\begin{document}

\title[A finitely presented non-MF group]{A finitely presented non-MF group}
\author{\paperauthor}
\subjclass[2020]{Primary 46L05; Secondary 20F05, 22D25, 20E26}
\keywords{MF groups, approximate unitary representations, property~(T),
group $C^*$-algebras, Clifford groups}

\begin{abstract}
A countable discrete group is MF if it embeds in the unitary group of a
matrix quotient
$\mathcal Q=\prod_nM_{d_n}(\mathbb C)/\bigoplus_nM_{d_n}(\mathbb C)$;
equivalently, if it admits finite-dimensional approximate unitary
representations, asymptotically multiplicative in operator norm, that
separate every nontrivial element from the identity.  We construct an
explicit finitely presented group $E$ that is not MF, refuting the
conjecture that every countable group is MF.

More generally, from a finitely presented property-\textup{(T)} group
$\Gamma$ with a proper injective endomorphism $\alpha$ we build a
finitely presented group carrying a nontrivial central involution $w$
that every homomorphism to $\U(\mathcal Q)$ maps to the identity.  The
rigidity behind this is that one-sided conjugation of $\Gamma$
preserves its asymptotic commutant in normalized Hilbert--Schmidt norm,
in every operator-norm asymptotic representation; compressing to the
$(-1)$-spectral corner of $w$ then contradicts it.  Taking
$\Gamma=\mathbb Z^3\rtimes\SL_3(\mathbb Z)$ and $\alpha(v,A)=(2v,A)$
gives $E$, on eight generators and forty-one relators.

The group $E$ is sofic, hence hyperlinear, so neither soficity nor
hyperlinearity implies the MF property; and its reduced $C^*$-algebra
$\Cred(E)$ is separable and stably finite but not MF\@.

\end{abstract}

\maketitle
\newpage

\setcounter{tocdepth}{1}
\tableofcontents
\par\clearpage

\section{Introduction}\label{sec:intro}


Can every countable discrete group be realized by matrices, if
multiplication is only required to hold up to operator-norm errors that
vanish along a sequence of finite dimensions?  Shulman calls the positive
assertion the \emph{MF conjecture} \cite{Shulman}, and no group was known
to fail it \cite{Schafhauser,Shulman}.  We prove that the answer is no:
there is an explicit finitely presented group, on eight generators and
forty-one relators, that is not MF\@.  Residually finite groups satisfy
the conjecture through their finite quotients, as do LEF groups \cite{CDE} and, by
quasidiagonality \cite{TWW}, all amenable groups.  Recent work
establishes it for many amalgamated free products
\cite{Schafhauser,Shulman,GKEMP}.
Throughout, $[g,h]=ghg^{-1}h^{-1}$ denotes the commutator of two group
elements.  The additive commutator of two operators is written
$[x,y]_{-}=xy-yx$, so that the two brackets are never confused where a
group element and its matrix image occur together.
\subsection*{The result}

\begin{mainthm}[an explicit finitely presented non-MF group]\label{thm:A}
Let $E$ be the group on the eight generators
$v_1,v_2,v_3,x,y,z,t,c$ with the forty-one relators displayed in
Definition~\ref{def:E}, and put
\[
 w=[tct^{-1},\,v_1(tct^{-1})v_1^{-1}].
\]
The defining relations make $w$ central; together with $c^2=1$, centrality
implies $w^2=1$.  Then the following statements hold:
\begin{enumerate}
 \item $w\ne1$ in $E$, so $w$ is a central involution;
 \item for every sequence $(d_n)$ of positive integers and every
  homomorphism $\Theta\colon E\to\U(\mathcal Q((d_n)))$ into the unitary
  group of the corresponding matrix quotient, one has $\Theta(w)=1$.
\end{enumerate}
In particular $E$ is not MF, and neither $\Cmax(E)$ nor $\Cred(E)$ is an
MF $C^*$-algebra.  A Tietze reduction presents the same group on six
generators with thirty-two relators (Section~\ref{sec:group}).
\leanverified{Sofic/LiteralNonMFEndpoint}{GroupApproximation.LiteralNonMFEndpoint.manuscriptTheoremA}
\end{mainthm}

\noindent
The group is written out in Definition~\ref{def:E};
Section~\ref{sec:example} proves the theorem.

\subsection*{Outline of the proof}

An inclusion between two objects of equal finite size is an equality.
\begin{equation}\label{eq:three-columns}
 \begin{array}{c@{\quad}c@{\quad}c}
 X\subseteq Y,\ |X|=|Y| & V\subseteq W,\ \dim V=\dim W
   & \substack{p\le q,\ p\sim q\\
       \text{in a finite }C^*\text{-algebra}}\\[2mm]
 \Downarrow & \Downarrow & \Downarrow\\[-1mm]
 X=Y & V=W & p=q.
 \end{array}
\end{equation}
Here $p\sim q$ is Murray--von Neumann equivalence, and a $C^*$-algebra
is \emph{finite} when every isometry in it is unitary.  The three
columns give the arguments for finite quotients, for
finite-dimensional representations, and for $\mathcal Q$, in that order.
Operator norm is the approximation norm throughout, and the normalized
Hilbert--Schmidt norm enters only as the Hilbert-space norm on which
property~\textup{(T)} acts.

Let $\pi$ be a homomorphism to a finite group and let
$t\Gamma t^{-1}\subseteq\Gamma$.  Then
$\pi(t\Gamma t^{-1})=\pi(\Gamma)$: the left side is a conjugate of the
right side contained in it, and the two are finite of the same
cardinality.  So an element $c$ centralizing $\Gamma$ has
$\pi(tct^{-1})$ centralizing $\pi(\Gamma)$, and every commutator
$[\,tct^{-1},a\,]$ with $a\in\Gamma$ lies in $\ker\pi$.

Every finite-dimensional representation $\pi$ of the ambient group over
every field gives the same conclusion, with the commutant in place of
the subgroup.  Let $C$ be the commutant of $\pi(\Gamma)$ in
$\End_k(V)$.  The inclusion $t\Gamma t^{-1}\subseteq\Gamma$ implies
$C\subseteq\pi(t)\,C\,\pi(t)^{-1}$, the two sides have equal finite
dimension, and therefore
\[
 C=\pi(t)\,C\,\pi(t)^{-1}
\]
(Theorem~\ref{thm:B} and Remark~\ref{rem:invariantsize}).  Since
$\pi(c)\in C$, also $\pi(tct^{-1})\in C$, so it commutes with every
$\pi(a)$, $a\in\Gamma$.

Regard
$M_d(\C)$ as the Hilbert space $L^2(M_d(\C),\tr_d)$, on which
conjugation by a unitary acts unitarily.  For unitaries $u_1,u_2$,
uniformly in $d$,
\[
 \bigl\lVert\Ad u_1-\Ad u_2\bigr\rVert_{B(L^2(M_d(\C),\tr_d))}
 \;\le\;2\,\opnorm{u_1-u_2},
\]
so an operator-norm asymptotic representation induces one by conjugation
on the Hilbert--Schmidt spaces.

Let $\Gamma$ have property~\textup{(T)}, let $\iota\colon\Gamma\to H$ be
a homomorphism, and let $t,c\in H$ satisfy
\[
 t\,\iota(\Gamma)\,t^{-1}\subseteq\iota(\Gamma),\qquad
 [c,\iota(\Gamma)]=1 .
\]
In a norm ultraproduct $B_\omega$ of the blocks, the classes
$\pi(g)=[\Ad U_n(g)]_\omega$ define a unitary representation of $H$.
The Kazhdan estimate bounds the spectrum of the Hermitian average $h$
of the generators away from $1$ off the invariant vectors, so the
spectral projection of $h$ at $1$ lies in $B_\omega$ and projects onto
the $\iota(\Gamma)$-invariant vectors; call it $P$.  Writing
$V=\pi(t)$, the inclusion above implies $P\le VPV^*$; the two
projections are Murray--von Neumann equivalent, and $B_\omega$ contains
no proper isometry, so $P=VPV^*$.  Hence conjugation by $t$ preserves
the asymptotic commutant of $\iota(\Gamma)$ in normalized
Hilbert--Schmidt norm (Theorem~\ref{thm:kazhdan-transport}).

Put $d=tct^{-1}$ and $u=[\,d,\iota(a)\,]$ for $a\in\Gamma$.  Since $c$
commutes with $\iota(\Gamma)$, its lifts lie in that asymptotic
commutant, and the theorem just stated gives
$\hsnorm{[U_n(d),U_n(\iota(\gamma))]_{-}}\to0$ for every
$\gamma\in\Gamma$.  Consequently, in every operator-norm asymptotic
representation $(U_n)$ of $H$,
\[
 \hsnorm{U_n(u)-1}\longrightarrow0 .
\]

Suppose now that $w=u^2$ is central in $H$ with $w^2=1$, and let
$\Theta$ be a homomorphism $H\to\U(\mathcal Q)$ with $\Theta(w)\ne1$.
Then $\Theta(w)$ is a self-adjoint unitary commuting with $\Theta(H)$,
so
\[
 q=\tfrac12\bigl(1-\Theta(w)\bigr)
\]
is a nonzero projection commuting with $\Theta(H)$.  Choosing unitary
lifts of $\Theta$ and rounding the corresponding coordinate averages to
genuine projections represents $q$ by projections $q_n\in M_{d_n}(\C)$,
nonzero for infinitely many $n$ and asymptotically commuting with the
lifts.  Compressing to $q_n$, and giving each corner its own normalized
trace, yields a second operator-norm asymptotic representation of $H$,
one in which $w$ goes to $-1$.  There the previous display gives
$\hsnorm{U_n(u)^2-1}\to0$, while $\hsnorm{-1-1}=2$.  Hence
$\Theta(w)=1$ for every such $\Theta$, and if $w\ne1$ then $H$ is not MF
(Theorem~\ref{thm:sign-criterion}).

Let $\Gamma$ be a finitely presented Kazhdan group with a proper
injective endomorphism $\alpha$, let $a\in\Gamma\setminus\alpha(\Gamma)$,
and adjoin $t$ and $c$ subject to $t\gamma t^{-1}=\alpha(\gamma)$,
$c^2=1$ and $[c,\gamma]=1$.  In
the direct limit of $\alpha$ the cosets $t\Gamma$ and $at\Gamma$ are
distinct, since $t^{-1}at\in\Gamma$ would place $a$ in $\alpha(\Gamma)$.
Let the ambient group permute the generators of a Clifford group indexed
by that coset space, and send $c$ to the generator at the base coset;
then $d$ and $ada^{-1}$ are carried to the generators at the two
distinct cosets above.  Distinct Clifford generators anticommute, so $u$
is carried to a product of two anticommuting involutions and $w=u^2$ to
$-1$ (Theorem~\ref{thm:kazhdan-clifford}).

Taking
\[
 \Gamma=\mathbb Z^3\rtimes\SL_3(\mathbb Z),\qquad
 \alpha(v,A)=(2v,A),\qquad a=(e_1,I)
\]
gives the group $E$ of Theorem~\ref{thm:A}.

Only the subgroup $\iota(\Gamma)$ is assumed to have
property~\textup{(T)}.  The group $E$ surjects onto $\mathbb Z$, by
sending $t$ to $1$ and every other generator to $0$, so $E$ itself does
not have property~\textup{(T)}.

The reduced group
$C^*$-algebra $\Cred(E)$ is separable and stably finite but not MF
(Theorem~\ref{thm:D}).  The Clifford quotient $W$ used to prove $w\ne1$
is itself finitely generated, sofic and not MF, so neither soficity nor
hyperlinearity implies the MF property (Theorem~\ref{thm:E}); the group
$E$ is sofic as well (Theorem~\ref{thm:Esofic}), so a finitely
presented group already separates the two properties.  The
quotient $E/\langle w\rangle$ is also not MF, so $\{1,w\}$ is a proper
subgroup of the MF residual of $E$ (Theorem~\ref{thm:signfree}).  The
non-MF argument implies neither soficity nor nonsoficity, for either
group (Section~\ref{sec:limits}).

\subsection*{Relation to prior work}

The corresponding $C^*$-algebra question is older.  Blackadar and
Kirchberg, who introduced MF algebras, remarked that no stably finite
separable $C^*$-algebra was known not to be MF \cite{BK,CDE}.  Their
natural candidate was $\Cred(F_2)$, which Haagerup and
Thorbj{\o}rnsen later proved to be MF \cite{HT}.  The negative solution of the Connes embedding
problem subsequently supplied abstract stably finite non-MF algebras
\cite{MIPRE,FGH}.  No countable group was known whose reduced or maximal group
$C^*$-algebra fails to be MF \cite{Shulman}.

In his 2018 ICM address, Thom asked for which Schatten
$p$-norms there exist non-approximable groups \cite[Question~3.11]{Th}.
The case $p=2$ was settled by De~Chiffre--Glebsky--Lubotzky--Thom
\cite{DGLT}, the cases $1<p<\infty$ by Lubotzky--Oppenheim \cite{LuO},
and the case $p=1$ by Bachner--Dogon--Lubotzky \cite{BDL}.  Three
approximation problems were left by that work: whether every countable
group is sofic (permutations in the Hamming metric), hyperlinear
(unitaries in the normalized Hilbert--Schmidt norm), and MF (unitaries in
operator norm).  The first was answered negatively in 2026: a nonsofic
group was constructed in \cite{OAI}, Fournier-Facio then gave a
torsion-free example \cite{FFF}, and Kun--Thom developed further
wreath-product examples \cite{KT}.  The present paper answers the third
negatively; at the time of writing the hyperlinear problem is open.
Our construction begins, as those arguments do, with a relation
$t\Gamma t^{-1}\subseteq\Gamma$ for a property-\textup{(T)} subgroup
$\Gamma$.  Because the approximation is by unitaries in operator norm
rather than by permutations in the Hamming metric, the rigidity used
here is instead that conjugation by $t$ preserves the asymptotic
commutant of $\Gamma$ in normalized Hilbert--Schmidt norm, in every
operator-norm asymptotic representation.
Throughout, ``MF'' is the operator-norm property of
Carri\'on--Dadarlat--Eckhardt \cite{CDE}, in the form used by Shulman
and by Bachner--Dogon--Lubotzky \cite{Shulman,BDL};
Section~\ref{sec:prelim} fixes it and its equivalent formulations.

The closest analogue is the recent work on nonsofic groups.  One-sided
conjugation of a property-\textup{(T)} subgroup, together with an element
centralizing that subgroup, appears in \cite{OAI,KT}, building on
rigidity results of Kun and Kun--Thom \cite{Kun16,KT19};
Alekseev--Thom prove a related centralizer rigidity for sofic embeddings
\cite{AlekseevThom}.  Those results concern Hamming or tracial
approximations.  Here the group acts by conjugation on the
Hilbert--Schmidt space of each matrix block, and finiteness of the norm
ultraproduct as a $C^*$-algebra forces the projection onto the
$\iota(\Gamma)$-fixed subspace to equal its unitary conjugate (Theorem~\ref{thm:kazhdan-transport}, and
Section~\ref{app:finite-stage} for a finite-stage form).

Slofstra's hyperlinear-profile construction uses a Clifford group, a
distinguished central involution, a shift, and an HNN doubling map
\cite[Section~2 and Remark~3.3]{SlofstraProfile}, and his quotients by
the elements sent to the identity by all exact, respectively by all
approximate, finite-dimensional representations
\cite[Definitions~2.5--2.7]{SlofstraCorrelations} are the exact and the
approximate analogues of the MF residual used below.
Negative-eigenspace
compression appears in Slofstra--Vidick
\cite[proof of Proposition~2.7]{SlofstraVidick}, and Fritz's marked
$\mathrm{BS}(2,3)$ example is the context for the cyclic comparison of
Section~\ref{sec:necessity} \cite{Fritz,SlofstraVidick}.
Bachner--Dogon--Lubotzky develop the operator-norm rounding,
compression, and polar-correction procedures used in
Section~\ref{sec:conj} \cite[Lemmas~2.2--2.3, Proposition~2.4, and the
proof of Proposition~1.5]{BDL}; in the proof of their Proposition~1.6
they treat the finite-central case by a character-isotypic corner and
reduce the general case of a finite normal subgroup to it through the
finite-index centralizer.  Theorem~\ref{thm:criterion} below combines
that corner with the one-sided conjugation of a Kazhdan subgroup: if
$F\trianglelefteq H$ is finite and $F\subseteq N_{\mathrm{conj}}$, then
every homomorphism $H\to\U(\mathcal Q)$ maps every element of $F$ to the
identity.  Central
extensions and rigidity of approximate representations also drive the
Frobenius obstruction of De~Chiffre--Glebsky--Lubotzky--Thom
\cite{DGLT}; finite-target approximation and extension results for weak
soficity appear in \cite{GR,Gl19}.

The passage from operator norm to the Hilbert--Schmidt conjugation
representation belongs to the $\pi\otimes\bar\pi$ framework of Bekka
and Bekka--Valette \cite{BekkaAmenable,BekkaValette}, and Dadarlat uses
normalized finite-rank projections as almost invariant
Hilbert--Schmidt vectors in an operator-norm approximation argument
\cite[Lemma~3.18 and Proposition~3.19]{Dadarlat}.  The group-MF
framework is that of Carri\'on--Dadarlat--Eckhardt, who also give,
through Abels' group, an amenable MF group that is not residually
finite \cite[Section~2.14 and Corollary~2.18]{CDE}.

The group property is weaker than the algebra property.  For the algebra
one asks for an embedding $\Cred(E)\hookrightarrow\mathcal Q$ of
$C^*$-algebras; for the group, only for an injective homomorphism
$E\to\U(\mathcal Q)$, which need not extend to the algebra.  Failure of
MF for a group $C^*$-algebra therefore leaves open whether the group
itself embeds.  For $E$, Theorem~\ref{thm:A} rules out both.

\section{Matrix quotients}\label{sec:prelim}

All groups are discrete and countable.  We use the standard formulation of
property~\textup{(T)} for unitary representations on complex Hilbert
spaces.  A $C^*$-homomorphism is unital only when this is stated; in
particular an MF embedding may be nonunital.  For a unital $C^*$-algebra
$A$ we write $\U(A)$ for its unitary group.  On $M_r(\C)$ we use the
normalized trace $\tr_r$, the operator norm $\opnorm{\cdot}$, and the
normalized Hilbert--Schmidt norm $\hsnorm{x}=\tr_r(x^*x)^{1/2}$.  For a
nonzero projection $q\in M_r(\C)$ we equip the corner $qM_r(\C)q$ with
its own normalized trace, and where the trace has to be named we write
$\lVert x\rVert_{2,\tr_r}$ for the same quantity.
The unnormalized trace is $\operatorname{Tr}=r\cdot\tr_r$ on $M_r(\C)$.
Convergence in normalized Hilbert--Schmidt norm is always asserted of
sequences of matrices, never of group elements.  We use without comment:
$\hsnorm{x}\le\opnorm{x}$;
$|\tr_r(x)|\le\opnorm{x}$; and $\hsnorm{uxv}=\hsnorm{x}$ for unitaries
$u,v$.

Given a sequence $(d_n)_{n\in\N}$ of positive integers, write
\begin{equation}\label{eq:corona}
  \mathcal Q\bigl((d_n)_{n\in\N}\bigr)
  \;=\;\prod_{n\in\N} M_{d_n}(\C)
  \Big/\bigoplus_{n\in\N} M_{d_n}(\C),
\end{equation}
where the product is the bounded $C^*$-product and $\bigoplus_n$ is the
$c_0$-sum, the ideal of sequences with $\opnorm{x_n}\to0$; equivalently,
$\mathcal Q$ is the corona algebra of $\bigoplus_nM_{d_n}(\C)$.  Write
$q\colon\prod_{n}M_{d_n}(\C)\to\mathcal Q$ for the quotient map.
Following Blackadar--Kirchberg \cite{BK}, a separable $C^*$-algebra is
\emph{MF} if it embeds into an algebra of the form \eqref{eq:corona}.

The following lifting lemmas are standard perturbation theory; see
Loring \cite{Loring} for a systematic treatment.

\begin{lemma}[lifting]\label{lem:lift}
Every unitary $u\in\mathcal Q$ lifts to a sequence of unitaries.
\leanverified{Sofic/ManuscriptExactWrappers}{GroupApproximation.ManuscriptExactWrappers.manuscriptUnitaryLifting}
\end{lemma}

\begin{proof}
Lift $u$ to a bounded sequence $(x_n)$; unitarity of $q((x_n))$ gives
$\opnorm{x_n^*x_n-1}\to0$.  Once $\opnorm{x_n^*x_n-1}\le\tfrac12$,
the matrix $x_n$ is invertible and the polar correction
$u_n=x_n(x_n^*x_n)^{-1/2}$ is unitary with
$\opnorm{u_n-x_n}\le2\opnorm{x_n}\opnorm{x_n^*x_n-1}\to0$ by
continuous functional calculus; set $u_n=1$ at the finitely many
remaining indices.
\end{proof}

The unitaries of $\mathcal Q$ admit a direct description.  Write
\begin{equation}\label{eq:unitary-corona}
 \mathcal N=\bigl\{(u_n)\in\textstyle\prod_n\U(d_n)
 \ :\ \opnorm{u_n-1}\longrightarrow0\bigr\},
\end{equation}
a normal subgroup of $\prod_n\U(d_n)$.

\begin{lemma}[unitaries in the quotient]\label{lem:unitarycorona}
For every sequence $(d_n)$, with $\mathcal N$ as in
\eqref{eq:unitary-corona}, the map
\[
 \kappa_{(d_n)}\colon
 \prod_{n}\U(d_n)\big/\mathcal N\longrightarrow\U(\mathcal Q),
 \qquad [(u_n)]\longmapsto q((u_n)),
\]
is a canonical group isomorphism.  A homomorphism $H\to\U(\mathcal Q)$
is therefore equivalent to the following data: a sequence of unitaries
for each element of $H$, multiplicative up to operator-norm errors
tending to $0$, taken modulo sequences converging to $1$.
\leanverified{Sofic/ManuscriptExactWrappers}{GroupApproximation.ManuscriptExactWrappers.manuscriptUnitaryCoronaEquivalence}
\end{lemma}

\begin{proof}
The kernel of $(u_n)\mapsto q((u_n))$ is exactly $\mathcal N$, so the
induced map is injective.  Surjectivity is Lemma~\ref{lem:lift}.
\end{proof}

An \emph{operator-norm asymptotic representation} of $H$ is a sequence of
maps $U_n\colon H\to\U(d_n)$ such that $\opnorm{U_n(g)U_n(h)-U_n(gh)}\to0$
for all $g,h\in H$.  Taking
$g=h=1$ gives $\opnorm{U_n(1)-1}\to0$ automatically, since $U_n(1)$ is
unitary.  By Lemma~\ref{lem:unitarycorona}, choosing unitary lifts
$U_n(g)$ of $\Theta(g)$ turns a homomorphism
$\Theta\colon H\to\U(\mathcal Q)$ into such a sequence, and every such
sequence arises this way.  A countable group is \emph{MF} if it admits
an injective homomorphism to $\U(\mathcal Q)$ for some sequence of
dimensions.

\begin{proposition}[Equivalent formulations of the MF property]
\label{prop:mf-equivalences}
For every countable group, the $C^*$-algebra definition above is
equivalent to the definition by sequences of unitaries.  Both are
equivalent to the existence of approximate unitary representations with
separation constant $1$, and allowing arbitrary positive dimensions is
equivalent to requiring the dimensions to be strictly increasing.
\leanverified{Sofic/ManuscriptExactWrappers}{GroupApproximation.ManuscriptExactWrappers.manuscriptMFDefinitionEquivalences}
\end{proposition}

Section~\ref{app:equivalences} defines the approximate unitary
representations and proves the proposition.  Two stronger conventions
occur in the literature and are not used here: in \cite{GKEMP} the
approximating maps must also recover the canonical trace and the
left-regular norm on every group-ring element, and the purely matricial
field (PMF) property of \cite[Definition~1.2]{MdlS} requires
finite-dimensional representations whose group-ring norms converge to
the regular norms.

\section{One-sided conjugation in matrix models}\label{sec:transport}

Theorem~\ref{thm:B} uses the middle implication of
\eqref{eq:three-columns} for the
commutant $C$ of the base inside a finite-dimensional endomorphism
algebra, where $C\subseteq\pi(t)C\pi(t)^{-1}$ and the two sides have
equal finite dimension.  The proof of
Theorem~\ref{thm:kazhdan-transport} uses the right-hand implication for
the projection $P$ onto the Kazhdan fixed space inside a norm
ultraproduct: there $s\iota(\Gamma)s^{-1}\subseteq\iota(\Gamma)$
gives $P\le VPV^*$, the two projections are Murray--von Neumann
equivalent, and the ultraproduct is finite, so $P=VPV^*$.

\begin{lemma}[comparison in a finite algebra]\label{lem:finitecompare}
Let $A$ be a finite unital $C^*$-algebra and let $p,q\in A$ be
projections with $p\le q$ and $p\sim q$.  Then $p=q$.
\leanverified{Sofic/UltraproductKazhdanTransport}{GroupApproximation.kt_10_finiteness_reverses}
\end{lemma}

\begin{proof}
Let $r\in A$ satisfy $r^*r=q$ and $rr^*=p$.  From $r^*r=q$ we get
$r=rq$.  Since $p\le q$ we have $qp=p$, so
\[
 pr=rr^*r=rq=r,\qquad qr=q(pr)=(qp)r=pr=r,
\]
and $r=qr$ as well.  Hence the cross terms in
$\sigma^*\sigma$ vanish for $\sigma=r+(1-q)$, and
$\sigma^*\sigma=q+(1-q)=1$, so $\sigma$ is an isometry.  Finiteness
makes $\sigma$ unitary, and $\sigma\sigma^*=p+(1-q)=1$ gives $p=q$.
\end{proof}

\begin{lemma}[the norm ultraproduct]\label{lem:ultrafinite}
Let $(K_n)$ be finite-dimensional Hilbert spaces, $\omega$ a free
ultrafilter on $\N$, $K_\omega$ the Hilbert-space ultraproduct and
$B_\omega=\prod_\omega B(K_n)$ the norm ultraproduct, acting on
$K_\omega$ by $[A_n]_\omega[\xi_n]_\omega=[A_n\xi_n]_\omega$.  Then the
action is faithful, $B_\omega$ is a finite $C^*$-algebra, and for
projections $P,Q\in B_\omega$ the inclusion
$\operatorname{ran}P\subseteq\operatorname{ran}Q$ is equivalent to
$P\le Q$.
\leanverified{Sofic/UltraproductDedekindFinite}{GroupApproximation.kt_06_ultraproduct_finite}
\end{lemma}

\begin{proof}
If $A=[A_n]_\omega\ne0$ then $\lim_\omega\opnorm{A_n}=\delta>0$, and
unit vectors $\xi_n$ with $\lVert A_n\xi_n\rVert\ge\opnorm{A_n}-1/n$
give $\lVert A[\xi_n]_\omega\rVert=\delta$, so the action is faithful.
Consequently $\operatorname{ran}P\subseteq\operatorname{ran}Q$ makes
$QP$ and $P$ act identically, whence $QP=P$, that is, $P\le Q$.  If
$\sigma=[\sigma_n]_\omega$ satisfies $\sigma^*\sigma=1$ then
$\opnorm{\sigma_n^*\sigma_n-1}\to0$ along $\omega$; each $\sigma_n$ acts
on a finite-dimensional space, so polar correction replaces it by a
unitary $w_n$ with $\opnorm{\sigma_n-w_n}\to0$, and
$\sigma=[w_n]_\omega$ is unitary.
\end{proof}

\subsection*{The exact case}

% LABELS.  `mainthm` numbers by letter in order of appearance, so a label
% spelled `thm:X` is a promise about position that the source cannot keep.
% This one is NOT the lettered Theorem B -- it is an ordinary numbered
% theorem.  Cite it as \ref{thm:exactfd}; `thm:B` is a legacy alias kept only
% so that references written before the rename still resolve, and it should
% be deleted once no draft in flight uses it.  Same for `thm:C`, `thm:D`,
% `thm:E` at their own definitions.
\begin{theorem}[the finite-dimensional case]\label{thm:exactfd}\label{thm:B}
Let $k$ be a field, $V$ a finite-dimensional $k$-vector space, $H$ a
group, $\Gamma\le H$ a subgroup, and $t,c\in H$, $a\in\Gamma$ elements
with $t\Gamma t^{-1}\subseteq\Gamma$ and $c\gamma=\gamma c$ for all
$\gamma\in\Gamma$.  Then every homomorphism $\pi\colon H\to\GL(V)$
satisfies
\[
  \pi\bigl(\bigl[\,tct^{-1},\;a(tct^{-1})a^{-1}\bigr]\bigr)\;=\;1 .
\]
More generally, every such $\pi$ sends the entire subgroup
$\mathfrak D(H,\Gamma)$ of \eqref{eq:intrinsicdefect} to the identity.
\leanverified{Sofic/ManuscriptExactWrappers}{GroupApproximation.ManuscriptExactWrappers.manuscriptTheoremB}
\end{theorem}

\begin{proof}
Let
\[
 C=\{x\in\End_k(V):\pi(\gamma)x=x\pi(\gamma)\ \text{for all}\
 \gamma\in\Gamma\}
\]
be the commutant of $\pi(\Gamma)$, a linear subspace of $\End_k(V)$, and
write $\Phi(x)=\pi(t)\,x\,\pi(t)^{-1}$ for conjugation by $\pi(t)$, a
linear automorphism of $\End_k(V)$.

We claim $C\subseteq\Phi(C)$.  Let $x\in C$ and put
$y=\pi(t)^{-1}x\,\pi(t)$, so that $x=\Phi(y)$.  For $\gamma\in\Gamma$ we
have $t\gamma t^{-1}\in\Gamma$, hence $\pi(t\gamma t^{-1})$ commutes
with $x$, and therefore
\[
  \pi(\gamma)\,y
  = \pi(t)^{-1}\,\pi(t\gamma t^{-1})\,x\,\pi(t)
  = \pi(t)^{-1}\,x\,\pi(t\gamma t^{-1})\,\pi(t)
  = y\,\pi(\gamma).
\]
Thus $y\in C$, proving the claim.  Since $\Phi$ is a linear isomorphism,
$\dim_k\Phi(C)=\dim_kC<\infty$, and the inclusion $C\subseteq\Phi(C)$
forces
\begin{equation}\label{eq:pinning}
  C\;=\;\Phi(C)\;=\;\pi(t)\,C\,\pi(t)^{-1}.
\end{equation}
Now $\pi(c)\in C$ because $c$ centralizes $\Gamma$, so
$\pi(tct^{-1})=\Phi(\pi(c))\in C$ by \eqref{eq:pinning}.  Since
$a\in\Gamma$, the operator $\pi(tct^{-1})$ commutes with $\pi(a)$, so
$\pi\bigl(a(tct^{-1})a^{-1}\bigr)=\pi(tct^{-1})$ and
\[
  \pi\bigl(\bigl[\,tct^{-1},\;a(tct^{-1})a^{-1}\bigr]\bigr)
  =\bigl[\,\pi(tct^{-1}),\;\pi(tct^{-1})\bigr]=1 .
\]
Section~\ref{sec:findim} proves the subgroup-valued assertion from the
same calculation. \qedhere
\end{proof}

In $E$, every finite-dimensional linear representation over every field,
and hence every homomorphism to a finite group, maps the distinguished word to
the identity (Corollary~\ref{cor:notRFD}).

An MF
model is only asymptotically multiplicative, so its coordinate fixed
spaces are not invariant subspaces.  Operator-norm control keeps the
adjoint actions almost multiplicative on the Hilbert--Schmidt spaces,
and the finite-stage proof of Section~\ref{app:finite-stage} works with
the spectral subspace $\operatorname{ran}P_n$ of a Kazhdan average above
a fixed threshold and with $Q_n=\Ad U_n(s)\,P_n\,\Ad U_n(s)^{*}$: there
$\opnorm{(1-Q_n)P_n}\to0$ and
$\operatorname{rank}P_n=\operatorname{rank}Q_n$, hence
$\opnorm{(1-P_n)Q_n}\to0$.  Property~\textup{(T)} cannot be
dropped: the group $E_{\mathrm{BS}}$ of
Section~\ref{sec:necessity} has cyclic base, its distinguished word is trivial
in every finite-dimensional representation over every field, and some
homomorphism $E_{\mathrm{BS}}\to\U(\mathcal Q)$ maps that word to a
nontrivial element.

\begin{theorem}[one-sided conjugation preserves asymptotic commutants]
\label{thm:kazhdan-transport}
Let $\Gamma$ and $H$ be groups, let $\Gamma$ have
property~\textup{(T)}, let $\iota\colon\Gamma\to H$ be a homomorphism, let
$s\in H$, and let $(d_n)$ be a sequence of positive integers.  Suppose
\[
 s\iota(\Gamma)s^{-1}\subseteq\iota(\Gamma).
\]
Let $U_n\colon H\to\U(d_n)$ be an operator-norm asymptotic representation.
If $(x_n)$ is uniformly operator-norm bounded and asymptotically
centralizes $\iota(\Gamma)$ in normalized Hilbert--Schmidt norm,
\[
 \hsnorm{x_nU_n(\iota(\gamma))-U_n(\iota(\gamma))x_n}\longrightarrow0
 \qquad(\gamma\in\Gamma),
\]
then the conjugated sequence does as well:
\leanverified{Sofic/ManuscriptKazhdanTransport}{GroupApproximation.KazhdanAsymptoticCommutant.manuscriptKazhdanTransport}
\[
\hsnorm{[U_n(s)x_nU_n(s)^*,U_n(\iota(\gamma))]_{-}}
\longrightarrow0
\qquad(\gamma\in\Gamma).
\]
\end{theorem}

\begin{proof}
Suppose the conclusion fails: there are $\gamma_0\in\Gamma$,
$\delta>0$, and an infinite set $I\subseteq\N$ with
$\hsnorm{[U_n(s)x_nU_n(s)^*,U_n(\iota(\gamma_0))]_{-}}\ge\delta$ for
$n\in I$.  Fix a free ultrafilter $\omega$ on $\N$ with $I\in\omega$.

\emph{The adjoint model.}  Regard $M_{d_n}(\C)$ as the Hilbert space
$K_n=L^2(M_{d_n}(\C),\tr_{d_n})$ and let each group element act on it
by conjugation, $\Ad U_n(g)\,\xi=U_n(g)\,\xi\,U_n(g)^*$.
Operator-norm almost multiplicativity of $U_n$ makes
$g\mapsto\Ad U_n(g)$ an operator-norm asymptotic representation on
these Hilbert spaces.

\emph{The ultraproduct.}  Let $K_\omega$ and
$B_\omega=\prod_\omega B(K_n)$ be as in Lemma~\ref{lem:ultrafinite};
write $[\,\cdot\,]_\omega$ for classes in either.  By that lemma the
action is faithful, $B_\omega$ is finite in
the sense fixed above --- every isometry in it is a unitary, a
condition on the algebra and not on its dimension, which is
infinite --- and
an inclusion of ranges in $K_\omega$ may be read back as an inequality
of projections in $B_\omega$.  Asymptotic multiplicativity makes
\[
 \pi\colon H\longrightarrow\U(B_\omega),\qquad
 \pi(g)=[\Ad U_n(g)]_\omega,
\]
a homomorphism.

\emph{The projection onto the fixed subspace.}  Property~\textup{(T)}
provides a finite
symmetric generating set $S\subseteq\Gamma$ with $1\in S$ and a Kazhdan
constant $\kappa\in(0,1]$ for the pair $(S,\kappa)$.  Let $h$ be the
Hermitian part of $\frac1{|S|}\sum_{s'\in S}\pi(\iota(s'))$ and let
$\mathrm{Fix}\subseteq K_\omega$ be the subspace of vectors fixed by
every $\pi(\iota(\gamma))$.  Both $\mathrm{Fix}$ and its
orthocomplement are invariant under each unitary $\pi(\iota(s'))$,
hence under $h$.  On $\mathrm{Fix}$, $h=1$.  The restriction of
$\pi\circ\iota$ to $\mathrm{Fix}^\perp$ has no nonzero invariant
vector, so a unit vector $\xi\in\mathrm{Fix}^\perp$ satisfies
$\lVert\pi(\iota(s'))\xi-\xi\rVert\ge\kappa$ for some generator.  For
that generator
$\operatorname{Re}\langle\pi(\iota(s'))\xi,\xi\rangle\le1-\kappa^2/2$,
while every other term is at most $1$.  Averaging gives
$\langle h\xi,\xi\rangle\le1-\kappa^2/(2|S|)$.  Consequently
\[
 \operatorname{sp}(h)\subseteq
 \Bigl[-1,\,1-\tfrac{\kappa^2}{2|S|}\Bigr]\cup\{1\},
\]
and the spectral projection $P$ of $h$ at the isolated point $1$
belongs to $B_\omega$ by continuous functional calculus and projects
onto $\mathrm{Fix}$.

\emph{The two projections agree.}  Let $V=\pi(s)$ and $Q=VPV^*$.  Since
$s\iota(\Gamma)s^{-1}\subseteq\iota(\Gamma)$, every vector of
$\mathrm{Fix}$ is fixed by each $\pi(s\iota(\gamma)s^{-1})$; and $\eta$
is fixed by all $\pi(s\iota(\gamma)s^{-1})$ exactly when
$V^*\eta\in\mathrm{Fix}$.  Hence
$\operatorname{ran}P=\mathrm{Fix}\subseteq V\,\mathrm{Fix}
=\operatorname{ran}Q$, so $P\le Q$ by Lemma~\ref{lem:ultrafinite}.  The
element $r=V^*Q$ satisfies $r^*r=Q$ and $rr^*=V^*QV=P$, so $P\sim Q$.
Since $B_\omega$ is finite, Lemma~\ref{lem:finitecompare} gives $Q=P$.

\emph{Conclusion.}  Let $\xi=[\xi_n]_\omega\in K_\omega$, where
$\xi_n\in K_n$ is the vector of $x_n$; the uniform operator-norm bound
makes $\xi$ well defined.  By unitary invariance of the normalized
Hilbert--Schmidt norm, the commutator hypothesis says exactly that each
$\pi(\iota(\gamma))$ fixes $\xi$.  Thus $\xi\in\mathrm{Fix}$.  Since $Q=P$, we obtain
$V\xi\in V\,\mathrm{Fix}=\operatorname{ran}Q=\operatorname{ran}P
=\mathrm{Fix}$.
The vector of $U_n(s)x_nU_n(s)^*$ is $\Ad U_n(s)\,\xi_n$, so, again by
unitary invariance,
\[
 \hsnorm{[U_n(s)x_nU_n(s)^*,U_n(\iota(\gamma))]_{-}}
 =\bigl\lVert(\Ad U_n(\iota(\gamma))-1)\,\Ad U_n(s)\,\xi_n\bigr\rVert
 \longrightarrow0
\]
along $\omega$, for every $\gamma\in\Gamma$.  For $\gamma=\gamma_0$ this
contradicts $I\in\omega$.
\end{proof}

\begin{remark}[the finite-stage proof]\label{rem:finite-stage}
Section~\ref{app:finite-stage} proves the theorem again at finite
stages.  Conditional on the spectral-gap estimate stated there, every
bound in that proof is an explicit inequality in $\kappa$, $|S|$, the
uniform bound on $(x_n)$, and the multiplicative defects of $U_n$.
\end{remark}

\section{The central involution obstruction}\label{sec:sign}

Let $w$ be a central involution of $H$ and let $\Theta$ be a
homomorphism to $\U(\mathcal Q)$ with $\Theta(w)\ne1$.  Then
$\Theta(w)$ is a self-adjoint unitary commuting with
$\Theta(H)$, the projection $\tfrac12(1-\Theta(w))$ is
nonzero, and compressing to it gives a matrix model of $H$ in which
$w$ equals $-1$ and each block has its own normalized trace.

A bound on a commutator in normalized Hilbert--Schmidt norm does not by
itself yield an operator-norm obstruction: padding an asymptotic
representation with an identity block leaves every operator-norm
quantity unchanged and sends every normalized Hilbert--Schmidt distance
to zero (Section~\ref{sec:limits}).  On the corner $q_nM_{d_n}(\C)q_n$
the operator norm is the restriction of the operator norm, so the
compressed and polar-corrected maps remain operator-norm asymptotically
multiplicative, while the trace is the corner's own
normalized trace $\tr_{r_n}$ rather than the restriction of
$\tr_{d_n}$; and $\lVert1-(-1)\rVert_{2,\tr_{r_n}}=2$ for every value
of $r_n/d_n$.

\begin{theorem}[central involution obstruction]\label{thm:sign-criterion}
Let $H$ and $\Gamma$ be countable groups, let $\Gamma$ have
property~\textup{(T)}, let
$\iota\colon\Gamma\to H$ be a homomorphism, and suppose
\[
 t\iota(\Gamma)t^{-1}\subseteq\iota(\Gamma),
 \qquad [c,\iota(\Gamma)]=1.
\]
Put $d=tct^{-1}$ and $u=[d,\iota(a)]$ for some $a\in\Gamma$.
If $w:=u^2$ is a nontrivial central involution of $H$, then every
homomorphism $H\to\U(\mathcal Q)$ maps
$w$ to the identity, and $H$ is not MF.
\leanverified{Sofic/KazhdanSignCriterion}{GroupApproximation.KazhdanCompressionCore.manuscriptCentralSignCriterion}
\end{theorem}

\begin{proof}
Let $\Theta\colon H\to\U(\mathcal Q)$ be a homomorphism and
suppose $\Theta(w)\ne1$.

\emph{The $(-1)$-spectral corner.}  Choose coordinate unitary lifts
$(V_{g,n})$ of $\Theta$ (Lemma~\ref{lem:unitarycorona}) and put
$p_n=\tfrac12(1+V_{w,n})$, the averaging operator of the
two-element subgroup $F=\{1,w\}$.  Because the lifts are
asymptotically multiplicative and $w^2=1$, the Hermitian
part of $p_n$ is asymptotically idempotent, so its spectrum clusters
at $\{0,1\}$ and rounding at $\tfrac12$ by continuous functional
calculus produces genuine projections at operator-norm distance $o(1)$
from $p_n$; centrality of $w$ makes them asymptotically
central for all of $\Theta(H)$.  Let $q_n$ be their complements.  If
$q_n$ vanished for all large $n$ the averages would converge to $1$ and
$\Theta(w)$ would be $1$; so $q_n\ne0$ along infinitely
many coordinates, which we retain and relabel by $\N$.  Compressing
every lift to $q_nM_{d_n}(\C)q_n\cong M_{r_n}(\C)$ and polar-correcting
the compressions --- each is almost unitary in the corner, by
asymptotic centrality --- gives an operator-norm asymptotic
representation $(W_{g,n})$ of $H$ on nonzero blocks with
\[
 \opnorm{W_{w,n}+1}\longrightarrow0 .
\]
Equip each corner block with its own normalized trace $\tr_{r_n}$; all
estimates below are relative to $r_n$ and independent of the ratio
$r_n/d_n$.

\emph{Transport on the corner.}  Since $c$ centralizes
$\iota(\Gamma)$, the sequence $(W_{c,n})$ centralizes
$(W_{\iota(\gamma),n})$ asymptotically in operator norm, hence in
normalized Hilbert--Schmidt norm.  The one-sided conjugation relation
$t\iota(\Gamma)t^{-1}\subseteq\iota(\Gamma)$ and
Theorem~\ref{thm:kazhdan-transport}, applied to $x_n=W_{c,n}$, put the
conjugated sequence $(W_{d,n})$ in the same asymptotic commutant.
Therefore $\hsnorm{W_{u,n}-1}\to0$, and squaring gives
$\hsnorm{W_{u,n}^2-1}\to0$.

\emph{The contradiction.}  The relation $w=u^2$ gives
$\opnorm{W_{u,n}^2-W_{w,n}}\to0$, while
$W_{w,n}\to-1$ in operator norm and therefore also in
normalized Hilbert--Schmidt norm.  Hence $\hsnorm{W_{u,n}^2+1}\to0$
and $\hsnorm{W_{u,n}^2-1}\to0$, so $\hsnorm{2\cdot1}\to0$, which is
false.  Thus $\Theta(w)=1$.  Since $w\ne1$, no
homomorphism $H\to\U(\mathcal Q)$ is injective, and $H$ is not MF.
\end{proof}

The same conclusion holds for an arbitrary finite normal subgroup of
$N_{\mathrm{conj}}$ (Theorem~\ref{thm:criterion}), and for an arbitrary
normal property-\textup{(T)} subgroup $K\le N_{\mathrm{conj}}$, with a
Kazhdan spectral projection in place of the two-element average and
with neither centrality nor torsion assumed
(Theorem~\ref{thm:normal-kazhdan}).

\section{The Kazhdan--Clifford construction}\label{sec:construction}

Let $\Gamma$ be a finitely presented Kazhdan group, let $\alpha$ be a
proper injective endomorphism of it, and let
$a\in\Gamma\setminus\alpha(\Gamma)$.

With $d=tct^{-1}$ and $u=[d,a]$, put
\[
 w=u^2 .
\]
Since $d$ is an involution, $w=[\,d,ada^{-1}]$, a word in the
generators, so centrality of $w$ is a relation among them; centrality
then forces $w^2=1$ by \eqref{eq:involution-reversal} below.

\begin{theorem}[Kazhdan--Clifford construction]
\label{thm:kazhdan-clifford}
Let $\Gamma$ be a finitely presented group with property~\textup{(T)}, let
$\alpha\colon\Gamma\hookrightarrow\Gamma$ be an injective endomorphism, and
choose $a\in\Gamma\setminus\alpha(\Gamma)$.  Adjoin elements $t,c$ and impose
\[
 t\gamma t^{-1}=\alpha(\gamma),\qquad c^2=1,\qquad [c,\gamma]=1
 \quad(\gamma\in\Gamma).
\]
Put
\[
 d=tct^{-1},\qquad u=[d,a],\qquad w=u^2=[d,ada^{-1}],
\]
and impose centrality of $w$.
More explicitly, for a finite generating set $S_\Gamma$ it is enough to
impose the conjugation and commutation relations for $s\in S_\Gamma$, together with
\[
 [w,s]=1\quad(s\in S_\Gamma),\qquad [w,t]=[w,c]=1.
\]
Thus $w$ commutes with a generating set of the entire resulting group.  The
group $E(\Gamma,\alpha,a)$ is finitely presented,
the canonical map $\Gamma\to E(\Gamma,\alpha,a)$ is injective, and $w$ is a
nontrivial central involution.  Every homomorphism
\[
 E(\Gamma,\alpha,a)\longrightarrow \U(\mathcal Q)
\]
to $\U(\mathcal Q)$ maps $w$ to $1$.  Consequently
$E(\Gamma,\alpha,a)$ is not MF.
\leanverified{Sofic/KazhdanCliffordConstruction}{GroupApproximation.KazhdanCliffordConstruction.kazhdanCliffordConstruction}
\end{theorem}

\begin{proof}
Finite presentability follows from a relative finite presentation: start with
the free product of $\Gamma$ and the free group on $t,c$, and quotient by the
finitely many displayed relations for a finite generating set of $\Gamma$.

The relation $w^2=1$ is redundant.  Put $b=ada^{-1}$.  Both $d$ and $b$ are
involutions, $w=[d,b]=(db)^2$, and direct cancellation gives
\begin{equation}\label{eq:involution-reversal}
 dwd^{-1}=w^{-1}.
\end{equation}
Centrality also gives $dwd^{-1}=w$, whence $w=w^{-1}$ and $w^2=1$.

For nontriviality, realize the ascending HNN extension
\[
 G=\langle\Gamma,t\mid t\gamma t^{-1}=\alpha(\gamma)\rangle
\]
concretely.  Let $\Gamma_\infty$ be the direct limit of the
system $\Gamma\xrightarrow{\alpha}\Gamma\xrightarrow{\alpha}\cdots$,
whose $n$th copy of $\Gamma$ we call its \emph{$n$th level}; injectivity
of $\alpha$ passes to the limit, so the level-zero map embeds $\Gamma$ in
$\Gamma_\infty$.  Applying $\alpha$ levelwise induces an
injective endomorphism $\sigma$ of $\Gamma_\infty$.  It is surjective,
hence an automorphism, because an element at level $k$ equals $\sigma$
of the same element at level $k+1$.  Put
$G=\Gamma_\infty\rtimes_\sigma\Z$, with stable letter $t$ implementing
$\sigma$; then $t\gamma t^{-1}=\alpha(\gamma)$ for $\gamma\in\Gamma$.
Write $X=G/\Gamma$ for the coset space of the level-zero copy.  Let
$G$ permute the Clifford generators $(e_x)_{x\in X}$ and map $c$ to
$e_\Gamma$.  Then
\[
 d\longmapsto e_{t\Gamma},\qquad
 ada^{-1}\longmapsto e_{at\Gamma}.
\]
The two cosets are distinct: equality would give
$t^{-1}at\in\Gamma$, equivalently $a\in\alpha(\Gamma)$.  Hence the two
Clifford generators anticommute and
\[
 w\longmapsto(e_{t\Gamma}e_{at\Gamma})^2=-1.
\]
The Clifford sign is central, so the map respects every defining relation.
It follows both that $w\ne1$ and that the canonical map of
$\Gamma$ is injective.

Finally, $w=u^2$ is a nontrivial central involution.  By the central involution obstruction (Theorem~\ref{thm:sign-criterion}), every
homomorphism to $\U(\mathcal Q)$ maps $w$ to the identity.  Since $w\ne1$, none
is faithful.
\end{proof}

\begin{remark}[a small-cancellation realization]
\label{rem:ff-realization}
Fournier-Facio has pointed out (personal communication, 2026) that the
affine base of Sections~\ref{sec:group}--\ref{sec:witness} can be
replaced by a small-cancellation construction as in \cite{FFF}.  His
finitely presented torsion-free property-\textup{(T)} group $P$
contains a copy of every finitely presented torsion-free group, in
particular a direct product $P_1\times P_2$ with $P_i\cong P$.  Then
$\alpha\colon P\xrightarrow{\;\cong\;}P_1\le P$, together with any
$a\in P_2\setminus\{1\}$, satisfies the hypotheses of
Theorem~\ref{thm:kazhdan-clifford}.  The group $E(P,\alpha,a)$
contains involutions whatever the base.
\end{remark}

\section{A finitely presented non-MF group}\label{sec:example}

Specialize Theorem~\ref{thm:kazhdan-clifford} to
\begin{equation}\label{eq:affine-data}
 \Gamma=\mathbb Z^3\rtimes\SL_3(\mathbb Z),\qquad
 \alpha(v,A)=(2v,A),\qquad a=(e_1,I).
\end{equation}
The affine group $\Gamma$ is finitely presented and has
property~\textup{(T)} \cite[Example~1.7.4(i)]{BHV};
Section~\ref{sec:group} also proves this from the presentation used
below, by an exact rational sum-of-squares certificate.  The
endomorphism $\alpha$ is injective because
doubling is injective on $\mathbb Z^3$, it is proper because
$e_1\notin2\mathbb Z^3$, and $a\notin\alpha(\Gamma)$ for the same
reason.  Theorem~\ref{thm:kazhdan-clifford} therefore applies, and
relative to $\Gamma$ the resulting group has the finite presentation
\[
 E=\left\langle\,\Gamma,t,c \ \middle|\
 \begin{gathered}
  t\gamma t^{-1}=\alpha(\gamma),\quad
  [c,\gamma]=1\quad(\gamma\in S_\Gamma),\\
  c^2=1,\qquad [w,g]=1
 \end{gathered}\,\right\rangle,
\]
where $S_\Gamma$ is a finite generating set of $\Gamma$, $g$ runs over
the generators, and $w=[\,tct^{-1},\,a\,(tct^{-1})\,a^{-1}]$.
Expanding a standard presentation of the affine group in the generators
$v_1,v_2,v_3$ for the translations and $x,y,z$ for the linear part turns
this into the eight-generator, forty-one-relator presentation below.
First define the \emph{linear presentation}
\begin{equation}\label{eq:sl3presentation}
 \mathcal R=\left\langle x,y,z\ \middle|\
 \begin{gathered}
 x^3=y^3=z^2=(xz)^3=(yz)^3=1,\\
 (x^{-1}zxy)^2=(y^{-1}zyx)^2=(xy)^6=1
 \end{gathered}\right\rangle,
\end{equation}
and the \emph{base}
\begin{equation}\label{eq:gamma-presentation}
\mathcal B=\left\langle v_1,v_2,v_3,x,y,z\ \middle|\
\begin{gathered}
\text{the eight relations in \eqref{eq:sl3presentation}},\\
[v_1,v_2]=[v_1,v_3]=[v_2,v_3]=1,\\
xv_1x^{-1}=v_3,\ xv_2x^{-1}=v_1,\
xv_3x^{-1}=v_2,\\
yv_1y^{-1}=v_1,\ yv_2y^{-1}=v_2^{-1}v_3,\
yv_3y^{-1}=v_1v_2^{-1},\\
zv_1z^{-1}=v_2v_3^{-1},\ zv_2z^{-1}=v_1v_3^{-1},\
zv_3z^{-1}=v_3^{-1}
\end{gathered}\right\rangle.
\end{equation}
Write $\iota\colon\mathcal B\to E$ for the homomorphism induced by the first
six generators of the presentation below.  This map is not assumed to be
injective.

\begin{definition}\label{def:E}
Use the six base generators and the relations displayed in
\eqref{eq:gamma-presentation}.  Define
\begin{equation}\label{eq:E}
  E=\left\langle v_1,v_2,v_3,x,y,z,t,c\ \middle|\
  \begin{gathered}
   \textup{(B)}\quad\text{all relations in \eqref{eq:gamma-presentation}},\\
   \textup{(T)}\quad tv_i t^{-1}=v_i^2\ (1\le i\le3),\\
   \phantom{\textup{(T)}\quad}
     txt^{-1}=x,\quad tyt^{-1}=y,\quad tzt^{-1}=z,\\
   \textup{(C)}\quad c^2=1,\\
   \phantom{\textup{(C)}\quad}
     [c,g]=1\ \ (g\in\{v_1,v_2,v_3,x,y,z\}),\\
   \textup{(W)}\quad [w,g]=1\quad(g\in\{v_1,v_2,v_3,x,y,z,t,c\})
  \end{gathered}\right\rangle,
\end{equation}
where $w$ abbreviates the word
$\bigl[\,tct^{-1},\,v_1(tct^{-1})v_1^{-1}\bigr]$.
This is an explicit finite presentation with eight generators and
forty-one relators: twenty in family~\textup{(B)}, six in
family~\textup{(T)}, seven in family~\textup{(C)}, and eight in
family~\textup{(W)}.  Family~\textup{(B)} is a presentation of the
base; family~\textup{(T)} conjugates each base generator by $t$ into
the base; family~\textup{(C)} makes $c$ an involution commuting with
the base generators; and family~\textup{(W)} makes $w$ central.
Centrality together with $c^2=1$ implies
$w^2=1$ by \eqref{eq:involution-reversal}.  Families~\textup{(T)}
and~\textup{(C)} give, respectively,
\leanverified{Sofic/LiteralNonMFPresentation}{GroupApproximation.LiteralNonMFPresentation.manuscriptLiteralPresentation}
\[
 t\iota(\mathcal B)t^{-1}\subseteq\iota(\mathcal B),
 \qquad [c,\iota(\mathcal B)]=1.
\]
\end{definition}

A Tietze reduction removes two generators and nine relators
(Section~\ref{sec:group}).

Since $d=tct^{-1}$ is an involution, the distinguished word
\[
 w=[\,d,\,\iota(v_1)\,d\,\iota(v_1)^{-1}]
\]
is the square $[\,d,\iota(v_1)]^{2}$.

\begin{lemma}[the distinguished word is a square]\label{lem:square}
Let $H_1$ be a group and $d,a_1\in H_1$ with $d^2=1$.  Then
\leanverified{Sofic/CompressionDefectSquare}{GroupApproximation.commutator_conjugate_eq_commutator_sq_of_sq_eq_one}
\[
  \bigl[\,d,\;a_1\,d\,a_1^{-1}\bigr]\;=\;[\,d,a_1\,]^{\,2} .
\]
\end{lemma}

\begin{proof}
Put $b=a_1da_1^{-1}$, so $b^2=a_1d^2a_1^{-1}=1$; thus $b^{-1}=b$ and
$d^{-1}=d$.  Then $[d,a_1]=da_1d^{-1}a_1^{-1}=d\,(a_1da_1^{-1})=db$,
and
\[
  [d,a_1]^2=(db)^2=db\,db=d\,b\,d^{-1}b^{-1}=[d,b] . \qedhere
\]
\end{proof}

\begin{proof}[Proof of Theorem~\ref{thm:A}]
That $w\ne1$ is Proposition~\ref{prop:witness}.

Let $(d_n)$ be given, write $\mathcal Q=\mathcal Q((d_n))$, and let
$\Theta\colon E\to\U(\mathcal Q)$ be a homomorphism.  Apply the central
involution obstruction (Theorem~\ref{thm:sign-criterion}) with
$\Gamma=\mathcal B$, the canonical homomorphism $\iota$, the elements
$t,c\in E$, and $a=v_1$.  Its hypotheses are the displayed relators:
Proposition~\ref{prop:literal-base-T} gives property~\textup{(T)} of
$\mathcal B$; family~\textup{(T)} gives
$t\iota(\mathcal B)t^{-1}\subseteq\iota(\mathcal B)$; and
family~\textup{(C)} gives $[c,\iota(\mathcal B)]=1$.  In $E$ we
have $d^2=(tct^{-1})^2=tc^2t^{-1}=1$, so Lemma~\ref{lem:square} with
$a_1=\iota(v_1)$ gives
\[
  w=\bigl[\,d,\;\iota(v_1)\,d\,\iota(v_1)^{-1}\bigr]
  =[\,d,\iota(v_1)\,]^{\,2}=u^2 ,
  \qquad u=[\,d,\iota(v_1)\,].
\]
Centrality of $w$ is a defining relator; with $c^2=1$ it gives $w^2=1$
by \eqref{eq:involution-reversal}; and $w\ne1$ as above.  Hence
$\Theta(w)=1$.
\leanverified{Sofic/LiteralNonMFEndpoint}{GroupApproximation.LiteralNonMFEndpoint.negativeCorner_kazhdanTransport_contradiction}

An MF embedding of $E$ would be an injective homomorphism to $\U(\mathcal Q)$, and
every homomorphism to $\U(\mathcal Q)$ maps the nontrivial element $w$ to $1$; so
$E$ is not MF\@.  Suppose $\Cred(E)$ were an MF algebra, with an
injective, possibly nonunital $*$-homomorphism
$e\colon\Cred(E)\to\mathcal Q$.  Complement correction gives the
injective unitary homomorphism $u\mapsto e(u)+(1-e(1))$; composing it
with the canonical map $E\to\U(\Cred(E))$, which is injective because
$g\mapsto\lambda_g$ is, exhibits an injective homomorphism
$E\to\U(\mathcal Q)$.  The canonical map
$E\to\U(\Cmax(E))$ is injective as well, since the left regular
representation factors through $\Cmax(E)$ and sends $u_g$ to
$\lambda_g$, so an MF embedding of $\Cmax(E)$ produces an injective
homomorphism $E\to\U(\mathcal Q)$ after the same conversion.
\end{proof}

\begin{corollary}[uniform finite operator-norm obstruction]\label{cor:uniform}
There exist $\delta>0$ and a finite set $F_0\subset E$ such that,
in every matrix dimension, any unitary-valued map $\phi$ satisfying
\[
 \opnorm{\phi(gh)-\phi(g)\phi(h)}\leq\delta
 \qquad(g,h\in F_0)
\]
also satisfies $\opnorm{\phi(w)-1}<1$.
\leanverified{Sofic/LiteralUniformObstruction}{GroupApproximation.LiteralUniformObstruction.literal_uniform_operatorNorm_obstruction}
\end{corollary}

\begin{proof}
Fix an exhaustion $F_1\subseteq F_2\subseteq\cdots$ of $E$ by finite
sets.  If no such pair $(\delta,F_0)$ exists, then for each $n$ there
is a unitary-valued $\phi_n$ with multiplicative defect at most $1/n$
on $F_n$ and $\opnorm{\phi_n(w)-1}\ge1$.  The sequence $(\phi_n)$ is an
operator-norm asymptotic representation of $E$, so by
Lemma~\ref{lem:unitarycorona} its class is a homomorphism
$\Theta\colon E\to\U(\mathcal Q)$, and $\opnorm{\Theta(w)-1}\ge1$ gives
$\Theta(w)\ne1$, against Theorem~\ref{thm:A}.
\end{proof}

The argument is a diagonal one and bounds neither $\delta$ nor
$|F_0|$; whether an effective modulus follows from the rational
spectral certificate of Section~\ref{sec:group} is open.

\section{Consequences of the example}\label{sec:position}

Throughout, $d=tct^{-1}$ and $u=[d,\iota(v_1)]$, so that $w=u^2$.
Write $\operatorname{Res}_{\mathrm{MF}}(G)$ for the \emph{MF residual}
of a countable group $G$: the intersection of the kernels of all its
homomorphisms to $\U(\mathcal Q)$ (Definition~\ref{def:radical}).  Thus $G$ is MF
exactly when $\operatorname{Res}_{\mathrm{MF}}(G)=1$
(Proposition~\ref{prop:univquot}), and Theorem~\ref{thm:A} says
$w\in\operatorname{Res}_{\mathrm{MF}}(E)$ with $w\ne1$.

\subsection*{The quotient by the central involution}

\begin{mainthm}[the quotient of $E$ by $\langle w\rangle$]\label{thm:signfree}
The quotient $E/\langle w\rangle$ is not MF\@.  The image of
$[\iota(v_1),d]$, the inverse of the distinguished commutator $u$, is
nontrivial there and lies in
$\operatorname{Res}_{\mathrm{MF}}(E/\langle w\rangle)$; consequently
$\{1,w\}$ is a proper subgroup of
$\operatorname{Res}_{\mathrm{MF}}(E)$.
\leanverified{Sofic/LiteralSignFreeQuotient}{GroupApproximation.LiteralSignFreeQuotient.signFree_collapse}
\leanverified{Sofic/LiteralSignFreeQuotient}{GroupApproximation.LiteralSignFreeQuotient.signFreeQuotient_not_isCDEOperatorMF}
\leanverified{Sofic/LiteralSignFreeQuotient}{GroupApproximation.LiteralSignFreeQuotient.commutator_not_zpow_mark}
\end{mainthm}

\noindent
The proof is in Section~\ref{subsec:collapse}.
If an involution is
centralized by the conjugate copy of a Kazhdan subgroup, and its
conjugates under that subgroup commute with one another, then every
homomorphism to $\U(\mathcal Q)$ identifies the entire conjugation orbit
(Theorem~\ref{thm:collapse}, proved in
Section~\ref{subsec:collapse}).  In $E$ the pairwise commutators of those conjugates of $d$ lie in
$\langle w\rangle$, so in $E/\langle w\rangle$ the element $d$ satisfies
these hypotheses, and every homomorphism $E/\langle
w\rangle\to\U(\mathcal Q)$ maps $u$ to the identity.  Thus $E/\langle w\rangle$ is a
second finitely presented non-MF group, and Theorem~\ref{thm:A} does
not determine $\operatorname{Res}_{\mathrm{MF}}(E)$
(Section~\ref{sec:limits}).

\subsection*{A stably finite non-MF group algebra}
Every MF algebra is stably finite \cite{BK}; the converse fails.  The
canonical trace on $\Cred(E)$ is faithful, so $\Cred(E)$ is stably
finite (Lemma~\ref{lem:faithfultrace}), independently of the MF
question.
Abstract examples follow from the failure of the Connes embedding
problem \cite{FGH}; the reduced algebra of the finitely presented group
$E$ is an explicit one (Theorem~\ref{thm:D}).  For
$\Cred(\SL_3(\mathbb Z))$ and $\Cred(\SL_4(\mathbb Z))$ the MF
property is undecided; only the stronger PMF property is known to
fail, for $\SL_4(\mathbb Z)$ \cite{MdlS}.

% This prints as Theorem C, not Theorem D.  Cite \ref{thm:reduced}; `thm:D`
% is a legacy alias.  See the note at thm:exactfd.
\begin{mainthm}[the reduced group algebra of $E$]\label{thm:reduced}\label{thm:D}
$\Cred(E)$ is a unital separable $C^*$-algebra which has a
faithful tracial state --- and is therefore stably finite --- but is
not an MF algebra.
\leanverified{Sofic/LiteralNonMFEndpoint}{GroupApproximation.LiteralNonMFEndpoint.manuscriptTheoremD}
\end{mainthm}

\begin{proof}
$\Cred(E)$ is unital and separable because $E$ is countable, and by
Lemma~\ref{lem:faithfultrace} the canonical trace is faithful and the
algebra is therefore stably finite.  It is not an MF algebra by
Theorem~\ref{thm:A}.
\end{proof}

The algebra is not nuclear: the canonical map
$\mathcal B\to E$ is injective (Section~\ref{sec:witness}), so $E$
contains an infinite Kazhdan group and is nonamenable, whence
$\Cred(E)$ is not nuclear \cite{Lance}.  The nuclear form of the
Blackadar--Kirchberg problem --- whether every stably finite separable
nuclear $C^*$-algebra is quasidiagonal --- therefore remains open.
\leanverified{Analysis/NuclearityAmenability}{GroupApproximation.NuclearityAmenability.manuscriptNotAmenableOfBaseEmbeds}

\subsection*{A sofic example}
Let $X=G/\Gamma$ be the coset space of the ascending HNN extension $G=\Gamma_\infty\rtimes\Z$ used in the proof of
Theorem~\ref{thm:kazhdan-clifford}, at the affine data
\eqref{eq:affine-data}, and let
\[
 W=\Cl(X)\rtimes G
\]
be the Clifford group over it.  The homomorphism of that proof carrying
$w$ to $-1$ has target $W$; Section~\ref{sec:witness} realizes $W$ over
$\mathbb Q$, writing $\Sigma$ for $G$ in the explicit rational model.

% This prints as Theorem D, not Theorem E.  Cite \ref{thm:witnesssofic};
% `thm:E` is a legacy alias.  See the note at thm:exactfd.  The lettered
% Theorem E is thm:Esofic, further down this section.
\begin{mainthm}[a sofic non-MF group]\label{thm:witnesssofic}\label{thm:E}
The Clifford quotient $W=\Cl(X)\rtimes\Sigma$ of
Section~\ref{sec:witness} is a finitely generated sofic group that
is not MF; since sofic groups are hyperlinear, $W$ is likewise a
hyperlinear group that is not MF\@.  In particular, neither soficity nor
hyperlinearity implies the MF property.
\leanverified{Endpoint/NonMFImpact}{GroupApproximation.NonMFImpact.witness_sofic_hyperlinear_nonMF}
\end{mainthm}

\noindent
The proof is in Section~\ref{sec:algebras-sofic}.
The image of the doubling map has finite index, so every level of the
direct limit has finite orbits on $X$, every finite subset of
$\Cl(X)\rtimes\Gamma_\infty$ lies in a finite-by-sofic subgroup, and the
remaining $\Z$-extension is sofic by Elek--Szab\'o \cite{ElekSzabo}.
The surjection $E\to W$ sends $w$ to the nontrivial Clifford sign
$\zeta$, and $w\in\operatorname{Res}_{\mathrm{MF}}(E)$, so functoriality
(Lemma~\ref{lem:portable}) gives
$\zeta\in\operatorname{Res}_{\mathrm{MF}}(W)$ and $W$ is not MF.  This surjection does not
witness non-closure of MF under quotients: neither $E$ nor $W$ is MF,
so it exhibits no MF group with a non-MF quotient.  The witness for
that is $F_8\twoheadrightarrow E$, recorded in
Corollary~\ref{cor:quotclosure}.  The extension
$1\to\Cl(X)\to W\to\Sigma\to1$ does witness non-closure under
extensions, its kernel being locally finite and its quotient
residually finite, hence both MF, while $W$ is not
(Section~\ref{sec:algebras-sofic}).

Soficity of $E$ does not follow from soficity of $W$; it is proved
directly in Theorem~\ref{thm:Esofic}.  The adjoint spectral estimates of
the operator-norm method need operator-norm multiplicative control,
which permutation models do not supply, so that method implies neither
soficity nor nonsoficity for either group (Section~\ref{sec:limits}).

\begin{mainthm}[a finitely presented sofic non-MF group]\label{thm:Esofic}
The group $E$ of Definition~\ref{def:E} is sofic, hence hyperlinear.
Consequently $E$ is itself a finitely presented sofic group that is not
MF, and a finitely presented hyperlinear group that is not MF\@.  It is
also sofic and not LEF, and in particular not residually finite.
\leanverified{Sofic/LiteralSoficAssembly}{GroupApproximation.LiteralSoficAssembly.markedGroup_isSofic}
\leanverified{Sofic/LiteralSoficAssembly}{GroupApproximation.LiteralSoficAssembly.markedGroup_finitelyPresented_sofic_nonMF}
\leanverified{Sofic/LiteralSoficAssembly}{GroupApproximation.LiteralSoficAssembly.markedGroup_finitelyPresented_hyperlinear_nonMF}
\leanverified{Sofic/LiteralSoficAssembly}{GroupApproximation.LiteralSoficAssembly.markedGroup_sofic_not_isLEF_unconditional}
\end{mainthm}

\begin{proof}
Let $E_0$ be the kernel of the homomorphism $E\to\Z$ given by the
exponent sum in $t$.  Every finite subset of $E_0$ lies in a subgroup
generated by one level of the base together with finitely many
generators of the Clifford kernel.  Those generators span a finite
subgroup, because the doubling endomorphism has finite index and so
each level has finite orbits on the coset space; the resulting group is
a finite group extended by a level of the base, hence residually
finite.  So $E_0$ is a directed union of subgroups that embed in
residually finite groups, that is, LEF, and therefore sofic.  Now $E$
is a split extension of $E_0$ by $\Z$, and soficity passes through such
an extension by the argument used for Theorem~\ref{thm:E}; hence $E$ is
sofic, and hyperlinear because sofic groups are.  Failure of MF is
Theorem~\ref{thm:A}.  Finally, an LEF group is a limit of finite groups
in the space of marked groups, and Theorem~\ref{thm:markedclosed}
excludes a non-MF group from being such a limit, so $E$ is not LEF; a
residually finite group is LEF, so $E$ is not residually finite either.
\end{proof}

\clearpage
\begingroup
  \centering
  \bfseries\Large Supplementary material\par
\endgroup
\bigskip

\noindent
The supplement has four parts.  Sections~\ref{sec:group}--\ref{app:finite-stage} verify the explicit group and the two theorems the
main text applies to it.  Sections~\ref{supp:transport-variants}--\ref{sec:necessity} develop the transport argument in the generality it has, and
show that property~\textup{(T)} cannot be dropped.
Sections~\ref{supp:scaling}--\ref{sec:marked-horn} draw the consequences.
Sections~\ref{sec:limits}--\ref{app:p13} describe what the method does
not decide, and give two auxiliary constructions.

\setcounter{section}{0}
\renewcommand{\thesection}{S\arabic{section}}
\renewcommand{\theHsection}{supp.\arabic{section}}

\section{The base, and a smaller presentation}\label{sec:group}

The base $\mathcal B$ of \eqref{eq:gamma-presentation} is the affine
group $\mathbb Z^3\rtimes\SL_3(\mathbb Z)$
(Remark~\ref{rem:classical-base}), for which property~\textup{(T)} is
classical \cite[Example~1.7.4(i)]{BHV}.  It is proved below from the
displayed relators, by an exact rational spectral
certificate for an auxiliary Steinberg-type presentation, an explicit
surjection onto the linear presentation, and a passage from the linear
subgroup to the full base that produces an invariant vector from an
almost-invariant one.

\paragraph{Six generators suffice.}
The group $E$ is generated by the six elements $v_1,x,y,z,t,c$, and has
a Tietze-equivalent presentation on them with thirty-two relators.
\leanverified{Sofic/LiteralSixGenerator}{GroupApproximation.LiteralSixGenerator.literal_sixGenerated_finitelyPresented_nonMF}
\leanverified{Sofic/LiteralTietzePresentation}{GroupApproximation.LiteralTietzePresentation.manuscriptTietzeSixGeneratorPresentation}
In \eqref{eq:E}, eliminate $v_3=xv_1x^{-1}$ and $v_2=x^2v_1x^{-2}$ by
Tietze substitutions and delete the two defining relations; the
remaining $x$-action relation follows from $x^3=1$, and the
stable-letter, $c$-commutation, and centrality relations for $v_2,v_3$
follow from those for $v_1$ together with $[t,x]=1$ and $x^3=1$.
Deleting these nine leaves thirty-two relators on $v_1,x,y,z,t,c$.

Write $d=tct^{-1}$.  The displayed relations give
$[\,d,\,t\iota(\mathcal B)t^{-1}]=1$ and leave
$[\,d,\ \iota(v_1)\,d\,\iota(v_1)^{-1}]$ unconstrained
(Figure~\ref{fig:compression-pattern}).

\begin{figure}[htbp]
\centering
