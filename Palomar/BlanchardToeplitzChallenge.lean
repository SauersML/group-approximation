import Mathlib.Analysis.InnerProductSpace.l2Space
import Mathlib.Topology.ContinuousMap.Defs

/-!
# Blanchard's Question 5.4: the Toeplitz algebra of the Dixmier–Douady module

E. Blanchard, arXiv:1507.02535v1 (also arXiv:1312.7722v7), builds in the proof of
Proposition 4.3 (p. 6) a Hilbert `C(B_∞)`-module `E_DD` over the complex Hilbert cube, and asks
after Definition 5.1 (p. 9), verbatim:

> But is 𝒯(E_DD) properly infinite?

Blanchard defines a unital C*-algebra to be properly infinite when it "contains two isometries
with mutually orthogonal range projections" (p. 3).  The theorem `blanchard_question_5_4` below
answers **yes**.

## Vocabulary

* `HilbertCube` is `B_∞ = {x ∈ ℓ²(ℕ) ; ∑_p |x_p|² ≤ 1}` with the topology of Blanchard's metric
  `d((x_p),(y_p)) = ∑_p 2^{-p-2} |x_p - y_p|` (p. 6).  The metric is written `cubeDist`, and the
  topology is generated by its open balls.
* `K = ℓ²(Option ℕ)` is the fibre `ℓ²(ℕ) ⊕ ℂ`; the coordinate `none` is the summand `ℂ`.
* `Sections V` is the space of bounded maps `B_∞ → V` with the supremum norm.  A Hilbert
  `C(B_∞)`-module whose elements are sections of a field of Hilbert spaces is realised inside it,
  and its norm `‖⟨ξ,ξ⟩‖^{1/2}` is the supremum norm.
* `etaCoord x` is `η(x) = x ⊕ √(1 - ‖x‖²)` (p. 6).
* `moduleF` is `F̈ = [C(B_∞, ℓ²(ℕ) ⊕ 0) + C(B_∞)·η]`, the closed linear span (p. 6).
* `ddModule` is `E_DD = (1 - θ_{η,η})·F̈`, where `θ_{η,η} ζ = η ⟨η, ζ⟩` (p. 6).  Inner products
  are conjugate-linear in the first variable, as in Blanchard and in Mathlib.
* `Fock = ℓ²(List (Option ℕ))` is the full Fock space `⊕_m K^{⊗m}` of the fibre; a word of length
  `m` indexes a basis vector of `K^{⊗m}`.  `tensorCoord ζ ω` is `ζ ⊗ ω`.
* `fockModule E` is `F(E) = ⊕_m E^{⊗m}` with `E^{⊗0} = C(B_∞)` (Definition 5.1, p. 9), realised
  fibrewise: the closed linear span of the sections `x ↦ ζ₁(x) ⊗ ⋯ ⊗ ζ_m(x) f(x)`.  Because
  `C(B_∞)` is commutative and acts by multiplication, the interior tensor products are the
  pointwise tensor products.
* `IsSectionAdjoint T S` says `⟨T ξ, η⟩ = ⟨ξ, S η⟩` in `C(B_∞)`, that is, at every point.
* `toeplitzAlgebra E` is `𝒯(E)`, the unital C*-subalgebra of `ℒ(F(E))` generated by the creation
  operators `ℓ(ζ) ω = ζ ⊗ ω`, `ζ ∈ E` (Definition 5.1, p. 9).  It is written as the intersection
  of all sets of `C(B_∞)`-endomorphisms containing `1` and the creation operators and closed under
  sums, scalar multiples, products, adjoints and operator-norm limits.  Adjoints are unique and
  norm limits of adjointable operators are adjointable, so this intersection is `𝒯(E)`.
* `IsProperlyInfiniteSet 𝒜` says `𝒜` contains isometries `s₁, s₂` with adjoints `t₁, t₂`,
  `t₁ s₁ = t₂ s₂ = 1`, and orthogonal range projections, `(s₁ t₁)(s₂ t₂) = 0`.

The prose of this module was written by Claude (Anthropic).
-/

namespace BlanchardToeplitz

noncomputable section

open scoped ENNReal InnerProductSpace ComplexConjugate

-- BEGIN SHARED BLOCK (kept byte-identical in `Palomar/BlanchardToeplitzChallenge.lean` and `Palomar/BlanchardToeplitzSolution.lean`)

/-- The Hilbert space `ℓ²(ℕ)`. -/
abbrev L2 : Type := lp (fun _ : ℕ => ℂ) 2

/-- The complex Hilbert cube `B_∞`, the closed unit ball of `ℓ²(ℕ)` (Blanchard, p. 6). -/
def HilbertCube : Type := {x : L2 // ‖x‖ ≤ 1}

/-- Blanchard's metric `d((x_p),(y_p)) = ∑_p 2^{-p-2} |x_p - y_p|` on `B_∞` (p. 6). -/
def cubeDist (x y : HilbertCube) : ℝ :=
  ∑' p : ℕ, (2 : ℝ)⁻¹ ^ (p + 2) * ‖(x.1 : ℕ → ℂ) p - (y.1 : ℕ → ℂ) p‖

/-- The topology of `cubeDist`, generated by its open balls. -/
instance instTopologicalSpaceHilbertCube : TopologicalSpace HilbertCube :=
  TopologicalSpace.generateFrom {U | ∃ x : HilbertCube, ∃ r : ℝ, U = {y | cubeDist x y < r}}

/-- The fibre `ℓ²(ℕ) ⊕ ℂ`, with the summand `ℂ` at the coordinate `none`. -/
abbrev K : Type := lp (fun _ : Option ℕ => ℂ) 2

/-- Bounded sections `B_∞ → V` with the supremum norm. -/
abbrev Sections (V : Type) [NormedAddCommGroup V] : Type := lp (fun _ : HilbertCube => V) ∞

/-- The coordinates of `η(x) = x ⊕ √(1 - ‖x‖²)` (Blanchard, p. 6). -/
def etaCoord (x : HilbertCube) : Option ℕ → ℂ
  | none => (Real.sqrt (1 - ‖x.1‖ ^ 2) : ℂ)
  | some p => (x.1 : ℕ → ℂ) p

/-- `C(B_∞, ℓ²(ℕ) ⊕ 0)`: continuous sections with no component in the summand `ℂ`. -/
def continuousSections : Set (Sections K) :=
  {ξ | Continuous (fun x => (ξ x : K)) ∧ ∀ x, (ξ x : Option ℕ → ℂ) none = 0}

/-- `C(B_∞)·η`. -/
def etaMultiples : Set (Sections K) :=
  {ξ | ∃ f : C(HilbertCube, ℂ), ∀ x i, (ξ x : Option ℕ → ℂ) i = f x * etaCoord x i}

/-- `F̈ = [C(B_∞, ℓ²(ℕ) ⊕ 0) + C(B_∞)·η]`, a closed linear span (Blanchard, p. 6). -/
def moduleF : Submodule ℂ (Sections K) :=
  (Submodule.span ℂ (continuousSections ∪ etaMultiples)).topologicalClosure

/-- `E_DD = (1 - θ_{η,η})·F̈`, where `θ_{η,η} ζ = η ⟨η, ζ⟩` (Blanchard, proof of Prop. 4.3, p. 6). -/
def ddModule : Set (Sections K) :=
  {ζ | ∃ ξ ∈ moduleF, ∀ x i, (ζ x : Option ℕ → ℂ) i =
    (ξ x : Option ℕ → ℂ) i - (∑' j, conj (etaCoord x j) * (ξ x : Option ℕ → ℂ) j) * etaCoord x i}

/-- The full Fock space `⊕_m K^{⊗m}` of the fibre, indexed by words in `Option ℕ`. -/
abbrev Fock : Type := lp (fun _ : List (Option ℕ) => ℂ) 2

/-- The coordinates of `ζ ⊗ ω` for `ζ ∈ K` and `ω` in the Fock space. -/
def tensorCoord (ζ : Option ℕ → ℂ) (ω : List (Option ℕ) → ℂ) : List (Option ℕ) → ℂ
  | [] => 0
  | i :: w => ζ i * ω w

/-- The sections `ζ₁ ⊗ ⋯ ⊗ ζ_m ⊗ f` of `E^{⊗m}`, `ζ_i ∈ E`, `f ∈ C(B_∞) = E^{⊗0}`. -/
def fockGenerators (E : Set (Sections K)) : ℕ → Set (Sections Fock)
  | 0 => {ω | ∃ f : C(HilbertCube, ℂ), ∀ x w,
      (ω x : List (Option ℕ) → ℂ) w = if w = [] then f x else 0}
  | m + 1 => {ω | ∃ ζ ∈ E, ∃ ω' ∈ fockGenerators E m, ∀ x w,
      (ω x : List (Option ℕ) → ℂ) w =
        tensorCoord (ζ x : Option ℕ → ℂ) (ω' x : List (Option ℕ) → ℂ) w}

/-- The Fock module `F(E) = ⊕_m E^{⊗m}` (Blanchard, Definition 5.1, p. 9). -/
def fockModule (E : Set (Sections K)) : Submodule ℂ (Sections Fock) :=
  (Submodule.span ℂ (⋃ m, fockGenerators E m)).topologicalClosure

/-- `S` is the adjoint of `T`: `⟨T ξ, η⟩ = ⟨ξ, S η⟩` at every point of `B_∞`. -/
def IsSectionAdjoint {M : Submodule ℂ (Sections Fock)} (T S : Module.End ℂ M) : Prop :=
  ∀ ξ η : M, ∀ x, ⟪((T ξ : M) : Sections Fock) x, (η : Sections Fock) x⟫_ℂ =
    ⟪(ξ : Sections Fock) x, ((S η : M) : Sections Fock) x⟫_ℂ

/-- The Toeplitz algebra `𝒯(E)`: the unital C*-algebra of operators on `F(E)` generated by the
creation operators `ℓ(ζ) ω = ζ ⊗ ω`, `ζ ∈ E` (Blanchard, Definition 5.1, p. 9). -/
def toeplitzAlgebra (E : Set (Sections K)) : Set (Module.End ℂ (fockModule E)) :=
  ⋂₀ {𝒯 | 1 ∈ 𝒯 ∧
    (∀ ζ ∈ E, ∀ T : Module.End ℂ (fockModule E), (∀ ω x w,
      (((T ω : fockModule E) : Sections Fock) x : List (Option ℕ) → ℂ) w =
        tensorCoord (ζ x : Option ℕ → ℂ) ((ω : Sections Fock) x : List (Option ℕ) → ℂ) w) →
      T ∈ 𝒯) ∧
    (∀ S ∈ 𝒯, ∀ T ∈ 𝒯, S + T ∈ 𝒯) ∧
    (∀ c : ℂ, ∀ T ∈ 𝒯, c • T ∈ 𝒯) ∧
    (∀ S ∈ 𝒯, ∀ T ∈ 𝒯, S * T ∈ 𝒯) ∧
    (∀ T ∈ 𝒯, ∀ S, IsSectionAdjoint T S → S ∈ 𝒯) ∧
    (∀ T : Module.End ℂ (fockModule E), (∀ ε > (0 : ℝ), ∃ S ∈ 𝒯, ∀ ω,
      ‖((T ω : fockModule E) : Sections Fock) - ((S ω : fockModule E) : Sections Fock)‖ ≤
        ε * ‖(ω : Sections Fock)‖) → T ∈ 𝒯)}

/-- A set of operators is properly infinite when it contains two isometries with mutually
orthogonal range projections (Blanchard, p. 3). -/
def IsProperlyInfiniteSet {M : Submodule ℂ (Sections Fock)} (𝒜 : Set (Module.End ℂ M)) : Prop :=
  ∃ s₁ ∈ 𝒜, ∃ s₂ ∈ 𝒜, ∃ t₁ t₂ : Module.End ℂ M, IsSectionAdjoint s₁ t₁ ∧
    IsSectionAdjoint s₂ t₂ ∧ t₁ * s₁ = 1 ∧ t₂ * s₂ = 1 ∧ (s₁ * t₁) * (s₂ * t₂) = 0

-- END SHARED BLOCK

/-- **Blanchard's Question 5.4** (arXiv:1507.02535v1, p. 9): the Toeplitz algebra `𝒯(E_DD)` of
the Dixmier–Douady module is properly infinite. -/
theorem blanchard_question_5_4 : IsProperlyInfiniteSet (toeplitzAlgebra ddModule) := by
  sorry

end

end BlanchardToeplitz
