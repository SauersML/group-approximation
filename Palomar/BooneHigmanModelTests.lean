import Palomar.BooneHigmanSolution
import GroupApproximation.BooneHigman.Statement.ModelTests

/-!
# Model tests for the Boone–Higman megasubmission shared block

Definitions of the shared block of `Palomar/BooneHigmanChallenge.lean` are tested on positive
and negative models, so that a vacuous or always-true definition cannot pass. The copies tested
here are the solution's, which are byte-identical to the challenge's.

* `IsMetabelianGroup`: `ℤ` and `S₃` are metabelian; `S₅` is not.
* `EmbedsInFinitelyPresentedSimpleGroup`: `A₅` embeds in itself; `ℝ` embeds in no finitely
  presented simple group, because a finitely presented group is countable.
* `IsSelfSimilar`: the trivial group is self-similar; the group generated by a transposition
  of two vertices of different depths is not, since it does not preserve lengths.
* `IsClassTransposition`: the identity is not a class transposition.
* `IsResidueClassWiseAffine`: the identity is residue-class-wise affine.
* `mixedIdentities`: a nontrivial constant is never a mixed identity.

Not yet tested here: that `LeavittResolventRing` is nonzero (it has a faithful module on
finitely supported functions of infinite words; see the development) and that the Steinberg
relations do not collapse `SteinbergGroup`.

The prose of this module was written by Claude (Anthropic), under the user's direction.
-/

namespace BooneHigman.ModelTests

open Equiv

/-- **Positive model.** `ℤ`, a commutative group, is metabelian. -/
theorem multiplicative_int_isMetabelianGroup : IsMetabelianGroup (Multiplicative ℤ) :=
  isMetabelianGroup_iff.mpr (GroupApproximation.BooneHigman.isMetabelianGroup_of_commute mul_comm)

/-- **Positive model.** `S₃`, which is not commutative, is metabelian. -/
theorem perm_three_isMetabelianGroup : IsMetabelianGroup (Perm (Fin 3)) :=
  isMetabelianGroup_iff.mpr GroupApproximation.BooneHigman.ModelTests.perm_three_isMetabelianGroup

/-- **Negative model.** `S₅` is not metabelian. -/
theorem perm_five_not_isMetabelianGroup : ¬ IsMetabelianGroup (Perm (Fin 5)) := fun h ↦
  GroupApproximation.BooneHigman.ModelTests.perm_five_not_isMetabelianGroup
    (isMetabelianGroup_iff.mp h)

/-- **Positive model.** `A₅` embeds in a finitely presented simple group. -/
theorem alternatingGroup_five_embeds :
    EmbedsInFinitelyPresentedSimpleGroup (alternatingGroup (Fin 5)) :=
  embedsInFinitelyPresentedSimpleGroup_iff.mpr
    GroupApproximation.BooneHigman.ModelTests.alternatingGroup_five_embeds

/-- **Negative model.** `ℝ` embeds in no finitely presented simple group. -/
theorem multiplicative_real_not_embeds :
    ¬ EmbedsInFinitelyPresentedSimpleGroup (Multiplicative ℝ) := fun h ↦
  GroupApproximation.BooneHigman.ModelTests.multiplicative_real_not_embeds
    (embedsInFinitelyPresentedSimpleGroup_iff.mp h)

/-- **Positive model.** The trivial group of tree automorphisms is self-similar. -/
theorem bot_isSelfSimilar (d : ℕ) :
    IsSelfSimilar (⊥ : Subgroup (Equiv.Perm (List (Fin d)))) := by
  intro g hg
  rw [Subgroup.mem_bot] at hg
  subst hg
  exact ⟨fun _ => rfl, fun _ => ⟨1, Subgroup.one_mem _, fun _ => rfl⟩⟩

/-- **Negative model.** Swapping the root with a vertex of depth one does not preserve lengths,
so the group it generates is not self-similar. -/
theorem swap_root_not_isSelfSimilar :
    ¬ IsSelfSimilar (Subgroup.closure {Equiv.swap ([] : List (Fin 1)) [0]}) := by
  intro h
  have hlen := (h (Equiv.swap ([] : List (Fin 1)) [0])
    (Subgroup.subset_closure (Set.mem_singleton _))).1 []
  simp at hlen

/-- **Negative model.** The identity is not a class transposition: it would have to move
`r₁` to `r₂`, which lies in a disjoint class. -/
theorem one_not_isClassTransposition : ¬ IsClassTransposition 1 := by
  rintro ⟨r₁, m₁, r₂, m₂, -, -, -, -, hdisj, hswap, -⟩
  have h := (hswap 0).1
  apply hdisj 0 0
  simpa using h

/-- **Positive model.** The identity is residue-class-wise affine. -/
theorem one_isResidueClassWiseAffine : IsResidueClassWiseAffine 1 :=
  ⟨1, one_pos, fun _ => ⟨1, 0, 1, one_ne_zero, fun _ => by simp⟩⟩

/-- **Negative model.** A nontrivial constant `g ∈ G` is not a mixed identity of `G`: the
homomorphism `G ∗ F_n → G` that is the identity on `G` and trivial on `F_n` does not kill it. -/
theorem inl_not_mem_mixedIdentities {G : Type} [Group G] (n : ℕ) {g : G} (hg : g ≠ 1) :
    Monoid.Coprod.inl g ∉ mixedIdentities G n := by
  intro h
  simp only [mixedIdentities, Subgroup.mem_iInf, MonoidHom.mem_ker] at h
  have := h (Monoid.Coprod.lift (MonoidHom.id G) 1) (Monoid.Coprod.lift_comp_inl _ _)
  rw [Monoid.Coprod.lift_apply_inl] at this
  exact hg this

end BooneHigman.ModelTests
