# Site configuration for scripts/remote-build.sh.
#
# Copy to scripts/remote-build.env and fill in.  That file is gitignored: it
# names one person's cluster account, which is an affiliation detail rather
# than repository knowledge, and this repository is public.  Nothing here is a
# credential -- authentication is the wrapper's job -- so a wrong value fails
# loudly rather than leaking anything.
#
# Every variable may also be supplied through the environment, which wins over
# this file.

# Path to the ssh wrapper that owns the ControlMaster and the Duo cooldown.
# remote-build.sh never touches the auth lock itself; it calls `<wrapper> true`
# to self-heal an expired master and `<wrapper> up` to re-establish one.
MSI_WRAPPER=

# The local checkout that gets synced FROM.  No trailing slash.
MSI_LOCAL_ROOT=

# The warm build directory on the cluster that gets synced TO, holding the
# multi-gigabyte .lake olean cache.  Never put this on a RAM-backed filesystem.
# No trailing slash.
MSI_REMOTE_ROOT=

# ssh ControlMaster socket, shared with the wrapper.
MSI_SSH_SOCKET=

# HostKeyAlias for the login node, so the socket and the rsync agree on
# which host key they are checking.
MSI_SSH_ALIAS=

# Cluster username, used as the rsync remote user.
MSI_USER=

# Login host that rsync connects to.  An address or a name; it must match
# whatever the ControlMaster socket was established against.
MSI_LOGIN_HOST=
