import Palomar.Solution
import Lean.Elab.Command

/-!
# Elaborated signature of the Palomar theorem

This script elaborates the theorem named by the Palomar claim roster and writes
its type, pretty-printed by Lean, to the committed signature snapshot. A theorem
that keeps its name while changing its statement therefore fails CI on the
generated diff.

Run after a build:

    lake env lean scripts/Signatures.lean

then commit the regenerated `metadata/CLAIM_SIGNATURES.md`. CI runs the same
command and requires the committed file to match.
-/

open Lean Elab Command

namespace GroupApproximation.Signatures

/-- Header shared by both generated signature snapshots. -/
def header (declsPath : System.FilePath) : String :=
  "<!-- generated by `lake env lean scripts/Signatures.lean`; do not edit \
by hand -->\n\n\
# Elaborated type of the Palomar theorem\n\n\
One entry per declaration named by `" ++ toString declsPath ++ "`. The types \
are printed by Lean from the elaborated environment, so this file records what \
each declaration actually states beyond name resolution.\n"

/-- Elaborate one generated declaration roster and write its signature file. -/
def writeSignatures (env : Environment) (declsPath outPath : System.FilePath) :
    CommandElabM Nat := do
  let input ← IO.FS.readFile declsPath
  let names := input.splitOn "\n" |>.map (fun s => s.trimAscii.toString)
      |>.filter (· ≠ "")
  if names.isEmpty then
    throwError "{declsPath}: no declarations listed"
  let mut sections : Array String := #[header declsPath]
  for s in names do
    let n := s.toName
    let some info := env.find? n
      | throwError "mapped declaration `{s}` is not in the environment; \
the lexical index and the elaborated library disagree"
    let fmt ← liftTermElabM <| Lean.Meta.ppExpr info.type
    sections := sections.push
      s!"\n## `{s}`\n\n```lean\n{fmt.pretty 96}\n```\n"
  IO.FS.writeFile outPath (String.join sections.toList)
  return names.length

run_cmd do
  let env ← getEnv
  let jobs : List (System.FilePath × System.FilePath) :=
    [("metadata" / "CLAIM_DECLS.txt", "metadata" / "CLAIM_SIGNATURES.md")]
  for (declsPath, outPath) in jobs do
    let count ← writeSignatures env declsPath outPath
    logInfo m!"wrote {outPath} ({count} declarations)"

end GroupApproximation.Signatures
