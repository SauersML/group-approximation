digraph LiuCairn {
  graph [rankdir=TB, newrank=true, bgcolor="#ffffff", pad="0.3", nodesep="0.38", ranksep="0.52", splines=polyline, fontname="Helvetica", fontsize=22, labelloc=t, label="Liu → Cairn: one analytic theorem, two group routes\nIntegrated conditional consequences · 20 September 2026"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.17,0.13", fillcolor="#f5f7fa", color="#bbc5cf", fontcolor="#152b3c"];
  edge [fontname="Helvetica", fontsize=10, color="#687889", fontcolor="#465767", arrowsize=0.65];

  subgraph cluster_analytic {
    label="JIHAO LIU · Nonhyperlinear groups exist · §§3–6"; fontsize=14; fontcolor="#664589"; color="#d6c6e5"; style=rounded; margin=17;
    inputs [label="§§3–5 · four open analytic imports\nRelative repair + in-place rounding\nResolvent covariance / leakage + pruning", fillcolor="#f4edfa"];
    blocks [label="Theorem 5.1 · large physical blocks\nFix tolerance first; gap may depend on it\nOriginal dimensions; doubled nearby generators", fillcolor="#f4edfa"];
    inputs -> blocks [label="conditional assembly"];
    match [label="§6 · matching and exhaustion\nUnequal ranks → coherent multiplicity algebras\nDiagonalize expectations, not spectral gaps", fillcolor="#f4edfa"];
    blocks -> match;
    expect [label="Proposition 3.1 · expectation lift\nFull bounded-sequence uniformity\nWritten proof independently checked", fillcolor="#edf6ef", color="#96b79e"];
    expect -> match [label="shared uniformity input"];
    internal [label="LIU THEOREM 1.2 / 6.7 · OPEN / UNDER REVIEW\nEvery Kazhdan commutant is internal\nNo injectivity or regular-trace assumption", fillcolor="#e9dcf4", color="#9770ba", penwidth=1.7, fontsize=15];
    match -> internal;
  }

  subgraph cluster_kt {
    label="COMPRESSION / KUN–THOM ROUTE"; fontsize=13; fontcolor="#465767"; color="#d5dde5"; style=rounded; margin=17;
    norm [label="All-trace compression normalization\n+ conditional normalization theorem\nThom priority; Liu Theorem 7.4", fillcolor="#fff3df", color="#c6a15f"];
    uniform [label="Uniform finite-window compression\nRules out CE normalization countermodels", fillcolor="#fff3df", color="#c6a15f"];
    wreath [label="Kun–Thom binary wreaths\nDistinct lamps collapse in every model\n⇒ nonhyperlinear", fillcolor="#fff3df", color="#c6a15f"];
    double [label="Group double is nonhyperlinear\n+ recorded wreath / double equivalence", fillcolor="#fff3df", color="#c6a15f"];
    reduced [label="Reduced C*-algebra is not MF\n+ unique-trace input for q = 2\nDoes NOT refute group weak MF", fillcolor="#fff3df", color="#c6a15f"];
    norm -> uniform;
    norm -> wreath;
    wreath -> double -> reduced;
  }

  subgraph cluster_leavitt {
    label="CAIRN'S LEAVITT APPLICATION OF LIU'S THEOREM"; fontsize=13; fontcolor="#465767"; color="#d5dde5"; style=rounded; margin=17;
    heat [label="Sequential Kazhdan heat rounding\n+ fixed SOS / admissible-time argument\nNOT arbitrary-channel rounding", fillcolor="#fff3df", color="#c6a15f"];
    two [label="Earlier Cairn two-use argument\nGlobal heat: select scalar commutant\nNative heat: nonzero central witness", shape=hexagon, fillcolor="#edf6ef", color="#96b79e"];
    leavitt [label="Binary Leavitt unit group\nH = L_(F₂)(1,2)× is nonhyperlinear", fillcolor="#fff3df", color="#c6a15f"];
    stable [label="Existing stable Steinberg branch\n+ recorded stability equivalence", fillcolor="#fff3df", color="#c6a15f"];
    boundary [label="Characteristic-two boundary groups\n+ recorded embedding / equivalence", fillcolor="#fff3df", color="#c6a15f"];
    fp [label="The SAME H is finitely presented,\ninfinite simple, Kazhdan, nonhyperlinear\n+ Khanh and existing structural inputs", fillcolor="#fff3df", color="#c6a15f"];
    heat -> two -> leavitt;
    leavitt -> stable;
    leavitt -> boundary;
    leavitt -> fp;
  }

  internal -> norm;
  internal -> heat;
  {rank=same; norm; heat;}
  {rank=same; wreath; leavitt;}
  root [label="EXISTING CAIRN ROOT · STILL OPEN\nExhibit an explicit nonhyperlinear group", fillcolor="#243e52", color="#243e52", fontcolor="#ffffff", fontsize=16];
  wreath -> root [constraint=false];
  fp -> root;
  stable -> root;
  {rank=same; reduced; boundary; fp;}
  legend [shape=plaintext, style="", fontsize=11, fontcolor="#566675", label="Purple: Liu's analytic results; long imports remain open.\nGreen: checked / existing written implications. Amber: conditional conclusions.\nArrows condense named Cairn routes with their stated extra inputs.\nCredit: Jihao Liu (analytic theorem); Andreas Thom (conditional normalization);\nKun–Thom (pair and lamps). Leavitt: Cairn's conditional application of Liu.\nNo full-paper or Lean certification claimed."];
  root -> legend [style=invis];
}
