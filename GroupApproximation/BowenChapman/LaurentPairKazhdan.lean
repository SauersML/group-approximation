import GroupApproximation.BowenChapman.LaurentPair
import GroupApproximation.Kazhdan.SemidirectProductKazhdan
import GroupApproximation.PropertyT.IntegralColumnPlaneClosure
import Mathlib.RingTheory.FiniteType

/-!
# Property `(T)` for the Bowen--Chapman pair

The ambient group `Ambient = EL₃(𝔽₂[ℤ³]) ⋊ EL₃(ℤ)` and its peripheral subgroup
`Peripheral`, the image of `EL₃(𝔽₂[ℕ³])`, both have property `(T)`.

The coefficient rings `𝔽₂[ℤ³]`, `𝔽₂[ℕ³]` and `ℤ` are finitely generated rings,
so `EL₃` over each of them has property `(T)` by
`IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT`,
the Ershov--Jaikin-Zapirain theorem as proved in this repository.  The ambient
group is a semidirect product of two of these groups, so
`HasKazhdanPropertyT.semidirectProduct` applies.  The peripheral subgroup is
isomorphic to `EL₃(𝔽₂[ℕ³])` because the peripheral embedding is injective.
-/

namespace GroupApproximation.BowenChapman

/-- `𝔽₂[ℤ³]` is a finitely generated ring. -/
theorem isFinitelyGeneratedRing_laurent : IsFinitelyGeneratedRing Laurent :=
  (isFinitelyGeneratedRing_iff_finiteType_zmod 2 Laurent).mpr
    (AddMonoidAlgebra.finiteType_of_fg (ZMod 2) (Fin 3 → ℤ))

/-- `𝔽₂[ℕ³]` is a finitely generated ring. -/
theorem isFinitelyGeneratedRing_poly : IsFinitelyGeneratedRing Poly :=
  (isFinitelyGeneratedRing_iff_finiteType_zmod 2 Poly).mpr
    (AddMonoidAlgebra.finiteType_of_fg (ZMod 2) (Fin 3 → ℕ))

/-- `ℤ` is a finitely generated ring, generated by the empty set. -/
theorem isFinitelyGeneratedRing_int : IsFinitelyGeneratedRing ℤ := by
  refine ⟨∅, ?_⟩
  rw [Subring.eq_top_iff']
  intro x
  exact intCast_mem (Subring.closure ((∅ : Finset ℤ) : Set ℤ)) x

/-- `EL₃(𝔽₂[ℤ³])` has property `(T)`. -/
theorem laurentElementary_hasKazhdanPropertyT :
    HasKazhdanPropertyT.{0, 0} ↥(elementaryGroup (Fin 3) Laurent) :=
  IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT
    Laurent isFinitelyGeneratedRing_laurent 3 le_rfl

/-- `EL₃(𝔽₂[ℕ³])` has property `(T)`. -/
theorem polyElementary_hasKazhdanPropertyT :
    HasKazhdanPropertyT.{0, 0} ↥(elementaryGroup (Fin 3) Poly) :=
  IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT
    Poly isFinitelyGeneratedRing_poly 3 le_rfl

/-- The actor `EL₃(ℤ)` has property `(T)`. -/
theorem actor_hasKazhdanPropertyT : HasKazhdanPropertyT.{0, 0} Actor :=
  IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT
    ℤ isFinitelyGeneratedRing_int 3 le_rfl

/-- **The ambient group has property `(T)`.** -/
theorem ambient_hasKazhdanPropertyT : HasKazhdanPropertyT.{0, 0} Ambient :=
  HasKazhdanPropertyT.semidirectProduct laurentElementary_hasKazhdanPropertyT
    actor_hasKazhdanPropertyT

/-- **The peripheral subgroup has property `(T)`.** -/
theorem peripheral_hasKazhdanPropertyT : HasKazhdanPropertyT.{0, 0} ↥Peripheral :=
  HasKazhdanPropertyT.of_mulEquiv
    (MonoidHom.ofInjective peripheralHom_injective).symm
    polyElementary_hasKazhdanPropertyT

end GroupApproximation.BowenChapman
