import GroupApproximation.CharClass.ProjectiveSpaceRingBootstrap

/-!
# The ring of `ℂP^d`, unconditionally

`ProjectiveSpaceRingBootstrap` carries one hypothesis, that the chart's section is
the zero section.  `cc-bundle`'s `chartOpensHomotopyEquivBase_invFun_apply` is that
statement, so it discharges here and the ring is unconditional.

These are the two statements published to `cc-cohom-api` and frozen.  Together with
what was already green — vanishing in the odd degrees and above the top, and each
even group a line — they are `F₂[h]/(h^{d+1})` in element form.

## Main declarations

* `isZeroSectionChart` — the chart's section is the zero section.
* `cupPowE_cpGen_ne_zero` — **the powers of the generator are nonzero**.
* `eq_zero_or_eq_cupPowE_cpGen` — **and each even group is exactly them**.
* `cpGenHyp` — `cc-cohom-api`'s generation hypothesis, unconditionally.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace GroupApproximation
namespace CharClass

open CategoryTheory

noncomputable section

namespace Gysin

variable {X : Type} [TopologicalSpace X] {ι : Type} [Fintype ι] [DecidableEq ι]

/-- **The chart's section is the zero section**, from `cc-bundle`. -/
theorem isZeroSectionChart (p : Bundle X ι) : IsZeroSectionChart p :=
  TopCat.hom_ext (ContinuousMap.ext fun x =>
    Bundle.chartOpensHomotopyEquivBase_invFun_apply p x)

end Gysin

namespace CPn

/-- **The powers of the generator of `H^*(ℂP^d; F₂)` are nonzero**, up to the
dimension.  The first half of the ring, and the frozen interface. -/
theorem cupPowE_cpGen_ne_zero (d : ℕ) (hd : 1 ≤ d) {m : ℕ} (hm : m ≤ d) :
    cupPowE (cpGen d hd) m ≠ 0 :=
  cupPowE_cpGen_ne_zero_of_chart d hd (Gysin.isZeroSectionChart (cpTaut d)) hm

/-- **Each even group up to the top is exactly the two-element set generated by the
corresponding power.**  The second half of the ring, and the frozen interface. -/
theorem eq_zero_or_eq_cupPowE_cpGen (d : ℕ) (hd : 1 ≤ d) {m : ℕ} (hm : m ≤ d)
    (a : Hmod2 (CPtop d) (2 * m)) : a = 0 ∨ a = cupPowE (cpGen d hd) m :=
  eq_zero_or_eq_cupPowE_cpGen_of_chart d hd (Gysin.isZeroSectionChart (cpTaut d)) hm a

/-- **`cc-cohom-api`'s generation hypothesis**, unconditionally. -/
theorem cpGenHyp (d : ℕ) : KnCP.CPGenHyp d :=
  cpGenHyp_of_chart d fun _ => Gysin.isZeroSectionChart (cpTaut d)

end CPn

end

end CharClass
end GroupApproximation
