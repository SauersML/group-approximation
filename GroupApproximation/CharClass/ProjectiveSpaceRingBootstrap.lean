import GroupApproximation.CharClass.GysinTautFields
import GroupApproximation.CharClass.GysinPairRetract
import GroupApproximation.CharClass.GysinRanged
import GroupApproximation.CharClass.LerayHirschPlusOneClosed
import GroupApproximation.CharClass.GysinFromGraded
import GroupApproximation.CharClass.ProjectiveSpaceGenHyp

/-!
# The ring of `ℂP^d`, from the Gysin sequence of the tautological line

Everything the bootstrap needs is now in place, and this file spends it.

The Gysin step runs against the class the complement's reading produces, whatever
that class is.  No identification is attempted, and that is the trick: the argument
then *proves* the class is nonzero, in its own first power, and `H²(ℂP^d;F₂)` is a
line, so the class is the generator with nothing to compute.  Identifying it up
front would have needed the Euler class to be independent of the coordinate
embedding, which is a real theorem about isometric embeddings of projective spaces
and is not in the repo.

The circularity the lane hit repeatedly is broken the same way: the top power is
never asked for.  The pair of restrictions is used only in degrees `2` through `2d`,
which is exactly where the sphere bundle `S^{2d+1}` is acyclic, and the powers walk
up from the unit rather than down from the top.

One input is open, `Gysin.IsZeroSectionChart`, which says the chart's section is the
zero section.  It is `cc-bundle`'s and is the mirror of a statement they already
have; every result here carries it as a hypothesis and discharges in one line when
it lands.

## Main declarations

* `cupPowE_cpGen_ne_zero_of_chart` — **the powers of the generator are nonzero**.
* `eq_zero_or_eq_cupPowE_cpGen_of_chart` — **each even group is exactly them**.
* `cpGenHyp_of_chart` — `cc-cohom-api`'s generation hypothesis.
-/

set_option autoImplicit false

namespace GroupApproximation
namespace CharClass
namespace CPn

open CategoryTheory

noncomputable section

/-- **The powers of the generator are nonzero**, up to the dimension.

The class the Gysin step runs against is the complement's reading of the
tautological class.  Its first power is nonzero by the step itself, so it *is* the
generator, and the statement transfers. -/
theorem cupPowE_cpGen_ne_zero_of_chart (d : ℕ) (hd : 1 ≤ d)
    (hsec : Gysin.IsZeroSectionChart (cpTaut d)) {m : ℕ} (hm : m ≤ d) :
    cupPowE (cpGen d hd) m ≠ 0 := by
  classical
  have L := LH.lerayHirschGraded_plusOne_tautEuler (cpTaut d) (trace_cpTaut d)
  have hpow : ∀ j : ℕ, j ≤ d →
      cupPowE (Gysin.rNotZero (cpTaut d) (trace_cpTaut d) 2 (LH.tautEuler (cpTaut d))) j
        ≠ 0 := by
    intro j hj
    refine Gysin.cupPowE_ne_zero_of_pieces (Gysin.gysinProj (cpTaut d))
      (LH.tautEuler (cpTaut d))
      (Gysin.rChart (cpTaut d)) (Gysin.rNotZero (cpTaut d) (trace_cpTaut d))
      (Gysin.rChart_pull (cpTaut d))
      (Gysin.rNotZero_pull (cpTaut d) (trace_cpTaut d)) ?_ ?_ d ?_ ?_ ?_
      (one_ne_zero_cohZero (CPtop d)) hj
    · intro k b
      rw [Gysin.rChart_cup, Gysin.rChart_tautEuler (cpTaut d) hsec, cup_zero]
    · intro k b
      exact Gysin.rNotZero_cup (cpTaut d) (trace_cpTaut d) k b (LH.tautEuler (cpTaut d))
    · intro j' hj'
      exact Gysin.bijective_pair_cpTaut d j' hj'
    · intro n z
      exact LH.lh_surj_of_graded L n z
    · intro n a b h
      exact LH.lh_uniq_of_graded L n a b h
  have hne : Gysin.rNotZero (cpTaut d) (trace_cpTaut d) 2 (LH.tautEuler (cpTaut d)) ≠ 0 := by
    have h1 := hpow 1 hd
    rwa [LH.cupPowE_one] at h1
  have hgen : Gysin.rNotZero (cpTaut d) (trace_cpTaut d) 2 (LH.tautEuler (cpTaut d))
      = cpGen d hd := eq_cpGen_of_ne_zero hd hne
  rw [← hgen]
  exact hpow m hm

/-- **Each even group up to the top is exactly the two-element set generated by the
corresponding power.** -/
theorem eq_zero_or_eq_cupPowE_cpGen_of_chart (d : ℕ) (hd : 1 ≤ d)
    (hsec : Gysin.IsZeroSectionChart (cpTaut d)) {m : ℕ} (hm : m ≤ d)
    (a : Hmod2 (CPtop d) (2 * m)) : a = 0 ∨ a = cupPowE (cpGen d hd) m :=
  eq_zero_or_eq_cupPowE_cpGen_of_ne d hd hm
    (cupPowE_cpGen_ne_zero_of_chart d hd hsec hm) a

/-- **`cc-cohom-api`'s generation hypothesis.** -/
theorem cpGenHyp_of_chart (d : ℕ)
    (hsec : ∀ _hd : 1 ≤ d, Gysin.IsZeroSectionChart (cpTaut d)) : KnCP.CPGenHyp d :=
  cpGenHyp_of_cupPowE_ne_zero d
    (fun hd _ hm => cupPowE_cpGen_ne_zero_of_chart d hd (hsec hd) hm)

end

end CPn
end CharClass
end GroupApproximation
