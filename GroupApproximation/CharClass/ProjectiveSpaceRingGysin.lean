import GroupApproximation.CharClass.ProjectiveSpaceGenHyp
import GroupApproximation.CharClass.GysinFromLerayHirsch

/-!
# The ring of `ℂP^d`, from a Gysin structure

The last step of the bootstrap, and it is short: a `GysinData` for the
tautological line gives that cupping with the generator is bijective in every
degree, and walking up the even degrees from the unit turns that into the
non-vanishing of every power up to the dimension.  The group statement follows
because each even group is a line.

Together with what is already green, vanishing in the odd and the high degrees,
this is `F₂[h]/(h^{d+1})` in element form, and it is exactly the interface
published to `cc-cohom-api` and frozen.

Nothing here knows about bundles: the geometry is entirely inside the `GysinData`
argument, so the moment one exists for the tautological line the ring follows.

## Main declarations

* `cupPowE_cpGen_ne_zero_of_gysin` — **the powers are nonzero**.
* `eq_zero_or_eq_cupPowE_cpGen_of_gysin` — **and each even group is exactly them**.
* `cpGenHyp_of_gysin` — and hence `cc-cohom-api`'s generation hypothesis.
-/

set_option autoImplicit false

namespace GroupApproximation
namespace CharClass
namespace CPn

open CategoryTheory

noncomputable section

variable {P : TopCat.{0}}

/-- **The powers of the generator are nonzero**, from a Gysin structure for the
tautological line. -/
theorem cupPowE_cpGen_ne_zero_of_gysin (d : ℕ) (hd : 1 ≤ d)
    (G : GysinData (CPtop d) P (cpGen d hd)) {m : ℕ} (hm : m ≤ d) :
    cupPowE (cpGen d hd) m ≠ 0 :=
  cupPowE_ne_zero_of_bijective d (fun m _ => G.bijective_cupRight (2 * m))
    (one_ne_zero_cohZero (CPtop d)) hm

/-- **Each even group up to the top is exactly the two-element set generated by the
corresponding power.** -/
theorem eq_zero_or_eq_cupPowE_cpGen_of_gysin (d : ℕ) (hd : 1 ≤ d)
    (G : GysinData (CPtop d) P (cpGen d hd)) {m : ℕ} (hm : m ≤ d)
    (a : Hmod2 (CPtop d) (2 * m)) : a = 0 ∨ a = cupPowE (cpGen d hd) m :=
  eq_zero_or_eq_cupPowE_cpGen_of_ne d hd hm
    (cupPowE_cpGen_ne_zero_of_gysin d hd G hm) a

/-- **`cc-cohom-api`'s generation hypothesis**, from a Gysin structure. -/
theorem cpGenHyp_of_gysin (d : ℕ)
    (G : ∀ hd : 1 ≤ d, GysinData (CPtop d) P (cpGen d hd)) : KnCP.CPGenHyp d :=
  cpGenHyp_of_cupPowE_ne_zero d
    (fun hd _ hm => cupPowE_cpGen_ne_zero_of_gysin d hd (G hd) hm)

end

end CPn
end CharClass
end GroupApproximation
