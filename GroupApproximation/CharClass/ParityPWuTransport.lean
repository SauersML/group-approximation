import GroupApproximation.CharClass.ParityPWuComponent

/-!
# The field (W) of `ParityPData` from a split family of Chern roots

Lane `lix-evenside` (successor of `sp-evenside`), `sp-design` §3.3 L4a, transported.

`ParityPWuComponent.isDecomposable_wuRHSP` is the diagonal Wu relation for the universal
family of roots `X_0, …, X_{n−1}` over `ℤ`.  This file carries it to an actual split family:
`ParityPWuCartan.PowerData` on a commutative ring `A` with roots `y` indexed by a finset `s`,
and a ring `H` of Chern classes embedded in `A` by an injective ring hom `ρ` (the splitting
principle).  The conclusion is exactly the field `wu` of `ParityPData`:

```text
  P^i(γ_{i+1}) − c_i·γ_{ip+1}  ∈  IsDecomposable γ (ip+1),     c_i = m^i·(−1)^{i+ip}·(ip+1),
```

where `κ = m` is the normalisation constant of `P(h) = h + κ·h^p`, and `c_i` is a unit as soon
as `p = 0` in the coefficients and `m` is a unit (`isUnit_wuLeading`).

The normalisation constant enters as an integer cast because `IsDecomposable` is the additive
subgroup generated by the decomposable monomials, so it is closed under integer multiples only.
Over `F_p` every constant is an integer cast.

## Main results

* `ParityP.exists_pad` — a finset-indexed family of roots, padded by zeros to `Fin n`, has the
  same elementary symmetric functions and the same `m_{(p^i,1)}`.
* `ParityP.IsDecomposable.exists_lift` — decomposables pull back along an injective hom.
* `ParityP.wu_isDecomposable_of_splitting` — the diagonal Wu relation for the real Chern classes.
* `ParityP.wu_field_of_splitting`, `ParityP.isUnit_wuLeading` — the fields `wu` and `c_isUnit` of
  `ParityPData`, in their exact shape.
-/

set_option autoImplicit false

namespace GroupApproximation.CharClass

namespace ParityP

open MvPolynomial

/-! ## 1. Reindexing and padding the family of roots -/

section Padding

variable {A : Type*} [CommRing A]

theorem esymmOn_map {σ τ : Type*} (s : Finset σ) (e : σ ↪ τ) (y : τ → A) (a : ℕ) :
    esymmOn (s.map e) y a = esymmOn s (fun x => y (e x)) a := by
  rw [esymmOn_def, esymmOn_def, Finset.powersetCard_map, Finset.sum_map]
  refine Finset.sum_congr rfl fun B _ => ?_
  show ∏ l ∈ B.map e, y l = ∏ l ∈ B, y (e l)
  exact Finset.prod_map B e y

theorem esymmOn_congr {σ : Type*} {s : Finset σ} {y y' : σ → A} (h : ∀ x ∈ s, y x = y' x)
    (a : ℕ) : esymmOn s y a = esymmOn s y' a := by
  rw [esymmOn_def, esymmOn_def]
  refine Finset.sum_congr rfl fun B hB => Finset.prod_congr rfl fun l hl => h l ?_
  exact (Finset.mem_powersetCard.mp hB).1 hl

/-- Roots outside a subfamily that vanish do not change the elementary symmetric functions. -/
theorem esymmOn_eq_of_subset {σ : Type*} {t u : Finset σ} (htu : t ⊆ u) (y : σ → A)
    (hy : ∀ k ∈ u, k ∉ t → y k = 0) (a : ℕ) : esymmOn u y a = esymmOn t y a := by
  rw [esymmOn_def, esymmOn_def]
  refine (Finset.sum_subset (Finset.powersetCard_mono htu) fun B hBu hBt => ?_).symm
  have hBu' := Finset.mem_powersetCard.mp hBu
  have hnsub : ¬ B ⊆ t := fun hsub => hBt (Finset.mem_powersetCard.mpr ⟨hsub, hBu'.2⟩)
  obtain ⟨k, hkB, hkt⟩ := Finset.not_subset.mp hnsub
  exact Finset.prod_eq_zero hkB (hy k (hBu'.1 hkB) hkt)

theorem esymmOn_attach {σ : Type*} (s : Finset σ) (y : σ → A) (a : ℕ) :
    esymmOn s.attach (fun x => y x.1) a = esymmOn s y a := by
  have h := esymmOn_map s.attach (Function.Embedding.subtype (· ∈ s)) y a
  rw [Finset.attach_map_val] at h
  exact h.symm

theorem wuMonomialP_map {σ τ : Type*} [DecidableEq σ] [DecidableEq τ] (C : Finset σ)
    (e : σ ↪ τ) (g y : τ → A) (c : ℕ) :
    wuMonomialP (C.map e) g y c = wuMonomialP C (fun x => g (e x)) (fun x => y (e x)) c := by
  rw [wuMonomialP_def, wuMonomialP_def, Finset.powersetCard_map, Finset.sum_map]
  refine Finset.sum_congr rfl fun B _ => ?_
  show (∏ l ∈ B.map e, g l) * ∏ l ∈ C.map e \ B.map e, y l
    = (∏ l ∈ B, g (e l)) * ∏ l ∈ C \ B, y (e l)
  rw [← Finset.map_sdiff, Finset.prod_map, Finset.prod_map]

theorem wuMonomialP_eq_zero_of_mem {σ : Type*} [DecidableEq σ] {C : Finset σ} {g y : σ → A}
    {k : σ} (hk : k ∈ C) (hg : g k = 0) (hy : y k = 0) (c : ℕ) : wuMonomialP C g y c = 0 := by
  rw [wuMonomialP_def]
  refine Finset.sum_eq_zero fun B _ => ?_
  by_cases hkB : k ∈ B
  · rw [Finset.prod_eq_zero hkB hg, zero_mul]
  · rw [Finset.prod_eq_zero (Finset.mem_sdiff.mpr ⟨hk, hkB⟩) hy, mul_zero]

theorem wuRHSP_eq_of_subset {σ : Type*} [DecidableEq σ] {t u : Finset σ} (htu : t ⊆ u)
    (g y : σ → A) (h : ∀ k ∈ u, k ∉ t → g k = 0 ∧ y k = 0) (i : ℕ) :
    wuRHSP u g y i = wuRHSP t g y i := by
  rw [wuRHSP_eq_sum_wuMonomialP, wuRHSP_eq_sum_wuMonomialP]
  refine (Finset.sum_subset (Finset.powersetCard_mono htu) fun C hCu hCt => ?_).symm
  have hCu' := Finset.mem_powersetCard.mp hCu
  have hnsub : ¬ C ⊆ t := fun hsub => hCt (Finset.mem_powersetCard.mpr ⟨hsub, hCu'.2⟩)
  obtain ⟨k, hkC, hkt⟩ := Finset.not_subset.mp hnsub
  obtain ⟨hg, hy⟩ := h k (hCu'.1 hkC) hkt
  exact wuMonomialP_eq_zero_of_mem hkC hg hy i

theorem wuRHSP_map {σ τ : Type*} [DecidableEq σ] [DecidableEq τ] (s : Finset σ) (e : σ ↪ τ)
    (g y : τ → A) (i : ℕ) :
    wuRHSP (s.map e) g y i = wuRHSP s (fun x => g (e x)) (fun x => y (e x)) i := by
  rw [wuRHSP_eq_sum_wuMonomialP, wuRHSP_eq_sum_wuMonomialP, Finset.powersetCard_map,
    Finset.sum_map]
  refine Finset.sum_congr rfl fun C _ => ?_
  show wuMonomialP (C.map e) g y i = _
  exact wuMonomialP_map C e g y i

theorem wuRHSP_congr {σ : Type*} [DecidableEq σ] {s : Finset σ} {g g' y y' : σ → A}
    (hg : ∀ x ∈ s, g x = g' x) (hy : ∀ x ∈ s, y x = y' x) (i : ℕ) :
    wuRHSP s g y i = wuRHSP s g' y' i := by
  rw [wuRHSP_def, wuRHSP_def]
  refine Finset.sum_congr rfl fun B hB => Finset.sum_congr rfl fun k hk => ?_
  have hBs := (Finset.mem_powersetCard.mp hB).1
  rw [Finset.prod_congr rfl fun l hl => hg l (hBs hl), hy k (Finset.mem_sdiff.mp hk).1]

theorem wuRHSP_attach {σ : Type*} [DecidableEq σ] (s : Finset σ) (g y : σ → A) (i : ℕ) :
    wuRHSP s.attach (fun x => g x.1) (fun x => y x.1) i = wuRHSP s g y i := by
  have h := wuRHSP_map s.attach (Function.Embedding.subtype (· ∈ s)) g y i
  rw [Finset.attach_map_val] at h
  exact h.symm

/-- **Padding the roots.**  A finset-indexed family of roots, reindexed by `Fin (card + N)` and
padded with zeros, has the same elementary symmetric functions and the same `m_{(p^i,1)}`. -/
theorem exists_pad {σ : Type*} [DecidableEq σ] (s : Finset σ) (y : σ → A) (N : ℕ) :
    ∃ g : Fin (s.card + N) → A,
      (∀ a : ℕ, esymmOn Finset.univ g a = esymmOn s y a) ∧
      ∀ p i : ℕ, 1 ≤ p →
        wuRHSP Finset.univ (fun l => g l ^ p) g i = wuRHSP s (fun l => y l ^ p) y i := by
  let e : ↥s ↪ Fin (s.card + N) := s.equivFin.toEmbedding.trans (Fin.castLEEmb (by omega))
  let g : Fin (s.card + N) → A := Function.extend e (fun x => y x.1) 0
  have hge : ∀ x : ↥s, g (e x) = y x.1 := fun x => e.injective.extend_apply _ _ x
  have hg0 : ∀ k ∈ (Finset.univ : Finset (Fin (s.card + N))), k ∉ s.attach.map e → g k = 0 := by
    intro k _ hk
    refine Function.extend_apply' _ _ k ?_
    rintro ⟨x, rfl⟩
    exact hk (Finset.mem_map_of_mem e (Finset.mem_attach s x))
  have hsub : s.attach.map e ⊆ Finset.univ := Finset.subset_univ _
  refine ⟨g, fun a => ?_, fun p i hp => ?_⟩
  · rw [esymmOn_eq_of_subset hsub g hg0 a, esymmOn_map,
      esymmOn_congr (y := fun x => g (e x)) (y' := fun x => y x.1) (fun x _ => hge x) a,
      esymmOn_attach]
  · have hz : ∀ k ∈ (Finset.univ : Finset (Fin (s.card + N))), k ∉ s.attach.map e →
        (fun l => g l ^ p) k = 0 ∧ g k = 0 := by
      intro k hk hkt
      refine ⟨?_, hg0 k hk hkt⟩
      show g k ^ p = 0
      rw [hg0 k hk hkt, zero_pow (by omega)]
    rw [wuRHSP_eq_of_subset hsub _ _ hz i, wuRHSP_map,
      wuRHSP_congr (g := fun x => g (e x) ^ p) (g' := fun x => y x.1 ^ p)
        (y := fun x => g (e x)) (y' := fun x => y x.1)
        (fun x _ => congrArg (· ^ p) (hge x)) (fun x _ => hge x) i,
      wuRHSP_attach s (fun l => y l ^ p) y i]

end Padding

/-! ## 2. Evaluating the universal identity -/

section Evaluation

variable {A : Type*} [CommRing A] {n : ℕ}

theorem eval₂Hom_esymm (g : Fin n → A) (a : ℕ) :
    eval₂Hom (Int.castRingHom A) g (esymm (Fin n) ℤ a) = esymmOn Finset.univ g a := by
  simp only [esymm, map_sum, map_prod, eval₂Hom_X', esymmOn_def]

theorem eval₂Hom_wuRHSP (g : Fin n → A) (p i : ℕ) :
    eval₂Hom (Int.castRingHom A) g
        (wuRHSP Finset.univ (fun l : Fin n => (X l : MvPolynomial (Fin n) ℤ) ^ p) X i)
      = wuRHSP Finset.univ (fun l => g l ^ p) g i := by
  simp only [wuRHSP_def, map_sum, map_mul, map_prod, map_pow, eval₂Hom_X']

/-- **Decomposables pull back along an injective hom.**  If `ψ` sends the classes `γ₀` to the
images of the classes `γ` under `ρ`, a decomposable for `γ₀` is sent to the image of a
decomposable for `γ`. -/
theorem IsDecomposable.exists_lift {H₀ H A' : Type*} [CommRing H₀] [CommRing H] [CommRing A']
    (ψ : H₀ →+* A') (ρ : H →+* A') {γ₀ : ℕ → H₀} {γ : ℕ → H} (h : ∀ k, ψ (γ₀ k) = ρ (γ k))
    {N : ℕ} {u : H₀} (hu : IsDecomposable γ₀ N u) :
    ∃ w : H, IsDecomposable γ N w ∧ ψ u = ρ w := by
  induction hu with
  | monomial L hpos hsum hlen =>
    refine ⟨gammaProd γ L, IsDecomposable.monomial L hpos hsum hlen, ?_⟩
    rw [gammaProd_map, gammaProd_map]
    exact congrArg (fun γ' => gammaProd γ' L) (funext h)
  | zero => exact ⟨0, IsDecomposable.zero, by rw [map_zero, map_zero]⟩
  | add u v _hu _hv ihu ihv =>
    obtain ⟨w₁, hw₁, e₁⟩ := ihu
    obtain ⟨w₂, hw₂, e₂⟩ := ihv
    exact ⟨w₁ + w₂, IsDecomposable.add _ _ hw₁ hw₂, by rw [map_add, map_add, e₁, e₂]⟩
  | neg u _hu ihu =>
    obtain ⟨w, hw, e⟩ := ihu
    exact ⟨-w, IsDecomposable.neg _ hw, by rw [map_neg, map_neg, e]⟩

end Evaluation

/-! ## 3. The diagonal Wu relation for the real Chern classes -/

section Splitting

variable {H A σ : Type*} [CommRing H] [CommRing A] [DecidableEq σ]

/-- **The diagonal Wu relation, for a split family.**  With `ρ : H → A` injective, the classes
`γ` sent to the elementary symmetric functions of the roots of `D`, the reduced powers on `H`
intertwined with those of `D`, and `κ = m`, the relation (W) holds with leading coefficient
`m^i·wuCoeff p i`. -/
theorem wu_isDecomposable_of_splitting {p : ℕ} (hp : 2 ≤ p) (D : PowerData σ A p)
    (ρ : H →+* A) (hρ : Function.Injective ρ) (γ : ℕ → H) (hγ : ∀ k, ρ (γ k) = D.gamma k)
    (PH : ℕ → H →+ H) (hP : ∀ (i : ℕ) (x : H), ρ (PH i x) = D.P i (ρ x)) (m : ℤ)
    (hκ : D.κ = (m : A)) (i : ℕ) :
    IsDecomposable γ (i * p + 1)
      (PH i (γ (i + 1)) - ((m ^ i * wuCoeff p i : ℤ) : H) * γ (i * p + 1)) := by
  obtain ⟨g, hge, hgw⟩ := exists_pad D.s D.y 0
  have hdec := isDecomposable_wuRHSP (n := D.s.card + 0) hp i
  have hlift : ∀ k, eval₂Hom (Int.castRingHom A) g (esymm (Fin (D.s.card + 0)) ℤ k)
      = ρ (γ k) := by
    intro k
    rw [hγ, D.gamma_def, eval₂Hom_esymm, hge]
  obtain ⟨w, hw, hψw⟩ := hdec.exists_lift (eval₂Hom (Int.castRingHom A) g) ρ hlift
  have hu : eval₂Hom (Int.castRingHom A) g
      (wuRHSP Finset.univ
          (fun l : Fin (D.s.card + 0) => (X l : MvPolynomial (Fin (D.s.card + 0)) ℤ) ^ p) X i
        - C (wuCoeff p i) * esymm (Fin (D.s.card + 0)) ℤ (i * p + 1))
      = wuRHSP D.s (fun l => D.y l ^ p) D.y i
        - ((wuCoeff p i : ℤ) : A) * D.gamma (i * p + 1) := by
    rw [map_sub, map_mul, eval₂Hom_wuRHSP, hgw p i (by omega), eval₂Hom_C, eq_intCast,
      eval₂Hom_esymm, hge, D.gamma_def]
  have hkey : ρ (PH i (γ (i + 1)) - ((m ^ i * wuCoeff p i : ℤ) : H) * γ (i * p + 1))
      = ρ (((m ^ i : ℤ) : H) * w) := by
    rw [map_mul ρ, map_intCast ρ, ← hψw, hu, map_sub, map_mul, map_intCast, hP, hγ, hγ,
      D.p_gamma_succ_eq_smul i, hκ, Int.cast_mul, Int.cast_pow]
    ring
  rw [hρ hkey]
  exact hw.intCast_mul (m ^ i)

/-- **The field `wu` of `ParityPData`**, in its exact shape, with `c i = m^i·wuCoeff p i`. -/
theorem wu_field_of_splitting {R : Type*} [CommRing R] {p : ℕ} (hp : 2 ≤ p) (ι : R →+* H)
    (D : PowerData σ A p) (ρ : H →+* A) (hρ : Function.Injective ρ) (γ : ℕ → H)
    (hγ : ∀ k, ρ (γ k) = D.gamma k) (PH : ℕ → H →+ H)
    (hP : ∀ (i : ℕ) (x : H), ρ (PH i x) = D.P i (ρ x)) (m : ℤ) (hκ : D.κ = (m : A)) (i : ℕ) :
    IsDecomposable γ (i * p + 1)
      (PH i (γ (i + 1)) - ι ((m ^ i * wuCoeff p i : ℤ) : R) * γ (i * p + 1)) := by
  rw [map_intCast]
  exact wu_isDecomposable_of_splitting hp D ρ hρ γ hγ PH hP m hκ i

end Splitting

/-- **The field `c_isUnit` of `ParityPData`.**  The leading coefficient `m^i·wuCoeff p i` is a
unit once `p = 0` in the coefficients and `m` is a unit. -/
theorem isUnit_wuLeading {R : Type*} [CommRing R] {p : ℕ} (hpR : (p : R) = 0) {m : ℤ}
    (hm : IsUnit (m : R)) (i : ℕ) : IsUnit ((m ^ i * wuCoeff p i : ℤ) : R) := by
  rw [Int.cast_mul, Int.cast_pow]
  exact (hm.pow i).mul (isUnit_wuCoeff_cast hpR i)

end ParityP

end GroupApproximation.CharClass
