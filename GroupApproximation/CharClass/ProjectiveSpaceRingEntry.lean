import GroupApproximation.CharClass.ProjectiveSpaceComputation
import GroupApproximation.CharClass.ProjectiveSpaceRing
import GroupApproximation.CharClass.ChernEulerBundle
import GroupApproximation.CharClass.GysinFromLerayHirsch

/-!
# The second half of the ring statement

`GysinFromLerayHirsch.cupPowE_ne_zero_of_bijective` already gives the powers of
the Euler class from bijectivity of cupping, without a whole Gysin sequence.  What
is missing is the group statement that goes with it: once a power is nonzero, the
even group it lives in contains nothing but zero and that power, because the group
is a line.

## Main declarations

* `eq_zero_or_eq_cupPowE_cpGen_of_ne` — each even group of `ℂP^d` up to twice the
  dimension is exactly the two-element set generated by the corresponding power.
-/

set_option autoImplicit false

namespace GroupApproximation
namespace CharClass

open CategoryTheory

noncomputable section

namespace CPn

/-- **Each even group of `ℂP^d` up to the top is the two-element set generated by
the corresponding power**, as soon as that power is nonzero.  The group is a line,
and a line containing a nonzero element contains nothing else. -/
theorem eq_zero_or_eq_cupPowE_cpGen_of_ne (d : ℕ) (hd : 1 ≤ d) {m : ℕ} (hm : m ≤ d)
    (hne : cupPowE (cpGen d hd) m ≠ 0) (a : Hmod2 (CPtop d) (2 * m)) :
    a = 0 ∨ a = cupPowE (cpGen d hd) m :=
  eq_zero_or_eq_of_line ((hasCPCohomology_CP d).1 m hm).some hne a

end CPn

end

end CharClass
end GroupApproximation
