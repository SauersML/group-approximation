import GroupApproximation.CharClass.CohomologyLHRingInj

/-!
# Surjectivity of the ring-level Leray–Hirsch combination

The other half of `LerayHirschData.free`, and it needs **no** finite-support
argument after all.

The expected route was to invert degreewise, assemble a coefficient from its
components, and prove the assembled tuple finitely supported.  That is avoidable.
`lhFun` is additive in its tuple, so its range is a subgroup, and a direct sum is
generated by its concentrated elements.  So it suffices to hit `TotalH.of P n w`,
and there the witness is a **finite explicit tuple**: invert `lhMap` at the single
degree `n` and place each coefficient in its own degree.

The one thing to check is that the witness contributes nothing in the other
degrees.  It does not, and for two different reasons depending on the index: an
index outside the degree-`n` range gives a zero coefficient, and an index inside
it gives a class concentrated in a degree that `n' ≠ n` cannot meet, because both
degrees are at least twice the index.

## Main declarations

* `LHCast.lhFun_zero`, `LHCast.lhFun_add` — the combination is additive.
* `LHCast.lhMap_zero` — and so is the degreewise one, at zero.
* `LHCast.lhFun_surjective` — **surjectivity**.
-/

open CategoryTheory

namespace GroupApproximation.CharClass

noncomputable section

namespace LHCast

open LH

variable {X P : TopCat.{0}}

/-! ## 1. Additivity -/

theorem lhFun_zero (π : P ⟶ X) (r : ℕ) (ξ : Hmod2 P 2) :
    lhFun π r ξ 0 = 0 := by
  show ∑ i : Fin r, TotalH.map π ((0 : Fin r → TotalH X) i)
      * TotalH.of P 2 ξ ^ (i : ℕ) = 0
  refine Finset.sum_eq_zero (fun i _ => ?_)
  rw [Pi.zero_apply, map_zero, zero_mul]

theorem lhFun_add (π : P ⟶ X) (r : ℕ) (ξ : Hmod2 P 2) (c c' : Fin r → TotalH X) :
    lhFun π r ξ (c + c') = lhFun π r ξ c + lhFun π r ξ c' := by
  show ∑ i : Fin r, TotalH.map π ((c + c') i) * TotalH.of P 2 ξ ^ (i : ℕ)
      = (∑ i : Fin r, _) + ∑ i : Fin r, _
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl (fun i _ => by rw [Pi.add_apply, map_add, add_mul])

theorem lhMap_zero (π : P ⟶ X) (ξ : Hmod2 P 2) (r n : ℕ) :
    lhMap π ξ r n 0 = 0 := by
  simp only [lhMap]
  refine Finset.sum_eq_zero (fun i _ => ?_)
  rw [Pi.zero_apply, pull_zero, zero_cup, cohCast_zero]

/-! ## 2. Surjectivity -/

set_option maxHeartbeats 1000000 in
/-- **The ring-level combination is onto.**  Additivity reduces it to the
concentrated elements, where the witness is finite and explicit. -/
theorem lhFun_surjective {π : P ⟶ X} {ξ : Hmod2 P 2} {r : ℕ}
    (L : LerayHirschGraded π ξ r) : Function.Surjective (lhFun π r ξ) := by
  intro z
  induction z using DirectSum.induction_on with
  | zero => exact ⟨0, lhFun_zero π r ξ⟩
  | of n w =>
    obtain ⟨a, ha⟩ := (L.bij n).2 w
    refine ⟨fun i => if h : (i : ℕ) < lhDomainCard r n then
      TotalH.of X (n - 2 * (i : ℕ)) (a ⟨(i : ℕ), h⟩) else 0, ?_⟩
    ext n'
    show TotalH.component P n' (lhFun π r ξ _) = TotalH.component P n' (TotalH.of P n w)
    rw [component_lhFun]
    rcases eq_or_ne n' n with rfl | hne
    · rw [TotalH.component_of, ← ha]
      congr 1
      funext j
      have h1 : ((j : ℕ) < r) := lt_rank_of_lhDomain j
      simp only [degFun, dif_pos h1, dif_pos j.isLt, TotalH.component_of]
    · rw [Wu.component_of_ne hne]
      have hzero : (fun j : Fin (lhDomainCard r n') =>
          degFun X r n' (fun i => if h : (i : ℕ) < lhDomainCard r n then
            TotalH.of X (n - 2 * (i : ℕ)) (a ⟨(i : ℕ), h⟩) else 0) (j : ℕ)) = 0 := by
        funext j
        have h1 : ((j : ℕ) < r) := lt_rank_of_lhDomain j
        have h2 : 2 * (j : ℕ) ≤ n' := two_mul_le_of_lhDomain j
        simp only [degFun, dif_pos h1]
        by_cases h3 : (j : ℕ) < lhDomainCard r n
        · rw [dif_pos h3]
          have h4 : 2 * (j : ℕ) ≤ n :=
            two_mul_le_of_lhDomain (⟨(j : ℕ), h3⟩ : Fin (lhDomainCard r n))
          exact Wu.component_of_ne (by omega) _
        · rw [dif_neg h3]
          exact map_zero _
      rw [hzero, lhMap_zero]
  | add u v hu hv =>
    obtain ⟨cu, hcu⟩ := hu
    obtain ⟨cv, hcv⟩ := hv
    exact ⟨cu + cv, by rw [lhFun_add, hcu, hcv]⟩

end LHCast

end

end GroupApproximation.CharClass
