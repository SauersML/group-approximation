import GroupApproximation.Kazhdan.KazhdanOrthogonal
import GroupApproximation.Criterion.CompressionCentralizerDefect

/-!
# The subgroup stabilizing a fixed-vector sector

Once finite projection theory upgrades one-sided compression of a spectral
sector to equality, stabilization is automatically closed under products and
inverses.  Thus every element of the group generated by one-sided
compressors preserves the sector.  This is the group-theoretic back half of
the intrinsic compression--centralizer defect argument.
-/

namespace GroupApproximation
namespace FixedSpaceStabilizer

variable {H : Type} [Group H]
variable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Elements whose action preserves membership in a specified submodule in
both directions form a subgroup. -/
def stabilizer (ρ : H →* (E ≃ₗᵢ[ℝ] E)) (S : Submodule ℝ E) : Subgroup H where
  carrier := {g | ∀ x, x ∈ S ↔ ρ g x ∈ S}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh x
    rw [map_mul]
    exact (hh x).trans (hg (ρ h x))
  inv_mem' := by
    intro g hg x
    simpa using (hg (ρ g⁻¹ x)).symm

@[simp]
theorem mem_stabilizer_iff (ρ : H →* (E ≃ₗᵢ[ℝ] E))
    (S : Submodule ℝ E) {g : H} :
    g ∈ stabilizer ρ S ↔ ∀ x, x ∈ S ↔ ρ g x ∈ S :=
  Iff.rfl

/-- A stabilizing element sends every vector in the sector back into the
sector. -/
theorem map_mem_of_mem {ρ : H →* (E ≃ₗᵢ[ℝ] E)}
    {S : Submodule ℝ E} {g : H} (hg : g ∈ stabilizer ρ S)
    {x : E} (hx : x ∈ S) : ρ g x ∈ S :=
  (hg x).mp hx

/-- If every one-sided compressor stabilizes a sector, then the entire group
generated by compressors stabilizes it, including inverse compressors and
all finite products. -/
theorem compressionGroup_le_stabilizer
    (ρ : H →* (E ≃ₗᵢ[ℝ] E)) (L : Subgroup H) (S : Submodule ℝ E)
    (hcompression : compressionSet L ⊆ stabilizer ρ S) :
    compressionGroup L ≤ stabilizer ρ S := by
  rw [compressionGroup, Subgroup.closure_le]
  exact hcompression

/-- Group-generated fixed-sector propagation: every generated compressor
transports every vector of a stabilized sector inside that sector. -/
theorem compressionGroup_map_mem
    (ρ : H →* (E ≃ₗᵢ[ℝ] E)) (L : Subgroup H) (S : Submodule ℝ E)
    (hcompression : compressionSet L ⊆ stabilizer ρ S)
    {g : H} (hg : g ∈ compressionGroup L)
    {x : E} (hx : x ∈ S) : ρ g x ∈ S :=
  map_mem_of_mem (compressionGroup_le_stabilizer ρ L S hcompression hg) hx

end FixedSpaceStabilizer
end GroupApproximation
