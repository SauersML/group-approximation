import GroupApproximation.PropertyT.FiniteTypeCharacteristicTwoPropertyT
import GroupApproximation.Kazhdan.TorsionFreeHyperbolicKazhdan

/-!
# Why the repository's Kazhdan groups cannot witness `SharpExistence`

This repository **does** prove property `(T)` unconditionally for infinite
groups.  `PropertyT/FreeElementaryPropertyT.lean` proves it for
`EL₃(𝔽₂⟨X⟩)` --- the Ershov--Jaikin-Zapirain theorem in characteristic two,
by way of the `A₂` codistance estimate and the exact Hodge certificate ---
and `PropertyT/FiniteTypeCharacteristicTwoPropertyT.lean` descends it to
`EL₃(R)` for every finite-type `𝔽₂`-algebra `R`, since property `(T)` passes to
quotients.  `Leavitt/ElementaryGroup.lean` proves `EL_ι(R)` is infinite whenever
`R` is.

So the missing ingredient of `SharpExistence` is *not* property `(T)` for an
infinite group.  It is property `(T)` together with the other clauses, and this
module proves --- rather than asserts --- exactly which clause the existing
family fails, and that the failure is structural.

## The obstruction

In characteristic two every elementary root element is an involution:

```
    x_{ij}(a)² = x_{ij}(a + a) = x_{ij}(0) = 1
```

(`elementaryUnit_sq`).  So `EL₃(R)` over any nontrivial `𝔽₂`-algebra contains an
element of order two and is **not torsion-free**
(`elementaryThree_not_isPowerTorsionFree`), and it fails the torsion-free clause
of `SharpExistence` outright.

The obvious repair is to quotient: property `(T)` passes to quotients
(`HasKazhdanPropertyT.of_surjective`), so one would look for a torsion-free
quotient.  `subsingleton_of_isPowerTorsionFree_quotient_elementaryThree` closes
that door: a group generated by involutions has *no* nontrivial torsion-free
quotient, because the images of the generators are involutions and
torsion-freeness kills them, so the whole quotient collapses to a point.

## What this measures

The distance between this repository and `SharpExistence` is therefore located
precisely.  It is not the analytic content of property `(T)` --- that is
formalized here, for infinite groups, unconditionally.  It is that the only
formalized source of `(T)` produces groups generated by involutions, which are
never torsion-free and (for the same underlying reason --- an infinite subgroup
of exponent two inside two commuting root subgroups) never hyperbolic.

Reaching `SharpExistence` means a *different* source of property `(T)`: one
whose output is a torsion-free hyperbolic group.  The three known such sources
are recorded in `Kazhdan/SharpExistenceRoutes.lean` and
`Kazhdan/SharpExistenceSpectralRoute.lean`, and none of them is formalized
anywhere.

Nothing here proves `SharpExistence`, nothing assumes it, and every theorem
below is unconditional.
-/

namespace GroupApproximation
namespace CharTwoObstruction

universe u v

/-! ## Groups generated by involutions -/

/-- **A group generated by involutions has no nontrivial torsion-free
quotient.**  Each generator maps to an element whose square is the identity;
torsion-freeness makes that element the identity; so the generators all lie in
the kernel, the kernel is everything, and the surjective image is a point. -/
theorem subsingleton_of_isPowerTorsionFree_of_surjective
    {G : Type u} [Group G] {H : Type v} [Group H] {S : Set G}
    (hgen : Subgroup.closure S = ⊤) (hsq : ∀ s ∈ S, s ^ 2 = 1)
    (φ : G →* H) (hφ : Function.Surjective φ) (hH : IsPowerTorsionFree H) :
    Subsingleton H := by
  have hker : Subgroup.closure S ≤ φ.ker := by
    rw [Subgroup.closure_le]
    intro s hs
    have h1 : (φ s) ^ 2 = 1 := by rw [← map_pow, hsq s hs, map_one]
    exact MonoidHom.mem_ker.mpr (hH (φ s) 2 (by norm_num) h1)
  have htop : (⊤ : Subgroup G) ≤ φ.ker := by
    rw [← hgen]
    exact hker
  constructor
  intro a b
  obtain ⟨x, rfl⟩ := hφ a
  obtain ⟨y, rfl⟩ := hφ b
  have hx : φ x = 1 := MonoidHom.mem_ker.mp (htop (Subgroup.mem_top x))
  have hy : φ y = 1 := MonoidHom.mem_ker.mp (htop (Subgroup.mem_top y))
  rw [hx, hy]

/-- The same statement for a subgroup presented as a closure, which is the form
`elementaryGroup` comes in.  `Subgroup.closure_closure_coe_preimage` supplies
the generation statement inside the subtype. -/
theorem subsingleton_of_isPowerTorsionFree_of_surjective_closure
    {G : Type u} [Group G] (S : Set G) (hsq : ∀ s ∈ S, s ^ 2 = 1)
    {H : Type v} [Group H] (φ : ↥(Subgroup.closure S) →* H)
    (hφ : Function.Surjective φ) (hH : IsPowerTorsionFree H) :
    Subsingleton H := by
  refine subsingleton_of_isPowerTorsionFree_of_surjective
    (S := ((↑) : Subgroup.closure S → G) ⁻¹' S)
    Subgroup.closure_closure_coe_preimage ?_ φ hφ hH
  intro s hs
  have hcoe : ((s : G)) ^ 2 = 1 := hsq _ hs
  exact Subtype.ext (by simpa using hcoe)

/-! ## Characteristic two makes the root elements involutions -/

/-- **`x_{ij}(a)` is an involution in characteristic two.**  The elementary
relation `x_{ij}(a) x_{ij}(b) = x_{ij}(a+b)` plus `a + a = 0` gives
`x_{ij}(a)² = x_{ij}(0) = 1`. -/
theorem elementaryUnit_sq {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R]
    (h2 : (2 : R) = 0) (i j : ι) (hij : i ≠ j) (a : R) :
    elementaryUnit i j hij a ^ 2 = 1 := by
  have haa : a + a = 0 := by
    have hmul : (2 : R) * a = a + a := two_mul a
    rw [h2, zero_mul] at hmul
    exact hmul.symm
  rw [pow_two, elementaryUnit_mul, haa, elementaryUnit_zero]

/-- Two vanishes in every `𝔽₂`-algebra, because it is the image of `2 = 0`. -/
theorem two_eq_zero_of_algebra_zmodTwo (R : Type*) [Ring R]
    [Algebra (ZMod 2) R] : (2 : R) = 0 := by
  have h' : algebraMap (ZMod 2) R (2 : ZMod 2) = 0 := by
    rw [show (2 : ZMod 2) = 0 from by decide, map_zero]
  calc
    (2 : R) = algebraMap (ZMod 2) R (2 : ZMod 2) := (map_ofNat _ 2).symm
    _ = 0 := h'

/-! ## The consequence for the elementary groups -/

/-- **A characteristic-two elementary group is not torsion-free.**  A single
root element with nonzero coefficient is an involution different from the
identity, by injectivity of `a ↦ x_{ij}(a)`. -/
theorem not_isPowerTorsionFree_elementaryGroup
    {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R]
    (h2 : (2 : R) = 0) (i j : ι) (hij : i ≠ j) (a : R) (ha : a ≠ 0) :
    ¬ IsPowerTorsionFree ↥(elementaryGroup ι R) := by
  intro hfree
  set g : ↥(elementaryGroup ι R) :=
    ⟨elementaryUnit i j hij a, elementaryUnit_mem i j hij a⟩ with hgdef
  have hg2 : g ^ 2 = 1 := by
    apply Subtype.ext
    simpa [hgdef] using elementaryUnit_sq h2 i j hij a
  have hg1 : g = 1 := hfree g 2 (by norm_num) hg2
  have hval : elementaryUnit i j hij a = elementaryUnit i j hij 0 := by
    have hc := congrArg (fun z : ↥(elementaryGroup ι R) ↦ (z : (Matrix ι ι R)ˣ)) hg1
    simpa [hgdef, elementaryUnit_zero] using hc
  exact ha (elementaryUnit_injective i j hij hval)

/-- **No quotient repairs it.**  Every torsion-free quotient of a
characteristic-two elementary group is trivial, so the fact that property `(T)`
passes to quotients buys nothing here. -/
theorem subsingleton_of_isPowerTorsionFree_quotient_elementaryGroup
    {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R] (h2 : (2 : R) = 0)
    {H : Type v} [Group H] (φ : ↥(elementaryGroup ι R) →* H)
    (hφ : Function.Surjective φ) (hH : IsPowerTorsionFree H) :
    Subsingleton H := by
  refine subsingleton_of_isPowerTorsionFree_of_surjective_closure
    {z | ∃ (i j : ι) (h : i ≠ j) (a : R), elementaryUnit i j h a = z} ?_ φ hφ hH
  rintro z ⟨i, j, hij, a, rfl⟩
  exact elementaryUnit_sq h2 i j hij a

/-! ## The two statements side by side -/

/-- **The repository's unconditional Kazhdan group is not torsion-free.** -/
theorem elementaryThree_not_isPowerTorsionFree
    (R : Type) [Ring R] [Nontrivial R] [Algebra (ZMod 2) R] :
    ¬ IsPowerTorsionFree ↥(elementaryGroup (Fin 3) R) :=
  not_isPowerTorsionFree_elementaryGroup
    (two_eq_zero_of_algebra_zmodTwo R) 0 1 (by decide) 1 one_ne_zero

/-- **...and none of its quotients is a nontrivial torsion-free group.** -/
theorem subsingleton_of_isPowerTorsionFree_quotient_elementaryThree
    (R : Type) [Ring R] [Algebra (ZMod 2) R]
    {H : Type} [Group H] (φ : ↥(elementaryGroup (Fin 3) R) →* H)
    (hφ : Function.Surjective φ) (hH : IsPowerTorsionFree H) :
    Subsingleton H :=
  subsingleton_of_isPowerTorsionFree_quotient_elementaryGroup
    (two_eq_zero_of_algebra_zmodTwo R) φ hφ hH

/-- **The measurement.**  For every nontrivial finite-type `𝔽₂`-algebra the
elementary rank-three group has property `(T)` --- unconditionally, proved in
this repository --- and is not torsion-free.  Both halves are theorems, so the
gap between the formalized property `(T)` and `SharpExistence` is located at the
torsion-free clause and nowhere else. -/
theorem elementaryThree_kazhdan_and_not_torsionFree
    (R : Type) [Ring R] [Nontrivial R] [Algebra (ZMod 2) R]
    [Algebra.FiniteType (ZMod 2) R] :
    HasKazhdanPropertyT.{0, 0} ↥(elementaryGroup (Fin 3) R) ∧
      ¬ IsPowerTorsionFree ↥(elementaryGroup (Fin 3) R) :=
  ⟨finiteTypeElementaryThree_hasKazhdanPropertyT,
    elementaryThree_not_isPowerTorsionFree R⟩

end CharTwoObstruction
end GroupApproximation
