import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Data.ZMod.Basic
import Mathlib.SetTheory.Cardinal.Finite
import GroupApproximation.Meta.AxiomGuard
import GroupApproximation.Kazhdan.GHBQuotientMatrices

/-!
# The images of the vertex groups of `GHB(7)` in `GL₄(F₇)`, as matrix families

`Kazhdan/GHBQuotientMatrices.lean` defines `ψ : GHB(7) → GL₄(F₇)` (CCKW Proposition 7.15,
`k = 1`).  This module describes the three subgroups `⟨V'a, V'b⟩`, `⟨V'c, V'b⟩`,
`⟨V'c, V'a⟩` of `GL₄(F₇)` generated by the images of the vertex groups.

Each is a family of matrices `mat t` indexed by parameters `t ∈ F₇³` resp. `F₇⁴`, with an
explicit group law on the parameters: `mat s * mat t = mat (mul s t)` is a polynomial
identity (proved by `ring`), the generators and their inverses are members, so every
element of the generated subgroup is a member (`exists_matAB_of_mem_closure`, …).
Two numerical facts about the parameter laws are checked by kernel evaluation over
`F₇³`/`F₇⁴` (seconds, no matrices involved): every parameter has seventh power `0`, and
explicit words in the generators reach every parameter.  Consequences:

* every element of each generated subgroup has seventh power `1`;
* each generated subgroup has at least `7³` resp. `7⁴` elements.

The families, their laws, and the words were found and checked by lane kh-cckw's model
tests (`experiments/kms_ghb7_quotient/`).
-/

namespace GroupApproximation
namespace KMSGroup
namespace GHBQuotient

/-- Three parameters in `F₇`. -/
abbrev P3 : Type := ZMod 7 × ZMod 7 × ZMod 7

/-- Four parameters in `F₇`. -/
abbrev P4 : Type := ZMod 7 × ZMod 7 × ZMod 7 × ZMod 7

theorem mem_closure_pair_left {G : Type*} [Group G] (x y : G) :
    x ∈ Subgroup.closure ({x, y} : Set G) :=
  Subgroup.subset_closure (Set.mem_insert x {y})

theorem mem_closure_pair_right {G : Type*} [Group G] (x y : G) :
    y ∈ Subgroup.closure ({x, y} : Set G) :=
  Subgroup.subset_closure (Set.mem_insert_of_mem x (Set.mem_singleton y))

theorem comm_mem_closure {G : Type*} [Group G] {K : Subgroup G} {x y : G} (hx : x ∈ K)
    (hy : y ∈ K) : comm x y ∈ K :=
  mul_mem (mul_mem (mul_mem (inv_mem hx) (inv_mem hy)) hx) hy

/-! ## The family `ψ⟨a, b⟩` -/

/-- `matAB (i, j, x) = I + i E₀₃ + i E₁₂ + j E₁₀ − j E₂₃ + x E₁₃`. -/
def matAB (t : P3) : Mat :=
  !![1, 0, 0, t.1; t.2.1, 1, t.1, t.2.2; 0, 0, 1, -t.2.1; 0, 0, 0, 1]

/-- The group law of the family `matAB`. -/
def mulAB (s t : P3) : P3 :=
  (s.1 + t.1, s.2.1 + t.2.1, s.2.2 + t.2.2 + s.2.1 * t.1 - s.1 * t.2.1)

theorem matAB_mul (s t : P3) : matAB s * matAB t = matAB (mulAB s t) := by
  obtain ⟨i, j, x⟩ := s
  obtain ⟨i', j', x'⟩ := t
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [matAB, mulAB, Matrix.mul_apply, Fin.sum_univ_four] <;> ring

theorem matAB_zero : matAB 0 = 1 := by decide +kernel

theorem matAB_injective : Function.Injective matAB := by
  rintro ⟨i, j, x⟩ ⟨i', j', x'⟩ h
  have h1 := congrFun (congrFun h 0) 3
  have h2 := congrFun (congrFun h 1) 0
  have h3 := congrFun (congrFun h 1) 3
  simp [matAB] at h1 h2 h3
  exact Prod.ext h1 (Prod.ext h2 h3)

theorem val_uA : (uA : Mat) = matAB (1, 0, 0) := by decide +kernel

theorem val_uA_inv : ((uA⁻¹ : GL4) : Mat) = matAB (-1, 0, 0) := by decide +kernel

theorem val_uB_ab : (uB : Mat) = matAB (0, 1, 0) := by decide +kernel

theorem val_uB_inv_ab : ((uB⁻¹ : GL4) : Mat) = matAB (0, -1, 0) := by decide +kernel

theorem exists_matAB_of_mem_closure {x : GL4}
    (hx : x ∈ Subgroup.closure ({uA, uB} : Set GL4)) : ∃ t, (x : Mat) = matAB t := by
  induction hx using Subgroup.closure_induction_left with
  | one => exact ⟨0, by rw [Units.val_one, matAB_zero]⟩
  | mul_left g hg y _ ih =>
    obtain ⟨t, ht⟩ := ih
    rcases hg with rfl | rfl
    · exact ⟨mulAB (1, 0, 0) t, by rw [Units.val_mul, ht, val_uA, matAB_mul]⟩
    · exact ⟨mulAB (0, 1, 0) t, by rw [Units.val_mul, ht, val_uB_ab, matAB_mul]⟩
  | inv_mul_cancel g hg y _ ih =>
    obtain ⟨t, ht⟩ := ih
    rcases hg with rfl | rfl
    · exact ⟨mulAB (-1, 0, 0) t, by rw [Units.val_mul, ht, val_uA_inv, matAB_mul]⟩
    · exact ⟨mulAB (0, -1, 0) t, by rw [Units.val_mul, ht, val_uB_inv_ab, matAB_mul]⟩

/-- Powers in the parameter law of `matAB`. -/
def powAB (t : P3) : ℕ → P3
  | 0 => 0
  | n + 1 => mulAB (powAB t n) t

theorem matAB_pow (t : P3) (n : ℕ) : matAB t ^ n = matAB (powAB t n) := by
  induction n with
  | zero => simp only [pow_zero, powAB, matAB_zero]
  | succ n ih => simp only [pow_succ, ih, matAB_mul, powAB]

theorem powAB_seven : ∀ t : P3, powAB t 7 = 0 := by decide +kernel

/-- **`⟨V'a, V'b⟩` has exponent seven.** -/
theorem pow_seven_of_mem_closure_ab {x : GL4}
    (hx : x ∈ Subgroup.closure ({uA, uB} : Set GL4)) : x ^ 7 = 1 := by
  obtain ⟨t, ht⟩ := exists_matAB_of_mem_closure hx
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, ht, matAB_pow, powAB_seven, matAB_zero, Units.val_one]

/-- `[V'a, V'b]³`, the parameter `(0, 0, 1)`. -/
def zAB : GL4 := comm uA uB ^ 3

theorem val_zAB : (zAB : Mat) = matAB (0, 0, 1) := by decide +kernel

/-- The word `V'a^i V'b^j zAB^(x + ij)` reaching the parameter `(i, j, x)`. -/
def wordAB (t : P3) : GL4 :=
  uA ^ t.1.val * uB ^ t.2.1.val * zAB ^ (t.2.2 + t.1 * t.2.1).val

theorem wordAB_mem (t : P3) : wordAB t ∈ Subgroup.closure ({uA, uB} : Set GL4) := by
  have ha := mem_closure_pair_left uA uB
  have hb := mem_closure_pair_right uA uB
  exact mul_mem (mul_mem (pow_mem ha _) (pow_mem hb _))
    (pow_mem (pow_mem (comm_mem_closure ha hb) 3) _)

theorem powAB_word : ∀ t : P3,
    mulAB (mulAB (powAB (1, 0, 0) t.1.val) (powAB (0, 1, 0) t.2.1.val))
      (powAB (0, 0, 1) (t.2.2 + t.1 * t.2.1).val) = t := by
  decide +kernel

theorem val_wordAB (t : P3) : (wordAB t : Mat) = matAB t := by
  rw [wordAB, Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val,
    Units.val_pow_eq_pow_val, val_uA, val_uB_ab, val_zAB, matAB_pow, matAB_pow, matAB_pow,
    matAB_mul, matAB_mul, powAB_word]

/-- **`⟨V'a, V'b⟩` has at least `7³` elements.** -/
theorem card_closure_ab : 7 ^ 3 ≤ Nat.card (Subgroup.closure ({uA, uB} : Set GL4)) := by
  have hinj : Function.Injective
      (fun t : P3 => (⟨wordAB t, wordAB_mem t⟩ : Subgroup.closure ({uA, uB} : Set GL4))) := by
    intro s t hst
    apply matAB_injective
    have h := congrArg (fun y : Subgroup.closure ({uA, uB} : Set GL4) => ((y : GL4) : Mat)) hst
    simpa only [val_wordAB] using h
  have h := Nat.card_le_card_of_injective _ hinj
  simpa using h

/-! ## The family `ψ⟨c, b⟩` -/

/-- `matCB (i, j, k, u)`: rows `(1,0,0,0)`, `(j,1,0,0)`, `(u,k,1,−j)`, `(k+ij,i,0,1)`. -/
def matCB (t : P4) : Mat :=
  !![1, 0, 0, 0; t.2.1, 1, 0, 0; t.2.2.2, t.2.2.1, 1, -t.2.1;
    t.2.2.1 + t.1 * t.2.1, t.1, 0, 1]

/-- The group law of the family `matCB`. -/
def mulCB (s t : P4) : P4 :=
  (s.1 + t.1, s.2.1 + t.2.1, s.2.2.1 + t.2.2.1 - s.2.1 * t.1,
    s.2.2.2 + t.2.2.2 + s.2.2.1 * t.2.1 - s.2.1 * (t.2.2.1 + t.1 * t.2.1))

theorem matCB_mul (s t : P4) : matCB s * matCB t = matCB (mulCB s t) := by
  obtain ⟨i, j, k, u⟩ := s
  obtain ⟨i', j', k', u'⟩ := t
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [matCB, mulCB, Matrix.mul_apply, Fin.sum_univ_four] <;> ring

theorem matCB_zero : matCB 0 = 1 := by decide +kernel

theorem matCB_injective : Function.Injective matCB := by
  rintro ⟨i, j, k, u⟩ ⟨i', j', k', u'⟩ h
  have h1 := congrFun (congrFun h 3) 1
  have h2 := congrFun (congrFun h 1) 0
  have h3 := congrFun (congrFun h 2) 1
  have h4 := congrFun (congrFun h 2) 0
  simp [matCB] at h1 h2 h3 h4
  exact Prod.ext h1 (Prod.ext h2 (Prod.ext h3 h4))

theorem val_uC_cb : (uC : Mat) = matCB (1, 0, 0, 0) := by decide +kernel

theorem val_uC_inv_cb : ((uC⁻¹ : GL4) : Mat) = matCB (-1, 0, 0, 0) := by decide +kernel

theorem val_uB_cb : (uB : Mat) = matCB (0, 1, 0, 0) := by decide +kernel

theorem val_uB_inv_cb : ((uB⁻¹ : GL4) : Mat) = matCB (0, -1, 0, 0) := by decide +kernel

theorem exists_matCB_of_mem_closure {x : GL4}
    (hx : x ∈ Subgroup.closure ({uC, uB} : Set GL4)) : ∃ t, (x : Mat) = matCB t := by
  induction hx using Subgroup.closure_induction_left with
  | one => exact ⟨0, by rw [Units.val_one, matCB_zero]⟩
  | mul_left g hg y _ ih =>
    obtain ⟨t, ht⟩ := ih
    rcases hg with rfl | rfl
    · exact ⟨mulCB (1, 0, 0, 0) t, by rw [Units.val_mul, ht, val_uC_cb, matCB_mul]⟩
    · exact ⟨mulCB (0, 1, 0, 0) t, by rw [Units.val_mul, ht, val_uB_cb, matCB_mul]⟩
  | inv_mul_cancel g hg y _ ih =>
    obtain ⟨t, ht⟩ := ih
    rcases hg with rfl | rfl
    · exact ⟨mulCB (-1, 0, 0, 0) t, by rw [Units.val_mul, ht, val_uC_inv_cb, matCB_mul]⟩
    · exact ⟨mulCB (0, -1, 0, 0) t, by rw [Units.val_mul, ht, val_uB_inv_cb, matCB_mul]⟩

/-- Powers in the parameter law of `matCB`. -/
def powCB (t : P4) : ℕ → P4
  | 0 => 0
  | n + 1 => mulCB (powCB t n) t

theorem matCB_pow (t : P4) (n : ℕ) : matCB t ^ n = matCB (powCB t n) := by
  induction n with
  | zero => simp only [pow_zero, powCB, matCB_zero]
  | succ n ih => simp only [pow_succ, ih, matCB_mul, powCB]

theorem powCB_seven : ∀ t : P4, powCB t 7 = 0 := by decide +kernel

/-- **`⟨V'c, V'b⟩` has exponent seven.** -/
theorem pow_seven_of_mem_closure_cb {x : GL4}
    (hx : x ∈ Subgroup.closure ({uC, uB} : Set GL4)) : x ^ 7 = 1 := by
  obtain ⟨t, ht⟩ := exists_matCB_of_mem_closure hx
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, ht, matCB_pow, powCB_seven, matCB_zero, Units.val_one]

/-- `[V'c, V'b]`, the parameter `(0, 0, 1, 1)`. -/
def dCB : GL4 := comm uC uB

/-- `[V'c, V'b, V'b]⁴`, the parameter `(0, 0, 0, 1)`. -/
def eCB : GL4 := comm3 uC uB uB ^ 4

theorem val_dCB : (dCB : Mat) = matCB (0, 0, 1, 1) := by decide +kernel

theorem val_eCB : (eCB : Mat) = matCB (0, 0, 0, 1) := by decide +kernel

/-- The word `V'c^i V'b^j dCB^k eCB^(u − k + jk)` reaching the parameter `(i, j, k, u)`. -/
def wordCB (t : P4) : GL4 :=
  uC ^ t.1.val * uB ^ t.2.1.val * dCB ^ t.2.2.1.val *
    eCB ^ (t.2.2.2 - t.2.2.1 + t.2.1 * t.2.2.1).val

theorem wordCB_mem (t : P4) : wordCB t ∈ Subgroup.closure ({uC, uB} : Set GL4) := by
  have hc := mem_closure_pair_left uC uB
  have hb := mem_closure_pair_right uC uB
  have hd : dCB ∈ Subgroup.closure ({uC, uB} : Set GL4) := comm_mem_closure hc hb
  have he : eCB ∈ Subgroup.closure ({uC, uB} : Set GL4) :=
    pow_mem (comm_mem_closure hd hb) 4
  exact mul_mem (mul_mem (mul_mem (pow_mem hc _) (pow_mem hb _)) (pow_mem hd _)) (pow_mem he _)

theorem powCB_word : ∀ t : P4,
    mulCB (mulCB (mulCB (powCB (1, 0, 0, 0) t.1.val) (powCB (0, 1, 0, 0) t.2.1.val))
      (powCB (0, 0, 1, 1) t.2.2.1.val))
      (powCB (0, 0, 0, 1) (t.2.2.2 - t.2.2.1 + t.2.1 * t.2.2.1).val) = t := by
  decide +kernel

theorem val_wordCB (t : P4) : (wordCB t : Mat) = matCB t := by
  rw [wordCB, Units.val_mul, Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val,
    Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, val_uC_cb,
    val_uB_cb, val_dCB, val_eCB, matCB_pow, matCB_pow, matCB_pow, matCB_pow, matCB_mul,
    matCB_mul, matCB_mul, powCB_word]

/-- **`⟨V'c, V'b⟩` has at least `7⁴` elements.** -/
theorem card_closure_cb : 7 ^ 4 ≤ Nat.card (Subgroup.closure ({uC, uB} : Set GL4)) := by
  have hinj : Function.Injective
      (fun t : P4 => (⟨wordCB t, wordCB_mem t⟩ : Subgroup.closure ({uC, uB} : Set GL4))) := by
    intro s t hst
    apply matCB_injective
    have h := congrArg (fun y : Subgroup.closure ({uC, uB} : Set GL4) => ((y : GL4) : Mat)) hst
    simpa only [val_wordCB] using h
  have h := Nat.card_le_card_of_injective _ hinj
  simpa using h

/-! ## The family `ψ⟨c, a⟩` -/

/-- `matCA (i, j, k, w)`: rows `(1,−k,w,j)`, `(0,1,j,0)`, `(0,0,1,0)`, `(0,i,k+ij,1)`. -/
def matCA (t : P4) : Mat :=
  !![1, -t.2.2.1, t.2.2.2, t.2.1; 0, 1, t.2.1, 0; 0, 0, 1, 0;
    0, t.1, t.2.2.1 + t.1 * t.2.1, 1]

/-- The group law of the family `matCA`. -/
def mulCA (s t : P4) : P4 :=
  (s.1 + t.1, s.2.1 + t.2.1, s.2.2.1 + t.2.2.1 - s.2.1 * t.1,
    s.2.2.2 + t.2.2.2 - s.2.2.1 * t.2.1 + s.2.1 * (t.2.2.1 + t.1 * t.2.1))

theorem matCA_mul (s t : P4) : matCA s * matCA t = matCA (mulCA s t) := by
  obtain ⟨i, j, k, w⟩ := s
  obtain ⟨i', j', k', w'⟩ := t
  ext r c
  fin_cases r <;> fin_cases c <;>
    simp [matCA, mulCA, Matrix.mul_apply, Fin.sum_univ_four] <;> ring

theorem matCA_zero : matCA 0 = 1 := by decide +kernel

theorem matCA_injective : Function.Injective matCA := by
  rintro ⟨i, j, k, w⟩ ⟨i', j', k', w'⟩ h
  have h1 := congrFun (congrFun h 3) 1
  have h2 := congrFun (congrFun h 0) 3
  have h3 := congrFun (congrFun h 0) 1
  have h4 := congrFun (congrFun h 0) 2
  simp [matCA] at h1 h2 h3 h4
  exact Prod.ext h1 (Prod.ext h2 (Prod.ext h3 h4))

theorem val_uC_ca : (uC : Mat) = matCA (1, 0, 0, 0) := by decide +kernel

theorem val_uC_inv_ca : ((uC⁻¹ : GL4) : Mat) = matCA (-1, 0, 0, 0) := by decide +kernel

theorem val_uA_ca : (uA : Mat) = matCA (0, 1, 0, 0) := by decide +kernel

theorem val_uA_inv_ca : ((uA⁻¹ : GL4) : Mat) = matCA (0, -1, 0, 0) := by decide +kernel

theorem exists_matCA_of_mem_closure {x : GL4}
    (hx : x ∈ Subgroup.closure ({uC, uA} : Set GL4)) : ∃ t, (x : Mat) = matCA t := by
  induction hx using Subgroup.closure_induction_left with
  | one => exact ⟨0, by rw [Units.val_one, matCA_zero]⟩
  | mul_left g hg y _ ih =>
    obtain ⟨t, ht⟩ := ih
    rcases hg with rfl | rfl
    · exact ⟨mulCA (1, 0, 0, 0) t, by rw [Units.val_mul, ht, val_uC_ca, matCA_mul]⟩
    · exact ⟨mulCA (0, 1, 0, 0) t, by rw [Units.val_mul, ht, val_uA_ca, matCA_mul]⟩
  | inv_mul_cancel g hg y _ ih =>
    obtain ⟨t, ht⟩ := ih
    rcases hg with rfl | rfl
    · exact ⟨mulCA (-1, 0, 0, 0) t, by rw [Units.val_mul, ht, val_uC_inv_ca, matCA_mul]⟩
    · exact ⟨mulCA (0, -1, 0, 0) t, by rw [Units.val_mul, ht, val_uA_inv_ca, matCA_mul]⟩

/-- Powers in the parameter law of `matCA`. -/
def powCA (t : P4) : ℕ → P4
  | 0 => 0
  | n + 1 => mulCA (powCA t n) t

theorem matCA_pow (t : P4) (n : ℕ) : matCA t ^ n = matCA (powCA t n) := by
  induction n with
  | zero => simp only [pow_zero, powCA, matCA_zero]
  | succ n ih => simp only [pow_succ, ih, matCA_mul, powCA]

theorem powCA_seven : ∀ t : P4, powCA t 7 = 0 := by decide +kernel

/-- **`⟨V'c, V'a⟩` has exponent seven.** -/
theorem pow_seven_of_mem_closure_ca {x : GL4}
    (hx : x ∈ Subgroup.closure ({uC, uA} : Set GL4)) : x ^ 7 = 1 := by
  obtain ⟨t, ht⟩ := exists_matCA_of_mem_closure hx
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, ht, matCA_pow, powCA_seven, matCA_zero, Units.val_one]

/-- `[V'c, V'a]`, the parameter `(0, 0, 1, 6)`. -/
def dCA : GL4 := comm uC uA

/-- `[V'c, V'a, V'a]³`, the parameter `(0, 0, 0, 1)`. -/
def eCA : GL4 := comm3 uC uA uA ^ 3

theorem val_dCA : (dCA : Mat) = matCA (0, 0, 1, 6) := by decide +kernel

theorem val_eCA : (eCA : Mat) = matCA (0, 0, 0, 1) := by decide +kernel

/-- The word `V'c^i V'a^j dCA^k eCA^(w − 6k − jk)` reaching the parameter `(i, j, k, w)`. -/
def wordCA (t : P4) : GL4 :=
  uC ^ t.1.val * uA ^ t.2.1.val * dCA ^ t.2.2.1.val *
    eCA ^ (t.2.2.2 - 6 * t.2.2.1 - t.2.1 * t.2.2.1).val

theorem wordCA_mem (t : P4) : wordCA t ∈ Subgroup.closure ({uC, uA} : Set GL4) := by
  have hc := mem_closure_pair_left uC uA
  have ha := mem_closure_pair_right uC uA
  have hd : dCA ∈ Subgroup.closure ({uC, uA} : Set GL4) := comm_mem_closure hc ha
  have he : eCA ∈ Subgroup.closure ({uC, uA} : Set GL4) :=
    pow_mem (comm_mem_closure hd ha) 3
  exact mul_mem (mul_mem (mul_mem (pow_mem hc _) (pow_mem ha _)) (pow_mem hd _)) (pow_mem he _)

theorem powCA_word : ∀ t : P4,
    mulCA (mulCA (mulCA (powCA (1, 0, 0, 0) t.1.val) (powCA (0, 1, 0, 0) t.2.1.val))
      (powCA (0, 0, 1, 6) t.2.2.1.val))
      (powCA (0, 0, 0, 1) (t.2.2.2 - 6 * t.2.2.1 - t.2.1 * t.2.2.1).val) = t := by
  decide +kernel

theorem val_wordCA (t : P4) : (wordCA t : Mat) = matCA t := by
  rw [wordCA, Units.val_mul, Units.val_mul, Units.val_mul, Units.val_pow_eq_pow_val,
    Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, val_uC_ca,
    val_uA_ca, val_dCA, val_eCA, matCA_pow, matCA_pow, matCA_pow, matCA_pow, matCA_mul,
    matCA_mul, matCA_mul, powCA_word]

/-- **`⟨V'c, V'a⟩` has at least `7⁴` elements.** -/
theorem card_closure_ca : 7 ^ 4 ≤ Nat.card (Subgroup.closure ({uC, uA} : Set GL4)) := by
  have hinj : Function.Injective
      (fun t : P4 => (⟨wordCA t, wordCA_mem t⟩ : Subgroup.closure ({uC, uA} : Set GL4))) := by
    intro s t hst
    apply matCA_injective
    have h := congrArg (fun y : Subgroup.closure ({uC, uA} : Set GL4) => ((y : GL4) : Mat)) hst
    simpa only [val_wordCA] using h
  have h := Nat.card_le_card_of_injective _ hinj
  simpa using h

