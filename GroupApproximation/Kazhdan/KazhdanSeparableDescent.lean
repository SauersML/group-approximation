import GroupApproximation.Kazhdan.KazhdanUniverse
import GroupApproximation.Manuscript.OneSidedMFRadical.RankTwelveConfiguration

/-!
# Property `(T)` for the rank-twelve groups at every representation universe

`GroupApproximation.HasKazhdanPropertyT.{u, v}` quantifies over complete real
inner product spaces in `Type v`, and its own docstring warns that the name
carries no universe-independence theorem.  The manuscript's `thm:headline`
(Theorem B) asserts the clause "`H` has property `(T)`" as a *conclusion*, and
the repository proves it only in the form `HasKazhdanPropertyT.{0, 0} H`
(`RankTwelveEndpoint.hasKazhdanPropertyT`,
`RankTwelveEndpoint.corner_hasKazhdanPropertyT`).  Read naively, that is a
weaker assertion than the printed one, which quantifies over all Hilbert
spaces.

**The descent that removes the gap is already a theorem of this development.**
`Kazhdan/KazhdanUniverse.IsKazhdanPair.liftUniverse` proves

  `IsKazhdanPair.{u, u} G Q ε → IsKazhdanPair.{u, w} G Q ε`

for every group `G : Type u`, every `Q`, every `ε`, and every `w`, with no
countability hypothesis at all.  Its proof is the cyclic-subrepresentation
argument in the sharp form: the subrepresentation generated by an almost
invariant vector `x` is the GNS representation of the diagonal matrix
coefficient `g ↦ ⟪x, ρ g x⟫`, and that Hilbert space is manufactured out of
`G` alone, so it lives in `Type u` whatever universe the ambient space `E`
came from.  Separability of the closed orbit span — the route that would need
`G` countable — is therefore not required; the GNS route replaces it and is
strictly more general.  The converse move, `IsKazhdanPair.lowerUniverse`, goes
back down along `ULift`, so the two readings are *equivalent*, not merely
comparable.

This module records the two consequences that the ledger needs:

* `hasKazhdanPropertyT_type0_iff`: for a group whose carrier is `Type`, the
  `Type 0` representation-universe reading and the `Type v` reading are the
  same proposition, for every `v`.  So `HasKazhdanPropertyT.{0, 0}` as a
  *conclusion* is not weaker than the printed clause.
* the specializations to the two rank-twelve groups, in both the real
  orthogonal and the textbook complex-unitary forms.

One formal caveat, which is a fact about Lean rather than about property `(T)`:
a `Prop` cannot quantify over universes, so "property `(T)` at every
representation universe" is necessarily stated as a universe-polymorphic
*theorem* — as below — and cannot be folded into the single proposition
`BinaryLeavittFullRadical`.  What that proposition may carry is the `{0, 0}`
clause together with a citation of `rankTwelve_hasKazhdanPropertyT_anyUniverse`
for the upgrade.
-/

namespace GroupApproximation

universe u v

open Manuscript.OneSidedMFRadical

/-! ## The descent, in the shape the manuscript uses -/

/-- **The representation universe is immaterial for a `Type 0` group.**  For
`G : Type`, property `(T)` against real Hilbert spaces in `Type 0` and property
`(T)` against real Hilbert spaces in `Type v` are the same statement.

Forward direction: `IsKazhdanPair.liftUniverse`, the GNS argument.  Reverse
direction: `IsKazhdanPair.lowerUniverse`, transport along `ULift`. -/
theorem hasKazhdanPropertyT_type0_iff {G : Type} [Group G] :
    HasKazhdanPropertyT.{0, 0} G ↔ HasKazhdanPropertyT.{0, v} G := by
  refine ⟨fun h ↦ h.liftUniverse, ?_⟩
  rintro ⟨Q, a, h⟩
  exact ⟨Q, a, h.lowerUniverse⟩

/-- **Property `(T)` transported from a `Type 0` model, at every
representation universe.**  A group in any carrier universe that is isomorphic
to a group whose carrier is `Type` inherits property `(T)` against real Hilbert
spaces in every universe from the `{0, 0}` statement about that model.

Combined with `Type0Transfer.exists_type0_model` in `Sofic/Type0Transfer.lean`,
which produces such a model for every countable group, this is the
countable-group form of the descent named in the audit. -/
theorem HasKazhdanPropertyT.ofType0Model {G : Type u} [Group G]
    {G₀ : Type} [Group G₀] (e : G ≃* G₀)
    (h : HasKazhdanPropertyT.{0, 0} G₀) : HasKazhdanPropertyT.{u, v} G :=
  HasKazhdanPropertyT.of_mulEquiv e h.liftUniverse

/-! ## The rank-twelve endpoints

`H = EL₁₂(L_{𝔽₂}(1,2))` and its upper-left `EL₃` corner, at every
representation universe.
-/

/-- **The Theorem B property-`(T)` clause, at every representation universe.**
`H = EL₁₂(L_{𝔽₂}(1,2))` has property `(T)` against complete real inner product
spaces in `Type v`, for every `v`. -/
theorem rankTwelve_hasKazhdanPropertyT_anyUniverse :
    HasKazhdanPropertyT.{0, v} RankTwelveEndpoint.H :=
  HasKazhdanPropertyT.liftUniverse RankTwelveEndpoint.hasKazhdanPropertyT

/-- The upper-left `EL₃` corner of `H` has property `(T)` against complete real
inner product spaces in `Type v`, for every `v`. -/
theorem rankTwelveCorner_hasKazhdanPropertyT_anyUniverse :
    HasKazhdanPropertyT.{0, v} RankTwelveEndpoint.corner :=
  HasKazhdanPropertyT.liftUniverse RankTwelveEndpoint.corner_hasKazhdanPropertyT

/-- **The printed clause, verbatim.**  `H = EL₁₂(L_{𝔽₂}(1,2))` has Kazhdan's
property `(T)` in the textbook complex-unitary form, against complete complex
inner product spaces in `Type v`, for every `v`. -/
theorem rankTwelve_hasKazhdanPropertyTComplex_anyUniverse :
    HasKazhdanPropertyTComplex.{0, v} RankTwelveEndpoint.H :=
  hasKazhdanPropertyT_iff_complex.mp
    rankTwelve_hasKazhdanPropertyT_anyUniverse

/-- The upper-left `EL₃` corner of `H` has property `(T)` in the textbook
complex-unitary form, at every representation universe. -/
theorem rankTwelveCorner_hasKazhdanPropertyTComplex_anyUniverse :
    HasKazhdanPropertyTComplex.{0, v} RankTwelveEndpoint.corner :=
  hasKazhdanPropertyT_iff_complex.mp
    rankTwelveCorner_hasKazhdanPropertyT_anyUniverse

/-- **The full universe profile of the rank-twelve property-`(T)` clauses.**
Both groups named in `thm:headline` and in the printed compression
configuration have property `(T)` in the real orthogonal *and* the textbook
complex-unitary formulations, against Hilbert spaces in `Type v`, for every
`v`.  Nothing here is conditional. -/
theorem rankTwelve_propertyT_universe_profile :
    HasKazhdanPropertyT.{0, v} RankTwelveEndpoint.H ∧
      HasKazhdanPropertyTComplex.{0, v} RankTwelveEndpoint.H ∧
      HasKazhdanPropertyT.{0, v} RankTwelveEndpoint.corner ∧
      HasKazhdanPropertyTComplex.{0, v} RankTwelveEndpoint.corner :=
  ⟨rankTwelve_hasKazhdanPropertyT_anyUniverse,
    rankTwelve_hasKazhdanPropertyTComplex_anyUniverse,
    rankTwelveCorner_hasKazhdanPropertyT_anyUniverse,
    rankTwelveCorner_hasKazhdanPropertyTComplex_anyUniverse⟩

end GroupApproximation
