import GroupApproximation.Kazhdan.GHWPlaces
import Mathlib.Algebra.Ring.Subring.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# Finitely generated subgroups of `GL_2`: entries in a finitely generated ring

Reductions toward "every countable subgroup of `GL_2` over a field has the Haagerup property"
(`non_mf_groups_exist.tex`, the remark after `prop:torsion-defect-ring`, tex lines 1146--1147).

* The matrices whose entries and inverse entries lie in a subring `R` form a subgroup
  (`entrySubgroup`), so a subgroup generated by a finite set `s` has all its entries in the ring
  generated by the finitely many entries of `s` and of the inverses (`entryFinset`).
* **Corestriction** (`corestrict`): a homomorphism into `GL_2(K)` all of whose entries lie in the
  image of a field homomorphism `ι : F → K` factors through `GL_2(F)`.
* **Reduction** (`hasHaagerupProperty_of_finite_entries`): if every group with an injective
  homomorphism into `GL_2(K)` with entries in a finitely generated subring has the Haagerup
  property, then so does every countable subgroup of `GL_2(K)`.
-/

namespace GroupApproximation
namespace GHW

open Haagerup

universe u

variable {K : Type u} [Field K]

/-! ## Subgroups with entries in a subring -/

/-- The matrices whose entries and whose inverse's entries lie in `R`. -/
def entrySubgroup (R : Subring K) : Subgroup (GL (Fin 2) K) where
  carrier := {g | (∀ a b, (g : Matrix (Fin 2) (Fin 2) K) a b ∈ R) ∧
    ∀ a b, ((g⁻¹ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) a b ∈ R}
  one_mem' := by
    have h1 : ∀ a b : Fin 2, ((1 : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) a b ∈ R := by
      intro a b
      rw [Units.val_one, Matrix.one_apply]
      split_ifs
      · exact R.one_mem
      · exact R.zero_mem
    exact ⟨h1, by rw [inv_one]; exact h1⟩
  mul_mem' := by
    rintro g h ⟨hg, hg'⟩ ⟨hh, hh'⟩
    refine ⟨fun a b ↦ ?_, fun a b ↦ ?_⟩
    · rw [Units.val_mul, Matrix.mul_apply]
      exact sum_mem fun c _ ↦ R.mul_mem (hg a c) (hh c b)
    · rw [_root_.mul_inv_rev, Units.val_mul, Matrix.mul_apply]
      exact sum_mem fun c _ ↦ R.mul_mem (hh' a c) (hg' c b)
  inv_mem' := by
    rintro g ⟨hg, hg'⟩
    exact ⟨hg', by rw [inv_inv]; exact hg⟩

/-- The entries of the matrices of `s` and of their inverses. -/
noncomputable def entryFinset (s : Finset (GL (Fin 2) K)) : Finset K := by
  classical
  exact s.biUnion fun g ↦
    (Finset.univ : Finset (Fin 2 × Fin 2)).image (fun p ↦ (g : Matrix (Fin 2) (Fin 2) K) p.1 p.2) ∪
      (Finset.univ : Finset (Fin 2 × Fin 2)).image
        (fun p ↦ ((g⁻¹ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) p.1 p.2)

theorem closure_le_entrySubgroup (s : Finset (GL (Fin 2) K)) :
    Subgroup.closure (s : Set (GL (Fin 2) K)) ≤
      entrySubgroup (Subring.closure (entryFinset s : Set K)) := by
  classical
  refine (Subgroup.closure_le _).mpr fun g hg ↦ ⟨fun a b ↦ ?_, fun a b ↦ ?_⟩
  · refine Subring.subset_closure ?_
    simp only [entryFinset, Finset.coe_biUnion, Finset.coe_union, Finset.coe_image, Set.mem_iUnion,
      Set.mem_union, Set.mem_image, Finset.mem_coe]
    exact ⟨g, hg, Or.inl ⟨(a, b), Finset.mem_univ _, rfl⟩⟩
  · refine Subring.subset_closure ?_
    simp only [entryFinset, Finset.coe_biUnion, Finset.coe_union, Finset.coe_image, Set.mem_iUnion,
      Set.mem_union, Set.mem_image, Finset.mem_coe]
    exact ⟨g, hg, Or.inr ⟨(a, b), Finset.mem_univ _, rfl⟩⟩

/-! ## Corestriction along a field homomorphism -/

section Corestrict

variable {F : Type u} [Field F] (ι : F →+* K) (hι : Function.Injective ι)
  {Δ : Type} [Group Δ] (ρ : Δ →* GL (Fin 2) K)
  (hρ : ∀ (δ : Δ) (a b : Fin 2), (ρ δ : Matrix (Fin 2) (Fin 2) K) a b ∈ ι.range)

/-- The preimage matrix. -/
noncomputable def corestrictMatrix (δ : Δ) : Matrix (Fin 2) (Fin 2) F :=
  Matrix.of fun a b ↦ Classical.choose (hρ δ a b)

theorem mapMatrix_corestrictMatrix (δ : Δ) :
    ι.mapMatrix (corestrictMatrix ι ρ hρ δ) = (ρ δ : Matrix (Fin 2) (Fin 2) K) := by
  ext a b
  exact Classical.choose_spec (hρ δ a b)

include hι in
theorem mapMatrix_injective : Function.Injective (ι.mapMatrix : Matrix (Fin 2) (Fin 2) F → _) :=
  fun _ _ h ↦ Matrix.ext fun a b ↦ hι (congrFun (congrFun h a) b)

include hι in
theorem corestrictMatrix_mul (δ δ' : Δ) :
    corestrictMatrix ι ρ hρ (δ * δ') = corestrictMatrix ι ρ hρ δ * corestrictMatrix ι ρ hρ δ' := by
  apply mapMatrix_injective ι hι
  rw [map_mul, mapMatrix_corestrictMatrix, mapMatrix_corestrictMatrix, mapMatrix_corestrictMatrix,
    map_mul, Units.val_mul]

include hι in
theorem corestrictMatrix_one : corestrictMatrix ι ρ hρ 1 = 1 := by
  apply mapMatrix_injective ι hι
  rw [mapMatrix_corestrictMatrix, map_one, map_one, Units.val_one]

/-- **Corestriction** of a homomorphism into `GL_2(K)` with entries in `ι(F)`. -/
noncomputable def corestrict : Δ →* GL (Fin 2) F where
  toFun δ :=
    { val := corestrictMatrix ι ρ hρ δ
      inv := corestrictMatrix ι ρ hρ δ⁻¹
      val_inv := by rw [← corestrictMatrix_mul ι hι, mul_inv_cancel, corestrictMatrix_one ι hι]
      inv_val := by rw [← corestrictMatrix_mul ι hι, inv_mul_cancel, corestrictMatrix_one ι hι] }
  map_one' := Units.ext (corestrictMatrix_one ι hι ρ hρ)
  map_mul' δ δ' := Units.ext (corestrictMatrix_mul ι hι ρ hρ δ δ')

theorem corestrict_apply (δ : Δ) (a b : Fin 2) :
    ι ((corestrict ι hι ρ hρ δ : Matrix (Fin 2) (Fin 2) F) a b) = (ρ δ : Matrix (Fin 2) (Fin 2) K) a b :=
  congrFun (congrFun (mapMatrix_corestrictMatrix ι ρ hρ δ) a) b

theorem corestrict_injective (hinj : Function.Injective ρ) :
    Function.Injective (corestrict ι hι ρ hρ) := by
  intro δ δ' h
  apply hinj
  refine Units.ext (Matrix.ext fun a b ↦ ?_)
  rw [← corestrict_apply ι hι ρ hρ δ, ← corestrict_apply ι hι ρ hρ δ', h]

end Corestrict

/-- The homomorphism `GL_2(F) → GL_2(K)` of a field homomorphism is injective. -/
theorem map_injective {F : Type*} [Field F] {E : Type*} [Field E] (φ : F →+* E) :
    Function.Injective (Matrix.GeneralLinearGroup.map (n := Fin 2) φ) := by
  intro g h hgh
  refine Units.ext (Matrix.ext fun a b ↦ φ.injective ?_)
  have := congrArg (fun y : GL (Fin 2) E ↦ (y : Matrix (Fin 2) (Fin 2) E) a b) hgh
  simpa [Matrix.GeneralLinearGroup.map_apply] using this

/-! ## The reduction to finitely generated entries -/

/-- **Reduction to finitely generated entries.** -/
theorem hasHaagerupProperty_of_finite_entries {K : Type} [Field K]
    (hcore : ∀ (Δ : Type) [Group Δ] (ρ : Δ →* GL (Fin 2) K), Function.Injective ρ →
      ∀ S : Finset K, (∀ (δ : Δ) (a b : Fin 2),
        (ρ δ : Matrix (Fin 2) (Fin 2) K) a b ∈ Subring.closure (S : Set K)) →
        HasHaagerupProperty.{0, 0} Δ)
    (Γ : Subgroup (GL (Fin 2) K)) (hΓ : Countable Γ) : HasHaagerupProperty.{0, 0} Γ := by
  classical
  haveI := hΓ
  refine hasHaagerupProperty_of_closure_finset fun s ↦ ?_
  let t : Finset (GL (Fin 2) K) := s.image Γ.subtype
  let ρ : Subgroup.closure (s : Set Γ) →* GL (Fin 2) K :=
    Γ.subtype.comp (Subgroup.closure (s : Set Γ)).subtype
  have hρ : Function.Injective ρ :=
    Γ.subtype_injective.comp (Subgroup.closure (s : Set Γ)).subtype_injective
  refine hcore _ ρ hρ (entryFinset t) fun δ a b ↦ ?_
  have hmap : (Subgroup.closure (s : Set Γ)).map Γ.subtype ≤ Subgroup.closure (t : Set (GL (Fin 2) K)) := by
    rw [MonoidHom.map_closure]
    refine Subgroup.closure_mono ?_
    intro g hg
    obtain ⟨x, hx, rfl⟩ := hg
    exact Finset.mem_coe.mpr (Finset.mem_image_of_mem _ (Finset.mem_coe.mp hx))
  have hmem : ρ δ ∈ Subgroup.closure (t : Set (GL (Fin 2) K)) :=
    hmap ⟨δ.1, δ.2, rfl⟩
  exact (closure_le_entrySubgroup t hmem).1 a b

end GHW
end GroupApproximation

#audit_axioms GroupApproximation.GHW.closure_le_entrySubgroup
#audit_axioms GroupApproximation.GHW.corestrict_injective
#audit_axioms GroupApproximation.GHW.hasHaagerupProperty_of_finite_entries
