import Mathlib.Data.ZMod.QuotientGroup
import Mathlib.GroupTheory.Index
import Mathlib.Tactic.Group
import Mathlib.Tactic.Ring
import GroupApproximation.Kazhdan.KMSGroupPresentation
import GroupApproximation.Meta.AxiomGuard

/-!
# The orders of the vertex groups `U₃(p)` and `U₄(p)`

For `0 < p` the presented groups `U3 p` and `U4 p` of `KMSGroupPresentation` are finite
of order at most `p³` and `p⁴`.

* `card_U3_le`: with `x, y` the generators and `z = [x,y]`, the relators `[x,y,x]` and
  `[x,y,y]` make `z` commute with `x` and `y`, `x ^ p = 1` gives `z ^ p = 1`, and every
  element is `y ^ j * x ^ i * z ^ k` with `i, j, k < p`.
* `card_U4_le`: the relators of `U₄(p)` hold in `U₃(p)`, and the kernel of the
  resulting surjection `U₄(p) → U₃(p)` lies in the central cyclic subgroup generated by
  `w = [x,y,y]`, whose order is at most `p`.
* `injective_of_card_le_card_range`: a homomorphism out of a finite group whose image
  has at least as many elements as the group is injective.  An image of order `p³`
  (resp. `p⁴`) therefore certifies that a homomorphism out of `U₃(p)` (resp. `U₄(p)`)
  is injective (`u3_injective_of_card_range`, `u4_injective_of_card_range`).
-/

namespace GroupApproximation
namespace KMSGroup

/-! ## Identities in an arbitrary group -/

section Identities

variable {G : Type*} [Group G]

/-- A trivial commutator is a commuting pair. -/
theorem commute_of_comm_eq_one {u v : G} (h : comm u v = 1) : Commute u v := by
  have huv : u * v = v * u * comm u v := by
    rw [comm]
    group
  rw [h, mul_one] at huv
  exact huv

/-- A trivial triple commutator gives trivial quadruple commutators. -/
theorem comm4_eq_one_of_comm3_eq_one {x y z w : G} (h : comm3 x y z = 1) :
    comm4 x y z w = 1 := by
  rw [comm4, h]
  simp [comm]

/-- The inverse of an element killed by `p > 0` is its `(p - 1)`-st power. -/
theorem inv_eq_pow_pred {t : G} {p : ℕ} (hp : 0 < p) (ht : t ^ p = 1) :
    t⁻¹ = t ^ (p - 1) := by
  have hp' : p - 1 + 1 = p := by omega
  exact inv_eq_of_mul_eq_one_right (by rw [← pow_succ', hp', ht])

/-- A power of an element killed by `p` depends only on the exponent modulo `p`. -/
theorem pow_mod_eq_pow {t : G} {p : ℕ} (ht : t ^ p = 1) (n : ℕ) : t ^ (n % p) = t ^ n := by
  conv_rhs => rw [← Nat.mod_add_div n p, pow_add, pow_mul, ht, one_pow, mul_one]

/-- `[x,y] ^ p = 1` when `[x,y]` commutes with `x` and `x ^ p = 1`. -/
theorem comm_pow_eq_one {x y : G} {p : ℕ} (hx : x ^ p = 1) (hcx : Commute (comm x y) x) :
    comm x y ^ p = 1 := by
  have h1 : (x * comm x y) ^ p = comm x y ^ p := by
    rw [hcx.symm.mul_pow, hx, one_mul]
  have h2 : x * comm x y = y⁻¹ * x * y⁻¹⁻¹ := by
    rw [comm]
    group
  rw [← h1, h2, conj_pow, hx, mul_one, mul_inv_cancel]

/-- An element commuting with two generators is central. -/
theorem commute_of_closure_eq_top {w x y : G} (hwx : Commute w x) (hwy : Commute w y)
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) (g : G) : Commute w g := by
  have hle : Subgroup.closure ({x, y} : Set G) ≤ Subgroup.centralizer {w} := by
    rw [Subgroup.closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    refine ⟨Subgroup.mem_centralizer_iff.mpr ?_, Subgroup.mem_centralizer_iff.mpr ?_⟩
    · intro h hh
      rw [Set.mem_singleton_iff.mp hh]
      exact hwx.eq
    · intro h hh
      rw [Set.mem_singleton_iff.mp hh]
      exact hwy.eq
  have hg : g ∈ Subgroup.centralizer ({w} : Set G) :=
    hle (by rw [hgen]; exact Subgroup.mem_top g)
  exact Subgroup.mem_centralizer_iff.mp hg w (Set.mem_singleton w)

/-- The cyclic subgroup generated by a central element is normal. -/
theorem zpowers_normal_of_commute {w : G} (hw : ∀ g : G, Commute w g) :
    (Subgroup.zpowers w).Normal := by
  refine ⟨fun n hn g => ?_⟩
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hn
  rw [← ((hw g).zpow_left k).eq, mul_inv_cancel_right]
  exact Subgroup.zpow_mem_zpowers w k

/-- `x ^ i * y = y * x ^ i * z ^ i` when `x * y = y * x * z` and `z` commutes with `x`. -/
theorem pow_mul_eq_mul_pow_mul_pow {x y z : G} (hxy : x * y = y * x * z)
    (hzx : Commute z x) : ∀ i : ℕ, x ^ i * y = y * x ^ i * z ^ i
  | 0 => by simp
  | i + 1 => by
    have ih := pow_mul_eq_mul_pow_mul_pow hxy hzx i
    have hc : z * x ^ i = x ^ i * z := (hzx.pow_right i).eq
    calc x ^ (i + 1) * y = x * (x ^ i * y) := by rw [pow_succ', mul_assoc]
      _ = x * y * x ^ i * z ^ i := by rw [ih]; simp only [mul_assoc]
      _ = y * x * (z * x ^ i) * z ^ i := by rw [hxy]; simp only [mul_assoc]
      _ = y * x ^ (i + 1) * z ^ (i + 1) := by
        rw [hc, pow_succ' x, pow_succ' z]
        simp only [mul_assoc]

/-- The normal form `y ^ j * x ^ i * z ^ k` is stable under right multiplication by `x`. -/
theorem nf_mul_x {x y z g : G} (hzx : Commute z x)
    (hg : ∃ j i k : ℕ, g = y ^ j * x ^ i * z ^ k) :
    ∃ j i k : ℕ, g * x = y ^ j * x ^ i * z ^ k := by
  obtain ⟨j, i, k, rfl⟩ := hg
  refine ⟨j, i + 1, k, ?_⟩
  rw [pow_succ x, mul_assoc (y ^ j * x ^ i), (hzx.pow_left k).eq]
  simp only [mul_assoc]

/-- The normal form `y ^ j * x ^ i * z ^ k` is stable under right multiplication by `y`. -/
theorem nf_mul_y {x y z g : G} (hxy : x * y = y * x * z) (hzx : Commute z x)
    (hzy : Commute z y) (hg : ∃ j i k : ℕ, g = y ^ j * x ^ i * z ^ k) :
    ∃ j i k : ℕ, g * y = y ^ j * x ^ i * z ^ k := by
  obtain ⟨j, i, k, rfl⟩ := hg
  refine ⟨j + 1, i, i + k, ?_⟩
  rw [mul_assoc (y ^ j * x ^ i), (hzy.pow_left k).eq, ← mul_assoc, mul_assoc (y ^ j),
    pow_mul_eq_mul_pow_mul_pow hxy hzx i, pow_succ y, pow_add z]
  simp only [mul_assoc]

/-- A normal form stable under right multiplication by `t` is stable under its powers. -/
theorem nf_mul_pow {x y z t : G}
    (step : ∀ g : G, (∃ j i k : ℕ, g = y ^ j * x ^ i * z ^ k) →
      ∃ j i k : ℕ, g * t = y ^ j * x ^ i * z ^ k) :
    ∀ (n : ℕ) (g : G), (∃ j i k : ℕ, g = y ^ j * x ^ i * z ^ k) →
      ∃ j i k : ℕ, g * t ^ n = y ^ j * x ^ i * z ^ k
  | 0, g, hg => by
    rw [pow_zero, mul_one]
    exact hg
  | n + 1, g, hg => by
    rw [pow_succ', ← mul_assoc]
    exact nf_mul_pow step n (g * t) (step g hg)

/-- **Heisenberg normal form.**  In a group generated by `x` and `y` with `x ^ p = 1`,
`y ^ p = 1`, `x * y = y * x * z` and `z` commuting with `x` and `y`, every element is
`y ^ j * x ^ i * z ^ k`. -/
theorem nf_of_closure_eq_top {x y z : G} {p : ℕ} (hp : 0 < p) (hx : x ^ p = 1)
    (hy : y ^ p = 1) (hxy : x * y = y * x * z) (hzx : Commute z x) (hzy : Commute z y)
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) (g : G) :
    ∃ j i k : ℕ, g = y ^ j * x ^ i * z ^ k := by
  have stepx : ∀ g : G, (∃ j i k : ℕ, g = y ^ j * x ^ i * z ^ k) →
      ∃ j i k : ℕ, g * x = y ^ j * x ^ i * z ^ k := fun _ hg => nf_mul_x hzx hg
  have stepy : ∀ g : G, (∃ j i k : ℕ, g = y ^ j * x ^ i * z ^ k) →
      ∃ j i k : ℕ, g * y = y ^ j * x ^ i * z ^ k := fun _ hg => nf_mul_y hxy hzx hzy hg
  have hg : g ∈ Subgroup.closure ({x, y} : Set G) := by
    rw [hgen]
    exact Subgroup.mem_top g
  induction hg using Subgroup.closure_induction_right with
  | one => exact ⟨0, 0, 0, by simp⟩
  | mul_right g _ t ht ih =>
    rcases Set.mem_insert_iff.mp ht with ht | ht
    · rw [ht]
      exact stepx g ih
    · rw [Set.mem_singleton_iff.mp ht]
      exact stepy g ih
  | mul_inv_cancel g _ t ht ih =>
    rcases Set.mem_insert_iff.mp ht with ht | ht
    · rw [ht, inv_eq_pow_pred hp hx]
      exact nf_mul_pow stepx (p - 1) g ih
    · rw [Set.mem_singleton_iff.mp ht, inv_eq_pow_pred hp hy]
      exact nf_mul_pow stepy (p - 1) g ih

/-- **Order bound for a Heisenberg-type group.**  A group generated by `x` and `y` with
`x ^ p = y ^ p = 1` and `[x,y,x] = [x,y,y] = 1` is finite of order at most `p³`. -/
theorem finite_and_card_le_of_heisenberg {x y : G} {p : ℕ} (hp : 0 < p) (hx : x ^ p = 1)
    (hy : y ^ p = 1) (hxyx : comm3 x y x = 1) (hxyy : comm3 x y y = 1)
    (hgen : Subgroup.closure ({x, y} : Set G) = ⊤) :
    Finite G ∧ Nat.card G ≤ p ^ 3 := by
  have hzx : Commute (comm x y) x := commute_of_comm_eq_one hxyx
  have hzy : Commute (comm x y) y := commute_of_comm_eq_one hxyy
  have hz : comm x y ^ p = 1 := comm_pow_eq_one hx hzx
  have hxy : x * y = y * x * comm x y := by
    rw [comm]
    group
  let f : Fin p × Fin p × Fin p → G := fun q =>
    y ^ (q.1 : ℕ) * x ^ (q.2.1 : ℕ) * comm x y ^ (q.2.2 : ℕ)
  have hf : Function.Surjective f := by
    intro g
    obtain ⟨j, i, k, rfl⟩ := nf_of_closure_eq_top hp hx hy hxy hzx hzy hgen g
    refine ⟨(⟨j % p, Nat.mod_lt _ hp⟩, ⟨i % p, Nat.mod_lt _ hp⟩, ⟨k % p, Nat.mod_lt _ hp⟩), ?_⟩
    show y ^ (j % p) * x ^ (i % p) * comm x y ^ (k % p) = y ^ j * x ^ i * comm x y ^ k
    rw [pow_mod_eq_pow hy, pow_mod_eq_pow hx, pow_mod_eq_pow hz]
  refine ⟨Finite.of_surjective f hf, ?_⟩
  calc Nat.card G ≤ Nat.card (Fin p × Fin p × Fin p) := Nat.card_le_card_of_surjective f hf
    _ = p ^ 3 := by rw [Nat.card_prod, Nat.card_prod, Nat.card_fin, pow_three]

end Identities

/-! ## `U₃(p)` -/

/-- The generator `x` of `U₃(p)`. -/
def u3x (p : ℕ) : U3 p := PresentedGroup.of 0

/-- The generator `y` of `U₃(p)`. -/
def u3y (p : ℕ) : U3 p := PresentedGroup.of 1

/-- A listed relator is trivial in `U₃(p)`. -/
theorem u3_mk_relator {p : ℕ} {r : FreeGroup (Fin 2)} (hr : r ∈ u3RelatorList p) :
    PresentedGroup.mk (u3Relators p) r = 1 :=
  PresentedGroup.mk_eq_one_iff.mpr
    (Subgroup.subset_normalClosure (by simpa [u3Relators] using hr))

theorem u3x_pow (p : ℕ) : u3x p ^ p = 1 := by
  have h := u3_mk_relator (p := p) (r := gx ^ p) (by simp [u3RelatorList])
  rw [map_pow] at h
  exact h

theorem u3y_pow (p : ℕ) : u3y p ^ p = 1 := by
  have h := u3_mk_relator (p := p) (r := gy ^ p) (by simp [u3RelatorList])
  rw [map_pow] at h
  exact h

theorem u3_rel_xyx (p : ℕ) : comm3 (u3x p) (u3y p) (u3x p) = 1 := by
  have h := u3_mk_relator (p := p) (r := comm3 gx gy gx) (by simp [u3RelatorList])
  rw [map_comm3] at h
  exact h

theorem u3_rel_xyy (p : ℕ) : comm3 (u3x p) (u3y p) (u3y p) = 1 := by
  have h := u3_mk_relator (p := p) (r := comm3 gx gy gy) (by simp [u3RelatorList])
  rw [map_comm3] at h
  exact h

/-- `x` and `y` generate `U₃(p)`. -/
theorem closure_u3_generators (p : ℕ) :
    Subgroup.closure ({u3x p, u3y p} : Set (U3 p)) = ⊤ := by
  rw [eq_top_iff, ← PresentedGroup.closure_range_of (u3Relators p), Subgroup.closure_le,
    Set.range_subset_iff]
  refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
  · exact Subgroup.subset_closure (Set.mem_insert _ _)
  · exact Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- **`U₃(p)` is finite.** -/
theorem finite_U3 {p : ℕ} (hp : 0 < p) : Finite (U3 p) :=
  (finite_and_card_le_of_heisenberg hp (u3x_pow p) (u3y_pow p) (u3_rel_xyx p) (u3_rel_xyy p)
    (closure_u3_generators p)).1

/-- **`|U₃(p)| ≤ p³`.** -/
theorem card_U3_le {p : ℕ} (hp : 0 < p) : Nat.card (U3 p) ≤ p ^ 3 :=
  (finite_and_card_le_of_heisenberg hp (u3x_pow p) (u3y_pow p) (u3_rel_xyx p) (u3_rel_xyy p)
    (closure_u3_generators p)).2

/-! ## `U₄(p)` -/

/-- The generator `x` of `U₄(p)`. -/
def u4x (p : ℕ) : U4 p := PresentedGroup.of 0

/-- The generator `y` of `U₄(p)`. -/
def u4y (p : ℕ) : U4 p := PresentedGroup.of 1

/-- A listed relator is trivial in `U₄(p)`. -/
theorem u4_mk_relator {p : ℕ} {r : FreeGroup (Fin 2)} (hr : r ∈ u4RelatorList p) :
    PresentedGroup.mk (u4Relators p) r = 1 :=
  PresentedGroup.mk_eq_one_iff.mpr
    (Subgroup.subset_normalClosure (by simpa [u4Relators] using hr))

theorem u4x_pow (p : ℕ) : u4x p ^ p = 1 := by
  have h := u4_mk_relator (p := p) (r := gx ^ p) (by simp [u4RelatorList])
  rw [map_pow] at h
  exact h

theorem u4y_pow (p : ℕ) : u4y p ^ p = 1 := by
  have h := u4_mk_relator (p := p) (r := gy ^ p) (by simp [u4RelatorList])
  rw [map_pow] at h
  exact h

theorem u4_rel_xyx (p : ℕ) : comm3 (u4x p) (u4y p) (u4x p) = 1 := by
  have h := u4_mk_relator (p := p) (r := comm3 gx gy gx) (by simp [u4RelatorList])
  rw [map_comm3] at h
  exact h

theorem u4_rel_xyyx (p : ℕ) : comm4 (u4x p) (u4y p) (u4y p) (u4x p) = 1 := by
  have h := u4_mk_relator (p := p) (r := comm4 gx gy gy gx) (by simp [u4RelatorList])
  rw [map_comm4] at h
  exact h

theorem u4_rel_xyyy (p : ℕ) : comm4 (u4x p) (u4y p) (u4y p) (u4y p) = 1 := by
  have h := u4_mk_relator (p := p) (r := comm4 gx gy gy gy) (by simp [u4RelatorList])
  rw [map_comm4] at h
  exact h

/-- `x` and `y` generate `U₄(p)`. -/
theorem closure_u4_generators (p : ℕ) :
    Subgroup.closure ({u4x p, u4y p} : Set (U4 p)) = ⊤ := by
  rw [eq_top_iff, ← PresentedGroup.closure_range_of (u4Relators p), Subgroup.closure_le,
    Set.range_subset_iff]
  refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
  · exact Subgroup.subset_closure (Set.mem_insert _ _)
  · exact Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))

/-- The central element `w = [x,y,y]` of `U₄(p)`. -/
def u4Center (p : ℕ) : U4 p := comm3 (u4x p) (u4y p) (u4y p)

/-- `w = [x,y,y]` is central in `U₄(p)`. -/
theorem u4Center_commute (p : ℕ) (g : U4 p) : Commute (u4Center p) g :=
  commute_of_closure_eq_top (commute_of_comm_eq_one (u4_rel_xyyx p))
    (commute_of_comm_eq_one (u4_rel_xyyy p)) (closure_u4_generators p) g

instance u4Center_normal (p : ℕ) : (Subgroup.zpowers (u4Center p)).Normal :=
  zpowers_normal_of_commute (u4Center_commute p)

/-- `w ^ p = 1` in `U₄(p)`. -/
theorem u4Center_pow (p : ℕ) : u4Center p ^ p = 1 :=
  comm_pow_eq_one (comm_pow_eq_one (u4x_pow p) (commute_of_comm_eq_one (u4_rel_xyx p)))
    (u4Center_commute p _)

/-- The relators of `U₄(p)` hold in `U₃(p)`. -/
def u4ToU3 (p : ℕ) : U4 p →* U3 p :=
  PresentedGroup.toGroup (f := PresentedGroup.of) (by
    intro r hr
    have hr' : r ∈ u4RelatorList p := by simpa [u4Relators] using hr
    simp only [u4RelatorList, List.mem_cons, List.mem_nil_iff, or_false] at hr'
    rcases hr' with rfl | rfl | rfl | rfl | rfl
    · simpa [u3x] using u3x_pow p
    · simpa [u3y] using u3y_pow p
    · simpa [u3x, u3y] using u3_rel_xyx p
    · simpa [u3x, u3y] using comm4_eq_one_of_comm3_eq_one (w := u3x p) (u3_rel_xyy p)
    · simpa [u3x, u3y] using comm4_eq_one_of_comm3_eq_one (w := u3y p) (u3_rel_xyy p))

theorem u4ToU3_of (p : ℕ) (i : Fin 2) :
    u4ToU3 p (PresentedGroup.of i) = PresentedGroup.of i :=
  PresentedGroup.toGroup.of _

/-- The relators of `U₃(p)` hold in `U₄(p) ⧸ ⟨w⟩`. -/
def u3ToU4Quot (p : ℕ) : U3 p →* U4 p ⧸ Subgroup.zpowers (u4Center p) :=
  PresentedGroup.toGroup
    (f := fun i => QuotientGroup.mk' (Subgroup.zpowers (u4Center p)) (PresentedGroup.of i)) (by
    intro r hr
    have hr' : r ∈ u3RelatorList p := by simpa [u3Relators] using hr
    simp only [u3RelatorList, List.mem_cons, List.mem_nil_iff, or_false] at hr'
    rcases hr' with rfl | rfl | rfl | rfl
    · simp only [map_pow, FreeGroup.lift_apply_of]
      rw [← map_pow]
      exact (congrArg (QuotientGroup.mk' (Subgroup.zpowers (u4Center p))) (u4x_pow p)).trans
        (map_one _)
    · simp only [map_pow, FreeGroup.lift_apply_of]
      rw [← map_pow]
      exact (congrArg (QuotientGroup.mk' (Subgroup.zpowers (u4Center p))) (u4y_pow p)).trans
        (map_one _)
    · simp only [map_comm3, FreeGroup.lift_apply_of]
      rw [← map_comm3]
      exact (congrArg (QuotientGroup.mk' (Subgroup.zpowers (u4Center p))) (u4_rel_xyx p)).trans
        (map_one _)
    · simp only [map_comm3, FreeGroup.lift_apply_of]
      rw [← map_comm3]
      exact (QuotientGroup.eq_one_iff _).mpr (Subgroup.mem_zpowers (u4Center p)))

theorem u3ToU4Quot_of (p : ℕ) (i : Fin 2) :
    u3ToU4Quot p (PresentedGroup.of i) =
      QuotientGroup.mk' (Subgroup.zpowers (u4Center p)) (PresentedGroup.of i) :=
  PresentedGroup.toGroup.of _

theorem u3ToU4Quot_comp_u4ToU3 (p : ℕ) :
    (u3ToU4Quot p).comp (u4ToU3 p) = QuotientGroup.mk' (Subgroup.zpowers (u4Center p)) := by
  apply PresentedGroup.ext
  intro i
  rw [MonoidHom.comp_apply, u4ToU3_of, u3ToU4Quot_of]

/-- The kernel of `U₄(p) → U₃(p)` lies in `⟨w⟩`. -/
theorem ker_u4ToU3_le (p : ℕ) : (u4ToU3 p).ker ≤ Subgroup.zpowers (u4Center p) := by
  intro g hg
  have h : QuotientGroup.mk' (Subgroup.zpowers (u4Center p)) g = 1 := by
    rw [← u3ToU4Quot_comp_u4ToU3, MonoidHom.comp_apply, MonoidHom.mem_ker.mp hg, map_one]
  exact (QuotientGroup.eq_one_iff g).mp h

theorem finite_and_card_U4_le {p : ℕ} (hp : 0 < p) :
    Finite (U4 p) ∧ Nat.card (U4 p) ≤ p ^ 4 := by
  haveI := finite_U3 hp
  have hfin : IsOfFinOrder (u4Center p) :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨p, hp, u4Center_pow p⟩
  haveI : Finite (Subgroup.zpowers (u4Center p)) := hfin.finite_zpowers.to_subtype
  haveI : Finite (u4ToU3 p).ker :=
    Finite.of_injective _ (Subgroup.inclusion_injective (ker_u4ToU3_le p))
  have hker : Nat.card (u4ToU3 p).ker ≤ p :=
    (Subgroup.card_le_of_le (ker_u4ToU3_le p)).trans
      (by rw [Nat.card_zpowers]; exact orderOf_le_of_pow_eq_one hp (u4Center_pow p))
  have hrange : Nat.card (u4ToU3 p).range ≤ p ^ 3 :=
    (Subgroup.card_le_card_group (H := (u4ToU3 p).range)).trans (card_U3_le hp)
  have hmul : Nat.card (u4ToU3 p).ker * Nat.card (u4ToU3 p).range = Nat.card (U4 p) := by
    rw [← Subgroup.index_ker]
    exact Subgroup.card_mul_index (u4ToU3 p).ker
  have hne : Nat.card (U4 p) ≠ 0 := by
    rw [← hmul]
    exact Nat.mul_ne_zero Nat.card_pos.ne' Nat.card_pos.ne'
  refine ⟨Nat.finite_of_card_ne_zero hne, ?_⟩
  rw [← hmul]
  calc Nat.card (u4ToU3 p).ker * Nat.card (u4ToU3 p).range ≤ p * p ^ 3 :=
        Nat.mul_le_mul hker hrange
    _ = p ^ 4 := by ring

/-- **`U₄(p)` is finite.** -/
theorem finite_U4 {p : ℕ} (hp : 0 < p) : Finite (U4 p) :=
  (finite_and_card_U4_le hp).1

/-- **`|U₄(p)| ≤ p⁴`.** -/
theorem card_U4_le {p : ℕ} (hp : 0 < p) : Nat.card (U4 p) ≤ p ^ 4 :=
  (finite_and_card_U4_le hp).2

instance finite_U3_of_neZero (p : ℕ) [NeZero p] : Finite (U3 p) :=
  finite_U3 (Nat.pos_of_ne_zero (NeZero.ne p))

instance finite_U4_of_neZero (p : ℕ) [NeZero p] : Finite (U4 p) :=
  finite_U4 (Nat.pos_of_ne_zero (NeZero.ne p))

/-- `U₃(7)` is finite. -/
instance finite_U3_seven : Finite (U3 7) := finite_U3 (by decide)

/-- `U₄(7)` is finite. -/
instance finite_U4_seven : Finite (U4 7) := finite_U4 (by decide)

/-- `|U₃(7)| ≤ 7³`. -/
theorem card_U3_seven_le : Nat.card (U3 7) ≤ 7 ^ 3 := card_U3_le (by decide)

/-- `|U₄(7)| ≤ 7⁴`. -/
theorem card_U4_seven_le : Nat.card (U4 7) ≤ 7 ^ 4 := card_U4_le (by decide)

/-! ## Injectivity from the order of the image -/

section Injective

variable {H K : Type*} [Group H] [Group K]

/-- A homomorphism out of a finite group whose image has at least as many elements as
the group is injective. -/
theorem injective_of_card_le_card_range [Finite H] (f : H →* K)
    (h : Nat.card H ≤ Nat.card f.range) : Function.Injective f := by
  haveI : Finite f.range := Finite.of_surjective _ f.rangeRestrict_surjective
  have hmul : Nat.card f.ker * Nat.card f.range = Nat.card H := by
    rw [← Subgroup.index_ker]
    exact Subgroup.card_mul_index f.ker
  have hle : Nat.card f.ker * Nat.card f.range ≤ 1 * Nat.card f.range := by
    rw [one_mul, hmul]
    exact h
  have hker : Nat.card f.ker ≤ 1 := Nat.le_of_mul_le_mul_right hle Nat.card_pos
  exact (MonoidHom.ker_eq_bot_iff f).mp (Subgroup.eq_bot_of_card_le _ hker)

end Injective

/-- A homomorphism out of `U₃(p)` with image of order at least `p³` is injective. -/
theorem u3_injective_of_card_range {p : ℕ} (hp : 0 < p) {K : Type*} [Group K]
    (f : U3 p →* K) (h : p ^ 3 ≤ Nat.card f.range) : Function.Injective f :=
  haveI := finite_U3 hp
  injective_of_card_le_card_range f ((card_U3_le hp).trans h)

/-- A homomorphism out of `U₄(p)` with image of order at least `p⁴` is injective. -/
theorem u4_injective_of_card_range {p : ℕ} (hp : 0 < p) {K : Type*} [Group K]
    (f : U4 p →* K) (h : p ^ 4 ≤ Nat.card f.range) : Function.Injective f :=
  haveI := finite_U4 hp
  injective_of_card_le_card_range f ((card_U4_le hp).trans h)

end KMSGroup
end GroupApproximation

