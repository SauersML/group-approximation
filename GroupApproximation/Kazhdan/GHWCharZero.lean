/-!
# GHW Theorem 4 in characteristic zero

`non_mf_groups_exist.tex`, the remark after `prop:torsion-defect-ring` (tex lines 1146--1147):

> Every countable subgroup of `GL_2` over a field has the Haagerup property …

This module proves the statement for the subgroup generated by a finite set `s ⊆ GL_2(F)` over a
field of characteristic zero (`ghwFinitelyGeneratedCharZero`), the residual Prop of
`printedGHWTheoremFour_of_charP_charZero`.

* Noether normalization over `ℚ` makes the algebra of entries integral over `ℚ[t_1, …, t_d]`.
  Clearing denominators gives an integer `M > 0` with `M x` integral over `B = ℤ[t_1, …, t_d]`
  for every entry `x` of `s`, so every entry of the subgroup is integral over `B` after
  multiplication by a power of `M`.
* Let `L = Frac B` and `K = L(entries)`, a finite extension; the subgroup lies in `GL_2(K)`.
* The non-archimedean places are those of `exists_places_minpoly_coeff`: bounded valuation makes
  the scaled coefficients of the minimal polynomial integer polynomials of bounded degree.
* The archimedean places are the embeddings `K → ℂ` above the grid evaluations
  `L → ℂ, t_i ↦ z_i(k_i)` (`GridPlace`).  Bounded at all of them, those integer polynomials are
  bounded on a grid, so there are finitely many (`IntegerGridFinite`), and so finitely many
  minimal polynomials and roots (`finite_of_minpoly_coeff`).
* `hasHaagerupProperty_of_countable_places` concludes.
-/

namespace GroupApproximation
namespace GHW

open Haagerup WithZero Polynomial

section Fibers

variable {L K : Type*} [Field L] [Field K] [Algebra L K] [FiniteDimensional L K]

/-- Every root of the image of the minimal polynomial is the value of the element at an embedding
extending the given one. -/
theorem exists_ringHom_eq_of_mem_roots (φ : L →+* ℂ) (b : K) {w : ℂ}
    (hw : w ∈ ((minpoly L b).map φ).roots) :
    ∃ τ : K →+* ℂ, τ.comp (algebraMap L K) = φ ∧ τ b = w := by
  letI : Algebra L ℂ := φ.toAlgebra
  have hK' : ∀ x : K, IsIntegral L x ∧ ((minpoly L x).map (algebraMap L ℂ)).Splits :=
    fun x ↦ ⟨Algebra.IsIntegral.isIntegral x, IsAlgClosed.splits _⟩
  have hb : aeval w (minpoly L b) = 0 := by
    rw [aeval_def]
    exact (mem_roots_map (minpoly.ne_zero (Algebra.IsIntegral.isIntegral b))).mp hw
  obtain ⟨ψ, hψ⟩ := IntermediateField.exists_algHom_of_splits_of_aeval hK' hb
  exact ⟨ψ.toRingHom, RingHom.ext fun c ↦ ψ.commutes c, hψ⟩

/-- Finitely many embeddings `K → ℂ` extend a given embedding `L → ℂ`. -/
theorem finite_ringHomOver (φ : L →+* ℂ) :
    Finite {τ : K →+* ℂ // τ.comp (algebraMap L K) = φ} := by
  letI : Algebra L ℂ := φ.toAlgebra
  exact Finite.of_injective (β := K →ₐ[L] ℂ) (fun τ ↦ ⟨τ.1, fun c ↦ RingHom.congr_fun τ.2 c⟩)
    fun τ τ' h ↦ Subtype.ext (congrArg AlgHom.toRingHom h)

/-- The coefficients of the minimal polynomial at an embedding of `L` are bounded by the values of
the element at the embeddings of `K` above it. -/
theorem norm_coeff_minpoly_le (φ : L →+* ℂ) (b : K) {R : ℝ} (hR : 1 ≤ R)
    (hb : ∀ τ : K →+* ℂ, τ.comp (algebraMap L K) = φ → ‖τ b‖ ≤ R) {n : ℕ}
    (hn : Module.finrank L K = n) (i : ℕ) :
    ‖φ ((minpoly L b).coeff i)‖ ≤ R ^ n * 2 ^ n := by
  have hint : IsIntegral L b := Algebra.IsIntegral.isIntegral b
  have hdeg : (minpoly L b).natDegree ≤ n := (minpoly.natDegree_le b).trans_eq hn
  have h := coeff_le_of_roots_le (f := φ) (B := R) i (minpoly.monic hint) (IsAlgClosed.splits _)
    fun w hw ↦ by
      obtain ⟨τ, hτ, hτb⟩ := exists_ringHom_eq_of_mem_roots φ b hw
      rw [← hτb]
      exact hb τ hτ
  rw [coeff_map] at h
  refine h.trans ((mul_le_mul_of_nonneg_right
    (pow_le_pow_right₀ hR ((Nat.sub_le _ _).trans hdeg)) (Nat.cast_nonneg _)).trans
    (mul_le_mul_of_nonneg_left ?_ (pow_nonneg (zero_le_one.trans hR) _)))
  exact_mod_cast (Nat.choose_le_two_pow (minpoly L b).natDegree i).trans
    (Nat.pow_le_pow_right two_pos hdeg)

end Fibers

section Grid

/-- The integer polynomial ring `ℤ[t_1, …, t_d]`. -/
abbrev IntPoly (d : ℕ) := MvPolynomial (Fin d) ℤ

/-- Its field of fractions `ℚ(t_1, …, t_d)`. -/
abbrev RatFun (d : ℕ) := FractionRing (IntPoly d)

/-- Grid coordinates at which every grid evaluation of `ℤ[t_1, …, t_d]` is injective. -/
noncomputable def gridPoint (d : ℕ) : Fin d → ℕ → ℂ :=
  Classical.choose (IntegerGridFinite.exists_grid_points d)

theorem gridPoint_injective (d : ℕ) (i : Fin d) : Function.Injective (gridPoint d i) :=
  (Classical.choose_spec (IntegerGridFinite.exists_grid_points d)).1 i

theorem eval_gridPoint_injective (d : ℕ) (k : Fin d → ℕ) :
    Function.Injective (MvPolynomial.eval₂Hom (Int.castRingHom ℂ) fun i ↦ gridPoint d i (k i)) :=
  (Classical.choose_spec (IntegerGridFinite.exists_grid_points d)).2 k

/-- The embedding `ℚ(t_1, …, t_d) → ℂ` at the grid point `k`. -/
noncomputable def gridEval (d : ℕ) (k : Fin d → ℕ) : RatFun d →+* ℂ :=
  IsFractionRing.lift (K := RatFun d) (eval_gridPoint_injective d k)

theorem gridEval_algebraMap (d : ℕ) (k : Fin d → ℕ) (G : IntPoly d) :
    gridEval d k (algebraMap (IntPoly d) (RatFun d) G) =
      MvPolynomial.eval₂ (Int.castRingHom ℂ) (fun i ↦ gridPoint d i (k i)) G :=
  IsFractionRing.lift_algebraMap (K := RatFun d) (eval_gridPoint_injective d k) G

/-- The embeddings of `K` above the grid evaluation at `k`. -/
abbrev GridFiber (d : ℕ) (K : Type*) [Field K] [Algebra (RatFun d) K] (k : Fin d → ℕ) :=
  {τ : K →+* ℂ // τ.comp (algebraMap (RatFun d) K) = gridEval d k}

/-- The archimedean places of `K`: the embeddings above all grid evaluations. -/
abbrev GridPlace (d : ℕ) (K : Type*) [Field K] [Algebra (RatFun d) K] :=
  Σ k : Fin d → ℕ, GridFiber d K k

theorem countable_gridPlace (d : ℕ) (K : Type*) [Field K] [Algebra (RatFun d) K]
    [FiniteDimensional (RatFun d) K] : Countable (GridPlace d K) := by
  haveI : ∀ k, Finite (GridFiber d K k) := fun k ↦ finite_ringHomOver (K := K) (gridEval d k)
  infer_instance

/-- Elements whose scaled minimal polynomial coefficients are integer polynomials of bounded
degree, and which are bounded at every grid place, form a finite set. -/
theorem finite_of_minpoly_coeff {d : ℕ} {K : Type*} [Field K] [Algebra (RatFun d) K]
    [FiniteDimensional (RatFun d) K] (M N : ℕ) (hM : 0 < M) {n : ℕ}
    (hn : Module.finrank (RatFun d) K = n) (T : Set K)
    (hcoeff : ∀ a ∈ T, ∀ i, ∃ G : IntPoly d, G.totalDegree ≤ N * n ∧
      algebraMap (IntPoly d) (RatFun d) G =
        (M : RatFun d) ^ (N * n) * (minpoly (RatFun d) a).coeff i)
    (C : GridPlace d K → ℝ) :
    {a : K | a ∈ T ∧ ∀ i : GridPlace d K, ‖(i.2 : K →+* ℂ) a‖ ≤ C i}.Finite := by
  classical
  haveI : ∀ k, Fintype (GridFiber d K k) := fun k ↦
    @Fintype.ofFinite _ (finite_ringHomOver (K := K) (gridEval d k))
  -- a bound at each grid point, uniform over the places above it
  let Bd : (Fin d → ℕ) → ℝ := fun k ↦ max 1 (∑ τ : GridFiber d K k, |C ⟨k, τ⟩|)
  -- the integer polynomials that occur as scaled coefficients
  let Gs : Set (IntPoly d) := {G | G.totalDegree ≤ N * n ∧ ∀ k : Fin d → Fin (N * n + 1),
    ‖MvPolynomial.eval₂ (Int.castRingHom ℂ) (fun j ↦ gridPoint d j (k j)) G‖ ≤
      (M : ℝ) ^ (N * n) * (Bd (fun j ↦ (k j : ℕ)) ^ n * 2 ^ n)}
  have hGs : Gs.Finite := IntegerGridFinite.finite_setOf_totalDegree_le_norm_eval_le
    (gridPoint d) (gridPoint_injective d) (N * n)
    (fun k ↦ (M : ℝ) ^ (N * n) * (Bd (fun j ↦ (k j : ℕ)) ^ n * 2 ^ n))
  have hM0 : (M : RatFun d) ^ (N * n) ≠ 0 := by
    refine pow_ne_zero _ fun h ↦ hM.ne' ?_
    have h2 := congrArg (gridEval d 0) h
    rw [map_natCast, map_zero] at h2
    exact_mod_cast h2
  -- the candidate minimal polynomials
  let Ps : Set (RatFun d)[X] := {P | P.natDegree ≤ n ∧ ∀ i, ∃ G ∈ Gs,
    algebraMap (IntPoly d) (RatFun d) G = (M : RatFun d) ^ (N * n) * P.coeff i}
  have hPs : Ps.Finite := by
    refine Set.Finite.of_finite_image
      (f := fun (P : (RatFun d)[X]) (i : Fin (n + 1)) ↦ (M : RatFun d) ^ (N * n) * P.coeff i)
      ?_ ?_
    · refine (Set.Finite.pi (t := fun _ : Fin (n + 1) ↦ algebraMap (IntPoly d) (RatFun d) '' Gs)
        fun _ ↦ hGs.image _).subset ?_
      rintro _ ⟨P, ⟨-, hP⟩, rfl⟩
      refine Set.mem_univ_pi.mpr fun i ↦ ?_
      obtain ⟨G, hG, hGeq⟩ := hP i
      exact ⟨G, hG, hGeq⟩
    · intro P hP Q hQ hPQ
      refine (Polynomial.ext_iff_natDegree_le hP.1 hQ.1).mpr fun i hi ↦ ?_
      exact mul_left_cancel₀ hM0 (congrFun hPQ ⟨i, Nat.lt_succ_of_le hi⟩)
  -- every element of the set is a root of a candidate
  refine (hPs.biUnion fun P _ ↦ P.rootSet_finite K).subset ?_
  rintro a ⟨ha, hC⟩
  have hint : IsIntegral (RatFun d) a := Algebra.IsIntegral.isIntegral a
  refine Set.mem_biUnion (x := minpoly (RatFun d) a)
    ⟨(minpoly.natDegree_le a).trans_eq hn, fun i ↦ ?_⟩
    (Polynomial.mem_rootSet'.mpr ⟨((minpoly.monic hint).map _).ne_zero, minpoly.aeval _ _⟩)
  obtain ⟨G, hGdeg, hGeq⟩ := hcoeff a ha i
  refine ⟨G, ⟨hGdeg, fun k ↦ ?_⟩, hGeq⟩
  have hk := (gridEval_algebraMap d (fun j ↦ (k j : ℕ)) G).symm
  rw [hk, hGeq, map_mul, map_pow, map_natCast, norm_mul, norm_pow, Complex.norm_natCast]
  refine mul_le_mul_of_nonneg_left ?_ (pow_nonneg (Nat.cast_nonneg M) _)
  refine norm_coeff_minpoly_le (gridEval d fun j ↦ (k j : ℕ)) a
    (R := Bd fun j ↦ (k j : ℕ)) (le_max_left _ _) (fun τ hτ ↦ ?_) hn i
  have h1 : |C ⟨fun j ↦ (k j : ℕ), τ, hτ⟩| ≤
      ∑ τ' : GridFiber d K (fun j ↦ (k j : ℕ)), |C ⟨fun j ↦ (k j : ℕ), τ'⟩| :=
    Finset.single_le_sum (f := fun τ' : GridFiber d K (fun j ↦ (k j : ℕ)) ↦
      |C ⟨fun j ↦ (k j : ℕ), τ'⟩|) (fun _ _ ↦ abs_nonneg _) (Finset.mem_univ _)
  exact (hC ⟨_, τ, hτ⟩).trans ((le_abs_self _).trans (h1.trans (le_max_right _ _)))

end Grid

theorem countable_closure_of_finite {Γ : Type*} [Group Γ] {S : Set Γ} (hS : S.Finite) :
    Countable (Subgroup.closure S) := by
  haveI : Countable S := hS.countable.to_subtype
  haveI : Countable (FreeGroup S) := by
    have hmk : Function.Surjective (FreeGroup.mk (α := S)) := by
      rintro ⟨L⟩
      exact ⟨L, FreeGroup.quot_mk_eq_mk.symm⟩
    exact hmk.countable
  rw [FreeGroup.closure_eq_range]
  exact (MonoidHom.rangeRestrict_surjective _).countable

/-- **Finitely generated subgroups in characteristic zero.** -/
theorem hasHaagerupProperty_closure_of_charZero {F : Type} [Field F] [CharZero F]
    (s : Set (GL (Fin 2) F)) (hs : s.Finite) :
    HasHaagerupProperty.{0, 0} (Subgroup.closure s) := by
  classical
  -- the finitely generated `ℚ`-algebra of entries and its Noether normalization
  let A : Subalgebra ℚ F := Algebra.adjoin ℚ (entrySet s)
  haveI : Algebra.FiniteType ℚ A :=
    Algebra.FiniteType.adjoin_of_finite (R := ℚ) (entrySet_finite hs)
  obtain ⟨d, g₀, hg₀, hg₀int⟩ := exists_integral_inj_algHom_of_fg ℚ A
  let BQ := MvPolynomial (Fin d) ℚ
  let B := IntPoly d
  letI : Algebra BQ F := (A.val.toRingHom.comp g₀.toRingHom).toAlgebra
  letI : Algebra B BQ := MvPolynomial.algebraMvPolynomial
  letI : Algebra B F := ((algebraMap BQ F).comp (algebraMap B BQ)).toAlgebra
  haveI : IsScalarTower B BQ F := IsScalarTower.of_algebraMap_eq' rfl
  have hιB : Function.Injective (algebraMap B F) := by
    have h1 : Function.Injective (algebraMap B BQ) :=
      MvPolynomial.map_injective (algebraMap ℤ ℚ) (algebraMap ℤ ℚ).injective_int
    have h2 : Function.Injective (algebraMap BQ F) := by
      intro x y hxy
      apply hg₀
      apply Subtype.val_injective
      exact hxy
    exact h2.comp h1
  have hintBQ : ∀ t : A, IsIntegral BQ (t : F) := by
    intro t
    obtain ⟨q, hqm, hq⟩ := hg₀int t
    refine ⟨q, hqm, ?_⟩
    have h := Polynomial.hom_eval₂ (p := q) (f := g₀.toRingHom) (g := A.val.toRingHom) (x := t)
    rw [hq, map_zero] at h
    exact h.symm
  -- clearing denominators: an integer `M > 0` with `M x` integral over `B` for every entry `x`
  have hclear : ∀ x : entrySet s, ∃ c : ℤ, c ≠ 0 ∧ IsIntegral B ((c : F) * x) := by
    intro x
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      ((nonZeroDivisors ℤ).map (MvPolynomial.C (σ := Fin d) (R := ℤ))) (x : F)
      (hintBQ ⟨x, Algebra.subset_adjoin x.2⟩)
    obtain ⟨c, hc, hcm⟩ := Submonoid.mem_map.mp m.2
    refine ⟨c, nonZeroDivisors.ne_zero hc, ?_⟩
    have h : m • (x : F) = (c : F) * x := by
      show (m : B) • (x : F) = _
      rw [Algebra.smul_def, ← hcm]
      exact congrArg (· * (x : F)) (eq_intCast ((algebraMap B F).comp MvPolynomial.C) c)
    rwa [h] at hm
  haveI : Fintype (entrySet s) := (entrySet_finite hs).fintype
  choose c hc0 hcint using hclear
  let M : ℕ := (∏ x : entrySet s, c x).natAbs
  have hM : 0 < M := Int.natAbs_pos.mpr (Finset.prod_ne_zero_iff.mpr fun x _ ↦ hc0 x)
  have hMint : ∀ x ∈ entrySet s, IsIntegral B ((M : F) * x) := by
    intro x hx
    obtain ⟨e, he⟩ : c ⟨x, hx⟩ ∣ (M : ℤ) :=
      Int.dvd_natAbs.mpr (Finset.dvd_prod_of_mem _ (Finset.mem_univ _))
    have h : (M : F) * x = algebraMap B F (e : B) * ((c ⟨x, hx⟩ : F) * x) := by
      rw [map_intCast, ← mul_assoc, ← Int.cast_mul, mul_comm e, ← he, Int.cast_natCast]
    rw [h]
    exact isIntegral_algebraMap.mul (hcint ⟨x, hx⟩)
  -- every element of the `ℤ`-algebra of entries is integral over `B` after scaling by `M^e`
  have hMpow : ∀ y ∈ Algebra.adjoin ℤ (entrySet s), ∃ e : ℕ, IsIntegral B ((M : F) ^ e * y) := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx => exact ⟨1, by rw [pow_one]; exact hMint x hx⟩
    | algebraMap r =>
      refine ⟨0, ?_⟩
      rw [pow_zero, one_mul, eq_intCast (algebraMap ℤ F) r, ← map_intCast (algebraMap B F) r]
      exact isIntegral_algebraMap
    | add x y _ _ hx hy =>
      obtain ⟨e₁, h₁⟩ := hx
      obtain ⟨e₂, h₂⟩ := hy
      refine ⟨e₁ + e₂, ?_⟩
      have h : (M : F) ^ (e₁ + e₂) * (x + y) =
          algebraMap B F ((M : B) ^ e₂) * ((M : F) ^ e₁ * x) +
            algebraMap B F ((M : B) ^ e₁) * ((M : F) ^ e₂ * y) := by
        rw [map_pow, map_pow, map_natCast]
        ring
      rw [h]
      exact (isIntegral_algebraMap.mul h₁).add (isIntegral_algebraMap.mul h₂)
    | mul x y _ _ hx hy =>
      obtain ⟨e₁, h₁⟩ := hx
      obtain ⟨e₂, h₂⟩ := hy
      refine ⟨e₁ + e₂, ?_⟩
      have h : (M : F) ^ (e₁ + e₂) * (x * y) = ((M : F) ^ e₁ * x) * ((M : F) ^ e₂ * y) := by
        ring
      rw [h]
      exact h₁.mul h₂
  -- the field of fractions `L` of `B` and the finite extension `K = L(entries)`
  let L := RatFun d
  letI : Algebra L F := (IsFractionRing.lift (K := L) hιB).toAlgebra
  have hLF : ∀ b : B, algebraMap L F (algebraMap B L b) = algebraMap B F b := fun b ↦
    IsFractionRing.lift_algebraMap (K := L) hιB b
  have hcomp : (algebraMap L F).comp (algebraMap B L) = algebraMap B F := RingHom.ext hLF
  have hintL : ∀ x ∈ entrySet s, IsIntegral L x := by
    intro x hx
    obtain ⟨q, hqm, hq⟩ := hMint x hx
    have h1 : IsIntegral L ((M : F) * x) := by
      refine ⟨q.map (algebraMap B L), hqm.map _, ?_⟩
      rw [Polynomial.eval₂_map, hcomp]
      exact hq
    have h2 : algebraMap L F (M : L)⁻¹ * ((M : F) * x) = x := by
      rw [map_inv₀, map_natCast, ← mul_assoc, inv_mul_cancel₀ (Nat.cast_ne_zero.mpr hM.ne'),
        one_mul]
    have h3 : IsIntegral L (algebraMap L F (M : L)⁻¹ * ((M : F) * x)) :=
      isIntegral_algebraMap.mul h1
    rwa [h2] at h3
  let K : IntermediateField L F := IntermediateField.adjoin L (entrySet s)
  haveI : FiniteDimensional L K := IntermediateField.finiteDimensional_adjoin hintL
  -- the subgroup inside `GL_2(K)`
  have hinjK : Function.Injective (Matrix.GeneralLinearGroup.map (n := Fin 2) (K.val : K →+* F)) :=
    glMap_injective (K.val : K →+* F).injective
  have hle : Subgroup.closure s ≤
      (Matrix.GeneralLinearGroup.map (n := Fin 2) (K.val : K →+* F)).range := by
    rw [Subgroup.closure_le]
    intro g hg
    exact mem_range_glMap_of_entries _ (K.val : K →+* F).injective g
      (fun a b ↦ ⟨⟨((g : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) a b,
        IntermediateField.subset_adjoin L _ (mem_entrySet hg a b).1⟩, rfl⟩)
      (fun a b ↦ ⟨⟨((g⁻¹ : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) a b,
        IntermediateField.subset_adjoin L _ (mem_entrySet hg a b).2⟩, rfl⟩)
  let ρ₁ : Subgroup.closure s →* GL (Fin 2) K :=
    (MonoidHom.ofInjective hinjK).symm.toMonoidHom.comp (Subgroup.inclusion hle)
  have hρ₁ : Function.Injective ρ₁ := by
    intro x y hxy
    have h2 : (MonoidHom.ofInjective hinjK).symm (Subgroup.inclusion hle x) =
        (MonoidHom.ofInjective hinjK).symm (Subgroup.inclusion hle y) := hxy
    exact Subgroup.inclusion_injective hle ((MonoidHom.ofInjective hinjK).symm.injective h2)
  have hρ₁entry : ∀ (γ : Subgroup.closure s) (a b : Fin 2),
      ((((ρ₁ γ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) a b : K) : F) =
        ((γ : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) a b := by
    intro γ a b
    have h1 : Matrix.GeneralLinearGroup.map (n := Fin 2) (K.val : K →+* F) (ρ₁ γ) =
        (γ : GL (Fin 2) F) := by
      rw [← MonoidHom.ofInjective_apply hinjK]
      exact congrArg Subtype.val
        (MulEquiv.apply_symm_apply (MonoidHom.ofInjective hinjK) (Subgroup.inclusion hle γ))
    exact congrArg (fun z : GL (Fin 2) F ↦ (z : Matrix (Fin 2) (Fin 2) F) a b) h1
  -- the entries of the subgroup in `K` are integral over `B` after scaling by `M^e`
  letI : Algebra B K := ((algebraMap L K).comp (algebraMap B L)).toAlgebra
  haveI : IsScalarTower B L K := IsScalarTower.of_algebraMap_eq' rfl
  have hKcomp : (K.val : K →+* F).comp (algebraMap B K) = algebraMap B F := by
    refine RingHom.ext fun b ↦ ?_
    show algebraMap L F (algebraMap B L b) = algebraMap B F b
    exact hLF b
  have hS : ∀ (γ : Subgroup.closure s) (a b : Fin 2),
      ((ρ₁ γ : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) a b ∈
        {x : K | ∃ e : ℕ, IsIntegral B ((M : K) ^ e * x)} := by
    intro γ a b
    obtain ⟨e, q, hqm, hq⟩ := hMpow _ (entries_mem_of_mem_closure (R := ℤ) γ.2 a b).1
    refine ⟨e, q, hqm, (K.val : K →+* F).injective ?_⟩
    rw [Polynomial.hom_eval₂, map_zero, hKcomp, map_mul, map_pow, map_natCast]
    exact (congrArg (fun y ↦ Polynomial.eval₂ (algebraMap B F) ((M : F) ^ e * y) q)
      (hρ₁entry γ a b)).trans hq
  -- the places of `K`
  obtain ⟨r, u, hunif, hcoeff⟩ := exists_places_minpoly_coeff d M hM (↥K)
  choose ϖ hϖ using hunif
  haveI : Countable (Subgroup.closure s) := countable_closure_of_finite hs
  haveI : Countable (GridPlace d K) := countable_gridPlace d K
  refine hasHaagerupProperty_of_countable_places ρ₁ hρ₁
    (fun j ↦ ValuationWithTopInt.addVal (u j)) ϖ
    (fun j ↦ ValuationWithTopInt.addVal_eq_one (u j) (hϖ j)) (ι := GridPlace d K)
    (fun i ↦ (i.2 : K →+* ℂ)) {x : K | ∃ e : ℕ, IsIntegral B ((M : K) ^ e * x)} hS ?_
  intro C N
  refine (finite_of_minpoly_coeff M N hM rfl
    {x : K | (∃ e : ℕ, IsIntegral B ((M : K) ^ e * x)) ∧ ∀ j, u j x ≤ exp (N : ℤ)}
    (fun x hx i ↦ ?_) C).subset ?_
  · obtain ⟨⟨e, he⟩, hux⟩ := hx
    exact hcoeff N e x he hux i
  · rintro x ⟨hx, hC, hv⟩
    refine ⟨⟨hx, fun j ↦ ?_⟩, hC⟩
    by_cases hx0 : x = 0
    · rw [hx0, Valuation.map_zero]
      exact zero_le
    · exact (ValuationWithTopInt.neg_le_addVal_iff (u j) hx0 (N : ℤ)).mp (hv j)

/-- **GHW Theorem 4 for finitely generated subgroups in characteristic zero.** -/
theorem ghwFinitelyGeneratedCharZero : GHWFinitelyGeneratedCharZero := by
  intro F _ _ s hs
  exact hasHaagerupProperty_closure_of_charZero s hs

end GHW
