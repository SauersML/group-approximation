import GroupApproximation.Kazhdan.CCKWTitsTypedWords
import Mathlib.GroupTheory.PresentedGroup
import Mathlib.GroupTheory.FreeGroup.Reduce
import GroupApproximation.Meta.AxiomGuard

/-!
# Tits' lemma for presented groups whose relators lie in vertex groups

Let `G = ⟨S | R⟩` and let the vertex groups be generated by subsets of the generators,
`Hᵢ = ⟨Sᵢ⟩`, where every generator lies in some `S_{τ s}` and every relator is a word in the
generators of one vertex group (`VertexPresentation`).  Then every typed word with value `1`
reduces to the empty word (`typedWordProblem`), so the coset complex is simply connected
(`simplyConnected_of_vertexPresentation`), and it is connected
(`connected_of_vertexPresentation`).

Free-group words lift to typed words letter by letter (`liftT`, `liftF`), compatibly with free
reduction (`tw_liftT_of_mk_eq`).  An element of the free group on `Sᵢ` lifts to a single typed
letter of type `i` (`tw_liftF_closure`), so a relator lifts to the empty word, and so does every
element of the relator normal closure (`tw_liftF_normalClosure`).  A typed word with value `1`
is equivalent to the lift of a free-group element in the kernel of the quotient map.
-/

namespace GroupApproximation.CCKWTits

open Systolic

universe u

/-! ### Typed moves inside words -/

section Generic

variable {G : Type u} [Group G] {H : Fin 3 → Subgroup G}

theorem typedMove_append_left (A : List (Letter H)) {L L' : List (Letter H)}
    (h : TypedMove L L') : TypedMove (A ++ L) (A ++ L') := by
  obtain ⟨pre, mid, mid', post, hb, rfl, rfl⟩ := h
  exact ⟨A ++ pre, mid, mid', post, hb, by rw [List.append_assoc], by rw [List.append_assoc]⟩

theorem typedMove_append_right (B : List (Letter H)) {L L' : List (Letter H)}
    (h : TypedMove L L') : TypedMove (L ++ B) (L' ++ B) := by
  obtain ⟨pre, mid, mid', post, hb, rfl, rfl⟩ := h
  exact ⟨pre, mid, mid', post ++ B, hb, by simp only [List.append_assoc],
    by simp only [List.append_assoc]⟩

theorem tw_append_left (A : List (Letter H)) {L L' : List (Letter H)}
    (h : Relation.EqvGen TypedMove L L') : Relation.EqvGen TypedMove (A ++ L) (A ++ L') :=
  eqvGen_map (fun x ↦ A ++ x) (fun _ _ hab ↦ Relation.EqvGen.rel _ _ (typedMove_append_left A hab)) h

theorem tw_append_right (B : List (Letter H)) {L L' : List (Letter H)}
    (h : Relation.EqvGen TypedMove L L') : Relation.EqvGen TypedMove (L ++ B) (L' ++ B) :=
  eqvGen_map (fun x ↦ x ++ B) (fun _ _ hab ↦ Relation.EqvGen.rel _ _ (typedMove_append_right B hab)) h

theorem tw_append {L₁ L₁' L₂ L₂' : List (Letter H)} (h₁ : Relation.EqvGen TypedMove L₁ L₁')
    (h₂ : Relation.EqvGen TypedMove L₂ L₂') :
    Relation.EqvGen TypedMove (L₁ ++ L₂) (L₁' ++ L₂') :=
  Relation.EqvGen.trans _ _ _ (tw_append_right L₂ h₁) (tw_append_left L₁' h₂)

theorem tw_base {mid mid' : List (Letter H)} (hb : BaseMove mid mid') :
    Relation.EqvGen TypedMove mid mid' :=
  Relation.EqvGen.rel _ _ ⟨[], mid, mid', [], hb, by simp, by simp⟩

theorem tw_letter_congr {L : List (Letter H)} {i : Fin 3} {p q : H i} (h : (p : G) = q)
    (hL : Relation.EqvGen TypedMove L [⟨i, p⟩]) : Relation.EqvGen TypedMove L [⟨i, q⟩] := by
  rwa [Subtype.ext h] at hL

end Generic

/-! ### Vertex presentations -/

variable {S : Type u} {R : Set (FreeGroup S)} {H : Fin 3 → Subgroup (PresentedGroup R)}

/-- **A presentation adapted to three vertex groups**: each vertex group is generated by a set of
generators, every generator lies in one of these sets, and every relator is a word in the
generators of one vertex group. -/
structure VertexPresentation (R : Set (FreeGroup S)) (H : Fin 3 → Subgroup (PresentedGroup R)) where
  Stype : Fin 3 → Set S
  τ : S → Fin 3
  hH : ∀ i, H i = (Subgroup.closure (FreeGroup.of '' Stype i)).map (PresentedGroup.mk R)
  hτ : ∀ s, s ∈ Stype (τ s)
  hR : ∀ r ∈ R, ∃ j, r ∈ Subgroup.closure (FreeGroup.of '' Stype j)

variable (V : VertexPresentation R H)

theorem memH {i : Fin 3} {x : FreeGroup S} (hx : x ∈ Subgroup.closure (FreeGroup.of '' V.Stype i)) :
    PresentedGroup.mk R x ∈ H i := by
  rw [V.hH i]
  exact Subgroup.mem_map_of_mem _ hx

/-- A generator as an element of its vertex group. -/
def gen (s : S) : H (V.τ s) :=
  ⟨PresentedGroup.of s, memH V (Subgroup.subset_closure ⟨s, V.hτ s, rfl⟩)⟩

/-- The typed letter of a signed generator. -/
def liftLetter : S × Bool → Letter H
  | (s, true) => ⟨V.τ s, gen V s⟩
  | (s, false) => ⟨V.τ s, (gen V s)⁻¹⟩

/-- The typed word of a signed word. -/
def liftT (L : List (S × Bool)) : List (Letter H) := L.map (liftLetter V)

theorem tw_pair (s : S) (b : Bool) :
    Relation.EqvGen TypedMove [liftLetter V (s, b), liftLetter V (s, !b)] [] := by
  cases b
  · have h1 := tw_base (BaseMove.merge (V.τ s) (gen V s)⁻¹ (gen V s))
    rw [inv_mul_cancel] at h1
    exact Relation.EqvGen.trans _ _ _ h1 (tw_base (BaseMove.drop (V.τ s)))
  · have h1 := tw_base (BaseMove.merge (V.τ s) (gen V s) (gen V s)⁻¹)
    rw [mul_inv_cancel] at h1
    exact Relation.EqvGen.trans _ _ _ h1 (tw_base (BaseMove.drop (V.τ s)))

theorem tw_step {L₁ L₂ : List (S × Bool)} (h : FreeGroup.Red.Step L₁ L₂) :
    Relation.EqvGen TypedMove (liftT V L₁) (liftT V L₂) := by
  cases h with
  | @not A B s b =>
      have hp := tw_append_right (liftT V B) (tw_append_left (liftT V A) (tw_pair V s b))
      simpa only [liftT, List.map_append, List.map_cons, List.append_assoc, List.cons_append,
        List.nil_append] using hp

theorem tw_of_red {L₁ L₂ : List (S × Bool)} (h : FreeGroup.Red L₁ L₂) :
    Relation.EqvGen TypedMove (liftT V L₁) (liftT V L₂) := by
  have h' : Relation.ReflTransGen FreeGroup.Red.Step L₁ L₂ := h
  clear h
  induction h' with
  | refl => exact Relation.EqvGen.refl _
  | tail _ hs ih => exact Relation.EqvGen.trans _ _ _ ih (tw_step V hs)

theorem tw_liftT_of_mk_eq {L₁ L₂ : List (S × Bool)} (h : FreeGroup.mk L₁ = FreeGroup.mk L₂) :
    Relation.EqvGen TypedMove (liftT V L₁) (liftT V L₂) := by
  obtain ⟨L, h1, h2⟩ := FreeGroup.Red.exact.mp h
  exact Relation.EqvGen.trans _ _ _ (tw_of_red V h1) (Relation.EqvGen.symm _ _ (tw_of_red V h2))

theorem mk_eq_one_of_mem {r : FreeGroup S} (hr : r ∈ R) : PresentedGroup.mk R r = 1 :=
  (QuotientGroup.eq_one_iff (N := Subgroup.normalClosure R) r).mpr (Subgroup.subset_normalClosure hr)

theorem val_liftT (L : List (S × Bool)) :
    val (liftT V L) = PresentedGroup.mk R (FreeGroup.mk L) := by
  induction L with
  | nil =>
      show (1 : PresentedGroup R) = PresentedGroup.mk R (FreeGroup.mk [])
      rw [← FreeGroup.one_eq_mk, map_one]
  | cons x L ih =>
      have hsplit : (FreeGroup.mk (x :: L) : FreeGroup S) = FreeGroup.mk [x] * FreeGroup.mk L := by
        simp only [FreeGroup.mul_mk, List.singleton_append]
      rw [hsplit, map_mul, ← ih]
      show ((liftLetter V x).2 : PresentedGroup R) * val (liftT V L) = _
      congr 1
      rcases x with ⟨s, _ | _⟩
      · exact (map_inv (PresentedGroup.mk R) (FreeGroup.of s)).symm.trans
          (congrArg (PresentedGroup.mk R) (FreeGroup.inv_mk (L := [(s, true)])))
      · rfl

/-! ### Reduced words -/

variable [DecidableEq S]

/-- The typed word of a free-group element, through its reduced word. -/
def liftF (x : FreeGroup S) : List (Letter H) := liftT V (FreeGroup.toWord x)

theorem tw_liftF_mk (L : List (S × Bool)) :
    Relation.EqvGen TypedMove (liftF V (FreeGroup.mk L)) (liftT V L) :=
  tw_liftT_of_mk_eq V FreeGroup.mk_toWord

theorem tw_liftF_one : Relation.EqvGen TypedMove (liftF V (1 : FreeGroup S)) [] := by
  have h := tw_liftF_mk V []
  rwa [← FreeGroup.one_eq_mk] at h

theorem tw_liftF_mul (x y : FreeGroup S) :
    Relation.EqvGen TypedMove (liftF V (x * y)) (liftF V x ++ liftF V y) := by
  have e : liftF V x ++ liftF V y = liftT V (FreeGroup.toWord x ++ FreeGroup.toWord y) := by
    simp only [liftF, liftT, List.map_append]
  rw [e]
  exact tw_liftT_of_mk_eq V (by
    rw [← FreeGroup.mul_mk, FreeGroup.mk_toWord, FreeGroup.mk_toWord, FreeGroup.mk_toWord])

theorem tw_liftF_inv_nil {x : FreeGroup S} (hx : Relation.EqvGen TypedMove (liftF V x) []) :
    Relation.EqvGen TypedMove (liftF V x⁻¹) [] := by
  have h1 := tw_append_left (liftF V x⁻¹) hx
  have h2 := tw_liftF_mul V x⁻¹ x
  rw [List.append_nil] at h1
  rw [inv_mul_cancel] at h2
  exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ h1)
    (Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ h2) (tw_liftF_one V))

theorem tw_liftF_inv_letter {x : FreeGroup S} {i : Fin 3} {a : H i}
    (hx : Relation.EqvGen TypedMove (liftF V x) [⟨i, a⟩]) :
    Relation.EqvGen TypedMove (liftF V x⁻¹) [⟨i, a⁻¹⟩] := by
  have hcancel : Relation.EqvGen TypedMove (liftF V x ++ [⟨i, a⁻¹⟩]) [] := by
    have h1 := tw_base (BaseMove.merge i a a⁻¹)
    rw [mul_inv_cancel] at h1
    exact Relation.EqvGen.trans _ _ _ (tw_append_right [⟨i, a⁻¹⟩] hx)
      (Relation.EqvGen.trans _ _ _ h1 (tw_base (BaseMove.drop i)))
  have h1 := tw_append_left (liftF V x⁻¹) hcancel
  have h2 := tw_append_right [⟨i, a⁻¹⟩] (tw_liftF_mul V x⁻¹ x)
  have h3 := tw_append_right [⟨i, a⁻¹⟩] (tw_liftF_one V)
  rw [List.append_nil, ← List.append_assoc] at h1
  rw [inv_mul_cancel] at h2
  exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ h1)
    (Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ h2) h3)

/-- **Vertex-group elements lift to one letter.** -/
theorem tw_liftF_closure (i : Fin 3) {x : FreeGroup S}
    (hx : x ∈ Subgroup.closure (FreeGroup.of '' V.Stype i)) :
    Relation.EqvGen TypedMove (liftF V x) [⟨i, ⟨PresentedGroup.mk R x, memH V hx⟩⟩] := by
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
      obtain ⟨s, hs, rfl⟩ := hy
      have h1 : Relation.EqvGen TypedMove (liftF V (FreeGroup.of s)) [liftLetter V (s, true)] :=
        tw_liftF_mk V [(s, true)]
      exact Relation.EqvGen.trans _ _ _ h1
        (tw_base (BaseMove.retype (V.τ s) i (gen V s) (memH V (Subgroup.subset_closure ⟨s, hs, rfl⟩))))
  | one =>
      exact tw_letter_congr (map_one _).symm
        (Relation.EqvGen.trans _ _ _ (tw_liftF_one V) (Relation.EqvGen.symm _ _ (tw_base (BaseMove.drop i))))
  | mul y z hy hz ihy ihz =>
      have hm := tw_base (BaseMove.merge i ⟨PresentedGroup.mk R y, memH V hy⟩ ⟨PresentedGroup.mk R z, memH V hz⟩)
      exact tw_letter_congr (map_mul _ _ _).symm
        (Relation.EqvGen.trans _ _ _ (tw_liftF_mul V y z)
          (Relation.EqvGen.trans _ _ _ (tw_append ihy ihz) hm))
  | inv y _ ihy => exact tw_letter_congr (map_inv _ _).symm (tw_liftF_inv_letter V ihy)

/-- **The relator normal closure lifts to the empty word.** -/
theorem tw_liftF_normalClosure {n : FreeGroup S} (hn : n ∈ Subgroup.normalClosure R) :
    Relation.EqvGen TypedMove (liftF V n) [] := by
  have hn' : n ∈ Subgroup.closure (Group.conjugatesOfSet R) := hn
  clear hn
  induction hn' using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨r, hr, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hx
      obtain ⟨c, rfl⟩ := isConj_iff.mp hconj
      obtain ⟨j, hj⟩ := V.hR r hr
      have hrl : Relation.EqvGen TypedMove (liftF V r) [] :=
        Relation.EqvGen.trans _ _ _ (tw_letter_congr (mk_eq_one_of_mem hr) (tw_liftF_closure V j hj))
          (tw_base (BaseMove.drop j))
      have h1 := tw_liftF_mul V (c * r) c⁻¹
      have h2 := tw_append_right (liftF V c⁻¹)
        (Relation.EqvGen.trans _ _ _ (tw_liftF_mul V c r) (tw_append_left (liftF V c) hrl))
      have h3 := tw_liftF_mul V c c⁻¹
      rw [List.append_nil] at h2
      rw [mul_inv_cancel] at h3
      exact Relation.EqvGen.trans _ _ _ h1 (Relation.EqvGen.trans _ _ _ h2
        (Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ h3) (tw_liftF_one V)))
  | one => exact tw_liftF_one V
  | mul x y _ _ ihx ihy =>
      exact Relation.EqvGen.trans _ _ _ (tw_liftF_mul V x y) (tw_append ihx ihy)
  | inv x _ ihx => exact tw_liftF_inv_nil V ihx

theorem exists_lift (L : List (Letter H)) :
    ∃ X : FreeGroup S, Relation.EqvGen TypedMove L (liftF V X) ∧ PresentedGroup.mk R X = val L := by
  induction L with
  | nil => exact ⟨1, Relation.EqvGen.symm _ _ (tw_liftF_one V), map_one _⟩
  | cons a L ih =>
      obtain ⟨X, hX, hXv⟩ := ih
      obtain ⟨i, p⟩ := a
      have hp : (p : PresentedGroup R) ∈
          (Subgroup.closure (FreeGroup.of '' V.Stype i)).map (PresentedGroup.mk R) := by
        rw [← V.hH i]
        exact p.2
      obtain ⟨x, hx, hxp⟩ := Subgroup.mem_map.mp hp
      have hK := tw_letter_congr hxp (tw_liftF_closure V i hx)
      refine ⟨x * X, ?_, ?_⟩
      · exact Relation.EqvGen.trans _ _ _ (tw_append (Relation.EqvGen.symm _ _ hK) hX)
          (Relation.EqvGen.symm _ _ (tw_liftF_mul V x X))
      · show PresentedGroup.mk R (x * X) = (p : PresentedGroup R) * val L
        rw [map_mul, hxp, hXv]

include V in
/-- **The typed word problem for a vertex presentation.** -/
theorem typedWordProblem (L : List (Letter H)) (hL : val L = 1) :
    Relation.EqvGen TypedMove L [] := by
  obtain ⟨X, hX, hXv⟩ := exists_lift V L
  rw [hL] at hXv
  exact Relation.EqvGen.trans _ _ _ hX
    (tw_liftF_normalClosure V ((QuotientGroup.eq_one_iff (N := Subgroup.normalClosure R) X).mp hXv))

include V in
theorem generated (g : PresentedGroup R) : ∃ L : List (Letter H), val L = g := by
  obtain ⟨X, rfl⟩ := PresentedGroup.mk_surjective R g
  exact ⟨liftF V X, by rw [liftF, val_liftT, FreeGroup.mk_toWord]⟩

include V in
/-- **Tits' lemma**: the coset complex of a vertex presentation is simply connected. -/
theorem simplyConnected_of_vertexPresentation : SimplyConnected (titsComplex (PresentedGroup R) H) :=
  simplyConnected_of_typedWordProblem (typedWordProblem V)

include V in
/-- The coset complex of a vertex presentation is connected. -/
theorem connected_of_vertexPresentation : (titsComplex (PresentedGroup R) H).G.Connected :=
  connected_of_generated (generated V)

end GroupApproximation.CCKWTits

/-! ### Axiom audit -/

#audit_axioms GroupApproximation.CCKWTits.tw_liftT_of_mk_eq
#audit_axioms GroupApproximation.CCKWTits.tw_liftF_closure
#audit_axioms GroupApproximation.CCKWTits.tw_liftF_normalClosure
#audit_axioms GroupApproximation.CCKWTits.typedWordProblem
#audit_axioms GroupApproximation.CCKWTits.simplyConnected_of_vertexPresentation
#audit_axioms GroupApproximation.CCKWTits.connected_of_vertexPresentation
