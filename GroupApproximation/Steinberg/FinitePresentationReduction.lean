import GroupApproximation.Steinberg.QuotientExactness
import GroupApproximation.Algebra.NoncommutativeFinitePresentation

/-!
# Reducing Steinberg finite presentation to the free-ring case

This file isolates the formal quotient step in the Krstić--McCool theorem.
A finite presentation of a coefficient ring gives a surjection from a finite
free associative ring whose kernel is generated by finitely many two-sided
relations.  Steinberg quotient exactness then turns those coefficient
relations into finitely many normal group relations.

The remaining input is the genuinely geometric/combinatorial base theorem:
finite presentability of the Steinberg group over a finite free associative
ring.  It is kept explicit rather than hidden behind an unstable `K₂`
assumption.
-/

namespace GroupApproximation

namespace RingPresentation

variable {R : Type*} [Ring R]

/-- The differences attached to a relation presenting a ring. -/
def differences (r : R → R → Prop) : Set R :=
  {z | ∃ x y : R, r x y ∧ z = x - y}

theorem differences_finite {r : R → R → Prop}
    (hr : Set.Finite {p : R × R | r p.1 p.2}) :
    (differences r).Finite := by
  have himage := hr.image (fun p : R × R ↦ p.1 - p.2)
  apply himage.subset
  rintro z ⟨x, y, hxy, rfl⟩
  exact ⟨(x, y), hxy, rfl⟩

private theorem rel_difference_mem_span (r : R → R → Prop)
    {x y : R} (hxy : RingQuot.Rel r x y) :
    x - y ∈ TwoSidedIdeal.span (differences r) := by
  induction hxy with
  | @of x y h =>
      exact TwoSidedIdeal.subset_span ⟨_, _, h, rfl⟩
  | add_left h ih =>
      convert ih using 1
      noncomm_ring
  | @mul_left a b c h ih =>
      convert TwoSidedIdeal.mul_mem_right _ _ c ih using 1
      noncomm_ring
  | @mul_right a b c h ih =>
      convert TwoSidedIdeal.mul_mem_left _ a _ ih using 1
      noncomm_ring

private theorem eqvGen_difference_mem_span (r : R → R → Prop)
    {x y : R} (hxy : Relation.EqvGen (RingQuot.Rel r) x y) :
    x - y ∈ TwoSidedIdeal.span (differences r) := by
  induction hxy with
  | rel _ _ h => exact rel_difference_mem_span r h
  | refl => simp
  | symm x y h ih =>
      convert TwoSidedIdeal.neg_mem _ ih using 1
      noncomm_ring
  | trans x y z hxy hyz ihxy ihyz =>
      convert TwoSidedIdeal.add_mem _ ihxy ihyz using 1
      noncomm_ring

/-- The kernel ideal of a `RingQuot` presentation is precisely the
two-sided ideal generated by the displayed relation differences. -/
theorem mkRingHom_ker_eq_span (r : R → R → Prop) :
    TwoSidedIdeal.ker (RingQuot.mkRingHom r) =
      TwoSidedIdeal.span (differences r) := by
  apply le_antisymm
  · intro x hx
    have hq : RingQuot.mkRingHom r x = RingQuot.mkRingHom r 0 := by
      rw [map_zero]
      exact (TwoSidedIdeal.mem_ker (RingQuot.mkRingHom r)).mp hx
    rw [RingQuot.mkRingHom_def] at hq
    have hquot := congrArg RingQuot.toQuot hq
    change Quot.mk _ x = Quot.mk _ 0 at hquot
    have heqv : Relation.EqvGen (RingQuot.Rel r) x 0 :=
      Quot.eqvGen_exact hquot
    simpa using eqvGen_difference_mem_span r heqv
  · rw [TwoSidedIdeal.span_le]
    rintro z ⟨x, y, hxy, rfl⟩
    apply (TwoSidedIdeal.mem_ker (RingQuot.mkRingHom r)).mpr
    rw [map_sub, RingQuot.mkRingHom_rel hxy, sub_self]

end RingPresentation

namespace SteinbergGroup

variable {I R S : Type*} [Fintype I] [DecidableEq I]
  [Ring R] [Ring S]

/-- A finite set of coefficient-ring relations preserves finite
presentability of the Steinberg group, provided there is a third root index.

This is the quotient step in the Krstić--McCool finite-presentation
argument.  It uses only Steinberg quotient exactness, not centrality or
finite generation of unstable `K₂`. -/
theorem isFinitelyPresented_ringQuot
    (r : R → R → Prop)
    (hr : Set.Finite {p : R × R | r p.1 p.2})
    (hcard : 3 ≤ Fintype.card I)
    [Group.IsFinitelyPresented (SteinbergGroup I R)] :
    Group.IsFinitelyPresented (SteinbergGroup I (RingQuot r)) := by
  apply Group.IsFinitelyPresented.of_surjective
    (ringMap (I := I) (RingQuot.mkRingHom r))
    (ringMap_surjective_of_surjective
      (I := I) (RingQuot.mkRingHom r) (RingQuot.mkRingHom_surjective r))
  exact ringMap_ker_isFinitelyNormallyGenerated_of_ker_eq_span
    (I := I) (RingQuot.mkRingHom r) (RingQuot.mkRingHom_surjective r)
    hcard (RingPresentation.differences r)
    (RingPresentation.differences_finite hr)
    (RingPresentation.mkRingHom_ker_eq_span r)

/-- Finite presentability of Steinberg groups over finitely presented rings
reduces to the case of a free associative ring on finitely many generators.

The hypothesis `hfree` is intentionally explicit: it is the substantial
Krstić--McCool base theorem and is not a consequence of quotient exactness
or of an unstable-`K₂` assumption. -/
theorem isFinitelyPresented_of_isFinitelyPresentedNC
    [Ring.IsFinitelyPresentedNC S]
    (hcard : 3 ≤ Fintype.card I)
    (hfree : ∀ m : ℕ,
      Group.IsFinitelyPresented
        (SteinbergGroup I (FreeAlgebra ℤ (Fin m)))) :
    Group.IsFinitelyPresented (SteinbergGroup I S) := by
  obtain ⟨m, r, hr, ⟨e⟩⟩ := Ring.IsFinitelyPresentedNC.out (A := S)
  letI : Group.IsFinitelyPresented
      (SteinbergGroup I (FreeAlgebra ℤ (Fin m))) := hfree m
  letI : Group.IsFinitelyPresented (SteinbergGroup I (RingQuot r)) :=
    isFinitelyPresented_ringQuot r hr hcard
  exact Group.IsFinitelyPresented.equiv
    (coefficientEquiv (I := I) e.symm)

end SteinbergGroup

end GroupApproximation
