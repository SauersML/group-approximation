import GroupApproximation.Steinberg.Functoriality
import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# Exactness of Steinberg groups under coefficient quotients

For a surjective homomorphism of associative unital rings `f : R →+* S`,
the induced map `St_I(R) → St_I(S)` is the quotient by the normal closure
of the root elements `xᵢⱼ(a)` with `a ∈ ker(f)`.  This is the elementary
exactness input in the Krstić--McCool finite-presentation argument.

The proof is presentation-theoretic.  A set-theoretic section of `f` defines
an inverse from `St_I(S)` to the quotient.  Different coefficient lifts agree
in the quotient because their difference belongs to the coefficient kernel.
-/

namespace GroupApproximation
namespace SteinbergGroup

open scoped commutatorElement

variable {I R S : Type*} [Fintype I] [DecidableEq I] [Ring R] [Ring S]

/-- Root elements whose coefficients are killed by a ring homomorphism. -/
def kernelRootSet (f : R →+* S) : Set (SteinbergGroup I R) :=
  {g | ∃ (i j : I) (hij : i ≠ j) (a : R),
    f a = 0 ∧ g = x i j hij a}

/-- The normal subgroup generated by root elements with coefficients in the
kernel of a ring homomorphism. -/
def kernelRootClosure (f : R →+* S) : Subgroup (SteinbergGroup I R) :=
  Subgroup.normalClosure (kernelRootSet (I := I) f)

instance kernelRootClosure_normal (f : R →+* S) :
    (kernelRootClosure (I := I) f).Normal :=
  Subgroup.normalClosure_normal

theorem kernelRootSet_subset_ringMap_ker (f : R →+* S) :
    kernelRootSet (I := I) f ⊆ (ringMap (I := I) f).ker := by
  rintro g ⟨i, j, hij, a, ha, rfl⟩
  change ringMap (I := I) f (x i j hij a) = 1
  rw [ringMap_x, ha, x_zero]

theorem kernelRootClosure_le_ringMap_ker (f : R →+* S) :
    kernelRootClosure (I := I) f ≤ (ringMap (I := I) f).ker := by
  exact Subgroup.normalClosure_le_normal (kernelRootSet_subset_ringMap_ker f)

/-- The finite-indexed family of root elements whose coefficients lie in a
specified set. -/
def rootSetOver (K : Set R) : Set (SteinbergGroup I R) :=
  {g | ∃ (i j : I) (hij : i ≠ j) (a : R), a ∈ K ∧ g = x i j hij a}

/-- The normal subgroup generated by all root elements with coefficients in
`K`. -/
def rootClosureOver (K : Set R) : Subgroup (SteinbergGroup I R) :=
  Subgroup.normalClosure (rootSetOver (I := I) K)

instance rootClosureOver_normal (K : Set R) :
    (rootClosureOver (I := I) K).Normal :=
  Subgroup.normalClosure_normal

theorem rootSetOver_mono {K L : Set R} (hKL : K ⊆ L) :
    rootSetOver (I := I) K ⊆ rootSetOver (I := I) L := by
  rintro g ⟨i, j, hij, a, ha, rfl⟩
  exact ⟨i, j, hij, a, hKL ha, rfl⟩

theorem rootClosureOver_mono {K L : Set R} (hKL : K ⊆ L) :
    rootClosureOver (I := I) K ≤ rootClosureOver (I := I) L := by
  exact Subgroup.normalClosure_mono (rootSetOver_mono hKL)

private theorem exists_index_ne_two (hcard : 3 ≤ Fintype.card I) (i j : I) :
    ∃ k : I, k ≠ i ∧ k ≠ j := by
  classical
  by_contra hcon
  have hsub : (Finset.univ : Finset I) ⊆ {i, j} := by
    intro k _
    by_contra hk
    simp only [Finset.mem_insert, Finset.mem_singleton] at hk
    exact hcon ⟨k, fun hki ↦ hk (Or.inl hki), fun hkj ↦ hk (Or.inr hkj)⟩
  have hle : Fintype.card I ≤ 2 := by
    calc
      Fintype.card I = (Finset.univ : Finset I).card := (Finset.card_univ).symm
      _ ≤ ({i, j} : Finset I).card := Finset.card_le_card hsub
      _ ≤ 2 := Finset.card_insert_le _ _ |>.trans (by simp)
  omega

theorem rootSetOver_finite {K : Set R} (hK : K.Finite) :
    (rootSetOver (I := I) K).Finite := by
  let T : Set (I × I × R) := Set.univ ×ˢ (Set.univ ×ˢ K)
  have hT : T.Finite := Set.toFinite Set.univ |>.prod
    (Set.toFinite Set.univ |>.prod hK)
  let chooseRoot : I × I × R → SteinbergGroup I R := fun p ↦
    if hp : p.1 ≠ p.2.1 then x p.1 p.2.1 hp p.2.2 else 1
  apply (hT.image chooseRoot).subset
  rintro g ⟨i, j, hij, a, ha, rfl⟩
  refine ⟨(i, j, a), ⟨Set.mem_univ _, Set.mem_univ _, ha⟩, ?_⟩
  simp only [chooseRoot, dif_pos hij]

/-- Root elements over the two-sided ideal generated by `K` already lie in
the normal closure of the roots over `K`.  The third index is what turns left
and right multiplication in the coefficient ideal into Steinberg
commutators. -/
theorem root_mem_rootClosureOver_of_mem_span (hcard : 3 ≤ Fintype.card I)
    (K : Set R) {a : R} (ha : a ∈ TwoSidedIdeal.span K)
    (i j : I) (hij : i ≠ j) :
    x i j hij a ∈ rootClosureOver (I := I) K := by
  revert i j
  induction ha using TwoSidedIdeal.span_induction with
  | mem a ha =>
      intro i j hij
      exact Subgroup.subset_normalClosure ⟨i, j, hij, a, ha, rfl⟩
  | zero =>
      intro i j hij
      rw [x_zero]
      exact Subgroup.one_mem _
  | add a b ha hb iha ihb =>
      intro i j hij
      rw [← x_mul]
      exact Subgroup.mul_mem _ (iha i j hij) (ihb i j hij)
  | neg a ha iha =>
      intro i j hij
      rw [x_neg]
      exact Subgroup.inv_mem _ (iha i j hij)
  | left_absorb r a ha iha =>
      intro i j hij
      obtain ⟨k, hki, hkj⟩ := exists_index_ne_two hcard i j
      rw [← x_commutator i k j hki.symm hkj hij]
      apply Subgroup.commutator_le_right
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _)
        (iha k j hkj)
  | right_absorb r a ha iha =>
      intro i j hij
      obtain ⟨k, hki, hkj⟩ := exists_index_ne_two hcard i j
      rw [← x_commutator i k j hki.symm hkj hij]
      apply Subgroup.commutator_le_left
      exact Subgroup.commutator_mem_commutator
        (iha i k hki.symm)
        (Subgroup.mem_top _)

theorem rootClosureOver_span (hcard : 3 ≤ Fintype.card I) (K : Set R) :
    rootClosureOver (I := I) (TwoSidedIdeal.span K : Set R) =
      rootClosureOver (I := I) K := by
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    rintro g ⟨i, j, hij, a, ha, rfl⟩
    exact root_mem_rootClosureOver_of_mem_span hcard K ha i j hij
  · exact rootClosureOver_mono TwoSidedIdeal.subset_span

theorem rootClosureOver_isFinitelyNormallyGenerated {K : Set R}
    (hK : K.Finite) :
    (rootClosureOver (I := I) K).IsFinitelyNormallyGenerated :=
  ⟨rootSetOver (I := I) K, rootSetOver_finite hK, rfl⟩

theorem kernelRootSet_eq_rootSetOver_ker (f : R →+* S) :
    kernelRootSet (I := I) f =
      rootSetOver (I := I) (TwoSidedIdeal.ker f : Set R) := by
  ext g
  constructor
  · rintro ⟨i, j, hij, a, ha, rfl⟩
    exact ⟨i, j, hij, a, (TwoSidedIdeal.mem_ker f).mpr ha, rfl⟩
  · rintro ⟨i, j, hij, a, ha, rfl⟩
    exact ⟨i, j, hij, a, (TwoSidedIdeal.mem_ker f).mp ha, rfl⟩

theorem kernelRootClosure_eq_rootClosureOver_ker (f : R →+* S) :
    kernelRootClosure (I := I) f =
      rootClosureOver (I := I) (TwoSidedIdeal.ker f : Set R) := by
  rw [kernelRootClosure, rootClosureOver, kernelRootSet_eq_rootSetOver_ker]

private theorem quotient_x_eq_of_map_eq (f : R →+* S)
    {i j : I} (hij : i ≠ j) {a b : R} (hab : f a = f b) :
    QuotientGroup.mk' (kernelRootClosure (I := I) f) (x i j hij a) =
      QuotientGroup.mk' (kernelRootClosure (I := I) f) (x i j hij b) := by
  apply QuotientGroup.eq_iff_div_mem.mpr
  have hdiff : f (a - b) = 0 := by rw [map_sub, hab, sub_self]
  have hroot : x i j hij (a - b) ∈ kernelRootClosure (I := I) f :=
    Subgroup.subset_normalClosure ⟨i, j, hij, a - b, hdiff, rfl⟩
  simpa only [div_eq_mul_inv, ← x_neg, ← x_mul, sub_eq_add_neg] using hroot

section Surjective

variable (f : R →+* S) (hf : Function.Surjective f)

private noncomputable def quotientGenerator (g : SteinbergGenerator I S) :
    SteinbergGroup I R ⧸ kernelRootClosure (I := I) f :=
  QuotientGroup.mk' (kernelRootClosure (I := I) f)
    (x g.row g.column g.row_ne_column
      (Function.surjInv hf g.coefficient))

private theorem quotientGenerator_kills_relations
    (w : FreeGroup (SteinbergGenerator I S))
    (hw : w ∈ relations (I := I) (R := S)) :
    FreeGroup.lift (quotientGenerator (I := I) f hf) w = 1 := by
  change IsRelation w at hw
  cases hw with
  | add i j hij a b =>
      simp only [map_mul, map_inv, FreeGroup.lift_apply_of, quotientGenerator]
      change
        QuotientGroup.mk' (kernelRootClosure (I := I) f)
              (x i j hij (Function.surjInv hf a) *
                x i j hij (Function.surjInv hf b)) *
            (QuotientGroup.mk' (kernelRootClosure (I := I) f)
              (x i j hij (Function.surjInv hf (a + b))))⁻¹ = 1
      rw [x_mul]
      apply mul_inv_eq_one.mpr
      apply quotient_x_eq_of_map_eq f hij
      simp only [map_add, Function.surjInv_eq]
  | commute i j k l hij hkl hjk hli a b =>
      simp only [map_commutatorElement, FreeGroup.lift_apply_of,
        quotientGenerator]
      change QuotientGroup.mk' (kernelRootClosure (I := I) f)
        ⁅x i j hij (Function.surjInv hf a),
          x k l hkl (Function.surjInv hf b)⁆ = 1
      rw [(x_commute_of_ne i j k l hij hkl hjk hli
        (Function.surjInv hf a)
        (Function.surjInv hf b)).commutator_eq, map_one]
  | adjacent i j k hij hjk hik a b =>
      simp only [map_mul, map_inv, map_commutatorElement,
        FreeGroup.lift_apply_of, quotientGenerator]
      change
        QuotientGroup.mk' (kernelRootClosure (I := I) f)
              ⁅x i j hij (Function.surjInv hf a),
                x j k hjk (Function.surjInv hf b)⁆ *
            (QuotientGroup.mk' (kernelRootClosure (I := I) f)
              (x i k hik (Function.surjInv hf (a * b))))⁻¹ = 1
      rw [x_commutator i j k hij hjk hik]
      apply mul_inv_eq_one.mpr
      apply quotient_x_eq_of_map_eq f hik
      simp only [map_mul, Function.surjInv_eq]

/-- A set-theoretic coefficient section induces a homomorphism from the
target Steinberg group back to the quotient of the source. -/
private noncomputable def fromTargetToQuotient :
    SteinbergGroup I S →* SteinbergGroup I R ⧸ kernelRootClosure (I := I) f :=
  PresentedGroup.toGroup (f := quotientGenerator (I := I) f hf)
    (quotientGenerator_kills_relations (I := I) f hf)

@[simp] private theorem fromTargetToQuotient_x
    (i j : I) (hij : i ≠ j) (a : S) :
    fromTargetToQuotient (I := I) f hf (x i j hij a) =
      QuotientGroup.mk' (kernelRootClosure (I := I) f)
        (x i j hij (Function.surjInv hf a)) := by
  exact PresentedGroup.toGroup.of _

/-- The induced Steinberg map, factored through the root-kernel quotient. -/
private def fromQuotientToTarget :
    (SteinbergGroup I R ⧸ kernelRootClosure (I := I) f) →*
      SteinbergGroup I S :=
  QuotientGroup.lift (kernelRootClosure (I := I) f)
    (ringMap (I := I) f) (kernelRootClosure_le_ringMap_ker f)

private theorem fromQuotientToTarget_fromTargetToQuotient :
    (fromQuotientToTarget (I := I) f).comp
        (fromTargetToQuotient (I := I) f hf) =
      MonoidHom.id (SteinbergGroup I S) := by
  apply PresentedGroup.ext
  rintro ⟨i, j, hij, a⟩
  change fromQuotientToTarget (I := I) f
      (fromTargetToQuotient (I := I) f hf (x i j hij a)) = x i j hij a
  rw [fromTargetToQuotient_x]
  change ringMap (I := I) f
      (x i j hij (Function.surjInv hf a)) = x i j hij a
  rw [ringMap_x]
  exact congrArg (x i j hij) (Function.surjInv_eq hf a)

private theorem fromTargetToQuotient_ringMap :
    (fromTargetToQuotient (I := I) f hf).comp (ringMap (I := I) f) =
      QuotientGroup.mk' (kernelRootClosure (I := I) f) := by
  apply PresentedGroup.ext
  rintro ⟨i, j, hij, a⟩
  change fromTargetToQuotient (I := I) f hf
      (ringMap (I := I) f (x i j hij a)) =
    QuotientGroup.mk' (kernelRootClosure (I := I) f) (x i j hij a)
  rw [ringMap_x, fromTargetToQuotient_x]
  exact quotient_x_eq_of_map_eq f hij
    (Function.surjInv_eq hf (f a))

private theorem fromTargetToQuotient_fromQuotientToTarget :
    (fromTargetToQuotient (I := I) f hf).comp
        (fromQuotientToTarget (I := I) f) =
      MonoidHom.id
        (SteinbergGroup I R ⧸ kernelRootClosure (I := I) f) := by
  apply MonoidHom.ext
  intro q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective
    (kernelRootClosure (I := I) f) q
  change fromTargetToQuotient (I := I) f hf
      (ringMap (I := I) f g) =
    QuotientGroup.mk' (kernelRootClosure (I := I) f) g
  exact DFunLike.congr_fun (fromTargetToQuotient_ringMap (I := I) f hf) g

/-- The coefficient quotient theorem for Steinberg groups. -/
noncomputable def quotientEquiv :
    (SteinbergGroup I R ⧸ kernelRootClosure (I := I) f) ≃*
      SteinbergGroup I S :=
  MonoidHom.toMulEquiv (fromQuotientToTarget (I := I) f)
    (fromTargetToQuotient (I := I) f hf)
    (fromTargetToQuotient_fromQuotientToTarget (I := I) f hf)
    (fromQuotientToTarget_fromTargetToQuotient (I := I) f hf)

/-- Exactness: the kernel of a surjective coefficient map on Steinberg
groups is generated normally by the root elements over the ring kernel. -/
theorem ringMap_ker_eq_kernelRootClosure (hf : Function.Surjective f) :
    (ringMap (I := I) f).ker = kernelRootClosure (I := I) f := by
  apply le_antisymm
  · intro g hg
    apply (QuotientGroup.eq_one_iff g).mp
    apply (quotientEquiv (I := I) f hf).injective
    change ringMap (I := I) f g = 1
    exact hg
  · exact kernelRootClosure_le_ringMap_ker f

/-- If the coefficient kernel is generated by finitely many two-sided ring
relations, then the kernel of the induced Steinberg map is finitely normally
generated. -/
theorem ringMap_ker_isFinitelyNormallyGenerated_of_ker_eq_span
    (hf : Function.Surjective f) (hcard : 3 ≤ Fintype.card I)
    (K : Set R) (hK : K.Finite)
    (hker : TwoSidedIdeal.ker f = TwoSidedIdeal.span K) :
    (ringMap (I := I) f).ker.IsFinitelyNormallyGenerated := by
  rw [ringMap_ker_eq_kernelRootClosure f hf,
    kernelRootClosure_eq_rootClosureOver_ker, hker,
    rootClosureOver_span hcard]
  exact rootClosureOver_isFinitelyNormallyGenerated hK

end Surjective

end SteinbergGroup
end GroupApproximation
