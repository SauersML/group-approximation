import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVCTreeGap
import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVCTreeLevelBand
import GroupApproximation.Meta.AxiomGuard

/-!
# The defect gap reduced to a finitely generated level subgroup (lane bh-met-77k)

Write `K = normalClosure (higmanVC_rels d fun _ => True)` and `Q = higmanVCCommon_Q d`.  For a
pivot `(a, b)` with `|a| = n`, `|b| = n + 1` and `a`, `b` incomparable, let
`G_n = higmanVCTreeLevel_G d n a b ≤ Q`.  It is generated by the finitely many balanced swaps
of length `n + 1` (the image of `Sym(W_{n+1})`) and the single involution `(a, b)`.

**Proved here, with no hypotheses.**  Every word `r` in letters of defect `≤ 1` has
`mk (iota r) ∈ G_n` for all large `n` and every pivot (`higmanVCTreeLevel_word_mem`).  To see
this, split each letter `(u, v)` to band letters of lengths `(n, n + 1)` (split relator), and
use `EnvelopeHigmanVCTreeLevelBand`.

**Gap: `HigmanVCTreeLevelStatement`.**  For arbitrarily large `n` there is a pivot `(a, b)` such
that every kernel word whose class lies in `G_n` lies in `K`.  In other words, the standard
relators present the finitely generated subgroup `⟨Sym(W_{n+1}), (a, b)⟩` faithfully.

* **Reduction (proved):** `higmanVCTreeLevel_defect_of_level : HigmanVCTreeLevelStatement →
  HigmanVCTreeDefectStatement`.  This then feeds `higmanVCTree_balanced_of_defect`, giving
  `HigmanVCCentralBalancedStatement` (`higmanVCTreeLevel_balanced_of_level`), and (1)
  (`higmanVCTreeLevel_ker_le_of_level`).  The centrality hypothesis of the defect gap is not
  needed.
* **LOUD: it is equivalent to (1) as a Prop, NOT strictly weaker as a Prop**
  (`higmanVCTreeLevel_level_of_ker_le`).  No gap that yields (1) with nothing else supplied can
  be.
* **Strictly smaller in proof content.**  The defect gap quantifies over words in infinitely
  many letters of every length.  Here, for each `n`, only words in a fixed finite alphabet
  matter: `Sym(W_{n+1})` plus ONE involution.  The `Sym(W_{n+1})` part alone is already
  faithful (`higmanVCTreeLevel_bal_faithful`, from `higmanVCAll_antichain_mem`).  So what
  remains is exactly how the single involution `(a, b)` interacts with `Sym(W_{n+1})`.
* **LOUD: what is still inside the gap.**  `(a, b)` does not preserve depth `n + 1`: it maps a
  cylinder of depth `n` onto one of depth `n + 1`.  So words mixing `(a, b)` with
  `Sym(W_{n+1})` generate Thompson-`F`-like elements.  The
  cross-level tree-pair / normal-form argument is NOT supplied here.
* **LOUD: route (a), eliminating defect-1 letters letter by letter, is impossible.**  A
  defect-1 swap does not preserve the uniform measure of cylinders.  Every balanced swap
  does.  So no defect-1 letter is a product of balanced letters, even in `V_d`
  (`check.py` part D).  Defect-1 content can only be concentrated, which is what we do here:
  all of it is carried by one involution per level.
* **Route (b), the fixed-length / finite-Sym presentation, already exists in the corpus**
  (`higmanVCAll_antichain_mem`).  It is used by `higmanVCTreeLevel_bal_faithful`.
* **Truth.**  The gap is true if and only if (1) is true.  (1) is the standard presentation of
  `V_d`; it is believed but not verified here.  `scratchpad/bh-met-77k/check.py` checks the
  proved identities (pivot step, band step with the exact case split, splitting to band
  letters) as permutations of cylinders, for `d = 2, 3` and `n ≤ 3`: 847 checks, 0 failures,
  plus a negative control.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

/-- An `m`-fold split of an incomparable letter of lengths `(n - m, n + 1 - m)` lies in `G_n`,
since every component is a band letter. -/
theorem higmanVCTreeLevel_deep_mem {d n : ℕ} {a b : List (Fin d)} (ha : a.length = n)
    (hb : b.length = n + 1) (hab : ¬ a <+: b) (hba : ¬ b <+: a) (m : ℕ) :
    ∀ {x y : List (Fin d)}, x.length + m = n → y.length + m = n + 1 → ¬ x <+: y → ¬ y <+: x →
      higmanVCCommon_mk d (higmanVCCommon_deep d m x y) ∈ higmanVCTreeLevel_G d n a b := by
  induction m with
  | zero =>
    intro x y hx hy hxy hyx
    rw [higmanVCCommon_deep_zero]
    exact higmanVCTreeLevel_band_mem ha hb hab hba (by omega) (by omega) hxy hyx
  | succ m ih =>
    intro x y hx hy hxy hyx
    rw [higmanVCCommon_deep_succ, map_list_prod]
    refine list_prod_mem fun t ht => ?_
    obtain ⟨g, hg, rfl⟩ := List.mem_map.mp ht
    obtain ⟨c, _, rfl⟩ := List.mem_map.mp hg
    exact ih (x := x ++ [c]) (y := y ++ [c])
      (by rw [List.length_append, List.length_singleton]; omega)
      (by rw [List.length_append, List.length_singleton]; omega)
      (higmanVFP_ext_incomp hxy hyx c c) (higmanVFP_ext_incomp hyx hxy c c)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_deep_mem

/-- Every letter of defect `≤ 1` with both lengths `≤ n + 1` lies in `G_n`. -/
theorem higmanVCTreeLevel_small_mem {d n : ℕ} {a b : List (Fin d)} (ha : a.length = n)
    (hb : b.length = n + 1) (hab : ¬ a <+: b) (hba : ¬ b <+: a) {u v : List (Fin d)}
    (h1 : u.length ≤ v.length + 1) (h2 : v.length ≤ u.length + 1) (hun : u.length ≤ n + 1)
    (hvn : v.length ≤ n + 1) :
    higmanVCCommon_mk d (FreeGroup.of (u, v)) ∈ higmanVCTreeLevel_G d n a b := by
  by_cases hc : ¬ u <+: v ∧ ¬ v <+: u
  · rcases lt_trichotomy u.length v.length with hl | hl | hl
    · rw [← higmanVCCommon_mk_deep (n - u.length) hc.1 hc.2]
      exact higmanVCTreeLevel_deep_mem ha hb hab hba (n - u.length) (by omega) (by omega)
        hc.1 hc.2
    · exact higmanVCTreeLevel_bal_mem hl (by omega)
    · rw [higmanVCTree_mk_swap hc.1 hc.2, ← higmanVCCommon_mk_deep (n - v.length) hc.2 hc.1]
      exact higmanVCTreeLevel_deep_mem ha hb hab hba (n - v.length) (by omega) (by omega)
        hc.2 hc.1
  · rw [higmanVCCommon_mk_comparable hc]
    exact Subgroup.one_mem _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_small_mem

/-- **Every defect-`≤ 1` word lies in `G_n` for all large `n`** (with no hypotheses). -/
theorem higmanVCTreeLevel_word_mem {d : ℕ} (r : FreeGroup (higmanVCTree_Small d)) :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ a b : List (Fin d), a.length = n → b.length = n + 1 →
      ¬ a <+: b → ¬ b <+: a →
        higmanVCCommon_mk d (higmanVCTree_iota d r) ∈ higmanVCTreeLevel_G d n a b := by
  induction r using FreeGroup.induction_on with
  | C1 =>
    refine ⟨0, fun _ _ _ _ _ _ _ _ => ?_⟩
    rw [map_one (higmanVCTree_iota d), map_one]
    exact Subgroup.one_mem _
  | of p =>
    obtain ⟨⟨u, v⟩, h1, h2⟩ := p
    refine ⟨u.length + v.length, fun n hn a b ha hb hab hba => ?_⟩
    rw [higmanVCTree_iota_of]
    exact higmanVCTreeLevel_small_mem ha hb hab hba h1 h2 (by omega) (by omega)
  | inv_of _ ih =>
    obtain ⟨N, hN⟩ := ih
    refine ⟨N, fun n hn a b ha hb hab hba => ?_⟩
    rw [map_inv (higmanVCTree_iota d), map_inv]
    exact Subgroup.inv_mem _ (hN n hn a b ha hb hab hba)
  | mul g₁ g₂ ih₁ ih₂ =>
    obtain ⟨N₁, hN₁⟩ := ih₁
    obtain ⟨N₂, hN₂⟩ := ih₂
    refine ⟨max N₁ N₂, fun n hn a b ha hb hab hba => ?_⟩
    rw [map_mul (higmanVCTree_iota d), map_mul]
    exact Subgroup.mul_mem _ (hN₁ n ((le_max_left N₁ N₂).trans hn) a b ha hb hab hba)
      (hN₂ n ((le_max_right N₁ N₂).trans hn) a b ha hb hab hba)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_word_mem

/-- **Gap (level form).**  For arbitrarily large `n` there is a pivot `(a, b)`, `|a| = n`,
`|b| = n + 1`, incomparable, such that the standard relators present
`G_n = ⟨Sym(W_{n+1}), (a, b)⟩ ≤ Q` faithfully: every kernel word whose class lies in `G_n` lies
in `K`.  It is equivalent to (1) as a Prop, but only words over a finite alphabet per level
matter; see the module docstring. -/
def HigmanVCTreeLevelStatement : Prop :=
  ∀ d : ℕ, 1 < d → ∀ N : ℕ, ∃ n : ℕ, N ≤ n ∧ ∃ a b : List (Fin d), a.length = n ∧
    b.length = n + 1 ∧ ¬ a <+: b ∧ ¬ b <+: a ∧
    ∀ r : FreeGroup (List (Fin d) × List (Fin d)), r ∈ (higmanVC_evalAll d).ker →
      higmanVCCommon_mk d r ∈ higmanVCTreeLevel_G d n a b →
        r ∈ Subgroup.normalClosure (higmanVC_rels d fun _ => True)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.HigmanVCTreeLevelStatement

/-- **The defect gap of lane bh-met-77i from the level gap.** -/
theorem higmanVCTreeLevel_defect_of_level (h : HigmanVCTreeLevelStatement) :
    HigmanVCTreeDefectStatement := by
  intro d hd r hr _
  obtain ⟨N, hN⟩ := higmanVCTreeLevel_word_mem r
  obtain ⟨n, hn, a, b, ha, hb, hab, hba, hK⟩ := h d hd N
  refine ⟨[], fun _ hp => absurd hp List.not_mem_nil, ?_⟩
  rw [List.map_nil, List.prod_nil, inv_one, mul_one]
  exact hK _ hr (hN n hn a b ha hb hab hba)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_defect_of_level

/-- **The balanced gap of lane bh-met-77h from the level gap.** -/
theorem higmanVCTreeLevel_balanced_of_level (h : HigmanVCTreeLevelStatement) :
    HigmanVCCentralBalancedStatement :=
  higmanVCTree_balanced_of_defect (higmanVCTreeLevel_defect_of_level h)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_balanced_of_level

/-- **(1) from the level gap**: the standard relators present `V_d` on all ordered pairs. -/
theorem higmanVCTreeLevel_ker_le_of_level (h : HigmanVCTreeLevelStatement) (d : ℕ)
    (hd : 1 < d) :
    (higmanVC_evalAll d).ker ≤ Subgroup.normalClosure (higmanVC_rels d fun _ => True) :=
  higmanVCTree_ker_le_of_defect (higmanVCTreeLevel_defect_of_level h) d hd

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_ker_le_of_level

/-- **The level gap from (1)**: the gap is equivalent to (1) as a Prop, not weaker. -/
theorem higmanVCTreeLevel_level_of_ker_le
    (h : ∀ d : ℕ, 1 < d →
      (higmanVC_evalAll d).ker ≤ Subgroup.normalClosure (higmanVC_rels d fun _ => True)) :
    HigmanVCTreeLevelStatement := by
  intro d hd N
  refine ⟨N + 1, Nat.le_succ N, ⟨0, by omega⟩ :: List.replicate N ⟨0, by omega⟩,
    ⟨1, hd⟩ :: List.replicate (N + 1) ⟨1, hd⟩, ?_, ?_, ?_, ?_, fun _ hr _ => h d hd hr⟩
  · rw [List.length_cons, List.length_replicate]
  · rw [List.length_cons, List.length_replicate]
  · intro e
    exact higmanVCTree_fin_ne hd (List.cons_prefix_cons.mp e).1
  · intro e
    exact higmanVCTree_fin_ne hd (List.cons_prefix_cons.mp e).1.symm

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_level_of_ker_le

/-- **Route (b) is already available: `Sym(W_{n+1})` is faithful.**  A kernel word whose class
is a product of balanced letters of length `n + 1` lies in `K`. -/
theorem higmanVCTreeLevel_bal_faithful {d : ℕ} (hd : 0 < d) (n : ℕ)
    {r : FreeGroup (List (Fin d) × List (Fin d))} (hr : r ∈ (higmanVC_evalAll d).ker)
    (hm : higmanVCCommon_mk d r ∈
      ((higmanVCCommon_mk d).comp (higmanVCAll_iota (higmanVCCentral_words d (n + 1)))).range) :
    r ∈ Subgroup.normalClosure (higmanVC_rels d fun _ => True) := by
  obtain ⟨s, hs⟩ := MonoidHom.mem_range.mp hm
  rw [MonoidHom.comp_apply] at hs
  have hK : Subgroup.normalClosure (higmanVC_rels d fun _ => True) ≤
      (higmanVC_evalAll d).ker :=
    Subgroup.normalClosure_le_normal (higmanVC_rels_subset_ker d _)
  have h1 : higmanVCAll_iota (higmanVCCentral_words d (n + 1)) s * r⁻¹ ∈
      Subgroup.normalClosure (higmanVC_rels d fun _ => True) := by
    refine higmanVCCommon_mk_eq_one_iff.mp ?_
    rw [map_mul, map_inv, hs, mul_inv_cancel]
  have h2 := MonoidHom.mem_ker.mp (hK h1)
  rw [map_mul, map_inv, MonoidHom.mem_ker.mp hr, inv_one, mul_one] at h2
  have h3 := higmanVCAll_antichain_mem hd _ (higmanVCCentral_words_antichain d (n + 1)) s h2
  refine higmanVCCommon_mk_eq_one_iff.mp ?_
  rw [← hs]
  exact higmanVCCommon_mk_eq_one_iff.mpr h3

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_bal_faithful

end GroupApproximation.BooneHigman.Metabelian.Envelope
