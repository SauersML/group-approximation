import GroupApproximation.BooneHigman.Metabelian.SuslinBase3FamGen
import GroupApproximation.BooneHigman.Metabelian.SuslinBase3FamSucc
import GroupApproximation.Meta.AxiomGuard

/-!
# The rank-3 base of R2 for the two families: endpoint of lane `bh-met-91p`

* `SuslinBase3FamGlobalStatement`: `SuslinBase3CongGlobalStatement` with the core
  `SuslinBase3CongPowStab A 2` replaced by the residual `SuslinBase3FamPowStab A` (only the
  normalized `σ ≡ 1 mod 𝔪^N` OUTSIDE `SuslinBase3FamGen A`, the subgroup generated by
  `E₂(A[X])` and all `ψ(SL₂(A))`, `ψ : A →+* A[X]`).
* `suslinBase3Fam_congGlobal_of_famGlobal` (**the reduction**): it uses the family hypothesis
  `SL₃(A) = E₃(A)` AT LEVEL `k` (`suslinBase3Fam_powStab_of_famPowStab`), non-circularly.
* `suslinBase3Fam_famGlobal_iff_congGlobal`: **LOUD: the residual is EQUIVALENT** to
  `SuslinBase3CongGlobalStatement` (the converse drops the `∉` premise).  It is strictly smaller
  only in PROOF CONTENT (the elements of `SuslinBase3FamGen A`, which include normalized
  non-elementary ones, are discharged by the family hypothesis).
* Downstream: `SuslinBase3CoreGlobalStatement`, `SuslinBase3GlobalStatement`,
  `SuslinR2IndBaseStatement`.

**Truth check / closure (LOUD).**  No closure.  The strengthened-hypothesis variant
(`SL = E` at `k + 1`) is PROVED (`suslinBase3Fam_succGlobal`) but CIRCULAR for the consumer: its
hypothesis is the conclusion of the one-variable step that this base feeds
(`suslinBase3Fam_global_of_polynomialSuslin`).  The residual is true on the families exactly when
`SuslinBase3CongGlobalStatement` is (K1-regularity of the regular local rings `A_𝔪`; truth
witness `suslinBase3Cong_congGlobal_of_localCaseFamily`, NOT used as a route here).
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

/-- **The residual global Statement**: the deep-congruence core only outside
`SuslinBase3FamGen`, for the two families, under the level-`k` family hypothesis. -/
def SuslinBase3FamGlobalStatement : Prop :=
  (∀ (p : ℕ) [Fact p.Prime] (k : ℕ), 1 ≤ k →
      (∀ N' : ℕ, 3 ≤ N' → SpecialLinearInElementary (Chain.CharPPoly p k) N') →
        SuslinBase3FamPowStab (Chain.CharPPoly p k)) ∧
    ∀ (m k : ℕ),
      (∀ N' : ℕ, 3 ≤ N' → SpecialLinearInElementary (Chain.SIntPoly m k) N') →
        SuslinBase3FamPowStab (Chain.SIntPoly m k)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.SuslinBase3FamGlobalStatement

/-- **The reduction**, using `SL₃ = E₃` at level `k`. -/
theorem suslinBase3Fam_congGlobal_of_famGlobal (h : SuslinBase3FamGlobalStatement) :
    SuslinBase3CongGlobalStatement :=
  ⟨fun p _ k hk hA ↦
      suslinBase3Fam_powStab_of_famPowStab (hA (2 + 1) (by norm_num)) (h.1 p k hk hA),
    fun m k hA ↦
      suslinBase3Fam_powStab_of_famPowStab (hA (2 + 1) (by norm_num)) (h.2 m k hA)⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_congGlobal_of_famGlobal

/-- The trivial converse. -/
theorem suslinBase3Fam_famGlobal_of_congGlobal (h : SuslinBase3CongGlobalStatement) :
    SuslinBase3FamGlobalStatement :=
  ⟨fun p _ k hk hA ↦ suslinBase3Fam_famPowStab_of_powStab (h.1 p k hk hA),
    fun m k hA ↦ suslinBase3Fam_famPowStab_of_powStab (h.2 m k hA)⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_famGlobal_of_congGlobal

/-- **LOUD: the residual is equivalent** to `SuslinBase3CongGlobalStatement` (smaller only in
proof content). -/
theorem suslinBase3Fam_famGlobal_iff_congGlobal :
    SuslinBase3FamGlobalStatement ↔ SuslinBase3CongGlobalStatement :=
  ⟨suslinBase3Fam_congGlobal_of_famGlobal, suslinBase3Fam_famGlobal_of_congGlobal⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_famGlobal_iff_congGlobal

/-- The residual gives the congruence core for both families. -/
theorem suslinBase3Fam_coreGlobal_of_famGlobal (h : SuslinBase3FamGlobalStatement) :
    SuslinBase3CoreGlobalStatement :=
  suslinBase3Cong_coreGlobal_of_congGlobal (suslinBase3Fam_congGlobal_of_famGlobal h)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_coreGlobal_of_famGlobal

/-- The residual gives the stabilized base for both families. -/
theorem suslinBase3Fam_global_of_famGlobal (h : SuslinBase3FamGlobalStatement) :
    SuslinBase3GlobalStatement :=
  suslinBase3Cong_global_of_congGlobal (suslinBase3Fam_congGlobal_of_famGlobal h)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_global_of_famGlobal

/-- The residual gives the rank-3 base of R2. -/
theorem suslinBase3Fam_indBase_of_famGlobal (h : SuslinBase3FamGlobalStatement) :
    SuslinR2IndBaseStatement :=
  suslinBase3Cong_indBase_of_congGlobal (suslinBase3Fam_congGlobal_of_famGlobal h)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_indBase_of_famGlobal

end Absorption
end Metabelian
end BooneHigman
end GroupApproximation
