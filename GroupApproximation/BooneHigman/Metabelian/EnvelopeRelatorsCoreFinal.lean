import GroupApproximation.BooneHigman.Metabelian.EnvelopeRelatorsCoreStabSwaps
import GroupApproximation.BooneHigman.Metabelian.EnvelopeRelatorsCoreSplit
import GroupApproximation.BooneHigman.Metabelian.EnvelopeRelatorsCoreConj
import GroupApproximation.BooneHigman.Metabelian.EnvelopeRelatorsFiniteStatement
import GroupApproximation.Meta.AxiomGuard

/-!
# Finite core relators: the reduction to the kernel statement

`rnRelatorsFiniteCore_of_kernel` proves `RNRelatorsFiniteCoreStatement` from
`RNRelatorsCoreKernelStatement`.  The kernel statement says only that the four infinite
normal-form families `nfRelators H x₀` normally generate `ker (rnFreeHom H x₀)`.

The finite data are:
* `F := rnCoreStabGens x₀`, the short cone swaps avoiding `[x₀]`.  Their closure is the whole
  pointwise stabilizer of `cone [x₀]` in `V_X` (`rnCore_stab_closure`), so the commutation
  family is recovered;
* `E := rnCoreDisjData x₀ x₁`, two pairs `(e₁, [x₁])` and `(e₂, [x₁, x₁])`.  The disjoint-cone
  family is recovered from them (`rcore_disj_subset`);
* `R₀ := rnCoreRels`, the canonical splitting and root relators on a finite generating set `S`
  of `H`.  The two full families are recovered through `rcore_relators_of_gen` and
  `rcore_relator_mem`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

open Trees

/-- **Residual kernel statement.** The four normal-form relator families normally generate the
kernel of `rnFreeHom H x₀`.  This is step 1 of the route in `EnvelopeRelatorsFiniteStatement`,
the Rover–Nekrashevych normal-form argument.

**Truth.** It is TRUE.  Modulo `nfRelators H x₀`, every word of `RNFree X H` reduces to a
normal form `nfV v * ∏ L_w(h_w)` over a complete prefix code.  A kernel element maps to the
identity of `Sym (Cantor X)`, which forces the normal form to be trivial.  The core statement
also implies it: its finite relators all lie in `nfRelators H x₀`.

**It is SMALLER IN PROOF CONTENT ONLY, NOT LOGICALLY WEAKER.**  Both statements are true
propositions, so neither is logically weaker than the other in any meaningful sense.  This is
still not a restatement of the core, because the core's content is proved in this lane:
* the pointwise stabilizer of `cone [x₀]` in `V_X` is generated by the finite set
  `rnCoreStabGens x₀` (`rnCore_stab_closure`, via `rnCore_mem_of_fix`);
* the disjoint-cone family reduces to two pairs (`rcore_disj_subset`);
* the splitting and root families reduce to the canonical relators on a finite generating set
  of `H` (`rcore_relators_of_gen`, `rcore_relator_mem`, cocycle `rcoreW_mul`).
What remains is the normal-form reduction, with no finiteness in it. -/
def RNRelatorsCoreKernelStatement : Prop :=
  ∀ (X : Type) [Finite X] [Nontrivial X] (H : Subgroup (TreeAut X)), IsSelfSimilar H →
    Group.IsFinitelyPresented ↥H → Group.IsFinitelyPresented ↥(higmanThompsonV X) →
      ∃ x₀ : X, (rnFreeHom H x₀).ker ≤ Subgroup.normalClosure (nfRelators H x₀)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.RNRelatorsCoreKernelStatement

noncomputable section

variable {X : Type*} [Finite X]

/-- The canonical splitting-type relator over the word `u`, with leading letter `y`. -/
def rnCoreGenRel (H : Subgroup (TreeAut X)) (hH : IsSelfSimilar H) (x₀ : X) (u l : List X)
    (y : RNFree X H) (s : ↥H) : RNFree X H :=
  y⁻¹ * nfV H (rcoreShift u (TreeAut.rootPerm (s : TreeAut X))) *
    (l.map fun x => nfV H (rcoreE x₀ (u ++ [x])) * nfL H (rcoreSt H hH s x) *
      (nfV H (rcoreE x₀ (u ++ [x])))⁻¹).prod

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreGenRel

theorem rnCoreGenRel_split [Nontrivial X] (H : Subgroup (TreeAut X)) (hH : IsSelfSimilar H)
    (x₀ : X) {l : List X} (hl : l.Nodup) (hall : ∀ x, x ∈ l) (s : ↥H) :
    rnCoreGenRel H hH x₀ [x₀] l (nfL H s) s ∈ nfSplitRelators H x₀ :=
  ⟨s, rcoreShift [x₀] (TreeAut.rootPerm (s : TreeAut X)), fun x => rcoreE x₀ ([x₀] ++ [x]),
    rcoreSt H hH s, l, hl, hall, fun _ => rfl, fun x => rcore_E_append_spec x₀ [x₀] x, rfl, rfl⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreGenRel_split

theorem rnCoreGenRel_root [Nontrivial X] (H : Subgroup (TreeAut X)) (hH : IsSelfSimilar H)
    (x₀ : X) {l : List X} (hl : l.Nodup) (hall : ∀ x, x ∈ l) (s : ↥H) :
    rnCoreGenRel H hH x₀ [] l (nfH H s) s ∈ nfRootRelators H x₀ :=
  ⟨s, rcoreShift [] (TreeAut.rootPerm (s : TreeAut X)), fun x => rcoreE x₀ ([] ++ [x]),
    rcoreSt H hH s, l, hl, hall, fun _ => rfl, fun x => rcore_E_append_spec x₀ [] x,
    localize_nil (nfRootShift (TreeAut.rootPerm (s : TreeAut X))), rfl⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreGenRel_root

/-- The canonical splitting and root relators on the elements of `S`. -/
def rnCoreRels (H : Subgroup (TreeAut X)) (hH : IsSelfSimilar H) (x₀ : X) (l : List X)
    (S : Set ↥H) : Set (RNFree X H) :=
  (fun s => rnCoreGenRel H hH x₀ [x₀] l (nfL H s) s) '' S ∪
    (fun s => rnCoreGenRel H hH x₀ [] l (nfH H s) s) '' S

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreRels

theorem rnCoreRels_finite (H : Subgroup (TreeAut X)) (hH : IsSelfSimilar H) (x₀ : X)
    (l : List X) {S : Set ↥H} (hS : S.Finite) : (rnCoreRels H hH x₀ l S).Finite :=
  (hS.image _).union (hS.image _)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreRels_finite

theorem rnCoreRels_subset [Nontrivial X] (H : Subgroup (TreeAut X)) (hH : IsSelfSimilar H)
    (x₀ : X) {l : List X} (hl : l.Nodup) (hall : ∀ x, x ∈ l) (S : Set ↥H) :
    rnCoreRels H hH x₀ l S ⊆ nfRelators H x₀ := by
  rintro r (⟨s, -, rfl⟩ | ⟨s, -, rfl⟩)
  · exact Set.mem_union_left _ (Set.mem_union_right _ (rnCoreGenRel_split H hH x₀ hl hall s))
  · exact Set.mem_union_right _ (rnCoreGenRel_root H hH x₀ hl hall s)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreRels_subset

/-- The two disjoint-cone data `(e₁, [x₁])` and `(e₂, [x₁, x₁])`. -/
def rnCoreDisjData (x₀ x₁ : X) : Set (↥(higmanThompsonV X) × List X) :=
  {(rcoreE x₀ [x₁], [x₁]), (rcoreE x₀ [x₁, x₁], [x₁, x₁])}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreDisjData

theorem rnCoreDisjData_finite (x₀ x₁ : X) : (rnCoreDisjData x₀ x₁).Finite :=
  (Set.finite_singleton _).insert _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreDisjData_finite

theorem rnCoreDisjData_valid [Nontrivial X] {x₀ x₁ : X} (hne : x₁ ≠ x₀) :
    ∀ p ∈ rnCoreDisjData x₀ x₁, MapsCone (p.1 : Equiv.Perm (Cantor X)) [x₀] p.2 ∧
      ¬ [x₀] <+: p.2 ∧ ¬ p.2 <+: [x₀] := by
  rintro p (rfl | rfl)
  · exact ⟨rcoreE_spec x₀ (List.cons_ne_nil x₁ []), rnCore_not_root_cons hne _,
      fun h => hne (List.cons_prefix_cons.mp h).1⟩
  · exact ⟨rcoreE_spec x₀ (List.cons_ne_nil x₁ [x₁]), rnCore_not_root_cons hne _,
      fun h => hne (List.cons_prefix_cons.mp h).1⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCoreDisjData_valid

/-- **The finite data recover all normal-form relators.**  A normal subgroup containing the
canonical generator relators, the commutation relators over `closure (rnCoreStabGens x₀)` and
the disjoint-cone relators over `rnCoreDisjData x₀ x₁` contains `nfRelators H x₀`. -/
theorem rnCore_nfRelators_le [Nontrivial X] (H : Subgroup (TreeAut X)) (hH : IsSelfSimilar H)
    {x₀ x₁ : X} (hne : x₁ ≠ x₀) {S : Set ↥H} (hS : Subgroup.closure S = ⊤) {l : List X}
    (hl : l.Nodup) (hall : ∀ x, x ∈ l) (N : Subgroup (RNFree X H)) [N.Normal]
    (hR : rnCoreRels H hH x₀ l S ⊆ N)
    (hC : nfCommRelatorsOn H (Subgroup.closure (rnCoreStabGens x₀)) ⊆ N)
    (hD : nfDisjRelatorsOn H (rnCoreDisjData x₀ x₁) ⊆ N) : nfRelators H x₀ ⊆ N := by
  have hcomm : nfCommRelators H x₀ ⊆ N := by
    rintro r ⟨h, f, hf, rfl⟩
    exact hC ⟨h, f, rnCore_stab_closure x₀ f hf, rfl⟩
  have hdisj : nfDisjRelators H x₀ ⊆ N := by
    refine rcore_disj_subset H N hne hcomm (rcoreE_spec x₀ (List.cons_ne_nil x₁ []))
      (rcoreE_spec x₀ (List.cons_ne_nil x₁ [x₁])) fun h k => ⟨?_, ?_⟩
    · have hm := hD ⟨(rcoreE x₀ [x₁], [x₁]), Set.mem_insert _ _, h, k, rfl⟩
      exact rf_commute_of_mem hm
    · have hm := hD ⟨(rcoreE x₀ [x₁, x₁], [x₁, x₁]),
        Set.mem_insert_of_mem _ (Set.mem_singleton _), h, k, rfl⟩
      exact rf_commute_of_mem hm
  have hsplit : nfSplitRelators H x₀ ⊆ N := by
    rintro r ⟨h, a, c, k, l', hl', hall', hk, hc, ha, rfl⟩
    have hB := rcore_relators_of_gen H N hH x₀ hcomm hdisj hl hall [x₀]
      ((Monoid.Coprod.inr : Monoid.Coprod ↥H ↥H →* RNFree X H).comp
        (Monoid.Coprod.inr : ↥H →* Monoid.Coprod ↥H ↥H)) hS
      (fun s hs => hR (Set.mem_union_left _ ⟨s, hs, rfl⟩)) h
    exact rcore_relator_mem H N hH x₀ hcomm hdisj hl hall [x₀] (nfL H h) h hB a c k hl' hall'
      hk hc ha
  have hroot : nfRootRelators H x₀ ⊆ N := by
    rintro r ⟨h, a, c, k, l', hl', hall', hk, hc, ha, rfl⟩
    have hB := rcore_relators_of_gen H N hH x₀ hcomm hdisj hl hall []
      ((Monoid.Coprod.inr : Monoid.Coprod ↥H ↥H →* RNFree X H).comp
        (Monoid.Coprod.inl : ↥H →* Monoid.Coprod ↥H ↥H)) hS
      (fun s hs => hR (Set.mem_union_right _ ⟨s, hs, rfl⟩)) h
    exact rcore_relator_mem H N hH x₀ hcomm hdisj hl hall [] (nfH H h) h hB a c k hl' hall'
      hk hc (ha.trans (localize_nil _).symm)
  exact Set.union_subset (Set.union_subset (Set.union_subset hcomm hdisj) hsplit) hroot

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCore_nfRelators_le

end

/-- **Endpoint.** The residual kernel statement gives the finite core statement. -/
theorem rnRelatorsFiniteCore_of_kernel (hker : RNRelatorsCoreKernelStatement) :
    RNRelatorsFiniteCoreStatement := by
  intro X _ _ H hH hfp hV
  obtain ⟨x₀, hk⟩ := hker X H hH hfp hV
  obtain ⟨x₁, hx₁⟩ := exists_ne x₀
  obtain ⟨S, hS, hSfin⟩ := Group.fg_iff.mp (rf_fg_of_isFinitelyPresented hfp)
  obtain ⟨l, hl, hall⟩ := rcore_exists_list (X := X)
  refine ⟨x₀, rnCoreRels H hH x₀ l S, rnCoreStabGens x₀, rnCoreDisjData x₀ x₁,
    rnCoreRels_finite H hH x₀ l hSfin, rnCoreRels_subset H hH x₀ hl hall S,
    rnCoreStabGens_finite x₀, rnCoreStabGens_fix x₀, rnCoreDisjData_finite x₀ x₁,
    rnCoreDisjData_valid hx₁, hk.trans ?_⟩
  have hR := Subgroup.subset_normalClosure (s := rnCoreRels H hH x₀ l S ∪
    nfCommRelatorsOn H (Subgroup.closure (rnCoreStabGens x₀)) ∪
    nfDisjRelatorsOn H (rnCoreDisjData x₀ x₁))
  exact Subgroup.normalClosure_le_normal (rnCore_nfRelators_le H hH hx₁ hS hl hall _
    (fun r hr => hR (Set.mem_union_left _ (Set.mem_union_left _ hr)))
    (fun r hr => hR (Set.mem_union_left _ (Set.mem_union_right _ hr)))
    (fun r hr => hR (Set.mem_union_right _ hr)))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnRelatorsFiniteCore_of_kernel

end GroupApproximation.BooneHigman.Metabelian.Envelope
