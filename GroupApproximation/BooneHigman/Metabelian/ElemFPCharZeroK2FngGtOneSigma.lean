import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2FngStabOneTransfer
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroStabGenSupport
import GroupApproximation.Meta.AxiomGuard

/-!
# The embedding `σ : St_3(R) → St_4(R)` over any ring (lane bh-met-93o, 2)

Fix `i ≠ k` in `Fin 3`, and let `σ = czK2FngStabOne_sigma i k : Fin 3 ↪ Fin 4` be
`0 ↦ i, 1 ↦ k, 2 ↦ 3`.  The lemmas `czK2FngStabOne_sigma_*` state its bookkeeping only over
`ℤ[1/1]`.  This file restates that bookkeeping over an arbitrary ring `R`:
* `σ ∘ stab = stab ∘ τ`;
* `σ` sends `padCol`/`padRow` of `St_3` to `padCol`/`padRow` of `St_4` supported on `{i, k}`;
* `σ` maps `H X Y X Y H` into `H X Y X Y H`.

It also adds one new fact (`czK2FngGtOne_sigma_mem_off`).  If `j ∉ {i, k}`, the whole image of
`σ` lies in `czStabGen_off R j.castSucc`, the subgroup generated by the roots that avoid the
index `j.castSucc`.  The reason is that `σ` never hits `j.castSucc`, and `St_3` is generated by
its roots.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.SteinbergGroup GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.PaddedCentral

variable {R : Type*} [Ring R]

/-- `σ ∘ stab = stab ∘ τ`, over any ring. -/
theorem czK2FngGtOne_sigma_stab (i k : Fin 3) (hki : k ≠ i) (g : St 2 R) :
    indexMap (czK2FngStabOne_sigma i k hki) (stab 2 R g) =
      stab 3 R (indexMap (czK2FngStabOne_tau i k hki) g) := by
  have he : Fin.castSuccEmb.trans (czK2FngStabOne_sigma i k hki) =
      (czK2FngStabOne_tau i k hki).trans Fin.castSuccEmb := by
    refine Function.Embedding.ext fun p => ?_
    fin_cases p <;> rfl
  have h : indexMap (R := R) (Fin.castSuccEmb.trans (czK2FngStabOne_sigma i k hki)) g =
      indexMap ((czK2FngStabOne_tau i k hki).trans Fin.castSuccEmb) g := by
    rw [he]
  rw [indexMap_trans, indexMap_trans] at h
  exact h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_stab

theorem czK2FngGtOne_sigma_padCol2 (i k : Fin 3) (hki : k ≠ i) (a b : R) :
    indexMap (czK2FngStabOne_sigma i k hki)
        (padCol (Pi.single 0 a + Pi.single 1 b : Fin 2 → R)) =
      padCol (Pi.single i a + Pi.single k b) := by
  rw [padCol_add, padCol_add, map_mul, padCol_single, padCol_single, padCol_single,
    padCol_single, indexMap_x, indexMap_x]
  all_goals rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_padCol2

theorem czK2FngGtOne_sigma_padRow2 (i k : Fin 3) (hki : k ≠ i) (a b : R) :
    indexMap (czK2FngStabOne_sigma i k hki)
        (padRow (Pi.single 0 a + Pi.single 1 b : Fin 2 → R)) =
      padRow (Pi.single i a + Pi.single k b) := by
  rw [padRow_add, padRow_add, map_mul, padRow_single, padRow_single, padRow_single,
    padRow_single, indexMap_x, indexMap_x]
  all_goals rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_padRow2

theorem czK2FngGtOne_sigma_padCol1 (i k : Fin 3) (hki : k ≠ i) (a : R) :
    indexMap (czK2FngStabOne_sigma i k hki) (padCol (Pi.single 0 a : Fin 2 → R)) =
      padCol (Pi.single i a) := by
  rw [padCol_single, padCol_single, indexMap_x]
  all_goals rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_padCol1

theorem czK2FngGtOne_sigma_padRow1 (i k : Fin 3) (hki : k ≠ i) (a : R) :
    indexMap (czK2FngStabOne_sigma i k hki) (padRow (Pi.single 0 a : Fin 2 → R)) =
      padRow (Pi.single i a) := by
  rw [padRow_single, padRow_single, indexMap_x]
  all_goals rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_padRow1

theorem czK2FngGtOne_fin2_eta (v : Fin 2 → R) :
    v = Pi.single 0 (v 0) + Pi.single 1 (v 1) :=
  (Finset.univ_sum_single v).symm.trans (Fin.sum_univ_two _)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_fin2_eta

theorem czK2FngGtOne_sigma_padCol (i k : Fin 3) (hki : k ≠ i) (v : Fin 2 → R) :
    indexMap (czK2FngStabOne_sigma i k hki) (padCol v) =
      padCol (Pi.single i (v 0) + Pi.single k (v 1)) := by
  rw [← czK2FngGtOne_sigma_padCol2 i k hki (v 0) (v 1), ← czK2FngGtOne_fin2_eta v]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_padCol

theorem czK2FngGtOne_sigma_padRow (i k : Fin 3) (hki : k ≠ i) (v : Fin 2 → R) :
    indexMap (czK2FngStabOne_sigma i k hki) (padRow v) =
      padRow (Pi.single i (v 0) + Pi.single k (v 1)) := by
  rw [← czK2FngGtOne_sigma_padRow2 i k hki (v 0) (v 1), ← czK2FngGtOne_fin2_eta v]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_padRow

/-- `σ` carries `H X Y X Y H` of `St_3(R)` into `H X Y X Y H` of `St_4(R)`. -/
theorem czK2FngGtOne_sigma_mem (i k : Fin 3) (hki : k ≠ i) {y : St (2 + 1) R}
    (hy : SurjStabLengthMem y) :
    SurjStabLengthMem (indexMap (czK2FngStabOne_sigma i k hki) y) := by
  obtain ⟨g₁, g₂, v, w, c, w', rfl⟩ := hy
  rw [map_mul, map_mul, map_mul, map_mul, map_mul, czK2FngGtOne_sigma_stab,
    czK2FngGtOne_sigma_stab, czK2FngGtOne_sigma_padCol, czK2FngGtOne_sigma_padRow,
    czK2FngGtOne_sigma_padCol, czK2FngGtOne_sigma_padRow]
  exact ⟨_, _, _, _, _, _, rfl⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_mem

/-- Any two indices of `Fin 3` miss a third one. -/
theorem czK2FngGtOne_exists_third : ∀ i k : Fin 3, ∃ j : Fin 3, j ≠ i ∧ j ≠ k := by
  decide +kernel

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_exists_third

/-- The index map `σ` never hits `j.castSucc` when `j ∉ {i, k}`. -/
theorem czK2FngGtOne_sigmaFun_ne : ∀ i k j : Fin 3, j ≠ i → j ≠ k →
    ∀ p : Fin (2 + 1), czK2FngStabOne_sigmaFun i k p ≠ j.castSucc := by
  decide +kernel

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigmaFun_ne

/-- **Support of `σ`.**  If `j ∉ {i, k}`, then `σ(St_3(R)) ≤ czStabGen_off R j.castSucc`. -/
theorem czK2FngGtOne_sigma_mem_off (i k : Fin 3) (hki : k ≠ i) {j : Fin 3} (hji : j ≠ i)
    (hjk : j ≠ k) (g : St (2 + 1) R) :
    indexMap (czK2FngStabOne_sigma i k hki) g ∈ czStabGen_off R j.castSucc := by
  have hgen : ∀ p : Fin (2 + 1), czK2FngStabOne_sigma i k hki p ≠ j.castSucc :=
    czK2FngGtOne_sigmaFun_ne i k j hji hjk
  have htop : (⊤ : Subgroup (St (2 + 1) R)) ≤
      (czStabGen_off R j.castSucc).comap (indexMap (czK2FngStabOne_sigma i k hki)) := by
    rw [← PresentedGroup.closure_range_of, Subgroup.closure_le]
    rintro _ ⟨⟨p, q, hpq, a⟩, rfl⟩
    change indexMap (czK2FngStabOne_sigma i k hki) (x p q hpq a) ∈ czStabGen_off R j.castSucc
    rw [indexMap_x]
    exact Subgroup.subset_closure ⟨_, _, _, a, hgen p, hgen q, rfl⟩
  exact htop (Subgroup.mem_top g)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_sigma_mem_off

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
