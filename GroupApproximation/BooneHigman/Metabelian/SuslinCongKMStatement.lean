import GroupApproximation.BooneHigman.Metabelian.SuslinCongKMConj
import GroupApproximation.BooneHigman.Metabelian.SuslinCongDecideStatement
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.FractionRing
import GroupApproximation.Meta.AxiomGuard

/-!
# Krstić–McCool residual, part 2: reducing `suslinCongDecide_KMStatement` to a statement about
the subgroup generated by the `K[X]`-conjugates of upper unitriangular matrices

Lane `bh-met-92s`.

Let `R = A_𝔪`, `K = Frac R`, `ι : R[X] → K[X]`.  Call `σ ∈ GL₂(R[X])` **`K[X]`-parabolic** if
`ι σ = P E₁₂(β) P⁻¹` for some `P ∈ GL₂(K[X])`, `β ∈ K[X]` (`suslinCongKM_ellSet R`).  Part 1
(`suslinCongKM_unip_conj`) shows: every unipotent `1 + N`, `N² = 0`, of `GL₂(R[X])` is
`K[X]`-parabolic.  Hence `U₂(R[X]) ≤ ⟨K[X]-parabolic elements⟩` (`suslinCongKM_unipGen_le`), so

  `suslinCongKM_EllStatement A 𝔪 → suslinCongDecide_KMStatement A 𝔪`
  (`suslinCongKM_kmStatement_of_ell`, for a domain `A`).

**LOUD status of the residual `suslinCongKM_EllStatement`.**
* It is logically STRONGER than `suslinCongDecide_KMStatement` (its subgroup contains `U₂`), and
  strictly smaller in proof content (the unipotent classification is proved here).
* It is NOT proved here.  Its expected truth rests on the Krstić–McCool tree mechanism: every
  `K[X]`-parabolic element fixes a vertex (`P Λ_{deg β}`) of the Nagao/Bruhat–Tits tree `T` of
  `SL₂(K[X])` over `K((1/X))`, so the subgroup lies in the kernel of `Γ → π₁(Γ \ T)`
  (`Γ = SL₂(R[X])`), where `h_{q,k}` should survive.  This is exactly the step that is not
  verified; the specialization from `p ∈ ℤ` to `q = t^M` in a DVR remains unverified.
* Sanity (Python, not Lean): the normal form `h_{q,1} = w_q E₂₁(-q³ - q⁴X) E₁₂(f)`,
  `f = q⁻¹X² - q⁻²X + q⁻³`, `w_q = !![0, -q⁻³; q³, 0]`; `tr h_{q,k} = 2 + q² X^{2k} ≠ 2`, so
  `h_{q,k}` is itself not `K[X]`-parabolic.

Endpoints: `suslinCongKM_km_charPPoly_one`, `suslinCongKM_not_vacIncl_charPPoly_one`,
`suslinCongKM_not_vacGlobal`.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

open Polynomial

/-- Unipotents map to unipotents under ring homomorphisms. -/
theorem suslinCongKM_map_unipSet {S T : Type*} [CommRing S] [CommRing T] (f : S →+* T)
    {σ : (Matrix (Fin 2) (Fin 2) S)ˣ} (hσ : σ ∈ suslinCongDecide_unipSet S) :
    elementaryMatrixUnitMap (ι := Fin 2) f σ ∈ suslinCongDecide_unipSet T := by
  obtain ⟨N, hN, hval⟩ := hσ
  refine ⟨f.mapMatrix N, ?_, ?_⟩
  · have h0 := map_mul (f.mapMatrix : Matrix (Fin 2) (Fin 2) S →+* Matrix (Fin 2) (Fin 2) T) N N
    rw [hN, map_zero] at h0
    exact h0.symm
  · change f.mapMatrix (σ : Matrix (Fin 2) (Fin 2) S) = 1 + f.mapMatrix N
    rw [hval, map_add, map_one]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_map_unipSet

/-- The `K[X]`-parabolic elements of `GL₂(R[X])`, `K = Frac R`. -/
def suslinCongKM_ellSet (R : Type*) [CommRing R] :
    Set (Matrix (Fin 2) (Fin 2) R[X])ˣ :=
  {σ | ∃ P : (Matrix (Fin 2) (Fin 2) (FractionRing R)[X])ˣ, ∃ β : (FractionRing R)[X],
    P * elementaryUnit (0 : Fin 2) 1 (by decide) β * P⁻¹ =
      elementaryMatrixUnitMap (ι := Fin 2) (mapRingHom (algebraMap R (FractionRing R))) σ}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_ellSet

/-- Every unipotent of `GL₂(R[X])` is `K[X]`-parabolic (`R` a domain). -/
theorem suslinCongKM_unipSet_subset (R : Type*) [CommRing R] [IsDomain R] :
    suslinCongDecide_unipSet R[X] ⊆ suslinCongKM_ellSet R := by
  intro σ hσ
  obtain ⟨P, β, hP⟩ := suslinCongKM_unip_conj _
    (suslinCongKM_map_unipSet (mapRingHom (algebraMap R (FractionRing R))) hσ)
  exact ⟨P, β, hP⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_unipSet_subset

/-- `U₂(R[X]) ≤ ⟨K[X]-parabolic elements⟩`. -/
theorem suslinCongKM_unipGen_le (R : Type*) [CommRing R] [IsDomain R] :
    suslinCongDecide_unipGen R[X] ≤ Subgroup.closure (suslinCongKM_ellSet R) :=
  Subgroup.closure_mono (suslinCongKM_unipSet_subset R)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_unipGen_le

/-- **The residual** (NOT proved; logically STRONGER than `suslinCongDecide_KMStatement`, see the
module docstring): for every `N` there are `q ∈ 𝔪^N` and `k ≠ 0` such that `h_{q,k}` is not a
product of `K[X]`-parabolic elements of `GL₂(A_𝔪[X])`. -/
def suslinCongKM_EllStatement (A : Type*) [CommRing A] (𝔪 : Ideal A) [𝔪.IsPrime] : Prop :=
  ∀ N : ℕ, ∃ q ∈ 𝔪 ^ N, ∃ k : ℕ, k ≠ 0 ∧
    elementaryMatrixUnitMap (ι := Fin 2)
        (Polynomial.mapRingHom (algebraMap A (Localization.AtPrime 𝔪)))
        (suslinCongDecide_km q k) ∉
      Subgroup.closure (suslinCongKM_ellSet (Localization.AtPrime 𝔪))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_EllStatement

/-- **The reduction**: the residual implies the isolated Krstić–McCool non-membership. -/
theorem suslinCongKM_kmStatement_of_ell {A : Type*} [CommRing A] [IsDomain A] (𝔪 : Ideal A)
    [𝔪.IsPrime] (h : suslinCongKM_EllStatement A 𝔪) : suslinCongDecide_KMStatement A 𝔪 := by
  haveI : IsDomain (Localization.AtPrime 𝔪) :=
    IsLocalization.isDomain_of_local_atPrime inferInstance
  intro N
  obtain ⟨q, hq, k, hk, hnot⟩ := h N
  exact ⟨q, hq, k, hk, fun hmem ↦ hnot (suslinCongKM_unipGen_le _ hmem)⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_kmStatement_of_ell

/-- `𝔽_p[t]`: the residual gives `suslinCongDecide_KMStatement`. -/
theorem suslinCongKM_km_charPPoly_one (p : ℕ) [Fact p.Prime] (𝔪 : Ideal (Chain.CharPPoly p 1))
    [𝔪.IsPrime] (h : suslinCongKM_EllStatement (Chain.CharPPoly p 1) 𝔪) :
    suslinCongDecide_KMStatement (Chain.CharPPoly p 1) 𝔪 :=
  suslinCongKM_kmStatement_of_ell 𝔪 h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_km_charPPoly_one

/-- `𝔽_p[t]`: the residual refutes `SuslinCongVacIncl`. -/
theorem suslinCongKM_not_vacIncl_charPPoly_one (p : ℕ) [Fact p.Prime]
    (𝔪 : Ideal (Chain.CharPPoly p 1)) (h𝔪 : 𝔪.IsMaximal)
    (h : suslinCongKM_EllStatement (Chain.CharPPoly p 1) 𝔪) :
    ¬ SuslinCongVacIncl (Chain.CharPPoly p 1) :=
  suslinCongDecide_not_vacIncl_charPPoly_one p 𝔪 h𝔪 (suslinCongKM_km_charPPoly_one p 𝔪 h)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_not_vacIncl_charPPoly_one

/-- `𝔽₂[t]`: the residual refutes `SuslinCongVacGlobalStatement`. -/
theorem suslinCongKM_not_vacGlobal (𝔪 : Ideal (Chain.CharPPoly 2 1)) (h𝔪 : 𝔪.IsMaximal)
    (h : suslinCongKM_EllStatement (Chain.CharPPoly 2 1) 𝔪) : ¬ SuslinCongVacGlobalStatement :=
  suslinCongDecide_not_vacGlobal_of_km 𝔪 h𝔪 (suslinCongKM_km_charPPoly_one 2 𝔪 h)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinCongKM_not_vacGlobal

end Absorption
end Metabelian
end BooneHigman
end GroupApproximation
