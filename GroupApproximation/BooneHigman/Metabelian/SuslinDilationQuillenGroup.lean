import GroupApproximation.BooneHigman.Metabelian.SuslinLocalHorrocksStatement
import GroupApproximation.BooneHigman.Metabelian.SuslinNormalEndpoint
import GroupApproximation.Meta.AxiomGuard

/-!
# Suslin dilation route, part 1: the local Quillen matrices form a subgroup

Lane `bh-met-68c`.  For `τ ∈ GL_N(A[X])` recall the Quillen set
`Q(τ) = {a ∈ A : τ(X + aY) τ(X)⁻¹ ∈ E_N(A[X][Y])}` (`SuslinLocalGlobalQuillen`,
`SuslinLocalGlobalQuillen.lean`), an ideal of `A`.

Using **Suslin's normality theorem** (`suslinNormal_conj_mem`, `SuslinNormalEndpoint.lean`:
`E_N(B)` is normal in `GL_N(B)` for every commutative ring `B` and `N ≥ 3`), applied to
`B = A[X][Y]`:

* `a ∈ Q(τ₁)`, `a ∈ Q(τ₂)` imply `a ∈ Q(τ₁ τ₂)`, since
  `(τ₁τ₂)(X + aY) (τ₁τ₂)(X)⁻¹ = [τ₁(X + aY) τ₁(X)⁻¹] · τ₁(X) [τ₂(X + aY) τ₂(X)⁻¹] τ₁(X)⁻¹`;
* `a ∈ Q(τ)` implies `a ∈ Q(τ⁻¹)`, since
  `τ(X + aY)⁻¹ τ(X) = τ(X + aY)⁻¹ [τ(X + aY) τ(X)⁻¹]⁻¹ τ(X + aY)`;
* `a ∈ Q(1)` for every `a`.

Hence, for a prime ideal `𝔭` of `A`, the matrices `τ` with `Q(τ) ⊄ 𝔭` form a subgroup of
`GL_N(A[X])` (`suslinDilationQuillenSubgroup`): for products use `ab ∉ 𝔭` and the ideal
property of `Q`.  This is the group-theoretic half of the Quillen–Suslin local-global
(dilation) principle: it lets a local Quillen element be produced factor by factor.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

variable {A : Type*} [CommRing A] {N : ℕ}

/-- `a ∈ Q(1)` for every `a`. -/
theorem suslinDilation_quillen_one (a : A) :
    SuslinLocalGlobalQuillen (1 : Matrix.GeneralLinearGroup (Fin N) (Polynomial A)) a := by
  unfold SuslinLocalGlobalQuillen
  simp only [map_one, inv_one, mul_one]
  exact one_mem _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilation_quillen_one

/-- **Products** (normality of `E_N`, `N ≥ 3`): `Q(τ₁) ∩ Q(τ₂) ⊆ Q(τ₁ τ₂)`. -/
theorem suslinDilation_quillen_mul (hN : 2 < N)
    {τ₁ τ₂ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A)} {a : A}
    (h₁ : SuslinLocalGlobalQuillen τ₁ a) (h₂ : SuslinLocalGlobalQuillen τ₂ a) :
    SuslinLocalGlobalQuillen (τ₁ * τ₂) a := by
  unfold SuslinLocalGlobalQuillen at h₁ h₂ ⊢
  have hc := suslinNormal_conj_mem hN h₂
    (elementaryMatrixUnitMap (ι := Fin N)
      (Polynomial.C : Polynomial A →+* Polynomial (Polynomial A)) τ₁)
  have h := mul_mem h₁ hc
  rw [map_mul, map_mul, mul_inv_rev]
  simpa only [mul_assoc, inv_mul_cancel_left] using h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilation_quillen_mul

/-- **Inverses** (normality of `E_N`, `N ≥ 3`): `Q(τ) ⊆ Q(τ⁻¹)`. -/
theorem suslinDilation_quillen_inv (hN : 2 < N)
    {τ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A)} {a : A}
    (h : SuslinLocalGlobalQuillen τ a) : SuslinLocalGlobalQuillen τ⁻¹ a := by
  unfold SuslinLocalGlobalQuillen at h ⊢
  have hc := suslinNormal_conj_mem hN (inv_mem h)
    (elementaryMatrixUnitMap (ι := Fin N) (suslinLocalGlobalShift a) τ)⁻¹
  simpa only [map_inv, mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one] using hc

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilation_quillen_inv

/-- **The local Quillen subgroup** at a prime `𝔭`: all `τ ∈ GL_N(A[X])` having some
`a ∉ 𝔭` with `τ(X + aY) τ(X)⁻¹ ∈ E_N(A[X][Y])`.  A subgroup for `N ≥ 3`. -/
def suslinDilationQuillenSubgroup (hN : 2 < N) (𝔭 : Ideal A) (h𝔭 : 𝔭.IsPrime) :
    Subgroup (Matrix.GeneralLinearGroup (Fin N) (Polynomial A)) where
  carrier := {τ | ∃ a ∉ 𝔭, SuslinLocalGlobalQuillen τ a}
  one_mem' := ⟨1, (Ideal.ne_top_iff_one 𝔭).1 h𝔭.ne_top, suslinDilation_quillen_one 1⟩
  mul_mem' := fun {σ τ} hσ hτ ↦ by
    obtain ⟨b, hb, hqσ⟩ := hσ
    obtain ⟨c, hc, hqτ⟩ := hτ
    refine ⟨b * c, fun hbc ↦ (h𝔭.mem_or_mem hbc).elim hb hc, ?_⟩
    have hσ' : SuslinLocalGlobalQuillen σ (b * c) := by
      rw [mul_comm]
      exact suslinLocalGlobalQuillen_mul σ c hqσ
    exact suslinDilation_quillen_mul hN hσ' (suslinLocalGlobalQuillen_mul τ b hqτ)
  inv_mem' := fun {τ} hτ ↦ by
    obtain ⟨a, ha, hq⟩ := hτ
    exact ⟨a, ha, suslinDilation_quillen_inv hN hq⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilationQuillenSubgroup

theorem suslinDilation_mem_quillenSubgroup_iff (hN : 2 < N) {𝔭 : Ideal A} (h𝔭 : 𝔭.IsPrime)
    {τ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A)} :
    τ ∈ suslinDilationQuillenSubgroup hN 𝔭 h𝔭 ↔ ∃ a ∉ 𝔭, SuslinLocalGlobalQuillen τ a :=
  Iff.rfl

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilation_mem_quillenSubgroup_iff

/-- Every matrix in the subgroup generated by local Quillen matrices at `𝔭` is itself a
local Quillen matrix at `𝔭`. -/
theorem suslinDilation_quillen_of_mem_closure (hN : 2 < N) {𝔭 : Ideal A} (h𝔭 : 𝔭.IsPrime)
    {τ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A)}
    (hτ : τ ∈ Subgroup.closure
      {σ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A) |
        ∃ a ∉ 𝔭, SuslinLocalGlobalQuillen σ a}) :
    ∃ a ∉ 𝔭, SuslinLocalGlobalQuillen τ a :=
  (suslinDilation_mem_quillenSubgroup_iff hN h𝔭).1
    ((Subgroup.closure_le (suslinDilationQuillenSubgroup hN 𝔭 h𝔭)).2
      (fun _ hσ ↦ (suslinDilation_mem_quillenSubgroup_iff hN h𝔭).2 hσ) hτ)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilation_quillen_of_mem_closure

end Absorption
end Metabelian
end BooneHigman
end GroupApproximation
