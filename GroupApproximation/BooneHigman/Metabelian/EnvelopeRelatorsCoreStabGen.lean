import GroupApproximation.BooneHigman.Metabelian.EnvelopeRelatorsCoreStabLeaf
import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVSwapGenMove
import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVGenInduct
import GroupApproximation.Meta.AxiomGuard

/-!
# The pointwise stabilizer of `cone [x₀]` is generated by avoiding swaps

`rnCore_mem_of_fix`: if `G` contains every cone swap of two nonempty words not extending `[x₀]`
(`rnCoreSwapHyp G x₀`), then `G` contains every element of `V_X` fixing `cone [x₀]` pointwise.

This is `swapGen_mem_of_coneSwap_mem` run inside the stabilizer, at a depth `N ≥ 1`: every swap
used there exchanges a moved word, or its target, with a word that is neither empty nor inside
`cone [x₀]` (`rnCore_moved_avoid`, `rnCore_target_avoid`, `rnCore_target_ne_nil`).
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

open Trees

variable {X : Type*}

/-- An element fixing `cone [x₀]` pointwise never carries a cone outside `cone [x₀]` onto the
whole Cantor set. -/
theorem rnCore_target_ne_nil {x₀ : X} {f : Equiv.Perm (Cantor X)} (hfix : MapsCone f [x₀] [x₀])
    {w v : List X} (hv : MapsCone f w v) (hw : w ≠ []) (hwx : ¬ [x₀] <+: w) : v ≠ [] := by
  rintro rfl
  have key : prepend w (prepend [x₀] fun _ => x₀) = prepend [x₀] fun _ => x₀ :=
    f.injective (by rw [hv, hfix, prepend_nil])
  have h1 := isStreamPrefix_prepend w (prepend [x₀] fun _ => x₀)
  rw [key] at h1
  exact (prefix_or_prefix_of_isStreamPrefix h1 (isStreamPrefix_prepend [x₀] _)).elim
    (rnCore_not_prefix_root hw hwx) hwx

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCore_target_ne_nil

/-- **Base case** in the stabilizer. -/
theorem rnCore_mem_base [Finite X] [Nontrivial X] {G : Subgroup (Equiv.Perm (Cantor X))}
    {x₀ : X} (hG : rnCoreSwapHyp G x₀) {N : ℕ} (hN : 1 ≤ N) {f : Equiv.Perm (Cantor X)}
    (hfix : MapsCone f [x₀] [x₀])
    (hf : ∀ w : List X, w.length = N → ∃ v, MapsCone f w v ∧ v.length ≤ N) : f ∈ G := by
  have hinv := swapGen_inv_ge hf
  have hleaf : f⁻¹ ∈ G := rnCore_leaf hG N hN f⁻¹ hfix.inv fun u hu => by
    obtain ⟨v, hv, -⟩ := hinv u hu
    exact ⟨v, hv, swapGen_length_eq_of_le hinv hu hv⟩
  have h2 := G.inv_mem hleaf
  rwa [inv_inv] at h2

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCore_mem_base

/-- **Inductive step** in the stabilizer, on the bound `N + B` for the target lengths. -/
theorem rnCore_mem_step [Finite X] [Nontrivial X] {G : Subgroup (Equiv.Perm (Cantor X))}
    {x₀ : X} (hG : rnCoreSwapHyp G x₀) {N : ℕ} (hN : 1 ≤ N) (B : ℕ)
    (ih : ∀ f : Equiv.Perm (Cantor X), MapsCone f [x₀] [x₀] →
      (∀ w : List X, w.length = N → ∃ v, MapsCone f w v ∧ v.length ≤ N + B) → f ∈ G) :
    ∀ f : Equiv.Perm (Cantor X), MapsCone f [x₀] [x₀] →
      (∀ w : List X, w.length = N → ∃ v, MapsCone f w v ∧ v.length ≤ N + (B + 1)) → f ∈ G := by
  suffices H : ∀ (n : ℕ) (f : Equiv.Perm (Cantor X)), MapsCone f [x₀] [x₀] →
      (∀ w : List X, w.length = N → ∃ v, MapsCone f w v ∧ v.length ≤ N + (B + 1)) →
      {u : List X | u.length = N ∧ ∃ v, MapsCone f u v ∧ v.length = N + B + 1}.ncard = n →
      f ∈ G from
    fun f hfix hf => H _ f hfix hf rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ihn =>
    intro f hfix hf hn
    rcases Set.eq_empty_or_nonempty
      {u : List X | u.length = N ∧ ∃ v, MapsCone f u v ∧ v.length = N + B + 1} with hA | hA
    · refine ih f hfix fun w hw => ?_
      obtain ⟨v, hv, hvl⟩ := hf w hw
      refine ⟨v, hv, ?_⟩
      by_contra hlt
      exact Set.eq_empty_iff_forall_notMem.mp hA w ⟨hw, v, hv, by omega⟩
    obtain ⟨w₀, hw₀, q, hq, hqN⟩ := hA
    obtain ⟨q', x, rfl, hq'N⟩ := vgen_split_last hqN
    have hshort : ∃ wp p, wp.length = N ∧ MapsCone f wp p ∧ p.length < N := by
      by_contra hno
      have hge : ∀ w : List X, w.length = N → ∃ v, MapsCone f w v ∧ N ≤ v.length :=
        fun w hw => by
          obtain ⟨v, hv, -⟩ := hf w hw
          refine ⟨v, hv, ?_⟩
          by_contra hlt
          exact hno ⟨w, v, hw, hv, by omega⟩
      have hl := swapGen_length_eq_of_le hge hw₀ hq
      omega
    obtain ⟨wp, p, hwp, hp, hpN⟩ := hshort
    obtain ⟨hpq, hqp⟩ := swapGen_move_incomparable hp hpN hwp hq hw₀ hq'N
    have hwpx : ¬ [x₀] <+: wp := rnCore_moved_avoid hfix fun h => by
      have hl := congrArg List.length (MapsCone.unique hp h)
      omega
    have hwp0 : wp ≠ [] := List.ne_nil_of_length_pos (by omega)
    have hpx : ¬ [x₀] <+: p := rnCore_target_avoid hfix hp hwpx
    have hp0 : p ≠ [] := rnCore_target_ne_nil hfix hp hwp0 hwpx
    have hw₀x : ¬ [x₀] <+: w₀ := rnCore_moved_avoid hfix fun h => by
      have hl := congrArg List.length (MapsCone.unique hq h)
      rw [List.length_append, List.length_singleton] at hl
      omega
    have hqx : ¬ [x₀] <+: q' := fun h =>
      rnCore_target_avoid hfix hq hw₀x (h.trans (List.prefix_append q' [x]))
    have hq0 : q' ≠ [] := List.ne_nil_of_length_pos (by omega)
    have hfix' : MapsCone (coneSwap p q' hpq hqp * f) [x₀] [x₀] :=
      hfix.comp (rnCore_swap_fix hpq hqp hp0 hpx hq0 hqx)
    have hf' : ∀ w : List X, w.length = N →
        ∃ v, MapsCone (coneSwap p q' hpq hqp * f) w v ∧ v.length ≤ N + (B + 1) := by
      intro u hu
      obtain ⟨t, ht, htN⟩ := hf u hu
      obtain ⟨t', ht', hor⟩ :=
        swapGen_move hp hpN hwp hq hw₀ hq'N hpq hqp hu ht (by omega)
      refine ⟨t', ht', ?_⟩
      rcases hor with hl | ⟨htt, -⟩
      · omega
      · rw [htt]
        exact htN
    have hsub : {u : List X | u.length = N ∧
          ∃ v, MapsCone (coneSwap p q' hpq hqp * f) u v ∧ v.length = N + B + 1} ⊆
        {u : List X | u.length = N ∧ ∃ v, MapsCone f u v ∧ v.length = N + B + 1} := by
      rintro u ⟨hu, v, hv, hvN⟩
      obtain ⟨t, ht, htN⟩ := hf u hu
      obtain ⟨t', ht', hor⟩ :=
        swapGen_move hp hpN hwp hq hw₀ hq'N hpq hqp hu ht (by omega)
      rw [MapsCone.unique hv ht'] at hvN
      rcases hor with hl | ⟨htt, -⟩
      · omega
      · rw [htt] at hvN
        exact ⟨hu, t, ht, hvN⟩
    have hnot : w₀ ∉ {u : List X | u.length = N ∧
        ∃ v, MapsCone (coneSwap p q' hpq hqp * f) u v ∧ v.length = N + B + 1} := by
      rintro ⟨-, v, hv, hvN⟩
      obtain ⟨t', ht', hor⟩ :=
        swapGen_move hp hpN hwp hq hw₀ hq'N hpq hqp hw₀ hq (by omega)
      rw [MapsCone.unique hv ht'] at hvN
      rcases hor with hl | ⟨-, hno⟩
      · omega
      · exact hno (List.prefix_append q' [x])
    have hssub := (Set.ssubset_iff_of_subset hsub).mpr ⟨w₀, ⟨hw₀, q' ++ [x], hq, hqN⟩, hnot⟩
    have hlt := Set.ncard_lt_ncard hssub ((finite_words_length_eq N).subset fun u hu => hu.1)
    have hmem := ihn _ (by rw [← hn]; exact hlt) _ hfix' hf' rfl
    have hfeq : f = coneSwap p q' hpq hqp * (coneSwap p q' hpq hqp * f) := by
      rw [← mul_assoc, coneSwap_mul_self, one_mul]
    rw [hfeq]
    exact G.mul_mem (hG p q' hpq hqp hp0 hpx hq0 hqx) hmem

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCore_mem_step

/-- Induction on the bound `N + B` for the target lengths, inside the stabilizer. -/
theorem rnCore_mem_of_bound [Finite X] [Nontrivial X] {G : Subgroup (Equiv.Perm (Cantor X))}
    {x₀ : X} (hG : rnCoreSwapHyp G x₀) {N : ℕ} (hN : 1 ≤ N) (B : ℕ) :
    ∀ f : Equiv.Perm (Cantor X), MapsCone f [x₀] [x₀] →
      (∀ w : List X, w.length = N → ∃ v, MapsCone f w v ∧ v.length ≤ N + B) → f ∈ G := by
  induction B with
  | zero =>
    exact fun f hfix hf => rnCore_mem_base hG hN hfix fun w hw =>
      (hf w hw).imp fun v hv => ⟨hv.1, by have hv2 := hv.2; omega⟩
  | succ B ih => exact rnCore_mem_step hG hN B ih

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCore_mem_of_bound

/-- **The stabilizer of `cone [x₀]` in `V_X` is generated by avoiding swaps.** -/
theorem rnCore_mem_of_fix [Finite X] [Nontrivial X] {G : Subgroup (Equiv.Perm (Cantor X))}
    {x₀ : X} (hG : rnCoreSwapHyp G x₀) {f : Equiv.Perm (Cantor X)} (hf : f ∈ higmanThompsonV X)
    (hfix : MapsCone f [x₀] [x₀]) : f ∈ G := by
  obtain ⟨N, hN⟩ := mem_higmanThompsonV.mp hf
  have hN1 : HasDepth f (N + 1) := hN.mono (by omega)
  obtain ⟨M, hM⟩ :=
    ((finite_words_length_eq (N + 1)).image fun w : List X => (coneTarget f w).length).bddAbove
  refine rnCore_mem_of_bound hG (N := N + 1) (by omega) (M - (N + 1)) f hfix fun w hw => ?_
  obtain ⟨v, hv⟩ := hN1 w hw
  have hvt : coneTarget f w = v := MapsCone.unique (mapsCone_coneTarget ⟨v, hv⟩) hv
  have hle : (coneTarget f w).length ≤ M := hM ⟨w, hw, rfl⟩
  rw [hvt] at hle
  exact ⟨v, hv, by omega⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCore_mem_of_fix

end GroupApproximation.BooneHigman.Metabelian.Envelope
