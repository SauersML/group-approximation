import GroupApproximation.BooneHigman.SteinbergBasic.Naturality
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.RowColumn.StabAction
import Mathlib.GroupTheory.Commutator.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# The parabolic part of van der Kallen's action

Lane `bh-met-50`.  Fix a ring `R`, a rank `n` and an auxiliary type `X`.  Set
`VdKΩ n R X = (Fin n → R) × St_n(R) × X`.  This is the free left `P̃`-set built on `X`, where
`P̃ = R^n ⋊ St_n(R)` is the parabolic subgroup of `St_{n+1}(R)` generated by `stab St_n(R)`
and the column roots `x_{i,last}`.

* `vdkAct X : St_n(R) →* Perm (VdKΩ n R X)` sends `s` to `(v, g, ξ) ↦ (M_s v, s g, ξ)`, where
  `M_s = projectionMatrix s`.
* `vdkCol X i a` is the column translation `(v, g, ξ) ↦ (v + a e_i, g, ξ)`.
* The Steinberg relators that use only column roots and roots of `St_n(R)` hold unconditionally:
  `vdkCol_add`, `vdkCol_mul_comm`, `vdkCol_mul_act_comm` (pattern `x_{i,last}` against `x_{kl}`
  with `l ≠ i`) and `vdkAct_col_commutator` (`⁅x_{ij}(a), x_{j,last}(b)⁆ = x_{i,last}(ab)`).
* `vdkAct_eq_one_of_fix`: `vdkAct` acts freely, so it separates the base point `(0, 1, ξ₀)`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
  (projectionMatrix projectionMatrix_mul projectionMatrix_one projectionMatrix_x)
open scoped commutatorElement Matrix

/-- The underlying set of van der Kallen's action: the free `P̃`-set on `X`. -/
abbrev VdKΩ (n : ℕ) (R : Type*) [Ring R] (X : Type*) : Type _ := (Fin n → R) × St n R × X

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.VdKΩ

variable {R : Type*} [Ring R] {n : ℕ}

/-- Applying an elementary matrix to a column vector. -/
theorem vdkMulVec_elementary (i j : Fin n) (a : R) (v : Fin n → R) :
    (1 + Matrix.single i j a) *ᵥ v = v + Pi.single i (a * v j) := by
  rw [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.single_mulVec]
  rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkMulVec_elementary

/-- A commutator from a twisted commutation rule. -/
theorem vdk_commutatorElement_of_mul_eq {G : Type*} [Group G] {g h k : G}
    (H : g * h = k * h * g) : ⁅g, h⁆ = k := by
  rw [commutatorElement_def, H, mul_inv_cancel_right, mul_inv_cancel_right]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdk_commutatorElement_of_mul_eq

variable (X : Type*)

/-- The permutation of `VdKΩ n R X` given by `s ∈ St_n(R)`. -/
def vdkActPerm (s : St n R) : Equiv.Perm (VdKΩ n R X) where
  toFun w := (projectionMatrix s *ᵥ w.1, s * w.2.1, w.2.2)
  invFun w := (projectionMatrix s⁻¹ *ᵥ w.1, s⁻¹ * w.2.1, w.2.2)
  left_inv w := by
    have h : projectionMatrix s⁻¹ * projectionMatrix s = 1 := by
      rw [← projectionMatrix_mul, inv_mul_cancel, projectionMatrix_one]
    simp only [Matrix.mulVec_mulVec, h, Matrix.one_mulVec, inv_mul_cancel_left, Prod.mk.eta]
  right_inv w := by
    have h : projectionMatrix s * projectionMatrix s⁻¹ = 1 := by
      rw [← projectionMatrix_mul, mul_inv_cancel, projectionMatrix_one]
    simp only [Matrix.mulVec_mulVec, h, Matrix.one_mulVec, mul_inv_cancel_left, Prod.mk.eta]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkActPerm

theorem vdkActPerm_apply (s : St n R) (w : VdKΩ n R X) :
    vdkActPerm X s w = (projectionMatrix s *ᵥ w.1, s * w.2.1, w.2.2) :=
  rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkActPerm_apply

/-- The left action of `St_n(R)` on the free `P̃`-set. -/
def vdkAct : St n R →* Equiv.Perm (VdKΩ n R X) where
  toFun := vdkActPerm X
  map_one' := Equiv.ext fun w => by
    simp only [vdkActPerm_apply, projectionMatrix_one, Matrix.one_mulVec, one_mul,
      Equiv.Perm.one_apply, Prod.mk.eta]
  map_mul' s t := Equiv.ext fun w => by
    simp only [vdkActPerm_apply, Equiv.Perm.mul_apply, projectionMatrix_mul,
      Matrix.mulVec_mulVec, mul_assoc]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkAct

theorem vdkAct_apply (s : St n R) (w : VdKΩ n R X) :
    vdkAct X s w = (projectionMatrix s *ᵥ w.1, s * w.2.1, w.2.2) :=
  rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkAct_apply

/-- The column root `x_{i,last}(a)`, acting by translation of the vector coordinate. -/
def vdkCol (i : Fin n) (a : R) : Equiv.Perm (VdKΩ n R X) where
  toFun w := (w.1 + Pi.single i a, w.2)
  invFun w := (w.1 - Pi.single i a, w.2)
  left_inv w := by simp only [add_sub_cancel_right, Prod.mk.eta]
  right_inv w := by simp only [sub_add_cancel, Prod.mk.eta]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkCol

theorem vdkCol_apply (i : Fin n) (a : R) (w : VdKΩ n R X) :
    vdkCol X i a w = (w.1 + Pi.single i a, w.2) :=
  rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkCol_apply

/-- Additivity of the column roots. -/
theorem vdkCol_add (i : Fin n) (a b : R) :
    vdkCol X i a * vdkCol X i b = vdkCol X i (a + b) := by
  refine Equiv.ext fun w => Prod.ext ?_ rfl
  simp only [Equiv.Perm.mul_apply, vdkCol_apply, Pi.single_add]
  abel

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkCol_add

/-- Column roots commute with each other. -/
theorem vdkCol_mul_comm (i k : Fin n) (a b : R) :
    vdkCol X i a * vdkCol X k b = vdkCol X k b * vdkCol X i a := by
  refine Equiv.ext fun w => Prod.ext ?_ rfl
  simp only [Equiv.Perm.mul_apply, vdkCol_apply]
  abel

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkCol_mul_comm

/-- A column root `x_{i,last}` commutes with a root `x_{kl}` of `St_n(R)` when `l ≠ i`. -/
theorem vdkCol_mul_act_comm (i k l : Fin n) (hkl : k ≠ l) (hli : l ≠ i) (a b : R) :
    vdkCol X i a * vdkAct X (x k l hkl b) = vdkAct X (x k l hkl b) * vdkCol X i a := by
  refine Equiv.ext fun w => Prod.ext ?_ rfl
  simp only [Equiv.Perm.mul_apply, vdkAct_apply, vdkCol_apply, projectionMatrix_x,
    vdkMulVec_elementary, Pi.add_apply, Pi.single_eq_of_ne hli, add_zero]
  abel

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkCol_mul_act_comm

/-- The adjacent relator `⁅x_{ij}(a), x_{j,last}(b)⁆ = x_{i,last}(ab)` on the free `P̃`-set. -/
theorem vdkAct_col_commutator (i j : Fin n) (hij : i ≠ j) (a b : R) :
    ⁅vdkAct X (x i j hij a), vdkCol X j b⁆ = vdkCol X i (a * b) := by
  refine vdk_commutatorElement_of_mul_eq (Equiv.ext fun w => Prod.ext ?_ rfl)
  simp only [Equiv.Perm.mul_apply, vdkAct_apply, vdkCol_apply, projectionMatrix_x,
    vdkMulVec_elementary, Pi.add_apply, Pi.single_eq_same, mul_add, Pi.single_add]
  abel

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkAct_col_commutator

/-- `vdkAct` is free: an element fixing a base point `(0, 1, ξ₀)` is trivial. -/
theorem vdkAct_eq_one_of_fix (x₀ : X) (u : St n R)
    (h : vdkAct X u ((0 : Fin n → R), (1 : St n R), x₀) =
      ((0 : Fin n → R), (1 : St n R), x₀)) :
    u = 1 := by
  have h2 : u * 1 = 1 := congrArg (fun w : VdKΩ n R X => w.2.1) h
  rwa [mul_one] at h2

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkAct_eq_one_of_fix

end GroupApproximation.BooneHigman.Metabelian.ElemFP
