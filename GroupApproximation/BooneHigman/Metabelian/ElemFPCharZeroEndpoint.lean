import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroRingKernel
import GroupApproximation.BooneHigman.Metabelian.ChainCharZero
import GroupApproximation.BooneHigman.SteinbergBasic.Kernel
import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.RingTheory.Localization.Away.AdjoinRoot
import GroupApproximation.Meta.AxiomGuard

/-!
# Reduction of `CharZeroElementaryFPStatement` to finite generation of `K₂`

Lane `bh-met-17`.  Let `S = ℤ[1/m][t_0, ..., t_{k-1}]` (`Chain.SIntPoly m k`).

* `S` is a finitely presented `ℤ`-algebra, so `St_{d+5}(S)` is finitely presented
  (`steinbergSIntPoly_isFinitelyPresented`, via `ElemFPCharZeroRingKernel`).
* If `K₂(N, S) = ker(St_N(S) → E_N(S))` is a finitely generated group, it is finitely normally
  generated (`k2_isFinitelyNormallyGenerated_of_fg`).  Then `E_N(S)` is finitely presented.

**Warning.** `K₂(N, S) = ⊥` is FALSE in general.  For example `K₂(ℤ) = ℤ/2` is generated by the
Steinberg symbol `{-1,-1}`.  Only finite generation is isolated here.

The remaining gap `CharZeroElementaryFPGapStatement` has two parts:
1. `CharZeroStableK2FGStatement`: `K₂(N, S)` is finitely generated for `N ≥ k + 4` and `N ≥ 5`.
2. `CharZeroRankFourFPStatement`: the one case `N = 4` (forcing `k = 0`), where the rank-5
   Krstić–McCool presentation is not available.  This case is `E_4(ℤ[1/m])`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

/-- `St_{d+5}(ℤ[1/m][t_0, ..., t_{k-1}])` is finitely presented. -/
theorem steinbergSIntPoly_isFinitelyPresented (m k d : ℕ) :
    Group.IsFinitelyPresented (SteinbergGroup (Fin (d + 5)) (Chain.SIntPoly m k)) := by
  haveI : Algebra.FinitePresentation ℤ (Localization.Away (m : ℤ)) :=
    IsLocalization.Away.finitePresentation (m : ℤ)
  exact steinberg_isFinitelyPresented_of_finitePresentation
    (Algebra.FinitePresentation.mvPolynomial (R := ℤ) (A := Localization.Away (m : ℤ))
      (ι := Fin k)) d

/-- A finitely generated `K₂` is finitely normally generated. -/
theorem k2_isFinitelyNormallyGenerated_of_fg {I R : Type*} [Fintype I] [DecidableEq I] [Ring R]
    (h : Group.FG (SteinbergBasic.K2 I R)) :
    (SteinbergBasic.K2 I R).IsFinitelyNormallyGenerated := by
  haveI : Group.FG (SteinbergBasic.K2 I R) := h
  exact Subgroup.IsFinitelyNormallyGenerated.of_FG _

/-- If `St_I(R)` is finitely presented and `K₂(I, R)` is finitely generated, then `E_I(R)` is
finitely presented. -/
theorem isFinitelyPresented_elementaryGroup_of_fg {I R : Type*} [Fintype I] [DecidableEq I]
    [Ring R] [Group.IsFinitelyPresented (SteinbergGroup I R)]
    (h : Group.FG (SteinbergBasic.K2 I R)) :
    Group.IsFinitelyPresented (elementaryGroup I R) :=
  SteinbergBasic.isFinitelyPresented_elementaryGroup_of (k2_isFinitelyNormallyGenerated_of_fg h)

/-- **Gap, part 1 (stable `K₂` is finitely generated).**  `K₂(N, ℤ[1/m][t_0, ..., t_{k-1}])` is a
finitely generated group for `N ≥ k + 4` and `N ≥ 5`.

*Truth.*  If `m = 0`, the ring is zero and `St_N` is trivial.  Otherwise `S` is regular noetherian
of Krull dimension `≤ k + 1`, so Bass gives `sr(S) ≤ k + 2`.  Injective and surjective stability
(van der Kallen, Suslin–Tulenbaev) hold for `N ≥ sr(S) + 2`, which covers `N ≥ k + 4`.  So
`K₂(N, S) ≅ K₂(S)`.  By homotopy invariance (Quillen), `K₂(S) = K₂(ℤ[1/m])`.  This group is finite:
`K₂(ℤ) = ℤ/2`, and in the localization sequence `K₂(ℤ) → K₂(ℤ[1/m]) → ⊕_{p ∣ m} F_p^×` both outer
terms are finite.

*Strictly smaller.*  The `_of_` endpoint below proves the rest: finite presentation of `St_N(S)`,
the step from finite generation to normal generation, and the quotient step to `E_N(S)`. -/
def CharZeroStableK2FGStatement : Prop :=
  ∀ m k N : ℕ, k + 4 ≤ N → 5 ≤ N →
    Group.FG (SteinbergBasic.K2 (Fin N) (Chain.SIntPoly m k))

/-- **Gap, part 2 (the rank-4 corner).**  `E_4(ℤ[1/m])` is finitely presented.

*Truth.*  If `m = 0`, the ring is zero and the group is trivial.  Otherwise `ℤ[1/m]` is a
Dedekind ring of arithmetic type, so `E_4 = SL_4` (Bass–Milnor–Serre).  `SL_4(ℤ[1/m])` is an
`S`-arithmetic group, and these are finitely presented (Borel–Serre).

*Strictly smaller.*  This is the single instance `k = 0, N = 4` of
`Chain.CharZeroElementaryFPStatement`.  It is logically weaker than that statement. -/
def CharZeroRankFourFPStatement : Prop :=
  ∀ m : ℕ, Group.IsFinitelyPresented (elementaryGroup (Fin 4) (Chain.SIntPoly m 0))

/-- The remaining gap for `Chain.CharZeroElementaryFPStatement`. -/
def CharZeroElementaryFPGapStatement : Prop :=
  CharZeroStableK2FGStatement ∧ CharZeroRankFourFPStatement

/-- **Endpoint (lane `bh-met-17`).**  The gap implies `Chain.CharZeroElementaryFPStatement`. -/
theorem charZeroElementaryFP_of_gap (h : CharZeroElementaryFPGapStatement) :
    Chain.CharZeroElementaryFPStatement := by
  intro m k N hN
  by_cases h5 : N < 5
  · obtain rfl : N = 4 := by omega
    obtain rfl : k = 0 := by omega
    exact h.2 m
  · obtain ⟨d, rfl⟩ : ∃ d, N = d + 5 := ⟨N - 5, by omega⟩
    haveI := steinbergSIntPoly_isFinitelyPresented m k d
    exact isFinitelyPresented_elementaryGroup_of_fg (h.1 m k (d + 5) hN (by omega))

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.steinbergSIntPoly_isFinitelyPresented
#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_isFinitelyNormallyGenerated_of_fg
#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.isFinitelyPresented_elementaryGroup_of_fg
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroStableK2FGStatement
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroRankFourFPStatement
#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroElementaryFPGapStatement
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroElementaryFP_of_gap
