import GroupApproximation.BooneHigman.Metabelian.EnvelopeCantorAction
import GroupApproximation.BooneHigman.V.Group
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Group.Submonoid.Operations
import Mathlib.Data.Set.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# The Röver–Nekrashevych group of a group of tree automorphisms

For a finite alphabet `X` and `H ≤ TreeAut X`, the Röver–Nekrashevych group `V_X(H)` is the
subgroup of `Equiv.Perm (Cantor X)` generated by the Higman–Thompson group `V_X`
(`higmanThompsonV X`) together with all *localised* elements of `H`: `h` acting inside the
cone of a word `w`, `w y ↦ w (h · y)`, and trivially elsewhere (`localize w (cantorHom h)`).

For self-similar `H` this is the usual Röver–Nekrashevych group: its elements are the
homeomorphisms that cut the Cantor set into finitely many cones, act by elements of `H` on
each cone and then move the cones by a prefix substitution.

Route.  `localize_nil` identifies localisation at the empty word with the identity, so every
`cantorHom h` lies in `V_X(H)`; `rnEmbedding` is the corestriction of `cantorHom` and
`rnEmbedding_injective` is `cantorHom_injective`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

open Trees

noncomputable section

variable {X : Type*}

theorem localize_nil (g : Equiv.Perm (Cantor X)) : localize ([] : List X) g = g :=
  Equiv.ext fun x => by
    simpa only [prepend_nil] using localize_apply_prepend ([] : List X) g x

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.localize_nil

variable [Finite X]

/-- Generators of the Röver–Nekrashevych group: `V_X` and the localised elements of `H`. -/
def rnGenerators (H : Subgroup (TreeAut X)) : Set (Equiv.Perm (Cantor X)) :=
  (higmanThompsonV X : Set (Equiv.Perm (Cantor X))) ∪
    {f | ∃ w : List X, ∃ h ∈ H, f = localize w (cantorHom h)}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnGenerators

variable (X) in
/-- The Röver–Nekrashevych group `V_X(H)`. -/
def roverNekrashevych (H : Subgroup (TreeAut X)) : Subgroup (Equiv.Perm (Cantor X)) :=
  Subgroup.closure (rnGenerators H)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.roverNekrashevych

theorem higmanThompsonV_le_rn (H : Subgroup (TreeAut X)) :
    higmanThompsonV X ≤ roverNekrashevych X H := fun _ hf =>
  Subgroup.subset_closure (Set.mem_union_left _ hf)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanThompsonV_le_rn

theorem localize_mem_roverNekrashevych (H : Subgroup (TreeAut X)) (w : List X) {h : TreeAut X}
    (hh : h ∈ H) : localize w (cantorHom h) ∈ roverNekrashevych X H :=
  Subgroup.subset_closure (Set.mem_union_right _ ⟨w, h, hh, rfl⟩)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.localize_mem_roverNekrashevych

theorem cantorHom_mem_roverNekrashevych (H : Subgroup (TreeAut X)) {h : TreeAut X}
    (hh : h ∈ H) : cantorHom h ∈ roverNekrashevych X H := by
  have hmem := localize_mem_roverNekrashevych H [] hh
  rwa [localize_nil] at hmem

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.cantorHom_mem_roverNekrashevych

/-- `H` inside its Röver–Nekrashevych group. -/
def rnEmbedding (H : Subgroup (TreeAut X)) : ↥H →* ↥(roverNekrashevych X H) :=
  (cantorHom.comp H.subtype).codRestrict (roverNekrashevych X H) fun h =>
    cantorHom_mem_roverNekrashevych H h.2

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnEmbedding

theorem rnEmbedding_injective [Nonempty X] (H : Subgroup (TreeAut X)) :
    Function.Injective (rnEmbedding H) :=
  (MonoidHom.injective_codRestrict _ _ _).2 (cantorHom_injective.comp Subtype.val_injective)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnEmbedding_injective

end

end GroupApproximation.BooneHigman.Metabelian.Envelope
