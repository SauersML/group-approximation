import GroupApproximation.BooneHigman.Metabelian.SuslinZLocalTransvection
import GroupApproximation.Meta.AxiomGuard

/-!
# Monic witnesses with transvection multipliers

Lane `bh-met-93u`.  For a commutative ring `R`, let `G(R) ≤ GL₂(R)` be generated by `E₂(R)` and
the orthogonal rank-one transvections `1 + v wᵀ` (`wᵀ v = 0`) of `suslinZLocal_TSet`
(`suslinZLocal_Group`).  Every `g ∈ G(R)` has `diag(g, 1) ∈ E₃(R)` (`suslinZLocal_stab_mem`)
and `det g = 1` (`suslinZLocal_det_eq_one`).

A **transvection monic witness** for `σ ∈ GL₂(A[X])` (`suslinZLocal_Witness`) is the lane-93p
witness `suslinZHalf_Witness` with `ε, ε' ∈ G(A[X])` in place of `E₂(A[X])`.  The group
`G` is given by explicit generators.  It is NOT the group of all `E₃`-stable multipliers.
* Every elementary monic witness is a transvection monic witness
  (`suslinZLocal_witness_of_halfWitness`).
* Every `σ ∈ G(A[X])` has one (`suslinZLocal_witness_of_mem`, with `φ = id`, `ε = σ⁻¹`,
  `ε' = 1`).  So does every Cohn matrix (`suslinZLocal_cohn_witness`).
* **Global.**  With `SL₃(A) = E₃(A)`, a witness gives `diag(σ, 1) ∈ E₃(A[X])`
  (`suslinZLocal_stab_of_globalWitness`).  The proof is the lane-93p proof.
* **Local.**  Over a LOCAL ring `B`, a witness gives `diag(σ, 1) ∈ E₃(B[X])` with no hypothesis
  on `SL₃(B)` (`suslinZLocal_stab_of_localWitness`).  The proof uses the unconditional local
  monic theorem `suslinMonicLocal_good`.
-/

set_option linter.unusedSimpArgs false

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

open Polynomial

/-- The subgroup of `GL₂(R)` generated by `E₂(R)` and the orthogonal rank-one transvections. -/
def suslinZLocal_Group (R : Type*) [CommRing R] : Subgroup (Matrix (Fin 2) (Fin 2) R)ˣ :=
  elementaryGroup (Fin 2) R ⊔ Subgroup.closure (suslinZLocal_TSet R)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_Group

/-- `G(R)` stabilizes into `E₃(R)`. -/
theorem suslinZLocal_group_le_comap (R : Type*) [CommRing R] :
    suslinZLocal_Group R ≤
      (elementaryGroup (Fin 2 ⊕ Unit) R).comap (stabilizeUnit (R := R) (κ := Unit)) := by
  refine sup_le ?_ ?_
  · intro x hx
    exact Subgroup.mem_comap.mpr
      (elementaryStabilization (ι := Fin 2) (κ := Unit) (R := R) ⟨x, hx⟩).2
  · rw [Subgroup.closure_le]
    intro x hx
    exact Subgroup.mem_comap.mpr (suslinZLocal_stab_mem_of_mem_TSet hx)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_group_le_comap

/-- Every `g ∈ G(R)` has `diag(g, 1) ∈ E₃(R)`. -/
theorem suslinZLocal_stab_mem {R : Type*} [CommRing R] {g : (Matrix (Fin 2) (Fin 2) R)ˣ}
    (hg : g ∈ suslinZLocal_Group R) :
    stabilizeUnit (R := R) (κ := Unit) g ∈ elementaryGroup (Fin 2 ⊕ Unit) R :=
  Subgroup.mem_comap.mp (suslinZLocal_group_le_comap R hg)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_stab_mem

/-- Every `g ∈ G(R)` has determinant `1`. -/
theorem suslinZLocal_det_eq_one {R : Type*} [CommRing R] {g : (Matrix (Fin 2) (Fin 2) R)ˣ}
    (hg : g ∈ suslinZLocal_Group R) : Matrix.det (g : Matrix (Fin 2) (Fin 2) R) = 1 := by
  have h := suslin_det_eq_one_of_mem_elementaryGroup (suslinZLocal_stab_mem hg)
  rw [stabilizeUnit_val, Matrix.det_fromBlocks_zero₂₁, Matrix.det_one, mul_one] at h
  exact h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_det_eq_one

/-- **A transvection monic witness** for `σ ∈ GL₂(A[X])`: an automorphism `φ` of `A[X]` and
`ε, ε' ∈ G(A[X])` such that `φ(ε σ ε')₀₀` has unit leading coefficient. -/
def suslinZLocal_Witness {A : Type*} [CommRing A] (σ : (Matrix (Fin 2) (Fin 2) A[X])ˣ) : Prop :=
  ∃ φ : A[X] ≃+* A[X], ∃ ε ∈ suslinZLocal_Group A[X], ∃ ε' ∈ suslinZLocal_Group A[X],
    IsUnit (((suslinZHalf_twist φ ε ε' σ : (Matrix (Fin 2) (Fin 2) A[X])ˣ) :
      Matrix (Fin 2) (Fin 2) A[X]) 0 0).leadingCoeff

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_Witness

/-- An elementary monic witness is a transvection monic witness. -/
theorem suslinZLocal_witness_of_halfWitness {A : Type*} [CommRing A]
    {σ : (Matrix (Fin 2) (Fin 2) A[X])ˣ} (h : suslinZHalf_Witness σ) :
    suslinZLocal_Witness σ := by
  obtain ⟨φ, ε, hε, ε', hε', hlc⟩ := h
  exact ⟨φ, ε, Subgroup.mem_sup_left hε, ε', Subgroup.mem_sup_left hε', hlc⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_witness_of_halfWitness

/-- Every `σ ∈ G(A[X])` has a transvection monic witness: `φ = id`, `ε = σ⁻¹`, `ε' = 1`. -/
theorem suslinZLocal_witness_of_mem {A : Type*} [CommRing A]
    {σ : (Matrix (Fin 2) (Fin 2) A[X])ˣ} (hσ : σ ∈ suslinZLocal_Group A[X]) :
    suslinZLocal_Witness σ := by
  refine ⟨RingEquiv.refl _, σ⁻¹, inv_mem hσ, 1, one_mem _, ?_⟩
  rw [suslinZHalf_twist, inv_mul_cancel, one_mul, map_one, Units.val_one, Matrix.one_apply_eq,
    Polynomial.leadingCoeff_one]
  exact isUnit_one

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_witness_of_mem

/-- Every Cohn matrix `[[1 + ab, a²], [-b², 1 - ab]]` over `A[X]` has a transvection monic
witness.  This covers the lane-93p counterexample to one-sided elementary witnesses. -/
theorem suslinZLocal_cohn_witness {A : Type*} [CommRing A] (a b : A[X])
    (σ : (Matrix (Fin 2) (Fin 2) A[X])ˣ)
    (hσ : (σ : Matrix (Fin 2) (Fin 2) A[X]) = !![1 + a * b, a ^ 2; -b ^ 2, 1 - a * b]) :
    suslinZLocal_Witness σ :=
  suslinZLocal_witness_of_mem
    (Subgroup.mem_sup_right (Subgroup.subset_closure (suslinZLocal_cohn_mem_TSet a b σ hσ)))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinZLocal_cohn_witness

end Absorption
end Metabelian
end BooneHigman
end GroupApproximation
