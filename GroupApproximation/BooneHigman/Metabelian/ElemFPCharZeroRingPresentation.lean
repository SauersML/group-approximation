import Mathlib.Algebra.FreeAlgebra
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Ideal.Span
import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.RingTheory.TwoSidedIdeal.Kernel
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import GroupApproximation.Meta.AxiomGuard

/-!
# Finitely presented commutative rings as quotients of free associative rings

Lane `bh-met-17`.  This is the generic form of `ElemFPPolyPresentation` (lane `bh-met-06`), which
treats only `F_p[s_1, ..., s_k]`.

Let `f : ℤ[X_0, ..., X_{n-1}] → A` be a surjective ring map whose kernel is the ideal generated by
a finite set `G`.  The map `freeToPoly n : ℤ⟨Fin n⟩ → ℤ[Fin n]` sends `ι i` to `X i` and is
surjective (`freeToPoly_surjective`).  Pick a lift `liftRel n g` of each `g ∈ G`.  The finite set

  `polyRelators n G = {lift g | g ∈ G} ∪ {ι i ι j - ι j ι i}`

generates the kernel of `f ∘ freeToPoly n` as a two-sided ideal (`ker_comp_freeToPoly`, in
`ElemFPCharZeroRingKernel`).  The proof is the one of `bh-met-06`.
In `Q = ℤ⟨Fin n⟩ / (polyRelators)` the generators commute, so every element of `Q` is central
(`relQuotMk_mem_center`).  The universal property of `MvPolynomial` then gives
`polyLiftC : ℤ[Fin n] → Z(Q)`, and this map kills `G`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

noncomputable section

variable (n : ℕ)

/-- `ℤ⟨Fin n⟩ → ℤ[Fin n]`, sending `ι i` to the variable `X i`. -/
def freeToPoly : FreeAlgebra ℤ (Fin n) →+* MvPolynomial (Fin n) ℤ :=
  (FreeAlgebra.lift ℤ fun i => (MvPolynomial.X i : MvPolynomial (Fin n) ℤ)).toRingHom

theorem freeToPoly_ι (i : Fin n) :
    freeToPoly n (FreeAlgebra.ι ℤ i) = MvPolynomial.X i :=
  FreeAlgebra.lift_ι_apply (fun i => (MvPolynomial.X i : MvPolynomial (Fin n) ℤ)) i

theorem freeToPoly_surjective : Function.Surjective (freeToPoly n) := by
  intro P
  induction P using MvPolynomial.induction_on with
  | C a =>
      refine ⟨(a : FreeAlgebra ℤ (Fin n)), ?_⟩
      rw [map_intCast]
      exact (eq_intCast (MvPolynomial.C : ℤ →+* MvPolynomial (Fin n) ℤ) a).symm
  | add P Q hP hQ =>
      obtain ⟨x, hx⟩ := hP
      obtain ⟨y, hy⟩ := hQ
      exact ⟨x + y, by rw [map_add, hx, hy]⟩
  | mul_X P i hP =>
      obtain ⟨x, hx⟩ := hP
      exact ⟨x * FreeAlgebra.ι ℤ i, by rw [map_mul, hx, freeToPoly_ι]⟩

/-- A chosen preimage under `freeToPoly n`. -/
def liftRel (g : MvPolynomial (Fin n) ℤ) : FreeAlgebra ℤ (Fin n) :=
  Function.surjInv (freeToPoly_surjective n) g

theorem freeToPoly_liftRel (g : MvPolynomial (Fin n) ℤ) : freeToPoly n (liftRel n g) = g :=
  Function.surjInv_eq (freeToPoly_surjective n) g

variable (G : Set (MvPolynomial (Fin n) ℤ))

/-- The relators: lifts of the elements of `G`, and the commutators of the generators. -/
def polyRelators : Set (FreeAlgebra ℤ (Fin n)) :=
  liftRel n '' G ∪ Set.range fun ij : Fin n × Fin n =>
    FreeAlgebra.ι ℤ ij.1 * FreeAlgebra.ι ℤ ij.2 - FreeAlgebra.ι ℤ ij.2 * FreeAlgebra.ι ℤ ij.1

theorem polyRelators_finite (hG : G.Finite) : (polyRelators n G).Finite :=
  (hG.image _).union (Set.finite_range _)

theorem liftRel_mem_polyRelators {g : MvPolynomial (Fin n) ℤ} (hg : g ∈ G) :
    liftRel n g ∈ polyRelators n G :=
  Set.mem_union_left _ ⟨g, hg, rfl⟩

theorem comm_mem_polyRelators (i j : Fin n) :
    FreeAlgebra.ι ℤ i * FreeAlgebra.ι ℤ j - FreeAlgebra.ι ℤ j * FreeAlgebra.ι ℤ i ∈
      polyRelators n G :=
  Set.mem_union_right _ ⟨(i, j), rfl⟩

/-- The quotient ring `ℤ⟨Fin n⟩ / (polyRelators n G)`. -/
abbrev RelQuot : Type := (TwoSidedIdeal.span (polyRelators n G)).ringCon.Quotient

/-- The quotient map onto `RelQuot n G`. -/
def relQuotMk : FreeAlgebra ℤ (Fin n) →+* RelQuot n G :=
  (TwoSidedIdeal.span (polyRelators n G)).ringCon.mk'

theorem ker_relQuotMk :
    TwoSidedIdeal.ker (relQuotMk n G) = TwoSidedIdeal.span (polyRelators n G) :=
  TwoSidedIdeal.ker_ringCon_mk' _

theorem relQuotMk_surjective : Function.Surjective (relQuotMk n G) :=
  RingCon.mk'_surjective _

theorem relQuotMk_relator {z : FreeAlgebra ℤ (Fin n)} (hz : z ∈ polyRelators n G) :
    relQuotMk n G z = 0 := by
  have h : z ∈ TwoSidedIdeal.ker (relQuotMk n G) := by
    rw [ker_relQuotMk]
    exact TwoSidedIdeal.subset_span hz
  rwa [TwoSidedIdeal.mem_ker] at h

theorem relQuotMk_ι_comm (i j : Fin n) :
    Commute (relQuotMk n G (FreeAlgebra.ι ℤ i)) (relQuotMk n G (FreeAlgebra.ι ℤ j)) := by
  have h := relQuotMk_relator n G (comm_mem_polyRelators n G i j)
  rw [map_sub, map_mul, map_mul, sub_eq_zero] at h
  exact h

/-- All elements of the quotient commute. -/
theorem relQuotMk_commute (x y : FreeAlgebra ℤ (Fin n)) :
    Commute (relQuotMk n G x) (relQuotMk n G y) := by
  induction x using FreeAlgebra.induction with
  | grade0 r =>
      rw [eq_intCast (algebraMap ℤ (FreeAlgebra ℤ (Fin n))) r, map_intCast]
      exact Int.cast_commute r _
  | grade1 i =>
      induction y using FreeAlgebra.induction with
      | grade0 r =>
          rw [eq_intCast (algebraMap ℤ (FreeAlgebra ℤ (Fin n))) r, map_intCast]
          exact (Int.cast_commute r _).symm
      | grade1 j => exact relQuotMk_ι_comm n G i j
      | mul a b ha hb =>
          rw [map_mul]
          exact ha.mul_right hb
      | add a b ha hb =>
          rw [map_add]
          exact ha.add_right hb
  | mul a b ha hb =>
      rw [map_mul]
      exact ha.mul_left hb
  | add a b ha hb =>
      rw [map_add]
      exact ha.add_left hb

theorem relQuotMk_mem_center (x : FreeAlgebra ℤ (Fin n)) :
    relQuotMk n G x ∈ Subring.center (RelQuot n G) := by
  rw [Subring.mem_center_iff]
  intro g
  obtain ⟨y, rfl⟩ := relQuotMk_surjective n G g
  exact relQuotMk_commute n G y x

end

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

