import GroupApproximation.BooneHigman.Metabelian.EnvelopeRelatorsFiniteCommute
import Mathlib.Data.Finite.Prod
import GroupApproximation.Meta.AxiomGuard

/-!
# Finite relators of the normal form: reduction to finite `V_X`-data

`RNNormalFormRelatorsStatement` asks for a finite `R ⊆ nfRelators H x₀` whose normal closure
contains the kernel of `rnFreeHom H x₀`.  This module proves it from
`RNRelatorsFiniteCoreStatement`.  The core statement asks for the same kernel bound, with two
changes:
* commutation relators `[nfL h, nfV f]` may use every `h ∈ H`, provided `f` ranges over the
  subgroup generated by a finite set `F` of elements of `V_X` fixing `cone [x₀]`;
* disjoint-cone relators `[nfL h, nfV e * nfL k * (nfV e)⁻¹]` may use every `h, k ∈ H`,
  provided the pair `(e, w)` ranges over a finite set `E`.

The reduction extracts a finite generating set `S` of `H` from its finite presentation. It
then uses multiplicativity of commutation in the quotient (`rf_commute_closure`) to replace
both infinite families by the finitely many relators with `h, k ∈ S`, `f ∈ F` and `(e, w) ∈ E`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

open Trees

noncomputable section

variable {X : Type*} [Finite X]

/-- Commutation relators `[nfL h, nfV f]` for all `h ∈ H` and all `f ∈ K`. -/
def nfCommRelatorsOn (H : Subgroup (TreeAut X)) (K : Subgroup ↥(higmanThompsonV X)) :
    Set (RNFree X H) :=
  {r | ∃ (h : ↥H) (f : ↥(higmanThompsonV X)), f ∈ K ∧
    r = nfL H h * nfV H f * (nfL H h)⁻¹ * (nfV H f)⁻¹}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfCommRelatorsOn

/-- Disjoint-cone relators for all `h, k ∈ H` and all pairs `(e, w) ∈ E`. -/
def nfDisjRelatorsOn (H : Subgroup (TreeAut X)) (E : Set (↥(higmanThompsonV X) × List X)) :
    Set (RNFree X H) :=
  {r | ∃ p ∈ E, ∃ h k : ↥H,
    r = nfL H h * (nfV H p.1 * nfL H k * (nfV H p.1)⁻¹) * (nfL H h)⁻¹ *
      (nfV H p.1 * nfL H k * (nfV H p.1)⁻¹)⁻¹}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfDisjRelatorsOn

/-- Commutation relators with `h ∈ S` and `f ∈ F`. -/
def nfCommGen (H : Subgroup (TreeAut X)) (S : Set ↥H) (F : Set ↥(higmanThompsonV X)) :
    Set (RNFree X H) :=
  (fun p : ↥H × ↥(higmanThompsonV X) =>
    nfL H p.1 * nfV H p.2 * (nfL H p.1)⁻¹ * (nfV H p.2)⁻¹) '' (S ×ˢ F)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfCommGen

/-- Disjoint-cone relators with `h, k ∈ S` and `(e, w) ∈ E`. -/
def nfDisjGen (H : Subgroup (TreeAut X)) (S : Set ↥H)
    (E : Set (↥(higmanThompsonV X) × List X)) : Set (RNFree X H) :=
  (fun q : (↥H × ↥H) × (↥(higmanThompsonV X) × List X) =>
    nfL H q.1.1 * (nfV H q.2.1 * nfL H q.1.2 * (nfV H q.2.1)⁻¹) * (nfL H q.1.1)⁻¹ *
      (nfV H q.2.1 * nfL H q.1.2 * (nfV H q.2.1)⁻¹)⁻¹) '' ((S ×ˢ S) ×ˢ E)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfDisjGen

theorem nfCommGen_finite (H : Subgroup (TreeAut X)) {S : Set ↥H}
    {F : Set ↥(higmanThompsonV X)} (hS : S.Finite) (hF : F.Finite) :
    (nfCommGen H S F).Finite :=
  (hS.prod hF).image _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfCommGen_finite

theorem nfDisjGen_finite (H : Subgroup (TreeAut X)) {S : Set ↥H}
    {E : Set (↥(higmanThompsonV X) × List X)} (hS : S.Finite) (hE : E.Finite) :
    (nfDisjGen H S E).Finite :=
  ((hS.prod hS).prod hE).image _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfDisjGen_finite

/-- The finite generator relators are normal-form relators. -/
theorem nfFiniteRelators_subset (H : Subgroup (TreeAut X)) (x₀ : X) {R₀ : Set (RNFree X H)}
    {S : Set ↥H} {F : Set ↥(higmanThompsonV X)} {E : Set (↥(higmanThompsonV X) × List X)}
    (hR₀ : R₀ ⊆ nfRelators H x₀)
    (hF : ∀ f ∈ F, ∀ y : Cantor X,
      (f : Equiv.Perm (Cantor X)) (prepend [x₀] y) = prepend [x₀] y)
    (hE : ∀ p ∈ E, MapsCone (p.1 : Equiv.Perm (Cantor X)) [x₀] p.2 ∧ ¬ [x₀] <+: p.2 ∧
      ¬ p.2 <+: [x₀]) :
    R₀ ∪ nfCommGen H S F ∪ nfDisjGen H S E ⊆ nfRelators H x₀ := by
  refine Set.union_subset (Set.union_subset hR₀ ?_) ?_
  · rintro r ⟨⟨s, f⟩, ⟨-, hf⟩, rfl⟩
    exact Set.mem_union_left _
      (Set.mem_union_left _ (Set.mem_union_left _ ⟨s, f, hF f hf, rfl⟩))
  · rintro r ⟨⟨⟨s, t⟩, p⟩, ⟨-, hp⟩, rfl⟩
    obtain ⟨he, hxw, hwx⟩ := hE p hp
    exact Set.mem_union_left _
      (Set.mem_union_left _ (Set.mem_union_right _ ⟨s, t, p.1, p.2, he, hxw, hwx, rfl⟩))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfFiniteRelators_subset

/-- Commutation relators on a generating set of `H` and a generating set `F` give all commutation
relators on `closure F`. -/
theorem nfCommRelatorsOn_subset (H : Subgroup (TreeAut X)) {S : Set ↥H}
    (hS : Subgroup.closure S = ⊤) {F : Set ↥(higmanThompsonV X)} (N : Subgroup (RNFree X H))
    [N.Normal]
    (hgen : ∀ s ∈ S, ∀ f ∈ F, nfL H s * nfV H f * (nfL H s)⁻¹ * (nfV H f)⁻¹ ∈ N) :
    nfCommRelatorsOn H (Subgroup.closure F) ⊆ N := by
  rintro r ⟨h, f, hfK, rfl⟩
  have hc : Commute (rfL H N h) (rfV H N f) :=
    rf_commute_closure (rfL H N) (rfV H N)
      (fun s hs t ht => by
        rw [rfL_apply, rfV_apply]
        exact rf_commute_of_mem (hgen s hs t ht))
      ((Subgroup.eq_top_iff' _).mp hS h) hfK
  rw [rfL_apply, rfV_apply] at hc
  exact rf_mem_of_commute hc

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfCommRelatorsOn_subset

/-- Disjoint-cone relators on a generating set of `H` give them for all `h, k ∈ H`. -/
theorem nfDisjRelatorsOn_subset (H : Subgroup (TreeAut X)) {S : Set ↥H}
    (hS : Subgroup.closure S = ⊤) (E : Set (↥(higmanThompsonV X) × List X))
    (N : Subgroup (RNFree X H)) [N.Normal]
    (hgen : ∀ p ∈ E, ∀ s ∈ S, ∀ t ∈ S,
      nfL H s * (nfV H p.1 * nfL H t * (nfV H p.1)⁻¹) * (nfL H s)⁻¹ *
        (nfV H p.1 * nfL H t * (nfV H p.1)⁻¹)⁻¹ ∈ N) :
    nfDisjRelatorsOn H E ⊆ N := by
  rintro r ⟨p, hp, h, k, rfl⟩
  have hc : Commute (rfL H N h) (rfConjL H N p.1 k) :=
    rf_commute_closure (rfL H N) (rfConjL H N p.1)
      (fun s hs t ht => by
        rw [rfL_apply, rfConjL_apply]
        exact rf_commute_of_mem (hgen p hp s hs t ht))
      ((Subgroup.eq_top_iff' _).mp hS h) ((Subgroup.eq_top_iff' _).mp hS k)
  rw [rfL_apply, rfConjL_apply] at hc
  exact rf_mem_of_commute hc

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.nfDisjRelatorsOn_subset

end

end GroupApproximation.BooneHigman.Metabelian.Envelope
