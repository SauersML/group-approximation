import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVCTauDeepCross
import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVCTauLevelReduce
import GroupApproximation.Meta.AxiomGuard

/-!
# The deep residual of the equal-level hop residual (lane bh-met-77t)

`HigmanVCTauDeepResidualStatement` is `HigmanVCTauLevelResidualStatement` (lane bh-met-77r)
with three more hypotheses: neither Hop D (`higmanVCTauDeep_HopD`, from `A`, nor from `B` read
backwards) nor Hop CD (`higmanVCTauDeep_HopCD`, Hop C with deep legs) applies.
`higmanVCTauDeep_level_of_deep` proves the hop residual from it, and
`higmanVCTauDeep_tau_of_deep` wires it with the lower-level part into `HigmanVCTauStatement`.

**Strength (loud): LOGICALLY EQUIVALENT to `HigmanVCTauLevelResidualStatement` and to
`HigmanVCTauLevelEqStatement`, strictly smaller in proof content**
(`higmanVCTauDeep_residual_iff`, `higmanVCTauDeep_residual_iff_eq`).  It is not a strictly
weaker proposition.

**Truth check** (scratch `SP/bh-met-77t/deep2.py`, on the lane bh-met-77r candidate lists;
the python hops demand at least what the Lean hops demand, so the counts are upper bounds for
the Lean deep residual).  Equal-level hop-residual instances and what is left:
* `d = 2`, words `≤ 4`: 128 instances; Hop D 64, Hop CD 64, left 0.
* `d = 2`, words `≤ 5`: 384 instances; Hop D 192, Hop CD 192, left 0.
* `d = 2`, words `≤ 6`: 896 instances; Hop D 448, Hop CD 448, left 0.
* `d = 2`, words `≤ 7` (candidates regenerated by `SP/bh-met-77t/gen/left.py`, 512832
  equal-level candidates): 1920 instances; Hop D 960, Hop CD 960, left 0.
* `d = 3`, words `≤ 4`: the hop residual is already vacuous.
So the deep residual is **empty on every tested size**.  It is not proved vacuous for all `d`,
`n`: a proof would need a uniform witness construction for every instance that escapes the
earlier hops, which is not available.

Hop D instances look like `A = (0, 1000)`, `s = (100, 110)`: `s` is the child `a = 0` of
`w = (10, 11)`, `w` carries `A` to `B` by a leg, and the sibling `(101, 111)` fixes `A`.  Hop CD
instances look like `A = (0, 1000)`, `s = (100, 111)`, `r = (100, 101)`, `s1 = (101, 111)`,
whose middle leg is Hop D.

**Truth.**  Implied by the hop residual, hence by the tight and comm residuals.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

/-- **Remaining gap (deep residual).**  `HigmanVCTauLevelResidualStatement` restricted to
instances where neither Hop D (from either side) nor Hop CD applies.
**EQUIVALENT** to the hop residual (`higmanVCTauDeep_residual_iff`). -/
def HigmanVCTauDeepResidualStatement : Prop :=
  ∀ d : ℕ, 1 < d → ∀ n : ℕ, higmanVCTauShort_Below d n →
    ∀ (p q x y x' y' : List (Fin d)) (hpq : ¬ p <+: q) (hqp : ¬ q <+: p),
      p.length ≤ 3 → q.length ≤ 3 →
      x.length + y.length = n → x'.length + y'.length ≤ n →
      (x'.length + y'.length = n → higmanVCTauShort_Shrink d n) →
      ¬ (x.length ≤ 3 ∧ y.length ≤ 3 ∧ x'.length ≤ 3 ∧ y'.length ≤ 3) →
      ¬ higmanVCTauShort_OptionA d p q x y hpq hqp →
      ¬ higmanVCTauShort_OptionE d p q x y →
      ¬ higmanVCTauComm_OptionR d p q x y →
      (x'.length + y'.length = n →
        ¬ higmanVCTauComm_FlexA d p q x y hpq hqp ∧ ¬ higmanVCTauComm_FlexB d p q x y x' y' ∧
          ¬ higmanVCTauComm_FlexA d p q x' y' hpq hqp ∧
          ¬ higmanVCTauComm_FlexB d p q x' y' x y) →
      (x'.length + y'.length < n → ¬ higmanVCTauTight_Chain d p q x y x' y') →
      x'.length + y'.length = n →
      ¬ higmanVCTauLevel_HopA d n p q x y x' y' hpq hqp →
      ¬ higmanVCTauLevel_HopA d n p q x' y' x y hpq hqp →
      ¬ higmanVCTauLevel_HopC d n p q x y x' y' →
      ¬ higmanVCTauDeep_HopD d n p q x y x' y' →
      ¬ higmanVCTauDeep_HopD d n p q x' y' x y →
      ¬ higmanVCTauDeep_HopCD d n p q x y x' y' →
      MapsCone (coneSwap p q hpq hqp) x x' → MapsCone (coneSwap p q hpq hqp) y y' →
      ¬ x <+: y → ¬ y <+: x → ¬ x' <+: y' → ¬ y' <+: x' →
      higmanVCTauShort_conjEq d p q x y x' y'

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.HigmanVCTauDeepResidualStatement

/-- **Reduction.**  The deep residual gives the equal-level hop residual. -/
theorem higmanVCTauDeep_level_of_deep (h : HigmanVCTauDeepResidualStatement) :
    HigmanVCTauLevelResidualStatement := by
  intro d hd n hB p q x y x' y' hpq hqp hp hq hA hBn hSh hs hOA hE hR hF hC hn h1 h2 h3 hmx
    hmy hxy hyx hxy' hyx'
  have hS := hSh hn
  by_cases h4 : higmanVCTauDeep_HopD d n p q x y x' y'
  · exact higmanVCTauDeep_hopD_case hd hB hS hp hq h4 hxy hyx hxy' hyx'
  by_cases h5 : higmanVCTauDeep_HopD d n p q x' y' x y
  · exact higmanVCTauComm_flip_eq hp hq
      (higmanVCTauDeep_hopD_case hd hB hS hp hq h5 hxy' hyx' hxy hyx)
  by_cases h6 : higmanVCTauDeep_HopCD d n p q x y x' y'
  · exact higmanVCTauDeep_hopCD_case hd hB hS hpq hqp hp hq h6 hmx hmy hxy hyx hxy' hyx'
  exact h d hd n hB p q x y x' y' hpq hqp hp hq hA hBn hSh hs hOA hE hR hF hC hn h1 h2 h3 h4 h5
    h6 hmx hmy hxy hyx hxy' hyx'

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTauDeep_level_of_deep

/-- The deep residual is a special case of the hop residual. -/
theorem higmanVCTauDeep_deep_of_level (h : HigmanVCTauLevelResidualStatement) :
    HigmanVCTauDeepResidualStatement := by
  intro d hd n hB p q x y x' y' hpq hqp hp hq hA hBn hSh hs hOA hE hR hF hC hn h1 h2 h3 _ _ _
    hmx hmy hxy hyx hxy' hyx'
  exact h d hd n hB p q x y x' y' hpq hqp hp hq hA hBn hSh hs hOA hE hR hF hC hn h1 h2 h3 hmx
    hmy hxy hyx hxy' hyx'

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTauDeep_deep_of_level

/-- **Strength (loud): EQUIVALENT** to the hop residual (smaller proof content only). -/
theorem higmanVCTauDeep_residual_iff :
    HigmanVCTauDeepResidualStatement ↔ HigmanVCTauLevelResidualStatement :=
  ⟨higmanVCTauDeep_level_of_deep, higmanVCTauDeep_deep_of_level⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTauDeep_residual_iff

/-- The deep residual gives the equal-level part of the tight residual. -/
theorem higmanVCTauDeep_eq_of_deep (h : HigmanVCTauDeepResidualStatement) :
    HigmanVCTauLevelEqStatement :=
  higmanVCTauLevel_eq_of_residual (higmanVCTauDeep_level_of_deep h)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTauDeep_eq_of_deep

/-- **Strength (loud): EQUIVALENT** to the equal-level statement (smaller proof content). -/
theorem higmanVCTauDeep_residual_iff_eq :
    HigmanVCTauDeepResidualStatement ↔ HigmanVCTauLevelEqStatement :=
  higmanVCTauDeep_residual_iff.trans higmanVCTauLevel_residual_iff

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTauDeep_residual_iff_eq

/-- **Wire.**  The `τ` half from the deep residual and the lower-level part. -/
theorem higmanVCTauDeep_tau_of_deep (h : HigmanVCTauDeepResidualStatement)
    (hLt : HigmanVCTauLevelLtStatement) : HigmanVCTauStatement :=
  higmanVCTauLevel_tau_of_residual (higmanVCTauDeep_level_of_deep h) hLt

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTauDeep_tau_of_deep

end GroupApproximation.BooneHigman.Metabelian.Envelope
