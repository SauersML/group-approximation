import Mathlib.RingTheory.Finiteness.Nakayama
import Mathlib.RingTheory.Ideal.Span
import Mathlib.GroupTheory.Finiteness
import Mathlib.GroupTheory.Abelianization.Defs
import Mathlib.GroupTheory.Commutator.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# Abstract abelianisation lemmas for the generator-torsion Statement

* `gentorsion_exists_exponent`: a finitely generated abelian group in which every element is a
  square has a positive exponent (Nakayama's lemma over `ℤ` for the ideal `(2)`);
* `gentorsion_transfer`: if the class of `x ∈ V` lies in the subgroup generated by the classes
  of `T`, then `x ∈ closure T ⊔ ⁅V, V⁆` in the ambient group;
* `gentorsion_mem_commutator_subtype`: `⁅V, V⁆` pulled back to the subtype;
* `gentorsion_class_eq_of_conj`: conjugate elements of `V` have one class;
* `gentorsion_class_sq`: if `g = s * b0 * b1` with `s ∈ [V, V]` and `b1` conjugate to `b0`
  inside `V`, then the class of `g` is a square.

Route: `Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul` on `Additive A` with
`I = (2)` and `N = ⊤`; the resulting `r` is odd, hence nonzero, and `r.natAbs` is an exponent.
The other lemmas push through `V.subtype` (`Subgroup.map_closure`,
`Subgroup.map_subtype_commutator`) and use `Abelianization.ker_of`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

/-- A finitely generated abelian group with `A = A ^ 2` has a positive exponent. -/
theorem gentorsion_exists_exponent {A : Type*} [CommGroup A] (hA : Group.FG A)
    (hsq : ∀ a : A, ∃ b : A, b ^ 2 = a) : ∃ m : ℕ, 0 < m ∧ ∀ a : A, a ^ m = 1 := by
  have hfin : Module.Finite ℤ (Additive A) :=
    Module.Finite.iff_addGroup_fg.mpr (GroupFG.iff_add_fg.mp hA)
  have hle : (⊤ : Submodule ℤ (Additive A)) ≤ Ideal.span ({2} : Set ℤ) • ⊤ := by
    intro n _
    obtain ⟨b, hb⟩ := hsq (Additive.toMul n)
    have e : n = Additive.ofMul (b ^ (2 : ℤ)) := by
      rw [zpow_two, ← pow_two, hb, ofMul_toMul]
    rw [e, ofMul_zpow]
    exact Submodule.smul_mem_smul (Ideal.subset_span (Set.mem_singleton 2)) Submodule.mem_top
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul
    (Ideal.span ({2} : Set ℤ)) ⊤ (Module.finite_def.mp hfin) hle
  have hdvd : (2 : ℤ) ∣ r - 1 := Ideal.mem_span_singleton.mp hr1
  have hr0 : r ≠ 0 := by
    rintro rfl
    omega
  refine ⟨r.natAbs, Int.natAbs_pos.mpr hr0, fun a => pow_natAbs_eq_one.mpr ?_⟩
  have h1 : Additive.ofMul (a ^ r) = 0 := by
    rw [ofMul_zpow]
    exact hr _ Submodule.mem_top
  exact ofMul_eq_zero.mp h1

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.gentorsion_exists_exponent

variable {G : Type*} [Group G] {V : Subgroup G}

/-- Membership modulo `[V, V]` transfers from the abelianisation to the ambient group. -/
theorem gentorsion_transfer {T : Set ↥V} {x : ↥V}
    (hx : (Abelianization.of : ↥V →* Abelianization ↥V) x ∈
      Subgroup.closure ((Abelianization.of : ↥V →* Abelianization ↥V) '' T)) :
    (x : G) ∈ Subgroup.closure (Subtype.val '' T) ⊔ ⁅V, V⁆ := by
  rw [← Subgroup.map_closure] at hx
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
  have hc : y⁻¹ * x ∈ commutator ↥V := by
    refine (Abelianization.ker_of ↥V).le (MonoidHom.mem_ker.mpr ?_)
    rw [map_mul, map_inv, hyx, inv_mul_cancel]
  have h1 : (y : G) ∈ Subgroup.closure (Subtype.val '' T) := by
    have e := Subgroup.mem_map_of_mem V.subtype hy
    rw [Subgroup.map_closure] at e
    exact e
  have h2 : ((y⁻¹ * x : ↥V) : G) ∈ ⁅V, V⁆ := by
    have e := Subgroup.mem_map_of_mem V.subtype hc
    rw [Subgroup.map_subtype_commutator] at e
    exact e
  have e : (x : G) = y * ((y⁻¹ * x : ↥V) : G) := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv, mul_inv_cancel_left]
  rw [e]
  exact Subgroup.mul_mem_sup h1 h2

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.gentorsion_transfer

/-- An element of `⁅V, V⁆` lies in `V` and in the commutator subgroup of the subtype. -/
theorem gentorsion_mem_commutator_subtype {s : G} (hs : s ∈ ⁅V, V⁆) :
    ∃ hsV : s ∈ V, (⟨s, hsV⟩ : ↥V) ∈ commutator ↥V := by
  rw [← Subgroup.map_subtype_commutator V] at hs
  obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hs
  exact ⟨y.2, hy⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.gentorsion_mem_commutator_subtype

/-- Elements of `V` conjugate by an element of `V` have the same class. -/
theorem gentorsion_class_eq_of_conj {f a b : G} (hf : f ∈ V) (ha : a ∈ V) (hb : b ∈ V)
    (h : f * a * f⁻¹ = b) :
    (Abelianization.of : ↥V →* Abelianization ↥V) ⟨a, ha⟩ =
      (Abelianization.of : ↥V →* Abelianization ↥V) ⟨b, hb⟩ := by
  have e : (⟨f, hf⟩ : ↥V) * ⟨a, ha⟩ * (⟨f, hf⟩ : ↥V)⁻¹ = ⟨b, hb⟩ := Subtype.ext h
  rw [← e, map_mul, map_mul, map_inv,
    mul_comm ((Abelianization.of : ↥V →* Abelianization ↥V) ⟨f, hf⟩), mul_inv_cancel_right]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.gentorsion_class_eq_of_conj

/-- If `g = s * b0 * b1` with `s ∈ [V, V]` and `t * b1 = b0 * t` inside `V`, the class of `g`
is the square of the class of `b0`. -/
theorem gentorsion_class_sq {s t b0 b1 g : G} (hsV : s ∈ V)
    (hs' : (⟨s, hsV⟩ : ↥V) ∈ commutator ↥V) (ht : t ∈ V) (hb0 : b0 ∈ V) (hb1 : b1 ∈ V)
    (hg : g ∈ V) (hsplit : g = s * b0 * b1) (hconj : t * b1 = b0 * t) :
    ∃ u : Abelianization ↥V, (Abelianization.of : ↥V →* Abelianization ↥V) ⟨g, hg⟩ = u ^ 2 := by
  subst hsplit
  have e : (⟨s * b0 * b1, hg⟩ : ↥V) = ⟨s, hsV⟩ * ⟨b0, hb0⟩ * ⟨b1, hb1⟩ := Subtype.ext rfl
  have hc : (⟨t, ht⟩ : ↥V) * ⟨b1, hb1⟩ = ⟨b0, hb0⟩ * ⟨t, ht⟩ := Subtype.ext hconj
  have h1 := congrArg (Abelianization.of : ↥V →* Abelianization ↥V) hc
  rw [map_mul, map_mul,
    mul_comm ((Abelianization.of : ↥V →* Abelianization ↥V) ⟨b0, hb0⟩)] at h1
  have hb : (Abelianization.of : ↥V →* Abelianization ↥V) ⟨b1, hb1⟩ =
      (Abelianization.of : ↥V →* Abelianization ↥V) ⟨b0, hb0⟩ := mul_left_cancel h1
  have hs1 : (Abelianization.of : ↥V →* Abelianization ↥V) ⟨s, hsV⟩ = 1 :=
    MonoidHom.mem_ker.mp ((Abelianization.ker_of ↥V).ge hs')
  refine ⟨(Abelianization.of : ↥V →* Abelianization ↥V) ⟨b0, hb0⟩, ?_⟩
  rw [e, map_mul, map_mul, hs1, hb, one_mul, pow_two]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.gentorsion_class_sq

end GroupApproximation.BooneHigman.Metabelian.Envelope
