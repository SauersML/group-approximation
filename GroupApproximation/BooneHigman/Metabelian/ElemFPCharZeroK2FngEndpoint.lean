/-!
# Part (i) of `CharZeroK2StabGenFNGSurjStatement` from rank four (lane `bh-met-75`)

Target: (i) `∀ m > 0, K₂(5, ℤ[1/m])` is finitely normally generated in `St_5(ℤ[1/m])`.

**Route.**  One stability step from rank four.
* `czK2Fng_succ_of_le_map` (helper module): `K₂(4) = ⟪s⟫` with `s` finite and
  `K₂(5) ≤ stab K₂(4)` give `K₂(5) = ⟪stab '' s⟫`.  The second input is exactly part (ii) of the
  target statement at `n = 4`.
* `K₂(4, ℤ[1/m])` is finitely normally generated once `E_4(ℤ[1/m])` is finitely presented: the
  source `St_4(ℤ[1/m])` is finitely **generated** (`czK2Fng_steinbergAway_fg`), and the Tietze
  kernel theorem needs only generation of the source (`czK2Fng_ker_of_fg`).
* `E_4(ℤ[1/m])` finitely presented is `CharZeroRankFourFPStatement` (lane `bh-met-17`), stated
  over `Chain.SIntPoly m 0 = ℤ[1/m][∅]`, transported along `MvPolynomial.isEmptyRingEquiv`.

**Isolated gap.**  `CZK2FngRankFourStatement`: `∀ m > 0, K₂(4, ℤ[1/m])` is finitely normally
generated.  Strictly weaker than `CharZeroRankFourFPStatement`: the implication is
`czK2FngRankFour_of_rankFourFP`, and the converse would need `St_4(ℤ[1/m])` finitely presented,
which is not available (the rank-`≥ 5` Krstić–McCool presentation does not apply at rank four).

**LOUD.**  `CZK2FngRankFourStatement` is **not** logically weaker than (i).  The two are
incomparable as stated; (i) follows from it only together with (ii) at `n = 4`
(`czK2Fng_fngFive_of_rankFour`).  Since (ii) is the other conjunct of the target statement, the
gap `CharZeroK2StabGenFNGSurjStatement` reduces to `CZK2FngRankFourStatement ∧ (ii)`
(`czK2Fng_stabGenFNGSurj_of_rankFour`).

**LOUD (false route, recorded again).**  "`K₂(ℤ[1/m])` is generated by the symbols `{u, v}` with
`u, v ∈ {-1} ∪ {p ∣ m}`" is false: for `m = 5`, `K₂(ℤ[1/5]) ≅ ℤ/2 × F₅^×` has order `8`, and the
tame symbol at `5` sends every such symbol into `{±1} ⊂ F₅^× ≅ ℤ/4`.

**No circularity.**  `CharZeroRankFourFPStatement` is an input leaf of lane `bh-met-17`; nothing
in the repository derives it from a `K₂` statement.  The equivalence
`E_5(ℤ[1/m])` f.p. `↔` (i) (`isFinitelyPresented_elementaryGroup_iff`, using `St_5` f.p.) is not
used.

**Truth check.**  `CZK2FngRankFourStatement` is true: `St_4(ℤ[1/m])` is finitely generated (proved
here) and `E_4(ℤ[1/m]) = SL_4(ℤ[1/m])` is finitely presented (Behr; Borel–Serre), so the kernel is
finitely normally generated by `czK2Fng_ker_of_fg`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic

/-- **The isolated gap (lane `bh-met-75`).**  `K₂(4, ℤ[1/m])` is finitely normally generated in
`St_4(ℤ[1/m])` for `m ≥ 1`.  True; strictly weaker than `CharZeroRankFourFPStatement`; **not**
weaker than (i) on its own (see the module docstring). -/
def CZK2FngRankFourStatement : Prop :=
  ∀ m : ℕ, 0 < m → (K2 (Fin 4) (Localization.Away (m : ℤ))).IsFinitelyNormallyGenerated

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CZK2FngRankFourStatement

/-- `E_4(ℤ[1/m][∅])` finitely presented gives `E_4(ℤ[1/m])` finitely presented. -/
theorem czK2Fng_elemFour_fp_of_rankFourFP (h : CharZeroRankFourFPStatement) (m : ℕ) :
    Group.IsFinitelyPresented (elementaryGroup (Fin 4) (Localization.Away (m : ℤ))) := by
  haveI := h m
  let e : Chain.SIntPoly m 0 ≃+* Localization.Away (m : ℤ) :=
    MvPolynomial.isEmptyRingEquiv (Localization.Away (m : ℤ)) (Fin 0)
  exact Group.IsFinitelyPresented.equiv (MulEquiv.ofBijective
    (elementaryGroupMap (ι := Fin 4) e.toRingHom)
    ⟨elementaryGroupMap_injective _ e.injective,
      elementaryGroupMap_surjective_of_surjective _ e.surjective⟩)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_elemFour_fp_of_rankFourFP

/-- **Reduction to the existing rank-four leaf.**  `CharZeroRankFourFPStatement` gives the gap. -/
theorem czK2FngRankFour_of_rankFourFP (h : CharZeroRankFourFPStatement) :
    CZK2FngRankFourStatement := by
  intro m _
  haveI := czK2Fng_elemFour_fp_of_rankFourFP h m
  haveI := czK2Fng_steinbergAway_fg m 4 (by omega)
  exact czK2Fng_k2_of_fg_of_fp

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngRankFour_of_rankFourFP

/-- **Part (i) from rank four.**  The gap and surjective stability at `n = 4` give (i). -/
theorem czK2Fng_fngFive_of_rankFour (h4 : CZK2FngRankFourStatement)
    (hsurj4 : ∀ m : ℕ, 0 < m →
      K2 (Fin (4 + 1)) (Localization.Away (m : ℤ)) ≤
        (K2 (Fin 4) (Localization.Away (m : ℤ))).map (stab 4 (Localization.Away (m : ℤ))))
    (m : ℕ) (hm : 0 < m) :
    (K2 (Fin 5) (Localization.Away (m : ℤ))).IsFinitelyNormallyGenerated :=
  czK2Fng_succ_of_le_map (n := 4) (h4 m hm) (hsurj4 m hm)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_fngFive_of_rankFour

/-- **Endpoint (lane `bh-met-75`).**  The gap and (ii) give `CharZeroK2StabGenFNGSurjStatement`. -/
theorem czK2Fng_stabGenFNGSurj_of_rankFour (h4 : CZK2FngRankFourStatement)
    (hsurj : ∀ m n : ℕ, 0 < m → 4 ≤ n →
      K2 (Fin (n + 1)) (Localization.Away (m : ℤ)) ≤
        (K2 (Fin n) (Localization.Away (m : ℤ))).map (stab n (Localization.Away (m : ℤ)))) :
    CharZeroK2StabGenFNGSurjStatement :=
  ⟨czK2Fng_fngFive_of_rankFour h4 fun m hm ↦ hsurj m 4 hm le_rfl, hsurj⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_stabGenFNGSurj_of_rankFour

/-- The same, from the existing rank-four leaf `CharZeroRankFourFPStatement`. -/
theorem czK2Fng_stabGenFNGSurj_of_rankFourFP (h : CharZeroRankFourFPStatement)
    (hsurj : ∀ m n : ℕ, 0 < m → 4 ≤ n →
      K2 (Fin (n + 1)) (Localization.Away (m : ℤ)) ≤
        (K2 (Fin n) (Localization.Away (m : ℤ))).map (stab n (Localization.Away (m : ℤ)))) :
    CharZeroK2StabGenFNGSurjStatement :=
  czK2Fng_stabGenFNGSurj_of_rankFour (czK2FngRankFour_of_rankFourFP h) hsurj

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_stabGenFNGSurj_of_rankFourFP

/-- With lane `bh-met-54`'s `P Q P` statement for (ii): the rank-four leaf gives
`CharZeroK2PosStabGenStatement`. -/
theorem czK2Fng_charZeroK2PosStabGen_of_rankFourFP_of_conjTriple
    (h : CharZeroRankFourFPStatement) (h' : SurjStabConjTripleStatement) :
    CharZeroK2PosStabGenStatement :=
  charZeroK2PosStabGen_of_fngSurj
    (czK2Fng_stabGenFNGSurj_of_rankFourFP h (charZeroK2SurjStab_of_conjTriple h'))

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_charZeroK2PosStabGen_of_rankFourFP_of_conjTriple

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
