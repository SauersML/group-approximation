import GroupApproximation.BooneHigman.Metabelian.ElemFPBaseFGCzBase
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2FngRank3SecDiv
import GroupApproximation.Meta.AxiomGuard

/-!
# `BaseFG` from a rank-5 relative cokernel statement (lane `bh-met-95c`, part 2)

Target: `CharZeroK2BaseFGStatement` (module `ElemFPCharZeroK2Split`, line 100), i.e.
`K₂(N, ℤ[1/m])` is finitely generated for `N ≥ 5`.

## The residual

`czBaseFGCz_CokerStatement`: take `m > 0` and a prime `p` smaller than every prime factor of `m`.
Then `K₂(5, ℤ[1/(mp)])` is generated by the image of `K₂(5, ℤ[1/m])` together with finitely many
elements of `K₂(5, ℤ[1/(mp)])`.  In other words, the cokernel of
`K₂(5, ℤ[1/m]) → K₂(5, ℤ[1/(mp)])` is finitely generated.

## Proved here

`czBaseFGCz_baseFG_of_coker` derives the target from the residual.  It needs:
* base ring `ℤ[1/1]`: `czBaseFGCz_fg_five_one`, which comes from `P13` and surjective stability;
* strong induction on `n`, splitting off `p = minFac n`, so the side condition always holds;
* `p ∣ c`: then `ℤ[1/c] ≅ ℤ[1/(cp)]` (`czBaseFGCz_fg_of_dvd`);
* ranks `N ≥ 6` (`czBaseFGCz_fg_ge_five`), and `m = 0` (`charZeroK2BaseFG_of_pos`).

## Strength (LOUD)

* `czBaseFGCz_coker_of_baseFG`: the target implies the residual (take `s` to be a finite
  generating set).  So the two are **logically equivalent**.
* `czBaseFGCz_coker_of_step` proves that the existing rank-3 one-prime step
  `czK2FngGtOneRank3_StepStatement` implies the residual, by transporting it to rank 5 with
  `czBaseFGCz_step_succ`.  So the residual lies below the known `Z3`/`Z4` routes.
* The residual is strictly smaller in proof content:
  * it is *relative*, asking only for finitely many generators of a cokernel and nothing about
    `K₂(5, ℤ[1/m])` itself;
  * it lives at rank 5, where normal closure is not needed;
  * it is only asked for primes `p` below all prime factors of `m`.

## Truth check

`K₂(5, ℤ[1/n])` is finite for `n > 0`.  Stability holds at rank 5 since `sr ≤ 2`.  Tate
computed `K₂(ℤ[1/n]) ≅ ℤ/2 ⊕ ⊕_{q ∣ n} F_q^×` (truth-check only, not an input).  So a finite
generating set of the whole group works as `s`, and the residual is **true**.  When `p ∤ m`,
the cokernel is `F_p^×` stably.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup

/-- **The residual.**  Let `m > 0` and let `p` be a prime below every prime factor of `m`.  Then
`K₂(5, ℤ[1/(mp)])` is generated by the image of `K₂(5, ℤ[1/m])` and a finite subset of
`K₂(5, ℤ[1/(mp)])`. -/
def czBaseFGCz_CokerStatement : Prop :=
  ∀ m p : ℕ, 0 < m → p.Prime → (∀ q : ℕ, q.Prime → q ∣ m → p < q) →
    ∃ s : Set (St 5 (Localization.Away ((m * p : ℕ) : ℤ))), s.Finite ∧
      s ⊆ K2 (Fin 5) (Localization.Away ((m * p : ℕ) : ℤ)) ∧
      K2 (Fin 5) (Localization.Away ((m * p : ℕ) : ℤ)) ≤ Subgroup.closure
        (ringMap (czK2FngGtOneRank3_locMap m p) ''
          (K2 (Fin 5) (Localization.Away (m : ℤ)) :
            Set (St 5 (Localization.Away (m : ℤ)))) ∪ s)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_CokerStatement

/-- If `p ∣ m`, then `ℤ[1/m] ≅ ℤ[1/(mp)]`, so finite generation of `K₂` transfers. -/
theorem czBaseFGCz_fg_of_dvd {m p : ℕ} (hm : 0 < m) (hp : 0 < p) (hpm : p ∣ m) {N : ℕ}
    (h : Group.FG (K2 (Fin N) (Localization.Away (m : ℤ)))) :
    Group.FG (K2 (Fin N) (Localization.Away ((m * p : ℕ) : ℤ))) :=
  k2_fg_of_ringEquiv (RingEquiv.ofBijective (czK2FngGtOneRank3_locMap m p)
    ⟨czK2FngGtOneRank3_locMap_injective m p (Nat.mul_pos hm hp).ne',
      czK2FngRank3Sec_locMap_surjective m p hpm⟩) h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_of_dvd

/-- **Prime induction at rank 5.**  The residual gives finite generation of `K₂(5, ℤ[1/n])`
for every `n > 0`. -/
theorem czBaseFGCz_fg_five_of_coker (h : czBaseFGCz_CokerStatement) :
    ∀ n : ℕ, 0 < n → Group.FG (K2 (Fin 5) (Localization.Away (n : ℤ))) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro hn
    by_cases h1 : n = 1
    · subst h1
      exact czBaseFGCz_fg_five_one
    · obtain ⟨p, hp, hpmin, c, rfl⟩ : ∃ p : ℕ, p.Prime ∧ (∀ q : ℕ, q.Prime → q ∣ n → p ≤ q) ∧
          ∃ c : ℕ, n = c * p :=
        ⟨n.minFac, Nat.minFac_prime h1, fun q hq hqn ↦ Nat.minFac_le_of_dvd hq.two_le hqn,
          n / n.minFac, (Nat.div_mul_cancel (Nat.minFac_dvd n)).symm⟩
      have hcpos : 0 < c := Nat.pos_of_ne_zero fun h0 ↦ by simp [h0] at hn
      have hclt : c < c * p := (lt_mul_iff_one_lt_right hcpos).mpr hp.one_lt
      have hc := ih c hclt hcpos
      by_cases hpc : p ∣ c
      · exact czBaseFGCz_fg_of_dvd hcpos hp.pos hpc hc
      · have hlt : ∀ q : ℕ, q.Prime → q ∣ c → p < q := fun q hq hqc ↦
          lt_of_le_of_ne (hpmin q hq (dvd_mul_of_dvd_left hqc p))
            (fun he ↦ hpc (by rw [he]; exact hqc))
        obtain ⟨s, hsfin, hsK, hle⟩ := h c p hcpos hp hlt
        exact czBaseFGCz_fg_of_le_closure (czK2FngGtOneRank3_locMap c p) hc hsfin hsK hle

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_five_of_coker

/-- The residual gives `CharZeroK2BasePosFGStatement`. -/
theorem czBaseFGCz_basePos_of_coker (h : czBaseFGCz_CokerStatement) :
    CharZeroK2BasePosFGStatement :=
  fun m N hm h5N ↦ czBaseFGCz_fg_ge_five hm (czBaseFGCz_fg_five_of_coker h m hm) N h5N

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_basePos_of_coker

/-- **Endpoint (lane `bh-met-95c`).**  The residual gives `CharZeroK2BaseFGStatement`. -/
theorem czBaseFGCz_baseFG_of_coker (h : czBaseFGCz_CokerStatement) :
    CharZeroK2BaseFGStatement :=
  charZeroK2BaseFG_of_pos (czBaseFGCz_basePos_of_coker h)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_baseFG_of_coker

/-- **Comparison.**  The existing rank-3 one-prime step (`czK2FngGtOneRank3_StepStatement`)
implies the residual.  Transport it twice, `3 → 4 → 5`, with `czBaseFGCz_step_succ`, using
surjective stability over `ℤ[1/(mp)]`. -/
theorem czBaseFGCz_coker_of_step (h : czK2FngGtOneRank3_StepStatement) :
    czBaseFGCz_CokerStatement := by
  intro m p hm hp _
  have hmp : 0 < m * p := Nat.mul_pos hm hp.pos
  obtain ⟨s, hsfin, hsK, hle⟩ := h m p hm hp
  have h4 := czBaseFGCz_step_succ (czK2FngGtOneRank3_locMap m p) hsK hle
    (czK2FngGtOne_k2_le_map hmp)
  have h5 := czBaseFGCz_step_succ (czK2FngGtOneRank3_locMap m p)
    (czBaseFGCz_stab_image_subset_K2 hsK) (h4.trans Subgroup.closure_le_normalClosure)
    (czStabGen_k2SurjStab_of_triOff czTriOff_triOffStatement (m * p) 4 hmp le_rfl)
  exact ⟨stab (3 + 1) (Localization.Away ((m * p : ℕ) : ℤ)) ''
      (stab 3 (Localization.Away ((m * p : ℕ) : ℤ)) '' s), (hsfin.image _).image _,
    czBaseFGCz_stab_image_subset_K2 (czBaseFGCz_stab_image_subset_K2 hsK), h5⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_coker_of_step

/-- **LOUD converse.**  The target implies the residual: take `s` to be a finite generating set
of `K₂(5, ℤ[1/(mp)])`.  So the residual is logically equivalent to the target, though smaller in
proof content (see the module docstring). -/
theorem czBaseFGCz_coker_of_baseFG (h : CharZeroK2BaseFGStatement) :
    czBaseFGCz_CokerStatement := by
  intro m p _ _ _
  obtain ⟨s, hs, hsfin⟩ :=
    (Subgroup.fg_iff _).mp ((Group.fg_iff_subgroup_fg _).mp (h (m * p) 5 le_rfl))
  refine ⟨s, hsfin, ?_, ?_⟩
  · rw [← hs]
    exact Subgroup.subset_closure
  · rw [← hs]
    exact Subgroup.closure_mono Set.subset_union_right

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_coker_of_baseFG

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
