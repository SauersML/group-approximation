import Mathlib.RingTheory.Algebraic.Integral
import Mathlib.RingTheory.IntegralClosure.IsIntegral.Basic
import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Finiteness.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# Torsion-free linearity, coprimary case: finite dimensionality (lane bh-met-43)

Let `B` be a commutative `K`-algebra (`K` a field) generated by a finite set `t`, and `M` a
finitely generated `B`-module on which every generator `b ∈ t` is killed by a nonzero polynomial
over `K`, i.e. `p(b) • M = 0`.  Then `M` is finite-dimensional over `K`.

Proof: `C = B ⧸ Ann_B(M)` is generated over `K` by the images of `t`, which are algebraic, hence
integral, so `C` is module-finite over `K` (`fg_adjoin_of_finite`).  `M` is a finite `C`-module,
so `M` is finite over `K` (`Module.Finite.trans`).

* `noether_finiteDimensional_of_adjoin`: the endpoint.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Coprimary

/-- **Finite dimensionality.** A finitely generated module over a finitely generated commutative
`K`-algebra, on which each generator satisfies a nonzero polynomial over `K`, is
finite-dimensional over `K`. -/
theorem noether_finiteDimensional_of_adjoin {K B M : Type*} [Field K] [CommRing B]
    [Algebra K B] [AddCommGroup M] [Module B M] [Module K M] [IsScalarTower K B M]
    [Module.Finite B M] (t : Set B) (ht : t.Finite) (hadj : Algebra.adjoin K t = ⊤)
    (hkill : ∀ b ∈ t, ∃ p : Polynomial K, p ≠ 0 ∧ ∀ m : M, Polynomial.aeval b p • m = 0) :
    FiniteDimensional K M := by
  letI : Module (B ⧸ Module.annihilator B M) M := Module.quotientAnnihilator
  haveI : IsScalarTower B (B ⧸ Module.annihilator B M) M := ⟨fun b c m => by
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
    exact mul_smul b c m⟩
  haveI : Module.Finite (B ⧸ Module.annihilator B M) M :=
    Module.Finite.of_restrictScalars_finite B (B ⧸ Module.annihilator B M) M
  haveI : IsScalarTower K (B ⧸ Module.annihilator B M) M := ⟨fun k c m => by
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective c
    exact smul_assoc k c m⟩
  haveI : Module.Finite K (B ⧸ Module.annihilator B M) := by
    have hint : ∀ x ∈ Ideal.Quotient.mkₐ K (Module.annihilator B M) '' t, IsIntegral K x := by
      rintro _ ⟨b, hb, rfl⟩
      obtain ⟨p, hp0, hp⟩ := hkill b hb
      refine IsAlgebraic.isIntegral ⟨p, hp0, ?_⟩
      rw [Polynomial.aeval_algHom_apply, Ideal.Quotient.mkₐ_eq_mk,
        Ideal.Quotient.eq_zero_iff_mem, Module.mem_annihilator]
      exact hp
    have hadj' : Algebra.adjoin K (Ideal.Quotient.mkₐ K (Module.annihilator B M) '' t) = ⊤ := by
      rw [← AlgHom.map_adjoin, hadj]
      refine eq_top_iff.2 fun y _ => ?_
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective K (Module.annihilator B M) y
      exact Subalgebra.mem_map.2 ⟨x, Algebra.mem_top, rfl⟩
    have hfg := fg_adjoin_of_finite (ht.image _) hint
    rw [hadj', Algebra.top_toSubmodule] at hfg
    exact ⟨hfg⟩
  exact Module.Finite.trans (B ⧸ Module.annihilator B M) M

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.noether_finiteDimensional_of_adjoin

end Coprimary
end Metabelian
end BooneHigman
end GroupApproximation
