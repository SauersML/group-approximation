import GroupApproximation.BooneHigman.Metabelian.SuslinDilationQuillenGroup
import GroupApproximation.Meta.AxiomGuard

/-!
# Suslin dilation route, part 2: local Quillen elements from generators

Lane `bh-met-68c`.  Target: `SuslinLocalHorrocksStatement`
(`SuslinLocalHorrocksStatement.lean`), hypothesis `hH` of
`finitelyPresentedMetabelianStatement_of_frontierThree`.

**Truth check of the target.**  TRUE, by Suslin's theorem (A. A. Suslin, 1977):
for `A = F_p[s_0, ..., s_{k-1}]` or `A = ℤ[1/m][t_0, ..., t_{k-1}]` and `N ≥ 3`,
`SL_N(A[X]) = E_N(A[X])`, so every normalized `τ` is elementary, its Quillen matrix
`τ(X + Y) τ(X)⁻¹` is elementary, and `ε = 1`, `g = 1`, `a = 1 ∉ 𝔪` work.
It is NOT closed here: the analytic half of the dilation principle (localizing at `s ∉ 𝔪`,
local Horrocks over `A_𝔪[X]`, and the commutator estimate `σ(X, s^k Y) ∈ E_N(A[X][Y])`)
needs localization machinery for `E_N` that the corpus does not have.

**Isolated Statement.**  `SuslinDilationGeneratedStatement` has the same hypotheses and, for a
normalized `τ ∈ SL_N(A[X])` and a maximal ideal `𝔪`, only asks that `τ` lie in the SUBGROUP
GENERATED by the local Quillen matrices at `𝔪`,
`{σ ∈ GL_N(A[X]) : ∃ a ∉ 𝔪, σ(X + aY) σ(X)⁻¹ ∈ E_N(A[X][Y])}`,
i.e. `τ = σ₁^{±1} ⋯ σ_r^{±1}` with each `σᵢ` having its OWN local Quillen element `aᵢ ∉ 𝔪`.

* It is implied by the target (`suslinDilationGeneratedStatement_of_localHorrocks`): the target's
  `a ∈ Q(ε τ C(g))` gives `a ∈ Q(τ)` (`SuslinLocalHorrocksInvariance.lean`), so `τ` is itself a
  generator.  Prima facie it asks much less: the factors need not be normalized, need not have
  determinant one, and have independent Quillen elements.
* It is true: by the truth check, `τ` is a generator (`a = 1`).
* The reduction `suslinLocalHorrocks_of_dilationGenerated` uses the group-theoretic half of the
  Quillen–Suslin dilation principle, proved in `SuslinDilationQuillenGroup.lean` from the
  normality of `E_N` (`suslinNormal_conj_mem`, `N ≥ 3`): local Quillen matrices at a prime form
  a subgroup, via `Q(τ₁) ∩ Q(τ₂) ⊆ Q(τ₁τ₂)`, `Q(τ) ⊆ Q(τ⁻¹)` and `aᵢ ∉ 𝔪 ⇒ ∏ aᵢ ∉ 𝔪`.

**Loud caveat.**  As with every proved `_of_` reduction, the isolated Statement is logically
equivalent to the target once both implications are proved; it is not a restatement, but the
proof content removed is only the normality-based closure under products and inverses.  The
mathematical core (steps 1–3 of `SuslinLocalHorrocksStatement.lean`) remains open: one still has
to produce, for each `𝔪`, generators with local Quillen elements, which is where localization,
local Horrocks and the commutator estimate of the dilation lemma enter.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

/-- Every normalized `τ ∈ SL_N(A[X])` lies, for each maximal ideal `𝔪`, in the subgroup of
`GL_N(A[X])` generated by the matrices `σ` having some `a ∉ 𝔪` with
`σ(X + aY) σ(X)⁻¹ ∈ E_N(A[X][Y])`. -/
def SuslinDilationGeneratedQuillen (A : Type*) [CommRing A] (N : ℕ) : Prop :=
  ∀ τ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A),
    Matrix.det (τ : Matrix (Fin N) (Fin N) (Polynomial A)) = 1 →
      elementaryMatrixUnitMap (ι := Fin N) (Polynomial.constantCoeff (R := A)) τ = 1 →
        ∀ 𝔪 : Ideal A, 𝔪.IsMaximal →
          τ ∈ Subgroup.closure
            {σ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A) |
              ∃ a ∉ 𝔪, SuslinLocalGlobalQuillen σ a}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.SuslinDilationGeneratedQuillen

/-- For `N ≥ 3`, generated local Quillen matrices give the local Horrocks condition
(with `ε = 1`, `g = 1`). -/
theorem suslinDilation_localHorrocks_of_generated {A : Type*} [CommRing A] {N : ℕ}
    (hN : 3 ≤ N) (h : SuslinDilationGeneratedQuillen A N) :
    SuslinLocalHorrocksLocallyQuillen A N := by
  have hN' : 2 < N := by omega
  intro τ hdet h0 𝔪 h𝔪
  obtain ⟨a, ha𝔪, ha⟩ :=
    suslinDilation_quillen_of_mem_closure hN' h𝔪.isPrime (h τ hdet h0 𝔪 h𝔪)
  refine ⟨1, one_mem _, 1, a, ha𝔪, ?_⟩
  rw [one_mul, map_one, mul_one]
  exact ha

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilation_localHorrocks_of_generated

/-- The local Horrocks condition implies the generated condition (no rank bound needed). -/
theorem suslinDilation_generated_of_localHorrocks {A : Type*} [CommRing A] {N : ℕ}
    (h : SuslinLocalHorrocksLocallyQuillen A N) : SuslinDilationGeneratedQuillen A N := by
  intro τ hdet h0 𝔪 h𝔪
  obtain ⟨ε, hε, g, a, ha𝔪, ha⟩ := h τ hdet h0 𝔪 h𝔪
  have hmem : τ ∈ {σ : Matrix.GeneralLinearGroup (Fin N) (Polynomial A) |
      ∃ a ∉ 𝔪, SuslinLocalGlobalQuillen σ a} :=
    ⟨a, ha𝔪, suslinLocalHorrocks_quillen_of_elementary_mul_C hε g ha⟩
  exact Subgroup.subset_closure hmem

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilation_generated_of_localHorrocks

/-- **The generated local Quillen Statement**: `SuslinDilationGeneratedQuillen` for the two
coefficient families, under the hypotheses of `SuslinLocalHorrocksStatement`. -/
def SuslinDilationGeneratedStatement : Prop :=
  (∀ (p : ℕ) [Fact p.Prime] (k N : ℕ), 1 ≤ k →
      (∀ N' : ℕ, 3 ≤ N' → SpecialLinearInElementary (Chain.CharPPoly p k) N') → 3 ≤ N →
        SuslinDilationGeneratedQuillen (Chain.CharPPoly p k) N) ∧
    ∀ (m k N : ℕ),
      (∀ N' : ℕ, 3 ≤ N' → SpecialLinearInElementary (Chain.SIntPoly m k) N') → 3 ≤ N →
        SuslinDilationGeneratedQuillen (Chain.SIntPoly m k) N

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.SuslinDilationGeneratedStatement

/-- **The reduction**: the generated Statement gives the local Horrocks Statement. -/
theorem suslinLocalHorrocks_of_dilationGenerated (h : SuslinDilationGeneratedStatement) :
    SuslinLocalHorrocksStatement :=
  ⟨fun p _ k N hk hA hN ↦ suslinDilation_localHorrocks_of_generated hN (h.1 p k N hk hA hN),
    fun m k N hA hN ↦ suslinDilation_localHorrocks_of_generated hN (h.2 m k N hA hN)⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinLocalHorrocks_of_dilationGenerated

/-- The target implies the isolated Statement, so the latter is no stronger. -/
theorem suslinDilationGeneratedStatement_of_localHorrocks (h : SuslinLocalHorrocksStatement) :
    SuslinDilationGeneratedStatement :=
  ⟨fun p _ k N hk hA hN ↦ suslinDilation_generated_of_localHorrocks (h.1 p k N hk hA hN),
    fun m k N hA hN ↦ suslinDilation_generated_of_localHorrocks (h.2 m k N hA hN)⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilationGeneratedStatement_of_localHorrocks

end Absorption
end Metabelian
end BooneHigman
end GroupApproximation
