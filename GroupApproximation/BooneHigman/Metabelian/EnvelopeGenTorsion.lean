import GroupApproximation.BooneHigman.Metabelian.EnvelopeGenTorsionClass
import GroupApproximation.BooneHigman.Metabelian.EnvelopeFiniteIndex
import GroupApproximation.Meta.AxiomGuard

/-!
# The generator-torsion Statement from perfectness of `V_{Fin 2 × X}`

* `GenTorsionVPerfectStatement`: for every finite nontrivial `X`, the Higman–Thompson group
  `V_Y = higmanThompsonV (Fin 2 × X)` is perfect (`V_Y ≤ ⁅V_Y, V_Y⁆`);
* `rnGeneratorTorsion_of_vPerfect`: it implies `RNGeneratorTorsionStatement`;
* `rnFiniteIndex_of_vPerfect`: hence `RNCommutatorFiniteIndexStatement`.

Route.  Let `V = envelopeV X H`, `K = envelopeK 2 H`, `A` the abelianisation of `V`.
`K` is finitely presented, so it has a finite generating set `S`; fix a letter `a`.  Take
`T = gentorsionLoc K [] '' S ∪ gentorsionLoc K [a] '' S`.
* The `V_Y` generators lie in `⁅V, V⁆` by perfectness.
* A localised `k ∈ K` at `w ≠ []` has the class of its localisation at `[a]`
  (`gentorsion_class_localize_eq`), and `k ↦ class of localize p k` is a homomorphism, so the
  class lies in the closure of the classes of `T` (`gentorsion_mem_closure_image`); transfer by
  `gentorsion_transfer`.
* So the classes of `T` generate `A` (`closure_image_of_eq_top`), `A` is finitely generated,
  and each generator class is a square (`gentorsion_loc_sq`), so `A = A ^ 2`.
* `gentorsion_exists_exponent` gives `m > 0` with `A ^ m = 1`, i.e. `t ^ m ∈ [V, V]`.

*Why the isolated Statement is strictly smaller.*  `GenTorsionVPerfectStatement` only concerns
the Higman–Thompson group `V_Y`: it mentions neither `H`, nor `K`, nor the Röver–Nekrashevych
group, nor finite presentability.  The reduction proves all the envelope-specific content: the
first-letter splitting of `cantorHom (envelopeEmbed 2 h)` into a `V_Y` element and two
conjugate halves, the conjugacy of localisations, the transfer through the abelianisation, the
finite generation of `A`, and Nakayama's lemma over `ℤ` for `A = 2 A`.

*Truth.*  Higman (*Finitely presented infinite simple groups*, 1974) shows that `V_{n,1}` is
simple, hence perfect, for even `n`, and `|Fin 2 × X| = 2 |X|` is even.  Sketch: `V_Y` is
generated by cone swaps (sibling `EnvelopeHigmanVGen*` work); a cone swap `s` of `v, w` is an
involution and equals the product of the `|Y|` swaps of `v ++ [y], w ++ [y]`, each conjugate to
`s` in `V_Y`; in the abelianisation this gives `(|Y| - 1) [s] = 0` and `2 [s] = 0`, so `[s] = 0`
as `|Y| - 1` is odd.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

open Trees

/-- **Perfectness of `V_{Fin 2 × X}`.**  Higman's `V_{2|X|,1}` lies in its own commutator
subgroup. -/
def GenTorsionVPerfectStatement : Prop :=
  ∀ (X : Type) [Finite X] [Nontrivial X],
    higmanThompsonV (envelopeY X 2) ≤
      ⁅higmanThompsonV (envelopeY X 2), higmanThompsonV (envelopeY X 2)⁆

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.GenTorsionVPerfectStatement

theorem gentorsion_mem_closure_image {G A B : Type*} [Group G] [Group A] [Group B] {S : Set G}
    (hS : Subgroup.closure S = ⊤) (f : G →* A) (g : A →* B) (x : G) :
    g (f x) ∈ Subgroup.closure (g '' (f '' S)) := by
  have hx : x ∈ Subgroup.closure S := by
    rw [hS]
    exact Subgroup.mem_top x
  have e := Subgroup.mem_map_of_mem (g.comp f) hx
  rw [Subgroup.map_closure, MonoidHom.coe_comp, Set.image_comp] at e
  exact e

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.gentorsion_mem_closure_image

/-- The localisations of `S ⊆ K` at the empty word and at the one-letter word `[a]`. -/
noncomputable def gentorsionGens {X : Type} [Finite X] (H : Subgroup (TreeAut X))
    (S : Set ↥(envelopeK 2 H)) (a : envelopeY X 2) : Set ↥(envelopeV X H) :=
  gentorsionLoc (envelopeK 2 H) [] '' S ∪ gentorsionLoc (envelopeK 2 H) [a] '' S

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.gentorsionGens

/-- Perfectness of `V_{Fin 2 × X}` gives the generator data of `RNGeneratorTorsionStatement`. -/
theorem rnGeneratorTorsion_of_vPerfect (hperf : GenTorsionVPerfectStatement) :
    RNGeneratorTorsionStatement := by
  intro X _ _ H hH hHfp
  have hVc : higmanThompsonV (envelopeY X 2) ≤ ⁅envelopeV X H, envelopeV X H⁆ :=
    (hperf X).trans
      (Subgroup.commutator_mono (higmanThompsonV_le_rn _) (higmanThompsonV_le_rn _))
  have hKfg : Group.FG ↥(envelopeK 2 H) := by
    obtain ⟨n, φ, hφ, -⟩ := (isFinitelyPresented_envelopeK hHfp).out
    exact Group.fg_of_surjective hφ
  obtain ⟨S, hS, hSfin⟩ := Group.fg_iff.mp hKfg
  obtain ⟨a⟩ := (inferInstance : Nonempty (envelopeY X 2))
  have hgen : ∀ g ∈ rnGenerators (envelopeK 2 H), g ∈
      Subgroup.closure (Subtype.val '' gentorsionGens H S a) ⊔ ⁅envelopeV X H, envelopeV X H⁆ := by
    rintro g (hg | ⟨w, k, hk, rfl⟩)
    · exact Subgroup.mem_sup_right (hVc hg)
    · refine gentorsion_transfer (V := envelopeV X H) (T := gentorsionGens H S a)
        (x := ⟨localize w (cantorHom k), localize_mem_roverNekrashevych _ w hk⟩) ?_
      by_cases hw : w = []
      · subst hw
        exact Subgroup.closure_mono (Set.image_mono (Set.subset_union_left
            (t := gentorsionLoc (envelopeK 2 H) [a] '' S)))
          (gentorsion_mem_closure_image hS (gentorsionLoc (envelopeK 2 H) [])
            Abelianization.of ⟨k, hk⟩)
      · rw [gentorsion_class_localize_eq hw (List.cons_ne_nil a [])
          (localize_mem_roverNekrashevych _ w hk) (localize_mem_roverNekrashevych _ [a] hk)]
        exact Subgroup.closure_mono (Set.image_mono (Set.subset_union_right
            (s := gentorsionLoc (envelopeK 2 H) [] '' S)))
          (gentorsion_mem_closure_image hS (gentorsionLoc (envelopeK 2 H) [a])
            Abelianization.of ⟨k, hk⟩)
  have h1 := closure_image_of_eq_top (closure_sup_commutator_eq_top (V := envelopeV X H)
    (S := rnGenerators (envelopeK 2 H)) le_rfl hgen)
  have hfin : (gentorsionGens H S a).Finite :=
    (hSfin.image (gentorsionLoc (envelopeK 2 H) [])).union
      (hSfin.image (gentorsionLoc (envelopeK 2 H) [a]))
  have hAfg : Group.FG (Abelianization ↥(envelopeV X H)) :=
    Group.fg_iff.mpr ⟨_, h1, hfin.image _⟩
  have hle : Subgroup.closure
      ((Abelianization.of : ↥(envelopeV X H) →* Abelianization ↥(envelopeV X H)) ''
        gentorsionGens H S a) ≤
      (powMonoidHom 2 :
        Abelianization ↥(envelopeV X H) →* Abelianization ↥(envelopeV X H)).range := by
    refine Subgroup.closure_le.mpr ?_
    rintro _ ⟨t, ht | ht, rfl⟩
    · obtain ⟨k, -, rfl⟩ := ht
      exact gentorsion_loc_sq hVc hH [] k
    · obtain ⟨k, -, rfl⟩ := ht
      exact gentorsion_loc_sq hVc hH [a] k
  have hsq : ∀ u : Abelianization ↥(envelopeV X H), ∃ b, b ^ 2 = u := by
    intro u
    have hu : u ∈ Subgroup.closure
        ((Abelianization.of : ↥(envelopeV X H) →* Abelianization ↥(envelopeV X H)) ''
          gentorsionGens H S a) := by
      rw [h1]
      exact Subgroup.mem_top u
    exact MonoidHom.mem_range.mp (hle hu)
  obtain ⟨m, hm, hpow⟩ := gentorsion_exists_exponent hAfg hsq
  refine ⟨m, gentorsionGens H S a, hm, hfin, hgen, fun t _ => ?_⟩
  exact (Abelianization.ker_of ↥(envelopeV X H)).le
    (MonoidHom.mem_ker.mpr ((map_pow _ t m).trans (hpow _)))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnGeneratorTorsion_of_vPerfect

/-- Perfectness of `V_{Fin 2 × X}` gives `RNCommutatorFiniteIndexStatement`. -/
theorem rnFiniteIndex_of_vPerfect (hperf : GenTorsionVPerfectStatement) :
    RNCommutatorFiniteIndexStatement :=
  rnFiniteIndex_of_generatorTorsion (rnGeneratorTorsion_of_vPerfect hperf)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnFiniteIndex_of_vPerfect

end GroupApproximation.BooneHigman.Metabelian.Envelope
