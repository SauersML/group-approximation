import GroupApproximation.BooneHigman.Metabelian.ElemFPK2OneVarTransport
import Mathlib.GroupTheory.Finiteness
import Mathlib.RingTheory.Localization.Away.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# Unconditional cases of finite generation of `K₂(N, ℤ[1/m])`

Lane `bh-met-36`, helper module.  These lemmas hold with no hypothesis.

* `steinbergGroup_subsingleton`: over the zero ring every generator `xᵢⱼ(a) = xᵢⱼ(0) = 1`, so
  `St_I(R)` is trivial;
* `k2_fg_of_subsingleton`: so `K₂(I, R)` is finitely generated over the zero ring;
* `k2_fg_of_ringEquiv`, `k2_fg_iff_of_ringEquiv`: finite generation of `K₂(I, -)` transports along
  ring isomorphisms (via `ElemFP.K2Map_K2Map_of_comp_eq_id`);
* `localizationAway_subsingleton_of_eq_zero`, `k2_fg_localizationAway_of_eq_zero`: `ℤ[1/0] = 0`,
  so `K₂(I, ℤ[1/0])` is finitely generated;
* `k2_fg_localizationAway_iff_of_eq_one`: `ℤ[1/1] ≅ ℤ`, so `K₂(I, ℤ[1/1])` is finitely generated
  exactly when `K₂(I, ℤ)` is.

**Warning.**  `K₂(ℤ) = ℤ/2` (Milnor), generated by `{-1,-1}`.  Nothing here claims it vanishes.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic

section Trivial

variable {I R S : Type*} [Fintype I] [DecidableEq I] [Ring R] [Ring S]

/-- Over the zero ring the Steinberg group is trivial: each generator is `xᵢⱼ(0) = 1`. -/
theorem steinbergGroup_subsingleton [Subsingleton R] : Subsingleton (SteinbergGroup I R) := by
  refine subsingleton_of_forall_eq 1 fun g ↦ ?_
  have hg : g ∈ (⊥ : Subgroup (SteinbergGroup I R)) := by
    refine PresentedGroup.generated_by _ _ ?_ g
    rintro ⟨i, j, hij, a⟩
    have ha : a = 0 := Subsingleton.elim a 0
    subst ha
    exact Subgroup.mem_bot.mpr (GroupApproximation.SteinbergGroup.x_zero (R := R) i j hij)
  exact Subgroup.mem_bot.mp hg

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.steinbergGroup_subsingleton

/-- Over the zero ring `K₂(I, R)` is finitely generated (it is trivial). -/
theorem k2_fg_of_subsingleton [Subsingleton R] : Group.FG (K2 I R) := by
  have hs : Subsingleton (SteinbergGroup I R) := steinbergGroup_subsingleton
  have hf : Finite (K2 I R) := Subtype.finite
  exact Group.fg_of_finite

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_of_subsingleton

/-- Finite generation of `K₂(I, -)` transports along a ring isomorphism. -/
theorem k2_fg_of_ringEquiv (e : R ≃+* S) (h : Group.FG (K2 I R)) : Group.FG (K2 I S) :=
  Group.fg_of_surjective (hG := h) (f := K2Map (I := I) e.toRingHom)
    fun v ↦ ⟨K2Map e.symm.toRingHom v,
      ElemFP.K2Map_K2Map_of_comp_eq_id _ _ e.toRingHom_comp_symm_toRingHom v⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_of_ringEquiv

/-- Isomorphic rings have finitely generated `K₂(I, -)` simultaneously. -/
theorem k2_fg_iff_of_ringEquiv (e : R ≃+* S) : Group.FG (K2 I R) ↔ Group.FG (K2 I S) :=
  ⟨k2_fg_of_ringEquiv e, k2_fg_of_ringEquiv e.symm⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_iff_of_ringEquiv

end Trivial

section Localization

variable {I : Type*} [Fintype I] [DecidableEq I]

/-- `ℤ[1/0]` is the zero ring. -/
theorem localizationAway_subsingleton_of_eq_zero {x : ℤ} (hx : x = 0) :
    Subsingleton (Localization.Away x) := by
  subst hx
  exact IsLocalization.subsingleton (M := Submonoid.powers (0 : ℤ))
    (S := Localization.Away (0 : ℤ)) (Submonoid.mem_powers 0)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.localizationAway_subsingleton_of_eq_zero

/-- `K₂(I, ℤ[1/0])` is finitely generated. -/
theorem k2_fg_localizationAway_of_eq_zero {x : ℤ} (hx : x = 0) :
    Group.FG (K2 I (Localization.Away x)) := by
  have hs : Subsingleton (Localization.Away x) :=
    localizationAway_subsingleton_of_eq_zero hx
  exact k2_fg_of_subsingleton

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_localizationAway_of_eq_zero

/-- `ℤ[1/1] ≅ ℤ`, so `K₂(I, ℤ[1/1])` is finitely generated exactly when `K₂(I, ℤ)` is. -/
theorem k2_fg_localizationAway_iff_of_eq_one {x : ℤ} (hx : x = 1) :
    Group.FG (K2 I (Localization.Away x)) ↔ Group.FG (K2 I ℤ) := by
  subst hx
  exact (k2_fg_iff_of_ringEquiv
    (IsLocalization.atOne ℤ (Localization.Away (1 : ℤ))).toRingEquiv).symm

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_localizationAway_iff_of_eq_one

end Localization

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
