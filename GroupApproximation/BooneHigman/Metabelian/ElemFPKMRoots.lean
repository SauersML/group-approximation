import GroupApproximation.BooneHigman.Metabelian.ElemFPKMWordPackage
import GroupApproximation.BooneHigman.Metabelian.ElemFPKMPhi
import GroupApproximation.Meta.AxiomGuard

/-!
# Root subgroups of `KMGroup X d` and the inverse root map

Rank-`d + 5` generalisation of
`GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.RootExtension`.  For indices `i ≠ j`
the words `word X d u i j` pairwise commute, so they generate a commutative subgroup
`RootGroup X d i j hij`.  The free abelian group `ℤ⟨X⟩ = ⨁_{w} ℤ w` maps additively into it,
sending the monomial `w` to the word of `w`.  This gives `psiRoot X d i j hij : ℤ⟨X⟩ → KMGroup X d`
with `psiRoot_add`, `psiRoot_zero`, `psiRoot_neg`, `psiRoot_monomial`, `psiRoot_commute` and
`psiRoot_adjacent : ⁅ψ_{ij}(a), ψ_{jk}(b)⁆ = ψ_{ik}(a b)`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP

open scoped commutatorElement
open FreeAlgebraDegree
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP
  (comm_mul_left comm_mul_right commute_of_mem_closure)

noncomputable section

variable (X : Type*) (d : ℕ)

/-- The words at the index pair `(i, j)`. -/
def rootWords (i j : Fin (d + 5)) : Set (KMGroup X d) :=
  Set.range fun u : List X => word X d u i j

theorem closure_commute (i j k l : Fin (d + 5)) (hij : i ≠ j) (hkl : k ≠ l) (hjk : j ≠ k)
    (hil : i ≠ l) {g h : KMGroup X d} (hg : g ∈ Subgroup.closure (rootWords X d i j))
    (hh : h ∈ Subgroup.closure (rootWords X d k l)) : Commute g h := by
  refine commute_of_mem_closure ?_ hg hh
  rintro _ ⟨u, rfl⟩ _ ⟨v, rfl⟩
  exact word_commute_word X d u v i j k l hij hkl hjk hil

/-- The root subgroup generated by the words at `(i, j)`. -/
def RootGroup (i j : Fin (d + 5)) (_hij : i ≠ j) : Type _ :=
  ↥(Subgroup.closure (rootWords X d i j))

instance (i j : Fin (d + 5)) (hij : i ≠ j) : CommGroup (RootGroup X d i j hij) :=
  { (inferInstanceAs (Group ↥(Subgroup.closure (rootWords X d i j)))) with
    mul_comm := fun a b => Subtype.ext
      (closure_commute X d i j i j hij hij (Ne.symm hij) hij (Subtype.property a)
        (Subtype.property b)).eq }

/-- The word of a monomial, as an element of the root subgroup. -/
def rootElem (i j : Fin (d + 5)) (hij : i ≠ j) (w : FreeMonoid X) : RootGroup X d i j hij :=
  Subtype.mk (word X d (FreeMonoid.toList w) i j)
    (Subgroup.subset_closure
      (Set.mem_range_self (f := fun u : List X => word X d u i j) (FreeMonoid.toList w)))

/-- The additive extension of `rootElem` to `ℤ⟨X⟩`. -/
def rootSum (i j : Fin (d + 5)) (hij : i ≠ j) (p : FreeAlgebra ℤ X) :
    Additive (RootGroup X d i j hij) :=
  Finsupp.liftAddHom (α := FreeMonoid X) (M := ℤ) (N := Additive (RootGroup X d i j hij))
    (fun w => zmultiplesHom (Additive (RootGroup X d i j hij))
      (Additive.ofMul (rootElem X d i j hij w)))
    (FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := ℤ) (X := X) p).coeff

theorem rootSum_add (i j : Fin (d + 5)) (hij : i ≠ j) (p q : FreeAlgebra ℤ X) :
    rootSum X d i j hij (p + q) = rootSum X d i j hij p + rootSum X d i j hij q := by
  unfold rootSum
  simp only [map_add, MonoidAlgebra.coeff_add]

theorem rootSum_monomial (i j : Fin (d + 5)) (hij : i ≠ j) (w : FreeMonoid X) :
    rootSum X d i j hij (wordMonomial X ℤ w) = Additive.ofMul (rootElem X d i j hij w) := by
  unfold rootSum wordMonomial
  rw [AlgEquiv.apply_symm_apply, MonoidAlgebra.coeff_single, Finsupp.liftAddHom_apply_single,
    zmultiplesHom_apply]
  exact one_zsmul (Additive.ofMul (rootElem X d i j hij w))

/-- The root map `ψ_{ij} : ℤ⟨X⟩ → KMGroup X d`. -/
def psiRoot (i j : Fin (d + 5)) (hij : i ≠ j) (p : FreeAlgebra ℤ X) : KMGroup X d :=
  Subtype.val (Additive.toMul (rootSum X d i j hij p))

theorem psiRoot_add (i j : Fin (d + 5)) (hij : i ≠ j) (p q : FreeAlgebra ℤ X) :
    psiRoot X d i j hij (p + q) = psiRoot X d i j hij p * psiRoot X d i j hij q := by
  exact congrArg (fun z : Additive (RootGroup X d i j hij) => Subtype.val (Additive.toMul z))
    (rootSum_add X d i j hij p q)

theorem psiRoot_monomial (i j : Fin (d + 5)) (hij : i ≠ j) (w : FreeMonoid X) :
    psiRoot X d i j hij (wordMonomial X ℤ w) = word X d (FreeMonoid.toList w) i j := by
  exact congrArg (fun z : Additive (RootGroup X d i j hij) => Subtype.val (Additive.toMul z))
    (rootSum_monomial X d i j hij w)

theorem psiRoot_mem (i j : Fin (d + 5)) (hij : i ≠ j) (p : FreeAlgebra ℤ X) :
    psiRoot X d i j hij p ∈ Subgroup.closure (rootWords X d i j) :=
  Subtype.property (Additive.toMul (rootSum X d i j hij p))

theorem psiRoot_commute (i j k l : Fin (d + 5)) (hij : i ≠ j) (hkl : k ≠ l) (hjk : j ≠ k)
    (hil : i ≠ l) (p q : FreeAlgebra ℤ X) :
    Commute (psiRoot X d i j hij p) (psiRoot X d k l hkl q) :=
  closure_commute X d i j k l hij hkl hjk hil (psiRoot_mem X d i j hij p)
    (psiRoot_mem X d k l hkl q)

theorem psiRoot_zero (i j : Fin (d + 5)) (hij : i ≠ j) : psiRoot X d i j hij 0 = 1 := by
  have h : psiRoot X d i j hij 0 * psiRoot X d i j hij 0 = psiRoot X d i j hij 0 * 1 := by
    rw [← psiRoot_add, add_zero, mul_one]
  exact mul_left_cancel h

theorem psiRoot_neg (i j : Fin (d + 5)) (hij : i ≠ j) (p : FreeAlgebra ℤ X) :
    psiRoot X d i j hij (-p) = (psiRoot X d i j hij p)⁻¹ := by
  have h : psiRoot X d i j hij p * psiRoot X d i j hij (-p) = 1 := by
    rw [← psiRoot_add, add_neg_cancel, psiRoot_zero]
  exact eq_inv_of_mul_eq_one_right h

/-- Induction over `ℤ⟨X⟩`: sums, negatives and monomials. -/
@[elab_as_elim]
theorem freeAlgebra_induction {P : FreeAlgebra ℤ X → Prop}
    (hadd : ∀ p q, P p → P q → P (p + q)) (hneg : ∀ p, P p → P (-p))
    (hw : ∀ w, P (wordMonomial X ℤ w)) (p : FreeAlgebra ℤ X) : P p := by
  have h0 : P 0 := by
    have h := hadd _ _ (hw 1) (hneg _ (hw 1))
    rwa [add_neg_cancel] at h
  have key : ∀ q : MonoidAlgebra ℤ (FreeMonoid X),
      P ((FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := ℤ) (X := X)).symm q) := by
    intro q
    induction q using MonoidAlgebra.induction_linear with
    | zero => rwa [map_zero]
    | add x y hx hy =>
        rw [map_add]
        exact hadd _ _ hx hy
    | single m r =>
        induction r using Int.induction_on with
        | zero => rwa [MonoidAlgebra.single_zero, map_zero]
        | succ i ih =>
            rw [MonoidAlgebra.single_add, map_add]
            exact hadd _ _ ih (hw m)
        | pred i ih =>
            rw [sub_eq_add_neg, MonoidAlgebra.single_add, map_add,
              MonoidAlgebra.single_neg m (1 : ℤ), map_neg]
            exact hadd _ _ ih (hneg _ (hw m))
  have h := key (FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := ℤ) (X := X) p)
  rwa [AlgEquiv.symm_apply_apply] at h

/-- The adjacent relation with a word as right entry. -/
theorem adj_word (i j k : Fin (d + 5)) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (v : List X)
    (a : FreeAlgebra ℤ X) :
    ⁅psiRoot X d i j hij a, word X d v j k⁆ =
      psiRoot X d i k hik (a * wordMonomial X ℤ (FreeMonoid.ofList v)) := by
  refine freeAlgebra_induction X ?_ ?_ ?_ a
  · intro p q hp hq
    rw [psiRoot_add X d i j hij p q, comm_mul_left, hp, hq,
      (psiRoot_commute X d i j i k hij hik (Ne.symm hij) hik p
        (q * wordMonomial X ℤ (FreeMonoid.ofList v))).eq,
      mul_inv_cancel_right, add_mul,
      psiRoot_add X d i k hik (p * wordMonomial X ℤ (FreeMonoid.ofList v))
        (q * wordMonomial X ℤ (FreeMonoid.ofList v))]
    exact (psiRoot_commute X d i k i k hik hik (Ne.symm hik) hik _ _).eq
  · intro p hp
    rw [psiRoot_neg X d i j hij p, commutatorElement_inv_left, ← commutatorElement_inv, hp,
      (psiRoot_commute X d i j i k hij hik (Ne.symm hij) hik p
        (p * wordMonomial X ℤ (FreeMonoid.ofList v))).inv_right.inv_left.eq,
      inv_mul_cancel_right, neg_mul,
      psiRoot_neg X d i k hik (p * wordMonomial X ℤ (FreeMonoid.ofList v))]
  · intro w
    rw [psiRoot_monomial X d i j hij w,
      word_append X d (FreeMonoid.toList w) v i j k hij hjk hik,
      wordMonomial_mul, psiRoot_monomial X d i k hik, FreeMonoid.toList_mul,
      FreeMonoid.toList_ofList]

end

end GroupApproximation.BooneHigman.Metabelian.ElemFP

