import GroupApproximation.BooneHigman.Metabelian.ElemFPKMIso
import GroupApproximation.BooneHigman.Metabelian.ElemFPPolyKernel
import GroupApproximation.Steinberg.QuotientExactness
import GroupApproximation.BooneHigman.SteinbergBasic.Kernel
import Mathlib.Algebra.MvPolynomial.Equiv
import Mathlib.Algebra.GroupWithZero.Units.Fintype
import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Data.Matrix.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# `E_N(F_p[s_1, ..., s_k])` is finitely presented for `N ≥ k + 4`, from `K₂` vanishing

Lane `bh-met-06`, Steinberg presentation route.

1. `steinbergFreeAlgebra_isFinitelyPresented` (`ElemFPKMIso`): `St_{d+5}(ℤ⟨X⟩)` is finitely
   presented for a finite alphabet `X` (Krstić–McCool presentation, rank `d + 5`).
2. `ker_polyQuotientMap` (`ElemFPPolyKernel`): `F_p[s_1..s_k]` is the quotient of `ℤ⟨Fin k⟩`
   by the two-sided ideal generated by a finite set.
3. `SteinbergGroup.ringMap_ker_isFinitelyNormallyGenerated_of_ker_eq_span`: the Steinberg map
   `St_{d+5}(ℤ⟨Fin k⟩) → St_{d+5}(F_p[s])` is surjective with finitely normally generated kernel.
   So `St_{d+5}(F_p[s])` is finitely presented (`steinbergPoly_isFinitelyPresented`), with no
   hypothesis.
4. `E_N = St_N / K₂(N)`.  The only remaining input is `K₂(N, F_p[s_1..s_k]) = 0`
   (`PolynomialFpK2VanishingStatement`).  The case `N = 4`, `k = 0` needs no input:
   `E_4(F_p)` is finite.

## The isolated gap

`PolynomialFpK2VanishingStatement`: for `p` prime, `N ≥ k + 4` and `N ≥ 5`,
`K2 (Fin N) (F_p[s_1..s_k]) = ⊥`.

* It is strictly smaller than the target.  It says nothing about presentations: all the
  presentation content (steps 1–3) is proved here.  It is not equivalent to the target: a finitely
  presented `E_N` only forces `K₂(N)` to be *finitely normally generated*
  (`SteinbergBasic.K2_isFinitelyNormallyGenerated_of`), not trivial.
* It is true.  `F_p[s_1..s_k]` is noetherian of Krull dimension `k`, so its Bass stable rank is
  `≤ k + 1`.  Van der Kallen's injective stability for `K₂` (1976) makes
  `K₂(N, R) → K₂(R)` injective for `N ≥ sr(R) + 2`, hence for `N ≥ k + 3`.  Quillen's homotopy
  invariance for regular rings gives `K₂(F_p[s_1..s_k]) = K₂(F_p)`, and `K₂(F_p) = 0`
  (Steinberg).
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP

noncomputable section

/-- `St_{d+5}(F_p[s_1..s_k])` is finitely presented. -/
theorem steinbergPoly_isFinitelyPresented (p k d : ℕ) :
    Group.IsFinitelyPresented
      (SteinbergGroup (Fin (d + 5)) (MvPolynomial (Fin k) (ZMod p))) := by
  haveI := steinbergFreeAlgebra_isFinitelyPresented (Fin k) d
  exact Group.IsFinitelyPresented.of_surjective
    (SteinbergGroup.ringMap (I := Fin (d + 5)) (polyQuotientMap p k))
    (SteinbergGroup.ringMap_surjective_of_surjective (polyQuotientMap p k)
      (polyQuotientMap_surjective p k))
    (SteinbergGroup.ringMap_ker_isFinitelyNormallyGenerated_of_ker_eq_span (polyQuotientMap p k)
      (polyQuotientMap_surjective p k) (by rw [Fintype.card_fin]; omega) (polyRelators p k)
      (polyRelators_finite p k) (ker_polyQuotientMap p k))

/-- **Lane target.**  `E_N(F_p[s_1..s_k])` is finitely presented for `p` prime and `N ≥ k + 4`. -/
def PolynomialFpElementaryFPStatement : Prop :=
  ∀ p : ℕ, p.Prime → ∀ k N : ℕ, k + 4 ≤ N →
    Group.IsFinitelyPresented (elementaryGroup (Fin N) (MvPolynomial (Fin k) (ZMod p)))

/-- **The isolated gap.**  `K₂(N, F_p[s_1..s_k]) = 0` for `p` prime, `N ≥ k + 4` and `N ≥ 5`.
True by van der Kallen's injective stability (`sr(F_p[s_1..s_k]) ≤ k + 1`), Quillen's homotopy
invariance, and `K₂(F_p) = 0`.  See the module docstring for why it is strictly smaller than the
target. -/
def PolynomialFpK2VanishingStatement : Prop :=
  ∀ p : ℕ, p.Prime → ∀ k N : ℕ, k + 4 ≤ N → 5 ≤ N →
    BooneHigman.SteinbergBasic.K2 (Fin N) (MvPolynomial (Fin k) (ZMod p)) = ⊥

/-- `E_N(F_p[s_1..s_k])` is finitely presented for `N ≥ k + 4`, from the smaller gap
`K₂(N, F_p[s_1..s_k]) = 0`.  The case `N = 4` forces `k = 0`, and then `E_4(F_p)` is finite. -/
theorem polynomialFpElementaryFP_of_polynomialFpK2Vanishing
    (h : PolynomialFpK2VanishingStatement) : PolynomialFpElementaryFPStatement := by
  intro p hp k N hN
  rcases Nat.lt_or_ge N 5 with h4 | h5
  · obtain rfl : N = 4 := by omega
    obtain rfl : k = 0 := by omega
    haveI : NeZero p := ⟨hp.ne_zero⟩
    haveI : Finite (MvPolynomial (Fin 0) (ZMod p)) :=
      Finite.of_equiv (ZMod p) (MvPolynomial.isEmptyRingEquiv (ZMod p) (Fin 0)).symm.toEquiv
    infer_instance
  · obtain ⟨d, rfl⟩ : ∃ d, N = d + 5 := ⟨N - 5, by omega⟩
    haveI := steinbergPoly_isFinitelyPresented p k d
    exact BooneHigman.SteinbergBasic.isFinitelyPresented_elementaryGroup_of_K2_eq_bot
      (h p hp k (d + 5) hN h5)

end

end GroupApproximation.BooneHigman.Metabelian.ElemFP

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.steinbergPoly_isFinitelyPresented
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.PolynomialFpElementaryFPStatement
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.PolynomialFpK2VanishingStatement
#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFP.polynomialFpElementaryFP_of_polynomialFpK2Vanishing
