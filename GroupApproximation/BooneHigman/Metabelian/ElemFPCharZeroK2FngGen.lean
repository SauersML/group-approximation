import GroupApproximation.BooneHigman.SteinbergBasic.Naturality
import GroupApproximation.Algebra.FinitePresentationKernel
import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.GroupTheory.Finiteness
import Mathlib.RingTheory.Localization.Away.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# `St_n(ℤ[1/m])` is finitely generated; Tietze with a finitely generated source

Lane `bh-met-75`, helper module.  Three facts, none of them about `K₂` of a specific ring beyond
what is displayed.

* `czK2Fng_ker_of_fg`: if `E` is finitely **generated**, `W` is finitely presented and
  `f : E ↠ W`, then `ker f` is finitely normally generated.  This sharpens
  `Tietze.ker_isFinitelyNormallyGenerated`, whose proof only uses the generating half of finite
  presentability of the source: choose `φ : F(α) ↠ E` with `α` finite, apply the free-source
  Tietze theorem to `f ∘ φ`, and push `ker (f ∘ φ) = φ⁻¹ (ker f)` forward along `φ`.
* `czK2Fng_steinbergAway_fg`: for `n ≥ 3`, `St_n(ℤ[1/m])` is generated by the finitely many
  `x_ij(1)` and `x_ij(1/m)`.  The coefficients `a` with every `x_ij(a)` in the subgroup form a
  subring (root additivity; multiplication by the commutator through a third index), which
  contains `1/m`, hence every `c · (1/m)^k`, hence everything (`IsLocalization.Away.surj`).
* `czK2Fng_succ_of_le_map`: over any ring, if `K₂(n)` is the normal closure of a finite `s` and
  `K₂(n+1) ≤ stab K₂(n)`, then `K₂(n+1) = ⟪stab '' s⟫`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup
open scoped commutatorElement

/-- **Tietze with a finitely generated source.**  A surjection from a finitely generated group
onto a finitely presented group has finitely normally generated kernel. -/
theorem czK2Fng_ker_of_fg {E W : Type*} [Group E] [Group W] [hE : Group.FG E]
    [Group.IsFinitelyPresented W] (f : E →* W) (hf : Function.Surjective f) :
    f.ker.IsFinitelyNormallyGenerated := by
  obtain ⟨α, hα, φ, hφ⟩ := (Group.fg_iff_exists_freeGroup_hom_surjective_finite (G := E)).mp hE
  have hcomp : Function.Surjective (f.comp φ) := hf.comp hφ
  have hker : (f.comp φ).ker.IsFinitelyNormallyGenerated :=
    Tietze.isFinitelyNormallyGenerated_ker (f.comp φ) hcomp
  have hmap : ((f.comp φ).ker).map φ = f.ker := by
    rw [← MonoidHom.comap_ker f φ]
    exact Subgroup.map_comap_eq_self_of_surjective hφ _
  rw [← hmap]
  exact hker.map hφ

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_ker_of_fg

/-- If `St_I(R)` is finitely generated and `E_I(R)` is finitely presented, then `K₂(I, R)` is
finitely normally generated in `St_I(R)`. -/
theorem czK2Fng_k2_of_fg_of_fp {I R : Type*} [Fintype I] [DecidableEq I] [Ring R]
    [Group.FG (SteinbergGroup I R)] [Group.IsFinitelyPresented (elementaryGroup I R)] :
    (K2 I R).IsFinitelyNormallyGenerated :=
  czK2Fng_ker_of_fg (projection (I := I) (R := R)) projection_surjective

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_k2_of_fg_of_fp

/-- **`St_n(ℤ[1/m])` is finitely generated for `n ≥ 3`**, by the `x_ij(1)` and `x_ij(1/m)`. -/
theorem czK2Fng_steinbergAway_fg (m n : ℕ) (hn : 2 < n) :
    Group.FG (SteinbergGroup (Fin n) (Localization.Away (m : ℤ))) := by
  classical
  obtain ⟨u, hu1⟩ : ∃ u : Localization.Away (m : ℤ),
      algebraMap ℤ (Localization.Away (m : ℤ)) (m : ℤ) * u = 1 :=
    ⟨_, IsLocalization.Away.mul_invSelf (m : ℤ)⟩
  let f : {p : Fin n × Fin n // p.1 ≠ p.2} × Bool →
      SteinbergGroup (Fin n) (Localization.Away (m : ℤ)) :=
    fun q ↦ x q.1.1.1 q.1.1.2 q.1.2 (cond q.2 1 u)
  let H : Subgroup (SteinbergGroup (Fin n) (Localization.Away (m : ℤ))) :=
    Subgroup.closure (Set.range f)
  have hgen : ∀ (b : Bool) (i j : Fin n) (h : i ≠ j), x i j h (cond b 1 u) ∈ H :=
    fun b i j h ↦ Subgroup.subset_closure ⟨(⟨(i, j), h⟩, b), rfl⟩
  let C : Subring (Localization.Away (m : ℤ)) :=
    { carrier := {a | ∀ (i j : Fin n) (h : i ≠ j), x i j h a ∈ H}
      mul_mem' := by
        intro a b ha hb i j hij
        obtain ⟨k, hki, hkj⟩ := Fin.exists_ne_and_ne_of_two_lt i j hn
        have hik : i ≠ k := hki.symm
        have hc : ⁅x i k hik a, x k j hkj b⁆ ∈ H := by
          rw [commutatorElement_def]
          exact H.mul_mem
            (H.mul_mem (H.mul_mem (ha i k hik) (hb k j hkj)) (H.inv_mem (ha i k hik)))
            (H.inv_mem (hb k j hkj))
        rw [x_commutator i k j hik hkj hij] at hc
        exact hc
      one_mem' := by
        intro i j hij
        exact hgen true i j hij
      add_mem' := by
        intro a b ha hb i j hij
        rw [← x_mul]
        exact H.mul_mem (ha i j hij) (hb i j hij)
      zero_mem' := by
        intro i j hij
        rw [x_zero]
        exact H.one_mem
      neg_mem' := by
        intro a ha i j hij
        rw [x_neg]
        exact H.inv_mem (ha i j hij) }
  have huC : u ∈ C := by
    intro i j hij
    exact hgen false i j hij
  have hC : ∀ z : Localization.Away (m : ℤ), z ∈ C := by
    intro z
    obtain ⟨k, c, hc⟩ := IsLocalization.Away.surj (m : ℤ) z
    have hz : z = algebraMap ℤ (Localization.Away (m : ℤ)) c * u ^ k := by
      rw [← hc, mul_assoc, ← mul_pow, hu1, one_pow, mul_one]
    rw [hz, eq_intCast (algebraMap ℤ (Localization.Away (m : ℤ))) c]
    exact C.mul_mem (intCast_mem C c) (pow_mem huC k)
  have hH : H = ⊤ := by
    apply top_unique
    intro g _
    apply PresentedGroup.generated_by
      (relations (I := Fin n) (R := Localization.Away (m : ℤ))) H ?_ g
    rintro ⟨i, j, hij, a⟩
    change x i j hij a ∈ H
    exact hC a i j hij
  exact Group.fg_iff.mpr ⟨Set.range f, hH, Set.finite_range f⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_steinbergAway_fg

/-- **One stability step, any ring.**  Finite normal generation of `K₂(n, R)` in `St_n(R)` and
`K₂(n+1, R) ≤ stab K₂(n, R)` give finite normal generation of `K₂(n+1, R)` in `St_{n+1}(R)`. -/
theorem czK2Fng_succ_of_le_map {R : Type*} [Ring R] {n : ℕ}
    (hfn : (K2 (Fin n) R).IsFinitelyNormallyGenerated)
    (hsurj : K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R)) :
    (K2 (Fin (n + 1)) R).IsFinitelyNormallyGenerated := by
  obtain ⟨s, hsfin, hs⟩ := hfn
  have hsK : s ⊆ K2 (Fin n) R := by
    intro k hk
    rw [← hs]
    exact Subgroup.subset_normalClosure hk
  refine ⟨stab n R '' s, hsfin.image _, le_antisymm ?_ ?_⟩
  · apply Subgroup.normalClosure_le_normal
    rintro _ ⟨k, hk, rfl⟩
    exact (K2Stab n R ⟨k, hsK hk⟩).2
  · calc K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R) := hsurj
      _ = (Subgroup.normalClosure s).map (stab n R) := by rw [hs]
      _ ≤ Subgroup.normalClosure (stab n R '' s) := Subgroup.map_normalClosure_le _ _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2Fng_succ_of_le_map

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
