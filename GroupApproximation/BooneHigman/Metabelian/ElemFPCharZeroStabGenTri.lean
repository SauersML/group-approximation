import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroStabGenSupport
import GroupApproximation.BooneHigman.Metabelian.ElemFPK2SurjStabCollapseEndpoint
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2FngEndpoint
import GroupApproximation.Meta.AxiomGuard

/-!
# The rank-two collapse gap reduced to a `K₂`-free matrix statement (lane bh-met-90d)

`SurjStabCollapseTriStatement` (lane bh-met-89) says that a word
`T = Y_{e_i α + e_k δ} X_{e_i ζ + e_k η} Y_{e_i β} X_{e_i γ}` of `St_{n+1}(ℤ[1/m])` lies in
`S = H X Y X Y H` (`SurjStabLengthMem`).  That is an equality in the Steinberg group, so it
carries `K₂` content.  This file removes all of that `K₂` content.

## The new residual `CZStabGenTriOffStatement`

We only ask for an `H X Y X Y H` word `q` with the same **matrix** as `T`
(`projection q = projection T`).  In addition, every factor of `q` must be supported off
some index `j ∉ {i, k}`.  Then `T q⁻¹ ∈ K₂(n+1)` lies in the subgroup generated by the roots
avoiding `j.castSucc`.  The support lemma `czStabGen_mem_map_of_off` (any ring, any `n`,
proved in `ElemFPCharZeroStabGenSupport` by a Weyl-element conjugation plus the centrality
of `stab K₂`) puts it in `stab K₂(n)`.  So `T = stab k · q ∈ S`
(`czStabGen_surjStabLength_of_off`).

## Strength (LOUD)

* **Not a logical weakening of the Tri statement per instance.**  It asks for extra support
  data (`j`, and factors vanishing at `j`), but it asks only for matrix equality.  The two
  are incomparable as per-instance claims.  As closed Statements both are true.
* **Strictly smaller in proof content.**  It mentions no `K₂` at all: it is a statement about
  elementary matrices over `ℤ[1/m]` (for `g₁, g₂`, only their images matter, plus membership
  in the root subgroup avoiding `j`).  All of the Steinberg-level lifting is discharged here.
* **Not an equivalent restatement** of any existing Statement, and **not the unit-symbol
  route**.  It uses no literature input: in particular, van der Kallen's theorem is not used.

## Truth check (explicit decomposition, checked by computer)

We have `n ≥ 4`.  Pick distinct `j, j' ∉ {i, k}`.  The matrix `M = proj T` is `1` outside
`{i, k, L}` (with `L = last`).  Write `M⁻¹`'s last row on `{i, k, L}` as `(a, b, e)`, so that
`a c_i + b c_k + e c_L = 1`, where `c` is the last column of `M`.  Set:

* `X1 = X_{e_{j'}}` and `Y2 = Y_{a e_i + b e_k + (e - 1) e_{j'}}`;
* `X3 = X_{-u}`, where `u` is the upper part of the last column of `Y2 X1 M` (whose `L`-entry is `1`);
* `Y4 = Y_{r A⁻¹}`.

Then `M = X1⁻¹ Y2⁻¹ X3⁻¹ Y4 · diag(A, 1)`, where `A ∈ SL₃(ℤ[1/m])` sits on `{i, k, j'}` and
`r` is the last row of `X3 Y2 X1 M`.  Every vector vanishes at `j`.  `A` lies in `E₃` on
`{i, k, j'}` because `ℤ[1/m]` is Euclidean: row reduction gives a unit upper-triangular matrix.
So `g₂` is a product of roots inside `{i, k, j'}`, hence avoiding `j`, and `g₁ = 1`.

This was checked for `m ∈ {1, 2, 3, 5, 6, 10}`, with 40 random parameter tuples each
(`n = 4`, `i = 0`, `k = 1`, `j' = 2`, `j = 3`), in exact arithmetic over `ℤ[1/m]`.  The check
covered the identity, the vanishing at `j`, `det A = 1`, integrality in `ℤ[1/m]`, and a
successful Euclidean reduction of `A`.

## Endpoint

`czStabGen_posStabGen_of_rankFour_triOff`: `CharZeroK2PosStabGenStatement` follows from
`CZK2FngRankFourStatement` together with `CZStabGenTriOffStatement`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.SteinbergGroup GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.PaddedCentral

section General

variable {R : Type*} [Ring R] {n : ℕ}

/-- Suppose an `H X Y X Y H` word is supported off `j.castSucc` and has the same matrix as an
element `y` of the root subgroup avoiding `j.castSucc`.  Then `y ∈ S`.  This holds over any
ring. -/
theorem czStabGen_surjStabLength_of_off (j : Fin n) {y : St (n + 1) R}
    (hy : y ∈ czStabGen_off R j.castSucc) (g₁ g₂ : St n R) (v w c w' : Fin n → R)
    (hg₁ : g₁ ∈ czStabGen_off R j) (hg₂ : g₂ ∈ czStabGen_off R j) (hv : v j = 0)
    (hw : w j = 0) (hc : c j = 0) (hw' : w' j = 0)
    (hproj : projection (stab n R g₁ * padCol v * padRow w * padCol c * padRow w' *
      stab n R g₂) = projection y) :
    SurjStabLengthMem y := by
  obtain ⟨q, hqdef⟩ : ∃ q : St (n + 1) R,
      q = stab n R g₁ * padCol v * padRow w * padCol c * padRow w' * stab n R g₂ := ⟨_, rfl⟩
  rw [← hqdef] at hproj
  have hq : q ∈ czStabGen_off R j.castSucc := by
    rw [hqdef]
    exact mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (czStabGen_stab_mem_off hg₁)
      (czStabGen_padCol_mem_off hv)) (czStabGen_padRow_mem_off hw))
      (czStabGen_padCol_mem_off hc)) (czStabGen_padRow_mem_off hw'))
      (czStabGen_stab_mem_off hg₂)
  have hK : y * q⁻¹ ∈ K2 (Fin (n + 1)) R := by
    rw [mem_K2_iff, map_mul, map_inv, ← hproj, mul_inv_cancel]
  obtain ⟨k0, _, hk0⟩ :=
    Subgroup.mem_map.mp (czStabGen_mem_map_of_off j hK (mul_mem hy (inv_mem hq)))
  have hyq : y = stab n R k0 * q := by rw [hk0, inv_mul_cancel_right]
  rw [hyq]
  exact surjStabLength_mem_stab_mul ⟨g₁, g₂, v, w, c, w', hqdef⟩ k0

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGen_surjStabLength_of_off

end General
