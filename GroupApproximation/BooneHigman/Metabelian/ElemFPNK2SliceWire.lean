import GroupApproximation.BooneHigman.Metabelian.ElemFPNK2SliceLevel
import GroupApproximation.BooneHigman.Metabelian.ElemFPNK2CoreWire
import GroupApproximation.Meta.AxiomGuard

/-!
# The slice `NK₂` residual at cofinally many levels only

Lane `bh-met-90t`, wiring.

* `nk2Slice_CofinalOverStatement A`: for every `n₀`, the slice residual holds at **some** level
  `n ≥ n₀` (`nk2Slice_LevelStatement A n`).
* `nk2Slice_sliceOver_of_cofinalOver`: given `hres`, it gives the full slice residual
  `nk2Core_SliceOverStatement A`.  At level `n₀`, pick `n ≥ n₀` from the hypothesis; the level
  gives death at level `n` (`nk2Slice_dies_of_level`), which descends to death at level `n₀`
  (`nk2Slice_dies_of_dies_le`, the cone `s_0 ↦ s_0 s_{n+1}` and its retraction), which gives
  the level `n₀` with `s = 1` (`nk2Slice_level_of_dies`).
* `nk2Slice_cofinalOver_of_sliceOver`: the converse (take `n = n₀`).
* `nk2Slice_CofinalStatement`, `nk2Slice_slice_of_cofinal`, `nk2Slice_cofinal_of_slice`: the same
  over every `ℤ[1/m]` (`m ≥ 1`) and every `F_p`.
* `Envelope.nk2Slice_finitelyPresentedMetabelian`: the root
  `Envelope.nk2Core_finitelyPresentedMetabelian` with `hU` replaced by the cofinal residual.

## LOUD: strength

`nk2Slice_CofinalStatement ↔ nk2Core_SliceStatement` (both directions proved).  The new residual
is **logically equivalent**, **not** strictly weaker.  It is strictly smaller in proof content:
a proof may skip every level below any level it treats (e.g. only even `n`, or only `n ≥ 10^6`);
the skipped levels are derived here by the ring-generic cone descent.  **No regularity content is
proved.**  The residual is still Quillen's `NK₂ = 0` for `ℤ[1/m][s_1..s_k]` and
`F_p[s_1..s_k]` (in local unstable form), now at cofinally many `k`.

## Why regularity content is not proved (the lane target)

The suggested route (localize at `𝔪`, finite residue fields, reduce to `K₂` of a polynomial ring
over a local ring, then Euclid in `St(k[t])`) needs, beyond `K₂(k[t]) = K₂(k)` for a field `k`,
the passage from the residue field `k = B/𝔪` back to the local ring `B_𝔪`.  That passage is
Quillen's dévissage/localization or a Suslin–Vorst–van der Kallen type argument, and it is where
regularity enters: over `B = F_p[ε]/(ε²)`, `p` odd, `NK₂(B) ≠ 0` (module
`ElemFPNK2CoreSlice`, remark), although `K₂(F_p[t]) = K₂(F_p)` holds.  So the field case alone
does not reach the residual.  Even the field case `K₂(n + 5, F_p[t])` generated by `K₂(n + 5, F_p)`
is not in the repository (only `K₂(N, F_p) = 1`, `N ≥ 5`, module `ElemFPFieldK2*`), and the
cone descent here goes **downward** in the number of variables, so low levels (such as the
one-variable level `n = 0`) do not feed the higher ones.

## Truth check

True: by the equivalence it is `nk2Core_SliceStatement`, which is equivalent to
`nk2Unify_ConeStatement`, true by Quillen's `NK₂ = 0` for regular rings.  Smallest instance:
`A = F_p`, `n₀ = 0`, choose `n = 0`: `v ∈ K₂(5, F_p[s_0])` with `v(0) = 1` is `1`, and `s = 1`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.Metabelian.ElemFP

section Over

variable (A : Type*) [CommRing A]

/-- **The cofinal slice residual over `A`**: the slice residual at cofinally many levels. -/
def nk2Slice_CofinalOverStatement : Prop :=
  ∀ n₀ : ℕ, ∃ n : ℕ, n₀ ≤ n ∧ nk2Slice_LevelStatement A n

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.nk2Slice_CofinalOverStatement

/-- **The reduction over `A`.**  Given `hres`, the cofinal slice residual gives the slice
residual at every level. -/
theorem nk2Slice_sliceOver_of_cofinalOver
    (hres : ∀ k : ℕ, ∀ P : Ideal (MvPolynomial (Fin k) A), P.IsMaximal →
      ∃ p : ℕ, p.Prime ∧ (p : MvPolynomial (Fin k) A) ∈ P)
    (h : nk2Slice_CofinalOverStatement A) : nk2Core_SliceOverStatement A := by
  refine (nk2Slice_sliceOver_iff_level A).mpr fun n₀ ↦ ?_
  obtain ⟨n, hle, hn⟩ := h n₀
  exact nk2Slice_level_of_dies A
    (nk2Slice_dies_of_dies_le A hle (nk2Slice_dies_of_level A hres hn))

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.nk2Slice_sliceOver_of_cofinalOver

/-- Conversely, the slice residual gives the cofinal slice residual (take `n = n₀`). -/
theorem nk2Slice_cofinalOver_of_sliceOver (h : nk2Core_SliceOverStatement A) :
    nk2Slice_CofinalOverStatement A :=
  fun n₀ ↦ ⟨n₀, le_refl n₀, (nk2Slice_sliceOver_iff_level A).mp h n₀⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.nk2Slice_cofinalOver_of_sliceOver

end Over

/-- **The cofinal slice residual** over every `ℤ[1/m]`, `m ≥ 1`, and every prime field `F_p`. -/
def nk2Slice_CofinalStatement : Prop :=
  (∀ m : ℕ, 0 < m → nk2Slice_CofinalOverStatement (Localization.Away (m : ℤ))) ∧
    ∀ p : ℕ, p.Prime → nk2Slice_CofinalOverStatement (ZMod p)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.nk2Slice_CofinalStatement

/-- **Endpoint (lane `bh-met-90t`).**  The cofinal slice residual gives the slice residual. -/
theorem nk2Slice_slice_of_cofinal (h : nk2Slice_CofinalStatement) : nk2Core_SliceStatement :=
  ⟨fun m hm ↦ nk2Slice_sliceOver_of_cofinalOver _
      (fun _ P hP ↦ czCubeLocal_exists_prime_mem (m : ℤ) P hP) (h.1 m hm),
    fun p hp ↦ nk2Slice_sliceOver_of_cofinalOver _ (nk2Unify_hres_zmod p hp) (h.2 p hp)⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.nk2Slice_slice_of_cofinal

/-- Conversely (**LOUD**: equivalence), the slice residual gives the cofinal slice residual. -/
theorem nk2Slice_cofinal_of_slice (h : nk2Core_SliceStatement) : nk2Slice_CofinalStatement :=
  ⟨fun m hm ↦ nk2Slice_cofinalOver_of_sliceOver _ (h.1 m hm),
    fun p hp ↦ nk2Slice_cofinalOver_of_sliceOver _ (h.2 p hp)⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.nk2Slice_cofinal_of_slice

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

/-- **The root with the cofinal slice `NK₂` residual.**  `nk2Core_finitelyPresentedMetabelian`
with the slice residual `hU` replaced by the cofinal slice residual. -/
theorem nk2Slice_finitelyPresentedMetabelian
    (hH : Absorption.SuslinLocalHorrocksStatement)
    (hvdk : ElemFP.VdKRowExtensionStatement)
    (hgen : ElemFPCharZero.CharZeroK2PosStabGenStatement)
    (hU : ElemFPCharZero.nk2Slice_CofinalStatement)
    (hstab : ∀ m : ℕ, 0 < m →
      ElemFPCharZero.CZCubePosStabOverStatement (Localization.Away (m : ℤ)))
    (hswap : HigmanVSwapSectionStatement) : FinitelyPresentedMetabelianStatement :=
  nk2Core_finitelyPresentedMetabelian hH hvdk hgen
    (ElemFPCharZero.nk2Slice_slice_of_cofinal hU) hstab hswap

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Envelope.nk2Slice_finitelyPresentedMetabelian

end GroupApproximation.BooneHigman.Metabelian.Envelope
