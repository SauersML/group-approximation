import GroupApproximation.Leavitt.ElementaryGroup
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Tactic.Group
import GroupApproximation.Meta.AxiomGuard

/-!
# Suslin dilation, analytic half, part 1: the commutator estimate

Lane `bh-met-76`.  Fix a ring homomorphism `φ : T → T'` of commutative rings and `s ∈ T`.
The *level-`K` subgroup* `suslinDilAnLevel φ s N K ≤ GL_N(T')` is generated by the elementary
matrices `e_{ij}(φ(s^K b))`, `b ∈ T`; it lies in the image of `E_N(T)`.

**Suslin's commutator estimate** (`suslinDilAn_conjBound_of_mem`, `N ≥ 3`).  Assume every
`c ∈ T'` has a power `φ(s)^t` with `c φ(s)^t ∈ φ(T)`.  Then for every `γ ∈ E_N(T')` and every
level `K'` there is a level `K` with `γ G_K γ⁻¹ ⊆ G_{K'}`.  On a generator `γ = e_{pq}(c)` with
`c φ(s)^t = φ(a)`, the level `2(K' + t)` works: conjugating `e_{kl}(y)` is computed by the three
identities below, and in the case `(k, l) = (q, p)` one first splits
`e_{qp}(uv) = [e_{qm}(u), e_{mp}(v)]` through a third index `m`.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

open scoped commutatorElement

section Identities

variable {R : Type*} [Ring R] {N : ℕ}

theorem suslinDilAn_elementaryUnit_inv (i j : Fin N) (h : i ≠ j) (a : R) :
    (elementaryUnit i j h a)⁻¹ = elementaryUnit i j h (-a) :=
  inv_eq_of_mul_eq_one_right (by rw [elementaryUnit_mul, add_neg_cancel, elementaryUnit_zero])

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_elementaryUnit_inv

/-- Disjoint indices: `e_{pq}(c)` commutes with `e_{kl}(y)` when `q ≠ k` and `l ≠ p`. -/
theorem suslinDilAn_conj_commute (p q k l : Fin N) (hpq : p ≠ q) (hkl : k ≠ l)
    (hqk : q ≠ k) (hlp : l ≠ p) (c y : R) :
    elementaryUnit p q hpq c * elementaryUnit k l hkl y * (elementaryUnit p q hpq c)⁻¹ =
      elementaryUnit k l hkl y := by
  apply Units.ext
  change (1 + Matrix.single p q c) * (1 + Matrix.single k l y) * (1 - Matrix.single p q c) =
    1 + Matrix.single k l y
  have hAA := single_mul_self_eq_zero p q hpq c
  have hAB : Matrix.single p q c * Matrix.single k l y = 0 :=
    Matrix.single_mul_single_of_ne (c := c) p q k hqk y
  have hBA : Matrix.single k l y * Matrix.single p q c = 0 :=
    Matrix.single_mul_single_of_ne (c := y) k l p hlp c
  noncomm_ring [hAA, hAB, hBA]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_commute

/-- Row case: `e_{pq}(c) e_{ql}(y) e_{pq}(c)⁻¹ = e_{pl}(cy) e_{ql}(y)` for `l ≠ p`. -/
theorem suslinDilAn_conj_row (p q l : Fin N) (hpq : p ≠ q) (hql : q ≠ l) (hpl : p ≠ l)
    (c y : R) :
    elementaryUnit p q hpq c * elementaryUnit q l hql y * (elementaryUnit p q hpq c)⁻¹ =
      elementaryUnit p l hpl (c * y) * elementaryUnit q l hql y := by
  apply Units.ext
  change (1 + Matrix.single p q c) * (1 + Matrix.single q l y) * (1 - Matrix.single p q c) =
    (1 + Matrix.single p l (c * y)) * (1 + Matrix.single q l y)
  have hAA := single_mul_self_eq_zero p q hpq c
  have hAB : Matrix.single p q c * Matrix.single q l y = Matrix.single p l (c * y) :=
    Matrix.single_mul_single_same (c := c) p q l y
  have hBA : Matrix.single q l y * Matrix.single p q c = 0 :=
    Matrix.single_mul_single_of_ne (c := y) q l p hpl.symm c
  have hZB : Matrix.single p l (c * y) * Matrix.single q l y = 0 :=
    Matrix.single_mul_single_of_ne (c := c * y) p l q hql.symm y
  noncomm_ring [hAA, hAB, hBA, hZB]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_row

/-- Column case: `e_{pq}(c) e_{kp}(y) e_{pq}(c)⁻¹ = e_{kp}(y) e_{kq}(yc)⁻¹` for `k ≠ q`. -/
theorem suslinDilAn_conj_col (p q k : Fin N) (hpq : p ≠ q) (hkp : k ≠ p) (hkq : k ≠ q)
    (c y : R) :
    elementaryUnit p q hpq c * elementaryUnit k p hkp y * (elementaryUnit p q hpq c)⁻¹ =
      elementaryUnit k p hkp y * (elementaryUnit k q hkq (y * c))⁻¹ := by
  apply Units.ext
  change (1 + Matrix.single p q c) * (1 + Matrix.single k p y) * (1 - Matrix.single p q c) =
    (1 + Matrix.single k p y) * (1 - Matrix.single k q (y * c))
  have hAA := single_mul_self_eq_zero p q hpq c
  have hAB : Matrix.single p q c * Matrix.single k p y = 0 :=
    Matrix.single_mul_single_of_ne (c := c) p q k hkq.symm y
  have hBA : Matrix.single k p y * Matrix.single p q c = Matrix.single k q (y * c) :=
    Matrix.single_mul_single_same (c := y) k p q c
  have hAV : Matrix.single p q c * Matrix.single k q (y * c) = 0 :=
    Matrix.single_mul_single_of_ne (c := c) p q k hkq.symm (y * c)
  have hBV : Matrix.single k p y * Matrix.single k q (y * c) = 0 :=
    Matrix.single_mul_single_of_ne (c := y) k p k hkp.symm (y * c)
  noncomm_ring [hAA, hAB, hBA, hAV, hBV]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_col

end Identities

section Level

variable {T T' : Type*} [CommRing T] [CommRing T'] (φ : T →+* T') (s : T) {N : ℕ}

/-- The level-`K` subgroup: generated by the `e_{ij}(φ(s^K b))`, `b ∈ T`. -/
def suslinDilAnLevel (φ : T →+* T') (s : T) (N K : ℕ) :
    Subgroup (Matrix (Fin N) (Fin N) T')ˣ :=
  Subgroup.closure
    {z | ∃ (i j : Fin N) (h : i ≠ j) (b : T), elementaryUnit i j h (φ (s ^ K * b)) = z}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAnLevel

theorem suslinDilAnLevel_unit {K : ℕ} (i j : Fin N) (h : i ≠ j) {x : T'} (b : T)
    (hx : x = φ (s ^ K * b)) : elementaryUnit i j h x ∈ suslinDilAnLevel φ s N K := by
  subst hx
  exact Subgroup.subset_closure ⟨i, j, h, b, rfl⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAnLevel_unit

theorem suslinDilAnLevel_mono {K' K : ℕ} (h : K' ≤ K) :
    suslinDilAnLevel φ s N K ≤ suslinDilAnLevel φ s N K' := by
  unfold suslinDilAnLevel
  apply Subgroup.closure_mono
  rintro _ ⟨i, j, hij, b, rfl⟩
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
  exact ⟨i, j, hij, s ^ d * b, by rw [pow_add, mul_assoc]⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAnLevel_mono

/-- Every level lies in the image of `E_N(T)`. -/
theorem suslinDilAnLevel_le_map (K : ℕ) :
    suslinDilAnLevel φ s N K ≤ (elementaryGroup (Fin N) T).map (elementaryMatrixUnitMap φ) := by
  rw [suslinDilAnLevel, Subgroup.closure_le]
  rintro _ ⟨i, j, hij, b, rfl⟩
  rw [← elementaryMatrixUnitMap_elementaryUnit φ i j hij]
  exact Subgroup.mem_map_of_mem _ (elementaryUnit_mem i j hij _)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAnLevel_le_map

/-- Conjugation estimates need only be checked on generators. -/
theorem suslinDilAn_conj_closure {G : Type*} [Group G] (g : G) {S : Set G} {H : Subgroup G}
    (hS : ∀ x ∈ S, g * x * g⁻¹ ∈ H) {x : G} (hx : x ∈ Subgroup.closure S) :
    g * x * g⁻¹ ∈ H := by
  have hle : Subgroup.closure S ≤ H.comap (MulAut.conj g).toMonoidHom :=
    (Subgroup.closure_le _).2 fun y hy ↦ by
      rw [SetLike.mem_coe, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      exact hS y hy
  have h := hle hx
  rwa [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_closure

theorem suslinDilAn_level_commute (p q k l : Fin N) (hpq : p ≠ q) (hkl : k ≠ l)
    (hqk : q ≠ k) (hlp : l ≠ p) {c y : T'} {K' : ℕ} {b : T} (h : y = φ (s ^ K' * b)) :
    elementaryUnit p q hpq c * elementaryUnit k l hkl y * (elementaryUnit p q hpq c)⁻¹ ∈
      suslinDilAnLevel φ s N K' := by
  rw [suslinDilAn_conj_commute p q k l hpq hkl hqk hlp]
  exact suslinDilAnLevel_unit φ s k l hkl b h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_level_commute

theorem suslinDilAn_level_row (p q l : Fin N) (hpq : p ≠ q) (hql : q ≠ l) (hpl : p ≠ l)
    {c y : T'} {K' : ℕ} {b₁ b₂ : T} (h₁ : c * y = φ (s ^ K' * b₁))
    (h₂ : y = φ (s ^ K' * b₂)) :
    elementaryUnit p q hpq c * elementaryUnit q l hql y * (elementaryUnit p q hpq c)⁻¹ ∈
      suslinDilAnLevel φ s N K' := by
  rw [suslinDilAn_conj_row p q l hpq hql hpl]
  exact mul_mem (suslinDilAnLevel_unit φ s p l hpl b₁ h₁)
    (suslinDilAnLevel_unit φ s q l hql b₂ h₂)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_level_row

theorem suslinDilAn_level_col (p q k : Fin N) (hpq : p ≠ q) (hkp : k ≠ p) (hkq : k ≠ q)
    {c y : T'} {K' : ℕ} {b₁ b₂ : T} (h₁ : y * c = φ (s ^ K' * b₁))
    (h₂ : y = φ (s ^ K' * b₂)) :
    elementaryUnit p q hpq c * elementaryUnit k p hkp y * (elementaryUnit p q hpq c)⁻¹ ∈
      suslinDilAnLevel φ s N K' := by
  rw [suslinDilAn_conj_col p q k hpq hkp hkq]
  exact mul_mem (suslinDilAnLevel_unit φ s k p hkp b₂ h₂)
    (inv_mem (suslinDilAnLevel_unit φ s k q hkq b₁ h₁))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_level_col

/-- The opposite case `(k, l) = (q, p)`, through a third index (`N ≥ 3`). -/
theorem suslinDilAn_level_swap (hN : 2 < N) (p q : Fin N) (hpq : p ≠ q) (hqp : q ≠ p)
    {c u v : T'} {K' : ℕ} {b₁ b₂ b₃ b₄ : T} (hu : u = φ (s ^ K' * b₁))
    (hcu : c * u = φ (s ^ K' * b₂)) (hv : v = φ (s ^ K' * b₃))
    (hvc : v * c = φ (s ^ K' * b₄)) :
    elementaryUnit p q hpq c * elementaryUnit q p hqp (u * v) * (elementaryUnit p q hpq c)⁻¹ ∈
      suslinDilAnLevel φ s N K' := by
  obtain ⟨m, hmp, hmq⟩ := Fin.exists_ne_and_ne_of_two_lt p q hN
  rw [← elementaryUnit_commutator q m p hmq.symm hmp hqp u v]
  have key : ∀ x z : (Matrix (Fin N) (Fin N) T')ˣ,
      elementaryUnit p q hpq c * ⁅x, z⁆ * (elementaryUnit p q hpq c)⁻¹ =
        ⁅elementaryUnit p q hpq c * x * (elementaryUnit p q hpq c)⁻¹,
          elementaryUnit p q hpq c * z * (elementaryUnit p q hpq c)⁻¹⁆ := by
    intro x z
    simp only [commutatorElement_def]
    group
  rw [key, commutatorElement_def]
  have h₁ := suslinDilAn_level_row φ s p q m hpq hmq.symm hmp.symm hcu hu
  have h₂ := suslinDilAn_level_col φ s p q m hpq hmp hmq hvc hv
  exact mul_mem (mul_mem (mul_mem h₁ h₂) (inv_mem h₁)) (inv_mem h₂)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_level_swap

/-- **Suslin's commutator estimate on a generator.**  If `c φ(s)^t = φ(a)`, conjugation by
`e_{pq}(c)` maps level `2(K' + t)` into level `K'`. -/
theorem suslinDilAn_conj_gen (hN : 2 < N) (p q : Fin N) (hpq : p ≠ q) {c : T'} {t : ℕ}
    {a : T} (hca : c * φ s ^ t = φ a) (K' : ℕ) {x : (Matrix (Fin N) (Fin N) T')ˣ}
    (hx : x ∈ suslinDilAnLevel φ s N (2 * (K' + t))) :
    elementaryUnit p q hpq c * x * (elementaryUnit p q hpq c)⁻¹ ∈
      suslinDilAnLevel φ s N K' := by
  unfold suslinDilAnLevel at hx
  refine suslinDilAn_conj_closure (elementaryUnit p q hpq c) ?_ hx
  rintro _ ⟨k, l, hkl, b, rfl⟩
  have e₁ : c * φ (s ^ (2 * (K' + t)) * b) = φ (s ^ K' * (a * s ^ (K' + t) * b)) := by
    simp only [map_mul, map_pow]
    rw [← hca]
    ring
  have e₁' : φ (s ^ (2 * (K' + t)) * b) * c = φ (s ^ K' * (a * s ^ (K' + t) * b)) := by
    rw [mul_comm]
    exact e₁
  have e₂ : φ (s ^ (2 * (K' + t)) * b) = φ (s ^ K' * (s ^ (K' + 2 * t) * b)) := by
    congr 1
    ring
  rcases eq_or_ne k q with hkq | hkq
  · rcases eq_or_ne l p with hlp | hlp
    · have hsplit : φ (s ^ (2 * (K' + t)) * b) = φ (s ^ (K' + t) * b) * φ (s ^ (K' + t)) := by
        rw [← map_mul]
        congr 1
        ring
      have hu : φ (s ^ (K' + t) * b) = φ (s ^ K' * (s ^ t * b)) := by
        rw [pow_add, mul_assoc]
      have hcu : c * φ (s ^ (K' + t) * b) = φ (s ^ K' * (a * b)) := by
        simp only [map_mul, map_pow]
        rw [← hca]
        ring
      have hv : φ (s ^ (K' + t)) = φ (s ^ K' * s ^ t) := by
        rw [pow_add]
      have hvc : φ (s ^ (K' + t)) * c = φ (s ^ K' * a) := by
        simp only [map_mul, map_pow]
        rw [← hca]
        ring
      subst hkq
      subst hlp
      rw [hsplit]
      exact suslinDilAn_level_swap φ s hN _ _ hpq _ hu hcu hv hvc
    · subst hkq
      exact suslinDilAn_level_row φ s _ _ _ hpq hkl hlp.symm e₁ e₂
  · rcases eq_or_ne l p with hlp | hlp
    · subst hlp
      exact suslinDilAn_level_col φ s _ _ _ hpq hkl hkq e₁' e₂
    · exact suslinDilAn_level_commute φ s p q k l hpq hkl hkq.symm hlp e₂

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_gen

/-- `γ` satisfies the conjugation bound: every level `K'` receives `γ G_K γ⁻¹` for some `K`. -/
def SuslinDilationAnalyticConjBound (φ : T →+* T') (s : T) (N : ℕ)
    (γ : (Matrix (Fin N) (Fin N) T')ˣ) : Prop :=
  ∀ K' : ℕ, ∃ K : ℕ, ∀ x ∈ suslinDilAnLevel φ s N K, γ * x * γ⁻¹ ∈ suslinDilAnLevel φ s N K'

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.SuslinDilationAnalyticConjBound

theorem suslinDilAn_conjBound_one :
    SuslinDilationAnalyticConjBound φ s N 1 := fun K' ↦
  ⟨K', fun x hx ↦ by simpa only [one_mul, inv_one, mul_one] using hx⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conjBound_one

theorem suslinDilAn_conjBound_mul {γ₁ γ₂ : (Matrix (Fin N) (Fin N) T')ˣ}
    (h₁ : SuslinDilationAnalyticConjBound φ s N γ₁)
    (h₂ : SuslinDilationAnalyticConjBound φ s N γ₂) :
    SuslinDilationAnalyticConjBound φ s N (γ₁ * γ₂) := by
  intro K'
  obtain ⟨K₁, hK₁⟩ := h₁ K'
  obtain ⟨K₂, hK₂⟩ := h₂ K₁
  refine ⟨K₂, fun x hx ↦ ?_⟩
  have h := hK₁ _ (hK₂ x hx)
  simpa only [mul_inv_rev, mul_assoc] using h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conjBound_mul

theorem suslinDilAn_conjBound_unit (hN : 2 < N)
    (hsurj : ∀ c : T', ∃ (t : ℕ) (a : T), c * φ s ^ t = φ a)
    (p q : Fin N) (hpq : p ≠ q) (c : T') :
    SuslinDilationAnalyticConjBound φ s N (elementaryUnit p q hpq c) := by
  intro K'
  obtain ⟨t, a, hca⟩ := hsurj c
  exact ⟨2 * (K' + t), fun x hx ↦ suslinDilAn_conj_gen φ s hN p q hpq hca K' hx⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conjBound_unit

/-- **Suslin's commutator estimate** (`N ≥ 3`): every `γ ∈ E_N(T')` satisfies the conjugation
bound, provided every `c ∈ T'` becomes a `φ`-image after multiplication by a power of `φ(s)`. -/
theorem suslinDilAn_conjBound_of_mem (hN : 2 < N)
    (hsurj : ∀ c : T', ∃ (t : ℕ) (a : T), c * φ s ^ t = φ a)
    {γ : (Matrix (Fin N) (Fin N) T')ˣ} (hγ : γ ∈ elementaryGroup (Fin N) T') :
    SuslinDilationAnalyticConjBound φ s N γ := by
  have hγ' : γ ∈ Subgroup.closure {z : (Matrix (Fin N) (Fin N) T')ˣ |
      ∃ (i j : Fin N) (h : i ≠ j) (a : T'), elementaryUnit i j h a = z} := hγ
  refine Subgroup.closure_induction''
    (p := fun γ _ ↦ SuslinDilationAnalyticConjBound φ s N γ) ?_ ?_ ?_ ?_ hγ'
  · rintro _ ⟨i, j, hij, c, rfl⟩
    exact suslinDilAn_conjBound_unit φ s hN hsurj i j hij c
  · rintro _ ⟨i, j, hij, c, rfl⟩
    rw [suslinDilAn_elementaryUnit_inv]
    exact suslinDilAn_conjBound_unit φ s hN hsurj i j hij (-c)
  · exact suslinDilAn_conjBound_one φ s
  · intro x y _ _ hx hy
    exact suslinDilAn_conjBound_mul φ s hx hy

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conjBound_of_mem

end Level

