import GroupApproximation.Leavitt.ElementaryGroup
import Mathlib.Algebra.Group.Subgroup.Pointwise
import GroupApproximation.Meta.AxiomGuard

/-!
# Suslin dilation, analytic half, part 1: the commutator estimate

Lane `bh-met-76`.  Fix a ring homomorphism `φ : T → T'` of commutative rings and `s ∈ T`.
The *level-`K` subgroup* `suslinDilAnLevel φ s N K ≤ GL_N(T')` is generated by the elementary
matrices `e_{ij}(φ(s^K b))`, `b ∈ T`; it lies in the image of `E_N(T)`.

**Suslin's commutator estimate** (`suslinDilAn_conjBound_of_mem`, `N ≥ 3`).  Assume every
`c ∈ T'` has a power `φ(s)^t` with `c φ(s)^t ∈ φ(T)`.  Then for every `γ ∈ E_N(T')` and every
level `K'` there is a level `K` with `γ G_K γ⁻¹ ⊆ G_{K'}`.  On a generator `γ = e_{pq}(c)` with
`c φ(s)^t = φ(a)`, the level `2(K' + t)` works: conjugating `e_{kl}(y)` is computed by the three
identities below, and in the case `(k, l) = (q, p)` one first splits
`e_{qp}(uv) = [e_{qm}(u), e_{mp}(v)]` through a third index `m`.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

open scoped commutatorElement

section Identities

variable {R : Type*} [Ring R] {N : ℕ}

theorem suslinDilAn_elementaryUnit_inv (i j : Fin N) (h : i ≠ j) (a : R) :
    (elementaryUnit i j h a)⁻¹ = elementaryUnit i j h (-a) :=
  inv_eq_of_mul_eq_one_right (by rw [elementaryUnit_mul, add_neg_cancel, elementaryUnit_zero])

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_elementaryUnit_inv

/-- Disjoint indices: `e_{pq}(c)` commutes with `e_{kl}(y)` when `q ≠ k` and `l ≠ p`. -/
theorem suslinDilAn_conj_commute (p q k l : Fin N) (hpq : p ≠ q) (hkl : k ≠ l)
    (hqk : q ≠ k) (hlp : l ≠ p) (c y : R) :
    elementaryUnit p q hpq c * elementaryUnit k l hkl y * (elementaryUnit p q hpq c)⁻¹ =
      elementaryUnit k l hkl y := by
  apply Units.ext
  change (1 + Matrix.single p q c) * (1 + Matrix.single k l y) * (1 - Matrix.single p q c) =
    1 + Matrix.single k l y
  have hAA := single_mul_self_eq_zero p q hpq c
  have hAB : Matrix.single p q c * Matrix.single k l y = 0 :=
    Matrix.single_mul_single_of_ne (c := c) p q k hqk y
  have hBA : Matrix.single k l y * Matrix.single p q c = 0 :=
    Matrix.single_mul_single_of_ne (c := y) k l p hlp c
  noncomm_ring [hAA, hAB, hBA]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_commute

/-- Row case: `e_{pq}(c) e_{ql}(y) e_{pq}(c)⁻¹ = e_{pl}(cy) e_{ql}(y)` for `l ≠ p`. -/
theorem suslinDilAn_conj_row (p q l : Fin N) (hpq : p ≠ q) (hql : q ≠ l) (hpl : p ≠ l)
    (c y : R) :
    elementaryUnit p q hpq c * elementaryUnit q l hql y * (elementaryUnit p q hpq c)⁻¹ =
      elementaryUnit p l hpl (c * y) * elementaryUnit q l hql y := by
  apply Units.ext
  change (1 + Matrix.single p q c) * (1 + Matrix.single q l y) * (1 - Matrix.single p q c) =
    (1 + Matrix.single p l (c * y)) * (1 + Matrix.single q l y)
  have hAA := single_mul_self_eq_zero p q hpq c
  have hAB : Matrix.single p q c * Matrix.single q l y = Matrix.single p l (c * y) :=
    Matrix.single_mul_single_same (c := c) p q l y
  have hBA : Matrix.single q l y * Matrix.single p q c = 0 :=
    Matrix.single_mul_single_of_ne (c := y) q l p hpl.symm c
  have hZB : Matrix.single p l (c * y) * Matrix.single q l y = 0 :=
    Matrix.single_mul_single_of_ne (c := c * y) p l q hql.symm y
  noncomm_ring [hAA, hAB, hBA, hZB]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_row

/-- Column case: `e_{pq}(c) e_{kp}(y) e_{pq}(c)⁻¹ = e_{kp}(y) e_{kq}(yc)⁻¹` for `k ≠ q`. -/
theorem suslinDilAn_conj_col (p q k : Fin N) (hpq : p ≠ q) (hkp : k ≠ p) (hkq : k ≠ q)
    (c y : R) :
    elementaryUnit p q hpq c * elementaryUnit k p hkp y * (elementaryUnit p q hpq c)⁻¹ =
      elementaryUnit k p hkp y * (elementaryUnit k q hkq (y * c))⁻¹ := by
  apply Units.ext
  change (1 + Matrix.single p q c) * (1 + Matrix.single k p y) * (1 - Matrix.single p q c) =
    (1 + Matrix.single k p y) * (1 - Matrix.single k q (y * c))
  have hAA := single_mul_self_eq_zero p q hpq c
  have hAB : Matrix.single p q c * Matrix.single k p y = 0 :=
    Matrix.single_mul_single_of_ne (c := c) p q k hkq.symm y
  have hBA : Matrix.single k p y * Matrix.single p q c = Matrix.single k q (y * c) :=
    Matrix.single_mul_single_same (c := y) k p q c
  have hAV : Matrix.single p q c * Matrix.single k q (y * c) = 0 :=
    Matrix.single_mul_single_of_ne (c := c) p q k hkq.symm (y * c)
  have hBV : Matrix.single k p y * Matrix.single k q (y * c) = 0 :=
    Matrix.single_mul_single_of_ne (c := y) k p k hkp.symm (y * c)
  noncomm_ring [hAA, hAB, hBA, hAV, hBV]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinDilAn_conj_col

end Identities
