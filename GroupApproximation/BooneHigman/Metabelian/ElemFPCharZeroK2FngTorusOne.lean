import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2FngTorusSet
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroRankFourFPReduce
import GroupApproximation.Algebra.SteinbergSL3
import Mathlib.RingTheory.Localization.Away.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# The slice `m = 1` (`ℤ[1/1] = ℤ`) of `CZK2FngRankFourStatement` (lane `bh-met-92w`, part 3)

**Proved outright.**
* `czK2FngTorus_elemThreeOne_fp`: `E_3(ℤ[1/1])` is finitely presented.  Chain:
  `SL_3(ℤ) ≃* SL_3(ℤ[1/1])` (`czK2FngTorus_slThreeOneEquiv`, coefficient transport along
  `IsLocalization.atUnit`) `≃* E_3(ℤ[1/1])` (`czRankFourFP_slEquiv`, Euclidean elimination), and
  `SL_3(ℤ)` is finitely presented by `SteinbergSL3.isFinitelyPresented_specialLinearGroup`
  (the repository's own axiom-clean `P13` descent; no literature input).
* `czK2FngTorus_k2ThreeOne_fng`: `K₂(3, ℤ[1/1])` is finitely normally generated in `St_3`.
* `czK2FngTorus_one_of_stabOne`: the residual below gives the `m = 1` slice
  `K₂(4, ℤ[1/1])` finitely normally generated.
* `czK2FngTorus_stabOne_of_le_map`: plain surjective stability `K₂(4) ≤ stab K₂(3)` (the
  hypothesis shape of `czK2Fng_succ_of_le_map`) implies the residual.

**The residual `czK2FngTorus_StabOneStatement` (LOUD).**
`K₂(4, ℤ[1/1]) ≤ ⟪stab K₂(3, ℤ[1/1])⟫ ⊔ ⟨T_1⟩`, with `T_1` the torus family `H_ab(-1)`, `H_ab(1)`.
* **It is NOT equivalent to the target, and NOT a restatement.**  It concerns only `m = 1`.
  It is a sufficient condition for the `m = 1` slice, and that slice is strictly weaker than
  `CZK2FngRankFourStatement` (it is one instance of the `∀ m`).  The residual does not
  formally follow from the slice.
* **It is smaller in proof content than the `m = 1` slice.**  The slice is equivalent, given the
  Steinberg half `czSLFourFP_stFour_one`, to `SL_4(ℤ)` being finitely presented.  The residual
  needs no presentation of any matrix group: it is a pure normal-form statement inside
  `St_4(ℤ)`, namely that every element of `K₂(4, ℤ)` is a product of conjugates of stabilised
  rank-three `K₂` elements and torus words.  The rank-three input is discharged here by the
  `SL_3(ℤ)` presentation.
* **It is weaker than plain surjective stability** (`czK2FngTorus_stabOne_of_le_map`).
* **Truth.**  `K₂(4, ℤ) ≅ ℤ/2` is generated by the symbol `{-1,-1} = H_12(-1)²`, which lies in
  `⟨T_1⟩` (Milnor, *Introduction to algebraic K-theory*, §10).  Surjective stability
  `K₂(3, ℤ) ↠ K₂(4, ℤ)` also holds (van der Kallen, `sr(ℤ) = 2`).  These are truth checks
  only; neither is a hypothesis anywhere.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup

local notation "R₁" => Localization.Away ((1 : ℕ) : ℤ)

/-- `ℤ ≃+* ℤ[1/1]`. -/
noncomputable def czK2FngTorus_oneRingEquiv : ℤ ≃+* R₁ :=
  (IsLocalization.atUnit ℤ R₁ ((1 : ℕ) : ℤ)
    (by rw [Nat.cast_one]; exact isUnit_one)).toRingEquiv

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngTorus_oneRingEquiv

/-- `SL_3(ℤ) ≃* SL_3(ℤ[1/1])` by coefficient transport. -/
noncomputable def czK2FngTorus_slThreeOneEquiv :
    Matrix.SpecialLinearGroup (Fin 3) ℤ ≃* Matrix.SpecialLinearGroup (Fin 3) R₁ where
  toFun := Matrix.SpecialLinearGroup.map czK2FngTorus_oneRingEquiv.toRingHom
  invFun := Matrix.SpecialLinearGroup.map czK2FngTorus_oneRingEquiv.symm.toRingHom
  left_inv g := Matrix.SpecialLinearGroup.ext _ _ fun i j ↦ by
    simp
  right_inv g := Matrix.SpecialLinearGroup.ext _ _ fun i j ↦ by
    simp
  map_mul' x y := map_mul (Matrix.SpecialLinearGroup.map czK2FngTorus_oneRingEquiv.toRingHom) x y

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngTorus_slThreeOneEquiv

/-- **`E_3(ℤ[1/1])` is finitely presented**, from the repository's `SL_3(ℤ)` presentation. -/
theorem czK2FngTorus_elemThreeOne_fp :
    Group.IsFinitelyPresented (elementaryGroup (Fin 3) R₁) :=
  haveI := GroupApproximation.SteinbergSL3.isFinitelyPresented_specialLinearGroup
  Group.IsFinitelyPresented.equiv
    (czK2FngTorus_slThreeOneEquiv.trans (czRankFourFP_slEquiv 1 (N := 3) (by omega)))

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngTorus_elemThreeOne_fp

/-- **`K₂(3, ℤ[1/1])` is finitely normally generated** in `St_3(ℤ[1/1])`. -/
theorem czK2FngTorus_k2ThreeOne_fng : (K2 (Fin 3) R₁).IsFinitelyNormallyGenerated :=
  haveI := czK2Fng_steinbergAway_fg 1 3 (by omega)
  haveI := czK2FngTorus_elemThreeOne_fp
  czK2Fng_k2_of_fg_of_fp

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngTorus_k2ThreeOne_fng

/-- **The residual (lane `bh-met-92w`).**  `K₂(4, ℤ[1/1])` lies in the join of the normal
closure of the stabilised `K₂(3, ℤ[1/1])` and the torus subgroup `⟨T_1⟩`.  True; not equivalent
to the target; smaller in proof content than the `m = 1` slice (see the module docstring). -/
def czK2FngTorus_StabOneStatement : Prop :=
  K2 (Fin (3 + 1)) R₁ ≤
    Subgroup.normalClosure (stab 3 R₁ '' K2 (Fin 3) R₁) ⊔
      Subgroup.closure (czK2FngTorus_torusSet (3 + 1) 1)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngTorus_StabOneStatement

/-- **Reduction of the `m = 1` slice.**  The residual gives `K₂(4, ℤ[1/1])` finitely normally
generated in `St_4(ℤ[1/1])`. -/
theorem czK2FngTorus_one_of_stabOne (h : czK2FngTorus_StabOneStatement) :
    (K2 (Fin 4) R₁).IsFinitelyNormallyGenerated :=
  czK2FngTorus_succ_of_le_sup czK2FngTorus_k2ThreeOne_fng (czK2FngTorus_torusSet (3 + 1) 1)
    (czK2FngTorus_torusSet_finite (3 + 1) 1) (czK2FngTorus_torusSet_commute (3 + 1) 1) h

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngTorus_one_of_stabOne

/-- **Strength.**  Plain surjective stability `K₂(4, ℤ[1/1]) ≤ stab K₂(3, ℤ[1/1])` implies the
residual. -/
theorem czK2FngTorus_stabOne_of_le_map
    (h : K2 (Fin (3 + 1)) R₁ ≤ (K2 (Fin 3) R₁).map (stab 3 R₁)) :
    czK2FngTorus_StabOneStatement := by
  unfold czK2FngTorus_StabOneStatement
  refine h.trans (le_sup_of_le_left ?_)
  rintro _ ⟨k, hk, rfl⟩
  exact Subgroup.subset_normalClosure ⟨k, hk, rfl⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngTorus_stabOne_of_le_map

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
