import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroRingPresentation
import GroupApproximation.BooneHigman.Metabelian.ElemFPKMIso
import GroupApproximation.Steinberg.QuotientExactness
import Mathlib.RingTheory.FinitePresentation
import GroupApproximation.Meta.AxiomGuard

/-!
# `St_{d+5}(A)` is finitely presented for every finitely presented commutative ring `A`

Lane `bh-met-17`.  Continuation of `ElemFPCharZeroRingPresentation`.

1. `polyLiftC n G : ℤ[Fin n] → Z(Q)` sends `X i` to the class of `ι i`, and
   `polyLift ∘ freeToPoly n = relQuotMk n G` (`polyLift_comp`).  It kills `G`, hence the ideal
   `(G)` (`span_le_ker_polyLiftC`).
2. If `f : ℤ[Fin n] → A` is surjective with `ker f = (G)`, then
   `ker (f ∘ freeToPoly n) = span (polyRelators n G)` (`ker_comp_freeToPoly`).
3. `St_{d+5}(ℤ⟨Fin n⟩)` is finitely presented (`ElemFP.steinbergFreeAlgebra_isFinitelyPresented`,
   lane `bh-met-06`), and the Steinberg map of a surjection with finitely generated two-sided
   kernel has finitely normally generated kernel
   (`SteinbergGroup.ringMap_ker_isFinitelyNormallyGenerated_of_ker_eq_span`).  So
   `St_{d+5}(A)` is finitely presented (`steinberg_isFinitelyPresented_of_presentation`), and in
   particular whenever `A` is a finitely presented `ℤ`-algebra
   (`steinberg_isFinitelyPresented_of_finitePresentation`, for any `ℤ`-algebra instance).
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

noncomputable section

variable (n : ℕ) (G : Set (MvPolynomial (Fin n) ℤ))

/-- The images of the generators, as central elements of `Q`. -/
def centerGen (i : Fin n) : Subring.center (RelQuot n G) :=
  ⟨relQuotMk n G (FreeAlgebra.ι ℤ i), relQuotMk_mem_center n G _⟩

/-- `ℤ[Fin n] → Z(Q)`, sending `X i` to the class of `ι i`. -/
def polyLiftC : MvPolynomial (Fin n) ℤ →+* Subring.center (RelQuot n G) :=
  MvPolynomial.eval₂Hom (Int.castRingHom (Subring.center (RelQuot n G))) (centerGen n G)

/-- `ℤ[Fin n] → Q`, sending `X i` to the class of `ι i`. -/
def polyLift : MvPolynomial (Fin n) ℤ →+* RelQuot n G :=
  (Subring.center (RelQuot n G)).subtype.comp (polyLiftC n G)

theorem polyLift_apply (P : MvPolynomial (Fin n) ℤ) :
    polyLift n G P = (polyLiftC n G P : RelQuot n G) :=
  rfl

theorem polyLift_comp (z : FreeAlgebra ℤ (Fin n)) :
    polyLift n G (freeToPoly n z) = relQuotMk n G z := by
  induction z using FreeAlgebra.induction with
  | grade0 r => simp only [eq_intCast, map_intCast]
  | grade1 i =>
      rw [freeToPoly_ι]
      exact congrArg Subtype.val
        (MvPolynomial.eval₂Hom_X' (Int.castRingHom (Subring.center (RelQuot n G)))
          (centerGen n G) i)
  | mul a b ha hb => rw [map_mul, map_mul, map_mul, ha, hb]
  | add a b ha hb => rw [map_add, map_add, map_add, ha, hb]

theorem polyLiftC_eq_zero {g : MvPolynomial (Fin n) ℤ} (hg : g ∈ G) : polyLiftC n G g = 0 := by
  apply Subtype.ext
  rw [← polyLift_apply, ← freeToPoly_liftRel n g, polyLift_comp,
    relQuotMk_relator n G (liftRel_mem_polyRelators n G hg)]
  rfl

theorem span_le_ker_polyLiftC : Ideal.span G ≤ RingHom.ker (polyLiftC n G) := by
  rw [Ideal.span_le]
  intro g hg
  exact RingHom.mem_ker.mpr (polyLiftC_eq_zero n G hg)

variable {n G}

/-- The kernel of `ℤ⟨Fin n⟩ → ℤ[Fin n] → A` is the two-sided span of `polyRelators n G`. -/
theorem ker_comp_freeToPoly {A : Type*} [Ring A] (f : MvPolynomial (Fin n) ℤ →+* A)
    (hG : Ideal.span G = RingHom.ker f) :
    TwoSidedIdeal.ker (f.comp (freeToPoly n)) = TwoSidedIdeal.span (polyRelators n G) := by
  apply le_antisymm
  · intro z hz
    rw [TwoSidedIdeal.mem_ker] at hz
    have h1 : freeToPoly n z ∈ Ideal.span G := by
      rw [hG, RingHom.mem_ker]
      exact hz
    have h2 : polyLiftC n G (freeToPoly n z) = 0 :=
      RingHom.mem_ker.mp (span_le_ker_polyLiftC n G h1)
    have h3 : z ∈ TwoSidedIdeal.ker (relQuotMk n G) := by
      rw [TwoSidedIdeal.mem_ker, ← polyLift_comp, polyLift_apply, h2]
      rfl
    rwa [ker_relQuotMk] at h3
  · rw [TwoSidedIdeal.span_le]
    rintro z (⟨g, hg, rfl⟩ | ⟨⟨i, j⟩, rfl⟩)
    · rw [SetLike.mem_coe, TwoSidedIdeal.mem_ker, RingHom.comp_apply, freeToPoly_liftRel,
        ← RingHom.mem_ker, ← hG]
      exact Ideal.subset_span hg
    · have h : freeToPoly n (FreeAlgebra.ι ℤ i * FreeAlgebra.ι ℤ j -
          FreeAlgebra.ι ℤ j * FreeAlgebra.ι ℤ i) = 0 := by
        rw [map_sub, map_mul, map_mul, freeToPoly_ι, freeToPoly_ι]
        exact sub_eq_zero.mpr (mul_comm _ _)
      rw [SetLike.mem_coe, TwoSidedIdeal.mem_ker, RingHom.comp_apply, h, map_zero]

/-- `St_{d+5}(A)` is finitely presented when `A` is a quotient of `ℤ[X_0, ..., X_{n-1}]` by the
ideal generated by a finite set. -/
theorem steinberg_isFinitelyPresented_of_presentation {A : Type*} [Ring A]
    (f : MvPolynomial (Fin n) ℤ →+* A) (hf : Function.Surjective f) (hGfin : G.Finite)
    (hG : Ideal.span G = RingHom.ker f) (d : ℕ) :
    Group.IsFinitelyPresented (SteinbergGroup (Fin (d + 5)) A) := by
  haveI := ElemFP.steinbergFreeAlgebra_isFinitelyPresented (Fin n) d
  have hsurj : Function.Surjective (f.comp (freeToPoly n)) := hf.comp (freeToPoly_surjective n)
  exact Group.IsFinitelyPresented.of_surjective
    (SteinbergGroup.ringMap (I := Fin (d + 5)) (f.comp (freeToPoly n)))
    (SteinbergGroup.ringMap_surjective_of_surjective (f.comp (freeToPoly n)) hsurj)
    (SteinbergGroup.ringMap_ker_isFinitelyNormallyGenerated_of_ker_eq_span (f.comp (freeToPoly n))
      hsurj (by rw [Fintype.card_fin]; omega) (polyRelators n G) (polyRelators_finite n G hGfin)
      (ker_comp_freeToPoly f hG))

/-- `St_{d+5}(A)` is finitely presented for a finitely presented commutative `ℤ`-algebra `A`
(for any `ℤ`-algebra instance on `A`; they all coincide). -/
theorem steinberg_isFinitelyPresented_of_finitePresentation {A : Type*} [CommRing A]
    {inst : Algebra ℤ A} (h : @Algebra.FinitePresentation ℤ A _ _ inst) (d : ℕ) :
    Group.IsFinitelyPresented (SteinbergGroup (Fin (d + 5)) A) := by
  obtain ⟨m, f, hf, hker⟩ := h.out
  obtain ⟨S, hS⟩ := hker
  exact steinberg_isFinitelyPresented_of_presentation (G := (S : Set (MvPolynomial (Fin m) ℤ)))
    f.toRingHom hf S.finite_toSet hS d

end

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

