import GroupApproximation.BooneHigman.Metabelian.VdKInjCocycleRetract
import GroupApproximation.BooneHigman.Metabelian.ElemFPK2VdKRowParInjReadout
import Mathlib.GroupTheory.SemidirectProduct
import GroupApproximation.Meta.AxiomGuard

/-!
# The parabolic presentation, part 1: the abstract group `R^n ⋊ St_n(R)`

Lane `bh-met-92g`.  Everything here is unconditional, for every commutative `R` and every `n`.

* `vdkParPres_act`: `St_n(R)` acts on `R^n` (written multiplicatively) by `v ↦ M_g v`.
* `vdkParPres_Tilde n R := R^n ⋊ St_n(R)`, a Mathlib `SemidirectProduct`.  It is the group
  presented by the generators `stab x_{ij}(a)`, `x_{i,last}(a)` of the parabolic and the
  Steinberg relations visible among them: the relations of `St_n(R)`, `x_{i,last}` additive and
  pairwise commuting, and `stab g · x(v) · stab g⁻¹ = x(M_g v)`.
* `vdkParPres_Pi : R^n ⋊ St_n(R) →* St_{n+1}(R)`, `(v, g) ↦ colVec v · stab g`.  It is
  `SemidirectProduct.lift` of `colVec` and `stab`.  The one compatibility to check is
  `stab_conj_colVec`.  On elements it is `vdkRowPar`.
* `vdkParPres_range`: its range is `P = vdkRowParSubgroup n R`.
* `vdkParPres_closure`: **`P` is generated by `stab(St_n(R))` and the `x_{i,last}(a)`**.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
  (colRoot colVec colVec_add colVec_zero projectionMatrix projectionMatrix_mul
    projectionMatrix_one stab_conj_colVec)
open scoped Matrix

variable {n : ℕ} {R : Type*} [CommRing R]

/-- The automorphism `v ↦ M_g v` of `R^n`, written multiplicatively. -/
def vdkParPres_aut (g : St n R) : MulAut (Multiplicative (Fin n → R)) where
  toFun v := Multiplicative.ofAdd (projectionMatrix g *ᵥ v.toAdd)
  invFun v := Multiplicative.ofAdd (projectionMatrix g⁻¹ *ᵥ v.toAdd)
  left_inv v := by
    change Multiplicative.ofAdd (projectionMatrix g⁻¹ *ᵥ projectionMatrix g *ᵥ v.toAdd) = v
    rw [Matrix.mulVec_mulVec, ← projectionMatrix_mul, inv_mul_cancel, projectionMatrix_one,
      Matrix.one_mulVec, ofAdd_toAdd]
  right_inv v := by
    change Multiplicative.ofAdd (projectionMatrix g *ᵥ projectionMatrix g⁻¹ *ᵥ v.toAdd) = v
    rw [Matrix.mulVec_mulVec, ← projectionMatrix_mul, mul_inv_cancel, projectionMatrix_one,
      Matrix.one_mulVec, ofAdd_toAdd]
  map_mul' a b := by
    change Multiplicative.ofAdd (projectionMatrix g *ᵥ (a.toAdd + b.toAdd)) =
      Multiplicative.ofAdd (projectionMatrix g *ᵥ a.toAdd) *
        Multiplicative.ofAdd (projectionMatrix g *ᵥ b.toAdd)
    rw [Matrix.mulVec_add, ofAdd_add]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_aut

theorem vdkParPres_aut_apply (g : St n R) (v : Multiplicative (Fin n → R)) :
    vdkParPres_aut g v = Multiplicative.ofAdd (projectionMatrix g *ᵥ v.toAdd) :=
  rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_aut_apply

/-- The action of `St_n(R)` on `R^n` through `E_n(R)`. -/
def vdkParPres_act : St n R →* MulAut (Multiplicative (Fin n → R)) where
  toFun := vdkParPres_aut
  map_one' := by
    refine MulEquiv.ext fun v ↦ ?_
    change Multiplicative.ofAdd (projectionMatrix (1 : St n R) *ᵥ v.toAdd) = v
    rw [projectionMatrix_one, Matrix.one_mulVec, ofAdd_toAdd]
  map_mul' g h := by
    refine MulEquiv.ext fun v ↦ ?_
    change Multiplicative.ofAdd (projectionMatrix (g * h) *ᵥ v.toAdd) =
      Multiplicative.ofAdd (projectionMatrix g *ᵥ projectionMatrix h *ᵥ v.toAdd)
    rw [Matrix.mulVec_mulVec, projectionMatrix_mul]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_act

variable (n R) in
/-- The abstract parabolic `P̃ = R^n ⋊ St_n(R)`. -/
abbrev vdkParPres_Tilde : Type _ :=
  SemidirectProduct (Multiplicative (Fin n → R)) (St n R) (vdkParPres_act (n := n) (R := R))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_Tilde

/-- The `St_n(R)` factor of `P̃`. -/
def vdkParPres_inr : St n R →* vdkParPres_Tilde n R :=
  SemidirectProduct.inr

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_inr

/-- `colVec` as a homomorphism out of `R^n`, written multiplicatively. -/
def vdkParPres_colHom : Multiplicative (Fin n → R) →* St (n + 1) R where
  toFun v := colVec v.toAdd
  map_one' := colVec_zero
  map_mul' a b := colVec_add a.toAdd b.toAdd

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_colHom

/-- The compatibility of `colVec` and `stab` with the action: `stab_conj_colVec`. -/
theorem vdkParPres_compat (g : St n R) :
    vdkParPres_colHom.comp (vdkParPres_act g).toMonoidHom =
      (MulAut.conj (stab n R g)).toMonoidHom.comp vdkParPres_colHom := by
  refine MonoidHom.ext fun v ↦ ?_
  change colVec (projectionMatrix g *ᵥ v.toAdd) = stab n R g * colVec v.toAdd * (stab n R g)⁻¹
  rw [stab_conj_colVec]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_compat

/-- The canonical map `Π : R^n ⋊ St_n(R) →* St_{n+1}(R)`, `(v, g) ↦ colVec v · stab g`. -/
def vdkParPres_Pi : vdkParPres_Tilde n R →* St (n + 1) R :=
  SemidirectProduct.lift vdkParPres_colHom (stab n R) vdkParPres_compat

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_Pi

theorem vdkParPres_Pi_apply (y : vdkParPres_Tilde n R) :
    vdkParPres_Pi y = vdkRowPar (y.left.toAdd, y.right) :=
  rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_Pi_apply

theorem vdkParPres_Pi_inr (g : St n R) : vdkParPres_Pi (vdkParPres_inr g) = stab n R g :=
  SemidirectProduct.lift_inr vdkParPres_colHom (stab n R) vdkParPres_compat g

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_Pi_inr

/-- The range of `Π` is the parabolic `P`. -/
theorem vdkParPres_range :
    (vdkParPres_Pi (n := n) (R := R)).range = vdkRowParSubgroup n R := by
  refine Subgroup.ext fun h ↦ ?_
  rw [MonoidHom.mem_range, mem_vdkRowParSubgroup]
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨(y.left.toAdd, y.right), rfl⟩
  · rintro ⟨⟨v, g⟩, rfl⟩
    exact ⟨⟨Multiplicative.ofAdd v, g⟩, rfl⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_range

variable (n R) in
/-- The generators of the parabolic: `stab g` and the last-column roots `x_{i,last}(a)`. -/
def vdkParPres_gens : Set (St (n + 1) R) :=
  Set.range (stab n R) ∪ Set.range (fun p : Fin n × R ↦ colRoot p.1 p.2)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_gens

theorem vdkParPres_colVec_mem_closure (v : Fin n → R) :
    colVec v ∈ Subgroup.closure (vdkParPres_gens n R) := by
  induction v using Pi.single_induction with
  | zero => rw [colVec_zero]; exact one_mem _
  | add f f' hf hf' => rw [colVec_add]; exact mul_mem hf hf'
  | single p a =>
    rw [vdkRow_colVec_single]
    exact Subgroup.mem_closure_of_mem (Set.mem_union_right _ ⟨(p, a), rfl⟩)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_colVec_mem_closure

/-- **Generation**: `P` is generated by `stab(St_n(R))` and the `x_{i,last}(a)`. -/
theorem vdkParPres_closure :
    vdkRowParSubgroup n R = Subgroup.closure (vdkParPres_gens n R) := by
  refine le_antisymm (fun h hh ↦ ?_) ((Subgroup.closure_le _).mpr ?_)
  · obtain ⟨⟨v, g⟩, rfl⟩ := (mem_vdkRowParSubgroup h).mp hh
    rw [vdkRowPar_apply]
    exact mul_mem (vdkParPres_colVec_mem_closure v)
      (Subgroup.mem_closure_of_mem (Set.mem_union_left _ ⟨g, rfl⟩))
  · rintro _ (⟨g, rfl⟩ | ⟨p, rfl⟩)
    · exact vdkInjCocycle_stab_mem_par g
    · refine (mem_vdkRowParSubgroup _).mpr ⟨(Pi.single p.1 p.2, 1), ?_⟩
      change colVec (Pi.single p.1 p.2) * stab n R 1 = colRoot p.1 p.2
      rw [map_one, mul_one, vdkRow_colVec_single]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_closure

/-- `P̃` is generated by `St_n(R)` and the basis vectors of `R^n`: every element is
`inl v · inr g`, and `inl v` is a product of `inl (e_i a)`. -/
theorem vdkParPres_tilde_eq (y : vdkParPres_Tilde n R) :
    y = SemidirectProduct.inl y.left * vdkParPres_inr y.right :=
  (SemidirectProduct.inl_left_mul_inr_right y).symm

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.vdkParPres_tilde_eq

end GroupApproximation.BooneHigman.Metabelian.ElemFP
