import Mathlib.Algebra.Algebra.Equiv
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Module.Equiv.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.LinearAlgebra.Matrix.FiniteDimensional
import GroupApproximation.Meta.AxiomGuard

/-!
# Finite commutative algebras from invariant spaces of functions (bh-met-87b)

Let `M` be an abelian group, `Q` a group acting on `M` additively via `act`, and `L` a field.
Suppose `V ⊆ (M → L)` is a finite-dimensional `L`-subspace such that:

* `V` is stable under translations `f ↦ f (· + m)`;
* `V` is stable under the action `f ↦ f ∘ act q`;
* `V` separates the points of `M`: for `m ≠ 0` some `f ∈ V` has `f m ≠ f 0`.

Then there is a finite-dimensional commutative `L`-algebra `B`, an injective
`θ : Multiplicative M →* B` and `σ : Q →* (B ≃ₐ[L] B)` with `θ (q • m) = σ q (θ m)`.

Construction:

* `T m : V → V` is the translation `f ↦ f (· + m)`.  It is linear and `T` is a monoid hom.
* `B` is the subalgebra of `Module.End L V` generated by all `T m`.  It is commutative because
  translations commute, and finite-dimensional because `V` is.
* `Ψ q : f ↦ f ∘ act q⁻¹` is a linear automorphism of `V`, and `σ q` is conjugation by `Ψ q`.
  The key identity `Ψ q ∘ T m ∘ (Ψ q)⁻¹ = T (act q m)` shows that `σ q` preserves `B`.
* `θ m = T m`.  It is injective: if `T a = T b`, evaluate at `f` and the point `-b`, which gives
  `f (a - b) = f 0` for every `f ∈ V`, so `a = b` by separation.

This is the "linear algebraic group" side of the Artin–Hasse/Witt picture.  An abelian group of
exponent `p ^ 2` has no faithful *additive* model in characteristic `p`.  Its polynomial
functions (for example `span {1, x₀, …, x₀ ^ p, x₁}` on `W₂`) nevertheless form a finite,
translation-stable, point-separating space, which is exactly the input required here.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Coprimary

open scoped IsMulCommutative

noncomputable section

section PolyFun

variable {L M Q : Type} [Field L] [AddCommGroup M] [Group Q]

/-- Precomposition with `g : M → M` on a subspace `V ⊆ (M → L)` that `g` preserves. -/
def eHighArtinHasse_precomp (V : Submodule L (M → L)) (g : M → M)
    (hg : ∀ f ∈ V, (fun x => f (g x)) ∈ V) : Module.End L V where
  toFun f := ⟨fun x => (f : M → L) (g x), hg (f : M → L) f.2⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighArtinHasse_precomp

/-- The translation representation `m ↦ (f ↦ f (· + m))` on a translation-stable `V`. -/
def eHighArtinHasse_trans (V : Submodule L (M → L))
    (htrans : ∀ m : M, ∀ f ∈ V, (fun x => f (x + m)) ∈ V) :
    Multiplicative M →* Module.End L V where
  toFun m := eHighArtinHasse_precomp V (fun x => x + Multiplicative.toAdd m)
    (htrans (Multiplicative.toAdd m))
  map_one' := LinearMap.ext fun f => Subtype.ext (funext fun x => by
    show (f : M → L) (x + Multiplicative.toAdd (1 : Multiplicative M)) = (f : M → L) x
    rw [toAdd_one, add_zero])
  map_mul' a b := LinearMap.ext fun f => Subtype.ext (funext fun x => by
    show (f : M → L) (x + Multiplicative.toAdd (a * b)) =
      (f : M → L) (x + Multiplicative.toAdd a + Multiplicative.toAdd b)
    rw [toAdd_mul, add_assoc])

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighArtinHasse_trans

/-- The linear automorphism `Ψ q : f ↦ f ∘ act q⁻¹` of an action-stable `V`. -/
def eHighArtinHasse_psi (act : Q → M → M) (hmul : ∀ q r x, act (q * r) x = act q (act r x))
    (hone : ∀ x, act 1 x = x) (V : Submodule L (M → L))
    (hact : ∀ q : Q, ∀ f ∈ V, (fun x => f (act q x)) ∈ V) (q : Q) : V ≃ₗ[L] V :=
  LinearEquiv.ofLinear (eHighArtinHasse_precomp V (act q⁻¹) (hact q⁻¹))
    (eHighArtinHasse_precomp V (act q) (hact q))
    (LinearMap.ext fun f => Subtype.ext (funext fun x => by
      show (f : M → L) (act q (act q⁻¹ x)) = (f : M → L) x
      rw [← hmul, mul_inv_cancel, hone]))
    (LinearMap.ext fun f => Subtype.ext (funext fun x => by
      show (f : M → L) (act q⁻¹ (act q x)) = (f : M → L) x
      rw [← hmul, inv_mul_cancel, hone]))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighArtinHasse_psi

/-- Conjugation by `Ψ q`, as an `L`-algebra endomorphism of `Module.End L V`. -/
def eHighArtinHasse_conj (act : Q → M → M) (hmul : ∀ q r x, act (q * r) x = act q (act r x))
    (hone : ∀ x, act 1 x = x) (V : Submodule L (M → L))
    (hact : ∀ q : Q, ∀ f ∈ V, (fun x => f (act q x)) ∈ V) (q : Q) :
    Module.End L V →ₐ[L] Module.End L V :=
  ((eHighArtinHasse_psi act hmul hone V hact q).conjAlgEquiv L).toAlgHom

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighArtinHasse_conj

/-- The key identity: `Ψ q ∘ T m ∘ (Ψ q)⁻¹ = T (act q m)`. -/
theorem eHighArtinHasse_conj_trans (act : Q → M → M)
    (hadd : ∀ q x y, act q (x + y) = act q x + act q y)
    (hmul : ∀ q r x, act (q * r) x = act q (act r x)) (hone : ∀ x, act 1 x = x)
    (V : Submodule L (M → L)) (htrans : ∀ m : M, ∀ f ∈ V, (fun x => f (x + m)) ∈ V)
    (hact : ∀ q : Q, ∀ f ∈ V, (fun x => f (act q x)) ∈ V) (q : Q) (m : Multiplicative M) :
    eHighArtinHasse_conj act hmul hone V hact q (eHighArtinHasse_trans V htrans m) =
      eHighArtinHasse_trans V htrans
        (Multiplicative.ofAdd (act q (Multiplicative.toAdd m))) := by
  refine LinearMap.ext fun f => Subtype.ext (funext fun x => ?_)
  show (f : M → L) (act q (act q⁻¹ x + Multiplicative.toAdd m)) =
    (f : M → L) (x + Multiplicative.toAdd (Multiplicative.ofAdd (act q (Multiplicative.toAdd m))))
  rw [hadd, ← hmul, mul_inv_cancel, hone, toAdd_ofAdd]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighArtinHasse_conj_trans

/-- Conjugation is multiplicative in `q`. -/
theorem eHighArtinHasse_conj_mul (act : Q → M → M)
    (hmul : ∀ q r x, act (q * r) x = act q (act r x)) (hone : ∀ x, act 1 x = x)
    (V : Submodule L (M → L)) (hact : ∀ q : Q, ∀ f ∈ V, (fun x => f (act q x)) ∈ V)
    (q r : Q) (X : Module.End L V) :
    eHighArtinHasse_conj act hmul hone V hact (q * r) X =
      eHighArtinHasse_conj act hmul hone V hact q (eHighArtinHasse_conj act hmul hone V hact r X) := by
  refine LinearMap.ext fun f => ?_
  have hs : (eHighArtinHasse_psi act hmul hone V hact (q * r)).symm f =
      (eHighArtinHasse_psi act hmul hone V hact r).symm
        ((eHighArtinHasse_psi act hmul hone V hact q).symm f) :=
    Subtype.ext (funext fun y => by
      show (f : M → L) (act (q * r) y) = (f : M → L) (act q (act r y))
      rw [hmul])
  have hp : ∀ v : V, eHighArtinHasse_psi act hmul hone V hact (q * r) v =
      eHighArtinHasse_psi act hmul hone V hact q (eHighArtinHasse_psi act hmul hone V hact r v) :=
    fun v => Subtype.ext (funext fun y => by
      show (v : M → L) (act (q * r)⁻¹ y) = (v : M → L) (act r⁻¹ (act q⁻¹ y))
      rw [mul_inv_rev, hmul])
  show eHighArtinHasse_psi act hmul hone V hact (q * r)
      (X ((eHighArtinHasse_psi act hmul hone V hact (q * r)).symm f)) =
    eHighArtinHasse_psi act hmul hone V hact q (eHighArtinHasse_psi act hmul hone V hact r
      (X ((eHighArtinHasse_psi act hmul hone V hact r).symm
        ((eHighArtinHasse_psi act hmul hone V hact q).symm f))))
  rw [hs, hp]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighArtinHasse_conj_mul
