import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2PosStabGen
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroTriOffEndpoint
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2FngGtOneRank3Step
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVStableK2.Reduction
import GroupApproximation.Meta.AxiomGuard

/-!
# `BaseFG`: rank transport and the base ring `ℤ[1/1]` (lane `bh-met-95c`, part 1)

**General lemmas.**  These hold for any rings `R`, `S`, any rank `n` and any `φ : R →+* S`.
* `czBaseFGCz_fg_succ_of_le_map`: if `K₂(n, R)` is finitely generated and surjective stability
  `K₂(n+1, R) ≤ stab K₂(n, R)` holds, then `K₂(n+1, R)` is finitely generated.
* `czBaseFGCz_fg_succ_of_fng_of_le_map`: the same conclusion from finite *normal* generation of
  `K₂(n, R)`.  It works because the stabilized `K₂` is central (`map_stab_K2_le_center`).
* `czBaseFGCz_fg_of_le_closure`: suppose `K₂(n, R)` is finitely generated, and `K₂(n, S)` lies
  in the subgroup generated by `φ(K₂(n, R))` and a finite `s ⊆ K₂(n, S)`.  Then `K₂(n, S)` is
  finitely generated.
* `czBaseFGCz_step_succ`: moves a relative normal-generation statement for `φ` from rank `n`
  to a relative generation statement at rank `n+1`, given surjective stability over `S`.  It
  uses naturality `stab ∘ φ = φ ∘ stab` (`czBaseFGCz_stab_ringMap`) and centrality.

**Over `ℤ[1/m]`, `m > 0`, all proved outright.**
* `czBaseFGCz_fg_four_one`, `czBaseFGCz_fg_five_one`: `K₂(4, ℤ[1/1])` and `K₂(5, ℤ[1/1])` are
  finitely generated.  The inputs are `czK2FngTorus_k2ThreeOne_fng`, which comes from the
  repository's `SL_3(ℤ)` presentation `P13`, and surjective stability: `czK2FngGtOne_k2_le_map`
  for `3 → 4`, and `czStabGen_k2SurjStab_of_triOff czTriOff_triOffStatement` for `n ≥ 4`.
* `czBaseFGCz_fg_ge_five`: if `K₂(5, ℤ[1/m])` is finitely generated, then so is `K₂(N, ℤ[1/m])`
  for every `N ≥ 5`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup

section General

variable {R S : Type*} [Ring R] [Ring S] {n : ℕ}

/-- Finite generation of `K₂(n, R)` and surjective stability give finite generation of
`K₂(n+1, R)`. -/
theorem czBaseFGCz_fg_succ_of_le_map (hfg : Group.FG (K2 (Fin n) R))
    (hsurj : K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R)) :
    Group.FG (K2 (Fin (n + 1)) R) := by
  obtain ⟨s, hsfin, hsK, hle⟩ := exists_finite_normalClosure_stab_of_fg_of_le_map hfg hsurj
  exact k2_fg_of_le_normalClosure_stab hsfin hsK hle

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_succ_of_le_map

/-- Finite normal generation of `K₂(n, R)` and surjective stability give finite generation of
`K₂(n+1, R)`. -/
theorem czBaseFGCz_fg_succ_of_fng_of_le_map
    (hfn : (K2 (Fin n) R).IsFinitelyNormallyGenerated)
    (hsurj : K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R)) :
    Group.FG (K2 (Fin (n + 1)) R) := by
  obtain ⟨t, htfin, ht⟩ := hfn
  have htK : t ⊆ K2 (Fin n) R := by
    rw [← ht]
    exact Subgroup.subset_normalClosure
  refine k2_fg_of_le_normalClosure_stab htfin htK ?_
  calc K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R) := hsurj
    _ = (Subgroup.normalClosure t).map (stab n R) := by rw [ht]
    _ ≤ Subgroup.normalClosure (stab n R '' t) := Subgroup.map_normalClosure_le t (stab n R)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_succ_of_fng_of_le_map

/-- **Relative finite generation.**  Suppose `K₂(n, R)` is finitely generated and `K₂(n, S)`
lies in the subgroup generated by `φ(K₂(n, R))` and a finite `s ⊆ K₂(n, S)`.  Then `K₂(n, S)`
is finitely generated. -/
theorem czBaseFGCz_fg_of_le_closure (φ : R →+* S) (hR : Group.FG (K2 (Fin n) R))
    {s : Set (St n S)} (hsfin : s.Finite) (hsK : s ⊆ K2 (Fin n) S)
    (hle : K2 (Fin n) S ≤
      Subgroup.closure (ringMap φ '' (K2 (Fin n) R : Set (St n R)) ∪ s)) :
    Group.FG (K2 (Fin n) S) := by
  obtain ⟨g, hg, hgfin⟩ := (Subgroup.fg_iff _).mp ((Group.fg_iff_subgroup_fg _).mp hR)
  refine (Group.fg_iff_subgroup_fg _).mpr ((Subgroup.fg_iff _).mpr
    ⟨ringMap φ '' g ∪ s, le_antisymm ?_ ?_, (hgfin.image _).union hsfin⟩)
  · rw [Subgroup.closure_le]
    rintro _ (⟨u, hu, rfl⟩ | hu)
    · have huK : u ∈ K2 (Fin n) R := by
        rw [← hg]
        exact Subgroup.subset_closure hu
      exact ringMap_mem_K2 φ huK
    · exact hsK hu
  · refine hle.trans ?_
    rw [Subgroup.closure_le]
    rintro _ (⟨u, hu, rfl⟩ | hu)
    · have hug : u ∈ Subgroup.closure g := by
        rw [hg]
        exact hu
      have h1 : ringMap φ u ∈ (Subgroup.closure g).map (ringMap φ) :=
        Subgroup.mem_map_of_mem _ hug
      rw [MonoidHom.map_closure] at h1
      exact Subgroup.closure_mono Set.subset_union_left h1
    · exact Subgroup.subset_closure (Set.mem_union_right _ hu)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_of_le_closure

/-- Naturality: stabilization commutes with coefficient maps. -/
theorem czBaseFGCz_stab_ringMap (φ : R →+* S) (u : St n R) :
    stab n S (ringMap φ u) = ringMap φ (stab n R u) :=
  GroupApproximation.Full.LVStableK2.indexMap_ringMap Fin.castSuccEmb φ u

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_stab_ringMap

/-- The stabilization of a subset of `K₂(n, R)` lies in `K₂(n+1, R)`. -/
theorem czBaseFGCz_stab_image_subset_K2 {s : Set (St n R)} (hsK : s ⊆ K2 (Fin n) R) :
    stab n R '' s ⊆ K2 (Fin (n + 1)) R := by
  rintro _ ⟨k, hk, rfl⟩
  exact (K2Stab n R ⟨k, hsK hk⟩).2

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_stab_image_subset_K2

/-- Normal generation at rank `n` by a subset of `K₂` becomes generation at rank `n+1`, given
surjective stability. -/
theorem czBaseFGCz_le_closure_stab_image {X : Set (St n R)} (hXK : X ⊆ K2 (Fin n) R)
    (hle : K2 (Fin n) R ≤ Subgroup.normalClosure X)
    (hsurj : K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R)) :
    K2 (Fin (n + 1)) R ≤ Subgroup.closure (stab n R '' X) :=
  calc K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R) := hsurj
    _ ≤ (Subgroup.normalClosure X).map (stab n R) := Subgroup.map_mono hle
    _ ≤ Subgroup.normalClosure (stab n R '' X) := Subgroup.map_normalClosure_le X (stab n R)
    _ = Subgroup.closure (stab n R '' X) :=
      normalClosure_eq_closure_of_subset_center (stab_image_subset_center hXK)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_le_closure_stab_image

/-- Stabilization carries `φ(K₂(n, R)) ∪ s` into `φ(K₂(n+1, R)) ∪ stab '' s`. -/
theorem czBaseFGCz_stab_image_subset (φ : R →+* S) (s : Set (St n S)) :
    stab n S '' (ringMap φ '' (K2 (Fin n) R : Set (St n R)) ∪ s) ⊆
      ringMap φ '' (K2 (Fin (n + 1)) R : Set (St (n + 1) R)) ∪ stab n S '' s := by
  rintro _ ⟨y, (⟨u, hu, rfl⟩ | hy), rfl⟩
  · exact Or.inl ⟨stab n R u, (K2Stab n R ⟨u, hu⟩).2, (czBaseFGCz_stab_ringMap φ u).symm⟩
  · exact Or.inr ⟨y, hy, rfl⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_stab_image_subset

/-- **Rank step for relative generation.**  Suppose `K₂(n, S)` lies in the normal closure of
`φ(K₂(n, R)) ∪ s` with `s ⊆ K₂(n, S)`, and surjective stability holds over `S`.  Then
`K₂(n+1, S)` lies in the subgroup generated by `φ(K₂(n+1, R)) ∪ stab '' s`. -/
theorem czBaseFGCz_step_succ (φ : R →+* S) {s : Set (St n S)} (hsK : s ⊆ K2 (Fin n) S)
    (hle : K2 (Fin n) S ≤
      Subgroup.normalClosure (ringMap φ '' (K2 (Fin n) R : Set (St n R)) ∪ s))
    (hsurj : K2 (Fin (n + 1)) S ≤ (K2 (Fin n) S).map (stab n S)) :
    K2 (Fin (n + 1)) S ≤ Subgroup.closure
      (ringMap φ '' (K2 (Fin (n + 1)) R : Set (St (n + 1) R)) ∪ stab n S '' s) := by
  have hXK : ringMap φ '' (K2 (Fin n) R : Set (St n R)) ∪ s ⊆ K2 (Fin n) S := by
    rintro _ (⟨u, hu, rfl⟩ | hu)
    · exact ringMap_mem_K2 φ hu
    · exact hsK hu
  exact (czBaseFGCz_le_closure_stab_image hXK hle hsurj).trans
    (Subgroup.closure_mono (czBaseFGCz_stab_image_subset φ s))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_step_succ

end General

/-- `K₂(4, ℤ[1/1])` is finitely generated. -/
theorem czBaseFGCz_fg_four_one :
    Group.FG (K2 (Fin (3 + 1)) (Localization.Away ((1 : ℕ) : ℤ))) :=
  czBaseFGCz_fg_succ_of_fng_of_le_map czK2FngTorus_k2ThreeOne_fng
    (czK2FngGtOne_k2_le_map (m := 1) Nat.zero_lt_one)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_four_one

/-- `K₂(5, ℤ[1/1])` is finitely generated. -/
theorem czBaseFGCz_fg_five_one :
    Group.FG (K2 (Fin (4 + 1)) (Localization.Away ((1 : ℕ) : ℤ))) :=
  czBaseFGCz_fg_succ_of_le_map czBaseFGCz_fg_four_one
    (czStabGen_k2SurjStab_of_triOff czTriOff_triOffStatement 1 4 Nat.zero_lt_one le_rfl)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_five_one

/-- Finite generation of `K₂(5, ℤ[1/m])`, `m > 0`, propagates to every rank `N ≥ 5`. -/
theorem czBaseFGCz_fg_ge_five {m : ℕ} (hm : 0 < m)
    (h5 : Group.FG (K2 (Fin 5) (Localization.Away (m : ℤ)))) :
    ∀ N : ℕ, 5 ≤ N → Group.FG (K2 (Fin N) (Localization.Away (m : ℤ))) := by
  intro N hN
  induction N, hN using Nat.le_induction with
  | base => exact h5
  | succ n hn ih =>
    exact czBaseFGCz_fg_succ_of_le_map ih
      (czStabGen_k2SurjStab_of_triOff czTriOff_triOffStatement m n hm (by omega))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czBaseFGCz_fg_ge_five

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
