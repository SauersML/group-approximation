import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2StabGenRank
import GroupApproximation.BooneHigman.Metabelian.ElemFPK2SurjStabEndpoint
import GroupApproximation.Meta.AxiomGuard

/-!
# `CharZeroK2PosStabGenStatement`: reduction to one rank of normal generation plus stability

Lane `bh-met-72c`.  Target: `CharZeroK2PosStabGenStatement` (lane `bh-met-47`): for `m ≥ 1` and
`n ≥ 4`, some finite `s ⊆ K₂(n, ℤ[1/m])` has `K₂(n+1, ℤ[1/m]) ≤ ⟪stab '' s⟫` in `St_{n+1}`.

## Results

* `CharZeroK2StabGenFNGSurjStatement`: for `m ≥ 1`,
  (i) `K₂(5, ℤ[1/m])` is the normal closure in `St_5(ℤ[1/m])` of a finite set (rank `5` only), and
  (ii) surjective stability `K₂(n+1, ℤ[1/m]) ≤ stab K₂(n, ℤ[1/m])` for `n ≥ 4`.
  **This is the isolated gap.**
* `charZeroK2PosStabGen_of_fngSurj`: the gap gives the target.  Induction on `n ≥ 4`
  (`Nat.le_induction`): the base `n = 4` is `czStabGen_base` (finite lift of the normal generating
  set along `stab`, using (ii) at `n = 4`), and the step is `czStabGen_step` (push the set up by
  `stab`, using (ii) at `n + 1` and `stab ⟪X⟫ ≤ ⟪stab X⟫`).
* `czStabGenFNGSurj_of_charZeroK2PosStabGen`: the converse (via padded centrality).
* `charZeroK2PosStabGen_of_fng_of_conjTriple`: (i) together with lane `bh-met-54`'s
  `SurjStabConjTripleStatement` (which gives (ii)) gives the target.
* `czStabGen_fng_of_fg`, `czStabGenFNGSurj_of_fg_of_surj`: finite generation of `K₂(5)` gives (i),
  so the hypotheses of `charZeroK2PosStabGen_of_fg_of_surj` (finite generation at *every* rank
  `n ≥ 4`, plus (ii)) imply the gap.

## LOUD: the gap is logically EQUIVALENT to the target

Both directions are proved (`charZeroK2PosStabGen_of_fngSurj`,
`czStabGenFNGSurj_of_charZeroK2PosStabGen`).  It is strictly smaller in proof content only.
Discharged here: the whole rank parameter `n ≥ 5` (the induction), the finite lifting of
generators from rank `5` to rank `4`, and the passage from finite normal generation to
stabilized normal generation.  What remains is split into its two classical ingredients:
(i) is an arithmetic statement at the single rank `5`, asking only for finite *normal*
generation (so no centrality and no finite generation of `K₂(4)`; standalone, (i) is weaker than
`Group.FG (K₂(5))`, see `czStabGen_fng_of_fg`); (ii) is the pure stability statement already
targeted by lane `bh-met-54`.

## Why the target is not proved outright

(ii) is Dennis–van der Kallen surjective stability for `K₂` over a ring of stable rank `≤ 2`, whose
remaining step (the `P Q P` factorization, lane `bh-met-54`) is a long Steinberg word calculation
using `sr(ℤ[1/m]) ≤ 2` (not in Mathlib).  (i) needs finiteness of `K₂(ℤ[1/m])` (Tate's
localization sequence and Milnor's `K₂(ℤ) = ℤ/2`), or finite presentation of `St_5` and `E_5`
over `ℤ[1/m]`, which is circular in this chain (lane `bh-met-36`).

## Truth check

(ii): `ℤ[1/m]` is a Dedekind domain, `sr ≤ 2`, and `K₂(n) → K₂(n+1)` is onto for `n ≥ sr + 1`,
so for `n ≥ 3`, in particular `n ≥ 4`.  **True.**  (i): by injective stability (`n ≥ sr + 2 = 4`)
`K₂(5, ℤ[1/m]) ≅ K₂(ℤ[1/m])`, an extension of `⊕_{p ∣ m} F_p^×` by `K₂(ℤ) = ℤ/2` (Tate), hence
finite, hence finitely (normally) generated.  **True.**  Sanity check `m = 1`: `K₂(5, ℤ) = ℤ/2`,
generated by `{-1,-1}` stabilized from `St_3`, so (i) holds with one generator and (ii) holds.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic

/-- **The isolated gap (lane `bh-met-72c`).**  For `m ≥ 1`: (i) `K₂(5, ℤ[1/m])` is finitely
normally generated in `St_5(ℤ[1/m])`, and (ii) `K₂(n+1, ℤ[1/m]) ≤ stab K₂(n, ℤ[1/m])` for `n ≥ 4`.
True (Tate, Milnor; Dennis–van der Kallen).  **Equivalent** to `CharZeroK2PosStabGenStatement`,
strictly smaller in proof content; see the module docstring. -/
def CharZeroK2StabGenFNGSurjStatement : Prop :=
  (∀ m : ℕ, 0 < m →
      (K2 (Fin 5) (Localization.Away (m : ℤ))).IsFinitelyNormallyGenerated) ∧
    ∀ m n : ℕ, 0 < m → 4 ≤ n →
      K2 (Fin (n + 1)) (Localization.Away (m : ℤ)) ≤
        (K2 (Fin n) (Localization.Away (m : ℤ))).map (stab n (Localization.Away (m : ℤ)))

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroK2StabGenFNGSurjStatement

/-- **Endpoint (lane `bh-met-72c`).**  The gap gives `CharZeroK2PosStabGenStatement`. -/
theorem charZeroK2PosStabGen_of_fngSurj (h : CharZeroK2StabGenFNGSurjStatement) :
    CharZeroK2PosStabGenStatement := by
  intro m n hm h4n
  induction n, h4n using Nat.le_induction with
  | base => exact czStabGen_base (n := 4) (h.1 m hm) (h.2 m 4 hm le_rfl)
  | succ n hn ih => exact czStabGen_step ih (h.2 m (n + 1) hm (by omega))

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroK2PosStabGen_of_fngSurj

/-- **LOUD converse.**  The target gives the gap, so the two are equivalent. -/
theorem czStabGenFNGSurj_of_charZeroK2PosStabGen (h : CharZeroK2PosStabGenStatement) :
    CharZeroK2StabGenFNGSurjStatement :=
  ⟨fun m hm ↦ czStabGen_fng_of_T (n := 4) (h m 4 hm le_rfl),
    fun m n hm h4n ↦ czStabGen_surj_of_T (h m n hm h4n)⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGenFNGSurj_of_charZeroK2PosStabGen

/-- (i) together with lane `bh-met-54`'s `P Q P` statement gives the target. -/
theorem charZeroK2PosStabGen_of_fng_of_conjTriple
    (hfn : ∀ m : ℕ, 0 < m →
      (K2 (Fin 5) (Localization.Away (m : ℤ))).IsFinitelyNormallyGenerated)
    (h : SurjStabConjTripleStatement) : CharZeroK2PosStabGenStatement :=
  charZeroK2PosStabGen_of_fngSurj ⟨hfn, charZeroK2SurjStab_of_conjTriple h⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroK2PosStabGen_of_fng_of_conjTriple

/-- Finite generation of `K₂(5, ℤ[1/m])` gives (i). -/
theorem czStabGen_fng_of_fg
    (hfg : ∀ m : ℕ, 0 < m → Group.FG (K2 (Fin 5) (Localization.Away (m : ℤ))))
    (m : ℕ) (hm : 0 < m) :
    (K2 (Fin 5) (Localization.Away (m : ℤ))).IsFinitelyNormallyGenerated := by
  haveI := hfg m hm
  exact Subgroup.IsFinitelyNormallyGenerated.of_FG _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGen_fng_of_fg

/-- The hypotheses of `charZeroK2PosStabGen_of_fg_of_surj` imply the gap: only rank `5` of the
finite generation hypothesis is used, and only in its normal form. -/
theorem czStabGenFNGSurj_of_fg_of_surj
    (hfg : ∀ m n : ℕ, 0 < m → 4 ≤ n → Group.FG (K2 (Fin n) (Localization.Away (m : ℤ))))
    (hsurj : ∀ m n : ℕ, 0 < m → 4 ≤ n →
      K2 (Fin (n + 1)) (Localization.Away (m : ℤ)) ≤
        (K2 (Fin n) (Localization.Away (m : ℤ))).map (stab n (Localization.Away (m : ℤ)))) :
    CharZeroK2StabGenFNGSurjStatement :=
  ⟨czStabGen_fng_of_fg fun m hm ↦ hfg m 5 hm (by omega), hsurj⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGenFNGSurj_of_fg_of_surj

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
