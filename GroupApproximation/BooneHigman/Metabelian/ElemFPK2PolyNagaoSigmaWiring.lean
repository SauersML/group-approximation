import GroupApproximation.BooneHigman.Metabelian.ElemFPK2PolyNagaoSigmaLm
import GroupApproximation.Meta.AxiomGuard

/-!
# Nagao normal forms for `K₂(F_p[X])`, part 6: the rank-one Weyl residual and its wiring

Lane `bh-met-92q`.  Notation of `ElemFPK2PolyEuclidGen` and `ElemFPK2PolyNagaoSigmaDef`.

* `k2PolyNagaoSigma_WeylStatement` (**the rank-one residual**): for `K = {m}`, the coset
  check of the single Weyl element `W' = w_mL(-1)` against the explicit Euclidean section
  `σ = k2PolyNagaoSigma_sigma`, only at the orbit vectors with `deg v L ≤ deg v m`.
* `k2PolyNagaoSigma_WideStatement`: `k2PolyNagao_MonoStatement` for `|K| ≥ 2`, **UNCHANGED**
  (`k2PolyNagaoSigma_wide_of_mono` proves it from `k2PolyNagao_MonoStatement`).
* `k2PolyNagaoSigma_gens_of_weyl`: for `K = {m}`, the residual gives `k2PolyNagao_Gens` for `σ`:
  the whole `x_Lm` family is `k2PolyNagaoSigma_check_Lm`, the Weyl check at
  `deg v m < deg v L` is `k2PolyNagaoSigma_check_W_lt`, and `x_mL(1) = W' x_Lm(-1) W'⁻¹`.
* `k2PolyNagaoSigma_mono_of_statement`: `Wide ∧ Weyl` gives `k2PolyNagao_MonoStatement`; hence
  `k2PolyNF_StabStatement` and `K₂(N, F_p[X]) = ⊥` for `N ≥ 5`.

**LOUD.**
- The `|K| ≥ 2` part of lane target (a) is NOT proved.  It is carried as
  `k2PolyNagaoSigma_WideStatement`, which is `k2PolyNagao_MonoStatement` restricted to
  `|K| ≥ 2`: an unchanged restatement of that case.
- `k2PolyNagaoSigma_WeylStatement` is TRUE.  It is logically equivalent, as all true
  statements are, and STRICTLY SMALLER IN PROOF CONTENT than the `K = {m}` case of
  `k2PolyNagao_MonoStatement`:
  - `σ` is explicit;
  - the checks of `x_Lm(1)`, `x_Lm(X)` and all `x_Lm(X^k)` are proved (`check_Lm`);
  - `x_mL(1)` is reduced to `W'`;
  - of the Weyl check, only the half `deg v L ≤ deg v m` remains.
  It is a statement about words in `St_2`-type generators `x_mL, x_Lm` only.

**Truth of the residual.**  Let `G` be the subgroup generated by `x_mL(f)`, `x_Lm(f)`.
- Nagao: `SL₂(F_p[X]) = SL₂(F_p) *_{B(F_p)} B(F_p[X])`.
- The constant-`K₂` hypothesis makes both factors, and so `SL₂(F_p[X])`, lift isomorphically
  into `G`.  The Borel factor uses `k2PolyDeg_h_conj_exists` and the constant symbols
  `{u, v}`.  Hence `G ∩ K₂ = 1`.
- The check element lies in `G` and fixes `e_L`, because `σ(v) e_L = v` on the orbit (see
  `bh-met-92q/chk.py`).  So its matrix is `1 + c E_Lm`, and the element is `x_Lm(c) ∈ Q`.

**Checks.**  Scratchpad `bh-met-92q/chk.py`, over `F_2`, `F_3` with degree `≤ 3`, 4505 unimodular
columns.  It checked:
- `σ(v) e_L = v`;
- every `x_Lm(f)` check (`deg f ≤ 1`) and every `W'` check has matrix `1 + c E_Lm`;
- the word-level identities used in `check_Lm` and `check_W_lt`;
- the identity `x_mL(1) = W' x_Lm(-1) W'⁻¹`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP

open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.SimpleKazhdanSofic.SkRows.SteinbergWeyl (w)
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwo (act unitVec)

/-- **The rank-one residual.**  For `K = {m}`, the coset check of `W' = w_mL(-1)` against the
Euclidean section `σ`, at the orbit vectors with `deg v L ≤ deg v m`.  TRUE (module
docstring). -/
def k2PolyNagaoSigma_WeylStatement : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] {I : Type} [Fintype I] [DecidableEq I] (K : Finset I) (m L : I)
    (hmL : m ≠ L), m ∈ K → (∀ i ∈ K, i = m) → (∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k) →
    (∀ g ∈ (ringMap (I := I) (Polynomial.C : ZMod p →+* Polynomial (ZMod p))).range,
      g ∈ K2 I (Polynomial (ZMod p)) → g = 1) →
    ∀ v : I → Polynomial (ZMod p), (∃ y ∈ k2PolyDeg_G p K L, act y (unitVec L) = v) →
      (v L).degree ≤ (v m).degree →
      (k2PolyNagaoSigma_sigma p m L hmL
          (act (w m L hmL (-1 : (Polynomial (ZMod p))ˣ)) v))⁻¹ *
        w m L hmL (-1 : (Polynomial (ZMod p))ˣ) * k2PolyNagaoSigma_sigma p m L hmL v ∈
          k2PolyNF_Q p K L

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_WeylStatement

/-- `k2PolyNagao_MonoStatement` for `|K| ≥ 2`, unchanged (LOUD: not reduced here). -/
def k2PolyNagaoSigma_WideStatement : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] {I : Type} [Fintype I] [DecidableEq I] (K : Finset I) (L : I),
    L ∉ K → (∃ i ∈ K, ∃ j ∈ K, i ≠ j) → (∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k) →
    (∀ g ∈ (ringMap (I := I) (Polynomial.C : ZMod p →+* Polynomial (ZMod p))).range,
      g ∈ K2 I (Polynomial (ZMod p)) → g = 1) →
    (∀ s ∈ k2PolyDeg_S p K, s ∈ K2 I (Polynomial (ZMod p)) → s = 1) →
    ∃ σ : (I → Polynomial (ZMod p)) → SteinbergGroup I (Polynomial (ZMod p)),
      σ (unitVec L) ∈ k2PolyNF_Q p K L ∧
      ∃ (m : I) (hmL : m ≠ L), m ∈ K ∧ k2PolyNagao_Gens p K L σ m hmL

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_WideStatement

/-- **The residual of lane `bh-met-92q`**: the unchanged `|K| ≥ 2` case and the rank-one
Weyl residual. -/
def k2PolyNagaoSigma_Statement : Prop :=
  k2PolyNagaoSigma_WideStatement ∧ k2PolyNagaoSigma_WeylStatement

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_Statement

/-- The wide part is implied by `k2PolyNagao_MonoStatement` (it is a special case). -/
theorem k2PolyNagaoSigma_wide_of_mono (hM : k2PolyNagao_MonoStatement) :
    k2PolyNagaoSigma_WideStatement := by
  intro p _ I _ _ K L hLK hwide hthird hconst ih
  obtain ⟨i, hiK, -⟩ := hwide
  exact hM p K L hLK ⟨i, hiK⟩ hthird hconst ih

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_wide_of_mono

section Gens

variable {I : Type} [Fintype I] [DecidableEq I] {p : ℕ} [Fact p.Prime]

/-- **Reduction for `K = {m}`.**  The Weyl check at `deg v L ≤ deg v m` gives all the checks
of `k2PolyNagao_Gens` for the Euclidean section `σ`. -/
theorem k2PolyNagaoSigma_gens_of_weyl {K : Finset I} {m L : I} (hmL : m ≠ L) (hmK : m ∈ K)
    (hKm : ∀ i ∈ K, i = m) (hthird : ∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k)
    (hW : ∀ v : I → Polynomial (ZMod p), (∃ y ∈ k2PolyDeg_G p K L, act y (unitVec L) = v) →
      (v L).degree ≤ (v m).degree →
      (k2PolyNagaoSigma_sigma p m L hmL
          (act (w m L hmL (-1 : (Polynomial (ZMod p))ˣ)) v))⁻¹ *
        w m L hmL (-1 : (Polynomial (ZMod p))ˣ) * k2PolyNagaoSigma_sigma p m L hmL v ∈
          k2PolyNF_Q p K L) :
    k2PolyNagao_Gens p K L (k2PolyNagaoSigma_sigma p m L hmL) m hmL := by
  obtain ⟨n, hmn, hLn⟩ := hthird m L
  have hm' : m ∈ insert L K := Finset.mem_insert_of_mem hmK
  have hL' : L ∈ insert L K := Finset.mem_insert_self L K
  have hLm : ∀ f : Polynomial (ZMod p),
      k2PolyEuclid_Good p K L (k2PolyNagaoSigma_sigma p m L hmL) (x L m hmL.symm f) :=
    fun f => ⟨k2PolyEuclid_x_mem_G hmL.symm f hL' hm',
      k2PolyNagaoSigma_check_Lm hmL hmK ⟨n, hmn, hLn⟩ f⟩
  have hWg : k2PolyEuclid_Good p K L (k2PolyNagaoSigma_sigma p m L hmL)
      (w m L hmL (-1 : (Polynomial (ZMod p))ˣ)) := by
    refine ⟨?_, fun v hv => ?_⟩
    · rw [w]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (k2PolyEuclid_x_mem_G hmL _ hm' hL')
        (k2PolyEuclid_x_mem_G hmL.symm _ hL' hm')) (k2PolyEuclid_x_mem_G hmL _ hm' hL')
    · rcases lt_or_ge (v m).degree (v L).degree with hd | hd
      · exact k2PolyNagaoSigma_check_W_lt hmL v hd
      · exact hW v hv hd
  have e : x m L hmL (1 : Polynomial (ZMod p)) =
      w m L hmL (-1 : (Polynomial (ZMod p))ˣ) * x L m hmL.symm (-1 : Polynomial (ZMod p)) *
        (w m L hmL (-1 : (Polynomial (ZMod p))ˣ))⁻¹ := by
    rw [k2PolyDeg_w_conj_self_symm_eq m L n hmL hmn hLn (-1 : (Polynomial (ZMod p))ˣ)
      (-1 : Polynomial (ZMod p))]
    refine congrArg (x m L hmL) ?_
    rw [Units.val_neg, Units.val_one]
    ring
  refine ⟨fun i him hiK => absurd (hKm i hiK) him, ?_, (hLm 1).2, (hLm _).2,
    fun _ _ => (hLm _).2⟩
  rw [e]
  exact (k2PolyEuclid_good_mul (k2PolyEuclid_good_mul hWg (hLm (-1)))
    (k2PolyEuclid_good_inv hWg)).2

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_gens_of_weyl

end Gens

/-- **Reduction.**  The residual of lane `bh-met-92q` gives `k2PolyNagao_MonoStatement`: for
`|K| ≥ 2` by the wide part, for `K = {m}` with the explicit `σ` and
`k2PolyNagaoSigma_gens_of_weyl`. -/
theorem k2PolyNagaoSigma_mono_of_statement (hS : k2PolyNagaoSigma_Statement) :
    k2PolyNagao_MonoStatement := by
  intro p _ I _ _ K L hLK hK hthird hconst ih
  by_cases hwide : ∃ i ∈ K, ∃ j ∈ K, i ≠ j
  · exact hS.1 p K L hLK hwide hthird hconst ih
  obtain ⟨m, hmK⟩ := hK
  have hKm : ∀ i ∈ K, i = m := by
    intro i hiK
    by_contra hne
    exact hwide ⟨i, hiK, m, hmK, hne⟩
  have hmL : m ≠ L := fun e => hLK (e ▸ hmK)
  refine ⟨k2PolyNagaoSigma_sigma p m L hmL, ?_, m, hmL, hmK, ?_⟩
  · rw [k2PolyNagaoSigma_sigma_unitVec]
    exact Subgroup.one_mem _
  · exact k2PolyNagaoSigma_gens_of_weyl hmL hmK hKm hthird
      (hS.2 p K m L hmL hmK hKm hthird hconst)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_mono_of_statement

/-- **Endpoint.**  The residual gives lane 92c's stabiliser statement. -/
theorem k2PolyNagaoSigma_stab_of_statement (hS : k2PolyNagaoSigma_Statement) :
    k2PolyNF_StabStatement :=
  k2PolyNagao_stab_of_mono (k2PolyNagaoSigma_mono_of_statement hS)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_stab_of_statement

/-- **Endpoint.**  The residual gives `K₂(N, F_p[X]) = ⊥` for `N ≥ 5`. -/
theorem k2PolyNagaoSigma_K2_bot_of_stmt (hS : k2PolyNagaoSigma_Statement) {p : ℕ}
    (hp : p.Prime) {N : ℕ} (hN : 5 ≤ N) : K2n N (Polynomial (ZMod p)) = ⊥ :=
  k2PolyNagao_K2_eq_bot_of_mono (k2PolyNagaoSigma_mono_of_statement hS) hp hN

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2PolyNagaoSigma_K2_bot_of_stmt

end GroupApproximation.BooneHigman.Metabelian.ElemFP
