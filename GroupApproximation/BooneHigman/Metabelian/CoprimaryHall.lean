import Mathlib.GroupTheory.Finiteness
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.LinearAlgebra.Span.Defs
import Mathlib.Data.Finite.Prod
import GroupApproximation.BooneHigman.Metabelian.CoprimaryPieces
import GroupApproximation.Meta.AxiomGuard

/-!
# Hall's finiteness of the derived module (lane bh-met-04)

Research node `fg-metabelian-coprimary-quotients-proof`, step (a)1.  If `G` is generated by a
finite set `T`, the derived module `G' / G''` is generated as a `ℤ[Gᵃᵇ]`-module by the classes of
the commutators `⁅s, t⁆` with `s, t ∈ T`.

**Route.** Let `S` be the span of these classes and `N = pieceSubgroup S`, which is normal.  The
images of the generators commute in `G ⧸ N`, because their commutators lie in `N`; they generate
`G ⧸ N`, which is therefore commutative, so `G' ≤ N` (`commutator_le_of_closure`).  Every element
of `G'` then has its class in `S`, and `S = ⊤`.

Main declarations:
* `commClass s t`: the class of `⁅s, t⁆`;
* `commutator_le_of_closure`: if the commutators of a generating set lie in a normal subgroup
  `N`, then `G' ≤ N`;
* `module_finite`: for f.g. `G`, the derived module is a finite `ℤ[Gᵃᵇ]`-module.
-/

open scoped commutatorElement

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Coprimary

variable {G : Type*} [Group G]

/-- The class of the commutator `⁅s, t⁆` in the derived module. -/
def commClass (s t : G) : DerivedModule G :=
  dcls ⟨⁅s, t⁆, Subgroup.commutator_mem_commutator (Subgroup.mem_top s) (Subgroup.mem_top t)⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.commClass

/-- If the commutators of a generating set lie in a normal subgroup `N`, then `G' ≤ N`. -/
theorem commutator_le_of_closure {N : Subgroup G} [N.Normal] {T : Set G}
    (hT : Subgroup.closure T = ⊤) (hgen : ∀ s ∈ T, ∀ t ∈ T, ⁅s, t⁆ ∈ N) :
    commutator G ≤ N := by
  have hcomm : ∀ x ∈ QuotientGroup.mk' N '' T, ∀ y ∈ QuotientGroup.mk' N '' T,
      x * y = y * x := by
    rintro _ ⟨s, hs, rfl⟩ _ ⟨t, ht, rfl⟩
    rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement (QuotientGroup.mk' N)]
    exact (QuotientGroup.eq_one_iff ⁅s, t⁆).mpr (hgen s hs t ht)
  haveI := Subgroup.isMulCommutative_closure hcomm
  have htop : Subgroup.closure (QuotientGroup.mk' N '' T) = ⊤ := by
    rw [← MonoidHom.map_closure, hT,
      Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)]
  rw [_root_.commutator_def, Subgroup.commutator_le]
  intro g₁ _ g₂ _
  have h1 : QuotientGroup.mk' N g₁ ∈ Subgroup.closure (QuotientGroup.mk' N '' T) := by
    rw [htop]
    exact Subgroup.mem_top _
  have h2 : QuotientGroup.mk' N g₂ ∈ Subgroup.closure (QuotientGroup.mk' N '' T) := by
    rw [htop]
    exact Subgroup.mem_top _
  have key : QuotientGroup.mk' N ⁅g₁, g₂⁆ = 1 := by
    rw [map_commutatorElement (QuotientGroup.mk' N), commutatorElement_eq_one_iff_mul_comm]
    exact setLike_mul_comm h1 h2
  exact (QuotientGroup.eq_one_iff ⁅g₁, g₂⁆).mp key

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.commutator_le_of_closure

variable (G) in
/-- **Hall.** The derived module of a finitely generated group is a finite `ℤ[Gᵃᵇ]`-module. -/
theorem module_finite [Group.FG G] :
    Module.Finite (MonoidAlgebra ℤ (Abelianization G)) (DerivedModule G) := by
  obtain ⟨T, hT, hTfin⟩ := Group.fg_iff.mp ‹Group.FG G›
  refine Module.finite_def.mpr (Submodule.fg_def.mpr
    ⟨Set.image2 commClass T T, hTfin.image2 _ hTfin, ?_⟩)
  refine eq_top_iff.mpr fun m _ => ?_
  obtain ⟨y, rfl⟩ := Additive.ofMul.surjective m
  refine QuotientGroup.induction_on y fun a => ?_
  have hgen : ∀ s ∈ T, ∀ t ∈ T, ⁅s, t⁆ ∈ pieceSubgroup
      (Submodule.span (MonoidAlgebra ℤ (Abelianization G)) (Set.image2 commClass T T)) :=
    fun s hs t ht => mem_pieceSubgroup.mpr
      ⟨Subgroup.commutator_mem_commutator (Subgroup.mem_top s) (Subgroup.mem_top t),
        Submodule.subset_span (Set.mem_image2_of_mem (f := commClass) hs ht)⟩
  obtain ⟨_, h⟩ := mem_pieceSubgroup.mp (commutator_le_of_closure hT hgen a.2)
  exact h

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.module_finite

end Coprimary
end Metabelian
end BooneHigman
end GroupApproximation
