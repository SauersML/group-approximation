import GroupApproximation.BooneHigman.Metabelian.SuslinBase3FamLift
import GroupApproximation.Meta.AxiomGuard

/-!
# The rank-3 base of R2: using `SL₃(A) = E₃(A)` at level `k` (non-circular)

Lane `bh-met-91p`.

`SuslinBase3FamGen A ≤ SL₂(A[X])` is the subgroup generated by
* `E₂(A[X])`, and
* every `ψ(τ)` with `ψ : A →+* A[X]` ANY ring map and `τ ∈ SL₂(A)` (entrywise image).

* `suslinBase3Fam_gen_le`: if `SL₃(A) = E₃(A)` then for EVERY ring map `f : A[X] → S`, every
  `σ ∈ SuslinBase3FamGen A` has `diag(f σ, 1) ∈ E₃(S)`.  For `ψ(τ)`: `diag(τ, 1) ∈ SL₃(A) =
  E₃(A)` and `E₃` is functorial along `f ∘ ψ`; for `E₂(A[X])`: functoriality plus
  stabilization.
* `SuslinBase3FamPowStab A`: `SuslinBase3CongPowStab A 2` with the extra premise
  `σ ∉ SuslinBase3FamGen A`.
* `suslinBase3Fam_powStab_of_famPowStab` (**the reduction**): given `SL₃(A) = E₃(A)` (which is
  exactly what the family hypothesis supplies at level `k`, NOT at `k + 1`),
  `SuslinBase3FamPowStab A → SuslinBase3CongPowStab A 2`.
* `suslinBase3Fam_famPowStab_of_powStab`: the trivial converse.

**LOUD status.**  Over a ring with `SL₃ = E₃`, `SuslinBase3FamPowStab A ↔ SuslinBase3CongPowStab
A 2` (the two items above), so this is NOT logically weaker on the families (whose hypothesis
supplies `SL₃ = E₃`).  It is strictly smaller in PROOF CONTENT: every normalized `σ` in
`SuslinBase3FamGen A` is discharged, and this is where the family hypothesis `SL₃(A) = E₃(A)` is
USED (the earlier reductions `SuslinBase3Core*`, `SuslinBase3Cong*` never use it).  The class
discharged is not contained in `E₂(A[X])`: for `A = 𝔽_p[t₁..t_k]`, `k ≥ 2`, with
`ψ : tᵢ ↦ X tᵢ` and `τ` Cohn's matrix `[[1 + t₁t₂, t₁²], [-t₂², 1 - t₁t₂]] ∈ SL₂(A) \ E₂(A)`,
`ψ(τ)` is normalized (`X = 0` gives `1`) and specializes at `X = 1` to `τ ∉ E₂(A)`, so
`ψ(τ) ∉ E₂(A[X])`.  (Remark only; this file makes no claim about the congruence
`σ ≡ 1 mod 𝔪^N` for such `σ`.)

TRUE on the families exactly when `SuslinBase3CongPowStab` is (the equivalence); the remaining gap
is K1-regularity (rank 2 plus one stabilization, one polynomial variable) for the normalized
`σ ≡ 1 mod 𝔪^N` outside `SuslinBase3FamGen A`.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

open Polynomial

/-- The subgroup of `GL₂(A[X])` generated by `E₂(A[X])` and all images `ψ(τ)`, `ψ : A →+* A[X]`,
`τ ∈ SL₂(A)`. -/
def SuslinBase3FamGen (A : Type*) [CommRing A] : Subgroup (Matrix (Fin 2) (Fin 2) A[X])ˣ :=
  Subgroup.closure
    (((elementaryGroup (Fin 2) A[X] : Subgroup (Matrix (Fin 2) (Fin 2) A[X])ˣ) :
        Set (Matrix (Fin 2) (Fin 2) A[X])ˣ) ∪
      {σ | ∃ (ψ : A →+* A[X]) (τ : (Matrix (Fin 2) (Fin 2) A)ˣ),
        Matrix.det (τ : Matrix (Fin 2) (Fin 2) A) = 1 ∧ elementaryMatrixUnitMap ψ τ = σ})

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.SuslinBase3FamGen

/-- **Every element of `SuslinBase3FamGen A` stabilizes into `E₃` after any ring map**, when
`SL₃(A) = E₃(A)`. -/
theorem suslinBase3Fam_gen_le {A S : Type*} [CommRing A] [CommRing S]
    (hSL : SpecialLinearInElementary A (2 + 1)) (f : A[X] →+* S) :
    SuslinBase3FamGen A ≤ (elementaryGroup (Fin 2 ⊕ Unit) S).comap
      ((stabilizeUnit (R := S) (κ := Unit)).comp (elementaryMatrixUnitMap (ι := Fin 2) f)) := by
  rw [SuslinBase3FamGen, Subgroup.closure_le]
  rintro σ (hσ | ⟨ψ, τ, hτ, rfl⟩)
  · have hσ' : σ ∈ elementaryGroup (Fin 2) A[X] := hσ
    have hloc : elementaryMatrixUnitMap f σ ∈ elementaryGroup (Fin 2) S :=
      elementaryGroup_map_le f (Subgroup.mem_map_of_mem _ hσ')
    change stabilizeUnit (R := S) (κ := Unit) (elementaryMatrixUnitMap f σ) ∈
      elementaryGroup (Fin 2 ⊕ Unit) S
    exact (elementaryStabilization (ι := Fin 2) (κ := Unit) (R := S) ⟨_, hloc⟩).2
  · change stabilizeUnit (R := S) (κ := Unit)
        (elementaryMatrixUnitMap f (elementaryMatrixUnitMap ψ τ)) ∈
      elementaryGroup (Fin 2 ⊕ Unit) S
    rw [suslinBase3Fam_map_comp]
    exact suslinBase3Fam_stab_map_mem hSL (f.comp ψ) τ hτ

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_gen_le

/-- **The residual**: the deep-congruence core at rank `2`, only for `σ ∉ SuslinBase3FamGen A`. -/
def SuslinBase3FamPowStab (A : Type*) [CommRing A] : Prop :=
  ∀ (𝔪 : Ideal A) (_ : 𝔪.IsMaximal), ∃ N : ℕ,
    ∀ σ : Matrix.GeneralLinearGroup (Fin 2) (Polynomial A),
      Matrix.det (σ : Matrix (Fin 2) (Fin 2) (Polynomial A)) = 1 →
        elementaryMatrixUnitMap (ι := Fin 2) (Polynomial.constantCoeff (R := A)) σ = 1 →
          elementaryMatrixUnitMap (ι := Fin 2)
              (Polynomial.mapRingHom (Ideal.Quotient.mk (𝔪 ^ N))) σ = 1 →
            σ ∉ SuslinBase3FamGen A →
              stabilizeUnit (R := Polynomial (Localization.AtPrime 𝔪)) (κ := Unit)
                  (elementaryMatrixUnitMap (ι := Fin 2)
                    (Polynomial.mapRingHom (algebraMap A (Localization.AtPrime 𝔪))) σ) ∈
                elementaryGroup (Fin 2 ⊕ Unit) (Polynomial (Localization.AtPrime 𝔪))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.SuslinBase3FamPowStab

/-- **The reduction**: with `SL₃(A) = E₃(A)`, the residual gives the deep-congruence core. -/
theorem suslinBase3Fam_powStab_of_famPowStab {A : Type*} [CommRing A]
    (hSL : SpecialLinearInElementary A (2 + 1)) (h : SuslinBase3FamPowStab A) :
    SuslinBase3CongPowStab A 2 := by
  intro 𝔪 h𝔪
  obtain ⟨N, hN⟩ := h 𝔪 h𝔪
  refine ⟨N, fun σ hdet h0 hπ ↦ ?_⟩
  by_cases hσ : σ ∈ SuslinBase3FamGen A
  · exact Subgroup.mem_comap.mp (suslinBase3Fam_gen_le hSL
      (Polynomial.mapRingHom (algebraMap A (Localization.AtPrime 𝔪))) hσ)
  · exact hN σ hdet h0 hπ hσ

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_powStab_of_famPowStab

/-- The trivial converse (LOUD: equivalence over rings with `SL₃ = E₃`). -/
theorem suslinBase3Fam_famPowStab_of_powStab {A : Type*} [CommRing A]
    (h : SuslinBase3CongPowStab A 2) : SuslinBase3FamPowStab A :=
  fun 𝔪 h𝔪 ↦ (h 𝔪 h𝔪).imp fun _ hN σ hdet h0 hπ _ ↦ hN σ hdet h0 hπ

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.Absorption.suslinBase3Fam_famPowStab_of_powStab

end Absorption
end Metabelian
end BooneHigman
end GroupApproximation
