import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroEndpoint
import GroupApproximation.BooneHigman.Metabelian.ElemFPK2Homotopy
import GroupApproximation.Meta.AxiomGuard

/-!
# Finite generation of `K₂(N, ℤ[1/m][t_0..t_{k-1}])`: split into base ring and nil part

Lane `bh-met-28`.  The char-zero gap `CharZeroStableK2FGStatement` (module
`ElemFPCharZeroEndpoint`) asks that `K₂(N, S)` be finitely generated, where
`S = ℤ[1/m][t_0, ..., t_{k-1}]` (`Chain.SIntPoly m k`), `N ≥ k + 4` and `N ≥ 5`.

**Warning.**  `K₂(ℤ[1/m]) ≠ 0`: the symbol `{-1,-1}` has real Hilbert symbol `-1`.  Nothing here
claims that a `K₂` vanishes.  Only finite generation is used.

## The split

Write `A = ℤ[1/m]`.  Evaluation at `0`, `ev₀ = constantCoeff : A[σ] → A`, retracts the constants
`C : A → A[σ]`.  Every `u ∈ K₂(I, A[σ])` factors as `u = C(ev₀ u) · w` with `ev₀ w = 1`
(`ElemFP.K2Map_constantCoeff_split`).  So `K₂(I, A[σ])` is generated by the image of `C` and the
kernel of `ev₀` (`k2_fg_of_base_of_nil`).  This holds for any commutative ring and any index type.

* `CharZeroK2BaseFGStatement`: `K₂(N, ℤ[1/m])` is finitely generated for `N ≥ 5`.
* `CharZeroK2NilFGPosStatement`: for `k ≥ 1`, the kernel of `ev₀ : K₂(N, S) → K₂(N, ℤ[1/m])` is
  finitely generated.
* `CharZeroK2SplitGapStatement`: the conjunction of the two.  **This is the isolated gap.**
* `charZeroStableK2FG_of_splitGap`: the gap implies `CharZeroStableK2FGStatement`.

## Truth check

*Base part.*  If `m = 0` the ring `ℤ[1/0]` is zero and `St_N` is trivial.  If `m ≥ 1`, `ℤ[1/m]`
is a Dedekind ring, so its Bass stable rank is at most `2`.  Injective and surjective stability
(van der Kallen; Suslin–Tulenbaev) give `K₂(N, ℤ[1/m]) ≅ K₂(ℤ[1/m])` for `N ≥ 4`.  The localization
sequence `K₂(ℤ) → K₂(ℤ[1/m]) → ⊕_{p ∣ m} F_p^×` has finite outer terms (`K₂(ℤ) = ℤ/2`), so this
group is finite.

*Nil part.*  `S` is noetherian of Krull dimension `k + 1`, so Bass gives `sr(S) ≤ k + 2`.
Injective stability for `N ≥ sr(S) + 2`, which covers `N ≥ k + 4`, embeds `K₂(N, S)` in the stable
`K₂(S)`.  Quillen's homotopy invariance for the regular ring `ℤ[1/m]` makes stable `ev₀` an
isomorphism `K₂(S) ≅ K₂(ℤ[1/m])`.  So the kernel of `ev₀` on `K₂(N, S)` is trivial, in particular
finitely generated.  The stronger vanishing form is `CharZeroK2NilPosStatement`, and
`charZeroK2NilFGPos_of_nilPos` proves the implication.

## Why the gap is strictly smaller

The endpoint proves the splitting, the generation step `range C ⊔ ker ev₀ = ⊤`, and the case
`k = 0`, where `ev₀` is injective (`ElemFP.K2Map_constantCoeff_injective_of_isEmpty`).  The base
part is logically weaker than the target: `charZeroK2BaseFG_of_stableK2FG` derives it.  The nil part
concerns only `k ≥ 1` and only the kernel of `ev₀`, never the constants.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic

section Generic

variable {σ R I : Type*} [CommRing R] [Fintype I] [DecidableEq I]

/-- **The split, generic form.**  If `K₂(I, R)` and the kernel of `ev₀ : K₂(I, R[σ]) → K₂(I, R)`
are finitely generated, then `K₂(I, R[σ])` is finitely generated. -/
theorem k2_fg_of_base_of_nil (hbase : Group.FG (K2 I R))
    (hnil : Group.FG (K2Map (I := I) (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R)).ker) :
    Group.FG (K2 I (MvPolynomial σ R)) := by
  have hC : (K2Map (I := I) (MvPolynomial.C : R →+* MvPolynomial σ R)).range.FG :=
    (Group.fg_iff_subgroup_fg _).mp (Group.fg_of_surjective (hG := hbase)
      (K2Map (I := I) (MvPolynomial.C : R →+* MvPolynomial σ R)).rangeRestrict_surjective)
  have hev : (K2Map (I := I) (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R)).ker.FG :=
    (Group.fg_iff_subgroup_fg _).mp hnil
  have htop : (K2Map (I := I) (MvPolynomial.C : R →+* MvPolynomial σ R)).range ⊔
      (K2Map (I := I) (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R)).ker = ⊤ := by
    refine eq_top_iff.mpr fun u _ ↦ ?_
    have hmem := Subgroup.mul_mem_sup
      (MonoidHom.mem_range.mpr
          ⟨K2Map (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R) u, rfl⟩ :
        K2Map (I := I) (MvPolynomial.C : R →+* MvPolynomial σ R)
            (K2Map (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R) u) ∈
          (K2Map (I := I) (MvPolynomial.C : R →+* MvPolynomial σ R)).range)
      (MonoidHom.mem_ker.mpr (ElemFP.K2Map_constantCoeff_split u))
    rwa [mul_inv_cancel_left] at hmem
  rw [Group.fg_def, ← htop]
  exact hC.sup hev

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_of_base_of_nil

/-- With no variables, `K₂(I, R[σ])` is finitely generated as soon as `K₂(I, R)` is. -/
theorem k2_fg_mvPolynomial_of_isEmpty [IsEmpty σ] (hbase : Group.FG (K2 I R)) :
    Group.FG (K2 I (MvPolynomial σ R)) := by
  have hker : (K2Map (I := I) (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R)).ker = ⊥ :=
    (MonoidHom.ker_eq_bot_iff _).mpr ElemFP.K2Map_constantCoeff_injective_of_isEmpty
  refine k2_fg_of_base_of_nil hbase ((Group.fg_iff_subgroup_fg _).mpr ?_)
  rw [hker]
  exact Subgroup.FG.bot

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_mvPolynomial_of_isEmpty

end Generic

/-- **Gap, base part.**  `K₂(N, ℤ[1/m])` is finitely generated for `N ≥ 5`. -/
def CharZeroK2BaseFGStatement : Prop :=
  ∀ m N : ℕ, 5 ≤ N → Group.FG (K2 (Fin N) (Localization.Away (m : ℤ)))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroK2BaseFGStatement

/-- **Gap, nil part.**  For `k ≥ 1`, `N ≥ k + 4` and `N ≥ 5`, the kernel of
`ev₀ : K₂(N, ℤ[1/m][t_0..t_{k-1}]) → K₂(N, ℤ[1/m])` is finitely generated. -/
def CharZeroK2NilFGPosStatement : Prop :=
  ∀ m k N : ℕ, 0 < k → k + 4 ≤ N → 5 ≤ N →
    Group.FG (K2Map (I := Fin N)
      (MvPolynomial.constantCoeff :
        MvPolynomial (Fin k) (Localization.Away (m : ℤ)) →+* Localization.Away (m : ℤ))).ker

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroK2NilFGPosStatement

/-- **The isolated gap** (lane `bh-met-28`): the base part and the nil part. -/
def CharZeroK2SplitGapStatement : Prop :=
  CharZeroK2BaseFGStatement ∧ CharZeroK2NilFGPosStatement

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroK2SplitGapStatement

/-- **Endpoint (lane `bh-met-28`).**  The split gap implies `CharZeroStableK2FGStatement`. -/
theorem charZeroStableK2FG_of_splitGap (h : CharZeroK2SplitGapStatement) :
    CharZeroStableK2FGStatement := by
  intro m k N hkN h5N
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · exact k2_fg_mvPolynomial_of_isEmpty (σ := Fin 0) (R := Localization.Away (m : ℤ))
      (I := Fin N) (h.1 m N h5N)
  · exact k2_fg_of_base_of_nil (σ := Fin k) (R := Localization.Away (m : ℤ)) (I := Fin N)
      (h.1 m N h5N) (h.2 m k N hk hkN h5N)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroStableK2FG_of_splitGap

/-- The base part is logically weaker than the target: it is the case `k = 0`, transported along
the surjection `ev₀ : K₂(N, ℤ[1/m][∅]) → K₂(N, ℤ[1/m])`. -/
theorem charZeroK2BaseFG_of_stableK2FG (h : CharZeroStableK2FGStatement) :
    CharZeroK2BaseFGStatement := by
  intro m N h5N
  exact Group.fg_of_surjective (hG := h m 0 N (by omega) h5N)
    (f := K2Map (I := Fin N)
      (MvPolynomial.constantCoeff :
        MvPolynomial (Fin 0) (Localization.Away (m : ℤ)) →+* Localization.Away (m : ℤ)))
    fun v ↦ ⟨K2Map (I := Fin N) (MvPolynomial.C :
        Localization.Away (m : ℤ) →+* MvPolynomial (Fin 0) (Localization.Away (m : ℤ))) v,
      ElemFP.K2Map_constantCoeff_K2Map_C v⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroK2BaseFG_of_stableK2FG

/-- The vanishing form of the nil part: for `k ≥ 1`, `N ≥ k + 4`, `N ≥ 5`, an element of
`K₂(N, ℤ[1/m][t_0..t_{k-1}])` killed by `ev₀` is trivial.  It is true by injective stability and
homotopy invariance (see the module docstring).  It is not the isolated gap, only a convenient
stronger input. -/
def CharZeroK2NilPosStatement : Prop :=
  ∀ m k N : ℕ, 0 < k → k + 4 ≤ N → 5 ≤ N →
    ∀ u : K2 (Fin N) (MvPolynomial (Fin k) (Localization.Away (m : ℤ))),
      K2Map (MvPolynomial.constantCoeff :
        MvPolynomial (Fin k) (Localization.Away (m : ℤ)) →+* Localization.Away (m : ℤ)) u = 1 →
        u = 1

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroK2NilPosStatement

/-- Vanishing of the nil part gives its finite generation. -/
theorem charZeroK2NilFGPos_of_nilPos (h : CharZeroK2NilPosStatement) :
    CharZeroK2NilFGPosStatement := by
  intro m k N hk hkN h5N
  have hker : (K2Map (I := Fin N)
      (MvPolynomial.constantCoeff :
        MvPolynomial (Fin k) (Localization.Away (m : ℤ)) →+* Localization.Away (m : ℤ))).ker = ⊥ :=
    (MonoidHom.ker_eq_bot_iff _).mpr ((injective_iff_map_eq_one _).mpr (h m k N hk hkN h5N))
  rw [Group.fg_iff_subgroup_fg, hker]
  exact Subgroup.FG.bot

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroK2NilFGPos_of_nilPos

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
