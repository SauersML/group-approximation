import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroStabGenWeyl
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.PaddedCentral
import GroupApproximation.Algebra.ElementaryPaddingInjective
import GroupApproximation.Meta.AxiomGuard

/-!
# `K₂` elements supported off one index come from `K₂(n)` (lane bh-met-90d)

This holds over an arbitrary unital ring `R` and for every `n`.  Fix `j : Fin n` and let
`c = j.castSucc`.  Write `czStabGen_off R c ≤ St_{n+1}(R)` for the subgroup generated by the
roots `x_{p,q}(a)` with `p ≠ c` and `q ≠ c`.

**Support lemma** (`czStabGen_mem_map_of_off`): every `z ∈ K₂(n+1, R) ∩ czStabGen_off R c`
lies in `stab K₂(n, R)`.

Proof.  Take the Weyl-type element `w = x_{c,L}(1) x_{L,c}(-1) x_{c,L}(1)` with `L = last`.
By `ElemFPCharZeroStabGenWeyl`, conjugation by `w` sends each generator of `czStabGen_off R c`
to a root with both indices `≠ L`, which lies in `stab St_n`.  So `w z w⁻¹ = stab k`.
Because `z ∈ K₂`, `elementaryStab (projection k) = 1`, and the identity padding is injective,
so `k ∈ K₂(n)`.  Then `stab k` is central (`LeavittK2.map_stab_K2_le_center`), which gives
`z = w⁻¹ (stab k) w = stab k`.

The file also records the support bookkeeping: `padCol v`, `padRow v` with `v j = 0` lie in
`czStabGen_off R c`, and `stab` maps `czStabGen_off R j` into `czStabGen_off R c`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.SteinbergGroup GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2 (map_stab_K2_le_center)
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.PaddedCentral
  (padCol padRow padCol_add padRow_add padCol_zero padRow_zero padCol_single padRow_single)

/-- Roots of `St_N(R)` whose two indices avoid `c`. -/
abbrev czStabGen_offSet (R : Type*) [Ring R] {N : ℕ} (c : Fin N) : Set (St N R) :=
  {g | ∃ (p q : Fin N) (hpq : p ≠ q) (a : R), p ≠ c ∧ q ≠ c ∧ g = x p q hpq a}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGen_offSet

/-- The subgroup of `St_N(R)` generated by the roots avoiding `c`. -/
abbrev czStabGen_off (R : Type*) [Ring R] {N : ℕ} (c : Fin N) : Subgroup (St N R) :=
  Subgroup.closure (czStabGen_offSet R c)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGen_off

/-- Conjugation by `w` maps a closure into `K` once it maps the generators into `K`. -/
theorem czStabGen_conj_mem_of_closure {G : Type*} [Group G] {s : Set G} {K : Subgroup G}
    (w : G) (hs : ∀ g ∈ s, w * g * w⁻¹ ∈ K) {g : G} (hg : g ∈ Subgroup.closure s) :
    w * g * w⁻¹ ∈ K := by
  induction hg using Subgroup.closure_induction with
  | mem g hg => exact hs g hg
  | one => rw [mul_one, mul_inv_cancel]; exact one_mem K
  | mul g h _ _ ihg ihh =>
    have e : w * (g * h) * w⁻¹ = (w * g * w⁻¹) * (w * h * w⁻¹) := by group
    rw [e]
    exact mul_mem ihg ihh
  | inv g _ ih =>
    have e : w * g⁻¹ * w⁻¹ = (w * g * w⁻¹)⁻¹ := by group
    rw [e]
    exact inv_mem ih

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGen_conj_mem_of_closure

variable {R : Type*} [Ring R] {n : ℕ}

/-- A root of `St_{n+1}` with both indices `≠ last` is stabilized. -/
theorem czStabGen_x_mem_range {p q : Fin (n + 1)} (hpq : p ≠ q) (hp : p ≠ Fin.last n)
    (hq : q ≠ Fin.last n) (a : R) : x p q hpq a ∈ (stab n R).range := by
  obtain ⟨p', rfl⟩ := Fin.exists_castSucc_eq.mpr hp
  obtain ⟨q', rfl⟩ := Fin.exists_castSucc_eq.mpr hq
  exact MonoidHom.mem_range.mpr
    ⟨x p' q' (fun h => hpq (congrArg Fin.castSucc h)) a, stab_x _ _ _ _⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGen_x_mem_range

/-- Conjugating `czStabGen_off R j.castSucc` by the Weyl element lands in `stab St_n`. -/
theorem czStabGen_weyl_conj_mem_range (j : Fin n) {g : St (n + 1) R}
    (hg : g ∈ czStabGen_off R j.castSucc) :
    czStabGen_weyl j.castSucc (Fin.last n) (Fin.castSucc_lt_last j).ne * g *
      (czStabGen_weyl j.castSucc (Fin.last n) (Fin.castSucc_lt_last j).ne)⁻¹ ∈
        (stab n R).range := by
  have hcL : j.castSucc ≠ Fin.last n := (Fin.castSucc_lt_last j).ne
  refine czStabGen_conj_mem_of_closure _ ?_ hg
  rintro _ ⟨p, q, hpq, a, hpc, hqc, rfl⟩
  by_cases hpL : p = Fin.last n
  · subst hpL
    rw [czStabGen_weyl_conj_row _ _ hcL hpq hqc a]
    exact czStabGen_x_mem_range hqc.symm hcL (fun h => hpq h.symm) a
  · by_cases hqL : q = Fin.last n
    · subst hqL
      rw [czStabGen_weyl_conj_col _ _ hcL hpq hpc a]
      exact czStabGen_x_mem_range hpc hpL hcL a
    · rw [czStabGen_weyl_conj_fix _ _ hcL hpq hpc hqc hpL hqL a]
      exact czStabGen_x_mem_range hpq hpL hqL a

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czStabGen_weyl_conj_mem_range
