import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVCTreeMid
import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVCCentralBalanced
import GroupApproximation.Meta.AxiomGuard

/-!
# All-swaps presentation: reduction to letters of defect at most one (lane bh-met-77i)

The *defect* of a letter `(u, v)` is `| |u| - |v| |`.  Modulo the standard relators
`K = normalClosure (higmanVC_rels d fun _ => True)`, every letter is a product of letters of
defect `≤ 1` (`higmanVCTree_letter_mem`), hence so is every word (`higmanVCTree_mem`).

Proof.  Two relator instances are used.

* **Swap** (`higmanVCTree_mk_swap`): `(u, v) = (v, u)`.  This is the conjugation relator
  `(u, v) (u, v) (u, v)⁻¹ = (v, u)`.
* **Detour** (`higmanVCTree_mk_conj`): `(u, v) = (w, v) (u, w) (w, v)⁻¹` whenever `u`, `v`, `w`
  are pairwise incomparable.  The cone swap `(w v)` fixes the cone `u` and carries `w` onto `v`.

Let `|u| + 2 ≤ |v|`.  Choose `w` with `|w| = |u| + 1` incomparable with `u` and `v`
(`higmanVCTree_exists_mid`; this needs `d ≥ 2`).  Then `(u, w)` has defect `1`, and `(w, v)` has
defect one less than `(u, v)`.  Induct on the defect.  Comparable letters are trivial.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

/-- Letters of defect at most one. -/
abbrev higmanVCTree_Small (d : ℕ) : Type :=
  {p : List (Fin d) × List (Fin d) // p.1.length ≤ p.2.length + 1 ∧ p.2.length ≤ p.1.length + 1}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_Small

/-- The inclusion of the free group on letters of defect at most one. -/
noncomputable def higmanVCTree_iota (d : ℕ) :
    FreeGroup (higmanVCTree_Small d) →* FreeGroup (List (Fin d) × List (Fin d)) :=
  FreeGroup.lift fun p : higmanVCTree_Small d => FreeGroup.of p.1

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_iota

theorem higmanVCTree_iota_of {d : ℕ} (p : higmanVCTree_Small d) :
    higmanVCTree_iota d (FreeGroup.of p) = FreeGroup.of p.1 :=
  FreeGroup.lift_apply_of (f := fun p : higmanVCTree_Small d => FreeGroup.of p.1)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_iota_of

/-- The subgroup of the quotient generated by letters of defect at most one. -/
noncomputable def higmanVCTree_S (d : ℕ) : Subgroup (higmanVCCommon_Q d) :=
  ((higmanVCCommon_mk d).comp (higmanVCTree_iota d)).range

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_S

/-- A letter of defect at most one lies in `higmanVCTree_S d`. -/
theorem higmanVCTree_small_mem {d : ℕ} {u v : List (Fin d)} (h1 : u.length ≤ v.length + 1)
    (h2 : v.length ≤ u.length + 1) :
    higmanVCCommon_mk d (FreeGroup.of (u, v)) ∈ higmanVCTree_S d :=
  MonoidHom.mem_range.mpr ⟨FreeGroup.of ⟨(u, v), h1, h2⟩, by
    rw [MonoidHom.comp_apply, higmanVCTree_iota_of]⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_small_mem

/-- **Swap.**  `(u, v) = (v, u)` modulo the relators, for incomparable `u`, `v`. -/
theorem higmanVCTree_mk_swap {d : ℕ} {u v : List (Fin d)} (h1 : ¬ u <+: v) (h2 : ¬ v <+: u) :
    higmanVCCommon_mk d (FreeGroup.of (u, v)) = higmanVCCommon_mk d (FreeGroup.of (v, u)) := by
  have hr := higmanVCCommon_mk_rel (higmanVCCommon_conj_mem (p := u) (q := v) (x := u) (y := v)
    (x' := v) (y' := u) h1 h2 (mapsCone_coneSwap_left h1 h2) (mapsCone_coneSwap_right h1 h2)
    h1 h2 h2 h1)
  rw [map_mul, map_mul, map_mul, map_inv, map_inv, mul_inv_cancel_right] at hr
  exact mul_inv_eq_one.mp hr

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_mk_swap

/-- **Detour.**  `(u, v) = (w, v) (u, w) (w, v)⁻¹` modulo the relators, for pairwise
incomparable `u`, `v`, `w`. -/
theorem higmanVCTree_mk_conj {d : ℕ} {u v w : List (Fin d)} (huv : ¬ u <+: v)
    (hvu : ¬ v <+: u) (huw : ¬ u <+: w) (hwu : ¬ w <+: u) (hwv : ¬ w <+: v)
    (hvw : ¬ v <+: w) :
    higmanVCCommon_mk d (FreeGroup.of (u, v)) =
      higmanVCCommon_mk d (FreeGroup.of (w, v)) * higmanVCCommon_mk d (FreeGroup.of (u, w)) *
        (higmanVCCommon_mk d (FreeGroup.of (w, v)))⁻¹ := by
  have hr := higmanVCCommon_mk_rel (higmanVCCommon_conj_mem (p := w) (q := v) (x := u) (y := w)
    (x' := u) (y' := v) hwv hvw (vgen_mapsCone_coneSwap_fix hwv hvw huw hwu huv hvu)
    (mapsCone_coneSwap_left hwv hvw) huw hwu huv hvu)
  rw [map_mul, map_mul, map_mul, map_inv, map_inv] at hr
  exact (mul_inv_eq_one.mp hr).symm

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_mk_conj

/-- Two distinct letters of `Fin d`, `d ≥ 2`. -/
theorem higmanVCTree_fin_ne {d : ℕ} (hd : 1 < d) :
    (⟨0, by omega⟩ : Fin d) ≠ ⟨1, hd⟩ :=
  fun h => absurd (Fin.mk.inj h) Nat.zero_ne_one

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_fin_ne

/-- **Defect step.**  If every letter of defect `≤ n + 1` lies in `higmanVCTree_S d`, so does
every incomparable letter `(u, v)` with `|v| = |u| + n + 2`. -/
theorem higmanVCTree_step {d n : ℕ} (hd : 1 < d)
    (ih : ∀ u v : List (Fin d), u.length ≤ v.length + n + 1 → v.length ≤ u.length + n + 1 →
      higmanVCCommon_mk d (FreeGroup.of (u, v)) ∈ higmanVCTree_S d)
    {u v : List (Fin d)} (h1 : ¬ u <+: v) (h2 : ¬ v <+: u) (hlen : u.length + n + 1 < v.length)
    (hle : v.length ≤ u.length + n + 2) :
    higmanVCCommon_mk d (FreeGroup.of (u, v)) ∈ higmanVCTree_S d := by
  rcases List.eq_nil_or_concat u with hu | ⟨p, a, hu⟩
  · rw [hu] at h1
    exact (h1 List.nil_prefix).elim
  have hu' : u = p ++ [a] := by rw [hu, List.concat_eq_append]
  subst hu'
  have hla : (p ++ [a]).length = p.length + 1 := by simp
  obtain ⟨w, hwl, hw1, hw2, hw3, hw4⟩ :=
    higmanVCTree_exists_mid (higmanVCTree_fin_ne hd) p a (v := v) (by omega)
  rw [higmanVCTree_mk_conj h1 h2 hw1 hw2 hw3 hw4]
  have hwv := ih w v (by omega) (by omega)
  exact mul_mem (mul_mem hwv (ih (p ++ [a]) w (by omega) (by omega))) (inv_mem hwv)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTree_step

end GroupApproximation.BooneHigman.Metabelian.Envelope
