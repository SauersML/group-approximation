import GroupApproximation.BooneHigman.Metabelian.ElemFPK2KarInjConj
import GroupApproximation.BooneHigman.Metabelian.ElemFPK2KaroubiStatement
import GroupApproximation.Meta.AxiomGuard

/-!
# Status of `R1` (Karoubi-square injectivity) after lane `bh-met-92b`

**Target not closed.**  `k2Karoubi_InjAt (C s₀)` / `k2Karoubi_PosStatement` stay open.

## What is proved (unconditionally, `ElemFPK2KarInjConj`)

* `k2KarInj_conj_opp`: the opposite-root identity
  `x_ji(t) x_ij(v w) x_ji(t)⁻¹ = ⁅x_jk(t v) x_ik(v), x_ki(-(w t)) x_kj(w)⁆`.
* `k2KarInj_conj_mem` (`M ≥ 3`): for every constant root `x_kl(C t)`, `t ∈ L = A_s`, and every
  generator `x_ij(h)` with `h(0) = 0`, the conjugate lies in `S = snd (ker fst)`.  The
  opposite-root case uses the explicit witness
  `⁅x_jk(lift (t h/sⁿ)) x_ik(lift (h/sⁿ)), x_ki(const (-a)) x_kj(const sⁿ)⁆ ∈ ker fst`
  for `t = a/sⁿ`.  This is the generator-level surjectivity step of the square.

## Residual isolated here: `k2KarInj_InjAtThree`

It is `R1` restricted to matrix sizes `M ≥ 3`.  **LOUD: this is EQUIVALENT to
`k2Karoubi_InjAt` (both directions are proved below, by padding).**  It is not strictly weaker
in logical strength.  It is smaller in proof content only by the trivial padding step (an
`R1` proof no longer has to handle `M ≤ 2`).  So the lane fallback ("strictly weaker")
is **NOT met in substance**.  The real remaining gap is Steinberg-level injectivity itself:
an element `y ∈ St(M, P)` with `fst y = 1` and `snd y = 1` must die after padding.

## Truth check (paper, no literature input used as a hypothesis)

* `R1` is believed TRUE.  After stabilisation, `ker(K₂(P) → K₂(A) × K₂(L[X]))` is controlled
  by the birelative term for `A → L` with ideal `X L[X]`, and that term is
  `L ⊗_A (L/A)`-type, which vanishes because `L ⊗_A L = L` (`L` is a localisation of `A`).
* Checked FALSE along the way and **not** used: "`ker fst` is the subgroup generated by the
  `x_ij(lift h)`".  Modulo `I²`, conjugates by `E(A)` have nonzero diagonal part.
* The step from `k2KarInj_conj_mem` to normality of `S` in `St(M, L[X])` needs a
  Vaserstein-type argument, and it is not done.  Every "construct the action" route found
  was circular: it goes through `k2Karoubi_Faithful`, which is `R1` again.

Nothing here uses `k2DilateSt_PullbackStatement`, `k2PullExc_*`, dilation, p-power
filtrations, Witt vectors, Cohen theory, excision or homotopy invariance.
-/

universe u

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup

section KarInjStatement

/-- `R1` at `s`, restricted to matrix sizes `M ≥ 3`.  **Equivalent** to `k2Karoubi_InjAt s`
(see `k2KarInj_injAt_of_three` and `k2KarInj_three_of_injAt`). -/
def k2KarInj_InjAtThree {A : Type u} [CommRing A] (s : A) : Prop :=
  ∀ (M : ℕ), 3 ≤ M → ∀ (y : SteinbergGroup (Fin M) (k2DilateSt_pullback s)),
    ringMap (k2PullRel_fst s) y = 1 → ringMap (k2PullRel_snd s) y = 1 →
      cubeDiagDilate_StDies y

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarInj_InjAtThree

/-- **Reduction**: `R1` for `M ≥ 3` gives `R1`.  Pad `y` to size `max M 3`. -/
theorem k2KarInj_injAt_of_three {A : Type u} [CommRing A] {s : A}
    (h : k2KarInj_InjAtThree s) : k2Karoubi_InjAt s := by
  intro N y h₁ h₂
  refine cubeDiagDilate_stDies_of_indexMap (le_max_left N 3)
    (h (max N 3) (le_max_right N 3) _ ?_ ?_)
  · rw [← GroupApproximation.Full.LVStableK2.indexMap_ringMap, h₁, map_one]
  · rw [← GroupApproximation.Full.LVStableK2.indexMap_ringMap, h₂, map_one]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarInj_injAt_of_three

/-- The converse, so `k2KarInj_InjAtThree s ↔ k2Karoubi_InjAt s` (**equivalent**). -/
theorem k2KarInj_three_of_injAt {A : Type u} [CommRing A] {s : A}
    (h : k2Karoubi_InjAt s) : k2KarInj_InjAtThree s :=
  fun M _ y h₁ h₂ ↦ h M y h₁ h₂

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarInj_three_of_injAt

/-- The positive residual in the `M ≥ 3` form.  **Equivalent** to `k2Karoubi_PosStatement`. -/
def k2KarInj_PosStatement : Prop :=
  ∀ p : ℕ, p.Prime → ∀ k : ℕ, 1 ≤ k → ∀ s₀ : MvPolynomial (Fin k) (ZMod p),
    s₀ ≠ 0 → ¬ IsUnit s₀ →
      k2KarInj_InjAtThree (Polynomial.C s₀ : Polynomial (MvPolynomial (Fin k) (ZMod p)))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarInj_PosStatement

/-- **Reduction**: `k2KarInj_PosStatement → k2Karoubi_PosStatement`. -/
theorem k2KarInj_karoubiPos_of_pos (h : k2KarInj_PosStatement) : k2Karoubi_PosStatement :=
  fun p hp k hk s₀ h0 hu ↦ k2KarInj_injAt_of_three (h p hp k hk s₀ h0 hu)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarInj_karoubiPos_of_pos

/-- The converse (**equivalence**). -/
theorem k2KarInj_pos_of_karoubiPos (h : k2Karoubi_PosStatement) : k2KarInj_PosStatement :=
  fun p hp k hk s₀ h0 hu ↦ k2KarInj_three_of_injAt (h p hp k hk s₀ h0 hu)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarInj_pos_of_karoubiPos

end KarInjStatement

end GroupApproximation.BooneHigman.Metabelian.ElemFP
