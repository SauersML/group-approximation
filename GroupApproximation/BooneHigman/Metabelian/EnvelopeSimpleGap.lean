import GroupApproximation.BooneHigman.Metabelian.EnvelopeSimpleRoom
import GroupApproximation.BooneHigman.Metabelian.EnvelopeSimpleStatement
import GroupApproximation.Meta.AxiomGuard

/-!
# Simplicity of `[V_X(H), V_X(H)]` from displacement, compression and fragmentation

`RNDisplaceCompressStatement` is the remaining dynamical input for
`RNCommutatorSimpleStatement'`; `rnCommutatorSimple_of_gap` proves the reduction.

Route: `isSimpleGroup_commutator_of_bracket` moves to `⁅V, V⁆ ≤ Perm (Cantor X)`, and
`isSimpleGroup_of_room_fragments` applies with `U = cone u` displaced by `f`,
`U₁ = cone (u ++ [a, a])` (room by `threeRoom_cone`, `a ≠ b` from `exists_pair_ne`),
`Small = MissesCone`, and `⁅V, V⁆ ≠ ⊥` by `commutator_rn_ne_bot`.

What the reduction discharges: Epstein's double-commutator trick
(`commutatorElement_mem_of_room`), the expansion of commutators of products of fragments
(`commutator_le_of_fragments`), the room inside a cone, nontriviality of `⁅V, V⁆`, and the
transfer from `⁅V, V⁆` to `commutator ↥V`.  The gap mentions no normal subgroup; it is three
statements about how single elements of `V = V_X(H)` act on cones.

*Truth* (`X` finite with `|X| = d ≥ 2`, `H` self-similar).
* Displacement: `f ≠ 1` moves some point `x`; elements of `V` are locally prefix
  replacements followed by elements of `H`, so a deep cone `cone u ∋ x` is carried onto a cone
  incomparable with `u`, hence disjoint from it.
* Invariance of `MissesCone`: `f '' S` misses `f '' cone c`, which contains a cone.
* Compression into `cone w`: a set missing `cone c` lies in the proper clopen set
  `A = (cone c)ᶜ`, a union of `n` cones with complement of `m` cones, `n + m ≡ 1 mod (d - 1)`.
  Inside `cone w` choose a union `B` of `n` cones of a deep subdivision, not all of them;
  its complement has `≡ m` cones, so some `k ∈ V_X` maps `A` onto `B`.  Since
  `V_X / [V_X, V_X]` has order `≤ 2` (Higman), `k` or `σ k` lies in `[V_X, V_X] ≤ [V, V]`,
  `σ` a cone swap fixing `B` pointwise, and either maps `A` into `cone w`.
* Fragmentation: every element of `V` is a product of elements each supported in the union
  of two depth-3 cones: a cone swap `v ↔ w` is the product of the swaps `v ++ c ↔ w ++ c`,
  `|c| = 3`, `V_X` is generated by cone swaps, and by self-similarity a localized
  `localize w h` with `|w| < 3` is a cone permutation times the `localize (w ++ c) (h|_c)`.
  Two such fragments are supported in at most `4 < 8 ≤ d ^ 3` depth-3 cones, so jointly in a
  set missing a cone.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

open scoped commutatorElement
open Trees

variable {X : Type*}

/-- A set of streams missing some cone. -/
def MissesCone (S : Set (Cantor X)) : Prop :=
  ∃ c : List X, Disjoint S (cone c)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.MissesCone

/-- **Displacement, compression and fragmentation for `V_X(H)`.** -/
def RNDisplaceCompressStatement : Prop :=
  ∀ (X : Type) [Finite X] [Nontrivial X] (H : Subgroup (TreeAut X)), IsSelfSimilar H →
    (∀ f ∈ ⁅roverNekrashevych X H, roverNekrashevych X H⁆, f ≠ 1 →
      ∃ u : List X, Disjoint (f '' cone u) (cone u)) ∧
    (∀ (u : List X) (a : X),
      Compressible (roverNekrashevych X H) (cone (u ++ [a, a])) MissesCone) ∧
    Fragments (roverNekrashevych X H) MissesCone

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.RNDisplaceCompressStatement

/-- Displacement, compression and fragmentation give simplicity of `[V_X(H), V_X(H)]`. -/
theorem rnCommutatorSimple_of_gap (h : RNDisplaceCompressStatement) :
    RNCommutatorSimpleStatement' := by
  intro X _ _ H hH
  obtain ⟨hdisp, hcomp, hfrag⟩ := h X H hH
  obtain ⟨a, b, hab⟩ := exists_pair_ne X
  refine isSimpleGroup_commutator_of_bracket (roverNekrashevych X H) ?_
  refine isSimpleGroup_of_room_fragments (roverNekrashevych X H) (commutator_rn_ne_bot H) ?_
  intro f hf hf1
  obtain ⟨u, hu⟩ := hdisp f hf hf1
  exact ⟨cone u, cone (u ++ [a, a]), MissesCone, hu, threeRoom_cone H u hab, hcomp u a, hfrag⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.rnCommutatorSimple_of_gap

end GroupApproximation.BooneHigman.Metabelian.Envelope
