import GroupApproximation.BooneHigman.Metabelian.PureCharPrimeEHighETwo
import GroupApproximation.BooneHigman.Metabelian.PureCharPrimeEHighArtinHasseAlg
import GroupApproximation.Meta.AxiomGuard

/-!
# The `e = 2` unit-group residual from invariant function spaces (bh-met-87b)

**Target.**  `EHighETwoUnitsStatement` (`PureCharPrimeEHighETwo.lean:100`).  It asks for a
finite-dimensional commutative `K`-algebra `B` in characteristic `p`, an injective
`θ : Multiplicative M →* B`, and `σ : Q →* (B ≃ₐ[K] B)` with `θ (q • m) = σ q (θ m)`.

**Not proved: the target itself.**  What is proved is `eHighETwoUnits_of_polyFun`, a reduction to
`EHighArtinHassePolyFunStatement`.  That statement asks for a field `L` of characteristic `p`
and a finite-dimensional `V ⊆ (M → L)` which is stable under translations, stable under
precomposition with `x ↦ q • x`, and separates points (`m ≠ 0 → ∃ f ∈ V, f m ≠ f 0`).  The
algebra `B`, its commutativity and finiteness, the automorphisms `σ` and the injectivity of `θ`
are all discharged by `eHighArtinHasse_exists_units_of_polyFun`
(`PureCharPrimeEHighArtinHasseAlg`).  There `B` is the algebra generated by the translation
operators on `V`, and `σ q` is conjugation by `f ↦ f ∘ (q⁻¹ • ·)`.

**LOUD: the gap is only equivalent, not strictly weaker.**  The converse holds on paper.  Given
`κ : M → GL_d(K)` and `ρ` as in `EHighETwoStatement`, the matrix coefficients `x ↦ κ(x)ᵢⱼ` span
a `V` of dimension `≤ d²`:

* it is translation-stable, since `κ (x + m) = κ x * κ m`;
* it is `Q`-stable, since `κ (q • x) = ρ q * κ x * (ρ q)⁻¹`;
* it separates points, since `κ` is injective.

So the gap sits between `EHighETwoStatement` and `EHighETwoUnitsStatement`, which are
interderivable.  It is smaller only in *proof content*: it states no algebra, no automorphisms
and no injective hom.

**Truth.**  The statement is true, since it is implied by `EHighETwoStatement` as above.  The
direct Witt-vector route (paper only, no p-power filtration gluing) goes as follows.

* Embed `M` `Q`-equivariantly into `W₂(L)ⁿ` for a perfect field `L ⊇ F_p`, with `Q` acting
  through `GL_n(W₂(L))`.
* Take `V` to be the restrictions of the polynomials on `W₂(L)ⁿ` of weighted degree `≤ p`, where
  each `x₀`-coordinate has weight `1` and each `x₁`-coordinate has weight `p`.

Witt addition `(a₀, a₁) + (b₀, b₁) = (a₀ + b₀, a₁ + b₁ - Σ_{0<i<p} p⁻¹ (p choose i) a₀ⁱ b₀ᵖ⁻ⁱ)`
is isobaric, and so is `W₂(L)`-linear substitution.  Hence `V` is translation-stable and
`GL_n(W₂(L))`-stable.  It separates points because it contains the coordinate functions.

The non-Teichmüller units that make the model `(ℤ/p²)[s^±]` (with `t` acting as `1 + p s`)
delicate are harmless here.  `(1, c) · (a₀, a₁) = (a₀, a₁ + c a₀ᵖ)` is not `L`-linear in the Witt
coordinates, but pullback along it *is* `L`-linear on `V`, and `V` is all this criterion needs.
No additive model exists: exponent `p²` never embeds into a vector space in characteristic `p`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Coprimary

/-- **Gap (bh-met-87b).**  An invariant, point-separating, finite-dimensional space of
`L`-valued functions on `M`, for a field `L` of characteristic `p`. -/
def EHighArtinHassePolyFunStatement : Prop :=
  ∀ p : ℕ, p.Prime → ∀ (Q : Type) [CommGroup Q], Group.FG Q →
    ∀ (M : Type) [AddCommGroup M] [Module (MonoidAlgebra (ZMod (p ^ 2)) Q) M],
      Module.Finite (MonoidAlgebra (ZMod (p ^ 2)) Q) M →
      ∀ (P : Ideal (MonoidAlgebra (ZMod (p ^ 2)) Q)) (k : ℕ),
        Primary.IsCoprimaryWith (MonoidAlgebra (ZMod (p ^ 2)) Q) M P k →
        ((p : ℕ) : MonoidAlgebra (ZMod (p ^ 2)) Q) ∈ P →
        2 ≤ k → (∃ m : M, p • m ≠ 0) → Infinite M →
      ∃ (L : Type) (_ : Field L), ringChar L = p ∧
        ∃ V : Submodule L (M → L), FiniteDimensional L V ∧
          (∀ m : M, ∀ f ∈ V, (fun x => f (x + m)) ∈ V) ∧
          (∀ q : Q, ∀ f ∈ V, (fun x => f (MonoidAlgebra.of (ZMod (p ^ 2)) Q q • x)) ∈ V) ∧
          (∀ m : M, m ≠ 0 → ∃ f ∈ V, f m ≠ f 0)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.EHighArtinHassePolyFunStatement

/-- **Endpoint (reduction).**  The unit-group residual follows from the invariant
function-space criterion. -/
theorem eHighETwoUnits_of_polyFun (h : EHighArtinHassePolyFunStatement) :
    EHighETwoUnitsStatement := by
  intro p hp Q _ hfg M _ _ hfin P k hM hpP hk hne hinf
  obtain ⟨L, hL, hchar, V, hfd, htrans, hact, hsep⟩ :=
    h p hp Q hfg M hfin P k hM hpP hk hne hinf
  haveI : FiniteDimensional L V := hfd
  obtain ⟨B, hB, hBalg, hBfin, θ, σ, hθ, hequiv⟩ :=
    eHighArtinHasse_exists_units_of_polyFun
      (fun (q : Q) (m : M) => MonoidAlgebra.of (ZMod (p ^ 2)) Q q • m)
      (fun q x y => smul_add (MonoidAlgebra.of (ZMod (p ^ 2)) Q q) x y)
      (fun _ _ _ => by simp only [map_mul, mul_smul])
      (fun _ => by simp only [map_one, one_smul])
      V htrans hact hsep
  exact ⟨L, hL, B, hB, hBalg, hBfin, hchar, θ, σ, hθ, hequiv⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighETwoUnits_of_polyFun

/-- **Composite endpoint.**  The `e = 2` infinite mixed case follows from the invariant
function-space criterion. -/
theorem eHighETwo_of_polyFun (h : EHighArtinHassePolyFunStatement) : EHighETwoStatement :=
  eHighETwo_of_units (eHighETwoUnits_of_polyFun h)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighETwo_of_polyFun

end GroupApproximation.BooneHigman.Metabelian.Coprimary
