import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2BaseEndpoint
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2BaseCentral
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.PaddedCentral
import GroupApproximation.Meta.AxiomGuard

/-!
# `K₂(N, ℤ[1/m])`, `m ≥ 1`: finite generation from a finite set stabilized from rank `N - 1`

Lane `bh-met-47`.  Lane `bh-met-36` (module `ElemFPCharZeroK2BaseEndpoint`) isolated
`CharZeroK2BasePosFGStatement := ∀ m N, 0 < m → 5 ≤ N → Group.FG (K₂(N, ℤ[1/m]))`.

## Results

* `k2_fg_of_le_normalClosure_stab`, for an arbitrary ring `R`: let `s ⊆ K₂(n, R)` be finite with
  `K₂(n+1, R) ≤ ⟪stab '' s⟫` (normal closure in `St_{n+1}(R)`).  Then `K₂(n+1, R)` is finitely
  generated, and in fact equals `closure (stab '' s)`.  Proof: the padded centrality theorem
  `LeavittK2.map_stab_K2_le_center` (unconditional, all ranks; Milnor's column/row argument) puts
  `stab '' s` in the centre of `St_{n+1}(R)`.  A set of central elements has the same normal
  closure and closure (`normalClosure_eq_closure_of_subset_center`, lane `bh-met-36`), and
  `stab '' s ⊆ K₂(n+1, R)`.
* `exists_finite_normalClosure_stab_of_fg_of_le_map`, for an arbitrary ring: finite generation of
  `K₂(n, R)` together with surjective stability `K₂(n+1, R) ≤ stab K₂(n, R)` gives the hypothesis
  of the previous item.
* `CharZeroK2PosStabGenStatement`: for `m ≥ 1`, `n ≥ 4`, some finite `s ⊆ K₂(n, ℤ[1/m])` has
  `K₂(n+1, ℤ[1/m]) ≤ ⟪stab '' s⟫`.  **This is the isolated gap.**
* `charZeroK2BasePos_of_stabGen`: the gap implies `CharZeroK2BasePosFGStatement`.
* `charZeroK2PosStabGen_of_fg_of_surj`: the gap follows from (finite generation of `K₂(n, ℤ[1/m])`
  for `n ≥ 4`) and (surjective stability at `n ≥ 4`).  So the gap is logically no stronger than
  that conjunction.
* `charZeroK2BaseFG_of_stabGen`: the composite with `charZeroK2BaseFG_of_pos`.

## Truth check

`ℤ[1/m]` (`m ≥ 1`) is a Dedekind domain, so its Bass stable rank is at most `2`.  Surjective
stability for `K₂` (van der Kallen: `K₂(n, R) → K₂(n+1, R)` onto for `n ≥ sr(R) + 1`) holds at
`n ≥ 4`, and injective stability (`n ≥ sr(R) + 2 = 4`) identifies `K₂(n, ℤ[1/m])` with the stable
`K₂(ℤ[1/m])`, which is finite by Tate's localization sequence
`0 → K₂(ℤ) → K₂(ℤ[1/m]) → ⊕_{p ∣ m} F_p^× → 0` and Milnor's `K₂(ℤ) = ℤ/2`.  Take for `s` a finite
generating set of `K₂(n, ℤ[1/m])`.  Case `m = 1`: `K₂(n, ℤ) = ℤ/2` for `n ≥ 3`, generated by
`{-1,-1}` coming from `St_3`, so `s = {{-1,-1}}` works.  The gap is **true**.

## Why the gap is strictly smaller in proof content

The target needs a finite generating set of `K₂(N, ℤ[1/m])` itself.  The gap only asks for a
finite subset of the *smaller* group `K₂(N-1, ℤ[1/m])` whose stabilization *normally* generates
`K₂(N)`.  The passage from normal generation to generation, which needs centrality, is proved here
(from the repository's padded centrality theorem).  The gap asks for no centrality and no
generation, only normal generation.

## LOUD warning: route (b) is false

The suggested route "`K₂(N, ℤ[1/m])` is generated by Steinberg symbols `{u, v}` of units" is
**false** for `m = 5` (and for `m = 7, 11, …`).  Tate: `K₂(ℤ[1/5]) ≅ ℤ/2 ⊕ F_5^×` has order `8`.
The units are `±5^k`, and the tame symbol at `5` sends `{-1,-1} ↦ 1`, `{5,-1} ↦ -1`,
`{5,5} ↦ -1`.  So symbols of units span a subgroup of order at most `4`.  Generation by symbols
needs non-unit entries (e.g. `{2,5}` lives in `K₂(ℚ)`, not `K₂(ℤ[1/5])`) or Dennis–Stein symbols.
So that route is not taken, and no symbol bimultiplicativity is developed here.

Route (a), finite presentation of `St_N(ℤ[1/m])` plus `E_N(ℤ[1/m])`, is circular (lane
`bh-met-36`, module `ElemFPCharZeroK2BaseCentral`), so it is not taken either.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2 (map_stab_K2_le_center)

section General

variable {R : Type*} [Ring R] {n : ℕ}

/-- The stabilization of a subset of `K₂(n, R)` is central in `St_{n+1}(R)`. -/
theorem stab_image_subset_center {s : Set (St n R)} (hsK : s ⊆ K2 (Fin n) R) :
    stab n R '' s ⊆ Subgroup.center (St (n + 1) R) := by
  rintro _ ⟨k, hk, rfl⟩
  have hk' : k ∈ K2 (Fin n) R := hsK hk
  exact map_stab_K2_le_center (R := R) (n := n) (Subgroup.mem_map_of_mem (stab n R) hk')

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.stab_image_subset_center

/-- If a finite `s ⊆ K₂(n, R)` has stabilization normally generating `K₂(n+1, R)`, then the
stabilization generates `K₂(n+1, R)`. -/
theorem closure_stab_image_eq_K2 {s : Set (St n R)} (hsK : s ⊆ K2 (Fin n) R)
    (hle : K2 (Fin (n + 1)) R ≤ Subgroup.normalClosure (stab n R '' s)) :
    Subgroup.closure (stab n R '' s) = K2 (Fin (n + 1)) R := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro _ ⟨k, hk, rfl⟩
    exact (K2Stab n R ⟨k, hsK hk⟩).2
  · rw [← normalClosure_eq_closure_of_subset_center (stab_image_subset_center hsK)]
    exact hle

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.closure_stab_image_eq_K2

/-- **Finite generation from a stabilized finite normal generating set**, any ring. -/
theorem k2_fg_of_le_normalClosure_stab {s : Set (St n R)} (hsfin : s.Finite)
    (hsK : s ⊆ K2 (Fin n) R)
    (hle : K2 (Fin (n + 1)) R ≤ Subgroup.normalClosure (stab n R '' s)) :
    Group.FG (K2 (Fin (n + 1)) R) :=
  (Group.fg_iff_subgroup_fg _).mpr
    ((Subgroup.fg_iff _).mpr ⟨_, closure_stab_image_eq_K2 hsK hle, hsfin.image _⟩)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.k2_fg_of_le_normalClosure_stab

/-- Finite generation of `K₂(n, R)` and surjective stability give a finite `s ⊆ K₂(n, R)` whose
stabilization normally generates `K₂(n+1, R)`. -/
theorem exists_finite_normalClosure_stab_of_fg_of_le_map (hfg : Group.FG (K2 (Fin n) R))
    (hsurj : K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R)) :
    ∃ s : Set (St n R), s.Finite ∧ s ⊆ K2 (Fin n) R ∧
      K2 (Fin (n + 1)) R ≤ Subgroup.normalClosure (stab n R '' s) := by
  obtain ⟨S, hS, hSfin⟩ := (Subgroup.fg_iff _).mp ((Group.fg_iff_subgroup_fg _).mp hfg)
  refine ⟨S, hSfin, ?_, ?_⟩
  · rw [← hS]
    exact Subgroup.subset_closure
  · calc K2 (Fin (n + 1)) R ≤ (K2 (Fin n) R).map (stab n R) := hsurj
      _ = Subgroup.closure (stab n R '' S) := by rw [← hS, MonoidHom.map_closure]
      _ ≤ Subgroup.normalClosure (stab n R '' S) := Subgroup.closure_le_normalClosure

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.exists_finite_normalClosure_stab_of_fg_of_le_map

end General

/-- **Gap (lane `bh-met-47`).**  For `m ≥ 1` and `n ≥ 4`, some finite subset of `K₂(n, ℤ[1/m])`
has stabilization normally generating `K₂(n+1, ℤ[1/m])` in `St_{n+1}(ℤ[1/m])`.  True by surjective
stability (`sr(ℤ[1/m]) ≤ 2`) and finiteness of `K₂(n, ℤ[1/m])` (Tate, Milnor); see the module
docstring. -/
def CharZeroK2PosStabGenStatement : Prop :=
  ∀ m n : ℕ, 0 < m → 4 ≤ n →
    ∃ s : Set (St n (Localization.Away (m : ℤ))), s.Finite ∧
      s ⊆ K2 (Fin n) (Localization.Away (m : ℤ)) ∧
      K2 (Fin (n + 1)) (Localization.Away (m : ℤ)) ≤
        Subgroup.normalClosure (stab n (Localization.Away (m : ℤ)) '' s)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.CharZeroK2PosStabGenStatement

/-- **Endpoint (lane `bh-met-47`).**  The gap gives `CharZeroK2BasePosFGStatement`. -/
theorem charZeroK2BasePos_of_stabGen (h : CharZeroK2PosStabGenStatement) :
    CharZeroK2BasePosFGStatement := by
  intro m N hm h5N
  obtain ⟨n, rfl⟩ : ∃ n, N = n + 1 := ⟨N - 1, by omega⟩
  obtain ⟨s, hsfin, hsK, hle⟩ := h m n hm (by omega)
  exact k2_fg_of_le_normalClosure_stab hsfin hsK hle

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroK2BasePos_of_stabGen

/-- The gap follows from finite generation of `K₂(n, ℤ[1/m])` at `n ≥ 4` together with surjective
stability at `n ≥ 4`. -/
theorem charZeroK2PosStabGen_of_fg_of_surj
    (hfg : ∀ m n : ℕ, 0 < m → 4 ≤ n → Group.FG (K2 (Fin n) (Localization.Away (m : ℤ))))
    (hsurj : ∀ m n : ℕ, 0 < m → 4 ≤ n →
      K2 (Fin (n + 1)) (Localization.Away (m : ℤ)) ≤
        (K2 (Fin n) (Localization.Away (m : ℤ))).map (stab n (Localization.Away (m : ℤ)))) :
    CharZeroK2PosStabGenStatement := fun m n hm h4n ↦
  exists_finite_normalClosure_stab_of_fg_of_le_map (hfg m n hm h4n) (hsurj m n hm h4n)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroK2PosStabGen_of_fg_of_surj

/-- The gap gives `CharZeroK2BaseFGStatement` (all `m`, `N ≥ 5`). -/
theorem charZeroK2BaseFG_of_stabGen (h : CharZeroK2PosStabGenStatement) :
    CharZeroK2BaseFGStatement :=
  charZeroK2BaseFG_of_pos (charZeroK2BasePos_of_stabGen h)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.charZeroK2BaseFG_of_stabGen

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
