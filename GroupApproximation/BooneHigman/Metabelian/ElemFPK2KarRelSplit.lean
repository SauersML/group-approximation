import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Algebra.Group.Submonoid.Membership
import Mathlib.Tactic.Group
import GroupApproximation.BooneHigman.Metabelian.ElemFPK2PullRelDefs
import GroupApproximation.Meta.AxiomGuard

/-!
# The split relative Steinberg lemma

Lane `bh-met-92u`, split module.  Let `f : R →+* S` have a ring section `g` (`f ∘ g = id`).  If a
normal subgroup `N ⊆ St(I, R)` contains every `x_ij(b)` with `f b = 0`, then
`ker (St f) ≤ N` (`k2KarRel_ker_le_of_section`).  On a generator,
`x_ij(g (f b))⁻¹ x_ij(b) = x_ij(b - g (f b))` and `f (b - g (f b)) = 0`, so
`St(I, R) → St(I, R) / N` factors through `St g ∘ St f`.  This is the argument of
`k2KarNorm_ker_le` for any split surjection.

For `fst : P → A`, split by `const`:

* `k2KarRel_ker_eq_normalClosure`:
  `k2PullRel_ker s M = normalClosure {x_ij(b) : fst b = 0}`;
* `k2KarRel_ker_eq_closure`: `k2PullRel_ker s M = closure (k2KarRel_gens s M)`, where the
  generators are the conjugates `g x_ij(b) g⁻¹` with `fst b = 0`;
* `k2KarRel_exists_list`: every `y ∈ ker fst` is a finite product of such conjugates.

(Unlike the FALSE claim "`ker fst` is generated by `x_ij(lift h)`", conjugates by arbitrary
`g ∈ St(M, P)` are allowed here.)
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP

open GroupApproximation.BooneHigman.SteinbergBasic GroupApproximation.SteinbergGroup

section KarRelSplit

variable {I R S : Type*} [Fintype I] [DecidableEq I] [CommRing R] [CommRing S]

/-- **Split relative lemma.**  For `f` with a ring section `g`, every normal subgroup that
contains all `x_ij(b)` with `f b = 0` contains `ker (St f)`. -/
theorem k2KarRel_ker_le_of_section (f : R →+* S) (g : S →+* R) (hfg : ∀ b, f (g b) = b)
    (N : Subgroup (SteinbergGroup I R)) [N.Normal]
    (hN : ∀ (i j : I) (hij : i ≠ j) (b : R), f b = 0 → x i j hij b ∈ N) :
    (ringMap (I := I) f).ker ≤ N := by
  have key : (QuotientGroup.mk' N).comp ((ringMap (I := I) g).comp (ringMap (I := I) f)) =
      QuotientGroup.mk' N := by
    apply PresentedGroup.ext
    rintro ⟨i, j, hij, b⟩
    change QuotientGroup.mk' N (ringMap g (ringMap f (x i j hij b))) =
      QuotientGroup.mk' N (x i j hij b)
    rw [ringMap_x, ringMap_x, QuotientGroup.mk'_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq, ← x_neg, x_mul]
    apply hN
    rw [map_add, map_neg, hfg, neg_add_cancel]
  intro y hy
  rw [MonoidHom.mem_ker] at hy
  have e := DFunLike.congr_fun key y
  simp only [MonoidHom.comp_apply, hy, map_one] at e
  exact (QuotientGroup.eq_one_iff y).mp e.symm

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarRel_ker_le_of_section

end KarRelSplit

section KarRelFst

variable {A : Type*} [CommRing A] (s : A) (M : ℕ)

theorem k2KarRel_ker_fst_le (N : Subgroup (SteinbergGroup (Fin M) (k2DilateSt_pullback s)))
    [N.Normal] (hN : ∀ (i j : Fin M) (hij : i ≠ j) (b : k2DilateSt_pullback s),
      k2PullRel_fst s b = 0 → x i j hij b ∈ N) :
    k2PullRel_ker s M ≤ N :=
  k2KarRel_ker_le_of_section (k2PullRel_fst s) (k2PullRel_const s) (k2PullRel_fst_const s) N hN

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarRel_ker_fst_le

/-- The relative root elements `x_ij(b)`, `fst b = 0`. -/
def k2KarRel_relGens : Set (SteinbergGroup (Fin M) (k2DilateSt_pullback s)) :=
  {y | ∃ i j : Fin M, ∃ hij : i ≠ j, ∃ b : k2DilateSt_pullback s,
    k2PullRel_fst s b = 0 ∧ x i j hij b = y}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarRel_relGens

/-- **`ker fst = normalClosure {x_ij(b) : fst b = 0}`.** -/
theorem k2KarRel_ker_eq_normalClosure :
    k2PullRel_ker s M = Subgroup.normalClosure (k2KarRel_relGens s M) := by
  haveI : (k2PullRel_ker s M).Normal := MonoidHom.normal_ker (ringMap (k2PullRel_fst s))
  apply le_antisymm
  · exact k2KarRel_ker_fst_le s M _ fun i j hij b hb ↦
      Subgroup.subset_normalClosure ⟨i, j, hij, b, hb, rfl⟩
  · refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨i, j, hij, b, hb, rfl⟩
    exact k2PullRel_x_mem i j hij hb

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarRel_ker_eq_normalClosure

/-- The conjugates `g x_ij(b) g⁻¹` (`g ∈ St(M, P)` arbitrary, `fst b = 0`). -/
def k2KarRel_gens : Set (SteinbergGroup (Fin M) (k2DilateSt_pullback s)) :=
  {y | ∃ g : SteinbergGroup (Fin M) (k2DilateSt_pullback s), ∃ i j : Fin M, ∃ hij : i ≠ j,
    ∃ b : k2DilateSt_pullback s, k2PullRel_fst s b = 0 ∧ g * x i j hij b * g⁻¹ = y}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarRel_gens

variable {s M}

theorem k2KarRel_gens_inv {y : SteinbergGroup (Fin M) (k2DilateSt_pullback s)}
    (hy : y ∈ k2KarRel_gens s M) : y⁻¹ ∈ k2KarRel_gens s M := by
  obtain ⟨g, i, j, hij, b, hb, rfl⟩ := hy
  refine ⟨g, i, j, hij, -b, by rw [map_neg, hb, neg_zero], ?_⟩
  rw [x_neg]
  group

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarRel_gens_inv

theorem k2KarRel_gens_mem_ker {y : SteinbergGroup (Fin M) (k2DilateSt_pullback s)}
    (hy : y ∈ k2KarRel_gens s M) : y ∈ k2PullRel_ker s M := by
  obtain ⟨g, i, j, hij, b, hb, rfl⟩ := hy
  rw [k2PullRel_mem_ker, map_mul, map_mul, map_inv, ringMap_x, hb, x_zero, mul_one,
    mul_inv_cancel]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.k2KarRel_gens_mem_ker

end KarRelFst

end GroupApproximation.BooneHigman.Metabelian.ElemFP
