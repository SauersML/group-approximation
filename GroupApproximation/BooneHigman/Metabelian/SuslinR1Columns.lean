import GroupApproximation.BooneHigman.Metabelian.SuslinHorrocksReduce
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# R1, part 1: a monic polynomial in the ideal of the other entries gives a monic entry

Lane `bh-met-90j`.  Let `M` be invertible over `R[X]`, and suppose the ideal generated by the
entries of row `r` of `M` outside column `t` contains a monic polynomial `p`, say
`p = ∑_{j ≠ t} c_j M r j`.  Adding `X^n c_j` times column `j` to column `t`, for every `j ≠ t`,
turns the entry at `(r, t)` into `M r t + X^n p`, which is monic once `n > deg (M r t)`
(`suslinR1_monic_of_mem_span`).  Moreover, if the quotient `R[X] / I` of `R[X]` by this ideal
`I` is a finite `R`-module, then the class of `X` is integral over `R`, so `I` contains a monic
polynomial (`suslinR1_exists_monic_mem_of_finite`, `suslinR1_monic_of_finite`).

No locality of `R` is used; only `Nontrivial R`, for the degree count.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- Right multiplication by `x_{i j}(a)` leaves every column `c ≠ j` unchanged. -/
theorem suslinR1_mul_elementaryUnit_ne (M : Matrix ι ι R) (i j : ι) (hij : i ≠ j) (a : R)
    (r c : ι) (hc : c ≠ j) :
    (M * ((elementaryUnit i j hij a : (Matrix ι ι R)ˣ) : Matrix ι ι R)) r c = M r c := by
  rw [mul_elementaryUnit_apply, if_neg hc]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_mul_elementaryUnit_ne

/-- **Adding many columns into column `t`.**  Right multiplication by the product of
`x_{k t}(a k)` over a list of indices `k ≠ t` adds `∑ M r k * a k` to the entry at `(r, t)`. -/
theorem suslinR1_mul_colSum_apply (M : Matrix ι ι R) (t : ι) (a : ι → R)
    (l : List {k : ι // k ≠ t}) (r : ι) :
    (M * (((l.map fun k ↦ elementaryUnit (k : ι) t k.property (a k)).prod :
        (Matrix ι ι R)ˣ) : Matrix ι ι R)) r t =
      M r t + (l.map fun k ↦ M r k * a k).sum := by
  induction l generalizing M with
  | nil => simp
  | cons k l ih =>
    simp only [List.map_cons, List.prod_cons, List.sum_cons]
    rw [Units.val_mul, ← mul_assoc, ih, mul_elementaryUnit_apply, if_pos rfl, add_assoc]
    have hs : (l.map fun k' : {k' : ι // k' ≠ t} ↦
        (M * ((elementaryUnit (k : ι) t k.property (a k) : (Matrix ι ι R)ˣ) :
          Matrix ι ι R)) r k' * a k') = l.map fun k' ↦ M r k' * a k' :=
      List.map_congr_left fun k' _ ↦ by
        rw [suslinR1_mul_elementaryUnit_ne M (k : ι) t k.property (a k) r k' k'.property]
    rw [hs]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_mul_colSum_apply

/-- The column-sum factor lies in the elementary group. -/
theorem suslinR1_colSum_mem (t : ι) (a : ι → R) (l : List {k : ι // k ≠ t}) :
    ((l.map fun k ↦ elementaryUnit (k : ι) t k.property (a k)).prod : (Matrix ι ι R)ˣ) ∈
      elementaryGroup ι R := by
  refine Subgroup.list_prod_mem _ fun x hx ↦ ?_
  obtain ⟨k, _, rfl⟩ := List.mem_map.1 hx
  exact elementaryUnit_mem _ _ _ _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_colSum_mem
