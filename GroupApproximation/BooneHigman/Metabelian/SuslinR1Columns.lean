import GroupApproximation.BooneHigman.Metabelian.SuslinHorrocksReduce
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Algebra.Polynomial.AlgebraMap
import GroupApproximation.Meta.AxiomGuard

/-!
# R1, part 1: a monic polynomial in the ideal of the other entries gives a monic entry

Lane `bh-met-90j`.  Let `M` be invertible over `R[X]`, and suppose the ideal generated by the
entries of row `r` of `M` outside column `t` contains a monic polynomial `p`, say
`p = ∑_{j ≠ t} c_j M r j`.  Adding `X^n c_j` times column `j` to column `t`, for every `j ≠ t`,
turns the entry at `(r, t)` into `M r t + X^n p`, which is monic once `n > deg (M r t)`
(`suslinR1_monic_of_mem_span`).  Moreover, if the quotient `R[X] / I` of `R[X]` by this ideal
`I` is a finite `R`-module, then the class of `X` is integral over `R`, so `I` contains a monic
polynomial (`suslinR1_monicMem_of_finite`, `suslinR1_monic_of_finite`).

No locality of `R` is used; only `Nontrivial R`, for the degree count.
-/

namespace GroupApproximation
namespace BooneHigman
namespace Metabelian
namespace Absorption

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι]

/-- Right multiplication by `x_{i j}(a)` leaves every column `c ≠ j` unchanged. -/
theorem suslinR1_mul_elementaryUnit_ne (M : Matrix ι ι R) (i j : ι) (hij : i ≠ j) (a : R)
    (r c : ι) (hc : c ≠ j) :
    (M * ((elementaryUnit i j hij a : (Matrix ι ι R)ˣ) : Matrix ι ι R)) r c = M r c := by
  rw [mul_elementaryUnit_apply, if_neg hc]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_mul_elementaryUnit_ne

/-- **Adding many columns into column `t`.**  Right multiplication by the product of
`x_{k t}(a k)` over a list of indices `k ≠ t` adds `∑ M r k * a k` to the entry at `(r, t)`. -/
theorem suslinR1_mul_colSum_apply (M : Matrix ι ι R) (t : ι) (a : {k : ι // k ≠ t} → R)
    (l : List {k : ι // k ≠ t}) (r : ι) :
    (M * (((l.map fun k ↦ elementaryUnit (k : ι) t k.property (a k)).prod :
        (Matrix ι ι R)ˣ) : Matrix ι ι R)) r t =
      M r t + (l.map fun k ↦ M r k * a k).sum := by
  induction l generalizing M with
  | nil => simp
  | cons k l ih =>
    simp only [List.map_cons, List.prod_cons, List.sum_cons]
    rw [Units.val_mul, ← mul_assoc, ih, mul_elementaryUnit_apply, if_pos rfl, add_assoc]
    have hs : (l.map fun k' : {k' : ι // k' ≠ t} ↦
        (M * ((elementaryUnit (k : ι) t k.property (a k) : (Matrix ι ι R)ˣ) :
          Matrix ι ι R)) r k' * a k') = l.map fun k' ↦ M r k' * a k' :=
      List.map_congr_left fun k' _ ↦ congrArg (fun x : R ↦ x * a k')
        (suslinR1_mul_elementaryUnit_ne M (k : ι) t k.property (a k) r k' k'.property)
    rw [hs]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_mul_colSum_apply

/-- The column-sum factor lies in the elementary group. -/
theorem suslinR1_colSum_mem (t : ι) (a : {k : ι // k ≠ t} → R) (l : List {k : ι // k ≠ t}) :
    ((l.map fun k ↦ elementaryUnit (k : ι) t k.property (a k)).prod : (Matrix ι ι R)ˣ) ∈
      elementaryGroup ι R := by
  refine Subgroup.list_prod_mem _ fun x hx ↦ ?_
  obtain ⟨k, _, rfl⟩ := List.mem_map.1 hx
  exact elementaryUnit_mem _ _ _ _

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_colSum_mem
/-- **A monic polynomial in the ideal of the other entries gives a monic entry.**  If the ideal
generated by the entries of row `r` of `M` outside column `t` contains a monic `p`, then some
`M F`, with `F` elementary, has a monic entry at `(r, t)`: namely `M r t + X^n p` for
`n > deg (M r t)`. -/
theorem suslinR1_monic_of_mem_span [Nontrivial R] (M : (Matrix ι ι (Polynomial R))ˣ) (r t : ι)
    {p : Polynomial R} (hp : p.Monic)
    (hmem : p ∈ Ideal.span (Set.range fun j : {j : ι // j ≠ t} ↦
      (M : Matrix ι ι (Polynomial R)) r j)) :
    ∃ F ∈ elementaryGroup ι (Polynomial R),
      (((M * F : (Matrix ι ι (Polynomial R))ˣ) : Matrix ι ι (Polynomial R)) r t).Monic := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1 hmem
  have hc' : ∑ j, c j * (M : Matrix ι ι (Polynomial R)) r j = p := hc
  obtain ⟨n, hn⟩ : ∃ n : ℕ, ((M : Matrix ι ι (Polynomial R)) r t).natDegree < n :=
    ⟨_, Nat.lt_succ_self _⟩
  refine ⟨((Finset.univ : Finset {k : ι // k ≠ t}).toList.map fun k ↦
      elementaryUnit (k : ι) t k.property (Polynomial.X ^ n * c k)).prod,
    suslinR1_colSum_mem t _ _, ?_⟩
  rw [Units.val_mul, suslinR1_mul_colSum_apply]
  have hsum : ((Finset.univ : Finset {k : ι // k ≠ t}).toList.map fun k ↦
      (M : Matrix ι ι (Polynomial R)) r k * (Polynomial.X ^ n * c k)).sum =
        Polynomial.X ^ n * p := by
    rw [Finset.sum_map_toList, ← hc', Finset.mul_sum]
    exact Finset.sum_congr rfl fun k _ ↦ by ring
  rw [hsum]
  refine Polynomial.Monic.add_of_right ((Polynomial.monic_X_pow n).mul hp)
    (Polynomial.degree_lt_degree ?_)
  rw [Polynomial.natDegree_X_pow_mul n hp.ne_zero]
  omega

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_monic_of_mem_span

/-- **Finite quotient gives a monic element.**  If `B[X] / I` is a finite `B`-module, then `I`
contains a monic polynomial: the class of `X` is integral over `B`. -/
theorem suslinR1_monicMem_of_finite {B : Type*} [CommRing B] (I : Ideal (Polynomial B))
    (hfin : Module.Finite B (Polynomial B ⧸ I)) : ∃ p : Polynomial B, p.Monic ∧ p ∈ I := by
  obtain ⟨p, hp, hev⟩ := IsIntegral.of_finite B (Ideal.Quotient.mk I Polynomial.X)
  refine ⟨p, hp, Ideal.Quotient.eq_zero_iff_mem.1 ?_⟩
  rw [← Ideal.Quotient.mkₐ_eq_mk B I,
    ← Polynomial.eval₂_algebraMap_X p (Ideal.Quotient.mkₐ B I), Ideal.Quotient.mkₐ_eq_mk]
  exact hev

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_monicMem_of_finite

/-- **Finite quotient gives a monic entry.**  If `R[X]` modulo the ideal of the entries of row
`r` of `M` outside column `t` is a finite `R`-module, then some `M F`, with `F` elementary, has a
monic entry at `(r, t)`. -/
theorem suslinR1_monic_of_finite [Nontrivial R] (M : (Matrix ι ι (Polynomial R))ˣ) (r t : ι)
    (hfin : Module.Finite R (Polynomial R ⧸ Ideal.span (Set.range fun j : {j : ι // j ≠ t} ↦
      (M : Matrix ι ι (Polynomial R)) r j))) :
    ∃ F ∈ elementaryGroup ι (Polynomial R),
      (((M * F : (Matrix ι ι (Polynomial R))ˣ) : Matrix ι ι (Polynomial R)) r t).Monic := by
  obtain ⟨p, hp, hmem⟩ := suslinR1_monicMem_of_finite _ hfin
  exact suslinR1_monic_of_mem_span M r t hp hmem

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Absorption.suslinR1_monic_of_finite

end Absorption
end Metabelian
end BooneHigman
end GroupApproximation
