import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVCTreeDefect
import GroupApproximation.Meta.AxiomGuard

/-!
# Band letters from `Sym(W_{n+1})` and one involution (lane bh-met-77k)

Fix `n` and a *pivot* letter `(a, b)` with `|a| = n`, `|b| = n + 1` and `a`, `b` incomparable.
Let `G = higmanVCTreeLevel_G d n a b` be the subgroup of the quotient
`Q = higmanVCCommon_Q d` generated by

* the balanced letters `(x, y)` with `|x| = |y| = n + 1` (the image of `Sym(W_{n+1})`), and
* the single involution `t = (a, b)`.

**Proved here, with no hypotheses.**  Every *band letter* `(u, v)`, meaning `|u| = n`,
`|v| = n + 1` and `u`, `v` incomparable, lies in `G` (`higmanVCTreeLevel_band_mem`).  Only the
conjugation relator is used, and in each step the conjugator lies in `G`.

* **Pivot step** (`higmanVCTreeLevel_pivot_mem`).  Let `|y| = n + 1`, `y ≠ b`, with `a`, `y`
  incomparable.  The cone swap `(y b)` fixes the cone at `a` and carries `y` onto `b`, so
  `(y b) (a y) (y b)⁻¹ = (a b)`.  Here `(y b)` is balanced of length `n + 1`.
* **Band step** (`higmanVCTreeLevel_band_mem`).  Let `u ≠ a`.  The swap `(u a)` is balanced of
  length `n`, so it lies in `G` (split to length `n + 1`).
  - If `a` is not a prefix of `v`, then `(u a)` fixes the cone at `v`, and
    `(u a) (u v) (u a)⁻¹ = (a v)`.
  - If `v = a ++ s`, then `(u a)` carries `a ++ s` onto `u ++ s`, and
    `(u a) (u, a ++ s) (u a)⁻¹ = (a, u ++ s)`.
  In either case the right side is a pivot letter.

`scratchpad/bh-met-77k/check.py` checks both identities as permutations of cylinders, with the
exact case split used here, for `d = 2, 3` and `n ≤ 3`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

/-- Generators: balanced letters of length `n + 1`, and the pivot `(a, b)`. -/
noncomputable def higmanVCTreeLevel_gens (d n : ℕ) (a b : List (Fin d)) :
    Set (higmanVCCommon_Q d) :=
  {g | (∃ x y : List (Fin d), x.length = n + 1 ∧ y.length = n + 1 ∧
      g = higmanVCCommon_mk d (FreeGroup.of (x, y))) ∨
    g = higmanVCCommon_mk d (FreeGroup.of (a, b))}

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_gens

/-- The subgroup of `Q` generated by `Sym(W_{n+1})` and the pivot involution `(a, b)`. -/
noncomputable def higmanVCTreeLevel_G (d n : ℕ) (a b : List (Fin d)) :
    Subgroup (higmanVCCommon_Q d) :=
  Subgroup.closure (higmanVCTreeLevel_gens d n a b)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_G

theorem higmanVCTreeLevel_bal_gen {d n : ℕ} {a b x y : List (Fin d)} (hx : x.length = n + 1)
    (hy : y.length = n + 1) :
    higmanVCCommon_mk d (FreeGroup.of (x, y)) ∈ higmanVCTreeLevel_G d n a b := by
  rw [higmanVCTreeLevel_G]
  refine Subgroup.subset_closure ?_
  rw [higmanVCTreeLevel_gens, Set.mem_setOf_eq]
  exact Or.inl ⟨x, y, hx, hy, rfl⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_bal_gen

theorem higmanVCTreeLevel_pivot_gen {d n : ℕ} {a b : List (Fin d)} :
    higmanVCCommon_mk d (FreeGroup.of (a, b)) ∈ higmanVCTreeLevel_G d n a b := by
  rw [higmanVCTreeLevel_G]
  refine Subgroup.subset_closure ?_
  rw [higmanVCTreeLevel_gens, Set.mem_setOf_eq]
  exact Or.inr rfl

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_pivot_gen

/-- If a conjugate of `x` by an element of `H` lies in `H`, then so does `x`. -/
theorem higmanVCTreeLevel_mem_of_conj {M : Type*} [Group M] {H : Subgroup M} {p x t : M}
    (hp : p ∈ H) (ht : t ∈ H) (e : p * x * p⁻¹ = t) : x ∈ H := by
  subst e
  have hx : x = p⁻¹ * (p * x * p⁻¹) * p := by
    simp only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one]
  rw [hx]
  exact H.mul_mem (H.mul_mem (H.inv_mem hp) ht) hp

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_mem_of_conj

/-- The conjugation relator, as an equation in `Q`. -/
theorem higmanVCTreeLevel_rel_eq {d : ℕ} {p q x y x' y' : List (Fin d)} (hpq : ¬ p <+: q)
    (hqp : ¬ q <+: p) (hmx : MapsCone (coneSwap p q hpq hqp) x x')
    (hmy : MapsCone (coneSwap p q hpq hqp) y y') (hxy : ¬ x <+: y) (hyx : ¬ y <+: x)
    (hxy' : ¬ x' <+: y') (hyx' : ¬ y' <+: x') :
    higmanVCCommon_mk d (FreeGroup.of (p, q)) * higmanVCCommon_mk d (FreeGroup.of (x, y)) *
        (higmanVCCommon_mk d (FreeGroup.of (p, q)))⁻¹ =
      higmanVCCommon_mk d (FreeGroup.of (x', y')) := by
  have hr := higmanVCCommon_mk_rel
    (higmanVCCommon_conj_mem hpq hqp hmx hmy hxy hyx hxy' hyx')
  rw [map_mul, map_mul, map_mul, map_inv, map_inv] at hr
  exact mul_inv_eq_one.mp hr

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_rel_eq

/-- **Conjugation step.**  If the conjugator `(p, q)` and the conjugate `(x', y')` lie in `H`,
then so does `(x, y)`. -/
theorem higmanVCTreeLevel_conj_step {d : ℕ} {H : Subgroup (higmanVCCommon_Q d)}
    {p q x y x' y' : List (Fin d)} (hpq : ¬ p <+: q) (hqp : ¬ q <+: p)
    (hmx : MapsCone (coneSwap p q hpq hqp) x x') (hmy : MapsCone (coneSwap p q hpq hqp) y y')
    (hxy : ¬ x <+: y) (hyx : ¬ y <+: x) (hxy' : ¬ x' <+: y') (hyx' : ¬ y' <+: x')
    (hp : higmanVCCommon_mk d (FreeGroup.of (p, q)) ∈ H)
    (ht : higmanVCCommon_mk d (FreeGroup.of (x', y')) ∈ H) :
    higmanVCCommon_mk d (FreeGroup.of (x, y)) ∈ H :=
  higmanVCTreeLevel_mem_of_conj hp ht
    (higmanVCTreeLevel_rel_eq hpq hqp hmx hmy hxy hyx hxy' hyx')

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_conj_step

/-- The image of `Sym(W_{n+1})`, i.e. of the free group on balanced letters of length `n + 1`,
lies in `G`. -/
theorem higmanVCTreeLevel_iota_mem {d n : ℕ} (a b : List (Fin d))
    (r : FreeGroup (↥(higmanVCCentral_words d (n + 1)) × ↥(higmanVCCentral_words d (n + 1)))) :
    higmanVCCommon_mk d (higmanVCAll_iota (higmanVCCentral_words d (n + 1)) r) ∈
      higmanVCTreeLevel_G d n a b := by
  induction r using FreeGroup.induction_on with
  | C1 =>
    rw [map_one (higmanVCAll_iota (higmanVCCentral_words d (n + 1))), map_one]
    exact Subgroup.one_mem _
  | of p =>
    rw [higmanVCAll_iota_of]
    exact higmanVCTreeLevel_bal_gen ((higmanVCCentral_mem_words_iff d (n + 1) _).mp p.1.2)
      ((higmanVCCentral_mem_words_iff d (n + 1) _).mp p.2.2)
  | inv_of p ih =>
    rw [map_inv (higmanVCAll_iota (higmanVCCentral_words d (n + 1))), map_inv]
    exact Subgroup.inv_mem _ ih
  | mul g₁ g₂ ih₁ ih₂ =>
    rw [map_mul (higmanVCAll_iota (higmanVCCentral_words d (n + 1))), map_mul]
    exact Subgroup.mul_mem _ ih₁ ih₂

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_iota_mem

/-- Every balanced letter of length at most `n + 1` lies in `G` (split it to length `n + 1`). -/
theorem higmanVCTreeLevel_bal_mem {d n : ℕ} {a b x y : List (Fin d)}
    (hxy : x.length = y.length) (hle : x.length ≤ n + 1) :
    higmanVCCommon_mk d (FreeGroup.of (x, y)) ∈ higmanVCTreeLevel_G d n a b := by
  obtain ⟨r, hr⟩ := MonoidHom.mem_range.mp (higmanVCCentral_letter_mem (M := n + 1) hxy hle)
  rw [← hr, MonoidHom.comp_apply]
  exact higmanVCTreeLevel_iota_mem a b r

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_bal_mem

/-- **Pivot step.**  `(a, y) ∈ G` for `|y| = n + 1` with `a`, `y` incomparable.  For `y ≠ b`,
`(y b) (a y) (y b)⁻¹ = (a b)`. -/
theorem higmanVCTreeLevel_pivot_mem {d n : ℕ} {a b : List (Fin d)} (hb : b.length = n + 1)
    (hab : ¬ a <+: b) (hba : ¬ b <+: a) {y : List (Fin d)} (hy : y.length = n + 1)
    (hay : ¬ a <+: y) (hya : ¬ y <+: a) :
    higmanVCCommon_mk d (FreeGroup.of (a, y)) ∈ higmanVCTreeLevel_G d n a b := by
  by_cases hyb : y = b
  · rw [hyb]
    exact higmanVCTreeLevel_pivot_gen
  have h1 : ¬ y <+: b := fun h => hyb (h.eq_of_length (hy.trans hb.symm))
  have h2 : ¬ b <+: y := fun h => hyb (h.eq_of_length (hb.trans hy.symm)).symm
  exact higmanVCTreeLevel_conj_step (p := y) (q := b) (x := a) (y := y) (x' := a) (y' := b)
    h1 h2 (vgen_mapsCone_coneSwap_fix h1 h2 hay hya hab hba) (mapsCone_coneSwap_left h1 h2)
    hay hya hab hba (higmanVCTreeLevel_bal_gen hy hb) higmanVCTreeLevel_pivot_gen

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_pivot_mem

/-- **Band letters.**  Every incomparable letter `(u, v)` with `|u| = n`, `|v| = n + 1` lies in
`G = ⟨Sym(W_{n+1}), (a, b)⟩`. -/
theorem higmanVCTreeLevel_band_mem {d n : ℕ} {a b : List (Fin d)} (ha : a.length = n)
    (hb : b.length = n + 1) (hab : ¬ a <+: b) (hba : ¬ b <+: a) {u v : List (Fin d)}
    (hu : u.length = n) (hv : v.length = n + 1) (huv : ¬ u <+: v) (hvu : ¬ v <+: u) :
    higmanVCCommon_mk d (FreeGroup.of (u, v)) ∈ higmanVCTreeLevel_G d n a b := by
  have hva : ¬ v <+: a := fun h => by
    have := h.length_le
    omega
  by_cases hua : u = a
  · rw [hua] at huv ⊢
    exact higmanVCTreeLevel_pivot_mem hb hab hba hv huv hva
  have h1 : ¬ u <+: a := fun h => hua (h.eq_of_length (hu.trans ha.symm))
  have h2 : ¬ a <+: u := fun h => hua (h.eq_of_length (ha.trans hu.symm)).symm
  have hp : higmanVCCommon_mk d (FreeGroup.of (u, a)) ∈ higmanVCTreeLevel_G d n a b :=
    higmanVCTreeLevel_bal_mem (by omega) (by omega)
  by_cases hav : a <+: v
  · obtain ⟨s, rfl⟩ := hav
    rw [List.length_append] at hv
    have hus : (u ++ s).length = n + 1 := by
      rw [List.length_append]
      omega
    have h3 : ¬ a <+: u ++ s := fun h =>
      h2 (List.prefix_of_prefix_length_le h (List.prefix_append u s) (by omega))
    have h4 : ¬ u ++ s <+: a := fun h => by
      have := h.length_le
      omega
    exact higmanVCTreeLevel_conj_step (p := u) (q := a) (x := u) (y := a ++ s) (x' := a)
      (y' := u ++ s) h1 h2 (mapsCone_coneSwap_left h1 h2)
      ((mapsCone_coneSwap_right h1 h2).append s) huv hvu h3 h4 hp
      (higmanVCTreeLevel_pivot_mem hb hab hba hus h3 h4)
  · exact higmanVCTreeLevel_conj_step (p := u) (q := a) (x := u) (y := v) (x' := a) (y' := v)
      h1 h2 (mapsCone_coneSwap_left h1 h2) (vgen_mapsCone_coneSwap_fix h1 h2 hvu huv hva hav)
      huv hvu hav hva hp (higmanVCTreeLevel_pivot_mem hb hab hba hv hav hva)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVCTreeLevel_band_mem

end GroupApproximation.BooneHigman.Metabelian.Envelope
