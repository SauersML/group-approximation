import GroupApproximation.BooneHigman.Metabelian.ElemFPK2SurjStabCollapseEndpoint
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2FngGtOneMat
import GroupApproximation.BooneHigman.Metabelian.ElemFPCharZeroK2FngGtOneSigma
import GroupApproximation.Meta.AxiomGuard

/-!
# Surjective stability `K₂(4, ℤ[1/m]) ≤ stab K₂(3, ℤ[1/m])` for every `m > 0`
(lane bh-met-93o, 3)

The rank-three length reduction of `ElemFPCharZeroK2FngStabOneReduce` uses nothing about `1`,
except through the word statement.  The word statement over `ℤ[1/1]` came from the explicit
generator `sym`.  Over `ℤ[1/m]` we prove it instead from the support lemma
`czStabGen_mem_map_of_off`.

`czK2FngGtOne_tri` proves the word statement `czK2FngGtOne_TriStatement m` for every `m > 0`.
Fix `i ≠ k` in `Fin 3`, the embedding `σ : Fin 3 ↪ Fin 4` (`0 ↦ i, 1 ↦ k, 2 ↦ 3`), and a third
index `j ∉ {i, k}`.  The word is `σ y₀` for some `y₀ ∈ St_3(ℤ[1/m])`.
* `czK2FngGtOne_mat_away` gives `y' ∈ H X Y X Y H` with `padMat y' = padMat y₀`.  So
  `u = y'⁻¹ y₀ ∈ K₂(3)`, and hence `σ u ∈ K₂(4)`.
* `σ u` lies in the subgroup generated by the roots that avoid `j.castSucc`
  (`czK2FngGtOne_sigma_mem_off`).  By the support lemma, `σ u = stab h₀` with `h₀ ∈ K₂(3)`.
* `σ y₀ = σ y' · stab h₀ ∈ H X Y X Y H`.

The chain `mem_word → all → gaussForm → conjTriple` then gives `czK2FngGtOne_k2_le_map`.
No hypothesis and no literature input is used.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero

open scoped Matrix
open GroupApproximation.SteinbergGroup GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.PaddedCentral

/-- The `St_3`-supported rank-two words of `St_4(ℤ[1/m])` lie in `H X Y X Y H`. -/
def czK2FngGtOne_TriStatement (m : ℕ) : Prop :=
  ∀ i k : Fin 3, k ≠ i → ∀ α δ ζ η β γ : Localization.Away (m : ℤ),
    SurjStabLengthMem (padRow (Pi.single i α + Pi.single k δ) *
      padCol (Pi.single i ζ + Pi.single k η) * padRow (Pi.single i β) *
      padCol (Pi.single i γ))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_TriStatement

/-- **The word statement over `ℤ[1/m]`, `m > 0`, outright.** -/
theorem czK2FngGtOne_tri {m : ℕ} (hm : 0 < m) : czK2FngGtOne_TriStatement m := by
  intro i k hki α δ ζ η β γ
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ : St (2 + 1) (Localization.Away (m : ℤ)), y₀ =
      padRow (Pi.single 0 α + Pi.single 1 δ : Fin 2 → Localization.Away (m : ℤ)) *
        padCol (Pi.single 0 ζ + Pi.single 1 η : Fin 2 → Localization.Away (m : ℤ)) *
        padRow (Pi.single 0 β : Fin 2 → Localization.Away (m : ℤ)) *
        padCol (Pi.single 0 γ : Fin 2 → Localization.Away (m : ℤ)) :=
    ⟨_, rfl⟩
  obtain ⟨y', hy', hpad⟩ := czK2FngGtOne_mat_away hm y₀
  have hK : y'⁻¹ * y₀ ∈ K2 (Fin (2 + 1)) (Localization.Away (m : ℤ)) := by
    apply surjStab_mem_K2_of_padMat_eq_one
    rw [map_mul, ← hpad, ← map_mul padMat, inv_mul_cancel, map_one]
  obtain ⟨j, hji, hjk⟩ := czK2FngGtOne_exists_third i k
  have hN := czStabGen_mem_map_of_off j
    (indexMap_mem_K2 (czK2FngStabOne_sigma i k hki) hK)
    (czK2FngGtOne_sigma_mem_off i k hki hji hjk (y'⁻¹ * y₀))
  obtain ⟨h₀, -, hh₀⟩ := Subgroup.mem_map.mp hN
  have hmem := czK2FngGtOne_sigma_mem i k hki hy'
  have hsplit : indexMap (czK2FngStabOne_sigma i k hki) y₀ =
      indexMap (czK2FngStabOne_sigma i k hki) y' * stab 3 (Localization.Away (m : ℤ)) h₀ := by
    rw [hh₀, ← map_mul (indexMap (czK2FngStabOne_sigma i k hki)), mul_inv_cancel_left]
  have hfin : SurjStabLengthMem (indexMap (czK2FngStabOne_sigma i k hki) y₀) := by
    rw [hsplit]
    exact surjStabLength_mem_mul_stab hmem h₀
  rw [hy₀, map_mul, map_mul, map_mul, czK2FngGtOne_sigma_padRow2,
    czK2FngGtOne_sigma_padCol2, czK2FngGtOne_sigma_padRow1,
    czK2FngGtOne_sigma_padCol1] at hfin
  exact hfin

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_tri

/-- Rank-two words with a single row `e_i β`, from the `St_3`-supported ones. -/
theorem czK2FngGtOne_rankTwo_of_tri {m : ℕ} (h : czK2FngGtOne_TriStatement m)
    (w c : Fin 3 → Localization.Away (m : ℤ)) (i : Fin 3) (β γ : Localization.Away (m : ℤ)) :
    SurjStabLengthMem (padRow w * padCol c * padRow (Pi.single i β) *
      padCol (Pi.single i γ)) := by
  haveI : Nontrivial (Fin 3) := Fin.nontrivial_iff_two_le.mpr (by omega)
  obtain ⟨k0, hk0⟩ := exists_ne i
  obtain ⟨k, δ, hki, g, hg, hwg⟩ := surjStabCollapse_away_reach (m := m) i k0 hk0 w
  refine surjStabCollapse_mem_word_of_fix hg w c β γ ?_
  rw [hwg]
  refine surjStabCollapse_mem_word_split _ i k hki ?_ _ _ _ ?_
  · intro l hli hlk
    rw [Pi.add_apply, Pi.single_eq_of_ne hli, Pi.single_eq_of_ne hlk, add_zero]
  · exact h i k hki _ _ _ _ β γ

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_rankTwo_of_tri

/-- All words `Y X Y X` of `St_4(ℤ[1/m])` lie in `H X Y X Y H`. -/
theorem czK2FngGtOne_mem_word_of_tri {m : ℕ} (h : czK2FngGtOne_TriStatement m)
    (w c w' c' : Fin 3 → Localization.Away (m : ℤ)) :
    SurjStabLengthMem (padRow w * padCol c * padRow w' * padCol c') := by
  obtain ⟨i, β, hr⟩ := surjStabGauss_away_reach_single (m := m) (by omega : 0 < 3) w'
  obtain ⟨g, hg⟩ := hr
  refine surjStabLength_mem_word_of_conj g w c w' c' ?_
  rw [hg]
  exact surjStabLength_mem_word_single _ _ i β _
    (fun w₁ c₁ => czK2FngGtOne_rankTwo_of_tri h w₁ c₁ i β _)

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_mem_word_of_tri

/-- `St_4(ℤ[1/m]) = H X Y X Y H`. -/
theorem czK2FngGtOne_all_of_tri {m : ℕ} (h : czK2FngGtOne_TriStatement m)
    (y : St (3 + 1) (Localization.Away (m : ℤ))) : SurjStabLengthMem y :=
  surjStabLength_mem_all_of_col (fun _ i a hs =>
    surjStabLength_mem_mul_padCol_of_word (czK2FngGtOne_mem_word_of_tri h) hs
      (Pi.single i a)) y

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_all_of_tri

/-- **Surjective stability** `K₂(4, ℤ[1/m]) ≤ stab K₂(3, ℤ[1/m])` for every `m > 0`. -/
theorem czK2FngGtOne_k2_le_map {m : ℕ} (hm : 0 < m) :
    K2 (Fin (3 + 1)) (Localization.Away (m : ℤ)) ≤
      (K2 (Fin 3) (Localization.Away (m : ℤ))).map (stab 3 (Localization.Away (m : ℤ))) := by
  haveI : IsDomain (Localization.Away (m : ℤ)) := czK2FngGtOne_isDomain hm
  refine surjStab_k2_le_map_of_conjTriple fun x hx => ?_
  obtain ⟨w, hF⟩ :=
    surjStabLength_gaussForm_of_mem (czK2FngGtOne_all_of_tri (czK2FngGtOne_tri hm) x)
  obtain ⟨i, β, hr⟩ := surjStabGauss_away_reach_single (m := m) (by omega : 0 < 3) w
  exact surjStabFactor_conjTriple_of_disj hx
    (surjStabGauss_factorDisj_of_single hx (surjStabGauss_form_of_reach hF hr))

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero.czK2FngGtOne_k2_le_map

end GroupApproximation.BooneHigman.Metabelian.ElemFPCharZero
