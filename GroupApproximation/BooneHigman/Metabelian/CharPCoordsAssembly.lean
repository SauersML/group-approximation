/-!
# Polynomial coordinates in characteristic `p`: the reduction (lane bh-met-03)

Research node `char-p-polynomial-embedding-via-noether-normalization`:

  "Let `A` be the finitely generated `F_p`-subalgebra of `K` generated by the matrix entries
  of a finite generating set and their inverses ... By Noether normalization `A` is a finite
  module over `P = F_p[x_1, ..., x_s]` ... Hence `A` embeds in a matrix algebra over a
  polynomial ring and `G ≤ GL_n(A)` embeds in `GL_M(F_p[x_1, ..., x_k])`."

**Endpoint.** `charPCoordinates_of_finiteDomainAway`.

**Route.**
1. `ringChar K = p > 0` gives `CharP K p`, `p` prime, and the `ZMod p`-algebra `K`.
2. `Coordinates.exists_finset_factor`: the inclusion `H ↪ GL_n(K)` factors through
   `GL_n(B)` for any subring `B` containing a finite set `t`; take
   `A = Algebra.adjoin (ZMod p) t` and `B = A.toSubring`.
3. `A` is a finitely generated `ZMod p`-algebra and a domain; Noether normalization
   (`exists_finite_inj_algHom_of_fg`) gives a finite injective `P = F_p[x_0..x_{s-1}] → A`.
4. The isolated `FiniteDomainAwayEmbeddingStatement` gives `A ↪ M(P[1/f])`;
   `matrixEmbedding_localizationAway` gives `P[1/f] ↪ M(P)`; compose with `B ≅ A`.
5. `MatrixEmbedding.exists_injective_gl` passes to `GL`.
-/

open GroupApproximation.BooneHigman.Coordinates

namespace GroupApproximation.BooneHigman.Metabelian.CharPCoords

/-- **Reduction.**  Generic freeness for one finite injective extension of a polynomial ring
implies the characteristic-`p` polynomial-coordinates theorem. -/
theorem charPCoordinates_of_finiteDomainAway
    (h : FiniteDomainAwayEmbeddingStatement) : CharPPolynomialCoordinatesStatement := by
  intro K _ p hp hK n H hH
  haveI : CharP K p := ringChar.of_eq hK
  haveI : NeZero p := ⟨hp.ne'⟩
  haveI : Fact p.Prime := CharP.char_is_prime_of_pos K p
  letI : Algebra (ZMod p) K := ZMod.algebra K p
  haveI : Group.FG H := (Group.fg_iff_subgroup_fg H).mpr hH
  obtain ⟨t, ht⟩ := exists_finset_factor H.subtype
  obtain ⟨A, hA⟩ : ∃ A : Subalgebra (ZMod p) K, A = Algebra.adjoin (ZMod p) (↑t : Set K) :=
    ⟨_, rfl⟩
  have hsub : (↑t : Set K) ⊆ (A.toSubring : Set K) := by
    rw [Subalgebra.coe_toSubring, hA]
    exact Algebra.subset_adjoin
  obtain ⟨ρ', hρ'⟩ := ht A.toSubring hsub
  have hρ'inj : Function.Injective ρ' := factor_injective hρ' H.subtype_injective
  haveI : Algebra.FiniteType (ZMod p) A :=
    (Subalgebra.fg_iff_finiteType A).mp (by
      rw [hA]
      exact Algebra.fg_adjoin_finset t)
  obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg (ZMod p) A
  obtain ⟨f, hf⟩ := h (ZMod p) s A g.toRingHom hginj hgfin
  let ι : ↥A.toSubring →+* ↥A :=
    { toFun := fun x => ⟨x.1, x.2⟩
      map_one' := Subtype.ext rfl
      map_mul' := fun _ _ => Subtype.ext rfl
      map_zero' := Subtype.ext rfl
      map_add' := fun _ _ => Subtype.ext rfl }
  have hι : Function.Injective ι := fun x y hxy =>
    Subtype.ext (congrArg Subtype.val hxy)
  have hemb : MatrixEmbedding ↥A.toSubring (MvPolynomial (Fin s) (ZMod p)) :=
    (MatrixEmbedding.of_injective ι hι).trans
      (hf.trans (matrixEmbedding_localizationAway f))
  obtain ⟨M, ψ, hψ⟩ := hemb.exists_injective_gl n
  exact ⟨s, M, ψ.comp ρ', hψ.comp hρ'inj⟩

#audit_axioms
  GroupApproximation.BooneHigman.Metabelian.CharPCoords.charPCoordinates_of_finiteDomainAway

end GroupApproximation.BooneHigman.Metabelian.CharPCoords
