import Mathlib.RingTheory.FiniteType
import Mathlib.RingTheory.Adjoin.FG
import GroupApproximation.BooneHigman.Coordinates.MatrixEmbedding
import GroupApproximation.BooneHigman.Coordinates.FGSubring
