import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVSection
import GroupApproximation.BooneHigman.Metabelian.EnvelopeHigmanVGenFamily
import GroupApproximation.Meta.AxiomGuard

/-!
# The normal-form section from a section over any family generating the cone swaps

`higmanVFinSection_of_swapSection` reduces `HigmanVFinSectionStatement` to
`HigmanVSwapSectionStatement`.  The generators are the explicit finite family `vgenShortSwaps`
of cone swaps of words of length `≤ 3`; the subgroup they generate contains every cone swap
(`vgenShortSwaps_closure`).

*Truth.*  `V_d` is generated by its cone swaps (every element of `V_d` is a product of cone
swaps: it permutes the leaves of a complete prefix code, and such a permutation is a product of
transpositions of leaves).  So a family `g` whose closure contains every cone swap generates
`V_d`.  By Higman's theorem `V_d` is finitely presented, so for every finite generating family
`g` the kernel of `FreeGroup.lift g` is the normal closure of a finite set `R` (B. H. Neumann),
and the inverse of `FreeGroup (Fin n) ⧸ ⟨⟨R⟩⟩ ≃* V_d` is the required unital section.

*Why it is strictly smaller in proof content.*  The reduction discharges the choice of a finite
generating family and the generation of all cone swaps from the short ones (`vgen_step`, by
conjugation).  What remains is generation of `V_d` by cone swaps and the finite presentation.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Envelope

/-- **Normal-form section over any finite family generating the cone swaps.**  For `d ≥ 2`, every
finite family of elements of `higmanThompsonV (Fin d)` whose closure contains every cone swap
generates, and some finite set of relators carries a unital intertwining section. -/
def HigmanVSwapSectionStatement : Prop :=
  ∀ d : ℕ, 1 < d → ∀ (n : ℕ) (g : Fin n → ↥(higmanThompsonV (Fin d))),
    (∀ (v w : List (Fin d)) (h1 : ¬ v <+: w) (h2 : ¬ w <+: v),
      (⟨coneSwap v w h1 h2, coneSwap_mem_higmanThompsonV h1 h2⟩ :
        ↥(higmanThompsonV (Fin d))) ∈ Subgroup.closure (Set.range g)) →
    Subgroup.closure (Set.range g) = ⊤ ∧
      ∃ R : Set (FreeGroup (Fin n)), R.Finite ∧ R ⊆ (FreeGroup.lift g).ker ∧
        ∃ s : ↥(higmanThompsonV (Fin d)) → FreeGroup (Fin n) ⧸ Subgroup.normalClosure R,
          s 1 = 1 ∧
            ∀ (v : ↥(higmanThompsonV (Fin d))) (i : Fin n),
              s v * ((FreeGroup.of i : FreeGroup (Fin n)) :
                FreeGroup (Fin n) ⧸ Subgroup.normalClosure R) = s (v * g i)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.HigmanVSwapSectionStatement

/-- The section over families generating the cone swaps gives the normal-form section. -/
theorem higmanVFinSection_of_swapSection (h : HigmanVSwapSectionStatement) :
    HigmanVFinSectionStatement := by
  intro d hd
  haveI : Nontrivial (Fin d) := Fin.nontrivial_iff_two_le.mpr hd
  exact ⟨_, vgenShortSwaps (Fin d), h d hd _ (vgenShortSwaps (Fin d))
    (fun _ _ h1 h2 => vgenShortSwaps_closure h1 h2)⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Envelope.higmanVFinSection_of_swapSection

end GroupApproximation.BooneHigman.Metabelian.Envelope
