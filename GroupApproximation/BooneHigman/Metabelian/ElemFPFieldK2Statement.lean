import GroupApproximation.BooneHigman.Metabelian.ElemFPFieldK2Finite
import GroupApproximation.BooneHigman.Metabelian.ElemFPK2Split
import GroupApproximation.Meta.AxiomGuard

/-!
# `K₂(N, F_p) = 0`, reduced to symbol generation

Lane `bh-met-15`.  `ElemFPFieldK2Finite` shows that every Steinberg symbol of `St_N(ZMod p)` is
trivial once `N ≥ 3`.  The remaining input is the classical fact that the unstable `K₂` of a
field is generated by symbols of one root pair:

* `SymbolGenerationStatement n₀`: for every prime `p` and `N ≥ n₀` there are `i ≠ j` in `Fin N`
  with `K2 (Fin N) (ZMod p) ≤ closure {symbol i j hij u v}`.

Endpoints:

* `fieldK2_eq_bot_of_symbolGeneration`: `3 ≤ n₀`, `SymbolGenerationStatement n₀` and `n₀ ≤ N`
  give `K2 (Fin N) (ZMod p) = ⊥`.
* `fieldK2VanishingStatement_of_symbolGeneration`: `SymbolGenerationStatement 5` gives
  `FieldK2VanishingStatement`.

Truth check.  The statement is true for `n₀ = 3`.  For a field `F` and `N ≥ 3`, `K₂(N, F)` is
generated by the symbols of a single root pair (Steinberg; Matsumoto).  Also `K₂(N, F_p) = 0`
(Steinberg), and `⊥` lies below every subgroup.  It is implied by `FieldK2VanishingStatement`
at `n₀ = 5`, so it is a weaker hypothesis.  Here `symbol i j hij u v = h(uv) h(u)⁻¹ h(v)⁻¹`, and
`h(u) h(v) h(uv)⁻¹` generates the same subgroup.
-/

namespace GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2

open GroupApproximation.BooneHigman.SteinbergBasic

/-- **Symbol generation** from rank `n₀` on: `K₂(N, F_p)` lies in the subgroup generated by
the symbols of one root pair. -/
def SymbolGenerationStatement (n₀ : ℕ) : Prop :=
  ∀ (p : ℕ) [Fact p.Prime] (N : ℕ), n₀ ≤ N → ∃ (i j : Fin N) (hij : i ≠ j),
    K2 (Fin N) (ZMod p) ≤
      Subgroup.closure (Set.range fun uv : (ZMod p)ˣ × (ZMod p)ˣ => symbol i j hij uv.1 uv.2)

/-- Two indices of `Fin N` with `N ≥ 3` leave room for a third. -/
theorem exists_third_index {N : ℕ} (hN : 3 ≤ N) (i j : Fin N) : ∃ k : Fin N, i ≠ k ∧ j ≠ k := by
  by_cases a : (i : ℕ) ≠ 0 ∧ (j : ℕ) ≠ 0
  · exact ⟨⟨0, by omega⟩, fun e => a.1 (congrArg Fin.val e), fun e => a.2 (congrArg Fin.val e)⟩
  by_cases b : (i : ℕ) ≠ 1 ∧ (j : ℕ) ≠ 1
  · exact ⟨⟨1, by omega⟩, fun e => b.1 (congrArg Fin.val e), fun e => b.2 (congrArg Fin.val e)⟩
  refine ⟨⟨2, by omega⟩, fun e => ?_, fun e => ?_⟩
  · have e2 : (i : ℕ) = 2 := congrArg Fin.val e
    omega
  · have e2 : (j : ℕ) = 2 := congrArg Fin.val e
    omega

/-- **Reduction.**  Symbol generation from rank `n₀ ≥ 3` gives `K₂(N, F_p) = 0` for `N ≥ n₀`. -/
theorem fieldK2_eq_bot_of_symbolGeneration (n₀ : ℕ) (hn₀ : 3 ≤ n₀)
    (hgen : SymbolGenerationStatement n₀) (p : ℕ) (hp : p.Prime) (N : ℕ) (hN : n₀ ≤ N) :
    K2 (Fin N) (ZMod p) = ⊥ := by
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨i, j, hij, hle⟩ := hgen p N hN
  obtain ⟨k, hik, hjk⟩ := exists_third_index (le_trans hn₀ hN) i j
  rw [eq_bot_iff]
  refine le_trans hle ((Subgroup.closure_le _).mpr ?_)
  rintro _ ⟨uv, rfl⟩
  exact Subgroup.mem_bot.mpr (symbol_eq_one_zmod i j k hij hik hjk uv.1 uv.2)

/-- **Bridge** to the field case of `ElemFPK2Split`. -/
theorem fieldK2VanishingStatement_of_symbolGeneration (hgen : SymbolGenerationStatement 5) :
    FieldK2VanishingStatement :=
  fun p hp N hN => fieldK2_eq_bot_of_symbolGeneration 5 (by norm_num) hgen p hp N hN

end GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2

#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2.SymbolGenerationStatement
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2.exists_third_index
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2.fieldK2_eq_bot_of_symbolGeneration
#audit_axioms GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2.fieldK2VanishingStatement_of_symbolGeneration
