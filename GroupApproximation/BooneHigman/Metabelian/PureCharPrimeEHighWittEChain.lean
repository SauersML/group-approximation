import Mathlib.Algebra.Module.Injective
import Mathlib.RingTheory.Artinian.Module
import Mathlib.RingTheory.HopkinsLevitzki
import Mathlib.RingTheory.KrullDimension.Basic
import Mathlib.RingTheory.Ideal.Maximal
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.LinearAlgebra.Pi
import Mathlib.Data.Fin.Tuple.Basic
import Mathlib.Data.Nat.Find
import GroupApproximation.Meta.AxiomGuard

/-!
# Chain rings are self-injective (bh-met-87h, part 1)

A commutative ring `D` with an element `π` is a *chain ring of length `e`*
(`eHighWittE_IsChain π e`) if

* every element is a unit or a multiple of `π`;
* `π ^ e = 0`;
* `π ^ j ≠ 0` for `j < e`.

This file proves, for any such `D`:

* every nonzero `z` is `π ^ j * u` with `j < e` and `u` a unit (`eHighWittE_val`);
* `π ^ a * y = 0` forces `π ^ (e - a) ∣ y` (`eHighWittE_ann`);
* every ideal is generated by some `π ^ j` (`eHighWittE_ideal`);
* Baer's criterion, so `D` is self-injective (`eHighWittE_selfInj`);
* linear functionals `N → D` separate points (`eHighWittE_exists_ne_zero`), so every Artinian
  `D`-module embeds in some `Dˢ` (`eHighWittE_embed_of_artinian`);
* a Noetherian chain ring is Artinian (`eHighWittE_isArtinianRing`).

This generalises the `e = 2` files `PureCharPrimeEHighWittModInj*.lean` to all `e`.
-/

namespace GroupApproximation.BooneHigman.Metabelian.Coprimary

/-- The chain-ring hypotheses for `π` and length `e`. -/
structure eHighWittE_IsChain {D : Type} [CommRing D] (π : D) (e : ℕ) : Prop where
  unit_or : ∀ z : D, IsUnit z ∨ ∃ w, z = π * w
  pow_eq : π ^ e = 0
  pow_ne : ∀ j < e, π ^ j ≠ 0

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_IsChain

variable {D : Type} [CommRing D] {π : D} {e : ℕ}

/-- **Valuation.** Every nonzero element is `π ^ j * u` with `j < e` and `u` a unit. -/
theorem eHighWittE_val (hC : eHighWittE_IsChain π e) {z : D} (hz : z ≠ 0) :
    ∃ j < e, ∃ u : Dˣ, z = π ^ j * u := by
  classical
  have hex : ∃ j, ¬∃ w, z = π ^ (j + 1) * w :=
    ⟨e, fun ⟨w, hw⟩ => hz (by rw [hw, pow_succ, hC.pow_eq, zero_mul, zero_mul])⟩
  obtain ⟨j, hj⟩ : ∃ j, Nat.find hex = j := ⟨_, rfl⟩
  have hnot : ¬∃ w, z = π ^ (j + 1) * w := by
    rw [← hj]
    exact Nat.find_spec hex
  have hdiv : ∃ w, z = π ^ j * w := by
    cases j with
    | zero => exact ⟨z, by rw [pow_zero, one_mul]⟩
    | succ i => exact not_not.mp (Nat.find_min hex (by omega : i < Nat.find hex))
  obtain ⟨w, hw⟩ := hdiv
  rcases hC.unit_or w with ⟨u, rfl⟩ | ⟨w', rfl⟩
  · refine ⟨j, ?_, u, hw⟩
    by_contra hje
    exact hz (by rw [hw, pow_eq_zero_of_le (by omega : e ≤ j) hC.pow_eq, zero_mul])
  · exact (hnot ⟨w', by rw [hw, pow_succ, mul_assoc]⟩).elim

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_val

/-- **Annihilators.** If `π ^ a * y = 0` then `y` is a multiple of `π ^ (e - a)`. -/
theorem eHighWittE_ann (hC : eHighWittE_IsChain π e) {a : ℕ} {y : D} (h : π ^ a * y = 0) :
    ∃ c, y = π ^ (e - a) * c := by
  by_cases hy : y = 0
  · exact ⟨0, by rw [hy, mul_zero]⟩
  obtain ⟨i, _, u, rfl⟩ := eHighWittE_val hC hy
  have h0 : π ^ (a + i) = 0 := by
    rw [pow_add, ← Units.mul_left_eq_zero u, mul_assoc]
    exact h
  have hle : e - a ≤ i := by
    by_contra hlt
    exact hC.pow_ne (a + i) (by omega) h0
  refine ⟨π ^ (i - (e - a)) * u, ?_⟩
  rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' hle]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_ann

/-- **Ideals.** Every ideal `I` contains some `π ^ j` with `j ≤ e` dividing all its elements. -/
theorem eHighWittE_ideal (hC : eHighWittE_IsChain π e) (I : Ideal D) :
    ∃ j ≤ e, π ^ j ∈ I ∧ ∀ x ∈ I, ∃ a, x = a * π ^ j := by
  classical
  have hmem : π ^ e ∈ I := by
    rw [hC.pow_eq]
    exact I.zero_mem
  have hex : ∃ j, π ^ j ∈ I := ⟨e, hmem⟩
  refine ⟨Nat.find hex, Nat.find_min' hex hmem, Nat.find_spec hex, fun x hx => ?_⟩
  by_cases hx0 : x = 0
  · exact ⟨0, by rw [hx0, zero_mul]⟩
  obtain ⟨i, _, u, rfl⟩ := eHighWittE_val hC hx0
  have hi : π ^ i ∈ I := by
    have h := I.mul_mem_right (↑u⁻¹ : D) hx
    rwa [mul_assoc, Units.mul_inv, mul_one] at h
  have hle : Nat.find hex ≤ i := Nat.find_min' hex hi
  refine ⟨π ^ (i - Nat.find hex) * u, ?_⟩
  rw [mul_right_comm, ← pow_add, Nat.sub_add_cancel hle]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_ideal

/-- **Baer's criterion holds for a chain ring over itself.** -/
theorem eHighWittE_baer (hC : eHighWittE_IsChain π e) : Module.Baer D D := by
  intro I g
  obtain ⟨j, hje, hjI, hdiv⟩ := eHighWittE_ideal hC I
  have h0 : π ^ (e - j) • (⟨π ^ j, hjI⟩ : I) = 0 :=
    Subtype.ext (by
      rw [Submodule.coe_smul, Submodule.coe_mk, smul_eq_mul, ← pow_add, Nat.sub_add_cancel hje,
        hC.pow_eq, Submodule.coe_zero])
  have h1 := map_smul g (π ^ (e - j)) ⟨π ^ j, hjI⟩
  rw [h0, map_zero, smul_eq_mul] at h1
  obtain ⟨c, hc⟩ := eHighWittE_ann hC h1.symm
  rw [Nat.sub_sub_self hje] at hc
  refine ⟨LinearMap.toSpanSingleton D D c, fun x mem => ?_⟩
  obtain ⟨a, rfl⟩ := hdiv x mem
  have e' : (⟨a * π ^ j, mem⟩ : I) = a • ⟨π ^ j, hjI⟩ :=
    Subtype.ext (by rw [Submodule.coe_smul, Submodule.coe_mk, Submodule.coe_mk, smul_eq_mul])
  rw [LinearMap.toSpanSingleton_apply, e', map_smul, hc, smul_eq_mul, smul_eq_mul, mul_assoc]

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_baer

/-- **A chain ring is self-injective.** -/
theorem eHighWittE_selfInj (hC : eHighWittE_IsChain π e) : Module.Injective D D :=
  Module.Baer.injective (eHighWittE_baer hC)

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_selfInj

/-- **Linear functionals `N → D` separate points** of any module over a chain ring. -/
theorem eHighWittE_exists_ne_zero (hC : eHighWittE_IsChain π e) (he : e ≠ 0) {N : Type}
    [AddCommGroup N] [Module D N] {n : N} (hn : n ≠ 0) :
    ∃ f : N →ₗ[D] D, f n ≠ 0 := by
  have hK : LinearMap.ker (LinearMap.toSpanSingleton D N n) ≤
      LinearMap.ker (LinearMap.toSpanSingleton D D (π ^ (e - 1))) := by
    intro r hr
    rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] at hr ⊢
    rw [smul_eq_mul]
    rcases hC.unit_or r with ⟨u, rfl⟩ | ⟨w, rfl⟩
    · exact (hn (by
        rw [← one_smul D n, ← Units.inv_mul u, mul_smul, hr, smul_zero])).elim
    · rw [mul_right_comm, ← pow_succ', Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr he),
        hC.pow_eq, zero_mul]
  obtain ⟨h, hh⟩ := (eHighWittE_selfInj hC).out
    ((LinearMap.ker (LinearMap.toSpanSingleton D N n)).liftQ
      (LinearMap.toSpanSingleton D N n) le_rfl)
    (LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot _ _ _ le_rfl))
    ((LinearMap.ker (LinearMap.toSpanSingleton D N n)).liftQ
      (LinearMap.toSpanSingleton D D (π ^ (e - 1))) hK)
  have h3 := hh (Submodule.Quotient.mk 1)
  simp only [Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply, one_smul] at h3
  exact ⟨h, by rw [h3]; exact hC.pow_ne (e - 1) (by omega)⟩

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_exists_ne_zero

/-- **Every Artinian module over a chain ring embeds linearly in some `Dˢ`.** -/
theorem eHighWittE_embed_of_artinian (hC : eHighWittE_IsChain π e) (he : e ≠ 0) {N : Type}
    [AddCommGroup N] [Module D N] (hA : IsArtinian D N) :
    ∃ (s : ℕ) (ι : N →ₗ[D] (Fin s → D)), Function.Injective ι := by
  obtain ⟨K, ⟨s, fs, rfl⟩, hmin⟩ := (set_has_minimal_iff_artinian.mpr hA)
    {K : Submodule D N | ∃ (s : ℕ) (fs : Fin s → (N →ₗ[D] D)),
      K = LinearMap.ker (LinearMap.pi fs)}
    ⟨_, 0, Fin.elim0, rfl⟩
  refine ⟨s, LinearMap.pi fs,
    LinearMap.ker_eq_bot.mp (LinearMap.ker_eq_bot'.mpr fun x hx => ?_)⟩
  by_contra hne
  obtain ⟨g, hg⟩ := eHighWittE_exists_ne_zero hC he hne
  have hle : LinearMap.ker (LinearMap.pi
      (Fin.cons g fs : Fin (s + 1) → (N →ₗ[D] D))) ≤ LinearMap.ker (LinearMap.pi fs) := by
    intro y hy
    rw [LinearMap.mem_ker] at hy ⊢
    funext i
    simpa only [LinearMap.pi_apply, Fin.cons_succ, Pi.zero_apply] using congrFun hy i.succ
  have heq := eq_of_le_of_not_lt hle (hmin _ ⟨s + 1, Fin.cons g fs, rfl⟩)
  have hx' : x ∈ LinearMap.ker (LinearMap.pi
      (Fin.cons g fs : Fin (s + 1) → (N →ₗ[D] D))) := by
    rw [heq]
    exact LinearMap.mem_ker.mpr hx
  rw [LinearMap.mem_ker] at hx'
  apply hg
  simpa only [LinearMap.pi_apply, Fin.cons_zero, Pi.zero_apply] using congrFun hx' 0

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_embed_of_artinian

/-- **A Noetherian chain ring is Artinian**: every prime contains `π`, and everything outside
it is a unit, so every prime is maximal. -/
theorem eHighWittE_isArtinianRing [IsNoetherianRing D] (hC : eHighWittE_IsChain π e) :
    IsArtinianRing D := by
  haveI : Ring.KrullDimLE 0 D := by
    refine Ring.KrullDimLE.mk₀ fun I hI => ?_
    have hπI : π ∈ I := hI.mem_of_pow_mem e (by rw [hC.pow_eq]; exact I.zero_mem)
    have hunit : ∀ x : D, x ∉ I → IsUnit x := fun x hx =>
      (hC.unit_or x).resolve_right (by
        rintro ⟨w, rfl⟩
        exact hx (I.mul_mem_right w hπI))
    refine Ideal.isMaximal_iff.mpr ⟨(Ideal.ne_top_iff_one I).mp hI.ne_top, ?_⟩
    intro J x _ hxI hxJ
    exact (Ideal.eq_top_iff_one J).mp (Ideal.eq_top_of_isUnit_mem J hxJ (hunit x hxI))
  exact IsNoetherianRing.isArtinianRing_of_krullDimLE_zero

#audit_axioms GroupApproximation.BooneHigman.Metabelian.Coprimary.eHighWittE_isArtinianRing

end GroupApproximation.BooneHigman.Metabelian.Coprimary
