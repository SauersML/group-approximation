import GroupApproximation.BooneHigman.Join.DRaySemi

/-!
# The lift of `F_{n+2}` is faithful (lane bh-pal-met-join)

* `rayR_rel`: Brown's relations hold on the ray.  They follow from those in `Q` (`xgen_rel`),
  the semiconjugacy `xgen_semi` and injectivity of `up`.
* `RW n`, the subgroup generated by the `rayR N`, is an `FdModel` (`rModel`).  Its shift is
  `shHom` and its exponent is the germ at `(0, 0^∞)`.
* `theta : BrownGroup n →* RW n` is the lift, and `psiD` is semiconjugate to it through `up`
  (`psiD_semi`).
* `PhiD_faithful`: an element of `PhiD n` with trivial evaluation is `1`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unreachableTactic false
set_option linter.unusedTactic false

namespace GroupApproximation.BooneHigman.Join

open GroupApproximation.BooneHigman.Metabelian.Envelope
open GroupApproximation.ThompsonOre GroupApproximation.HigmanThompson

variable {n : ℕ}

theorem rayR_rel : ∀ i j : ℕ, i < j →
    rayR n j * rayR n i = rayR n i * rayR n (j + (n + 1)) := by
  intro i j hij
  ext p : 1
  apply up_injective (n := n)
  have h := congrArg (fun q => jperm (n + 2) q (up n p)) (xgen_rel (n := n) i j hij)
  simp only [jperm_mul, Equiv.Perm.mul_apply, xgen_semi] at h
  exact h

#audit_axioms GroupApproximation.BooneHigman.Join.rayR_rel

/-- The zero word, in the alphabet `Fin (n + 2)`. -/
abbrev zd (n k : ℕ) : List (Fin (n + 2)) := List.replicate k (fc n 0)

/-- `f` has germ `(a, b)` at `(0, 0^∞)`. -/
def GermR (f : Equiv.Perm (ℕ × Cantor (Fin (n + 2)))) (a b : ℕ) : Prop :=
  ∀ j (w : Cantor (Fin (n + 2))), f (0, prepend (zd n (a + j)) w) = (0, prepend (zd n (b + j)) w)

#audit_axioms GroupApproximation.BooneHigman.Join.GermR

theorem GermR.shift {f : Equiv.Perm (ℕ × Cantor (Fin (n + 2)))} {a b : ℕ} (h : GermR f a b)
    (k : ℕ) : GermR f (a + k) (b + k) := fun j w => by
  have h' := h (k + j) w
  rwa [← Nat.add_assoc, ← Nat.add_assoc] at h'

#audit_axioms GroupApproximation.BooneHigman.Join.GermR.shift

theorem GermR.mul {f g : Equiv.Perm (ℕ × Cantor (Fin (n + 2)))} {a b a' b' : ℕ}
    (hf : GermR f a b) (hg : GermR g a' b') : GermR (f * g) (a' + a) (b + b') := fun j w => by
  have h1 := hg (a + j) w
  have h2 := hf (b' + j) w
  rw [show a' + (a + j) = a' + a + j by omega, show b' + (a + j) = a + (b' + j) by omega] at h1
  rw [show b + (b' + j) = b + b' + j by omega] at h2
  rw [Equiv.Perm.mul_apply, h1, h2]

#audit_axioms GroupApproximation.BooneHigman.Join.GermR.mul

theorem GermR.inv {f : Equiv.Perm (ℕ × Cantor (Fin (n + 2)))} {a b : ℕ} (hf : GermR f a b) :
    GermR f⁻¹ b a := fun j w => by
  rw [Equiv.Perm.inv_eq_iff_eq]
  exact (hf j w).symm

#audit_axioms GroupApproximation.BooneHigman.Join.GermR.inv

/-- Two words of zeros agree in front of the stream `t t t ⋯` only if they have equal length. -/
theorem zd_len_eq {k l : ℕ}
    (h : prepend (zd n k) (fun _ => tl n) = prepend (zd n l) (fun _ => tl n)) : k = l := by
  have htz : tl n ≠ fc n 0 := fc_ne (by omega) (by omega) (by omega)
  have ev1 : ∀ m, prepend (zd n m) (fun _ => tl n) m = tl n := fun m => by
    rw [prepend_of_length_le (n := m) (zd n m) (fun _ => tl n) (by simp)]
  have ev2 : ∀ m m', m < m' → prepend (zd n m') (fun _ => tl n) m = fc n 0 := fun m m' hm => by
    rw [prepend_getElem (n := m) (zd n m') (fun _ => tl n) (by simpa using hm),
      List.getElem_replicate]
  by_contra hne
  rcases Nat.lt_or_ge k l with hlt | hge
  · have h5 := congrFun h k
    rw [ev1, ev2 k l hlt] at h5
    exact htz h5
  · have h5 := congrFun h l
    rw [ev1, ev2 l k (by omega)] at h5
    exact htz h5.symm

#audit_axioms GroupApproximation.BooneHigman.Join.zd_len_eq

theorem GermR.eq {f : Equiv.Perm (ℕ × Cantor (Fin (n + 2)))} {a b a' b' : ℕ} (h : GermR f a b)
    (h' : GermR f a' b') : (b : ℤ) - a = (b' : ℤ) - a' := by
  have h3 := h a' (fun _ => tl n)
  have h4 := h' a (fun _ => tl n)
  rw [Nat.add_comm a' a] at h4
  rw [h4, Prod.mk.injEq] at h3
  have e := zd_len_eq h3.2
  omega

#audit_axioms GroupApproximation.BooneHigman.Join.GermR.eq

/-- The permutations with a germ at `(0, 0^∞)`. -/
def GR (n : ℕ) : Subgroup (Equiv.Perm (ℕ × Cantor (Fin (n + 2)))) where
  carrier := {f | ∃ a b, GermR f a b}
  mul_mem' := by
    rintro f g ⟨a, b, hf⟩ ⟨a', b', hg⟩
    exact ⟨_, _, hf.mul hg⟩
  one_mem' := ⟨0, 0, fun j w => rfl⟩
  inv_mem' := by
    rintro f ⟨a, b, hf⟩
    exact ⟨_, _, hf.inv⟩

#audit_axioms GroupApproximation.BooneHigman.Join.GR

theorem mem_GR {f : Equiv.Perm (ℕ × Cantor (Fin (n + 2)))} : f ∈ GR n ↔ ∃ a b, GermR f a b :=
  Iff.rfl

#audit_axioms GroupApproximation.BooneHigman.Join.mem_GR

/-- The germ exponent `b - a`. -/
noncomputable def chiR (f : ↥(GR n)) : ℤ :=
  (Classical.choose (Classical.choose_spec (mem_GR.mp f.2)) : ℤ) - Classical.choose (mem_GR.mp f.2)

#audit_axioms GroupApproximation.BooneHigman.Join.chiR

theorem chiR_eq {f : ↥(GR n)} {a b : ℕ} (h : GermR f.1 a b) : chiR f = (b : ℤ) - a :=
  (Classical.choose_spec (Classical.choose_spec (mem_GR.mp f.2))).eq h

#audit_axioms GroupApproximation.BooneHigman.Join.chiR_eq

/-- The germ exponent as a homomorphism. -/
noncomputable def chiRHom (n : ℕ) : ↥(GR n) →* Multiplicative ℤ where
  toFun f := Multiplicative.ofAdd (chiR f)
  map_one' := by
    show Multiplicative.ofAdd (chiR (1 : ↥(GR n))) = 1
    rw [chiR_eq (f := 1) (a := 0) (b := 0) (fun j w => rfl)]
    simp
  map_mul' f g := by
    show Multiplicative.ofAdd (chiR (f * g)) =
      Multiplicative.ofAdd (chiR f) * Multiplicative.ofAdd (chiR g)
    obtain ⟨a, b, hf⟩ := mem_GR.mp f.2
    obtain ⟨a', b', hg⟩ := mem_GR.mp g.2
    rw [chiR_eq (f := f * g) (hf.mul hg), chiR_eq hf, chiR_eq hg, ← ofAdd_add]
    congr 1
    push_cast
    ring

#audit_axioms GroupApproximation.BooneHigman.Join.chiRHom

theorem chiRHom_eq {f : ↥(GR n)} {a b : ℕ} (h : GermR f.1 a b) :
    chiRHom n f = Multiplicative.ofAdd ((b : ℤ) - a) := by
  show Multiplicative.ofAdd (chiR f) = _
  rw [chiR_eq h]

#audit_axioms GroupApproximation.BooneHigman.Join.chiRHom_eq

theorem germ_rayR_zero : GermR (rayR n 0) 0 1 := fun j w => by
  have e : zd n (1 + j) = [fc n 0] ++ zd n (0 + j) := by
    simp only [zd, Nat.zero_add, Nat.add_comm 1 j, List.replicate_succ, List.singleton_append]
  rw [e, prepend_append, rayR_apply, rayF_mid _ (le_refl 0) (by omega), Nat.sub_self]

#audit_axioms GroupApproximation.BooneHigman.Join.germ_rayR_zero

theorem germ_rayR_succ (N : ℕ) : GermR (rayR n (N + 1)) 0 0 := fun j w => by
  rw [rayR_apply, rayF_lt _ (by omega)]

#audit_axioms GroupApproximation.BooneHigman.Join.germ_rayR_succ

/-- The subgroup generated by Brown's generators on the ray. -/
def RW (n : ℕ) : Subgroup (Equiv.Perm (ℕ × Cantor (Fin (n + 2)))) :=
  Subgroup.closure (Set.range (rayR n))

#audit_axioms GroupApproximation.BooneHigman.Join.RW

theorem RW_le_GR : RW n ≤ GR n := by
  rw [RW, Subgroup.closure_le]
  rintro _ ⟨N, rfl⟩
  cases N with
  | zero => exact ⟨0, 1, germ_rayR_zero⟩
  | succ N => exact ⟨0, 0, germ_rayR_succ N⟩

#audit_axioms GroupApproximation.BooneHigman.Join.RW_le_GR

theorem shHom_mem_RW {f : Equiv.Perm (ℕ × Cantor (Fin (n + 2)))} (hf : f ∈ RW n) :
    shHom (Fin (n + 2)) f ∈ RW n := by
  have hf' : f ∈ Subgroup.closure (Set.range (rayR n)) := hf
  induction hf' using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨N, rfl⟩ := hx
    rw [shHom_rayR]
    exact Subgroup.subset_closure ⟨N + 1, rfl⟩
  | one => rw [map_one]; exact (RW n).one_mem
  | mul x y _ _ hx hy => rw [map_mul]; exact (RW n).mul_mem hx hy
  | inv x _ hx => rw [map_inv]; exact (RW n).inv_mem hx

#audit_axioms GroupApproximation.BooneHigman.Join.shHom_mem_RW

/-- The generators of `RW n`. -/
def rx (n N : ℕ) : ↥(RW n) := ⟨rayR n N, Subgroup.subset_closure ⟨N, rfl⟩⟩

#audit_axioms GroupApproximation.BooneHigman.Join.rx

/-- The shift of `RW n`. -/
def rShift (n : ℕ) : ↥(RW n) →* ↥(RW n) where
  toFun f := ⟨shHom (Fin (n + 2)) f, shHom_mem_RW f.2⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' f g := Subtype.ext (map_mul _ f g)

#audit_axioms GroupApproximation.BooneHigman.Join.rShift

theorem closure_rx : Subgroup.closure (Set.range (rx n)) = ⊤ := by
  rw [eq_top_iff]
  rintro ⟨f, hf⟩ -
  have key : ∀ g (hg : g ∈ RW n), (⟨g, hg⟩ : ↥(RW n)) ∈ Subgroup.closure (Set.range (rx n)) := by
    intro g hg
    have hg' : g ∈ Subgroup.closure (Set.range (rayR n)) := hg
    induction hg' using Subgroup.closure_induction with
    | mem x hx =>
      obtain ⟨N, rfl⟩ := hx
      exact Subgroup.subset_closure ⟨N, rfl⟩
    | one => exact Subgroup.one_mem _
    | mul x y hx hy ihx ihy => exact Subgroup.mul_mem _ ihx ihy
    | inv x hx ih => exact Subgroup.inv_mem _ ih
  exact key f hf

#audit_axioms GroupApproximation.BooneHigman.Join.closure_rx

/-- **The ray model of `F_{n+2}`.** -/
noncomputable def rModel (n : ℕ) : FdModel ↥(RW n) (n + 1) where
  x := rx n
  rel i j hij := Subtype.ext (rayR_rel i j hij)
  closure_eq_top := closure_rx
  shift := rShift n
  shift_x N := Subtype.ext (shHom_rayR N)
  shift_injective f g h := Subtype.ext (shHom_injective _ (congrArg Subtype.val h))
  chi := (chiRHom n).comp (Subgroup.inclusion RW_le_GR)
  chi_x_zero := (chiRHom_eq (f := ⟨rayR n 0, RW_le_GR (rx n 0).2⟩) germ_rayR_zero).trans
    (by norm_num)
  chi_x_succ N :=
    (chiRHom_eq (f := ⟨rayR n (N + 1), RW_le_GR (rx n (N + 1)).2⟩) (germ_rayR_succ N)).trans
      (by norm_num)

#audit_axioms GroupApproximation.BooneHigman.Join.rModel

end GroupApproximation.BooneHigman.Join
