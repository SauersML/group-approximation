#audit_axioms GroupApproximation.AlgebraicK.glColimMap_injective
#audit_axioms GroupApproximation.AlgebraicK.algebraicKOneMap_comp
#audit_axioms GroupApproximation.AlgebraicK.nestedKOneToKOne_surjective
#audit_axioms GroupApproximation.AlgebraicK.nestedKOneToKOne_injective
#audit_closed_axioms GroupApproximation.AlgebraicK.nestedUnionAlgebraicKOne
