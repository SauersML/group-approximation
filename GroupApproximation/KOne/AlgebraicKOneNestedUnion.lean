import GroupApproximation.KOne.FieldKOneDeterminant
import GroupApproximation.Meta.AxiomGuard

/-!
# `K₁` commutes with a nested union of subrings

For an increasing sequence of subrings `R₀ ⊆ R₁ ⊆ ⋯` whose union is `R`,

    `K₁(R) ≅ colim_n K₁(R_n)`,

and the isomorphism is the canonical comparison map, the one induced on the
colimit by the inclusions `R_n → R`.  `nestedUnionAlgebraicKOne` is the closed
statement.

## Why the two halves are easy in this presentation

`K₁` is built from matrices of *finite* size, and every such matrix has finitely
many entries.

* **Surjective.**  A class of `K₁(R)` is represented by some `u ∈ GL_m(R)`.  The
  `m²` entries of `u` and the `m²` entries of `u⁻¹` lie in finitely many stages,
  hence all in one, and the two identities `u u⁻¹ = u⁻¹ u = 1` transfer back to
  that stage because a subring inclusion is injective (`unitOfEntriesMem`).
* **Injective.**  `E_∞(R)` is generated by the classes of the elementary units
  `e_{ij}(a)`, `a ∈ R`, at all finite ranks, and each such generator already
  lives at a stage.  The stage images form a *directed* family of subgroups
  (`stageElementaryImage_mono`), so a whole product of generators lives at a
  single stage.  Then `glColimMap_injective` — the stable general linear group
  of a subring injects into that of the ambient ring — pulls the conclusion back
  to that stage.

## What this module adds to the tree

`KOne/AlgebraicKOneFunctor.lean` builds `glColimMap` and proves it respects
`E_∞`; `KOne/FieldKOneDeterminant.lean` descends it to `algebraicKOneMap`.
Neither records that these are *functorial* — `algebraicKOneMap_id` and
`algebraicKOneMap_comp` below — which a direct system needs, nor that an
injective coefficient map induces an injective map of stable general linear
groups.  Those three are proved here for an arbitrary ring homomorphism and are
of general use.

## The colimit

`DirectLimit` is Mathlib's, the same object `KOne/ClassicalKOne.lean` uses for
`GL(R)` and `KOne/LeavittKOnePowerColimit.lean` uses for `k^×`: the quotient of
`Σ n, K₁(R_n)` by the relation identifying two stages once they agree further
along.  Nothing about colimits is re-derived.
-/

namespace GroupApproximation
namespace AlgebraicK

/-! ### Functoriality of `K₁` -/

section Functoriality

variable {R S T : Type*} [Ring R] [Ring S] [Ring T]

theorem elementaryMatrixUnitMap_id {ι : Type*} [Fintype ι] [DecidableEq ι]
    (u : (Matrix ι ι R)ˣ) : elementaryMatrixUnitMap (RingHom.id R) u = u := by
  apply Units.ext
  ext i j
  rfl

theorem elementaryMatrixUnitMap_comp {ι : Type*} [Fintype ι] [DecidableEq ι]
    (g : S →+* T) (f : R →+* S) (u : (Matrix ι ι R)ˣ) :
    elementaryMatrixUnitMap g (elementaryMatrixUnitMap f u)
      = elementaryMatrixUnitMap (g.comp f) u := by
  apply Units.ext
  ext i j
  rfl

theorem elementaryMatrixUnitMap_injective {ι : Type*} [Fintype ι]
    [DecidableEq ι] (f : R →+* S) (hf : Function.Injective f) :
    Function.Injective (elementaryMatrixUnitMap (ι := ι) f) := by
  intro u v huv
  apply Units.ext
  ext i j
  exact hf (congrArg (fun z : (Matrix ι ι S)ˣ => (z : Matrix ι ι S) i j) huv)

theorem glColimMap_id (z : ClassicalGLColim R) :
    glColimMap (RingHom.id R) z = z := by
  induction z using DirectLimit.induction with
  | ih n u =>
      show glColimMap (RingHom.id R) (glColimOf R n u) = glColimOf R n u
      rw [glColimMap_glColimOf, elementaryMatrixUnitMap_id]

theorem glColimMap_comp (g : S →+* T) (f : R →+* S) (z : ClassicalGLColim R) :
    glColimMap g (glColimMap f z) = glColimMap (g.comp f) z := by
  induction z using DirectLimit.induction with
  | ih n u =>
      show glColimMap g (glColimMap f (glColimOf R n u))
        = glColimMap (g.comp f) (glColimOf R n u)
      rw [glColimMap_glColimOf, glColimMap_glColimOf, glColimMap_glColimOf,
        elementaryMatrixUnitMap_comp]

/-- **An injective coefficient map induces an injective map of stable general
linear groups.**  Two classes agreeing after applying `f` already agree at some
finite rank there, and padding commutes with `f`, so they agree at that rank
before applying it. -/
theorem glColimMap_injective (f : R →+* S) (hf : Function.Injective f) :
    Function.Injective (glColimMap f) := by
  intro z w hzw
  obtain ⟨n, u, v, rfl, rfl⟩ := DirectLimit.exists_eq_mk₂ (f := glStab R) z w
  have h : (glColimOf S n (elementaryMatrixUnitMap f u))
      = glColimOf S n (elementaryMatrixUnitMap f v) := hzw
  obtain ⟨k, hu, hv, heq⟩ := Quotient.exact h
  refine Quotient.sound ⟨k, hu, hv, elementaryMatrixUnitMap_injective f hf ?_⟩
  rw [← glStab_elementaryMatrixUnitMap f hu, ← glStab_elementaryMatrixUnitMap f hv]
  exact heq

theorem algebraicKOneMap_id (x : AlgebraicKOne R) :
    algebraicKOneMap (RingHom.id R) x = x := by
  obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective x
  rw [algebraicKOneMap_mk, glColimMap_id]

theorem algebraicKOneMap_comp (g : S →+* T) (f : R →+* S) (x : AlgebraicKOne R) :
    algebraicKOneMap g (algebraicKOneMap f x) = algebraicKOneMap (g.comp f) x := by
  obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective x
  rw [algebraicKOneMap_mk, algebraicKOneMap_mk, algebraicKOneMap_mk,
    glColimMap_comp]

end Functoriality

/-! ### Restricting a unit to a subring that contains its entries -/

section Restrict

variable {R : Type*} [Ring R] (T : Subring R)

theorem subringMapMatrix_injective {m : ℕ} :
    Function.Injective ((T.subtype).mapMatrix :
      Matrix (Fin m) (Fin m) ↥T →+* Matrix (Fin m) (Fin m) R) := by
  intro A B h
  ext i j
  exact congrArg (fun M : Matrix (Fin m) (Fin m) R => M i j) h

/-- **A unit of `GL_m(R)` whose entries and whose inverse's entries lie in `T`
is a unit of `GL_m(T)`.**  The two identities transfer because the entrywise
inclusion is an injective ring homomorphism of matrix rings. -/
def unitOfEntriesMem {m : ℕ} (u : (Matrix (Fin m) (Fin m) R)ˣ)
    (hval : ∀ i j, (u : Matrix (Fin m) (Fin m) R) i j ∈ T)
    (hinv : ∀ i j, (↑u⁻¹ : Matrix (Fin m) (Fin m) R) i j ∈ T) :
    (Matrix (Fin m) (Fin m) ↥T)ˣ where
  val := Matrix.of fun i j => ⟨(u : Matrix (Fin m) (Fin m) R) i j, hval i j⟩
  inv := Matrix.of fun i j => ⟨(↑u⁻¹ : Matrix (Fin m) (Fin m) R) i j, hinv i j⟩
  val_inv := by
    refine subringMapMatrix_injective T ?_
    rw [map_mul, map_one]
    show (u : Matrix (Fin m) (Fin m) R) * (↑u⁻¹ : Matrix (Fin m) (Fin m) R) = 1
    exact u.mul_inv
  inv_val := by
    refine subringMapMatrix_injective T ?_
    rw [map_mul, map_one]
    show (↑u⁻¹ : Matrix (Fin m) (Fin m) R) * (u : Matrix (Fin m) (Fin m) R) = 1
    exact u.inv_mul

theorem elementaryMatrixUnitMap_unitOfEntriesMem {m : ℕ}
    (u : (Matrix (Fin m) (Fin m) R)ˣ)
    (hval : ∀ i j, (u : Matrix (Fin m) (Fin m) R) i j ∈ T)
    (hinv : ∀ i j, (↑u⁻¹ : Matrix (Fin m) (Fin m) R) i j ∈ T) :
    elementaryMatrixUnitMap T.subtype (unitOfEntriesMem T u hval hinv) = u := by
  apply Units.ext
  ext i j
  rfl

end Restrict

/-! ### The nested union and its `K₁` colimit -/

section Nested

variable {R : Type*} [Ring R] (S : ℕ → Subring R) (hmono : Monotone S)

/-- The stage-to-stage inclusion `R_n → R_m`. -/
def nestedInclusion {n m : ℕ} (h : n ≤ m) : ↥(S n) →+* ↥(S m) :=
  Subring.inclusion (hmono h)

theorem nestedInclusion_self (n : ℕ) :
    nestedInclusion S hmono (le_refl n) = RingHom.id ↥(S n) :=
  RingHom.ext fun _ => rfl

theorem nestedInclusion_comp {n m k : ℕ} (h₁ : n ≤ m) (h₂ : m ≤ k) :
    (nestedInclusion S hmono h₂).comp (nestedInclusion S hmono h₁)
      = nestedInclusion S hmono (h₁.trans h₂) :=
  RingHom.ext fun _ => rfl

theorem subtype_comp_nestedInclusion {n m : ℕ} (h : n ≤ m) :
    ((S m).subtype).comp (nestedInclusion S hmono h) = (S n).subtype :=
  RingHom.ext fun _ => rfl

/-- The transition map of the direct system, `K₁(R_n) → K₁(R_m)`. -/
noncomputable def nestedKOneStep (n m : ℕ) (h : n ≤ m) :
    AlgebraicKOne ↥(S n) →* AlgebraicKOne ↥(S m) :=
  algebraicKOneMap (nestedInclusion S hmono h)

instance nestedKOneDirectedSystem :
    DirectedSystem (fun n : ℕ => AlgebraicKOne ↥(S n))
      (fun i j h => ⇑(nestedKOneStep S hmono i j h)) where
  map_self := fun i x => by
    show algebraicKOneMap (nestedInclusion S hmono (le_refl i)) x = x
    rw [nestedInclusion_self]
    exact algebraicKOneMap_id x
  map_map := fun _ _ _ hij hjk x => by
    show algebraicKOneMap (nestedInclusion S hmono hjk)
        (algebraicKOneMap (nestedInclusion S hmono hij) x)
      = algebraicKOneMap (nestedInclusion S hmono (hij.trans hjk)) x
    rw [algebraicKOneMap_comp, nestedInclusion_comp]

/-- **`colim_n K₁(R_n)`**, the quotient of `Σ n, K₁(R_n)` by the stage
relation. -/
noncomputable abbrev NestedKOneColim : Type _ :=
  DirectLimit (fun n : ℕ => AlgebraicKOne ↥(S n)) (nestedKOneStep S hmono)

/-- The canonical map from a stage into the colimit. -/
noncomputable def nestedKOneOf (n : ℕ) :
    AlgebraicKOne ↥(S n) →* NestedKOneColim S hmono where
  toFun x := ⟦⟨n, x⟩⟧
  map_one' := (DirectLimit.one_def (f := nestedKOneStep S hmono) n).symm
  map_mul' x y :=
    (DirectLimit.mul_def (f := nestedKOneStep S hmono) n x y).symm

theorem nestedCompat (i j : ℕ) (h : i ≤ j) (x : AlgebraicKOne ↥(S i)) :
    algebraicKOneMap (S i).subtype x
      = algebraicKOneMap (S j).subtype (nestedKOneStep S hmono i j h x) := by
  show _ = algebraicKOneMap (S j).subtype
    (algebraicKOneMap (nestedInclusion S hmono h) x)
  rw [algebraicKOneMap_comp, subtype_comp_nestedInclusion]

/-- **The canonical comparison map** `colim_n K₁(R_n) → K₁(R)`, induced by the
subring inclusions. -/
noncomputable def nestedKOneToKOne :
    NestedKOneColim S hmono →* AlgebraicKOne R where
  toFun := DirectLimit.lift (nestedKOneStep S hmono)
    (fun n => ⇑(algebraicKOneMap (S n).subtype)) (nestedCompat S hmono)
  map_one' :=
    DirectLimit.lift_one (fun n => algebraicKOneMap (S n).subtype)
      (nestedCompat S hmono)
  map_mul' :=
    DirectLimit.lift_mul (fun n => algebraicKOneMap (S n).subtype)
      (nestedCompat S hmono)

@[simp] theorem nestedKOneToKOne_of (n : ℕ) (x : AlgebraicKOne ↥(S n)) :
    nestedKOneToKOne S hmono (nestedKOneOf S hmono n x)
      = algebraicKOneMap (S n).subtype x := rfl

/-! ### Surjectivity -/

include hmono in
/-- **Every finite invertible matrix over `R` lives at a stage.** -/
theorem exists_stage_unit (hcover : ∀ x : R, ∃ n, x ∈ S n) {m : ℕ}
    (u : (Matrix (Fin m) (Fin m) R)ˣ) :
    ∃ (N : ℕ) (U : (Matrix (Fin m) (Fin m) ↥(S N))ˣ),
      elementaryMatrixUnitMap (S N).subtype U = u := by
  classical
  choose g hg using hcover
  obtain ⟨N, hval, hinv⟩ :
      ∃ N : ℕ, (∀ i j, (u : Matrix (Fin m) (Fin m) R) i j ∈ S N) ∧
        ∀ i j, (↑u⁻¹ : Matrix (Fin m) (Fin m) R) i j ∈ S N := by
    refine ⟨Finset.univ.sup fun p : Fin m × Fin m =>
      max (g ((u : Matrix (Fin m) (Fin m) R) p.1 p.2))
        (g ((↑u⁻¹ : Matrix (Fin m) (Fin m) R) p.1 p.2)), ?_, ?_⟩
    · intro i j
      refine hmono (le_trans (le_max_left (g ((u : Matrix (Fin m) (Fin m) R) i j))
        (g ((↑u⁻¹ : Matrix (Fin m) (Fin m) R) i j))) ?_) (hg _)
      exact Finset.le_sup (f := fun p : Fin m × Fin m =>
        max (g ((u : Matrix (Fin m) (Fin m) R) p.1 p.2))
          (g ((↑u⁻¹ : Matrix (Fin m) (Fin m) R) p.1 p.2)))
        (Finset.mem_univ (i, j))
    · intro i j
      refine hmono (le_trans (le_max_right (g ((u : Matrix (Fin m) (Fin m) R) i j))
        (g ((↑u⁻¹ : Matrix (Fin m) (Fin m) R) i j))) ?_) (hg _)
      exact Finset.le_sup (f := fun p : Fin m × Fin m =>
        max (g ((u : Matrix (Fin m) (Fin m) R) p.1 p.2))
          (g ((↑u⁻¹ : Matrix (Fin m) (Fin m) R) p.1 p.2)))
        (Finset.mem_univ (i, j))
  exact ⟨N, unitOfEntriesMem (S N) u hval hinv,
    elementaryMatrixUnitMap_unitOfEntriesMem (S N) u hval hinv⟩

theorem nestedKOneToKOne_surjective (hcover : ∀ x : R, ∃ n, x ∈ S n) :
    Function.Surjective (nestedKOneToKOne S hmono) := by
  intro y
  obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective y
  induction z using DirectLimit.induction with
  | ih m u =>
      obtain ⟨N, U, hU⟩ := exists_stage_unit S hmono hcover u
      refine ⟨nestedKOneOf S hmono N
        (QuotientGroup.mk (glColimOf ↥(S N) m U)), ?_⟩
      rw [nestedKOneToKOne_of, algebraicKOneMap_mk, glColimMap_glColimOf, hU]
      rfl

/-! ### Injectivity -/

/-- The part of `E_∞(R)` visible at stage `N`. -/
noncomputable def stageElementaryImage (N : ℕ) : Subgroup (ClassicalGLColim R) :=
  (elementaryColim ↥(S N)).map (glColimMap (S N).subtype)

include hmono in
theorem stageElementaryImage_mono : Monotone (stageElementaryImage S) := by
  intro n m h
  rintro _ ⟨w, hw, rfl⟩
  refine ⟨glColimMap (nestedInclusion S hmono h) w,
    elementaryColim_map_le _ ⟨w, hw, rfl⟩, ?_⟩
  rw [glColimMap_comp, subtype_comp_nestedInclusion]

theorem elementaryColim_le_iSup_stage (hcover : ∀ x : R, ∃ n, x ∈ S n) :
    elementaryColim R ≤ ⨆ N : ℕ, stageElementaryImage S N := by
  show (⨆ r : ℕ, (elementaryGroup (Fin r) R).map (glColimOf R r)) ≤ _
  refine iSup_le fun r => ?_
  rw [Subgroup.map_le_iff_le_comap, elementaryGroup, Subgroup.closure_le]
  rintro _ ⟨i, j, hij, a, rfl⟩
  obtain ⟨N, haN⟩ := hcover a
  refine Subgroup.mem_iSup_of_mem N ?_
  refine ⟨glColimOf ↥(S N) r (elementaryUnit i j hij ⟨a, haN⟩),
    glColimOf_mem_elementaryColim _ (elementaryUnit_mem i j hij _), ?_⟩
  rw [glColimMap_glColimOf, elementaryMatrixUnitMap_elementaryUnit]
  rfl

include hmono in
theorem exists_stage_of_mem_elementaryColim (hcover : ∀ x : R, ∃ n, x ∈ S n)
    {z : ClassicalGLColim R} (hz : z ∈ elementaryColim R) :
    ∃ N, z ∈ stageElementaryImage S N :=
  (Subgroup.mem_iSup_of_directed
    ((stageElementaryImage_mono S hmono).directed_le)).mp
      (elementaryColim_le_iSup_stage S hcover hz)

theorem nestedKOneToKOne_injective (hcover : ∀ x : R, ∃ n, x ∈ S n) :
    Function.Injective (nestedKOneToKOne S hmono) := by
  rw [injective_iff_map_eq_one]
  intro c hc
  induction c using DirectLimit.induction with
  | ih n x =>
      obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective x
      have hmem : glColimMap (S n).subtype z ∈ elementaryColim R :=
        (QuotientGroup.eq_one_iff _).mp hc
      obtain ⟨N, hN⟩ := exists_stage_of_mem_elementaryColim S hmono hcover hmem
      obtain ⟨w, hw, hwz⟩ :=
        stageElementaryImage_mono S hmono (le_max_right n N) hN
      have hstep : glColimMap
          (nestedInclusion S hmono (le_max_left n N)) z = w := by
        refine glColimMap_injective (S (max n N)).subtype
          Subtype.val_injective ?_
        rw [glColimMap_comp, subtype_comp_nestedInclusion, hwz]
      have hdies : nestedKOneStep S hmono n (max n N) (le_max_left n N)
          (QuotientGroup.mk z) = 1 := by
        show algebraicKOneMap (nestedInclusion S hmono (le_max_left n N))
          (QuotientGroup.mk z) = 1
        rw [algebraicKOneMap_mk, QuotientGroup.eq_one_iff, hstep]
        exact hw
      calc (⟦⟨n, (QuotientGroup.mk z : AlgebraicKOne ↥(S n))⟩⟧ :
            NestedKOneColim S hmono)
          = ⟦⟨max n N, nestedKOneStep S hmono n (max n N) (le_max_left n N)
              (QuotientGroup.mk z)⟩⟧ :=
            (DirectLimit.mk_apply (f := nestedKOneStep S hmono) n (max n N)
              (QuotientGroup.mk z) (le_max_left n N)).symm
        _ = ⟦⟨max n N, (1 : AlgebraicKOne ↥(S (max n N)))⟩⟧ := by rw [hdies]
        _ = 1 := (DirectLimit.one_def (f := nestedKOneStep S hmono) _).symm

end Nested

/-! ### The theorem -/

/-- **`K₁` commutes with a nested union of subrings**, as a closed proposition.

The first conjunct says the *canonical* comparison map is a bijection; the
second packages it as a multiplicative equivalence and pins it on every stage,
so this is strictly more than "some isomorphism exists". -/
def NestedUnionAlgebraicKOne : Prop :=
  ∀ (R : Type) [Ring R] (S : ℕ → Subring R) (hmono : Monotone S),
    (∀ x : R, ∃ n, x ∈ S n) →
      Function.Bijective (nestedKOneToKOne S hmono) ∧
        ∃ e : NestedKOneColim S hmono ≃* AlgebraicKOne R,
          ∀ (n : ℕ) (x : AlgebraicKOne ↥(S n)),
            e (nestedKOneOf S hmono n x) = algebraicKOneMap (S n).subtype x

theorem nestedUnionAlgebraicKOne : NestedUnionAlgebraicKOne := by
  intro R _ S hmono hcover
  have hbij : Function.Bijective (nestedKOneToKOne S hmono) :=
    ⟨nestedKOneToKOne_injective S hmono hcover,
      nestedKOneToKOne_surjective S hmono hcover⟩
  exact ⟨hbij, MulEquiv.ofBijective _ hbij, fun _ _ => rfl⟩

end AlgebraicK
end GroupApproximation

