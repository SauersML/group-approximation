import GroupApproximation.KOne.UnstableKOneAbelian
import GroupApproximation.Meta.AxiomGuard

/-!
# The diagonal group `D_ι(R)`, its normalizing action on `EL_ι(R)`, and
# `GL_ι(R) = EL_ι(R) · D_ι(R)`

`UnstableKOneAbelian.lean` needs only the *one-coordinate* diagonal matrices
`diagAt l u`, because the quotient `GL_ι(R)/EL_ι(R)` is already generated by
them.  The printed Khanh--Thanh sentence of `non_mf_groups_exist.tex`,

> Khanh--Thanh show that `GL_d(R) = EL_d(R) D_d(k)`, where `D_d(k)` is the
> abelian group of diagonal matrices with entries in `k^×`, which normalizes
> `EL_d(R)`

is about the *full* diagonal group, so this file introduces it:

* `diagonalUnit u` --- the diagonal matrix with entries a prescribed tuple of
  units `u : ι → Rˣ` --- and `diagonalGroup ι R`, the subgroup of `GL_ι(R)` it
  ranges over;
* `diagonalGroup_le_normalizer` --- **`D_ι(R)` normalizes `EL_ι(R)`**, over an
  arbitrary ring, with no division hypothesis: conjugating `x_{ab}(c)` by
  `diag(u)` gives `x_{ab}(u_a c u_b^{-1})`;
* `exists_elementary_mul_diagonal` and `elementaryGroup_sup_diagonalGroup_eq_top`
  --- **`GL_ι(R) = EL_ι(R) · D_ι(R)`** over a nontrivial strongly divisible
  ring, which is `RankNElimination.eq_elementary_mul_diagAt` with the trailing
  elementary factor pushed through the diagonal one.

The last section restricts the entries: for a ring homomorphism `f : k →+* R`
out of a *commutative* ring, `scalarDiagonalGroup f` is the group of diagonal
matrices whose entries lie in `f(k^×)`, and it is **abelian**
(`scalarDiagonalGroup_mul_comm`).  With `k` a field and `f = algebraMap k R`
this is the printed `D_d(k)`.

## What is not here

The printed decomposition has `D_d(k)`, not `D_d(R)`, and the gap between the
two is exactly the statement that every class of `GL_d(R)/EL_d(R)` is
represented by a *scalar* diagonal matrix.  Over `L_k(1,d)` that is
`LeavittKOneFormula.ScalarSurjective` in unstable form, open for `d ≥ 3`.
`Manuscript/OneSidedMFRadical/KhanhThanhDiagonalDecomposition.lean` states the
residual and reduces the printed sentence to it; nothing in this file assumes
it.
-/

namespace GroupApproximation
namespace RankNElimination

variable {R ι : Type*} [Ring R] [Fintype ι] [DecidableEq ι]

/-! ### The diagonal group -/

/-- The diagonal invertible matrix with prescribed unit entries. -/
def diagonalUnit (u : ι → Rˣ) : (Matrix ι ι R)ˣ where
  val := Matrix.diagonal fun i ↦ ((u i : R))
  inv := Matrix.diagonal fun i ↦ (((u i)⁻¹ : Rˣ) : R)
  val_inv := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    funext i
    simp
  inv_val := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    funext i
    simp

@[simp] theorem diagonalUnit_val (u : ι → Rˣ) :
    ((diagonalUnit u : (Matrix ι ι R)ˣ) : Matrix ι ι R) =
      Matrix.diagonal fun i ↦ ((u i : R)) := rfl

theorem diagonalUnit_inv_val (u : ι → Rˣ) :
    (((diagonalUnit u : (Matrix ι ι R)ˣ)⁻¹ : (Matrix ι ι R)ˣ) : Matrix ι ι R) =
      Matrix.diagonal fun i ↦ (((u i)⁻¹ : Rˣ) : R) := rfl

/-- The diagonal embedding `(ι → Rˣ) → GL_ι(R)` as a group homomorphism. -/
def diagonalHom : (ι → Rˣ) →* (Matrix ι ι R)ˣ where
  toFun := diagonalUnit
  map_one' := by
    apply Units.ext
    rw [diagonalUnit_val, Units.val_one, ← Matrix.diagonal_one]
    congr 1
  map_mul' u v := by
    apply Units.ext
    rw [Units.val_mul, diagonalUnit_val, diagonalUnit_val, diagonalUnit_val,
      Matrix.diagonal_mul_diagonal]
    congr 1

theorem diagonalHom_apply (u : ι → Rˣ) :
    (diagonalHom u : (Matrix ι ι R)ˣ) = diagonalUnit u := rfl

/-- `D_ι(R)`: the diagonal matrices with invertible entries. -/
def diagonalGroup (ι R : Type*) [Fintype ι] [DecidableEq ι] [Ring R] :
    Subgroup (Matrix ι ι R)ˣ :=
  (diagonalHom (ι := ι) (R := R)).range

theorem mem_diagonalGroup_iff {A : (Matrix ι ι R)ˣ} :
    A ∈ diagonalGroup ι R ↔ ∃ u : ι → Rˣ, diagonalUnit u = A := Iff.rfl

theorem diagonalUnit_mem (u : ι → Rˣ) :
    diagonalUnit u ∈ diagonalGroup ι R := ⟨u, rfl⟩

/-- The one-coordinate diagonal matrices of `RankNElimination` are diagonal. -/
theorem diagAt_mem_diagonalGroup (l : ι) (u : Rˣ) :
    (diagAt l u : (Matrix ι ι R)ˣ) ∈ diagonalGroup ι R := by
  refine mem_diagonalGroup_iff.mpr
    ⟨fun i ↦ if i = l then u else 1, Units.ext ?_⟩
  rw [diagonalUnit_val, diagAt_val]
  congr 1
  funext i
  by_cases h : i = l <;> simp [h]

/-! ### `D_ι(R)` normalizes `EL_ι(R)` -/

/-- **Conjugating an elementary matrix by a diagonal one** gives an elementary
matrix at the same two indices, with the entry rescaled on both sides.  This is
the general-entry form of `diagAt_conj_elementaryUnit`. -/
theorem diagonalUnit_conj_elementaryUnit (u : ι → Rˣ) {a b : ι} (hab : a ≠ b)
    (c : R) :
    diagonalUnit u * elementaryUnit a b hab c * (diagonalUnit u)⁻¹ =
      elementaryUnit a b hab ((u a : R) * c * (((u b)⁻¹ : Rˣ) : R)) := by
  have hdd : (Matrix.diagonal fun i ↦ ((u i : R))) *
      (Matrix.diagonal fun i ↦ (((u i)⁻¹ : Rˣ) : R)) = 1 := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    funext i
    simp
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, diagonalUnit_val, diagonalUnit_inv_val]
  show (Matrix.diagonal (fun i ↦ ((u i : R))) * (1 + Matrix.single a b c)) *
      Matrix.diagonal (fun i ↦ (((u i)⁻¹ : Rˣ) : R)) = 1 + Matrix.single a b _
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, hdd,
    diagonal_mul_single_mul_diagonal]

/-- Conjugation by a diagonal matrix preserves the elementary group. -/
theorem diagonalUnit_conj_mem (u : ι → Rˣ) {Y : (Matrix ι ι R)ˣ}
    (hY : Y ∈ elementaryGroup ι R) :
    diagonalUnit u * Y * (diagonalUnit u)⁻¹ ∈ elementaryGroup ι R := by
  have hle : elementaryGroup ι R ≤ (elementaryGroup ι R).comap
      (MulAut.conj (diagonalUnit u)).toMonoidHom := by
    rw [elementaryGroup]
    refine (Subgroup.closure_le _).mpr ?_
    rintro z ⟨i, j, hij, a, rfl⟩
    show diagonalUnit u * elementaryUnit i j hij a * (diagonalUnit u)⁻¹ ∈
      elementaryGroup ι R
    rw [diagonalUnit_conj_elementaryUnit]
    exact elementaryUnit_mem _ _ _ _
  exact hle hY

theorem conj_mem_of_mem_diagonalGroup {D : (Matrix ι ι R)ˣ}
    (hD : D ∈ diagonalGroup ι R) {Y : (Matrix ι ι R)ˣ}
    (hY : Y ∈ elementaryGroup ι R) : D * Y * D⁻¹ ∈ elementaryGroup ι R := by
  obtain ⟨u, rfl⟩ := mem_diagonalGroup_iff.mp hD
  exact diagonalUnit_conj_mem u hY

/-- **`D_ι(R)` normalizes `EL_ι(R)`**, over an arbitrary ring: no
nontriviality, no division property, no lower bound on the rank. -/
theorem diagonalGroup_le_normalizer :
    diagonalGroup ι R ≤
      Subgroup.normalizer (elementaryGroup ι R : Set (Matrix ι ι R)ˣ) := by
  intro D hD
  rw [Subgroup.mem_normalizer_iff]
  intro Y
  refine ⟨fun hY ↦ conj_mem_of_mem_diagonalGroup hD hY, fun hY ↦ ?_⟩
  have h := conj_mem_of_mem_diagonalGroup (inv_mem hD) hY
  have heq : D⁻¹ * (D * Y * D⁻¹) * D⁻¹⁻¹ = Y := by group
  rwa [heq] at h

/-! ### `GL_ι(R) = EL_ι(R) · D_ι(R)` -/

/-- **The Gaussian elimination read as a two-factor decomposition**: over a
nontrivial strongly divisible ring, every invertible matrix is an elementary
matrix times a diagonal one.

`eq_elementary_mul_diagAt` gives `A = E · diagAt l u · F`; the trailing
elementary factor is pushed through the diagonal one, which is legitimate
because the diagonal matrices normalize `EL_ι(R)`. -/
theorem exists_elementary_mul_diagonal [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) (A : (Matrix ι ι R)ˣ) (l : ι) :
    ∃ E ∈ elementaryGroup ι R, ∃ D ∈ diagonalGroup ι R, A = E * D := by
  obtain ⟨E, hE, F, hF, u, hA⟩ := eq_elementary_mul_diagAt hdiv A l
  refine ⟨E * ((diagAt l u : (Matrix ι ι R)ˣ) * F *
      (diagAt l u : (Matrix ι ι R)ˣ)⁻¹),
    mul_mem hE (diagAt_conj_mem l u hF), diagAt l u,
    diagAt_mem_diagonalGroup l u, ?_⟩
  rw [hA]
  group

/-- **`GL_ι(R) = EL_ι(R) · D_ι(R)`** in subgroup form. -/
theorem elementaryGroup_sup_diagonalGroup_eq_top [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) (l : ι) :
    elementaryGroup ι R ⊔ diagonalGroup ι R = ⊤ := by
  rw [eq_top_iff]
  intro A _
  obtain ⟨E, hE, D, hD, rfl⟩ := exists_elementary_mul_diagonal hdiv A l
  exact mul_mem (Subgroup.mem_sup_left hE) (Subgroup.mem_sup_right hD)

/-! ### Diagonal matrices with scalar entries -/

section Scalar

variable {k : Type*} [CommRing k]

/-- Entrywise application of a ring homomorphism to a tuple of unit scalars. -/
def scalarUnitsPi (f : k →+* R) : (ι → kˣ) →* (ι → Rˣ) where
  toFun a i := Units.map (f : k →* R) (a i)
  map_one' := by
    funext i
    exact map_one (Units.map (f : k →* R))
  map_mul' a b := by
    funext i
    exact map_mul (Units.map (f : k →* R)) (a i) (b i)

/-- `D_ι(k)`: the diagonal matrices whose entries are units of `k`, pushed into
`R` along `f`.  With `k` a field and `f = algebraMap k R` this is the printed
`D_d(k)`. -/
def scalarDiagonalGroup (f : k →+* R) : Subgroup (Matrix ι ι R)ˣ :=
  ((diagonalHom (ι := ι) (R := R)).comp (scalarUnitsPi (ι := ι) f)).range

theorem mem_scalarDiagonalGroup_iff (f : k →+* R) {A : (Matrix ι ι R)ˣ} :
    A ∈ scalarDiagonalGroup (ι := ι) f ↔
      ∃ a : ι → kˣ, diagonalUnit (fun i ↦ Units.map (f : k →* R) (a i)) = A :=
  Iff.rfl

theorem scalarDiagonalUnit_mem (f : k →+* R) (a : ι → kˣ) :
    diagonalUnit (fun i ↦ Units.map (f : k →* R) (a i)) ∈
      scalarDiagonalGroup (ι := ι) f := ⟨a, rfl⟩

theorem scalarDiagonalGroup_le_diagonalGroup (f : k →+* R) :
    scalarDiagonalGroup (ι := ι) f ≤ diagonalGroup ι R := by
  rintro A hA
  obtain ⟨a, rfl⟩ := (mem_scalarDiagonalGroup_iff f).mp hA
  exact diagonalUnit_mem _

/-- **`D_ι(k)` normalizes `EL_ι(R)`.** -/
theorem scalarDiagonalGroup_le_normalizer (f : k →+* R) :
    scalarDiagonalGroup (ι := ι) f ≤
      Subgroup.normalizer (elementaryGroup ι R : Set (Matrix ι ι R)ˣ) :=
  le_trans (scalarDiagonalGroup_le_diagonalGroup f) diagonalGroup_le_normalizer

/-- **`D_ι(k)` is abelian**: its two elements come from the commutative group
`ι → kˣ`. -/
theorem scalarDiagonalGroup_mul_comm (f : k →+* R) {A B : (Matrix ι ι R)ˣ}
    (hA : A ∈ scalarDiagonalGroup (ι := ι) f)
    (hB : B ∈ scalarDiagonalGroup (ι := ι) f) : A * B = B * A := by
  obtain ⟨a, rfl⟩ := hA
  obtain ⟨b, rfl⟩ := hB
  rw [← map_mul, ← map_mul, mul_comm]

/-- **`D_ι(k)` is an abelian group**, as the printed sentence says: any two of
its elements commute, in the subgroup itself. -/
theorem scalarDiagonalGroup_commute (f : k →+* R)
    (A B : scalarDiagonalGroup (ι := ι) f) : A * B = B * A :=
  Subtype.ext (scalarDiagonalGroup_mul_comm f A.2 B.2)

end Scalar

end RankNElimination
end GroupApproximation

/-! ### Axiom audit -/

#audit_axioms GroupApproximation.RankNElimination.diagonalGroup_le_normalizer
#audit_axioms GroupApproximation.RankNElimination.exists_elementary_mul_diagonal
#audit_axioms GroupApproximation.RankNElimination.elementaryGroup_sup_diagonalGroup_eq_top
#audit_axioms GroupApproximation.RankNElimination.scalarDiagonalGroup_le_normalizer
#audit_axioms GroupApproximation.RankNElimination.scalarDiagonalGroup_mul_comm
#audit_axioms GroupApproximation.RankNElimination.scalarDiagonalGroup_commute
