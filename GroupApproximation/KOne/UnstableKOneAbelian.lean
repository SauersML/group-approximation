import GroupApproximation.KOne.BlockWhitehead
import GroupApproximation.Meta.AxiomGuard

/-!
# The unstable `K₁` of a strongly divisible ring is abelian

Over a nontrivial ring in which every nonzero element divides the identity on
both sides, and at any rank with two distinct coordinates:

* `EL_ι(R)` is **normal** in `GL_ι(R)` (`elementaryGroup_normal_of_division`);
* `GL_ι(R) / EL_ι(R)` is a quotient of `Rˣ` and is **abelian**, so

      `⁅GL_ι(R), GL_ι(R)⁆ ≤ EL_ι(R)`   (`commutator_le_elementaryGroup`).

`elementaryGroup_normal_of_division` shares its short name with
`MatrixDiagonalization.elementaryGroup_normal_of_division`
(`Leavitt/DiagonalClassGroup.lean`), which is the rank-two case of it; the two
full names differ, the hypotheses are the same predicate, and at `ι = Fin 2`
the statement below is exactly the older one.  Nothing here edits or replaces
it --- new consumers at arbitrary rank should use this one, rank-two consumers
either.

Both come from the two facts proved in this directory and nothing else:
Gaussian elimination at every rank (`RankNElimination`) writes every invertible
matrix as `E · diagAt l u · F` with `E`, `F` elementary, so the quotient is
generated by the image of the diagonal embedding `u ↦ diagAt l u`; and
Whitehead's identity in a two-index block (`BlockWhitehead`) kills the
commutators of that image.

## What this settles about a citation

`non_mf_groups_exist.tex`, `cor:leavitt-mf-quotient`, cites Khanh--Thanh's
proof of Theorem 7.2 for `GL_d(R) = EL_d(R) D_d(k)`, and uses that
decomposition **only** through its consequence `[GL_d(R), GL_d(R)] ≤ EL_d(R)`
--- which is what `LeavittMFQuotientGeneral.PrintedKhanhThanhCommutatorInElementary`
isolates.  The theorem below gives that consequence from strong division alone.
Since a purely infinite simple ring has strong division, the Khanh--Thanh
citation is not needed for the printed chain; what it is still needed for is
the *other* half of the same sentence, the identification
`K₁(L_k(1,d)) ≅ k^×/(k^×)^{d-1}`, which the printed corollary states and
`PrintedLeavittMFQuotientGeneral` deliberately does not carry.
-/

namespace GroupApproximation
namespace RankNElimination

open scoped commutatorElement

variable {R ι : Type*} [Ring R] [Fintype ι] [DecidableEq ι]

/-! ### Conjugating an elementary matrix by a diagonal unit -/

theorem diagAt_inv_val (l : ι) (u : Rˣ) :
    (((diagAt l u : (Matrix ι ι R)ˣ)⁻¹ : (Matrix ι ι R)ˣ) : Matrix ι ι R) =
      Matrix.diagonal fun i ↦ if i = l then ((u⁻¹ : Rˣ) : R) else 1 := rfl

theorem diagonal_mul_single_mul_diagonal (d e : ι → R) (a b : ι) (c : R) :
    Matrix.diagonal d * Matrix.single a b c * Matrix.diagonal e =
      Matrix.single a b (d a * c * e b) := by
  ext x y
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.single_apply,
    Matrix.single_apply]
  by_cases h : a = x ∧ b = y
  · rw [if_pos h, if_pos h, h.1, h.2]
  · rw [if_neg h, if_neg h, mul_zero, zero_mul]

/-- Conjugating an elementary matrix by `diagAt l u` gives an elementary
matrix at the same two indices. -/
theorem diagAt_conj_elementaryUnit (l : ι) (u : Rˣ) {a b : ι} (hab : a ≠ b)
    (c : R) :
    (diagAt l u : (Matrix ι ι R)ˣ) * elementaryUnit a b hab c *
        (diagAt l u : (Matrix ι ι R)ˣ)⁻¹ =
      elementaryUnit a b hab
        ((if a = l then (u : R) else 1) * c *
          (if b = l then ((u⁻¹ : Rˣ) : R) else 1)) := by
  have hdd : (Matrix.diagonal (fun i ↦ if i = l then (u : R) else 1) :
        Matrix ι ι R) *
      Matrix.diagonal (fun i ↦ if i = l then ((u⁻¹ : Rˣ) : R) else 1) = 1 := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    exact congrArg Matrix.diagonal
      (funext fun i ↦ by by_cases h : i = l <;> simp [h])
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, diagAt_val, diagAt_inv_val]
  show (Matrix.diagonal (fun i ↦ if i = l then (u : R) else 1) *
      (1 + Matrix.single a b c)) *
      Matrix.diagonal (fun i ↦ if i = l then ((u⁻¹ : Rˣ) : R) else 1) =
    1 + Matrix.single a b _
  rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_mul, hdd,
    diagonal_mul_single_mul_diagonal]

/-- Conjugation by a diagonal unit preserves the elementary group. -/
theorem diagAt_conj_mem (l : ι) (u : Rˣ) {Y : (Matrix ι ι R)ˣ}
    (hY : Y ∈ elementaryGroup ι R) :
    (diagAt l u : (Matrix ι ι R)ˣ) * Y * (diagAt l u : (Matrix ι ι R)ˣ)⁻¹ ∈
      elementaryGroup ι R := by
  have hle : elementaryGroup ι R ≤ (elementaryGroup ι R).comap
      (MulAut.conj (diagAt l u : (Matrix ι ι R)ˣ)).toMonoidHom := by
    rw [elementaryGroup]
    refine (Subgroup.closure_le _).mpr ?_
    rintro z ⟨i, j, hij, a, rfl⟩
    show (diagAt l u : (Matrix ι ι R)ˣ) * elementaryUnit i j hij a *
      (diagAt l u : (Matrix ι ι R)ˣ)⁻¹ ∈ elementaryGroup ι R
    rw [diagAt_conj_elementaryUnit]
    exact elementaryUnit_mem _ _ _ _
  exact hle hY

/-! ### Normality -/

/-- **`EL_ι(R)` is normal in `GL_ι(R)`** over a strongly divisible ring: every
invertible matrix is elementary times a diagonal times elementary, and a
diagonal conjugates elementary matrices to elementary matrices. -/
theorem elementaryGroup_normal_of_division [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) (l : ι) :
    (elementaryGroup ι R).Normal := by
  constructor
  intro Y hY A
  obtain ⟨E, hE, F, hF, u, hA⟩ := eq_elementary_mul_diagAt hdiv A l
  have h1 : F * Y * F⁻¹ ∈ elementaryGroup ι R :=
    mul_mem (mul_mem hF hY) (inv_mem hF)
  have h3 : E * ((diagAt l u : (Matrix ι ι R)ˣ) * (F * Y * F⁻¹) *
      (diagAt l u : (Matrix ι ι R)ˣ)⁻¹) * E⁻¹ ∈ elementaryGroup ι R :=
    mul_mem (mul_mem hE (diagAt_conj_mem l u h1)) (inv_mem hE)
  have heq : A * Y * A⁻¹ =
      E * ((diagAt l u : (Matrix ι ι R)ˣ) * (F * Y * F⁻¹) *
        (diagAt l u : (Matrix ι ι R)ˣ)⁻¹) * E⁻¹ := by
    rw [hA]
    group
  rw [heq]
  exact h3

/-! ### The unstable `K₁` is abelian -/

/-- **`⁅GL_ι(R), GL_ι(R)⁆ ≤ EL_ι(R)`** for every nontrivial strongly divisible
ring and every index type with two distinct indices.

No hypothesis beyond strong division: the quotient is generated by the image of
`u ↦ diagAt l u` because of Gaussian elimination, and Whitehead's identity
kills the commutators of that image. -/
theorem commutator_le_elementaryGroup [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) {l m : ι} (hlm : l ≠ m) :
    commutator (Matrix ι ι R)ˣ ≤ elementaryGroup ι R := by
  haveI hN : (elementaryGroup ι R).Normal :=
    elementaryGroup_normal_of_division hdiv l
  rw [commutator_def, Subgroup.commutator_le]
  intro A _ B _
  obtain ⟨E₁, hE₁, F₁, hF₁, u, hA⟩ := eq_elementary_mul_diagAt hdiv A l
  obtain ⟨E₂, hE₂, F₂, hF₂, v, hB⟩ := eq_elementary_mul_diagAt hdiv B l
  have hq : ∀ X ∈ elementaryGroup ι R,
      (QuotientGroup.mk' (elementaryGroup ι R)) X = 1 := fun X hX ↦
    (QuotientGroup.eq_one_iff X).mpr hX
  have hqA : (QuotientGroup.mk' (elementaryGroup ι R)) A =
      (QuotientGroup.mk' (elementaryGroup ι R)) (diagAt l u) := by
    rw [hA, map_mul, map_mul, hq E₁ hE₁, hq F₁ hF₁, one_mul, mul_one]
  have hqB : (QuotientGroup.mk' (elementaryGroup ι R)) B =
      (QuotientGroup.mk' (elementaryGroup ι R)) (diagAt l v) := by
    rw [hB, map_mul, map_mul, hq E₂ hE₂, hq F₂ hF₂, one_mul, mul_one]
  have hcomm : ⁅(diagAt l u : (Matrix ι ι R)ˣ), (diagAt l v : (Matrix ι ι R)ˣ)⁆
      = diagAt l ⁅u, v⁆ := by
    rw [← diagAtHom_apply l u, ← diagAtHom_apply l v, ← map_commutatorElement,
      diagAtHom_apply]
  have hzero : (QuotientGroup.mk' (elementaryGroup ι R)) ⁅A, B⁆ = 1 := by
    rw [map_commutatorElement, hqA, hqB, ← map_commutatorElement, hcomm]
    exact hq _ (diagAt_commutatorElement_mem l m hlm u v)
  have hker : ⁅A, B⁆ ∈ (QuotientGroup.mk' (elementaryGroup ι R)).ker :=
    MonoidHom.mem_ker.mpr hzero
  rwa [QuotientGroup.ker_mk'] at hker

end RankNElimination
end GroupApproximation

/-! ### Axiom audit -/

#audit_axioms GroupApproximation.RankNElimination.exists_elementary_mul_diagAt
#audit_axioms GroupApproximation.RankNElimination.diagAt_commutatorElement_mem
#audit_axioms GroupApproximation.RankNElimination.elementaryGroup_normal_of_division
#audit_axioms GroupApproximation.RankNElimination.commutator_le_elementaryGroup
