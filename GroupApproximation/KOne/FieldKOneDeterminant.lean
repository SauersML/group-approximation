import GroupApproximation.KOne.MoritaKOne
import GroupApproximation.KOne.AlgebraicKOneFunctor
import GroupApproximation.KOne.RankNElimination
import Mathlib.LinearAlgebra.Matrix.Transvection
import Mathlib.LinearAlgebra.Matrix.Kronecker

/-!
# `K₁(k) ≅ k^×` for a field, by the determinant, and the degree of the scalar inclusion

`non_mf_groups_exist.tex`, `cor:leavitt-mf-quotient` (line 1276):

> `H/EL_d(R) ≅ K_1(R) ≅ k^×/(k^×)^{d-1}`

The right-hand isomorphism is where this module is consumed: `K_1(L_k(1,d))` is
a colimit of copies of `K_1(k)`, and the transition map is the one the scalar
inclusion `k → M_d(k)` induces.  Two facts are needed about the field, and
neither was on the tree:

* `K_1(k) ≅ k^×`, the determinant;
* the induced map of that colimit is `x ↦ x^d`.

Both are proved here for an arbitrary field, at the repo's `AlgebraicKOne`.

## The determinant argument, and why it is short

`ker det = EL_n(k)` is usually quoted as "`SL_n` is generated by elementary
matrices", proved by Gaussian elimination and a Whitehead trick on the leftover
diagonal.  None of that is needed here, because the elimination is already on
the tree in the form that leaves **one** diagonal entry:
`RankNElimination.eq_elementary_mul_diagAt` writes every `A ∈ GL_ι(R)` as
`E · diagAt l u · F` with `E, F` elementary, over any nontrivial ring in which
every nonzero element divides `1` on both sides.  A field satisfies that
hypothesis (`hasSingleSandwichDivision_of_field`), and taking determinants gives
`det A = u` outright.  So `det A = 1` forces `diagAt l u = 1` and `A = E · F`:
both inclusions of `ker det = EL_ι(k)`, and surjectivity, with no Whitehead
trick and no `SL` generation theorem.

The same factorization makes the comparison with stabilization cheap
(`detUnits_glStab`): padding carries elementary matrices to elementary matrices
(`AlgebraicK.glStab_elementaryGroup_le`) and `diagAt l u` to `diagAt (castLE l) u`
(`glStab_diagAt`), and both sides of the equation only see `u`.

## The degree

`Matrix.scalar (Fin d) : k →+* M_d(k)` is a ring homomorphism, so it acts on
`K₁` through the tree's coefficient functoriality (`glColimMap`,
`elementaryColim_map_le`), which `algebraicKOneMap` descends to the quotient.
Read through `fieldKOneEquiv` on the source and through
`MoritaKOne`'s `moritaKOneEquiv` and `fieldKOneEquiv` on the target, that map is
`x ↦ x^d` (`fieldKOneEquiv_scalarMap`): entrywise the scalar inclusion is
`A ↦ A ⊗ 1_d`, whose determinant is `(det A)^d` by `Matrix.det_kronecker`.

`K_1(k) ≅ k^×` is classical background rather than a printed sentence of the
manuscript, so nothing here is a sentence carrier; the printed sentence it feeds
is `cor:leavitt-mf-quotient`, owned elsewhere.
-/

namespace GroupApproximation
namespace AlgebraicK

open RankNElimination

noncomputable section

/-! ### The determinant of an invertible matrix over a field -/

section Det

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {k : Type*} [Field k]

/-- **`det : GL_ι(k) → k^×`.** -/
def detUnits : (Matrix ι ι k)ˣ →* kˣ :=
  Units.map (Matrix.detMonoidHom : Matrix ι ι k →* k)

@[simp] theorem detUnits_val (u : (Matrix ι ι k)ˣ) :
    ((detUnits u : kˣ) : k) = Matrix.det (u : Matrix ι ι k) := rfl

/-- The determinant of an elementary matrix is `1`: it is a transvection. -/
theorem detUnits_elementaryUnit (i j : ι) (hij : i ≠ j) (a : k) :
    detUnits (elementaryUnit i j hij a) = 1 := by
  apply Units.ext
  show Matrix.det (Matrix.transvection i j a) = ((1 : kˣ) : k)
  rw [Matrix.det_transvection_of_ne i j hij a, Units.val_one]

/-- Hence the determinant of an elementary *matrix* is `1`. -/
theorem detUnits_eq_one_of_mem_elementaryGroup {u : (Matrix ι ι k)ˣ}
    (hu : u ∈ elementaryGroup ι k) : detUnits u = 1 := by
  have hle : elementaryGroup ι k ≤ (detUnits (ι := ι) (k := k)).ker := by
    rw [elementaryGroup, Subgroup.closure_le]
    rintro _ ⟨i, j, hij, a, rfl⟩
    exact MonoidHom.mem_ker.mpr (detUnits_elementaryUnit i j hij a)
  exact hle hu

/-- The determinant of `diagAt l u` is `u`. -/
theorem detUnits_diagAt (l : ι) (u : kˣ) : detUnits (diagAt l u) = u := by
  apply Units.ext
  show Matrix.det (Matrix.diagonal fun i ↦ if i = l then (u : k) else 1) = (u : k)
  rw [Matrix.det_diagonal]
  simp

/-- `diagAt l 1 = 1`. -/
theorem diagAt_one (l : ι) : diagAt l (1 : kˣ) = 1 := by
  apply Units.ext
  have hfun : (fun i : ι ↦ if i = l then ((1 : kˣ) : k) else 1) = fun _ ↦ (1 : k) := by
    funext i
    by_cases h : i = l <;> simp [h]
  rw [diagAt_val, hfun]
  exact Matrix.diagonal_one

/-- **A field divides on both sides**, the hypothesis the tree's Gaussian
elimination takes. -/
theorem hasSingleSandwichDivision_of_field :
    HasSingleSandwichDivision k := by
  intro a ha
  exact ⟨a⁻¹, 1, by rw [mul_one, inv_mul_cancel₀ ha]⟩

/-- **`ker det ≤ EL_ι(k)`.**  By the tree's Gaussian elimination every
invertible matrix is `E · diagAt l u · F` with `E`, `F` elementary; the
determinant of that is `u`, so a determinant of `1` leaves `E · F`. -/
theorem mem_elementaryGroup_of_detUnits_eq_one [Nonempty ι]
    {u : (Matrix ι ι k)ˣ} (hu : detUnits u = 1) : u ∈ elementaryGroup ι k := by
  obtain ⟨l⟩ := ‹Nonempty ι›
  obtain ⟨E, hE, F, hF, v, huv⟩ :=
    eq_elementary_mul_diagAt (hasSingleSandwichDivision_of_field (k := k)) u l
  have hv : v = 1 := by
    have hd := congrArg detUnits huv
    rw [map_mul, map_mul, detUnits_eq_one_of_mem_elementaryGroup hE,
      detUnits_eq_one_of_mem_elementaryGroup hF, detUnits_diagAt, one_mul,
      mul_one, hu] at hd
    exact hd.symm
  rw [huv, hv, diagAt_one, mul_one]
  exact mul_mem hE hF

/-- **`ker det = EL_ι(k)`** at every nonempty rank. -/
theorem ker_detUnits [Nonempty ι] :
    (detUnits (ι := ι) (k := k)).ker = elementaryGroup ι k := by
  apply le_antisymm
  · intro u hu
    exact mem_elementaryGroup_of_detUnits_eq_one (MonoidHom.mem_ker.mp hu)
  · intro u hu
    exact MonoidHom.mem_ker.mpr (detUnits_eq_one_of_mem_elementaryGroup hu)

/-- **The determinant is surjective** at every nonempty rank. -/
theorem detUnits_surjective [Nonempty ι] :
    Function.Surjective (detUnits (ι := ι) (k := k)) := by
  intro x
  obtain ⟨l⟩ := ‹Nonempty ι›
  exact ⟨diagAt l x, detUnits_diagAt l x⟩

end Det

/-! ### Padding a one-entry diagonal -/

section Stab

variable {k : Type*} [Field k]

/-- Padding carries `diagAt l u` to `diagAt (castLE l) u`. -/
theorem glStab_diagAt {p q : ℕ} (h : p ≤ q) (l : Fin p) (u : kˣ) :
    glStab k p q h (diagAt l u) = diagAt (Fin.castLE h l) u := by
  apply Units.ext
  rw [glStab_val, diagAt_val, diagAt_val]
  ext x y
  rw [stabMatrix_apply]
  by_cases hx : (x : ℕ) < p
  · by_cases hy : (y : ℕ) < p
    · rw [padEntry_of_lt_lt _ hx hy, Matrix.diagonal_apply, Matrix.diagonal_apply]
      by_cases hxy : (x : ℕ) = (y : ℕ)
      · rw [if_pos (show (⟨(x : ℕ), hx⟩ : Fin p) = ⟨(y : ℕ), hy⟩ from Fin.ext hxy),
          if_pos (show x = y from Fin.ext hxy)]
        by_cases hl : (x : ℕ) = (l : ℕ)
        · rw [if_pos (show (⟨(x : ℕ), hx⟩ : Fin p) = l from Fin.ext hl),
            if_pos (show x = Fin.castLE h l from Fin.ext hl)]
        · have h1 : ¬ ((⟨(x : ℕ), hx⟩ : Fin p) = l) := by
            intro hc
            have hv := congrArg Fin.val hc
            exact hl hv
          have h2 : ¬ (x = Fin.castLE h l) := by
            intro hc
            have hv := congrArg Fin.val hc
            exact hl hv
          rw [if_neg h1, if_neg h2]
      · have h1 : ¬ ((⟨(x : ℕ), hx⟩ : Fin p) = ⟨(y : ℕ), hy⟩) := by
          intro hc
          have hv := congrArg Fin.val hc
          exact hxy hv
        have h2 : ¬ (x = y) := by
          intro hc
          have hv := congrArg Fin.val hc
          exact hxy hv
        rw [if_neg h1, if_neg h2]
    · have hne : ¬ (x = y) := by
        intro hc
        exact hy (by rw [← hc]; exact hx)
      rw [padEntry_of_lt_ge _ hx hy, Matrix.diagonal_apply_ne _ hne]
  · have hlx : ¬ (x = Fin.castLE h l) := by
      intro hc
      apply hx
      have hv := congrArg Fin.val hc
      rw [hv]
      exact l.isLt
    rw [padEntry_of_ge _ hx, Matrix.diagonal_apply]
    by_cases hxy : (x : ℕ) = (y : ℕ)
    · rw [if_pos hxy, if_pos (show x = y from Fin.ext hxy), if_neg hlx]
    · have h2 : ¬ (x = y) := by
        intro hc
        have hv := congrArg Fin.val hc
        exact hxy hv
      rw [if_neg hxy, if_neg h2]

/-- **The determinant is compatible with stabilization.**  Both sides see only
the surviving diagonal entry of the Gaussian elimination. -/
theorem detUnits_glStab {p q : ℕ} (h : p ≤ q) (u : (Matrix (Fin p) (Fin p) k)ˣ) :
    detUnits (glStab k p q h u) = detUnits u := by
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · have hu : u = 1 := Units.ext (by ext i; exact i.elim0)
    rw [hu, map_one, map_one, map_one]
  · haveI : Nonempty (Fin p) := ⟨⟨0, hp⟩⟩
    obtain ⟨E, hE, F, hF, v, huv⟩ :=
      eq_elementary_mul_diagAt (hasSingleSandwichDivision_of_field (k := k)) u
        (⟨0, hp⟩ : Fin p)
    have hEq : detUnits (glStab k p q h E) = 1 :=
      detUnits_eq_one_of_mem_elementaryGroup
        (glStab_elementaryGroup_le h (Subgroup.mem_map_of_mem _ hE))
    have hFq : detUnits (glStab k p q h F) = 1 :=
      detUnits_eq_one_of_mem_elementaryGroup
        (glStab_elementaryGroup_le h (Subgroup.mem_map_of_mem _ hF))
    rw [huv, map_mul, map_mul, map_mul, map_mul, map_mul, map_mul, hEq, hFq,
      detUnits_eq_one_of_mem_elementaryGroup hE,
      detUnits_eq_one_of_mem_elementaryGroup hF, glStab_diagAt, detUnits_diagAt,
      detUnits_diagAt]

end Stab

/-! ### The stable determinant and `K₁(k) ≅ k^×` -/

section Colimit

variable (k : Type*) [Field k]

/-- **The determinant on the stable general linear group.** -/
def detColim : ClassicalGLColim k →* kˣ :=
  MonoidHom.mk'
    (DirectLimit.lift (glStab k) (fun _ u ↦ detUnits u)
      (fun _ _ h u ↦ (detUnits_glStab h u).symm))
    (by
      intro x y
      obtain ⟨m, u, v, rfl, rfl⟩ := DirectLimit.exists_eq_mk₂ (f := glStab k) x y
      have hu : (⟦⟨m, u⟩⟧ : ClassicalGLColim k) = glColimOf k m u := rfl
      have hv : (⟦⟨m, v⟩⟧ : ClassicalGLColim k) = glColimOf k m v := rfl
      rw [hu, hv, ← map_mul (glColimOf k m)]
      exact map_mul detUnits u v)

@[simp] theorem detColim_glColimOf (n : ℕ) (u : (Matrix (Fin n) (Fin n) k)ˣ) :
    detColim k (glColimOf k n u) = detUnits u := rfl

theorem detColim_surjective : Function.Surjective (detColim k) := by
  intro x
  exact ⟨glColimOf k 1 (diagAt (0 : Fin 1) x), detUnits_diagAt _ x⟩

/-- **The kernel of the stable determinant is `E_∞(k)`.** -/
theorem ker_detColim : (detColim k).ker = elementaryColim k := by
  apply le_antisymm
  · intro z hz
    induction z using DirectLimit.induction with
    | ih n u =>
        have hzu : (⟦⟨n, u⟩⟧ : ClassicalGLColim k) = glColimOf k n u := rfl
        have hu : detUnits u = 1 := by
          have := MonoidHom.mem_ker.mp hz
          rwa [hzu, detColim_glColimOf] at this
        rcases Nat.eq_zero_or_pos n with rfl | hn
        · have hu1 : u = 1 := Units.ext (by ext i; exact i.elim0)
          rw [hzu, hu1, map_one]
          exact one_mem _
        · haveI : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
          rw [hzu]
          exact glColimOf_mem_elementaryColim k
            (mem_elementaryGroup_of_detUnits_eq_one hu)
  · show (⨆ n : ℕ, (elementaryGroup (Fin n) k).map (glColimOf k n)) ≤ _
    refine iSup_le fun n ↦ ?_
    rw [Subgroup.map_le_iff_le_comap]
    intro u hu
    simp only [Subgroup.mem_comap, MonoidHom.mem_ker, detColim_glColimOf]
    exact detUnits_eq_one_of_mem_elementaryGroup hu

/-- **`K₁(k) ≅ k^×` for every field**, by the determinant. -/
def fieldKOneEquiv : AlgebraicKOne k ≃* kˣ :=
  (QuotientGroup.quotientMulEquivOfEq (ker_detColim k).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (detColim k) (detColim_surjective k))

@[simp] theorem fieldKOneEquiv_mk (z : ClassicalGLColim k) :
    fieldKOneEquiv k (QuotientGroup.mk z) = detColim k z := rfl

/-- **The determinant identification carries the printed `κ` to the identity**:
`κ : k^× → K_1(k)` is inverse to it. -/
theorem fieldKOneEquiv_kappa (u : kˣ) : fieldKOneEquiv k (kappa k u) = u := by
  have h1 : fieldKOneEquiv k (kappa k u) = detUnits (unitsToGLOne k u) := rfl
  rw [h1]
  apply Units.ext
  show Matrix.det (Matrix.scalar (Fin 1) (u : k)) = (u : k)
  rw [Matrix.scalar_apply, Matrix.det_diagonal]
  simp

/-- `K₁(k)` is isomorphic to `k^×`, as a closed statement. -/
theorem field_algebraicKOne : Nonempty (AlgebraicKOne k ≃* kˣ) :=
  ⟨fieldKOneEquiv k⟩

end Colimit

/-! ### `K₁` of a ring homomorphism, and the degree of the scalar inclusion -/

section Functor

/-- **The map of `K₁` induced by a ring homomorphism.**  `AlgebraicKOneFunctor`
descends only isomorphisms; this descends any coefficient map, which is what the
scalar inclusion `k → M_d(k)` needs. -/
def algebraicKOneMap {R S : Type*} [Ring R] [Ring S] (f : R →+* S) :
    AlgebraicKOne R →* AlgebraicKOne S :=
  QuotientGroup.map (elementaryColim R) (elementaryColim S) (glColimMap f)
    (Subgroup.map_le_iff_le_comap.mp (elementaryColim_map_le f))

@[simp] theorem algebraicKOneMap_mk {R S : Type*} [Ring R] [Ring S] (f : R →+* S)
    (z : ClassicalGLColim R) :
    algebraicKOneMap f (QuotientGroup.mk z) = QuotientGroup.mk (glColimMap f z) := rfl

variable {k : Type*} [Field k]

/-- The block flattening of an entrywise scalar matrix is a Kronecker product
with the identity. -/
theorem blockFlatten_map_scalar {m d : ℕ} (A : Matrix (Fin m) (Fin m) k) :
    blockFlatten d (A.map (Matrix.scalar (Fin d) : k →+* Matrix (Fin d) (Fin d) k))
      = Matrix.reindex finProdFinEquiv finProdFinEquiv
          (Matrix.kroneckerMap (· * ·) A (1 : Matrix (Fin d) (Fin d) k)) := by
  ext x y
  obtain ⟨⟨i, a⟩, rfl⟩ := finProdFinEquiv.surjective x
  obtain ⟨⟨j, b⟩, rfl⟩ := finProdFinEquiv.surjective y
  rw [blockFlatten_apply, Matrix.reindex_apply, Matrix.submatrix_apply,
    Equiv.symm_apply_apply, Equiv.symm_apply_apply]
  show (Matrix.scalar (Fin d) (A i j)) a b = A i j * (1 : Matrix (Fin d) (Fin d) k) a b
  rw [Matrix.scalar_apply, Matrix.one_apply]
  by_cases hab : a = b
  · rw [hab, Matrix.diagonal_apply_eq, if_pos rfl, mul_one]
  · rw [Matrix.diagonal_apply_ne _ hab, if_neg hab, mul_zero]

/-- **The determinant of the scalar inclusion is a `d`-th power.** -/
theorem detUnits_blockFlat_map_scalar {m d : ℕ}
    (A : (Matrix (Fin m) (Fin m) k)ˣ) :
    detUnits (blockFlatUnitEquiv k d m
        (elementaryMatrixUnitMap (Matrix.scalar (Fin d) :
          k →+* Matrix (Fin d) (Fin d) k) A))
      = (detUnits A) ^ d := by
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, detUnits_val, detUnits_val, blockFlatUnitEquiv_val]
  show Matrix.det (blockFlatten d
      ((A : Matrix (Fin m) (Fin m) k).map
        (Matrix.scalar (Fin d) : k →+* Matrix (Fin d) (Fin d) k)))
    = Matrix.det (A : Matrix (Fin m) (Fin m) k) ^ d
  rw [blockFlatten_map_scalar, Matrix.det_reindex_self, Matrix.det_kronecker,
    Matrix.det_one, one_pow, mul_one, Fintype.card_fin]

/-- **The scalar inclusion has degree `d` on `K₁`.**

`Matrix.scalar (Fin d) : k → M_d(k)` induces a map `K_1(k) → K_1(M_d(k))`;
composed with Morita invariance `K_1(M_d(k)) ≅ K_1(k)` and read through the
determinant on both sides, it is `x ↦ x^d`.  This is the transition map of the
colimit computing `K_1(L_k(1,d))`. -/
theorem fieldKOneEquiv_scalarMap (d : ℕ) (hd : 1 ≤ d) (x : AlgebraicKOne k) :
    fieldKOneEquiv k (moritaKOneEquiv k d hd
        (algebraicKOneMap (Matrix.scalar (Fin d) :
          k →+* Matrix (Fin d) (Fin d) k) x))
      = (fieldKOneEquiv k x) ^ d := by
  obtain ⟨z, rfl⟩ := QuotientGroup.mk_surjective x
  induction z using DirectLimit.induction with
  | ih m u =>
      have hz : (⟦⟨m, u⟩⟧ : ClassicalGLColim k) = glColimOf k m u := rfl
      rw [hz]
      have hmap : algebraicKOneMap
            (Matrix.scalar (Fin d) : k →+* Matrix (Fin d) (Fin d) k)
            (QuotientGroup.mk (glColimOf k m u))
          = QuotientGroup.mk (glColimOf (Matrix (Fin d) (Fin d) k) m
              (elementaryMatrixUnitMap (Matrix.scalar (Fin d) :
                k →+* Matrix (Fin d) (Fin d) k) u)) := rfl
      have hmor : moritaKOneEquiv k d hd
            (QuotientGroup.mk (glColimOf (Matrix (Fin d) (Fin d) k) m
              (elementaryMatrixUnitMap (Matrix.scalar (Fin d) :
                k →+* Matrix (Fin d) (Fin d) k) u)))
          = QuotientGroup.mk (glColimOf k (m * d)
              (blockFlatUnitEquiv k d m
                (elementaryMatrixUnitMap (Matrix.scalar (Fin d) :
                  k →+* Matrix (Fin d) (Fin d) k) u))) := rfl
      rw [hmap, hmor, fieldKOneEquiv_mk, fieldKOneEquiv_mk, detColim_glColimOf,
        detColim_glColimOf, detUnits_blockFlat_map_scalar]

end Functor

end

