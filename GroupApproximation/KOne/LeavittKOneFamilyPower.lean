import GroupApproximation.Leavitt.MatrixSelfSimilarity
import Mathlib.Tactic.NoncommRing
import GroupApproximation.Meta.AxiomGuard

/-!
# Complete matrix families at every rank `dⁿ`

A ring carrying a complete matrix family on `Fin d` — for the manuscript,
`R = L_k(1,d)` with `AryLeavitt.family` — carries one on `Fin (dⁿ)` for every
`n`.  This module builds them.

## Why the tree needs this

`AryLeavitt.family` is the **only** producer of a `CompleteMatrixFamily` over
`AryLeavittAlgebra k d`, and it lives at rank `d` alone.  Every consumer that
has to descend from an *unspecified* rank is therefore stuck.  The one that
matters is

`CompleteMatrixFamily.mem_stableUnits_of_cornerDiag_mem` (`Leavitt/FamilyDescent.lean`):
if `cornerDiagUnit i₀ u` is elementary at a rank identified with the base ring,
then `u ∈ stableUnits A`.  A class of `K₁(R)` is trivial exactly when its
representative is elementary at *some* rank `n`, and `n` is not under the
consumer's control; without a family at a rank `≥ n` the descent cannot start.

Ranks `dⁿ` are the right supply: `dⁿ ≡ 1 mod (d-1)`, which is the arithmetic
condition for `R ≅ M_n(R)` over `L_k(1,d)` (where `K₀ = ℤ/(d-1)` is generated by
`[1]`), and they are cofinal in `ℕ`, which is all a rank-unbounded consumer
needs.  A family at a rank `n ≢ 1 mod (d-1)` does not exist, so cofinality — not
"every rank" — is the correct target.

## The construction

Three pieces, all for an arbitrary ring:

* `reindex` — transport along an equivalence of index types;
* `one` — the trivial family on `Fin 1`, `left = right = 1`;
* `prod` — the composite of a family on `ι` with one on `κ`, on `ι × κ`, with
  `left (i,a) = F.left i * G.left a` and `right (i,a) = G.right a * F.right i`.
  Orthogonality splits on whether the outer indices agree, and completeness is
  `∑ᵢ F.left i * (∑ₐ G.left a * G.right a) * F.right i`.

`pow F n` is then `n`-fold `prod` with `F`, reindexed to `Fin (dⁿ)` along
`finProdFinEquiv`.

## What is *not* claimed

Nothing here says the ranks `dⁿ` exhaust the ranks at which a family exists,
and nothing here is about `L_k(1,d)` in particular: `prod` and `pow` are
statements about an arbitrary ring carrying a family.
-/

namespace GroupApproximation
namespace CompleteMatrixFamily

variable {A : Type*} [Ring A]

/-! ### Reindexing -/

section Reindex

variable {ι ι' : Type*} [Fintype ι] [DecidableEq ι] [Fintype ι'] [DecidableEq ι']

/-- A complete matrix family transported along an equivalence of index types. -/
def reindex (F : CompleteMatrixFamily A ι) (e : ι' ≃ ι) :
    CompleteMatrixFamily A ι' where
  left i := F.left (e i)
  right i := F.right (e i)
  orthogonal i j := by
    rw [F.orthogonal (e i) (e j)]
    rcases eq_or_ne i j with rfl | h
    · rw [if_pos rfl, if_pos rfl]
    · rw [if_neg h, if_neg (fun hh ↦ h (e.injective hh))]
  complete := by
    rw [← F.complete]
    exact Fintype.sum_equiv e _ _ (fun _ ↦ rfl)

@[simp] theorem reindex_left (F : CompleteMatrixFamily A ι) (e : ι' ≃ ι)
    (i : ι') : (F.reindex e).left i = F.left (e i) := rfl

@[simp] theorem reindex_right (F : CompleteMatrixFamily A ι) (e : ι' ≃ ι)
    (i : ι') : (F.reindex e).right i = F.right (e i) := rfl

end Reindex

/-! ### The trivial family -/

/-- The one-slot complete matrix family: `left = right = 1`. -/
def one : CompleteMatrixFamily A (Fin 1) where
  left _ := 1
  right _ := 1
  orthogonal i j := by
    rw [if_pos (Subsingleton.elim i j), one_mul]
  complete := by simp

/-! ### Composing two families -/

section Prod

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- **The composite of two complete matrix families.**  Refining every slot of
`F` by the whole of `G` gives a family indexed by `ι × κ`. -/
def prod (F : CompleteMatrixFamily A ι) (G : CompleteMatrixFamily A κ) :
    CompleteMatrixFamily A (ι × κ) where
  left p := F.left p.1 * G.left p.2
  right p := G.right p.2 * F.right p.1
  orthogonal p q := by
    obtain ⟨i, a⟩ := p
    obtain ⟨j, b⟩ := q
    show G.right a * F.right i * (F.left j * G.left b) = _
    rcases eq_or_ne i j with rfl | hij
    · have hassoc : G.right a * F.right i * (F.left i * G.left b)
          = G.right a * (F.right i * F.left i) * G.left b := by noncomm_ring
      rw [hassoc, F.orthogonal i i, if_pos rfl, mul_one, G.orthogonal a b]
      rcases eq_or_ne a b with rfl | hab
      · rw [if_pos rfl, if_pos rfl]
      · rw [if_neg hab, if_neg (fun h ↦ hab (congrArg Prod.snd h))]
    · have hassoc : G.right a * F.right i * (F.left j * G.left b)
          = G.right a * (F.right i * F.left j) * G.left b := by noncomm_ring
      rw [hassoc, F.orthogonal i j, if_neg hij, mul_zero, zero_mul,
        if_neg (fun h ↦ hij (congrArg Prod.fst h))]
  complete := by
    rw [Fintype.sum_prod_type]
    have hinner : ∀ i : ι,
        (∑ a : κ, F.left i * G.left a * (G.right a * F.right i))
          = F.left i * F.right i := by
      intro i
      have hstep : ∀ a : κ, F.left i * G.left a * (G.right a * F.right i)
          = F.left i * (G.left a * G.right a) * F.right i := by
        intro a
        noncomm_ring
      rw [Finset.sum_congr rfl (fun a _ ↦ hstep a), ← Finset.sum_mul,
        ← Finset.mul_sum, G.complete, mul_one]
    rw [Finset.sum_congr rfl (fun i _ ↦ hinner i), F.complete]

@[simp] theorem prod_left (F : CompleteMatrixFamily A ι)
    (G : CompleteMatrixFamily A κ) (p : ι × κ) :
    (F.prod G).left p = F.left p.1 * G.left p.2 := rfl

@[simp] theorem prod_right (F : CompleteMatrixFamily A ι)
    (G : CompleteMatrixFamily A κ) (p : ι × κ) :
    (F.prod G).right p = G.right p.2 * F.right p.1 := rfl

end Prod

/-! ### Families at every rank `dⁿ` -/

/-- **The `n`-fold composite of a family on `Fin d`, at rank `dⁿ`.** -/
def pow {d : ℕ} (F : CompleteMatrixFamily A (Fin d)) :
    ∀ n : ℕ, CompleteMatrixFamily A (Fin (d ^ n))
  | 0 => reindex one (finCongr (pow_zero d))
  | (n + 1) =>
      reindex ((pow F n).prod F)
        ((finCongr (pow_succ d n)).trans finProdFinEquiv.symm)

/-- **Ranks `dⁿ` are cofinal**: for `d ≥ 2` and any `n` there is an `m` with
`n ≤ dᵐ`, so a rank-unbounded consumer can always find a family above it. -/
theorem exists_pow_ge {d : ℕ} (hd : 2 ≤ d) (n : ℕ) : ∃ m : ℕ, n ≤ d ^ m :=
  ⟨n, le_trans (Nat.le_of_lt n.lt_two_pow_self) (Nat.pow_le_pow_left hd n)⟩

end CompleteMatrixFamily
end GroupApproximation

/-! ### Axiom audit -/

#audit_axioms GroupApproximation.CompleteMatrixFamily.reindex
#audit_axioms GroupApproximation.CompleteMatrixFamily.one
#audit_axioms GroupApproximation.CompleteMatrixFamily.prod
#audit_axioms GroupApproximation.CompleteMatrixFamily.pow
#audit_axioms GroupApproximation.CompleteMatrixFamily.exists_pow_ge
