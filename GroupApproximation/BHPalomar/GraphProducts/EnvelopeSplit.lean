import GroupApproximation.BHPalomar.GraphProducts.Main
import Mathlib.GroupTheory.Subgroup.Simple

/-!
# `EnvelopeInput` as the two literature statements it needs

`EnvelopeInput` (in `GroupApproximation.BHPalomar.GraphProducts.Reduction`) is the one hypothesis
of `question31_of_envelopeInput`. It is used exactly once, at a group `Γ` with an action of type (A)
that contains `K × X`. Only the rank `n = 2` is used, and only through the subgroup of
`Aut_H(H ∗ F₂)` generated by the transvections `ρ_a` and the twisted conjugations `γ_h`.

This file splits `EnvelopeInput` into the two statements of BFFHZ (arXiv:2503.21882v2) that give it,
each cut down to what is used:

* `EnvelopeEmbedding`: Theorem C, (i) ⇒ (iv). A group with an action of type (A) embeds in a
  finitely presented simple group that is mixed-identity-free. Only rank 2 of MIF is required
  (`IsMIF2`); BFFHZ's MIF quantifies over all ranks and implies it.
* `TheoremE2`: Theorem E at `n = 2`. If `H` is finitely presented, simple and MIF in rank 2, then
  `Aut_H(H ∗ F₂)` admits an action of type (A). BFFHZ use MIF only for faithfulness
  (their Lemma "faithful"), and at `n = 2` that proof uses only rank-2 mixed identities.

`envelopeInput_of_embedding_theoremE2` combines them, and `question31_of_embedding_theoremE2`
answers Question 3.1 from these two statements alone.
-/

namespace GroupApproximation.BHPalomar.GraphProducts

open Monoid

/-- `H` has no mixed identities in two variables: every nontrivial `w ∈ H ∗ F₂` survives some
`H`-homomorphism `H ∗ F₂ → H` (one that is the identity on `H`). -/
def IsMIF2 (H : Type) [Group H] : Prop :=
  ∀ w : Coprod H (FreeGroup (Fin 2)), w ≠ 1 →
    ∃ φ : Coprod H (FreeGroup (Fin 2)) →* H, (∀ h : H, φ (Coprod.inl h) = h) ∧ φ w ≠ 1

/-- **BFFHZ Theorem C, (i) ⇒ (iv)**, as used: a group with an action of type (A) embeds in a
finitely presented simple group without mixed identities in two variables. -/
def EnvelopeEmbedding : Prop :=
  ∀ (Γ S : Type) [Group Γ] [MulAction Γ S], IsTypeA Γ S →
    ∃ (H : Type) (_ : Group H) (e : Γ →* H), Function.Injective e ∧
      Group.IsFinitelyPresented H ∧ IsSimpleGroup H ∧ IsMIF2 H

/-- **BFFHZ Theorem E at `n = 2`**: for `H` finitely presented, simple and MIF in rank 2,
`Aut_H(H ∗ F₂)` admits an action of type (A). -/
def TheoremE2 : Prop :=
  ∀ (H : Type) [Group H], Group.IsFinitelyPresented H → IsSimpleGroup H → IsMIF2 H →
    ∃ (S : Type) (_ : MulAction (relAut H 2) S), IsTypeA (relAut H 2) S

/-- The two literature statements give `EnvelopeInput`. -/
theorem envelopeInput_of_embedding_theoremE2 (hC : EnvelopeEmbedding) (hE : TheoremE2) :
    EnvelopeInput := by
  intro Γ S _ _ hA
  obtain ⟨H, _, e, he, hfp, hs, hm⟩ := hC Γ S hA
  obtain ⟨T, _, hT⟩ := hE H hfp hs hm
  exact ⟨H, inferInstance, e, he, SatisfiesPBH.of_isTypeA hT⟩

/-- **BFFHZ Question 3.1, positive answer**, from BFFHZ Theorem C (i) ⇒ (iv) and Theorem E
(`n = 2`) alone. -/
theorem question31_of_embedding_theoremE2 (hC : EnvelopeEmbedding) (hE : TheoremE2) :
    Question31 :=
  question31_of_envelopeInput (envelopeInput_of_embedding_theoremE2 hC hE)

end GroupApproximation.BHPalomar.GraphProducts
