import GroupApproximation.BHPalomar.GraphProducts.Reduction
import Mathlib.Data.Finite.Prod
import Mathlib.Data.Fintype.EquivFin
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Data.Set.Finite.Range
import Mathlib.GroupTheory.NoncommCoprod
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.Tactic.Group

/-!
# PBH is closed under direct products (`ProductInput`)

This is Zaremsky, arXiv:2405.18354, Proposition 5.5, proved here from Mathlib. If `Γ₁ ↷ S₁` and
`Γ₂ ↷ S₂` are of type (A), then so is `Γ₁ × Γ₂ ↷ S₁ ⊕ S₂` (`isTypeA_sum`):

* `Γ₁ × Γ₂` is finitely presented (`isFinitelyPresented_prod`): it is `Γ₁ ∗ Γ₂` modulo the
  finitely many commutators of generators;
* the stabilizer of a point of `S₁` is `Stab(s) × Γ₂`;
* orbits of pairs come from orbits of pairs in each `Sᵢ` and orbits of points.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

attribute [local instance] Classical.propDecidable

namespace GroupApproximation.BHPalomar.GraphProducts

open Monoid

/-- A finitely presented group is finitely generated by a finite set. -/
theorem exists_finite_generating_of_fp (A : Type) [Group A] [h : Group.IsFinitelyPresented A] :
    ∃ S : Set A, Subgroup.closure S = ⊤ ∧ S.Finite := by
  obtain ⟨n, φ, hφ, _⟩ := h.out
  have hfg : Group.FG A :=
    Group.fg_iff_exists_freeGroup_hom_surjective_finite.mpr ⟨Fin n, inferInstance, φ, hφ⟩
  exact Group.fg_iff.mp hfg

theorem fg_top_of_fp (A : Type) [Group A] [Group.IsFinitelyPresented A] :
    (⊤ : Subgroup A).FG := by
  obtain ⟨S, hS, hSf⟩ := exists_finite_generating_of_fp A
  exact ⟨hSf.toFinset, by rw [Set.Finite.coe_toFinset, hS]⟩

/-- **Direct products of finitely presented groups are finitely presented.** -/
theorem isFinitelyPresented_prod (A B : Type) [Group A] [Group B] [Group.IsFinitelyPresented A]
    [Group.IsFinitelyPresented B] : Group.IsFinitelyPresented (A × B) := by
  obtain ⟨SA, hSA, hSAf⟩ := exists_finite_generating_of_fp A
  obtain ⟨SB, hSB, hSBf⟩ := exists_finite_generating_of_fp B
  let R : Set (Coprod A B) := Set.image2 (fun a b => Coprod.inl a * Coprod.inr b *
    (Coprod.inl a)⁻¹ * (Coprod.inr b)⁻¹) SA SB
  have hRf : R.Finite := hSAf.image2 _ hSBf
  refine Group.IsFinitelyPresented.of_surjective (Coprod.toProd : Coprod A B →* A × B)
    Coprod.toProd_surjective ⟨R, hRf, le_antisymm ?_ ?_⟩
  · refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨a, _, b, _, rfl⟩
    rw [SetLike.mem_coe, MonoidHom.mem_ker]
    ext <;> simp [Coprod.toProd_apply_inl, Coprod.toProd_apply_inr]
  · intro w hw
    let mA : A →* Coprod A B ⧸ Subgroup.normalClosure R := (QuotientGroup.mk' (Subgroup.normalClosure R)).comp Coprod.inl
    let mB : B →* Coprod A B ⧸ Subgroup.normalClosure R := (QuotientGroup.mk' (Subgroup.normalClosure R)).comp Coprod.inr
    have gen : ∀ a ∈ SA, ∀ b ∈ SB, mA a * mB b = mB b * mA a := by
      intro a ha b hb
      have h0 : QuotientGroup.mk' (Subgroup.normalClosure R) (Coprod.inl a * Coprod.inr b * (Coprod.inl a)⁻¹ *
          (Coprod.inr b)⁻¹) = 1 := by
        rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
        exact Subgroup.subset_normalClosure ⟨a, ha, b, hb, rfl⟩
      have h1 : mA a * mB b * (mA a)⁻¹ * (mB b)⁻¹ = 1 := by
        rw [map_mul, map_mul, map_mul, map_inv, map_inv] at h0
        exact h0
      calc mA a * mB b = (mA a * mB b * (mA a)⁻¹ * (mB b)⁻¹) * (mB b * mA a) := by group
        _ = mB b * mA a := by rw [h1, one_mul]
    have genB : ∀ a ∈ SA, ∀ b : B, mA a * mB b = mB b * mA a := by
      intro a ha b
      have hle : Subgroup.closure SB ≤ (Subgroup.centralizer {mA a}).comap mB := by
        rw [Subgroup.closure_le]
        intro b' hb'
        rw [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.mem_centralizer_iff]
        rintro _ rfl
        exact gen a ha b' hb'
      have hb : b ∈ (Subgroup.centralizer {mA a}).comap mB := hle (by rw [hSB]; exact Subgroup.mem_top b)
      rw [Subgroup.mem_comap, Subgroup.mem_centralizer_iff] at hb
      exact hb _ rfl
    have comm : ∀ (a : A) (b : B), Commute (mA a) (mB b) := by
      intro a b
      have hle : Subgroup.closure SA ≤ (Subgroup.centralizer {mB b}).comap mA := by
        rw [Subgroup.closure_le]
        intro a' ha'
        rw [SetLike.mem_coe, Subgroup.mem_comap, Subgroup.mem_centralizer_iff]
        rintro _ rfl
        exact (genB a' ha' b).symm
      have ha : a ∈ (Subgroup.centralizer {mB b}).comap mA := hle (by rw [hSA]; exact Subgroup.mem_top a)
      rw [Subgroup.mem_comap, Subgroup.mem_centralizer_iff] at ha
      exact (ha _ rfl).symm
    let S : A × B →* Coprod A B ⧸ Subgroup.normalClosure R := MonoidHom.noncommCoprod mA mB comm
    have hS : S.comp Coprod.toProd = QuotientGroup.mk' (Subgroup.normalClosure R) := by
      apply Coprod.hom_ext
      · ext a
        simp [S, mA, mB, Coprod.toProd_apply_inl]
      · ext b
        simp [S, mA, mB, Coprod.toProd_apply_inr]
    have hw' : QuotientGroup.mk' (Subgroup.normalClosure R) w = 1 := by
      rw [← hS, MonoidHom.comp_apply, MonoidHom.mem_ker.mp hw, map_one]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hw'
    exact hw'

/-! ### The disjoint union action -/

section SumAction

variable (Γ₁ Γ₂ S₁ S₂ : Type) [Group Γ₁] [Group Γ₂] [MulAction Γ₁ S₁] [MulAction Γ₂ S₂]

/-- `Γ₁ × Γ₂` acting on `S₁ ⊕ S₂`, each factor on its own summand. -/
def sumProdAction : MulAction (Γ₁ × Γ₂) (S₁ ⊕ S₂) where
  smul g x := Sum.map (fun s => g.1 • s) (fun t => g.2 • t) x
  one_smul x := by
    cases x with
    | inl s => exact congrArg Sum.inl (one_smul Γ₁ s)
    | inr t => exact congrArg Sum.inr (one_smul Γ₂ t)
  mul_smul g h x := by
    cases x with
    | inl s => exact congrArg Sum.inl (mul_smul g.1 h.1 s)
    | inr t => exact congrArg Sum.inr (mul_smul g.2 h.2 t)

attribute [local instance] sumProdAction

variable {Γ₁ Γ₂ S₁ S₂}

theorem sum_smul_inl (g : Γ₁ × Γ₂) (s : S₁) : g • (Sum.inl s : S₁ ⊕ S₂) = Sum.inl (g.1 • s) := rfl

theorem sum_smul_inr (g : Γ₁ × Γ₂) (t : S₂) : g • (Sum.inr t : S₁ ⊕ S₂) = Sum.inr (g.2 • t) := rfl

end SumAction

/-- Finitely many orbits, in representative form. -/
theorem finite_orbits_iff {M X : Type} [Group M] [MulAction M X] :
    Finite (MulAction.orbitRel.Quotient M X) ↔
      ∃ F : Set X, F.Finite ∧ ∀ x, ∃ f ∈ F, ∃ g : M, g • f = x := by
  constructor
  · intro hfin
    refine ⟨Set.range (fun q : MulAction.orbitRel.Quotient M X => Quotient.out q),
      Set.finite_range _, fun x => ⟨Quotient.out (Quotient.mk (MulAction.orbitRel M X) x),
        Set.mem_range_self _, ?_⟩⟩
    have h : x ∈ MulAction.orbit M (Quotient.out (Quotient.mk (MulAction.orbitRel M X) x)) :=
      Quotient.exact (Quotient.out_eq (Quotient.mk (MulAction.orbitRel M X) x)).symm
    exact MulAction.mem_orbit_iff.mp h
  · rintro ⟨F, hF, hrep⟩
    haveI : Finite F := hF.to_subtype
    refine Finite.of_surjective
      (fun f : F => (Quotient.mk (MulAction.orbitRel M X) f.1 : MulAction.orbitRel.Quotient M X))
      fun q => ?_
    induction q using Quotient.inductionOn with
    | h x =>
      obtain ⟨f, hf, g, rfl⟩ := hrep x
      exact ⟨⟨f, hf⟩, Quotient.sound ⟨g⁻¹, inv_smul_smul g f⟩⟩

end GroupApproximation.BHPalomar.GraphProducts
