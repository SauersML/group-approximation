import GroupApproximation.BirmanGenusThree.Section3Dichotomy

/-!
# Chen–Salter, Lemma 3.6: Case B forces `s = 1`

Chen–Salter (arXiv:1804.11235v1, §3.3) show that if `s` kills every power of a simple element lying
in `H̄`, then `s` is trivial. The proof combines three inputs about a family of Dehn twist powers
`τ_i = T_{d_i}^{k_i}` acting on `π₁(Σ_2)`:
- Lemma 3.8: `τ_i(x) x⁻¹` is a product of powers of simple elements lying in `H̄`;
- Lemma 3.7: `s(τ_i(x))` and `τ_i(s(x))` are conjugate;
- Lemma 2.8 and filling: an element whose conjugacy class is fixed by every `τ_i` is trivial.

Chen–Salter take the `d_i` separating, so their eq. (15) applies Corollary 3.4(B) to elements
conjugate to separating curves, while their Lemma 3.2 derives the power formula through bounding
pairs only. The B3 review (research/artifacts/fz-birman-genus3-review-2026-09-13.md §3) closes this
gap with Lemma C, which gives the formula for separating curves in genus 3.

`lemma_3_6` derives `s = 1` from these three inputs as hypotheses on `τ`, for any simple system `S`
whose powers the family `τ` produces.
-/

namespace GroupApproximation.BirmanGenusThree.Section3

variable {G : Type*} [Group G] {S : Set G} {H : Subgroup G} {f : H →* G}

/-- The subgroup of `H` generated by the powers of simple elements that lie in `H`. -/
def simplePowers (S : Set G) (H : Subgroup G) : Subgroup H :=
  Subgroup.closure {x : H | ∃ α ∈ S, ∃ k : ℤ, (x : G) = α ^ k}

/-- In Case B, `f` kills the subgroup generated by powers of simple elements. -/
theorem simplePowers_le_ker (hB : ∀ α ∈ S, ∀ (k : ℤ) (hk : α ^ k ∈ H), f ⟨α ^ k, hk⟩ = 1) :
    simplePowers S H ≤ f.ker := by
  rw [simplePowers, Subgroup.closure_le]
  rintro ⟨x, hx⟩ ⟨α, hαS, k, rfl⟩
  exact MonoidHom.mem_ker.2 (hB α hαS k hx)

/-- **Chen–Salter, Lemma 3.6.** In Case B, `f` is trivial, given Lemmas 3.7, 3.8 and 2.8 for a
family `τ` of automorphisms preserving `H`. -/
theorem lemma_3_6 {ι : Type*} (τ : ι → MulAut G) (hτH : ∀ i, ∀ x ∈ H, τ i x ∈ H)
    (h38 : ∀ i (x : H), (⟨τ i x, hτH i x x.2⟩ : H) * x⁻¹ ∈ simplePowers S H)
    (h37 : ∀ i (x : H), IsConj (f ⟨τ i x, hτH i x x.2⟩) (τ i (f x)))
    (h28 : ∀ y : G, (∀ i, IsConj (τ i y) y) → y = 1)
    (hB : ∀ α ∈ S, ∀ (k : ℤ) (hk : α ^ k ∈ H), f ⟨α ^ k, hk⟩ = 1) (x : H) : f x = 1 := by
  refine h28 (f x) fun i => ?_
  have hker := simplePowers_le_ker hB (h38 i x)
  rw [MonoidHom.mem_ker, map_mul, map_inv, mul_inv_eq_one] at hker
  have h := h37 i x
  rw [hker] at h
  exact h.symm

end GroupApproximation.BirmanGenusThree.Section3
