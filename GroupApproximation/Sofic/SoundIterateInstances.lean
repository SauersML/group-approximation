import GroupApproximation.Sofic.MFRelationClosure
import GroupApproximation.Sofic.FiniteNormalCoronaObstruction
import GroupApproximation.Sofic.NormalKazhdanMFRadical
import GroupApproximation.Sofic.CollapseUniverseScope
import Mathlib.GroupTheory.SpecificGroups.Alternating
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# The rules the sound iteration consumes, and staged applicability

`Sofic.MFRelationClosure` builds the closure calculus `IsSoundIterate`, but
nothing there exhibits a *rule*.  The manuscript's paragraph after
`prop:sounditeration` does exactly that:

> Theorems `thm:criterion`, `thm:normal-kazhdan`, and `thm:collapse` supply the
> memberships this iteration consumes: each places a subgroup inside the
> radical of every countable group with its data, hence inside the radical of
> every reached quotient.  Theorem `thm:saturation` is the case
> `D_coll(L,s) = H`.  Such a membership can hold at a later stage without
> holding at an earlier one: modulo the earlier stage an element may acquire
> finite order, an orbit may begin to commute, or a subgroup may become
> normal.

Both halves of that paragraph are formalized here.

The first half is mechanical once the right lemma is isolated.  A radical
membership `M ≤ Res_MF(G)` is already a sound iterate: apply the closure step
over the trivial stage, whose MF closure is the whole radical.  That is
`isSoundIterate_of_le_actualCoronaMFResidual`, and each named theorem becomes
an `IsSoundIterate` instance through it.  The clause "hence inside the radical
of every reached quotient" is `isSoundIterate_comap_of_le_residual_quotient`:
a rule applied *inside* `G ⧸ N`, for a reached normal stage `N`, pulls back to
a sound iterate of `G` — which is the closure step read forwards.

The second half is illustrative in the manuscript and is formalized as three
explicit examples, one per named mechanism.  Each exhibits a group, a normal
subgroup playing the earlier stage, and the failure/success pair:

* `order_acquired_at_later_stage` — in `ℤ` written multiplicatively, modulo the
  even integers the generator becomes an involution although it has infinite
  order;
* `commutation_acquired_at_later_stage` — in the symmetric group on three
  points, two transpositions do not commute but their images modulo the
  alternating group do;
* `normality_acquired_at_later_stage` — in the same group, the subgroup
  generated by a transposition is not normal but its image is.

These are examples, not part of any endpoint: no manuscript theorem depends on
them.  They exist because the printed sentence asserts that the three
mechanisms are possible, and an assertion of possibility is discharged by an
instance.
-/

namespace GroupApproximation
namespace SoundIterateInstances

universe u

/-! ## Every radical membership is a sound iterate -/

/-- **A subgroup of the MF radical is reached in one step.**  The trivial
subgroup is a sound iterate, its MF closure is the whole radical
(`actualCoronaMFClosure_eq_residual_of_le`), and the closure step allows any
subgroup of that closure — normal or not.

This is the lemma that turns each of the manuscript's obstruction theorems
into a rule of the iteration: all of them conclude a radical membership. -/
theorem isSoundIterate_of_le_actualCoronaMFResidual {G : Type u} [Group G]
    {M : Subgroup G} (hM : M ≤ actualCoronaMFResidual G) : IsSoundIterate M :=
  IsSoundIterate.closure_step ⊥ M Subgroup.normal_bot IsSoundIterate.bot
    (le_of_le_of_eq hM
      (actualCoronaMFClosure_eq_residual_of_le (⊥ : Subgroup G) bot_le).symm)

/-- **"Hence inside the radical of every reached quotient."**  A rule applied
in the quotient by an already-reached normal stage returns a sound iterate of
the ambient group: its output pulls back along `G → G ⧸ N` into the MF closure
of `N`, which is precisely what the closure step consumes. -/
theorem isSoundIterate_comap_of_le_residual_quotient {G : Type u} [Group G]
    {N : Subgroup G} [hN : N.Normal] (hiter : IsSoundIterate N)
    {D : Subgroup (G ⧸ N)} (hD : D ≤ actualCoronaMFResidual (G ⧸ N)) :
    IsSoundIterate (D.comap (QuotientGroup.mk' N)) := by
  refine IsSoundIterate.closure_step N _ hN hiter ?_
  exact Subgroup.comap_mono hD

/-! ## The named theorems, as rules

Each of the three obstruction theorems places a subgroup inside the radical of
every countable group carrying its data; each therefore instantiates the rule
interface.  The universe scope of each instance is the scope of the theorem it
packages, and nothing here widens or narrows it. -/

/-- **`thm:criterion` is a sound rule.**  A finite normal subgroup of the
compression defect is a sound iterate. -/
theorem isSoundIterate_finiteNormal {Gamma E : Type} [Group Gamma] [Group E]
    [Countable E] (C : KazhdanCompressionCore Gamma E)
    (F : Subgroup E) [Finite F] [F.Normal] (hF : F ≤ C.defectNormal) :
    IsSoundIterate F := by
  refine isSoundIterate_of_le_actualCoronaMFResidual ?_
  rw [actualCoronaMFResidual_eq_coronaMFResidual]
  exact C.finiteNormal_le_coronaMFResidual F hF

/-- **`thm:normal-kazhdan` is a sound rule.**  A normal property-`(T)`
subgroup of the compression defect is a sound iterate; no finiteness,
centrality, or torsion enters. -/
theorem isSoundIterate_normalKazhdan {Gamma E : Type} [Group Gamma] [Group E]
    [Countable E] (C : KazhdanCompressionCore Gamma E)
    (K : Subgroup E) [K.Normal] (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ C.defectNormal) : IsSoundIterate K := by
  refine isSoundIterate_of_le_actualCoronaMFResidual ?_
  rw [actualCoronaMFResidual_eq_coronaMFResidual]
  exact C.normalKazhdan_le_coronaMFResidual K hT hK

/-- **`thm:collapse` is a sound rule.**  The involutive collapse defect of a
Kazhdan subgroup with a one-sided compressor is a sound iterate. -/
theorem isSoundIterate_involutiveCollapseDefect {E : Type u} [Group E]
    [Countable E] {L : Subgroup E} (hT : HasKazhdanPropertyT.{u, u} ↥L)
    {s : E} (hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L) :
    IsSoundIterate (CollapseUniverseScope.involutiveCollapseDefect L s) :=
  isSoundIterate_of_le_actualCoronaMFResidual
    (CollapseUniverseScope.involutiveCollapseDefect_le_actualCoronaMFResidual
      hT hcomp)

/-- **`thm:saturation` is the case where one application reaches the whole
group.**  When the collapse defect is everything, a single use of the collapse
rule makes `⊤` a sound iterate — and then the calculus itself returns the
radical. -/
theorem isSoundIterate_top_of_saturated {E : Type u} [Group E] [Countable E]
    {L : Subgroup E} (hT : HasKazhdanPropertyT.{u, u} ↥L)
    {s : E} (hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L)
    (hsat : CollapseUniverseScope.involutiveCollapseDefect L s = ⊤) :
    IsSoundIterate (⊤ : Subgroup E) := by
  rw [← hsat]
  exact isSoundIterate_involutiveCollapseDefect hT hcomp

/-- The saturated case, read through the calculus: the radical is everything.
This is `prop:sounditeration`'s third clause applied to `thm:saturation`. -/
theorem actualCoronaMFResidual_eq_top_of_saturated {E : Type u} [Group E]
    [Countable E] {L : Subgroup E} (hT : HasKazhdanPropertyT.{u, u} ↥L)
    {s : E} (hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L)
    (hsat : CollapseUniverseScope.involutiveCollapseDefect L s = ⊤) :
    actualCoronaMFResidual E = ⊤ :=
  IsSoundIterate.residual_eq_top
    (isSoundIterate_top_of_saturated hT hcomp hsat)

/-- The staged form of the collapse rule: applied over an already-reached
normal stage `N`, in the quotient `G ⧸ N`, it returns a sound iterate of `G`.
This is the printed clause "hence inside the radical of every reached
quotient", instantiated at the rule whose hypotheses are most easily acquired
in a quotient. -/
theorem isSoundIterate_comap_involutiveCollapseDefect {G : Type} [Group G]
    [Countable G] {N : Subgroup G} [hN : N.Normal] (hiter : IsSoundIterate N)
    {L : Subgroup (G ⧸ N)} (hT : HasKazhdanPropertyT.{0, 0} ↥L)
    {s : G ⧸ N} (hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L) :
    IsSoundIterate
      ((CollapseUniverseScope.involutiveCollapseDefect L s).comap
        (QuotientGroup.mk' N)) := by
  haveI : Countable (G ⧸ N) :=
    Function.Surjective.countable (@QuotientGroup.mk'_surjective G _ N hN)
  exact isSoundIterate_comap_of_le_residual_quotient hiter
    (CollapseUniverseScope.involutiveCollapseDefect_le_actualCoronaMFResidual
      hT hcomp)

/-! ## A rule may first apply at a later stage

Three examples, one for each mechanism the manuscript names.  In each, the
normal subgroup is the earlier stage and the displayed failure/success pair is
the hypothesis of a rule that holds only after passing to the quotient. -/

section AcquiredOrder

/-- The earlier stage of the order example: the even integers, inside `ℤ`
written multiplicatively. -/
def evenStage : Subgroup (Multiplicative ℤ) :=
  Subgroup.zpowers (Multiplicative.ofAdd (2 : ℤ))

/-- The even integers are normal because the ambient group is commutative;
stated by hand so that the example does not depend on which commutativity
instance the library happens to register. -/
instance evenStage_normal : evenStage.Normal where
  conj_mem n hn g := by
    have h : g * n * g⁻¹ = n := by
      rw [mul_comm g n]
      group
    rw [h]
    exact hn

/-- The generator of `ℤ` has infinite order. -/
theorem not_isOfFinOrder_generator :
    ¬ IsOfFinOrder (Multiplicative.ofAdd (1 : ℤ)) := by
  rw [isOfFinOrder_iff_pow_eq_one]
  rintro ⟨n, hn, hpow⟩
  rw [← ofAdd_nsmul, ofAdd_eq_one, Int.nsmul_eq_mul, mul_one] at hpow
  omega

/-- Its square lies in the earlier stage. -/
theorem sq_mem_evenStage :
    Multiplicative.ofAdd (1 : ℤ) ^ 2 ∈ evenStage := by
  have h : Multiplicative.ofAdd (1 : ℤ) ^ (2 : ℕ)
      = Multiplicative.ofAdd (2 : ℤ) := by
    rw [← ofAdd_nsmul]
    norm_num
  rw [h]
  exact Subgroup.mem_zpowers _

/-- The generator itself does not. -/
theorem generator_not_mem_evenStage :
    Multiplicative.ofAdd (1 : ℤ) ∉ evenStage := by
  intro hmem
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 hmem
  rw [← ofAdd_zsmul] at hk
  have hk' : k • (2 : ℤ) = 1 := Multiplicative.ofAdd.injective hk
  rw [Int.zsmul_eq_mul] at hk'
  omega

/-- **An element may acquire finite order modulo the earlier stage.**  The
generator of `ℤ` has infinite order, but modulo the even integers it is a
nontrivial involution — so a rule whose hypothesis is "this element squares to
one" first applies at the later stage. -/
theorem order_acquired_at_later_stage :
    ¬ IsOfFinOrder (Multiplicative.ofAdd (1 : ℤ)) ∧
      QuotientGroup.mk' evenStage (Multiplicative.ofAdd (1 : ℤ)) ≠ 1 ∧
      QuotientGroup.mk' evenStage (Multiplicative.ofAdd (1 : ℤ)) ^ 2 = 1 := by
  refine ⟨not_isOfFinOrder_generator, ?_, ?_⟩
  · intro h
    exact generator_not_mem_evenStage ((QuotientGroup.eq_one_iff _).1 h)
  · rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).2 sq_mem_evenStage

end AcquiredOrder

section AcquiredCommutationAndNormality

/-- Two transpositions of three points do not commute. -/
theorem not_commute_swaps :
    ¬ Commute (Equiv.swap (0 : Fin 3) 1) (Equiv.swap (0 : Fin 3) 2) := by
  intro h
  have hl : (Equiv.swap (0 : Fin 3) 1 * Equiv.swap (0 : Fin 3) 2) 0 = 2 := by
    simp only [Equiv.Perm.mul_apply, Equiv.swap_apply_left]
    exact Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)
  have hr : (Equiv.swap (0 : Fin 3) 2 * Equiv.swap (0 : Fin 3) 1) 0 = 1 := by
    simp only [Equiv.Perm.mul_apply, Equiv.swap_apply_left]
    exact Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)
  rw [h.eq, hr] at hl
  exact absurd hl (by decide)

/-- Their images commute modulo the alternating group, because the sign of a
commutator is trivial. -/
theorem commute_swaps_in_quotient :
    Commute
      (QuotientGroup.mk' (alternatingGroup (Fin 3)) (Equiv.swap (0 : Fin 3) 1))
      (QuotientGroup.mk' (alternatingGroup (Fin 3))
        (Equiv.swap (0 : Fin 3) 2)) := by
  rw [← commutatorElement_eq_one_iff_commute, ← map_commutatorElement]
  refine (QuotientGroup.eq_one_iff _).2 ?_
  rw [Equiv.Perm.mem_alternatingGroup, map_commutatorElement]
  exact commutatorElement_eq_one_iff_commute.2 (Commute.all _ _)

/-- **An orbit may begin to commute modulo the earlier stage.** -/
theorem commutation_acquired_at_later_stage :
    ¬ Commute (Equiv.swap (0 : Fin 3) 1) (Equiv.swap (0 : Fin 3) 2) ∧
      Commute
        (QuotientGroup.mk' (alternatingGroup (Fin 3))
          (Equiv.swap (0 : Fin 3) 1))
        (QuotientGroup.mk' (alternatingGroup (Fin 3))
          (Equiv.swap (0 : Fin 3) 2)) :=
  ⟨not_commute_swaps, commute_swaps_in_quotient⟩

/-- The subgroup generated by a transposition is not normal: conjugating by
another transposition produces a permutation that moves the point the
generated subgroup fixes. -/
theorem swapSubgroup_not_normal :
    ¬ (Subgroup.zpowers (Equiv.swap (0 : Fin 3) 1)).Normal := by
  intro h
  have hmem : Equiv.swap (0 : Fin 3) 2 * Equiv.swap (0 : Fin 3) 1 *
      (Equiv.swap (0 : Fin 3) 2)⁻¹ ∈
        Subgroup.zpowers (Equiv.swap (0 : Fin 3) 1) :=
    h.conj_mem _ (Subgroup.mem_zpowers _) _
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 hmem
  have hfix : ((Equiv.swap (0 : Fin 3) 1) ^ k) 2 = 2 :=
    Equiv.Perm.zpow_apply_eq_self_of_apply_eq_self
      (Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)) k
  rw [hk] at hfix
  have hval : (Equiv.swap (0 : Fin 3) 2 * Equiv.swap (0 : Fin 3) 1 *
      (Equiv.swap (0 : Fin 3) 2)⁻¹) 2 = 1 := by
    simp only [Equiv.swap_inv, Equiv.Perm.mul_apply, Equiv.swap_apply_right,
      Equiv.swap_apply_left]
    exact Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)
  rw [hval] at hfix
  exact absurd hfix (by decide)

/-- Its image modulo the alternating group is the whole quotient: a
permutation is either even, hence trivial there, or odd, hence congruent to
the transposition. -/
theorem swapSubgroup_map_eq_top :
    (Subgroup.zpowers (Equiv.swap (0 : Fin 3) 1)).map
        (QuotientGroup.mk' (alternatingGroup (Fin 3))) = ⊤ := by
  refine eq_top_iff.2 ?_
  intro x _
  obtain ⟨σ, rfl⟩ :=
    (@QuotientGroup.mk'_surjective (Equiv.Perm (Fin 3)) _
      (alternatingGroup (Fin 3)) _) x
  rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with hσ | hσ
  · have h1 : QuotientGroup.mk' (alternatingGroup (Fin 3)) σ = 1 :=
      (QuotientGroup.eq_one_iff _).2 (Equiv.Perm.mem_alternatingGroup.2 hσ)
    rw [h1]
    exact one_mem _
  · refine ⟨Equiv.swap (0 : Fin 3) 1, Subgroup.mem_zpowers _, ?_⟩
    have hker : σ * (Equiv.swap (0 : Fin 3) 1)⁻¹ ∈ alternatingGroup (Fin 3) := by
      rw [Equiv.Perm.mem_alternatingGroup, map_mul, map_inv,
        Equiv.Perm.sign_swap (by decide), hσ, mul_inv_cancel]
    have h2 : QuotientGroup.mk' (alternatingGroup (Fin 3))
        (σ * (Equiv.swap (0 : Fin 3) 1)⁻¹) = 1 :=
      (QuotientGroup.eq_one_iff _).2 hker
    rw [map_mul, map_inv, mul_inv_eq_one] at h2
    exact h2.symm

/-- **A subgroup may become normal modulo the earlier stage.** -/
theorem normality_acquired_at_later_stage :
    ¬ (Subgroup.zpowers (Equiv.swap (0 : Fin 3) 1)).Normal ∧
      ((Subgroup.zpowers (Equiv.swap (0 : Fin 3) 1)).map
        (QuotientGroup.mk' (alternatingGroup (Fin 3)))).Normal := by
  refine ⟨swapSubgroup_not_normal, ?_⟩
  rw [swapSubgroup_map_eq_top]
  exact Subgroup.normal_top

end AcquiredCommutationAndNormality

end SoundIterateInstances
end GroupApproximation
