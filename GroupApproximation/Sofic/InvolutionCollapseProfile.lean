import GroupApproximation.Sofic.InvolutionCollapseMetric

/-!
# Normalized displacement vectors of an involution microstate family

The rank displacement of the microstate family, normalized by the total
generator displacement `kNorm`, produces the flattened vectors `bVec`
feeding the ultralimit Gaussian machinery:

* `wordLen` chooses an `S`-word for every group element; displacements
  grow at most linearly in the word length against `kNorm`
  (`eventually_dV_le_wordLen_mul_kNorm`);
* `bVec` is the flattened, `√kNorm`-normalized displacement, capped by
  the word bound so that its squared norm is bounded by `4 · wordLen`
  at **every** stage;
* at every stage with positive `kNorm` the generators carry total squared
  mass exactly `4` (`sum_normSq_bVec_eq_four`) — the nonvanishing anchor
  of the collapse argument;
* a marked separation forces `kNorm ≥ 1` at all late stages
  (`eventually_one_le_kNorm_of_marked`).
-/

namespace GroupApproximation
namespace InvolutionCollapseProfile

open Matrix InvolutionOrbitMicrostates InvolutionRankMass
open InvolutionCollapseMetric InvolutionMicrostateTools
open KazhdanCornerMatrices KazhdanCompressorCorner
open scoped Matrix.Norms.L2Operator
open scoped commutatorElement

variable {Γ E : Type} [Group Γ] [Group E]
variable (B : OpAlmostRepresentation E)
variable (iota : Γ →* E)
variable (k : E)
variable (V : ∀ n, Γ → Matrix (B.model n) (B.model n) ℂ)
variable (S : Finset Γ)

/-! ## Words -/

/-- Every element of a group generated by a symmetric finite set is a
product of a list of generators. -/
theorem exists_word (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S) (γ : Γ) :
    ∃ l : List Γ, (∀ x ∈ l, x ∈ S) ∧ l.prod = γ := by
  have hmem : γ ∈ Subgroup.closure (S : Set Γ) := by
    rw [hgen]
    exact Subgroup.mem_top γ
  have hmem' : γ ∈ Submonoid.closure ((S : Set Γ) ∪ (S : Set Γ)⁻¹) := by
    rw [← Subgroup.closure_toSubmonoid]
    exact hmem
  obtain ⟨l, hl, hprod⟩ := Submonoid.exists_list_of_mem_closure hmem'
  refine ⟨l, fun x hx ↦ ?_, hprod⟩
  rcases hl x hx with h | h
  · exact h
  · have hxinv : x⁻¹ ∈ S := by
      rwa [Set.mem_inv] at h
    have := hsymm x⁻¹ hxinv
    rwa [inv_inv] at this

/-- The length of a chosen `S`-word for `γ`. -/
noncomputable def wordLen (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S) (γ : Γ) : ℕ :=
  (Classical.choose (exists_word S hgen hsymm γ)).length

theorem wordLen_spec (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S) (γ : Γ) :
    ∃ l : List Γ, (∀ x ∈ l, x ∈ S) ∧ l.prod = γ ∧
      l.length = wordLen S hgen hsymm γ :=
  ⟨Classical.choose (exists_word S hgen hsymm γ),
    (Classical.choose_spec (exists_word S hgen hsymm γ)).1,
    (Classical.choose_spec (exists_word S hgen hsymm γ)).2, rfl⟩

/-! ## The word bound -/

/-- List form of the word bound: the displacement of a word is eventually
at most its length times the generator normalization. -/
theorem eventually_dV_prod_le
    (hVinv : ∀ n γ, ExactInvolutionLifts.IsExactInvolution (V n γ))
    (hVcomm : ∀ n γ₁ γ₂, V n γ₁ * V n γ₂ = V n γ₂ * V n γ₁)
    (hVconv : ∀ γ, OpNormVanishing B (fun n ↦ V n γ - raw B iota k n γ))
    (l : List Γ) (hl : ∀ x ∈ l, x ∈ S) :
    ∃ N, ∀ n ≥ N,
      dV B V n l.prod 1 ≤ l.length * kNorm B V S n := by
  induction l with
  | nil =>
      refine ⟨0, fun n _ ↦ ?_⟩
      have hzero : dV B V n (List.prod []) 1 = 0 := by
        show (V n (1 : Γ) - V n 1).rank = 0
        rw [sub_self]
        exact Matrix.rank_zero
      rw [hzero]
      exact Nat.zero_le _
  | cons a l ih =>
      obtain ⟨N₁, hN₁⟩ := ih fun x hx ↦ hl x (List.mem_cons_of_mem a hx)
      obtain ⟨N₂, hN₂⟩ := eventual_invariance B iota k V hVinv hVcomm
        hVconv a l.prod 1
      refine ⟨max N₁ N₂, fun n hn ↦ ?_⟩
      have haS : a ∈ S := hl a List.mem_cons_self
      have hstep : dV B V n (a * l.prod) a = dV B V n l.prod 1 := by
        have h := hN₂ n ((le_max_right _ _).trans hn)
        rwa [mul_one] at h
      calc
        dV B V n (List.prod (a :: l)) 1 =
            dV B V n (a * l.prod) 1 := by rw [List.prod_cons]
        _ ≤ dV B V n (a * l.prod) a + dV B V n a 1 :=
          dV_triangle B V n _ a 1
        _ ≤ l.length * kNorm B V S n + kNorm B V S n := by
          rw [hstep]
          exact Nat.add_le_add (hN₁ n ((le_max_left _ _).trans hn))
            (dV_le_kNorm B V haS n)
        _ = (a :: l).length * kNorm B V S n := by
          rw [List.length_cons]
          ring

/-- The displacement of any element is eventually bounded by its word
length times the generator normalization. -/
theorem eventually_dV_le_wordLen_mul_kNorm
    (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S)
    (hVinv : ∀ n γ, ExactInvolutionLifts.IsExactInvolution (V n γ))
    (hVcomm : ∀ n γ₁ γ₂, V n γ₁ * V n γ₂ = V n γ₂ * V n γ₁)
    (hVconv : ∀ γ, OpNormVanishing B (fun n ↦ V n γ - raw B iota k n γ))
    (γ : Γ) :
    ∃ N, ∀ n ≥ N,
      dV B V n γ 1 ≤ wordLen S hgen hsymm γ * kNorm B V S n := by
  obtain ⟨l, hlS, hlprod, hllen⟩ := wordLen_spec S hgen hsymm γ
  obtain ⟨N, hN⟩ := eventually_dV_prod_le B iota k V S hVinv hVcomm
    hVconv l hlS
  refine ⟨N, fun n hn ↦ ?_⟩
  have h := hN n hn
  rwa [hlprod, hllen] at h

/-! ## The mass identity -/

omit [Group Γ] in
/-- The Frobenius mass of a displacement is four times its rank. -/
theorem matMass_V_sub
    (hVinv : ∀ n γ, ExactInvolutionLifts.IsExactInvolution (V n γ))
    (hVcomm : ∀ n γ₁ γ₂, V n γ₁ * V n γ₂ = V n γ₂ * V n γ₁)
    (n : ℕ) (γ₁ γ₂ : Γ) :
    ScaledKazhdanTransport.matMass (V n γ₁ - V n γ₂) =
      4 * (dV B V n γ₁ γ₂ : ℝ) := by
  have h := matMass_sub_eq_four_mul_rank
    ⟨(hVinv n γ₁).1, (hVinv n γ₁).2⟩ ⟨(hVinv n γ₂).1, (hVinv n γ₂).2⟩
    (hVcomm n γ₁ γ₂)
  rw [h, rank_halfSqProjection ⟨(hVinv n γ₁).1, (hVinv n γ₁).2⟩
    ⟨(hVinv n γ₂).1, (hVinv n γ₂).2⟩ (hVcomm n γ₁ γ₂)]
  rfl

/-! ## The normalized displacement vectors -/

open Classical in
/-- The flattened, normalized, word-capped displacement vector. -/
noncomputable def bVec (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S) (n : ℕ) (γ : Γ) :
    EuclideanSpace ℂ (B.model n × B.model n) :=
  if 0 < kNorm B V S n ∧
      dV B V n γ 1 ≤ wordLen S hgen hsymm γ * kNorm B V S n then
    ((Real.sqrt (kNorm B V S n))⁻¹ : ℝ) • flatE (V n γ - V n 1)
  else 0

theorem bVec_one (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S) (n : ℕ) :
    bVec B V S hgen hsymm n 1 = 0 := by
  unfold bVec
  split_ifs with h
  · rw [sub_self, flatE_zero, smul_zero]
  · rfl

/-- In the capped branch the squared norm is the normalized mass. -/
theorem norm_bVec_sq_of_pos (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S) {n : ℕ} {γ : Γ}
    (hk : 0 < kNorm B V S n)
    (hcap : dV B V n γ 1 ≤ wordLen S hgen hsymm γ * kNorm B V S n) :
    ‖bVec B V S hgen hsymm n γ‖ ^ 2 =
      ScaledKazhdanTransport.matMass (V n γ - V n 1) /
        (kNorm B V S n : ℝ) := by
  unfold bVec
  rw [if_pos ⟨hk, hcap⟩]
  have hkpos : (0 : ℝ) < (kNorm B V S n : ℝ) := by exact_mod_cast hk
  have hsqrtpos : (0 : ℝ) < Real.sqrt (kNorm B V S n) :=
    Real.sqrt_pos.mpr hkpos
  rw [norm_smul, mul_pow, norm_flatE_sq]
  have hns : ‖((Real.sqrt (kNorm B V S n))⁻¹ : ℝ)‖ ^ 2 =
      ((kNorm B V S n : ℝ))⁻¹ := by
    rw [Real.norm_eq_abs, abs_of_pos (by positivity), inv_pow,
      Real.sq_sqrt hkpos.le]
  rw [hns]
  ring

/-- The squared norm of the normalized vector is bounded by four times
the word length, at every stage. -/
theorem norm_bVec_sq_le (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S)
    (hVinv : ∀ n γ, ExactInvolutionLifts.IsExactInvolution (V n γ))
    (hVcomm : ∀ n γ₁ γ₂, V n γ₁ * V n γ₂ = V n γ₂ * V n γ₁)
    (n : ℕ) (γ : Γ) :
    ‖bVec B V S hgen hsymm n γ‖ ^ 2 ≤
      4 * (wordLen S hgen hsymm γ : ℝ) := by
  unfold bVec
  split_ifs with h
  · obtain ⟨hk, hcap⟩ := h
    have hkpos : (0 : ℝ) < (kNorm B V S n : ℝ) := by exact_mod_cast hk
    have hval := norm_bVec_sq_of_pos B V S hgen hsymm hk hcap
    unfold bVec at hval
    rw [if_pos ⟨hk, hcap⟩] at hval
    rw [hval, matMass_V_sub B V hVinv hVcomm n γ 1]
    rw [div_le_iff₀ hkpos]
    have hcast : (dV B V n γ 1 : ℝ) ≤
        (wordLen S hgen hsymm γ : ℝ) * (kNorm B V S n : ℝ) := by
      exact_mod_cast hcap
    nlinarith [hcast]
  · rw [norm_zero]
    have h0 : (0 : ℝ) ^ 2 = 0 := by norm_num
    rw [h0]
    positivity

/-- **The nonvanishing anchor**: at every stage with positive generator
normalization, the generators carry total normalized squared mass exactly
four. -/
theorem sum_normSq_bVec_eq_four (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S)
    (hVinv : ∀ n γ, ExactInvolutionLifts.IsExactInvolution (V n γ))
    (hVcomm : ∀ n γ₁ γ₂, V n γ₁ * V n γ₂ = V n γ₂ * V n γ₁)
    {n : ℕ} (hk : 0 < kNorm B V S n) :
    ∑ a ∈ S, ‖bVec B V S hgen hsymm n a‖ ^ 2 = 4 := by
  have hkpos : (0 : ℝ) < (kNorm B V S n : ℝ) := by exact_mod_cast hk
  have hcap : ∀ a ∈ S,
      dV B V n a 1 ≤ wordLen S hgen hsymm a * kNorm B V S n := by
    intro a haS
    by_cases hwl : wordLen S hgen hsymm a = 0
    · obtain ⟨l, _, hlprod, hllen⟩ := wordLen_spec S hgen hsymm a
      rw [hwl] at hllen
      have hnil : l = [] := List.length_eq_zero_iff.mp hllen
      rw [hnil] at hlprod
      simp only [List.prod_nil] at hlprod
      have : dV B V n a 1 = 0 := by
        show (V n a - V n 1).rank = 0
        rw [← hlprod, sub_self]
        exact Matrix.rank_zero
      rw [this]
      exact Nat.zero_le _
    · have h1 : 1 ≤ wordLen S hgen hsymm a := Nat.one_le_iff_ne_zero.mpr hwl
      calc
        dV B V n a 1 ≤ kNorm B V S n := dV_le_kNorm B V haS n
        _ = 1 * kNorm B V S n := (one_mul _).symm
        _ ≤ wordLen S hgen hsymm a * kNorm B V S n :=
          Nat.mul_le_mul_right _ h1
  calc
    ∑ a ∈ S, ‖bVec B V S hgen hsymm n a‖ ^ 2 =
        ∑ a ∈ S, 4 * ((dV B V n a 1 : ℝ) / (kNorm B V S n : ℝ)) := by
      refine Finset.sum_congr rfl fun a haS ↦ ?_
      rw [norm_bVec_sq_of_pos B V S hgen hsymm hk (hcap a haS),
        matMass_V_sub B V hVinv hVcomm n a 1]
      ring
    _ = 4 * ((∑ a ∈ S, (dV B V n a 1 : ℝ)) / (kNorm B V S n : ℝ)) := by
      rw [Finset.sum_div, Finset.mul_sum]
    _ = 4 := by
      have hsum : (∑ a ∈ S, (dV B V n a 1 : ℝ)) = (kNorm B V S n : ℝ) := by
        rw [show kNorm B V S n = ∑ a ∈ S, dV B V n a 1 from rfl]
        push_cast
        rfl
      rw [hsum, div_self (ne_of_gt hkpos)]
      norm_num

/-! ## Marked positivity -/

/-- A marked separation of the collapse commutator forces the microstates
at the mover apart from the basepoint, hence positive displacement and
positive generator normalization, at all late stages. -/
theorem eventually_one_le_kNorm_of_marked
    (hgen : Subgroup.closure (S : Set Γ) = ⊤)
    (hsymm : ∀ g ∈ S, g⁻¹ ∈ S)
    (hVinv : ∀ n γ, ExactInvolutionLifts.IsExactInvolution (V n γ))
    (hVcomm : ∀ n γ₁ γ₂, V n γ₁ * V n γ₂ = V n γ₂ * V n γ₁)
    (hVconv : ∀ γ, OpNormVanishing B (fun n ↦ V n γ - raw B iota k n γ))
    {k2 : k * k = 1} {γ₀ : Γ} {δ : ℝ} (hδ : 0 < δ)
    (hsep : ∀ n, δ ≤
      ‖(B.map n ⁅iota γ₀, k⁆ : Matrix (B.model n) (B.model n) ℂ) -
        B.map n 1‖) :
    ∃ N, ∀ n ≥ N, 1 ≤ kNorm B V S n := by
  classical
  -- the commutator is the product of the two orbit microstates
  have hz : ⁅iota γ₀, k⁆ =
      orbitElement iota k γ₀ * orbitElement iota k 1 := by
    rw [orbitElement_one]
    rw [commutatorElement_def]
    have hkinv : k⁻¹ = k := by
      rw [← mul_one k⁻¹, ← k2, ← mul_assoc, inv_mul_cancel, one_mul]
    unfold orbitElement
    rw [hkinv]
  have hmul := (multiplicativeDefect_vanishing B
    (orbitElement iota k γ₀) (orbitElement iota k 1))
  obtain ⟨N₁, hN₁⟩ := hmul (δ / 8) (by positivity)
  obtain ⟨N₂, hN₂⟩ := hVconv γ₀ (δ / 8) (by positivity)
  obtain ⟨N₃, hN₃⟩ := hVconv 1 (δ / 8) (by positivity)
  obtain ⟨N₄, hN₄⟩ := map_one_vanishing B (δ / 8) (by positivity)
  obtain ⟨l₀, hl₀S, hl₀prod, _⟩ := wordLen_spec S hgen hsymm γ₀
  obtain ⟨N₅, hN₅⟩ := eventually_dV_prod_le B iota k V S hVinv hVcomm
    hVconv l₀ hl₀S
  refine ⟨max (max N₁ N₂) (max (max N₃ N₄) N₅), fun n hn ↦ ?_⟩
  have hn₁ : n ≥ N₁ := le_trans (le_trans (le_max_left _ _)
    (le_max_left _ _)) hn
  have hn₂ : n ≥ N₂ := le_trans (le_trans (le_max_right _ _)
    (le_max_left _ _)) hn
  have hn₃ : n ≥ N₃ := le_trans (le_trans (le_max_left _ _)
    (le_trans (le_max_left _ _) (le_max_right _ _))) hn
  have hn₄ : n ≥ N₄ := le_trans (le_trans (le_max_right _ _)
    (le_trans (le_max_left _ _) (le_max_right _ _))) hn
  have hn₅ : n ≥ N₅ := le_trans (le_trans (le_max_right _ _)
    (le_max_right _ _)) hn
  -- the displacement at the mover is positive
  have hne : V n γ₀ ≠ V n 1 := by
    intro heq
    have hVprod : V n γ₀ * V n 1 = 1 := by
      rw [heq]
      exact (hVinv n 1).2
    have hchain : ‖(B.map n ⁅iota γ₀, k⁆ :
        Matrix (B.model n) (B.model n) ℂ) - B.map n 1‖ < δ := by
      have hzn : (B.map n ⁅iota γ₀, k⁆ :
          Matrix (B.model n) (B.model n) ℂ) =
          B.map n (orbitElement iota k γ₀ * orbitElement iota k 1) := by
        rw [hz]
      have hd1 : ‖(B.map n (orbitElement iota k γ₀ *
          orbitElement iota k 1) : Matrix (B.model n) (B.model n) ℂ) -
          raw B iota k n γ₀ * raw B iota k n 1‖ ≤ δ / 8 := hN₁ n hn₁
      have hd2 : ‖raw B iota k n γ₀ * raw B iota k n 1 -
          V n γ₀ * V n 1‖ ≤ δ / 8 + δ / 8 := by
        have hsplit : raw B iota k n γ₀ * raw B iota k n 1 -
            V n γ₀ * V n 1 =
            (raw B iota k n γ₀ - V n γ₀) * raw B iota k n 1 +
              V n γ₀ * (raw B iota k n 1 - V n 1) := by
          noncomm_ring
        have hb1 : ‖(raw B iota k n γ₀ - V n γ₀) *
            raw B iota k n 1‖ ≤ δ / 8 := by
          have hnorm1 : ‖raw B iota k n γ₀ - V n γ₀‖ ≤ δ / 8 := by
            have := hN₂ n hn₂
            rwa [norm_sub_rev] at this
          calc
            ‖(raw B iota k n γ₀ - V n γ₀) * raw B iota k n 1‖ ≤
                ‖raw B iota k n γ₀ - V n γ₀‖ * ‖raw B iota k n 1‖ :=
              Matrix.l2_opNorm_mul _ _
            _ ≤ δ / 8 * 1 := by
              have hu := norm_le_one_of_mem_unitary
                (raw_mem_unitaryGroup B iota k n 1)
              have hnn := norm_nonneg (raw B iota k n γ₀ - V n γ₀)
              nlinarith
            _ = δ / 8 := mul_one _
        have hb2 : ‖V n γ₀ * (raw B iota k n 1 - V n 1)‖ ≤ δ / 8 := by
          have hnorm2 : ‖raw B iota k n 1 - V n 1‖ ≤ δ / 8 := by
            have := hN₃ n hn₃
            rwa [norm_sub_rev] at this
          have hVu : ‖V n γ₀‖ ≤ 1 := by
            by_cases hY : Nonempty (B.model n)
            · haveI := hY
              exact le_of_eq (CStarRing.norm_of_mem_unitary
                (InvolutionCollapseMetric.isExactInvolution_mem_unitaryGroup
                  (hVinv n γ₀)))
            · haveI : IsEmpty (B.model n) := not_nonempty_iff.mp hY
              have : V n γ₀ = 0 := Subsingleton.elim _ _
              rw [this, norm_zero]
              norm_num
          calc
            ‖V n γ₀ * (raw B iota k n 1 - V n 1)‖ ≤
                ‖V n γ₀‖ * ‖raw B iota k n 1 - V n 1‖ :=
              Matrix.l2_opNorm_mul _ _
            _ ≤ δ / 8 := by
              have hnn := norm_nonneg (raw B iota k n 1 - V n 1)
              nlinarith
        calc
          ‖raw B iota k n γ₀ * raw B iota k n 1 - V n γ₀ * V n 1‖ =
              ‖(raw B iota k n γ₀ - V n γ₀) * raw B iota k n 1 +
                V n γ₀ * (raw B iota k n 1 - V n 1)‖ := by rw [hsplit]
          _ ≤ ‖(raw B iota k n γ₀ - V n γ₀) * raw B iota k n 1‖ +
              ‖V n γ₀ * (raw B iota k n 1 - V n 1)‖ := norm_add_le _ _
          _ ≤ δ / 8 + δ / 8 := add_le_add hb1 hb2
      have hd4 : ‖(1 : Matrix (B.model n) (B.model n) ℂ) -
          B.map n 1‖ ≤ δ / 8 := by
        have := hN₄ n hn₄
        rwa [norm_sub_rev] at this
      calc
        ‖(B.map n ⁅iota γ₀, k⁆ :
            Matrix (B.model n) (B.model n) ℂ) - B.map n 1‖ =
            ‖((B.map n (orbitElement iota k γ₀ * orbitElement iota k 1) :
                Matrix (B.model n) (B.model n) ℂ) -
              raw B iota k n γ₀ * raw B iota k n 1) +
              ((raw B iota k n γ₀ * raw B iota k n 1 -
                V n γ₀ * V n 1)) +
              ((V n γ₀ * V n 1 - 1) +
                ((1 : Matrix (B.model n) (B.model n) ℂ) - B.map n 1))‖ := by
          rw [hzn]
          congr 1
          abel
        _ ≤ δ / 8 + (δ / 8 + δ / 8) + (0 + δ / 8) := by
          have h5 : ‖(V n γ₀ * V n 1 - 1 :
              Matrix (B.model n) (B.model n) ℂ)‖ = 0 := by
            rw [hVprod, sub_self, norm_zero]
          calc
            ‖_ + _ + _‖ ≤ _ := norm_add₃_le
            _ ≤ δ / 8 + (δ / 8 + δ / 8) + (0 + δ / 8) := by
              refine add_le_add (add_le_add hd1 hd2) ?_
              calc
                ‖(V n γ₀ * V n 1 - 1) +
                    ((1 : Matrix (B.model n) (B.model n) ℂ) -
                      B.map n 1)‖ ≤
                    ‖(V n γ₀ * V n 1 - 1 :
                      Matrix (B.model n) (B.model n) ℂ)‖ +
                    ‖(1 : Matrix (B.model n) (B.model n) ℂ) -
                      B.map n 1‖ := norm_add_le _ _
                _ ≤ 0 + δ / 8 := add_le_add (le_of_eq h5) hd4
        _ < δ := by linarith
    exact absurd (hsep n) (not_le.mpr hchain)
  have hdVpos : 1 ≤ dV B V n γ₀ 1 := by
    rw [Nat.one_le_iff_ne_zero]
    intro h0
    have hne0 : V n γ₀ - V n 1 ≠ 0 := sub_ne_zero.mpr hne
    obtain ⟨v, hv⟩ := exists_mulVec_ne_zero hne0
    have hfr : (V n γ₀ - V n 1).rank = 0 := h0
    unfold Matrix.rank at hfr
    have hbot := Submodule.finrank_eq_zero.mp hfr
    apply hv
    have hmem : (V n γ₀ - V n 1) *ᵥ v ∈
        LinearMap.range (V n γ₀ - V n 1).mulVecLin :=
      LinearMap.mem_range.mpr ⟨v, rfl⟩
    rw [hbot] at hmem
    exact (Submodule.mem_bot ℂ).mp hmem
  have hword := hN₅ n hn₅
  rw [hl₀prod] at hword
  by_contra hk0
  push Not at hk0
  have hk00 : kNorm B V S n = 0 := by omega
  rw [hk00, Nat.mul_zero, Nat.le_zero] at hword
  omega

end InvolutionCollapseProfile
end GroupApproximation
