import GroupApproximation.Criterion.CompressionCentralizerDefect
import GroupApproximation.Sofic.KazhdanCompressionCore

/-!
# Intrinsic and orbit compression defects

This file relates the original single-compressor defect to the choice-free
compression--centralizer defect `𝔇(E,L)`, where `L` is the image of the
Kazhdan source.  It also formalizes the two-sided orbit enlargement: although
negative powers of the stable letter need not be algebraic one-sided
compressors, they lie in the *group generated* by all compressors.  Hence the
normal closure of all integer-orbit commutators lies in the intrinsic defect.
-/

namespace GroupApproximation

open scoped commutatorElement

universe u

/-! The ambient group is quantified at an arbitrary universe: the intrinsic
defect `𝔇(H,L)` of the manuscript is defined for an arbitrary group `H`, and
everything here is group theory.  The Kazhdan source `Γ` stays in `Type 0`
because `KazhdanCompressionCore` spells property `(T)` as
`HasKazhdanPropertyT.{0, 0}`. -/
variable {Γ : Type} {E : Type u} [Group Γ] [Group E]

namespace KazhdanCompressionCore

/-- The full integer-orbit defect generators attached to one compression
core. -/
def orbitDefectSet (C : KazhdanCompressionCore Γ E) : Set E :=
  Set.range fun p : ℤ × Γ ↦
    ⁅C.t ^ p.1 * C.c * (C.t ^ p.1)⁻¹, C.iota p.2⁆

/-- The normal closure of all integer-orbit compression defects. -/
def orbitDefectNormal (C : KazhdanCompressionCore Γ E) : Subgroup E :=
  Subgroup.normalClosure C.orbitDefectSet

instance orbitDefectNormal_normal (C : KazhdanCompressionCore Γ E) :
    C.orbitDefectNormal.Normal :=
  Subgroup.normalClosure_normal

/-- The distinguished stable letter is one of the one-sided compressors of
the image subgroup. -/
theorem t_mem_compressionSet (C : KazhdanCompressionCore Γ E) :
    C.t ∈ compressionSet C.iota.range := by
  intro x hx
  obtain ⟨gamma, rfl⟩ := hx
  obtain ⟨delta, hdelta⟩ := C.compresses gamma
  exact ⟨delta, hdelta.symm⟩

/-- Every integer power of the stable letter lies in the group generated by
one-sided compressors. -/
theorem zpow_t_mem_compressionGroup (C : KazhdanCompressionCore Γ E)
    (n : ℤ) : C.t ^ n ∈ compressionGroup C.iota.range := by
  have ht : C.t ∈ compressionGroup C.iota.range :=
    Subgroup.subset_closure C.t_mem_compressionSet
  exact zpow_mem ht n

/-- The root centralizes the entire image subgroup. -/
theorem c_commutes_range (C : KazhdanCompressionCore Γ E) :
    ∀ x ∈ C.iota.range, Commute C.c x := by
  intro x hx
  obtain ⟨gamma, rfl⟩ := hx
  exact C.comm_c gamma

/-- Every integer-orbit generator belongs to the intrinsic defect. -/
theorem orbitDefect_mem_compressionCentralizerDefect
    (C : KazhdanCompressionCore Γ E) (n : ℤ) (gamma : Γ) :
    ⁅C.t ^ n * C.c * (C.t ^ n)⁻¹, C.iota gamma⁆ ∈
      compressionCentralizerDefect C.iota.range :=
  compressionCentralizerDefect_generator_mem C.iota.range
    (C.zpow_t_mem_compressionGroup n) C.c_commutes_range
    ⟨gamma, rfl⟩

/-- The entire orbit defect is contained in the intrinsic defect. -/
theorem orbitDefectNormal_le_compressionCentralizerDefect
    (C : KazhdanCompressionCore Γ E) :
    C.orbitDefectNormal ≤ compressionCentralizerDefect C.iota.range := by
  apply Subgroup.normalClosure_le_normal
  rintro x ⟨⟨n, gamma⟩, rfl⟩
  exact C.orbitDefect_mem_compressionCentralizerDefect n gamma

/-- The original single-compressor defect is contained in the integer-orbit
defect. -/
theorem defectNormal_le_orbitDefectNormal
    (C : KazhdanCompressionCore Γ E) :
    C.defectNormal ≤ C.orbitDefectNormal := by
  apply Subgroup.normalClosure_le_normal
  rintro x ⟨gamma, rfl⟩
  apply Subgroup.subset_normalClosure
  refine ⟨(1, gamma), ?_⟩
  simp [transported]

/-- Consequently the old marked defect is a subgroup of the intrinsic,
choice-free defect. -/
theorem defectNormal_le_compressionCentralizerDefect
    (C : KazhdanCompressionCore Γ E) :
    C.defectNormal ≤ compressionCentralizerDefect C.iota.range :=
  C.defectNormal_le_orbitDefectNormal.trans
    C.orbitDefectNormal_le_compressionCentralizerDefect

end KazhdanCompressionCore
end GroupApproximation
