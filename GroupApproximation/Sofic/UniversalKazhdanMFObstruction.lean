import GroupApproximation.Sofic.NormallyGeneratedMFObstruction

/-!
# Universal Kazhdan groups with full MF residual

This file formalizes the short deduction that combines two external
group-embedding inputs:

* a finitely presented group containing every finitely presented group in a
  fixed universe; and
* a finitely presented Kazhdan envelope normally generated by a selected
  nontrivial element.

Both inputs are represented by explicit data structures.  In particular,
this file neither postulates Higman's embedding theorem nor the
Chatterji--Kassabov normally generated envelope theorem.  Once such data are
supplied, functoriality of the norm-MF residual proves that the final envelope
has full residual, contains every finitely presented group, and has only
trivial homomorphisms to residual-free or operator-MF groups.
-/

namespace GroupApproximation

universe u v w x

/-- Proof-carrying universality data for a finitely presented group `U`.

The quantification is over finitely presented groups in the fixed universe
`u`.  This is the exact input needed from a chosen universal finitely
presented group construction; no inhabitant is asserted here. -/
structure UniversalFinitelyPresentedGroupData
    (U : Type v) [Group U] where
  [finitelyPresented : Group.IsFinitelyPresented U]
  embedding :
    ∀ (H : Type u) [Group H] [Group.IsFinitelyPresented H], H →* U
  embedding_injective :
    ∀ (H : Type u) [Group H] [Group.IsFinitelyPresented H],
      Function.Injective (embedding H)

namespace UniversalFinitelyPresentedGroupData

variable {U : Type v} [Group U]

/-- Universality expressed without exposing the chosen embedding. -/
theorem exists_embedding
    (D : UniversalFinitelyPresentedGroupData.{u, v} U)
    (H : Type u) [Group H] [Group.IsFinitelyPresented H] :
    ∃ f : H →* U, Function.Injective f :=
  ⟨UniversalFinitelyPresentedGroupData.embedding D H,
    UniversalFinitelyPresentedGroupData.embedding_injective D H⟩

end UniversalFinitelyPresentedGroupData

set_option linter.checkUnivs false in
/-- Explicit inputs for the universal Kazhdan full-residual construction.

`Universal` is the Higman-style universal finitely presented group,
`sourceEmbedding` places the marked source obstruction inside it, and
`envelope` is the Chatterji--Kassabov-style Kazhdan envelope normally
generated by the image of that mark.  The structure is deliberately only
data: the literature-dependent existence of these inputs is not asserted. -/
structure UniversalNormallyGeneratedKazhdanEnvelopeData
    (E : Type x) [Group E] (mark : E) where
  Universal : Type v
  [groupUniversal : Group Universal]
  universal : UniversalFinitelyPresentedGroupData.{u, v} Universal
  sourceEmbedding : E →* Universal
  sourceEmbedding_injective : Function.Injective sourceEmbedding
  envelope : NormallyGeneratedKazhdanEnvelopeData.{v, w}
    Universal (sourceEmbedding mark)

namespace UniversalNormallyGeneratedKazhdanEnvelopeData

variable {E : Type x} [Group E] {mark : E}
    (D : UniversalNormallyGeneratedKazhdanEnvelopeData.{u, v, w, x} E mark)

local instance : Group D.Universal := D.groupUniversal
local instance : Group.IsFinitelyPresented D.Universal :=
  D.universal.finitelyPresented
local instance : Group D.envelope.Envelope := D.envelope.groupEnvelope
local instance : Group.IsFinitelyPresented D.envelope.Envelope :=
  D.envelope.finitelyPresented

/-- The marked source embeds into the final Kazhdan envelope. -/
def markedSourceEmbedding : E →* D.envelope.Envelope :=
  D.envelope.embedding.comp D.sourceEmbedding

/-- The marked-source embedding into the final envelope is injective. -/
theorem markedSourceEmbedding_injective :
    Function.Injective D.markedSourceEmbedding :=
  D.envelope.embedding_injective.comp D.sourceEmbedding_injective

/-- The chosen source mark remains nontrivial in the final envelope. -/
theorem markedSourceEmbedding_ne_one (hmark : mark ≠ 1) :
    D.markedSourceEmbedding mark ≠ 1 := by
  intro h
  apply hmark
  apply D.markedSourceEmbedding_injective
  simpa using h

/-- Embed any finitely presented group in the final Kazhdan envelope. -/
def embeddingOfFinitelyPresented
    (H : Type u) [Group H] [Group.IsFinitelyPresented H] :
    H →* D.envelope.Envelope :=
  D.envelope.embedding.comp (D.universal.embedding H)

/-- The canonical embedding of a finitely presented group in the final
envelope is injective. -/
theorem embeddingOfFinitelyPresented_injective
    (H : Type u) [Group H] [Group.IsFinitelyPresented H] :
    Function.Injective (D.embeddingOfFinitelyPresented H) :=
  D.envelope.embedding_injective.comp
    (D.universal.embedding_injective H)

/-- The final Kazhdan envelope contains every finitely presented group in
the universe quantified by the universality data. -/
theorem contains_every_finitelyPresented
    (H : Type u) [Group H] [Group.IsFinitelyPresented H] :
    ∃ f : H →* D.envelope.Envelope, Function.Injective f :=
  ⟨D.embeddingOfFinitelyPresented H,
    D.embeddingOfFinitelyPresented_injective H⟩

/-- Portability carries the source obstruction into the universal group. -/
theorem universal_mark_mem_normMFResidual
    (hmark : mark ∈ normMFResidual E) :
    D.sourceEmbedding mark ∈ normMFResidual D.Universal :=
  mem_normMFResidual_iff.mpr
    ((mem_normMFResidual_iff.mp hmark).map D.sourceEmbedding)

/-- Injectivity preserves nontriviality of the selected mark in the universal
group. -/
theorem universal_mark_ne_one (hmark : mark ≠ 1) :
    D.sourceEmbedding mark ≠ 1 := by
  intro h
  apply hmark
  apply D.sourceEmbedding_injective
  simpa using h

/-- The final finitely presented Kazhdan envelope has full norm-MF
residual. -/
theorem envelope_normMFResidual_eq_top
    (hmark : mark ∈ normMFResidual E) :
    normMFResidual D.envelope.Envelope = ⊤ :=
  D.envelope.envelope_normMFResidual_eq_top
    (D.universal_mark_mem_normMFResidual hmark)

/-- Every homomorphism from the final envelope to a group with trivial
norm-MF residual is trivial. -/
theorem hom_eq_one_to_residualFree
    (hmark : mark ∈ normMFResidual E)
    {M : Type*} [Group M] (hM : normMFResidual M = ⊥)
    (f : D.envelope.Envelope →* M) : f = 1 :=
  D.envelope.hom_eq_one_to_residualFree
    (D.universal_mark_mem_normMFResidual hmark) hM f

/-- Every homomorphism from the final envelope to any operator-MF group is
trivial.  The target need not be countable. -/
theorem hom_eq_one_to_isOperatorMF
    (hmark : mark ∈ normMFResidual E)
    {M : Type*} [Group M] (hM : IsOperatorMF M)
    (f : D.envelope.Envelope →* M) : f = 1 :=
  D.envelope.hom_eq_one_to_isOperatorMF
    (D.universal_mark_mem_normMFResidual hmark) hM f

/-- A nontrivial invisible source mark makes the final universal Kazhdan
envelope non-operator-MF. -/
theorem not_isOperatorMF
    (hmark : mark ∈ normMFResidual E) (hmark1 : mark ≠ 1) :
    ¬ IsOperatorMF D.envelope.Envelope :=
  D.envelope.not_isOperatorMF
    (D.universal_mark_mem_normMFResidual hmark)
    (D.universal_mark_ne_one hmark1)

/-- Complete formal consequence package.  Its components say that the final
group is finitely presented, Kazhdan, universal for finitely presented
groups in the selected universe, has full norm-MF residual, and is not
operator-MF. -/
theorem consequence_package
    (hmark : mark ∈ normMFResidual E) (hmark1 : mark ≠ 1) :
    Group.IsFinitelyPresented D.envelope.Envelope ∧
      HasKazhdanPropertyT.{w, 0} D.envelope.Envelope ∧
      (∀ (H : Type u) [Group H] [Group.IsFinitelyPresented H],
        ∃ f : H →* D.envelope.Envelope, Function.Injective f) ∧
      normMFResidual D.envelope.Envelope = ⊤ ∧
      ¬ IsOperatorMF D.envelope.Envelope := by
  refine ⟨D.envelope.finitelyPresented, D.envelope.kazhdan, ?_,
    D.envelope_normMFResidual_eq_top hmark,
    D.not_isOperatorMF hmark hmark1⟩
  intro H _ _
  exact D.contains_every_finitelyPresented H

end UniversalNormallyGeneratedKazhdanEnvelopeData
end GroupApproximation
