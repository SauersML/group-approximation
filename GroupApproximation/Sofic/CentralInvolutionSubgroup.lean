import Mathlib.Algebra.Group.Subgroup.Finite

/-!
# The subgroup generated by a central involution

For an element `w` satisfying `w ^ 2 = 1`, this file packages the two-element
set `{1, w}` as an explicit subgroup.  The construction is intentionally
elementary: its carrier is definitionally the disjunction `x = 1 ∨ x = w`.
This makes membership and subgroup-containment arguments transparent at the
finite-normal obstruction endpoint.
-/

namespace GroupApproximation

section CentralInvolutionSubgroup

variable {G : Type*} [Group G]

/-- The subgroup whose elements are `1` and an involution `w`.

When `w = 1`, this is the trivial subgroup; when `w ≠ 1`, it has exactly two
elements. -/
def centralInvolutionSubgroup (w : G) (hw : w ^ 2 = 1) : Subgroup G where
  carrier := {x | x = 1 ∨ x = w}
  one_mem' := Or.inl rfl
  mul_mem' := by
    intro x y hx hy
    rcases hx with hx | hx <;> rcases hy with hy | hy
    · exact Or.inl (by simp [hx, hy])
    · exact Or.inr (by simp [hx, hy])
    · exact Or.inr (by simp [hx, hy])
    · exact Or.inl (by simpa [hx, hy, pow_two] using hw)
  inv_mem' := by
    intro x hx
    rcases hx with hx | hx
    · exact Or.inl (by simp [hx])
    · refine Or.inr ?_
      calc
        x⁻¹ = w⁻¹ := by rw [hx]
        _ = w⁻¹ * 1 := by simp
        _ = w⁻¹ * (w * w) := by
          rw [show w * w = 1 by simpa [pow_two] using hw]
        _ = w := by simp

@[simp] theorem mem_centralInvolutionSubgroup_iff
    (w : G) (hw : w ^ 2 = 1) (x : G) :
    x ∈ centralInvolutionSubgroup w hw ↔ x = 1 ∨ x = w :=
  Iff.rfl

@[simp] theorem involution_mem_centralInvolutionSubgroup
    (w : G) (hw : w ^ 2 = 1) :
    w ∈ centralInvolutionSubgroup w hw :=
  Or.inr rfl

@[simp] theorem coe_centralInvolutionSubgroup
    (w : G) (hw : w ^ 2 = 1) :
    (centralInvolutionSubgroup w hw : Set G) = {1, w} := by
  ext x
  simp [mem_centralInvolutionSubgroup_iff]

/-- The explicit involution subgroup lies in `K` exactly when `w` lies in
`K`; membership of `1` is automatic. -/
theorem centralInvolutionSubgroup_le_iff_mem
    (w : G) (hw : w ^ 2 = 1) (K : Subgroup G) :
    centralInvolutionSubgroup w hw ≤ K ↔ w ∈ K := by
  constructor
  · intro h
    exact h (involution_mem_centralInvolutionSubgroup w hw)
  · intro h x hx
    rcases (mem_centralInvolutionSubgroup_iff w hw x).mp hx with rfl | rfl
    · exact K.one_mem
    · exact h

/-- The explicit involution subgroup is finite, including in the degenerate
case `w = 1`. -/
noncomputable instance centralInvolutionSubgroup_finite
    (w : G) (hw : w ^ 2 = 1) :
    Finite (centralInvolutionSubgroup w hw) := by
  classical
  let decode : Fin 2 → centralInvolutionSubgroup w hw := fun i ↦
    if i = 0 then
      ⟨1, (centralInvolutionSubgroup w hw).one_mem⟩
    else
      ⟨w, involution_mem_centralInvolutionSubgroup w hw⟩
  apply Finite.of_surjective decode
  rintro ⟨x, hx⟩
  rcases hx with hx | hx
  · refine ⟨0, ?_⟩
    apply Subtype.ext
    simp [decode, hx]
  · refine ⟨1, ?_⟩
    apply Subtype.ext
    simp [decode, hx]

/-- Centrality of `w` makes its explicit involution subgroup normal.

Use the result as a local instance with
`letI := centralInvolutionSubgroup_normal w hw hcentral`. -/
theorem centralInvolutionSubgroup_normal
    (w : G) (hw : w ^ 2 = 1) (hcentral : ∀ g : G, Commute w g) :
    (centralInvolutionSubgroup w hw).Normal where
  conj_mem := by
    intro x hx g
    rcases (mem_centralInvolutionSubgroup_iff w hw x).mp hx with hx | hx
    · apply (mem_centralInvolutionSubgroup_iff w hw _).mpr
      exact Or.inl (by simp [hx])
    · apply (mem_centralInvolutionSubgroup_iff w hw _).mpr
      refine Or.inr ?_
      calc
        g * x * g⁻¹ = g * w * g⁻¹ := by rw [hx]
        _ = w * g * g⁻¹ := by rw [(hcentral g).eq]
        _ = w := by simp

/-- A nonidentity involution makes the explicit involution subgroup
nontrivial. -/
theorem centralInvolutionSubgroup_nontrivial
    (w : G) (hw : w ^ 2 = 1) (hne : w ≠ 1) :
    Nontrivial (centralInvolutionSubgroup w hw) :=
  ⟨⟨⟨w, involution_mem_centralInvolutionSubgroup w hw⟩,
      ⟨1, (centralInvolutionSubgroup w hw).one_mem⟩,
      fun h ↦ hne (congrArg Subtype.val h)⟩⟩

end CentralInvolutionSubgroup

end GroupApproximation
