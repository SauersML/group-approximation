import GroupApproximation.Sofic.InvolutionCollapseEndpoint
import Mathlib.GroupTheory.FreeGroup.Basic

/-!
# Corona projections with commuting orbits collapse

The involutive collapse endpoint places every collapse commutator of a
group-element witness in the MF radical.  This file bootstraps that
group-level theorem into a statement about arbitrary projections of the
corona algebra itself: if a projection `p` commutes with the compressed
image of a Kazhdan subgroup and its `L`-conjugation orbit commutes
pairwise, then `p` commutes with the full image.

The bootstrap needs no new analysis.  The sign `w = 1 - 2p` is a
self-adjoint unitary; the subgroup `E'` of the corona unitary group
generated by the represented group and `w` is countable; inside `E'` the
sign is literally an involutive compression witness; the kernel-checked
endpoint therefore makes the collapse commutators invisible in every
corona representation of `E'`; and instantiating that universal statement
at the inclusion `E' → U(Q)` itself turns invisibility into equality.

Consequently the relative commutant of a compressed Kazhdan image cannot
grow by projections with commuting orbits — the projection-generated half
of the compression dichotomy.  A one-line wrapper also records the direct
non-MF endpoint: a nontrivial involutive collapse commutator refutes
CDE-operator-MF-ness outright.
-/

namespace GroupApproximation

open scoped commutatorElement
namespace ProjectionCompressionCollapse

open InvolutionCollapseEndpoint

/-- The subgroup generated by a countable set of a group is countable. -/
theorem countable_subgroupClosure {H : Type*} [Group H] {S : Set H}
    (hS : S.Countable) : Countable (Subgroup.closure S) := by
  haveI : Countable ↥S := hS.to_subtype
  haveI : Countable (FreeGroup ↥S) := by
    have hmk : Function.Surjective (FreeGroup.mk (α := ↥S)) := by
      rintro ⟨L⟩
      exact ⟨L, FreeGroup.quot_mk_eq_mk.symm⟩
    exact hmk.countable
  rw [FreeGroup.closure_eq_range]
  exact (MonoidHom.rangeRestrict_surjective _).countable

/-- A nontrivial involutive compression-collapse commutator obstructs CDE
operator-MF-ness directly. -/
theorem not_isCDEOperatorMF_of_involutiveWitness {E : Type} [Group E]
    [Countable E] {L : Subgroup E}
    (hkazhdan : HasKazhdanPropertyT.{0, 0} ↥L) {s : E}
    (hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L) {k : E}
    (hk : IsInvolutiveCompressionWitness L s k)
    {γ : E} (hγ : γ ∈ L) (hne : ⁅γ, k⁆ ≠ 1) :
    ¬ IsCDEOperatorMF E := by
  intro hMF
  have hmem : ⁅γ, k⁆ ∈ actualCoronaMFResidual E :=
    actualCoronaMFInvisible_of_involutiveWitness hkazhdan hcomp hk hγ
  have hbot : actualCoronaMFResidual E = ⊥ :=
    isCDEOperatorMF_iff_actualCoronaMFResidual_eq_bot.mp hMF
  rw [hbot] at hmem
  exact hne (Subgroup.mem_bot.mp hmem)

/-- **Projection-orbit collapse.**  Let `L ≤ E` have property (T), let
`s` compress `L`, and let `pi` be a corona representation of `E`.  Every
projection of the corona that commutes with the compressed image and
whose `L`-conjugation orbit commutes pairwise already commutes with the
full image of `L`. -/
theorem corona_projection_collapse {E : Type} [Group E] [Countable E]
    (L : Subgroup E) (hT : HasKazhdanPropertyT.{0, 0} ↥L)
    {s : E} (hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L)
    (X : ℕ → FiniteModel) (hX : ∀ n, 0 < Fintype.card (X n)) :
    letI : ∀ n, Nonempty (X n) := fun n ↦ Fintype.card_pos_iff.mp (hX n)
    ∀ (pi : E →* unitary (NormMatrixCStarCorona (fun n ↦ X n)))
      (p : NormMatrixCStarCorona (fun n ↦ X n)),
      star p = p → p * p = p →
      (∀ γ ∈ L,
        ((pi (s * γ * s⁻¹) :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) * p =
          p * ((pi (s * γ * s⁻¹) :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n))) →
      (∀ γ₁ ∈ L, ∀ γ₂ ∈ L,
        Commute
          (((pi γ₁ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * p *
            star ((pi γ₁ :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)))
          (((pi γ₂ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * p *
            star ((pi γ₂ :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)))) →
      ∀ γ ∈ L,
        ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) * p =
          p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) := by
  classical
  letI : ∀ n, Nonempty (X n) := fun n ↦ Fintype.card_pos_iff.mp (hX n)
  intro pi p hsa hproj hpcomm horb γ hγ
  set w : NormMatrixCStarCorona (fun n ↦ X n) := 1 - 2 * p with hw_def
  have hwstar : star w = w := by
    rw [hw_def, star_sub, star_one]
    congr 1
    calc star ((2 : NormMatrixCStarCorona (fun n ↦ X n)) * p) =
        star p * star (2 : NormMatrixCStarCorona (fun n ↦ X n)) :=
          star_mul _ _
      _ = p * 2 := by rw [hsa, star_ofNat]
      _ = 2 * p := by rw [mul_two, ← two_mul]
  have hww : w * w = 1 := by
    have hexp : w * w = 1 - 4 * p + 4 * (p * p) := by
      rw [hw_def]
      noncomm_ring
    rw [hexp, hproj]
    noncomm_ring
  have hwmem : w ∈ unitary (NormMatrixCStarCorona (fun n ↦ X n)) := by
    refine ⟨?_, ?_⟩
    · rw [hwstar]
      exact hww
    · rw [hwstar]
      exact hww
  set wU : unitary (NormMatrixCStarCorona (fun n ↦ X n)) :=
    ⟨w, hwmem⟩ with hwU_def
  set S : Set (unitary (NormMatrixCStarCorona (fun n ↦ X n))) :=
    Set.range (fun e : E ↦ pi e) ∪ {wU} with hS_def
  set E' : Subgroup (unitary (NormMatrixCStarCorona (fun n ↦ X n))) :=
    Subgroup.closure S with hE'_def
  haveI hE'count : Countable ↥E' := countable_subgroupClosure
    ((Set.countable_range _).union (Set.countable_singleton _))
  have hrangeE' : ∀ e : E, pi e ∈ E' := fun e ↦
    Subgroup.subset_closure (Or.inl ⟨e, rfl⟩)
  have hwE' : wU ∈ E' := Subgroup.subset_closure (Or.inr rfl)
  have hle : L.map pi ≤ E' := by
    rintro _ ⟨e, _, rfl⟩
    exact hrangeE' e
  set L' : Subgroup ↥E' := (L.map pi).subgroupOf E' with hL'_def
  have hT' : HasKazhdanPropertyT.{0, 0} ↥L' := by
    have h₁ : HasKazhdanPropertyT.{0, 0} ↥(L.map pi) :=
      HasKazhdanPropertyT.of_surjective (pi.subgroupMap L)
        (MonoidHom.subgroupMap_surjective pi L) hT
    exact HasKazhdanPropertyT.of_mulEquiv
      (Subgroup.subgroupOfEquivOfLe hle) h₁
  set sE : ↥E' := ⟨pi s, hrangeE' s⟩ with hsE_def
  set kE : ↥E' := ⟨wU, hwE'⟩ with hkE_def
  have hcommE' : ∀ {a b : ↥E'},
      (((a : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) *
        ((b : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) =
        ((b : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) *
        ((a : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n))) → a * b = b * a :=
    fun hab ↦ Subtype.ext (Subtype.ext hab)
  have hval_conj : ∀ (γ' : ↥E') (δ : E), pi δ = (γ' : _) →
      (((sE * γ' * sE⁻¹ : ↥E') :
          unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) =
        ((pi (s * δ * s⁻¹) :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) := by
    intro γ' δ hπ
    have hEq : pi (s * δ * s⁻¹) = ((sE * γ' * sE⁻¹ : ↥E') :
        unitary (NormMatrixCStarCorona (fun n ↦ X n))) := by
      rw [map_mul, map_mul, map_inv, hπ]
      rfl
    rw [← hEq]
  have hcomp' : ∀ γ' ∈ L', sE * γ' * sE⁻¹ ∈ L' := by
    intro γ' hγ'
    rw [hL'_def, Subgroup.mem_subgroupOf] at hγ' ⊢
    obtain ⟨δ, hδL, hπ⟩ := Subgroup.mem_map.mp hγ'
    refine Subgroup.mem_map.mpr ⟨s * δ * s⁻¹, hcomp δ hδL, ?_⟩
    rw [map_mul, map_mul, map_inv, hπ]
    rfl
  have hk : IsInvolutiveCompressionWitness L' sE kE := by
    refine ⟨?_, ?_, ?_⟩
    · exact Subtype.ext (Subtype.ext hww)
    · intro γ' hγ'
      rw [hL'_def, Subgroup.mem_subgroupOf] at hγ'
      obtain ⟨δ, hδL, hπ⟩ := Subgroup.mem_map.mp hγ'
      refine hcommE' ?_
      rw [hval_conj γ' δ hπ]
      show ((pi (s * δ * s⁻¹) :
          unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) * w =
        w * ((pi (s * δ * s⁻¹) :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n))
      have hu := hpcomm δ hδL
      rw [hw_def]
      calc ((pi (s * δ * s⁻¹) :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) * (1 - 2 * p) =
          ((pi (s * δ * s⁻¹) :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) -
            2 * (((pi (s * δ * s⁻¹) :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * p) := by
            noncomm_ring
        _ = ((pi (s * δ * s⁻¹) :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) -
            2 * (p * ((pi (s * δ * s⁻¹) :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n))) := by
            rw [hu]
        _ = (1 - 2 * p) * ((pi (s * δ * s⁻¹) :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) := by
            noncomm_ring
    · intro γ₁' hγ₁' γ₂' hγ₂'
      rw [hL'_def, Subgroup.mem_subgroupOf] at hγ₁' hγ₂'
      obtain ⟨δ₁, hδ₁L, hπ₁⟩ := Subgroup.mem_map.mp hγ₁'
      obtain ⟨δ₂, hδ₂L, hπ₂⟩ := Subgroup.mem_map.mp hγ₂'
      have hval : ∀ (γ' : ↥E') (δ : E), pi δ = (γ' : _) →
          (((γ' * kE * γ'⁻¹ : ↥E') :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) =
            1 - 2 * (((pi δ :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * p *
              star ((pi δ :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n))) := by
        intro γ' δ hπ
        have hinvA : (((γ'⁻¹ : ↥E') :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) =
            star (((γ' : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n))) := by
          have hba : (((γ'⁻¹ : ↥E') :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) *
              (((γ' : ↥E') :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) = 1 := by
            have h0 : ((γ'⁻¹ * γ' : ↥E') :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) = 1 := by
              rw [inv_mul_cancel]
              rfl
            calc (((γ'⁻¹ : ↥E') :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) *
                (((γ' : ↥E') :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                  NormMatrixCStarCorona (fun n ↦ X n)) =
                (((γ'⁻¹ * γ' : ↥E') :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                  NormMatrixCStarCorona (fun n ↦ X n)) := rfl
              _ = 1 := by rw [h0]; rfl
          have hac : (((γ' : ↥E') :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) *
              star (((γ' : ↥E') :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) = 1 :=
            ((γ' : unitary (NormMatrixCStarCorona (fun n ↦ X n))).prop).2
          exact left_inv_eq_right_inv hba hac
        have hcoe : (((γ' * kE * γ'⁻¹ : ↥E') :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) =
            ((γ' : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * w *
              star ((γ' : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) := by
          calc (((γ' * kE * γ'⁻¹ : ↥E') :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) =
              ((γ' : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) * w *
                (((γ'⁻¹ : ↥E') :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                  NormMatrixCStarCorona (fun n ↦ X n)) := rfl
            _ = ((γ' : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) * w *
                star ((γ' :
                    unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                  NormMatrixCStarCorona (fun n ↦ X n)) := by
              rw [hinvA]
        rw [hcoe, ← hπ]
        have huu : ((pi δ :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) *
            star ((pi δ :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) = 1 :=
          ((pi δ).prop).2
        rw [hw_def]
        calc ((pi δ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * (1 - 2 * p) *
              star ((pi δ :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) =
            ((pi δ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) *
              star ((pi δ :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) -
              2 * (((pi δ :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n)) * p *
                star ((pi δ :
                    unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                  NormMatrixCStarCorona (fun n ↦ X n))) := by
              noncomm_ring
          _ = 1 - 2 * (((pi δ :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * p *
              star ((pi δ :
                  unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
                NormMatrixCStarCorona (fun n ↦ X n))) := by
              rw [huu]
      refine hcommE' ?_
      rw [hval γ₁' δ₁ hπ₁, hval γ₂' δ₂ hπ₂]
      have hab := (horb δ₁ hδ₁L δ₂ hδ₂L).eq
      set a₁ : NormMatrixCStarCorona (fun n ↦ X n) :=
        ((pi δ₁ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) * p *
          star ((pi δ₁ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) with ha₁_def
      set a₂ : NormMatrixCStarCorona (fun n ↦ X n) :=
        ((pi δ₂ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) * p *
          star ((pi δ₂ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) with ha₂_def
      calc (1 - 2 * a₁) * (1 - 2 * a₂) =
          1 - 2 * a₁ - 2 * a₂ + 4 * (a₁ * a₂) := by noncomm_ring
        _ = 1 - 2 * a₁ - 2 * a₂ + 4 * (a₂ * a₁) := by rw [hab]
        _ = (1 - 2 * a₂) * (1 - 2 * a₁) := by noncomm_ring
  set γE : ↥E' := ⟨pi γ, hrangeE' γ⟩ with hγE_def
  have hγE : γE ∈ L' := by
    rw [hL'_def, Subgroup.mem_subgroupOf]
    exact Subgroup.mem_map.mpr ⟨γ, hγ, rfl⟩
  have hInv :=
    actualCoronaMFInvisible_of_involutiveWitness hT' hcomp' hk hγE
  have hone := hInv X hX E'.subtype
  rw [map_commutatorElement] at hone
  have hcommU : Commute
      (γE : unitary (NormMatrixCStarCorona (fun n ↦ X n)))
      (kE : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :=
    commutatorElement_eq_one_iff_commute.mp hone
  have hcommA : ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
      NormMatrixCStarCorona (fun n ↦ X n)) * w =
      w * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) :=
    congrArg
      (fun u : unitary (NormMatrixCStarCorona (fun n ↦ X n)) ↦
        (u : NormMatrixCStarCorona (fun n ↦ X n)))
      hcommU.eq
  have hdiff : ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
      NormMatrixCStarCorona (fun n ↦ X n)) -
      2 * (((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) * p) =
      ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) -
      2 * (p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n))) := by
    calc ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) -
          2 * (((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) * p) =
        ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) * (1 - 2 * p) := by
          noncomm_ring
      _ = (1 - 2 * p) *
          ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) := by
          rw [← hw_def]
          exact hcommA
      _ = ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) -
          2 * (p * ((pi γ :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n))) := by
          noncomm_ring
  have h2 : (2 : NormMatrixCStarCorona (fun n ↦ X n)) *
      (((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) * p) =
      2 * (p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n))) :=
    sub_right_inj.mp hdiff
  have h4 : (2 : ℂ) •
      (((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) * p) =
      (2 : ℂ) •
      (p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n))) := by
    rw [Algebra.smul_def, Algebra.smul_def, map_ofNat]
    exact h2
  have hxx := inv_smul_smul₀ (two_ne_zero (α := ℂ))
    (((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
      NormMatrixCStarCorona (fun n ↦ X n)) * p)
  have hyy := inv_smul_smul₀ (two_ne_zero (α := ℂ))
    (p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
      NormMatrixCStarCorona (fun n ↦ X n)))
  calc ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
      NormMatrixCStarCorona (fun n ↦ X n)) * p =
      (2 : ℂ)⁻¹ • ((2 : ℂ) •
        (((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) * p)) := hxx.symm
    _ = (2 : ℂ)⁻¹ • ((2 : ℂ) •
        (p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)))) := by rw [h4]
    _ = p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) := hyy

end ProjectionCompressionCollapse
end GroupApproximation
