import GroupApproximation.Kazhdan.KazhdanUniverse
import GroupApproximation.Sofic.InvolutionCollapseEndpoint
import GroupApproximation.Analysis.CollapsePrintedProjectionCollapse
import Mathlib.GroupTheory.FreeGroup.Basic

/-!
# Corona projections with commuting orbits collapse

`thm:projection-collapse` of `non_mf_groups_exist.tex`: if a projection `p`
of the corona commutes with the compressed image of a Kazhdan subgroup and
its `L`-conjugation orbit commutes pairwise, then `p` commutes with the full
image.

`corona_projection_collapse` is proved by the **printed corona route** —
`Analysis/CollapsePrintedProjectionCollapse.printed_projection_collapse`,
which walks the manuscript's own proof: the join of the displacement
supports, the rank-normalized `Λ` on its ideal, the displacement cocycle,
and the Delorme–Guichardet contradiction.  The manuscript quantifies the
ambient group over an arbitrary universe while the corona machinery lives in
`Type 0`; the only universe step here is the descent to the subgroup `E'` of
the corona unitary group generated by the image, along which property `(T)`
moves in two moves — `liftUniverse` on the representation universe, then
`of_surjective` on the group.

This file used to prove the theorem by bootstrapping the finite-stage
involutive collapse endpoint through the sign `w = 1 - 2p`; that route still
exists in the tree, and the printed derivation of `thm:collapse` *from* this
theorem is `Sofic/CollapsePrintedCorollary`, so the printed logical order —
projection collapse first, the involutive corollary second — is now the
order of the formal dependencies as well.  The `routeGuards` pins in
`scripts/Audit.lean` keep it that way.

A one-line wrapper also records the direct non-MF endpoint: a nontrivial
involutive collapse commutator refutes CDE-operator-MF-ness outright.
-/

namespace GroupApproximation

open scoped commutatorElement
namespace ProjectionCompressionCollapse

open InvolutionCollapseEndpoint

universe u

/-- The subgroup generated by a countable set of a group is countable. -/
theorem countable_subgroupClosure {H : Type*} [Group H] {S : Set H}
    (hS : S.Countable) : Countable (Subgroup.closure S) := by
  haveI : Countable ↥S := hS.to_subtype
  haveI : Countable (FreeGroup ↥S) := by
    have hmk : Function.Surjective (FreeGroup.mk (α := ↥S)) := by
      rintro ⟨L⟩
      exact ⟨L, FreeGroup.quot_mk_eq_mk.symm⟩
    exact hmk.countable
  rw [FreeGroup.closure_eq_range]
  exact (MonoidHom.rangeRestrict_surjective _).countable

/-- A nontrivial involutive compression-collapse commutator obstructs CDE
operator-MF-ness directly. -/
theorem not_isCDEOperatorMF_of_involutiveWitness {E : Type} [Group E]
    [Countable E] {L : Subgroup E}
    (hkazhdan : HasKazhdanPropertyT.{0, 0} ↥L) {s : E}
    (hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L) {k : E}
    (hk : IsInvolutiveCompressionWitness L s k)
    {γ : E} (hγ : γ ∈ L) (hne : ⁅γ, k⁆ ≠ 1) :
    ¬ IsCDEOperatorMF E := by
  intro hMF
  have hmem : ⁅γ, k⁆ ∈ actualCoronaMFResidual E :=
    actualCoronaMFInvisible_of_involutiveWitness hkazhdan hcomp hk hγ
  have hbot : actualCoronaMFResidual E = ⊥ :=
    isCDEOperatorMF_iff_actualCoronaMFResidual_eq_bot.mp hMF
  rw [hbot] at hmem
  exact hne (Subgroup.mem_bot.mp hmem)

/-- **Projection-orbit collapse.**  Let `L ≤ E` have property (T), let
`s` compress `L`, and let `pi` be a corona representation of `E`.  Every
projection of the corona that commutes with the compressed image and
whose `L`-conjugation orbit commutes pairwise already commutes with the
full image of `L`.

The ambient group is countable but otherwise arbitrary, in any universe, as
the manuscript quantifies it.  The proof is the printed one —
`CollapsePrintedProjectionCollapse.printed_projection_collapse`, the corona
argument of `thm:projection-collapse` itself — applied to the subgroup `E'`
of the corona unitary group generated by the image of `E`, which lives in
`Type 0` whatever universe `E` came from.  The only universe step is on the
property `(T)` hypothesis, which descends to `E'` in two moves —
`liftUniverse` on the representation universe, then `of_surjective` on the
group. -/
theorem corona_projection_collapse :
    ∀ {E : Type u} [Group E] [_hcount : Countable E]
      (L : Subgroup E) (_hT : HasKazhdanPropertyT.{u, u} ↥L)
      {s : E} (_hcomp : ∀ γ ∈ L, s * γ * s⁻¹ ∈ L)
      (X : ℕ → FiniteModel) (hX : ∀ n, 0 < Fintype.card (X n)),
    letI : ∀ n, Nonempty (X n) := fun n ↦ Fintype.card_pos_iff.mp (hX n)
    ∀ (pi : E →* unitary (NormMatrixCStarCorona (fun n ↦ X n)))
      (p : NormMatrixCStarCorona (fun n ↦ X n)),
      star p = p → p * p = p →
      (∀ γ ∈ L,
        ((pi (s * γ * s⁻¹) :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) * p =
          p * ((pi (s * γ * s⁻¹) :
              unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n))) →
      (∀ γ₁ ∈ L, ∀ γ₂ ∈ L,
        Commute
          (((pi γ₁ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * p *
            star ((pi γ₁ :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)))
          (((pi γ₂ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)) * p *
            star ((pi γ₂ :
                unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
              NormMatrixCStarCorona (fun n ↦ X n)))) →
      ∀ γ ∈ L,
        ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) * p =
          p * ((pi γ : unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
            NormMatrixCStarCorona (fun n ↦ X n)) := by
  intro E _ _ L hT s hcomp X hX
  classical
  letI : ∀ n, Nonempty (X n) := fun n ↦ Fintype.card_pos_iff.mp (hX n)
  intro pi p hsa hproj hpcomm horb γ hγ
  -- Descend to the subgroup of the corona unitary group generated by the
  -- image of `E`; the printed proof runs there, in `Type 0`.  The descent is
  -- the same two-move pattern the finite-stage route used: `liftUniverse` on
  -- the representation universe, then `of_surjective` along the image.
  set E' : Subgroup (unitary (NormMatrixCStarCorona (fun n ↦ X n))) :=
    Subgroup.closure (Set.range (fun e : E ↦ pi e)) with hE'_def
  have hrangeE' : ∀ e : E, pi e ∈ E' := fun e ↦
    Subgroup.subset_closure ⟨e, rfl⟩
  have hle : L.map pi ≤ E' := by
    rintro _ ⟨e, _, rfl⟩
    exact hrangeE' e
  set L' : Subgroup ↥E' := (L.map pi).subgroupOf E' with hL'_def
  have hT' : HasKazhdanPropertyT.{0, 0} ↥L' := by
    have hlift : HasKazhdanPropertyT.{u, 0} ↥L :=
      HasKazhdanPropertyT.liftUniverse hT
    have h₁ : HasKazhdanPropertyT.{0, 0} ↥(L.map pi) :=
      HasKazhdanPropertyT.of_surjective (pi.subgroupMap L)
        (MonoidHom.subgroupMap_surjective pi L) hlift
    exact HasKazhdanPropertyT.of_mulEquiv
      (Subgroup.subgroupOfEquivOfLe hle) h₁
  set sE : ↥E' := ⟨pi s, hrangeE' s⟩ with hsE_def
  have hcomp' : ∀ γ' ∈ L', sE * γ' * sE⁻¹ ∈ L' := by
    intro γ' hγ'
    rw [hL'_def, Subgroup.mem_subgroupOf] at hγ' ⊢
    obtain ⟨δ, hδL, hπ⟩ := Subgroup.mem_map.mp hγ'
    refine Subgroup.mem_map.mpr ⟨s * δ * s⁻¹, hcomp δ hδL, ?_⟩
    rw [map_mul, map_mul, map_inv, hπ]
    rfl
  have hval_conj : ∀ (γ' : ↥E') (δ : E),
      pi δ = (γ' : unitary (NormMatrixCStarCorona (fun n ↦ X n))) →
      ((E'.subtype (sE * γ' * sE⁻¹) :
          unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n))
        = ((pi (s * δ * s⁻¹) :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) := by
    intro γ' δ hπ
    have hEq : pi (s * δ * s⁻¹)
        = (E'.subtype (sE * γ' * sE⁻¹) :
          unitary (NormMatrixCStarCorona (fun n ↦ X n))) := by
      rw [map_mul, map_mul, map_inv, hπ]
      rfl
    rw [← hEq]
  have hpcomm' : ∀ γ' ∈ L',
      ((E'.subtype (sE * γ' * sE⁻¹) :
          unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
        NormMatrixCStarCorona (fun n ↦ X n)) * p
        = p * ((E'.subtype (sE * γ' * sE⁻¹) :
            unitary (NormMatrixCStarCorona (fun n ↦ X n))) :
          NormMatrixCStarCorona (fun n ↦ X n)) := by
    intro γ' hγ'
    rw [hL'_def, Subgroup.mem_subgroupOf] at hγ'
    obtain ⟨δ, hδL, hπ⟩ := Subgroup.mem_map.mp hγ'
    rw [hval_conj γ' δ hπ]
    exact hpcomm δ hδL
  have horb' : ∀ γ₁' ∈ L', ∀ γ₂' ∈ L',
      Commute (ProjectionOrbitCollapse.conj E'.subtype p γ₁')
        (ProjectionOrbitCollapse.conj E'.subtype p γ₂') := by
    intro γ₁' hγ₁' γ₂' hγ₂'
    rw [hL'_def, Subgroup.mem_subgroupOf] at hγ₁' hγ₂'
    obtain ⟨δ₁, hδ₁L, hπ₁⟩ := Subgroup.mem_map.mp hγ₁'
    obtain ⟨δ₂, hδ₂L, hπ₂⟩ := Subgroup.mem_map.mp hγ₂'
    have h := horb δ₁ hδ₁L δ₂ hδ₂L
    rw [hπ₁, hπ₂] at h
    exact h
  have hmain := CollapsePrintedProjectionCollapse.printed_projection_collapse
    X L' hT' hcomp' E'.subtype p hsa hproj hpcomm' horb'
  have hγ' : (⟨pi γ, hrangeE' γ⟩ : ↥E') ∈ L' := by
    rw [hL'_def, Subgroup.mem_subgroupOf]
    exact Subgroup.mem_map.mpr ⟨γ, hγ, rfl⟩
  exact hmain ⟨pi γ, hrangeE' γ⟩ hγ'

end ProjectionCompressionCollapse
end GroupApproximation
