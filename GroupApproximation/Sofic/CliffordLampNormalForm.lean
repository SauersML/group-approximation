import GroupApproximation.Sofic.CliffordLampNormalFormSplice
import GroupApproximation.Meta.AxiomGuard

/-!
# The normal form of the presented Clifford lamp group

`toModel X : CliffordLamp X →* SignedModel X` (`Sofic/CliffordLampGroup.lean`) is onto but its
injectivity is not proved there.  This module proves it: for a linearly ordered `X`, `toModel X`
is bijective, giving the printed normal form "every element of `Cl(X)` is uniquely
`ε^a c_{x_1} ⋯ c_{x_r}`, `x_1 < ⋯ < x_r`, and the homomorphism is an isomorphism."  (The
consequent order formula `2^{|Y|+1}` for the subgroup generated by `ε` and `{c_y : y ∈ Y}`, for
finite `Y`, is not yet in this module; see the module's landing report.)

## Route

* `section'`: the explicit section `SignedModel X → CliffordLamp X`, `⟨a, f⟩ ↦ (1 or ε) *
  wordOfSupport f.support`.
* `section'_mul_modelLamp`/`section'_mul_modelSign`: `section'` intertwines right-multiplication
  by a generator's model image with right-multiplication by the generator itself, for *every*
  starting point, not just at the identity --- proved from `wordOfSupport_insert`
  (`Sofic/CliffordLampNormalFormSplice.lean`) and the crossing-form computation
  `crossing f (single x 1) = |{y ∈ support f : y > x}|`.
* `toModel_section'`: the easy direction, `toModel (section' m) = m`, by induction on the support.
* `section'_toModel`: the hard direction.  The naive property `g ↦ section' (toModel g) = g` is
  not closed under multiplication, since `section'` is not a homomorphism.  Instead, `Q h := ∀ n,
  section' (n * toModel h) = section' n * h` (universally quantified over `n`) *is* closed under
  multiplication and inverse, holds at `1`, and holds at each generator by the key lemmas above;
  bundling `{h | Q h}` as a `Subgroup` and applying
  `CliffordLamp.mem_subgroup_of_sign_mem_of_lamp_mem` gives `Q g` for every `g`, and specializing
  at `n = 1` gives the hard direction.
* `toModel_bijective`/`toModel_injective`/`toModel_surjective`.
-/

namespace GroupApproximation
namespace CliffordLampNormalForm

open CliffordLamp CliffordLampNormalFormSplice
open scoped commutatorElement

noncomputable section

variable {X : Type}

/-! ## `ZMod 2`-valued sign powers -/

theorem zmod2_eq_zero_or_one (a : ZMod 2) : a = 0 ∨ a = 1 := by revert a; decide

/-- The central sign, raised to a `ZMod 2` power: `1` if the exponent is `0`, `sign X` if it is
`1`.  Avoids `Nat`-power/`.val` arithmetic entirely. -/
def signPow (a : ZMod 2) : CliffordLamp X := if a = 0 then 1 else sign X

theorem signPow_zero : (signPow (X := X) 0) = 1 := by simp [signPow]

theorem signPow_one : (signPow (X := X) 1) = sign X := by simp [signPow]

theorem signPow_add (a b : ZMod 2) :
    signPow (X := X) (a + b) = signPow a * signPow b := by
  rcases zmod2_eq_zero_or_one a with rfl | rfl <;> rcases zmod2_eq_zero_or_one b with rfl | rfl
  · simp [signPow]
  · simp [signPow]
  · simp [signPow]
  · have h : (1 + 1 : ZMod 2) = 0 := by decide
    have hss : sign X * sign X = (1 : CliffordLamp X) := by simpa [pow_two] using sign_sq X
    rw [h, signPow_zero, signPow_one, hss]

theorem signPow_commute (a : ZMod 2) (g : CliffordLamp X) : Commute (signPow a) g := by
  rcases zmod2_eq_zero_or_one a with rfl | rfl
  · simp [signPow, Commute.one_left]
  · simpa [signPow] using sign_commute X g

theorem signPow_natCast (k : ℕ) : signPow (X := X) (k : ZMod 2) = sign X ^ k := by
  induction k with
  | zero => simp [signPow]
  | succ n ih =>
      have hcast : ((n + 1 : ℕ) : ZMod 2) = (n : ZMod 2) + 1 := by push_cast; ring
      rw [hcast, signPow_add, ih, signPow_one, pow_succ]

variable [LinearOrder X]

theorem toModel_signPow (c : ZMod 2) : toModel X (signPow c) = (⟨c, 0⟩ : SignedModel X) := by
  rcases zmod2_eq_zero_or_one c with rfl | rfl
  · rw [signPow_zero, map_one, one_def]
  · rw [signPow_one, toModel_sign, modelSign]

theorem modelSign_pow (k : ℕ) : modelSign X ^ k = (⟨(k : ZMod 2), 0⟩ : SignedModel X) := by
  rw [← toModel_sign, ← map_pow, ← signPow_natCast, toModel_signPow]

/-! ## The characteristic function of a finite set -/

omit [LinearOrder X] in
theorem finsupp_eq_sum_single_one (f : X →₀ ZMod 2) :
    f = ∑ y ∈ f.support, Finsupp.single y 1 := by
  conv_lhs => rw [← Finsupp.sum_single f]
  unfold Finsupp.sum
  apply Finset.sum_congr rfl
  intro y hy
  rcases zmod2_eq_zero_or_one (f y) with h0 | h1
  · exact absurd h0 (Finsupp.mem_support_iff.mp hy)
  · rw [h1]

/-- The crossing form of the characteristic function of `s` against a fresh singleton counts,
mod `2`, the points of `s` greater than `x` --- regardless of whether `x ∈ s` (crossing a point
against itself never counts, since `x < x` is false either way). -/
theorem crossing_finsetSum_single_right (s : Finset X) (x : X) :
    crossing X (∑ y ∈ s, Finsupp.single y (1 : ZMod 2)) (Finsupp.single x 1) =
      ((s.filter (x < ·)).card : ZMod 2) := by
  induction s using Finset.induction_on with
  | empty => simp [crossing_zero_left]
  | @insert y s hy ih =>
      rw [Finset.sum_insert hy, crossing_add_left, ih, crossing_single_single,
        Finset.filter_insert]
      by_cases hcase : x < y
      · rw [if_pos hcase, if_pos hcase,
          Finset.card_insert_of_notMem (fun hmem => hy (Finset.mem_filter.mp hmem).1)]
        push_cast
        ring
      · rw [if_neg hcase, if_neg hcase]
        simp

theorem crossing_eq_card_filter (f : X →₀ ZMod 2) (x : X) :
    crossing X f (Finsupp.single x 1) = ((f.support.filter (x < ·)).card : ZMod 2) := by
  conv_lhs => rw [finsupp_eq_sum_single_one f]
  exact crossing_finsetSum_single_right f.support x

/-! ## The explicit section -/

/-- The explicit section `SignedModel X → CliffordLamp X`: `⟨a, f⟩ ↦ (1 or ε) · ∏_{x ∈ support f}
c_x` (ascending). -/
def section' (m : SignedModel X) : CliffordLamp X :=
  signPow m.signPart * wordOfSupport m.config.support

theorem section'_def (m : SignedModel X) :
    section' m = signPow m.signPart * wordOfSupport m.config.support := rfl

@[simp] theorem section'_one : section' (1 : SignedModel X) = 1 := by
  rw [section'_def, one_def]
  simp [signPow_zero]

theorem section'_mul_modelSign (n : SignedModel X) :
    section' (n * modelSign X) = section' n * sign X := by
  obtain ⟨a, f⟩ := n
  have hmul : (⟨a, f⟩ : SignedModel X) * modelSign X = ⟨a + 1, f⟩ := by
    rw [modelSign, mul_def]
    apply SignedModel.ext
    · show a + 1 + crossing X f (0 : X →₀ ZMod 2) = a + 1
      rw [crossing_zero_right, add_zero]
    · show f + (0 : X →₀ ZMod 2) = f
      rw [add_zero]
  have hcomm : sign X * wordOfSupport f.support = wordOfSupport f.support * sign X := by
    have h1 := wordOfList_mul_sign_pow_comm (f.support.sort (· ≤ ·)) 1
    rw [pow_one] at h1
    rw [wordOfSupport_def]
    exact h1.symm
  rw [hmul, section'_def, section'_def, signPow_add, signPow_one]
  calc signPow a * sign X * wordOfSupport f.support
      = signPow a * (sign X * wordOfSupport f.support) := by rw [mul_assoc]
    _ = signPow a * (wordOfSupport f.support * sign X) := by rw [hcomm]
    _ = signPow a * wordOfSupport f.support * sign X := by rw [mul_assoc]

/-- Adding a fresh singleton to a `ZMod 2`-valued `Finsupp` either erases the point (if it was
already present) or inserts it (if it was not). -/
theorem finsupp_support_add_single (f : X →₀ ZMod 2) (x : X) :
    (f + Finsupp.single x 1).support =
      if x ∈ f.support then f.support.erase x else insert x f.support := by
  ext y
  by_cases hxy : y = x
  · subst hxy
    rw [Finsupp.mem_support_iff, Finsupp.add_apply, Finsupp.single_eq_same]
    split_ifs with hx
    · apply iff_of_false
      · simp only [ne_eq, not_not]
        rcases zmod2_eq_zero_or_one (f y) with h0 | h1
        · exact absurd h0 (Finsupp.mem_support_iff.mp hx)
        · rw [h1]; decide
      · exact Finset.notMem_erase y f.support
    · apply iff_of_true
      · rw [Finsupp.notMem_support_iff.mp hx]; decide
      · exact Finset.mem_insert_self y f.support
  · rw [Finsupp.mem_support_iff, Finsupp.add_apply, Finsupp.single_eq_of_ne hxy, add_zero]
    split_ifs with hx
    · rw [Finset.mem_erase]; simp [hxy, Finsupp.mem_support_iff]
    · rw [Finset.mem_insert]; simp [hxy, Finsupp.mem_support_iff]

theorem section'_mul_modelLamp (n : SignedModel X) (x : X) :
    section' (n * modelLamp X x) = section' n * lamp X x := by
  obtain ⟨a, f⟩ := n
  have hval : (⟨a, f⟩ : SignedModel X) * modelLamp X x =
      ⟨a + crossing X f (Finsupp.single x 1), f + Finsupp.single x 1⟩ := by
    rw [modelLamp, mul_def]
    apply SignedModel.ext
    · show a + 0 + crossing X f (Finsupp.single x 1) = a + crossing X f (Finsupp.single x 1)
      rw [add_zero]
    · rfl
  rw [hval, section'_def, section'_def, crossing_eq_card_filter, wordOfSupport_def,
    wordOfSupport_def, finsupp_support_add_single]
  by_cases hx : x ∈ f.support
  · rw [if_pos hx]
    have herase : f.support = insert x (f.support.erase x) := (Finset.insert_erase hx).symm
    have hxnotin : x ∉ f.support.erase x := Finset.notMem_erase x f.support
    have hk : (f.support.erase x).filter (x < ·) = f.support.filter (x < ·) := by
      conv_rhs => rw [herase]
      rw [Finset.filter_insert, if_neg (lt_irrefl x)]
    have hins : wordOfList (f.support.sort (· ≤ ·)) =
        sign X ^ (f.support.filter (x < ·)).card *
          wordOfList ((f.support.erase x).sort (· ≤ ·)) * lamp X x := by
      have h0 := wordOfSupport_insert hxnotin
      rw [hk] at h0
      rw [wordOfSupport_def, wordOfSupport_def] at h0
      conv_lhs => rw [herase]
      exact h0
    rw [hins, ← signPow_natCast]
    symm
    calc signPow a * (signPow ((f.support.filter (x < ·)).card : ZMod 2) *
          wordOfList ((f.support.erase x).sort (· ≤ ·)) * lamp X x) * lamp X x
        = signPow a * signPow ((f.support.filter (x < ·)).card : ZMod 2) *
            wordOfList ((f.support.erase x).sort (· ≤ ·)) * (lamp X x * lamp X x) := by
          simp only [mul_assoc]
      _ = signPow a * signPow ((f.support.filter (x < ·)).card : ZMod 2) *
            wordOfList ((f.support.erase x).sort (· ≤ ·)) := by rw [lamp_sq_mul_self, mul_one]
      _ = signPow (a + ((f.support.filter (x < ·)).card : ZMod 2)) *
            wordOfList ((f.support.erase x).sort (· ≤ ·)) := by rw [signPow_add]
  · rw [if_neg hx]
    have hins2 : wordOfList ((insert x f.support).sort (· ≤ ·)) =
        sign X ^ (f.support.filter (x < ·)).card * wordOfList (f.support.sort (· ≤ ·)) *
          lamp X x := by
      have h0 := wordOfSupport_insert hx
      rw [wordOfSupport_def, wordOfSupport_def] at h0
      exact h0
    rw [hins2, ← signPow_natCast]
    have hzero : ((f.support.filter (x < ·)).card : ZMod 2) +
        ((f.support.filter (x < ·)).card : ZMod 2) = 0 := CharTwo.add_self_eq_zero _
    calc signPow (a + ((f.support.filter (x < ·)).card : ZMod 2)) *
          (signPow ((f.support.filter (x < ·)).card : ZMod 2) *
            wordOfList (f.support.sort (· ≤ ·)) * lamp X x)
        = signPow (a + ((f.support.filter (x < ·)).card : ZMod 2)) *
            signPow ((f.support.filter (x < ·)).card : ZMod 2) *
            wordOfList (f.support.sort (· ≤ ·)) * lamp X x := by simp only [mul_assoc]
      _ = signPow ((a + ((f.support.filter (x < ·)).card : ZMod 2)) +
            ((f.support.filter (x < ·)).card : ZMod 2)) *
            wordOfList (f.support.sort (· ≤ ·)) * lamp X x := by rw [← signPow_add]
      _ = signPow a * wordOfList (f.support.sort (· ≤ ·)) * lamp X x := by
          rw [add_assoc, hzero, add_zero]

/-! ## The easy direction: `toModel ∘ section' = id` -/

theorem toModel_wordOfSupport (s : Finset X) :
    toModel X (wordOfSupport s) = (⟨0, ∑ y ∈ s, Finsupp.single y 1⟩ : SignedModel X) := by
  induction s using Finset.induction_on with
  | empty => simp [wordOfSupport_empty, one_def]
  | @insert x s hx ih =>
      rw [wordOfSupport_insert hx, map_mul, map_mul, map_pow, toModel_sign, modelSign_pow,
        toModel_lamp, ih, Finset.sum_insert hx, modelLamp, mul_def, mul_def]
      have hc : crossing X (∑ y ∈ s, Finsupp.single y (1 : ZMod 2)) (Finsupp.single x 1) =
          ((s.filter (x < ·)).card : ZMod 2) := crossing_finsetSum_single_right s x
      apply SignedModel.ext
      · show ((s.filter (x < ·)).card : ZMod 2) + (0 : ZMod 2) +
            crossing X (0 : X →₀ ZMod 2) (∑ y ∈ s, Finsupp.single y 1) + 0 +
            crossing X ((0 : X →₀ ZMod 2) + ∑ y ∈ s, Finsupp.single y 1)
              (Finsupp.single x 1) = (0 : ZMod 2)
        rw [crossing_zero_left, add_zero, add_zero, add_zero, zero_add, hc,
          CharTwo.add_self_eq_zero]
      · show (0 : X →₀ ZMod 2) + ∑ y ∈ s, Finsupp.single y 1 + Finsupp.single x 1 =
          Finsupp.single x 1 + ∑ y ∈ s, Finsupp.single y 1
        rw [zero_add, add_comm]

theorem toModel_section' (m : SignedModel X) : toModel X (section' m) = m := by
  obtain ⟨a, f⟩ := m
  rw [section'_def, map_mul, toModel_signPow, toModel_wordOfSupport]
  rw [← finsupp_eq_sum_single_one]
  apply SignedModel.ext
  · show (a : ZMod 2) + 0 + crossing X (0 : X →₀ ZMod 2) f = a
    rw [crossing_zero_left, add_zero, add_zero]
  · show (0 : X →₀ ZMod 2) + f = f
    rw [zero_add]

/-! ## The hard direction: `section' ∘ toModel = id` -/

/-- The property that makes the closure induction on the presented group's generating set
work: unlike `g ↦ section' (toModel g) = g`, this is closed under multiplication and inverse,
since it is universally quantified over the starting point `n`. -/
def satisfiesQ (h : CliffordLamp X) : Prop :=
  ∀ n : SignedModel X, section' (n * toModel X h) = section' n * h

theorem satisfiesQ_one : satisfiesQ (X := X) 1 := by
  intro n
  rw [map_one, mul_one, mul_one]

theorem satisfiesQ_mul {g h : CliffordLamp X} (hg : satisfiesQ g) (hh : satisfiesQ h) :
    satisfiesQ (g * h) := by
  intro n
  rw [map_mul, ← mul_assoc, hh, hg, mul_assoc]

theorem satisfiesQ_inv {h : CliffordLamp X} (hh : satisfiesQ h) : satisfiesQ h⁻¹ := by
  intro n
  have heq := hh (n * (toModel X h)⁻¹)
  rw [mul_assoc, inv_mul_cancel, mul_one] at heq
  rw [map_inv]
  calc section' (n * (toModel X h)⁻¹)
      = section' (n * (toModel X h)⁻¹) * h * h⁻¹ := by
        rw [mul_assoc, mul_inv_cancel, mul_one]
    _ = section' n * h⁻¹ := by rw [← heq]

theorem satisfiesQ_sign : satisfiesQ (X := X) (sign X) := by
  intro n
  rw [toModel_sign, section'_mul_modelSign]

theorem satisfiesQ_lamp (x : X) : satisfiesQ (lamp X x) := by
  intro n
  rw [toModel_lamp, section'_mul_modelLamp]

/-- The subgroup of elements satisfying `Q`. -/
def qSubgroup : Subgroup (CliffordLamp X) where
  carrier := {h | satisfiesQ h}
  one_mem' := satisfiesQ_one
  mul_mem' hg hh := satisfiesQ_mul hg hh
  inv_mem' hh := satisfiesQ_inv hh

theorem mem_qSubgroup_iff {h : CliffordLamp X} : h ∈ (qSubgroup (X := X)) ↔ satisfiesQ h := Iff.rfl

theorem satisfiesQ_all (g : CliffordLamp X) : satisfiesQ g :=
  mem_qSubgroup_iff.mp
    (mem_subgroup_of_sign_mem_of_lamp_mem X qSubgroup
      (mem_qSubgroup_iff.mpr satisfiesQ_sign)
      (fun x => mem_qSubgroup_iff.mpr (satisfiesQ_lamp x)) g)

theorem section'_toModel (g : CliffordLamp X) : section' (toModel X g) = g := by
  have h := satisfiesQ_all g 1
  rwa [one_mul, section'_one, one_mul] at h

/-! ## Bijectivity and the normal form -/

theorem toModel_injective : Function.Injective (toModel X) :=
  Function.LeftInverse.injective section'_toModel

theorem toModel_surjective : Function.Surjective (toModel X) :=
  Function.RightInverse.surjective toModel_section'

theorem toModel_bijective : Function.Bijective (toModel X) :=
  ⟨toModel_injective, toModel_surjective⟩

/-- **The printed normal form.**  Every element of `Cl(X)` is uniquely `ε^a c_{x_1} ⋯ c_{x_r}`,
`x_1 < ⋯ < x_r`: `toModel X` is a bijection onto `SignedModel X`, with explicit two-sided inverse
`section'`. -/
theorem toModel_bijective_printed :
    Function.Bijective (toModel X) ∧
      Function.LeftInverse section' (toModel X) ∧
      Function.RightInverse section' (toModel X) :=
  ⟨toModel_bijective, section'_toModel, toModel_section'⟩

end
end CliffordLampNormalForm
end GroupApproximation

