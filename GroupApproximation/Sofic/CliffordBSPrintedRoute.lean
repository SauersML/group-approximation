import GroupApproximation.Sofic.CliffordBSAmenable
import GroupApproximation.Sofic.NormMFCoronaRadical
import GroupApproximation.Monsters.LiteralCyclicCalibration
import GroupApproximation.Monsters.LiteralDyadicCalibration
import Mathlib.GroupTheory.Solvable

/-!
# The sharpness paragraph along the route it prints

`non_mf_groups_exist.tex`, `\section{The cyclic comparison}`, paragraph
*Sharpness of the Kazhdan hypothesis* (grep `"hence MF by"`, never a line
number: the file is edited concurrently).  The printed argument is a chain of
six steps:

1. `BS(1,2) ≅ ℤ[1/2] ⋊ ℤ` is solvable;
2. the Clifford lamp group on its coset space is locally finite;
3. hence their semidirect product is amenable;
4. the realized Clifford quotient of `thm:C` is a subgroup of that product, so
   it is amenable;
5. hence it is MF, by Tikuisis--White--Winter;
6. composing the quotient map with a faithful homomorphism of that quotient
   into `U(Q)` gives `Θ : E_BS → U(Q)` with `Θ(w_BS) ≠ 1`, so
   `w_BS ∉ Res_MF(E_BS)` and property `(T)` cannot be dropped from the central
   involution obstruction.

Steps 1--4 and 6 are elementary and are machine-checked here on the
repository's own objects: `Sofic.CliffordBSAmenable` already supplies steps 2--4
for the rational-overgroup model that carries `thm:C`'s realized quotient, and
`Monsters.LiteralDyadicCalibration` supplies all of steps 1--4 for the literal
`ℤ[1/2] ⋊ ℤ` the paragraph names (collected here as `literalAffine_chain`).
This file adds step 1 for the overgroup model (`isSolvable_BSLike`) and step 6,
and assembles the whole chain.

Step 5 is the single external input, and it is written out as the mathematical
claim it is, in the binder of every theorem that consumes it:

    ∀ (G : Type) [Group G] [Countable G], IsAmenable G → IsOperatorMF G

It is not wrapped in a name, not tagged, and not postulated.  A reader of any
type below sees the whole of what the sharpness paragraph imports from the
literature without following an indirection, and every theorem here either does
not mention it at all or takes it as its only non-structural premise.  That is
the shape the paragraph has in print, and the trust surface is exactly one
hypothesis wide.

Two things this module deliberately does not do.

* It does not discharge that hypothesis, and it does not route it through
  `Sofic.CliffordBSAmenable`'s `AmenableImpliesMF` -- a `Prop` structure that
  nothing in this repository ever inhabits, which is exactly the shape the house
  rules forbid.  `Analysis.AmenableQuasidiagonal` shows why no substitute is
  available: permutation operator-norm defects are `0` or at least `1`, so
  permutation models certify exactly the LEF groups, and
  `Monsters.CyclicBaseLEFObstruction` proves the realized quotient is not LEF.
* It does not compete with `Sofic.CliffordBSAmenableMF`.  That module reaches
  the *endpoint* of step 6 with no hypothesis at all, by exhibiting an explicit
  monomial corona model of the seven printed relators.  That is a different
  route from the printed one, and it is deliberately kept separate: what is
  formalized here is the argument the manuscript prints, hypothesis and all.
-/

namespace GroupApproximation
namespace CliffordBSPrintedRoute

open CyclicBaseCalibration LiteralCyclicCalibration
open scoped commutatorElement

/-! ## Step 1: the affine base is solvable -/

/-- **Step 1.**  The affine model is solvable: it is an extension of an abelian
group by an abelian group, split by the semidirect product structure.  The
manuscript writes the base as `ℤ[1/2] ⋊ ℤ`; the repository models the
translation part by all of `Multiplicative ℚ`, which contains it, so this is
the statement for an overgroup of the printed one. -/
theorem isSolvable_BSLike : IsSolvable BSLike :=
  solvable_of_ker_le_range
    (SemidirectProduct.inl : Multiplicative ℚ →* BSLike)
    (SemidirectProduct.rightHom : BSLike →* Multiplicative ℤ)
    (le_of_eq
      (SemidirectProduct.range_inl_eq_ker_rightHom
        (φ := CyclicBaseCalibration.actingHom)).symm)

/-- The Baumslag--Solitar copy itself --- the subgroup generated by the two
distinguished elements `γ₀` and `t` --- is solvable, solvability passing to
subgroups. -/
theorem isSolvable_baumslagSolitarCopy :
    IsSolvable ↥(Subgroup.closure ({gammaZero, tZero} : Set BSLike)) := by
  haveI := isSolvable_BSLike
  infer_instance

/-! ## Steps 2--4: amenability of the realized quotient -/

/-- **Steps 2--4.**  The lamp group is locally finite, hence amenable; the
semidirect product of it with the solvable affine base is amenable; and the
realized Clifford quotient of `thm:C`, being a subgroup of that product, is
amenable.  Every step is machine-checked in `Sofic.CliffordBSAmenable`; this
records the two clauses the paragraph states, at the group it states them
about. -/
theorem ambient_and_realizedQuotient_isAmenable :
    Amenability.IsAmenable CliffordBS ∧
      Amenability.IsAmenable RealizedQuotient :=
  ⟨Amenability.isAmenable_of_hasInvariantMean hasInvariantMean_CliffordBS,
    isAmenable_subgroup_CliffordBS realization.range⟩

/-- The realized quotient is countable, being a homomorphic image of the
finitely presented group `E_BS`. -/
instance realizedQuotient_countable : Countable RealizedQuotient :=
  Function.Surjective.countable quotientMap_surjective

/-- **Steps 1--4 in the manuscript's own group.**  The paragraph names
`BS(1,2) ≅ ℤ[1/2] ⋊ ℤ`, not the rational overgroup, and
`Monsters.LiteralDyadicCalibration` builds exactly that: the literal affine
group, its literal coset space, its literal Clifford extension, and its own
realized quotient of `thm:C`, which detects the marked word.  The four
elementary steps are already machine-checked there; this collects them so that
the reader sees the printed chain on the printed objects.

The realized quotient of `thm:C`'s badge is the rational-overgroup one, which
is why the conclusion below is drawn there rather than here. -/
theorem literalAffine_chain :
    IsSolvable DyadicRationals.Affine ∧
      Amenability.HasInvariantMean
        (LiteralDyadicCalibration.CliffordDyadic) ∧
      Amenability.IsAmenable LiteralDyadicCalibration.DyadicRealizedQuotient ∧
      LiteralDyadicCalibration.dyadicQuotientMap mark ≠ 1 :=
  ⟨LiteralDyadicCalibration.affine_isSolvable,
    LiteralDyadicCalibration.hasInvariantMean_cliffordDyadic,
    LiteralDyadicCalibration.isAmenable_dyadicRealizedQuotient,
    LiteralDyadicCalibration.dyadicQuotientMap_mark_ne_one⟩

/-- **What the word "solvable" is doing in the printed sentence.**  The
paragraph offers solvability as the reason the affine base is amenable.  There
is no general `solvable ⟹ amenable` theorem in this repository, and none in the
pinned Mathlib --- which has no amenability API at all --- so the inference is
recorded here in the only honest form: the two abelian terms of the affine
group's solvable series each carry an invariant mean, and the extension
inherits one.  That is the printed inference on the printed group, and it is
strictly more than "it is solvable" supplies, since it exhibits the means
rather than quoting a theorem about the class.

`hasInvariantMean_dyadic` is itself the directed union of the cyclic groups
`⟨1/2ⁿ⟩`, so the whole chain bottoms out in `hasInvariantMean_zpowers`. -/
theorem literalAffine_solvable_series_amenable :
    IsSolvable DyadicRationals.Affine ∧
      Amenability.HasInvariantMean
        (Multiplicative DyadicRationals.Dyadic) ∧
      Amenability.HasInvariantMean (Multiplicative ℤ) ∧
      Amenability.HasInvariantMean DyadicRationals.Affine :=
  ⟨LiteralDyadicCalibration.affine_isSolvable,
    LiteralDyadicCalibration.hasInvariantMean_dyadic,
    Amenability.hasInvariantMean_int,
    LiteralDyadicCalibration.hasInvariantMean_affine⟩

/-! ## Step 5: the external input, used once

The step is written out as the mathematical claim it is, in the binder of the
theorem that consumes it, rather than hidden behind a name.  A reader of
`isOperatorMF_realizedQuotient`'s type sees the whole of what the sharpness
paragraph imports from the literature without following an indirection, and
`Sofic.CliffordBSAmenable`'s `AmenableImpliesMF` -- a `Prop` structure with no
inhabitant anywhere -- is deliberately not used here. -/

/-- **Step 5.**  Granting Tikuisis--White--Winter and nothing else, the realized
Clifford quotient is operator-MF.  The amenability half of the implication is
fully machine-checked above; the binder `tww` is the entire external input, and
no inhabitant of it is constructed or postulated anywhere in this repository.

`Analysis.AmenableQuasidiagonal` shows why it cannot simply be discharged:
permutation operator-norm models have defect `0` or at least `1`, so they
certify exactly the LEF groups, and the realized quotient is not LEF
(`Monsters.CyclicBaseLEFObstruction`). -/
theorem isOperatorMF_realizedQuotient
    (tww : ∀ (G : Type) [Group G] [Countable G],
      Amenability.IsAmenable G → IsOperatorMF G) :
    IsOperatorMF RealizedQuotient :=
  tww _ (isAmenable_subgroup_CliffordBS realization.range)

/-! ## Step 6: composing with a faithful representation of the quotient -/

/-- **Step 6.**  A faithful homomorphism of the realized quotient into the
unitary group of a cofinite norm-matrix corona, precomposed with the quotient
map of `thm:C`, is a homomorphism of `E_BS` itself that does not kill the
marked word.  This is the paragraph's `Θ`.

The only input beyond `thm:C` is `tww`; the composition step uses nothing but
injectivity of the faithful representation and
`LiteralCyclicCalibration.quotientMap_mark_ne_one`. -/
theorem exists_coronaRepresentation_mark_ne_one
    (tww : ∀ (G : Type) [Group G] [Countable G],
      Amenability.IsAmenable G → IsOperatorMF G) :
    ∃ X : ℕ → FiniteModel, (∀ n, 0 < Fintype.card (X n)) ∧
      ∃ Theta : LiteralGroup →* NormMatrixCoronaUnitary X,
        Theta mark ≠ 1 := by
  obtain ⟨X, hX, rho, hrho⟩ := isOperatorMF_realizedQuotient tww
  refine ⟨X, hX, rho.comp quotientMap, ?_⟩
  intro hcon
  apply quotientMap_mark_ne_one
  apply hrho
  rw [map_one]
  exact hcon

/-- The marked word of `E_BS` is not invisible to cofinite norm-matrix coronas,
along the printed route. -/
theorem mark_not_coronaMFInvisible
    (tww : ∀ (G : Type) [Group G] [Countable G],
      Amenability.IsAmenable G → IsOperatorMF G) :
    ¬ CoronaMFInvisible (mark : LiteralGroup) := by
  intro hinv
  obtain ⟨X, hX, Theta, hTheta⟩ := exists_coronaRepresentation_mark_ne_one tww
  exact hTheta (hinv X hX Theta)

/-- **`w_BS ∉ Res_MF(E_BS)`**, the paragraph's conclusion in the radical
language of `\section{Consequences}`, along the printed route. -/
theorem mark_notMem_coronaMFResidual
    (tww : ∀ (G : Type) [Group G] [Countable G],
      Amenability.IsAmenable G → IsOperatorMF G) :
    (mark : LiteralGroup) ∉ coronaMFResidual LiteralGroup :=
  fun hmem => mark_not_coronaMFInvisible tww hmem

/-- The same statement for the universal-ultraproduct presentation of the
radical. -/
theorem mark_notMem_normMFResidual
    (tww : ∀ (G : Type) [Group G] [Countable G],
      Amenability.IsAmenable G → IsOperatorMF G) :
    (mark : LiteralGroup) ∉ normMFResidual LiteralGroup := by
  rw [← coronaMFResidual_eq_normMFResidual]
  exact mark_notMem_coronaMFResidual tww

/-! ## What sharpness means: the configuration is the obstruction's, minus (T)

The central involution obstruction asks for a subgroup compressed one-sidedly
by a stable letter and centralized by an involution, and concludes that the
marked commutator dies in every homomorphism to `U(Q)`.  `E_BS` supplies that
configuration with the cyclic group `⟨γ₀⟩` in place of a Kazhdan group, and the
marked word survives.  So the Kazhdan hypothesis is doing work: the rest of the
configuration is present and is not enough. -/

/-- The compression configuration of `E_BS`: the cyclic base contains `γ₀`, the
stable letter compresses it one-sidedly, the lamp centralizes it, and the
marked word is the obstruction's marked commutator. -/
theorem cyclicBase_configuration :
    gamma ∈ LiteralCyclicCalibration.cyclicBase ∧
      (∀ g ∈ LiteralCyclicCalibration.cyclicBase,
        stable * g * stable⁻¹ ∈ LiteralCyclicCalibration.cyclicBase) ∧
      (∀ g ∈ LiteralCyclicCalibration.cyclicBase, lamp * g = g * lamp) ∧
      mark = markedCompressionWord stable gamma lamp :=
  ⟨gamma_mem_cyclicBase, stable_compresses_cyclicBase,
    lamp_centralizes_cyclicBase, mark_eq_markedCompressionWord⟩

/-- **The sharpness paragraph, exactly as printed.**  Steps 1--4 and 6 are
proved; step 5 is the hypothesis `tww` and enters once.

The conjuncts, in the order of the paragraph: the affine base is solvable, both
in the repository's rational overgroup and in the literal `ℤ[1/2] ⋊ ℤ` the
paragraph names, whose own realized quotient is amenable too; the
Clifford--affine extension is amenable; the realized quotient of `thm:C` is a
subgroup of it and so is amenable; granting `tww` it is therefore MF; the
quotient map
detects the marked word, so composing with a faithful representation of the
quotient gives a homomorphism of `E_BS` to a corona unitary group that does not
kill the mark; and hence the mark lies outside the MF radical of `E_BS`, while
the compression configuration of the central involution obstruction is present
in `E_BS` with the cyclic base in place of a Kazhdan one. -/
theorem manuscriptSharpnessPrintedRoute
    (tww : ∀ (G : Type) [Group G] [Countable G],
      Amenability.IsAmenable G → IsOperatorMF G) :
    IsSolvable BSLike ∧
      IsSolvable DyadicRationals.Affine ∧
      Amenability.IsAmenable
        LiteralDyadicCalibration.DyadicRealizedQuotient ∧
      Amenability.IsAmenable CliffordBS ∧
      Amenability.IsAmenable RealizedQuotient ∧
      IsOperatorMF RealizedQuotient ∧
      quotientMap mark ≠ 1 ∧
      (∃ X : ℕ → FiniteModel, (∀ n, 0 < Fintype.card (X n)) ∧
        ∃ Theta : LiteralGroup →* NormMatrixCoronaUnitary X, Theta mark ≠ 1) ∧
      (mark : LiteralGroup) ∉ coronaMFResidual LiteralGroup ∧
      (mark : LiteralGroup) ∉ normMFResidual LiteralGroup ∧
      (gamma ∈ LiteralCyclicCalibration.cyclicBase ∧
        (∀ g ∈ LiteralCyclicCalibration.cyclicBase,
          stable * g * stable⁻¹ ∈ LiteralCyclicCalibration.cyclicBase) ∧
        (∀ g ∈ LiteralCyclicCalibration.cyclicBase, lamp * g = g * lamp) ∧
        mark = markedCompressionWord stable gamma lamp) :=
  ⟨isSolvable_BSLike,
    LiteralDyadicCalibration.affine_isSolvable,
    LiteralDyadicCalibration.isAmenable_dyadicRealizedQuotient,
    ambient_and_realizedQuotient_isAmenable.1,
    ambient_and_realizedQuotient_isAmenable.2,
    isOperatorMF_realizedQuotient tww,
    quotientMap_mark_ne_one,
    exists_coronaRepresentation_mark_ne_one tww,
    mark_notMem_coronaMFResidual tww,
    mark_notMem_normMFResidual tww,
    cyclicBase_configuration⟩

end CliffordBSPrintedRoute
end GroupApproximation
