import GroupApproximation.Sofic.LiteralNonMFLinearWitness

/-!
# The literal base surjects onto its exact affine matrix model

The twenty printed base relators define a canonical homomorphism from the
literal presented base to the subgroup of `GL₄(ℚ)` generated by the six
displayed affine matrices.  This module proves, without any presentation
completeness assumption, that this homomorphism is surjective.

The direction matters.  Since Kazhdan's property `(T)` passes to quotients,
property `(T)` of the literal presented base would imply property `(T)` of
the matrix group.  Surjectivity alone does not transfer property `(T)` back
to the presented group; that requires either injectivity of this map or a
direct Kazhdan proof for the literal presentation.
-/

namespace GroupApproximation
namespace LiteralBaseAffineQuotient

open ExplicitLinearModel LiteralNonMFLinearWitness LiteralNonMFPresentation

noncomputable section

/-- Evaluation of the six literal base generators in the exact affine
matrix group. -/
noncomputable def affineQuotient : Base →* gammaBar :=
  PresentedGroup.toGroup matrixBaseGenerator_kills

@[simp] theorem affineQuotient_generator (i : BaseGenerator) :
    affineQuotient (PresentedGroup.of i) = matrixBaseGenerator i := by
  simp [affineQuotient]

/-- Each one of the six named affine generators lies in the range of the
canonical map from the literal base. -/
theorem matrixBaseGenerator_mem_range (i : BaseGenerator) :
    matrixBaseGenerator i ∈ affineQuotient.range :=
  ⟨PresentedGroup.of i, affineQuotient_generator i⟩

/-- The canonical map from the literal base onto the exact affine matrix
group is surjective.  This uses only the definition of `gammaBar` as the
subgroup generated by the same six matrices. -/
theorem affineQuotient_surjective : Function.Surjective affineQuotient := by
  rw [← MonoidHom.range_eq_top]
  apply top_unique
  intro g _
  have hgenerators :
      gammaBar.subtype ⁻¹'
          ({xU, yU, zU, v1U, v2U, v3U} : Set Matˣ) ≤ affineQuotient.range := by
    intro u hu
    rcases hu with h | h | h | h | h | h
    · rw [show u = xG from Subtype.ext h]
      simpa [matrixBaseGenerator, v1Index, v2Index, v3Index, xIndex]
        using matrixBaseGenerator_mem_range xIndex
    · rw [show u = yG from Subtype.ext h]
      simpa [matrixBaseGenerator, v1Index, v2Index, v3Index, xIndex, yIndex]
        using matrixBaseGenerator_mem_range yIndex
    · rw [show u = zG from Subtype.ext h]
      simpa [matrixBaseGenerator, v1Index, v2Index, v3Index, xIndex, yIndex,
        zIndex] using matrixBaseGenerator_mem_range zIndex
    · rw [show u = v1G from Subtype.ext h]
      simpa [matrixBaseGenerator]
        using matrixBaseGenerator_mem_range v1Index
    · rw [show u = v2G from Subtype.ext h]
      simpa [matrixBaseGenerator, v1Index, v2Index]
        using matrixBaseGenerator_mem_range v2Index
    · rw [Set.mem_singleton_iff] at h
      rw [show u = v3G from Subtype.ext h]
      simpa [matrixBaseGenerator, v1Index, v2Index, v3Index]
        using matrixBaseGenerator_mem_range v3Index
  have hclosure :
      Subgroup.closure
          (gammaBar.subtype ⁻¹'
            ({xU, yU, zU, v1U, v2U, v3U} : Set Matˣ)) ≤
        affineQuotient.range :=
    (Subgroup.closure_le _).mpr hgenerators
  have htop :
      Subgroup.closure
          (gammaBar.subtype ⁻¹'
            ({xU, yU, zU, v1U, v2U, v3U} : Set Matˣ)) = ⊤ :=
    Subgroup.closure_preimage_eq_top
      ({xU, yU, zU, v1U, v2U, v3U} : Set Matˣ)
  exact hclosure (htop.symm ▸ Subgroup.mem_top g)

end

end LiteralBaseAffineQuotient
end GroupApproximation
