import GroupApproximation.Sofic.NormalKazhdanMFRadical
import GroupApproximation.Sofic.NormMFResidualFunctorial
import GroupApproximation.Sofic.NormallyGeneratedMFObstruction
import GroupApproximation.Sofic.CDEMFRadical
import GroupApproximation.Sofic.OperatorMFIncreasingDimensions
import GroupApproximation.Algebra.GroupTorsionFree
import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.GroupTheory.Subgroup.Simple

/-!
# The torsion-free full-MF-radical construction

This file formalizes the algebraic and operator-MF part of the proposed
Fournier-Facio--Hull construction.  There are two deliberately explicit
interfaces.

Here **MF group** has the precise Carrión--Dadarlat--Eckhardt meaning.  The
literal predicate `IsCDEOperatorMF G` asks for an embedding into the unitary
group of a genuine cofinite norm-matrix C-star corona.  The equivalent
unitary-sequence predicate is `IsOperatorMF G`; their equivalence is proved by
formal polar correction in `CDEOperatorMF`.  Strictly increasing matrix sizes
are also proved equivalent in `OperatorMFIncreasingDimensions`.

Neither predicate is a definition of MF-ness of the reduced group C-star
algebra or of the full group C-star algebra.  Those are separate notions.

* `FournierFacioDefectData` records the HNN relations used to expose a marked
  Kazhdan-compression pattern, together with the simple subgroup and one
  noncommuting witness.  From these data Lean proves that the simple subgroup
  is contained in the compression defect.
* `FiveConditionRoutingData` records exactly the five conditions the
  manuscript prints for the routed quotient, and nothing else.  It is the
  interface the two cited endpoint theorems consume.
* `DefectRoutingData` records the output of the relative common-quotient
  construction.  The existence of this output is the literature-dependent
  acylindrical-small-cancellation step and is not postulated as an axiom here.
  It is strictly stronger than the printed five conditions: it also carries
  survival of the protected simple-factor element, which is what makes the
  routed quotient nontrivial and hence non-MF itself.
* `OrderPreservingRoutingData` closes that gap along the route the manuscript
  prints.  From a torsion-free source and a routing map that preserves element
  orders — the clause the manuscript quotes from Hull's theorem — both
  torsion-freeness of the quotient and survival of the protected element are
  proved rather than assumed.

Once routing is supplied, the mapped compression defect is the whole quotient.
The already formalized normal-Kazhdan compression theorem then proves that the
whole quotient is its MF radical.  The quotient-hereditary and MF-target
consequences are proved as well.

Mathlib currently has no formal theory of acylindrically hyperbolic groups or
Hull's suitable-subgroup small cancellation.  Accordingly this file does not
encode those words as opaque predicates and does not claim an unconditional
existence theorem for the routed data.  It formalizes exactly the part of the
argument whose definitions and theorems exist in the present trust surface.
-/

namespace GroupApproximation

open scoped commutatorElement

universe u v

/-! ## Elementary profile predicates -/

/-- A group is generated by two specified elements. -/
def IsTwoGenerated (G : Type u) [Group G] : Prop :=
  ∃ x y : G, Subgroup.closure ({x, y} : Set G) = ⊤

/-! ## The hidden Fournier-Facio defect -/

/-- Proof-carrying algebraic input extracted from the Fournier-Facio HNN
skeleton.

`u` is the first stable letter, `s` is the selected element of the simple
factor, and `iota` is the property-`(T)` base map.  The field
`commutesAfterCompression` is precisely `[S,P₁]=1` in the paper.  The
element `witness` is the base element called `r` there. -/
structure FournierFacioDefectData
    (P : Type) (E : Type u) [Group P] [Group E] where
  /-- The property-`(T)` base map. -/
  iota : P →* E
  /-- The first stable letter. -/
  u : E
  /-- A selected nonidentity element of the simple factor. -/
  s : E
  /-- Property `(T)` of the base. -/
  kazhdan : HasKazhdanPropertyT.{0, 0} P
  /-- Conjugation by `u` compresses the base into itself. -/
  compresses : ∀ p : P, ∃ q : P, u * iota p * u⁻¹ = iota q
  /-- The selected simple-factor element commutes with the compressed base. -/
  commutesAfterCompression :
    ∀ p : P, Commute s (u * iota p * u⁻¹)
  /-- The embedded simple factor. -/
  simpleSubgroup : Subgroup E
  [simple : IsSimpleGroup simpleSubgroup]
  /-- The selected element belongs to the simple factor. -/
  s_mem : s ∈ simpleSubgroup
  /-- A base element witnessing that `s` is not central in the simple factor. -/
  witness : P
  /-- The witness also belongs to the simple factor. -/
  witness_mem : iota witness ∈ simpleSubgroup
  /-- The chosen commutator is nontrivial. -/
  witness_commutator_ne_one : ⁅s, iota witness⁆ ≠ 1

namespace FournierFacioDefectData

variable {P : Type} {E : Type u} [Group P] [Group E]
    (D : FournierFacioDefectData P E)

local instance defectSimpleSubgroup : IsSimpleGroup D.simpleSubgroup := D.simple

/-- The marked Kazhdan-compression core hidden in the HNN skeleton.  Its root
is `u⁻¹ s u`, so transporting the root by `u` recovers `s`. -/
def core : KazhdanCompressionCore P E where
  iota := D.iota
  t := D.u
  c := D.u⁻¹ * D.s * D.u
  kazhdan := D.kazhdan
  compresses := D.compresses
  comm_c p := by
    show D.u⁻¹ * D.s * D.u * D.iota p =
      D.iota p * (D.u⁻¹ * D.s * D.u)
    have h := (D.commutesAfterCompression p).eq
    calc
      D.u⁻¹ * D.s * D.u * D.iota p =
          D.u⁻¹ * (D.s * (D.u * D.iota p * D.u⁻¹)) * D.u := by
            group
      _ = D.u⁻¹ * ((D.u * D.iota p * D.u⁻¹) * D.s) * D.u := by
            rw [h]
      _ = D.iota p * (D.u⁻¹ * D.s * D.u) := by
            group

/-- The transported root of the hidden pattern is the chosen simple-factor
element `s`. -/
@[simp] theorem core_transported : D.core.transported = D.s := by
  unfold core KazhdanCompressionCore.transported
  dsimp
  group

/-- The defect is exactly the normal closure of the displayed commutators
`[s,ι(p)]`. -/
theorem core_defectNormal_eq :
    D.core.defectNormal =
      Subgroup.normalClosure (Set.range fun p : P ↦ ⁅D.s, D.iota p⁆) := by
  unfold KazhdanCompressionCore.defectNormal
    KazhdanCompressionCore.defectSet
  rw [D.core_transported]
  rfl

/-- The chosen nontrivial commutator lies in the hidden compression defect. -/
theorem witness_commutator_mem_defectNormal :
    ⁅D.s, D.iota D.witness⁆ ∈ D.core.defectNormal := by
  rw [← D.core_transported]
  exact D.core.defect_mem_defectNormal D.witness

/-- The selected simple-factor element is nontrivial.  Otherwise its chosen
commutator witness would be trivial. -/
theorem s_ne_one : D.s ≠ 1 := by
  intro hs
  apply D.witness_commutator_ne_one
  rw [hs]
  simp

/-- **Defect saturation.**  The embedded simple factor is contained in the
normal closure of the compression defects.

The proof takes the preimage of the defect in the simple subgroup.  It is a
normal subgroup containing the selected nontrivial commutator, hence it is
the whole simple subgroup. -/
theorem simpleSubgroup_le_defectNormal :
    D.simpleSubgroup ≤ D.core.defectNormal := by
  let N : Subgroup D.simpleSubgroup :=
    D.core.defectNormal.comap D.simpleSubgroup.subtype
  letI : N.Normal := inferInstance
  have hcomm_mem_simple : ⁅D.s, D.iota D.witness⁆ ∈ D.simpleSubgroup := by
    rw [commutatorElement_def]
    exact D.simpleSubgroup.mul_mem
      (D.simpleSubgroup.mul_mem
        (D.simpleSubgroup.mul_mem D.s_mem D.witness_mem)
        (D.simpleSubgroup.inv_mem D.s_mem))
      (D.simpleSubgroup.inv_mem D.witness_mem)
  let x : D.simpleSubgroup :=
    ⟨⁅D.s, D.iota D.witness⁆, hcomm_mem_simple⟩
  have hxN : x ∈ N := by
    change ⁅D.s, D.iota D.witness⁆ ∈ D.core.defectNormal
    exact D.witness_commutator_mem_defectNormal
  have hxne : x ≠ 1 := by
    intro hx
    apply D.witness_commutator_ne_one
    exact congrArg Subtype.val hx
  have hNtop : N = ⊤ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal N inferInstance with
      hNbot | hNtop
    · exfalso
      have hxone : x = 1 := Subgroup.mem_bot.mp (hNbot ▸ hxN)
      exact hxne hxone
    · exact hNtop
  intro y hy
  have hyN : (⟨y, hy⟩ : D.simpleSubgroup) ∈ N := by
    rw [hNtop]
    exact Subgroup.mem_top _
  exact hyN

end FournierFacioDefectData

/-! ## Hereditary transport of the full radical -/

/-- Full corona MF radical passes through every surjective homomorphism.  The
target's countability is derived from the countable source. -/
theorem coronaMFResidual_eq_top_of_surjective
    {G : Type u} {H : Type v} [Group G] [Group H] [Countable G]
    (hG : coronaMFResidual G = ⊤) (f : G →* H)
    (hf : Function.Surjective f) : coronaMFResidual H = ⊤ := by
  letI : Countable H := hf.countable
  apply top_unique
  intro y _
  obtain ⟨x, rfl⟩ := hf y
  have hx : x ∈ coronaMFResidual G := by
    rw [hG]
    exact Subgroup.mem_top x
  exact map_coronaMFResidual_le f ⟨x, hx, rfl⟩

/-! ## The printed five-condition interface -/

/-- **The five conditions the manuscript prints, and nothing else.**

The closing question of the manuscript reads: it suffices to construct a
quotient `q : E' ↠ Q` of the ascending HNN extension `E'` over
Fournier-Facio's torsion-free finitely presented property-`(T)` group,
"subject to five conditions: `Q` is finitely presented; `Q` has
property~(T); `Q` is torsion-free; `Q` is generated by two elements; and
`q(N_comp) = Q`".

This structure records precisely those five conditions over a
`FournierFacioDefectData`, reading `N_comp` as the compression defect
`D.core.defectNormal`.  It carries no sixth field.  In particular there is
no survival hypothesis `q s ≠ 1`, because the printed list contains none;
the endpoint theorems that cite that sentence must therefore not assume
one, and must not conclude nontriviality of `Q` either, since the trivial
group satisfies all five conditions.

`DefectRoutingData` below is the strictly stronger interface that does
carry survival, and `OrderPreservingRoutingData` derives survival from the
order-preservation clause the manuscript quotes from Hull's theorem.

Surjectivity of `q` — the `↠` of the printed sentence — is deliberately
not a field either: `quotient_surjective` below derives it from the fifth
condition, so this interface assumes strictly less than the prose grants. -/
structure FiveConditionRoutingData
    {P : Type} {E : Type u} [Group P] [Group E]
    (D : FournierFacioDefectData P E) where
  /-- The group `Q` of the printed sentence. -/
  Quotient : Type
  [groupQuotient : Group Quotient]
  /-- The map `q` of the printed sentence. -/
  quotient : E →* Quotient
  /-- Printed condition 1: `Q` is finitely presented. -/
  [finitelyPresented : Group.IsFinitelyPresented Quotient]
  /-- Printed condition 2: `Q` has property `(T)`. -/
  kazhdan : HasKazhdanPropertyT.{0, 0} Quotient
  /-- Printed condition 3: `Q` is torsion-free, in the power form used
  throughout this library. -/
  torsionFree : IsPowerTorsionFree Quotient
  /-- The first of the two generators of printed condition 4. -/
  generatorOne : Quotient
  /-- The second of the two generators of printed condition 4. -/
  generatorTwo : Quotient
  /-- Printed condition 4: `Q` is generated by two elements. -/
  generates :
    Subgroup.closure ({generatorOne, generatorTwo} : Set Quotient) = ⊤
  /-- Printed condition 5: `q(N_comp) = Q`. -/
  defect_surjective : D.core.defectNormal.map quotient = ⊤

namespace FiveConditionRoutingData

variable {P : Type} {E : Type u} [Group P] [Group E]
    {D : FournierFacioDefectData P E}
    (R : FiveConditionRoutingData.{u} D)

local instance fiveConditionQuotientGroup : Group R.Quotient := R.groupQuotient
local instance fiveConditionQuotientFinitelyPresented :
    Group.IsFinitelyPresented R.Quotient := R.finitelyPresented

/-- The `↠` of the printed sentence is not an extra assumption: the fifth
printed condition `q(N_comp) = Q` already forces `q` to be onto, because
every element of the quotient is the image of a defect element. -/
theorem quotient_surjective : Function.Surjective R.quotient := by
  intro y
  have hy : y ∈ D.core.defectNormal.map R.quotient := by
    rw [R.defect_surjective]
    exact Subgroup.mem_top y
  obtain ⟨x, -, hx⟩ := Subgroup.mem_map.mp hy
  exact ⟨x, hx⟩

/-- A finitely presented quotient is countable. -/
theorem quotientCountable : Countable R.Quotient := by
  obtain ⟨n, f, hsurj, -⟩ := R.finitelyPresented.out
  letI : Countable (FreeGroup (Fin n)) := by
    have hfree : Function.Surjective
        (FreeGroup.mk : List (Fin n × Bool) → FreeGroup (Fin n)) := by
      intro g
      obtain ⟨L, hL⟩ := Quot.exists_rep g
      exact ⟨L, by rw [← FreeGroup.quot_mk_eq_mk, hL]⟩
    exact hfree.countable
  exact hsurj.countable

local instance fiveConditionQuotientCountable : Countable R.Quotient :=
  R.quotientCountable

/-- Printed condition 4 in the form the endpoint states it. -/
theorem isTwoGenerated : IsTwoGenerated R.Quotient :=
  ⟨R.generatorOne, R.generatorTwo, R.generates⟩

/-- Defect routing commutes with descent of the marked pattern: the defect of
the mapped core is the whole quotient. -/
theorem mapped_defectNormal_eq_top :
    (D.core.map R.quotient).defectNormal = ⊤ := by
  apply top_unique
  rw [← R.defect_surjective]
  exact D.core.map_subgroup_le_defectNormal R.quotient
    D.core.defectNormal le_rfl

/-- **Full MF radical.**  Every element of the routed quotient is invisible
in every standard cofinite norm-matrix corona.  Only the printed conditions
are used: property `(T)` and `q(N_comp) = Q`. -/
theorem coronaMFResidual_eq_top :
    coronaMFResidual R.Quotient = ⊤ := by
  letI : Countable R.Quotient := R.quotientCountable
  have hTtop :
      HasKazhdanPropertyT.{0, 0} (⊤ : Subgroup R.Quotient) :=
    HasKazhdanPropertyT.of_mulEquiv Subgroup.topEquiv R.kazhdan
  have htop_le : (⊤ : Subgroup R.Quotient) ≤
      coronaMFResidual R.Quotient := by
    apply KazhdanCompressionCore.normalKazhdan_le_coronaMFResidual
      (D.core.map R.quotient) (⊤ : Subgroup R.Quotient) hTtop
    rw [R.mapped_defectNormal_eq_top]
  exact top_unique htop_le

/-- **Literal CDE full radical.**  Every element is killed by every
homomorphism into the unitary group of every genuine norm-matrix C-star
corona.  This is the manuscript's "equal to its own MF radical". -/
theorem cdeMFResidual_eq_top : cdeMFResidual R.Quotient = ⊤ := by
  rw [cdeMFResidual_eq_coronaMFResidual]
  exact R.coronaMFResidual_eq_top

/-- Ultraproduct-language form of the full-radical theorem. -/
theorem normMFResidual_eq_top :
    normMFResidual R.Quotient = ⊤ := by
  letI : Countable R.Quotient := R.quotientCountable
  rw [← coronaMFResidual_eq_normMFResidual]
  exact R.coronaMFResidual_eq_top

/-- Every representation of the routed quotient in a standard cofinite
norm-matrix corona is the trivial homomorphism. -/
theorem coronaRepresentation_eq_one
    (X : ℕ → FiniteModel) (hX : ∀ n, 0 < Fintype.card (X n))
    (rho : R.Quotient →* NormMatrixCoronaUnitary X) : rho = 1 := by
  apply MonoidHom.ext
  intro g
  have hg : g ∈ coronaMFResidual R.Quotient := by
    rw [R.coronaMFResidual_eq_top]
    exact Subgroup.mem_top g
  exact hg X hX rho

/-- **Every homomorphism to a matrix quotient is trivial.**  This is the
printed consequence: a representation of the routed quotient in the unitary
group of a genuine CDE norm-matrix C-star corona is the trivial map. -/
theorem cdeCoronaRepresentation_eq_one
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (hX : ∀ n, 0 < Fintype.card (X n))
    (rho : R.Quotient →*
      unitary (NormMatrixCStarCorona (fun n ↦ X n))) : rho = 1 := by
  let sigma : R.Quotient →* NormMatrixCoronaUnitary X :=
    (normMatrixCoronaUnitaryEquiv X).symm.toMonoidHom.comp rho
  have hsigma : sigma = 1 := R.coronaRepresentation_eq_one X hX sigma
  apply MonoidHom.ext
  intro g
  apply (normMatrixCoronaUnitaryEquiv X).symm.injective
  simpa [sigma] using DFunLike.congr_fun hsigma g

/-- Every homomorphism from the routed quotient to any operator-MF group is
trivial.  The target need not be countable. -/
theorem hom_eq_one_to_isOperatorMF
    {M : Type*} [Group M] (hM : IsOperatorMF M)
    (f : R.Quotient →* M) : f = 1 := by
  letI : Countable R.Quotient := R.quotientCountable
  apply MonoidHom.ext
  intro g
  exact map_eq_one_of_normMFResidual_eq_top_to_isOperatorMF
    R.normMFResidual_eq_top hM f g

/-- Every homomorphism from the routed quotient to a finite group is
trivial. -/
theorem hom_eq_one_to_finite
    (M : Type) [Group M] [Finite M] (f : R.Quotient →* M) : f = 1 :=
  hom_eq_one_of_residual_eq_top_to_finite R.normMFResidual_eq_top M f

/-- Every homomorphism from the routed quotient to a countable residually
finite group is trivial. -/
theorem hom_eq_one_to_residuallyFinite
    {M : Type*} [Group M] [Countable M] [Group.ResiduallyFinite M]
    (f : R.Quotient →* M) : f = 1 :=
  hom_eq_one_of_residual_eq_top_to_residuallyFinite
    R.normMFResidual_eq_top f

/-- The routed quotient has no nontrivial finite quotient. -/
theorem no_nontrivial_finite_quotient
    (M : Type) [Group M] [Finite M] [Nontrivial M]
    (f : R.Quotient →* M) : ¬ Function.Surjective f :=
  not_surjective_of_residual_eq_top_to_finite
    R.normMFResidual_eq_top M f

/-- Every quotient of the routed group again has full corona MF radical. -/
theorem quotient_coronaMFResidual_eq_top
    {H : Type*} [Group H] (q : R.Quotient →* H)
    (hq : Function.Surjective q) : coronaMFResidual H = ⊤ := by
  letI : Countable R.Quotient := R.quotientCountable
  exact coronaMFResidual_eq_top_of_surjective
    R.coronaMFResidual_eq_top q hq

/-- Every quotient of the routed group has full ultraproduct norm-MF
residual as well. -/
theorem quotient_normMFResidual_eq_top
    {H : Type*} [Group H] (q : R.Quotient →* H)
    (hq : Function.Surjective q) : normMFResidual H = ⊤ := by
  letI : Countable R.Quotient := R.quotientCountable
  letI : Countable H := hq.countable
  rw [← coronaMFResidual_eq_normMFResidual]
  exact R.quotient_coronaMFResidual_eq_top q hq

/-- **Every nontrivial quotient fails to be MF.**  Nontriviality is required
of the target `H`, which is exactly where the manuscript puts it; no
survival hypothesis on the routed group itself is needed. -/
theorem quotient_not_isOperatorMF
    {H : Type*} [Group H] [Nontrivial H]
    (q : R.Quotient →* H) (hq : Function.Surjective q) :
    ¬ IsOperatorMF H := by
  letI : Countable R.Quotient := R.quotientCountable
  letI : Countable H := hq.countable
  intro hMF
  have htop : coronaMFResidual H = ⊤ :=
    R.quotient_coronaMFResidual_eq_top q hq
  have hbot : coronaMFResidual H = ⊥ :=
    isOperatorMF_iff_coronaMFResidual_eq_bot.mp hMF
  obtain ⟨x, hx⟩ := exists_ne (1 : H)
  have hxres : x ∈ coronaMFResidual H := by
    rw [htop]
    exact Subgroup.mem_top x
  rw [hbot] at hxres
  exact hx (Subgroup.mem_bot.mp hxres)

/-- Literal CDE form: every nontrivial quotient of the routed group fails to
embed in the unitary group of a norm-matrix C-star corona. -/
theorem quotient_not_isCDEOperatorMF
    {H : Type*} [Group H] [Countable H] [Nontrivial H]
    (q : R.Quotient →* H) (hq : Function.Surjective q) :
    ¬ IsCDEOperatorMF H := by
  rw [isCDEOperatorMF_iff_isOperatorMF]
  exact R.quotient_not_isOperatorMF q hq

end FiveConditionRoutingData

/-! ## The relative common-quotient output -/

/-- The algebraic output of the relative two-stage common-quotient theorem,
including both epimorphisms.

`source` is the map from the Fournier--Facio HNN skeleton, while `kazhdanMap`
is the map from the torsion-free hyperbolic Kazhdan input.  The finite
protected set used by the manuscript is `{1,s}`.  Acylindrical hyperbolicity
is deliberately absent: the present library has no definition of that
notion. -/
structure RelativeCommonQuotientData
    {P : Type} {E : Type u} [Group P] [Group E]
    (D : FournierFacioDefectData P E)
    (B : Type) [Group B] where
  Quotient : Type
  [groupQuotient : Group Quotient]
  source : E →* Quotient
  source_surjective : Function.Surjective source
  kazhdanMap : B →* Quotient
  kazhdanMap_surjective : Function.Surjective kazhdanMap
  [finitelyPresented : Group.IsFinitelyPresented Quotient]
  defect_surjective : D.core.defectNormal.map source = ⊤
  protected_injective : Set.InjOn source ({1, D.s} : Set E)
  generatorOne : Quotient
  generatorTwo : Quotient
  generates :
    Subgroup.closure ({generatorOne, generatorTwo} : Set Quotient) = ⊤
  torsionFree : IsPowerTorsionFree Quotient

/-- Proof-carrying output of the two-stage defect-routing construction.

This is data rather than an existence axiom.  In the intended application,
Hull's relative small-cancellation argument supplies `Quotient`, `quotient`,
the two generators, torsion preservation, finite presentation, and the fact
that the original defect maps onto the entire quotient.

**This interface is strictly stronger than the printed five conditions.**
Beyond `FiveConditionRoutingData` it carries `protected_ne_one`, the
survival of the protected simple-factor element.  That extra field is not
one of the five printed conditions and is not a consequence of them — the
trivial group meets all five — so it may not appear, directly or through
a `Nontrivial Q` conclusion, in the endpoint theorems the manuscript cites.
It is what makes the routed quotient itself non-MF, rather than only its
nontrivial quotients.  `RelativeCommonQuotientData.toDefectRoutingData`
derives it from injectivity on the protected set, and
`OrderPreservingRoutingData.toDefectRoutingData` derives it from order
preservation; neither postulates it. -/
structure DefectRoutingData
    {P : Type} {E : Type u} [Group P] [Group E]
    (D : FournierFacioDefectData P E) where
  /-- The routed common quotient. -/
  Quotient : Type
  [groupQuotient : Group Quotient]
  /-- The quotient map from the HNN skeleton. -/
  quotient : E →* Quotient
  /-- The map is onto. -/
  quotient_surjective : Function.Surjective quotient
  /-- The routed quotient is finitely presented. -/
  [finitelyPresented : Group.IsFinitelyPresented Quotient]
  /-- Property `(T)`, obtained from the second common-quotient map. -/
  kazhdan : HasKazhdanPropertyT.{0, 0} Quotient
  /-- The original compression defect maps onto the whole quotient. -/
  defect_surjective : D.core.defectNormal.map quotient = ⊤
  /-- The protected simple-factor element survives. -/
  protected_ne_one : quotient D.s ≠ 1
  /-- First generator produced by the second routing stage. -/
  generatorOne : Quotient
  /-- Second generator produced by the second routing stage. -/
  generatorTwo : Quotient
  /-- The two routed elements generate the quotient. -/
  generates :
    Subgroup.closure ({generatorOne, generatorTwo} : Set Quotient) = ⊤
  /-- Hull's torsion-preservation conclusion, in power form. -/
  torsionFree : IsPowerTorsionFree Quotient

namespace RelativeCommonQuotientData

variable {P : Type} {E : Type u} {B : Type}
    [Group P] [Group E] [Group B]
    {D : FournierFacioDefectData P E}
    (C : RelativeCommonQuotientData D B)

local instance relativeCommonQuotientGroup : Group C.Quotient := C.groupQuotient
local instance relativeCommonQuotientFinitelyPresented :
    Group.IsFinitelyPresented C.Quotient := C.finitelyPresented

/-- A Kazhdan common-quotient input produces precisely the routed data used by
the MF-radical argument.  In particular, property `(T)` is derived through
the second epimorphism rather than postulated for the quotient. -/
def toDefectRoutingData (hB : HasKazhdanPropertyT.{0, 0} B) :
    DefectRoutingData D where
  Quotient := C.Quotient
  groupQuotient := C.groupQuotient
  quotient := C.source
  quotient_surjective := C.source_surjective
  finitelyPresented := C.finitelyPresented
  kazhdan := HasKazhdanPropertyT.of_surjective
    C.kazhdanMap C.kazhdanMap_surjective hB
  defect_surjective := C.defect_surjective
  protected_ne_one := by
    intro hs
    apply D.s_ne_one
    apply C.protected_injective
    · simp
    · simp
    · simpa using hs
  generatorOne := C.generatorOne
  generatorTwo := C.generatorTwo
  generates := C.generates
  torsionFree := C.torsionFree

end RelativeCommonQuotientData

namespace DefectRoutingData

variable {P : Type} {E : Type u} [Group P] [Group E]
    {D : FournierFacioDefectData P E}
    (R : DefectRoutingData.{u} D)

local instance routedRadicalQuotientGroup : Group R.Quotient := R.groupQuotient
local instance routedRadicalQuotientFinitelyPresented :
    Group.IsFinitelyPresented R.Quotient := R.finitelyPresented

/-- **Forgetting survival lands exactly on the printed five conditions.**
Dropping `protected_ne_one` and re-deriving surjectivity of `quotient`
from `defect_surjective` turns routing data into the interface the
manuscript prints, which is how the cited endpoint theorems consume it.

Marked reducible so that the theorems below, which are exactly this
forgetful map composed with the printed-interface proofs, typecheck against
the routed quotient's own instances without a transparency detour. -/
@[reducible] def toFiveConditionRoutingData : FiveConditionRoutingData D where
  Quotient := R.Quotient
  groupQuotient := R.groupQuotient
  quotient := R.quotient
  finitelyPresented := R.finitelyPresented
  kazhdan := R.kazhdan
  torsionFree := R.torsionFree
  generatorOne := R.generatorOne
  generatorTwo := R.generatorTwo
  generates := R.generates
  defect_surjective := R.defect_surjective

/-- A finitely presented routed quotient is countable. -/
theorem quotientCountable : Countable R.Quotient :=
  R.toFiveConditionRoutingData.quotientCountable

local instance routedRadicalQuotientCountable : Countable R.Quotient :=
  R.quotientCountable

/-- The routed quotient is nontrivial because the protected element survives. -/
theorem quotientNontrivial : Nontrivial R.Quotient :=
  ⟨⟨R.quotient D.s, 1, R.protected_ne_one⟩⟩

/-- The structure's two chosen elements witness two-generation. -/
theorem isTwoGenerated : IsTwoGenerated R.Quotient :=
  R.toFiveConditionRoutingData.isTwoGenerated

/-- Defect routing commutes with descent of the marked pattern: the defect of
the mapped core is the whole quotient. -/
theorem mapped_defectNormal_eq_top :
    (D.core.map R.quotient).defectNormal = ⊤ :=
  R.toFiveConditionRoutingData.mapped_defectNormal_eq_top

/-- **Full MF radical.**  Every element of the routed quotient is invisible
in every standard cofinite norm-matrix corona. -/
theorem coronaMFResidual_eq_top :
    coronaMFResidual R.Quotient = ⊤ :=
  R.toFiveConditionRoutingData.coronaMFResidual_eq_top

/-- **Literal CDE full radical.**  Every element is killed by every
homomorphism into the unitary group of every genuine norm-matrix C-star
corona. -/
theorem cdeMFResidual_eq_top : cdeMFResidual R.Quotient = ⊤ :=
  R.toFiveConditionRoutingData.cdeMFResidual_eq_top

/-- Ultraproduct-language form of the full-radical theorem. -/
theorem normMFResidual_eq_top :
    normMFResidual R.Quotient = ⊤ :=
  R.toFiveConditionRoutingData.normMFResidual_eq_top

/-- Every representation of the routed quotient in a standard cofinite
norm-matrix corona is the trivial homomorphism. -/
theorem coronaRepresentation_eq_one
    (X : ℕ → FiniteModel) (hX : ∀ n, 0 < Fintype.card (X n))
    (rho : R.Quotient →* NormMatrixCoronaUnitary X) : rho = 1 :=
  R.toFiveConditionRoutingData.coronaRepresentation_eq_one X hX rho

/-- Every representation into the unitary group of a genuine CDE
norm-matrix C-star corona is trivial. -/
theorem cdeCoronaRepresentation_eq_one
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (hX : ∀ n, 0 < Fintype.card (X n))
    (rho : R.Quotient →*
      unitary (NormMatrixCStarCorona (fun n ↦ X n))) : rho = 1 :=
  R.toFiveConditionRoutingData.cdeCoronaRepresentation_eq_one X hX rho

/-- Every homomorphism from the routed quotient to any operator-MF group is
trivial.  The target need not be countable. -/
theorem hom_eq_one_to_isOperatorMF
    {M : Type*} [Group M] (hM : IsOperatorMF M)
    (f : R.Quotient →* M) : f = 1 :=
  R.toFiveConditionRoutingData.hom_eq_one_to_isOperatorMF hM f

/-- Every homomorphism from the routed quotient to a finite group is
trivial. -/
theorem hom_eq_one_to_finite
    (M : Type) [Group M] [Finite M] (f : R.Quotient →* M) : f = 1 :=
  R.toFiveConditionRoutingData.hom_eq_one_to_finite M f

/-- Every homomorphism from the routed quotient to a countable residually
finite group is trivial. -/
theorem hom_eq_one_to_residuallyFinite
    {M : Type*} [Group M] [Countable M] [Group.ResiduallyFinite M]
    (f : R.Quotient →* M) : f = 1 :=
  R.toFiveConditionRoutingData.hom_eq_one_to_residuallyFinite f

/-- The routed quotient has no nontrivial finite quotient. -/
theorem no_nontrivial_finite_quotient
    (M : Type) [Group M] [Finite M] [Nontrivial M]
    (f : R.Quotient →* M) : ¬ Function.Surjective f :=
  R.toFiveConditionRoutingData.no_nontrivial_finite_quotient M f

/-- The routed quotient is not operator-MF.  Unlike everything above, this
uses the survival field: without it the routed quotient could be trivial,
and the trivial group is MF. -/
theorem not_isOperatorMF : ¬ IsOperatorMF R.Quotient := by
  intro hMF
  have htrivial : MonoidHom.id R.Quotient = 1 :=
    R.hom_eq_one_to_isOperatorMF hMF (MonoidHom.id R.Quotient)
  apply R.protected_ne_one
  simpa using DFunLike.congr_fun htrivial (R.quotient D.s)

/-- Literal Carrión--Dadarlat--Eckhardt formulation of the non-MF theorem. -/
theorem not_isCDEOperatorMF : ¬ IsCDEOperatorMF R.Quotient := by
  rw [isCDEOperatorMF_iff_isOperatorMF]
  exact R.not_isOperatorMF

/-- The non-MF theorem is unchanged when the CDE convention requires the
matrix dimensions to be strictly increasing. -/
theorem not_isOperatorMFIncreasing : ¬ IsOperatorMFIncreasing R.Quotient := by
  rw [isOperatorMFIncreasing_iff]
  exact R.not_isOperatorMF

/-- Properties derived from a supplied routed quotient datum: finite
presentation, two-generation, torsion-freeness, property `(T)`, full CDE-MF
radical, and failure of operator-MF. -/
theorem consequence_package :
    Group.IsFinitelyPresented R.Quotient ∧
      IsTwoGenerated R.Quotient ∧
      IsPowerTorsionFree R.Quotient ∧
      HasKazhdanPropertyT.{0, 0} R.Quotient ∧
      cdeMFResidual R.Quotient = ⊤ ∧
      ¬ IsOperatorMF R.Quotient ∧
      ¬ IsCDEOperatorMF R.Quotient :=
  ⟨R.finitelyPresented, R.isTwoGenerated, R.torsionFree, R.kazhdan,
    R.cdeMFResidual_eq_top, R.not_isOperatorMF, R.not_isCDEOperatorMF⟩

end DefectRoutingData

/-! ## Quotient-hereditary full radical -/

namespace DefectRoutingData

variable {P : Type} {E : Type u} [Group P] [Group E]
    {D : FournierFacioDefectData P E}
    (R : DefectRoutingData.{u} D)

local instance quotientInheritanceGroup : Group R.Quotient := R.groupQuotient
local instance quotientInheritanceFinitelyPresented :
    Group.IsFinitelyPresented R.Quotient := R.finitelyPresented
local instance quotientInheritanceCountable : Countable R.Quotient :=
  R.quotientCountable

/-- Every quotient of the routed group again has full corona MF radical. -/
theorem quotient_coronaMFResidual_eq_top
    {H : Type*} [Group H] (q : R.Quotient →* H)
    (hq : Function.Surjective q) : coronaMFResidual H = ⊤ :=
  R.toFiveConditionRoutingData.quotient_coronaMFResidual_eq_top q hq

/-- Every quotient of the routed group has full ultraproduct norm-MF
residual as well. -/
theorem quotient_normMFResidual_eq_top
    {H : Type*} [Group H] (q : R.Quotient →* H)
    (hq : Function.Surjective q) : normMFResidual H = ⊤ :=
  R.toFiveConditionRoutingData.quotient_normMFResidual_eq_top q hq

/-- Every nontrivial quotient of the routed group is non-MF. -/
theorem quotient_not_isOperatorMF
    {H : Type*} [Group H] [Nontrivial H]
    (q : R.Quotient →* H) (hq : Function.Surjective q) :
    ¬ IsOperatorMF H :=
  R.toFiveConditionRoutingData.quotient_not_isOperatorMF q hq

/-- Literal CDE form: every nontrivial quotient of the routed group fails to
embed in the unitary group of a norm-matrix C-star corona. -/
theorem quotient_not_isCDEOperatorMF
    {H : Type*} [Group H] [Countable H] [Nontrivial H]
    (q : R.Quotient →* H) (hq : Function.Surjective q) :
    ¬ IsCDEOperatorMF H :=
  R.toFiveConditionRoutingData.quotient_not_isCDEOperatorMF q hq

end DefectRoutingData

/-! ## Order preservation as the upstream input -/

/-- **How much Hull's published clause (e) supplies.**  Hull's Theorem 7.1
concludes that every element of the quotient of order `n` is the image of an
element of order `n`.  That existential clause gives torsion-freeness of the
quotient from torsion-freeness of the source, and it gives nothing else: the
trivial quotient satisfies it, so it cannot certify that any particular
element survives.  This lemma isolates exactly that much, so that the extra
strength used by `OrderPreservingRoutingData` below is visible. -/
theorem isPowerTorsionFree_of_orderReflecting
    {G : Type u} {H : Type v} [Group G] [Group H]
    (hG : IsPowerTorsionFree G) (f : G →* H)
    (horder : ∀ (y : H) (n : ℕ), 0 < n → orderOf y = n →
      ∃ x : G, orderOf x = n ∧ f x = y) :
    IsPowerTorsionFree H := by
  intro y n hn hy
  have hfin : IsOfFinOrder y := isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, hy⟩
  obtain ⟨x, hx, -⟩ := horder y (orderOf y) hfin.orderOf_pos rfl
  have hxpos : 0 < orderOf x := by
    rw [hx]
    exact hfin.orderOf_pos
  have hx1 : x = 1 := hG x (orderOf x) hxpos (pow_orderOf_eq_one x)
  have hy1 : orderOf y = 1 := by
    rw [← hx, hx1, orderOf_one]
  exact orderOf_eq_one_iff.mp hy1

/-- **Hull's quotient as the manuscript describes it.**

Immediately after the five conditions the manuscript writes that Hull's
small-cancellation theorem "would deliver four of the five" because the
quotient it returns "is obtained by adjoining finitely many relators,
preserves element orders, and restricts to a surjection from `S`".  This
structure records that description literally: the routing data of
`FiveConditionRoutingData`, except that torsion-freeness of `Q` is *not*
assumed.  Instead the source `E` is torsion-free — it is the ascending HNN
extension `E'` over Fournier-Facio's torsion-free group — and the routing
map preserves the order of every element.

Both the printed third condition and the survival of the protected
simple-factor element are then theorems rather than hypotheses:
`torsionFree` and `protected_ne_one` below.  That is the whole point of
this layer.  `DefectRoutingData` assumes survival; here it is derived from
a printed property of the construction, so no interface postulates it.

One caveat is recorded because it is load-bearing: Hull's *published*
clause (e) is the weaker existential form isolated in
`isPowerTorsionFree_of_orderReflecting` above, which yields torsion-freeness
alone.  In the published theorem survival of `s` comes instead from
injectivity on a large enough ball, which is the `protected_injective`
field of `RelativeCommonQuotientData`.  The field below is the
manuscript's own phrase, and it implies both. -/
structure OrderPreservingRoutingData
    {P : Type} {E : Type u} [Group P] [Group E]
    (D : FournierFacioDefectData P E) where
  /-- The routed common quotient. -/
  Quotient : Type
  [groupQuotient : Group Quotient]
  /-- The quotient map from the HNN skeleton. -/
  quotient : E →* Quotient
  /-- Printed condition 1: the routed quotient is finitely presented,
  because Hull's quotient adjoins only finitely many relators. -/
  [finitelyPresented : Group.IsFinitelyPresented Quotient]
  /-- Printed condition 2: property `(T)`, which descends from the
  torsion-free Kazhdan lattice through the common quotient. -/
  kazhdan : HasKazhdanPropertyT.{0, 0} Quotient
  /-- Printed condition 5: the compression defect maps onto the whole
  quotient, because Hull's quotient restricts to a surjection from the
  suitable subgroup `S ≤ N_comp`. -/
  defect_surjective : D.core.defectNormal.map quotient = ⊤
  /-- First generator produced by the routing stage. -/
  generatorOne : Quotient
  /-- Second generator produced by the routing stage. -/
  generatorTwo : Quotient
  /-- Printed condition 4: the two routed elements generate the quotient. -/
  generates :
    Subgroup.closure ({generatorOne, generatorTwo} : Set Quotient) = ⊤
  /-- The skeleton `E'` is torsion-free: it is an ascending HNN extension
  of Fournier-Facio's torsion-free finitely presented Kazhdan group. -/
  sourceTorsionFree : IsPowerTorsionFree E
  /-- The manuscript's clause: the routing map "preserves element orders".
  Printed condition 3 and the survival of the protected element are both
  proved from this, so neither is assumed anywhere. -/
  orderPreserving : ∀ x : E, orderOf (quotient x) = orderOf x

namespace OrderPreservingRoutingData

variable {P : Type} {E : Type u} [Group P] [Group E]
    {D : FournierFacioDefectData P E}
    (R : OrderPreservingRoutingData.{u} D)

local instance orderPreservingQuotientGroup : Group R.Quotient :=
  R.groupQuotient

/-- Order preservation in the form the power-torsion predicate consumes: a
relation `q x ^ n = 1` in the quotient already holds in the source.  This is
the shape `IsPowerTorsionFree` is stated in, which is why the interface
above is phrased with `orderOf` and converted here rather than the other way
round: `orderOf` is what the manuscript's sentence says, and divisibility is
what the predicate needs. -/
theorem powerFaithful {x : E} {n : ℕ} (h : R.quotient x ^ n = 1) :
    x ^ n = 1 := by
  apply orderOf_dvd_iff_pow_eq_one.mp
  rw [← R.orderPreserving x]
  exact orderOf_dvd_of_pow_eq_one h

/-- The routing map is onto, by the fifth printed condition. -/
theorem quotient_surjective : Function.Surjective R.quotient := by
  intro y
  have hy : y ∈ D.core.defectNormal.map R.quotient := by
    rw [R.defect_surjective]
    exact Subgroup.mem_top y
  obtain ⟨x, -, hx⟩ := Subgroup.mem_map.mp hy
  exact ⟨x, hx⟩

/-- **Printed condition 3, derived.**  A torsion-free source and an
order-preserving surjection give a torsion-free quotient. -/
theorem torsionFree : IsPowerTorsionFree R.Quotient := by
  intro y n hn hy
  obtain ⟨x, rfl⟩ := R.quotient_surjective y
  have hx : x = 1 := R.sourceTorsionFree x n hn (R.powerFaithful hy)
  rw [hx, map_one]

/-- **Survival, derived.**  Order preservation makes the protected
simple-factor element survive routing: if `q s` were trivial it would have
order one, hence so would `s`, contradicting `FournierFacioDefectData.s_ne_one`.
This is the field `DefectRoutingData` assumes. -/
theorem protected_ne_one : R.quotient D.s ≠ 1 := by
  intro h
  apply D.s_ne_one
  have h1 : orderOf (R.quotient D.s) = 1 := orderOf_eq_one_iff.mpr h
  rw [R.orderPreserving D.s] at h1
  exact orderOf_eq_one_iff.mp h1

/-- The order-preserving description produces the full routing data, with
both the third printed condition and the survival hypothesis proved instead
of assumed.  Reducible for the same reason as
`DefectRoutingData.toFiveConditionRoutingData`. -/
@[reducible] def toDefectRoutingData : DefectRoutingData D where
  Quotient := R.Quotient
  groupQuotient := R.groupQuotient
  quotient := R.quotient
  quotient_surjective := R.quotient_surjective
  finitelyPresented := R.finitelyPresented
  kazhdan := R.kazhdan
  defect_surjective := R.defect_surjective
  protected_ne_one := R.protected_ne_one
  generatorOne := R.generatorOne
  generatorTwo := R.generatorTwo
  generates := R.generates
  torsionFree := R.torsionFree

/-- The order-preserving description also lands directly on the printed
five conditions, through the routing data. -/
def toFiveConditionRoutingData : FiveConditionRoutingData D :=
  R.toDefectRoutingData.toFiveConditionRoutingData

/-- The routed quotient is nontrivial, without any survival assumption
anywhere: order preservation supplies it. -/
theorem quotientNontrivial : Nontrivial R.Quotient :=
  R.toDefectRoutingData.quotientNontrivial

end OrderPreservingRoutingData

end GroupApproximation
