import GroupApproximation.Analysis.RankNormalizedHilbertization
import GroupApproximation.Leavitt.ConjProductClosure
import GroupApproximation.Sofic.InvolutionCollapseMetric

/-!
# Active cores generated by a finite-order matrix

This file contains the finite-dimensional rank calculus behind active-core
reblocking.  A product of conjugates of one unitary `R` (or `R⁻¹`) moves only
as many dimensions as the number of occurrences of `R` times
`rank (R - 1)`.  Consequently a finite packet of such words has an active
subspace whose dimension is bounded by the total word length times that one
spectral rank.

There are no approximation, stability, or property-`(T)` assumptions here.
The statements are exact finite linear algebra.
-/

namespace GroupApproximation
namespace TorsionActiveCore

open Matrix InvolutionRankMass RankNormalizedHilbertization
open scoped Matrix.Norms.L2Operator

noncomputable section

variable {Y I : Type*} [Fintype Y] [DecidableEq Y]

/-- One matrix conjugate of `R` or `R⁻¹`. -/
def conjugateFactor (R C : Matrix.unitaryGroup Y ℂ) (positive : Bool) :
    Matrix.unitaryGroup Y ℂ :=
  C * (if positive then R else R⁻¹) * C⁻¹

/-- The matrix evaluation of a conjugate-product word. -/
def conjugateWord (R : Matrix.unitaryGroup Y ℂ) :
    List (Matrix.unitaryGroup Y ℂ × Bool) → Matrix.unitaryGroup Y ℂ
  | [] => 1
  | (C, positive) :: l =>
      conjugateFactor R C positive * conjugateWord R l

@[simp] theorem conjugateWord_nil (R : Matrix.unitaryGroup Y ℂ) :
    conjugateWord R [] = 1 := rfl

@[simp] theorem conjugateWord_cons (R C : Matrix.unitaryGroup Y ℂ)
    (positive : Bool) (l : List (Matrix.unitaryGroup Y ℂ × Bool)) :
    conjugateWord R ((C, positive) :: l) =
      conjugateFactor R C positive * conjugateWord R l := rfl

omit [DecidableEq Y] in
/-- Left multiplication cannot increase matrix rank. -/
theorem rank_mul_le_right (A B : Matrix Y Y ℂ) : (A * B).rank ≤ B.rank :=
  Matrix.rank_mul_le_right A B

omit [DecidableEq Y] in
/-- Right multiplication cannot increase matrix rank. -/
theorem rank_mul_le_left (A B : Matrix Y Y ℂ) : (A * B).rank ≤ A.rank :=
  Matrix.rank_mul_le_left A B

/-- Inverting a unitary does not increase the rank of its displacement from
the identity.  The reverse inequality follows by applying the same statement
to `R⁻¹`, so an equality is recorded below. -/
theorem rank_inv_sub_one_le (R : Matrix.unitaryGroup Y ℂ) :
    (((R⁻¹ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank ≤
      (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  let U : Matrix Y Y ℂ := R
  let V : Matrix Y Y ℂ := star U
  have hVU : V * U = 1 := by
    dsimp [U, V]
    exact Unitary.star_mul_self_of_mem R.prop
  have hfactor : V - 1 = V * (1 - U) := by
    rw [Matrix.mul_sub, Matrix.mul_one, hVU]
  have hr : (V - 1).rank ≤ (U - 1).rank := by
    rw [hfactor]
    refine (rank_mul_le_right V (1 - U)).trans_eq ?_
    have hneg : (1 - U) = -(U - 1) := by abel
    rw [hneg, InvolutionCollapseMetric.rank_neg]
  change (star (R : Matrix Y Y ℂ) - 1).rank ≤
    ((R : Matrix Y Y ℂ) - 1).rank
  simpa [U, V] using hr

/-- A unitary and its inverse have the same active spectral rank. -/
theorem rank_inv_sub_one (R : Matrix.unitaryGroup Y ℂ) :
    (((R⁻¹ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank =
      (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  apply le_antisymm (rank_inv_sub_one_le R)
  simpa using rank_inv_sub_one_le (R⁻¹)

/-- Conjugation by a unitary does not increase active rank. -/
theorem rank_unitary_conj_sub_one_le
    (R C : Matrix.unitaryGroup Y ℂ) :
    (((C * R * C⁻¹ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank ≤
      (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  let U : Matrix Y Y ℂ := C
  let V : Matrix Y Y ℂ := star U
  let T : Matrix Y Y ℂ := R
  have hUV : U * V = 1 := by
    dsimp [U, V]
    exact Unitary.mul_star_self_of_mem C.prop
  have hfactor : U * T * V - 1 = U * (T - 1) * V := by
    calc
      U * T * V - 1 = U * T * V - U * V := by rw [hUV]
      _ = U * (T - 1) * V := by noncomm_ring
  have hr : (U * T * V - 1).rank ≤ (T - 1).rank := by
    rw [hfactor]
    exact rank_mul_mul_le U (T - 1) V
  change (((C : Matrix Y Y ℂ) * (R : Matrix Y Y ℂ) *
      star (C : Matrix Y Y ℂ)) - 1).rank ≤
    ((R : Matrix Y Y ℂ) - 1).rank
  simpa [U, V, T] using hr

/-- Boolean-sign specialization of unitary conjugation. -/
theorem rank_conjugateFactor_sub_one_le
    (R C : Matrix.unitaryGroup Y ℂ) (positive : Bool) :
    (((conjugateFactor R C positive : Matrix.unitaryGroup Y ℂ) :
        Matrix Y Y ℂ) - 1).rank ≤
      (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  cases positive with
  | false =>
      exact (rank_unitary_conj_sub_one_le R⁻¹ C).trans
        (rank_inv_sub_one_le R)
  | true => exact rank_unitary_conj_sub_one_le R C

/-- Multiplying two unitary words adds, rather than multiplies, their active
ranks. -/
theorem rank_mul_sub_one_le_add
    (U V : Matrix.unitaryGroup Y ℂ) :
    ((((U * V : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank) ≤
      (((U : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank +
        (((V : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  let A : Matrix Y Y ℂ := U
  let B : Matrix Y Y ℂ := V
  have hsplit : A * B - 1 = A * (B - 1) + (A - 1) := by
    noncomm_ring
  change (A * B - 1).rank ≤ (A - 1).rank + (B - 1).rank
  rw [hsplit]
  calc
    (A * (B - 1) + (A - 1)).rank ≤
        (A * (B - 1)).rank + (A - 1).rank := rank_add_le _ _
    _ ≤ (B - 1).rank + (A - 1).rank :=
      Nat.add_le_add_right (rank_mul_le_right A (B - 1)) _
    _ = (A - 1).rank + (B - 1).rank := Nat.add_comm _ _

/-- **Conjugate-product active-rank bound.**  A word with `l.length`
occurrences of `R^{±1}` moves at most `l.length * rank (R - 1)` dimensions. -/
theorem rank_conjugateWord_sub_one_le
    (R : Matrix.unitaryGroup Y ℂ)
    (l : List (Matrix.unitaryGroup Y ℂ × Bool)) :
    (((conjugateWord R l : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank ≤
      l.length * (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  induction l with
  | nil => simp
  | cons p l ih =>
      obtain ⟨C, positive⟩ := p
      calc
        (((conjugateWord R ((C, positive) :: l) :
              Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank ≤
            ((((conjugateFactor R C positive : Matrix.unitaryGroup Y ℂ) :
              Matrix Y Y ℂ) - 1).rank) +
              (((conjugateWord R l : Matrix.unitaryGroup Y ℂ) :
                Matrix Y Y ℂ) - 1).rank :=
          rank_mul_sub_one_le_add _ _
        _ ≤ (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank +
              l.length *
                (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank :=
          Nat.add_le_add (rank_conjugateFactor_sub_one_le R C positive) ih
        _ = ((C, positive) :: l).length *
              (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
          simp only [List.length_cons, Nat.add_mul, one_mul]
          rw [Nat.add_comm]

/-- The active subspace of a finite unitary packet is the span of all
generator displacement ranges. -/
def activeSubspace [Fintype I] (W : I → Matrix.unitaryGroup Y ℂ) :
    Submodule ℂ (Y → ℂ) :=
  Finset.univ.sup fun i : I ↦ LinearMap.range
    ((((W i : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin)

/-- Every generator displacement lands in the active subspace. -/
theorem displacement_mem_activeSubspace [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (i : I) (x : Y → ℂ) :
    ((((W i : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1) *ᵥ x) ∈
      activeSubspace W := by
  apply Finset.le_sup (f := fun j : I ↦ LinearMap.range
    ((((W j : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin))
    (Finset.mem_univ i)
  exact ⟨x, rfl⟩

/-- The active subspace is invariant under every packet unitary. -/
theorem map_mem_activeSubspace [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (i : I) {x : Y → ℂ}
    (hx : x ∈ activeSubspace W) :
    ((W i : Matrix Y Y ℂ) *ᵥ x) ∈ activeSubspace W := by
  have hd := displacement_mem_activeSubspace W i x
  have hsplit : (W i : Matrix Y Y ℂ) *ᵥ x =
      x + (((W i : Matrix Y Y ℂ) - 1) *ᵥ x) := by
    rw [Matrix.sub_mulVec, Matrix.one_mulVec]
    abel
  rw [hsplit]
  exact (activeSubspace W).add_mem hx hd

omit [DecidableEq Y] in
/-- Finite joins of finite-dimensional subspaces have dimension at most the
sum of their dimensions. -/
theorem finrank_finset_sup_le [Fintype I]
    (s : Finset I) (K : I → Submodule ℂ (Y → ℂ)) :
    Module.finrank ℂ ↥(s.sup K) ≤
      ∑ i ∈ s, Module.finrank ℂ ↥(K i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      rw [Finset.sum_insert hi]
      rw [Finset.sup_insert]
      change Module.finrank ℂ ↥(K i ⊔ s.sup K) ≤
        Module.finrank ℂ ↥(K i) +
          ∑ j ∈ s, Module.finrank ℂ ↥(K j)
      have hdim := Submodule.finrank_sup_add_finrank_inf_eq (K i) (s.sup K)
      omega

/-- The dimension of a packet's active subspace is at most the sum of its
generator displacement ranks. -/
theorem finrank_activeSubspace_le_sum_rank [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) :
    Module.finrank ℂ ↥(activeSubspace W) ≤
      ∑ i : I,
        (((W i : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  classical
  unfold activeSubspace
  change Module.finrank ℂ ↥(Finset.univ.sup fun i : I ↦ LinearMap.range
      ((((W i : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin)) ≤
    ∑ i ∈ (Finset.univ : Finset I), Module.finrank ℂ ↥(LinearMap.range
      ((((W i : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin))
  exact finrank_finset_sup_le (Y := Y) Finset.univ
      (fun i : I ↦ LinearMap.range
        ((((W i : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin))

/-- A finite packet of conjugate-product words in `R`. -/
def conjugateWordPacket [Fintype I]
    (R : Matrix.unitaryGroup Y ℂ)
    (words : I → List (Matrix.unitaryGroup Y ℂ × Bool)) :
    I → Matrix.unitaryGroup Y ℂ :=
  fun i ↦ conjugateWord R (words i)

/-- Total number of occurrences of `R^{±1}` in a packet. -/
def totalWordLength [Fintype I]
    (words : I → List (Matrix.unitaryGroup Y ℂ × Bool)) : ℕ :=
  ∑ i : I, (words i).length

/-- **Active-core upper dimension bound.**  Reblocking a finite packet of
conjugate-product words discards a common fixed complement and leaves an
invariant active space of dimension at most
`totalWordLength * rank (R - 1)`. -/
theorem finrank_activeSubspace_conjugateWordPacket_le [Fintype I]
    (R : Matrix.unitaryGroup Y ℂ)
    (words : I → List (Matrix.unitaryGroup Y ℂ × Bool)) :
    Module.finrank ℂ ↥(activeSubspace (conjugateWordPacket R words)) ≤
      totalWordLength words *
        (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  classical
  calc
    Module.finrank ℂ ↥(activeSubspace (conjugateWordPacket R words)) ≤
        ∑ i : I,
          (((conjugateWordPacket R words i : Matrix.unitaryGroup Y ℂ) :
            Matrix Y Y ℂ) - 1).rank :=
      finrank_activeSubspace_le_sum_rank _
    _ ≤ ∑ i : I, (words i).length *
        (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank :=
      Finset.sum_le_sum fun i _ ↦ rank_conjugateWord_sub_one_le R (words i)
    _ = totalWordLength words *
        (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
      unfold totalWordLength
      rw [Finset.sum_mul]

/-- If the packet contains `R` itself, its active space contains the entire
active spectral range of `R`. -/
theorem rank_le_finrank_activeSubspace_of_eq [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (R : Matrix.unitaryGroup Y ℂ)
    (i₀ : I) (hi₀ : W i₀ = R) :
    (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank ≤
      Module.finrank ℂ ↥(activeSubspace W) := by
  let K : Submodule ℂ (Y → ℂ) := LinearMap.range
    ((((W i₀ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin)
  have hK : K ≤ activeSubspace W :=
    Finset.le_sup (f := fun j : I ↦ LinearMap.range
      ((((W j : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin))
      (Finset.mem_univ i₀)
  have hdim := Submodule.finrank_mono hK
  subst R
  change Module.finrank ℂ ↥(LinearMap.range
      ((((W i₀ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).mulVecLin)) ≤
    Module.finrank ℂ ↥(activeSubspace W)
  simpa only [K] using hdim

/-- **Positive-density active core.**  When one packet entry is exactly `R`,
the active rank of `R` is bounded above by the core dimension, while the core
dimension is bounded by the fixed total word length times that rank. -/
theorem activeCore_rank_sandwich [Fintype I]
    (R : Matrix.unitaryGroup Y ℂ)
    (words : I → List (Matrix.unitaryGroup Y ℂ × Bool))
    (i₀ : I) (hi₀ : conjugateWord R (words i₀) = R) :
    let W := conjugateWordPacket R words
    (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank ≤
        Module.finrank ℂ ↥(activeSubspace W) ∧
      Module.finrank ℂ ↥(activeSubspace W) ≤
        totalWordLength words *
          (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  dsimp only
  exact ⟨rank_le_finrank_activeSubspace_of_eq
      (conjugateWordPacket R words) R i₀ hi₀,
    finrank_activeSubspace_conjugateWordPacket_le R words⟩

/-! ## Euclidean realization of the active core -/

/-- A unitary matrix acts isometrically on the Euclidean coordinate space. -/
def unitaryEuclideanLinearIsometry (U : Matrix.unitaryGroup Y ℂ) :
    EuclideanSpace ℂ Y →ₗᵢ[ℂ] EuclideanSpace ℂ Y where
  toLinearMap := Matrix.toEuclideanLin (U : Matrix Y Y ℂ)
  norm_map' x := by
    have hstar : (U : Matrix Y Y ℂ)ᴴ * (U : Matrix Y Y ℂ) = 1 :=
      Unitary.star_mul_self_of_mem U.prop
    have hmass := KazhdanCornerMatrices.sum_normSq_mulVec_of_star_mul_self
      hstar x.ofLp
    have hout := KazhdanCornerMatrices.euclidean_norm_sq_general
      ((U : Matrix Y Y ℂ) *ᵥ x.ofLp)
    have hin := KazhdanCornerMatrices.euclidean_norm_sq_general
      x.ofLp
    have hsquare :
        ‖Matrix.toEuclideanLin (U : Matrix Y Y ℂ) x‖ ^ 2 = ‖x‖ ^ 2 := by
      rw [Matrix.toLpLin_apply]
      simpa using hout.trans (hmass.trans hin.symm)
    nlinarith [norm_nonneg
      (Matrix.toEuclideanLin (U : Matrix Y Y ℂ) x), norm_nonneg x]

/-- The Euclidean action of a unitary is onto, with inverse induced by the
inverse unitary. -/
theorem unitaryEuclideanLinearIsometry_surjective
    (U : Matrix.unitaryGroup Y ℂ) :
    Function.Surjective (unitaryEuclideanLinearIsometry U) := by
  intro y
  refine ⟨Matrix.toEuclideanLin ((U⁻¹ : Matrix.unitaryGroup Y ℂ) :
      Matrix Y Y ℂ) y, ?_⟩
  ext j
  change (((U : Matrix Y Y ℂ) *ᵥ
    (((U⁻¹ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) *ᵥ y.ofLp)) j) =
      y.ofLp j
  have hmul : (U : Matrix Y Y ℂ) *
      ((U⁻¹ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) = 1 := by
    change (((U * U⁻¹ : Matrix.unitaryGroup Y ℂ) :
      Matrix Y Y ℂ)) = 1
    rw [mul_inv_cancel]
    rfl
  have hv : (U : Matrix Y Y ℂ) *ᵥ
      (((U⁻¹ : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) *ᵥ y.ofLp) =
        y.ofLp := by
    rw [Matrix.mulVec_mulVec, hmul, Matrix.one_mulVec]
  exact congrFun hv j

/-- A unitary matrix as a Euclidean linear isometric equivalence. -/
def unitaryEuclideanLinearIsometryEquiv (U : Matrix.unitaryGroup Y ℂ) :
    EuclideanSpace ℂ Y ≃ₗᵢ[ℂ] EuclideanSpace ℂ Y :=
  LinearIsometryEquiv.ofSurjective (unitaryEuclideanLinearIsometry U)
    (unitaryEuclideanLinearIsometry_surjective U)

/-- The algebraic active range, transported to the genuine Euclidean
coordinate Hilbert space. -/
def activeEuclideanSubspace [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) :
    Submodule ℂ (EuclideanSpace ℂ Y) :=
  Submodule.map (EuclideanSpace.equiv Y ℂ).symm.toLinearEquiv.toLinearMap
    (activeSubspace W)

/-- The Euclidean active core has the same dimension as the algebraic active
range used by the rank calculation. -/
theorem finrank_activeEuclideanSubspace [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) :
    Module.finrank ℂ ↥(activeEuclideanSubspace W) =
      Module.finrank ℂ ↥(activeSubspace W) := by
  unfold activeEuclideanSubspace
  rw [LinearEquiv.finrank_map_eq]

/-- Every packet unitary preserves the Euclidean active core. -/
theorem unitaryEuclidean_mem_activeCore [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (i : I)
    (x : EuclideanSpace ℂ Y) (hx : x ∈ activeEuclideanSubspace W) :
    unitaryEuclideanLinearIsometryEquiv (W i) x ∈
      activeEuclideanSubspace W := by
  rw [activeEuclideanSubspace] at hx ⊢
  obtain ⟨y, hy, rfl⟩ := hx
  refine ⟨(W i : Matrix Y Y ℂ) *ᵥ y, map_mem_activeSubspace W i hy, ?_⟩
  ext j
  rfl

/-- Restriction of one packet unitary to the invariant Euclidean active core. -/
def activeCoreLinearIsometry [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (i : I) :
    activeEuclideanSubspace W →ₗᵢ[ℂ] activeEuclideanSubspace W where
  toLinearMap :=
    { toFun := fun x ↦ ⟨unitaryEuclideanLinearIsometryEquiv (W i) x,
        unitaryEuclidean_mem_activeCore W i x x.2⟩
      map_add' := by
        intro x y
        apply Subtype.ext
        simp
      map_smul' := by
        intro c x
        apply Subtype.ext
        simp }
  norm_map' x := by
    exact (unitaryEuclideanLinearIsometryEquiv (W i)).norm_map x

/-- The restricted isometry is onto because it is an injective endomorphism
of a finite-dimensional space. -/
theorem activeCoreLinearIsometry_surjective [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (i : I) :
    Function.Surjective (activeCoreLinearIsometry W i) := by
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank rfl).mp
    (activeCoreLinearIsometry W i).injective

/-- Restriction of a packet unitary as a linear isometric equivalence. -/
def activeCoreLinearIsometryEquiv [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (i : I) :
    activeEuclideanSubspace W ≃ₗᵢ[ℂ] activeEuclideanSubspace W :=
  LinearIsometryEquiv.ofSurjective (activeCoreLinearIsometry W i)
    (activeCoreLinearIsometry_surjective W i)

/-- Canonical finite coordinates for the active core. -/
abbrev ActiveCoreIndex [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) :=
  Fin (Module.finrank ℂ (activeEuclideanSubspace W))

/-- The active core as a finite matrix model. -/
def activeCoreModel [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) : FiniteModel where
  carrier := ActiveCoreIndex W
  fintype := inferInstance
  decidableEq := inferInstance

/-- Matrix coordinates of a finite-dimensional linear isometric
automorphism in the canonical orthonormal basis. -/
noncomputable def orthonormalMatrixOfLinearIsometryEquiv
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [FiniteDimensional ℂ E] (e : E ≃ₗᵢ[ℂ] E) :
    Matrix.unitaryGroup (Fin (Module.finrank ℂ E)) ℂ := by
  let b : OrthonormalBasis (Fin (Module.finrank ℂ E)) ℂ E :=
    stdOrthonormalBasis ℂ E
  refine ⟨e.toMatrix b.toBasis b.toBasis, e.toMatrix_mem_unitaryGroup b b⟩

/-- Matrix rank of the displacement is the dimension of the range of the
underlying linear displacement. -/
theorem rank_orthonormalMatrix_sub_one
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [FiniteDimensional ℂ E] (e : E ≃ₗᵢ[ℂ] E) :
    (((orthonormalMatrixOfLinearIsometryEquiv e :
        Matrix.unitaryGroup (Fin (Module.finrank ℂ E)) ℂ) :
          Matrix (Fin (Module.finrank ℂ E)) (Fin (Module.finrank ℂ E)) ℂ) - 1).rank =
      Module.finrank ℂ
        (LinearMap.range (e.toLinearEquiv.toLinearMap - LinearMap.id)) := by
  let b : Module.Basis (Fin (Module.finrank ℂ E)) ℂ E :=
    (stdOrthonormalBasis ℂ E).toBasis
  rw [Matrix.rank_eq_finrank_range_toLin _ b b]
  have hlin : Matrix.toLin b b
      (((orthonormalMatrixOfLinearIsometryEquiv e :
          Matrix.unitaryGroup (Fin (Module.finrank ℂ E)) ℂ) :
            Matrix (Fin (Module.finrank ℂ E))
              (Fin (Module.finrank ℂ E)) ℂ) - 1) =
        e.toLinearEquiv.toLinearMap - LinearMap.id := by
    ext x
    simp [orthonormalMatrixOfLinearIsometryEquiv, b]
  rw [hlin]

/-- A packet unitary compressed to its common invariant active block. -/
noncomputable def activeCoreMatrix [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) (i : I) :
    Matrix.unitaryGroup (ActiveCoreIndex W) ℂ :=
  orthonormalMatrixOfLinearIsometryEquiv
    (E := activeEuclideanSubspace W) (activeCoreLinearIsometryEquiv W i)

/-- The matrix size of the active block is exactly its Euclidean dimension. -/
@[simp] theorem card_activeCoreModel [Fintype I]
    (W : I → Matrix.unitaryGroup Y ℂ) :
    Fintype.card (activeCoreModel W) =
      Module.finrank ℂ (activeEuclideanSubspace W) := by
  change Fintype.card (Fin (Module.finrank ℂ (activeEuclideanSubspace W))) = _
  exact Fintype.card_fin _

/-- Active-core reblocking has the same fixed-multiple dimension bound as the
algebraic range packet. -/
theorem card_activeCoreModel_conjugateWordPacket_le [Fintype I]
    (R : Matrix.unitaryGroup Y ℂ)
    (words : I → List (Matrix.unitaryGroup Y ℂ × Bool)) :
    Fintype.card (activeCoreModel (conjugateWordPacket R words)) ≤
      totalWordLength words *
        (((R : Matrix.unitaryGroup Y ℂ) : Matrix Y Y ℂ) - 1).rank := by
  rw [card_activeCoreModel, finrank_activeEuclideanSubspace]
  exact finrank_activeSubspace_conjugateWordPacket_le R words

end

end TorsionActiveCore
end GroupApproximation
