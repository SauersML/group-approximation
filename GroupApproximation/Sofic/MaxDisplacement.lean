import Mathlib.Algebra.Group.Submonoid.Membership
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Data.Finset.Max
import Mathlib.Data.Fintype.Pigeonhole
import Mathlib.Data.Real.Basic
import Mathlib.GroupTheory.GroupAction.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring

/-!
# The max-displacement lemma

Replacing a single distinguished mover by a finite mover family, and
normalizing by their *maximal* displacement, is an observation of Francesco
Fournier-Facio.

Section 5 of the multi-mover dossier.  A collapse argument normalized by
displacement uses its generating hypothesis only to bound the displacement of an
arbitrary group element by a constant multiple of the displacement scale.  This
file proves that the bound survives when a single distinguished mover is
replaced by the maximum over finitely many movers.

The setting is deliberately metric-free: `d` is any real-valued function on the
finite-stage model which vanishes on the diagonal, satisfies the triangle
inequality, and is left invariant up to an additive error `e`.  In the exact
rank model obtained after spectral correction one may take `e = 0`; carrying `e`
keeps the estimate usable at finite stages.

* `dist_inv_smul_le` is Lemma 5.1: inverses cost the same scale.
* `dist_listProd_le` and `dist_smul_le_of_mem_closure` are Lemma 5.2: the word
  estimate `δ(g) ≤ C_g (k + e)`.
* `exists_max_mover` and `exists_infinite_constant_argmax` are Lemma 5.3: an
  argmax mover always exists, and since it ranges over a finite index set some
  single index is the argmax at infinitely many stages.
-/

namespace GroupApproximation
namespace MaxDisplacement

universe u v

variable {G : Type u} [Group G] {X : Type v} [MulAction G X] (d : X → X → ℝ)

/-- Left invariance of the stage pseudometric up to an additive error. -/
def AlmostLeftInvariant (e : ℝ) : Prop :=
  ∀ (g : G) (x y : X), d (g • x) (g • y) ≤ d x y + e

variable {d}

/-- **Lemma 5.1.**  Inverting a letter costs the same displacement scale, up to
one extra invariance error. -/
theorem dist_inv_smul_le (hsymm : ∀ x y : X, d x y = d y x) {e : ℝ}
    (hinv : AlmostLeftInvariant (G := G) d e) (x₀ : X) (γ : G) :
    d x₀ (γ⁻¹ • x₀) ≤ d x₀ (γ • x₀) + e := by
  have h := hinv γ⁻¹ (γ • x₀) x₀
  rw [inv_smul_smul] at h
  calc d x₀ (γ⁻¹ • x₀) ≤ d (γ • x₀) x₀ + e := h
    _ = d x₀ (γ • x₀) + e := by rw [hsymm]

/-- **Lemma 5.2, list form.**  A word of length `r` in letters of displacement
at most `k` moves the basepoint by at most `r (k + e)`. -/
theorem dist_listProd_le (hrefl : ∀ x : X, d x x = 0)
    (htri : ∀ x y z : X, d x z ≤ d x y + d y z) {e k : ℝ}
    (hinv : AlmostLeftInvariant (G := G) d e) (x₀ : X) (S : Set G)
    (hS : ∀ s ∈ S, d x₀ (s • x₀) ≤ k) :
    ∀ L : List G, (∀ s ∈ L, s ∈ S) →
      d x₀ (L.prod • x₀) ≤ (L.length : ℝ) * (k + e) := by
  intro L
  induction L with
  | nil =>
      intro _
      have hz : d x₀ ((List.nil : List G).prod • x₀) = 0 := by
        simp [hrefl x₀]
      rw [hz]
      simp
  | cons s T ih =>
      intro hmem
      have hsS : s ∈ S := hmem s (by simp)
      have hT : ∀ t ∈ T, t ∈ S := fun t ht => hmem t (by simp [ht])
      have hstep : d (s • x₀) ((s * T.prod) • x₀) ≤ d x₀ (T.prod • x₀) + e := by
        have h := hinv s x₀ (T.prod • x₀)
        rwa [← mul_smul] at h
      have hchain : d x₀ ((s * T.prod) • x₀)
          ≤ d x₀ (s • x₀) + d (s • x₀) ((s * T.prod) • x₀) := htri _ _ _
      have hbound : d x₀ ((s * T.prod) • x₀)
          ≤ k + ((T.length : ℝ) * (k + e) + e) := by
        have h1 := hS s hsS
        have h2 := ih hT
        linarith
      have hgoal : d x₀ ((s :: T).prod • x₀)
          ≤ k + ((T.length : ℝ) * (k + e) + e) := by
        simpa [List.prod_cons] using hbound
      have harith : k + ((T.length : ℝ) * (k + e) + e)
          = ((T.length : ℝ) + 1) * (k + e) := by ring
      have hlen : ((s :: T).length : ℝ) = (T.length : ℝ) + 1 := by simp
      rw [hlen]
      exact le_trans hgoal (le_of_eq harith)

/-- **Lemma 5.2.**  Every element of the subgroup generated by a symmetric set
of letters of displacement at most `k` has displacement bounded by a constant
multiple of `k + e`, the constant being any word length of the element. -/
theorem dist_smul_le_of_mem_closure (hrefl : ∀ x : X, d x x = 0)
    (htri : ∀ x y z : X, d x z ≤ d x y + d y z)
    {e k : ℝ} (hinv : AlmostLeftInvariant (G := G) d e) (x₀ : X) (S : Set G)
    (hS : ∀ s ∈ S, d x₀ (s • x₀) ≤ k)
    (hSsymm : ∀ s ∈ S, s⁻¹ ∈ S) {g : G} (hg : g ∈ Subgroup.closure S) :
    ∃ r : ℕ, d x₀ (g • x₀) ≤ (r : ℝ) * (k + e) := by
  have hmon : g ∈ Submonoid.closure (S ∪ S⁻¹) := by
    rw [← Subgroup.closure_toSubmonoid S]
    exact hg
  obtain ⟨L, hL, hLprod⟩ := Submonoid.exists_list_of_mem_closure hmon
  refine ⟨L.length, ?_⟩
  rw [← hLprod]
  refine dist_listProd_le hrefl htri hinv x₀ S hS L ?_
  intro s hs
  rcases hL s hs with h | h
  · exact h
  · have hinvS : s⁻¹ ∈ S := Set.mem_inv.mp h
    simpa using hSsymm _ hinvS

/-- **Lemma 5.3, existence of a top-scale mover.**  Over a nonempty finite
family of movers the displacement attains its maximum. -/
theorem exists_max_mover {ι : Type*} (s : Finset ι) (hs : s.Nonempty)
    (f : ι → ℝ) : ∃ i ∈ s, ∀ j ∈ s, f j ≤ f i :=
  s.exists_max_image f hs

/-- The normalized displacement of an argmax mover is exactly one whenever the
scale is positive. -/
theorem normalized_argmax_eq_one {k : ℝ} (hk : k ≠ 0) : k / k = 1 :=
  div_self hk

/-- **Lemma 5.3, pigeonhole.**  An argmax index chosen at every stage takes some
single value at infinitely many stages, because the mover family is finite. -/
theorem exists_infinite_constant_argmax {ι : Type*} [Finite ι] (i : ℕ → ι) :
    ∃ a : ι, {n : ℕ | i n = a}.Infinite := by
  obtain ⟨a, ha⟩ := Finite.exists_infinite_fiber i
  exact ⟨a, Set.infinite_coe_iff.mp ha⟩

end MaxDisplacement
end GroupApproximation
