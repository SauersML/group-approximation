import GroupApproximation.Sofic.CliffordLampNormalForm
import GroupApproximation.Meta.AxiomGuard

/-!
# The order of a finitely generated Clifford lamp subgroup

`Sofic/CliffordLampNormalForm.lean` proves `toModel X : CliffordLamp X →* SignedModel X`
bijective.  This module draws the printed order-formula corollary: for a finite `Y ⊆ X`, the
subgroup of `CliffordLamp X` generated by `ε` and `{c_y : y ∈ Y}` has order `2^{|Y|+1}`.

## Route

Rather than characterizing `Subgroup.closure ({sign X} ∪ lamp X '' Y)` inside `CliffordLamp X`
directly, the computation is pushed through the isomorphism `toModel X`.  `supportedModel Y` is
the subgroup of `SignedModel X` of pairs whose lamp-configuration is supported in `Y`; its
preimage `generatedSubgroup Y` under `toModel X` is shown to equal the generated subgroup
(`≤`, by `Subgroup.closure_le` on the generators' images; `≥`, by `section'_toModel` and an
induction on the support via `wordOfSupport_insert`).  Since `toModel X` is bijective,
`generatedSubgroup Y` and `supportedModel Y` have the same `Nat.card`, and `supportedModel Y` is
computed directly by splitting off the sign coordinate and restricting the `Finsupp` to its
support.
-/

namespace GroupApproximation
namespace CliffordLampOrderFormula

open CliffordLamp CliffordLampNormalForm CliffordLampNormalFormSplice

noncomputable section

variable {X : Type} [LinearOrder X]

/-! ## The target subgroup of `SignedModel X` -/

/-- The subgroup of `SignedModel X` of pairs whose lamp-configuration is supported in `Y`. -/
def supportedModel (Y : Finset X) : Subgroup (SignedModel X) where
  carrier := {p | (↑p.config.support : Set X) ⊆ (↑Y : Set X)}
  one_mem' := by
    show (↑(1 : SignedModel X).config.support : Set X) ⊆ (↑Y : Set X)
    rw [one_def]
    simp
  mul_mem' {p q} hp hq := by
    show (↑(p * q).config.support : Set X) ⊆ (↑Y : Set X)
    show (↑(p.config + q.config).support : Set X) ⊆ (↑Y : Set X)
    rw [Finset.coe_subset]
    exact Finsupp.support_add.trans
      (Finset.union_subset (Finset.coe_subset.mp hp) (Finset.coe_subset.mp hq))
  inv_mem' {p} hp := by
    show (↑p⁻¹.config.support : Set X) ⊆ (↑Y : Set X)
    show (↑p.config.support : Set X) ⊆ (↑Y : Set X)
    exact hp

theorem mem_supportedModel_iff (Y : Finset X) (p : SignedModel X) :
    p ∈ supportedModel Y ↔ (↑p.config.support : Set X) ⊆ (↑Y : Set X) := Iff.rfl

/-! ## Its preimage in `CliffordLamp X` is the generated subgroup -/

/-- The preimage of `supportedModel Y` under `toModel X`. -/
def generatedSubgroup (Y : Finset X) : Subgroup (CliffordLamp X) :=
  (supportedModel Y).comap (toModel X)

theorem mem_generatedSubgroup_iff (Y : Finset X) (g : CliffordLamp X) :
    g ∈ generatedSubgroup Y ↔ (↑(toModel X g).config.support : Set X) ⊆ (↑Y : Set X) := Iff.rfl

theorem closure_le_generatedSubgroup (Y : Finset X) :
    Subgroup.closure ({sign X} ∪ lamp X '' (↑Y : Set X)) ≤ generatedSubgroup Y := by
  rw [Subgroup.closure_le]
  apply Set.union_subset
  · intro g hg
    rw [Set.mem_singleton_iff] at hg
    subst hg
    show (↑(toModel X (sign X)).config.support : Set X) ⊆ (↑Y : Set X)
    rw [toModel_sign, modelSign]
    simp
  · rintro g ⟨y, hy, rfl⟩
    show (↑(toModel X (lamp X y)).config.support : Set X) ⊆ (↑Y : Set X)
    rw [toModel_lamp, modelLamp]
    exact Finset.coe_subset.mpr (Finsupp.support_single_subset.trans
      (Finset.singleton_subset_iff.mpr (Finset.mem_coe.mp hy)))

theorem generatedSubgroup_le_closure (Y : Finset X) :
    generatedSubgroup Y ≤ Subgroup.closure ({sign X} ∪ lamp X '' (↑Y : Set X)) := by
  intro g hg
  have hg' : (toModel X g).config.support ⊆ Y := Finset.coe_subset.mp hg
  rw [← section'_toModel g, section'_def]
  apply Subgroup.mul_mem
  · rcases zmod2_eq_zero_or_one (toModel X g).signPart with h0 | h1
    · rw [h0, signPow_zero]; exact Subgroup.one_mem _
    · rw [h1, signPow_one]; exact Subgroup.subset_closure (Or.inl rfl)
  · revert hg'
    generalize (toModel X g).config.support = s
    induction s using Finset.induction_on with
    | empty => intro _; simp [wordOfSupport_empty]
    | @insert x s hx ih =>
        intro hsub
        have hxY : x ∈ Y := hsub (Finset.mem_insert_self x s)
        have hsY : s ⊆ Y := (Finset.subset_insert x s).trans hsub
        rw [wordOfSupport_insert hx]
        apply Subgroup.mul_mem
        apply Subgroup.mul_mem
        · have hmem : sign X ∈ Subgroup.closure ({sign X} ∪ lamp X '' (↑Y : Set X)) :=
            Subgroup.subset_closure (Set.mem_union_left _ rfl)
          exact Subgroup.pow_mem _ hmem _
        · exact ih hsY
        · exact Subgroup.subset_closure (Or.inr ⟨x, Finset.mem_coe.mpr hxY, rfl⟩)

theorem closure_eq_generatedSubgroup (Y : Finset X) :
    Subgroup.closure ({sign X} ∪ lamp X '' (↑Y : Set X)) = generatedSubgroup Y :=
  le_antisymm (closure_le_generatedSubgroup Y) (generatedSubgroup_le_closure Y)

/-! ## Cardinality -/

theorem nat_card_generatedSubgroup_eq_supportedModel (Y : Finset X) :
    Nat.card (generatedSubgroup Y) = Nat.card (supportedModel Y) := by
  have hmap : (generatedSubgroup Y).map (toModel X) = supportedModel Y :=
    Subgroup.map_comap_eq_self_of_surjective toModel_surjective (supportedModel Y)
  calc Nat.card (generatedSubgroup Y)
      = Nat.card ((generatedSubgroup Y).map (toModel X)) :=
        Nat.card_congr
          ((generatedSubgroup Y).equivMapOfInjective (toModel X) toModel_injective).toEquiv
    _ = Nat.card (supportedModel Y) := by rw [hmap]

/-- Splitting off the sign coordinate and restricting the `Finsupp` to its support. -/
def supportedModelEquiv (Y : Finset X) :
    supportedModel Y ≃ ZMod 2 × {f : X →₀ ZMod 2 // (↑f.support : Set X) ⊆ (↑Y : Set X)} where
  toFun p := ⟨p.1.signPart, ⟨p.1.config, p.2⟩⟩
  invFun q := ⟨⟨q.1, q.2.1⟩, q.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem nat_card_supportedModel (Y : Finset X) :
    Nat.card (supportedModel Y) = 2 ^ (Y.card + 1) := by
  haveI : Finite (↑Y : Set X) := (Finset.finite_toSet Y).to_subtype
  have h1 : Nat.card (supportedModel Y) =
      Nat.card (ZMod 2) * Nat.card {f : X →₀ ZMod 2 // (↑f.support : Set X) ⊆ (↑Y : Set X)} := by
    rw [Nat.card_congr (supportedModelEquiv Y), Nat.card_prod]
  have h2 : Nat.card {f : X →₀ ZMod 2 // (↑f.support : Set X) ⊆ (↑Y : Set X)} =
      Nat.card ((↑Y : Set X) → ZMod 2) := by
    rw [Nat.card_congr (Finsupp.restrictSupportEquiv (↑Y : Set X) (ZMod 2)),
      Nat.card_congr (Finsupp.equivFunOnFinite (α := (↑Y : Set X)) (M := ZMod 2))]
  have h3 : Nat.card ((↑Y : Set X) → ZMod 2) = 2 ^ Y.card := by
    rw [Nat.card_fun, Nat.card_eq_fintype_card (α := ZMod 2), ZMod.card, Nat.card_coe_set_eq,
      Set.ncard_coe_finset]
  have h4 : Nat.card (ZMod 2) = 2 := by rw [Nat.card_eq_fintype_card, ZMod.card]
  rw [h1, h2, h3, h4]
  ring

/-- **Printed sentence.**

> In particular, for a finite subset `Y ⊆ X`, the subgroup generated by `ε` and the `c_y` with
> `y ∈ Y` has order `2^{|Y|+1}`.

The subgroup generated by `ε` and the `c_y` with `y ∈ Y` (`Y` a finite subset of `X`) has order
`2^{|Y|+1}`. -/
theorem nat_card_closure (Y : Finset X) :
    Nat.card (Subgroup.closure ({sign X} ∪ lamp X '' (↑Y : Set X))) = 2 ^ (Y.card + 1) := by
  rw [closure_eq_generatedSubgroup, nat_card_generatedSubgroup_eq_supportedModel,
    nat_card_supportedModel]

end
end CliffordLampOrderFormula
end GroupApproximation

open GroupApproximation
open GroupApproximation.CliffordLampOrderFormula

#audit_axioms nat_card_closure
