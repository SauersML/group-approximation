import GroupApproximation.Sofic.ConjugationDatumAnyUniverse
import GroupApproximation.Sofic.ManuscriptExactWrappers

/-!
# `thm:normal-kazhdan`, `cor:intrinsic-nk` and `p:nk-join` in any universe

Three statements of `\section{Obstructions from a one-sided conjugation datum}`
(`\label{sec:conj}`) name no universe for their Kazhdan source, and the
formalized forms fixed it at `Type 0`.  Those are ledger rows `NK.00`, `NK.16`
and `NK.17`:

* `thm:normal-kazhdan` — "Let `H` be a countable group with a Kazhdan
  conjugation datum `(Λ, ι, t, c)`, and let `K ⊴ H` be a normal subgroup with
  property (T) such that `K ⊆ N_conj`.  Then every homomorphism
  `Θ : H → U(Q)` satisfies `Θ(k) = 1` for all `k ∈ K`."
* `cor:intrinsic-nk` — "Let `H` and `Γ` be countable groups, let `Γ` have
  property (T), let `ι : Γ → H` be a homomorphism, and put `L = ι(Γ)`.  If
  `K ⊴ H` is a normal subgroup with property (T) and `K ≤ 𝔇(H,L)`, then every
  homomorphism `H → U(Q)` maps every element of `K` to the identity."
* `p:nk-join` — "The subgroup generated by *all* normal property-(T) subgroups
  of `𝔇(H,L)` therefore also lies in the kernel of every homomorphism to
  `U(Q)`."

All three are closed here by the descent of
`Sofic.ConjugationDatumAnyUniverse`.  **Countability of the source is derived,
never assumed**: for `thm:normal-kazhdan` it comes from the datum's own
`kazhdan` field, and for the two intrinsic statements from the property-`(T)`
hypothesis they already print.  So the `NK.00` wrapper carries one hypothesis
fewer than the `Type 0` form it replaces, and the intrinsic wrappers carry
exactly the printed ones.

For the intrinsic pair the object the conclusion is about is `𝔇(H,L)` with
`L = ι(Γ)`, and `range_comp_mulEquiv` says that `L` does not move when `ι` is
reindexed along the isomorphism onto the `Type 0` model, so the hypothesis
`K ≤ 𝔇(H,L)` transports with a rewrite and the conclusion needs no translation.
-/

namespace GroupApproximation
namespace ManuscriptExactWrappers

universe u v

/-- **`thm:normal-kazhdan` with the Kazhdan source at an arbitrary universe**
(ledger row `NK.00`).

Exact natural-dimension form of the normal-Kazhdan obstruction: every
homomorphism into the unitary group of the genuine norm-matrix C-star corona
maps a normal property-`(T)` subgroup of the compression defect to the identity.
No finiteness, centrality, or torsion hypothesis appears.

This is `manuscriptNormalKazhdanObstruction` with `Γ` unpinned and with its
`Countable Γ` instance binder removed: the datum's property `(T)` supplies it
(`KazhdanCompressionCore.countable_source`).  `Countable H` remains, as printed.

Every binder is after the colon, as the badged `Type 0` form does it: the
zero-input gate rejects a badged declaration with header binders. -/
theorem manuscriptNormalKazhdanObstruction_anyUniverse :
    ∀ {Gamma : Type v} {H : Type u} [Group Gamma] [Group H]
      [Countable H]
      (C : KazhdanCompressionCore Gamma H)
      (K : Subgroup H) [K.Normal]
      (hT : HasKazhdanPropertyT.{u, u} K)
      (hK : K ≤ C.defectNormal)
      (d : ℕ → ℕ) (hd : ∀ n, 0 < d n),
    let X : ℕ → FiniteModel := fun n ↦ naturalFiniteModel (d n)
    letI : ∀ n, Nonempty (X n) :=
      fun n ↦ Fintype.card_pos_iff.mp (by
        simpa [X] using hd n)
    ∀ Theta : H →* unitary (NormMatrixCStarCorona (fun n ↦ X n)),
      K ≤ Theta.ker := by
  intro Gamma H _ _ _ C K _ hT hK d hd
  haveI : Countable Gamma := C.countable_source
  obtain ⟨Gamma₀, _groupGamma₀, ⟨e⟩⟩ := Type0Transfer.exists_type0_model Gamma
  haveI : Countable Gamma₀ := Type0Transfer.countable_type0_model Gamma e
  exact manuscriptNormalKazhdanObstruction
    (CompressionUniverseTransfer.mapCoreSource C e) K hT (by
      simpa [CompressionUniverseTransfer.mapCoreSource_defectNormal] using hK) d hd

/-- **`cor:intrinsic-nk` with the Kazhdan source at an arbitrary universe**
(ledger row `NK.16`).

Closed form of the intrinsic normal-Kazhdan radical theorem, with `Γ` unpinned.
The `.{v, v}` spelling of property `(T)` for `Γ` is the textbook property at the
group's own representation universe, and it is exactly what
`countable_of_hasKazhdanPropertyT` consumes; the `.{u, u}` spelling for `K` is
forced, since `↥K` lives in `Type u`.  At `v = 0` this is
`manuscriptIntrinsicNormalKazhdanRadical`. -/
theorem manuscriptIntrinsicNormalKazhdanRadical_anyUniverse :
    ∀ {Gamma : Type v} {H : Type u} [Group Gamma] [Group H] [Countable H]
      (iota : Gamma →* H),
      HasKazhdanPropertyT.{v, v} Gamma →
      ∀ (K : Subgroup H) [K.Normal],
        HasKazhdanPropertyT.{u, u} K →
        K ≤ compressionCentralizerDefect iota.range →
        K ≤ actualCoronaMFResidual H := by
  intro Gamma H _ _ _ iota hkazhdan K _ hT hK
  haveI : Countable Gamma := countable_of_hasKazhdanPropertyT hkazhdan
  obtain ⟨Gamma₀, _groupGamma₀, ⟨e⟩⟩ := Type0Transfer.exists_type0_model Gamma
  -- property `(T)` moves to the model in two steps: raise the representation
  -- universe to `0` so that it can be seen from there, then carry it across
  have hlift : HasKazhdanPropertyT.{v, 0} Gamma :=
    HasKazhdanPropertyT.liftUniverse hkazhdan
  have hkazhdan₀ : HasKazhdanPropertyT.{0, 0} Gamma₀ :=
    HasKazhdanPropertyT.of_mulEquiv e.symm hlift
  -- `L = ι(Γ)` is unchanged by the reindexing, so `𝔇(H, L)` is too
  have hrange : (iota.comp e.symm.toMonoidHom).range = iota.range :=
    CompressionUniverseTransfer.range_comp_mulEquiv iota e.symm
  have hK₀ : K ≤
      compressionCentralizerDefect (iota.comp e.symm.toMonoidHom).range := by
    rw [hrange]
    exact hK
  exact manuscriptIntrinsicNormalKazhdanRadical (iota.comp e.symm.toMonoidHom)
    hkazhdan₀ K hT hK₀

/-- **`p:nk-join` with the Kazhdan source at an arbitrary universe** (ledger row
`NK.17`).

The subgroup generated by all normal property-`(T)` subgroups of `𝔇(H,L)` lies
in the kernel of every homomorphism to `U(Q)`.  No separate descent is needed:
the join is a supremum, so it suffices that each member is killed, which is
`manuscriptIntrinsicNormalKazhdanRadical_anyUniverse` at the same universes. -/
theorem manuscriptIntrinsicNormalKazhdanPart_anyUniverse :
    ∀ {Gamma : Type v} {H : Type u} [Group Gamma] [Group H] [Countable H]
      (iota : Gamma →* H),
      HasKazhdanPropertyT.{v, v} Gamma →
      normalKazhdanPart (compressionCentralizerDefect iota.range) ≤
        actualCoronaMFResidual H := by
  intro Gamma H _ _ _ iota hkazhdan
  rw [normalKazhdanPart]
  refine sSup_le ?_
  rintro K ⟨hnorm, hT, hKD⟩
  haveI := hnorm
  exact manuscriptIntrinsicNormalKazhdanRadical_anyUniverse iota hkazhdan K hT hKD

end ManuscriptExactWrappers
end GroupApproximation
