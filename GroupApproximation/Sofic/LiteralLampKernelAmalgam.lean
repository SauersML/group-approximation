import GroupApproximation.Sofic.BlockCliffordLamp
import GroupApproximation.Sofic.CentralInvolutionSubgroup
import GroupApproximation.Sofic.LEFSofic
import GroupApproximation.Sofic.LiteralNonMFPresentation
import Mathlib.GroupTheory.PushoutI

/-!
# The lamp kernel of the literal group is a central amalgam of order-512 Clifford blocks

This module formalises §5 of
`docs/LITERAL_GROUP_BLOCK_AMALGAM_STRUCTURE_2026-08-14.md` (Theorem 5.1): the
kernel `N_E` of the retraction `E → V` of the literal forty-one-relator group
is the free product, amalgamated over one common central involution `⟨ζ⟩ ≅ ℤ/2`,
of countably many copies of the Clifford lamp group `ClLamp(8)` of order
`2⁹ = 512`, one copy for each block of the `7`-regular orbital graph of
Proposition 4.2.

Three layers, in increasing distance from Mathlib:

* **Unconditional, self-contained.**  The Clifford lamp group on eight sites
  has order exactly `512` (`clBlock_card`); the central amalgam
  `CentralAmalgam I = ∗_{⟨ζ⟩, i ∈ I} ClLamp(8)` is built on Mathlib's
  `Monoid.PushoutI`; its block subgroups have order `512`
  (`blockCard_eq_512`); and it is isomorphic to the presented block-Clifford
  group `LampKernelModel I` of `Sofic/BlockCliffordLamp.lean`
  (`modelEquivAmalgam`).  Every finite subset lies in the sub-amalgam on
  finitely many blocks (`exists_finset_subInclusion_range`), those sub-amalgams
  are finitely generated (`subInclusion_range_fg`), every finitely generated
  subgroup is residually finite (`residuallyFinite_of_fg`), and consequently
  the whole amalgam is sofic (`isSofic_lampKernelModel`).  Blocks are permuted
  by any permutation of the index set, compatibly with the block geometry
  (`blockPerm_maps_blockSubgroup`).

* **A presentation criterion.**  `IsBlockCliffordPresentation` records exactly
  what a group `N` with site elements `c` and a central involution `ζ` must
  satisfy to *be* the amalgam: the four Clifford relations, generation, and the
  universal property.  Two groups satisfying it are canonically isomorphic
  (`exists_mulEquiv_of_isBlockCliffordPresentation`), and any such group is the
  central Clifford amalgam on its block set (`lampKernel_eq_amalgam`).

* **The literal interface.**  `blockGroup` is the subgroup of the literal
  `MarkedGroup` generated by the eight lamp conjugates of a block;
  `blockGroup_card` computes its order as `512` from the criterion, and
  `blockGroup_conj` is the statement that the base permutes the block groups
  along the block geometry.

**What is a hypothesis and what is proved.**  Everything about the *abstract*
amalgam is proved outright.  The identification of the literal lamp kernel with
that amalgam is *not*: it rests on Lemmas 2.1–3.1 and Propositions 4.1–4.2 of
the source document, whose inputs (I1)–(I2) are the conditional literature
layer `B ≅ ℤ³ ⋊ SL₃(ℤ)`.  That identification therefore enters here as the
explicit hypothesis `IsBlockCliffordPresentation` plus a chart
`∀ i, Fin 8 ≃ {s // blockOf s = i}` witnessing that every block carries exactly
eight sites.  Virtual freeness of the finite sub-amalgams is likewise an
explicit hypothesis (Karrass–Pietrowski–Solitar / Bass–Serre), because Mathlib
has no structure theory for groups acting on trees; the *unconditional*
substitute proved here is residual finiteness of the finite sub-amalgams, which
is what the soficity tower actually consumes.

The sanity check of §6 of the source (the kernel of `E → W` is free, hence
`N_E` is not the free lamp group) is respected: nothing below claims that the
blocks pairwise commute, and `blockCard_eq_512` would be false for the
collapsed witness `ClLamp(X)`.
-/

namespace GroupApproximation
namespace LiteralLampKernelAmalgam

open Monoid
open scoped commutatorElement

set_option linter.unusedSectionVars false

/-! ## 1.  Sign vectors and the order of the Clifford lamp group -/

section SignVectors

variable (X : Type) [Fintype X] [DecidableEq X]

/-- The sign vector supported at a single site. -/
def flipVec (x : X) : X → Multiplicative (ZMod 2) :=
  fun x' => if x' = x then Multiplicative.ofAdd 1 else 1

theorem flipVec_apply (x x' : X) :
    flipVec X x x' = if x' = x then Multiplicative.ofAdd (1 : ZMod 2) else 1 := rfl

theorem flipVec_mul_self (x : X) : flipVec X x * flipVec X x = 1 := by
  funext x'
  show flipVec X x x' * flipVec X x x' = (1 : Multiplicative (ZMod 2))
  by_cases h : x' = x
  · rw [flipVec_apply, if_pos h, ← ofAdd_add,
      show (1 : ZMod 2) + 1 = 0 by decide]
    rfl
  · rw [flipVec_apply, if_neg h, one_mul]

theorem mem_sset_iff (ε : X → Multiplicative (ZMod 2)) (y : X) :
    y ∈ BlockCliffordLamp.sset ε ↔ Multiplicative.toAdd (ε y) = 1 := by
  rw [BlockCliffordLamp.sset, Finset.mem_filter]
  exact ⟨fun h => h.2, fun h => ⟨Finset.mem_univ y, h⟩⟩

/-- Every sign vector is the product of the single-site flips in its support.
This is the only place the finiteness of the site set is used for the order
computation. -/
theorem prod_flipVec (ε : X → Multiplicative (ZMod 2)) :
    ∏ x ∈ BlockCliffordLamp.sset ε, flipVec X x = ε := by
  funext y
  rw [Finset.prod_apply]
  have hpt : ∀ x : X,
      flipVec X x y = if y = x then Multiplicative.ofAdd (1 : ZMod 2) else 1 :=
    fun x => flipVec_apply X x y
  rw [Finset.prod_congr rfl (fun x _ => hpt x), Finset.prod_ite_eq]
  by_cases hy : y ∈ BlockCliffordLamp.sset ε
  · rw [if_pos hy]
    have h1 : Multiplicative.toAdd (ε y) = 1 := (mem_sset_iff X ε y).mp hy
    calc Multiplicative.ofAdd (1 : ZMod 2)
        = Multiplicative.ofAdd (Multiplicative.toAdd (ε y)) := by rw [h1]
      _ = ε y := Multiplicative.ofAdd_toAdd _
  · rw [if_neg hy]
    have h1 : Multiplicative.toAdd (ε y) ≠ 1 := fun h =>
      hy ((mem_sset_iff X ε y).mpr h)
    have h0 : Multiplicative.toAdd (ε y) = 0 := by
      have hc : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
      rcases hc (Multiplicative.toAdd (ε y)) with h | h
      · exact h
      · exact absurd h h1
    calc (1 : Multiplicative (ZMod 2))
        = Multiplicative.ofAdd (0 : ZMod 2) := rfl
      _ = Multiplicative.ofAdd (Multiplicative.toAdd (ε y)) := by rw [h0]
      _ = ε y := Multiplicative.ofAdd_toAdd _

end SignVectors

section CliffordOrder

variable (X : Type)

theorem sign_mem_center :
    CliffordLamp.sign X ∈ Subgroup.center (CliffordLamp.CliffordLamp X) :=
  Subgroup.mem_center_iff.mpr fun g => ((CliffordLamp.sign_commute X g).symm).eq

instance signZpowersNormal :
    (Subgroup.zpowers (CliffordLamp.sign X)).Normal :=
  normal_zpowers_of_mem_center (sign_mem_center X)

/-- The Clifford lamp group modulo its central sign. -/
abbrev SignQuotient : Type :=
  CliffordLamp.CliffordLamp X ⧸ Subgroup.zpowers (CliffordLamp.sign X)

/-- A lamp in the sign quotient. -/
def lampBar (x : X) : SignQuotient X :=
  QuotientGroup.mk' _ (CliffordLamp.lamp X x)

theorem lampBar_sq (x : X) : lampBar X x * lampBar X x = 1 := by
  rw [lampBar, ← map_mul, ← pow_two, CliffordLamp.lamp_sq, map_one]

theorem lampBar_commute (x y : X) : Commute (lampBar X x) (lampBar X y) := by
  by_cases h : x = y
  · subst h; exact Commute.refl _
  · have hone : ⁅lampBar X x, lampBar X y⁆ = 1 := by
      rw [lampBar, lampBar, ← map_commutatorElement,
        CliffordLamp.commutator_lamp_lamp X h, QuotientGroup.mk'_apply,
        QuotientGroup.eq_one_iff]
      exact Subgroup.mem_zpowers _
    exact commutatorElement_eq_one_iff_commute.mp hone

/-- Generator images in the abelianised sign group: the sign dies, a lamp
becomes its coordinate flip. -/
def abelGenerator [Fintype X] [DecidableEq X] :
    CliffordLamp.Generator X → (X → Multiplicative (ZMod 2)) :=
  Sum.elim (fun _ => 1) (fun x => flipVec X x)

theorem abelGenerator_kills [Fintype X] [DecidableEq X] :
    ∀ w ∈ CliffordLamp.relators X, FreeGroup.lift (abelGenerator X) w = 1 := by
  intro w hw
  change CliffordLamp.IsRelator X w at hw
  cases hw with
  | sign_sq =>
      rw [map_pow, FreeGroup.lift_apply_of]
      show (1 : X → Multiplicative (ZMod 2)) ^ 2 = 1
      rw [one_pow]
  | lamp_sq x =>
      rw [map_pow, FreeGroup.lift_apply_of]
      show flipVec X x ^ 2 = 1
      rw [pow_two, flipVec_mul_self]
  | sign_comm x =>
      rw [map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of]
      show ⁅(1 : X → Multiplicative (ZMod 2)), flipVec X x⁆ = 1
      exact (Commute.one_left _).commutator_eq
  | @braiding x y _ =>
      rw [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      show ⁅flipVec X x, flipVec X y⁆ * ((1 : X → Multiplicative (ZMod 2)))⁻¹
        = 1
      rw [(Commute.all (flipVec X x) (flipVec X y)).commutator_eq, inv_one,
        mul_one]

/-- The abelianisation-with-sign-killed homomorphism. -/
def abelHom [Fintype X] [DecidableEq X] :
    CliffordLamp.CliffordLamp X →* (X → Multiplicative (ZMod 2)) :=
  PresentedGroup.toGroup (abelGenerator_kills X)

@[simp] theorem abelHom_sign [Fintype X] [DecidableEq X] :
    abelHom X (CliffordLamp.sign X) = 1 :=
  PresentedGroup.toGroup.of _

@[simp] theorem abelHom_lamp [Fintype X] [DecidableEq X] (x : X) :
    abelHom X (CliffordLamp.lamp X x) = flipVec X x :=
  PresentedGroup.toGroup.of _

/-- The descended abelianisation on the sign quotient. -/
def abelBar [Fintype X] [DecidableEq X] :
    SignQuotient X →* (X → Multiplicative (ZMod 2)) :=
  QuotientGroup.lift _ (abelHom X) (by
    intro g hg
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hg
    rw [MonoidHom.mem_ker, map_zpow, abelHom_sign, one_zpow])

@[simp] theorem abelBar_mk [Fintype X] [DecidableEq X]
    (g : CliffordLamp.CliffordLamp X) :
    abelBar X (QuotientGroup.mk' _ g) = abelHom X g := rfl

/-- The inverse direction: a sign vector becomes the product of its lamps in
the sign quotient, where same-site-set lamps commute. -/
def barHom [Fintype X] [DecidableEq X] :
    (X → Multiplicative (ZMod 2)) →* SignQuotient X :=
  BlockCliffordLamp.signProdHom (fun x => lampBar X x)
    (fun a b => lampBar_commute X a b) (fun b => lampBar_sq X b)

theorem barHom_flipVec [Fintype X] [DecidableEq X] (x : X) :
    barHom X (flipVec X x) = lampBar X x := by
  have hs : BlockCliffordLamp.sset (flipVec X x) = {x} := by
    ext y
    rw [Finset.mem_singleton, mem_sset_iff]
    constructor
    · intro h
      by_contra hy
      rw [flipVec_apply, if_neg hy] at h
      exact absurd h (by decide)
    · intro h
      subst h
      rw [flipVec_apply, if_pos rfl]
      rfl
  rw [barHom, BlockCliffordLamp.signProdHom_apply, hs,
    BlockCliffordLamp.prodOf_singleton]

theorem barHom_comp_abelBar [Fintype X] [DecidableEq X] :
    (barHom X).comp (abelBar X) = MonoidHom.id (SignQuotient X) := by
  apply QuotientGroup.monoidHom_ext
  apply PresentedGroup.ext
  intro j
  match j with
  | Sum.inl () =>
      show barHom X (abelHom X (CliffordLamp.sign X))
        = QuotientGroup.mk' (Subgroup.zpowers (CliffordLamp.sign X))
            (CliffordLamp.sign X)
      rw [abelHom_sign, map_one, QuotientGroup.mk'_apply, eq_comm,
        QuotientGroup.eq_one_iff]
      exact Subgroup.mem_zpowers _
  | Sum.inr x =>
      show barHom X (abelHom X (CliffordLamp.lamp X x))
        = QuotientGroup.mk' (Subgroup.zpowers (CliffordLamp.sign X))
            (CliffordLamp.lamp X x)
      rw [abelHom_lamp, barHom_flipVec]
      rfl

theorem abelBar_comp_barHom [Fintype X] [DecidableEq X] :
    (abelBar X).comp (barHom X)
      = MonoidHom.id (X → Multiplicative (ZMod 2)) := by
  ext ε
  show abelBar X (barHom X ε) = ε
  conv_rhs => rw [← prod_flipVec X ε]
  rw [← prod_flipVec X ε, map_prod, map_prod]
  refine Finset.prod_congr rfl (fun x _ => ?_)
  rw [barHom_flipVec, lampBar, abelBar_mk, abelHom_lamp]

/-- **The sign quotient is the elementary abelian sign group.** -/
def signQuotientEquiv [Fintype X] [DecidableEq X] :
    SignQuotient X ≃* (X → Multiplicative (ZMod 2)) :=
  MonoidHom.toMulEquiv (abelBar X) (barHom X) (barHom_comp_abelBar X)
    (abelBar_comp_barHom X)

end CliffordOrder

/-- The two-element multiplicative group used as the amalgamated subgroup. -/
abbrev Z2 : Type := Multiplicative (ZMod 2)

/-- The generator of `Z2`. -/
def zgen : Z2 := Multiplicative.ofAdd 1

theorem zgen_sq : zgen ^ 2 = 1 := by
  rw [pow_two]
  show Multiplicative.ofAdd (1 : ZMod 2) * Multiplicative.ofAdd 1 = 1
  rw [← ofAdd_add, show (1 : ZMod 2) + 1 = 0 by decide]
  rfl

theorem zgen_ne_one : zgen ≠ 1 := by
  intro h
  have h2 : Multiplicative.toAdd zgen = Multiplicative.toAdd (1 : Z2) := by
    rw [h]
  have h3 : (1 : ZMod 2) = 0 := h2
  exact absurd h3 (by decide)

/-- Every element of `Z2` is a power of the generator, with the exponent read
off from the additive coordinate. -/
theorem eq_zgen_pow (a : Z2) : a = zgen ^ (Multiplicative.toAdd a).val := by
  have hc : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
  rcases hc (Multiplicative.toAdd a) with h | h
  · have ha : a = 1 := by
      calc a = Multiplicative.ofAdd (Multiplicative.toAdd a) :=
            (Multiplicative.ofAdd_toAdd a).symm
        _ = Multiplicative.ofAdd (0 : ZMod 2) := by rw [h]
        _ = 1 := rfl
    rw [h, show ((0 : ZMod 2)).val = 0 from rfl, pow_zero]
    exact ha
  · have ha : a = zgen := by
      calc a = Multiplicative.ofAdd (Multiplicative.toAdd a) :=
            (Multiplicative.ofAdd_toAdd a).symm
        _ = Multiplicative.ofAdd (1 : ZMod 2) := by rw [h]
        _ = zgen := rfl
    rw [h, show ((1 : ZMod 2)).val = 1 from rfl, pow_one]
    exact ha

/-- The homomorphism out of `Z2` determined by an involution. -/
def involutionHom {M : Type*} [Group M] (m : M) (hm : m ^ 2 = 1) : Z2 →* M where
  toFun a := m ^ (Multiplicative.toAdd a).val
  map_one' := by
    show m ^ (Multiplicative.toAdd (1 : Z2)).val = 1
    rw [show Multiplicative.toAdd (1 : Z2) = (0 : ZMod 2) from rfl,
      show ((0 : ZMod 2)).val = 0 from rfl, pow_zero]
  map_mul' a b := by
    have hpow : ∀ k : ℕ, m ^ k = m ^ (k % 2) := by
      intro k
      conv_lhs => rw [← Nat.div_add_mod k 2]
      rw [pow_add, pow_mul, hm, one_pow, one_mul]
    show m ^ (Multiplicative.toAdd (a * b)).val
      = m ^ (Multiplicative.toAdd a).val * m ^ (Multiplicative.toAdd b).val
    rw [← pow_add, hpow ((Multiplicative.toAdd a).val
      + (Multiplicative.toAdd b).val)]
    congr 1
    show ((Multiplicative.toAdd a + Multiplicative.toAdd b : ZMod 2)).val
      = ((Multiplicative.toAdd a).val + (Multiplicative.toAdd b).val) % 2
    exact ZMod.val_add _ _

theorem involutionHom_apply {M : Type*} [Group M] (m : M) (hm : m ^ 2 = 1)
    (a : Z2) : involutionHom m hm a = m ^ (Multiplicative.toAdd a).val := rfl

@[simp] theorem involutionHom_zgen {M : Type*} [Group M] (m : M)
    (hm : m ^ 2 = 1) : involutionHom m hm zgen = m := by
  rw [involutionHom_apply, show Multiplicative.toAdd zgen = (1 : ZMod 2) from rfl,
    show ((1 : ZMod 2)).val = 1 from rfl, pow_one]

theorem involutionHom_injective {M : Type*} [Group M] (m : M) (hm : m ^ 2 = 1)
    (hne : m ≠ 1) : Function.Injective (involutionHom m hm) := by
  rw [injective_iff_map_eq_one]
  intro a ha
  have hval : ∀ c : ZMod 2, c.val = 0 ∨ c.val = 1 := by decide
  have hz : ∀ c : ZMod 2, c.val = 0 → c = 0 := by decide
  rcases hval (Multiplicative.toAdd a) with h | h
  · have h0 : Multiplicative.toAdd a = 0 := hz _ h
    calc a = Multiplicative.ofAdd (Multiplicative.toAdd a) :=
          (Multiplicative.ofAdd_toAdd a).symm
      _ = Multiplicative.ofAdd (0 : ZMod 2) := by rw [h0]
      _ = 1 := rfl
  · exfalso
    rw [involutionHom_apply, h, pow_one] at ha
    exact hne ha

theorem involutionHom_comp {M N : Type*} [Group M] [Group N]
    (m : M) (hm : m ^ 2 = 1) (n : N) (hn : n ^ 2 = 1) (f : M →* N)
    (hf : f m = n) :
    f.comp (involutionHom m hm) = involutionHom n hn := by
  ext a
  show f (m ^ (Multiplicative.toAdd a).val) = n ^ (Multiplicative.toAdd a).val
  rw [map_pow, hf]

/-! ## 2.  The Clifford block of eight sites -/

/-- The Clifford lamp group on eight sites: the block group `ClLamp(8)`. -/
abbrev ClBlock : Type := CliffordLamp.CliffordLamp (Fin 8)

/-- The central sign of a Clifford block. -/
def blockSign : ClBlock := CliffordLamp.sign (Fin 8)

/-- The lamp of a Clifford block at one of its eight sites. -/
def blockLamp (b : Fin 8) : ClBlock := CliffordLamp.lamp (Fin 8) b

theorem blockSign_sq : blockSign ^ 2 = 1 := CliffordLamp.sign_sq (Fin 8)

theorem blockSign_ne_one : blockSign ≠ 1 := CliffordLamp.sign_ne_one (Fin 8)

theorem blockSign_commute (g : ClBlock) : Commute blockSign g :=
  CliffordLamp.sign_commute (Fin 8) g

theorem blockLamp_sq (b : Fin 8) : blockLamp b ^ 2 = 1 :=
  CliffordLamp.lamp_sq (Fin 8) b

theorem blockLamp_commutator {b b' : Fin 8} (h : b ≠ b') :
    ⁅blockLamp b, blockLamp b'⁆ = blockSign :=
  CliffordLamp.commutator_lamp_lamp (Fin 8) h

/-- The sign of a block is a commutator of two of its lamps, so the eight
lamps alone generate the block. -/
theorem blockSign_mem_closure_lamps :
    blockSign ∈ Subgroup.closure (Set.range blockLamp) := by
  have h0 : blockLamp 0 ∈ Subgroup.closure (Set.range blockLamp) :=
    Subgroup.subset_closure ⟨0, rfl⟩
  have h1 : blockLamp 1 ∈ Subgroup.closure (Set.range blockLamp) :=
    Subgroup.subset_closure ⟨1, rfl⟩
  have hne : (0 : Fin 8) ≠ 1 := by decide
  rw [← blockLamp_commutator hne, commutatorElement_def]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ h0 h1)
    (Subgroup.inv_mem _ h0)) (Subgroup.inv_mem _ h1)

theorem closure_blockLamp : Subgroup.closure (Set.range blockLamp) = ⊤ := by
  apply eq_top_iff.mpr
  intro g _
  apply PresentedGroup.generated_by (CliffordLamp.relators (Fin 8))
  intro j
  match j with
  | Sum.inl () => exact blockSign_mem_closure_lamps
  | Sum.inr b => exact Subgroup.subset_closure ⟨b, rfl⟩

theorem card_mult_zmod_two : Nat.card Z2 = 2 := Nat.card_zmod 2

theorem card_signVectors (X : Type) [Fintype X] [DecidableEq X] :
    Nat.card (X → Multiplicative (ZMod 2)) = 2 ^ Fintype.card X := by
  rw [Nat.card_pi]
  simp only [card_mult_zmod_two]
  rw [Finset.prod_const, Finset.card_univ]

theorem orderOf_sign (X : Type) : orderOf (CliffordLamp.sign X) = 2 := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  exact orderOf_eq_prime (CliffordLamp.sign_sq X) (CliffordLamp.sign_ne_one X)

theorem card_cliffordLamp (X : Type) [Fintype X] [DecidableEq X] :
    Nat.card (CliffordLamp.CliffordLamp X) = 2 ^ Fintype.card X * 2 := by
  rw [Subgroup.card_eq_card_quotient_mul_card_subgroup
    (Subgroup.zpowers (CliffordLamp.sign X)),
    Nat.card_congr (signQuotientEquiv X).toEquiv, card_signVectors,
    Nat.card_zpowers, orderOf_sign]

/-- **The Clifford block has order `2⁹ = 512`.** -/
theorem clBlock_card : Nat.card ClBlock = 512 := by
  rw [card_cliffordLamp (Fin 8), Fintype.card_fin]
  norm_num

instance : Finite ClBlock := by
  have h : 0 < Nat.card ClBlock := by rw [clBlock_card]; norm_num
  exact (Nat.card_pos_iff.mp h).2

/-! ## 3.  The central Clifford amalgam -/

/-- One Clifford block per index. -/
abbrev blockOfIndex (I : Type) : I → Type := fun _ => ClBlock

/-- The amalgamating maps: the common central involution of the blocks. -/
def zetaHom : Z2 →* ClBlock := involutionHom blockSign blockSign_sq

theorem zetaHom_zgen : zetaHom zgen = blockSign := involutionHom_zgen _ _

theorem zetaHom_injective : Function.Injective zetaHom :=
  involutionHom_injective blockSign blockSign_sq blockSign_ne_one

/-- The amalgamation diagram: `ℤ/2` into every Clifford block as its centre. -/
def zetaFamily (I : Type) : ∀ i : I, Z2 →* blockOfIndex I i := fun _ => zetaHom

theorem zetaFamily_injective (I : Type) :
    ∀ i : I, Function.Injective (zetaFamily I i) := fun _ => zetaHom_injective

/-- **The central Clifford amalgam** `∗_{⟨ζ⟩, i ∈ I} ClLamp(8)`: the free
product of one copy of the order-512 Clifford lamp group per index,
amalgamated over the common central involution. -/
abbrev CentralAmalgam (I : Type) : Type := PushoutI (zetaFamily I)

/-- The common central involution of the amalgam. -/
def amalgamZeta (I : Type) : CentralAmalgam I :=
  PushoutI.base (zetaFamily I) zgen

theorem amalgamZeta_eq_of (I : Type) (i : I) :
    PushoutI.of (φ := zetaFamily I) i blockSign = amalgamZeta I := by
  rw [← zetaHom_zgen]
  exact PushoutI.of_apply_eq_base (zetaFamily I) i zgen

theorem amalgamZeta_sq (I : Type) : amalgamZeta I ^ 2 = 1 := by
  rw [amalgamZeta, ← map_pow, zgen_sq, map_one]

theorem amalgamZeta_ne_one (I : Type) : amalgamZeta I ≠ 1 := by
  intro h
  have h1 : PushoutI.base (zetaFamily I) zgen
      = PushoutI.base (zetaFamily I) 1 := by rw [h, map_one]
  exact zgen_ne_one
    (PushoutI.base_injective (zetaFamily_injective I) h1)

theorem amalgamZeta_central (I : Type) (g : CentralAmalgam I) :
    Commute (amalgamZeta I) g := by
  induction g using PushoutI.induction_on with
  | of i x =>
      rw [← amalgamZeta_eq_of I i, ← map_mul, ← map_mul,
        (blockSign_commute x).eq]
  | base h =>
      exact ((PushoutI.base (zetaFamily I)).map_mul zgen h ▸ rfl :
        _ = _) ▸ (Commute.map (Commute.all zgen h)
          (PushoutI.base (zetaFamily I)))
  | mul a b ha hb => exact ha.mul_right hb

/-- The block subgroup of the amalgam: the image of the `i`-th Clifford
block. -/
def blockSubgroupAm (I : Type) (i : I) : Subgroup (CentralAmalgam I) :=
  (PushoutI.of (φ := zetaFamily I) i).range

/-- **Each block of the amalgam has order `512`.** -/
theorem blockCard_eq_512 (I : Type) (i : I) :
    Nat.card (blockSubgroupAm I i) = 512 := by
  have hinj : Function.Injective (PushoutI.of (φ := zetaFamily I) i) :=
    PushoutI.of_injective (zetaFamily_injective I) i
  rw [blockSubgroupAm,
    ← Nat.card_congr (MonoidHom.ofInjective hinj).toEquiv]
  exact clBlock_card

/-- The block subgroup is generated by the eight lamps of the block: the
central sign is one of their commutators. -/
theorem blockSubgroupAm_eq_closure (I : Type) (i : I) :
    blockSubgroupAm I i
      = Subgroup.closure
          (Set.range fun b : Fin 8 =>
            PushoutI.of (φ := zetaFamily I) i (blockLamp b)) := by
  rw [blockSubgroupAm, ← MonoidHom.range_eq_map, ← closure_blockLamp,
    MonoidHom.map_closure, ← Set.range_comp]
  rfl

/-! ## 4.  The presented block-Clifford model and the amalgam -/

/-- Eight sites per block. -/
abbrev EightBlocks (I : Type) : I → Type := fun _ => Fin 8

/-- The presented model of the lamp kernel: the block Clifford lamp group on
`I` blocks of eight sites each. -/
abbrev LampKernelModel (I : Type) : Type :=
  BlockCliffordLamp.BlockClifford I (EightBlocks I)

/-- The central sign of the model. -/
def modelZeta (I : Type) : LampKernelModel I :=
  BlockCliffordLamp.sign I (EightBlocks I)

/-- The lamp of the model at a site. -/
def modelLamp (I : Type) (i : I) (b : Fin 8) : LampKernelModel I :=
  BlockCliffordLamp.lamp I (EightBlocks I) ⟨i, b⟩

theorem modelZeta_sq (I : Type) : modelZeta I ^ 2 = 1 :=
  BlockCliffordLamp.sign_sq I (EightBlocks I)

theorem modelZeta_central (I : Type) (g : LampKernelModel I) :
    Commute (modelZeta I) g :=
  BlockCliffordLamp.sign_commute I (EightBlocks I) g

theorem modelLamp_sq (I : Type) (i : I) (b : Fin 8) :
    modelLamp I i b ^ 2 = 1 :=
  BlockCliffordLamp.lamp_sq I (EightBlocks I) ⟨i, b⟩

theorem modelLamp_commutator (I : Type) (i : I) {b b' : Fin 8} (h : b ≠ b') :
    ⁅modelLamp I i b, modelLamp I i b'⁆ = modelZeta I :=
  BlockCliffordLamp.commutator_lamp_lamp I (EightBlocks I) h

/-- Generator images of the model in the amalgam. -/
def toAmalgamGenerator (I : Type) :
    BlockCliffordLamp.Gen I (EightBlocks I) → CentralAmalgam I :=
  Sum.elim (fun _ => amalgamZeta I)
    (fun p => PushoutI.of (φ := zetaFamily I) p.1 (blockLamp p.2))

theorem toAmalgamGenerator_kills (I : Type) :
    ∀ w ∈ BlockCliffordLamp.relators I (EightBlocks I),
      FreeGroup.lift (toAmalgamGenerator I) w = 1 := by
  intro w hw
  change BlockCliffordLamp.IsRelator I (EightBlocks I) w at hw
  cases hw with
  | sign_sq =>
      rw [map_pow, FreeGroup.lift_apply_of]
      exact amalgamZeta_sq I
  | lamp_sq p =>
      rw [map_pow, FreeGroup.lift_apply_of]
      show PushoutI.of (φ := zetaFamily I) p.1 (blockLamp p.2) ^ 2 = 1
      rw [← map_pow, blockLamp_sq, map_one]
  | sign_comm p =>
      rw [map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of]
      exact (amalgamZeta_central I _).commutator_eq
  | @braiding i b b' h =>
      rw [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      show ⁅PushoutI.of (φ := zetaFamily I) i (blockLamp b),
          PushoutI.of (φ := zetaFamily I) i (blockLamp b')⁆
          * (amalgamZeta I)⁻¹ = 1
      rw [← map_commutatorElement, blockLamp_commutator h,
        amalgamZeta_eq_of I i, mul_inv_cancel]

/-- The model maps to the amalgam. -/
def toAmalgam (I : Type) : LampKernelModel I →* CentralAmalgam I :=
  PresentedGroup.toGroup (toAmalgamGenerator_kills I)

@[simp] theorem toAmalgam_zeta (I : Type) :
    toAmalgam I (modelZeta I) = amalgamZeta I :=
  PresentedGroup.toGroup.of _

@[simp] theorem toAmalgam_lamp (I : Type) (i : I) (b : Fin 8) :
    toAmalgam I (modelLamp I i b)
      = PushoutI.of (φ := zetaFamily I) i (blockLamp b) :=
  PresentedGroup.toGroup.of _

/-- Generator images of one Clifford block in the model. -/
def blockToModelGenerator (I : Type) (i : I) :
    CliffordLamp.Generator (Fin 8) → LampKernelModel I :=
  Sum.elim (fun _ => modelZeta I) (fun b => modelLamp I i b)

theorem blockToModelGenerator_kills (I : Type) (i : I) :
    ∀ w ∈ CliffordLamp.relators (Fin 8),
      FreeGroup.lift (blockToModelGenerator I i) w = 1 := by
  intro w hw
  change CliffordLamp.IsRelator (Fin 8) w at hw
  cases hw with
  | sign_sq =>
      rw [map_pow, FreeGroup.lift_apply_of]
      exact modelZeta_sq I
  | lamp_sq b =>
      rw [map_pow, FreeGroup.lift_apply_of]
      exact modelLamp_sq I i b
  | sign_comm b =>
      rw [map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of]
      exact (modelZeta_central I _).commutator_eq
  | @braiding b b' h =>
      rw [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      show ⁅modelLamp I i b, modelLamp I i b'⁆ * (modelZeta I)⁻¹ = 1
      rw [modelLamp_commutator I i h, mul_inv_cancel]

/-- One Clifford block inside the model. -/
def blockToModel (I : Type) (i : I) : ClBlock →* LampKernelModel I :=
  PresentedGroup.toGroup (blockToModelGenerator_kills I i)

@[simp] theorem blockToModel_sign (I : Type) (i : I) :
    blockToModel I i blockSign = modelZeta I :=
  PresentedGroup.toGroup.of _

@[simp] theorem blockToModel_lamp (I : Type) (i : I) (b : Fin 8) :
    blockToModel I i (blockLamp b) = modelLamp I i b :=
  PresentedGroup.toGroup.of _

theorem blockToModel_comp (I : Type) (i : I) :
    (blockToModel I i).comp (zetaFamily I i)
      = involutionHom (modelZeta I) (modelZeta_sq I) :=
  involutionHom_comp blockSign blockSign_sq (modelZeta I) (modelZeta_sq I)
    (blockToModel I i) (blockToModel_sign I i)

/-- The amalgam maps back to the model. -/
def fromAmalgam (I : Type) : CentralAmalgam I →* LampKernelModel I :=
  PushoutI.lift (blockToModel I) (involutionHom (modelZeta I) (modelZeta_sq I))
    (blockToModel_comp I)

@[simp] theorem fromAmalgam_of (I : Type) (i : I) (g : ClBlock) :
    fromAmalgam I (PushoutI.of (φ := zetaFamily I) i g) = blockToModel I i g :=
  PushoutI.lift_of _ _ _ _

@[simp] theorem fromAmalgam_base (I : Type) (h : Z2) :
    fromAmalgam I (PushoutI.base (zetaFamily I) h)
      = involutionHom (modelZeta I) (modelZeta_sq I) h :=
  PushoutI.lift_base _ _ _ _

theorem fromAmalgam_comp_toAmalgam (I : Type) :
    (fromAmalgam I).comp (toAmalgam I) = MonoidHom.id (LampKernelModel I) := by
  apply PresentedGroup.ext
  intro j
  match j with
  | Sum.inl () =>
      show fromAmalgam I (toAmalgam I (modelZeta I)) = modelZeta I
      rw [toAmalgam_zeta, amalgamZeta, fromAmalgam_base, involutionHom_zgen]
  | Sum.inr p =>
      show fromAmalgam I (toAmalgam I (modelLamp I p.1 p.2))
        = modelLamp I p.1 p.2
      rw [toAmalgam_lamp, fromAmalgam_of, blockToModel_lamp]

theorem toAmalgam_comp_fromAmalgam (I : Type) :
    (toAmalgam I).comp (fromAmalgam I) = MonoidHom.id (CentralAmalgam I) := by
  apply PushoutI.hom_ext
  · intro i
    apply PresentedGroup.ext
    intro j
    match j with
    | Sum.inl () =>
        show toAmalgam I (fromAmalgam I
          (PushoutI.of (φ := zetaFamily I) i blockSign))
          = PushoutI.of (φ := zetaFamily I) i blockSign
        rw [fromAmalgam_of, blockToModel_sign, toAmalgam_zeta,
          amalgamZeta_eq_of I i]
    | Sum.inr b =>
        show toAmalgam I (fromAmalgam I
          (PushoutI.of (φ := zetaFamily I) i (blockLamp b)))
          = PushoutI.of (φ := zetaFamily I) i (blockLamp b)
        rw [fromAmalgam_of, blockToModel_lamp, toAmalgam_lamp]
  · ext a
    show toAmalgam I (fromAmalgam I (PushoutI.base (zetaFamily I) a))
      = PushoutI.base (zetaFamily I) a
    rw [fromAmalgam_base, involutionHom_apply, map_pow, toAmalgam_zeta]
    conv_rhs => rw [eq_zgen_pow a]
    rw [map_pow]
    rfl

/-- **Theorem 5.1.**  The presented block-Clifford group on `I` blocks of eight
sites is the free product of `I` copies of the order-512 Clifford lamp group,
amalgamated over their common central involution. -/
def modelEquivAmalgam (I : Type) : LampKernelModel I ≃* CentralAmalgam I :=
  MonoidHom.toMulEquiv (toAmalgam I) (fromAmalgam I)
    (fromAmalgam_comp_toAmalgam I) (toAmalgam_comp_fromAmalgam I)

@[simp] theorem modelEquivAmalgam_zeta (I : Type) :
    modelEquivAmalgam I (modelZeta I) = amalgamZeta I :=
  toAmalgam_zeta I

@[simp] theorem modelEquivAmalgam_lamp (I : Type) (i : I) (b : Fin 8) :
    modelEquivAmalgam I (modelLamp I i b)
      = PushoutI.of (φ := zetaFamily I) i (blockLamp b) :=
  toAmalgam_lamp I i b

/-- The block subgroup inside the model. -/
def blockSubgroup (I : Type) (i : I) : Subgroup (LampKernelModel I) :=
  Subgroup.closure (Set.range fun b : Fin 8 => modelLamp I i b)

theorem map_blockSubgroup (I : Type) (i : I) :
    Subgroup.map (toAmalgam I) (blockSubgroup I i) = blockSubgroupAm I i := by
  rw [blockSubgroup, MonoidHom.map_closure, ← Set.range_comp,
    blockSubgroupAm_eq_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨b, rfl⟩
    exact ⟨b, by rw [Function.comp_apply, toAmalgam_lamp]⟩
  · rintro ⟨b, rfl⟩
    exact ⟨b, by rw [Function.comp_apply, toAmalgam_lamp]⟩

/-- **Each block subgroup of the model has order `512`.** -/
theorem blockSubgroup_card (I : Type) (i : I) :
    Nat.card (blockSubgroup I i) = 512 := by
  have hinj : Function.Injective (toAmalgam I) :=
    (modelEquivAmalgam I).injective
  rw [Nat.card_congr
    (Subgroup.equivMapOfInjective (blockSubgroup I i) (toAmalgam I) hinj).toEquiv,
    map_blockSubgroup]
  exact blockCard_eq_512 I i

/-! ## 5.  Reindexing the blocks -/

section Reindex

variable {I₁ I₂ I₃ : Type}

/-- Generator images of a block reindexing. -/
def reindexGenerator (σ : I₁ → I₂) :
    BlockCliffordLamp.Gen I₁ (EightBlocks I₁) → LampKernelModel I₂ :=
  Sum.elim (fun _ => modelZeta I₂) (fun p => modelLamp I₂ (σ p.1) p.2)

theorem reindexGenerator_kills (σ : I₁ → I₂) :
    ∀ w ∈ BlockCliffordLamp.relators I₁ (EightBlocks I₁),
      FreeGroup.lift (reindexGenerator σ) w = 1 := by
  intro w hw
  change BlockCliffordLamp.IsRelator I₁ (EightBlocks I₁) w at hw
  cases hw with
  | sign_sq =>
      rw [map_pow, FreeGroup.lift_apply_of]
      exact modelZeta_sq I₂
  | lamp_sq p =>
      rw [map_pow, FreeGroup.lift_apply_of]
      exact modelLamp_sq I₂ (σ p.1) p.2
  | sign_comm p =>
      rw [map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of]
      exact (modelZeta_central I₂ _).commutator_eq
  | @braiding i b b' h =>
      rw [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      show ⁅modelLamp I₂ (σ i) b, modelLamp I₂ (σ i) b'⁆
        * (modelZeta I₂)⁻¹ = 1
      rw [modelLamp_commutator I₂ (σ i) h, mul_inv_cancel]

/-- Reindexing the blocks along a map of index sets. -/
def reindex (σ : I₁ → I₂) : LampKernelModel I₁ →* LampKernelModel I₂ :=
  PresentedGroup.toGroup (reindexGenerator_kills σ)

@[simp] theorem reindex_zeta (σ : I₁ → I₂) :
    reindex σ (modelZeta I₁) = modelZeta I₂ :=
  PresentedGroup.toGroup.of _

@[simp] theorem reindex_lamp (σ : I₁ → I₂) (i : I₁) (b : Fin 8) :
    reindex σ (modelLamp I₁ i b) = modelLamp I₂ (σ i) b :=
  PresentedGroup.toGroup.of _

theorem reindex_comp (σ : I₁ → I₂) (τ : I₂ → I₃) :
    (reindex τ).comp (reindex σ) = reindex (τ ∘ σ) := by
  apply PresentedGroup.ext
  intro j
  match j with
  | Sum.inl () =>
      show reindex τ (reindex σ (modelZeta I₁)) = reindex (τ ∘ σ) (modelZeta I₁)
      rw [reindex_zeta, reindex_zeta, reindex_zeta]
  | Sum.inr p =>
      show reindex τ (reindex σ (modelLamp I₁ p.1 p.2))
        = reindex (τ ∘ σ) (modelLamp I₁ p.1 p.2)
      rw [reindex_lamp, reindex_lamp, reindex_lamp]
      rfl

theorem reindex_id : reindex (id : I₁ → I₁) = MonoidHom.id _ := by
  apply PresentedGroup.ext
  intro j
  match j with
  | Sum.inl () =>
      show reindex (id : I₁ → I₁) (modelZeta I₁) = modelZeta I₁
      rw [reindex_zeta]
  | Sum.inr p =>
      show reindex (id : I₁ → I₁) (modelLamp I₁ p.1 p.2) = modelLamp I₁ p.1 p.2
      rw [reindex_lamp]
      rfl

theorem reindex_leftInverse (σ : I₁ → I₂) (r : I₂ → I₁)
    (h : ∀ i, r (σ i) = i) :
    (reindex r).comp (reindex σ) = MonoidHom.id (LampKernelModel I₁) := by
  rw [reindex_comp]
  have : (r ∘ σ) = id := funext h
  rw [this, reindex_id]

theorem reindex_injective (σ : I₁ → I₂) (r : I₂ → I₁) (h : ∀ i, r (σ i) = i) :
    Function.Injective (reindex σ) := by
  intro a b hab
  have ha := DFunLike.congr_fun (reindex_leftInverse σ r h) a
  have hb := DFunLike.congr_fun (reindex_leftInverse σ r h) b
  simp only [MonoidHom.coe_comp, Function.comp_apply, MonoidHom.id_apply]
    at ha hb
  rw [← ha, ← hb, hab]

end Reindex

/-! ## 6.  Finite sub-amalgams, residual finiteness, soficity -/

section SubAmalgam

variable {I : Type}

/-- The sub-amalgam on a finite set of blocks, included in the whole. -/
def subInclusion (J : Finset I) : LampKernelModel ↥J →* LampKernelModel I :=
  reindex (fun j : ↥J => (j : I))

/-- The retraction that collapses every block outside `J` onto a chosen block
of `J`. -/
def subRetract (J : Finset I) (i₀ : ↥J) :
    LampKernelModel I →* LampKernelModel ↥J :=
  reindex (fun i : I => if h : i ∈ J then (⟨i, h⟩ : ↥J) else i₀)

theorem subRetract_comp_subInclusion (J : Finset I) (i₀ : ↥J) :
    (subRetract J i₀).comp (subInclusion J)
      = MonoidHom.id (LampKernelModel ↥J) := by
  apply reindex_leftInverse
  intro j
  show (if h : (j : I) ∈ J then (⟨(j : I), h⟩ : ↥J) else i₀) = j
  rw [dif_pos j.2]

theorem subInclusion_injective (J : Finset I) (i₀ : ↥J) :
    Function.Injective (subInclusion J) := by
  apply reindex_injective (r := fun i : I => if h : i ∈ J then (⟨i, h⟩ : ↥J)
    else i₀)
  intro j
  show (if h : (j : I) ∈ J then (⟨(j : I), h⟩ : ↥J) else i₀) = j
  rw [dif_pos j.2]

theorem subInclusion_mono {J J' : Finset I} (h : J ⊆ J') :
    (subInclusion J).range ≤ (subInclusion J').range := by
  rintro _ ⟨u, rfl⟩
  refine ⟨reindex (fun j : ↥J => (⟨(j : I), h j.2⟩ : ↥J')) u, ?_⟩
  have hcomp := reindex_comp (fun j : ↥J => (⟨(j : I), h j.2⟩ : ↥J'))
    (fun j' : ↥J' => (j' : I))
  have := DFunLike.congr_fun hcomp u
  simp only [MonoidHom.coe_comp, Function.comp_apply] at this
  rw [subInclusion, subInclusion, this]
  rfl

/-- Every element of the model lies in the sub-amalgam on finitely many
blocks. -/
theorem exists_finset_subInclusion_range (g : LampKernelModel I) :
    ∃ J : Finset I, g ∈ (subInclusion J).range := by
  classical
  obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective _ g
  induction w using FreeGroup.induction_on with
  | C1 => exact ⟨∅, Subgroup.one_mem _⟩
  | of j =>
      match j with
      | Sum.inl () =>
          refine ⟨∅, ⟨modelZeta ↥(∅ : Finset I), ?_⟩⟩
          rw [subInclusion, reindex_zeta]
          rfl
      | Sum.inr p =>
          refine ⟨{p.1}, ⟨modelLamp ↥({p.1} : Finset I)
            ⟨p.1, Finset.mem_singleton_self p.1⟩ p.2, ?_⟩⟩
          rw [subInclusion, reindex_lamp]
          rfl
  | inv_of j hj =>
      obtain ⟨J, hJ⟩ := hj
      rw [map_inv]
      exact ⟨J, Subgroup.inv_mem _ hJ⟩
  | mul a b ha hb =>
      obtain ⟨Ja, hJa⟩ := ha
      obtain ⟨Jb, hJb⟩ := hb
      rw [map_mul]
      exact ⟨Ja ∪ Jb, Subgroup.mul_mem _
        (subInclusion_mono Finset.subset_union_left hJa)
        (subInclusion_mono Finset.subset_union_right hJb)⟩

/-- **The finite sub-amalgams are finitely generated.** -/
theorem subInclusion_range_fg (J : Finset I) : ((subInclusion J).range).FG := by
  classical
  refine Subgroup.fg_iff.mpr ⟨Set.range
    (fun j : BlockCliffordLamp.Gen ↥J (EightBlocks ↥J) =>
      subInclusion J (PresentedGroup.of j)), ?_, Set.finite_range _⟩
  rw [Set.range_comp, ← MonoidHom.map_closure, PresentedGroup.closure_range_of,
    ← MonoidHom.range_eq_map]

/-- **The finite sub-amalgams are residually finite** — this is the finite-`I`
case of `BlockCliffordLamp.residuallyFinite_blockClifford`. -/
theorem residuallyFinite_sub (J : Finset I) :
    Group.ResiduallyFinite (LampKernelModel ↥J) := by
  classical
  exact BlockCliffordLamp.residuallyFinite_blockClifford ↥J (EightBlocks ↥J)

/-- **Every finitely generated subgroup of the amalgam is residually
finite.**  Its generators involve only finitely many blocks, and the
sub-amalgam on those blocks is a retract of the whole. -/
theorem residuallyFinite_of_fg [Nonempty I] (H : Subgroup (LampKernelModel I))
    (hH : H.FG) : Group.ResiduallyFinite H := by
  classical
  obtain ⟨S, hS⟩ := hH
  obtain ⟨i₀⟩ := ‹Nonempty I›
  set f : LampKernelModel I → Finset I := fun g =>
    (exists_finset_subInclusion_range g).choose with hf
  set J : Finset I := insert i₀ (S.biUnion f) with hJ
  have hi₀ : i₀ ∈ J := Finset.mem_insert_self _ _
  have hsub : H ≤ (subInclusion J).range := by
    rw [← hS]
    apply Subgroup.closure_le _ |>.mpr
    intro g hg
    have hgJ : f g ⊆ J := by
      intro i hi
      refine Finset.mem_insert_of_mem (Finset.mem_biUnion.mpr ⟨g, ?_, hi⟩)
      exact hg
    exact subInclusion_mono hgJ (exists_finset_subInclusion_range g).choose_spec
  haveI := residuallyFinite_sub J
  refine residuallyFinite_of_injective
    ((subRetract J ⟨i₀, hi₀⟩).comp H.subtype) ?_
  rintro ⟨a, ha⟩ ⟨b, hb⟩ hab
  obtain ⟨u, hu⟩ := hsub ha
  obtain ⟨v, hv⟩ := hsub hb
  have hau : subRetract J ⟨i₀, hi₀⟩ a = u := by
    rw [← hu]
    exact DFunLike.congr_fun (subRetract_comp_subInclusion J ⟨i₀, hi₀⟩) u
  have hbv : subRetract J ⟨i₀, hi₀⟩ b = v := by
    rw [← hv]
    exact DFunLike.congr_fun (subRetract_comp_subInclusion J ⟨i₀, hi₀⟩) v
  simp only [MonoidHom.coe_comp, Function.comp_apply, Subgroup.coe_subtype]
    at hab
  apply Subtype.ext
  rw [← hu, ← hv, ← hau, ← hbv, hab]

/-- **The lamp-kernel model is sofic.**  Local residual finiteness gives LEF,
and LEF groups are sofic. -/
theorem isSofic_lampKernelModel [Nonempty I] : IsSofic (LampKernelModel I) :=
  isSofic_of_locallyResiduallyFinite residuallyFinite_of_fg

/-- **The central Clifford amalgam is sofic.** -/
theorem isSofic_centralAmalgam [Nonempty I] : IsSofic (CentralAmalgam I) :=
  isSofic_of_injective (modelEquivAmalgam I).symm.toMonoidHom
    (modelEquivAmalgam I).symm.injective isSofic_lampKernelModel

end SubAmalgam

/-! ## 7.  The base permutes the blocks -/

section BlockPermutation

variable {I : Type}

/-- The automorphism of the model induced by a permutation of the blocks
together with a permutation of the eight sites inside each block. -/
def blockPermGenerator (σ : Equiv.Perm I) (τ : I → Equiv.Perm (Fin 8)) :
    BlockCliffordLamp.Gen I (EightBlocks I) → LampKernelModel I :=
  Sum.elim (fun _ => modelZeta I) (fun p => modelLamp I (σ p.1) (τ p.1 p.2))

theorem blockPermGenerator_kills (σ : Equiv.Perm I)
    (τ : I → Equiv.Perm (Fin 8)) :
    ∀ w ∈ BlockCliffordLamp.relators I (EightBlocks I),
      FreeGroup.lift (blockPermGenerator σ τ) w = 1 := by
  intro w hw
  change BlockCliffordLamp.IsRelator I (EightBlocks I) w at hw
  cases hw with
  | sign_sq =>
      rw [map_pow, FreeGroup.lift_apply_of]
      exact modelZeta_sq I
  | lamp_sq p =>
      rw [map_pow, FreeGroup.lift_apply_of]
      exact modelLamp_sq I (σ p.1) (τ p.1 p.2)
  | sign_comm p =>
      rw [map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of]
      exact (modelZeta_central I _).commutator_eq
  | @braiding i b b' h =>
      rw [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      show ⁅modelLamp I (σ i) (τ i b), modelLamp I (σ i) (τ i b')⁆
        * (modelZeta I)⁻¹ = 1
      rw [modelLamp_commutator I (σ i)
        (fun hc => h ((τ i).injective hc)), mul_inv_cancel]

/-- The endomorphism realising a block permutation. -/
def blockPermMap (σ : Equiv.Perm I) (τ : I → Equiv.Perm (Fin 8)) :
    LampKernelModel I →* LampKernelModel I :=
  PresentedGroup.toGroup (blockPermGenerator_kills σ τ)

@[simp] theorem blockPermMap_zeta (σ : Equiv.Perm I)
    (τ : I → Equiv.Perm (Fin 8)) :
    blockPermMap σ τ (modelZeta I) = modelZeta I :=
  PresentedGroup.toGroup.of _

@[simp] theorem blockPermMap_lamp (σ : Equiv.Perm I)
    (τ : I → Equiv.Perm (Fin 8)) (i : I) (b : Fin 8) :
    blockPermMap σ τ (modelLamp I i b) = modelLamp I (σ i) (τ i b) :=
  PresentedGroup.toGroup.of _

/-- **The blocks are permuted along the block geometry.**  A permutation of
the blocks carries the `i`-th block subgroup onto the `σ i`-th one. -/
theorem blockPerm_maps_blockSubgroup (σ : Equiv.Perm I)
    (τ : I → Equiv.Perm (Fin 8)) (i : I) :
    Subgroup.map (blockPermMap σ τ) (blockSubgroup I i)
      = blockSubgroup I (σ i) := by
  rw [blockSubgroup, MonoidHom.map_closure, ← Set.range_comp, blockSubgroup]
  congr 1
  ext g
  constructor
  · rintro ⟨b, rfl⟩
    exact ⟨τ i b, by rw [Function.comp_apply, blockPermMap_lamp]⟩
  · rintro ⟨b, rfl⟩
    refine ⟨(τ i).symm b, ?_⟩
    rw [Function.comp_apply, blockPermMap_lamp, Equiv.apply_symm_apply]

end BlockPermutation

/-! ## 8.  The presentation criterion -/

/-- A group `N` with site elements `c` and a central involution `ζ` **is** the
block-Clifford presentation on the site set `Site` fibred over the block set
`Block` when it satisfies the four Clifford relations, is generated by them,
and has the universal property.

This is the interface through which the literal lamp kernel enters: `lift` and
`generated` together say that `N` is *presented* by the relations, which is
exactly Lemma 3.1 plus Proposition 4.2 of the source document, and is not
provable from the relations alone. -/
structure IsBlockCliffordPresentation (Block Site : Type) (blockOf : Site → Block)
    (N : Type) [Group N] (c : Site → N) (ζ : N) : Prop where
  /-- Every lamp is an involution. -/
  c_sq : ∀ s, c s ^ 2 = 1
  /-- The mark is an involution. -/
  zeta_sq : ζ ^ 2 = 1
  /-- The mark is central. -/
  zeta_central : ∀ g : N, Commute ζ g
  /-- Distinct sites of one block anticommute through the mark. -/
  braid : ∀ {s s' : Site}, blockOf s = blockOf s' → s ≠ s' → ⁅c s, c s'⁆ = ζ
  /-- The universal property. -/
  lift : ∀ (M : Type) [Group M] (c' : Site → M) (ζ' : M),
      (∀ s, c' s ^ 2 = 1) → ζ' ^ 2 = 1 → (∀ g : M, Commute ζ' g) →
      (∀ {s s' : Site}, blockOf s = blockOf s' → s ≠ s' → ⁅c' s, c' s'⁆ = ζ') →
      ∃ F : N →* M, (∀ s, F (c s) = c' s) ∧ F ζ = ζ'
  /-- The lamps and the mark generate. -/
  generated : ∀ H : Subgroup N, ζ ∈ H → (∀ s, c s ∈ H) → H = ⊤

namespace IsBlockCliffordPresentation

/-- The criterion transports along a relabelling of the site set that respects
the block map. -/
theorem reindexSites {Block S₁ S₂ : Type} {b₁ : S₁ → Block} {b₂ : S₂ → Block}
    (e : S₁ ≃ S₂) (he : ∀ p, b₂ (e p) = b₁ p)
    {N : Type} [Group N] {c : S₂ → N} {ζ : N}
    (h : IsBlockCliffordPresentation Block S₂ b₂ N c ζ) :
    IsBlockCliffordPresentation Block S₁ b₁ N (fun s => c (e s)) ζ where
  c_sq s := h.c_sq (e s)
  zeta_sq := h.zeta_sq
  zeta_central := h.zeta_central
  braid {s s'} hb hne := by
    refine h.braid ?_ (fun hc => hne (e.injective hc))
    rw [he s, he s', hb]
  lift M _ c' ζ' hsq hzsq hzc hbraid := by
    obtain ⟨F, hF, hFz⟩ := h.lift M (fun s₂ => c' (e.symm s₂)) ζ'
      (fun s₂ => hsq _) hzsq hzc (by
        intro s₂ s₂' hb hne
        refine hbraid ?_ (fun hc => hne (by rw [← e.apply_symm_apply s₂,
          ← e.apply_symm_apply s₂', hc]))
        rw [← he (e.symm s₂), ← he (e.symm s₂'), e.apply_symm_apply,
          e.apply_symm_apply, hb])
    refine ⟨F, fun s => ?_, hFz⟩
    rw [hF (e s), e.symm_apply_apply]
  generated H hζ hc := h.generated H hζ (by
    intro s₂
    have := hc (e.symm s₂)
    rwa [e.apply_symm_apply] at this)

end IsBlockCliffordPresentation

/-- The block-Clifford model satisfies its own presentation criterion. -/
theorem isBlockCliffordPresentation_model (I : Type) :
    IsBlockCliffordPresentation I ((i : I) × Fin 8) Sigma.fst
      (LampKernelModel I) (fun p => modelLamp I p.1 p.2) (modelZeta I) where
  c_sq p := modelLamp_sq I p.1 p.2
  zeta_sq := modelZeta_sq I
  zeta_central := modelZeta_central I
  braid {p q} hb hne := by
    obtain ⟨i, b⟩ := p
    obtain ⟨j, b'⟩ := q
    obtain rfl : i = j := hb
    exact modelLamp_commutator I i (fun hc => hne (by rw [hc]))
  lift M _ c' ζ' hsq hzsq hzc hbraid := by
    have hkills : ∀ w ∈ BlockCliffordLamp.relators I (EightBlocks I),
        FreeGroup.lift
          (Sum.elim (fun _ : Unit => ζ') (fun p : (i : I) × Fin 8 => c' p) :
            BlockCliffordLamp.Gen I (EightBlocks I) → M) w = 1 := by
      intro w hw
      change BlockCliffordLamp.IsRelator I (EightBlocks I) w at hw
      cases hw with
      | sign_sq =>
          rw [map_pow, FreeGroup.lift_apply_of]
          exact hzsq
      | lamp_sq p =>
          rw [map_pow, FreeGroup.lift_apply_of]
          exact hsq p
      | sign_comm p =>
          rw [map_commutatorElement, FreeGroup.lift_apply_of,
            FreeGroup.lift_apply_of]
          exact (hzc _).commutator_eq
      | @braiding i b b' h =>
          rw [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of,
            FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
          show ⁅c' ⟨i, b⟩, c' ⟨i, b'⟩⁆ * ζ'⁻¹ = 1
          rw [hbraid rfl (fun hc => h (sigma_mk_injective hc)), mul_inv_cancel]
    refine ⟨PresentedGroup.toGroup hkills, fun p => ?_, ?_⟩
    · exact PresentedGroup.toGroup.of _
    · exact PresentedGroup.toGroup.of _
  generated H hζ hc := by
    apply eq_top_iff.mpr
    intro g _
    apply PresentedGroup.generated_by (BlockCliffordLamp.relators I
      (EightBlocks I))
    intro j
    match j with
    | Sum.inl () => exact hζ
    | Sum.inr p => exact hc p

/-- **Two groups presented by the same block-Clifford data are canonically
isomorphic**, by an isomorphism matching lamps with lamps and mark with
mark. -/
theorem exists_mulEquiv_of_isBlockCliffordPresentation
    {Block Site : Type} {blockOf : Site → Block}
    {N₁ : Type} [Group N₁] {c₁ : Site → N₁} {ζ₁ : N₁}
    (h₁ : IsBlockCliffordPresentation Block Site blockOf N₁ c₁ ζ₁)
    {N₂ : Type} [Group N₂] {c₂ : Site → N₂} {ζ₂ : N₂}
    (h₂ : IsBlockCliffordPresentation Block Site blockOf N₂ c₂ ζ₂) :
    ∃ E : N₁ ≃* N₂, (∀ s, E (c₁ s) = c₂ s) ∧ E ζ₁ = ζ₂ := by
  obtain ⟨F, hF, hFz⟩ := h₁.lift N₂ c₂ ζ₂ h₂.c_sq h₂.zeta_sq h₂.zeta_central
    (fun {_ _} hb hne => h₂.braid hb hne)
  obtain ⟨G, hG, hGz⟩ := h₂.lift N₁ c₁ ζ₁ h₁.c_sq h₁.zeta_sq h₁.zeta_central
    (fun {_ _} hb hne => h₁.braid hb hne)
  have hGF : G.comp F = MonoidHom.id N₁ := by
    have hstab : (⊤ : Subgroup N₁) ≤
        { carrier := {x : N₁ | G (F x) = x}
          one_mem' := by simp
          mul_mem' := by
            intro a b ha hb
            show G (F (a * b)) = a * b
            rw [map_mul, map_mul]
            exact congrArg₂ (· * ·) ha hb
          inv_mem' := by
            intro a ha
            show G (F a⁻¹) = a⁻¹
            rw [map_inv, map_inv]
            exact congrArg Inv.inv ha } := by
      apply le_of_eq
      refine (h₁.generated _ ?_ ?_).symm
      · show G (F ζ₁) = ζ₁
        rw [hFz, hGz]
      · intro s
        show G (F (c₁ s)) = c₁ s
        rw [hF s, hG s]
    apply MonoidHom.ext
    intro x
    exact hstab (Subgroup.mem_top x)
  have hFG : F.comp G = MonoidHom.id N₂ := by
    have hstab : (⊤ : Subgroup N₂) ≤
        { carrier := {x : N₂ | F (G x) = x}
          one_mem' := by simp
          mul_mem' := by
            intro a b ha hb
            show F (G (a * b)) = a * b
            rw [map_mul, map_mul]
            exact congrArg₂ (· * ·) ha hb
          inv_mem' := by
            intro a ha
            show F (G a⁻¹) = a⁻¹
            rw [map_inv, map_inv]
            exact congrArg Inv.inv ha } := by
      apply le_of_eq
      refine (h₂.generated _ ?_ ?_).symm
      · show F (G ζ₂) = ζ₂
        rw [hGz, hFz]
      · intro s
        show F (G (c₂ s)) = c₂ s
        rw [hG s, hF s]
    apply MonoidHom.ext
    intro x
    exact hstab (Subgroup.mem_top x)
  exact ⟨MonoidHom.toMulEquiv F G hGF hFG, hF, hFz⟩

/-! ## 9.  The lamp kernel of the literal group -/

section LiteralInterface

variable {Block Site : Type} (blockOf : Site → Block)

/-- The relabelling of the site set produced by an eight-site chart on every
block. -/
def siteEquiv (chart : ∀ i : Block, Fin 8 ≃ {s : Site // blockOf s = i}) :
    ((i : Block) × Fin 8) ≃ Site :=
  (Equiv.sigmaCongrRight chart).trans (Equiv.sigmaFiberEquiv blockOf)

theorem blockOf_siteEquiv
    (chart : ∀ i : Block, Fin 8 ≃ {s : Site // blockOf s = i})
    (p : (i : Block) × Fin 8) : blockOf (siteEquiv blockOf chart p) = p.1 :=
  (chart p.1 p.2).2

/-- **Theorem 5.1 for the literal lamp kernel.**  A group presented by the
block-Clifford data on a site set whose blocks each carry exactly eight sites
is the free product, amalgamated over the common central involution, of one
copy of the order-512 Clifford lamp group per block. -/
theorem lampKernel_eq_amalgam
    (chart : ∀ i : Block, Fin 8 ≃ {s : Site // blockOf s = i})
    {N : Type} [Group N] {c : Site → N} {ζ : N}
    (h : IsBlockCliffordPresentation Block Site blockOf N c ζ) :
    ∃ E : N ≃* CentralAmalgam Block,
      (∀ p : (i : Block) × Fin 8,
        E (c (siteEquiv blockOf chart p))
          = PushoutI.of (φ := zetaFamily Block) p.1 (blockLamp p.2)) ∧
      E ζ = amalgamZeta Block := by
  have hre : IsBlockCliffordPresentation Block ((i : Block) × Fin 8) Sigma.fst N
      (fun p => c (siteEquiv blockOf chart p)) ζ :=
    h.reindexSites (siteEquiv blockOf chart) (blockOf_siteEquiv blockOf chart)
  obtain ⟨E₀, hE₀, hE₀z⟩ :=
    exists_mulEquiv_of_isBlockCliffordPresentation hre
      (isBlockCliffordPresentation_model Block)
  refine ⟨E₀.trans (modelEquivAmalgam Block), fun p => ?_, ?_⟩
  · rw [MulEquiv.trans_apply, hE₀ p]
    exact modelEquivAmalgam_lamp Block p.1 p.2
  · rw [MulEquiv.trans_apply, hE₀z]
    exact modelEquivAmalgam_zeta Block

/-- **The lamp kernel is sofic.** -/
theorem lampKernel_isSofic [Nonempty Block]
    (chart : ∀ i : Block, Fin 8 ≃ {s : Site // blockOf s = i})
    {N : Type} [Group N] {c : Site → N} {ζ : N}
    (h : IsBlockCliffordPresentation Block Site blockOf N c ζ) : IsSofic N := by
  obtain ⟨E, _, _⟩ := lampKernel_eq_amalgam blockOf chart h
  exact isSofic_of_injective E.toMonoidHom E.injective isSofic_centralAmalgam

/-- The block subgroup, inside any group carrying the site elements:
generated by the eight lamps sitting at the sites of one block. -/
def blockGroupOf {N : Type} [Group N] (c : Site → N) (i : Block) : Subgroup N :=
  Subgroup.closure (c '' {s | blockOf s = i})

/-- **Each block subgroup has order `2⁹ = 512`.** -/
theorem blockGroupOf_card
    (chart : ∀ i : Block, Fin 8 ≃ {s : Site // blockOf s = i})
    {N : Type} [Group N] {c : Site → N} {ζ : N}
    (h : IsBlockCliffordPresentation Block Site blockOf N c ζ) (i : Block) :
    Nat.card (blockGroupOf blockOf c i) = 512 := by
  obtain ⟨E, hE, _⟩ := lampKernel_eq_amalgam blockOf chart h
  have himg : Subgroup.map E.toMonoidHom (blockGroupOf blockOf c i)
      = blockSubgroupAm Block i := by
    rw [blockGroupOf, MonoidHom.map_closure, blockSubgroupAm_eq_closure]
    congr 1
    ext g
    constructor
    · rintro ⟨u, ⟨s, hs, rfl⟩, rfl⟩
      refine ⟨(chart i).symm ⟨s, hs⟩, ?_⟩
      have hp : siteEquiv blockOf chart ⟨i, (chart i).symm ⟨s, hs⟩⟩ = s := by
        show ((chart i) ((chart i).symm ⟨s, hs⟩) : Site) = s
        rw [Equiv.apply_symm_apply]
      have := hE ⟨i, (chart i).symm ⟨s, hs⟩⟩
      rw [hp] at this
      exact this.symm
    · rintro ⟨b, rfl⟩
      refine ⟨c (siteEquiv blockOf chart ⟨i, b⟩), ?_, hE ⟨i, b⟩⟩
      exact ⟨siteEquiv blockOf chart ⟨i, b⟩,
        blockOf_siteEquiv blockOf chart ⟨i, b⟩, rfl⟩
  rw [Nat.card_congr (Subgroup.equivMapOfInjective (blockGroupOf blockOf c i)
    E.toMonoidHom E.injective).toEquiv, himg]
  exact blockCard_eq_512 Block i

end LiteralInterface

/-! ### The literal group `E` -/

section LiteralGroup

open LiteralNonMFPresentation

variable {Block Site : Type} (blockOf : Site → Block) (c : Site → MarkedGroup)

/-- **The block subgroups of the literal group.**  For each block `i` of the
orbital graph, the subgroup of the literal forty-one-relator group generated by
the eight lamp conjugates `c_ξ` with `ξ` in that block. -/
def blockGroup (i : Block) : Subgroup MarkedGroup :=
  blockGroupOf blockOf c i

/-- **Each block group of the literal group has order `512`**, given the
block-Clifford presentation of the lamp kernel. -/
theorem blockGroup_card
    (chart : ∀ i : Block, Fin 8 ≃ {s : Site // blockOf s = i})
    (h : IsBlockCliffordPresentation Block Site blockOf MarkedGroup c mark)
    (i : Block) : Nat.card (blockGroup blockOf c i) = 512 :=
  blockGroupOf_card blockOf chart h i

/-- **The base permutes the block groups along the block geometry.**  If
conjugation by `g` moves the site `s` to `act s` and the block map intertwines
`act` with `actB`, then it carries the `i`-th block group onto the `actB i`-th
one.  No presentation hypothesis is needed: this is the geometry of the site
action alone. -/
theorem blockGroup_conj (g : MarkedGroup) (act : Site → Site)
    (actB : Block → Block)
    (hact : ∀ s, g * c s * g⁻¹ = c (act s))
    (hblock : ∀ s, blockOf (act s) = actB (blockOf s))
    (hsurj : ∀ i : Block, ∀ s : Site, blockOf s = actB i →
      ∃ s', blockOf s' = i ∧ act s' = s)
    (i : Block) :
    Subgroup.map (MulAut.conj g).toMonoidHom (blockGroup blockOf c i)
      = blockGroup blockOf c (actB i) := by
  rw [blockGroup, blockGroup, blockGroupOf, blockGroupOf,
    MonoidHom.map_closure]
  congr 1
  ext u
  constructor
  · rintro ⟨v, ⟨s, hs, rfl⟩, rfl⟩
    refine ⟨act s, ?_, ?_⟩
    · rw [hblock s, hs]
    · show g * c s * g⁻¹ = c (act s)
      exact hact s
  · rintro ⟨s, hs, rfl⟩
    obtain ⟨s', hs', rfl⟩ := hsurj i s hs
    exact ⟨c s', ⟨s', hs', rfl⟩, hact s'⟩

end LiteralGroup

/-! ## 10.  Virtual freeness of the finite sub-amalgams

The soficity tower consumes residual finiteness of the finite sub-amalgams,
which is proved outright above (`residuallyFinite_sub`).  Virtual freeness is
the sharper classical statement; Mathlib has no Bass--Serre structure theory,
so it is carried here as an explicit hypothesis naming its external source.
-/

/-- A group is virtually free when some finite-index subgroup is free. -/
def IsVirtuallyFree (G : Type) [Group G] : Prop :=
  ∃ H : Subgroup G, H.index ≠ 0 ∧ ∃ β : Type, Nonempty (↥H ≃* FreeGroup β)

/-- **Karrass--Pietrowski--Solitar / Bass--Serre**, as an explicit hypothesis:
the amalgam of finitely many finite groups over a common finite subgroup is
virtually free.  Nothing in this file proves it. -/
def AmalgamOfFiniteGroupsVirtuallyFree : Prop :=
  ∀ (ι : Type) [Finite ι] (Gi : ι → Type) [∀ i, Group (Gi i)]
    [∀ i, Finite (Gi i)] (Hb : Type) [Group Hb] [Finite Hb]
    (ψ : ∀ i, Hb →* Gi i), (∀ i, Function.Injective (ψ i)) →
    IsVirtuallyFree (PushoutI ψ)

instance : Finite Z2 := by
  have h : 0 < Nat.card Z2 := by rw [card_mult_zmod_two]; norm_num
  exact (Nat.card_pos_iff.mp h).2

/-- **The sub-amalgam on finitely many blocks is virtually free**, given the
Karrass--Pietrowski--Solitar input.  Combined with
`exists_finset_subInclusion_range` and `subInclusion_range_fg`, this is the
statement that every finite subset of the lamp kernel lies in a finitely
generated, virtually free sub-amalgam of finitely many order-512 blocks. -/
theorem fg_subamalgam_virtuallyFree (hKPS : AmalgamOfFiniteGroupsVirtuallyFree)
    {I : Type} (J : Finset I) : IsVirtuallyFree (CentralAmalgam ↥J) :=
  hKPS ↥J (blockOfIndex ↥J) Z2 (zetaFamily ↥J) (zetaFamily_injective ↥J)

end LiteralLampKernelAmalgam
end GroupApproximation
