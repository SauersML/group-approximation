import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Algebra.Group.Subgroup.Map
import Mathlib.GroupTheory.Subgroup.Simple

/-!
# A simple quotient of a supremum of simple factors recovers a factor

Section 52.2 of the ascending-HNN dossier needs one purely group-theoretic
lemma, and it is the step that makes the alternating-lamp family pairwise
noncommensurable: if a restricted direct sum of copies of a finite simple group
`S` has `T` as a simple quotient, then `T ≅ S`.  Without it the family members
could not be told apart at all, since every visible invariant of theirs
coincides -- the differing simple types live only inside the invisible radical.

The proof does not use the direct-sum structure, only that the factors are
normal and generate.  A surjection carries each factor onto a normal subgroup
of the simple target, hence onto `⊥` or `⊤`; not all can be `⊥`, since the
factors generate and the target is nontrivial.  On a factor mapping onto `⊤`
the restriction is surjective with normal kernel, so simplicity of the factor
leaves only the trivial kernel, and the factor is isomorphic to the target.

Stated for `⨆ i, S i = ⊤` rather than for an external direct sum, so that it
applies to the lamp subgroup of a wreath product without first identifying that
subgroup with a sum.
-/

namespace GroupApproximation

universe u v

variable {G : Type u} [Group G] {T : Type v} [Group T]

/-- **Some factor survives.**  A simple quotient of a group generated by normal
subgroups is already a quotient of one of them. -/
theorem exists_map_eq_top_of_isSimpleGroup {ι : Type*} (S : ι → Subgroup G)
    (hnormal : ∀ i, (S i).Normal) (hsup : (⨆ i, S i) = ⊤)
    (hT : IsSimpleGroup T) (f : G →* T) (hf : Function.Surjective f) :
    ∃ i, (S i).map f = ⊤ := by
  haveI := hT.toNontrivial
  by_contra hcon
  push Not at hcon
  have hbot : ∀ i, (S i).map f = ⊥ := by
    intro i
    rcases hT.eq_bot_or_eq_top_of_normal ((S i).map f)
        ((hnormal i).map f hf) with h | h
    · exact h
    · exact absurd h (hcon i)
  have htop : (⊤ : Subgroup T) = ⊥ := by
    calc (⊤ : Subgroup T)
        = (⊤ : Subgroup G).map f := (Subgroup.map_top_of_surjective f hf).symm
      _ = (⨆ i, S i).map f := by rw [hsup]
      _ = ⨆ i, (S i).map f := Subgroup.map_iSup f S
      _ = ⊥ := by simp [hbot]
  exact absurd htop bot_ne_top.symm

/-- **The factor is isomorphic to the target.**  On a factor mapping onto the
whole simple target the restriction is surjective, and its kernel is a proper
normal subgroup of a simple group, hence trivial. -/
noncomputable def mulEquivOfMapEqTop {ι : Type*} (S : ι → Subgroup G) (i : ι)
    (hSsimple : IsSimpleGroup (S i)) (hT : IsSimpleGroup T) (f : G →* T)
    (hmap : (S i).map f = ⊤) :
    (S i) ≃* T := by
  classical
  haveI := hT.toNontrivial
  have hsurj : Function.Surjective (f.comp (S i).subtype) := by
    intro t
    have ht : t ∈ (S i).map f := by rw [hmap]; exact Subgroup.mem_top t
    obtain ⟨s, hs, rfl⟩ := ht
    exact ⟨⟨s, hs⟩, rfl⟩
  have hinj : Function.Injective (f.comp (S i).subtype) := by
    rcases hSsimple.eq_bot_or_eq_top_of_normal (f.comp (S i).subtype).ker
        inferInstance with hbot | htop
    · exact (MonoidHom.ker_eq_bot_iff _).mp hbot
    · exfalso
      obtain ⟨t, ht⟩ := exists_ne (1 : T)
      obtain ⟨s, rfl⟩ := hsurj t
      have hmem : s ∈ (f.comp (S i).subtype).ker := by
        rw [htop]; exact Subgroup.mem_top s
      exact ht (MonoidHom.mem_ker.mp hmem)
  exact MulEquiv.ofBijective _ ⟨hinj, hsurj⟩

/-- **§52.2.**  A simple quotient of a group generated by simple normal
subgroups is isomorphic to one of them.  For a restricted direct sum of copies
of one simple group, this says the simple type is recoverable from the sum, so
sums of copies of nonisomorphic simple groups are nonisomorphic. -/
theorem exists_mulEquiv_of_isSimpleGroup_quotient {ι : Type*} (S : ι → Subgroup G)
    (hnormal : ∀ i, (S i).Normal) (hsimple : ∀ i, IsSimpleGroup (S i))
    (hsup : (⨆ i, S i) = ⊤) (hT : IsSimpleGroup T) (f : G →* T)
    (hf : Function.Surjective f) :
    ∃ i, Nonempty ((S i) ≃* T) := by
  obtain ⟨i, hi⟩ := exists_map_eq_top_of_isSimpleGroup S hnormal hsup hT f hf
  exact ⟨i, ⟨mulEquivOfMapEqTop S i (hsimple i) hT f hi⟩⟩

end GroupApproximation
