import GroupApproximation.Sofic.LiteralNonMFPresentation
import GroupApproximation.Sofic.LiteralBaseRelations
import GroupApproximation.Sofic.LiteralBaseDoublingIndex
import GroupApproximation.Sofic.MappingTelescopeFiniteOrbits
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.GroupTheory.GroupAction.Quotient
import Mathlib.GroupTheory.Commensurable

/-!
# The normal form of the literal forty-one-relator group

Definition `def:E` of `non_mf_groups_exist.tex` presents a group `E` on eight
letters `v₁,v₂,v₃,x,y,z,t,c` by twenty base relators, six doubling relators,
the involution `c²`, six centralising relators `[c,g]`, and eight relators
making the marked word `w = [tct⁻¹, v₁(tct⁻¹)v₁⁻¹]` central.  This module
computes that group completely: it is a semidirect product

    E  ≅  C(𝒢) ⋊ V ,

where `V` is the seven-letter ascending-HNN quotient `E/⟨⟨c⟩⟩`, the *site set*
is the coset space `X = V/B` of the level-zero copy of the base, `𝒢` is the
*orbital graph* on `X` — the `V`-orbit of the single unordered pair
`{τo, v₁τo}` — and `C(𝒢)` is the Clifford group of that graph: involutions
`c_ξ` (`ξ ∈ X`), a central involution `ζ`, and `[c_ξ,c_η] = ζ` exactly along
the edges of `𝒢`.  Under the isomorphism the lamp kernel `⟨⟨c⟩⟩` is the factor
`C(𝒢)`, the marked word `w` is the central sign `ζ`, and the site `gB` carries
the conjugate `g c g⁻¹`.

## The route, and why this one

Two routes to a normal-form theorem are standard: van der Waerden's trick —
act on the set of formal normal forms and read injectivity off faithfulness —
and the *two-sided universal property*: exhibit the model both as a quotient
of the presented group and as a group that maps back, then check the two
composites on generators.  This module takes the second route, and the choice
is forced by what has to stay unconditional.

Van der Waerden here would mean an action on amalgamated normal forms in
`∗_{⟨ζ⟩} P_i`, which presupposes that the connected pieces of `𝒢` are known
finite cliques.  That is not available without identifying the presented base
`B` with `ℤ³ ⋊ SL₃(ℤ)`.  The second route needs no such input: the model is
assembled out of `V` and `X = V/B` themselves, so both

* `E → C(𝒢) ⋊ V`, by evaluating the forty-one relators, and
* `C(𝒢) ⋊ V → E`, by the universal properties of a presented group, of the
  presented Clifford graph group, and of a semidirect product,

exist for structural reasons, and the two composites are checked on the eight
letters and on the generators `ζ, c_ξ` respectively.  Nothing about the
isomorphism type of `B`, the injectivity of the doubling endomorphism, or the
geometry of `𝒢` enters.

## Blocks

The soficity tower consumes the site set fibred over a *block* set.  Blocks are
the cosets of

    K = ⟨ B , β ⟩ ,     β = t⁻¹ v₁ t ,

the subgroup generated by the base together with the element joining the two
marked sites; the doubling relation gives `β² = v₁ ∈ B`.  Adjacent sites lie in
a common block, and `Block = V/K` is a `V`-equivariant quotient of
`Site = V/B`.  Two facts about this fibration are proved, and they are the two
the tower uses:

* every finite subset of the lamp kernel lies in the subgroup generated by the
  marked word together with the site lamps of finitely many blocks;
* every conjugate of the base — in particular every telescope level
  `t⁻ⁿ B tⁿ` — has finite orbits on sites, hence on blocks.

The second rests on the unconditional finite-index theorem
`LiteralBaseDoublingIndex.doubledBase_finiteIndex` (the eight parity cosets),
transported into `V`, and on the commensurated-subgroup criterion of
`MappingTelescopeFiniteOrbits`.

What is deliberately *not* proved here is that a block is a clique with eight
vertices, equivalently that `K = B ∪ BβB`; that is Proposition 4.2 of
`notes/LITERAL_GROUP_BLOCK_AMALGAM_STRUCTURE_2026-08-14.md`, and it rests on the
identification of the base.  Consequently the lamp factor is the Clifford group
of the orbital graph, not visibly a free product of copies of `ClLamp(8)`
amalgamated over `⟨ζ⟩`; the latter is the same group once the clique property
is known, and is a strictly stronger reading of the same isomorphism.
-/

namespace GroupApproximation
namespace LiteralBlockNormalForm

open LiteralNonMFPresentation
open scoped commutatorElement Pointwise

noncomputable section

/-! ## Generic helpers -/

/-- A subgroup of a presented group containing all canonical generators is
everything. -/
theorem mem_of_generators {X : Type*} {R : Set (FreeGroup X)}
    (K : Subgroup (PresentedGroup R))
    (h : ∀ i, (PresentedGroup.of i : PresentedGroup R) ∈ K)
    (g : PresentedGroup R) : g ∈ K := by
  obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective R g
  induction w using FreeGroup.induction_on with
  | C1 => rw [map_one]; exact K.one_mem
  | of i => exact h i
  | inv_of i hi => rw [map_inv]; exact K.inv_mem hi
  | mul a b ha hb => rw [map_mul]; exact K.mul_mem ha hb

/-- An element fixed by conjugation commutes with the conjugator. -/
theorem commute_of_conj_eq {G : Type*} [Group G] {a b : G}
    (h : b * a * b⁻¹ = a) : Commute a b := by
  have hba : b * a = a * b := by
    have hb := congrArg (fun z : G ↦ z * b) h
    simpa using hb
  exact hba.symm

/-- Conjugation passes through commutators. -/
theorem commutator_conj {G : Type*} [Group G] (a u v : G) :
    ⁅a * u * a⁻¹, a * v * a⁻¹⁆ = a * ⁅u, v⁆ * a⁻¹ := by
  simp only [commutatorElement_def]
  group

/-- The eight letters are the six base letters, the stable letter and the lamp
letter. -/
theorem generator_cases (j : Generator) :
    (∃ i : BaseGenerator, j = Generator.base i) ∨
      j = Generator.stable ∨ j = Generator.lamp := by
  rcases j with i | k
  · exact Or.inl ⟨i, rfl⟩
  · fin_cases k
    · exact Or.inr (Or.inl rfl)
    · exact Or.inr (Or.inr rfl)

/-! ## The vertical group

`V` is the literal presentation with the lamp letter killed.  Keeping the same
eight-letter alphabet means the base and doubling relator families are reused
verbatim and the retraction `E ↠ V` is the identity on letters. -/

/-- The relators of the vertical group. -/
def verticalRelators : Set (FreeGroup Generator) :=
  ((transportedBaseRelators : Finset (FreeGroup Generator)) :
      Set (FreeGroup Generator)) ∪
    ((stableRelators : Finset (FreeGroup Generator)) :
      Set (FreeGroup Generator)) ∪
    {lampWord}

/-- The vertical group `V = E/⟨⟨c⟩⟩`. -/
abbrev Vertical : Type := PresentedGroup verticalRelators

/-- Free words evaluated in the vertical group. -/
abbrev verticalWord : FreeGroup Generator →* Vertical :=
  PresentedGroup.mk verticalRelators

theorem transported_mem_verticalRelators {r : FreeGroup Generator}
    (h : r ∈ transportedBaseRelators) : r ∈ verticalRelators :=
  Or.inl (Or.inl (Finset.mem_coe.mpr h))

theorem stableRelator_mem_verticalRelators (i : BaseGenerator) :
    stableRelator i ∈ verticalRelators :=
  Or.inl (Or.inr (Finset.mem_coe.mpr
    (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩)))

theorem lampWord_mem_verticalRelators : lampWord ∈ verticalRelators :=
  Or.inr rfl

theorem transported_relator_eq_one {r : FreeGroup Generator}
    (h : r ∈ transportedBaseRelators) : wordInMarkedGroup r = 1 := by
  refine PresentedGroup.one_of_mem (Finset.mem_coe.mpr ?_)
  simp only [relators, Finset.mem_union]
  exact Or.inl (Or.inl (Or.inl h))

theorem stable_relator_eq_one (i : BaseGenerator) :
    wordInMarkedGroup (stableRelator i) = 1 := by
  refine PresentedGroup.one_of_mem (Finset.mem_coe.mpr ?_)
  simp only [relators, Finset.mem_union]
  exact Or.inl (Or.inl (Or.inr
    (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩)))

@[simp] theorem verticalWord_lampWord : verticalWord lampWord = 1 :=
  PresentedGroup.one_of_mem lampWord_mem_verticalRelators

theorem verticalWord_displacedLampWord :
    verticalWord displacedLampWord = 1 := by
  show verticalWord (stableWord * lampWord * stableWord⁻¹) = 1
  rw [map_mul, map_mul, map_inv, verticalWord_lampWord, mul_one,
    mul_inv_cancel]

theorem verticalWord_markedWord : verticalWord markedWord = 1 := by
  show verticalWord (commutatorWord displacedLampWord
    (v1Word * displacedLampWord * v1Word⁻¹)) = 1
  rw [map_commutatorWord, verticalWord_displacedLampWord, map_mul, map_mul,
    map_inv, verticalWord_displacedLampWord, mul_one, mul_inv_cancel]
  exact commutatorElement_one_left _

/-- Every displayed relator of the literal presentation dies once the lamp
letter is killed. -/
theorem retractKill :
    ∀ r ∈ ((relators : Finset (FreeGroup Generator)) : Set (FreeGroup Generator)),
      FreeGroup.lift (fun j : Generator ↦ verticalWord (FreeGroup.of j)) r = 1 := by
  intro r hr
  rw [freeGroup_lift_presentedGroup_generators]
  have hr' : r ∈ relators := Finset.mem_coe.mp hr
  simp only [relators, Finset.mem_union] at hr'
  rcases hr' with ((hr' | hr') | hr') | hr'
  · exact PresentedGroup.one_of_mem (transported_mem_verticalRelators hr')
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hr'
    exact PresentedGroup.one_of_mem (stableRelator_mem_verticalRelators i)
  · simp only [lampRelators, Finset.mem_union, Finset.mem_singleton,
      Finset.mem_image] at hr'
    rcases hr' with rfl | ⟨i, -, rfl⟩
    · rw [map_pow, verticalWord_lampWord, one_pow]
    · rw [map_commutatorWord, verticalWord_lampWord]
      exact commutatorElement_one_left _
  · simp only [markedRelators, Finset.mem_image] at hr'
    obtain ⟨i, -, rfl⟩ := hr'
    rw [map_commutatorWord, verticalWord_markedWord]
    exact commutatorElement_one_left _

/-- **The retraction `E ↠ V`.** -/
def retract : MarkedGroup →* Vertical := PresentedGroup.toGroup retractKill

@[simp] theorem retract_of (j : Generator) :
    retract (PresentedGroup.of j) = (PresentedGroup.of j : Vertical) :=
  PresentedGroup.toGroup.of _

@[simp] theorem retract_word (w : FreeGroup Generator) :
    retract (wordInMarkedGroup w) = verticalWord w := by
  change (retract.comp wordInMarkedGroup) w = verticalWord w
  refine freeGroup_hom_eq_on_generators ?_ w
  intro j
  rw [MonoidHom.comp_apply]
  exact retract_of j

/-- The vertical image of the literal base. -/
def verticalBase : Base →* Vertical := retract.comp baseMap

@[simp] theorem verticalBase_of (i : BaseGenerator) :
    verticalBase (PresentedGroup.of i) =
      (PresentedGroup.of (Generator.base i) : Vertical) := by
  rw [verticalBase, MonoidHom.comp_apply, baseMap_generator, retract_word]
  rfl

theorem verticalBase_baseWord (w : FreeGroup BaseGenerator) :
    verticalBase (LiteralBaseRelations.baseWord w) =
      verticalWord (embedBaseWord w) := by
  rw [verticalBase, MonoidHom.comp_apply]
  change retract (baseMap (PresentedGroup.mk _ w)) = _
  rw [baseMap_mk, retract_word]

/-- The stable letter inside the vertical group. -/
def vStable : Vertical := PresentedGroup.of Generator.stable

/-- The first translation letter inside the vertical group. -/
def vV1 : Vertical := PresentedGroup.of (Generator.base v1Index)

theorem retract_stable : retract stable = vStable := retract_of _

theorem verticalOf_lamp_eq_one :
    (PresentedGroup.of Generator.lamp : Vertical) = 1 :=
  verticalWord_lampWord

/-- The six doubling relations, transported into the vertical group. -/
theorem vertical_stable_relation (i : BaseGenerator) :
    vStable * verticalBase (PresentedGroup.of i) * vStable⁻¹ =
      verticalBase (LiteralBaseRelations.baseWord (compressedBaseWord i)) := by
  have h := congrArg retract (stable_relation i)
  simp only [map_mul, map_inv, retract_stable] at h
  rw [verticalBase_baseWord]
  change _ = verticalWord (compressedGeneratorWord i)
  rw [← retract_word]
  exact h

/-! ## Sites and blocks -/

/-- The level-zero copy of the base inside the vertical group. -/
def baseSubgroup : Subgroup Vertical := verticalBase.range

/-- The site set `X = V/B`. -/
abbrev Site : Type := Vertical ⧸ baseSubgroup

instance : MulAction Vertical Site :=
  inferInstanceAs (MulAction Vertical (Vertical ⧸ baseSubgroup))

/-- The root site. -/
def origin : Site := QuotientGroup.mk 1

theorem smul_mk (v g : Vertical) :
    v • (QuotientGroup.mk g : Site) = QuotientGroup.mk (v * g) := by
  rw [MulAction.Quotient.smul_mk, smul_eq_mul]

theorem smul_origin (v : Vertical) :
    v • origin = (QuotientGroup.mk v : Site) := by
  rw [origin, smul_mk, mul_one]

theorem smul_origin_of_mem {h : Vertical} (hh : h ∈ baseSubgroup) :
    h • origin = origin := by
  rw [smul_origin]
  show (QuotientGroup.mk h : Site) = QuotientGroup.mk 1
  exact QuotientGroup.eq.mpr (by simpa using baseSubgroup.inv_mem hh)

/-- The first marked site `τo`. -/
def siteA : Site := QuotientGroup.mk vStable

/-- The second marked site `v₁τo`. -/
def siteB : Site := QuotientGroup.mk (vV1 * vStable)

/-- Two sites are adjacent when the ordered pair, in one of the two orders, is
a translate of the marked pair `(τo, v₁τo)`.  This is the edge relation of the
orbital graph `𝒢`. -/
def Adjacent (ξ η : Site) : Prop :=
  (∃ g : Vertical, g • siteA = ξ ∧ g • siteB = η) ∨
    (∃ g : Vertical, g • siteA = η ∧ g • siteB = ξ)

theorem Adjacent.flip {ξ η : Site} (h : Adjacent ξ η) : Adjacent η ξ := h.symm

theorem adjacent_marked : Adjacent siteA siteB :=
  Or.inl ⟨1, one_smul _ _, one_smul _ _⟩

/-- The edge set is `V`-invariant. -/
theorem adjacent_smul {ξ η : Site} (h : Adjacent ξ η) (v : Vertical) :
    Adjacent (v • ξ) (v • η) := by
  rcases h with ⟨g, hga, hgb⟩ | ⟨g, hga, hgb⟩
  · exact Or.inl ⟨v * g, by rw [mul_smul, hga], by rw [mul_smul, hgb]⟩
  · exact Or.inr ⟨v * g, by rw [mul_smul, hga], by rw [mul_smul, hgb]⟩

/-- The element joining the two marked sites.  The doubling relation makes it a
square root of the first translation. -/
def vBeta : Vertical := vStable⁻¹ * vV1 * vStable

/-- The block subgroup `K = ⟨B, β⟩`. -/
def blockSubgroup : Subgroup Vertical :=
  baseSubgroup ⊔ Subgroup.closure ({vBeta} : Set Vertical)

theorem baseSubgroup_le_blockSubgroup : baseSubgroup ≤ blockSubgroup :=
  le_sup_left

theorem vBeta_mem_blockSubgroup : vBeta ∈ blockSubgroup :=
  (le_sup_right : Subgroup.closure {vBeta} ≤ blockSubgroup)
    (Subgroup.subset_closure rfl)

/-- The block set `I = V/K`. -/
abbrev Block : Type := Vertical ⧸ blockSubgroup

instance : MulAction Vertical Block :=
  inferInstanceAs (MulAction Vertical (Vertical ⧸ blockSubgroup))

/-- The fibration of sites over blocks. -/
def blockOf (ξ : Site) : Block :=
  Quotient.liftOn' ξ (fun g ↦ (QuotientGroup.mk g : Block))
    (by
      intro a b hab
      rw [QuotientGroup.leftRel_apply] at hab
      exact QuotientGroup.eq.mpr (baseSubgroup_le_blockSubgroup hab))

@[simp] theorem blockOf_mk (g : Vertical) :
    blockOf (QuotientGroup.mk g : Site) = (QuotientGroup.mk g : Block) := rfl

theorem blockOf_surjective : Function.Surjective blockOf := by
  intro b
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective b
  exact ⟨QuotientGroup.mk g, rfl⟩

theorem blockOf_smul (v : Vertical) (ξ : Site) :
    blockOf (v • ξ) = v • blockOf ξ := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective ξ
  rw [smul_mk, blockOf_mk, blockOf_mk, MulAction.Quotient.smul_mk, smul_eq_mul]

/-- Adjacent sites lie in a common block. -/
theorem blockOf_eq_of_adjacent {ξ η : Site} (h : Adjacent ξ η) :
    blockOf ξ = blockOf η := by
  have key : ∀ g : Vertical, blockOf (g • siteA) = blockOf (g • siteB) := by
    intro g
    rw [siteA, siteB, smul_mk, smul_mk, blockOf_mk, blockOf_mk]
    refine QuotientGroup.eq.mpr ?_
    have hcalc : (g * vStable)⁻¹ * (g * (vV1 * vStable)) = vBeta := by
      rw [vBeta]; group
    rw [hcalc]
    exact vBeta_mem_blockSubgroup
  rcases h with ⟨g, hga, hgb⟩ | ⟨g, hga, hgb⟩
  · rw [← hga, ← hgb]; exact key g
  · rw [← hga, ← hgb]; exact (key g).symm

/-! ## The Clifford group of the orbital graph

One involution per site, a central involution `ζ`, and the braiding relation
`[c_ξ,c_η] = ζ` exactly along the edges. -/

/-- Free generators of the lamp factor: the sign and one lamp per site. -/
abbrev LampGen : Type := Unit ⊕ Site

/-- The defining relator families of the Clifford graph group. -/
inductive IsLampRelator : FreeGroup LampGen → Prop
  | sign_sq : IsLampRelator (FreeGroup.of (Sum.inl ()) ^ 2)
  | lamp_sq (ξ : Site) : IsLampRelator (FreeGroup.of (Sum.inr ξ) ^ 2)
  | sign_comm (ξ : Site) :
      IsLampRelator ⁅(FreeGroup.of (Sum.inl ()) : FreeGroup LampGen),
        FreeGroup.of (Sum.inr ξ)⁆
  | braiding {ξ η : Site} (h : Adjacent ξ η) :
      IsLampRelator (⁅(FreeGroup.of (Sum.inr ξ) : FreeGroup LampGen),
          FreeGroup.of (Sum.inr η)⁆ * (FreeGroup.of (Sum.inl ()))⁻¹)

/-- The relators of the Clifford graph group, as a set. -/
def lampRelatorSet : Set (FreeGroup LampGen) := {w | IsLampRelator w}

/-- The Clifford group `C(𝒢)` of the orbital graph. -/
abbrev LampFactor : Type := PresentedGroup lampRelatorSet

/-- The central sign `ζ`. -/
def lampSign : LampFactor := PresentedGroup.of (Sum.inl ())

/-- The lamp at a site. -/
def lampAt (ξ : Site) : LampFactor := PresentedGroup.of (Sum.inr ξ)

theorem lampSign_sq : lampSign ^ 2 = 1 := by
  have h := PresentedGroup.one_of_mem
    (show FreeGroup.of (Sum.inl ()) ^ 2 ∈ lampRelatorSet from
      IsLampRelator.sign_sq)
  rwa [map_pow] at h

theorem lampAt_sq (ξ : Site) : lampAt ξ ^ 2 = 1 := by
  have h := PresentedGroup.one_of_mem
    (show FreeGroup.of (Sum.inr ξ) ^ 2 ∈ lampRelatorSet from
      IsLampRelator.lamp_sq ξ)
  rwa [map_pow] at h

theorem lampSign_commute_lampAt (ξ : Site) : Commute lampSign (lampAt ξ) := by
  have h := PresentedGroup.one_of_mem
    (show ⁅(FreeGroup.of (Sum.inl ()) : FreeGroup LampGen),
        FreeGroup.of (Sum.inr ξ)⁆ ∈ lampRelatorSet from
      IsLampRelator.sign_comm ξ)
  rw [map_commutatorElement] at h
  exact commutatorElement_eq_one_iff_commute.mp h

/-- The braiding relation along an edge of the orbital graph. -/
theorem commutator_lampAt {ξ η : Site} (h : Adjacent ξ η) :
    ⁅lampAt ξ, lampAt η⁆ = lampSign := by
  have h1 := PresentedGroup.one_of_mem
    (show (⁅(FreeGroup.of (Sum.inr ξ) : FreeGroup LampGen),
        FreeGroup.of (Sum.inr η)⁆ * (FreeGroup.of (Sum.inl ()))⁻¹) ∈
      lampRelatorSet from IsLampRelator.braiding h)
  rw [map_mul, map_inv, map_commutatorElement] at h1
  have h2 : ⁅lampAt ξ, lampAt η⁆ * lampSign⁻¹ = 1 := h1
  calc ⁅lampAt ξ, lampAt η⁆
      = ⁅lampAt ξ, lampAt η⁆ * lampSign⁻¹ * lampSign := by group
    _ = 1 * lampSign := by rw [h2]
    _ = lampSign := one_mul _

/-- The sign is central in the Clifford graph group. -/
theorem lampSign_central (n : LampFactor) : Commute lampSign n := by
  have hmem : n ∈ Subgroup.centralizer ({lampSign} : Set LampFactor) := by
    refine mem_of_generators _ (fun j ↦ ?_) n
    rw [Subgroup.mem_centralizer_singleton_iff]
    match j with
    | Sum.inl () => rfl
    | Sum.inr ξ => exact (lampSign_commute_lampAt ξ).eq.symm
  rw [Subgroup.mem_centralizer_singleton_iff] at hmem
  exact Commute.symm hmem

/-- **Universal property of the Clifford graph group.**  A homomorphism out of
`C(𝒢)` is a central involution together with a family of involutions braiding
into it along the edges. -/
def lampLift {G : Type*} [Group G] (s : G) (c : Site → G)
    (hs : s ^ 2 = 1) (hc : ∀ ξ, c ξ ^ 2 = 1)
    (hsc : ∀ ξ, Commute s (c ξ))
    (hbr : ∀ ξ η, Adjacent ξ η → ⁅c ξ, c η⁆ = s) :
    LampFactor →* G := by
  refine PresentedGroup.toGroup (f := Sum.elim (fun _ ↦ s) c) ?_
  intro w hw
  change IsLampRelator w at hw
  cases hw with
  | sign_sq => rw [map_pow, FreeGroup.lift_apply_of]; exact hs
  | lamp_sq ξ => rw [map_pow, FreeGroup.lift_apply_of]; exact hc ξ
  | sign_comm ξ =>
      rw [map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of]
      exact (hsc ξ).commutator_eq
  | @braiding ξ η h =>
      rw [map_mul, map_inv, map_commutatorElement, FreeGroup.lift_apply_of,
        FreeGroup.lift_apply_of, FreeGroup.lift_apply_of]
      show ⁅c ξ, c η⁆ * s⁻¹ = 1
      rw [hbr ξ η h]
      exact mul_inv_cancel _

@[simp] theorem lampLift_sign {G : Type*} [Group G] (s : G) (c : Site → G)
    (hs : s ^ 2 = 1) (hc : ∀ ξ, c ξ ^ 2 = 1) (hsc : ∀ ξ, Commute s (c ξ))
    (hbr : ∀ ξ η, Adjacent ξ η → ⁅c ξ, c η⁆ = s) :
    lampLift s c hs hc hsc hbr lampSign = s :=
  PresentedGroup.toGroup.of _

@[simp] theorem lampLift_at {G : Type*} [Group G] (s : G) (c : Site → G)
    (hs : s ^ 2 = 1) (hc : ∀ ξ, c ξ ^ 2 = 1) (hsc : ∀ ξ, Commute s (c ξ))
    (hbr : ∀ ξ η, Adjacent ξ η → ⁅c ξ, c η⁆ = s) (ξ : Site) :
    lampLift s c hs hc hsc hbr (lampAt ξ) = c ξ :=
  PresentedGroup.toGroup.of _

/-! ## The vertical action on the lamp factor -/

/-- The endomorphism of `C(𝒢)` induced by a vertical element. -/
def lampPermMap (v : Vertical) : LampFactor →* LampFactor :=
  lampLift lampSign (fun ξ ↦ lampAt (v • ξ)) lampSign_sq
    (fun _ ↦ lampAt_sq _) (fun _ ↦ lampSign_commute_lampAt _)
    (fun _ _ h ↦ commutator_lampAt (adjacent_smul h v))

@[simp] theorem lampPermMap_sign (v : Vertical) :
    lampPermMap v lampSign = lampSign :=
  lampLift_sign _ _ _ _ _ _

@[simp] theorem lampPermMap_at (v : Vertical) (ξ : Site) :
    lampPermMap v (lampAt ξ) = lampAt (v • ξ) :=
  lampLift_at _ _ _ _ _ _ ξ

theorem lampPermMap_comp (v w : Vertical) :
    (lampPermMap v).comp (lampPermMap w) = lampPermMap (v * w) := by
  refine PresentedGroup.ext ?_
  intro j
  match j with
  | Sum.inl () =>
      show lampPermMap v (lampPermMap w lampSign) =
        lampPermMap (v * w) lampSign
      rw [lampPermMap_sign, lampPermMap_sign, lampPermMap_sign]
  | Sum.inr ξ =>
      show lampPermMap v (lampPermMap w (lampAt ξ)) =
        lampPermMap (v * w) (lampAt ξ)
      rw [lampPermMap_at, lampPermMap_at, lampPermMap_at, mul_smul]

theorem lampPermMap_one : lampPermMap 1 = MonoidHom.id LampFactor := by
  refine PresentedGroup.ext ?_
  intro j
  match j with
  | Sum.inl () =>
      show lampPermMap 1 lampSign = lampSign
      rw [lampPermMap_sign]
  | Sum.inr ξ =>
      show lampPermMap 1 (lampAt ξ) = lampAt ξ
      rw [lampPermMap_at, one_smul]

/-- The automorphism of `C(𝒢)` induced by a vertical element. -/
def lampPermAut (v : Vertical) : MulAut LampFactor :=
  MonoidHom.toMulEquiv (lampPermMap v) (lampPermMap v⁻¹)
    (by rw [lampPermMap_comp, inv_mul_cancel, lampPermMap_one])
    (by rw [lampPermMap_comp, mul_inv_cancel, lampPermMap_one])

@[simp] theorem lampPermAut_apply (v : Vertical) (n : LampFactor) :
    lampPermAut v n = lampPermMap v n := rfl

/-- **The vertical action on the Clifford graph group.** -/
def lampAutHom : Vertical →* MulAut LampFactor where
  toFun := lampPermAut
  map_one' := by
    refine MulEquiv.ext ?_
    intro n
    rw [lampPermAut_apply]
    change lampPermMap 1 n = n
    rw [lampPermMap_one]
    rfl
  map_mul' v w := by
    refine MulEquiv.ext ?_
    intro n
    rw [lampPermAut_apply]
    show lampPermMap (v * w) n = (lampPermAut v * lampPermAut w) n
    rw [MulAut.mul_apply, lampPermAut_apply, lampPermAut_apply,
      ← lampPermMap_comp]
    rfl

@[simp] theorem lampAutHom_sign (v : Vertical) :
    lampAutHom v lampSign = lampSign := lampPermMap_sign v

@[simp] theorem lampAutHom_at (v : Vertical) (ξ : Site) :
    lampAutHom v (lampAt ξ) = lampAt (v • ξ) := lampPermMap_at v ξ

/-! ## The block model -/

/-- **The block model** `C(𝒢) ⋊ V`. -/
abbrev Model : Type := SemidirectProduct LampFactor Vertical lampAutHom

/-- Conjugation inside the model. -/
theorem inr_conj_inl (v : Vertical) (n : LampFactor) :
    (SemidirectProduct.inr v : Model) * SemidirectProduct.inl n *
        (SemidirectProduct.inr v)⁻¹ =
      SemidirectProduct.inl (lampAutHom v n) := by
  rw [← map_inv]
  exact (SemidirectProduct.inl_aut v n).symm

/-- The image of the sign is central in the model. -/
theorem inl_lampSign_central (m : Model) :
    Commute (SemidirectProduct.inl lampSign : Model) m := by
  have hleft : ∀ n : LampFactor,
      Commute (SemidirectProduct.inl lampSign : Model)
        (SemidirectProduct.inl n) :=
    fun n ↦ (lampSign_central n).map SemidirectProduct.inl
  have hright : ∀ v : Vertical,
      Commute (SemidirectProduct.inl lampSign : Model)
        (SemidirectProduct.inr v) := by
    intro v
    refine commute_of_conj_eq ?_
    rw [inr_conj_inl, lampAutHom_sign]
  rw [← SemidirectProduct.inl_left_mul_inr_right m]
  exact (hleft m.left).mul_right (hright m.right)

/-- The image of `inl` is normal: it is the kernel of the projection. -/
instance inl_range_normal :
    ((SemidirectProduct.inl : LampFactor →* Model).range).Normal := by
  constructor
  rintro _ ⟨n, rfl⟩ m
  rw [← SemidirectProduct.inl_left_mul_inr_right m]
  refine ⟨m.left * lampAutHom m.right n * (m.left)⁻¹, ?_⟩
  rw [map_mul, map_mul, map_inv, ← inr_conj_inl]
  group

/-! ## The presented group maps to the model -/

/-- The base, realized in the model through the vertical factor. -/
def modelBase : Base →* Model :=
  (SemidirectProduct.inr : Vertical →* Model).comp verticalBase

theorem modelBase_of (i : BaseGenerator) :
    modelBase (PresentedGroup.of i) =
      (SemidirectProduct.inr (PresentedGroup.of (Generator.base i)) : Model) := by
  show (SemidirectProduct.inr (verticalBase (PresentedGroup.of i)) : Model) = _
  rw [verticalBase_of]

theorem lift_modelBase (r : FreeGroup BaseGenerator) :
    FreeGroup.lift (fun i ↦ modelBase (PresentedGroup.of i)) r =
      modelBase (LiteralBaseRelations.baseWord r) := by
  change (FreeGroup.lift (fun i ↦ modelBase (PresentedGroup.of i))) r =
    (modelBase.comp LiteralBaseRelations.baseWord) r
  refine freeGroup_hom_eq_on_generators ?_ r
  intro i
  rw [FreeGroup.lift_apply_of, MonoidHom.comp_apply,
    LiteralBaseRelations.baseWord_of]

/-- The marked compression word of the model data is the central sign. -/
theorem model_marked_eq :
    markedCompressionWord (SemidirectProduct.inr vStable : Model)
        (modelBase (PresentedGroup.of v1Index))
        (SemidirectProduct.inl (lampAt origin)) =
      SemidirectProduct.inl lampSign := by
  have hX : modelBase (PresentedGroup.of v1Index) =
      (SemidirectProduct.inr vV1 : Model) := by
    rw [modelBase_of]; rfl
  have h1 : (SemidirectProduct.inr vStable : Model) *
      SemidirectProduct.inl (lampAt origin) *
        (SemidirectProduct.inr vStable)⁻¹ =
      SemidirectProduct.inl (lampAt siteA) := by
    rw [inr_conj_inl, lampAutHom_at, smul_origin]; rfl
  have h2 : (SemidirectProduct.inr vV1 : Model) *
      SemidirectProduct.inl (lampAt siteA) *
        (SemidirectProduct.inr vV1)⁻¹ =
      SemidirectProduct.inl (lampAt siteB) := by
    rw [inr_conj_inl, lampAutHom_at, siteA, smul_mk]; rfl
  rw [markedCompressionWord, hX, h1, h2, ← map_commutatorElement,
    commutator_lampAt adjacent_marked]

/-- The realization of the literal presentation in the block model: the base
letters and the stable letter go to the vertical factor, and the lamp letter to
the lamp at the root site. -/
def modelRealization : Realization Model where
  baseGenerator i := modelBase (PresentedGroup.of i)
  stable := SemidirectProduct.inr vStable
  lamp := SemidirectProduct.inl (lampAt origin)
  base_relations := by
    intro r hr
    rw [lift_modelBase, LiteralBaseRelations.baseRelator_eq_one hr, map_one]
  stable_relations := fun i ↦ by
    rw [lift_modelBase]
    show (SemidirectProduct.inr vStable : Model) *
        SemidirectProduct.inr (verticalBase (PresentedGroup.of i)) *
        (SemidirectProduct.inr vStable)⁻¹ =
      SemidirectProduct.inr
        (verticalBase (LiteralBaseRelations.baseWord (compressedBaseWord i)))
    rw [← map_inv, ← map_mul, ← map_mul, vertical_stable_relation]
  lamp_sq := by rw [← map_pow, lampAt_sq, map_one]
  lamp_centralizes_base := fun i ↦ by
    show Commute (SemidirectProduct.inl (lampAt origin) : Model)
      (modelBase (PresentedGroup.of i))
    rw [modelBase_of]
    refine commute_of_conj_eq ?_
    rw [inr_conj_inl, lampAutHom_at,
      smul_origin_of_mem
        (show (PresentedGroup.of (Generator.base i) : Vertical) ∈ baseSubgroup
          from ⟨PresentedGroup.of i, verticalBase_of i⟩)]
  marked_central := fun m ↦ by
    show Commute (markedCompressionWord (SemidirectProduct.inr vStable : Model)
      (modelBase (PresentedGroup.of v1Index))
      (SemidirectProduct.inl (lampAt origin))) m
    rw [model_marked_eq]
    exact inl_lampSign_central m

/-- **The canonical map from the literal presented group into the block
model.** -/
def toModel : MarkedGroup →* Model := realizationHom modelRealization

theorem toModel_comp_baseMap : toModel.comp baseMap = modelBase := by
  refine PresentedGroup.ext ?_
  intro i
  rw [MonoidHom.comp_apply]
  exact realizationHom_base_generator modelRealization i

@[simp] theorem toModel_baseMap (u : Base) : toModel (baseMap u) = modelBase u :=
  DFunLike.congr_fun toModel_comp_baseMap u

@[simp] theorem toModel_stable :
    toModel stable = SemidirectProduct.inr vStable :=
  realizationHom_stable modelRealization

@[simp] theorem toModel_lamp :
    toModel lamp = SemidirectProduct.inl (lampAt origin) :=
  realizationHom_lamp modelRealization

/-- **The marked word is the central sign of the Clifford factor.** -/
@[simp] theorem toModel_mark :
    toModel mark = SemidirectProduct.inl lampSign := by
  show realizationHom modelRealization mark = SemidirectProduct.inl lampSign
  rw [realizationHom_mark]
  exact model_marked_eq

/-! ## The model maps back to the presented group -/

/-- Letter images of the vertical group inside `E`: the lamp letter dies. -/
def eGen : Generator → MarkedGroup
  | Sum.inl i => wordInMarkedGroup (vertexLetter i)
  | Sum.inr j => if j = 0 then stable else 1

@[simp] theorem eGen_base (i : BaseGenerator) :
    eGen (Generator.base i) = wordInMarkedGroup (vertexLetter i) := rfl

@[simp] theorem eGen_stable : eGen Generator.stable = stable := by
  simp [eGen]

@[simp] theorem eGen_lamp : eGen Generator.lamp = 1 := by
  simp [eGen]

theorem lift_eGen_base (q : FreeGroup BaseGenerator) :
    FreeGroup.lift (fun i ↦ eGen (Generator.base i)) q =
      baseMap (LiteralBaseRelations.baseWord q) := by
  change (FreeGroup.lift (fun i ↦ eGen (Generator.base i))) q =
    (baseMap.comp LiteralBaseRelations.baseWord) q
  refine freeGroup_hom_eq_on_generators ?_ q
  intro i
  rw [FreeGroup.lift_apply_of, MonoidHom.comp_apply,
    LiteralBaseRelations.baseWord_of, baseMap_generator]
  rfl

theorem baseMap_baseWord (w : FreeGroup BaseGenerator) :
    baseMap (LiteralBaseRelations.baseWord w) =
      wordInMarkedGroup (embedBaseWord w) := baseMap_mk w

theorem verticalKill :
    ∀ r ∈ verticalRelators, FreeGroup.lift eGen r = 1 := by
  intro r hr
  rcases hr with (hr | hr) | hr
  · obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hr)
    rw [lift_embedBaseWord, lift_eGen_base,
      LiteralBaseRelations.baseRelator_eq_one hq, map_one]
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hr)
    have hstable : FreeGroup.lift eGen stableWord = stable := by
      rw [FreeGroup.lift_apply_of]; exact eGen_stable
    have hvert : FreeGroup.lift eGen (vertexLetter i) =
        baseMap (PresentedGroup.of i) := by
      rw [FreeGroup.lift_apply_of, eGen_base, baseMap_generator]
    have hcomp : FreeGroup.lift eGen (compressedGeneratorWord i) =
        wordInMarkedGroup (compressedGeneratorWord i) := by
      rw [compressedGeneratorWord, lift_embedBaseWord, lift_eGen_base,
        baseMap_baseWord]
    simp only [stableRelator, map_mul, map_inv, hstable, hvert, hcomp]
    rw [stable_relation i]
    exact mul_inv_cancel _
  · rw [Set.mem_singleton_iff] at hr
    subst hr
    rw [FreeGroup.lift_apply_of]
    exact eGen_lamp

/-- **The splitting `V ↪ E`.** -/
def verticalToE : Vertical →* MarkedGroup := PresentedGroup.toGroup verticalKill

@[simp] theorem verticalToE_of (j : Generator) :
    verticalToE (PresentedGroup.of j) = eGen j :=
  PresentedGroup.toGroup.of _

@[simp] theorem verticalToE_vStable : verticalToE vStable = stable := by
  rw [vStable, verticalToE_of, eGen_stable]

@[simp] theorem verticalToE_vV1 :
    verticalToE vV1 = baseMap (PresentedGroup.of v1Index) := by
  rw [vV1, verticalToE_of, eGen_base, baseMap_generator]

theorem verticalToE_comp_verticalBase :
    verticalToE.comp verticalBase = baseMap := by
  refine PresentedGroup.ext ?_
  intro i
  rw [MonoidHom.comp_apply, verticalBase_of, verticalToE_of, eGen_base,
    baseMap_generator]

@[simp] theorem verticalToE_verticalBase (u : Base) :
    verticalToE (verticalBase u) = baseMap u :=
  DFunLike.congr_fun verticalToE_comp_verticalBase u

/-- The lamp attached to a site: the conjugate `g c g⁻¹`, well defined because
the base centralizes the lamp letter. -/
def siteLamp (ξ : Site) : MarkedGroup :=
  Quotient.liftOn' ξ (fun g ↦ verticalToE g * lamp * (verticalToE g)⁻¹)
    (by
      intro a b hab
      rw [QuotientGroup.leftRel_apply] at hab
      obtain ⟨u, hu⟩ := hab
      have hb : b = a * verticalBase u := by rw [hu]; group
      have hkey : baseMap u * lamp * (baseMap u)⁻¹ = lamp := by
        rw [← (lamp_commutes_base u).eq]; group
      rw [hb, map_mul, verticalToE_verticalBase]
      calc verticalToE a * lamp * (verticalToE a)⁻¹
          = verticalToE a * (baseMap u * lamp * (baseMap u)⁻¹) *
              (verticalToE a)⁻¹ := by rw [hkey]
        _ = verticalToE a * baseMap u * lamp *
              (verticalToE a * baseMap u)⁻¹ := by group)

@[simp] theorem siteLamp_mk (g : Vertical) :
    siteLamp (QuotientGroup.mk g : Site) =
      verticalToE g * lamp * (verticalToE g)⁻¹ := rfl

@[simp] theorem siteLamp_origin : siteLamp origin = lamp := by
  rw [origin, siteLamp_mk, map_one, one_mul, inv_one, mul_one]

theorem siteLamp_sq (ξ : Site) : siteLamp ξ ^ 2 = 1 := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective ξ
  rw [siteLamp_mk, pow_two]
  have hl : lamp * lamp = 1 := by
    have h := lamp_sq; rwa [pow_two] at h
  calc verticalToE g * lamp * (verticalToE g)⁻¹ *
        (verticalToE g * lamp * (verticalToE g)⁻¹)
      = verticalToE g * (lamp * lamp) * (verticalToE g)⁻¹ := by group
    _ = 1 := by rw [hl]; group

theorem siteLamp_smul_siteA (g : Vertical) :
    siteLamp (g • siteA) =
      verticalToE g * (stable * lamp * stable⁻¹) * (verticalToE g)⁻¹ := by
  rw [siteA, smul_mk, siteLamp_mk, map_mul, verticalToE_vStable]
  group

theorem siteLamp_smul_siteB (g : Vertical) :
    siteLamp (g • siteB) =
      verticalToE g *
        (baseMap (PresentedGroup.of v1Index) * (stable * lamp * stable⁻¹) *
          (baseMap (PresentedGroup.of v1Index))⁻¹) * (verticalToE g)⁻¹ := by
  rw [siteB, smul_mk, siteLamp_mk, map_mul, map_mul, verticalToE_vStable,
    verticalToE_vV1]
  group

theorem mark_inv : mark⁻¹ = mark := by
  refine inv_eq_of_mul_eq_one_left ?_
  have h := mark_sq
  rwa [pow_two] at h

/-- Lamps at adjacent sites braid through the marked word. -/
theorem siteLamp_braiding {ξ η : Site} (h : Adjacent ξ η) :
    ⁅siteLamp ξ, siteLamp η⁆ = mark := by
  have key : ∀ g : Vertical,
      ⁅siteLamp (g • siteA), siteLamp (g • siteB)⁆ = mark := by
    intro g
    rw [siteLamp_smul_siteA, siteLamp_smul_siteB, commutator_conj]
    have hmc : ⁅stable * lamp * stable⁻¹,
        baseMap (PresentedGroup.of v1Index) * (stable * lamp * stable⁻¹) *
          (baseMap (PresentedGroup.of v1Index))⁻¹⁆ = mark := by
      rw [mark_eq_markedCompressionWord]; rfl
    rw [hmc, ← (mark_central (verticalToE g)).eq]
    group
  rcases h with ⟨g, hga, hgb⟩ | ⟨g, hga, hgb⟩
  · rw [← hga, ← hgb]; exact key g
  · rw [← hga, ← hgb, ← commutatorElement_inv, key g, mark_inv]

/-- **The Clifford factor maps back into `E`.** -/
def lampToE : LampFactor →* MarkedGroup :=
  lampLift mark siteLamp mark_sq siteLamp_sq (fun ξ ↦ mark_central (siteLamp ξ))
    (fun _ _ h ↦ siteLamp_braiding h)

@[simp] theorem lampToE_sign : lampToE lampSign = mark :=
  lampLift_sign _ _ _ _ _ _

@[simp] theorem lampToE_at (ξ : Site) : lampToE (lampAt ξ) = siteLamp ξ :=
  lampLift_at _ _ _ _ _ _ ξ

theorem lampToE_compat (v : Vertical) :
    lampToE.comp (lampAutHom v).toMonoidHom =
      (MulAut.conj (verticalToE v)).toMonoidHom.comp lampToE := by
  refine PresentedGroup.ext ?_
  intro j
  match j with
  | Sum.inl () =>
      show lampToE (lampAutHom v lampSign) =
        MulAut.conj (verticalToE v) (lampToE lampSign)
      rw [lampAutHom_sign, lampToE_sign, MulAut.conj_apply,
        ← (mark_central (verticalToE v)).eq]
      group
  | Sum.inr ξ =>
      show lampToE (lampAutHom v (lampAt ξ)) =
        MulAut.conj (verticalToE v) (lampToE (lampAt ξ))
      rw [lampAutHom_at, lampToE_at, lampToE_at, MulAut.conj_apply]
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective ξ
      rw [smul_mk, siteLamp_mk, siteLamp_mk, map_mul]
      group

/-- **The inverse homomorphism** `C(𝒢) ⋊ V → E`. -/
def fromModel : Model →* MarkedGroup :=
  SemidirectProduct.lift lampToE verticalToE lampToE_compat

@[simp] theorem fromModel_inl (n : LampFactor) :
    fromModel (SemidirectProduct.inl n) = lampToE n := by
  simp only [fromModel, SemidirectProduct.lift_inl]

@[simp] theorem fromModel_inr (v : Vertical) :
    fromModel (SemidirectProduct.inr v) = verticalToE v := by
  simp only [fromModel, SemidirectProduct.lift_inr]

/-! ## The two composites -/

theorem of_base_eq (i : BaseGenerator) :
    (PresentedGroup.of (Generator.base i) : MarkedGroup) =
      baseMap (PresentedGroup.of i) :=
  (baseMap_generator i).symm

@[simp] theorem of_stable_eq :
    (PresentedGroup.of Generator.stable : MarkedGroup) = stable := rfl

@[simp] theorem of_lamp_eq :
    (PresentedGroup.of Generator.lamp : MarkedGroup) = lamp := rfl

theorem fromModel_comp_toModel :
    fromModel.comp toModel = MonoidHom.id MarkedGroup := by
  refine PresentedGroup.ext ?_
  intro j
  rcases generator_cases j with ⟨i, rfl⟩ | rfl | rfl
  · show fromModel (toModel (PresentedGroup.of (Generator.base i))) =
      PresentedGroup.of (Generator.base i)
    rw [of_base_eq, toModel_baseMap, modelBase, MonoidHom.comp_apply,
      fromModel_inr, verticalToE_verticalBase]
  · show fromModel (toModel (PresentedGroup.of Generator.stable)) =
      PresentedGroup.of Generator.stable
    rw [of_stable_eq, toModel_stable, fromModel_inr, verticalToE_vStable]
  · show fromModel (toModel (PresentedGroup.of Generator.lamp)) =
      PresentedGroup.of Generator.lamp
    rw [of_lamp_eq, toModel_lamp, fromModel_inl, lampToE_at, siteLamp_origin]

theorem toModel_comp_verticalToE :
    toModel.comp verticalToE = (SemidirectProduct.inr : Vertical →* Model) := by
  refine PresentedGroup.ext ?_
  intro j
  rcases generator_cases j with ⟨i, rfl⟩ | rfl | rfl
  · show toModel (verticalToE (PresentedGroup.of (Generator.base i))) =
      SemidirectProduct.inr (PresentedGroup.of (Generator.base i))
    rw [verticalToE_of, eGen_base, ← baseMap_generator, toModel_baseMap,
      modelBase_of]
  · show toModel (verticalToE (PresentedGroup.of Generator.stable)) =
      SemidirectProduct.inr (PresentedGroup.of Generator.stable)
    rw [verticalToE_of, eGen_stable, toModel_stable]
    rfl
  · show toModel (verticalToE (PresentedGroup.of Generator.lamp)) =
      SemidirectProduct.inr (PresentedGroup.of Generator.lamp)
    rw [verticalToE_of, eGen_lamp, map_one, verticalOf_lamp_eq_one, map_one]

@[simp] theorem toModel_verticalToE (v : Vertical) :
    toModel (verticalToE v) = SemidirectProduct.inr v :=
  DFunLike.congr_fun toModel_comp_verticalToE v

/-- **Manuscript `prop:blocknormalform`.**  The site lamps of `E` are exactly
the lamps of the Clifford factor.

Stated with the site after the colon, which is what the manuscript badges.
There is deliberately no second, wrapped copy: `Site` here is a concrete type
rather than a section variable, so a restatement would be the *same*
proposition under a second name and the kernel audit would report it as a
duplicate. -/
@[simp] theorem manuscriptSiteLampImage :
    ∀ ξ : Site, toModel (siteLamp ξ) = SemidirectProduct.inl (lampAt ξ) := by
  intro ξ
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective ξ
  rw [siteLamp_mk, map_mul, map_mul, map_inv, toModel_lamp,
    toModel_verticalToE, inr_conj_inl, lampAutHom_at, smul_origin]

theorem toModel_comp_lampToE :
    toModel.comp lampToE = (SemidirectProduct.inl : LampFactor →* Model) := by
  refine PresentedGroup.ext ?_
  intro j
  match j with
  | Sum.inl () =>
      show toModel (lampToE lampSign) = SemidirectProduct.inl lampSign
      rw [lampToE_sign, toModel_mark]
  | Sum.inr ξ =>
      show toModel (lampToE (lampAt ξ)) = SemidirectProduct.inl (lampAt ξ)
      rw [lampToE_at, manuscriptSiteLampImage]

theorem toModel_comp_fromModel :
    toModel.comp fromModel = MonoidHom.id Model := by
  refine SemidirectProduct.hom_ext ?_ ?_
  · refine MonoidHom.ext ?_
    intro n
    show toModel (fromModel (SemidirectProduct.inl n)) =
      SemidirectProduct.inl n
    rw [fromModel_inl]
    exact DFunLike.congr_fun toModel_comp_lampToE n
  · refine MonoidHom.ext ?_
    intro v
    show toModel (fromModel (SemidirectProduct.inr v)) =
      SemidirectProduct.inr v
    rw [fromModel_inr, toModel_verticalToE]

/-- **The normal-form theorem.**  The canonical map from the literal
forty-one-relator group into the block model is injective.  Injectivity is
exactly the statement that the presented group has no relations beyond those
visible in the model: a word in the eight letters is trivial in `E` precisely
when its vertical part is trivial in `V` and its Clifford part reduces to `1`
in the Clifford group of the orbital graph. -/
theorem toModel_injective : Function.Injective toModel := by
  intro a b hab
  have ha := DFunLike.congr_fun fromModel_comp_toModel a
  have hb := DFunLike.congr_fun fromModel_comp_toModel b
  simp only [MonoidHom.coe_comp, Function.comp_apply, MonoidHom.id_apply]
    at ha hb
  rw [← ha, ← hb, hab]

theorem toModel_surjective : Function.Surjective toModel := by
  intro m
  refine ⟨fromModel m, ?_⟩
  have h := DFunLike.congr_fun toModel_comp_fromModel m
  simpa using h

/-- **The literal group is the block model.**  `E ≅ C(𝒢) ⋊ V`: the lamp kernel
is the Clifford group of the orbital graph on `X = V/B`, the vertical
complement is the seven-letter ascending HNN quotient, and the marked word is
the central sign. -/
def markedGroupEquivModel : MarkedGroup ≃* Model :=
  MonoidHom.toMulEquiv toModel fromModel fromModel_comp_toModel
    toModel_comp_fromModel

@[simp] theorem markedGroupEquivModel_apply (g : MarkedGroup) :
    markedGroupEquivModel g = toModel g := rfl

/-! ## The lamp kernel -/

/-- The lamp kernel of the literal group: the normal closure of the lamp
letter. -/
def lampKernel : Subgroup MarkedGroup :=
  Subgroup.normalClosure ({lamp} : Set MarkedGroup)

instance : lampKernel.Normal := Subgroup.normalClosure_normal

theorem lamp_mem_lampKernel : lamp ∈ lampKernel :=
  Subgroup.subset_normalClosure rfl

theorem siteLamp_mem_lampKernel (ξ : Site) : siteLamp ξ ∈ lampKernel := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective ξ
  rw [siteLamp_mk]
  exact (inferInstance : lampKernel.Normal).conj_mem lamp lamp_mem_lampKernel _

theorem mark_mem_lampKernel : mark ∈ lampKernel := by
  have hd : stable * lamp * stable⁻¹ ∈ lampKernel :=
    (inferInstance : lampKernel.Normal).conj_mem lamp lamp_mem_lampKernel stable
  have he : baseMap (PresentedGroup.of v1Index) * (stable * lamp * stable⁻¹) *
      (baseMap (PresentedGroup.of v1Index))⁻¹ ∈ lampKernel :=
    (inferInstance : lampKernel.Normal).conj_mem _ hd _
  rw [mark_eq_markedCompressionWord, markedCompressionWord,
    commutatorElement_def]
  exact lampKernel.mul_mem
    (lampKernel.mul_mem (lampKernel.mul_mem hd he) (lampKernel.inv_mem hd))
    (lampKernel.inv_mem he)

/-- **The lamp kernel is the Clifford factor.**  Under the isomorphism
`E ≅ C(𝒢) ⋊ V` the normal closure of the lamp letter is carried exactly onto
the Clifford group of the orbital graph. -/
theorem lampKernel_map_toModel :
    lampKernel.map toModel =
      (SemidirectProduct.inl : LampFactor →* Model).range := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.map_le_iff_le_comap]
    refine Subgroup.normalClosure_le_normal ?_
    rintro g rfl
    show toModel lamp ∈ (SemidirectProduct.inl : LampFactor →* Model).range
    rw [toModel_lamp]
    exact ⟨lampAt origin, rfl⟩
  · rintro _ ⟨n, rfl⟩
    have hmem : n ∈ (lampKernel.map toModel).comap
        (SemidirectProduct.inl : LampFactor →* Model) := by
      refine mem_of_generators _ (fun j ↦ ?_) n
      match j with
      | Sum.inl () =>
          show (SemidirectProduct.inl lampSign : Model) ∈ lampKernel.map toModel
          exact ⟨mark, mark_mem_lampKernel, toModel_mark⟩
      | Sum.inr ξ =>
          show (SemidirectProduct.inl (lampAt ξ) : Model) ∈
            lampKernel.map toModel
          exact ⟨siteLamp ξ, siteLamp_mem_lampKernel ξ, manuscriptSiteLampImage ξ⟩
    exact hmem

/-- The vertical group receives the lamp-killed quotient of `E`. -/
def verticalToQuot : Vertical →* MarkedGroup ⧸ lampKernel := by
  refine PresentedGroup.toGroup
    (f := fun j : Generator ↦
      QuotientGroup.mk' lampKernel (wordInMarkedGroup (FreeGroup.of j))) ?_
  intro r hr
  have heval : FreeGroup.lift
      (fun j : Generator ↦
        QuotientGroup.mk' lampKernel (wordInMarkedGroup (FreeGroup.of j))) r =
      QuotientGroup.mk' lampKernel (wordInMarkedGroup r) := by
    change (FreeGroup.lift _) r =
      ((QuotientGroup.mk' lampKernel).comp wordInMarkedGroup) r
    refine freeGroup_hom_eq_on_generators ?_ r
    intro j
    rw [FreeGroup.lift_apply_of, MonoidHom.comp_apply]
  rw [heval]
  rcases hr with (hr | hr) | hr
  · rw [transported_relator_eq_one (Finset.mem_coe.mp hr), map_one]
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hr)
    rw [stable_relator_eq_one i, map_one]
  · rw [Set.mem_singleton_iff] at hr
    subst hr
    exact (QuotientGroup.eq_one_iff _).mpr lamp_mem_lampKernel

theorem verticalToQuot_comp_retract :
    verticalToQuot.comp retract = QuotientGroup.mk' lampKernel := by
  refine PresentedGroup.ext ?_
  intro j
  rw [MonoidHom.comp_apply, retract_of]
  exact PresentedGroup.toGroup.of _

/-- **The lamp kernel is the kernel of the vertical retraction.**  This is the
form the soficity tower quotes: `1 → C(𝒢) → E → V → 1` is exact and split. -/
theorem lampKernel_eq : lampKernel = MonoidHom.ker retract := by
  refine le_antisymm ?_ ?_
  · refine Subgroup.normalClosure_le_normal ?_
    rintro g rfl
    show lamp ∈ MonoidHom.ker retract
    rw [MonoidHom.mem_ker]
    show retract (wordInMarkedGroup lampWord) = 1
    rw [retract_word, verticalWord_lampWord]
  · intro g hg
    have h := DFunLike.congr_fun verticalToQuot_comp_retract g
    simp only [MonoidHom.coe_comp, Function.comp_apply] at h
    rw [MonoidHom.mem_ker] at hg
    rw [hg, map_one] at h
    exact (QuotientGroup.eq_one_iff g).mp h.symm

/-- The lamp kernel, as a group, is the Clifford group of the orbital
graph. -/
def lampKernelEquiv : lampKernel ≃* LampFactor :=
  ((lampKernel.equivMapOfInjective toModel toModel_injective).trans
      (MulEquiv.subgroupCongr lampKernel_map_toModel)).trans
    (MonoidHom.ofInjective
      (SemidirectProduct.inl_injective (N := LampFactor) (G := Vertical)
        (φ := lampAutHom))).symm

/-! ## Finite block support

The first fact the soficity tower consumes: a finite subset of the lamp kernel
involves only finitely many blocks. -/

local instance blockDecEq : DecidableEq Block := Classical.decEq _

local instance markedGroupDecEq : DecidableEq MarkedGroup := Classical.decEq _

/-- The subgroup of `E` spanned by the marked word and the site lamps of a
finite set of blocks. -/
def blockSpan (J : Finset Block) : Subgroup MarkedGroup :=
  Subgroup.closure
    ({mark} ∪ {g | ∃ ξ : Site, blockOf ξ ∈ J ∧ g = siteLamp ξ})

/-- The corresponding subgroup of the Clifford factor. -/
def lampSpan (J : Finset Block) : Subgroup LampFactor :=
  Subgroup.closure
    ({lampSign} ∪ {n | ∃ ξ : Site, blockOf ξ ∈ J ∧ n = lampAt ξ})

theorem blockSpan_mono {J J' : Finset Block} (h : J ⊆ J') :
    blockSpan J ≤ blockSpan J' := by
  refine Subgroup.closure_mono ?_
  rintro g (hg | ⟨ξ, hξ, rfl⟩)
  · exact Or.inl hg
  · exact Or.inr ⟨ξ, h hξ, rfl⟩

theorem lampSpan_mono {J J' : Finset Block} (h : J ⊆ J') :
    lampSpan J ≤ lampSpan J' := by
  refine Subgroup.closure_mono ?_
  rintro n (hn | ⟨ξ, hξ, rfl⟩)
  · exact Or.inl hn
  · exact Or.inr ⟨ξ, h hξ, rfl⟩

/-- The elements of the Clifford factor with finite block support. -/
def lampSupported : Subgroup LampFactor where
  carrier := {n | ∃ J : Finset Block, n ∈ lampSpan J}
  one_mem' := ⟨∅, one_mem _⟩
  mul_mem' := by
    rintro a b ⟨J, hJ⟩ ⟨J', hJ'⟩
    exact ⟨J ∪ J', mul_mem (lampSpan_mono Finset.subset_union_left hJ)
      (lampSpan_mono Finset.subset_union_right hJ')⟩
  inv_mem' := by
    rintro a ⟨J, hJ⟩
    exact ⟨J, inv_mem hJ⟩

theorem exists_lampSpan (n : LampFactor) : ∃ J : Finset Block, n ∈ lampSpan J := by
  refine mem_of_generators lampSupported (fun j ↦ ?_) n
  match j with
  | Sum.inl () =>
      exact ⟨∅, Subgroup.subset_closure (Or.inl rfl)⟩
  | Sum.inr ξ =>
      exact ⟨{blockOf ξ}, Subgroup.subset_closure
        (Or.inr ⟨ξ, Finset.mem_singleton_self _, rfl⟩)⟩

theorem blockSpan_map (J : Finset Block) :
    (blockSpan J).map toModel =
      (lampSpan J).map (SemidirectProduct.inl : LampFactor →* Model) := by
  rw [blockSpan, lampSpan, MonoidHom.map_closure, MonoidHom.map_closure]
  congr 1
  ext m
  constructor
  · rintro ⟨g, hg, rfl⟩
    rcases hg with hg | ⟨ξ, hξ, rfl⟩
    · rw [Set.mem_singleton_iff] at hg
      subst hg
      exact ⟨lampSign, Or.inl rfl, toModel_mark.symm⟩
    · exact ⟨lampAt ξ, Or.inr ⟨ξ, hξ, rfl⟩, (manuscriptSiteLampImage ξ).symm⟩
  · rintro ⟨x, hx, rfl⟩
    rcases hx with hx | ⟨ξ, hξ, rfl⟩
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨mark, Or.inl rfl, toModel_mark⟩
    · exact ⟨siteLamp ξ, Or.inr ⟨ξ, hξ, rfl⟩, manuscriptSiteLampImage ξ⟩

/-- Every element of the lamp kernel is supported on finitely many blocks. -/
theorem exists_blockSpan {g : MarkedGroup} (hg : g ∈ lampKernel) :
    ∃ J : Finset Block, g ∈ blockSpan J := by
  have hmem : toModel g ∈ (SemidirectProduct.inl : LampFactor →* Model).range := by
    rw [← lampKernel_map_toModel]
    exact ⟨g, hg, rfl⟩
  obtain ⟨n, hn⟩ := hmem
  obtain ⟨J, hJ⟩ := exists_lampSpan n
  refine ⟨J, ?_⟩
  have hin : toModel g ∈ (blockSpan J).map toModel := by
    rw [blockSpan_map, ← hn]
    exact ⟨n, hJ, rfl⟩
  obtain ⟨k, hk, hkg⟩ := hin
  rwa [toModel_injective hkg] at hk

/-- **Finite block support.**  Every finite subset of the lamp kernel lies in
the subgroup generated by the marked word together with the site lamps of
finitely many blocks.  This is the input the soficity tower needs in order to
approximate the lamp kernel by its finite block sub-amalgams. -/
theorem exists_blockSpan_finset (S : Finset MarkedGroup)
    (hS : ∀ g ∈ S, g ∈ lampKernel) :
    ∃ J : Finset Block, ∀ g ∈ S, g ∈ blockSpan J := by
  induction S using Finset.induction_on with
  | empty => exact ⟨∅, by simp⟩
  | insert a s ha ih =>
      obtain ⟨J, hJ⟩ := ih (fun g hg ↦ hS g (Finset.mem_insert_of_mem hg))
      obtain ⟨J', hJ'⟩ := exists_blockSpan (hS a (Finset.mem_insert_self a s))
      refine ⟨J ∪ J', ?_⟩
      intro g hg
      rcases Finset.mem_insert.mp hg with rfl | hg
      · exact blockSpan_mono Finset.subset_union_right hJ'
      · exact blockSpan_mono Finset.subset_union_left (hJ g hg)

/-! ## Finite telescope-level orbits on blocks

The second fact the soficity tower consumes.  Conjugation by the stable letter
carries the vertical base onto the image of the doubled subgroup, which has
finite index there because the doubled subgroup has finite index in the literal
base — the eight parity cosets of `LiteralBaseDoublingIndex`, an unconditional
count.  Hence the whole vertical group commensurates the base, and the
commensurated-subgroup criterion gives finite orbits. -/

@[simp] theorem compressedBaseWord_v1 : compressedBaseWord v1Index = bv1 ^ 2 := rfl
@[simp] theorem compressedBaseWord_v2 : compressedBaseWord v2Index = bv2 ^ 2 := rfl
@[simp] theorem compressedBaseWord_v3 : compressedBaseWord v3Index = bv3 ^ 2 := rfl
@[simp] theorem compressedBaseWord_x : compressedBaseWord xIndex = bx := rfl
@[simp] theorem compressedBaseWord_y : compressedBaseWord yIndex = bY := rfl
@[simp] theorem compressedBaseWord_z : compressedBaseWord zIndex = bz := rfl

theorem baseWord_compressed_mem (i : BaseGenerator) :
    LiteralBaseRelations.baseWord (compressedBaseWord i) ∈
      LiteralBaseDoublingIndex.doubledBase := by
  have hv1 : LiteralBaseRelations.baseWord (compressedBaseWord v1Index) ∈
      LiteralBaseDoublingIndex.doubledBase := by
    rw [compressedBaseWord_v1, map_pow, LiteralBaseRelations.baseWord_of]
    exact LiteralBaseDoublingIndex.v1sq_mem_doubledBase
  have hv2 : LiteralBaseRelations.baseWord (compressedBaseWord v2Index) ∈
      LiteralBaseDoublingIndex.doubledBase := by
    rw [compressedBaseWord_v2, map_pow, LiteralBaseRelations.baseWord_of]
    exact LiteralBaseDoublingIndex.v2sq_mem_doubledBase
  have hv3 : LiteralBaseRelations.baseWord (compressedBaseWord v3Index) ∈
      LiteralBaseDoublingIndex.doubledBase := by
    rw [compressedBaseWord_v3, map_pow, LiteralBaseRelations.baseWord_of]
    exact LiteralBaseDoublingIndex.v3sq_mem_doubledBase
  have hx : LiteralBaseRelations.baseWord (compressedBaseWord xIndex) ∈
      LiteralBaseDoublingIndex.doubledBase := by
    rw [compressedBaseWord_x, LiteralBaseRelations.baseWord_of]
    exact LiteralBaseDoublingIndex.x_mem_doubledBase
  have hy : LiteralBaseRelations.baseWord (compressedBaseWord yIndex) ∈
      LiteralBaseDoublingIndex.doubledBase := by
    rw [compressedBaseWord_y, LiteralBaseRelations.baseWord_of]
    exact LiteralBaseDoublingIndex.y_mem_doubledBase
  have hz : LiteralBaseRelations.baseWord (compressedBaseWord zIndex) ∈
      LiteralBaseDoublingIndex.doubledBase := by
    rw [compressedBaseWord_z, LiteralBaseRelations.baseWord_of]
    exact LiteralBaseDoublingIndex.z_mem_doubledBase
  fin_cases i
  · exact hv1
  · exact hv2
  · exact hv3
  · exact hx
  · exact hy
  · exact hz

/-- The base, conjugated by the stable letter. -/
def conjStable : Base →* Vertical :=
  (MulAut.conj vStable).toMonoidHom.comp verticalBase

@[simp] theorem conjStable_apply (u : Base) :
    conjStable u = vStable * verticalBase u * vStable⁻¹ := rfl

theorem conjStable_of (i : BaseGenerator) :
    conjStable (PresentedGroup.of i) =
      verticalBase (LiteralBaseRelations.baseWord (compressedBaseWord i)) := by
  rw [conjStable_apply]
  exact vertical_stable_relation i

theorem conjStable_range_le :
    conjStable.range ≤
      LiteralBaseDoublingIndex.doubledBase.map verticalBase := by
  rintro _ ⟨u, rfl⟩
  have hmem : u ∈ (LiteralBaseDoublingIndex.doubledBase.map
      verticalBase).comap conjStable := by
    refine mem_of_generators _ (fun i ↦ ?_) u
    show conjStable (PresentedGroup.of i) ∈
      LiteralBaseDoublingIndex.doubledBase.map verticalBase
    rw [conjStable_of]
    exact ⟨_, baseWord_compressed_mem i, rfl⟩
  exact hmem

theorem doubledBase_map_le_conjStable_range :
    LiteralBaseDoublingIndex.doubledBase.map verticalBase ≤
      conjStable.range := by
  have hcl : LiteralBaseDoublingIndex.doubledBase =
      Subgroup.closure ({LiteralBaseRelations.x, LiteralBaseRelations.y,
        LiteralBaseRelations.z, LiteralBaseRelations.v1 ^ 2,
        LiteralBaseRelations.v2 ^ 2, LiteralBaseRelations.v3 ^ 2} :
          Set Base) := rfl
  rw [hcl, MonoidHom.map_closure, Subgroup.closure_le]
  rintro _ ⟨g, hg, rfl⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl
  · exact ⟨PresentedGroup.of xIndex, by
      rw [conjStable_of, compressedBaseWord_x,
        LiteralBaseRelations.baseWord_of]⟩
  · exact ⟨PresentedGroup.of yIndex, by
      rw [conjStable_of, compressedBaseWord_y,
        LiteralBaseRelations.baseWord_of]⟩
  · exact ⟨PresentedGroup.of zIndex, by
      rw [conjStable_of, compressedBaseWord_z,
        LiteralBaseRelations.baseWord_of]⟩
  · exact ⟨PresentedGroup.of v1Index, by
      rw [conjStable_of, compressedBaseWord_v1, map_pow,
        LiteralBaseRelations.baseWord_of, map_pow]⟩
  · exact ⟨PresentedGroup.of v2Index, by
      rw [conjStable_of, compressedBaseWord_v2, map_pow,
        LiteralBaseRelations.baseWord_of, map_pow]⟩
  · exact ⟨PresentedGroup.of v3Index, by
      rw [conjStable_of, compressedBaseWord_v3, map_pow,
        LiteralBaseRelations.baseWord_of, map_pow]⟩

theorem conjStable_range_eq :
    conjStable.range = LiteralBaseDoublingIndex.doubledBase.map verticalBase :=
  le_antisymm conjStable_range_le doubledBase_map_le_conjStable_range

theorem map_doubledBase_le_baseSubgroup :
    LiteralBaseDoublingIndex.doubledBase.map verticalBase ≤ baseSubgroup := by
  rintro _ ⟨u, -, rfl⟩
  exact ⟨u, rfl⟩

/-- Conjugating the vertical base by the stable letter gives the image of the
doubled subgroup. -/
theorem stable_smul_baseSubgroup :
    ConjAct.toConjAct vStable • baseSubgroup =
      LiteralBaseDoublingIndex.doubledBase.map verticalBase := by
  rw [← conjStable_range_eq]
  ext v
  constructor
  · intro hv
    obtain ⟨b, hb, hbv⟩ :=
      (Subgroup.mem_smul_pointwise_iff_exists v
        (ConjAct.toConjAct vStable) baseSubgroup).mp hv
    obtain ⟨u, rfl⟩ := hb
    refine ⟨u, ?_⟩
    rw [conjStable_apply]
    simpa [ConjAct.toConjAct_smul] using hbv
  · rintro ⟨u, rfl⟩
    rw [conjStable_apply]
    have hsm : vStable * verticalBase u * vStable⁻¹ =
        ConjAct.toConjAct vStable • verticalBase u := by
      simp [ConjAct.toConjAct_smul]
    rw [hsm]
    exact Subgroup.smul_mem_pointwise_smul _ _ _ ⟨u, rfl⟩

theorem finite_quotient_stable_conj :
    Finite (↥baseSubgroup ⧸
      (LiteralBaseDoublingIndex.doubledBase.map verticalBase).subgroupOf
        baseSubgroup) := by
  apply Finite.of_surjective
    (fun e : Fin 3 → Fin 2 ↦
      (QuotientGroup.mk
        (⟨verticalBase
            (LiteralBaseDoublingIndex.parityRep (fun i ↦ ((e i : ℕ) : ℤ))),
          ⟨LiteralBaseDoublingIndex.parityRep (fun i ↦ ((e i : ℕ) : ℤ)),
            rfl⟩⟩ : ↥baseSubgroup) :
        ↥baseSubgroup ⧸
          (LiteralBaseDoublingIndex.doubledBase.map verticalBase).subgroupOf
            baseSubgroup))
  intro q
  obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective q
  obtain ⟨g, hg⟩ := u.2
  obtain ⟨e, h, hh, hgeq⟩ := LiteralBaseDoublingIndex.exists_parity_coset g
  refine ⟨e, ?_⟩
  refine QuotientGroup.eq.mpr ?_
  rw [Subgroup.mem_subgroupOf]
  show (verticalBase
      (LiteralBaseDoublingIndex.parityRep (fun i ↦ ((e i : ℕ) : ℤ))))⁻¹ *
    (u : Vertical) ∈ LiteralBaseDoublingIndex.doubledBase.map verticalBase
  rw [← hg, hgeq, map_mul]
  exact ⟨h, hh, by group⟩

theorem relIndex_ne_zero_stable :
    (LiteralBaseDoublingIndex.doubledBase.map verticalBase).relIndex
      baseSubgroup ≠ 0 := by
  haveI := finite_quotient_stable_conj
  exact Subgroup.index_ne_zero_of_finite

theorem commensurable_stable :
    Subgroup.Commensurable (ConjAct.toConjAct vStable • baseSubgroup)
      baseSubgroup := by
  rw [stable_smul_baseSubgroup]
  refine ⟨relIndex_ne_zero_stable, ?_⟩
  rw [Subgroup.relIndex_eq_one.mpr map_doubledBase_le_baseSubgroup]
  exact one_ne_zero

/-- **The vertical group commensurates the base.** -/
theorem top_le_commensurator :
    (⊤ : Subgroup Vertical) ≤
      Subgroup.Commensurable.commensurator baseSubgroup := by
  intro v _
  refine mem_of_generators _ (fun j ↦ ?_) v
  rcases generator_cases j with ⟨i, rfl⟩ | rfl | rfl
  · rw [Subgroup.Commensurable.commensurator_mem_iff]
    have hmem : (PresentedGroup.of (Generator.base i) : Vertical) ∈
        baseSubgroup := ⟨PresentedGroup.of i, verticalBase_of i⟩
    rw [Subgroup.conjAct_pointwise_smul_eq_self
      (baseSubgroup.le_normalizer hmem)]
  · rw [Subgroup.Commensurable.commensurator_mem_iff]
    exact commensurable_stable
  · rw [verticalOf_lamp_eq_one]
    exact Subgroup.one_mem _

/-- Every conjugate of the vertical base has finite orbits on sites. -/
theorem finite_conj_site_orbit (g : Vertical) (ξ : Site) :
    (MulAction.orbit ↥(ConjAct.toConjAct g • baseSubgroup) ξ).Finite :=
  MappingTelescopeFiniteOrbits.finite_orbit_on_quotient_of_commensurated
    (ConjAct.toConjAct g • baseSubgroup) baseSubgroup
    ((Subgroup.Commensurable.commensurator_mem_iff baseSubgroup g).mp
      (top_le_commensurator (Subgroup.mem_top g)))
    top_le_commensurator ξ

/-- Telescope level `n`: the conjugate `t⁻ⁿ B tⁿ` of the vertical base. -/
def telescopeLevel (n : ℕ) : Subgroup Vertical :=
  ConjAct.toConjAct ((vStable ^ n)⁻¹) • baseSubgroup

/-- **Manuscript `prop:blocknormalform`.**  Every telescope level has finite
orbits on sites.  Binders after the colon, and a single name, for the reason
given at `manuscriptSiteLampImage`. -/
theorem manuscriptFiniteLevelSiteOrbit :
    ∀ (n : ℕ) (ξ : Site), (MulAction.orbit ↥(telescopeLevel n) ξ).Finite :=
  fun _ ξ ↦ finite_conj_site_orbit _ ξ

/-- **Finite telescope-level orbits on blocks.**  Each level of the mapping
telescope moves any block into only finitely many blocks.  This is the second
input the soficity tower needs: it is what makes the level-invariant lamp
sub-amalgams finite. -/
theorem finite_telescopeLevel_block_orbit (n : ℕ) (b : Block) :
    (MulAction.orbit ↥(telescopeLevel n) b).Finite := by
  obtain ⟨ξ, rfl⟩ := blockOf_surjective b
  have himg : MulAction.orbit (telescopeLevel n) (blockOf ξ) =
      blockOf '' MulAction.orbit (telescopeLevel n) ξ := by
    ext c
    simp only [MulAction.mem_orbit_iff, Set.mem_image]
    constructor
    · rintro ⟨h, rfl⟩
      exact ⟨(h : Vertical) • ξ, ⟨h, rfl⟩, blockOf_smul _ _⟩
    · rintro ⟨y, ⟨h, rfl⟩, rfl⟩
      exact ⟨h, (blockOf_smul _ _).symm⟩
  rw [himg]
  exact (manuscriptFiniteLevelSiteOrbit n ξ).image _


end

end LiteralBlockNormalForm
end GroupApproximation
