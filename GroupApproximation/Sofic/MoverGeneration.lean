import GroupApproximation.Sofic.CoronaRadicalPullback
import Mathlib.GroupTheory.GroupAction.Basic

/-!
# Movers, and unions of forced defects

Two small pieces of the dossier.  The finite mover family replacing a single
distinguished mover is Fournier-Facio's refinement; see `Sofic.MaxDisplacement`
for the estimate it feeds.

`closure_stabilizer_union_movers` is Corollary 4.2: a finitely generated group
acting on a set is generated by the stabiliser of a point together with the
*finitely many* generators that move it.  This is what lets the collapse
argument replace a single distinguished mover by a finite mover family without
enlarging the subgroup used for bookkeeping: the stabiliser contributes only
zero-displacement letters.

`coronaMFResidual_iSup_le` is the step that turns the telescope iteration of
Section 37 into a single statement: an increasing family of forced-defect
kernels, each inside the MF radical, has its union inside the MF radical.  In
Lean this is just that the radical is a subgroup, which is the honest content of
the dossier's argument once the individual containments are known.
-/

namespace GroupApproximation

universe u v w

/-- **Corollary 4.2.**  The stabiliser of a point together with the moving
generators generates the whole group. -/
theorem closure_stabilizer_union_movers {Γ : Type u} [Group Γ] {X : Type v}
    [MulAction Γ X] (x₀ : X) (S : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) :
    Subgroup.closure ((MulAction.stabilizer Γ x₀ : Set Γ) ∪
      {s : Γ | s ∈ S ∧ s • x₀ ≠ x₀}) = ⊤ := by
  refine eq_top_iff.mpr ?_
  rw [← hS]
  refine (Subgroup.closure_le _).mpr fun s hs => ?_
  by_cases h : s • x₀ = x₀
  · exact Subgroup.subset_closure (Or.inl h)
  · exact Subgroup.subset_closure (Or.inr ⟨hs, h⟩)

/-- The moving generators really are finitely many. -/
theorem movers_finite {Γ : Type u} [Group Γ] {X : Type v} [MulAction Γ X]
    (x₀ : X) (S : Finset Γ) :
    {s : Γ | s ∈ S ∧ s • x₀ ≠ x₀}.Finite :=
  Set.Finite.subset S.finite_toSet fun _ hs => hs.1

/-- **Section 37, union step.**  An increasing family of forced-defect kernels,
each inside the MF radical, has its supremum inside the MF radical. -/
theorem coronaMFResidual_iSup_le {H : Type u} [Group H] {ι : Type w}
    (N : ι → Subgroup H) (hN : ∀ i, N i ≤ coronaMFResidual H) :
    (⨆ i, N i) ≤ coronaMFResidual H :=
  iSup_le hN

end GroupApproximation
