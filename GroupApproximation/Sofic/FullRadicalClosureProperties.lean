import GroupApproximation.Sofic.SimpleFullMFRadical
import GroupApproximation.Algebra.GroupTorsionFree

/-!
# What the class of full-MF-radical groups is closed under

The routing lane wants a *torsion-free* group whose MF radical is everything,
and the existence step it quotes -- a relative common quotient produced by
acylindrical small cancellation -- is the one piece with no formal theory
behind it.  That is an argument about a single hard example.  It says nothing
about the class itself, and the class turns out to be extremely well behaved.

Write `Rad(G) = ⊤` for "every genuine norm-matrix corona representation of `G`
is trivial".  This file proves, with no hypothesis anywhere on countability,
finite presentation, hyperbolicity or Kazhdan property:

* `actualCoronaMFResidual_eq_top_of_surjective` -- quotients stay full;
* `actualCoronaMFResidual_eq_top_of_iSup_eq_top` -- a group generated by full
  subgroups is full, so full subgroups can only ever be *enlarged* to full
  groups, never diluted;
* `actualCoronaMFResidual_eq_top_of_extension` -- an extension of a full group
  by a full group is full.

The last one is the interesting one, because torsion-freeness has exactly the
same closure property (`isPowerTorsionFree_of_extension`) and a matching one
for directed unions (`isPowerTorsionFree_of_directed_iSup`).  The conjunction
that the routing lane is after is therefore closed under both operations:
`torsionFree_full_of_extension` and `torsionFree_full_of_directed_iSup`.

So the routing lane needs exactly one thing, and needs it only once.  A single
countable torsion-free group with a full radical -- from any source at all --
generates a proper class of them, since every extension of it by itself, every
directed union of those, and every torsion-free extension in either direction
inherits both properties.  `torsionFree_full_of_isSimpleGroup` records the
cheapest such source: any countable torsion-free simple non-MF group will do,
because in a simple group the normal subgroup `Rad(G)` has nowhere else to be.

None of this produces the example.  It says that producing it once is enough,
and that the difficulty is concentrated entirely in nonemptiness of the class
rather than anywhere in its structure -- which is the opposite of how the
routing paragraph reads, where torsion-freeness looks like a fragile side
condition to be protected through the construction.
-/

namespace GroupApproximation

universe u v w

variable {G : Type u} [Group G]

/-! ## Fullness, unfolded in both directions -/

/-- `Rad(G) = ⊤` says exactly that every genuine corona representation kills
every element.  This is the elimination form. -/
theorem forall_eq_one_of_actualCoronaMFResidual_eq_top
    (h : actualCoronaMFResidual G = ⊤) (x : G) :
    ∀ (X : ℕ → FiniteModel), ∀ hX : ∀ n, 0 < Fintype.card (X n),
      letI : ∀ n, Nonempty (X n) :=
        fun n ↦ Fintype.card_pos_iff.mp (hX n)
      ∀ rho : G →* unitary (NormMatrixCStarCorona (fun n ↦ X n)), rho x = 1 := by
  have hx : x ∈ actualCoronaMFResidual G := by
    rw [h]
    exact Subgroup.mem_top x
  exact mem_actualCoronaMFResidual_iff.mp hx

/-- The introduction form. -/
theorem actualCoronaMFResidual_eq_top_of_forall_eq_one
    (h : ∀ x : G, ∀ (X : ℕ → FiniteModel), ∀ hX : ∀ n, 0 < Fintype.card (X n),
      letI : ∀ n, Nonempty (X n) :=
        fun n ↦ Fintype.card_pos_iff.mp (hX n)
      ∀ rho : G →* unitary (NormMatrixCStarCorona (fun n ↦ X n)), rho x = 1) :
    actualCoronaMFResidual G = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  exact mem_actualCoronaMFResidual_iff.mpr (h x)

/-! ## Closure under quotients -/

/-- **Quotients stay full.**  The radical is functorial, and the image of `⊤`
under a surjection is `⊤`. -/
theorem actualCoronaMFResidual_eq_top_of_surjective {H : Type v} [Group H]
    (f : G →* H) (hf : Function.Surjective f)
    (h : actualCoronaMFResidual G = ⊤) :
    actualCoronaMFResidual H = ⊤ := by
  refine top_le_iff.mp ?_
  calc (⊤ : Subgroup H)
      = (⊤ : Subgroup G).map f := (Subgroup.map_top_of_surjective f hf).symm
    _ = (actualCoronaMFResidual G).map f := by rw [h]
    _ ≤ actualCoronaMFResidual H := map_actualCoronaMFResidual_le f

/-- Fullness is an isomorphism invariant. -/
theorem actualCoronaMFResidual_eq_top_of_mulEquiv {H : Type v} [Group H]
    (e : G ≃* H) (h : actualCoronaMFResidual G = ⊤) :
    actualCoronaMFResidual H = ⊤ :=
  actualCoronaMFResidual_eq_top_of_surjective e.toMonoidHom e.surjective h

/-! ## Closure under generation -/

/-- **A group generated by full subgroups is full.**  Each member sits inside
the ambient radical by functoriality along its inclusion, and a normal subgroup
containing a generating family is everything.

No directedness and no normality: the subgroups need not commute, be normal, or
be comparable. -/
theorem actualCoronaMFResidual_eq_top_of_iSup_eq_top {ι : Type w} (K : ι → Subgroup G)
    (hsup : (⨆ i, K i) = ⊤)
    (hfull : ∀ i, actualCoronaMFResidual (K i) = ⊤) :
    actualCoronaMFResidual G = ⊤ := by
  refine top_le_iff.mp ?_
  rw [← hsup]
  refine iSup_le fun i => ?_
  intro x hx
  have hmem : (⟨x, hx⟩ : K i) ∈ actualCoronaMFResidual (K i) := by
    rw [hfull i]
    exact Subgroup.mem_top _
  exact map_actualCoronaMFResidual_le (K i).subtype
    (Subgroup.mem_map_of_mem _ hmem)

/-! ## Closure under extensions -/

/-- **An extension of a full group by a full group is full.**

Restricting a corona representation of `G` to `N` is a corona representation of
`N`, so fullness of `N` puts `N` inside the kernel; the representation then
factors through `G ⧸ N`, where fullness of the quotient finishes it.  Both
halves use the *same* coordinate system `X`, which is why no countability or
compatibility hypothesis is needed. -/
theorem actualCoronaMFResidual_eq_top_of_extension (N : Subgroup G) [N.Normal]
    (hN : actualCoronaMFResidual N = ⊤)
    (hQ : actualCoronaMFResidual (G ⧸ N) = ⊤) :
    actualCoronaMFResidual G = ⊤ := by
  refine actualCoronaMFResidual_eq_top_of_forall_eq_one ?_
  intro x X hX
  letI : ∀ n, Nonempty (X n) :=
    fun n ↦ Fintype.card_pos_iff.mp (hX n)
  intro rho
  -- the restriction to `N` is a corona representation of `N`, hence trivial
  have hker : ∀ y ∈ N, rho y = 1 := by
    intro y hy
    have h1 := forall_eq_one_of_actualCoronaMFResidual_eq_top hN (⟨y, hy⟩ : N) X hX
      (rho.comp N.subtype)
    simpa using h1
  -- so it factors through the quotient, which is full as well
  have h2 := forall_eq_one_of_actualCoronaMFResidual_eq_top hQ
    (QuotientGroup.mk' N x) X hX (QuotientGroup.lift N rho hker)
  simpa using h2

/-- **A surjection with full kernel and full target has full source.**

This is the homomorphism form of closure under extensions.  It avoids making
callers identify the quotient by the kernel by hand. -/
theorem actualCoronaMFResidual_eq_top_of_surjective_kernel
    {H : Type v} [Group H] (f : G →* H) (hf : Function.Surjective f)
    (hker : actualCoronaMFResidual f.ker = ⊤)
    (hH : actualCoronaMFResidual H = ⊤) :
    actualCoronaMFResidual G = ⊤ := by
  have hquot : actualCoronaMFResidual (G ⧸ f.ker) = ⊤ :=
    actualCoronaMFResidual_eq_top_of_mulEquiv
      (QuotientGroup.quotientKerEquivOfSurjective f hf).symm hH
  exact actualCoronaMFResidual_eq_top_of_extension f.ker hker hquot

/-! ## The same two closure properties for torsion-freeness -/

/-- **An extension of a torsion-free group by a torsion-free group is
torsion-free.**  A finite power of `g` that dies makes the class of `g` a
torsion element of the quotient, hence trivial, so `g` already lies in `N`. -/
theorem isPowerTorsionFree_of_extension {N : Subgroup G} [N.Normal]
    (hN : IsPowerTorsionFree N) (hQ : IsPowerTorsionFree (G ⧸ N)) :
    IsPowerTorsionFree G := by
  intro g n hn hpow
  have hq : (QuotientGroup.mk' N) g = 1 := by
    refine hQ _ n hn ?_
    rw [← map_pow, hpow, map_one]
  have hmem : g ∈ N := by
    have hker : g ∈ (QuotientGroup.mk' N).ker := hq
    rwa [QuotientGroup.ker_mk'] at hker
  have hpowN : (⟨g, hmem⟩ : N) ^ n = 1 := by
    apply Subtype.ext
    simpa using hpow
  simpa using congrArg Subtype.val (hN _ n hn hpowN)

/-- **A directed union of torsion-free subgroups is torsion-free.**  Unlike
fullness, this one really does need directedness: a group generated by
torsion-free subgroups can have torsion. -/
theorem isPowerTorsionFree_of_directed_iSup {ι : Type w} (hι : Nonempty ι)
    (K : ι → Subgroup G) (hdir : Directed (· ≤ ·) K)
    (hsup : (⨆ i, K i) = ⊤) (hK : ∀ i, IsPowerTorsionFree (K i)) :
    IsPowerTorsionFree G := by
  haveI := hι
  intro g n hn hpow
  have hmem : g ∈ ⨆ i, K i := by
    rw [hsup]
    exact Subgroup.mem_top g
  obtain ⟨i, hi⟩ := (Subgroup.mem_iSup_of_directed hdir).mp hmem
  have hpowK : (⟨g, hi⟩ : K i) ^ n = 1 := by
    apply Subtype.ext
    simpa using hpow
  simpa using congrArg Subtype.val (hK i _ n hn hpowK)

/-! ## The conjunction the routing lane is after -/

/-- **Torsion-free with a full radical is closed under extensions.**  This is
the routing lane's target property, and it propagates: from one example, every
iterated extension of it by itself is another. -/
theorem torsionFree_full_of_extension (N : Subgroup G) [N.Normal]
    (hNt : IsPowerTorsionFree N) (hNf : actualCoronaMFResidual N = ⊤)
    (hQt : IsPowerTorsionFree (G ⧸ N)) (hQf : actualCoronaMFResidual (G ⧸ N) = ⊤) :
    IsPowerTorsionFree G ∧ actualCoronaMFResidual G = ⊤ :=
  ⟨isPowerTorsionFree_of_extension hNt hQt,
    actualCoronaMFResidual_eq_top_of_extension N hNf hQf⟩

/-- **And under directed unions.**  Fullness needs no directedness, so the
hypothesis is carried only by the torsion-free half. -/
theorem torsionFree_full_of_directed_iSup {ι : Type w} (hι : Nonempty ι)
    (K : ι → Subgroup G) (hdir : Directed (· ≤ ·) K) (hsup : (⨆ i, K i) = ⊤)
    (hKt : ∀ i, IsPowerTorsionFree (K i))
    (hKf : ∀ i, actualCoronaMFResidual (K i) = ⊤) :
    IsPowerTorsionFree G ∧ actualCoronaMFResidual G = ⊤ :=
  ⟨isPowerTorsionFree_of_directed_iSup hι K hdir hsup hKt,
    actualCoronaMFResidual_eq_top_of_iSup_eq_top K hsup hKf⟩

/-! ## The cheapest entry point into the class -/

/-- **Simplicity supplies fullness for free.**  In a simple group the normal
subgroup `Rad(G)` is `⊥` or `⊤`, and `⊥` says the group is MF; so a countable
torsion-free simple non-MF group is already a member of the class, with no
routing construction anywhere.

This is the reduction the routing lane should be measured against: it does not
have to preserve torsion-freeness through a small-cancellation quotient, it has
to produce one torsion-free simple non-MF group. -/
theorem torsionFree_full_of_isSimpleGroup [Countable G]
    (ht : IsPowerTorsionFree G) (hsimple : IsSimpleGroup G)
    (hnot : ¬ IsCDEOperatorMF G) :
    IsPowerTorsionFree G ∧ actualCoronaMFResidual G = ⊤ :=
  ⟨ht, actualCoronaMFResidual_eq_top_of_isSimpleGroup hsimple hnot⟩

/-- A nontrivial full group is not MF: the class is not vacuous for a silly
reason.  Stated in the literal genuine-corona radical, at any universe. -/
theorem not_isCDEOperatorMF_of_actualCoronaMFResidual_eq_top [Countable G] [Nontrivial G]
    (h : actualCoronaMFResidual G = ⊤) : ¬ IsCDEOperatorMF G := by
  intro hMF
  have hbot : actualCoronaMFResidual G = ⊥ :=
    isCDEOperatorMF_iff_actualCoronaMFResidual_eq_bot.mp hMF
  obtain ⟨x, hx⟩ := exists_ne (1 : G)
  have hmem : x ∈ actualCoronaMFResidual G := by
    rw [h]
    exact Subgroup.mem_top x
  rw [hbot, Subgroup.mem_bot] at hmem
  exact hx hmem

end GroupApproximation
