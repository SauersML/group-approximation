import GroupApproximation.Sofic.LiteralBaseDoublingIndex

/-!
# Transitivity on the nontrivial doubling cosets, over the affine carrier

**Build status.**  This module is imported by `GroupApproximation.lean` and is
therefore part of the repository's root build/audit closure.

`Sofic/LiteralBlockGeometry.lean` reduces Proposition 4.2 of
`notes/LITERAL_GROUP_BLOCK_AMALGAM_STRUCTURE_2026-08-14.md` — the blocks of the
orbital graph are complete graphs — to one arithmetic hypothesis,

    AlphaCosetTransitive α a₀ :
      ∀ γ : Γ, γ ∉ Set.range α → ∃ ν : Γ, γ⁻¹ * (α ν * a₀) ∈ Set.range α ,

and proves it for `Monsters/AffineSL3Doubling.alpha` over
`AffineSL3Doubling.Gamma`.  The literal chain, however, runs over
`ExplicitLinearModel.gammaBar` with `α = conjD`, and the repository relates
neither carrier to the other.  This file proves the hypothesis directly over
`gammaBar`, so the reduction becomes usable where it is needed.

## Why this is not a transcription of the affine proof

The affine proof picks, for each nonzero parity class, an arbitrary `SL₃(ℤ)`
matrix with a first column in that class — seven explicit matrices.  That is
legitimate over `AffineSL3Doubling.Gamma`, whose linear part is all of
`SL₃(ℤ)`.  It is *not* available over `gammaBar`, whose linear part is only
the subgroup generated by the three displayed rotations `x, y, z`; asserting
that this subgroup is `SL₃(ℤ)` is exactly the conditional literature input
(I1) of the source document, `\cite{CRW}` Theorem 2, which the manuscript
explicitly does not use.

So the proof here is the manuscript's own `[audit-fix]` computation: the orbit
of `ē₁` under the mod-`2` reductions of `x, y, z` alone is all seven nonzero
classes of `(ℤ/2)³`, along the chain

    e₁  --x-->  e₃  --z-->  (0,1,1)  --x-->  (1,1,0)  --y-->  (1,1,1) ,

with the `x`-cycle supplying `e₂` and one more `x`-step supplying `(1,0,1)`.
**This module is CRW-free.**

## How the computation is carried out

Not with matrices.  The conjugation action of the rotations on the three
translations is already recorded as nine group identities in
`Sofic/LiteralBaseRelations.lean` (`x_conj_v1 : x * v₁ * x⁻¹ = v₃`, and so
on), each of them already reduced to a verified `4 × 4` rational matrix
identity.  Rewriting with those nine identities computes the whole orbit, so
no new matrix arithmetic appears below and none is needed.

The seven rotation words are `1`, `x`, `x²`, `z`, `yx`, `y²x`, `xyx`, and for
each of them the displayed core lemma exhibits

    (parity representative)⁻¹ * (rotation word * v₁)  ∈  doubledBase ,

`doubledBase` being the subgroup `⟨x, y, z, v₁², v₂², v₃²⟩` of the literal
base, whose image under `affineQuotient` lands in `range conjD`
(`map_doubledBase_le_conjD_range`).  Everything happens inside the *presented*
base and is transported once, at the end, by the surjection
`affineQuotient : Base ↠ gammaBar`.

Only two of the seven cases need that translations commute; the other five are
free-group identities and `group` closes them.

## Statement

`conjD_cosetTransitive` is definitionally
`LiteralBlockGeometry.AlphaCosetTransitive conjD v1G`.  It is stated in
unfolded form on purpose: `Sofic/LiteralBlockGeometry.lean` is an untracked
working-tree file at the time of writing, and this module has no reason to
depend on it.  Once that file is stable the bridge is `rfl`.

What is still missing before Proposition 4.2 discharges the completeness
hypothesis of `Sofic/LiteralBlockCliffordBridge.lean` and
`Sofic/LiteralLampKernelAmalgam.lean` is only the *site vocabulary*
identification — `LiteralBlockGeometry.Cosets α hα` against
`LiteralBlockNormalForm.Site` — which is bookkeeping, not mathematics, and is
not attempted here.
-/

namespace GroupApproximation
namespace LiteralAffineCosetTransitivity

open ExplicitLinearModel LiteralBaseRelations LiteralBaseDoublingIndex
  LiteralBaseAffineQuotient LiteralNonMFLinearWitness

noncomputable section

/-! ## 1.  The parity representatives, evaluated -/

/-- The parity representative attached to an exponent triple is the
corresponding product of the three translations.  Only the three basis
evaluations of `latticeToBase` are used, so nothing here depends on the
private internals of the lattice file. -/
theorem parityRep_apply (e : Fin 3 → ℤ) :
    parityRep e = v1 ^ e 0 * (v2 ^ e 1 * v3 ^ e 2) := by
  have hsplit : (Multiplicative.ofAdd e : Multiplicative (Fin 3 → ℤ))
      = Multiplicative.ofAdd (Pi.single (0 : Fin 3) (1 : ℤ)) ^ e 0 *
        (Multiplicative.ofAdd (Pi.single (1 : Fin 3) (1 : ℤ)) ^ e 1 *
          Multiplicative.ofAdd (Pi.single (2 : Fin 3) (1 : ℤ)) ^ e 2) := by
    rw [← ofAdd_zsmul, ← ofAdd_zsmul, ← ofAdd_zsmul, ← ofAdd_add, ← ofAdd_add]
    congr 1
    funext i
    fin_cases i <;> simp
  rw [parityRep, hsplit, map_mul, map_mul, map_zpow, map_zpow, map_zpow,
    LiteralBaseTranslationLattice.latticeToBase_basis_zero,
    LiteralBaseTranslationLattice.latticeToBase_basis_one,
    LiteralBaseTranslationLattice.latticeToBase_basis_two]

@[simp] theorem cast_fin2_zero : ((0 : Fin 2) : ℤ) = 0 := rfl

@[simp] theorem cast_fin2_one : ((1 : Fin 2) : ℤ) = 1 := rfl

/-! ## 2.  Moving a rotation past `v₁`

Each of these is one of the nine conjugation relations of
`Sofic/LiteralBaseRelations.lean`, rearranged.  Note the `conv_rhs` in
`y_mul_v1`: there `v₁` occurs on both sides of the goal, so an unrestricted
rewrite would fire twice and leave an unprovable equation. -/

theorem x_mul_v1 : x * v1 = v3 * x := by
  rw [← x_conj_v1]
  group

theorem x_mul_v2 : x * v2 = v1 * x := by
  rw [← x_conj_v2]
  group

theorem x_mul_v3 : x * v3 = v2 * x := by
  rw [← x_conj_v3]
  group

theorem y_mul_v1 : y * v1 = v1 * y := by
  conv_rhs => rw [← y_conj_v1]
  group

theorem y_mul_v3 : y * v3 = v1 * v2⁻¹ * y := by
  rw [← y_conj_v3]
  group

theorem z_mul_v1 : z * v1 = v2 * v3⁻¹ * z := by
  rw [← z_conj_v1]
  group

theorem x_mul_v2inv : x * v2⁻¹ = v1⁻¹ * x := by
  have h : x * v2⁻¹ * x⁻¹ = v1⁻¹ := by
    rw [← x_conj_v2]
    group
  rw [← h]
  group

theorem y_mul_v2inv : y * v2⁻¹ = v3⁻¹ * v2 * y := by
  have h : y * v2⁻¹ * y⁻¹ = v3⁻¹ * v2 := by
    rw [show (v3⁻¹ * v2 : LiteralNonMFPresentation.Base) = (v2⁻¹ * v3)⁻¹ by
      group, ← y_conj_v2]
    group
  rw [← h]
  group

/-! ## 3.  The seven rotation words, and what they do to `v₁`

`rot_word * v₁ = (translation) * rot_word`, the translation being the
conjugate `rot_word · v₁ · rot_word⁻¹`.  Its parity class is the point: the
seven classes below are `100`, `001`, `010`, `011`, `110`, `111`, `101`, which
is every nonzero class of `(ℤ/2)³`. -/
/-- `x² · v₁ · x⁻² = v₂`: parity class `010`. -/
theorem rot_xx : x * x * v1 = v2 * (x * x) := by
  calc x * x * v1 = x * (x * v1) := by group
    _ = x * (v3 * x) := by rw [x_mul_v1]
    _ = x * v3 * x := by group
    _ = v2 * x * x := by rw [x_mul_v3]
    _ = v2 * (x * x) := by group
/-- `(yx) · v₁ · (yx)⁻¹ = v₁v₂⁻¹`: parity class `110`. -/
theorem rot_yx : y * x * v1 = v1 * v2⁻¹ * (y * x) := by
  calc y * x * v1 = y * (x * v1) := by group
    _ = y * (v3 * x) := by rw [x_mul_v1]
    _ = y * v3 * x := by group
    _ = v1 * v2⁻¹ * y * x := by rw [y_mul_v3]
    _ = v1 * v2⁻¹ * (y * x) := by group

/-- `(y²x) · v₁ · (y²x)⁻¹ = v₁v₃⁻¹v₂`: parity class `111`. -/
theorem rot_yyx : y * y * x * v1 = v1 * v3⁻¹ * v2 * (y * y * x) := by
  calc y * y * x * v1 = y * (y * x * v1) := by group
    _ = y * (v1 * v2⁻¹ * (y * x)) := by rw [rot_yx]
    _ = y * v1 * v2⁻¹ * (y * x) := by group
    _ = v1 * y * v2⁻¹ * (y * x) := by rw [y_mul_v1]
    _ = v1 * (y * v2⁻¹) * (y * x) := by group
    _ = v1 * (v3⁻¹ * v2 * y) * (y * x) := by rw [y_mul_v2inv]
    _ = v1 * v3⁻¹ * v2 * (y * y * x) := by group

/-- `(xyx) · v₁ · (xyx)⁻¹ = v₃v₁⁻¹`: parity class `101`. -/
theorem rot_xyx : x * y * x * v1 = v3 * v1⁻¹ * (x * y * x) := by
  calc x * y * x * v1 = x * (y * x * v1) := by group
    _ = x * (v1 * v2⁻¹ * (y * x)) := by rw [rot_yx]
    _ = x * v1 * v2⁻¹ * (y * x) := by group
    _ = v3 * x * v2⁻¹ * (y * x) := by rw [x_mul_v1]
    _ = v3 * (x * v2⁻¹) * (y * x) := by group
    _ = v3 * (v1⁻¹ * x) * (y * x) := by rw [x_mul_v2inv]
    _ = v3 * v1⁻¹ * (x * y * x) := by group

/-! ## 4.  The seven core identities

For each nonzero parity class, the parity representative cancels the
translation part, leaving an element of `doubledBase = ⟨x, y, z, v₁², v₂²,
v₃²⟩`.  Five are free-group identities; `core_111` and `core_101` are the two
that need translations to commute. -/

theorem core_100 : v1⁻¹ * (1 * v1) = (1 : LiteralNonMFPresentation.Base) := by
  group

theorem core_001 : v3⁻¹ * (x * v1) = x := by
  rw [GroupApproximation.LiteralAffineCosetTransitivity.x_mul_v1]
  group

theorem core_010 : v2⁻¹ * (x * x * v1) = x * x := by
  rw [rot_xx]
  group

theorem core_011 : (v2 * v3)⁻¹ * (z * v1) = (v3 ^ 2)⁻¹ * z := by
  rw [GroupApproximation.LiteralAffineCosetTransitivity.z_mul_v1]
  group

theorem core_110 : (v1 * v2)⁻¹ * (y * x * v1) = (v2 ^ 2)⁻¹ * (y * x) := by
  rw [rot_yx]
  group

theorem core_111 : (v1 * (v2 * v3))⁻¹ * (y * y * x * v1)
    = (v3 ^ 2)⁻¹ * (y * y * x) := by
  have hc : v2⁻¹ * v3⁻¹ = v3⁻¹ * v2⁻¹ :=
    (commute_v2_v3.inv_left.inv_right).eq
  rw [rot_yyx]
  calc (v1 * (v2 * v3))⁻¹ * (v1 * v3⁻¹ * v2 * (y * y * x))
      = v3⁻¹ * (v2⁻¹ * v3⁻¹) * v2 * (y * y * x) := by group
    _ = v3⁻¹ * (v3⁻¹ * v2⁻¹) * v2 * (y * y * x) := by rw [hc]
    _ = (v3 ^ 2)⁻¹ * (y * y * x) := by group

theorem core_101 : (v1 * v3)⁻¹ * (x * y * x * v1)
    = (v1 ^ 2)⁻¹ * (x * y * x) := by
  have hc : v1⁻¹ * v3 = v3 * v1⁻¹ := (commute_v1_v3.inv_left).eq
  rw [rot_xyx]
  calc (v1 * v3)⁻¹ * (v3 * v1⁻¹ * (x * y * x))
      = v3⁻¹ * (v1⁻¹ * v3) * v1⁻¹ * (x * y * x) := by group
    _ = v3⁻¹ * (v3 * v1⁻¹) * v1⁻¹ * (x * y * x) := by rw [hc]
    _ = (v1 ^ 2)⁻¹ * (x * y * x) := by group

/-! ## 5.  The seven witnesses lie in the doubled subgroup -/

theorem d_100_mem : (1 : LiteralNonMFPresentation.Base) ∈ doubledBase :=
  Subgroup.one_mem _
theorem d_010_mem : x * x ∈ doubledBase :=
  Subgroup.mul_mem _ x_mem_doubledBase x_mem_doubledBase

theorem d_011_mem : (v3 ^ 2)⁻¹ * z ∈ doubledBase :=
  Subgroup.mul_mem _ (Subgroup.inv_mem _ v3sq_mem_doubledBase) z_mem_doubledBase

theorem d_110_mem : (v2 ^ 2)⁻¹ * (y * x) ∈ doubledBase :=
  Subgroup.mul_mem _ (Subgroup.inv_mem _ v2sq_mem_doubledBase)
    (Subgroup.mul_mem _ y_mem_doubledBase x_mem_doubledBase)

theorem d_111_mem : (v3 ^ 2)⁻¹ * (y * y * x) ∈ doubledBase :=
  Subgroup.mul_mem _ (Subgroup.inv_mem _ v3sq_mem_doubledBase)
    (Subgroup.mul_mem _ (Subgroup.mul_mem _ y_mem_doubledBase
      y_mem_doubledBase) x_mem_doubledBase)

theorem d_101_mem : (v1 ^ 2)⁻¹ * (x * y * x) ∈ doubledBase :=
  Subgroup.mul_mem _ (Subgroup.inv_mem _ v1sq_mem_doubledBase)
    (Subgroup.mul_mem _ (Subgroup.mul_mem _ x_mem_doubledBase
      y_mem_doubledBase) x_mem_doubledBase)

/-! ## 6.  Transport to the affine matrix group -/

/-- Membership in the range of `conjD`, as a set and as a subgroup, are the
same statement: `MonoidHom.range` carries `Set.range` as its carrier. -/
theorem mem_setRange_conjD_iff (g : gammaBar) :
    g ∈ Set.range conjD ↔ g ∈ (conjD).range := Iff.rfl

/-- A core identity in the presented base transports to a membership in the
range of the compressing endomorphism. -/
theorem witness_of_base {p r d : LiteralNonMFPresentation.Base}
    (hd : d ∈ doubledBase) (heq : p⁻¹ * (r * v1) = d) :
    (affineQuotient p)⁻¹ * (affineQuotient r * v1G) ∈ (conjD).range := by
  have h1 : (affineQuotient p)⁻¹ * (affineQuotient r * v1G)
      = affineQuotient (p⁻¹ * (r * v1)) := by
    rw [map_mul, map_mul, map_inv, affineQuotient_v1]
  rw [h1, heq]
  exact map_doubledBase_le_conjD_range ⟨d, hd, rfl⟩

/-! ### The compressing endomorphism fixes the rotation letters -/

theorem conjD_fix_one : conjD (affineQuotient (1 : LiteralNonMFPresentation.Base))
    = affineQuotient (1 : LiteralNonMFPresentation.Base) := by
  rw [map_one, map_one]

theorem conjD_fix_x : conjD (affineQuotient x) = affineQuotient x := by
  rw [affineQuotient_x, conjD_xG]

theorem conjD_fix_y : conjD (affineQuotient y) = affineQuotient y := by
  rw [affineQuotient_y, conjD_yG]

theorem conjD_fix_z : conjD (affineQuotient z) = affineQuotient z := by
  rw [affineQuotient_z, conjD_zG]

theorem conjD_fix_mul {a b : LiteralNonMFPresentation.Base}
    (ha : conjD (affineQuotient a) = affineQuotient a)
    (hb : conjD (affineQuotient b) = affineQuotient b) :
    conjD (affineQuotient (a * b)) = affineQuotient (a * b) := by
  rw [map_mul, map_mul, ha, hb]

/-! ## 7.  A witness for every nonzero parity class -/

/-- **The orbit computation.**  For every nonzero parity class there is a
rotation word `ν`, fixed by the compressing endomorphism, carrying the parity
representative into the compressed range. -/
theorem exists_witness (e : Fin 3 → Fin 2)
    (hne : ¬ (e 0 = 0 ∧ e 1 = 0 ∧ e 2 = 0)) :
    ∃ ν : gammaBar, conjD ν = ν ∧
      (affineQuotient (parityRep (fun i ↦ ((e i : ℤ)))))⁻¹ *
        (ν * v1G) ∈ (conjD).range := by
  have hcase : ∀ a : Fin 2, a = 0 ∨ a = 1 := by decide
  rw [parityRep_apply]
  rcases hcase (e 0) with h0 | h0
  · rcases hcase (e 1) with h1 | h1
    · rcases hcase (e 2) with h2 | h2
      · exact absurd ⟨h0, h1, h2⟩ hne
      · -- class `001`, rotation word `x`
        have hp : v1 ^ ((e 0 : ℤ)) *
            (v2 ^ ((e 1 : ℤ)) * v3 ^ ((e 2 : ℤ))) = v3 := by
          rw [h0, h1, h2, cast_fin2_zero, cast_fin2_one, zpow_zero, zpow_zero,
            zpow_one, one_mul, one_mul]
        rw [hp]
        exact ⟨affineQuotient x, conjD_fix_x,
          witness_of_base GroupApproximation.LiteralBaseDoublingIndex.x_mem_doubledBase core_001⟩
    · rcases hcase (e 2) with h2 | h2
      · -- class `010`, rotation word `x²`
        have hp : v1 ^ ((e 0 : ℤ)) *
            (v2 ^ ((e 1 : ℤ)) * v3 ^ ((e 2 : ℤ))) = v2 := by
          rw [h0, h1, h2, cast_fin2_zero, cast_fin2_one, zpow_zero, zpow_one,
            zpow_zero, mul_one, one_mul]
        rw [hp]
        refine ⟨affineQuotient (x * x), conjD_fix_mul conjD_fix_x conjD_fix_x,
          ?_⟩
        exact witness_of_base d_010_mem core_010
      · -- class `011`, rotation word `z`
        have hp : v1 ^ ((e 0 : ℤ)) *
            (v2 ^ ((e 1 : ℤ)) * v3 ^ ((e 2 : ℤ)))
            = v2 * v3 := by
          rw [h0, h1, h2, cast_fin2_zero, cast_fin2_one, zpow_zero, zpow_one,
            zpow_one, one_mul]
        rw [hp]
        exact ⟨affineQuotient z, conjD_fix_z,
          witness_of_base d_011_mem core_011⟩
  · rcases hcase (e 1) with h1 | h1
    · rcases hcase (e 2) with h2 | h2
      · -- class `100`, rotation word `1`
        have hp : v1 ^ ((e 0 : ℤ)) *
            (v2 ^ ((e 1 : ℤ)) * v3 ^ ((e 2 : ℤ))) = v1 := by
          rw [h0, h1, h2, cast_fin2_zero, cast_fin2_one, zpow_one, zpow_zero,
            zpow_zero, mul_one, mul_one]
        rw [hp]
        exact ⟨affineQuotient 1, conjD_fix_one,
          witness_of_base d_100_mem core_100⟩
      · -- class `101`, rotation word `xyx`
        have hp : v1 ^ ((e 0 : ℤ)) *
            (v2 ^ ((e 1 : ℤ)) * v3 ^ ((e 2 : ℤ)))
            = v1 * v3 := by
          rw [h0, h1, h2, cast_fin2_zero, cast_fin2_one, zpow_one, zpow_zero,
            zpow_one, one_mul]
        rw [hp]
        refine ⟨affineQuotient (x * y * x),
          conjD_fix_mul (conjD_fix_mul conjD_fix_x conjD_fix_y) conjD_fix_x,
          ?_⟩
        exact witness_of_base d_101_mem core_101
    · rcases hcase (e 2) with h2 | h2
      · -- class `110`, rotation word `yx`
        have hp : v1 ^ ((e 0 : ℤ)) *
            (v2 ^ ((e 1 : ℤ)) * v3 ^ ((e 2 : ℤ)))
            = v1 * v2 := by
          rw [h0, h1, h2, cast_fin2_zero, cast_fin2_one, zpow_one, zpow_one,
            zpow_zero, mul_one]
        rw [hp]
        refine ⟨affineQuotient (y * x), conjD_fix_mul conjD_fix_y conjD_fix_x,
          ?_⟩
        exact witness_of_base d_110_mem core_110
      · -- class `111`, rotation word `y²x`
        have hp : v1 ^ ((e 0 : ℤ)) *
            (v2 ^ ((e 1 : ℤ)) * v3 ^ ((e 2 : ℤ)))
            = v1 * (v2 * v3) := by
          rw [h0, h1, h2, cast_fin2_one, zpow_one, zpow_one, zpow_one]
        rw [hp]
        refine ⟨affineQuotient (y * y * x),
          conjD_fix_mul (conjD_fix_mul conjD_fix_y conjD_fix_y) conjD_fix_x,
          ?_⟩
        exact witness_of_base d_111_mem core_111

/-! ## 8.  The transitivity statement -/

/-- Left multiplication by an element of the range does not change membership
in it. -/
theorem mem_range_of_core {P s ν : gammaBar} (hs : s ∈ (conjD).range)
    (hcore : P⁻¹ * (ν * v1G) ∈ (conjD).range) :
    (P * s)⁻¹ * (ν * v1G) ∈ (conjD).range := by
  rw [mul_inv_rev, mul_assoc]
  exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hs) hcore

/-- **`α(Γ)` acts transitively on the nontrivial cosets of `α(Γ)`, over the
affine carrier of the literal chain.**  This is definitionally
`LiteralBlockGeometry.AlphaCosetTransitive conjD v1G`, and it is proved from
the three displayed rotations alone — no identification of `⟨x, y, z⟩` with
`SL₃(ℤ)`, hence no `\cite{CRW}` input. -/
theorem conjD_cosetTransitive :
    ∀ γ : gammaBar, γ ∉ Set.range conjD →
      ∃ ν : gammaBar, γ⁻¹ * (conjD ν * v1G) ∈ Set.range conjD := by
  intro γ hγ
  obtain ⟨g, rfl⟩ := affineQuotient_surjective γ
  obtain ⟨e, h, hh, hg⟩ := exists_parity_coset g
  subst hg
  have hs : affineQuotient h ∈ (conjD).range :=
    map_doubledBase_le_conjD_range ⟨h, hh, rfl⟩
  have hne : ¬ (e 0 = 0 ∧ e 1 = 0 ∧ e 2 = 0) := by
    rintro ⟨h0, h1, h2⟩
    refine hγ ?_
    rw [mem_setRange_conjD_iff]
    have hp : parityRep (fun i ↦ ((e i : ℤ)))
        = (1 : LiteralNonMFPresentation.Base) := by
      rw [parityRep_apply, h0, h1, h2, cast_fin2_zero, zpow_zero, zpow_zero,
        zpow_zero, one_mul, one_mul]
    rw [map_mul, hp, map_one, one_mul]
    exact hs
  obtain ⟨ν, hfix, hcore⟩ := exists_witness e hne
  refine ⟨ν, ?_⟩
  rw [mem_setRange_conjD_iff, hfix, map_mul]
  exact mem_range_of_core hs hcore

end

end LiteralAffineCosetTransitivity
end GroupApproximation
