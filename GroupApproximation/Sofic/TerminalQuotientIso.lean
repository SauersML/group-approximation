import GroupApproximation.Sofic.TerminalQuotientPresentation
import Mathlib.GroupTheory.NoncommCoprod
import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# The terminal quotient *is* the free-lamp amalgam

`Sofic/TerminalQuotientPresentation` constructs the canonical homomorphism

```text
terminalHom : (E/⟨w⟩)/(D/⟨w⟩)  →*  Σ *_B (B × C₂)
```

in the direction the presentation calculation supplies it, and explicitly
leaves open whether it is an isomorphism.  This file closes that gap: it
builds the inverse homomorphism outright and checks the two composites on
generators, so `terminalHom` is a `MulEquiv`.  No normal-form theorem for
amalgamated free products is used, and no declaration below carries a
hypothesis.

## The two halves

*Surjectivity* is the easy half.  `Monoid.PushoutI.induction_on` says a
pushout is generated by the images of its factor maps together with the base;
`amalgamHom_sect` puts every `inAmbient v` in the image — it is the statement
that `amalgamHom ∘ sect = inAmbient`, proved on the two generators of the
ascending HNN extension through
`MarkedCompression.vertical_mem_subgroup_of_iota_mem_of_t_mem` — and
`amalgamHom_dee` puts the lamp there.  That is `terminalHom_surjective`.

*Injectivity* is obtained not from a normal form but from an explicit inverse.
The universal property of the pushout, `Monoid.PushoutI.lift`, asks for a
homomorphism on each factor agreeing on the amalgamated subgroup:

* on `Σ` it is `quotHom ∘ sect`, using the section
  `LiteralLampKernelSplit.sect : Σ →* E` that the completeness of the base
  presentation already supplies;
* on `B × C₂` it is `MonoidHom.noncommCoprod` of that same map with the
  order-two map `C₂ →* (E/⟨w⟩)/D` sending the flip to the moved lamp `d`.

The only real content is the commutation hypothesis that the coproduct needs:

`quotHom_commute_baseMap` — **in the terminal quotient the moved lamp
commutes with the whole base**, not merely with `v₁`.  The printed defect is
the normal closure of the *single* commutator `⁅v₁, d⁆`, so this has to be
derived.  It is: the centralizer of `d` pulls back to a subgroup of the base,
a presented group is generated by its six letters
(`PresentedGroup.generated_by`), and each of the six is accounted for —

* `x, y, z` already centralize `d` upstairs in `E`, because `t x t⁻¹ = x` and
  `c` centralizes the base (`LiteralSignFreeQuotient.dee_commutes_x` and its
  two siblings);
* `v₁` is the imposed relator;
* `v₃ = x v₁ x⁻¹` and `v₂ = x v₃ x⁻¹` are two of the twenty displayed base
  relators (`LiteralBaseRelations.x_conj_v1`, `x_conj_v3`).

That is exactly the manuscript's sentence "the imposed relation `[d,v₁]=1`
together with the doubling relations forces `[d,B]=1`", read off the
presentation rather than off the matrix group.

## What this buys

`manuscriptExactRadical_of_symmetricDoubleMF` is
`TerminalQuotientPresentation.manuscriptExactRadical_of_terminalIdentification`
with its first hypothesis discharged: the exact MF-radical identity of the
manuscript now rests on operator MF of the symmetric double alone.
-/

namespace GroupApproximation
namespace TerminalQuotientPresentation

open LiteralNonMFPresentation LiteralNonMFLinearWitness
open LiteralSignFreeQuotient LiteralSignFreeRadicalReduction
open LiteralBaseAffineQuotient ExplicitLinearModel MarkedCompression
open LiteralLampKernelSplit
open Monoid
open scoped commutatorElement

noncomputable section

/-! ## The terminal quotient and its structural projection -/

/-- The manuscript's terminal quotient `(E/⟨w⟩)/(D/⟨w⟩)`. -/
abbrev TerminalQuotient : Type := SignFreeQuotient ⧸ signFreePrintedDefect

/-- The composite projection `E ↠ (E/⟨w⟩)/(D/⟨w⟩)`. -/
def quotHom : MarkedGroup →* TerminalQuotient :=
  (QuotientGroup.mk' signFreePrintedDefect).comp proj

theorem quotHom_apply (g : MarkedGroup) :
    quotHom g = QuotientGroup.mk' signFreePrintedDefect (proj g) := rfl

/-- `terminalHom` undoes the projection: it is `amalgamHom` on representatives.
This is `terminalHom_mk`, phrased at `quotHom`. -/
theorem terminalHom_quotHom (g : MarkedGroup) :
    terminalHom (quotHom g) = amalgamHom g := rfl

theorem quotHom_surjective : Function.Surjective quotHom := by
  intro q
  obtain ⟨s, rfl⟩ := QuotientGroup.mk'_surjective signFreePrintedDefect q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective markSubgroup s
  exact ⟨g, rfl⟩

theorem quotHom_dee_sq : quotHom dee * quotHom dee = 1 := by
  rw [← map_mul, dee_sq, map_one]

/-! ## The order-two map carrying the lamp -/

/-- The lamp of the amalgam, downstairs: the flip goes to the moved lamp `d`,
which is an involution because `c` is. -/
def lampHom : FlipC2 →* TerminalQuotient where
  toFun
    | .one => 1
    | .swap => quotHom dee
  map_one' := rfl
  map_mul' a b := by
    cases a <;> cases b
    · exact (one_mul (1 : TerminalQuotient)).symm
    · exact (one_mul (quotHom dee)).symm
    · exact (mul_one (quotHom dee)).symm
    · exact quotHom_dee_sq.symm

theorem lampHom_one : lampHom .one = 1 := rfl

theorem lampHom_swap : lampHom .swap = quotHom dee := rfl

/-- `terminalHom` carries the order-two map back to the lamp of the amalgam. -/
theorem terminalHom_lampHom (k : FlipC2) :
    terminalHom (lampHom k) = inLamp SigmaGroup sigmaBase FlipC2 k := by
  cases k
  · have h : inLamp SigmaGroup sigmaBase FlipC2 FlipC2.one = 1 :=
      map_one (inLamp SigmaGroup sigmaBase FlipC2)
    rw [h]
    exact map_one terminalHom
  · show terminalHom (quotHom dee) = amalgamLampRoot
    rw [terminalHom_quotHom, amalgamHom_dee]

/-! ## The imposed relation, on the whole base

The printed defect is the normal closure of the single commutator `⁅v₁, d⁆`.
Downstairs that one relator already forces `d` to centralize *all* of `B`:
the rotation letters and the translation squares centralize `d` in `E`
itself, and the two `x`-conjugation relators carry `v₁` onto `v₃` and `v₃`
onto `v₂`. -/

/-- **The moved lamp centralizes the whole base in the terminal quotient.** -/
theorem quotHom_commute_baseMap (b : Base) :
    Commute (quotHom (baseMap b)) (quotHom dee) := by
  -- the single imposed relator
  have hv1 : Commute (quotHom (baseMap baseV1)) (quotHom dee) := by
    refine commutatorElement_eq_one_iff_commute.mp ?_
    have h : ⁅quotHom (baseMap baseV1), quotHom dee⁆
        = (QuotientGroup.mk' signFreePrintedDefect)
            ⁅proj (baseMap baseV1), proj dee⁆ :=
      (map_commutatorElement (QuotientGroup.mk' signFreePrintedDefect)
        (proj (baseMap baseV1)) (proj dee)).symm
    rw [h, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact collapsedCommutator_mem_signFreePrintedDefect
  -- the three rotation letters: already true in `E`
  have hx : Commute (quotHom (baseMap LiteralBaseRelations.x)) (quotHom dee) :=
    (LiteralSignFreeQuotient.dee_commutes_x.map quotHom).symm
  have hy : Commute (quotHom (baseMap LiteralBaseRelations.y)) (quotHom dee) :=
    (LiteralSignFreeQuotient.dee_commutes_y.map quotHom).symm
  have hz : Commute (quotHom (baseMap LiteralBaseRelations.z)) (quotHom dee) :=
    (LiteralSignFreeQuotient.dee_commutes_z.map quotHom).symm
  -- the two remaining translations are `x`-conjugates of `v₁`
  have hv3 : Commute (quotHom (baseMap LiteralBaseRelations.v3)) (quotHom dee) := by
    have hconj : (LiteralBaseRelations.v3 : Base)
        = LiteralBaseRelations.x * LiteralBaseRelations.v1
          * LiteralBaseRelations.x⁻¹ := LiteralBaseRelations.x_conj_v1.symm
    rw [hconj]
    simp only [map_mul, map_inv]
    exact (hx.mul_left hv1).mul_left hx.inv_left
  have hv2 : Commute (quotHom (baseMap LiteralBaseRelations.v2)) (quotHom dee) := by
    have hconj : (LiteralBaseRelations.v2 : Base)
        = LiteralBaseRelations.x * LiteralBaseRelations.v3
          * LiteralBaseRelations.x⁻¹ := LiteralBaseRelations.x_conj_v3.symm
    rw [hconj]
    simp only [map_mul, map_inv]
    exact (hx.mul_left hv3).mul_left hx.inv_left
  -- a presented group is generated by its letters
  have hmem : ∀ g : Base, Commute (quotHom (baseMap g)) (quotHom dee) →
      g ∈ (Subgroup.centralizer {quotHom dee}).comap (quotHom.comp baseMap) :=
    fun _ hg =>
      Subgroup.mem_comap.mpr (Subgroup.mem_centralizer_singleton_iff.mpr hg)
  have hall : b ∈ (Subgroup.centralizer {quotHom dee}).comap
      (quotHom.comp baseMap) := by
    refine PresentedGroup.generated_by _ _ ?_ b
    intro j
    fin_cases j
    · exact hmem _ hv1
    · exact hmem _ hv2
    · exact hmem _ hv3
    · exact hmem _ hx
    · exact hmem _ hy
    · exact hmem _ hz
  exact Subgroup.mem_centralizer_singleton_iff.mp (Subgroup.mem_comap.mp hall)

/-! ## Surjectivity

`amalgamHom ∘ sect = inAmbient`: the section of `LiteralLampKernelSplit`
realizes the whole vertex group inside `E`, and `amalgamHom` puts it back
where it came from.  Both sides are homomorphisms out of the ascending HNN
extension, so it is enough to check the level-zero base and the stable
letter. -/

/-- **The vertex group is in the image, on the nose.** -/
theorem amalgamHom_sect (v : SigmaGroup) :
    amalgamHom (sect v) = inAmbient SigmaGroup sigmaBase FlipC2 v := by
  have hmem : v ∈ (amalgamHom.comp sect).eqLocus
      (inAmbient SigmaGroup sigmaBase FlipC2) := by
    apply vertical_mem_subgroup_of_iota_mem_of_t_mem alpha conjD_injective
    · intro γ
      show amalgamHom (sect (iotaVertical alpha conjD_injective γ))
        = inAmbient SigmaGroup sigmaBase FlipC2
            (iotaVertical alpha conjD_injective γ)
      rw [sect_iota, affineToMarked_apply, amalgamHom_baseMap,
        affineQuotient_baseAffineEquiv_symm]
    · show amalgamHom (sect (tVertical alpha conjD_injective))
        = inAmbient SigmaGroup sigmaBase FlipC2
            (tVertical alpha conjD_injective)
      rw [sect_t, amalgamHom_stable]
  exact hmem

theorem inAmbient_mem_terminalHom_range (v : SigmaGroup) :
    inAmbient SigmaGroup sigmaBase FlipC2 v ∈ terminalHom.range :=
  ⟨quotHom (sect v), by rw [terminalHom_quotHom, amalgamHom_sect]⟩

theorem inLamp_mem_terminalHom_range (k : FlipC2) :
    inLamp SigmaGroup sigmaBase FlipC2 k ∈ terminalHom.range :=
  ⟨lampHom k, terminalHom_lampHom k⟩

/-- A letter of the lamp factor splits as an ambient letter times a lamp:
`(γ, k) = (γ, 1) · (1, k)`, and `(γ,1)` is the amalgamated copy of `γ`. -/
theorem amalgam_of_false (p : LampFactor SigmaGroup sigmaBase FlipC2 false) :
    (PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2) false p)
      = inAmbient SigmaGroup sigmaBase FlipC2 (p.1 : SigmaGroup)
        * inLamp SigmaGroup sigmaBase FlipC2 p.2 := by
  have hbase : (PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2) false
        ((p.1, (1 : FlipC2)) : ↥sigmaBase × FlipC2))
      = inAmbient SigmaGroup sigmaBase FlipC2 (p.1 : SigmaGroup) := by
    have h1 : ((p.1, (1 : FlipC2)) : ↥sigmaBase × FlipC2)
        = lampMap SigmaGroup sigmaBase FlipC2 false p.1 := rfl
    rw [h1, PushoutI.of_apply_eq_base,
      ← PushoutI.of_apply_eq_base (φ := lampMap SigmaGroup sigmaBase FlipC2) true]
    rfl
  have hmul : PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2) false
        ((p.1, (1 : FlipC2)) : ↥sigmaBase × FlipC2)
      * PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2) false
        (((1 : ↥sigmaBase), p.2) : ↥sigmaBase × FlipC2)
      = PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2) false p := by
    rw [← map_mul]
    congr 1
    exact Prod.ext (mul_one _) (one_mul _)
  rw [← hmul, hbase, inLamp_apply]

/-- **`terminalHom` is surjective.**  A pushout is generated by the images of
its factor maps, and both are hit. -/
theorem terminalHom_surjective : Function.Surjective terminalHom := by
  intro a
  have hmem : a ∈ terminalHom.range := by
    refine PushoutI.induction_on (motive := fun b => b ∈ terminalHom.range)
      a ?_ ?_ ?_
    · intro i
      cases i
      · intro g
        have hsplit : PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2)
            false g ∈ terminalHom.range := by
          rw [amalgam_of_false]
          exact Subgroup.mul_mem _ (inAmbient_mem_terminalHom_range _)
            (inLamp_mem_terminalHom_range _)
        exact hsplit
      · intro g
        exact inAmbient_mem_terminalHom_range g
    · intro h
      have hb : PushoutI.base (lampMap SigmaGroup sigmaBase FlipC2) h
          = inAmbient SigmaGroup sigmaBase FlipC2 (h : SigmaGroup) :=
        (PushoutI.of_apply_eq_base (lampMap SigmaGroup sigmaBase FlipC2)
          true h).symm
      rw [hb]
      exact inAmbient_mem_terminalHom_range _
    · intro u v hu hv
      exact Subgroup.mul_mem _ hu hv
  exact MonoidHom.mem_range.mp hmem

/-! ## The inverse homomorphism

`Monoid.PushoutI.lift` wants a homomorphism on each factor together with a
homomorphism on the amalgamated subgroup that both restrict to.  On `Σ` the
map is `quotHom ∘ sect`; on `B × C₂` it is the noncommutative coproduct of
its restriction with `lampHom`, which is legitimate exactly because of
`quotHom_commute_baseMap`. -/

/-- The amalgamated subgroup `B`, mapped into the terminal quotient. -/
def baseQuotHom : ↥sigmaBase →* TerminalQuotient :=
  (quotHom.comp sect).comp sigmaBase.subtype

/-- The commutation the coproduct needs: `B` and the lamp commute downstairs.
Every element of `sigmaBase` is a level-zero base element, so this is
`quotHom_commute_baseMap`. -/
theorem baseQuotHom_commute_dee (m : ↥sigmaBase) :
    Commute (baseQuotHom m) (quotHom dee) := by
  obtain ⟨γ, hγ⟩ := MonoidHom.mem_range.mp m.2
  have h : baseQuotHom m
      = quotHom (baseMap (LiteralBaseCompleteness.baseAffineEquiv.symm γ)) := by
    show quotHom (sect ((m : SigmaGroup))) = _
    rw [← hγ, sect_iota, affineToMarked_apply]
  rw [h]
  exact quotHom_commute_baseMap _

theorem baseQuotHom_commute_lampHom (m : ↥sigmaBase) (n : FlipC2) :
    Commute (baseQuotHom m) (lampHom n) := by
  cases n
  · exact Commute.one_right _
  · exact baseQuotHom_commute_dee m

/-- The two factor maps of the inverse. -/
def inverseFactorMaps : ∀ b,
    LampFactor SigmaGroup sigmaBase FlipC2 b →* TerminalQuotient
  | true => quotHom.comp sect
  | false => baseQuotHom.noncommCoprod lampHom baseQuotHom_commute_lampHom

set_option backward.isDefEq.respectTransparency false in
theorem inverseFactorMaps_comp :
    ∀ b, (inverseFactorMaps b).comp (lampMap SigmaGroup sigmaBase FlipC2 b)
      = baseQuotHom := by
  intro b
  cases b
  · exact MonoidHom.noncommCoprod_comp_inl baseQuotHom lampHom
      baseQuotHom_commute_lampHom
  · rfl

/-- **The candidate inverse** `Σ *_B (B × C₂) →* (E/⟨w⟩)/(D/⟨w⟩)`. -/
def inverseHom : TerminalAmalgam →* TerminalQuotient :=
  PushoutI.lift inverseFactorMaps baseQuotHom inverseFactorMaps_comp

theorem inverseHom_ambient (v : SigmaGroup) :
    inverseHom (inAmbient SigmaGroup sigmaBase FlipC2 v) = quotHom (sect v) := by
  exact PushoutI.lift_of _ _ _ _

set_option backward.isDefEq.respectTransparency false in
theorem inverseHom_lamp (k : FlipC2) :
    inverseHom (inLamp SigmaGroup sigmaBase FlipC2 k) = lampHom k := by
  rw [inLamp_apply]
  have h : inverseHom (PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2)
        false (((1 : ↥sigmaBase), k) : ↥sigmaBase × FlipC2))
      = inverseFactorMaps false (((1 : ↥sigmaBase), k) : ↥sigmaBase × FlipC2) := by
    exact PushoutI.lift_of _ _ _ _
  rw [h]
  show baseQuotHom (1 : ↥sigmaBase) * lampHom k = lampHom k
  rw [map_one, one_mul]

theorem inverseHom_amalgamStable : inverseHom amalgamStable = quotHom stable := by
  have h := inverseHom_ambient (tVertical alpha conjD_injective)
  rw [sect_t] at h
  exact h

theorem inverseHom_amalgamLampRoot :
    inverseHom amalgamLampRoot = quotHom dee :=
  inverseHom_lamp FlipC2.swap

/-! ## The two composites -/

/-- `terminalHom ∘ inverseHom = id`, checked on the two factors. -/
theorem terminalHom_comp_inverseHom :
    terminalHom.comp inverseHom = MonoidHom.id TerminalAmalgam := by
  apply PushoutI.hom_ext_nonempty
  intro b
  cases b
  · refine MonoidHom.ext fun p => ?_
    show terminalHom (inverseHom
        (PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2) false p))
      = PushoutI.of (φ := lampMap SigmaGroup sigmaBase FlipC2) false p
    rw [amalgam_of_false, map_mul, map_mul, inverseHom_ambient,
      inverseHom_lamp, terminalHom_quotHom, amalgamHom_sect,
      terminalHom_lampHom]
  · refine MonoidHom.ext fun v => ?_
    show terminalHom (inverseHom (inAmbient SigmaGroup sigmaBase FlipC2 v))
      = inAmbient SigmaGroup sigmaBase FlipC2 v
    rw [inverseHom_ambient, terminalHom_quotHom, amalgamHom_sect]

theorem terminalHom_inverseHom (a : TerminalAmalgam) :
    terminalHom (inverseHom a) = a :=
  DFunLike.congr_fun terminalHom_comp_inverseHom a

/-- `inverseHom ∘ amalgamHom = quotHom`, checked on the eight literal
generators. -/
theorem inverseHom_comp_amalgamHom :
    inverseHom.comp amalgamHom = quotHom := by
  refine PresentedGroup.ext ?_
  rintro (i | j)
  · have hgen : (PresentedGroup.of (Sum.inl i : Generator) : MarkedGroup)
        = baseMap (PresentedGroup.of i) := (baseMap_generator i).symm
    have hsect : sect (verticalBaseGenerator i) = baseMap (PresentedGroup.of i) := by
      simp only [verticalBaseGenerator]
      rw [sect_iota, affineToMarked_apply, ← affineQuotient_generator i,
        baseAffineEquiv_symm_affineQuotient]
    have hamb : inverseHom (amalgamBaseGenerator i)
        = quotHom (sect (verticalBaseGenerator i)) := inverseHom_ambient _
    show inverseHom (amalgamHom (PresentedGroup.of (Sum.inl i : Generator)))
      = quotHom (PresentedGroup.of (Sum.inl i : Generator))
    rw [hgen, amalgamHom_baseGenerator, hamb, hsect]
  · fin_cases j
    · show inverseHom (amalgamHom stable) = quotHom stable
      rw [amalgamHom_stable, inverseHom_amalgamStable]
    · have hdl : stable⁻¹ * dee * stable = lamp := by
        rw [dee]
        group
      show inverseHom (amalgamHom lamp) = quotHom lamp
      rw [amalgamHom_lamp]
      show inverseHom (amalgamStable⁻¹ * amalgamLampRoot * amalgamStable)
        = quotHom lamp
      rw [map_mul, map_mul, map_inv, inverseHom_amalgamStable,
        inverseHom_amalgamLampRoot, ← map_inv, ← map_mul, ← map_mul, hdl]

theorem inverseHom_terminalHom (q : TerminalQuotient) :
    inverseHom (terminalHom q) = q := by
  obtain ⟨g, rfl⟩ := quotHom_surjective q
  rw [terminalHom_quotHom]
  exact DFunLike.congr_fun inverseHom_comp_amalgamHom g

/-! ## The identification -/

/-- **The manuscript's presentation calculation, as a theorem.**  The terminal
quotient of the literal group by the printed defect *is* the free-lamp amalgam
`Σ *_B (B × C₂)`, with `terminalHom` the isomorphism. -/
def terminalEquiv : TerminalQuotient ≃* TerminalAmalgam where
  toFun := terminalHom
  invFun := inverseHom
  left_inv := inverseHom_terminalHom
  right_inv := terminalHom_inverseHom
  map_mul' := map_mul terminalHom

theorem terminalEquiv_apply (q : TerminalQuotient) :
    terminalEquiv q = terminalHom q := rfl

theorem terminalHom_injective : Function.Injective terminalHom :=
  Function.LeftInverse.injective inverseHom_terminalHom

theorem terminalHom_bijective : Function.Bijective terminalHom :=
  ⟨terminalHom_injective, terminalHom_surjective⟩

/-! ## The endpoint, with the presentation calculation discharged -/

/-- **The manuscript's exact residual computation, with only the analytic
input left.**  `manuscriptExactRadical_of_terminalIdentification` takes the
identification as a hypothesis; `terminalEquiv` supplies it.  What remains is
operator MF of the symmetric double `Σ *_B Σ`, which is where Shulman's
C⋆-theorem and residual finiteness of `Σ` enter. -/
theorem manuscriptExactRadical_of_symmetricDoubleMF
    (h : IsOperatorMF (SymmetricDouble SigmaGroup sigmaBase)) :
    signFreeCollapseDefect = signFreePrintedDefect ∧
      actualCoronaMFResidual SignFreeQuotient = signFreePrintedDefect ∧
        actualCoronaMFResidual MarkedGroup =
          signFreeCollapseDefect.comap proj :=
  manuscriptExactRadical_of_terminalIdentification terminalEquiv h

end

end TerminalQuotientPresentation
end GroupApproximation
