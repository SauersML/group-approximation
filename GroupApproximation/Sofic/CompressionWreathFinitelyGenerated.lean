import GroupApproximation.Algebra.PermutationalWreathSimple
import GroupApproximation.Sofic.AscendingHNNSplitExtension
import GroupApproximation.Sofic.AscendingHNNWreathWitness

/-!
# Compression wreath products are finitely generated

The four-radical theorem of `Sofic/FourRadicalsCoincide` needs its source group
to be finitely generated: Mal'cev's theorem is what puts the all-fields linear
residual into the chain, and Mal'cev needs finite generation.  This file
supplies that hypothesis for the ascending-HNN compression wreath products.

Both steps are elementary and both are already half-done elsewhere:

* `fg_vertical` — the ascending HNN extension of a finitely generated group is
  finitely generated: the base generators together with the stable letter
  generate, which is exactly
  `MarkedCompressionGroup.vertical_mem_subgroup_of_iota_mem_of_t_mem`.
* `fg_wreathV` — a permutational wreath product over a *transitive* action is
  generated by generators of the acting group together with one-site lamps at a
  single base site.  That is the generic
  `PermutationalWreathSimple.wreath_eq_closure`, and the ascending-HNN coset
  action is transitive by `exists_smul_tSite`.

Nothing here is specific to a lamp group or to approximation theory.
-/

namespace GroupApproximation
namespace MarkedCompression

open SemidirectProduct

universe u

/-! ## The acting group -/

/-- **The vertical group of a finitely generated base is finitely generated.**
The base copy and the stable letter generate the ascending HNN extension. -/
theorem fg_vertical {Γ : Type u} [Group Γ] (α : Γ →* Γ)
    (hα : Function.Injective α) (hΓ : Group.FG Γ) :
    Group.FG (Vertical α hα) := by
  classical
  obtain ⟨S, hS⟩ : (⊤ : Subgroup Γ).FG := hΓ.out
  refine Group.fg_iff.mpr
    ⟨((iotaVertical α hα) '' (S : Set Γ)) ∪ {tVertical α hα}, ?_, ?_⟩
  · refine eq_top_iff.mpr fun v _ => ?_
    refine vertical_mem_subgroup_of_iota_mem_of_t_mem α hα _ ?_ ?_ v
    · intro γ
      have hmem : iotaVertical α hα γ ∈
          Subgroup.closure ((iotaVertical α hα) '' (S : Set Γ)) := by
        rw [← MonoidHom.map_closure, hS]
        exact ⟨γ, Subgroup.mem_top γ, rfl⟩
      exact Subgroup.closure_mono Set.subset_union_left hmem
    · exact Subgroup.subset_closure (Set.mem_union_right _ rfl)
  · exact ((S : Set Γ).toFinite.image _).union (Set.finite_singleton _)

/-! ## The wreath product -/

/-- **The compression wreath product is finitely generated.**  The coset action
of the vertical group on `V/Γ` is transitive, so generators of the vertical
group together with one-site lamps at the witness site generate everything. -/
theorem fg_wreathV {Γ₀ : Type} [Group Γ₀] (β : Γ₀ →* Γ₀)
    (hβ : Function.Injective β) {K₀ : Type} [Group K₀]
    [DecidableEq (Cosets β hβ)] (hΓ : Group.FG Γ₀) (hK : Group.FG K₀) :
    Group.FG (WreathV (K := K₀) β hβ) := by
  classical
  haveI hVfg : Group.FG (Vertical β hβ) := fg_vertical β hβ hΓ
  obtain ⟨SV, hSV⟩ : (⊤ : Subgroup (Vertical β hβ)).FG := hVfg.out
  obtain ⟨SK, hSK⟩ : (⊤ : Subgroup K₀).FG := hK.out
  refine Group.fg_iff.mpr ⟨_,
    wreath_eq_closure (K := K₀) (G := Vertical β hβ) (X := Cosets β hβ)
      (tSite β hβ) (exists_smul_tSite β hβ) hSV hSK, ?_⟩
  exact ((SV : Set (Vertical β hβ)).toFinite.image _).union
    ((SK : Set K₀).toFinite.image _)

end MarkedCompression
end GroupApproximation
