/-- Bounded-depth access to every exact Gram-factor row. -/
def qNumerator (row : Fin 102) : Fin 6 → Fin 22 → ℤ :=
  if h0 : row.1 < 8 then qNumeratorChunk0 ⟨row.1, by lia⟩ else
  if h1 : row.1 < 16 then qNumeratorChunk1 ⟨row.1 - 8, by lia⟩ else
  if h2 : row.1 < 24 then qNumeratorChunk2 ⟨row.1 - 16, by lia⟩ else
  if h3 : row.1 < 32 then qNumeratorChunk3 ⟨row.1 - 24, by lia⟩ else
  if h4 : row.1 < 40 then qNumeratorChunk4 ⟨row.1 - 32, by lia⟩ else
  if h5 : row.1 < 48 then qNumeratorChunk5 ⟨row.1 - 40, by lia⟩ else
  if h6 : row.1 < 56 then qNumeratorChunk6 ⟨row.1 - 48, by lia⟩ else
  if h7 : row.1 < 64 then qNumeratorChunk7 ⟨row.1 - 56, by lia⟩ else
  if h8 : row.1 < 72 then qNumeratorChunk8 ⟨row.1 - 64, by lia⟩ else
  if h9 : row.1 < 80 then qNumeratorChunk9 ⟨row.1 - 72, by lia⟩ else
  if h10 : row.1 < 88 then qNumeratorChunk10 ⟨row.1 - 80, by lia⟩ else
  if h11 : row.1 < 96 then qNumeratorChunk11 ⟨row.1 - 88, by lia⟩ else
  qNumeratorFinal ⟨row.1 - 96, by lia⟩
/-- The exact rational Gram factor `Q_Z / 10^8`. -/
def q : Fin 102 → Fin 6 → RatGroupRing P13 :=
  fun row root ↦ ∑ supportIndex : Fin 22,
    monomial (support supportIndex)
      ((qNumerator row root supportIndex : ℚ) / qDenominator)

/-- Coordinate function of the exact rational Gram factor. -/
def qCoefficient (row : Fin 102) (root : Fin 6) (i : Fin 22) : ℚ :=
  (qNumerator row root i : ℚ) / qDenominator

@[simp] theorem q_eq_coordinateSum (row : Fin 102) (root : Fin 6) :
    q row root = coordinateSum support (qCoefficient row root) := by
  rfl

/-! ## Exact coefficient collection -/

/-- The 293 abstract P13 words which occur after collecting all
`support⁻¹ * support` products. -/
def productClass (i : Fin 293) : P13 :=
  p13Word (productClassFreeWord i)

@[simp] theorem productClass_identity : productClass 201 = 1 := by
  rfl

theorem support_inv_mul_support (i j : Fin 22) :
    (support i)⁻¹ * support j = productClass (productClassIndex i j) := by
  unfold support productClass
  rw [← map_inv, ← map_mul]
  exact supportProduct_replayed i j

/-! ## Coordinate expansions of the differential -/

/-- Exact rational Fox coefficients on the common 22-word support. -/
def boundaryCoefficient (relator : Fin 13) (root : Fin 6)
    (i : Fin 22) : ℚ :=
  boundaryNumerator relator root i

/-- Exact support coefficients of `(g_i - 1)⁺ = g_i⁻¹ - 1`.  In the
stored support order, `6,…,11` are the six inverse generators and `12` is the
identity. -/
def adjointCoboundaryNumerator (root : Fin 6) (i : Fin 22) : ℤ :=
  if i = ⟨6 + root, by lia⟩ then 1 else if i = 12 then -1 else 0

def adjointCoboundaryCoefficient (root : Fin 6) (i : Fin 22) : ℚ :=
  adjointCoboundaryNumerator root i

theorem adjoint_D_eq_coordinateSum (root : Fin 6) :
    adjoint (D root) =
      coordinateSum support (adjointCoboundaryCoefficient root) := by
  classical
  fin_cases root <;>
    simp [D, generatorCoboundary, sub_eq_add_neg,
      adjointCoboundaryCoefficient,
      adjointCoboundaryNumerator,
      coordinateSum, support, p13Generator,
      Fin.sum_univ_succ, MonoidAlgebra.one_def,
      LiteralP13HodgeReplay.p13Word_word_eq_wordValue,
      wordValue, letterValue]

private theorem commute_of_conjugate_eq_self {G : Type*} [Group G]
    (a b : G) (h : a * (b * a⁻¹) = b) : Commute a b := by
  rw [commute_iff_eq]
  calc
    a * b = (a * (b * a⁻¹)) * a := by simp [mul_assoc]
    _ = b * a := by rw [h]

private theorem commute_1_3 :
    Commute (p13Generator 1) (p13Generator 3) :=
  commute_of_conjugate_eq_self _ _ prefixValue30

private theorem commute_0_5 :
    Commute (p13Generator 0) (p13Generator 5) :=
  commute_of_conjugate_eq_self _ _ prefixValue28

private theorem commute_2_4 :
    Commute (p13Generator 2) (p13Generator 4) :=
  commute_of_conjugate_eq_self _ _ prefixValue35

@[simp] private theorem prefixValue74_short :
    p13Generator 0 *
      (p13Generator 3 * ((p13Generator 0)⁻¹ * (p13Generator 1)⁻¹)) =
        p13Generator 3 := by
  rw [← mul_inv_eq_one]
  simpa only [mul_assoc, commute_1_3.inv_inv.eq] using prefixValue74

@[simp] private theorem prefixValue76_short :
    p13Generator 1 *
      (p13Generator 5 * ((p13Generator 1)⁻¹ * (p13Generator 0)⁻¹)) =
        p13Generator 5 := by
  rw [← mul_inv_eq_one]
  simpa only [mul_assoc, commute_0_5.inv_inv.eq] using prefixValue76

@[simp] private theorem prefixValue82_short :
    p13Generator 3 *
      (p13Generator 4 * ((p13Generator 3)⁻¹ * (p13Generator 2)⁻¹)) =
        p13Generator 4 := by
  rw [← mul_inv_eq_one]
  simpa only [mul_assoc, commute_2_4.inv_inv.eq] using prefixValue82

