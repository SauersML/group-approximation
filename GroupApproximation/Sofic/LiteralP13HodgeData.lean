import GroupApproximation.Kazhdan.FiniteSupportHodgeCertificate
import GroupApproximation.Sofic.LiteralP13HodgeReplay

/-!
# Exact concrete data for the P13 Hodge certificate

This module is the Lean-side source of truth for the rational Hodge
certificate whose discovery artifact is
`experiments/sl3-sos-radius0-certificate.npz` (SHA-256
`5b83dc59e55b89a8f48e115e06ce72deaac2bccd5c3f1ded1ead3837c26b021b`).

The generator and relator order are imported from `LiteralP13Presentation`.
The stored matrix model is intentionally absent: every support collision used
below must be supplied through `PresentedGroupRelatorReplay`, hence checked as
a finite product of conjugates of the thirteen abstract relators.

The complete `102 x 132` integer Gram factor is represented below as an exact
`102 x 6 x 22` table.  It is exact data, not a floating-point approximation
and not an assertion of positivity; positivity follows only after Lean checks
the displayed group-ring decomposition and rational residual bounds.
-/

namespace GroupApproximation
namespace LiteralP13HodgeData

open ExactHodgeCertificate FiniteSupportHodgeCertificate FoxBoundary
  LiteralP13HodgeReplay
  LiteralP13Presentation
open scoped BigOperators

noncomputable section

/-- A group-ring basis monomial with an exact rational coefficient. -/
def monomial (g : P13) (q : ℚ) : RatGroupRing P13 :=
  MonoidAlgebra.single g q

/-- The six degree-zero coboundary entries `e_ij - 1`. -/
def D : Fin 6 → RatGroupRing P13 :=
  generatorCoboundary p13Generator

/-! ## Fox matrix

`B` is the `13 x 6` Fox boundary.  Terms are listed by their actual abstract
P13 prefixes; later support canonicalization may replace them only via checked
relator-replay theorems.
-/

def B (relator : Fin 13) : Fin 6 → RatGroupRing P13 :=
  boundary p13Generator (p13RelatorLetters relator)

/-- Every Fox row satisfies the chain identity.  The proof is the formal Fox
telescoping identity followed by the defining presented-group relation. -/
theorem chain (relator : Fin 13) :
    ∑ i : Fin 6, B relator i * D i = 0 := by
  rw [B, D, sum_boundary_mul_coboundary]
  have hrel : wordValue p13Generator (p13RelatorLetters relator) = 1 := by
    change wordValue (fun i ↦ p13Word (FreeGroup.of i))
      (p13RelatorLetters relator) = 1
    rw [wordValue_freeGroup_map p13Word]
    exact PresentedGroup.one_of_mem
      (Finset.mem_coe.mpr (p13Relator_mem relator))
  rw [hrel]
  simp [MonoidAlgebra.one_def]

/-! ## Exact Gram-factor table representation -/

/-- Read one exact integer block as a finite function.  The length equality
is part of the data definition, so no out-of-range default can enter. -/
def integerBlock {n : ℕ} (entries : List ℤ) (h : entries.length = n) :
    Fin n → ℤ :=
  fun i ↦ entries.get (h ▸ i)

/-- Read any exact finite table from a list with a proved length. -/
def finiteTable {A : Type*} {n : ℕ} (entries : List A)
    (h : entries.length = n) : Fin n → A :=
  fun i ↦ entries.get (h ▸ i)

/-- The rational scale of every Gram-factor entry. -/
def qDenominator : ℕ := 100000000

/-! ## The 22 exact abstract support words -/

/-- Radius-zero monomial support in stored order.  These are abstract P13
words; the integral matrices stored in the discovery artifact are not present
in this definition. -/
def support : Fin 22 → P13
  | i => p13Word (supportFreeWord i)

