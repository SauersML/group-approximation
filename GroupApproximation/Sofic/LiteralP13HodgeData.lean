/-- The literal Fox boundary agrees with the canonical coefficient table.
Every nontrivial prefix identification used by this proof is one of the 28
kernel-checked `prefixReplay` theorems. -/
theorem B_eq_coordinateSum (relator : Fin 13) (root : Fin 6) :
    B relator root = coordinateSum support (boundaryCoefficient relator root) := by
  fin_cases relator
  · exact B_eq_coordinateSum_0 root
  · exact B_eq_coordinateSum_1 root
  · exact B_eq_coordinateSum_2 root
  · exact B_eq_coordinateSum_3 root
  · exact B_eq_coordinateSum_4 root
  · exact B_eq_coordinateSum_5 root
  · exact B_eq_coordinateSum_6 root
  · exact B_eq_coordinateSum_7 root
  · exact B_eq_coordinateSum_8 root
  · exact B_eq_coordinateSum_9 root
  · exact B_eq_coordinateSum_10 root
  · exact B_eq_coordinateSum_11 root
  · exact B_eq_coordinateSum_12 root

end

