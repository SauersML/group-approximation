theorem gramNumerator_correct (i k : Fin 6) :
    ∀ c, gramNumerator i k c = computedGramNumerator i k c := by
  fin_cases i <;> fin_cases k <;>
    first
      | exact gramNumerator_correct_0_0
      | exact gramNumerator_correct_0_1
      | exact gramNumerator_correct_0_2
      | exact gramNumerator_correct_0_3
      | exact gramNumerator_correct_0_4
      | exact gramNumerator_correct_0_5
      | exact gramNumerator_correct_1_0
      | exact gramNumerator_correct_1_1
      | exact gramNumerator_correct_1_2
      | exact gramNumerator_correct_1_3
      | exact gramNumerator_correct_1_4
      | exact gramNumerator_correct_1_5
      | exact gramNumerator_correct_2_0
      | exact gramNumerator_correct_2_1
      | exact gramNumerator_correct_2_2
      | exact gramNumerator_correct_2_3
      | exact gramNumerator_correct_2_4
      | exact gramNumerator_correct_2_5
