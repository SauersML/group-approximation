import GroupApproximation.Sofic.SoficAction

/-!
# Finite-orbit windows have exact sofic-action models

Lemmas 13.3 and 13.4 of the ascending-HNN dossier, proved in one step.

A window `(F, E)` whose tested group elements all lie in a single subgroup `H`
with finite orbits admits an orbit-approximation model with **zero**
multiplicativity defect and no bad model points.  The model set is the full
symmetric group of the finite `H`-invariant set generated by `E`; the subgroup
acts on it by left translation through its exact permutation image, extended by
the identity outside `H`; and the chart at a model point `s` is the inverse
permutation `s⁻¹`.

Because the model is built for the *ambient* group directly, letting `H` vary
with the window immediately gives the increasing-union permanence lemma with no
transfer of models between different acting groups.  Applied to the ascending
HNN telescope `N = ⋃ₖ t^{-k} Γ tᵏ`, whose levels are pairwise commensurable and
therefore have finite orbits on `G/Γ`, this is exactly the input needed for the
finite-index coset-action theorem.
-/

namespace GroupApproximation

universe u v

section Orbits

variable {G : Type u} [Group G] {X : Type v} [MulAction G X]

/-- The orbit of a point under a subgroup, as a subset of `X`.  Phrasing it this
way avoids carrying a restricted `MulAction` instance for every subgroup. -/
def subgroupOrbit (H : Subgroup G) (x : X) : Set X := {y | ∃ g ∈ H, g • x = y}

theorem mem_subgroupOrbit_self (H : Subgroup G) (x : X) :
    x ∈ subgroupOrbit H x :=
  ⟨1, H.one_mem, one_smul _ _⟩

theorem smul_mem_subgroupOrbit {H : Subgroup G} {x y : X} {g : G} (hg : g ∈ H)
    (hy : y ∈ subgroupOrbit H x) : g • y ∈ subgroupOrbit H x := by
  obtain ⟨a, ha, rfl⟩ := hy
  exact ⟨g * a, H.mul_mem hg ha, by rw [mul_smul]⟩

theorem subgroupOrbit_top (x : X) :
    subgroupOrbit (⊤ : Subgroup G) x = MulAction.orbit G x := by
  ext y
  constructor
  · rintro ⟨g, -, rfl⟩
    exact MulAction.mem_orbit x g
  · rintro ⟨g, rfl⟩
    exact ⟨g, trivial, rfl⟩

/-- The invariant set generated by a finite window under a subgroup. -/
def orbitClosureOf (H : Subgroup G) (E : Finset X) : Set X :=
  ⋃ x ∈ (E : Set X), subgroupOrbit H x

theorem mem_orbitClosureOf_of_mem {H : Subgroup G} {E : Finset X} {x : X}
    (hx : x ∈ E) : x ∈ orbitClosureOf H E :=
  Set.mem_biUnion (by exact_mod_cast hx) (mem_subgroupOrbit_self H x)

theorem smul_mem_orbitClosureOf {H : Subgroup G} {E : Finset X} {g : G}
    (hg : g ∈ H) {y : X} (hy : y ∈ orbitClosureOf H E) :
    g • y ∈ orbitClosureOf H E := by
  simp only [orbitClosureOf, Set.mem_iUnion, exists_prop] at hy ⊢
  obtain ⟨x, hx, hxy⟩ := hy
  exact ⟨x, hx, smul_mem_subgroupOrbit hg hxy⟩

theorem orbitClosureOf_finite (H : Subgroup G) (E : Finset X)
    (horb : ∀ x : X, (subgroupOrbit H x).Finite) :
    (orbitClosureOf H E).Finite :=
  Set.Finite.biUnion E.finite_toSet fun x _ => horb x

end Orbits

section FiniteOrbits

variable {G : Type u} [Group G] {X : Type v} [MulAction G X]

/-- **A window tested inside a finite-orbit subgroup has an exact model.**

If every element of the tested set `F` lies in a subgroup `H` all of whose
orbits on `X` are finite, then the window `(F, E)` admits an orbit-approximation
model whose multiplicativity defect is zero and all of whose model points are
good. -/
theorem exists_soficActionModel_of_finiteOrbits [DecidableEq X]
    {F : Finset G} {E : Finset X} {ε : ℝ} (hε : 0 < ε)
    {H : Subgroup G} (hFH : ∀ g ∈ F, g ∈ H)
    (horb : ∀ x : X, (subgroupOrbit H x).Finite) :
    Nonempty (SoficActionModel G X F E ε) := by
  classical
  have hYfin : (orbitClosureOf H E).Finite := orbitClosureOf_finite H E horb
  -- The finite invariant window, packaged as a `Finset` for clean instances.
  obtain ⟨Yf, hmem⟩ :
      ∃ Yf : Finset X, ∀ x : X, x ∈ Yf ↔ x ∈ orbitClosureOf H E :=
    ⟨hYfin.toFinset, fun x => hYfin.mem_toFinset⟩
  have hclosed : ∀ g : G, g ∈ H → ∀ y : X, y ∈ Yf → g • y ∈ Yf :=
    fun g hg y hy => (hmem _).2 (smul_mem_orbitClosureOf hg ((hmem _).1 hy))
  have hEsub : ∀ x ∈ E, x ∈ Yf := fun x hx =>
    (hmem x).2 (mem_orbitClosureOf_of_mem hx)
  haveI instFY : Fintype {x : X // x ∈ Yf} := FinsetCoe.fintype Yf
  haveI instDY : DecidableEq {x : X // x ∈ Yf} := Classical.decEq _
  haveI instFP : Fintype (Equiv.Perm {x : X // x ∈ Yf}) :=
    Fintype.ofInjective (fun e : Equiv.Perm {x : X // x ∈ Yf} => (e : _ → _))
      Equiv.coe_fn_injective
  haveI instDP : DecidableEq (Equiv.Perm {x : X // x ∈ Yf}) := Classical.decEq _
  -- The exact permutation representation of `H` on that invariant window.
  let ρ : H →* Equiv.Perm {x : X // x ∈ Yf} :=
    { toFun := fun g =>
        { toFun := fun y => ⟨(g : G) • (y : X), hclosed g g.2 (y : X) y.2⟩
          invFun := fun y => ⟨(g : G)⁻¹ • (y : X),
            hclosed (g : G)⁻¹ (H.inv_mem g.2) (y : X) y.2⟩
          left_inv := fun y => Subtype.ext (by simp)
          right_inv := fun y => Subtype.ext (by simp) }
      map_one' := Equiv.ext fun y => Subtype.ext (by simp)
      map_mul' := fun g h => Equiv.ext fun y => Subtype.ext (by
        simp [Equiv.Perm.mul_apply, mul_smul]) }
  have hρ : ∀ (g : H) (y : {x : X // x ∈ Yf}),
      ((ρ g) y : X) = (g : G) • (y : X) := fun _ _ => rfl
  refine ⟨{
    Site := Equiv.Perm {x : X // x ∈ Yf}
    siteFintype := instFP
    siteDecEq := instDP
    siteNonempty := Fintype.card_pos_iff.mpr ⟨1⟩
    act := fun g => if hg : g ∈ H then Equiv.mulLeft (ρ ⟨g, hg⟩) else 1
    act_one := ?_
    act_mul := ?_
    good := Finset.univ
    good_card := ?_
    Chart := Option {x : X // x ∈ Yf}
    chartFintype := inferInstance
    chart := fun s x => if hx : x ∈ Yf then some (s.symm ⟨x, hx⟩) else none
    chart_inj := ?_
    chart_equivariant := ?_ }⟩
  · -- the model map is unital
    rw [dif_pos H.one_mem]
    refine Equiv.ext fun s => ?_
    have hone : (⟨(1 : G), H.one_mem⟩ : H) = 1 := rfl
    simp [hone, map_one]
  · -- the model map restricts to an exact homomorphism, so the defect vanishes
    intro g hg h hh
    have hgH : g ∈ H := hFH g hg
    have hhH : h ∈ H := hFH h hh
    refine le_of_eq_of_le (permDist_eq_zero_of_eq ?_) hε.le
    rw [dif_pos hgH, dif_pos hhH, dif_pos (H.mul_mem hgH hhH)]
    have hsplit : (⟨g * h, H.mul_mem hgH hhH⟩ : H) = ⟨g, hgH⟩ * ⟨h, hhH⟩ := rfl
    rw [hsplit, map_mul]
    refine Equiv.ext fun s => ?_
    simp only [Equiv.coe_mulLeft, Equiv.Perm.mul_apply, mul_assoc]
  · -- every model point is good
    rw [Finset.card_univ]
    have h0 : (0 : ℝ) ≤ (Fintype.card (Equiv.Perm {x : X // x ∈ Yf}) : ℝ) :=
      Nat.cast_nonneg _
    nlinarith
  · -- charts are inverse permutations, hence injective
    intro s _ x hx y hy h
    rw [dif_pos (hEsub x hx), dif_pos (hEsub y hy)] at h
    exact congrArg Subtype.val (s.symm.injective (Option.some_injective _ h))
  · -- exact orbit covariance
    intro g hg s _ _ x hx hgx
    have hgH : g ∈ H := hFH g hg
    rw [dif_pos (hEsub x hx), dif_pos (hEsub _ hgx), dif_pos hgH]
    refine congrArg some ?_
    have hmul : Equiv.mulLeft (ρ ⟨g, hgH⟩) s = ρ ⟨g, hgH⟩ * s := rfl
    rw [hmul, Equiv.symm_apply_eq, Equiv.Perm.mul_apply, Equiv.apply_symm_apply]
    exact Subtype.ext (by simp [hρ])

/-- **Every action with finite orbits is sofic** (Lemma 13.3), with exact
models. -/
theorem isSoficAction_of_finite_orbits [DecidableEq X]
    (horb : ∀ x : X, (MulAction.orbit G x).Finite) :
    IsSoficAction G X := fun _ _ _ hε =>
  exists_soficActionModel_of_finiteOrbits hε (H := ⊤) (fun _ _ => trivial)
    (fun x => by rw [subgroupOrbit_top]; exact horb x)

/-- **Increasing-union permanence** (Lemma 13.4).  If every finite subset of `G`
lies in a subgroup acting with finite orbits, the whole action is sofic.

In the ascending-HNN application `G` is the telescope `N = ⋃ₖ t^{-k} Γ tᵏ` and
the subgroups are its levels: each level has finite orbits on `G/Γ` because the
levels are pairwise commensurable. -/
theorem isSoficAction_of_locally_finite_orbits [DecidableEq X]
    (h : ∀ F : Finset G, ∃ H : Subgroup G, (∀ g ∈ F, g ∈ H) ∧
      ∀ x : X, (subgroupOrbit H x).Finite) :
    IsSoficAction G X := by
  intro F _ _ hε
  obtain ⟨H, hFH, horb⟩ := h F
  exact exists_soficActionModel_of_finiteOrbits hε hFH horb

end FiniteOrbits

end GroupApproximation
