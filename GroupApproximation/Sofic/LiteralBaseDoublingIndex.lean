import GroupApproximation.Sofic.LiteralBaseTranslationLattice
import GroupApproximation.Sofic.LiteralBaseAffineQuotient

/-!
# The doubled subgroup of the literal base has finite index

The compressing endomorphism of the witness fixes the three rotation letters
and squares the three translations, so its image is generated by `x, y, z`
and the squares `vᵢ²`.  This file shows that subgroup has index at most
eight, the number of parity classes of the translation lattice.

Finiteness of that index is what makes the telescope levels commensurable,
hence what makes each level act with finite orbits on the coset space of lamp
sites -- the hypothesis of the invariant-kernel soficity permanence lemma.
So this file is the arithmetic gate of the sofic witness tower.

The argument is the affine one.  Every base element factors as a translation
times a rotation; every translation is `v₁^a v₂^b v₃^c`; splitting each
exponent into its parity and twice its half puts the element in one of the
eight cosets `v₁^{e₁} v₂^{e₂} v₃^{e₃} · H`.
-/

namespace GroupApproximation
namespace LiteralBaseDoublingIndex

open LiteralBaseRelations LiteralBaseTranslationNormal
  LiteralBaseTranslationLattice

noncomputable section

abbrev Base := LiteralNonMFPresentation.Base

/-! ## The doubled subgroup -/

/-- The image of the compressing endomorphism, spelled inside the base. -/
def doubledBase : Subgroup Base :=
  Subgroup.closure ({x, y, z, v1 ^ 2, v2 ^ 2, v3 ^ 2} : Set Base)

theorem x_mem_doubledBase : x ∈ doubledBase :=
  Subgroup.subset_closure (by simp)

theorem y_mem_doubledBase : y ∈ doubledBase :=
  Subgroup.subset_closure (by simp)

theorem z_mem_doubledBase : z ∈ doubledBase :=
  Subgroup.subset_closure (by simp)

theorem v1sq_mem_doubledBase : v1 ^ 2 ∈ doubledBase :=
  Subgroup.subset_closure (by simp)

theorem v2sq_mem_doubledBase : v2 ^ 2 ∈ doubledBase :=
  Subgroup.subset_closure (by simp)

theorem v3sq_mem_doubledBase : v3 ^ 2 ∈ doubledBase :=
  Subgroup.subset_closure (by simp)

theorem rotations_le_doubledBase : rotations ≤ doubledBase := by
  rw [rotations, Subgroup.closure_le]
  intro g hg
  rcases hg with h | h | h
  · exact h ▸ x_mem_doubledBase
  · exact h ▸ y_mem_doubledBase
  · rw [Set.mem_singleton_iff] at h
    exact h ▸ z_mem_doubledBase

/-! ## Even translations are products of squares -/

/-- A translation with even exponent vector lies in the doubled subgroup. -/
theorem latticeToBase_even_mem (b : Fin 3 → ℤ) :
    latticeToBase (Multiplicative.ofAdd (fun i ↦ 2 * b i)) ∈ doubledBase := by
  have hsplit := lattice_eq_basis_product
    (Multiplicative.ofAdd (fun i ↦ 2 * b i))
  rw [hsplit]
  simp only [map_mul, map_zpow, latticeToBase_basis_zero,
    latticeToBase_basis_one, latticeToBase_basis_two, toAdd_ofAdd]
  have hv1 : v1 ^ (2 : ℤ) ∈ doubledBase := by
    simpa [zpow_two, pow_two] using v1sq_mem_doubledBase
  have hv2 : v2 ^ (2 : ℤ) ∈ doubledBase := by
    simpa [zpow_two, pow_two] using v2sq_mem_doubledBase
  have hv3 : v3 ^ (2 : ℤ) ∈ doubledBase := by
    simpa [zpow_two, pow_two] using v3sq_mem_doubledBase
  refine Subgroup.mul_mem _ (Subgroup.mul_mem _ ?_ ?_) ?_
  · rw [zpow_mul]
    exact Subgroup.zpow_mem _ hv1 _
  · rw [zpow_mul]
    exact Subgroup.zpow_mem _ hv2 _
  · rw [zpow_mul]
    exact Subgroup.zpow_mem _ hv3 _

/-! ## The eight parity cosets -/

/-- The translation attached to an exponent triple. -/
def parityRep (e : Fin 3 → ℤ) : Base :=
  latticeToBase (Multiplicative.ofAdd e)

/-- Splitting an exponent vector into its parity and twice its half. -/
theorem lattice_split (a : Fin 3 → ℤ) :
    latticeToBase (Multiplicative.ofAdd a) =
      parityRep (fun i ↦ a i % 2) *
        latticeToBase (Multiplicative.ofAdd (fun i ↦ 2 * (a i / 2))) := by
  rw [parityRep, ← map_mul, ← ofAdd_add]
  congr 1
  funext i
  show a i = a i % 2 + 2 * (a i / 2)
  lia

/-- Every translation lies in one of the parity cosets. -/
theorem translation_mem_parity_coset {t : Base} (ht : t ∈ translations) :
    ∃ e : Fin 3 → Fin 2, ∃ h ∈ doubledBase,
      t = parityRep (fun i ↦ (e i : ℤ)) * h := by
  have hrange : t ∈ latticeToBase.range := by
    rw [latticeToBase_range]; exact ht
  obtain ⟨a, rfl⟩ := hrange
  refine ⟨fun i ↦ ⟨((Multiplicative.toAdd a) i % 2).toNat, ?_⟩,
    latticeToBase
      (Multiplicative.ofAdd (fun i ↦ 2 * ((Multiplicative.toAdd a) i / 2))),
    latticeToBase_even_mem _, ?_⟩
  · lia
  · have hcast : (fun i ↦ ((⟨((Multiplicative.toAdd a) i % 2).toNat,
        by lia⟩ : Fin 2) : ℤ)) =
      fun i ↦ (Multiplicative.toAdd a) i % 2 := by
      funext i
      show (((Multiplicative.toAdd a) i % 2).toNat : ℤ) =
        (Multiplicative.toAdd a) i % 2
      lia
    rw [hcast]
    have := lattice_split (Multiplicative.toAdd a)
    rwa [ofAdd_toAdd] at this

/-- **Every base element lies in one of the eight parity cosets.** -/
theorem exists_parity_coset (g : Base) :
    ∃ e : Fin 3 → Fin 2, ∃ h ∈ doubledBase,
      g = parityRep (fun i ↦ (e i : ℤ)) * h := by
  obtain ⟨t, ht, r, hr, rfl⟩ := exists_translation_mul_rotation g
  obtain ⟨e, h, hh, hteq⟩ := translation_mem_parity_coset ht
  refine ⟨e, h * r, Subgroup.mul_mem _ hh (rotations_le_doubledBase hr), ?_⟩
  rw [hteq, mul_assoc]

/-! ## Finiteness of the index -/

/-- The parity cosets exhaust the quotient, so it is finite. -/
theorem finite_quotient_doubledBase : Finite (Base ⧸ doubledBase) := by
  apply Finite.of_surjective
    (fun e : Fin 3 → Fin 2 ↦
      (QuotientGroup.mk (parityRep (fun i ↦ (e i : ℤ))) : Base ⧸ doubledBase))
  intro q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
  obtain ⟨e, h, hh, hg⟩ := exists_parity_coset g
  refine ⟨e, ?_⟩
  apply QuotientGroup.eq.mpr
  rw [hg]
  simpa using hh

/-! ## Transport to the affine matrix model

The affine quotient is surjective, so the eight parity cosets cover the
matrix group as well.  The image of the doubled subgroup lands inside the
range of the compressing endomorphism, which therefore also has finite
index -- this is the form the telescope needs. -/

open ExplicitLinearModel LiteralNonMFLinearWitness LiteralBaseAffineQuotient

/-- Evaluation of the six base letters in the affine matrix model. -/
theorem affineQuotient_x : affineQuotient x = xG := by
  simp

theorem affineQuotient_y : affineQuotient y = yG := by
  simp

theorem affineQuotient_z : affineQuotient z = zG := by
  simp

theorem affineQuotient_v1 : affineQuotient v1 = v1G := by
  simp

theorem affineQuotient_v2 : affineQuotient v2 = v2G := by
  simp

theorem affineQuotient_v3 : affineQuotient v3 = v3G := by
  simp

/-- The image of the doubled subgroup sits inside the compressed range. -/
theorem map_doubledBase_le_conjD_range :
    doubledBase.map affineQuotient ≤ (conjD).range := by
  rw [doubledBase, MonoidHom.map_closure, Subgroup.closure_le]
  rintro g ⟨u, hu, rfl⟩
  rcases hu with h | h | h | h | h | h
  · subst h; exact ⟨xG, by rw [conjD_xG, affineQuotient_x]⟩
  · subst h; exact ⟨yG, by rw [conjD_yG, affineQuotient_y]⟩
  · subst h; exact ⟨zG, by rw [conjD_zG, affineQuotient_z]⟩
  · subst h; exact ⟨v1G, by rw [conjD_v1G, map_pow, affineQuotient_v1]⟩
  · subst h; exact ⟨v2G, by rw [conjD_v2G, map_pow, affineQuotient_v2]⟩
  · rw [Set.mem_singleton_iff] at h
    subst h; exact ⟨v3G, by rw [conjD_v3G, map_pow, affineQuotient_v3]⟩

/-- The parity cosets survive the affine quotient. -/
theorem finite_quotient_map_doubledBase :
    Finite (gammaBar ⧸ doubledBase.map affineQuotient) := by
  haveI := finite_quotient_doubledBase
  refine Finite.of_surjective
    (fun q : Base ⧸ doubledBase ↦
      Quotient.map' affineQuotient
        (by
          intro a b hab
          rw [QuotientGroup.leftRel_apply] at hab ⊢
          exact ⟨a⁻¹ * b, hab, by rw [map_mul, map_inv]⟩) q) ?_
  intro q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
  obtain ⟨h, rfl⟩ := affineQuotient_surjective g
  exact ⟨QuotientGroup.mk h, rfl⟩

/-- **The compressed range has finite index in the affine base.**  This is
the arithmetic input to commensurability of the telescope levels. -/
instance conjD_range_finiteIndex : (conjD).range.FiniteIndex := by
  haveI := finite_quotient_map_doubledBase
  have hne : (doubledBase.map affineQuotient).index ≠ 0 :=
    Subgroup.index_ne_zero_of_finite
  have hdvd := Subgroup.index_dvd_of_le map_doubledBase_le_conjD_range
  refine ⟨fun h ↦ hne ?_⟩
  rw [h] at hdvd
  exact Nat.eq_zero_of_zero_dvd hdvd

end

end LiteralBaseDoublingIndex
end GroupApproximation
