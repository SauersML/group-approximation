import GroupApproximation.Sofic.WeakMFNonsoficDouble
import GroupApproximation.Sofic.FreeLampReduction
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.Tactic.DeriveFintype

/-!
# The flip of a symmetric amalgam

This file begins the removal of the finite-flip premise from the weak-MF
nonsofic-double endpoint.  It constructs, entirely from the universal property
of `PushoutI`, the involution exchanging the two vertex groups of
`G *_Γ G`, and packages it as an action of a concrete group of order two.
-/

namespace GroupApproximation

open Monoid

/-! ## A concrete group of order two -/

/-- A dedicated two-element group, used so the flip action has no arithmetic
encoding overhead. -/
inductive FlipC2
  | one
  | swap
  deriving DecidableEq, Fintype

namespace FlipC2

instance : One FlipC2 := ⟨.one⟩

instance : Mul FlipC2 where
  mul
    | .one, x => x
    | .swap, .one => .swap
    | .swap, .swap => .one

instance : Inv FlipC2 := ⟨id⟩

instance : Group FlipC2 where
  mul_assoc a b c := by cases a <;> cases b <;> cases c <;> rfl
  one_mul a := by cases a <;> rfl
  mul_one a := by cases a <;> rfl
  inv_mul_cancel a := by cases a <;> rfl

instance : Nontrivial FlipC2 := ⟨⟨.one, .swap, by decide⟩⟩

@[simp] theorem one_eq : (1 : FlipC2) = .one := rfl
@[simp] theorem inv_eq (a : FlipC2) : a⁻¹ = a := rfl
@[simp] theorem swap_mul_swap : .swap * .swap = (.one : FlipC2) := rfl

end FlipC2

/-! ## The involution of the double -/

variable (G : Type) [Group G] (Γ : Subgroup G)

/-- Factorwise maps which exchange the two copies of `G`. -/
def doubleSwapMaps : ∀ b, DoubleFactor G b →* SymmetricDouble G Γ
  | true => inDouble G Γ false
  | false => inDouble G Γ true

theorem doubleSwapMaps_comp :
    ∀ b, (doubleSwapMaps G Γ b).comp (doubleMap G Γ b)
      = PushoutI.base (doubleMap G Γ) := by
  intro b
  cases b <;> exact PushoutI.of_comp_eq_base _

/-- The endomorphism exchanging the two vertex groups. -/
def doubleSwapHom : SymmetricDouble G Γ →* SymmetricDouble G Γ :=
  PushoutI.lift (doubleSwapMaps G Γ) (PushoutI.base (doubleMap G Γ))
    (doubleSwapMaps_comp G Γ)

@[simp] theorem doubleSwapHom_inDouble (b : Bool) (g : G) :
    doubleSwapHom G Γ (inDouble G Γ b g) = inDouble G Γ (!b) g := by
  cases b <;> exact PushoutI.lift_of _ _ _ _

theorem doubleSwapHom_sq :
    (doubleSwapHom G Γ).comp (doubleSwapHom G Γ) = MonoidHom.id _ := by
  apply PushoutI.hom_ext_nonempty
  intro b
  ext g
  change doubleSwapHom G Γ (doubleSwapHom G Γ (inDouble G Γ b g))
    = inDouble G Γ b g
  rw [doubleSwapHom_inDouble, doubleSwapHom_inDouble]
  cases b <;> rfl

/-- The involutive automorphism which exchanges the two copies of `G`. -/
def doubleSwap : MulAut (SymmetricDouble G Γ) where
  toFun := doubleSwapHom G Γ
  invFun := doubleSwapHom G Γ
  left_inv x := by
    have h := DFunLike.congr_fun (doubleSwapHom_sq G Γ) x
    exact h
  right_inv x := by
    have h := DFunLike.congr_fun (doubleSwapHom_sq G Γ) x
    exact h
  map_mul' := (doubleSwapHom G Γ).map_mul

@[simp] theorem doubleSwap_apply_inDouble (b : Bool) (g : G) :
    doubleSwap G Γ (inDouble G Γ b g) = inDouble G Γ (!b) g :=
  doubleSwapHom_inDouble G Γ b g

@[simp] theorem doubleSwap_sq : doubleSwap G Γ * doubleSwap G Γ = 1 := by
  ext x
  exact DFunLike.congr_fun (doubleSwapHom_sq G Γ) x

/-- The order-two action generated by the swap. -/
def doubleFlipAction : FlipC2 →* MulAut (SymmetricDouble G Γ) where
  toFun
    | .one => 1
    | .swap => doubleSwap G Γ
  map_one' := rfl
  map_mul' a b := by
    cases a <;> cases b <;> simp

@[simp] theorem doubleFlipAction_one : doubleFlipAction G Γ .one = 1 := rfl

@[simp] theorem doubleFlipAction_swap :
    doubleFlipAction G Γ .swap = doubleSwap G Γ := rfl

/-- The semidirect product of the double by its flip. -/
abbrev SymmetricDoubleFlipExtension : Type :=
  SymmetricDouble G Γ ⋊[doubleFlipAction G Γ] FlipC2

/-! ## From the free-lamp presentation to the flip extension -/

@[simp] theorem inDouble_subgroup_eq (γ : Γ) :
    inDouble G Γ true (γ : G) = inDouble G Γ false (γ : G) := by
  calc
    inDouble G Γ true (γ : G) = PushoutI.base (doubleMap G Γ) γ :=
      PushoutI.of_apply_eq_base (doubleMap G Γ) true γ
    _ = inDouble G Γ false (γ : G) :=
      (PushoutI.of_apply_eq_base (doubleMap G Γ) false γ).symm

@[simp] theorem doubleSwap_subgroup (γ : Γ) :
    doubleSwap G Γ (inDouble G Γ true (γ : G))
      = inDouble G Γ true (γ : G) := by
  rw [doubleSwap_apply_inDouble]
  change inDouble G Γ false (γ : G) = inDouble G Γ true (γ : G)
  exact (inDouble_subgroup_eq G Γ γ).symm

@[simp] theorem doubleFlipAction_subgroup_any (k : FlipC2) (b : Bool) (γ : Γ) :
    doubleFlipAction G Γ k (inDouble G Γ b (γ : G))
      = inDouble G Γ b (γ : G) := by
  cases b
  · rw [← inDouble_subgroup_eq]
    cases k <;> simp
  · cases k <;> simp

@[simp] theorem doubleFlipAction_subgroup (k : FlipC2) (γ : Γ) :
    doubleFlipAction G Γ k (inDouble G Γ true (γ : G))
      = inDouble G Γ true (γ : G) := by
  cases k <;> simp

/-- The map from the ambient factor into the flip extension. -/
def ambientToFlip : G →* SymmetricDoubleFlipExtension G Γ :=
  (SemidirectProduct.inl (φ := doubleFlipAction G Γ)).comp
    (inDouble G Γ true)

@[simp] theorem ambientToFlip_apply (g : G) :
    ambientToFlip G Γ g = SemidirectProduct.inl (inDouble G Γ true g) := rfl

/-- The map from `Γ × C₂` into the flip extension. -/
def lampFactorToFlip : Γ × FlipC2 →* SymmetricDoubleFlipExtension G Γ where
  toFun p := SemidirectProduct.inl (inDouble G Γ true (p.1 : G))
    * SemidirectProduct.inr p.2
  map_one' := by
    apply SemidirectProduct.ext <;> simp
  map_mul' a b := by
    apply SemidirectProduct.ext
    · simp [doubleFlipAction_subgroup_any]
    · change a.2 * b.2 = a.2 * b.2
      rfl

@[simp] theorem lampFactorToFlip_apply (p : Γ × FlipC2) :
    lampFactorToFlip G Γ p =
      SemidirectProduct.inl (inDouble G Γ true (p.1 : G))
        * SemidirectProduct.inr p.2 := rfl

/-- The two factor maps defining the free-lamp-to-flip homomorphism. -/
def freeLampToFlipMaps : ∀ b,
    LampFactor G Γ FlipC2 b →* SymmetricDoubleFlipExtension G Γ
  | true => ambientToFlip G Γ
  | false => lampFactorToFlip G Γ

set_option backward.isDefEq.respectTransparency false in
theorem freeLampToFlipMaps_comp :
    ∀ b, (freeLampToFlipMaps G Γ b).comp (lampMap G Γ FlipC2 b)
      = (ambientToFlip G Γ).comp Γ.subtype := by
  intro b
  cases b
  · ext γ <;> simp [freeLampToFlipMaps, lampMap]
  · rfl

/-- The canonical homomorphism
`G *_Γ (Γ × C₂) → (G *_Γ G) ⋊ C₂`. -/
def freeLampToFlip : FreeLamp G Γ FlipC2 →* SymmetricDoubleFlipExtension G Γ :=
  PushoutI.lift (freeLampToFlipMaps G Γ)
    ((ambientToFlip G Γ).comp Γ.subtype) (freeLampToFlipMaps_comp G Γ)

@[simp] theorem freeLampToFlip_inAmbient (g : G) :
    freeLampToFlip G Γ (inAmbient G Γ FlipC2 g)
      = SemidirectProduct.inl (inDouble G Γ true g) := by
  exact PushoutI.lift_of _ _ _ _

set_option backward.isDefEq.respectTransparency false in
@[simp] theorem freeLampToFlip_inLamp (k : FlipC2) :
    freeLampToFlip G Γ (inLamp G Γ FlipC2 k)
      = SemidirectProduct.inr k := by
  rw [inLamp_apply]
  calc
    freeLampToFlip G Γ (PushoutI.of false ((1 : Γ), k))
        = lampFactorToFlip G Γ ((1 : Γ), k) := by
          exact PushoutI.lift_of _ _ _ _
    _ = SemidirectProduct.inr k := by
      apply SemidirectProduct.ext <;> simp [lampFactorToFlip]

/-! ## From the flip extension back to the free-lamp presentation -/

/-- The lamp element implementing the flip in the free-lamp amalgam. -/
abbrev flipLamp : FreeLamp G Γ FlipC2 := inLamp G Γ FlipC2 .swap

@[simp] theorem flipLamp_sq : flipLamp G Γ * flipLamp G Γ = 1 := by
  calc
    flipLamp G Γ * flipLamp G Γ
        = inLamp G Γ FlipC2 (.swap * .swap) :=
          ((inLamp G Γ FlipC2).map_mul .swap .swap).symm
    _ = inLamp G Γ FlipC2 .one := rfl
    _ = 1 := (inLamp G Γ FlipC2).map_one

@[simp] theorem flipLamp_inv : (flipLamp G Γ)⁻¹ = flipLamp G Γ := by
  calc
    (flipLamp G Γ)⁻¹ = (flipLamp G Γ)⁻¹ * 1 := (mul_one _).symm
    _ = (flipLamp G Γ)⁻¹ * (flipLamp G Γ * flipLamp G Γ) := by
      rw [flipLamp_sq]
    _ = flipLamp G Γ := by simp

/-- The two vertex maps from the symmetric double into the free-lamp group.
The second copy is the conjugate of the first by the order-two lamp. -/
def doubleToFreeLampMaps : ∀ b, DoubleFactor G b →* FreeLamp G Γ FlipC2
  | true => inAmbient G Γ FlipC2
  | false => (MulAut.conj (flipLamp G Γ)).toMonoidHom.comp
      (inAmbient G Γ FlipC2)

set_option backward.isDefEq.respectTransparency false in
theorem doubleToFreeLampMaps_comp :
    ∀ b, (doubleToFreeLampMaps G Γ b).comp (doubleMap G Γ b)
      = (inAmbient G Γ FlipC2).comp Γ.subtype := by
  intro b
  cases b
  · ext γ
    change flipLamp G Γ * inAmbient G Γ FlipC2 (γ : G) * (flipLamp G Γ)⁻¹
      = inAmbient G Γ FlipC2 (γ : G)
    exact (inLamp_commute_inAmbient G Γ FlipC2 .swap γ.property).mul_inv_cancel
  · rfl

/-- The canonical map from the symmetric double to the free-lamp amalgam. -/
def doubleToFreeLamp : SymmetricDouble G Γ →* FreeLamp G Γ FlipC2 :=
  PushoutI.lift (doubleToFreeLampMaps G Γ)
    ((inAmbient G Γ FlipC2).comp Γ.subtype) (doubleToFreeLampMaps_comp G Γ)

@[simp] theorem doubleToFreeLamp_inDouble_true (g : G) :
    doubleToFreeLamp G Γ (inDouble G Γ true g) = inAmbient G Γ FlipC2 g := by
  exact PushoutI.lift_of _ _ _ _

@[simp] theorem doubleToFreeLamp_inDouble_false (g : G) :
    doubleToFreeLamp G Γ (inDouble G Γ false g)
      = flipLamp G Γ * inAmbient G Γ FlipC2 g * (flipLamp G Γ)⁻¹ := by
  exact PushoutI.lift_of _ _ _ _

/-- Conjugating the image of the double by the flip lamp exchanges its two
vertex groups. -/
theorem doubleToFreeLamp_swap_equivariant :
    (doubleToFreeLamp G Γ).comp (doubleSwap G Γ).toMonoidHom
      = (MulAut.conj (flipLamp G Γ)).toMonoidHom.comp (doubleToFreeLamp G Γ) := by
  apply PushoutI.hom_ext_nonempty
  intro b
  ext g
  cases b
  · change inAmbient G Γ FlipC2 g =
      flipLamp G Γ * (flipLamp G Γ * inAmbient G Γ FlipC2 g
        * (flipLamp G Γ)⁻¹) * (flipLamp G Γ)⁻¹
    rw [flipLamp_inv]
    simp only [← mul_assoc, flipLamp_sq, one_mul]
    rw [mul_assoc, flipLamp_sq, mul_one]
  · rfl

/-- Equivariance for the whole order-two action. -/
theorem doubleToFreeLamp_flip_equivariant (k : FlipC2) :
    (doubleToFreeLamp G Γ).comp (doubleFlipAction G Γ k).toMonoidHom
      = (MulAut.conj (inLamp G Γ FlipC2 k)).toMonoidHom.comp
          (doubleToFreeLamp G Γ) := by
  cases k
  · have hk : inLamp G Γ FlipC2 .one = 1 := (inLamp G Γ FlipC2).map_one
    rw [hk]
    ext x
    simp
  · exact doubleToFreeLamp_swap_equivariant G Γ

/-- The homomorphism inverse to `freeLampToFlip`. -/
def flipToFreeLamp : SymmetricDoubleFlipExtension G Γ →* FreeLamp G Γ FlipC2 :=
  SemidirectProduct.lift (doubleToFreeLamp G Γ) (inLamp G Γ FlipC2)
    (doubleToFreeLamp_flip_equivariant G Γ)

@[simp] theorem flipToFreeLamp_inl (d : SymmetricDouble G Γ) :
    flipToFreeLamp G Γ (SemidirectProduct.inl d) = doubleToFreeLamp G Γ d := by
  exact SemidirectProduct.lift_inl _ _ _ _

@[simp] theorem flipToFreeLamp_inr (k : FlipC2) :
    flipToFreeLamp G Γ (SemidirectProduct.inr k) = inLamp G Γ FlipC2 k := by
  exact SemidirectProduct.lift_inr _ _ _ _

/-! ## The presentation isomorphism -/

set_option backward.isDefEq.respectTransparency false in
theorem inAmbient_subgroup_eq_false (γ : Γ) :
    inAmbient G Γ FlipC2 (γ : G)
      = PushoutI.of (φ := lampMap G Γ FlipC2) false ((γ, (1 : FlipC2))) := by
  calc
    inAmbient G Γ FlipC2 (γ : G)
        = PushoutI.base (lampMap G Γ FlipC2) γ :=
          PushoutI.of_apply_eq_base (lampMap G Γ FlipC2) true γ
    _ = PushoutI.of (φ := lampMap G Γ FlipC2) false ((γ, (1 : FlipC2))) :=
      (PushoutI.of_apply_eq_base (lampMap G Γ FlipC2) false γ).symm

set_option backward.isDefEq.respectTransparency false in
theorem of_false_eq_inAmbient_mul_inLamp (γ : Γ) (k : FlipC2) :
    PushoutI.of (φ := lampMap G Γ FlipC2) false ((γ, k))
      = inAmbient G Γ FlipC2 (γ : G) * inLamp G Γ FlipC2 k := by
  rw [inLamp_apply, inAmbient_subgroup_eq_false]
  cases k
  · convert (PushoutI.of (φ := lampMap G Γ FlipC2) false).map_mul
      (γ, 1) (1, FlipC2.one) using 1
    simp
    rfl
  · convert (PushoutI.of (φ := lampMap G Γ FlipC2) false).map_mul
      (γ, 1) (1, FlipC2.swap) using 1
    simp
    rfl

set_option backward.isDefEq.respectTransparency false in
theorem freeLampToFlip_comp_doubleToFreeLamp :
    (freeLampToFlip G Γ).comp (doubleToFreeLamp G Γ)
      = SemidirectProduct.inl := by
  apply PushoutI.hom_ext_nonempty
  intro b
  apply MonoidHom.ext
  intro g
  cases b
  · change freeLampToFlip G Γ
        (flipLamp G Γ * inAmbient G Γ FlipC2 g * (flipLamp G Γ)⁻¹)
      = SemidirectProduct.inl (inDouble G Γ false g)
    rw [map_mul, map_mul, map_inv, freeLampToFlip_inLamp, freeLampToFlip_inAmbient]
    exact (SemidirectProduct.inl_aut (.swap : FlipC2) (inDouble G Γ true g)).symm
  · change freeLampToFlip G Γ (inAmbient G Γ FlipC2 g)
      = SemidirectProduct.inl (inDouble G Γ true g)
    exact freeLampToFlip_inAmbient G Γ g

@[simp] theorem freeLampToFlip_doubleToFreeLamp (d : SymmetricDouble G Γ) :
    freeLampToFlip G Γ (doubleToFreeLamp G Γ d) = SemidirectProduct.inl d := by
  exact DFunLike.congr_fun (freeLampToFlip_comp_doubleToFreeLamp G Γ) d

theorem freeLampToFlip_comp_flipToFreeLamp :
    (freeLampToFlip G Γ).comp (flipToFreeLamp G Γ) = MonoidHom.id _ := by
  apply SemidirectProduct.hom_ext
  · apply MonoidHom.ext
    intro d
    simpa only [MonoidHom.comp_apply, MonoidHom.id_apply, flipToFreeLamp_inl] using
      freeLampToFlip_doubleToFreeLamp G Γ d
  · apply MonoidHom.ext
    intro k
    simpa only [MonoidHom.comp_apply, MonoidHom.id_apply, flipToFreeLamp_inr] using
      freeLampToFlip_inLamp G Γ k

set_option backward.isDefEq.respectTransparency false in
theorem flipToFreeLamp_comp_freeLampToFlip :
    (flipToFreeLamp G Γ).comp (freeLampToFlip G Γ) = MonoidHom.id _ := by
  apply PushoutI.hom_ext_nonempty
  intro b
  apply MonoidHom.ext
  intro x
  change flipToFreeLamp G Γ
      (freeLampToFlip G Γ (PushoutI.of b x)) = PushoutI.of b x
  cases b
  · rcases x with ⟨γ, k⟩
    rw [of_false_eq_inAmbient_mul_inLamp, map_mul, map_mul]
    rw [freeLampToFlip_inAmbient, flipToFreeLamp_inl, doubleToFreeLamp_inDouble_true,
      freeLampToFlip_inLamp, flipToFreeLamp_inr]
  · change flipToFreeLamp G Γ
        (freeLampToFlip G Γ (inAmbient G Γ FlipC2 x))
      = inAmbient G Γ FlipC2 x
    rw [freeLampToFlip_inAmbient, flipToFreeLamp_inl, doubleToFreeLamp_inDouble_true]

/-- **Free-lamp/flip isomorphism.**  For every subgroup `Γ ≤ G`,

`G *_Γ (Γ × C₂) ≅ (G *_Γ G) ⋊ C₂`,

where the nontrivial element of `C₂` exchanges the two vertex groups. -/
def freeLampMulEquivSymmetricDoubleFlip :
    FreeLamp G Γ FlipC2 ≃* SymmetricDoubleFlipExtension G Γ where
  toFun := freeLampToFlip G Γ
  invFun := flipToFreeLamp G Γ
  left_inv x := DFunLike.congr_fun (flipToFreeLamp_comp_freeLampToFlip G Γ) x
  right_inv x := DFunLike.congr_fun (freeLampToFlip_comp_flipToFreeLamp G Γ) x
  map_mul' := (freeLampToFlip G Γ).map_mul

end GroupApproximation
