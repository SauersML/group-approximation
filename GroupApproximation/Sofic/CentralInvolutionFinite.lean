import GroupApproximation.Sofic.LocallyFiniteMF
import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.GroupTheory.QuotientGroup.Finite
import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Finiteness of Clifford-type subgroups

The lamp groups of this development are generated by involutions any two of
which commute *up to* one fixed central involution `z`.  This file proves that
such a generating set, when finite, generates a finite subgroup, and derives
the local finiteness of the whole group when the generating set is not finite.

The argument avoids any normal form.  Modulo the central subgroup `⟨z⟩` the
generators commute honestly, so their image is an abelian group generated by
finitely many involutions -- finitely generated and torsion, hence finite by
`CommGroup.finite_of_fg_torsion`.  The kernel of the reduction is contained in
`⟨z⟩`, which has at most two elements.  A group with a finite normal subgroup
and a finite quotient is finite.

Nothing here mentions Clifford algebras: the input is exactly the relation
pattern `a² = 1`, `[a,b] ∈ ⟨z⟩`, `z` central.
-/

namespace GroupApproximation

universe u

variable {G : Type u} [Group G]

/-! ## Finitely many honestly commuting involutions -/

/-- A finite set of pairwise commuting involutions generates a finite
subgroup: the subgroup is abelian, finitely generated and of exponent two. -/
theorem finite_closure_of_commuting_involutions {s : Set G} (hfin : s.Finite)
    (hsq : ∀ a ∈ s, a ^ 2 = 1)
    (hcomm : ∀ a ∈ s, ∀ b ∈ s, a * b = b * a) :
    Finite (Subgroup.closure s) := by
  haveI : IsMulCommutative (Subgroup.closure s) :=
    Subgroup.isMulCommutative_closure hcomm
  letI : CommGroup (Subgroup.closure s) :=
    { (inferInstance : Group (Subgroup.closure s)) with mul_comm := mul_comm' }
  haveI : Group.FG (Subgroup.closure s) :=
    (Group.fg_iff_subgroup_fg _).mpr ((Subgroup.fg_iff _).mpr ⟨s, rfl, hfin⟩)
  have hgen : Subgroup.closure ((Subgroup.closure s).subtype ⁻¹' s) = ⊤ :=
    Subgroup.closure_preimage_eq_top s
  have hsq2 : ∀ x : (Subgroup.closure s), x ^ 2 = 1 := by
    intro x
    have hx : x ∈ (⊤ : Subgroup (Subgroup.closure s)) := Subgroup.mem_top x
    rw [← hgen] at hx
    induction hx using Subgroup.closure_induction with
    | mem y hy =>
        apply Subtype.ext
        simpa only [Subgroup.coe_pow, Subgroup.coe_one] using hsq (y : G) hy
    | one => exact one_pow 2
    | mul a b _ _ ha hb => rw [mul_pow, ha, hb, mul_one]
    | inv a _ ha => rw [inv_pow, ha, inv_one]
  exact CommGroup.finite_of_fg_torsion _
    (fun x ↦ isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, hsq2 x⟩)

/-! ## The central involution -/

section Central

variable (z : G)

/-- With `z` an involution, its cyclic subgroup has at most the two elements
`1` and `z`. -/
theorem zpowers_subset_pair (hz : z ^ 2 = 1) :
    (Subgroup.zpowers z : Set G) ⊆ {1, z} := by
  have h2 : z ^ (2 : ℤ) = 1 := by
    rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) by norm_num, zpow_natCast]
    exact hz
  rintro g ⟨n, hn⟩
  have hgn : z ^ n = g := hn
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  rcases Int.even_or_odd n with ⟨k, hk⟩ | ⟨k, hk⟩
  · left
    rw [← hgn, show n = 2 * k by omega, zpow_mul, h2, one_zpow]
  · right
    rw [← hgn, show n = 2 * k + 1 by omega, zpow_add, zpow_mul, h2, one_zpow,
      one_mul, zpow_one]

theorem finite_zpowers_of_sq (hz : z ^ 2 = 1) : Finite (Subgroup.zpowers z) :=
  Set.Finite.to_subtype
    (Set.Finite.subset (Set.toFinite ({1, z} : Set G)) (zpowers_subset_pair z hz))

/-- A central involution generates a normal subgroup. -/
theorem zpowers_normal_of_central (hzc : ∀ g : G, Commute z g) :
    (Subgroup.zpowers z).Normal := by
  refine ⟨fun n hn g ↦ ?_⟩
  obtain ⟨k, hk⟩ := hn
  have hkn : z ^ k = n := hk
  have hcom : Commute (z ^ k) g := (hzc g).zpow_left k
  have hfix : g * n * g⁻¹ = n := by
    rw [← hkn, ← hcom.eq, mul_assoc, mul_inv_cancel, mul_one]
  rw [hfix]
  exact ⟨k, hkn⟩

end Central

/-- **The Clifford finiteness pattern.**  A finite set of involutions any two
of which commute up to a fixed central involution `z` generates, together with
`z`, a finite subgroup. -/
theorem finite_closure_of_central_involution {z : G} (hz : z ^ 2 = 1)
    (hzc : ∀ g : G, Commute z g) {s : Set G} (hfin : s.Finite)
    (hsq : ∀ a ∈ s, a ^ 2 = 1)
    (hcomm : ∀ a ∈ s, ∀ b ∈ s, a * b * a⁻¹ * b⁻¹ ∈ Subgroup.zpowers z) :
    Finite (Subgroup.closure (insert z s)) := by
  classical
  set Z : Subgroup G := Subgroup.zpowers z with hZ
  haveI : Z.Normal := zpowers_normal_of_central z hzc
  haveI : Finite Z := finite_zpowers_of_sq z hz
  set H : Subgroup G := Subgroup.closure (insert z s) with hH
  set pi : G →* G ⧸ Z := QuotientGroup.mk' Z with hpi
  -- The image of the generators in the central quotient: honest involutions
  -- that honestly commute.
  have hpi_sq : ∀ a ∈ pi '' s, a ^ 2 = 1 := by
    rintro _ ⟨a, ha, rfl⟩
    rw [← map_pow, hsq a ha, map_one]
  have hpi_comm : ∀ a ∈ pi '' s, ∀ b ∈ pi '' s, a * b = b * a := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩
    have hker : pi (a * b * a⁻¹ * b⁻¹) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr (hcomm a ha b hb)
    simp only [map_mul, map_inv] at hker
    exact mul_inv_eq_one.mp (by
      rw [mul_inv_rev]
      simpa only [mul_assoc] using hker)
  haveI hfinImage : Finite (Subgroup.closure (pi '' s)) :=
    finite_closure_of_commuting_involutions (hfin.image _) hpi_sq hpi_comm
  -- The image of `H` is that finite subgroup.
  have hmap : Subgroup.map pi H = Subgroup.closure (pi '' s) := by
    rw [hH, MonoidHom.map_closure, Set.image_insert_eq,
      show pi z = 1 from (QuotientGroup.eq_one_iff _).mpr (Subgroup.mem_zpowers z),
      Subgroup.closure_insert_one]
  -- Reduce `H` itself along `pi`.
  set f : H →* G ⧸ Z := pi.comp H.subtype with hf
  have hrange : f.range = Subgroup.map pi H := by
    ext x
    constructor
    · rintro ⟨⟨y, hy⟩, rfl⟩
      exact ⟨y, hy, rfl⟩
    · rintro ⟨y, hy, rfl⟩
      exact ⟨⟨y, hy⟩, rfl⟩
  haveI : Finite f.range := by rw [hrange, hmap]; exact hfinImage
  haveI : Finite f.ker := by
    have hmapker : ∀ x : f.ker, ((x : H) : G) ∈ Z := fun x ↦
      (QuotientGroup.eq_one_iff _).mp (MonoidHom.mem_ker.mp x.2)
    have hinj : Function.Injective
        (fun x : f.ker ↦ (⟨((x : H) : G), hmapker x⟩ : Z)) := by
      intro a b hab
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun w : Z ↦ (w : G)) hab
    exact Finite.of_injective _ hinj
  haveI : Finite (H ⧸ f.ker) :=
    Finite.of_equiv _ (QuotientGroup.quotientKerEquivRange f).symm.toEquiv
  exact Finite.of_subgroup_quotient f.ker

/-! ## From finite generating pieces to local finiteness -/

/-- Every element of a subgroup closure already lies in the closure of a
finite part of the generating set. -/
theorem exists_finite_subset_mem_closure {T : Set G} {g : G}
    (hg : g ∈ Subgroup.closure T) :
    ∃ T' : Set G, T' ⊆ T ∧ T'.Finite ∧ g ∈ Subgroup.closure T' := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
      exact ⟨{x}, Set.singleton_subset_iff.mpr hx, Set.finite_singleton x,
        Subgroup.subset_closure rfl⟩
  | one => exact ⟨∅, Set.empty_subset _, Set.finite_empty, Subgroup.one_mem _⟩
  | mul a b _ _ ha hb =>
      obtain ⟨A, hAT, hAfin, hA⟩ := ha
      obtain ⟨B, hBT, hBfin, hB⟩ := hb
      refine ⟨A ∪ B, Set.union_subset hAT hBT, hAfin.union hBfin,
        Subgroup.mul_mem _ ?_ ?_⟩
      · exact Subgroup.closure_mono Set.subset_union_left hA
      · exact Subgroup.closure_mono Set.subset_union_right hB
  | inv a _ ha =>
      obtain ⟨A, hAT, hAfin, hA⟩ := ha
      exact ⟨A, hAT, hAfin, Subgroup.inv_mem _ hA⟩

/-- **The Clifford local-finiteness pattern.**  The subgroup generated by a
central involution `z` together with any family of involutions that pairwise
commute modulo `z` is locally finite: a finite window uses only finitely many
of the generators, and those already generate a finite subgroup. -/
theorem isLocallyFiniteGroup_closure_of_central_involution {z : G}
    (hz : z ^ 2 = 1) (hzc : ∀ g : G, Commute z g) {T : Set G}
    (hsq : ∀ a ∈ T, a ^ 2 = 1)
    (hcomm : ∀ a ∈ T, ∀ b ∈ T, a * b * a⁻¹ * b⁻¹ ∈ Subgroup.zpowers z) :
    IsLocallyFiniteGroup (Subgroup.closure (insert z T)) := by
  classical
  set H : Subgroup G := Subgroup.closure (insert z T) with hH
  intro F
  have hmem : ∀ g : H, ∃ T' : Set G, T' ⊆ insert z T ∧ T'.Finite ∧
      (g : G) ∈ Subgroup.closure T' :=
    fun g ↦ exists_finite_subset_mem_closure g.2
  choose part hpart hpartFin hpartMem using hmem
  set U : Set G := ⋃ g ∈ (F : Set H), part g with hU
  have hUfin : U.Finite :=
    Set.Finite.biUnion F.finite_toSet (fun g _ ↦ hpartFin g)
  have hUsub : U ⊆ insert z T := by
    simp only [hU, Set.iUnion_subset_iff]
    exact fun g _ ↦ hpart g
  -- Drop `z` from the collected part; the finiteness theorem reinstates it.
  set V : Set G := U \ {z} with hV
  have hVfin : V.Finite := hUfin.subset Set.sdiff_subset
  have hVT : V ⊆ T := by
    intro a ha
    rcases hUsub ha.1 with h | h
    · exact absurd h ha.2
    · exact h
  haveI : Finite (Subgroup.closure (insert z V)) :=
    finite_closure_of_central_involution hz hzc hVfin
      (fun a ha ↦ hsq a (hVT ha)) (fun a ha b hb ↦ hcomm a (hVT ha) b (hVT hb))
  refine ⟨(Subgroup.closure (insert z V)).subgroupOf H, ?_, fun g hg ↦ ?_⟩
  · refine Finite.of_injective
      (fun x : (Subgroup.closure (insert z V)).subgroupOf H ↦
        (⟨((x : H) : G), x.2⟩ : Subgroup.closure (insert z V))) ?_
    intro a b hab
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun w : Subgroup.closure (insert z V) ↦ (w : G)) hab
  · show (g : G) ∈ Subgroup.closure (insert z V)
    refine Subgroup.closure_mono ?_ (hpartMem g)
    intro a ha
    by_cases haz : a = z
    · exact Or.inl haz
    · exact Or.inr ⟨Set.mem_biUnion (Finset.mem_coe.mpr hg) ha, haz⟩

/-- The ambient form: a group generated by a central involution together with
involutions commuting modulo it is locally finite. -/
theorem isLocallyFiniteGroup_of_central_involution {z : G}
    (hz : z ^ 2 = 1) (hzc : ∀ g : G, Commute z g) {T : Set G}
    (hgen : Subgroup.closure (insert z T) = ⊤)
    (hsq : ∀ a ∈ T, a ^ 2 = 1)
    (hcomm : ∀ a ∈ T, ∀ b ∈ T, a * b * a⁻¹ * b⁻¹ ∈ Subgroup.zpowers z) :
    IsLocallyFiniteGroup G := by
  have h := isLocallyFiniteGroup_closure_of_central_involution hz hzc hsq hcomm
  rw [hgen] at h
  exact h.comap (Subgroup.topEquiv (G := G)).symm.toMonoidHom
    (Subgroup.topEquiv (G := G)).symm.injective

end GroupApproximation
