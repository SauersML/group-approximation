import GroupApproximation.Kazhdan.KazhdanUniverse
import GroupApproximation.Leavitt.GeneralCornerTheorem
import GroupApproximation.Sofic.ManuscriptKazhdanTransport
import GroupApproximation.Sofic.Type0Transfer

/-!
# `thm:kazhdan-transport` for groups in any universe

The printed statement opens

> Let `Γ` and `H` be groups, let `Γ` have property (T), let `ι : Γ → H` be a
> homomorphism, let `s ∈ H` …

with **no countability hypothesis on either group**.  The formalized statement
`KazhdanAsymptoticCommutant.manuscriptKazhdanTransport` fixed both at `Type 0`,
and the proof ledger recorded that as `univ0` — correctly, since a `Type 0`
statement is strictly narrower than the printed one.

`H` was freed by giving the transport chain a universe-polymorphic ambient group.
`Γ` cannot be freed the same way: property `(T)` for `Γ` is spelled
`HasKazhdanPropertyTComplex.{v, …} Γ` and appears, at `Type 0`, in 249 places
across the development.  It does not need to be: **property `(T)` implies
countability**, because it supplies a finite generating set, so a Kazhdan group
in any universe is isomorphic to one in `Type 0` *that still has property (T)*.
That is the content of this file, and it is why the closure is not a weakening —
the countability the print does not grant is not assumed, it is derived.

## The three steps

* `IsKazhdanPairComplex.mulEquiv` / `HasKazhdanPropertyTComplex.mulEquiv` move
  property `(T)` across a group isomorphism.  This changes the universe of the
  **group** and leaves the representation universe alone, which is the free
  direction: pull a representation back along the isomorphism and push the
  invariant vector forward.  `Kazhdan/KazhdanUniverse.lean` already had the
  other direction, moving the representation universe.
* `countable_of_hasKazhdanPropertyTComplex` is property `(T)` ⇒ countable, via
  the real form and `KazhdanFiniteGeneration`.  The `Type 0` case is
  `Leavitt.GeneralCornerTheorem.countable_of_hasKazhdanPropertyT`; this is the
  complex form at every universe.
* `manuscriptKazhdanTransport_anyUniverse` is the theorem itself, with both
  groups at arbitrary universes and no hypothesis the print does not state.
-/

namespace GroupApproximation

open Matrix
open scoped Matrix.Norms.L2Operator

universe u u' v w

/-! ## Property `(T)` along a group isomorphism -/

/-- A complex Kazhdan pair transports along a group isomorphism, with the
control set carried across and the tolerance unchanged.  The representation
universe is untouched. -/
theorem IsKazhdanPairComplex.mulEquiv {G : Type u} {G' : Type u'}
    [Group G] [Group G'] (e : G ≃* G') {Q : Finset G} {ε : ℝ}
    (h : IsKazhdanPairComplex.{u, v} G Q ε) :
    IsKazhdanPairComplex.{u', v} G' (Q.map e.toEquiv.toEmbedding) ε := by
  refine ⟨h.1, ?_⟩
  intro E _ _ _ ρ x hx hnear
  have hnear' : ∀ q ∈ Q, ‖(ρ.comp e.toMonoidHom) q x - x‖ < ε := by
    intro q hq
    have hmem : e q ∈ Q.map e.toEquiv.toEmbedding :=
      Finset.mem_map_of_mem _ hq
    exact hnear (e q) hmem
  obtain ⟨y, hy0, hy⟩ := h.2 E (ρ.comp e.toMonoidHom) x hx hnear'
  refine ⟨y, hy0, fun g' ↦ ?_⟩
  have hg := hy (e.symm g')
  have hcomp : (ρ.comp e.toMonoidHom) (e.symm g') = ρ g' := by
    show ρ (e (e.symm g')) = ρ g'
    rw [e.apply_symm_apply]
  rw [hcomp] at hg
  exact hg

/-- **Property `(T)` transports along a group isomorphism.**  This is what turns
"the theorem is stated for `Type 0` groups" into "the theorem applies to a
Kazhdan group at any universe", once countability supplies the model. -/
theorem HasKazhdanPropertyTComplex.mulEquiv {G : Type u} {G' : Type u'}
    [Group G] [Group G'] (e : G ≃* G')
    (h : HasKazhdanPropertyTComplex.{u, v} G) :
    HasKazhdanPropertyTComplex.{u', v} G' := by
  obtain ⟨Q, ε, hQ⟩ := h
  exact ⟨Q.map e.toEquiv.toEmbedding, ε, hQ.mulEquiv e⟩

/-! ## Property `(T)` forces countability -/

/-- **A Kazhdan group is countable.**  Property `(T)` supplies a finite
symmetric generating set, and a group generated by a finite set is countable.

This is what makes the transfer legitimate rather than a weakening: the printed
statement grants no countability hypothesis, and none is assumed, because
property `(T)` already implies it. -/
theorem countable_of_hasKazhdanPropertyTComplex {G : Type u} [Group G]
    (h : HasKazhdanPropertyTComplex.{u, max u v} G) : Countable G := by
  have hreal : HasKazhdanPropertyT.{u, u} G :=
    (hasKazhdanPropertyT_iff_textbook.{u, v}).mpr h
  obtain ⟨S, -, -, hS⟩ :=
    KazhdanFiniteGeneration.exists_symmetric_generating_finset G hreal
  exact GeneralCornerTheorem.countable_of_closure_finset_eq_top hS


/-- **A compression core's source is automatically countable.**  Its `kazhdan`
field is property `(T)`, which supplies a finite generating set, so the `Type 0`
model of the source always exists and no countability hypothesis is owed of it.
This is the compression-datum analogue of
`countable_of_hasKazhdanPropertyTComplex`, and it is what a universe descent for
the Kazhdan source of that weighted transport theorem consumes. -/
theorem KazhdanCompressionCore.countable_source {Γ : Type v} [Group Γ]
    {E : Type u} [Group E] (C : KazhdanCompressionCore Γ E) : Countable Γ := by
  obtain ⟨S, -, -, hS⟩ :=
    KazhdanFiniteGeneration.exists_symmetric_generating_finset Γ C.kazhdan
  exact GeneralCornerTheorem.countable_of_closure_finset_eq_top hS

/-! ## The theorem at any universe -/

namespace KazhdanAsymptoticCommutant

/-- **`thm:kazhdan-transport` with both groups at arbitrary universes.**

Every hypothesis is one the print states: property `(T)` for the source, a
homomorphism into the ambient, a compressing element, positive dimensions, an
operator-norm asymptotic representation, a uniform operator-norm bound on `x`,
and asymptotic commutation with the image of `Γ`.  No countability is assumed of
either group.

The `Type 0` statement is applied to the model `Γ₀` of `Γ`, which exists because
property `(T)` makes `Γ` countable, and which still has property `(T)` because
the isomorphism carries it.  The data is pulled back along the isomorphism and
the conclusion pushed forward; the conclusion only ever mentions `U n s` and
`U n (ι γ)`, so nothing else has to move.

Every binder is after the colon, as `manuscriptKazhdanTransport` does it: the
zero-input gate rejects a badged declaration with header binders. -/
theorem manuscriptKazhdanTransport_anyUniverse :
    ∀ {Γ : Type w} {H : Type u'} [Group Γ] [Group H]
      (_hT : HasKazhdanPropertyTComplex.{w, max w v} Γ)
      (iota : Γ →* H) (s : H)
      (_hs : ∀ γ : Γ, ∃ δ : Γ, s * iota γ * s⁻¹ = iota δ)
      (d : ℕ → ℕ) (_hd : ∀ n, 0 < d n)
      (U : ∀ n, H → Matrix.unitaryGroup (naturalFiniteModel (d n)) ℂ)
      (_hU : ∀ g h : H, ∀ ε : ℝ, 0 < ε → ∃ N, ∀ n ≥ N,
        ‖(U n (g * h) : Matrix (naturalFiniteModel (d n))
            (naturalFiniteModel (d n)) ℂ) -
          (U n g : Matrix (naturalFiniteModel (d n))
            (naturalFiniteModel (d n)) ℂ) * U n h‖ ≤ ε)
      (x : ∀ n, Matrix (naturalFiniteModel (d n)) (naturalFiniteModel (d n)) ℂ)
      (_hbound : ∃ M : ℝ, 0 ≤ M ∧ ∀ n, ‖x n‖ ≤ M)
      (_hx : ∀ γ : Γ, NaturalHSCommutatorVanishing d U x (iota γ)),
    ∀ γ : Γ, NaturalHSCommutatorVanishing d U (fun n ↦
      (U n s : Matrix (naturalFiniteModel (d n))
        (naturalFiniteModel (d n)) ℂ) * x n *
        (U n s : Matrix (naturalFiniteModel (d n))
          (naturalFiniteModel (d n)) ℂ)ᴴ) (iota γ) := by
  intro Γ H _ _ hT iota s hs d hd U hU x hbound hx γ
  haveI : Countable Γ := countable_of_hasKazhdanPropertyTComplex.{w, v} hT
  obtain ⟨Γ₀, _, ⟨e⟩⟩ := Type0Transfer.exists_type0_model Γ
  have hT₀ : HasKazhdanPropertyTComplex.{0, max w v} Γ₀ := hT.mulEquiv e
  have hpull : ∀ γ₀ : Γ₀, (iota.comp e.symm.toMonoidHom) γ₀ = iota (e.symm γ₀) :=
    fun γ₀ ↦ rfl
  have hs₀ : ∀ γ₀ : Γ₀, ∃ δ₀ : Γ₀,
      s * (iota.comp e.symm.toMonoidHom) γ₀ * s⁻¹
        = (iota.comp e.symm.toMonoidHom) δ₀ := by
    intro γ₀
    obtain ⟨δ, hδ⟩ := hs (e.symm γ₀)
    refine ⟨e δ, ?_⟩
    rw [hpull, hpull, e.symm_apply_apply]
    exact hδ
  have hx₀ : ∀ γ₀ : Γ₀,
      NaturalHSCommutatorVanishing d U x ((iota.comp e.symm.toMonoidHom) γ₀) :=
    fun γ₀ ↦ by rw [hpull]; exact hx (e.symm γ₀)
  have hconc := manuscriptKazhdanTransport hT₀ (iota.comp e.symm.toMonoidHom) s
    hs₀ d hd U hU x hbound hx₀ (e γ)
  rw [hpull, e.symm_apply_apply] at hconc
  exact hconc

end KazhdanAsymptoticCommutant

end GroupApproximation
