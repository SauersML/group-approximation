import GroupApproximation.Sofic.NormalKazhdanMFRadical
import GroupApproximation.Sofic.IntrinsicCompressionMFRadical
import GroupApproximation.Sofic.ActualCoronaMFRadical

/-!
# Normal Kazhdan subgroups of an abstract tracially killed defect

The finite-normal obstruction is already stated against an abstract
hypothesis: `finiteNormal_le_normMFResidual_of_hyperlinear_killed` consumes
any subgroup that is killed in the tracial ultraproduct attached to every
operator-norm almost representation, with no compression structure in sight.
This file supplies the matching abstraction for the normal-Kazhdan
obstruction.

If `D` is killed in the tracial ultraproduct of every operator-norm almost
representation of `E`, then every normal property-`(T)` subgroup contained
in `D` lies in the norm-MF residual.  The two concrete kill theorems ---
the single-compressor defect (`compressionDefects_eq_one_in_hyperlinearHom`)
and the intrinsic all-compressors defect
(`compressionCentralizerDefect_eq_one_in_hyperlinearHom`) --- become
instances.  In particular the intrinsic compression--centralizer defect
`𝔇(H, L)` receives the normal-Kazhdan form of the radical theorem, which
previously existed only for the single-compressor defect subgroup.

The pushforward along the range restriction of an arbitrary norm-matrix
ultraproduct representation, performed by `KazhdanCompressionCore.map` in
the concrete theorem, is replaced by precomposition of almost
representations (`OpAlmostRepresentation.comap`), under which the kill
hypothesis is preserved definitionally.
-/

namespace GroupApproximation

universe w

variable {Γ E : Type} [Group Γ] [Group E]

/-- The subgroup generated by all normal property-`(T)` subgroups contained
in a given subgroup.  For the single-compressor defect this specializes to
`KazhdanCompressionCore.normalKazhdanDefectPart`.

The ambient group is quantified at an arbitrary universe here, shadowing the
section variable, because `p:nk-join` speaks of an arbitrary countable group.
Property `(T)` is then spelled `HasKazhdanPropertyT.{w, w}`, which is forced:
for `K : Subgroup E` with `E : Type w` the subtype `↥K` lives in `Type w`, so
the `.{0, 0}` form is not merely narrower but ill-typed.  This is a rendering of
the printed hypothesis, not a change to it -- at `w = 0` it is literally the
previous definition, so every `Type 0` consumer is unaffected. -/
def normalKazhdanPart {E : Type w} [Group E] (D : Subgroup E) : Subgroup E :=
  sSup {K : Subgroup E |
    K.Normal ∧ HasKazhdanPropertyT.{w, w} K ∧ K ≤ D}

namespace KazhdanCompressionCore

/-- **Normal-Kazhdan obstruction from an arbitrary tracial kill theorem
(engine form).**  If every element of `D` is killed in the tracial
ultraproduct attached to every operator-norm almost representation, then a
nontrivial normal property-`(T)` subgroup contained in `D` prevents weak-MF
approximation.  The subgroup may be infinite, noncentral, and torsion-free;
no compression structure is assumed. -/
theorem not_isWeakMF_of_normalKazhdan_le_hyperlinear_killed
    [Countable E] (D : Subgroup E)
    (hDkill : ∀ (B : OpAlmostRepresentation E) (U : Ultrafilter ℕ)
      (hcof : (U : Filter ℕ) ≤ Filter.cofinite) (x : E), x ∈ D →
      (KazhdanCompressionCore.toAsymptoticUnitaryRepresentation B).toUltraproductHom
        hcof x = 1)
    (K : Subgroup E) [K.Normal] [Nontrivial K]
    (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ D) :
    ¬ IsWeakMF E := by
  classical
  intro hMF
  obtain ⟨separation, hseparation, happroximation⟩ := hMF
  let A : WeakMFApproximation E :=
    Classical.choice
      (exists_weakMFApproximation hseparation happroximation)
  obtain ⟨Dgap⟩ := InternalRadicalGap.exists_setup A K hT
  obtain ⟨R⟩ := InternalRadicalGap.exists_ambientMovingCornerSchedule A K Dgap
  let U : Ultrafilter ℕ := Ultrafilter.of Filter.cofinite
  have hcof : ((U : Ultrafilter ℕ) : Filter ℕ) ≤ Filter.cofinite :=
    Ultrafilter.of_le Filter.cofinite
  let B : OpAlmostRepresentation E := normalCornerOpAlmostRepresentation R
  let S := toAsymptoticUnitaryRepresentation B
  let rhoHS : E →* UniversalHyperlinear U S.model S.modelNonempty :=
    S.toUltraproductHom hcof
  have hkillK : ∀ x : K, rhoHS (x : E) = 1 := by
    intro x
    exact hDkill B U hcof (x : E) (hK x.property)
  obtain ⟨s, hs, hsurvive⟩ :=
    R.exists_generator_hyperlinearHom_ne_one hcof
  apply hsurvive
  rw [R.hyperlinearHom_apply]
  have hkill := hkillK s
  change QuotientGroup.mk (fun n ↦ S.map n (s : E)) = 1 at hkill
  have hmap : (fun n ↦ S.map n (s : E)) = (fun n ↦ R.map n (s : E)) := by
    funext n
    rfl
  rw [hmap] at hkill
  exact hkill

/-- **Normal-Kazhdan cancellation from an arbitrary tracial kill theorem.**

If every element of a subgroup `D` is killed in the tracial ultraproduct
attached to every operator-norm almost representation, then every normal
property-`(T)` subgroup contained in `D` lies in the norm-MF residual.

This is the property-`(T)` companion of
`finiteNormal_le_normMFResidual_of_hyperlinear_killed`, and by
`hasKazhdanPropertyT_of_finite` it subsumes that theorem.  The formulation
is independent of Kazhdan compression; the concrete single-compressor
theorem `normalKazhdan_le_normMFResidual` and the intrinsic all-compressors
theorem below are instances. -/
theorem normalKazhdan_le_normMFResidual_of_hyperlinear_killed
    [Countable E] (D : Subgroup E)
    (hDkill : ∀ (B : OpAlmostRepresentation E) (U : Ultrafilter ℕ)
      (hcof : (U : Filter ℕ) ≤ Filter.cofinite) (x : E), x ∈ D →
      (KazhdanCompressionCore.toAsymptoticUnitaryRepresentation B).toUltraproductHom
        hcof x = 1)
    (K : Subgroup E) [K.Normal]
    (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ D) :
    K ≤ normMFResidual E := by
  intro k hk
  rw [mem_normMFResidual_iff]
  intro I U X rho
  by_contra hsurvive
  let f : E →* rho.range := rho.rangeRestrict
  let K' : Subgroup rho.range := K.map f
  letI : Countable rho.range :=
    Function.Surjective.countable rho.rangeRestrict_surjective
  letI : K'.Normal :=
    map_subgroup_normal K f rho.rangeRestrict_surjective
  have hT' : HasKazhdanPropertyT.{0, 0} K' :=
    map_subgroup_hasKazhdanPropertyT K f hT
  have hk' : f k ∈ K' := ⟨k, hk, rfl⟩
  have hfk_ne : f k ≠ 1 := by
    intro heq
    apply hsurvive
    exact congrArg Subtype.val heq
  letI : Nontrivial K' :=
    ⟨⟨⟨f k, hk'⟩, 1, fun heq ↦ hfk_ne (congrArg Subtype.val heq)⟩⟩
  have hres : normMFResidual rho.range = ⊥ := by
    apply Subgroup.eq_bot_iff_forall (normMFResidual rho.range) |>.2
    intro y hy
    apply Subtype.ext
    exact map_eq_one_of_mem_normMFResidual U X rho.range.subtype hy
  have hRangeOperatorMF : IsOperatorMF rho.range :=
    isOperatorMF_of_normMFResidual_eq_bot hres
  have hRangeWeakMF : IsWeakMF rho.range :=
    ⟨1, by norm_num,
      OperatorMFLocalNormalization.isNormApproximable_one hRangeOperatorMF⟩
  have hDkill' : ∀ (B : OpAlmostRepresentation rho.range)
      (U' : Ultrafilter ℕ)
      (hcof : (U' : Filter ℕ) ≤ Filter.cofinite) (y : rho.range),
      y ∈ D.map f →
      (KazhdanCompressionCore.toAsymptoticUnitaryRepresentation B).toUltraproductHom
        hcof y = 1 := by
    intro B U' hcof y hy
    obtain ⟨x, hx, rfl⟩ := hy
    exact hDkill (B.comap f) U' hcof x hx
  exact not_isWeakMF_of_normalKazhdan_le_hyperlinear_killed
    (D.map f) hDkill' K' hT' (Subgroup.map_mono hK) hRangeWeakMF

/-- Corona form of the abstract normal-Kazhdan cancellation theorem. -/
theorem normalKazhdan_le_coronaMFResidual_of_hyperlinear_killed
    [Countable E] (D : Subgroup E)
    (hDkill : ∀ (B : OpAlmostRepresentation E) (U : Ultrafilter ℕ)
      (hcof : (U : Filter ℕ) ≤ Filter.cofinite) (x : E), x ∈ D →
      (KazhdanCompressionCore.toAsymptoticUnitaryRepresentation B).toUltraproductHom
        hcof x = 1)
    (K : Subgroup E) [K.Normal]
    (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ D) :
    K ≤ coronaMFResidual E := by
  rw [coronaMFResidual_eq_normMFResidual]
  exact normalKazhdan_le_normMFResidual_of_hyperlinear_killed D hDkill K hT hK

/-- The normal Kazhdan part of an abstractly killed subgroup lies in the
norm-MF residual. -/
theorem normalKazhdanPart_le_normMFResidual_of_hyperlinear_killed
    [Countable E] (D : Subgroup E)
    (hDkill : ∀ (B : OpAlmostRepresentation E) (U : Ultrafilter ℕ)
      (hcof : (U : Filter ℕ) ≤ Filter.cofinite) (x : E), x ∈ D →
      (KazhdanCompressionCore.toAsymptoticUnitaryRepresentation B).toUltraproductHom
        hcof x = 1) :
    normalKazhdanPart D ≤ normMFResidual E := by
  apply sSup_le
  intro K hKmem
  letI : K.Normal := hKmem.1
  exact normalKazhdan_le_normMFResidual_of_hyperlinear_killed
    D hDkill K hKmem.2.1 hKmem.2.2

/-- Abstract normal-Kazhdan cancellation in the concrete C*-corona-kernel
form: literal norm matrix C*-corona representations kill every normal
property-`(T)` subgroup of an abstractly killed defect. -/
theorem normalKazhdan_le_normMatrixCStarCoronaKernel_of_hyperlinear_killed
    [Countable E] (D : Subgroup E)
    (hDkill : ∀ (B : OpAlmostRepresentation E) (U : Ultrafilter ℕ)
      (hcof : (U : Filter ℕ) ≤ Filter.cofinite) (x : E), x ∈ D →
      (KazhdanCompressionCore.toAsymptoticUnitaryRepresentation B).toUltraproductHom
        hcof x = 1)
    (K : Subgroup E) [K.Normal]
    (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ D)
    (X : ℕ → FiniteModel) (hX : ∀ n, 0 < Fintype.card (X n)) :
    letI : ∀ n, Nonempty (X n) :=
      fun n ↦ Fintype.card_pos_iff.mp (hX n)
    ∀ rho : E →* unitary (NormMatrixCStarCorona (fun n ↦ X n)),
      K ≤ rho.ker := by
  letI : ∀ n, Nonempty (X n) :=
    fun n ↦ Fintype.card_pos_iff.mp (hX n)
  intro rho
  let sigma : E →* NormMatrixCoronaUnitary X :=
    (normMatrixCoronaUnitaryEquiv X).symm.toMonoidHom.comp rho
  intro k hk
  have hres : k ∈ normMFResidual E :=
    normalKazhdan_le_normMFResidual_of_hyperlinear_killed D hDkill K hT hK hk
  have hkernel : k ∈ sigma.ker :=
    NormMFInvisible.toCoronaMFInvisible
      (mem_normMFResidual_iff.mp hres) X hX sigma
  apply MonoidHom.mem_ker.mpr
  apply (normMatrixCoronaUnitaryEquiv X).symm.injective
  simpa [sigma] using MonoidHom.mem_ker.mp hkernel

/-- **Positive control.**  The single-compressor defect subgroup satisfies
the abstract kill hypothesis, so the concrete theorem
`normalKazhdan_le_normMFResidual` is an instance of the abstract one. -/
theorem defectNormal_hyperlinear_killed (C : KazhdanCompressionCore Γ E) :
    ∀ (B : OpAlmostRepresentation E) (U : Ultrafilter ℕ)
      (hcof : (U : Filter ℕ) ≤ Filter.cofinite) (x : E),
      x ∈ C.defectNormal →
      (KazhdanCompressionCore.toAsymptoticUnitaryRepresentation B).toUltraproductHom
        hcof x = 1 := by
  intro B U hcof x hx
  exact MonoidHom.mem_ker.mp (C.defectNormal_le_ker
    ((toAsymptoticUnitaryRepresentation B).toUltraproductHom hcof)
    (compressionDefects_eq_one_in_hyperlinearHom C B hcof) hx)

end KazhdanCompressionCore

namespace KazhdanAsymptoticCommutant

/-- **Intrinsic normal-Kazhdan radical theorem.**  Every normal
property-`(T)` subgroup inside the intrinsic compression--centralizer
defect of a Kazhdan image lies in the norm-MF residual.  This is the
normal-Kazhdan companion of
`finiteNormal_le_normMFResidual_of_le_compressionCentralizerDefect`. -/
theorem normalKazhdan_le_normMFResidual_of_le_compressionCentralizerDefect
    [Countable E] (iota : Γ →* E)
    (hkazhdan : HasKazhdanPropertyT.{0, 0} Γ)
    (K : Subgroup E) [K.Normal]
    (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ compressionCentralizerDefect iota.range) :
    K ≤ normMFResidual E := by
  refine KazhdanCompressionCore.normalKazhdan_le_normMFResidual_of_hyperlinear_killed
    (compressionCentralizerDefect iota.range) ?_ K hT hK
  intro B U hcof x hx
  exact MonoidHom.mem_ker.mp
    (compressionCentralizerDefect_eq_one_in_hyperlinearHom
      B iota hkazhdan hcof hx)

/-- A nontrivial normal property-`(T)` subgroup inside the intrinsic
compression--centralizer defect rules out weak-MF approximation. -/
theorem not_isWeakMF_of_normalKazhdan_le_compressionCentralizerDefect
    [Countable E] (iota : Γ →* E)
    (hkazhdan : HasKazhdanPropertyT.{0, 0} Γ)
    (K : Subgroup E) [K.Normal] [Nontrivial K]
    (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ compressionCentralizerDefect iota.range) :
    ¬ IsWeakMF E := by
  refine KazhdanCompressionCore.not_isWeakMF_of_normalKazhdan_le_hyperlinear_killed
    (compressionCentralizerDefect iota.range) ?_ K hT hK
  intro B U hcof x hx
  exact MonoidHom.mem_ker.mp
    (compressionCentralizerDefect_eq_one_in_hyperlinearHom
      B iota hkazhdan hcof hx)

/-- The intrinsic normal-Kazhdan radical theorem in the manuscript's
literal MF-radical language. -/
theorem normalKazhdan_le_actualCoronaMFResidual_of_le_compressionCentralizerDefect
    [Countable E] (iota : Γ →* E)
    (hkazhdan : HasKazhdanPropertyT.{0, 0} Γ)
    (K : Subgroup E) [K.Normal]
    (hT : HasKazhdanPropertyT.{0, 0} K)
    (hK : K ≤ compressionCentralizerDefect iota.range) :
    K ≤ actualCoronaMFResidual E := by
  rw [actualCoronaMFResidual_eq_coronaMFResidual,
    coronaMFResidual_eq_normMFResidual]
  exact normalKazhdan_le_normMFResidual_of_le_compressionCentralizerDefect
    iota hkazhdan K hT hK

/-- The normal Kazhdan part of the intrinsic compression--centralizer
defect lies in the norm-MF residual. -/
theorem normalKazhdanPart_compressionCentralizerDefect_le_normMFResidual
    [Countable E] (iota : Γ →* E)
    (hkazhdan : HasKazhdanPropertyT.{0, 0} Γ) :
    normalKazhdanPart (compressionCentralizerDefect iota.range) ≤
      normMFResidual E := by
  refine KazhdanCompressionCore.normalKazhdanPart_le_normMFResidual_of_hyperlinear_killed
    (compressionCentralizerDefect iota.range) ?_
  intro B U hcof x hx
  exact MonoidHom.mem_ker.mp
    (compressionCentralizerDefect_eq_one_in_hyperlinearHom
      B iota hkazhdan hcof hx)

/-- The normal Kazhdan part of the intrinsic defect in the manuscript's
literal MF-radical language. -/
theorem normalKazhdanPart_compressionCentralizerDefect_le_actualCoronaMFResidual
    [Countable E] (iota : Γ →* E)
    (hkazhdan : HasKazhdanPropertyT.{0, 0} Γ) :
    normalKazhdanPart (compressionCentralizerDefect iota.range) ≤
      actualCoronaMFResidual E := by
  rw [actualCoronaMFResidual_eq_coronaMFResidual,
    coronaMFResidual_eq_normMFResidual]
  exact normalKazhdanPart_compressionCentralizerDefect_le_normMFResidual
    iota hkazhdan

end KazhdanAsymptoticCommutant

end GroupApproximation
