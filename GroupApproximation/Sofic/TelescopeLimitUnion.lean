import GroupApproximation.Sofic.TelescopeRadicalInduction

/-!
# The telescope's union hypothesis, discharged

`TelescopeRadicalInduction.ker_limit_le_coronaMFResidual` carries the induction
over a tower `W ↠ V₀ ↠ V₁ ↠ ⋯ ↠ P` up to one hypothesis it leaves to the
caller:

```text
hunion : ∀ x ∈ limit.ker, ∃ n, x ∈ (T.stage n).ker
```

and its docstring calls this "the telescope's finite-support fact".  It is
weaker than that, and it does not need the telescope.  All it needs is that the
stage kernels *increase* and that the limit kernel is normally generated by
elements each of which some stage already kills.

The reason is that an increasing family of normal subgroups has a union which
is again a normal subgroup: directedness closes it under multiplication, and
each conjugate stays in the stage the element came from.  A normal subgroup
containing the generators contains the normal closure, so the whole limit
kernel lies in the union, and directedness converts "in the union" back into
"in some single stage".

That is what `exists_stage_of_mem_ker_limit` proves, and
`ker_limit_le_coronaMFResidual_of_generators` is the induction with the
hypothesis already discharged: a caller now supplies only the collapse
theorems, the monotonicity of the tower, and a normal generating set for the
limit kernel.

For the telescope this is exactly the right shape.  Its limit kernel is
normally generated by the lamp relations, each supported in finitely many
fibres, so each is killed once the tower has refined past its support -- and
the elements themselves, not the arbitrary products of them, are all that has
to be checked.
-/

namespace GroupApproximation
namespace TelescopeRadicalInduction

universe u

variable {W : Type u} [Group W] {V : ℕ → Type u} [∀ n, Group (V n)]
variable (T : Tower W V)

/-! ## The union of an increasing family of stage kernels -/

/-- An increasing family of normal subgroups has normal supremum.  Directedness
puts any element into a single member, where normality already holds. -/
theorem iSup_ker_normal (hmono : Monotone fun n => (T.stage n).ker)
    (hnormal : ∀ n, ((T.stage n).ker).Normal) :
    (⨆ n, (T.stage n).ker).Normal := by
  constructor
  intro x hx g
  obtain ⟨m, hm⟩ :=
    (Subgroup.mem_iSup_of_directed hmono.directed_le).mp hx
  exact le_iSup (fun n => (T.stage n).ker) m ((hnormal m).conj_mem x hm g)

/-- **The union hypothesis, discharged.**  If the stage kernels increase and the
limit kernel is normally generated by elements each killed at some stage, then
*every* element of the limit kernel is killed at some single stage.

Note what is not needed: no finiteness of the generating set, no countability,
and nothing about the maps beyond the tower structure.  The generators may each
die at a different stage. -/
theorem exists_stage_of_mem_ker_limit {P : Type u} [Group P] (limit : W →* P)
    (hmono : Monotone fun n => (T.stage n).ker)
    (hnormal : ∀ n, ((T.stage n).ker).Normal)
    {S : Set W} (hgen : limit.ker = Subgroup.normalClosure S)
    (hS : ∀ s ∈ S, ∃ n, s ∈ (T.stage n).ker) :
    ∀ x ∈ limit.ker, ∃ n, x ∈ (T.stage n).ker := by
  haveI hU : (⨆ n, (T.stage n).ker).Normal := iSup_ker_normal T hmono hnormal
  have hSU : S ⊆ ((⨆ n, (T.stage n).ker : Subgroup W) : Set W) := by
    intro s hs
    obtain ⟨n, hn⟩ := hS s hs
    exact le_iSup (fun n => (T.stage n).ker) n hn
  have hle : limit.ker ≤ ⨆ n, (T.stage n).ker := by
    rw [hgen]
    exact Subgroup.normalClosure_le_normal hSU
  intro x hx
  exact (Subgroup.mem_iSup_of_directed hmono.directed_le).mp (hle hx)

/-! ## The induction, with nothing left for the caller -/

/-- **The limit kernel is radical.**  `ker_limit_le_coronaMFResidual` with its
union hypothesis supplied: the caller provides the collapse theorems (through
`hstages`), the monotonicity of the tower, and a normal generating set for the
limit kernel whose members are each killed at some finite stage. -/
theorem ker_limit_le_coronaMFResidual_of_generators {P : Type u} [Group P]
    (limit : W →* P)
    (hstages : ∀ n, (T.stage n).ker ≤ coronaMFResidual W)
    (hmono : Monotone fun n => (T.stage n).ker)
    (hnormal : ∀ n, ((T.stage n).ker).Normal)
    {S : Set W} (hgen : limit.ker = Subgroup.normalClosure S)
    (hS : ∀ s ∈ S, ∃ n, s ∈ (T.stage n).ker) :
    limit.ker ≤ coronaMFResidual W :=
  ker_limit_le_coronaMFResidual T limit hstages
    (exists_stage_of_mem_ker_limit T limit hmono hnormal hgen hS)

/-- **The radical computed by the telescope.**  Combining the discharged limit
statement with `coronaMFResidual_eq_ker_limit`: for a surjective limit onto an
MF group, the MF radical of the source is exactly the limit kernel.

This is the full telescope collapse conclusion, with the induction, the limit
union, and the MF correction all in place; what remains for any concrete
telescope is to exhibit the collapse theorems and the normal generating set. -/
theorem coronaMFResidual_eq_ker_limit_of_generators {P : Type u} [Group P]
    (limit : W →* P)
    (hstages : ∀ n, (T.stage n).ker ≤ coronaMFResidual W)
    (hmono : Monotone fun n => (T.stage n).ker)
    (hnormal : ∀ n, ((T.stage n).ker).Normal)
    {S : Set W} (hgen : limit.ker = Subgroup.normalClosure S)
    (hS : ∀ s ∈ S, ∃ n, s ∈ (T.stage n).ker)
    (hsurj : Function.Surjective limit)
    (hMF : coronaMFResidual P = ⊥) :
    coronaMFResidual W = limit.ker :=
  -- `coronaMFResidual_eq_ker_limit` needs only the limit map: it is stated for
  -- any surjection with radical kernel, and never mentions the tower.
  coronaMFResidual_eq_ker_limit limit
    (ker_limit_le_coronaMFResidual_of_generators T limit hstages hmono hnormal
      hgen hS)
    hsurj hMF

/-! ## Monotonicity comes free from the tower -/

/-- The stage kernels of a tower are automatically increasing: stage `n+1`
factors through stage `n`, so anything stage `n` kills stage `n+1` kills too.
The `hmono` hypothesis above therefore never has to be checked separately. -/
theorem ker_stage_mono : Monotone fun n => (T.stage n).ker := by
  refine monotone_nat_of_le_succ fun n => ?_
  intro x hx
  rw [MonoidHom.mem_ker] at hx ⊢
  rw [stage_succ_apply, hx, map_one]

/-- The discharged induction with monotonicity removed as well: a caller
supplies the collapse theorems, normality of the stage kernels, and the normal
generating set, and nothing else. -/
theorem ker_limit_le_coronaMFResidual_of_tower {P : Type u} [Group P]
    (limit : W →* P)
    (hstages : ∀ n, (T.stage n).ker ≤ coronaMFResidual W)
    (hnormal : ∀ n, ((T.stage n).ker).Normal)
    {S : Set W} (hgen : limit.ker = Subgroup.normalClosure S)
    (hS : ∀ s ∈ S, ∃ n, s ∈ (T.stage n).ker) :
    limit.ker ≤ coronaMFResidual W :=
  ker_limit_le_coronaMFResidual_of_generators T limit hstages
    (ker_stage_mono T) hnormal hgen hS

end TelescopeRadicalInduction
end GroupApproximation
