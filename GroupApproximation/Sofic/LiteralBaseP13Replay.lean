import GroupApproximation.Sofic.LiteralBaseRotationRetract

/-!
# Finite relator replay for the literal rotation presentation

This module records explicit words used to compare the eight-relator rotation
presentation with standard integral presentations.  Every equality proved
here is internal to the presented group; no matrix equality is reflected back
through the canonical matrix quotient.
-/

namespace GroupApproximation
namespace LiteralBaseP13Replay

open LiteralBaseRotationRetract

noncomputable section

abbrev u : Rotation := Z
abbrev v : Rotation := X * Y

/-- Liversidge's explicit `u=z`, `v=xy` word for the generator `y`. -/
abbrev yFromUZXY : Rotation :=
  (u * v * u * v⁻¹ * u⁻¹ * v * u⁻¹ * v⁻¹ * u⁻¹ * v⁻¹ * u⁻¹ * v) ^ 2

/-! The following eleven cyclic relator forms are precisely the parenthesized
items used by the finite PEACE proof trace.  Each is proved directly from one
of the eight defining relations; no word-problem oracle is involved. -/

private theorem r0 : X * X * X = 1 := by
  simpa [pow_succ, mul_assoc] using rotation_x_cube

private theorem r1 : X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ = 1 := by
  have h := congrArg Inv.inv rotation_xz_cube
  have h' : Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ = 1 := by
    simpa [pow_succ, mul_assoc] using h
  calc
    X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ =
        X⁻¹ * (Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹) * X := by group
    _ = 1 := by rw [h']; simp

private theorem r2 :
    Z⁻¹ * X * Y⁻¹ * X⁻¹ * Z⁻¹ * X * Y⁻¹ * X⁻¹ = 1 := by
  have h := congrArg Inv.inv rotation_x_inv_z_x_y_sq
  have h' : Y⁻¹ * X⁻¹ * Z⁻¹ * X * Y⁻¹ * X⁻¹ * Z⁻¹ * X = 1 := by
    simpa [pow_succ, mul_assoc] using h
  calc
    Z⁻¹ * X * Y⁻¹ * X⁻¹ * Z⁻¹ * X * Y⁻¹ * X⁻¹ =
        (Y⁻¹ * X⁻¹)⁻¹ *
          (Y⁻¹ * X⁻¹ * Z⁻¹ * X * Y⁻¹ * X⁻¹ * Z⁻¹ * X) *
          (Y⁻¹ * X⁻¹) := by group
    _ = 1 := by rw [h']; simp

private theorem r3 : Z * Z = 1 := by
  simpa [pow_succ] using rotation_z_sq

private theorem r4 : Y⁻¹ * Y⁻¹ * Y⁻¹ = 1 := by
  have h := congrArg Inv.inv rotation_y_cube
  simpa [pow_succ, mul_assoc] using h

private theorem r5 : Y * X⁻¹ * Z * X * Y * X⁻¹ * Z * X = 1 := by
  calc
    Y * X⁻¹ * Z * X * Y * X⁻¹ * Z * X =
        (X⁻¹ * Z * X)⁻¹ * (X⁻¹ * Z * X * Y) ^ 2 *
          (X⁻¹ * Z * X) := by simp [pow_succ]; group
    _ = 1 := by rw [rotation_x_inv_z_x_y_sq]; group

private theorem r6 : Z * Y * Z * Y * Z * Y = 1 := by
  calc
    Z * Y * Z * Y * Z * Y = Y⁻¹ * (Y * Z) ^ 3 * Y := by
      simp [pow_succ]
      group
    _ = 1 := by rw [rotation_yz_cube]; simp

private theorem r7 : Z⁻¹ * Z⁻¹ = 1 := by
  have h := congrArg Inv.inv rotation_z_sq
  simpa [pow_succ] using h

private theorem r8 : X * Y * X⁻¹ * Z * X * Y * X⁻¹ * Z = 1 := by
  calc
    X * Y * X⁻¹ * Z * X * Y * X⁻¹ * Z =
        (X⁻¹ * Z)⁻¹ * (X⁻¹ * Z * X * Y) ^ 2 * (X⁻¹ * Z) := by
          simp [pow_succ]
          group
    _ = 1 := by rw [rotation_x_inv_z_x_y_sq]; group

private theorem r9 : Z * X * Z * X * Z * X = 1 := by
  calc
    Z * X * Z * X * Z * X = X⁻¹ * (X * Z) ^ 3 * X := by
      simp [pow_succ]
      group
    _ = 1 := by rw [rotation_xz_cube]; simp

private theorem r10 : X⁻¹ * X⁻¹ * X⁻¹ = 1 := by
  have h := congrArg Inv.inv rotation_x_cube
  simpa [pow_succ, mul_assoc] using h

private abbrev proofTrace : List Rotation :=
  [X, Y⁻¹, X⁻¹, X * X * X,
   X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹,
   Z⁻¹ * X * Y⁻¹ * X⁻¹ * Z⁻¹ * X * Y⁻¹ * X⁻¹,
   X, Y, X⁻¹, Z, X * Y, X⁻¹, Z * Z, X, Z, X, Z * Z,
   X⁻¹ * X⁻¹, X * X * X,
   X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹,
   X, Y⁻¹ * X⁻¹, Z⁻¹, X * Y, Y⁻¹ * Y⁻¹ * Y⁻¹, Y,
   Y * X⁻¹ * Z * X * Y * X⁻¹ * Z * X,
   Z * Y * Z * Y * Z * Y, Y⁻¹, Z⁻¹, Y⁻¹, Z⁻¹ * Z⁻¹, Y,
   Y⁻¹ * X⁻¹, Z⁻¹, X⁻¹, Z⁻¹ * Z⁻¹, X, Y⁻¹ * X⁻¹, Z⁻¹,
   X * Y, Y⁻¹ * Y⁻¹ * Y⁻¹, Y, X⁻¹,
   X * Y * X⁻¹ * Z * X * Y * X⁻¹ * Z,
   Z * X * Z * X * Z * X, X⁻¹ * X⁻¹ * X⁻¹, X, Y⁻¹, X,
   Y⁻¹, X⁻¹, X * X * X,
   X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹,
   Z⁻¹ * X * Y⁻¹ * X⁻¹ * Z⁻¹ * X * Y⁻¹ * X⁻¹,
   X, Y, X⁻¹, Z, X * Y, X⁻¹, Z * Z, X, Z, X, Z * Z,
   X⁻¹ * X⁻¹, X * X * X,
   X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹ * X⁻¹ * Z⁻¹,
   X, Y⁻¹ * X⁻¹, Z⁻¹, X * Y, Y⁻¹ * Y⁻¹ * Y⁻¹, Y,
   Y * X⁻¹ * Z * X * Y * X⁻¹ * Z * X,
   Z * Y * Z * Y * Z * Y, Y⁻¹, Z⁻¹, Y⁻¹, Z⁻¹ * Z⁻¹, Y,
   Y⁻¹ * X⁻¹, Z⁻¹, X⁻¹, Z⁻¹ * Z⁻¹, X, Y⁻¹ * X⁻¹, Z⁻¹,
   X * Y, Y⁻¹ * Y⁻¹, X⁻¹,
   X * Y * X⁻¹ * Z * X * Y * X⁻¹ * Z,
   Z * X * Z * X * Z * X, X⁻¹ * X⁻¹ * X⁻¹, X, Y, Y]

/-- The explicit two-generator recovery formula from the finite PEACE trace:
the generator `Y` lies in the subgroup generated by `Z` and `X * Y`.  The
proof is an exact replay of 31 cyclic defining-relator insertions followed by
free group simplification. -/
theorem yFromUZXY_eq : yFromUZXY = Y := by
  have hleft : proofTrace.prod = Y := by
    simp [proofTrace]
    group
  have hright : proofTrace.prod = yFromUZXY := by
    simp only [proofTrace, List.prod_cons, List.prod_nil, mul_one,
      r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, one_mul]
    simp [yFromUZXY, u, v, pow_succ]
    group
  exact hright.symm.trans hleft

/-- The rotation presentation is generated by `Z` and `X * Y`. -/
theorem closure_Z_XY_eq_top :
    Subgroup.closure ({Z, X * Y} : Set Rotation) = ⊤ := by
  let H : Subgroup Rotation := Subgroup.closure ({Z, X * Y} : Set Rotation)
  have hu : u ∈ H := Subgroup.subset_closure (by simp [u])
  have hv : v ∈ H := Subgroup.subset_closure (by simp [v])
  have hy : Y ∈ H := by
    rw [← yFromUZXY_eq]
    exact H.pow_mem
      (H.mul_mem
        (H.mul_mem
          (H.mul_mem
            (H.mul_mem
              (H.mul_mem
                (H.mul_mem
                  (H.mul_mem
                    (H.mul_mem
                      (H.mul_mem
                        (H.mul_mem
                          (H.mul_mem hu hv) hu)
                          (H.inv_mem hv))
                        (H.inv_mem hu)) hv)
                    (H.inv_mem hu))
                  (H.inv_mem hv))
                (H.inv_mem hu))
              (H.inv_mem hv))
            (H.inv_mem hu)) hv) 2
  have hx : X ∈ H := by
    have hxy : X * Y ∈ H := hv
    simpa only [mul_inv_cancel_right] using H.mul_mem hxy (H.inv_mem hy)
  refine top_unique fun g _ ↦ ?_
  obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective
    (rotationRelators : Set (FreeGroup RotationGenerator)) g
  induction w using FreeGroup.induction_on with
  | C1 => exact Subgroup.one_mem _
  | of i =>
      fin_cases i
      · exact hx
      · exact hy
      · exact hu
  | inv_of i hi =>
      rw [map_inv]
      exact H.inv_mem (hi trivial)
  | mul a b ha hb =>
      rw [map_mul]
      exact H.mul_mem (ha trivial) (hb trivial)

end

end LiteralBaseP13Replay
end GroupApproximation
