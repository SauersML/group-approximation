import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Tactic.Group

/-!
# The mixed raw/comb commutator is a bilateral dihedral direction

Two involutions conjugate the square of their product to its inverse.  This
is the abstract group identity behind the exact Leavitt-prefix word
`h=[U^* X₁ U, raw]`: once `h` is known to have infinite order, its direction
is bilateral and reflected by both packet generators.
-/

namespace GroupApproximation

/-- Each of two involutions reverses the squared translation generated by
their product. -/
theorem involutions_conjugate_product_sq_to_inverse
    {G : Type*} [Group G] (a b : G)
    (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) :
    a * (a * b) ^ 2 * a⁻¹ = ((a * b) ^ 2)⁻¹ ∧
      b * (a * b) ^ 2 * b⁻¹ = ((a * b) ^ 2)⁻¹ := by
  have haInv : a⁻¹ = a := by
    apply inv_eq_of_mul_eq_one_left
    simpa [pow_two] using ha
  have hbInv : b⁻¹ = b := by
    apply inv_eq_of_mul_eq_one_left
    simpa [pow_two] using hb
  have haa : a * a = 1 := by simpa [pow_two] using ha
  have hbb : b * b = 1 := by simpa [pow_two] using hb
  have hinv : ((a * b) ^ 2)⁻¹ = b * a * b * a := by
    simp only [pow_two, _root_.mul_inv_rev, haInv, hbInv]
    group
  constructor
  · rw [hinv]
    calc
      a * (a * b) ^ 2 * a⁻¹ = (a * a) * b * a * b * a := by
        rw [haInv, pow_two]
        group
      _ = b * a * b * a := by rw [haa, one_mul]
  · rw [hinv]
    calc
      b * (a * b) ^ 2 * b⁻¹ = b * a * b * a * (b * b) := by
        rw [hbInv, pow_two]
        group
      _ = b * a * b * a := by rw [hbb, mul_one]

end GroupApproximation
