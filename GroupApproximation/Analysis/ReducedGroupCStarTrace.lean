import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
import Mathlib.Analysis.InnerProductSpace.l2Space
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# The regular-operator model of the reduced group C⋆-algebra

Mathlib does not yet provide a reduced group C⋆-algebra construction.  This
file supplies the foundational operator-algebraic layer: the complex left
regular representation on `ℓ²(G)`, the closed star subalgebra it generates,
and the continuous coefficient functional at the identity vector.

The remaining trace and faithfulness proofs amount to extending the algebraic
coefficient calculation through this closure and proving that the identity
vector is separating for the left von Neumann action (using right
translations).  No such conclusion is assumed here.
-/

open scoped ENNReal InnerProductSpace

namespace GroupApproximation

namespace ReducedGroupCStarTrace

noncomputable section

universe u

variable {α β : Type u}

/-- Coefficientwise reindexing of complex `ℓ²` along an equivalence preserves
square-summability. -/
theorem memℓp_comp_equiv (e : α ≃ β) (f : lp (fun _ : α ↦ ℂ) 2) :
    Memℓp (fun b : β ↦ f (e.symm b)) 2 := by
  apply memℓp_gen
  exact (Equiv.summable_iff e.symm).2
    ((memℓp_gen_iff (by norm_num)).1 (lp.memℓp f))

/-- The underlying complex-linear equivalence induced by reindexing `ℓ²`. -/
def lpCongrLeftLinear (e : α ≃ β) :
    lp (fun _ : α ↦ ℂ) 2 ≃ₗ[ℂ] lp (fun _ : β ↦ ℂ) 2 where
  toFun f := ⟨fun b ↦ f (e.symm b), memℓp_comp_equiv e f⟩
  invFun f := ⟨fun a ↦ f (e.symm.symm a), memℓp_comp_equiv e.symm f⟩
  map_add' f g := by
    apply lp.ext
    funext b
    change (⇑(f + g)) (e.symm b) = f (e.symm b) + g (e.symm b)
    rw [lp.coeFn_add, Pi.add_apply]
  map_smul' c f := by
    apply lp.ext
    funext b
    change (⇑(c • f)) (e.symm b) = c • f (e.symm b)
    rw [lp.coeFn_smul, Pi.smul_apply]
  left_inv f := by
    apply lp.ext
    funext a
    change f (e.symm (e.symm.symm a)) = f a
    rw [Equiv.symm_symm, Equiv.symm_apply_apply]
  right_inv f := by
    apply lp.ext
    funext b
    change f (e.symm.symm (e.symm b)) = f b
    rw [Equiv.symm_symm, Equiv.apply_symm_apply]

/-- Reindexing complex `ℓ²` along an equivalence is a linear isometry. -/
def lpCongrLeft (e : α ≃ β) :
    lp (fun _ : α ↦ ℂ) 2 ≃ₗᵢ[ℂ] lp (fun _ : β ↦ ℂ) 2 :=
  (lpCongrLeftLinear e).isometryOfInner (by
    intro f g
    rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
    exact Equiv.tsum_eq e.symm fun a ↦ ⟪f a, g a⟫_ℂ)

@[simp]
theorem lpCongrLeft_apply (e : α ≃ β) (f : lp (fun _ : α ↦ ℂ) 2) (b : β) :
    lpCongrLeft e f b = f (e.symm b) :=
  rfl

variable (G : Type u) [Group G]

/-- The Hilbert space `ℓ²(G)` used by the regular representation. -/
abbrev GroupHilbert := lp (fun _ : G ↦ ℂ) 2

/-- The left regular unitary on `ℓ²(G)`. -/
def leftRegular (g : G) : GroupHilbert G ≃ₗᵢ[ℂ] GroupHilbert G :=
  lpCongrLeft (Equiv.mulLeft g)

@[simp]
theorem leftRegular_apply (g : G) (f : GroupHilbert G) (x : G) :
    leftRegular G g f x = f (g⁻¹ * x) :=
  rfl

/-- The left regular unitary regarded as a bounded operator. -/
def leftRegularOperator (g : G) : GroupHilbert G →L[ℂ] GroupHilbert G :=
  (leftRegular G g).toLinearIsometry.toContinuousLinearMap

@[simp]
theorem leftRegularOperator_apply (g : G) (f : GroupHilbert G) (x : G) :
    leftRegularOperator G g f x = f (g⁻¹ * x) :=
  rfl

/-- The concrete reduced group C⋆-algebra: the norm-closed star subalgebra of
bounded operators generated by the left regular representation. -/
def reducedGroupCStarSubalgebra :
    StarSubalgebra ℂ (GroupHilbert G →L[ℂ] GroupHilbert G) :=
  (StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G))).topologicalClosure

/-- The underlying C⋆-algebra type of the concrete reduced group C⋆-algebra. -/
abbrev ReducedGroupCStar := reducedGroupCStarSubalgebra G

/-- The identity point mass in `ℓ²(G)`. -/
def deltaOne : GroupHilbert G := by
  classical
  exact lp.single 2 (1 : G) 1

/-- On the ambient bounded-operator algebra, take the coefficient of
`T δ₁` at the identity.  This is the canonical reduced-group trace before
restriction and before proving traciality and faithfulness. -/
def ambientCoefficientAtOne :
    (GroupHilbert G →L[ℂ] GroupHilbert G) →L[ℂ] ℂ :=
  (lp.evalCLM ℂ (fun _ : G ↦ ℂ) 2 (1 : G)).comp
    (ContinuousLinearMap.apply ℂ (GroupHilbert G) (deltaOne G))

/-- The canonical coefficient functional restricted to the concrete reduced
group C⋆-algebra. -/
def canonicalCoefficientAtOne : ReducedGroupCStar G →L[ℂ] ℂ :=
  (ambientCoefficientAtOne G).comp
    (Submodule.subtypeL (reducedGroupCStarSubalgebra G).toSubalgebra.toSubmodule)

@[simp]
theorem ambientCoefficientAtOne_apply (T : GroupHilbert G →L[ℂ] GroupHilbert G) :
    ambientCoefficientAtOne G T = T (deltaOne G) 1 :=
  rfl

end

end ReducedGroupCStarTrace

end GroupApproximation
