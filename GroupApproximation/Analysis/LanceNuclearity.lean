import GroupApproximation.Analysis.LanceCPApprox
import GroupApproximation.Analysis.LanceMatrixArveson
import GroupApproximation.Analysis.NuclearityAmenability

/-!
# Nuclearity of the reduced algebra, and Lance's arrow

Toward proof-ledger row `RE.05`.  `NuclearityAmenability` proves the
manuscript's nonnuclearity paragraph modulo two things it could not state at
the pinned Mathlib revision: a *definition* of nuclearity, and Lance's
theorem about it.  Both are supplied here.

`NuclearReducedCPAP G` is the completely positive approximation property of
`C*_λ(G)`, written out: for every finite set of group elements and every
tolerance there is a `k` and a factorization of the identity through
`B(ℂᵏ)`, by a completely positive unital `down` on the reduced algebra and a
completely positive unital `up` back into it, agreeing with the identity
on the named translations to within the tolerance.  There is no C⋆-tensor
product at the pin, so the CPAP is the definition of nuclearity that can be
written down; it is the standard one for the reduced algebra of a discrete
group.

`hasInvariantMean_of_nuclearReducedCPAP` is **Lance's arrow**, proved:

* extend `down` from the reduced algebra to all bounded operators, by the
  matrix-target Arveson theorem (`Analysis/LanceMatrixArveson`);
* compose with `up` to get a unital completely positive `φ` on `B(ℓ²(G))`
  with values in `L(G)`, still close to the identity on the translations;
* feed `φ` to the Lance assembly (`Analysis/LanceCPApprox`), which averages
  the canonical trace against multiplication operators and takes Day's
  ultrafilter limit.

`reducedGroupCStar_not_nuclear` then discharges the `lance` binder of
`NuclearityAmenability.reducedGroupCStar_not_nuclear_of_lance` outright, so
the manuscript's conclusion --- `C*_λ(E)` is not nuclear --- holds with no
hypothesis on nuclearity left standing.

## Trust surface

The premise `NuclearReducedCPAP` is a definition, not a binder, and the
arrow to `HasInvariantMean` is proved for *all* discrete groups; nothing is
tailored to `E`.  What a reader must still check is that the definition is
the intended one: that is a reading of the `def` below, not of a hypothesis.

## Manuscript status

Closes the Lean side of the Lance debt in `RE.05`.
-/

namespace GroupApproximation
namespace CStarExactness

open scoped InnerProductSpace
open ReducedGroupCStarTrace GroupVonNeumann Amenability

noncomputable section

/-! ## The reduced algebra sits inside the group von Neumann algebra -/

variable {G : Type} [Group G]

omit [Group G] in
/-- A centralizer in the bounded operators is norm-closed. -/
theorem isClosed_centralizer
    (S : Set (GroupHilbert G →L[ℂ] GroupHilbert G)) :
    IsClosed (Set.centralizer S) := by
  have hEq : Set.centralizer S
      = ⋂ m ∈ S, {a : GroupHilbert G →L[ℂ] GroupHilbert G | m * a = a * m} := by
    ext a
    simp only [Set.mem_centralizer_iff, Set.mem_iInter, Set.mem_setOf_eq]
  rw [hEq]
  refine isClosed_iInter fun m ↦ isClosed_iInter fun _ ↦ ?_
  exact isClosed_eq (continuous_const.mul continuous_id)
    (continuous_id.mul continuous_const)

/-- **`C*_λ(G) ⊆ L(G)`.**  The reduced C⋆-algebra is the norm closure of the
star algebra generated by the translations, and the group von Neumann
algebra is a norm-closed star subalgebra containing them. -/
theorem mem_groupVonNeumannAlgebra_of_mem_reduced
    {T : GroupHilbert G →L[ℂ] GroupHilbert G}
    (hT : T ∈ reducedGroupCStarSubalgebra G) :
    T ∈ groupVonNeumannAlgebra G := by
  have hgen : (StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G)) :
      Set (GroupHilbert G →L[ℂ] GroupHilbert G))
      ⊆ (groupVonNeumannAlgebra G : Set _) := by
    have hle : StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G))
        ≤ (groupVonNeumannAlgebra G).toStarSubalgebra := by
      rw [StarAlgebra.adjoin_le_iff]
      rintro _ ⟨g, rfl⟩
      exact leftRegularOperator_mem G g
    exact hle
  have hclosed : IsClosed ((groupVonNeumannAlgebra G :
      Set (GroupHilbert G →L[ℂ] GroupHilbert G))) := by
    have hcc : (groupVonNeumannAlgebra G :
        Set (GroupHilbert G →L[ℂ] GroupHilbert G))
        = Set.centralizer
            (Set.centralizer (Set.range (leftRegularOperator G))) := rfl
    rw [hcc]
    exact isClosed_centralizer _
  exact closure_minimal hgen hclosed hT

/-- The reduced C⋆-algebra is norm-closed: it is a topological closure. -/
theorem isClosed_reducedGroupCStarSubalgebra :
    IsClosed ((reducedGroupCStarSubalgebra G :
      Set (GroupHilbert G →L[ℂ] GroupHilbert G))) :=
  (StarAlgebra.adjoin ℂ
    (Set.range (leftRegularOperator G))).isClosed_topologicalClosure

/-- Each left translation lies in the reduced C⋆-algebra. -/
theorem mem_reduced_leftRegularOperator (g : G) :
    leftRegularOperator G g ∈ reducedGroupCStarSubalgebra G :=
  (StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G))).le_topologicalClosure
    (StarAlgebra.subset_adjoin ℂ _ ⟨g, rfl⟩)

/-! ## Nuclearity -/

/-- **Nuclearity of the reduced group C⋆-algebra**, as the completely
positive approximation property through matrix algebras. -/
def NuclearReducedCPAP (G : Type) [Group G] : Prop :=
  ∀ (F : Finset G) (ε : ℝ), 0 < ε →
    ∃ (k : ℕ)
      (down : ↥(reducedGroupCStarSubalgebra G) →ₗ[ℂ]
        (EuclideanSpace ℂ (Fin k) →L[ℂ] EuclideanSpace ℂ (Fin k)))
      (up : (EuclideanSpace ℂ (Fin k) →L[ℂ] EuclideanSpace ℂ (Fin k)) →ₗ[ℂ]
        (GroupHilbert G →L[ℂ] GroupHilbert G)),
      -- `down` is completely positive, in the quadratic-form sense
      (∀ (m : ℕ) (a : Fin m → ↥(reducedGroupCStarSubalgebra G))
        (v : Fin m → EuclideanSpace ℂ (Fin k)),
        0 ≤ (∑ i : Fin m, ∑ j : Fin m,
          ⟪v i, down (star (a i) * a j) (v j)⟫_ℂ).re) ∧
      (∀ c : ↥(reducedGroupCStarSubalgebra G),
        down (star c) = star (down c)) ∧
      down 1 = 1 ∧
      -- `up` is completely positive, unital, and lands back in the algebra
      IsCompletelyPositive up ∧ up 1 = 1 ∧
      (∀ T, up T ∈ reducedGroupCStarSubalgebra G) ∧
      -- the composite nearly fixes the named translations
      (∀ g ∈ F, ‖up (down ⟨leftRegularOperator G g,
          mem_reduced_leftRegularOperator g⟩)
        - leftRegularOperator G g‖ ≤ ε)

/-- **Lance's arrow.**  A discrete group whose reduced C⋆-algebra has the
completely positive approximation property carries an invariant mean. -/
theorem hasInvariantMean_of_nuclearReducedCPAP (G : Type) [Group G]
    (hnuc : NuclearReducedCPAP G) : HasInvariantMean G := by
  classical
  refine hasInvariantMean_of_cpApprox fun F ε hε ↦ ?_
  unfold NuclearReducedCPAP at hnuc
  obtain ⟨k, down, up, hform, hstar, hdone, hupcp, hupone, huprange,
    hclose⟩ := hnuc F ε hε
  -- extend `down` to all bounded operators
  obtain ⟨Ψ, hΨcp, hΨone, hΨext⟩ :=
    exists_ucp_extension (reducedGroupCStarSubalgebra G)
      isClosed_reducedGroupCStarSubalgebra down hform hstar hdone
  refine ⟨up ∘ₗ Ψ, hupcp.comp hΨcp, ?_, ?_, ?_⟩
  · show up (Ψ 1) = 1
    rw [hΨone, hupone]
  · intro T
    exact mem_groupVonNeumannAlgebra_of_mem_reduced (huprange _)
  · intro g hg
    have hmem : leftRegularOperator G g ∈ reducedGroupCStarSubalgebra G :=
      mem_reduced_leftRegularOperator g
    have hval : (up ∘ₗ Ψ) (leftRegularOperator G g)
        = up (down ⟨leftRegularOperator G g, hmem⟩) := by
      show up (Ψ (leftRegularOperator G g)) = _
      rw [hΨext ⟨leftRegularOperator G g, hmem⟩]
    rw [hval]
    exact hclose g hg

/-- **The manuscript's conclusion, unconditionally.**  The reduced
C⋆-algebra of the manuscript's group does not have the completely positive
approximation property. -/
theorem reducedGroupCStar_not_nuclear :
    ¬ NuclearReducedCPAP LiteralNonMFPresentation.MarkedGroup :=
  NuclearityAmenability.reducedGroupCStar_not_nuclear_of_lance
    NuclearReducedCPAP
    (fun H _ hn ↦ hasInvariantMean_of_nuclearReducedCPAP H hn)

end

end CStarExactness
end GroupApproximation
