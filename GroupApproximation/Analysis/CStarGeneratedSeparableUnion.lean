import GroupApproximation.Analysis.CStarGeneratedSeparableCountable

/-!
# Separability of a C-star algebra generated by two separable ranges
-/

namespace GroupApproximation

noncomputable section

universe u v w

/-- The closed star subalgebra generated by the ranges of two maps from
separable C-star algebras is separable, even when the ambient algebra is not. -/
theorem topologicalClosure_adjoin_union_range_separable
    {A : Type u} {B : Type v} {D : Type w}
    [CStarAlgebra A] [CStarAlgebra B] [CStarAlgebra D]
    [TopologicalSpace.SeparableSpace A]
    [TopologicalSpace.SeparableSpace B]
    (left : A →⋆ₐ[ℂ] D) (right : B →⋆ₐ[ℂ] D) :
    TopologicalSpace.SeparableSpace
      ((StarAlgebra.adjoin ℂ
        (Set.range left ∪ Set.range right)).topologicalClosure) := by
  let t : Set D :=
    left '' Set.range (TopologicalSpace.denseSeq A) ∪
      right '' Set.range (TopologicalSpace.denseSeq B)
  have ht : t.Countable :=
    ((Set.countable_range _).image left).union
      ((Set.countable_range _).image right)
  have hleft_continuous : Continuous left := by
    exact (LipschitzWith.of_dist_le_mul (K := 1) fun x y ↦ by
      rw [NNReal.coe_one, one_mul, dist_eq_norm, dist_eq_norm, ← map_sub]
      exact NonUnitalStarAlgHom.norm_apply_le left (x - y)).continuous
  have hright_continuous : Continuous right := by
    exact (LipschitzWith.of_dist_le_mul (K := 1) fun x y ↦ by
      rw [NNReal.coe_one, one_mul, dist_eq_norm, dist_eq_norm, ← map_sub]
      exact NonUnitalStarAlgHom.norm_apply_le right (x - y)).continuous
  have hleft_dense : Set.range left ⊆ closure t := by
    rintro _ ⟨a, rfl⟩
    exact closure_mono Set.subset_union_left <|
      image_closure_subset_closure_image
        hleft_continuous
          ⟨a, TopologicalSpace.denseRange_denseSeq A a, rfl⟩
  have hright_dense : Set.range right ⊆ closure t := by
    rintro _ ⟨b, rfl⟩
    exact closure_mono Set.subset_union_right <|
      image_closure_subset_closure_image
        hright_continuous
          ⟨b, TopologicalSpace.denseRange_denseSeq B b, rfl⟩
  have ht_subset : t ⊆ Set.range left ∪ Set.range right := by
    intro x hx
    rcases hx with hx | hx
    · rcases hx with ⟨a, _, rfl⟩
      exact Or.inl ⟨a, rfl⟩
    · rcases hx with ⟨b, _, rfl⟩
      exact Or.inr ⟨b, rfl⟩
  exact topologicalClosure_adjoin_separable_of_countable_dense
    (Set.range left ∪ Set.range right) t ht ht_subset
      (Set.union_subset hleft_dense hright_dense)

end

end GroupApproximation
