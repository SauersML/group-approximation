import GroupApproximation.Analysis.CStarOrderZero

/-!
# The supported picture of an order-zero map

Winter--Zacharias' structure theorem says that a c.p.c. order-zero map
`φ : A → B` is exactly a product

  `φ a = h · π a`,   `h` a positive contraction commuting with `π`,

for a `⋆`-homomorphism `π` from `A` into the multiplier algebra of the
C⋆-algebra generated by `φ(A)`.  **This file proves the direction that
constructs order-zero maps** --- every such product is c.p.c. and order zero
--- unconditionally and with no hypothesis on `A` or `B` beyond their being
C⋆-algebras.

The data is packaged as `OrderZeroSupport`, with `h` presented by a
selfadjoint contraction `root` and `h = root * root`.  Presenting the *square
root* rather than `h` itself is not a convenience: it is what makes complete
positivity provable by hand.  The Choi matrix of `a ↦ h · π a` is
`(h · π (Nᵢⱼ))ᵢⱼ`, and exhibiting it as `star P * P` requires splitting `h`
across the two factors as `root * root`; with only `h` in hand one would need
a continuous functional calculus square root, which is available in mathlib
but drags in an order instance the rest of this development does not carry.
A positive contraction always has such a root, so nothing is lost.

## Contents

* `OrderZeroSupport.map` --- the map `a ↦ root * root * π a`, as a `ℂ`-linear
  map;
* `OrderZeroSupport.map_mul_map` --- the product formula
  `φ a · φ b = root⁴ · π (a b)`, which is the algebraic heart: it shows at
  once that `φ` is *not* multiplicative and that it kills orthogonal pairs;
* `OrderZeroSupport.isOrderZero` --- the three clauses, proved;
* `OrderZeroSupport.scaleRoot` --- the cone deformation `root ↦ t · root`,
  which produces from one order-zero map a whole family, ending at the zero
  map at `t = 0`.  This is the reason the quasidiagonality argument uses
  order-zero maps rather than `⋆`-homomorphisms: `⋆`-homomorphisms are rigid,
  order-zero maps are contractible.

The **forward** direction of Winter--Zacharias --- that every order-zero map
arises this way --- is not proved here and is not used anywhere in this
development; it needs multiplier algebras.  It is recorded, with attribution,
in `Analysis.KirchbergRordamOrderZeroLift`.
-/

namespace GroupApproximation
namespace OrderZero

open CStarExactness

universe u v

variable {A : Type u} {B : Type v}
variable [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]

noncomputable section

/-- **The data supporting an order-zero map**: a selfadjoint contraction
`root` and a `⋆`-homomorphism `hom` whose range commutes with `root`.  The
supported map is `a ↦ root² · hom a`. -/
structure OrderZeroSupport (A : Type u) (B : Type v)
    [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] where
  /-- The square root of the positive contraction supporting the map. -/
  root : B
  /-- The `⋆`-homomorphism the map is built from. -/
  hom : A →⋆ₙₐ[ℂ] B
  /-- `root` is selfadjoint. -/
  root_isSelfAdjoint : IsSelfAdjoint root
  /-- `root` is a contraction; equivalently `root²` is a positive
  contraction. -/
  norm_root_le_one : ‖root‖ ≤ 1
  /-- `root` commutes with the range of `hom`. -/
  root_comm : ∀ a : A, root * hom a = hom a * root

namespace OrderZeroSupport

variable (S : OrderZeroSupport A B)

/-- The commutation relation, in the orientation the associativity juggling
below consumes it. -/
theorem hom_mul_root (a : A) : S.hom a * S.root = S.root * S.hom a :=
  (S.root_comm a).symm

/-- The commutation relation with a trailing factor: this is the form every
rewrite in the file uses, because products are right-associated first. -/
theorem hom_mul_root_mul (a : A) (z : B) :
    S.hom a * (S.root * z) = S.root * (S.hom a * z) := by
  rw [← mul_assoc, hom_mul_root, mul_assoc]

/-- **The supported map** `a ↦ root² · hom a`. -/
def map : A →ₗ[ℂ] B where
  toFun a := S.root * S.root * S.hom a
  map_add' a b := by rw [map_add, mul_add]
  map_smul' c a := by
    rw [map_smul, mul_smul_comm]
    rfl

@[simp] theorem map_apply (a : A) : S.map a = S.root * S.root * S.hom a := rfl

/-- **The product formula.**  Two values of a supported order-zero map
multiply to `root⁴ · hom (a b)`: the two copies of `root²` collect on the
left, because `root` commutes with the range of `hom`.

This single identity carries the whole point of the notion.  Taking `a b = 0`
gives orthogonality preservation; taking `a = b` shows the failure of
multiplicativity is exactly the discrepancy between `root²` and `root⁴`, which
is what a functional calculus on the supporting element can interpolate. -/
theorem map_mul_map (a b : A) :
    S.map a * S.map b
      = S.root * (S.root * (S.root * (S.root * S.hom (a * b)))) := by
  rw [map_apply, map_apply, map_mul]
  simp only [mul_assoc]
  rw [S.hom_mul_root_mul a (S.root * S.hom b), S.hom_mul_root_mul a (S.hom b)]

/-- A supported map preserves orthogonality --- and does so for *all* pairs
with vanishing product, not only positive ones. -/
theorem map_mul_map_eq_zero {a b : A} (hab : a * b = 0) :
    S.map a * S.map b = 0 := by
  rw [S.map_mul_map a b, hab, map_zero, mul_zero, mul_zero, mul_zero, mul_zero]

/-! ## Complete positivity -/

/-- The matrix witnessing complete positivity: `Pᵢⱼ = root · hom Nᵢⱼ`. -/
def choiWitness (n : ℕ) (N : CStarMatrix (Fin n) (Fin n) A) :
    CStarMatrix (Fin n) (Fin n) B :=
  CStarMatrix.ofMatrix (Matrix.of fun i j => S.root * S.hom (N i j))

theorem choiWitness_apply (n : ℕ) (N : CStarMatrix (Fin n) (Fin n) A)
    (i j : Fin n) : S.choiWitness n N i j = S.root * S.hom (N i j) := rfl

/-- The entrywise computation behind complete positivity: the `(i,j)` entry of
`star P * P` is `root² · hom ((star N * N)ᵢⱼ)`. -/
theorem star_choiWitness_mul_choiWitness_apply (n : ℕ)
    (N : CStarMatrix (Fin n) (Fin n) A) (i j : Fin n) :
    (star (S.choiWitness n N) * S.choiWitness n N) i j
      = S.root * (S.root * S.hom ((star N * N) i j)) := by
  have hterm : ∀ k : Fin n,
      (star (S.choiWitness n N)) i k * S.choiWitness n N k j
        = S.root * (S.root * S.hom (star (N k i) * N k j)) := by
    intro k
    rw [cstarMatrix_star_apply, choiWitness_apply, choiWitness_apply,
      star_mul, ← map_star, S.root_isSelfAdjoint.star_eq, mul_assoc,
      S.hom_mul_root_mul (star (N k i)) (S.root * S.hom (N k j)),
      S.hom_mul_root_mul (star (N k i)) (S.hom (N k j)), map_mul]
  have hsum : (∑ k : Fin n,
        (star (S.choiWitness n N)) i k * S.choiWitness n N k j)
      = ∑ k : Fin n, S.root * (S.root * S.hom (star (N k i) * N k j)) :=
    Finset.sum_congr rfl fun k _ => hterm k
  rw [cstarMatrix_mul_apply, hsum, ← Finset.mul_sum, ← Finset.mul_sum,
    ← map_sum, cstarMatrix_mul_apply]
  simp only [cstarMatrix_star_apply]

/-- **A supported map is completely positive.** -/
theorem isCompletelyPositive_map : IsCompletelyPositive S.map := by
  intro n M hM
  obtain ⟨N, rfl⟩ := hM
  refine ⟨S.choiWitness n N, ?_⟩
  ext i j
  rw [S.star_choiWitness_mul_choiWitness_apply n N i j]
  show S.root * S.root * S.hom ((star N * N) i j)
      = S.root * (S.root * S.hom ((star N * N) i j))
  rw [mul_assoc]

/-- **A supported map is a contraction**, because `root` is. -/
theorem norm_map_apply_le (a : A) : ‖S.map a‖ ≤ ‖a‖ := by
  have hr : ‖S.root‖ * ‖S.root‖ ≤ 1 := by
    nlinarith [norm_nonneg S.root, S.norm_root_le_one]
  calc ‖S.map a‖ = ‖S.root * S.root * S.hom a‖ := by rw [map_apply]
    _ ≤ ‖S.root * S.root‖ * ‖S.hom a‖ := norm_mul_le _ _
    _ ≤ (‖S.root‖ * ‖S.root‖) * ‖a‖ :=
        mul_le_mul (norm_mul_le _ _) (NonUnitalStarAlgHom.norm_apply_le S.hom a)
          (norm_nonneg _) (by positivity)
    _ ≤ 1 * ‖a‖ := mul_le_mul_of_nonneg_right hr (norm_nonneg a)
    _ = ‖a‖ := one_mul _

/-- **Every supported map is an order-zero map.**  This is the constructive
half of the Winter--Zacharias structure theorem, and it is the only half any
construction in this development needs. -/
theorem isOrderZero : IsOrderZero S.map where
  completelyPositive := S.isCompletelyPositive_map
  norm_apply_le := S.norm_map_apply_le
  orthogonal _ _ _ _ hab := S.map_mul_map_eq_zero hab

/-! ## The cone deformation -/

/-- **Scaling the support.**  Replacing `root` by `t · root` for a scalar of
modulus at most one gives another supported map; at `t = 0` it is the zero
map, and at `t = 1` it is the original.

This is the deformation that makes the *cone* over `A` --- rather than `A`
itself --- the natural domain of an order-zero map, and it is the mechanism by
which order-zero maps into a corona algebra can be homotoped, which
`⋆`-homomorphisms cannot. -/
def scaleRoot (t : ℝ) (ht : ‖(t : ℂ)‖ ≤ 1) : OrderZeroSupport A B where
  root := (t : ℂ) • S.root
  hom := S.hom
  root_isSelfAdjoint := by
    rw [IsSelfAdjoint, star_smul, Complex.star_def, Complex.conj_ofReal,
      S.root_isSelfAdjoint.star_eq]
  norm_root_le_one := by
    calc ‖(t : ℂ) • S.root‖ = ‖(t : ℂ)‖ * ‖S.root‖ := norm_smul _ _
      _ ≤ 1 * 1 := mul_le_mul ht S.norm_root_le_one (norm_nonneg _) zero_le_one
      _ = 1 := one_mul 1
  root_comm a := by
    rw [smul_mul_assoc, mul_smul_comm, S.root_comm a]

@[simp] theorem scaleRoot_apply (t : ℝ) (ht : ‖(t : ℂ)‖ ≤ 1) (a : A) :
    (S.scaleRoot t ht).map a
      = ((t : ℂ) • S.root) * ((t : ℂ) • S.root) * S.hom a := rfl

/-- At `t = 1` the deformation is the original map. -/
theorem scaleRoot_one (ht : ‖((1 : ℝ) : ℂ)‖ ≤ 1) (a : A) :
    (S.scaleRoot 1 ht).map a = S.map a := by
  rw [scaleRoot_apply, map_apply, Complex.ofReal_one, one_smul]

/-- At `t = 0` the deformation is the zero map. -/
theorem scaleRoot_zero (ht : ‖((0 : ℝ) : ℂ)‖ ≤ 1) (a : A) :
    (S.scaleRoot 0 ht).map a = 0 := by
  rw [scaleRoot_apply, Complex.ofReal_zero, zero_smul, zero_mul, zero_mul]

end OrderZeroSupport

/-! ## The two extreme cases -/

/-- A `⋆`-homomorphism is the supported map of the support with `root = 1`;
this is the sense in which order-zero maps interpolate between
`⋆`-homomorphisms and `0`. -/
def unitalSupport {A : Type u} {B : Type v} [NonUnitalCStarAlgebra A]
    [CStarAlgebra B] (f : A →⋆ₙₐ[ℂ] B) : OrderZeroSupport A B where
  root := 1
  hom := f
  root_isSelfAdjoint := by simp
  -- `‖(1 : B)‖ = 1` needs `B` nontrivial: in a C*-algebra `‖1‖ = ‖1‖ ^ 2`, so
  -- the unit has norm `1` unless the algebra is zero, where it has norm `0`.
  -- Both cases satisfy the contraction bound this field asks for.
  norm_root_le_one := by
    rcases subsingleton_or_nontrivial B with _ | _
    · simp [Subsingleton.elim (1 : B) 0]
    · exact le_of_eq norm_one
  root_comm a := by rw [one_mul, mul_one]

@[simp] theorem unitalSupport_map_apply {A : Type u} {B : Type v}
    [NonUnitalCStarAlgebra A] [CStarAlgebra B] (f : A →⋆ₙₐ[ℂ] B) (a : A) :
    (unitalSupport f).map a = f a := by
  show (1 : B) * 1 * f a = f a
  rw [one_mul, one_mul]

end

end OrderZero
end GroupApproximation
