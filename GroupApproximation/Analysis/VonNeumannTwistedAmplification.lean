/-!
# Tensoring a von Neumann algebra with a twisted group von Neumann algebra

Infrastructure of lane `oa-mcduff` for `simple_kazhdan_sofic_group.tex` at origin/main 37551fd93,
"Brown's formulation", tex 280–283 (census row `97438886a277`): "`L(G) ⊗̄ 𝓡` is a McDuff factor that
embeds in `𝓡^ω` and whose unitary group contains `G`".  The hyperfinite II₁ factor `𝓡` is the twisted
group von Neumann algebra `L_β(Γ)` of the Pauli group (lane oa-hyperfinite).

For a von Neumann algebra `M` on `H`, the space `H ⊗ ℓ²(Γ)` is `ℓ²(Γ; H)`, the square-summable
`H`-valued functions on `Γ`.  On it `x ⊗ 1` acts pointwise and `1 ⊗ λ_σ(g)` is the twisted translation
`(λ_g f)(h) = s(σ(g, g⁻¹h)) f(g⁻¹h)`.  The von Neumann algebra `M ⊗̄ L_σ(Γ)` is the double centralizer
of these operators and the adjoints of the translations.  Since `L_σ(Γ)` is the double centralizer of
the translations, this is the von Neumann algebra generated by `M ⊗ 1` and `1 ⊗ L_σ(Γ)`.  No completed
Hilbert tensor product is needed.

* `vecReindex e`, `vecSignMul s`: reindexing and `±1` multipliers of `ℓ²(α; H)`, as unitaries.
* `twistedShiftOperator σ g`: the twisted translation `1 ⊗ λ_σ(g)`.
* `ampOperator α x`: `x ⊗ 1`, pointwise; multiplicative, unital, star-preserving, injective.
* `tensorGenerators M σ`, `twistedTensor M σ`: the von Neumann algebra `M ⊗̄ L_σ(Γ)`.
* `unitaryAmp M σ`: `U ↦ U ⊗ 1`, an injective group homomorphism between unitary groups.
-/

namespace GroupApproximation
namespace TwistedTensor

open ReducedGroupCStarTrace TwistedGroupVonNeumann
open scoped ENNReal InnerProductSpace

noncomputable section

universe u v

variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- `ℓ²(α; H)`. -/
abbrev VecHilbert (α : Type u) (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :=
  lp (fun _ : α ↦ H) 2

/-! ## Reindexing and sign multipliers -/

section Reindex

variable {α β : Type u}

theorem memℓp_vec_comp_equiv (e : α ≃ β) (f : VecHilbert α H) :
    Memℓp (fun b : β ↦ f (e.symm b)) 2 := by
  apply memℓp_gen
  exact (Equiv.summable_iff e.symm).2 ((memℓp_gen_iff (by norm_num)).1 (lp.memℓp f))

/-- Reindexing `ℓ²(α; H)` along an equivalence, as a linear equivalence. -/
def vecReindexLinear (e : α ≃ β) : VecHilbert α H ≃ₗ[ℂ] VecHilbert β H where
  toFun f := ⟨fun b ↦ f (e.symm b), memℓp_vec_comp_equiv e f⟩
  invFun f := ⟨fun a ↦ f (e.symm.symm a), memℓp_vec_comp_equiv e.symm f⟩
  map_add' f g := by
    apply lp.ext
    funext b
    change (⇑(f + g)) (e.symm b) = f (e.symm b) + g (e.symm b)
    rw [lp.coeFn_add, Pi.add_apply]
  map_smul' c f := by
    apply lp.ext
    funext b
    change (⇑(c • f)) (e.symm b) = c • f (e.symm b)
    rw [lp.coeFn_smul, Pi.smul_apply]
  left_inv f := by
    apply lp.ext
    funext a
    change f (e.symm (e.symm.symm a)) = f a
    rw [Equiv.symm_symm, Equiv.symm_apply_apply]
  right_inv f := by
    apply lp.ext
    funext b
    change f (e.symm.symm (e.symm b)) = f b
    rw [Equiv.symm_symm, Equiv.apply_symm_apply]

/-- Reindexing `ℓ²(α; H)` along an equivalence is unitary. -/
def vecReindex (e : α ≃ β) : VecHilbert α H ≃ₗᵢ[ℂ] VecHilbert β H :=
  (vecReindexLinear e).isometryOfInner (by
    intro f g
    rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
    exact Equiv.tsum_eq e.symm fun a ↦ ⟪f a, g a⟫_ℂ)

@[simp]
theorem vecReindex_apply (e : α ≃ β) (f : VecHilbert α H) (b : β) :
    vecReindex e f b = f (e.symm b) :=
  rfl

end Reindex

section SignMul

variable {α : Type u}

theorem memℓp_vec_zsign_smul (s : α → ZMod 2) (f : VecHilbert α H) :
    Memℓp (fun a : α ↦ zsign (s a) • f a) 2 := by
  apply memℓp_gen
  have h := (memℓp_gen_iff (by norm_num)).1 (lp.memℓp f)
  simpa only [norm_smul, norm_zsign, one_mul] using h

theorem zsign_smul_zsign_smul_self (a : ZMod 2) (v : H) : zsign a • zsign a • v = v := by
  rw [smul_smul, zsign_mul_self, one_smul]

/-- Multiplication by a `±1`-valued function, as a linear equivalence of `ℓ²(α; H)`. -/
def vecSignMulLinear (s : α → ZMod 2) : VecHilbert α H ≃ₗ[ℂ] VecHilbert α H where
  toFun f := ⟨fun a ↦ zsign (s a) • f a, memℓp_vec_zsign_smul s f⟩
  invFun f := ⟨fun a ↦ zsign (s a) • f a, memℓp_vec_zsign_smul s f⟩
  map_add' f g := by
    apply lp.ext
    funext a
    change zsign (s a) • (⇑(f + g)) a = zsign (s a) • f a + zsign (s a) • g a
    rw [lp.coeFn_add, Pi.add_apply, smul_add]
  map_smul' c f := by
    apply lp.ext
    funext a
    change zsign (s a) • (⇑(c • f)) a = c • (zsign (s a) • f a)
    rw [lp.coeFn_smul, Pi.smul_apply, smul_comm]
  left_inv f := by
    apply lp.ext
    funext a
    change zsign (s a) • zsign (s a) • f a = f a
    exact zsign_smul_zsign_smul_self (s a) (f a)
  right_inv f := by
    apply lp.ext
    funext a
    change zsign (s a) • zsign (s a) • f a = f a
    exact zsign_smul_zsign_smul_self (s a) (f a)

/-- Multiplication by a `±1`-valued function is unitary. -/
def vecSignMul (s : α → ZMod 2) : VecHilbert α H ≃ₗᵢ[ℂ] VecHilbert α H :=
  (vecSignMulLinear s).isometryOfInner (by
    intro f g
    rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
    refine tsum_congr fun a ↦ ?_
    change ⟪zsign (s a) • f a, zsign (s a) • g a⟫_ℂ = ⟪f a, g a⟫_ℂ
    rw [inner_smul_left, inner_smul_right, star_zsign, ← mul_assoc, zsign_mul_self, one_mul])

@[simp]
theorem vecSignMul_apply (s : α → ZMod 2) (f : VecHilbert α H) (a : α) :
    vecSignMul s f a = zsign (s a) • f a :=
  rfl

end SignMul

/-! ## The twisted translations `1 ⊗ λ_σ(g)` -/

section Shift

variable {Γ : Type u} [Group Γ] (σ : Γ → Γ → ZMod 2)

/-- The twisted translation on `ℓ²(Γ; H)`: `(λ_g f)(h) = s(σ(g, g⁻¹h)) f(g⁻¹h)`. -/
def twistedShift (g : Γ) : VecHilbert Γ H ≃ₗᵢ[ℂ] VecHilbert Γ H :=
  (vecReindex (Equiv.mulLeft g)).trans (vecSignMul fun h ↦ σ g (g⁻¹ * h))

/-- The twisted translation `1 ⊗ λ_σ(g)` as a bounded operator. -/
def twistedShiftOperator (g : Γ) : VecHilbert Γ H →L[ℂ] VecHilbert Γ H :=
  (twistedShift σ g).toLinearIsometry.toContinuousLinearMap

@[simp]
theorem twistedShiftOperator_apply (g : Γ) (f : VecHilbert Γ H) (h : Γ) :
    twistedShiftOperator σ g f h = zsign (σ g (g⁻¹ * h)) • f (g⁻¹ * h) :=
  rfl

/-- The adjoint of a twisted translation is its inverse. -/
theorem star_twistedShiftOperator [CompleteSpace H] (g : Γ) :
    star (twistedShiftOperator (H := H) σ g) =
      ((twistedShift (H := H) σ g).symm : VecHilbert Γ H →L[ℂ] VecHilbert Γ H) := by
  rw [ContinuousLinearMap.star_eq_adjoint]
  exact LinearIsometryEquiv.adjoint_eq_symm (twistedShift (H := H) σ g)

end Shift

/-! ## The amplification `x ⊗ 1` -/

section Amp

variable {α : Type u}

theorem memℓp_amp (x : H →L[ℂ] H) (f : VecHilbert α H) : Memℓp (fun a : α ↦ x (f a)) 2 := by
  apply memℓp_gen
  have hf := (memℓp_gen_iff (by norm_num)).1 (lp.memℓp f)
  simp only [ENNReal.toReal_ofNat, Real.rpow_two] at hf ⊢
  refine Summable.of_nonneg_of_le (fun _ ↦ sq_nonneg _) (fun a ↦ ?_) (hf.mul_left (‖x‖ ^ 2))
  calc ‖x (f a)‖ ^ 2 ≤ (‖x‖ * ‖f a‖) ^ 2 := by
        gcongr
        exact x.le_opNorm (f a)
    _ = ‖x‖ ^ 2 * ‖f a‖ ^ 2 := mul_pow _ _ _

/-- `x ⊗ 1` on `ℓ²(α; H)`, as a linear map. -/
def ampLinear (x : H →L[ℂ] H) : VecHilbert α H →ₗ[ℂ] VecHilbert α H where
  toFun f := ⟨fun a ↦ x (f a), memℓp_amp x f⟩
  map_add' f g := by
    apply lp.ext
    funext a
    change x ((⇑(f + g)) a) = x (f a) + x (g a)
    rw [lp.coeFn_add, Pi.add_apply, map_add]
  map_smul' c f := by
    apply lp.ext
    funext a
    change x ((⇑(c • f)) a) = c • x (f a)
    rw [lp.coeFn_smul, Pi.smul_apply, map_smul]

theorem ampLinear_apply (x : H →L[ℂ] H) (f : VecHilbert α H) (a : α) :
    ampLinear x f a = x (f a) :=
  rfl

theorem norm_ampLinear_le (x : H →L[ℂ] H) (f : VecHilbert α H) :
    ‖ampLinear x f‖ ≤ ‖x‖ * ‖f‖ := by
  have hF := lp.norm_rpow_eq_tsum (by norm_num : 0 < (2 : ℝ≥0∞).toReal) (ampLinear x f)
  have hf := lp.norm_rpow_eq_tsum (by norm_num : 0 < (2 : ℝ≥0∞).toReal) f
  have hsf := (memℓp_gen_iff (by norm_num)).1 (lp.memℓp f)
  have hsF := (memℓp_gen_iff (by norm_num)).1 (lp.memℓp (ampLinear x f))
  simp only [ENNReal.toReal_ofNat, Real.rpow_two, ampLinear_apply] at hF hf hsf hsF
  have hle : ‖ampLinear x f‖ ^ 2 ≤ (‖x‖ * ‖f‖) ^ 2 := by
    rw [hF, mul_pow, hf, ← tsum_mul_left]
    refine Summable.tsum_le_tsum (fun a ↦ ?_) hsF (hsf.mul_left _)
    calc ‖x (f a)‖ ^ 2 ≤ (‖x‖ * ‖f a‖) ^ 2 := by
          gcongr
          exact x.le_opNorm (f a)
      _ = ‖x‖ ^ 2 * ‖f a‖ ^ 2 := mul_pow _ _ _
  exact (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp hle

/-- `x ⊗ 1` on `ℓ²(α; H)`. -/
def ampOperator (α : Type u) (x : H →L[ℂ] H) : VecHilbert α H →L[ℂ] VecHilbert α H :=
  (ampLinear x).mkContinuous ‖x‖ (norm_ampLinear_le x)

@[simp]
theorem ampOperator_apply (x : H →L[ℂ] H) (f : VecHilbert α H) (a : α) :
    ampOperator α x f a = x (f a) :=
  rfl

theorem ampOperator_mul (x y : H →L[ℂ] H) :
    ampOperator α (x * y) = ampOperator α x * ampOperator α y := by
  apply ContinuousLinearMap.ext
  intro f
  apply lp.ext
  funext a
  rfl

theorem ampOperator_one : ampOperator α (1 : H →L[ℂ] H) = 1 := by
  apply ContinuousLinearMap.ext
  intro f
  apply lp.ext
  funext a
  rfl

/-- `(x ⊗ 1)⋆ = x⋆ ⊗ 1`. -/
theorem star_ampOperator [CompleteSpace H] (x : H →L[ℂ] H) :
    star (ampOperator α x) = ampOperator α (star x) := by
  rw [ContinuousLinearMap.star_eq_adjoint]
  symm
  rw [ContinuousLinearMap.eq_adjoint_iff]
  intro f g
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
  refine tsum_congr fun a ↦ ?_
  change ⟪star x (f a), g a⟫_ℂ = ⟪f a, x (g a)⟫_ℂ
  rw [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_left]

/-- Over a nonempty index set, `x ↦ x ⊗ 1` is injective. -/
theorem ampOperator_injective [Nonempty α] :
    Function.Injective (ampOperator (H := H) α) := by
  intro x y hxy
  obtain ⟨a⟩ := ‹Nonempty α›
  classical
  apply ContinuousLinearMap.ext
  intro v
  have h1 : (ampOperator α x (lp.single 2 a v)) a = (ampOperator α y (lp.single 2 a v)) a := by
    rw [hxy]
  simpa only [ampOperator_apply, lp.single_apply_self] using h1

end Amp

/-! ## The von Neumann algebra `M ⊗̄ L_σ(Γ)` -/

section Tensor

variable [CompleteSpace H] {Γ : Type u} [Group Γ]

/-- The generators of `M ⊗̄ L_σ(Γ)`: `x ⊗ 1` for `x ∈ M`, and the twisted translations and their
adjoints. -/
def tensorGenerators (M : VonNeumannAlgebra H) (σ : Γ → Γ → ZMod 2) :
    Set (VecHilbert Γ H →L[ℂ] VecHilbert Γ H) :=
  ampOperator Γ '' (M : Set (H →L[ℂ] H)) ∪
    (Set.range (twistedShiftOperator (H := H) σ) ∪
      Set.range fun g ↦ star (twistedShiftOperator (H := H) σ g))

theorem star_mem_tensorGenerators {M : VonNeumannAlgebra H} {σ : Γ → Γ → ZMod 2}
    {a : VecHilbert Γ H →L[ℂ] VecHilbert Γ H} (ha : a ∈ tensorGenerators M σ) :
    star a ∈ tensorGenerators M σ := by
  rcases ha with ⟨x, hx, rfl⟩ | ⟨g, rfl⟩ | ⟨g, rfl⟩
  · exact Set.mem_union_left _
      ⟨star x, SetLike.mem_coe.mpr (star_mem (SetLike.mem_coe.mp hx)), (star_ampOperator x).symm⟩
  · exact Set.mem_union_right _ (Set.mem_union_right _ ⟨g, rfl⟩)
  · exact Set.mem_union_right _ (Set.mem_union_left _ ⟨g, (star_star _).symm⟩)

/-- **`M ⊗̄ L_σ(Γ)`**, as a von Neumann algebra on `ℓ²(Γ; H) = H ⊗ ℓ²(Γ)`. -/
def twistedTensor (M : VonNeumannAlgebra H) (σ : Γ → Γ → ZMod 2) :
    VonNeumannAlgebra (VecHilbert Γ H) where
  toStarSubalgebra :=
    { Subalgebra.centralizer ℂ (Set.centralizer (tensorGenerators M σ)) with
      star_mem' := fun {_} ha ↦
        Set.star_mem_centralizer'
          (fun _ hb ↦ Set.star_mem_centralizer'
            (fun _ hm ↦ star_mem_tensorGenerators hm) hb) ha }
  centralizer_centralizer' :=
    Set.centralizer_centralizer_centralizer (Set.centralizer (tensorGenerators M σ))

theorem generator_mem {M : VonNeumannAlgebra H} {σ : Γ → Γ → ZMod 2}
    {a : VecHilbert Γ H →L[ℂ] VecHilbert Γ H} (ha : a ∈ tensorGenerators M σ) :
    a ∈ twistedTensor M σ :=
  Set.subset_centralizer_centralizer ha

/-- `x ⊗ 1 ∈ M ⊗̄ L_σ(Γ)` for `x ∈ M`. -/
theorem ampOperator_mem {M : VonNeumannAlgebra H} (σ : Γ → Γ → ZMod 2) {x : H →L[ℂ] H}
    (hx : x ∈ M) : ampOperator Γ x ∈ twistedTensor M σ :=
  generator_mem (Set.mem_union_left _ ⟨x, hx, rfl⟩)

/-- `1 ⊗ λ_σ(g) ∈ M ⊗̄ L_σ(Γ)`. -/
theorem twistedShiftOperator_mem (M : VonNeumannAlgebra H) (σ : Γ → Γ → ZMod 2) (g : Γ) :
    twistedShiftOperator (H := H) σ g ∈ twistedTensor M σ :=
  generator_mem (Set.mem_union_right _ (Set.mem_union_left _ ⟨g, rfl⟩))

theorem coe_star_mul_self_of_unitary {M : VonNeumannAlgebra H} (U : unitary ↥M.toStarSubalgebra) :
    star ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) * ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) = 1 :=
  congrArg Subtype.val (Unitary.coe_star_mul_self U)

theorem coe_mul_star_self_of_unitary {M : VonNeumannAlgebra H} (U : unitary ↥M.toStarSubalgebra) :
    ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) * star ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) = 1 :=
  congrArg Subtype.val (Unitary.coe_mul_star_self U)

/-- **`U ↦ U ⊗ 1`** from the unitary group of `M` to the unitary group of `M ⊗̄ L_σ(Γ)`. -/
def unitaryAmp (M : VonNeumannAlgebra H) (σ : Γ → Γ → ZMod 2) :
    unitary ↥M.toStarSubalgebra →* unitary ↥(twistedTensor M σ).toStarSubalgebra where
  toFun U := ⟨⟨ampOperator Γ ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H),
      ampOperator_mem σ (U : ↥M.toStarSubalgebra).2⟩, by
    rw [Unitary.mem_iff]
    constructor
    · apply Subtype.ext
      change star (ampOperator Γ ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H)) *
          ampOperator Γ ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) = 1
      rw [star_ampOperator, ← ampOperator_mul, coe_star_mul_self_of_unitary U, ampOperator_one]
    · apply Subtype.ext
      change ampOperator Γ ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) *
          star (ampOperator Γ ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H)) = 1
      rw [star_ampOperator, ← ampOperator_mul, coe_mul_star_self_of_unitary U, ampOperator_one]⟩
  map_one' := by
    apply Subtype.ext
    apply Subtype.ext
    change ampOperator Γ (1 : H →L[ℂ] H) = 1
    exact ampOperator_one
  map_mul' U V := by
    apply Subtype.ext
    apply Subtype.ext
    change ampOperator Γ (((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) *
        ((V : ↥M.toStarSubalgebra) : H →L[ℂ] H)) =
      ampOperator Γ ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) *
        ampOperator Γ ((V : ↥M.toStarSubalgebra) : H →L[ℂ] H)
    exact ampOperator_mul _ _

theorem coe_unitaryAmp (M : VonNeumannAlgebra H) (σ : Γ → Γ → ZMod 2)
    (U : unitary ↥M.toStarSubalgebra) :
    (((unitaryAmp M σ U : unitary ↥(twistedTensor M σ).toStarSubalgebra) :
        ↥(twistedTensor M σ).toStarSubalgebra) : VecHilbert Γ H →L[ℂ] VecHilbert Γ H) =
      ampOperator Γ ((U : ↥M.toStarSubalgebra) : H →L[ℂ] H) :=
  rfl

/-- **`U ↦ U ⊗ 1` is injective.** -/
theorem unitaryAmp_injective (M : VonNeumannAlgebra H) (σ : Γ → Γ → ZMod 2) :
    Function.Injective (unitaryAmp M σ) := by
  intro U V hUV
  apply Subtype.ext
  apply Subtype.ext
  apply ampOperator_injective (H := H) (α := Γ)
  rw [← coe_unitaryAmp M σ U, ← coe_unitaryAmp M σ V, hUV]

end Tensor

end

end TwistedTensor
end GroupApproximation

#audit_axioms GroupApproximation.TwistedTensor.unitaryAmp_injective
#audit_axioms GroupApproximation.TwistedTensor.ampOperator_mem
