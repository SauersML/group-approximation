import GroupApproximation.Analysis.ReducedGroupCStarTrace
import Mathlib.Analysis.InnerProductSpace.Adjoint

/-!
# A non-unitary isometry of `ℓ²` over an infinite index type

Sixth module of the `LI.06d` lane (`p:limits-trace`).  The printed sentence
says the algebra generated by the two standard-form actions "need not be
finite": the generated algebra is all of `B(L²)`, and `B(ℓ²)` over an
infinite index type is **not** finite, because it contains an isometry that is
not a unitary.  This module builds that isometry, with no group structure on
the index: shift the `ℕ`-chain of `Infinite.natEmbedding`, fix everything
else, and extend by zero on `ℓ²`.

* `shiftMap` — an injective, non-surjective self-map of any infinite type.
* `shiftFun`, `shiftLinear`, `shiftIsometry` — extension by zero along
  `shiftMap`, as an isometric linear map of `ℓ²`.
* `exists_isometry_not_unitary` — `V⋆V = 1` while `VV⋆ ≠ 1`: the adjoint
  identity is `inner_map_map_iff_adjoint_comp_self`, and the failure of
  `VV⋆ = 1` is visible at the missed point mass, where every vector in the
  range of `V` vanishes.
-/

namespace GroupApproximation
namespace ShiftIsometry

open scoped ENNReal InnerProductSpace

noncomputable section

universe u

variable {Γ : Type u} [Infinite Γ]

local instance : DecidableEq Γ := Classical.decEq Γ

/-! ## The shift injection -/

/-- Shift the `ℕ`-chain of `Infinite.natEmbedding`, fix everything else. -/
def shiftMap (Γ : Type u) [Infinite Γ] : Γ → Γ :=
  Function.extend (⇑(Infinite.natEmbedding Γ))
    (fun k ↦ Infinite.natEmbedding Γ (k + 1)) id

theorem shiftMap_natEmbedding (k : ℕ) :
    shiftMap Γ (Infinite.natEmbedding Γ k) = Infinite.natEmbedding Γ (k + 1) :=
  (Infinite.natEmbedding Γ).injective.extend_apply _ _ _

theorem shiftMap_of_not_mem {x : Γ}
    (hx : ¬ ∃ k, Infinite.natEmbedding Γ k = x) : shiftMap Γ x = x := by
  rw [shiftMap, Function.extend_apply' _ _ _ hx]
  rfl

theorem shiftMap_injective (Γ : Type u) [Infinite Γ] :
    Function.Injective (shiftMap Γ) := by
  intro x y hxy
  by_cases hx : ∃ k, Infinite.natEmbedding Γ k = x
  · obtain ⟨k, rfl⟩ := hx
    by_cases hy : ∃ j, Infinite.natEmbedding Γ j = y
    · obtain ⟨j, rfl⟩ := hy
      rw [shiftMap_natEmbedding, shiftMap_natEmbedding] at hxy
      have hkj : k + 1 = j + 1 := (Infinite.natEmbedding Γ).injective hxy
      exact congrArg (Infinite.natEmbedding Γ) (by omega)
    · rw [shiftMap_natEmbedding, shiftMap_of_not_mem hy] at hxy
      exact (hy ⟨k + 1, hxy⟩).elim
  · by_cases hy : ∃ j, Infinite.natEmbedding Γ j = y
    · obtain ⟨j, rfl⟩ := hy
      rw [shiftMap_of_not_mem hx, shiftMap_natEmbedding] at hxy
      exact (hx ⟨j + 1, hxy.symm⟩).elim
    · rw [shiftMap_of_not_mem hx, shiftMap_of_not_mem hy] at hxy
      exact hxy

/-- The base point of the chain is missed: the shift is not surjective. -/
theorem shiftMap_not_surjective (Γ : Type u) [Infinite Γ] :
    ¬ ∃ x, shiftMap Γ x = Infinite.natEmbedding Γ 0 := by
  rintro ⟨x, hx⟩
  by_cases hxr : ∃ k, Infinite.natEmbedding Γ k = x
  · obtain ⟨k, rfl⟩ := hxr
    rw [shiftMap_natEmbedding] at hx
    exact Nat.succ_ne_zero k ((Infinite.natEmbedding Γ).injective hx)
  · rw [shiftMap_of_not_mem hxr] at hx
    exact hxr ⟨0, hx.symm⟩

/-! ## Extension by zero along the shift -/

theorem memℓp_extend (f : lp (fun _ : Γ ↦ ℂ) 2) :
    Memℓp (Function.extend (shiftMap Γ) (⇑f) 0) 2 := by
  apply memℓp_gen
  have ht : (2 : ℝ≥0∞).toReal ≠ 0 := by simp
  have hnorm : (fun y : Γ ↦
      ‖Function.extend (shiftMap Γ) (⇑f) 0 y‖ ^ (2 : ℝ≥0∞).toReal)
      = Function.extend (shiftMap Γ)
          (fun x ↦ ‖f x‖ ^ (2 : ℝ≥0∞).toReal) 0 := by
    funext y
    rcases em (∃ x, shiftMap Γ x = y) with ⟨x, rfl⟩ | hy
    · rw [(shiftMap_injective Γ).extend_apply,
        (shiftMap_injective Γ).extend_apply]
    · rw [Function.extend_apply' _ _ _ hy, Function.extend_apply' _ _ _ hy]
      simp only [Pi.zero_apply, norm_zero]
      rw [Real.zero_rpow ht]
  rw [hnorm]
  have hcomp : (Function.extend (shiftMap Γ)
        (fun x ↦ ‖f x‖ ^ (2 : ℝ≥0∞).toReal) 0) ∘ shiftMap Γ
      = fun x ↦ ‖f x‖ ^ (2 : ℝ≥0∞).toReal :=
    funext fun x ↦ (shiftMap_injective Γ).extend_apply _ _ _
  refine ((shiftMap_injective Γ).summable_iff (fun y hy ↦ ?_)).mp ?_
  · rw [Function.extend_apply' _ _ _ (by simpa using hy)]
    rfl
  · rw [hcomp]
    exact (memℓp_gen_iff (by norm_num)).1 (lp.memℓp f)

/-- Extension by zero along the shift, as a map of `ℓ²`. -/
def shiftFun (f : lp (fun _ : Γ ↦ ℂ) 2) : lp (fun _ : Γ ↦ ℂ) 2 :=
  ⟨Function.extend (shiftMap Γ) (⇑f) 0, memℓp_extend f⟩

theorem shiftFun_apply_shift (f : lp (fun _ : Γ ↦ ℂ) 2) (x : Γ) :
    shiftFun f (shiftMap Γ x) = f x :=
  (shiftMap_injective Γ).extend_apply _ _ _

theorem shiftFun_apply_off (f : lp (fun _ : Γ ↦ ℂ) 2) {y : Γ}
    (hy : ¬ ∃ x, shiftMap Γ x = y) : shiftFun f y = 0 := by
  show Function.extend (shiftMap Γ) (⇑f) 0 y = 0
  rw [Function.extend_apply' _ _ _ hy]
  rfl

/-- The shift as a linear map. -/
def shiftLinear : lp (fun _ : Γ ↦ ℂ) 2 →ₗ[ℂ] lp (fun _ : Γ ↦ ℂ) 2 where
  toFun := shiftFun
  map_add' f g := by
    apply lp.ext
    funext y
    rcases em (∃ x, shiftMap Γ x = y) with ⟨x, rfl⟩ | hy
    · simp only [lp.coeFn_add, Pi.add_apply, shiftFun_apply_shift]
    · simp only [lp.coeFn_add, Pi.add_apply, shiftFun_apply_off _ hy, add_zero]
  map_smul' c f := by
    apply lp.ext
    funext y
    rcases em (∃ x, shiftMap Γ x = y) with ⟨x, rfl⟩ | hy
    · simp only [lp.coeFn_smul, Pi.smul_apply, shiftFun_apply_shift,
        RingHom.id_apply]
    · simp only [lp.coeFn_smul, Pi.smul_apply, shiftFun_apply_off _ hy,
        smul_zero, RingHom.id_apply]

@[simp]
theorem shiftLinear_apply (f : lp (fun _ : Γ ↦ ℂ) 2) :
    shiftLinear f = shiftFun f :=
  rfl

/-- The shift preserves inner products. -/
theorem inner_shiftFun (f g : lp (fun _ : Γ ↦ ℂ) 2) :
    ⟪shiftFun f, shiftFun g⟫_ℂ = ⟪f, g⟫_ℂ := by
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum]
  have hfun : (fun y : Γ ↦ ⟪shiftFun f y, shiftFun g y⟫_ℂ)
      = Function.extend (shiftMap Γ) (fun x ↦ ⟪f x, g x⟫_ℂ) 0 := by
    funext y
    rcases em (∃ x, shiftMap Γ x = y) with ⟨x, rfl⟩ | hy
    · rw [(shiftMap_injective Γ).extend_apply, shiftFun_apply_shift,
        shiftFun_apply_shift]
    · rw [Function.extend_apply' _ _ _ hy, shiftFun_apply_off _ hy,
        shiftFun_apply_off _ hy]
      simp
  rw [hfun]
  exact tsum_eq_tsum_of_hasSum_iff_hasSum fun {a} ↦
    hasSum_extend_zero (shiftMap_injective Γ)

/-- The shift as a linear isometry. -/
def shiftIsometry : lp (fun _ : Γ ↦ ℂ) 2 →ₗᵢ[ℂ] lp (fun _ : Γ ↦ ℂ) 2 :=
  shiftLinear.isometryOfInner fun f g ↦ inner_shiftFun f g

/-! ## `B(ℓ²)` is not finite -/

/-- **A non-unitary isometry of `ℓ²` over an infinite index type**: the shift
satisfies `V⋆V = 1` but `VV⋆ ≠ 1`, so the bounded operators do not form a
finite von Neumann algebra. -/
theorem exists_isometry_not_unitary (Γ : Type u) [Infinite Γ] :
    ∃ V : lp (fun _ : Γ ↦ ℂ) 2 →L[ℂ] lp (fun _ : Γ ↦ ℂ) 2,
      star V * V = 1 ∧ V * star V ≠ 1 := by
  refine ⟨(shiftIsometry (Γ := Γ)).toContinuousLinearMap, ?_, ?_⟩
  · rw [ContinuousLinearMap.star_eq_adjoint]
    exact (ContinuousLinearMap.inner_map_map_iff_adjoint_comp_self _).mp
      fun f g ↦ inner_shiftFun f g
  · intro hVV
    have hmiss := shiftMap_not_surjective Γ
    have hzero : ((shiftIsometry (Γ := Γ)).toContinuousLinearMap *
        star (shiftIsometry (Γ := Γ)).toContinuousLinearMap)
          (lp.single 2 (Infinite.natEmbedding Γ 0) (1 : ℂ))
          (Infinite.natEmbedding Γ 0) = 0 :=
      shiftFun_apply_off _ hmiss
    have hone : ((shiftIsometry (Γ := Γ)).toContinuousLinearMap *
        star (shiftIsometry (Γ := Γ)).toContinuousLinearMap)
          (lp.single 2 (Infinite.natEmbedding Γ 0) (1 : ℂ))
          (Infinite.natEmbedding Γ 0) = 1 := by
      rw [hVV]
      exact lp.single_apply_self 2 (Infinite.natEmbedding Γ 0) 1
    rw [hzero] at hone
    exact zero_ne_one hone

end

end ShiftIsometry
end GroupApproximation
