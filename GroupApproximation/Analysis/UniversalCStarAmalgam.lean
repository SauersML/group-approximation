import GroupApproximation.Analysis.MFAlgebra
import Mathlib.Analysis.CStarAlgebra.Hom
import Mathlib.Analysis.CStarAlgebra.lpSpace

/-!
# A universe-relative universal full C-star amalgam

For unital complex C-star algebras `C`, `A`, and `B` and star-algebra
homomorphisms `iA : C → A`, `iB : C → B`, this file constructs the full
amalgamated free product from first principles.  Its ambient algebra is the
bounded product of all same-universe compatible pairs of representations; the
universal amalgam is the closed star subalgebra generated by the two diagonal
factor maps.

Only the universal C-star object and its universal property are proved here.
The compatible-corona MF permanence theorem is a separate analytic step.  The
construction is immediately consumed by the two-by-two corner model of
`UniversalCStarHNN`.
-/

namespace GroupApproximation

open scoped CStarAlgebra ENNReal

noncomputable section

universe u

variable {C A B : Type u} [CStarAlgebra C] [CStarAlgebra A] [CStarAlgebra B]
variable (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)

/-- A same-universe compatible pair of representations of an amalgam datum. -/
structure CStarAmalgamRepresentation where
  carrier : Type u
  instCStarAlgebra : CStarAlgebra carrier
  instNontrivial : Nontrivial carrier
  left : letI : CStarAlgebra carrier := instCStarAlgebra
    A →⋆ₐ[ℂ] carrier
  right : letI : CStarAlgebra carrier := instCStarAlgebra
    B →⋆ₐ[ℂ] carrier
  compatible : letI : CStarAlgebra carrier := instCStarAlgebra
    left.comp iA = right.comp iB

namespace CStarAmalgamRepresentation

instance (R : CStarAmalgamRepresentation iA iB) : CStarAlgebra R.carrier :=
  R.instCStarAlgebra

instance (R : CStarAmalgamRepresentation iA iB) : Nontrivial R.carrier :=
  R.instNontrivial

/-- Package one compatible pair on a nontrivial same-universe target. -/
def ofCompatiblePair {E : Type u} [CStarAlgebra E] [Nontrivial E]
    (left : A →⋆ₐ[ℂ] E) (right : B →⋆ₐ[ℂ] E)
    (h : left.comp iA = right.comp iB) :
    CStarAmalgamRepresentation iA iB where
  carrier := E
  instCStarAlgebra := inferInstance
  instNontrivial := inferInstance
  left := left
  right := right
  compatible := h

end CStarAmalgamRepresentation

/-- The bounded product of all compatible representations. -/
abbrev UniversalCStarAmalgamAmbient :=
  lp (fun R : CStarAmalgamRepresentation iA iB ↦ R.carrier) ∞

noncomputable instance universalCStarAmalgamAmbientCStarAlgebra
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    CStarAlgebra (UniversalCStarAmalgamAmbient iA iB) where
  toNormedRing := inferInstance
  toStarRing := inferInstance
  toCompleteSpace := inferInstance
  toCStarRing := inferInstance
  toNormedAlgebra := inferInstance
  toStarModule := inferInstance

/-- The diagonal representation of the left factor. -/
def universalCStarAmalgamLeftAmbient
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    A →⋆ₐ[ℂ] UniversalCStarAmalgamAmbient iA iB where
  toFun a := ⟨fun R ↦ R.left a, memℓp_infty ⟨‖a‖, by
    rintro _ ⟨R, rfl⟩
    exact NonUnitalStarAlgHom.norm_apply_le R.left a⟩⟩
  map_one' := by apply lp.ext; funext R; exact map_one R.left
  map_mul' _ _ := by apply lp.ext; funext R; exact map_mul R.left _ _
  map_zero' := by apply lp.ext; funext R; exact map_zero R.left
  map_add' _ _ := by apply lp.ext; funext R; exact map_add R.left _ _
  commutes' _ := by apply lp.ext; funext R; exact R.left.commutes _
  map_star' _ := by apply lp.ext; funext R; exact map_star R.left _

/-- The diagonal representation of the right factor. -/
def universalCStarAmalgamRightAmbient
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    B →⋆ₐ[ℂ] UniversalCStarAmalgamAmbient iA iB where
  toFun b := ⟨fun R ↦ R.right b, memℓp_infty ⟨‖b‖, by
    rintro _ ⟨R, rfl⟩
    exact NonUnitalStarAlgHom.norm_apply_le R.right b⟩⟩
  map_one' := by apply lp.ext; funext R; exact map_one R.right
  map_mul' _ _ := by apply lp.ext; funext R; exact map_mul R.right _ _
  map_zero' := by apply lp.ext; funext R; exact map_zero R.right
  map_add' _ _ := by apply lp.ext; funext R; exact map_add R.right _ _
  commutes' _ := by apply lp.ext; funext R; exact R.right.commutes _
  map_star' _ := by apply lp.ext; funext R; exact map_star R.right _

/-- The closed star subalgebra generated by both factor maps. -/
def universalCStarAmalgamSubalgebra
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    StarSubalgebra ℂ (UniversalCStarAmalgamAmbient iA iB) :=
  (StarAlgebra.adjoin ℂ
    (Set.range (universalCStarAmalgamLeftAmbient iA iB) ∪
      Set.range (universalCStarAmalgamRightAmbient iA iB))).topologicalClosure

/-- The universe-relative universal full C-star amalgam. -/
abbrev UniversalCStarAmalgam
    [Nonempty (CStarAmalgamRepresentation iA iB)] : Type (u + 1) :=
  universalCStarAmalgamSubalgebra iA iB

instance universalCStarAmalgam_isClosed
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    IsClosed (universalCStarAmalgamSubalgebra iA iB :
      Set (UniversalCStarAmalgamAmbient iA iB)) :=
  StarSubalgebra.isClosed_topologicalClosure _

noncomputable instance universalCStarAmalgamCStarAlgebra
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    CStarAlgebra (UniversalCStarAmalgam iA iB) :=
  inferInstance

/-- The canonical left-factor map. -/
def universalCStarAmalgamLeft
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    A →⋆ₐ[ℂ] UniversalCStarAmalgam iA iB where
  toFun a := ⟨universalCStarAmalgamLeftAmbient iA iB a,
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨a, rfl⟩))⟩
  map_one' := Subtype.ext (map_one (universalCStarAmalgamLeftAmbient iA iB))
  map_mul' _ _ := Subtype.ext (map_mul (universalCStarAmalgamLeftAmbient iA iB) _ _)
  map_zero' := Subtype.ext (map_zero (universalCStarAmalgamLeftAmbient iA iB))
  map_add' _ _ := Subtype.ext (map_add (universalCStarAmalgamLeftAmbient iA iB) _ _)
  commutes' _ := Subtype.ext ((universalCStarAmalgamLeftAmbient iA iB).commutes _)
  map_star' _ := Subtype.ext (map_star (universalCStarAmalgamLeftAmbient iA iB) _)

/-- The canonical right-factor map. -/
def universalCStarAmalgamRight
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    B →⋆ₐ[ℂ] UniversalCStarAmalgam iA iB where
  toFun b := ⟨universalCStarAmalgamRightAmbient iA iB b,
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inr ⟨b, rfl⟩))⟩
  map_one' := Subtype.ext (map_one (universalCStarAmalgamRightAmbient iA iB))
  map_mul' _ _ := Subtype.ext (map_mul (universalCStarAmalgamRightAmbient iA iB) _ _)
  map_zero' := Subtype.ext (map_zero (universalCStarAmalgamRightAmbient iA iB))
  map_add' _ _ := Subtype.ext (map_add (universalCStarAmalgamRightAmbient iA iB) _ _)
  commutes' _ := Subtype.ext ((universalCStarAmalgamRightAmbient iA iB).commutes _)
  map_star' _ := Subtype.ext (map_star (universalCStarAmalgamRightAmbient iA iB) _)

/-- The two canonical maps agree on the amalgamated algebra. -/
theorem universalCStarAmalgam_compatible
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    (universalCStarAmalgamLeft iA iB).comp iA =
      (universalCStarAmalgamRight iA iB).comp iB := by
  apply StarAlgHom.ext
  intro c
  apply Subtype.ext
  apply lp.ext
  funext R
  exact congrArg (fun f : C →⋆ₐ[ℂ] R.carrier ↦ f c) R.compatible

/-- Evaluation at one compatible-representation coordinate. -/
def universalCStarAmalgamEval
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    (R : CStarAmalgamRepresentation iA iB) :
    UniversalCStarAmalgam iA iB →⋆ₐ[ℂ] R.carrier :=
  ({ toFun := fun f ↦ f R
     map_one' := rfl
     map_mul' := fun _ _ ↦ rfl
     map_zero' := rfl
     map_add' := fun _ _ ↦ rfl
     commutes' := fun _ ↦ rfl
     map_star' := fun _ ↦ rfl } :
      UniversalCStarAmalgamAmbient iA iB →⋆ₐ[ℂ] R.carrier).comp
    (universalCStarAmalgamSubalgebra iA iB).subtype

@[simp] theorem universalCStarAmalgamEval_left
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    (R : CStarAmalgamRepresentation iA iB) (a : A) :
    universalCStarAmalgamEval iA iB R
        (universalCStarAmalgamLeft iA iB a) = R.left a :=
  rfl

@[simp] theorem universalCStarAmalgamEval_right
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    (R : CStarAmalgamRepresentation iA iB) (b : B) :
    universalCStarAmalgamEval iA iB R
        (universalCStarAmalgamRight iA iB b) = R.right b :=
  rfl

/-- The coordinate evaluations are jointly faithful. -/
theorem universalCStarAmalgam_eq_of_forall_eval_eq
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    {x y : UniversalCStarAmalgam iA iB}
    (h : ∀ R : CStarAmalgamRepresentation iA iB,
      universalCStarAmalgamEval iA iB R x =
        universalCStarAmalgamEval iA iB R y) :
    x = y := by
  apply Subtype.ext
  apply lp.ext
  funext R
  exact h R

/-- A compatible coordinate faithful on the left factor makes the canonical
left-factor map faithful. -/
theorem universalCStarAmalgamLeft_injective_of_coordinate
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    (R : CStarAmalgamRepresentation iA iB)
    (hR : Function.Injective R.left) :
    Function.Injective (universalCStarAmalgamLeft iA iB) := by
  intro a a' haa
  apply hR
  have := congrArg (universalCStarAmalgamEval iA iB R) haa
  simpa using this

/-- A compatible coordinate faithful on the right factor makes the canonical
right-factor map faithful. -/
theorem universalCStarAmalgamRight_injective_of_coordinate
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    (R : CStarAmalgamRepresentation iA iB)
    (hR : Function.Injective R.right) :
    Function.Injective (universalCStarAmalgamRight iA iB) := by
  intro b b' hbb
  apply hR
  have := congrArg (universalCStarAmalgamEval iA iB R) hbb
  simpa using this

/-- Universal property of the concrete full C-star amalgam. -/
theorem universalCStarAmalgam_existsUnique_lift
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    {E : Type u} [CStarAlgebra E] [Nontrivial E]
    (left : A →⋆ₐ[ℂ] E) (right : B →⋆ₐ[ℂ] E)
    (h : left.comp iA = right.comp iB) :
    ∃! f : UniversalCStarAmalgam iA iB →⋆ₐ[ℂ] E,
      (∀ a : A, f (universalCStarAmalgamLeft iA iB a) = left a) ∧
      (∀ b : B, f (universalCStarAmalgamRight iA iB b) = right b) := by
  let R := CStarAmalgamRepresentation.ofCompatiblePair iA iB left right h
  let f := universalCStarAmalgamEval iA iB R
  refine ⟨f, ⟨fun _ ↦ rfl, fun _ ↦ rfl⟩, ?_⟩
  intro q hq
  apply StarAlgHom.ext_topologicalClosure
      (R := ℂ) (A := UniversalCStarAmalgamAmbient iA iB) (B := E)
      (map_continuous q) (map_continuous f)
  apply StarAlgHom.ext_adjoin
  intro x hx
  rcases hx with hx | hx
  · obtain ⟨a, ha⟩ := hx
    have hx' : x =
        ⟨universalCStarAmalgamLeftAmbient iA iB a,
          StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨a, rfl⟩)⟩ := by
      apply Subtype.ext
      exact ha.symm
    rw [hx']
    exact hq.1 a
  · obtain ⟨b, hb⟩ := hx
    have hx' : x =
        ⟨universalCStarAmalgamRightAmbient iA iB b,
          StarAlgebra.subset_adjoin ℂ _ (Or.inr ⟨b, rfl⟩)⟩ := by
      apply Subtype.ext
      exact hb.symm
    rw [hx']
    exact hq.2 b

end

end GroupApproximation
