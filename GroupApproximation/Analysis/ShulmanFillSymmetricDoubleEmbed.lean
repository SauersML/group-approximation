import GroupApproximation.Analysis.ShulmanSymmetricDoubleRoute
import GroupApproximation.Analysis.MFAlgebraSymmetricDoubleIdentity
import GroupApproximation.Analysis.ShulmanFillUnitalCorner
import GroupApproximation.Manuscript.OneSidedMFRadical.HNNCoronaConjugatorSentenceAudit

/-!
# Assembling Theorem 16 on the symmetric-double route

`Analysis/ShulmanSymmetricDoubleRoute` records Shulman's own proof of Theorem
16 as two named inputs and one formal composition.  This module carries out the
composition against the printed criterion: it unitalizes the corona pair, picks
the intermediate algebra `D`, and derives
`HNNPermanence.ShulmanTheorem16Statement`.

## Correction: Theorem 13 is not formal

An earlier reading of this lane recorded Theorem 13 as "formal, no
approximation", inferred from the shape of its statement.  That is wrong.
Shulman attributes Theorem 13 to

LITERATURE INPUT: D. Enders and T. Shulman, *On the (Local) Lifting Property*,
arXiv:2403.12224, Theorem 4.11,

and their proof is analytic.  It fixes an embedding `α : A *_C B → B(H)` that
stays injective after the Calkin quotient, extends `α_A` off `φ_A(A)` to a ccp
map on `D` by the **Arveson extension theorem**, dilates that to a
`*`-homomorphism `σ_A` by the **Stinespring dilation theorem**, does the same
for `B`, and then uses **Voiculescu's theorem** to find unitaries making
`σ_A ∘ φ_A` and `σ_B ∘ φ_B` agree on `ι_A(C)` in the Calkin algebra.  The
resulting `γ : D *_C D → Q(H^∞)` makes the diagram commute, and injectivity of
`φ_A * φ_B` follows.

So the symmetric-double route carries **two** literature inputs, not one:
Theorem 10 (`SymmetricDoubleMFStatement`) and Theorem 13
(`AmalgamEmbedsSymmetricDoubleStatement`).  Nothing below reduces their number.
The corresponding non-formal ingredient of the norming route is the single
step 5 of `Analysis/ShulmanFillConjugatePair`.  Which route is cheaper is a
question about which of these the repository can reach, not about how many
sorries the assembly shows.

Lemma 15 of Shulman, `A⁺ *_{C⁺} B⁺ = (A *_C B)⁺` (Enders--Shulman, Lemma 4.4),
is not used here: the printed criterion allows non-unital corona embeddings,
and `Analysis/CompatibleCoronaSupportCorner` already unitalizes them by passing
to the common support corner, which is the cheaper of the two routes named in
the lane brief.

This module is in the root import list.  It was authored while builds were
suspended and has not been elaborated.
-/

namespace GroupApproximation
namespace ShulmanSymmetricDouble

open ShulmanFill
open MFAlgebraAmalgamCriterion

noncomputable section

/-! ## Theorem 16 from the two inputs

`Nonempty (CStarAmalgamRepresentation k k)` for the symmetric double is the
peer lane's `MFAlgebraAmalgamCriterion.symmetricAmalgamRepresentationNonempty`,
built from the identity pair; nothing is restated here. -/

/-- **Shulman's Theorem 16 on his own route.**  The printed criterion follows
from Theorem 10 and Theorem 13.  The steps are: unitalize the corona pair on
its common support corner; take `D` to be the corona algebra generated by the
two unital images, which is separable and MF; embed the amalgam into `D *_C D`
by Theorem 13; and conclude by Theorem 10 and heredity of MF along a faithful
`*`-homomorphism. -/
theorem shulmanTheorem16_of_symmetricDouble
    (hDouble : SymmetricDoubleMFStatement)
    (hEmbed : AmalgamEmbedsSymmetricDoubleStatement) :
    Manuscript.MFRecognition.HNNPermanence.ShulmanTheorem16Statement := by
  intro C A₁ A₂ _ _ _ iA iB _ hC hA₁ hA₂ Y _ phiA phiB hphiA hphiB hcomp
  haveI : TopologicalSpace.SeparableSpace A₁ := hA₁
  haveI : TopologicalSpace.SeparableSpace A₂ := hA₂
  haveI : Nontrivial A₁ := nontrivial_left_of_nonempty_representation iA iB
  -- Step 0: replace the non-unital pair by a unital one on the support corner.
  obtain ⟨Z, hZ, l, r, hl, hr, hlr⟩ :=
    CompatibleCoronaSupportCorner.exists_compatible_injective_unital_supportCornerEmbeddings
      Y iA iB phiA phiB hphiA hphiB (by ext c; exact hcomp c)
  letI : ∀ n, Nonempty (Z n) := hZ
  -- Step 1: the intermediate algebra `D`, with its C-star structure.
  letI : CStarAlgebra (compatibleGeneratedSubalgebra Z l r) :=
    compatibleGeneratedCStarAlgebra Z l r
  obtain ⟨hinjL, hinjR⟩ := compatibleGenerated_factor_injective Z l r hl hr
  haveI : Nontrivial (compatibleGeneratedSubalgebra Z l r) := by
    obtain ⟨x, y, hxy⟩ := exists_pair_ne A₁
    exact ⟨⟨leftToCompatibleGenerated Z l r x, leftToCompatibleGenerated Z l r y,
      fun h ↦ hxy (hinjL h)⟩⟩
  -- `D` is MF: a separable subalgebra of a norm corona.
  have hDsep : TopologicalSpace.SeparableSpace
      (compatibleGeneratedSubalgebra Z l r) :=
    compatibleGenerated_separableSpace Z l r
  have hDmf : IsMFAlgebra (compatibleGeneratedSubalgebra Z l r) := by
    refine ⟨hDsep, ?_⟩
    refine (Manuscript.OneSidedMFRadical.HNNCoronaConjugatorSentenceAudit.normMatrixCorona_hasMFEmbedding_of_positive
        Z hZ).of_injective_nonUnitalStarAlgHom
      (compatibleGeneratedSubalgebra Z l r).subtype.toNonUnitalStarAlgHom ?_
    intro x y h
    exact Subtype.ext h
  -- Step 2: the common map of `C` into `D`.
  set k : C →⋆ₐ[ℂ] compatibleGeneratedSubalgebra Z l r :=
    (leftToCompatibleGenerated Z l r).comp iA
  have hkA : ∀ c : C, leftToCompatibleGenerated Z l r (iA c) = k c := fun _ ↦ rfl
  have hkB : ∀ c : C, rightToCompatibleGenerated Z l r (iB c) = k c := by
    intro c
    exact (DFunLike.congr_fun (compatibleGenerated_comp_eq iA iB Z l r hlr) c).symm
  -- Step 3: Theorem 13, then Theorem 10, then heredity.
  obtain ⟨e, he⟩ :=
    hEmbed iA iB k (leftToCompatibleGenerated Z l r)
      (rightToCompatibleGenerated Z l r) hC hinjL hinjR hkA hkB
  exact isMFAlgebra_of_injective_into_symmetricDouble (hDouble k hDmf) e he

end

end ShulmanSymmetricDouble
end GroupApproximation
