import GroupApproximation.Kazhdan.KazhdanOrthogonal
import GroupApproximation.Kazhdan.KazhdanFiniteGeneration

/-!
# Finite quotients of a Kazhdan group: the Cheeger estimate

This module proves the estimate behind "Since $\EL_3(F)$ has property (T), its finite quotients form
a family of expanders" (`simple_kazhdan_sofic_group.tex`, section "Finite models").

* `exists_isKazhdanPair_of_closure_eq_top`: if a group has a Kazhdan pair, then every finite
  generating set is a Kazhdan set for some positive tolerance.  Displacement is subadditive along
  products and invariant under inversion, so an element of word length `n` moves a vector by at most
  `n` times the largest displacement by the generators.
* `leftTranslation π`: for `π : Γ →* Q`, the orthogonal representation `(g · f)(b) = f(π(g)⁻¹ b)`
  of `Γ` on real `ℓ²(Q)`.
* `centredIndicator A = 1_A - (|A|/|Q|)·1`.  When `π` is onto, invariant vectors are constant, so the
  centred indicator is orthogonal to them.  Its squared norm times `|Q|` is `|A|(|Q| - |A|)`, and its
  squared displacement by `g` is `2·#{a ∈ A : π(g) a ∉ A}`.
* `kazhdanPair_quotient_boundary`: for a Kazhdan pair `(S, δ)` and a surjection onto a finite group,
  every nonempty `A` with `2|A| ≤ |Q|` has some `s ∈ S` with `#{a ∈ A : π(s) a ∉ A} ≥ (δ²/4)|A|`.

The expander family itself is stated in the manuscript's spelling (`SimpleKazhdanSofic.IsExpanderFamily`)
in `Manuscript/SimpleKazhdanSofic/KazhdanQuotientExpanders`.
-/

set_option linter.unusedSectionVars false

namespace GroupApproximation
namespace KazhdanQuotientCheeger

open scoped ENNReal InnerProductSpace

universe u v

/-! ## Displacement along words -/

section Displacement

variable {G : Type u} [Group G] {E : Type v} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Displacement is subadditive along products. -/
theorem norm_map_mul_sub_le (ρ : G →* (E ≃ₗᵢ[ℝ] E)) (g h : G) (x : E) :
    ‖ρ (g * h) x - x‖ ≤ ‖ρ g x - x‖ + ‖ρ h x - x‖ := by
  have hmul : ρ (g * h) x = ρ g (ρ h x) :=
    congrArg (fun T : E ≃ₗᵢ[ℝ] E ↦ T x) (map_mul ρ g h)
  have hsplit : ρ (g * h) x - x = ρ g (ρ h x - x) + (ρ g x - x) := by
    rw [hmul, map_sub]
    abel
  rw [hsplit]
  calc ‖ρ g (ρ h x - x) + (ρ g x - x)‖ ≤ ‖ρ g (ρ h x - x)‖ + ‖ρ g x - x‖ := norm_add_le _ _
    _ = ‖ρ h x - x‖ + ‖ρ g x - x‖ := by rw [LinearIsometryEquiv.norm_map]
    _ = ‖ρ g x - x‖ + ‖ρ h x - x‖ := add_comm _ _

/-- Displacement is invariant under inversion. -/
theorem norm_map_inv_sub (ρ : G →* (E ≃ₗᵢ[ℝ] E)) (g : G) (x : E) :
    ‖ρ g⁻¹ x - x‖ = ‖ρ g x - x‖ := by
  have hinv : ρ g⁻¹ (ρ g x) = x := by simp
  calc ‖ρ g⁻¹ x - x‖ = ‖ρ g⁻¹ x - ρ g⁻¹ (ρ g x)‖ := by rw [hinv]
    _ = ‖ρ g⁻¹ (x - ρ g x)‖ := by rw [map_sub]
    _ = ‖x - ρ g x‖ := LinearIsometryEquiv.norm_map _ _
    _ = ‖ρ g x - x‖ := norm_sub_rev _ _

end Displacement

section Generating

variable {G : Type u} [Group G]

/-- An element of the subgroup generated by `S` moves every vector by at most a fixed multiple of
the largest displacement by the elements of `S`, uniformly over all orthogonal representations. -/
theorem exists_displacement_bound_of_mem_closure (S : Finset G) {g : G}
    (hg : g ∈ Subgroup.closure (S : Set G)) :
    ∃ n : ℕ, ∀ (E : Type v) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
      (ρ : G →* (E ≃ₗᵢ[ℝ] E)) (x : E) (δ : ℝ),
        (∀ s ∈ S, ‖ρ s x - x‖ ≤ δ) → ‖ρ g x - x‖ ≤ n * δ := by
  induction hg using Subgroup.closure_induction with
  | mem s hs => exact ⟨1, fun E _ _ ρ x δ hx ↦ by simpa using hx s hs⟩
  | one => exact ⟨0, fun E _ _ ρ x δ _ ↦ by simp⟩
  | mul a b _ _ iha ihb =>
      obtain ⟨m, hm⟩ := iha
      obtain ⟨n, hn⟩ := ihb
      refine ⟨m + n, fun E _ _ ρ x δ hx ↦ ?_⟩
      have h1 := hm E ρ x δ hx
      have h2 := hn E ρ x δ hx
      have h3 := norm_map_mul_sub_le ρ a b x
      rw [Nat.cast_add, add_mul]
      linarith
  | inv a _ iha =>
      obtain ⟨m, hm⟩ := iha
      exact ⟨m, fun E _ _ ρ x δ hx ↦ by rw [norm_map_inv_sub]; exact hm E ρ x δ hx⟩

/-- **Every finite generating set of a Kazhdan group is a Kazhdan set.**  If `(Q, ε)` is a Kazhdan
pair and the finite set `S` generates `G`, then `(S, δ)` is a Kazhdan pair for some `δ`. -/
theorem exists_isKazhdanPair_of_closure_eq_top {Q : Finset G} {ε : ℝ}
    (hQ : IsKazhdanPair.{u, v} G Q ε) (S : Finset G)
    (hS : Subgroup.closure (S : Set G) = ⊤) :
    ∃ δ : ℝ, IsKazhdanPair.{u, v} G S δ := by
  classical
  have hbound : ∀ q ∈ Q, ∃ n : ℕ, ∀ (E : Type v) [NormedAddCommGroup E]
      [InnerProductSpace ℝ E] (ρ : G →* (E ≃ₗᵢ[ℝ] E)) (x : E) (δ : ℝ),
        (∀ s ∈ S, ‖ρ s x - x‖ ≤ δ) → ‖ρ q x - x‖ ≤ n * δ := fun q _ ↦
    exists_displacement_bound_of_mem_closure S (by rw [hS]; exact Subgroup.mem_top q)
  choose! n hn using hbound
  obtain ⟨N, hNpos, hN⟩ : ∃ N : ℕ, 0 < N ∧ ∀ q ∈ Q, n q < N :=
    ⟨∑ q ∈ Q, n q + 1, Nat.succ_pos _, fun q hq ↦
      Nat.lt_succ_of_le (Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) hq)⟩
  have hNreal : (0 : ℝ) < N := by exact_mod_cast hNpos
  have htol : 0 < ε / N := div_pos hQ.1 hNreal
  refine ⟨ε / N, htol, ?_⟩
  intro E _ _ _ ρ x hx hnear
  apply hQ.2 E ρ x hx
  intro q hq
  have hle : ∀ s ∈ S, ‖ρ s x - x‖ ≤ ε / N := fun s hs ↦ (hnear s hs).le
  have h1 := hn q hq E ρ x (ε / N) hle
  have hnq : (n q : ℝ) < N := by exact_mod_cast hN q hq
  have hcancel : (N : ℝ) * (ε / N) = ε := by
    field_simp
  calc ‖ρ q x - x‖ ≤ n q * (ε / N) := h1
    _ < N * (ε / N) := mul_lt_mul_of_pos_right hnq htol
    _ = ε := hcancel

end Generating

/-! ## Left translation on `ℓ²` of a quotient -/

section Translation

variable {Γ : Type u} [Group Γ] {Q : Type v} [Group Q]

/-- Left translation through a homomorphism, as an orthogonal representation on real `ℓ²(Q)`:
`(g · f)(b) = f(π(g)⁻¹ b)`. -/
noncomputable def leftTranslation (π : Γ →* Q) :
    Γ →* (lp (fun _ : Q ↦ ℝ) 2 ≃ₗᵢ[ℝ] lp (fun _ : Q ↦ ℝ) 2) where
  toFun g := KazhdanFiniteGeneration.lpCongrLeft (Equiv.mulLeft (π g))
  map_one' := by
    apply LinearIsometryEquiv.ext
    intro f
    apply lp.ext
    funext b
    change f ((Equiv.mulLeft (π 1)).symm b) = f b
    simp only [map_one, Equiv.mulLeft_symm, Equiv.coe_mulLeft, inv_one, one_mul]
  map_mul' g h := by
    apply LinearIsometryEquiv.ext
    intro f
    apply lp.ext
    funext b
    change f ((Equiv.mulLeft (π (g * h))).symm b) =
      f ((Equiv.mulLeft (π h)).symm ((Equiv.mulLeft (π g)).symm b))
    simp only [map_mul, Equiv.mulLeft_symm, Equiv.coe_mulLeft, mul_inv_rev, mul_assoc]

theorem leftTranslation_apply (π : Γ →* Q) (g : Γ) (f : lp (fun _ : Q ↦ ℝ) 2) (b : Q) :
    leftTranslation π g f b = f ((π g)⁻¹ * b) := by
  change f ((Equiv.mulLeft (π g)).symm b) = f ((π g)⁻¹ * b)
  simp only [Equiv.mulLeft_symm, Equiv.coe_mulLeft]

/-- When `π` is onto, an invariant vector of left translation is constant. -/
theorem eq_one_of_mem_invariantSubmodule (π : Γ →* Q) (hπ : Function.Surjective π)
    {f : lp (fun _ : Q ↦ ℝ) 2}
    (hf : f ∈ KazhdanOrthogonal.invariantSubmodule (leftTranslation π)) (b : Q) :
    f b = f 1 := by
  obtain ⟨g, hg⟩ := hπ b⁻¹
  have h := congrArg (fun z : lp (fun _ : Q ↦ ℝ) 2 ↦ z 1)
    ((KazhdanOrthogonal.mem_invariantSubmodule _ f).1 hf g)
  simp only [leftTranslation_apply, hg, inv_inv, mul_one] at h
  exact h

end Translation

/-! ## The centred indicator -/

section Indicator

variable {Q : Type v} [Fintype Q] [DecidableEq Q]

/-- The squared `ℓ²` norm over a finite index type is the finite sum of squares. -/
theorem norm_sq_eq_sum (f : lp (fun _ : Q ↦ ℝ) 2) : ‖f‖ ^ 2 = ∑ b, f b ^ 2 := by
  have hp : (0 : ℝ) < (2 : ℝ≥0∞).toReal := by norm_num
  have h := lp.hasSum_norm hp f
  have htwo : ((2 : ℝ≥0∞).toReal) = (2 : ℝ) := by norm_num
  have hfun : (fun i : Q ↦ ‖f i‖ ^ (2 : ℝ≥0∞).toReal) = fun i : Q ↦ (f i) ^ 2 := by
    funext i
    rw [htwo, Real.rpow_two, Real.norm_eq_abs, sq_abs]
  have hval : ‖f‖ ^ (2 : ℝ≥0∞).toReal = ‖f‖ ^ 2 := by
    rw [htwo, Real.rpow_two]
  rw [hfun, hval] at h
  exact h.unique (hasSum_fintype _)

/-- The real indicator of a finite set. -/
def ind (A : Finset Q) (b : Q) : ℝ := if b ∈ A then 1 else 0

/-- The number of elements of `A`, as a sum of indicator values. -/
theorem sum_ind (A : Finset Q) : ∑ b : Q, ind A b = A.card := by
  simp only [ind]
  rw [Finset.sum_boole]
  congr 2
  ext b
  simp

variable [Group Q]

/-- The centred indicator `1_A - (|A|/|Q|)·1` of a finite set, as a vector of real `ℓ²(Q)`. -/
noncomputable def centredIndicator (A : Finset Q) : lp (fun _ : Q ↦ ℝ) 2 :=
  ⟨fun b ↦ ind A b - (A.card : ℝ) / Fintype.card Q, memℓp_gen (hasSum_fintype _).summable⟩

theorem centredIndicator_apply (A : Finset Q) (b : Q) :
    centredIndicator A b = ind A b - (A.card : ℝ) / Fintype.card Q :=
  rfl

/-- The centred indicator has coordinate sum zero. -/
theorem sum_centredIndicator (A : Finset Q) : ∑ b, centredIndicator A b = 0 := by
  have hq : (Fintype.card Q : ℝ) ≠ 0 := by
    exact_mod_cast (Fintype.card_pos_iff.mpr ⟨(1 : Q)⟩).ne'
  have hc : (Fintype.card Q : ℝ) * ((A.card : ℝ) / Fintype.card Q) = A.card := by
    field_simp
  simp only [centredIndicator_apply, Finset.sum_sub_distrib, sum_ind, Finset.sum_const,
    Finset.card_univ, nsmul_eq_mul]
  rw [hc, sub_self]

/-- The squared norm of the centred indicator: `‖1_A - (|A|/|Q|)·1‖²·|Q| = |A|(|Q| - |A|)`. -/
theorem norm_centredIndicator_sq_mul (A : Finset Q) :
    ‖centredIndicator A‖ ^ 2 * Fintype.card Q = A.card * (Fintype.card Q - A.card) := by
  have hq : (Fintype.card Q : ℝ) ≠ 0 := by
    exact_mod_cast (Fintype.card_pos_iff.mpr ⟨(1 : Q)⟩).ne'
  have hc : (A.card : ℝ) / Fintype.card Q * Fintype.card Q = A.card := by
    field_simp
  have hpt : ∀ b : Q, (centredIndicator A b) ^ 2 =
      ind A b * (1 - 2 * ((A.card : ℝ) / Fintype.card Q)) +
        ((A.card : ℝ) / Fintype.card Q) ^ 2 := by
    intro b
    rw [centredIndicator_apply]
    by_cases hb : b ∈ A
    · rw [show ind A b = 1 from if_pos hb]
      ring
    · rw [show ind A b = 0 from if_neg hb]
      ring
  rw [norm_sq_eq_sum, Finset.sum_congr rfl fun b _ ↦ hpt b, Finset.sum_add_distrib,
    ← Finset.sum_mul, sum_ind, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  linear_combination ((A.card : ℝ) / Fintype.card Q * Fintype.card Q - A.card) * hc

variable {Γ : Type u} [Group Γ]

/-- The centred indicator is orthogonal to the invariant vectors of left translation through a
surjection. -/
theorem centredIndicator_mem_orthogonal (π : Γ →* Q) (hπ : Function.Surjective π) (A : Finset Q) :
    centredIndicator A ∈ (KazhdanOrthogonal.invariantSubmodule (leftTranslation π))ᗮ := by
  rw [Submodule.mem_orthogonal]
  intro f hf
  rw [lp.inner_eq_tsum, tsum_fintype]
  have hconst := eq_one_of_mem_invariantSubmodule π hπ hf
  have hterm : ∀ b : Q, ⟪f b, centredIndicator A b⟫_ℝ = f 1 * centredIndicator A b := by
    intro b
    rw [Real.inner_apply, hconst b]
  rw [Finset.sum_congr rfl fun b _ ↦ hterm b, ← Finset.mul_sum, sum_centredIndicator, mul_zero]

/-- The squared displacement of the centred indicator by left translation is twice the number of
elements of `A` that `π(g)` moves out of `A`. -/
theorem norm_leftTranslation_centredIndicator_sub_sq (π : Γ →* Q) (g : Γ) (A : Finset Q) :
    ‖leftTranslation π g (centredIndicator A) - centredIndicator A‖ ^ 2 =
      2 * ((A.filter fun a ↦ π g * a ∉ A).card : ℝ) := by
  rw [norm_sq_eq_sum]
  have hval : ∀ b : Q, (leftTranslation π g (centredIndicator A) - centredIndicator A) b =
      ind A ((π g)⁻¹ * b) - ind A b := by
    intro b
    rw [lp.coeFn_sub, Pi.sub_apply, leftTranslation_apply, centredIndicator_apply,
      centredIndicator_apply]
    ring
  have hre : ∑ b : Q, (ind A ((π g)⁻¹ * b) - ind A b) ^ 2 =
      ∑ b : Q, (ind A b - ind A (π g * b)) ^ 2 :=
    calc ∑ b : Q, (ind A ((π g)⁻¹ * b) - ind A b) ^ 2
        = ∑ b : Q, (fun c : Q ↦ (ind A c - ind A (π g * c)) ^ 2)
            (Equiv.mulLeft (π g)⁻¹ b) := by
          refine Finset.sum_congr rfl fun b _ ↦ ?_
          simp only [Equiv.coe_mulLeft, mul_inv_cancel_left]
      _ = ∑ b : Q, (ind A b - ind A (π g * b)) ^ 2 :=
          Equiv.sum_comp (Equiv.mulLeft (π g)⁻¹) fun c : Q ↦ (ind A c - ind A (π g * c)) ^ 2
  have hpt : ∀ b : Q, (ind A b - ind A (π g * b)) ^ 2 =
      ind A b + ind A (π g * b) - 2 * (if b ∈ A ∧ π g * b ∈ A then (1 : ℝ) else 0) := by
    intro b
    by_cases h1 : b ∈ A <;> by_cases h2 : π g * b ∈ A <;> norm_num [ind, h1, h2]
  have hshift : ∑ b : Q, ind A (π g * b) = A.card :=
    (Equiv.sum_comp (Equiv.mulLeft (π g)) (ind A)).trans (sum_ind A)
  have hboth : ∑ b : Q, (if b ∈ A ∧ π g * b ∈ A then (1 : ℝ) else 0) =
      ((A.filter fun a ↦ π g * a ∈ A).card : ℝ) := by
    rw [Finset.sum_boole]
    congr 2
    ext b
    simp
  have hsplit := Finset.card_filter_add_card_filter_not (s := A) (fun a ↦ π g * a ∈ A)
  have hcast : ((A.filter fun a ↦ π g * a ∈ A).card : ℝ) +
      ((A.filter fun a ↦ ¬ π g * a ∈ A).card : ℝ) = A.card := by
    exact_mod_cast hsplit
  simp only [hval]
  rw [hre, Finset.sum_congr rfl fun b _ ↦ hpt b, Finset.sum_sub_distrib, Finset.sum_add_distrib,
    ← Finset.mul_sum, sum_ind, hshift, hboth]
  linarith

/-- **The Kazhdan quotient estimate.**  If `(S, δ)` is a Kazhdan pair for `Γ` and `π : Γ → Q` is onto
a finite group, then every nonempty `A ⊆ Q` with `2|A| ≤ |Q|` has some `s ∈ S` moving at least
`(δ²/4)|A|` elements of `A` out of `A`. -/
theorem kazhdanPair_quotient_boundary {S : Finset Γ} {δ : ℝ}
    (hS : IsKazhdanPair.{u, v} Γ S δ) (π : Γ →* Q) (hπ : Function.Surjective π)
    (A : Finset Q) (hne : A.Nonempty) (hA : 2 * A.card ≤ Fintype.card Q) :
    ∃ s ∈ S, δ ^ 2 / 4 * A.card ≤ ((A.filter fun a ↦ π s * a ∉ A).card : ℝ) := by
  have hq : (0 : ℝ) < Fintype.card Q := by
    exact_mod_cast Fintype.card_pos_iff.mpr ⟨(1 : Q)⟩
  have ha : (0 : ℝ) < A.card := by exact_mod_cast Finset.card_pos.mpr hne
  have hA' : (2 * A.card : ℝ) ≤ Fintype.card Q := by exact_mod_cast hA
  have hkey := norm_centredIndicator_sq_mul A
  have hhalf : (A.card : ℝ) / 2 ≤ ‖centredIndicator A‖ ^ 2 := by
    have h2 : (A.card : ℝ) / 2 * Fintype.card Q ≤ ‖centredIndicator A‖ ^ 2 * Fintype.card Q := by
      rw [hkey]
      nlinarith [mul_nonneg ha.le (sub_nonneg.mpr hA')]
    exact le_of_mul_le_mul_right h2 hq
  have hv0 : centredIndicator A ≠ 0 := by
    intro h0
    rw [h0, norm_zero] at hhalf
    linarith
  obtain ⟨s, hs, hmove⟩ := KazhdanOrthogonal.exists_moved_mul_norm_of_mem_orthogonal hS
    (leftTranslation π) (centredIndicator_mem_orthogonal π hπ A) hv0
  refine ⟨s, hs, ?_⟩
  have hsq := norm_leftTranslation_centredIndicator_sub_sq π s A
  have hmove2 : (δ * ‖centredIndicator A‖) ^ 2 ≤
      ‖leftTranslation π s (centredIndicator A) - centredIndicator A‖ ^ 2 :=
    pow_le_pow_left₀ (mul_nonneg hS.1.le (norm_nonneg _)) hmove 2
  rw [hsq, mul_pow] at hmove2
  have hstep : δ ^ 2 * ((A.card : ℝ) / 2) ≤ δ ^ 2 * ‖centredIndicator A‖ ^ 2 :=
    mul_le_mul_of_nonneg_left hhalf (sq_nonneg δ)
  linarith

end Indicator

end KazhdanQuotientCheeger
end GroupApproximation
