import GroupApproximation.Analysis.MFAlgebraAmalgamCriterion

/-!
# The faithful-evaluation boundary for C-star amalgam MF permanence

The compatible-corona construction produces an evaluation of the universal
amalgam, but that evaluation is not generally faithful.  This module records
the exact consequence available once faithfulness has been established.
-/

namespace GroupApproximation
namespace MFAlgebraAmalgamCriterion

noncomputable section

variable {C A B : Type}
  [CStarAlgebra C] [CStarAlgebra A] [CStarAlgebra B]
  (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)

/-- The universal full amalgam of two separable factors is separable.  The
ambient bounded product is generally nonseparable; separability comes from
the fact that the universal amalgam is generated by the two factor ranges. -/
theorem universalCStarAmalgam_separableSpace
    [TopologicalSpace.SeparableSpace A]
    [TopologicalSpace.SeparableSpace B]
    [Nonempty (CStarAmalgamRepresentation iA iB)] :
    TopologicalSpace.SeparableSpace (UniversalCStarAmalgam iA iB) := by
  change TopologicalSpace.SeparableSpace
    ((StarAlgebra.adjoin ℂ
      (Set.range (universalCStarAmalgamLeftAmbient iA iB) ∪
        Set.range (universalCStarAmalgamRightAmbient iA iB))).topologicalClosure)
  exact topologicalClosure_adjoin_union_range_separable
    (universalCStarAmalgamLeftAmbient iA iB)
    (universalCStarAmalgamRightAmbient iA iB)

/-- An evaluation coordinate which is faithful on the universal amalgam
transfers MF embeddability from its target to the amalgam. -/
theorem universalCStarAmalgam_isMFAlgebra_of_faithful_eval
    [TopologicalSpace.SeparableSpace A]
    [TopologicalSpace.SeparableSpace B]
    [Nonempty (CStarAmalgamRepresentation iA iB)]
    (R : CStarAmalgamRepresentation iA iB)
    (hR : HasMFEmbedding R.carrier)
    (hfaithful : Function.Injective
      (universalCStarAmalgamEval iA iB R)) :
    IsMFAlgebra (UniversalCStarAmalgam iA iB) := by
  refine ⟨universalCStarAmalgam_separableSpace iA iB, ?_⟩
  exact hR.of_injective_nonUnitalStarAlgHom
    (universalCStarAmalgamEval iA iB R).toNonUnitalStarAlgHom hfaithful

/-- Self-amalgam specialization of
`universalCStarAmalgam_isMFAlgebra_of_faithful_eval`. -/
theorem universalCStarSelfAmalgam_isMFAlgebra_of_faithful_eval
    {C A : Type} [CStarAlgebra C] [CStarAlgebra A]
    [TopologicalSpace.SeparableSpace A]
    (i : C →⋆ₐ[ℂ] A)
    [Nonempty (CStarAmalgamRepresentation i i)]
    (R : CStarAmalgamRepresentation i i)
    (hR : HasMFEmbedding R.carrier)
    (hfaithful : Function.Injective
      (universalCStarAmalgamEval i i R)) :
    IsMFAlgebra (UniversalCStarAmalgam i i) :=
  universalCStarAmalgam_isMFAlgebra_of_faithful_eval
    i i R hR hfaithful

end

end MFAlgebraAmalgamCriterion
end GroupApproximation
