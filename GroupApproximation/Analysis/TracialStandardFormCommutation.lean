import Mathlib.Analysis.VonNeumannAlgebra.Basic
import Mathlib.Analysis.InnerProductSpace.Projection.Basic
import Mathlib.Analysis.InnerProductSpace.Adjoint

/-!
# The tracial standard form: `M′ = JMJ`, and the two actions generate `B(H)`

## The ledger row

`LI.06d` records the one assertion of the limits section with no counterpart
in the tree: *"for faithfully traced unital C⋆-coordinates `A` the left and
right actions on `L²(A,τ)` generate a von Neumann algebra that need not be
finite: for an infinite-dimensional II₁ factor in standard form it is all of
`B(L²(A,τ))`."*  The mechanism behind the sentence is the commutation
theorem of the *tracial* standard form --- Tomita--Takesaki in the only case
the row needs, where the modular operator is trivial --- plus the
observation that for a factor the two commuting actions have scalar joint
commutant.  This module proves that mechanism in full:

* `IsTracialStandardForm` --- a von Neumann algebra `M ⊆ B(H)` with a unit
  vector `Ω` that is cyclic, separating, and tracial.
* `TracialConjugation` --- the modular conjugation `J`, carried as *data*
  with its five defining identities (conjugate-linear isometric involution
  sending `TΩ` to `T⋆Ω`).  Its existence for a tracial standard form is the
  density extension of `TΩ ↦ T⋆Ω` (well defined by separation, isometric by
  traciality); that construction is not performed in this file, and every
  theorem below carries the conjugation as an explicit input --- but the
  residue is **discharged** in `Analysis/TracialConjugationExists.lean`,
  which builds the conjugation from exactly the density helpers above and
  the tracial field, so a consumer needs nothing beyond
  `IsTracialStandardForm`: the conjugation is recoverable via
  `exists_tracialConjugation`.
* `separating_commutant` and `dense_commutant_orbit` --- `Ω` is separating
  for the commutant (elementary) and cyclic for the commutant (the
  orthogonal projection onto the closed commutant orbit commutes with `M′`,
  hence lies in `M′′ = M` by the double-commutant axiom, fixes `Ω`, and
  separation forces it to be the identity).
* `conj_commutant_omega` --- the key identity `J T′ Ω = T′⋆ Ω` for
  `T′ ∈ M′`: both `⟪TΩ, J T′Ω⟫` and `⟪TΩ, T′⋆Ω⟫` compute to
  `⟪T′Ω, T⋆Ω⟫` against the dense orbit.
* `conjOp_mem_commutant` --- the easy half `J M J ⊆ M′`.
* `conjOp_commutant_mem`, `mem_commutant_iff_conjOp` --- the hard half
  `M′ ⊆ J M J`, hence **the commutation theorem** `M′ = J M J`.
* `centralizer_union_commutant`,
  `centralizer_centralizer_union_commutant` --- for a **factor**, the
  centralizer of `M ∪ M′` is the scalars, so the von Neumann algebra
  generated by the two actions --- the double centralizer of the union ---
  is all of `B(H)`.

## What this does and does not close

This is the standard-form *mechanism* of `LI.06d`.  The row's example ---
an infinite-dimensional II₁ factor exhibited with its trace --- is an
instantiation this module deliberately does not attempt: no von Neumann
algebra is constructed here and no claim is made that any particular `M`
satisfies the hypotheses.  The row stays `MISSING` until an instantiation
lands and the ledger is regraded by its own wave.
-/

namespace GroupApproximation
namespace TracialStandardForm

open scoped InnerProductSpace

universe u

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H]

/-! ## Density helpers -/

private theorem re_inner_self' {V : Type*} [NormedAddCommGroup V]
    [InnerProductSpace ℂ V] (v : V) : (⟪v, v⟫_ℂ).re = ‖v‖ ^ 2 := by
  have h := inner_self_eq_norm_sq (𝕜 := ℂ) v
  simpa [RCLike.re_to_complex] using h

omit [CompleteSpace H] in
/-- Two continuous linear maps agreeing on a set whose span is dense
agree: the agreement set is a closed submodule. -/
theorem clm_ext_of_dense_span {f g : H →L[ℂ] H} {s : Set H}
    (hs : Dense ((Submodule.span ℂ s : Submodule ℂ H) : Set H))
    (h : ∀ u ∈ s, f u = g u) : f = g := by
  have hclosed : IsClosed {u : H | (f - g) u = 0} :=
    isClosed_eq (f - g).continuous continuous_const
  have hsub : ((Submodule.span ℂ s : Submodule ℂ H) : Set H)
      ⊆ {u : H | (f - g) u = 0} := by
    intro u hu
    induction hu using Submodule.span_induction with
    | mem v hv =>
        show (f - g) v = 0
        rw [sub_apply, h v hv, sub_self]
    | zero =>
        show (f - g) 0 = 0
        rw [map_zero]
    | add v w hv hw ihv ihw =>
        show (f - g) (v + w) = 0
        rw [map_add, ihv, ihw, add_zero]
    | smul z v hv ihv =>
        show (f - g) (z • v) = 0
        rw [map_smul, ihv, smul_zero]
  have hall : closure ((Submodule.span ℂ s : Submodule ℂ H) : Set H)
      ⊆ {u : H | (f - g) u = 0} := closure_minimal hsub hclosed
  ext u
  have hu : u ∈ closure ((Submodule.span ℂ s : Submodule ℂ H) : Set H) := by
    rw [hs.closure_eq]
    trivial
  have h0 : (f - g) u = 0 := hall hu
  rw [sub_apply, sub_eq_zero] at h0
  exact h0

omit [CompleteSpace H] in
/-- Two continuous linear maps agreeing on a dense set agree. -/
theorem clm_ext_of_dense {f g : H →L[ℂ] H} {s : Set H} (hs : Dense s)
    (h : ∀ u ∈ s, f u = g u) : f = g :=
  clm_ext_of_dense_span (hs.mono Submodule.subset_span) h

omit [CompleteSpace H] in
/-- A vector orthogonal to a dense set vanishes. -/
theorem eq_zero_of_inner_dense {w : H} {s : Set H} (hs : Dense s)
    (h : ∀ u ∈ s, ⟪u, w⟫_ℂ = 0) : w = 0 := by
  have hclosed : IsClosed {u : H | ⟪u, w⟫_ℂ = 0} :=
    isClosed_eq (Continuous.inner continuous_id continuous_const)
      continuous_const
  have hall : closure s ⊆ {u : H | ⟪u, w⟫_ℂ = 0} := closure_minimal h hclosed
  have hw : ⟪w, w⟫_ℂ = 0 := by
    have hmem : w ∈ closure s := by
      rw [hs.closure_eq]
      trivial
    exact hall hmem
  exact inner_self_eq_zero.mp hw

/-! ## The tracial standard form -/

variable (M : VonNeumannAlgebra H) (Ω : H)

/-- The orbit of the distinguished vector under a set of operators. -/
def orbit (S : Set (H →L[ℂ] H)) (Ω : H) : Set H :=
  {v : H | ∃ T ∈ S, T Ω = v}

/-- **A tracial standard form**: a von Neumann algebra with a unit cyclic
separating tracial vector. -/
structure IsTracialStandardForm : Prop where
  /-- The vector is a unit vector. -/
  norm_omega : ‖Ω‖ = 1
  /-- The vector is cyclic: its orbit is dense. -/
  cyclic : Dense (orbit (M : Set (H →L[ℂ] H)) Ω)
  /-- The vector is separating. -/
  separating : ∀ T ∈ M, T Ω = 0 → T = 0
  /-- The vector state is a trace. -/
  tracial : ∀ T ∈ M, ∀ S ∈ M, ⟪Ω, (T * S) Ω⟫_ℂ = ⟪Ω, (S * T) Ω⟫_ℂ

/-- **The modular conjugation, as data**: a conjugate-linear isometric
involution sending `TΩ` to `T⋆Ω` for `T ∈ M`. -/
structure TracialConjugation where
  /-- The underlying conjugation map. -/
  J : H → H
  /-- Additivity. -/
  map_add : ∀ u v : H, J (u + v) = J u + J v
  /-- Conjugate-linearity. -/
  map_smul : ∀ (z : ℂ) (v : H), J (z • v) = (starRingEnd ℂ) z • J v
  /-- The conjugation is an involution. -/
  invol : ∀ v : H, J (J v) = v
  /-- The conjugation conjugates inner products. -/
  inner_map : ∀ u v : H, ⟪J u, J v⟫_ℂ = ⟪v, u⟫_ℂ
  /-- The defining action on the orbit. -/
  map_orbit : ∀ T ∈ M, J (T Ω) = (star T) Ω

namespace TracialConjugation

variable {M Ω}
variable (c : TracialConjugation M Ω)

theorem norm_map (v : H) : ‖c.J v‖ = ‖v‖ := by
  have h : (⟪c.J v, c.J v⟫_ℂ).re = (⟪v, v⟫_ℂ).re := by
    rw [c.inner_map v v]
  rw [re_inner_self' (c.J v), re_inner_self' v] at h
  exact le_antisymm ((sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h.le)
    ((sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h.ge)

/-- Conjugation of an operator by the modular conjugation, `x ↦ J x J`:
a continuous linear operator, because two conjugate-linearities cancel. -/
noncomputable def conjOp (x : H →L[ℂ] H) : H →L[ℂ] H :=
  LinearMap.mkContinuous
    { toFun := fun v => c.J (x (c.J v))
      map_add' := fun u v => by
        show c.J (x (c.J (u + v))) = c.J (x (c.J u)) + c.J (x (c.J v))
        rw [c.map_add u v, x.map_add, c.map_add]
      map_smul' := fun z v => by
        show c.J (x (c.J (z • v))) = (RingHom.id ℂ) z • c.J (x (c.J v))
        rw [RingHom.id_apply, c.map_smul z v, x.map_smul, c.map_smul,
          Complex.conj_conj] }
    ‖x‖ fun v => by
      show ‖c.J (x (c.J v))‖ ≤ ‖x‖ * ‖v‖
      rw [c.norm_map]
      calc ‖x (c.J v)‖ ≤ ‖x‖ * ‖c.J v‖ := x.le_opNorm _
        _ = ‖x‖ * ‖v‖ := by rw [c.norm_map]

@[simp] theorem conjOp_apply (x : H →L[ℂ] H) (v : H) :
    c.conjOp x v = c.J (x (c.J v)) := rfl

/-- Conjugation is involutive on operators. -/
theorem conjOp_conjOp (x : H →L[ℂ] H) : c.conjOp (c.conjOp x) = x := by
  ext v
  rw [conjOp_apply, conjOp_apply, c.invol, c.invol]

end TracialConjugation

variable {M Ω}

/-! ## Separation and cyclicity pass to the commutant -/

/-- The vector is separating for the commutant. -/
theorem separating_commutant (hsf : IsTracialStandardForm M Ω)
    {T' : H →L[ℂ] H} (hT' : T' ∈ M.commutant) (h : T' Ω = 0) : T' = 0 := by
  refine clm_ext_of_dense hsf.cyclic fun u hu => ?_
  obtain ⟨T, hT, rfl⟩ := hu
  have hc : T * T' = T' * T :=
    VonNeumannAlgebra.mem_commutant_iff.mp hT' T hT
  have h1 : T' (T Ω) = T (T' Ω) := by
    rw [← mul_apply_eq_comp, ← hc,
      mul_apply_eq_comp]
  rw [h1, h, map_zero, zero_apply]

/-- The orthogonal projection onto a closed subspace invariant under an
operator and its star commutes with that operator. -/
theorem starProjection_commute {C : Submodule ℂ H} [C.HasOrthogonalProjection]
    {T : H →L[ℂ] H} (hT : ∀ v ∈ C, T v ∈ C)
    (hTs : ∀ v ∈ C, (star T) v ∈ C) :
    T * C.starProjection = C.starProjection * T := by
  have h1 : C.starProjection * T * C.starProjection
      = T * C.starProjection := by
    ext v
    show C.starProjection (T (C.starProjection v)) = T (C.starProjection v)
    exact Submodule.starProjection_eq_self_iff.mpr
      (hT _ (C.starProjection_apply_mem v))
  have h2 : C.starProjection * (star T) * C.starProjection
      = (star T) * C.starProjection := by
    ext v
    show C.starProjection ((star T) (C.starProjection v))
      = (star T) (C.starProjection v)
    exact Submodule.starProjection_eq_self_iff.mpr
      (hTs _ (C.starProjection_apply_mem v))
  have hP : star C.starProjection = C.starProjection :=
    (isSelfAdjoint_starProjection C).star_eq
  have h3 := congrArg star h2
  rw [star_mul, star_mul, hP, star_star, star_mul, hP, star_star] at h3
  -- h3 : C.starProjection * (T * C.starProjection) = C.starProjection * T
  calc T * C.starProjection
      = C.starProjection * T * C.starProjection := h1.symm
    _ = C.starProjection * T := by rw [mul_assoc]; exact h3

/-- **The vector is cyclic for the commutant**: the span of the commutant
orbit is dense. -/
theorem dense_commutant_orbit (hsf : IsTracialStandardForm M Ω) :
    Dense ((Submodule.span ℂ
      (orbit (M.commutant : Set (H →L[ℂ] H)) Ω) : Submodule ℂ H) :
        Set H) := by
  set C₀ : Submodule ℂ H :=
    Submodule.span ℂ (orbit (M.commutant : Set (H →L[ℂ] H)) Ω) with hC₀
  set C := C₀.topologicalClosure with hCdef
  have hinv : ∀ S' ∈ M.commutant, ∀ v ∈ C, S' v ∈ C := by
    intro S' hS' v hv
    have hspan : ∀ u ∈ C₀, S' u ∈ C₀ := by
      intro u hu
      rw [hC₀] at hu ⊢
      induction hu using Submodule.span_induction with
      | mem w hw =>
          obtain ⟨T', hT', rfl⟩ := hw
          have he : S' (T' Ω) = (S' * T') Ω :=
            (mul_apply_eq_comp _ _ _).symm
          rw [he]
          exact Submodule.subset_span ⟨S' * T', mul_mem hS' hT', rfl⟩
      | zero =>
          rw [map_zero]
          exact Submodule.zero_mem _
      | add u w hu hw ihu ihw =>
          rw [map_add]
          exact Submodule.add_mem _ ihu ihw
      | smul z u hu ihu =>
          rw [map_smul]
          exact Submodule.smul_mem _ z ihu
    have h1 : v ∈ closure (C₀ : Set H) := by
      rw [hCdef] at hv
      exact hv
    have h2 : S' v ∈ closure (S' '' (C₀ : Set H)) :=
      image_closure_subset_closure_image S'.continuous
        (Set.mem_image_of_mem _ h1)
    have h3 : S' '' (C₀ : Set H) ⊆ (C₀ : Set H) := by
      rintro _ ⟨u, hu, rfl⟩
      exact hspan u hu
    have h4 : S' v ∈ closure (C₀ : Set H) := closure_mono h3 h2
    rw [hCdef]
    exact h4
  have hcomm : ∀ S' ∈ M.commutant,
      S' * C.starProjection = C.starProjection * S' := fun S' hS' =>
    starProjection_commute (fun v hv => hinv S' hS' v hv)
      (fun v hv => hinv (star S') (star_mem hS') v hv)
  have hPmem : C.starProjection ∈ M := by
    have h1 : C.starProjection ∈ M.commutant.commutant :=
      VonNeumannAlgebra.mem_commutant_iff.mpr hcomm
    rwa [VonNeumannAlgebra.commutant_commutant] at h1
  have hΩ : C.starProjection Ω = Ω := by
    refine Submodule.starProjection_eq_self_iff.mpr ?_
    apply Submodule.le_topologicalClosure
    rw [hC₀]
    exact Submodule.subset_span
      ⟨1, one_mem _, by rw [one_apply_eq_self]⟩
  have hone : C.starProjection = 1 := by
    have hdiff : (1 - C.starProjection : H →L[ℂ] H) ∈ M :=
      sub_mem (one_mem _) hPmem
    have hz : (1 - C.starProjection : H →L[ℂ] H) Ω = 0 := by
      rw [sub_apply, one_apply_eq_self, hΩ,
        sub_self]
    have h0 : (1 - C.starProjection : H →L[ℂ] H) = 0 :=
      hsf.separating _ hdiff hz
    have h1 : (1 : H →L[ℂ] H) = C.starProjection := by
      have h2 := sub_eq_zero.mp h0
      exact h2
    exact h1.symm
  intro v
  have hv : v ∈ C := by
    refine Submodule.starProjection_eq_self_iff.mp ?_
    rw [hone]
    exact one_apply_eq_self v
  rw [hCdef] at hv
  exact hv

/-! ## The key identity, and the commutation theorem -/

variable (c : TracialConjugation M Ω)

/-- **The key identity**: the conjugation acts on the commutant orbit the
same way, `J T′ Ω = T′⋆ Ω`.  Both matrix coefficients against the orbit of
`M` compute to `⟪T′Ω, T⋆Ω⟫`. -/
theorem conj_commutant_omega (hsf : IsTracialStandardForm M Ω)
    {T' : H →L[ℂ] H} (hT' : T' ∈ M.commutant) :
    c.J (T' Ω) = (star T') Ω := by
  have hkey : ∀ u ∈ orbit (M : Set (H →L[ℂ] H)) Ω,
      ⟪u, c.J (T' Ω) - (star T') Ω⟫_ℂ = 0 := by
    rintro _ ⟨T, hT, rfl⟩
    rw [inner_sub_right]
    have h1 : ⟪T Ω, c.J (T' Ω)⟫_ℂ = ⟪T' Ω, (star T) Ω⟫_ℂ := by
      have e1 : T Ω = c.J ((star T) Ω) := by
        rw [c.map_orbit (star T) (star_mem hT), star_star]
      rw [e1, c.inner_map]
    have h2 : ⟪T Ω, (star T') Ω⟫_ℂ = ⟪T' Ω, (star T) Ω⟫_ℂ := by
      have e2 : ⟪T Ω, (star T') Ω⟫_ℂ = ⟪T' (T Ω), Ω⟫_ℂ := by
        rw [ContinuousLinearMap.star_eq_adjoint,
          ContinuousLinearMap.adjoint_inner_right]
      have hc : T * T' = T' * T :=
        VonNeumannAlgebra.mem_commutant_iff.mp hT' T hT
      have e3 : T' (T Ω) = T (T' Ω) := by
        rw [← mul_apply_eq_comp, ← hc,
          mul_apply_eq_comp]
      have e4 : ⟪T (T' Ω), Ω⟫_ℂ = ⟪T' Ω, (star T) Ω⟫_ℂ := by
        rw [ContinuousLinearMap.star_eq_adjoint,
          ContinuousLinearMap.adjoint_inner_right]
      rw [e2, e3, e4]
    rw [h1, h2, sub_self]
  have hw := eq_zero_of_inner_dense hsf.cyclic hkey
  rw [sub_eq_zero] at hw
  exact hw

/-- **The easy half of the commutation theorem**: `J M J ⊆ M′`. -/
theorem conjOp_mem_commutant (hsf : IsTracialStandardForm M Ω)
    {x : H →L[ℂ] H} (hx : x ∈ M) : c.conjOp x ∈ M.commutant := by
  have horb : ∀ S ∈ M, c.conjOp x (S Ω) = S ((star x) Ω) := by
    intro S hS
    rw [c.conjOp_apply, c.map_orbit S hS]
    have h1 : x ((star S) Ω) = (x * star S) Ω :=
      (mul_apply_eq_comp _ _ _).symm
    rw [h1, c.map_orbit _ (mul_mem hx (star_mem hS)), star_mul, star_star,
      mul_apply_eq_comp]
  rw [VonNeumannAlgebra.mem_commutant_iff]
  intro g hg
  refine clm_ext_of_dense hsf.cyclic fun u hu => ?_
  obtain ⟨T, hT, rfl⟩ := hu
  show g (c.conjOp x (T Ω)) = c.conjOp x (g (T Ω))
  rw [horb T hT]
  have h2 : g (T Ω) = (g * T) Ω := (mul_apply_eq_comp _ _ _).symm
  rw [h2, horb (g * T) (mul_mem hg hT), mul_apply_eq_comp]

/-- **The hard half of the commutation theorem**: for `T′ ∈ M′`, the
conjugated operator `J T′ J` lies in `M`, tested against the dense
commutant orbit through the key identity. -/
theorem conjOp_commutant_mem (hsf : IsTracialStandardForm M Ω)
    {T' : H →L[ℂ] H} (hT' : T' ∈ M.commutant) : c.conjOp T' ∈ M := by
  have horb : ∀ S' ∈ M.commutant,
      c.conjOp T' (S' Ω) = S' ((star T') Ω) := by
    intro S' hS'
    rw [c.conjOp_apply, conj_commutant_omega c hsf hS']
    have h1 : T' ((star S') Ω) = (T' * star S') Ω :=
      (mul_apply_eq_comp _ _ _).symm
    rw [h1, conj_commutant_omega c hsf (mul_mem hT' (star_mem hS')),
      star_mul, star_star, mul_apply_eq_comp]
  have h1 : c.conjOp T' ∈ M.commutant.commutant := by
    rw [VonNeumannAlgebra.mem_commutant_iff]
    intro R' hR'
    refine clm_ext_of_dense_span (dense_commutant_orbit hsf) fun u hu => ?_
    obtain ⟨S', hS', rfl⟩ := hu
    show R' (c.conjOp T' (S' Ω)) = c.conjOp T' (R' (S' Ω))
    rw [horb S' hS']
    have h2 : R' (S' Ω) = (R' * S') Ω :=
      (mul_apply_eq_comp _ _ _).symm
    rw [h2, horb (R' * S') (mul_mem hR' hS'), mul_apply_eq_comp]
  rwa [VonNeumannAlgebra.commutant_commutant] at h1

/-- **The commutation theorem for the tracial standard form**:
`M′ = J M J`. -/
theorem mem_commutant_iff_conjOp (hsf : IsTracialStandardForm M Ω)
    (T' : H →L[ℂ] H) :
    T' ∈ M.commutant ↔ ∃ x ∈ M, c.conjOp x = T' := by
  constructor
  · intro h
    exact ⟨c.conjOp T', conjOp_commutant_mem c hsf h, c.conjOp_conjOp T'⟩
  · rintro ⟨x, hx, rfl⟩
    exact conjOp_mem_commutant c hsf hx

/-! ## The factor payoff: the two actions generate `B(H)` -/

/-- A factor: the center is the scalars. -/
def IsFactor (M : VonNeumannAlgebra H) : Prop :=
  ∀ T ∈ M, T ∈ M.commutant → ∃ z : ℂ, T = z • (1 : H →L[ℂ] H)

/-- An operator commuting with both actions of a factor is scalar. -/
theorem eq_smul_one_of_commute_both {M : VonNeumannAlgebra H}
    (hfac : IsFactor M) {T : H →L[ℂ] H}
    (h1 : ∀ S ∈ M, S * T = T * S)
    (h2 : ∀ S' ∈ M.commutant, S' * T = T * S') :
    ∃ z : ℂ, T = z • (1 : H →L[ℂ] H) := by
  have hTc : T ∈ M.commutant := VonNeumannAlgebra.mem_commutant_iff.mpr h1
  have hTm : T ∈ M := by
    have h3 : T ∈ M.commutant.commutant :=
      VonNeumannAlgebra.mem_commutant_iff.mpr h2
    rwa [VonNeumannAlgebra.commutant_commutant] at h3
  exact hfac T hTm hTc

/-- **For a factor, the centralizer of the union of the two actions is the
scalars.** -/
theorem centralizer_union_commutant {M : VonNeumannAlgebra H}
    (hfac : IsFactor M) :
    Set.centralizer
        ((M : Set (H →L[ℂ] H)) ∪ (M.commutant : Set (H →L[ℂ] H)))
      = Set.range fun z : ℂ => z • (1 : H →L[ℂ] H) := by
  ext T
  constructor
  · intro hT
    rw [Set.mem_centralizer_iff] at hT
    obtain ⟨z, hz⟩ := eq_smul_one_of_commute_both hfac
      (fun S hS => hT S (Or.inl hS)) (fun S' hS' => hT S' (Or.inr hS'))
    exact ⟨z, hz.symm⟩
  · rintro ⟨z, rfl⟩
    rw [Set.mem_centralizer_iff]
    intro m _
    rw [mul_smul_comm, smul_mul_assoc, mul_one, one_mul]

/-- **The two actions of a factor in standard form generate `B(H)`**: the
double centralizer of `M ∪ M′` is everything.  This is the mechanism of the
`LI.06d` sentence. -/
theorem centralizer_centralizer_union_commutant {M : VonNeumannAlgebra H}
    (hfac : IsFactor M) :
    Set.centralizer (Set.centralizer
        ((M : Set (H →L[ℂ] H)) ∪ (M.commutant : Set (H →L[ℂ] H))))
      = Set.univ := by
  rw [centralizer_union_commutant hfac]
  ext T
  simp only [Set.mem_univ, iff_true]
  rw [Set.mem_centralizer_iff]
  rintro _ ⟨z, rfl⟩
  rw [smul_mul_assoc, mul_smul_comm, one_mul, mul_one]

end TracialStandardForm
end GroupApproximation
