import GroupApproximation.Analysis.CuntzPedersenTraceZero
import Mathlib.Analysis.LocallyConvex.Separation

/-!
# Hermitian tracial separation of the Cuntz--Pedersen trace-zero space

This file proves the full Hahn--Banach part of Cuntz--Pedersen separation,
without assuming a Jordan decomposition theorem.  An element outside the
closed real space generated by additive self-commutators is detected by a
bounded complex-linear functional which is both hermitian and tracial.

The remaining passage from such a signed trace to a tracial state is exactly
the positive Jordan-decomposition step; it is deliberately not hidden in an
assumption here.
-/

namespace GroupApproximation
namespace CuntzPedersenHermitianSeparation

open CuntzPedersenCoronaObstruction CuntzPedersenTraceZero
  PolarLiftingGeneralCStar

noncomputable section

universe u

variable {A : Type u} [CStarAlgebra A]

/-- Finite sums of additive self-commutators, bundled as a real subspace. -/
def finiteSelfCommutatorSubmodule : Submodule ℝ A where
  carrier := {x | IsFiniteSelfCommutatorSum x}
  zero_mem' := isFiniteSelfCommutatorSum_zero
  add_mem' := fun hx hy ↦ IsFiniteSelfCommutatorSum.add hx hy
  smul_mem' := fun r x hx ↦ by
    change IsFiniteSelfCommutatorSum x at hx
    change IsFiniteSelfCommutatorSum (r • x)
    by_cases hr : 0 ≤ r
    · exact IsFiniteSelfCommutatorSum.nonneg_smul hx hr
    · have hneg : 0 ≤ -r := neg_nonneg.mpr (le_of_not_ge hr)
      have h := IsFiniteSelfCommutatorSum.nonneg_smul hx hneg
      simpa only [← neg_smul, neg_neg] using IsFiniteSelfCommutatorSum.neg h

/-- The Cuntz--Pedersen trace-zero space is a closed real subspace. -/
def traceZeroSubmodule : Submodule ℝ A :=
  finiteSelfCommutatorSubmodule.topologicalClosure

theorem traceZeroSubmodule_coe :
    (traceZeroSubmodule (A := A) : Set A) = traceZeroSpace A := by
  rw [traceZeroSubmodule, Submodule.topologicalClosure_coe]
  rfl

theorem traceZeroSpace_zero : (0 : A) ∈ traceZeroSpace A := by
  rw [← traceZeroSubmodule_coe]
  exact (traceZeroSubmodule (A := A)).zero_mem

theorem traceZeroSpace_add {x y : A}
    (hx : x ∈ traceZeroSpace A) (hy : y ∈ traceZeroSpace A) :
    x + y ∈ traceZeroSpace A := by
  rw [← traceZeroSubmodule_coe] at hx hy ⊢
  exact (traceZeroSubmodule (A := A)).add_mem hx hy

theorem traceZeroSpace_neg {x : A} (hx : x ∈ traceZeroSpace A) :
    -x ∈ traceZeroSpace A := by
  rw [← traceZeroSubmodule_coe] at hx ⊢
  exact (traceZeroSubmodule (A := A)).neg_mem hx

theorem traceZeroSpace_real_smul (r : ℝ) {x : A}
    (hx : x ∈ traceZeroSpace A) : r • x ∈ traceZeroSpace A := by
  rw [← traceZeroSubmodule_coe] at hx ⊢
  exact (traceZeroSubmodule (A := A)).smul_mem r hx

/-- Conjugating the value of a functional after applying it to the adjoint
defines another bounded complex-linear functional. -/
def adjointFunctional (f : A →L[ℂ] ℂ) : A →L[ℂ] ℂ :=
  LinearMap.mkContinuous
    { toFun := fun a ↦ star (f (star a))
      map_add' := fun a b ↦ by simp
      map_smul' := fun c a ↦ by simp [star_smul] }
    ‖f‖ fun a ↦ by
      simpa using f.le_opNorm (star a)

@[simp] theorem adjointFunctional_apply (f : A →L[ℂ] ℂ) (a : A) :
    adjointFunctional f a = star (f (star a)) := rfl

/-- The hermitian part of a bounded functional. -/
def hermitianPart (f : A →L[ℂ] ℂ) : A →L[ℂ] ℂ :=
  (2 : ℂ)⁻¹ • (f + adjointFunctional f)

@[simp] theorem hermitianPart_apply (f : A →L[ℂ] ℂ) (a : A) :
    hermitianPart f a = (2 : ℂ)⁻¹ * (f a + star (f (star a))) := by
  rfl

theorem hermitianPart_map_star (f : A →L[ℂ] ℂ) (a : A) :
    hermitianPart f (star a) = star (hermitianPart f a) := by
  simp [hermitianPart_apply, star_mul, star_add]
  ring

theorem hermitianPart_apply_selfAdjoint (f : A →L[ℂ] ℂ)
    {a : A} (ha : star a = a) :
    hermitianPart f a = (f a).re := by
  rw [hermitianPart_apply, ha]
  apply Complex.ext
  · norm_num [Complex.mul_re]
    ring
  · norm_num [Complex.mul_im]

/-- A bounded hermitian tracial functional.  It is not required to be
positive or normalized. -/
structure HermitianTrace (A : Type u) [CStarAlgebra A] where
  toContinuousLinearMap : A →L[ℂ] ℂ
  map_star' : ∀ a, toContinuousLinearMap (star a) =
    star (toContinuousLinearMap a)
  map_mul_comm' : ∀ a b, toContinuousLinearMap (a * b) =
    toContinuousLinearMap (b * a)

namespace HermitianTrace

instance : CoeFun (HermitianTrace A) fun _ ↦ A → ℂ :=
  ⟨fun φ ↦ φ.toContinuousLinearMap⟩

@[simp] theorem map_star (φ : HermitianTrace A) (a : A) :
    φ (star a) = star (φ a) := φ.map_star' a

theorem map_mul_comm (φ : HermitianTrace A) (a b : A) :
    φ (a * b) = φ (b * a) := φ.map_mul_comm' a b

end HermitianTrace

private theorem selfCommutator_add_star (a b : A) :
    selfCommutator (a + star b) =
      selfCommutator a + selfCommutator (star b) +
        (b * a - a * b) + star (b * a - a * b) := by
  simp only [selfCommutator, star_add, star_star, star_sub, star_mul]
  noncomm_ring

/-- A hermitian complex-linear functional which annihilates all additive
self-commutators is tracial. -/
theorem map_mul_comm_of_hermitian_of_selfCommutator_eq_zero
    (f : A →L[ℂ] ℂ)
    (hstar : ∀ a, f (star a) = star (f a))
    (hzero : ∀ z, f (selfCommutator z) = 0)
    (a b : A) : f (a * b) = f (b * a) := by
  let c := b * a - a * b
  have hrealzero : ∀ p q : A,
      f (q * p - p * q) + star (f (q * p - p * q)) = 0 := by
    intro p q
    have h := hzero (p + star q)
    rw [selfCommutator_add_star, map_add, map_add, map_add,
      hzero p, hzero (star q), zero_add, zero_add,
      hstar (q * p - p * q)] at h
    exact h
  have hre0 : f c + star (f c) = 0 := hrealzero a b
  have himraw := hrealzero a (Complex.I • b)
  have hcI : (Complex.I • b) * a - a * (Complex.I • b) =
      Complex.I • c := by
    simp only [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, smul_sub, c]
  rw [hcI, map_smul, smul_eq_mul, star_mul, Complex.star_def,
    Complex.conj_I] at himraw
  have him0 : Complex.I * (f c - star (f c)) = 0 := by
    linear_combination himraw
  have hdiff : f c - star (f c) = 0 :=
    (mul_eq_zero.mp him0).resolve_left Complex.I_ne_zero
  have hc : f c = 0 := by
    linear_combination (hre0 + hdiff) / 2
  change f (a * b) = f (b * a)
  have : f (b * a) - f (a * b) = 0 := by
    simpa [c, map_sub] using hc
  exact (sub_eq_zero.mp this).symm

/-- Hahn--Banach separation supplies a bounded hermitian trace detecting any
self-adjoint element outside the Cuntz--Pedersen trace-zero space. -/
theorem exists_hermitianTrace_detecting {x : A} (hxstar : star x = x)
    (hx : x ∉ traceZeroSpace A) :
    ∃ φ : HermitianTrace A, φ x ≠ 0 ∧
      ∀ y ∈ traceZeroSpace A, φ y = 0 := by
  obtain ⟨f, u, hf0, hfx⟩ :=
    RCLike.geometric_hahn_banach_closed_point (𝕜 := ℂ)
      closed_convex_traceZeroSpace.2 closed_convex_traceZeroSpace.1 hx
  have hu : 0 < u := by
    simpa using hf0 0 traceZeroSpace_zero
  have hfre : ∀ y ∈ traceZeroSpace A, (f y).re = 0 := by
    intro y hy
    set t : ℝ := (f y).re
    by_contra ht
    let r : ℝ := (u + 1) / t
    have hsep := hf0 (r • y) (traceZeroSpace_real_smul r hy)
    have heval : (f (r • y)).re = u + 1 := by
      have hry : r • y = (r : ℂ) • y := by
        rw [← algebraMap_smul ℂ r y]
        simp
      rw [hry, map_smul]
      simp only [smul_eq_mul, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul]
      rw [sub_zero]
      change r * t = u + 1
      dsimp only [r]
      exact div_mul_cancel₀ _ ht
    change (f (r • y)).re < u at hsep
    rw [heval] at hsep
    linarith
  let g := hermitianPart f
  have hgzero : ∀ y ∈ traceZeroSpace A, g y = 0 := by
    intro y hy
    rw [hermitianPart_apply_selfAdjoint f
      (isSelfAdjoint_of_mem_traceZeroSpace hy).star_eq, hfre y hy]
    norm_num
  have hgself : ∀ z, g (selfCommutator z) = 0 := by
    intro z
    exact hgzero _ (subset_closure ⟨1, fun _ ↦ z, by simp⟩)
  have hgtrace : ∀ a b, g (a * b) = g (b * a) :=
    map_mul_comm_of_hermitian_of_selfCommutator_eq_zero g
      (hermitianPart_map_star f) hgself
  have hgx : g x ≠ 0 := by
    rw [hermitianPart_apply_selfAdjoint f hxstar]
    have : u < (f x).re := hfx
    exact_mod_cast (ne_of_gt (hu.trans this))
  exact ⟨⟨g, hermitianPart_map_star f, hgtrace⟩, hgx, hgzero⟩

/-- The hermitian-functional separation analogue of Cuntz--Pedersen
separation holds for every C-star algebra, without an extra hypothesis. -/
theorem has_hermitianTrace_separation :
    ∀ x : A, star x = x → x ∉ traceZeroSpace A →
      ∃ φ : HermitianTrace A, φ x ≠ 0 := by
  intro x hxstar hx
  obtain ⟨φ, hφx, _⟩ := exists_hermitianTrace_detecting hxstar hx
  exact ⟨φ, hφx⟩

open Filter

/-- In particular, the corona obstruction unconditionally produces a
bounded hermitian trace.  Positivity is the only missing conversion to the
tracial state used by the counterexample. -/
theorem exists_hermitianTrace_detecting_coronaClass
    {D : ℕ → Type u} [∀ n, CStarAlgebra (D n)] [∀ n, Nontrivial (D n)]
    (B : BlockObstruction D) :
    ∃ φ : HermitianTrace (CStarProductCorona D atTop),
      φ B.coronaClass ≠ 0 :=
  has_hermitianTrace_separation B.coronaClass (star_coronaClass B)
    (coronaClass_not_mem_traceZeroSpace B)

end

end CuntzPedersenHermitianSeparation
end GroupApproximation
