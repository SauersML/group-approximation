import GroupApproximation.Analysis.CStarGeneratedSeparableUnion

/-!
# Separability of a C-star algebra generated by two separable ranges

This module isolates the universe-polymorphic topological argument used by
universal C-star amalgams and concrete corona subalgebras.  The ambient
C-star algebra need not be separable.
-/

namespace GroupApproximation

noncomputable section

universe u w

/-- Adjoining one element to the range of a separable C-star algebra map and
then taking the closed star subalgebra remains separable. -/
theorem topologicalClosure_adjoin_range_union_singleton_separable
    {A : Type u} {D : Type w} [CStarAlgebra A] [CStarAlgebra D]
    [TopologicalSpace.SeparableSpace A]
    (left : A →⋆ₐ[ℂ] D) (z : D) :
    TopologicalSpace.SeparableSpace
      ((StarAlgebra.adjoin ℂ
        (Set.range left ∪ {z})).topologicalClosure) := by
  let t : Set D :=
    left '' Set.range (TopologicalSpace.denseSeq A) ∪ {z}
  have ht : t.Countable :=
    ((Set.countable_range _).image left).union (Set.countable_singleton z)
  have hleft_continuous : Continuous left := by
    exact (LipschitzWith.of_dist_le_mul (K := 1) fun x y ↦ by
      rw [NNReal.coe_one, one_mul, dist_eq_norm, dist_eq_norm, ← map_sub]
      exact NonUnitalStarAlgHom.norm_apply_le left (x - y)).continuous
  have hleft_dense : Set.range left ⊆ closure t := by
    rintro _ ⟨a, rfl⟩
    exact closure_mono Set.subset_union_left <|
      image_closure_subset_closure_image
        hleft_continuous
          ⟨a, TopologicalSpace.denseRange_denseSeq A a, rfl⟩
  have ht_subset : t ⊆ Set.range left ∪ {z} := by
    intro x hx
    rcases hx with hx | hx
    · rcases hx with ⟨a, _, rfl⟩
      exact Or.inl ⟨a, rfl⟩
    · exact Or.inr hx
  have hz : {z} ⊆ closure t := by
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    exact subset_closure (Or.inr rfl)
  exact topologicalClosure_adjoin_separable_of_countable_dense
    (Set.range left ∪ {z}) t ht ht_subset
      (Set.union_subset hleft_dense hz)

end

end GroupApproximation
