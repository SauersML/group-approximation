import GroupApproximation.Analysis.CommutativeStateSpectralMeasure
import GroupApproximation.Analysis.CStarTakesakiCyclic

/-!
# Spectral measure of a represented abelian root plane

This module constructs the commutative C-star algebra generated by a family
of pairwise commuting represented group elements.  A unit vector gives a
state on this algebra, and the associated scalar spectral measure records
operator displacement exactly: the integral of the squared displacement of
one coordinate is the squared Hilbert-space displacement of the vector by
the corresponding represented group element.

All hypotheses are explicit algebraic or analytic data.  In particular, the
construction does not assume a spectral theorem for a group action, an
invariant measure, or any external existence statement.
-/

namespace GroupApproximation

namespace RepresentedRootPlaneSpectralMeasure

open WeakDual MeasureTheory
open scoped InnerProductSpace IsMulCommutative

universe u v w

/-- A unitary representation together with a pairwise commuting family of
group elements.  The family is the abstract root plane whose represented
coordinates generate the commutative C-star algebra below. -/
structure RepresentedAbelianPlane
    (G : Type u) [Group G] (I : Type v)
    (H : Type w) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  rho : G →* unitary (H →L[ℂ] H)
  root : I → G
  root_commute : ∀ i j, Commute (root i) (root j)

section Plane

variable {G : Type u} [Group G] {I : Type v}
variable {H : Type w} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H]

/-- The bounded operator representing one root-plane coordinate. -/
noncomputable def RepresentedAbelianPlane.representedOperator
    (P : RepresentedAbelianPlane G I H) (i : I) : H →L[ℂ] H :=
  (P.rho (P.root i) : H →L[ℂ] H)

/-- Represented root-plane coordinates commute as bounded operators. -/
theorem RepresentedAbelianPlane.representedOperator_commute
    (P : RepresentedAbelianPlane G I H) (i j : I) :
    Commute (P.representedOperator i) (P.representedOperator j) := by
  show (P.rho (P.root i) : H →L[ℂ] H) *
      (P.rho (P.root j) : H →L[ℂ] H) =
    (P.rho (P.root j) : H →L[ℂ] H) *
      (P.rho (P.root i) : H →L[ℂ] H)
  exact congrArg (fun z : unitary (H →L[ℂ] H) ↦ (z : H →L[ℂ] H))
    ((P.root_commute i j).map P.rho).eq

/-- The set of represented root-plane coordinate operators. -/
def RepresentedAbelianPlane.generatorSet
    (P : RepresentedAbelianPlane G I H) : Set (H →L[ℂ] H) :=
  Set.range P.representedOperator

/-- The closed star subalgebra generated by the represented root plane. -/
noncomputable def RepresentedAbelianPlane.algebra
    (P : RepresentedAbelianPlane G I H) :
    StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ P.generatorSet).topologicalClosure

/-- The algebraic star algebra generated by the represented coordinates is
commutative.  Commutation with adjoints follows from normality of unitary
operators. -/
theorem RepresentedAbelianPlane.adjoin_isMulCommutative
    (P : RepresentedAbelianPlane G I H) :
    IsMulCommutative (StarAlgebra.adjoin ℂ P.generatorSet) := by
  apply StarAlgebra.isMulCommutative_adjoin ℂ
  · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    exact (P.representedOperator_commute i j).eq
  · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    have hj : IsStarNormal (P.representedOperator j) :=
      Unitary.coe_isStarNormal (P.rho (P.root j))
    exact (hj.commute_star_right (P.representedOperator_commute i j)).eq

noncomputable instance RepresentedAbelianPlane.algebraIsMulCommutative
    (P : RepresentedAbelianPlane G I H) : IsMulCommutative P.algebra := by
  letI : IsMulCommutative (StarAlgebra.adjoin ℂ P.generatorSet) :=
    P.adjoin_isMulCommutative
  let hcomm : CommRing P.algebra :=
    (StarAlgebra.adjoin ℂ P.generatorSet).commRingTopologicalClosure mul_comm
  exact ⟨⟨fun a b ↦ hcomm.mul_comm a b⟩⟩

noncomputable instance RepresentedAbelianPlane.algebraCompleteSpace
    (P : RepresentedAbelianPlane G I H) : CompleteSpace P.algebra := by
  unfold RepresentedAbelianPlane.algebra
  infer_instance

noncomputable instance RepresentedAbelianPlane.algebraCommCStarAlgebra
    (P : RepresentedAbelianPlane G I H) : CommCStarAlgebra P.algebra := {}

/-- A represented root-plane operator, as an element of the generated
commutative C-star algebra. -/
noncomputable def RepresentedAbelianPlane.coordinate
    (P : RepresentedAbelianPlane G I H) (i : I) : P.algebra :=
  ⟨P.representedOperator i, by
    apply StarSubalgebra.le_topologicalClosure
    exact StarAlgebra.subset_adjoin ℂ P.generatorSet ⟨i, rfl⟩⟩

@[simp] theorem RepresentedAbelianPlane.coordinate_coe
    (P : RepresentedAbelianPlane G I H) (i : I) :
    ((P.coordinate i : P.algebra) : H →L[ℂ] H) =
      P.representedOperator i :=
  rfl

/-- The inclusion of the generated algebra in the bounded operators,
regarded as a star representation on the original Hilbert space. -/
noncomputable def RepresentedAbelianPlane.inclusionRep
    (P : RepresentedAbelianPlane G I H) :
    CStarTensor.StarRep P.algebra H :=
  CStarTensor.StarRep.ofStarAlgHom P.algebra.subtype

@[simp] theorem RepresentedAbelianPlane.inclusionRep_hom_coordinate
    (P : RepresentedAbelianPlane G I H) (i : I) :
    P.inclusionRep.hom (P.coordinate i) = P.representedOperator i :=
  rfl

/-- The state on the represented root-plane algebra induced by a unit
vector. -/
noncomputable def RepresentedAbelianPlane.vectorState
    (P : RepresentedAbelianPlane G I H) (zeta : H) (hzeta : ‖zeta‖ = 1) :
    CStarState.State P.algebra :=
  CStarTensor.stateOfVector P.inclusionRep zeta hzeta

@[simp] theorem RepresentedAbelianPlane.vectorState_apply
    (P : RepresentedAbelianPlane G I H) (zeta : H) (hzeta : ‖zeta‖ = 1)
    (a : P.algebra) :
    (P.vectorState zeta hzeta).toCLM a =
      ⟪zeta, P.inclusionRep.hom a zeta⟫_ℂ :=
  rfl

variable (P : RepresentedAbelianPlane G I H)

local notation "X" => characterSpace ℂ P.algebra

noncomputable local instance : MeasurableSpace X := borel X
local instance : BorelSpace X := ⟨rfl⟩

/-- **Represented root-plane spectral-measure identity.**  For every unit
vector and every root-plane coordinate, the scalar spectral measure of the
induced vector state integrates squared character displacement to the exact
squared Hilbert-space displacement. -/
theorem integral_coordinate_displacement_sq
    (zeta : H) (hzeta : ‖zeta‖ = 1) (i : I) :
    ∫ chi, ‖chi (P.coordinate i) - 1‖ ^ 2
        ∂CommutativeStateSpectralMeasure.stateSpectralMeasure
          (P.vectorState zeta hzeta) =
      ‖(P.rho (P.root i) : H →L[ℂ] H) zeta - zeta‖ ^ 2 := by
  calc
    ∫ chi, ‖chi (P.coordinate i) - 1‖ ^ 2
        ∂CommutativeStateSpectralMeasure.stateSpectralMeasure
          (P.vectorState zeta hzeta) =
      ∫ chi, CommutativeStateSpectralMeasure.characterDisplacementSq
          (P.coordinate i) chi
        ∂CommutativeStateSpectralMeasure.stateSpectralMeasure
          (P.vectorState zeta hzeta) := by
        apply integral_congr_ae
        filter_upwards [] with chi
        exact (CommutativeStateSpectralMeasure.characterDisplacementSq_apply
          (P.coordinate i) chi).symm
    _ = ((P.vectorState zeta hzeta).toCLM
          (star (P.coordinate i - 1) * (P.coordinate i - 1))).re :=
      CommutativeStateSpectralMeasure.integral_characterDisplacementSq
        (P.vectorState zeta hzeta) (P.coordinate i)
    _ = ‖P.inclusionRep.hom (P.coordinate i - 1) zeta‖ ^ 2 := by
      rw [P.vectorState_apply, ← CStarTensor.re_inner_self]
      have hmul :
          P.inclusionRep.hom
              (star (P.coordinate i - 1) * (P.coordinate i - 1)) zeta =
            P.inclusionRep.hom (star (P.coordinate i - 1))
              (P.inclusionRep.hom (P.coordinate i - 1) zeta) := by
        rw [map_mul]
        rfl
      rw [hmul]
      exact congrArg Complex.re
        ((P.inclusionRep.isAdjoint_star (P.coordinate i - 1) zeta
          (P.inclusionRep.hom (P.coordinate i - 1) zeta)).symm)
    _ = ‖(P.rho (P.root i) : H →L[ℂ] H) zeta - zeta‖ ^ 2 := by
      rw [map_sub, map_one, sub_apply, one_apply_eq_self,
        P.inclusionRep_hom_coordinate]
      rfl

end Plane

end RepresentedRootPlaneSpectralMeasure

end GroupApproximation
