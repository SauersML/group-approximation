import Mathlib.Analysis.CStarAlgebra.Hom
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# Equality of closed star algebras generated by a dense subfamily
-/

namespace GroupApproximation

noncomputable section

universe w

/-- Replacing a set of star-algebra generators by a dense contained subset
does not change the generated closed star subalgebra. -/
theorem topologicalClosure_adjoin_eq_of_subset_closure
    {D : Type w} [CStarAlgebra D] (s t : Set D)
    (ht_subset : t ⊆ s) (hs : s ⊆ closure t) :
    (StarAlgebra.adjoin ℂ s).topologicalClosure =
      (StarAlgebra.adjoin ℂ t).topologicalClosure := by
  apply le_antisymm
  · apply StarSubalgebra.topologicalClosure_minimal
    · apply StarAlgebra.adjoin_le
      intro x hx
      have hxt : x ∈ closure t := hs hx
      rw [StarSubalgebra.topologicalClosure_coe]
      exact closure_mono (StarAlgebra.subset_adjoin ℂ t) hxt
    · exact StarSubalgebra.isClosed_topologicalClosure _
  · apply StarSubalgebra.topologicalClosure_minimal
    · apply StarAlgebra.adjoin_le
      intro x hx
      apply StarSubalgebra.le_topologicalClosure
      exact StarAlgebra.subset_adjoin ℂ _ (ht_subset hx)
    · exact StarSubalgebra.isClosed_topologicalClosure _

end

end GroupApproximation
