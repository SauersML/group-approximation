import GroupApproximation.Analysis.CStarCountableAdjoinSeparable
import GroupApproximation.Analysis.CStarGeneratedClosureEquality

/-!
# Separability of a C-star algebra generated by countable dense generators
-/

namespace GroupApproximation

noncomputable section

universe w

/-- A countable subset dense in a set of C-star generators also generates a
separable closed star subalgebra. -/
theorem topologicalClosure_adjoin_separable_of_countable_dense
    {D : Type w} [CStarAlgebra D] (s t : Set D)
    (ht : t.Countable) (ht_subset : t ⊆ s) (hs : s ⊆ closure t) :
    TopologicalSpace.SeparableSpace
      (StarAlgebra.adjoin ℂ s).topologicalClosure := by
  rw [topologicalClosure_adjoin_eq_of_subset_closure s t ht_subset hs]
  exact topologicalClosure_adjoin_separable_of_countable t ht

end

end GroupApproximation
