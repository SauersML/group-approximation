import GroupApproximation.Analysis.QuasidiagonalTraceGeneratorDense
import GroupApproximation.Analysis.LocallyRFByIntAmenableTrace
import GroupApproximation.Meta.AxiomGuard

/-!
# The canonical trace of a locally residually finite group is quasidiagonal

`non_mf_groups_exist.tex`, Proposition `prop:locally-rf-by-z-trace`, first
assertion:

> For the first assertion, let `E ⊆ N` be finite, put `N₀ = ⟨E⟩`, and choose a
> finite quotient `θ : N₀ → Q` with `θ(x) ≠ 1` for `x ∈ E ∖ {1}`; put
> `H = ker θ`.  In the quasi-regular representation of `N` on `ℓ²(N/H)`, the
> finite-dimensional subspace `ℓ²(N₀/H)` is `N₀`-invariant, and compression to
> it is a u.c.p. map `φ_E` on `C*_max(N)` that restricts to a representation of
> `C*_max(N₀)`.  For `x ∈ E ∖ {1}`, the element `x` fixes no coset `nH` with
> `n ∈ N₀`, because `n⁻¹xn ∈ H` would give `x ∈ H` by normality of `H` in `N₀`;
> so `tr(φ_E(u_x)) = 0`.

Two features of this argument distinguish it from the amenable-trace
constructions elsewhere in `Analysis`, and both make it *easier*.

* The compression is exactly multiplicative on every pair of canonical
  unitaries at a late enough stage, because `N₀` maps the selected cosets to
  selected cosets with nothing escaping.  So the operator-norm defect is
  eventually zero, which is what a **quasidiagonal** trace model asks for and
  what `AmenableExtensionTrace.quasidiagonalTraceModel_of_dense_generators`
  turns into one.  No Følner set and no Hilbert--Schmidt estimate appear.
* The trace is exactly zero on every tested nonidentity unitary, not merely
  asymptotically, because `H` is normal in `N₀`.

The residual packet, the finite quotient and the coset enumeration are the
ones already built for the semidirect-product case in
`Analysis.LocallyRFByIntAmenableTrace`; only the window is different, since
there is no integer coordinate to stack over here.
-/

namespace GroupApproximation
namespace AmenableExtensionTrace

open Filter Matrix Quasidiagonal ResidualFinitePacket
open LocallyRFByIntAmenableTrace LocallyRFByIntSchedule
open scoped Matrix.Norms.L2Operator

noncomputable section

variable {N : Type} [Group N] [Countable N]

/-! ### The stage subgroup and its residual packet -/

/-- The finitely generated subgroup generated by the elements tested at stage
`n`: the printed `N₀ = ⟨E⟩`. -/
def stageSubgroup (N : Type) [Group N] [Countable N] (n : ℕ) : Subgroup N :=
  Subgroup.closure (↑(exhaustion N 1 n) : Set N)

theorem mem_stageSubgroup {n : ℕ} {g : N} (hg : g ∈ exhaustion N 1 n) :
    g ∈ stageSubgroup N n :=
  Subgroup.subset_closure hg

theorem stageSubgroup_fg (n : ℕ) : (stageSubgroup N n).FG := by
  classical
  exact (Subgroup.fg_iff _).mpr
    ⟨↑(exhaustion N 1 n), rfl, (exhaustion N 1 n).finite_toSet⟩

/-- The tested elements, read inside the subgroup they generate. -/
def stageWindowIn (N : Type) [Group N] [Countable N] (n : ℕ) :
    Finset ↥(stageSubgroup N n) := by
  classical
  exact (exhaustion N 1 n).attach.map
    ⟨fun x ↦ ⟨x.1, mem_stageSubgroup x.2⟩, by
      intro x y hxy
      apply Subtype.ext
      exact congrArg (fun z : ↥(stageSubgroup N n) ↦ (z : N)) hxy⟩

/-- The printed packet `E ∖ {1}`. -/
def stagePacketSet (N : Type) [Group N] [Countable N] (n : ℕ) :
    Finset ↥(stageSubgroup N n) := by
  classical
  exact (stageWindowIn N n).erase 1

theorem stagePacketSet_avoids_one (n : ℕ) :
    ∀ d ∈ stagePacketSet N n, d ≠ 1 := by
  classical
  intro d hd
  exact (Finset.mem_erase.mp hd).1

theorem mem_stagePacketSet {n : ℕ} {g : N} (hg : g ∈ exhaustion N 1 n)
    (hne : g ≠ 1) :
    (⟨g, mem_stageSubgroup hg⟩ : ↥(stageSubgroup N n)) ∈ stagePacketSet N n := by
  classical
  rw [stagePacketSet, Finset.mem_erase]
  refine ⟨fun hone ↦ hne (congrArg Subtype.val hone), ?_⟩
  rw [stageWindowIn, Finset.mem_map]
  exact ⟨⟨g, hg⟩, by simp, rfl⟩

/-- The printed finite quotient `θ : N₀ → Q`, as a normal finite-index
kernel separating every nonidentity tested element. -/
def stagePacket (hN : IsLocallyResiduallyFinite N) (n : ℕ) :
    Packet ↥(stageSubgroup N n) (stagePacketSet N n) :=
  Classical.choice
    (exists_packet_of_fg hN (stageSubgroup N n) (stageSubgroup_fg n)
      (stagePacketSet N n) (stagePacketSet_avoids_one n))

/-- The printed `H = ker θ`, as a subgroup of `N`.  It is normal in the stage
subgroup, not in `N`; the argument never needs more. -/
def stageKernel (hN : IsLocallyResiduallyFinite N) (n : ℕ) : Subgroup N :=
  (stagePacket hN n).subgroup.map (stageSubgroup N n).subtype

theorem mem_stageKernel_iff (hN : IsLocallyResiduallyFinite N) (n : ℕ)
    (x : ↥(stageSubgroup N n)) :
    (x : N) ∈ stageKernel hN n ↔ x ∈ (stagePacket hN n).subgroup := by
  constructor
  · rintro ⟨y, hy, hxy⟩
    have hyx : y = x := Subtype.ext hxy
    rwa [hyx] at hy
  · intro hx
    exact ⟨x, hx, rfl⟩

/-! ### The selected cosets -/

/-- The finite matrix index set at stage `n`: the fibres of `θ`. -/
@[reducible] def stageModel (hN : IsLocallyResiduallyFinite N) (n : ℕ) :
    FiniteModel :=
  (stagePacket hN n).quotientModel

/-- The printed selected cosets `nH`, `n ∈ N₀`. -/
def stageCoset (hN : IsLocallyResiduallyFinite N) (n : ℕ)
    (q : stageModel hN n) : N ⧸ stageKernel hN n :=
  QuotientGroup.mk ((Quotient.out q : ↥(stageSubgroup N n)) : N)

theorem stageCoset_apply (hN : IsLocallyResiduallyFinite N) (n : ℕ)
    (q : stageModel hN n) :
    stageCoset hN n q =
      QuotientGroup.mk ((Quotient.out q : ↥(stageSubgroup N n)) : N) := rfl

/-- The selected coset depends only on the fibre, so it is computed by any
representative. -/
theorem stageCoset_mk (hN : IsLocallyResiduallyFinite N) (n : ℕ)
    (y : ↥(stageSubgroup N n)) :
    stageCoset hN n (QuotientGroup.mk y) = QuotientGroup.mk (y : N) := by
  rw [stageCoset_apply]
  refine (QuotientGroup.eq (s := stageKernel hN n)).mpr ?_
  refine ⟨(Quotient.out (QuotientGroup.mk y : stageModel hN n))⁻¹ * y, ?_, ?_⟩
  · exact (QuotientGroup.eq (s := (stagePacket hN n).subgroup)).mp
      (QuotientGroup.out_eq' _)
  · simp

/-- Distinct fibres name distinct cosets, so the enumeration is a valid input
to the quasi-regular compression. -/
theorem stageCoset_injective (hN : IsLocallyResiduallyFinite N) (n : ℕ) :
    Function.Injective (stageCoset hN n) := by
  intro q r hqr
  rw [stageCoset_apply, stageCoset_apply] at hqr
  have hmem := (QuotientGroup.eq (s := stageKernel hN n)).mp hqr
  have hcoe : (((Quotient.out q : ↥(stageSubgroup N n)) : N))⁻¹ *
      ((Quotient.out r : ↥(stageSubgroup N n)) : N) =
      (((Quotient.out q : ↥(stageSubgroup N n))⁻¹ *
        (Quotient.out r : ↥(stageSubgroup N n)) : ↥(stageSubgroup N n)) : N) := by
    push_cast
    rfl
  rw [hcoe, mem_stageKernel_iff] at hmem
  have hclass : (QuotientGroup.mk (Quotient.out q) : stageModel hN n) =
      QuotientGroup.mk (Quotient.out r) :=
    (QuotientGroup.eq (s := (stagePacket hN n).subgroup)).mpr hmem
  rwa [QuotientGroup.out_eq', QuotientGroup.out_eq'] at hclass

/-- The printed `N₀`-invariance: nothing escapes the selected window under an
element of the stage subgroup. -/
theorem stageCoset_smul_mem_range (hN : IsLocallyResiduallyFinite N) (n : ℕ)
    {h : N} (hh : h ∈ stageSubgroup N n) (q : stageModel hN n) :
    h • stageCoset hN n q ∈ Set.range (stageCoset hN n) := by
  refine ⟨QuotientGroup.mk
    ((⟨h, hh⟩ : ↥(stageSubgroup N n)) * Quotient.out q), ?_⟩
  rw [stageCoset_mk, stageCoset_apply]
  show (QuotientGroup.mk
      ((((⟨h, hh⟩ : ↥(stageSubgroup N n)) * Quotient.out q :
        ↥(stageSubgroup N n))) : N) : N ⧸ stageKernel hN n) =
    h • QuotientGroup.mk ((Quotient.out q : ↥(stageSubgroup N n)) : N)
  show (QuotientGroup.mk
      ((((⟨h, hh⟩ : ↥(stageSubgroup N n)) * Quotient.out q :
        ↥(stageSubgroup N n))) : N) : N ⧸ stageKernel hN n) =
    QuotientGroup.mk (h * ((Quotient.out q : ↥(stageSubgroup N n)) : N))
  congr 1

/-! ### The compression at one stage -/

/-- The printed u.c.p. map `φ_E`. -/
def stageMap (hN : IsLocallyResiduallyFinite N) (n : ℕ) :
    MaximalGroupCStar N →ₗ[ℂ]
      Matrix (stageModel hN n) (stageModel hN n) ℂ :=
  QuasiRegularCompression.compressionMap (stageKernel hN n) (stageModel hN n)
    (stageCoset hN n)

theorem stageMap_one (hN : IsLocallyResiduallyFinite N) (n : ℕ) :
    stageMap hN n 1 = 1 :=
  QuasiRegularCompression.compressionMap_one (stageKernel hN n)
    (stageModel hN n) (stageCoset_injective hN n)

theorem stageMap_completelyPositive (hN : IsLocallyResiduallyFinite N)
    (n : ℕ) :
    IsCompletelyPositiveOnMatrices (stageModel hN n) ⇑(stageMap hN n) :=
  QuasiRegularCompression.isCompletelyPositiveOnMatrices_compressionMap
    (stageKernel hN n) (stageModel hN n) (stageCoset hN n)

theorem norm_stageMap_le (hN : IsLocallyResiduallyFinite N) (n : ℕ)
    (a : MaximalGroupCStar N) : ‖stageMap hN n a‖ ≤ ‖a‖ :=
  QuasiRegularCompression.norm_compressionMap_le (stageKernel hN n)
    (stageModel hN n) (stageCoset_injective hN n) a

/-! ### Exact multiplicativity at a late stage -/

/-- **The printed representation clause.**  Once the right-hand generator is
tested, the compression is *exactly* multiplicative on that pair. -/
theorem stage_generator_defect_eq_zero (hN : IsLocallyResiduallyFinite N)
    (n : ℕ) (g : N) {h : N} (hh : h ∈ exhaustion N 1 n) :
    stageMap hN n (maximalGroupCStarGenerator N (g * h)) -
        stageMap hN n (maximalGroupCStarGenerator N g) *
          stageMap hN n (maximalGroupCStarGenerator N h) = 0 := by
  ext p q
  have hnot : q ∉ QuasiRegularCompression.escape (stageKernel hN n)
      (stageModel hN n) (stageCoset hN n) h := by
    intro hq
    rw [QuasiRegularCompression.mem_escape] at hq
    exact hq (stageCoset_smul_mem_range hN n (mem_stageSubgroup hh) q)
  have hzero := QuasiRegularCompression.generatorDefect_apply_of_not_mem_escape
    (stageKernel hN n) (stageModel hN n) (stageCoset_injective hN n) g h p q hnot
  simpa [QuasiRegularCompression.generatorDefect, stageMap] using hzero

/-- Operator-norm multiplicative defects on canonical generators vanish
eventually. -/
theorem tendsto_stage_generator_mul_op (hN : IsLocallyResiduallyFinite N)
    (g h : N) :
    Tendsto (fun n ↦ ‖stageMap hN n
        (maximalGroupCStarGenerator N g * maximalGroupCStarGenerator N h) -
      stageMap hN n (maximalGroupCStarGenerator N g) *
        stageMap hN n (maximalGroupCStarGenerator N h)‖) atTop (nhds 0) := by
  have heq : ∀ᶠ n in atTop, ‖stageMap hN n
      (maximalGroupCStarGenerator N g * maximalGroupCStarGenerator N h) -
    stageMap hN n (maximalGroupCStarGenerator N g) *
      stageMap hN n (maximalGroupCStarGenerator N h)‖ = 0 := by
    filter_upwards [eventually_eventually_mem_exhaustion N 1 h] with n hn
    rw [maximalGroupCStarGenerator_mul, stage_generator_defect_eq_zero hN n g hn,
      norm_zero]
  exact tendsto_const_nhds.congr' (Filter.EventuallyEq.symm heq)

/-! ### Exact traces on tested generators -/

/-- **The printed trace clause.**  A tested nonidentity element fixes no
selected coset, because the packet kernel is normal in the stage subgroup. -/
theorem stage_no_fixed_coset (hN : IsLocallyResiduallyFinite N) (n : ℕ)
    {g : N} (hg : g ∈ exhaustion N 1 n) (hg1 : g ≠ 1) (q : stageModel hN n) :
    g • stageCoset hN n q ≠ stageCoset hN n q := by
  intro hfix
  obtain ⟨x, hxq⟩ : ∃ x : ↥(stageSubgroup N n), Quotient.out q = x := ⟨_, rfl⟩
  have hgs : ((⟨g, mem_stageSubgroup hg⟩ : ↥(stageSubgroup N n)) : N) = g := rfl
  have hfix' : (QuotientGroup.mk (g * (x : N)) : N ⧸ stageKernel hN n) =
      QuotientGroup.mk ((x : N)) := by
    rw [stageCoset_apply, hxq] at hfix
    exact hfix
  have hmem := (QuotientGroup.eq (s := stageKernel hN n)).mp hfix'
  have hcoe : (g * (x : N))⁻¹ * (x : N)
      = ((x⁻¹ * (⟨g, mem_stageSubgroup hg⟩ : ↥(stageSubgroup N n))⁻¹ * x :
          ↥(stageSubgroup N n)) : N) := by
    push_cast [hgs]
    group
  rw [hcoe, mem_stageKernel_iff] at hmem
  have hconj := (stagePacket hN n).normal'.conj_mem _ hmem x
  have hrewrite : x * (x⁻¹ *
      (⟨g, mem_stageSubgroup hg⟩ : ↥(stageSubgroup N n))⁻¹ * x) * x⁻¹ =
      (⟨g, mem_stageSubgroup hg⟩ : ↥(stageSubgroup N n))⁻¹ := by group
  rw [hrewrite] at hconj
  exact (stagePacket hN n).avoids _ (mem_stagePacketSet hg hg1)
    ((stagePacket hN n).subgroup.inv_mem_iff.mp hconj)

theorem stage_generator_trace_eq_zero (hN : IsLocallyResiduallyFinite N)
    (n : ℕ) {g : N} (hg : g ∈ exhaustion N 1 n) (hg1 : g ≠ 1) :
    normTrace (stageModel hN n)
      (stageMap hN n (maximalGroupCStarGenerator N g)) = 0 :=
  QuasiRegularCompression.normTrace_compressionMap_generator_eq_zero
    (stageKernel hN n) (stageModel hN n) (stageCoset hN n) g
    (stage_no_fixed_coset hN n hg hg1)

theorem tendsto_stage_generator_trace (hN : IsLocallyResiduallyFinite N)
    (g : N) :
    Tendsto (fun n ↦
      ‖canonicalMaximalTrace N (maximalGroupCStarGenerator N g) -
        normTrace (stageModel hN n)
          (stageMap hN n (maximalGroupCStarGenerator N g))‖)
      atTop (nhds 0) := by
  by_cases hg : g = 1
  · subst hg
    have hgen : maximalGroupCStarGenerator N 1 = 1 :=
      congrArg (fun w : unitary (MaximalGroupCStar N) ↦
        (w : MaximalGroupCStar N))
        (map_one (maximalGroupCStarUnitaryHom N))
    have hzero : ∀ n : ℕ,
        ‖canonicalMaximalTrace N (maximalGroupCStarGenerator N 1) -
          normTrace (stageModel hN n)
            (stageMap hN n (maximalGroupCStarGenerator N 1))‖ = 0 := by
      intro n
      rw [canonicalMaximalTrace_generator_one, hgen, stageMap_one,
        normTrace_one' (stageModel hN n) Fintype.card_pos, sub_self, norm_zero]
    simpa only [hzero] using
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (0 : ℝ)) atTop (nhds 0))
  · have heq : ∀ᶠ n in atTop,
        ‖canonicalMaximalTrace N (maximalGroupCStarGenerator N g) -
          normTrace (stageModel hN n)
            (stageMap hN n (maximalGroupCStarGenerator N g))‖ = 0 := by
      filter_upwards [eventually_eventually_mem_exhaustion N 1 g] with n hn
      rw [canonicalMaximalTrace_generator_of_ne_one N hg,
        stage_generator_trace_eq_zero hN n hn hg, sub_self, norm_zero]
    exact tendsto_const_nhds.congr' (Filter.EventuallyEq.symm heq)

/-! ### The printed first assertion -/

/-- **`prop:locally-rf-by-z-trace`, first assertion, as a closed
proposition.**  For every countable locally residually finite group, the
canonical trace of its maximal group C⋆-algebra is quasidiagonal. -/
def PrintedLocallyRFCanonicalTraceQuasidiagonal : Prop :=
  ∀ (N : Type) [Group N] [Countable N],
    IsLocallyResiduallyFinite N →
      IsQuasidiagonalTrace
        (fun a : MaximalGroupCStar N ↦ canonicalMaximalTrace N a)

theorem manuscriptPrintedLocallyRFCanonicalTraceQuasidiagonal :
    PrintedLocallyRFCanonicalTraceQuasidiagonal := by
  intro N _ _ hN
  exact ⟨quasidiagonalTraceModel_of_dense_generators
    (stageMap hN) (stageMap_one hN) (stageMap_completelyPositive hN)
    (norm_stageMap_le hN) (canonicalMaximalTrace N)
    (Set.range (maximalGroupCStarGenerator N))
    (maximalGroupCStar_dense_span_generator N)
    (by
      rintro _ ⟨g, rfl⟩ _ ⟨h, rfl⟩
      exact tendsto_stage_generator_mul_op hN g h)
    (by
      rintro _ ⟨g, rfl⟩
      exact tendsto_stage_generator_trace hN g)⟩

end

end AmenableExtensionTrace
end GroupApproximation

open GroupApproximation

#audit_closed_axioms
  AmenableExtensionTrace.manuscriptPrintedLocallyRFCanonicalTraceQuasidiagonal
