import GroupApproximation.Analysis.CStarGeneratedSeparable
import GroupApproximation.Analysis.UniversalCStarHNN

/-!
# MF consequences of faithful universal C-star HNN representations

This module records the exact final assembly for the manuscript's HNN
argument.  There are two independent faithfulness issues:

* a faithful evaluation of the universal C-star HNN algebra into an
  MF-embeddable target makes the universal algebra MF-embeddable; and
* a faithful evaluation of the induced abstract group-HNN representation
  makes that group representation faithful.

The Ueda-corner/Shulman step which supplies MF embeddability of the universal
HNN algebra is deliberately not hidden in either statement.
-/

namespace GroupApproximation
namespace MFAlgebraHNNPermanence

noncomputable section

universe u v

variable {D : Type u} [CStarAlgebra D]
variable (B0 B1 : StarSubalgebra ℂ D) (theta : B0 ≃⋆ₐ[ℂ] B1)
variable [Nonempty (CStarHNNRepresentation B0 B1 theta)]

/-- A universal C-star HNN algebra over a separable base is separable: it is
generated by the base range and one stable unitary. -/
theorem universalCStarHNN_separableSpace
    [TopologicalSpace.SeparableSpace D] :
    TopologicalSpace.SeparableSpace (UniversalCStarHNN B0 B1 theta) := by
  change TopologicalSpace.SeparableSpace
    ((StarAlgebra.adjoin ℂ
      (Set.range (universalCStarHNNBaseAmbient B0 B1 theta) ∪
        {(universalCStarHNNStableAmbient B0 B1 theta :
          UniversalCStarHNNAmbient B0 B1 theta)})).topologicalClosure)
  exact topologicalClosure_adjoin_range_union_singleton_separable
    (universalCStarHNNBaseAmbient B0 B1 theta)
    (universalCStarHNNStableAmbient B0 B1 theta :
      UniversalCStarHNNAmbient B0 B1 theta)

/-- A faithful evaluation into an MF-embeddable target makes the universal
C-star HNN algebra MF-embeddable. -/
theorem universalCStarHNN_hasMFEmbedding_of_faithful_eval
    (R : CStarHNNRepresentation B0 B1 theta)
    (hR : HasMFEmbedding R.carrier)
    (hfaithful : Function.Injective
      (universalCStarHNNEval B0 B1 theta R)) :
    HasMFEmbedding (UniversalCStarHNN B0 B1 theta) :=
  hR.of_injective_nonUnitalStarAlgHom
    (universalCStarHNNEval B0 B1 theta R).toNonUnitalStarAlgHom hfaithful

/-- The corresponding MF-algebra statement once separability of the
universal HNN algebra has been supplied. -/
theorem universalCStarHNN_isMFAlgebra_of_faithful_eval
    [TopologicalSpace.SeparableSpace D]
    (R : CStarHNNRepresentation B0 B1 theta)
    (hR : HasMFEmbedding R.carrier)
    (hfaithful : Function.Injective
      (universalCStarHNNEval B0 B1 theta R)) :
    IsMFAlgebra (UniversalCStarHNN B0 B1 theta) :=
  ⟨universalCStarHNN_separableSpace B0 B1 theta,
    universalCStarHNN_hasMFEmbedding_of_faithful_eval
      B0 B1 theta R hR hfaithful⟩

section GroupLift

variable {G : Type v} [Group G]
variable {S T : Subgroup G} (phi : S ≃* T)
variable [Countable (HNNExtension G S T phi)]

/-- **Final HNN MF assembly.**  If the universal C-star HNN algebra has an
MF embedding and one covariant coordinate detects the induced abstract
group-HNN representation faithfully, then the abstract HNN extension is
operator MF.

The coordinate used for group faithfulness need not itself be MF; in the
manuscript it is the reduced regular representation. -/
theorem hnnExtension_isOperatorMF_of_universalCStarHNN_hasMFEmbedding
    (hHNN : HasMFEmbedding (UniversalCStarHNN B0 B1 theta))
    (R : CStarHNNRepresentation B0 B1 theta)
    (rho : G →* unitary (UniversalCStarHNN B0 B1 theta))
    (hrel : ∀ s : S,
      universalCStarHNNStable B0 B1 theta * rho (s : G) =
        rho ((phi s : T) : G) * universalCStarHNNStable B0 B1 theta)
    (hfaithful : Function.Injective
      (universalCStarHNNGroupLiftEval B0 B1 theta phi R rho hrel)) :
    IsOperatorMF (HNNExtension G S T phi) :=
  hHNN.isOperatorMF
    (universalCStarHNNGroupLift B0 B1 theta phi rho hrel)
    (universalCStarHNNGroupLift_injective_of_eval
      B0 B1 theta phi R rho hrel hfaithful)

end GroupLift

end

end MFAlgebraHNNPermanence
end GroupApproximation
