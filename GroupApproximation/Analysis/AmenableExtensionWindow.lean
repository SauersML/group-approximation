import GroupApproximation.Analysis.LocallyRFQuasidiagonalTrace
import GroupApproximation.Sofic.SoficByAmenablePermanence
import GroupApproximation.Sofic.AmenableActionSofic

/-!
# The Følner window of an amenable extension

`non_mf_groups_exist.tex`, Proposition `prop:locally-rf-by-z-trace`, second
assertion.  This module builds the finite data of the printed proof and proves
its combinatorial properties; the analytic estimates and the trace model are in
`Analysis.AmenableExtensionAmenableTrace`.

> fix a finite set `E ⊆ G`, a finite Følner set `F ⊆ A`, and a section
> `σ : A → G`.  For `g ∈ E` and `x ∈ F` put `b(g,x) = σ(ḡx)⁻¹ g σ(x) ∈ N`.
> The subgroup `N₀` generated by these finitely many elements is residually
> finite; choose a finite quotient `θ : N₀ → Q` with `θ(b(g,x)) ≠ 1` whenever
> `b(g,x) ≠ 1`, put `H = ker θ`, and choose representatives `r_q ∈ N₀` of the
> cosets of `H` in `N₀`.  The cosets `σ(x) r_q H`, `x ∈ F`, `q ∈ Q`, are
> pairwise distinct, since equality forces `x = x'` in `A` and then `q = q'`.

The printed `σ` and `b` are already in the corpus, as
`SoficByAmenablePermanence.sect` and `SoficByAmenablePermanence.esCocycleN`:
the Elek--Szabó displacement cocycle of the same extension.  The printed Følner
set is `AmenableActionSofic.exists_folner`, at boundary tolerance `1/(n+1)` at
stage `n`, so that the boundary ratio tends to zero along the stages.

The subgroup `N₀` is built inside `↥N` rather than inside `G`, which is what
lets the hypothesis "`N` is locally residually finite" apply to it with no
transport: `windowEmb` is the single injective homomorphism `↥N₀ → G` through
which everything is read back into the ambient group.

The two printed geometric facts proved here are

* `extCoset_injective` --- the selected cosets are pairwise distinct;
* `extCoset_smul_mem_range` --- `g σ(x) r_q H = σ(ḡx) r_{θ(b(g,x))q} H`
  whenever `ḡx` is still in the Følner set, so the only escape is the Følner
  boundary.
-/

namespace GroupApproximation
namespace AmenableExtensionTrace

open Filter Quasidiagonal ResidualFinitePacket
open LocallyRFByIntAmenableTrace LocallyRFByIntSchedule SoficByAmenablePermanence

noncomputable section

variable {G : Type} [Group G] [Countable G] (N : Subgroup G) [N.Normal]

/-! ### The Følner set at one stage -/

/-- The quotient translations that must be tested at stage `n`. -/
def quotientWindow (n : ℕ) : Finset (G ⧸ N) := by
  classical
  exact (exhaustion G 1 n).image (fun g ↦ (QuotientGroup.mk g : G ⧸ N))

omit [N.Normal] in
theorem mk_mem_quotientWindow {n : ℕ} {g : G} (hg : g ∈ exhaustion G 1 n) :
    (QuotientGroup.mk g : G ⧸ N) ∈ quotientWindow N n := by
  classical
  exact Finset.mem_image_of_mem _ hg

/-- The printed Følner set, at boundary tolerance `1/(n+1)`. -/
theorem folner_exists (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    ∃ A : Finset (G ⧸ N), A.Nonempty ∧ ∀ q ∈ quotientWindow N n,
      ((AmenableActionSofic.boundary A q).card : ℝ) <
        (1 / ((n : ℝ) + 1)) * A.card :=
  AmenableActionSofic.exists_folner hA (quotientWindow N n) (by positivity)

/-- The printed Følner set `F ⊆ A` at stage `n`. -/
def folnerSet (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) : Finset (G ⧸ N) :=
  Classical.choose (folner_exists N hA n)

theorem folnerSet_nonempty (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    (folnerSet N hA n).Nonempty :=
  (Classical.choose_spec (folner_exists N hA n)).1

theorem folnerSet_boundary_lt (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ)
    {q : G ⧸ N} (hq : q ∈ quotientWindow N n) :
    ((AmenableActionSofic.boundary (folnerSet N hA n) q).card : ℝ) <
      (1 / ((n : ℝ) + 1)) * (folnerSet N hA n).card :=
  (Classical.choose_spec (folner_exists N hA n)).2 q hq

instance folnerSet_nonemptyCoe (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Nonempty ↥(folnerSet N hA n) := by
  obtain ⟨x, hx⟩ := folnerSet_nonempty N hA n
  exact ⟨⟨x, hx⟩⟩

/-! ### The cocycle window and its residual packet -/

/-- The printed cocycle values `b(g,x) = σ(ḡx)⁻¹ g σ(x)`, for `g` tested and
`x` in the Følner set. -/
def cocycleWindow (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) : Finset ↥N := by
  classical
  exact ((exhaustion G 1 n) ×ˢ (folnerSet N hA n)).image
    fun p ↦ esCocycleN N p.1 p.2

theorem esCocycleN_mem_cocycleWindow (hA : Amenability.IsAmenable (G ⧸ N))
    {n : ℕ} {g : G} (hg : g ∈ exhaustion G 1 n) {x : G ⧸ N}
    (hx : x ∈ folnerSet N hA n) :
    esCocycleN N g x ∈ cocycleWindow N hA n := by
  classical
  have hpair : ((g, x) : G × (G ⧸ N)) ∈
      (exhaustion G 1 n) ×ˢ (folnerSet N hA n) :=
    Finset.mem_product.mpr ⟨hg, hx⟩
  exact Finset.mem_image_of_mem _ hpair

/-- The printed `N₀`, built inside `↥N`. -/
def cocycleSubgroup (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Subgroup ↥N :=
  Subgroup.closure (↑(cocycleWindow N hA n) : Set ↥N)

theorem mem_cocycleSubgroup (hA : Amenability.IsAmenable (G ⧸ N)) {n : ℕ}
    {b : ↥N} (hb : b ∈ cocycleWindow N hA n) : b ∈ cocycleSubgroup N hA n :=
  Subgroup.subset_closure hb

theorem cocycleSubgroup_fg (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    (cocycleSubgroup N hA n).FG := by
  classical
  exact (Subgroup.fg_iff _).mpr
    ⟨↑(cocycleWindow N hA n), rfl, (cocycleWindow N hA n).finite_toSet⟩

/-- The cocycle values, read inside the subgroup they generate. -/
def cocycleWindowIn (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Finset ↥(cocycleSubgroup N hA n) := by
  classical
  exact (cocycleWindow N hA n).attach.map
    ⟨fun x ↦ ⟨x.1, mem_cocycleSubgroup N hA x.2⟩, by
      intro x y hxy
      apply Subtype.ext
      exact congrArg (fun z : ↥(cocycleSubgroup N hA n) ↦ (z : ↥N)) hxy⟩

/-- The printed packet: the nonidentity cocycle values. -/
def cocyclePacketSet (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Finset ↥(cocycleSubgroup N hA n) := by
  classical
  exact (cocycleWindowIn N hA n).erase 1

theorem cocyclePacketSet_avoids_one (hA : Amenability.IsAmenable (G ⧸ N))
    (n : ℕ) : ∀ d ∈ cocyclePacketSet N hA n, d ≠ 1 := by
  classical
  intro d hd
  exact (Finset.mem_erase.mp hd).1

theorem mem_cocyclePacketSet (hA : Amenability.IsAmenable (G ⧸ N)) {n : ℕ}
    {b : ↥N} (hb : b ∈ cocycleWindow N hA n) (hne : b ≠ 1) :
    (⟨b, mem_cocycleSubgroup N hA hb⟩ : ↥(cocycleSubgroup N hA n)) ∈
      cocyclePacketSet N hA n := by
  classical
  rw [cocyclePacketSet, Finset.mem_erase]
  refine ⟨fun hone ↦ hne (congrArg Subtype.val hone), ?_⟩
  rw [cocycleWindowIn, Finset.mem_map]
  exact ⟨⟨b, hb⟩, by simp, rfl⟩

/-- The printed finite quotient `θ : N₀ → Q`. -/
def cocyclePacket (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Packet ↥(cocycleSubgroup N hA n) (cocyclePacketSet N hA n) :=
  Classical.choice
    (exists_packet_of_fg hN (cocycleSubgroup N hA n) (cocycleSubgroup_fg N hA n)
      (cocyclePacketSet N hA n) (cocyclePacketSet_avoids_one N hA n))

/-! ### Reading the window back into the ambient group -/

/-- The single injective homomorphism `↥N₀ → G`. -/
def windowEmb (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    ↥(cocycleSubgroup N hA n) →* G :=
  N.subtype.comp (cocycleSubgroup N hA n).subtype

theorem windowEmb_injective (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Function.Injective (windowEmb N hA n) :=
  Subtype.val_injective.comp Subtype.val_injective

theorem windowEmb_mem (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ)
    (w : ↥(cocycleSubgroup N hA n)) : windowEmb N hA n w ∈ N :=
  ((w : ↥N)).2

theorem mk_windowEmb (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ)
    (w : ↥(cocycleSubgroup N hA n)) :
    (QuotientGroup.mk (windowEmb N hA n w) : G ⧸ N) = 1 :=
  (QuotientGroup.eq_one_iff _).mpr (windowEmb_mem N hA n w)

/-- The printed `H = ker θ`, as a subgroup of `G`. -/
def stageH (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) : Subgroup G :=
  (cocyclePacket N hN hA n).subgroup.map (windowEmb N hA n)

theorem mem_stageH_iff (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ)
    (w : ↥(cocycleSubgroup N hA n)) :
    windowEmb N hA n w ∈ stageH N hN hA n ↔
      w ∈ (cocyclePacket N hN hA n).subgroup := by
  constructor
  · rintro ⟨y, hy, hyw⟩
    have hyx : y = w := windowEmb_injective N hA n hyw
    rwa [hyx] at hy
  · intro hw
    exact ⟨w, hw, rfl⟩

theorem stageH_le (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) : stageH N hN hA n ≤ N := by
  rintro _ ⟨w, -, rfl⟩
  exact windowEmb_mem N hA n w

/-! ### The selected cosets `σ(x) r_q H` -/

/-- The finite matrix index set at stage `n`: Følner coordinate times quotient
fibre. -/
def extModel (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) : FiniteModel :=
  ⟨↥(folnerSet N hA n) × (cocyclePacket N hN hA n).quotientModel,
    inferInstance, Classical.decEq _⟩

instance extModel_nonempty (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Nonempty (extModel N hN hA n) := by
  show Nonempty (↥(folnerSet N hA n) × (cocyclePacket N hN hA n).quotientModel)
  infer_instance

/-- The printed selected coset `σ(x) r_q H`. -/
def extCoset (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ)
    (z : extModel N hN hA n) : G ⧸ stageH N hN hA n :=
  QuotientGroup.mk (sect N (z.1 : G ⧸ N) *
    windowEmb N hA n (Quotient.out z.2))

theorem extCoset_apply (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) (z : extModel N hN hA n) :
    extCoset N hN hA n z =
      QuotientGroup.mk (sect N (z.1 : G ⧸ N) *
        windowEmb N hA n (Quotient.out z.2)) := rfl

/-- The selected coset is computed by any representative of the fibre. -/
theorem extCoset_mk (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ)
    (x : ↥(folnerSet N hA n)) (w : ↥(cocycleSubgroup N hA n)) :
    extCoset N hN hA n (x, QuotientGroup.mk w) =
      QuotientGroup.mk (sect N (x : G ⧸ N) * windowEmb N hA n w) := by
  rw [extCoset_apply]
  refine (QuotientGroup.eq (s := stageH N hN hA n)).mpr ?_
  have hkey : (sect N (x : G ⧸ N) *
        windowEmb N hA n (Quotient.out
          (QuotientGroup.mk w : (cocyclePacket N hN hA n).quotientModel)))⁻¹ *
      (sect N (x : G ⧸ N) * windowEmb N hA n w) =
      windowEmb N hA n
        ((Quotient.out (QuotientGroup.mk w :
          (cocyclePacket N hN hA n).quotientModel))⁻¹ * w) := by
    rw [map_mul, map_inv]
    group
  rw [hkey, mem_stageH_iff]
  exact (QuotientGroup.eq (s := (cocyclePacket N hN hA n).subgroup)).mp
    (QuotientGroup.out_eq' _)

/-- **The printed distinctness.**  Equality of selected cosets forces equality
of the Følner coordinate, and then of the fibre. -/
theorem extCoset_injective (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) :
    Function.Injective (extCoset N hN hA n) := by
  rintro ⟨x, q⟩ ⟨y, r⟩ hxy
  rw [extCoset_apply, extCoset_apply] at hxy
  have hmem := (QuotientGroup.eq (s := stageH N hN hA n)).mp hxy
  have hmemN : (sect N (x : G ⧸ N) *
      windowEmb N hA n (Quotient.out q))⁻¹ *
      (sect N (y : G ⧸ N) * windowEmb N hA n (Quotient.out r)) ∈ N :=
    stageH_le N hN hA n hmem
  -- the Følner coordinate
  have hq : (QuotientGroup.mk
      (sect N (x : G ⧸ N) * windowEmb N hA n (Quotient.out q)) : G ⧸ N)
      = (x : G ⧸ N) := by
    rw [QuotientGroup.mk_mul, mk_windowEmb, mul_one, mk_sect]
  have hr : (QuotientGroup.mk
      (sect N (y : G ⧸ N) * windowEmb N hA n (Quotient.out r)) : G ⧸ N)
      = (y : G ⧸ N) := by
    rw [QuotientGroup.mk_mul, mk_windowEmb, mul_one, mk_sect]
  have hxyQ : (x : G ⧸ N) = (y : G ⧸ N) := by
    rw [← hq, ← hr]
    exact (QuotientGroup.eq (s := N)).mpr hmemN
  have hxyv : x = y := Subtype.ext hxyQ
  subst hxyv
  -- the fibre
  have hcancel : (sect N (x : G ⧸ N) * windowEmb N hA n (Quotient.out q))⁻¹ *
      (sect N (x : G ⧸ N) * windowEmb N hA n (Quotient.out r)) =
      windowEmb N hA n ((Quotient.out q)⁻¹ * Quotient.out r) := by
    rw [map_mul, map_inv]
    group
  rw [hcancel, mem_stageH_iff] at hmem
  have hclass : (QuotientGroup.mk (Quotient.out q) :
      (cocyclePacket N hN hA n).quotientModel) =
      QuotientGroup.mk (Quotient.out r) :=
    (QuotientGroup.eq (s := (cocyclePacket N hN hA n).subgroup)).mpr hmem
  rw [QuotientGroup.out_eq', QuotientGroup.out_eq'] at hclass
  exact Prod.ext rfl hclass

/-! ### The printed translation formula -/

/-- **The printed `g σ(x) r_q H = σ(ḡx) r_{θ(b(g,x))q} H`.**  Nothing escapes
the selected window except through the Følner boundary. -/
theorem extCoset_smul_mem_range (hN : IsLocallyResiduallyFinite ↥N)
    (hA : Amenability.IsAmenable (G ⧸ N)) (n : ℕ) {g : G}
    (hg : g ∈ exhaustion G 1 n) (z : extModel N hN hA n)
    (hin : (QuotientGroup.mk g : G ⧸ N) * (z.1 : G ⧸ N) ∈ folnerSet N hA n) :
    g • extCoset N hN hA n z ∈ Set.range (extCoset N hN hA n) := by
  obtain ⟨x, q⟩ := z
  have hb : esCocycleN N g (x : G ⧸ N) ∈ cocycleWindow N hA n :=
    esCocycleN_mem_cocycleWindow N hA hg x.2
  set b : ↥(cocycleSubgroup N hA n) :=
    ⟨esCocycleN N g (x : G ⧸ N), mem_cocycleSubgroup N hA hb⟩ with hbdef
  have hbG : windowEmb N hA n b = esCocycle N g (x : G ⧸ N) := rfl
  refine ⟨(⟨_, hin⟩, QuotientGroup.mk (b * Quotient.out q)), ?_⟩
  rw [extCoset_mk, extCoset_apply]
  show (QuotientGroup.mk (sect N ((QuotientGroup.mk g : G ⧸ N) * (x : G ⧸ N)) *
      windowEmb N hA n (b * Quotient.out q)) : G ⧸ stageH N hN hA n) =
    g • QuotientGroup.mk (sect N (x : G ⧸ N) * windowEmb N hA n (Quotient.out q))
  show (QuotientGroup.mk (sect N ((QuotientGroup.mk g : G ⧸ N) * (x : G ⧸ N)) *
      windowEmb N hA n (b * Quotient.out q)) : G ⧸ stageH N hN hA n) =
    QuotientGroup.mk (g * (sect N (x : G ⧸ N) *
      windowEmb N hA n (Quotient.out q)))
  congr 1
  rw [map_mul, hbG, esCocycle]
  group

end

end AmenableExtensionTrace
end GroupApproximation
