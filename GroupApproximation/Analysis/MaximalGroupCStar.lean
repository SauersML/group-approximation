import GroupApproximation.Analysis.MFAlgebra
import GroupApproximation.Analysis.ReducedGroupCStarMFObstruction
import Mathlib.Analysis.CStarAlgebra.lpSpace
import Mathlib.Analysis.CStarAlgebra.Spectrum

/-!
# The maximal group C-star algebra

For a group `G : Type u`, this file constructs a universe-relative maximal
group C-star algebra without assuming an external existence theorem.  Its
ambient algebra is the bounded product of every unitary representation of
`G` on a nontrivial C-star algebra in `Type u`.  The maximal algebra is the
closed star subalgebra generated by the diagonal universal representation.

This model has three useful features.

* The canonical group map is injective: the family of coordinates contains
  the concrete left regular representation.
* Every same-universe unitary representation is a coordinate projection and
  therefore extends uniquely to a star-algebra homomorphism.
* The construction uses only mathlib's bounded dependent product and closed
  star-subalgebra APIs; no maximal-completion or representation theorem is
  assumed.

The carrier lies in `Type (u + 1)` because the index contains all carrier
types in `Type u`.  The universal property below is correspondingly stated
for targets in `Type u`.
-/

namespace GroupApproximation

open scoped CStarAlgebra ENNReal

noncomputable section

universe u

variable (G : Type u) [Group G]

/-- A same-universe unitary representation, including its target C-star
algebra structure as proof-carrying data.  Trivial targets are omitted from
the universal product and handled separately in the universal property. -/
structure CStarUnitaryRepresentation where
  carrier : Type u
  instCStarAlgebra : CStarAlgebra carrier
  instNontrivial : Nontrivial carrier
  hom : letI : CStarAlgebra carrier := instCStarAlgebra
    G →* unitary carrier

namespace CStarUnitaryRepresentation

instance (R : CStarUnitaryRepresentation G) : CStarAlgebra R.carrier :=
  R.instCStarAlgebra

instance (R : CStarUnitaryRepresentation G) : Nontrivial R.carrier :=
  R.instNontrivial

/-- Package a representation on a nontrivial same-universe target as a
coordinate of the universal product. -/
def ofHom {B : Type u} [CStarAlgebra B] [Nontrivial B]
    (rho : G →* unitary B) : CStarUnitaryRepresentation G where
  carrier := B
  instCStarAlgebra := inferInstance
  instNontrivial := inferInstance
  hom := rho

/-- The concrete left regular representation is one coordinate of the
universal product. -/
def reduced : CStarUnitaryRepresentation G where
  carrier := ReducedGroupCStarTrace.ReducedGroupCStar G
  instCStarAlgebra := inferInstance
  instNontrivial := inferInstance
  hom := reducedLeftRegularUnitaryHom G

instance : Nonempty (CStarUnitaryRepresentation G) := ⟨reduced G⟩

end CStarUnitaryRepresentation

/-- The bounded dependent product containing every same-universe nontrivial
unitary representation of `G`. -/
abbrev MaximalGroupCStarAmbient :=
  lp (fun R : CStarUnitaryRepresentation G ↦ R.carrier) ∞

/-- The bounded universal product is a unital complex C-star algebra. -/
noncomputable instance maximalGroupCStarAmbientCStarAlgebra :
    CStarAlgebra (MaximalGroupCStarAmbient G) where
  toNormedRing := inferInstance
  toStarRing := inferInstance
  toCompleteSpace := inferInstance
  toCStarRing := inferInstance
  toNormedAlgebra := inferInstance
  toStarModule := inferInstance

/-- The diagonal element determined by `g` is unitary in the bounded
universal product. -/
def maximalGroupCStarAmbientUnitary (g : G) :
    unitary (MaximalGroupCStarAmbient G) :=
  ⟨⟨fun R ↦ (R.hom g : R.carrier), memℓp_infty ⟨1, by
      rintro _ ⟨R, rfl⟩
      exact (CStarRing.norm_of_mem_unitary (R.hom g).property).le⟩⟩, by
    constructor
    · apply lp.ext
      funext R
      exact (R.hom g).property.1
    · apply lp.ext
      funext R
      exact (R.hom g).property.2⟩

/-- The diagonal universal unitary representation. -/
def maximalGroupCStarAmbientRepresentation :
    G →* unitary (MaximalGroupCStarAmbient G) where
  toFun := maximalGroupCStarAmbientUnitary G
  map_one' := by
    apply Subtype.ext
    apply lp.ext
    funext R
    exact congrArg Subtype.val (map_one R.hom)
  map_mul' g h := by
    apply Subtype.ext
    apply lp.ext
    funext R
    exact congrArg Subtype.val (map_mul R.hom g h)

/-- The closed star subalgebra generated by the diagonal universal unitary
representation. -/
def maximalGroupCStarSubalgebra :
    StarSubalgebra ℂ (MaximalGroupCStarAmbient G) :=
  (StarAlgebra.adjoin ℂ
    (Set.range (fun g : G ↦
      (maximalGroupCStarAmbientRepresentation G g :
        MaximalGroupCStarAmbient G)))).topologicalClosure

/-- The canonical universe-relative maximal group C-star algebra. -/
abbrev MaximalGroupCStar : Type (u + 1) :=
  maximalGroupCStarSubalgebra G

instance maximalGroupCStar_isClosed :
    IsClosed (maximalGroupCStarSubalgebra G :
      Set (MaximalGroupCStarAmbient G)) :=
  StarSubalgebra.isClosed_topologicalClosure _

/-- The maximal group C-star algebra has the C-star structure inherited from
the bounded universal product. -/
noncomputable instance maximalGroupCStarCStarAlgebra :
    CStarAlgebra (MaximalGroupCStar G) :=
  inferInstance

/-- The canonical generator inside the closed generated star subalgebra. -/
def maximalGroupCStarGenerator (g : G) : MaximalGroupCStar G :=
  ⟨(maximalGroupCStarAmbientRepresentation G g : MaximalGroupCStarAmbient G),
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ ⟨g, rfl⟩)⟩

/-- Each canonical generator is unitary. -/
def maximalGroupCStarUnitary (g : G) : unitary (MaximalGroupCStar G) :=
  ⟨maximalGroupCStarGenerator G g, by
    constructor
    · apply Subtype.ext
      exact (maximalGroupCStarAmbientRepresentation G g).property.1
    · apply Subtype.ext
      exact (maximalGroupCStarAmbientRepresentation G g).property.2⟩

/-- The canonical group homomorphism into the unitary group of its maximal
group C-star algebra. -/
def maximalGroupCStarUnitaryHom : G →* unitary (MaximalGroupCStar G) where
  toFun := maximalGroupCStarUnitary G
  map_one' := by
    apply Subtype.ext
    apply Subtype.ext
    apply lp.ext
    funext R
    exact congrArg Subtype.val (map_one R.hom)
  map_mul' g h := by
    apply Subtype.ext
    apply Subtype.ext
    apply lp.ext
    funext R
    exact congrArg Subtype.val (map_mul R.hom g h)

/-- Evaluation at one representation coordinate is a star-algebra
homomorphism from the bounded universal product. -/
def maximalGroupCStarAmbientEval (R : CStarUnitaryRepresentation G) :
    MaximalGroupCStarAmbient G →⋆ₐ[ℂ] R.carrier where
  toFun f := f R
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl
  map_star' _ := rfl

/-- Evaluation at one representation coordinate, restricted to the maximal
group C-star algebra. -/
def maximalGroupCStarEval (R : CStarUnitaryRepresentation G) :
    MaximalGroupCStar G →⋆ₐ[ℂ] R.carrier :=
  (maximalGroupCStarAmbientEval G R).comp
    (maximalGroupCStarSubalgebra G).subtype

@[simp] theorem maximalGroupCStarEval_generator
    (R : CStarUnitaryRepresentation G) (g : G) :
    maximalGroupCStarEval G R (maximalGroupCStarGenerator G g) =
      (R.hom g : R.carrier) :=
  rfl

/-- The canonical group map is faithful.  Equality of two diagonal
generators can be tested at the concrete left regular coordinate. -/
theorem maximalGroupCStarUnitaryHom_injective :
    Function.Injective (maximalGroupCStarUnitaryHom G) := by
  intro g h hgh
  have hgen : maximalGroupCStarGenerator G g =
      maximalGroupCStarGenerator G h :=
    congrArg Subtype.val hgh
  have hreg := congrArg
    (maximalGroupCStarEval G (CStarUnitaryRepresentation.reduced G)) hgen
  change
    (reducedLeftRegularUnitaryHom G g :
      ReducedGroupCStarTrace.ReducedGroupCStar G) =
    (reducedLeftRegularUnitaryHom G h :
      ReducedGroupCStarTrace.ReducedGroupCStar G) at hreg
  apply reducedLeftRegularUnitaryHom_injective G
  apply Subtype.ext
  exact hreg

/-- On a nontrivial same-universe target, a representation extends by its
coordinate projection. -/
def maximalGroupCStarLift {B : Type u} [CStarAlgebra B] [Nontrivial B]
    (rho : G →* unitary B) : MaximalGroupCStar G →⋆ₐ[ℂ] B :=
  maximalGroupCStarEval G (CStarUnitaryRepresentation.ofHom G rho)

@[simp] theorem maximalGroupCStarLift_generator
    {B : Type u} [CStarAlgebra B] [Nontrivial B]
    (rho : G →* unitary B) (g : G) :
    maximalGroupCStarLift G rho (maximalGroupCStarGenerator G g) =
      (rho g : B) :=
  rfl

/-- Universal property of the universe-relative maximal group C-star
algebra.  Trivial targets are handled by their unique star-algebra map;
nontrivial targets are literal coordinates of the universal product. -/
theorem maximalGroupCStar_existsUnique_lift
    {B : Type u} [CStarAlgebra B] (rho : G →* unitary B) :
    ∃! f : MaximalGroupCStar G →⋆ₐ[ℂ] B,
      ∀ g : G, f (maximalGroupCStarGenerator G g) = (rho g : B) := by
  classical
  rcases subsingleton_or_nontrivial B with hB | hB
  · letI : Subsingleton B := hB
    let f : MaximalGroupCStar G →⋆ₐ[ℂ] B :=
      { toFun := fun _ ↦ 0
        map_one' := Subsingleton.elim _ _
        map_mul' := fun _ _ ↦ Subsingleton.elim _ _
        map_zero' := rfl
        map_add' := fun _ _ ↦ Subsingleton.elim _ _
        commutes' := fun _ ↦ Subsingleton.elim _ _
        map_star' := fun _ ↦ Subsingleton.elim _ _ }
    refine ⟨f, fun _ ↦ Subsingleton.elim _ _, ?_⟩
    intro q _
    exact StarAlgHom.ext fun _ ↦ Subsingleton.elim _ _
  · letI : Nontrivial B := hB
    let f := maximalGroupCStarLift G rho
    refine ⟨f, maximalGroupCStarLift_generator G rho, ?_⟩
    intro q hq
    apply StarAlgHom.ext_topologicalClosure
        (R := ℂ) (A := MaximalGroupCStarAmbient G) (B := B)
        (map_continuous q) (map_continuous f)
    apply StarAlgHom.ext_adjoin
    intro x hx
    obtain ⟨g, hg⟩ := hx
    have hx' : x =
        ⟨(maximalGroupCStarAmbientRepresentation G g :
          MaximalGroupCStarAmbient G),
          StarAlgebra.subset_adjoin ℂ _ ⟨g, rfl⟩⟩ := by
      apply Subtype.ext
      exact hg.symm
    rw [hx']
    exact hq g

/-- Exact public package for the manuscript's universe-relative maximal
group C-star algebra: the canonical unitary representation is faithful, and
every unitary representation on a same-universe C-star algebra extends
uniquely across the canonical generators. -/
theorem manuscriptUniverseRelativeMaximalGroupCStar :
    ∀ (G : Type u) [Group G],
    Function.Injective (maximalGroupCStarUnitaryHom G) ∧
      ∀ (B : Type u) [CStarAlgebra B] (rho : G →* unitary B),
        ∃! f : MaximalGroupCStar G →⋆ₐ[ℂ] B,
          ∀ g : G,
            f (maximalGroupCStarGenerator G g) = (rho g : B) := by
  intro G _
  exact ⟨maximalGroupCStarUnitaryHom_injective G,
    fun _ _ rho ↦ maximalGroupCStar_existsUnique_lift G rho⟩

/-- A faithful MF embedding of the maximal group C-star algebra would
restrict to a faithful MF embedding of the group. -/
theorem isOperatorMF_of_maximalGroupCStar_hasMFEmbedding [Countable G]
    (h : HasMFEmbedding (MaximalGroupCStar G)) : IsOperatorMF G :=
  h.isOperatorMF (maximalGroupCStarUnitaryHom G)
    (maximalGroupCStarUnitaryHom_injective G)

/-- A non-MF group has a maximal group C-star algebra with no
faithful norm-matrix-corona embedding. -/
theorem maximalGroupCStar_not_hasMFEmbedding_of_not_isOperatorMF
    [Countable G] (h : ¬ IsOperatorMF G) :
    ¬ HasMFEmbedding (MaximalGroupCStar G) :=
  mt (isOperatorMF_of_maximalGroupCStar_hasMFEmbedding G) h

/-- Consequently, the maximal group C-star algebra of a non-MF
group is not an MF C-star algebra. -/
theorem maximalGroupCStar_not_isMFAlgebra_of_not_isOperatorMF
    [Countable G] (h : ¬ IsOperatorMF G) :
    ¬ IsMFAlgebra (MaximalGroupCStar G) := by
  intro hMF
  exact maximalGroupCStar_not_hasMFEmbedding_of_not_isOperatorMF G h hMF.2

end

end GroupApproximation
