import Mathlib.Analysis.CStarAlgebra.Hom
import Mathlib.Analysis.CStarAlgebra.lpSpace

/-!
# A target-universe-relative full C-star amalgam

`UniversalCStarAmalgam` indexes compatible representations whose carriers
live in the same universe as the two factors.  The two-by-two HNN corner
argument needs one larger target universe: the faithful coordinate is a
matrix algebra over the already constructed universal HNN algebra.

This file supplies exactly that universe-polymorphic variant.  The full
amalgam is again the closed star subalgebra of the bounded product of all
compatible representations in the chosen target universe.  Only the factor
maps, coordinate evaluations, and the faithful-coordinate criterion needed
by the corner argument are included here.
-/

namespace GroupApproximation

open scoped CStarAlgebra ENNReal

noncomputable section

universe u v

variable {C A B : Type u} [CStarAlgebra C] [CStarAlgebra A] [CStarAlgebra B]
variable (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)

/-- A compatible pair whose target lives in an independently chosen
universe. -/
structure LargeCStarAmalgamRepresentation where
  carrier : Type v
  instCStarAlgebra : CStarAlgebra carrier
  instNontrivial : Nontrivial carrier
  left : letI : CStarAlgebra carrier := instCStarAlgebra
    A →⋆ₐ[ℂ] carrier
  right : letI : CStarAlgebra carrier := instCStarAlgebra
    B →⋆ₐ[ℂ] carrier
  compatible : letI : CStarAlgebra carrier := instCStarAlgebra
    left.comp iA = right.comp iB

namespace LargeCStarAmalgamRepresentation

instance (R : LargeCStarAmalgamRepresentation.{u, v} iA iB) :
    CStarAlgebra R.carrier :=
  R.instCStarAlgebra

instance (R : LargeCStarAmalgamRepresentation.{u, v} iA iB) :
    Nontrivial R.carrier :=
  R.instNontrivial

/-- Package one compatible pair. -/
def ofCompatiblePair {E : Type v} [CStarAlgebra E] [Nontrivial E]
    (left : A →⋆ₐ[ℂ] E) (right : B →⋆ₐ[ℂ] E)
    (h : left.comp iA = right.comp iB) :
    LargeCStarAmalgamRepresentation.{u, v} iA iB where
  carrier := E
  instCStarAlgebra := inferInstance
  instNontrivial := inferInstance
  left := left
  right := right
  compatible := h

end LargeCStarAmalgamRepresentation

/-- The bounded product of all compatible target-universe representations. -/
abbrev LargeUniversalCStarAmalgamAmbient :=
  lp (fun R : LargeCStarAmalgamRepresentation.{u, v} iA iB ↦ R.carrier) ∞

noncomputable instance largeUniversalCStarAmalgamAmbientCStarAlgebra
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    CStarAlgebra (LargeUniversalCStarAmalgamAmbient.{u, v} iA iB) where
  toNormedRing := inferInstance
  toStarRing := inferInstance
  toCompleteSpace := inferInstance
  toCStarRing := inferInstance
  toNormedAlgebra := inferInstance
  toStarModule := inferInstance

/-- The diagonal left-factor representation. -/
def largeUniversalCStarAmalgamLeftAmbient
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    A →⋆ₐ[ℂ] LargeUniversalCStarAmalgamAmbient.{u, v} iA iB where
  toFun a := ⟨fun R ↦ R.left a, memℓp_infty ⟨‖a‖, by
    rintro _ ⟨R, rfl⟩
    exact NonUnitalStarAlgHom.norm_apply_le R.left a⟩⟩
  map_one' := by apply lp.ext; funext R; exact map_one R.left
  map_mul' _ _ := by apply lp.ext; funext R; exact map_mul R.left _ _
  map_zero' := by apply lp.ext; funext R; exact map_zero R.left
  map_add' _ _ := by apply lp.ext; funext R; exact map_add R.left _ _
  commutes' _ := by apply lp.ext; funext R; exact R.left.commutes _
  map_star' _ := by apply lp.ext; funext R; exact map_star R.left _

/-- The diagonal right-factor representation. -/
def largeUniversalCStarAmalgamRightAmbient
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    B →⋆ₐ[ℂ] LargeUniversalCStarAmalgamAmbient.{u, v} iA iB where
  toFun b := ⟨fun R ↦ R.right b, memℓp_infty ⟨‖b‖, by
    rintro _ ⟨R, rfl⟩
    exact NonUnitalStarAlgHom.norm_apply_le R.right b⟩⟩
  map_one' := by apply lp.ext; funext R; exact map_one R.right
  map_mul' _ _ := by apply lp.ext; funext R; exact map_mul R.right _ _
  map_zero' := by apply lp.ext; funext R; exact map_zero R.right
  map_add' _ _ := by apply lp.ext; funext R; exact map_add R.right _ _
  commutes' _ := by apply lp.ext; funext R; exact R.right.commutes _
  map_star' _ := by apply lp.ext; funext R; exact map_star R.right _

/-- The closed star subalgebra generated by the two factor maps. -/
def largeUniversalCStarAmalgamSubalgebra
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    StarSubalgebra ℂ (LargeUniversalCStarAmalgamAmbient.{u, v} iA iB) :=
  (StarAlgebra.adjoin ℂ
    (Set.range (largeUniversalCStarAmalgamLeftAmbient iA iB) ∪
      Set.range (largeUniversalCStarAmalgamRightAmbient iA iB))).topologicalClosure

/-- The target-universe-relative full C-star amalgam. -/
abbrev LargeUniversalCStarAmalgam
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :=
  largeUniversalCStarAmalgamSubalgebra iA iB

instance largeUniversalCStarAmalgam_isClosed
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    IsClosed (largeUniversalCStarAmalgamSubalgebra iA iB :
      Set (LargeUniversalCStarAmalgamAmbient.{u, v} iA iB)) :=
  StarSubalgebra.isClosed_topologicalClosure _

noncomputable instance largeUniversalCStarAmalgamCStarAlgebra
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    CStarAlgebra (LargeUniversalCStarAmalgam.{u, v} iA iB) :=
  inferInstance

/-- The canonical left-factor map. -/
def largeUniversalCStarAmalgamLeft
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    A →⋆ₐ[ℂ] LargeUniversalCStarAmalgam.{u, v} iA iB where
  toFun a := ⟨largeUniversalCStarAmalgamLeftAmbient iA iB a,
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨a, rfl⟩))⟩
  map_one' := Subtype.ext (map_one (largeUniversalCStarAmalgamLeftAmbient iA iB))
  map_mul' _ _ :=
    Subtype.ext (map_mul (largeUniversalCStarAmalgamLeftAmbient iA iB) _ _)
  map_zero' := Subtype.ext (map_zero (largeUniversalCStarAmalgamLeftAmbient iA iB))
  map_add' _ _ :=
    Subtype.ext (map_add (largeUniversalCStarAmalgamLeftAmbient iA iB) _ _)
  commutes' _ :=
    Subtype.ext ((largeUniversalCStarAmalgamLeftAmbient iA iB).commutes _)
  map_star' _ :=
    Subtype.ext (map_star (largeUniversalCStarAmalgamLeftAmbient iA iB) _)

/-- The canonical right-factor map. -/
def largeUniversalCStarAmalgamRight
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    B →⋆ₐ[ℂ] LargeUniversalCStarAmalgam.{u, v} iA iB where
  toFun b := ⟨largeUniversalCStarAmalgamRightAmbient iA iB b,
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inr ⟨b, rfl⟩))⟩
  map_one' := Subtype.ext (map_one (largeUniversalCStarAmalgamRightAmbient iA iB))
  map_mul' _ _ :=
    Subtype.ext (map_mul (largeUniversalCStarAmalgamRightAmbient iA iB) _ _)
  map_zero' := Subtype.ext (map_zero (largeUniversalCStarAmalgamRightAmbient iA iB))
  map_add' _ _ :=
    Subtype.ext (map_add (largeUniversalCStarAmalgamRightAmbient iA iB) _ _)
  commutes' _ :=
    Subtype.ext ((largeUniversalCStarAmalgamRightAmbient iA iB).commutes _)
  map_star' _ :=
    Subtype.ext (map_star (largeUniversalCStarAmalgamRightAmbient iA iB) _)

/-- The canonical factor maps agree on the amalgamated algebra. -/
theorem largeUniversalCStarAmalgam_compatible
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)] :
    (largeUniversalCStarAmalgamLeft iA iB).comp iA =
      (largeUniversalCStarAmalgamRight iA iB).comp iB := by
  apply StarAlgHom.ext
  intro c
  apply Subtype.ext
  apply lp.ext
  funext R
  exact congrArg (fun f : C →⋆ₐ[ℂ] R.carrier ↦ f c) R.compatible

/-- Evaluation at one compatible coordinate. -/
def largeUniversalCStarAmalgamEval
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)]
    (R : LargeCStarAmalgamRepresentation.{u, v} iA iB) :
    LargeUniversalCStarAmalgam.{u, v} iA iB →⋆ₐ[ℂ] R.carrier :=
  ({ toFun := fun f ↦ f R
     map_one' := rfl
     map_mul' := fun _ _ ↦ rfl
     map_zero' := rfl
     map_add' := fun _ _ ↦ rfl
     commutes' := fun _ ↦ rfl
     map_star' := fun _ ↦ rfl } :
      LargeUniversalCStarAmalgamAmbient.{u, v} iA iB →⋆ₐ[ℂ] R.carrier).comp
    (largeUniversalCStarAmalgamSubalgebra iA iB).subtype

@[simp] theorem largeUniversalCStarAmalgamEval_left
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)]
    (R : LargeCStarAmalgamRepresentation.{u, v} iA iB) (a : A) :
    largeUniversalCStarAmalgamEval iA iB R
        (largeUniversalCStarAmalgamLeft iA iB a) = R.left a :=
  rfl

@[simp] theorem largeUniversalCStarAmalgamEval_right
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)]
    (R : LargeCStarAmalgamRepresentation.{u, v} iA iB) (b : B) :
    largeUniversalCStarAmalgamEval iA iB R
        (largeUniversalCStarAmalgamRight iA iB b) = R.right b :=
  rfl

/-- A coordinate faithful on the left factor makes the universal left map
faithful. -/
theorem largeUniversalCStarAmalgamLeft_injective_of_coordinate
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)]
    (R : LargeCStarAmalgamRepresentation.{u, v} iA iB)
    (hR : Function.Injective R.left) :
    Function.Injective (largeUniversalCStarAmalgamLeft iA iB) := by
  intro a a' haa
  apply hR
  have h := congrArg (largeUniversalCStarAmalgamEval iA iB R) haa
  simpa using h

/-- A coordinate faithful on the right factor makes the universal right map
faithful. -/
theorem largeUniversalCStarAmalgamRight_injective_of_coordinate
    [Nonempty (LargeCStarAmalgamRepresentation.{u, v} iA iB)]
    (R : LargeCStarAmalgamRepresentation.{u, v} iA iB)
    (hR : Function.Injective R.right) :
    Function.Injective (largeUniversalCStarAmalgamRight iA iB) := by
  intro b b' hbb
  apply hR
  have h := congrArg (largeUniversalCStarAmalgamEval iA iB R) hbb
  simpa using h

end

end GroupApproximation
