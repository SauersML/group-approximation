import GroupApproximation.Analysis.CStarGeneratedSeparableUnion
import GroupApproximation.Analysis.ReducedProductMFPermanence
import GroupApproximation.Analysis.UniversalCStarAmalgam

/-!
# Norming families of compatible representations make the full amalgam MF

`Analysis/MFAlgebraAmalgamCriterion` builds, from one compatible pair of
corona homomorphisms, a single evaluation coordinate of the universal full
amalgam, and records that the evaluation need not be faithful.  This module
supplies the step that turns *many* evaluation coordinates into an MF
embedding, so that no single coordinate has to be faithful.

The input is a *norming family*: for every element `x` of the amalgam and
every `ε > 0` some compatible representation whose carrier is MF has
`‖x‖ - ε ≤ ‖eval_R x‖`.  A diagonal choice over a dense sequence of the
amalgam and over `ε = 1/(m+1)` produces a single sequence `R : ℕ →
CStarAmalgamRepresentation iA iB` whose joint evaluation into the *reduced*
product `∏_j R_j / ⨁_j R_j` is injective — for a nonzero `x` the coordinate
norms `‖eval_{R_j} x‖` stay above `‖x‖/2` on an infinite set of `j`, so the
image sequence is not null.  `ReducedProductMFPermanence` then makes the
amalgam MF outright.

Nothing here assumes any amalgam permanence statement: the norming property
is an explicit hypothesis, and it is the only remaining input of Shulman's
Theorem 16 after this module (see `Analysis/ShulmanFillTheorem16`).

The separability lemma below repeats the one in the unwired module
`Analysis/MFAlgebraAmalgamFaithfulEval`; it is restated here so that this
file depends only on modules in the root import closure.
-/

namespace GroupApproximation
namespace ShulmanFill

open Filter PolarLiftingGeneralCStar

noncomputable section

variable {C A B : Type}
  [CStarAlgebra C] [CStarAlgebra A] [CStarAlgebra B]
  (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)
  [Nonempty (CStarAmalgamRepresentation iA iB)]

/-! ## Separability of the universal amalgam -/

/-- The universal full amalgam of two separable factors is separable.  The
ambient bounded product is not, but the amalgam is generated by the two
factor ranges. -/
theorem separableSpace_universalCStarAmalgam
    [TopologicalSpace.SeparableSpace A] [TopologicalSpace.SeparableSpace B] :
    TopologicalSpace.SeparableSpace (UniversalCStarAmalgam iA iB) := by
  change TopologicalSpace.SeparableSpace
    ((StarAlgebra.adjoin ℂ
      (Set.range (universalCStarAmalgamLeftAmbient iA iB) ∪
        Set.range (universalCStarAmalgamRightAmbient iA iB))).topologicalClosure)
  exact topologicalClosure_adjoin_union_range_separable
    (universalCStarAmalgamLeftAmbient iA iB)
    (universalCStarAmalgamRightAmbient iA iB)

/-! ## Joint evaluation at a sequence of compatible representations -/

/-- Evaluation of the universal amalgam at a whole sequence of compatible
representations, as a bounded sequence.  Each coordinate is contractive, so
the sequence of coordinates is bounded by `‖x‖`. -/
def sequenceEvalBounded (R : ℕ → CStarAmalgamRepresentation iA iB) :
    UniversalCStarAmalgam iA iB →⋆ₐ[ℂ]
      BoundedCStarSequence (fun j ↦ (R j).carrier) where
  toFun x := ⟨fun j ↦ universalCStarAmalgamEval iA iB (R j) x, memℓp_infty ⟨‖x‖, by
    rintro _ ⟨j, rfl⟩
    exact NonUnitalStarAlgHom.norm_apply_le
      (universalCStarAmalgamEval iA iB (R j)) x⟩⟩
  map_one' := by apply lp.ext; funext j; exact map_one _
  map_mul' _ _ := by apply lp.ext; funext j; exact map_mul _ _ _
  map_zero' := by apply lp.ext; funext j; exact map_zero _
  map_add' _ _ := by apply lp.ext; funext j; exact map_add _ _ _
  commutes' _ := by
    apply lp.ext; funext j
    exact (universalCStarAmalgamEval iA iB (R j)).commutes _
  map_star' _ := by apply lp.ext; funext j; exact map_star _ _

@[simp] theorem sequenceEvalBounded_apply
    (R : ℕ → CStarAmalgamRepresentation iA iB)
    (x : UniversalCStarAmalgam iA iB) (j : ℕ) :
    sequenceEvalBounded iA iB R x j =
      universalCStarAmalgamEval iA iB (R j) x := rfl

/-- The joint evaluation, followed by the passage to the reduced product. -/
def sequenceEvalCorona (R : ℕ → CStarAmalgamRepresentation iA iB) :
    UniversalCStarAmalgam iA iB →⋆ₐ[ℂ]
      CStarProductCorona (fun j ↦ (R j).carrier) cofinite :=
  (cStarProductCoronaQuotient (fun j ↦ (R j).carrier) cofinite).comp
    (sequenceEvalBounded iA iB R)

/-- The joint reduced-product evaluation is faithful as soon as no nonzero
element of the amalgam has null coordinate norms. -/
theorem sequenceEvalCorona_injective (R : ℕ → CStarAmalgamRepresentation iA iB)
    (hnull : ∀ x : UniversalCStarAmalgam iA iB, x ≠ 0 →
      ¬ IsNullCStarSequence (fun j ↦ (R j).carrier) cofinite
          (sequenceEvalBounded iA iB R x)) :
    Function.Injective (sequenceEvalCorona iA iB R) := by
  intro x y hxy
  by_contra hne
  refine hnull (x - y) (sub_ne_zero.mpr hne) ?_
  rw [← cStarProductCoronaQuotient_eq_zero_iff]
  have hzero : sequenceEvalCorona iA iB R (x - y) = 0 := by
    rw [map_sub, hxy, sub_self]
  exact hzero

/-! ## The norming criterion -/

/-- **Norming families make the full amalgam MF.**  If every element of the
universal amalgam has its norm approximated by evaluations at compatible
representations with MF carriers, then the amalgam is MF.

The proof is a diagonal choice: pick, for the `k`-th member of a dense
sequence and for `ε = 1/(m+1)`, a representation `R_{k,m}` almost norming it,
enumerate the family along Cantor pairing, and evaluate jointly into the
reduced product of the carriers.  The estimate

`‖eval_{R_j} x‖ ≥ ‖a_k‖ - 1/(m+1) - ‖x - a_k‖ ≥ ‖x‖ - 2‖x - a_k‖ - 1/(m+1)`

holds on the infinite set `j = ⟨k, m⟩`, `m ≥ M`, so the joint evaluation of a
nonzero `x` is not a null sequence. -/
theorem isMFAlgebra_of_norming_representations
    [TopologicalSpace.SeparableSpace A] [TopologicalSpace.SeparableSpace B]
    (hnorm : ∀ (x : UniversalCStarAmalgam iA iB) (ε : ℝ), 0 < ε →
      ∃ R : CStarAmalgamRepresentation iA iB,
        HasMFEmbedding R.carrier ∧
          ‖x‖ - ε ≤ ‖universalCStarAmalgamEval iA iB R x‖) :
    IsMFAlgebra (UniversalCStarAmalgam iA iB) := by
  haveI : TopologicalSpace.SeparableSpace (UniversalCStarAmalgam iA iB) :=
    separableSpace_universalCStarAmalgam iA iB
  set a : ℕ → UniversalCStarAmalgam iA iB :=
    TopologicalSpace.denseSeq (UniversalCStarAmalgam iA iB) with ha_def
  have ha : DenseRange a :=
    TopologicalSpace.denseRange_denseSeq (UniversalCStarAmalgam iA iB)
  have hstep : ∀ km : ℕ × ℕ, ∃ R : CStarAmalgamRepresentation iA iB,
      HasMFEmbedding R.carrier ∧
        ‖a km.1‖ - 1 / (km.2 + 1 : ℝ) ≤
          ‖universalCStarAmalgamEval iA iB R (a km.1)‖ := fun km ↦
    hnorm (a km.1) (1 / (km.2 + 1 : ℝ)) (by positivity)
  choose Rf hRfMF hRfNorm using hstep
  set R : ℕ → CStarAmalgamRepresentation iA iB := fun j ↦ Rf (Nat.unpair j)
    with hR_def
  have hinjective : Function.Injective (sequenceEvalCorona iA iB R) := by
    refine sequenceEvalCorona_injective iA iB R ?_
    intro x hx hnullx
    have hδ : 0 < ‖x‖ := norm_pos_iff.mpr hx
    obtain ⟨k, hk⟩ : ∃ k, ‖x - a k‖ < ‖x‖ / 8 := by
      obtain ⟨k, hk⟩ := Metric.denseRange_iff.mp ha x (‖x‖ / 8) (by positivity)
      exact ⟨k, by rwa [dist_eq_norm] at hk⟩
    obtain ⟨M, hM⟩ : ∃ M : ℕ, 1 / (M + 1 : ℝ) < ‖x‖ / 8 :=
      exists_nat_one_div_lt (by positivity)
    have key0 : ∀ (m : ℕ) (S : CStarAmalgamRepresentation iA iB),
        ‖a k‖ - 1 / ((M + m : ℕ) + 1 : ℝ) ≤
            ‖universalCStarAmalgamEval iA iB S (a k)‖ →
          ‖x‖ / 2 ≤ ‖universalCStarAmalgamEval iA iB S x‖ := by
      intro m S hS
      have hsub : ‖universalCStarAmalgamEval iA iB S (a k)‖ -
          ‖universalCStarAmalgamEval iA iB S x‖ ≤ ‖x - a k‖ := by
        calc ‖universalCStarAmalgamEval iA iB S (a k)‖ -
              ‖universalCStarAmalgamEval iA iB S x‖
            ≤ ‖universalCStarAmalgamEval iA iB S (a k) -
                universalCStarAmalgamEval iA iB S x‖ := norm_sub_norm_le _ _
          _ = ‖universalCStarAmalgamEval iA iB S (a k - x)‖ := by rw [map_sub]
          _ ≤ ‖a k - x‖ :=
              NonUnitalStarAlgHom.norm_apply_le
                (universalCStarAmalgamEval iA iB S) (a k - x)
          _ = ‖x - a k‖ := norm_sub_rev _ _
      have hak_lower : ‖x‖ - ‖x - a k‖ ≤ ‖a k‖ := by
        have hx' := norm_sub_norm_le x (x - a k)
        simpa using hx'
      have hone : 1 / ((M + m : ℕ) + 1 : ℝ) ≤ 1 / (M + 1 : ℝ) := by
        apply one_div_le_one_div_of_le (by positivity)
        push_cast
        linarith [Nat.cast_nonneg (α := ℝ) m]
      linarith
    have key : ∀ m : ℕ, ‖x‖ / 2 ≤
        ‖universalCStarAmalgamEval iA iB (R (Nat.pair k (M + m))) x‖ := by
      intro m
      refine key0 m (R (Nat.pair k (M + m))) ?_
      have hR : R (Nat.pair k (M + m)) = Rf (k, M + m) := by
        rw [hR_def]
        simp only [Nat.unpair_pair]
      rw [hR]
      exact hRfNorm (k, M + m)
    have hfinite : {j : ℕ | ‖sequenceEvalBounded iA iB R x j‖ < ‖x‖ / 2}ᶜ.Finite :=
      Filter.mem_cofinite.mp (hnullx (Iio_mem_nhds (by positivity)))
    have hsubset : Set.range (fun m : ℕ ↦ Nat.pair k (M + m)) ⊆
        {j : ℕ | ‖sequenceEvalBounded iA iB R x j‖ < ‖x‖ / 2}ᶜ := by
      rintro _ ⟨m, rfl⟩
      exact not_lt.mpr (key m)
    have hpairinj : Function.Injective fun m : ℕ ↦ Nat.pair k (M + m) := by
      intro m₁ m₂ hm
      have hun := congrArg Nat.unpair hm
      simp only [Nat.unpair_pair, Prod.mk.injEq] at hun
      omega
    exact Set.infinite_range_of_injective hpairinj (hfinite.subset hsubset)
  exact ReducedProductMFPermanence.isMFAlgebra_of_injective_reducedProduct
    (fun j ↦ (R j).carrier)
    (sequenceEvalCorona iA iB R).toNonUnitalStarAlgHom hinjective
    (fun j ↦ hRfMF (Nat.unpair j))

/-! ## The amalgam norm is the supremum of the evaluation norms -/

/-- The universal amalgam sits in the bounded product of all compatible
representations, so its norm is the supremum of the norms of its evaluation
coordinates. -/
theorem norm_eq_ciSup_universalCStarAmalgamEval
    (x : UniversalCStarAmalgam iA iB) :
    ‖x‖ = ⨆ S : CStarAmalgamRepresentation iA iB,
      ‖universalCStarAmalgamEval iA iB S x‖ :=
  lp.norm_eq_ciSup (x : UniversalCStarAmalgamAmbient iA iB)

/-- **Domination gives norming.**  If every evaluation coordinate is
approximated by one with an MF carrier, then the MF-carrier coordinates
compute the amalgam norm: the norm is the supremum over *all* coordinates,
and each of them is approximated. -/
theorem norming_of_dominating_representations
    (hdom : ∀ (S : CStarAmalgamRepresentation iA iB)
      (x : UniversalCStarAmalgam iA iB) (ε : ℝ), 0 < ε →
      ∃ R : CStarAmalgamRepresentation iA iB,
        HasMFEmbedding R.carrier ∧
          ‖universalCStarAmalgamEval iA iB S x‖ - ε ≤
            ‖universalCStarAmalgamEval iA iB R x‖)
    (x : UniversalCStarAmalgam iA iB) (ε : ℝ) (hε : 0 < ε) :
    ∃ R : CStarAmalgamRepresentation iA iB,
      HasMFEmbedding R.carrier ∧
        ‖x‖ - ε ≤ ‖universalCStarAmalgamEval iA iB R x‖ := by
  have hlt : ‖x‖ - ε / 2 < ⨆ S : CStarAmalgamRepresentation iA iB,
      ‖universalCStarAmalgamEval iA iB S x‖ := by
    rw [← norm_eq_ciSup_universalCStarAmalgamEval iA iB x]
    linarith
  obtain ⟨S, hS⟩ := exists_lt_of_lt_ciSup hlt
  obtain ⟨R, hRMF, hR⟩ := hdom S x (ε / 2) (by linarith)
  exact ⟨R, hRMF, by linarith⟩

/-! ## Faithful evaluation is the special case of a constant norming family -/

/-- An evaluation coordinate that happens to be faithful is norming, because
an injective star homomorphism of C-star algebras is isometric.  So the
criterion above subsumes the single-coordinate one. -/
theorem norming_of_faithful_eval (R : CStarAmalgamRepresentation iA iB)
    (hR : HasMFEmbedding R.carrier)
    (hfaithful : Function.Injective (universalCStarAmalgamEval iA iB R))
    (x : UniversalCStarAmalgam iA iB) {ε : ℝ} (hε : 0 < ε) :
    ∃ S : CStarAmalgamRepresentation iA iB,
      HasMFEmbedding S.carrier ∧
        ‖x‖ - ε ≤ ‖universalCStarAmalgamEval iA iB S x‖ := by
  refine ⟨R, hR, ?_⟩
  have hiso : Isometry (universalCStarAmalgamEval iA iB R) :=
    NonUnitalStarAlgHom.isometry
      (universalCStarAmalgamEval iA iB R).toNonUnitalStarAlgHom hfaithful
  have hnorm : ‖universalCStarAmalgamEval iA iB R x‖ = ‖x‖ :=
    hiso.norm_map_of_map_zero (map_zero _) x
  linarith

/-- A faithful evaluation coordinate with an MF carrier makes the universal
amalgam MF.  This is the single-coordinate criterion, here a corollary of the
norming one. -/
theorem isMFAlgebra_of_faithful_eval
    [TopologicalSpace.SeparableSpace A] [TopologicalSpace.SeparableSpace B]
    (R : CStarAmalgamRepresentation iA iB) (hR : HasMFEmbedding R.carrier)
    (hfaithful : Function.Injective (universalCStarAmalgamEval iA iB R)) :
    IsMFAlgebra (UniversalCStarAmalgam iA iB) :=
  isMFAlgebra_of_norming_representations iA iB fun _ _ hε ↦
    norming_of_faithful_eval iA iB R hR hfaithful _ hε

end

end ShulmanFill
end GroupApproximation
