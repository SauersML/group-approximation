import Mathlib.Analysis.CStarAlgebra.Unitary.Connected
import Mathlib.Topology.Connected.PathComponentOne
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Algebra.Group.Subgroup.Finite

/-!
# The identity component of the unitary group of a unital C-star algebra

For a unital C-star algebra `A` the unitary group `unitary A` carries the norm
topology and is a topological group.  `unitaryComponentOne A` is its identity
path component `U_0(A)`, and `UnitaryClass A` is the quotient group
`U(A) / U_0(A)`.

Mathlib already supplies almost all of this:

* `Mathlib/Topology/Algebra/Star/Unitary.lean` makes `unitary A` a topological
  group;
* `Subgroup.pathComponentOne` and `Subgroup.Normal.pathComponentOne`
  (`Mathlib/Topology/Connected/PathConnected.lean`) make the identity path
  component of a topological group a normal subgroup;
* `Unitary.instLocallyPathConnectedSpace` makes `unitary A` locally path
  connected, so the identity component is in fact clopen;
* `Unitary.mem_pathComponentOne_iff` identifies `U_0(A)` with the set of finite
  products of exponential unitaries `exp (i h)`, `h` selfadjoint.

What is added here is the packaging as a named subgroup with the quotient
group, the description of `U_0(A)` as the *subgroup generated by* the
exponential unitaries (as opposed to the set of finite products of them), and
the functoriality of `G / pathComponentOne G` along continuous group
homomorphisms, which is what transports `U_0` along the matrix block
inclusions.
-/

namespace GroupApproximation

open Metric selfAdjoint

section Topological

variable {G H : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

theorem mem_pathComponentOne_iff' {g : G} :
    g ∈ Subgroup.pathComponentOne G ↔ Joined (1 : G) g := Iff.rfl

/-- A continuous group homomorphism carries the identity path component into the identity
path component: transport a path along the homomorphism. -/
theorem mapsTo_pathComponentOne (f : G →* H) (hf : Continuous f) {g : G}
    (hg : g ∈ Subgroup.pathComponentOne G) : f g ∈ Subgroup.pathComponentOne H := by
  have h₁ : Joined (1 : G) g := hg
  obtain ⟨γ⟩ := h₁
  have h₂ : Joined (1 : H) (f g) := ⟨(γ.map hf).cast (map_one f).symm rfl⟩
  exact h₂

theorem pathComponentOne_le_comap (f : G →* H) (hf : Continuous f) :
    Subgroup.pathComponentOne G ≤ (Subgroup.pathComponentOne H).comap f :=
  fun _ hg => mapsTo_pathComponentOne f hf hg

/-- The homomorphism `G / pathComponentOne G →* H / pathComponentOne H` induced by a continuous
group homomorphism `G →* H`. -/
def pathComponentQuotientMap (f : G →* H) (hf : Continuous f) :
    G ⧸ Subgroup.pathComponentOne G →* H ⧸ Subgroup.pathComponentOne H :=
  QuotientGroup.map _ _ f (pathComponentOne_le_comap f hf)

@[simp] theorem pathComponentQuotientMap_mk (f : G →* H) (hf : Continuous f) (g : G) :
    pathComponentQuotientMap f hf (QuotientGroup.mk g) = QuotientGroup.mk (f g) := rfl

end Topological

section CStar

variable {A : Type*} [CStarAlgebra A]

variable (A) in
/-- `U_0(A)`: the identity path component of the unitary group of a unital C-star algebra,
as a subgroup of `U(A)`.  It is normal, and (since the unitary group is locally path connected)
also open and closed. -/
def unitaryComponentOne : Subgroup (unitary A) := Subgroup.pathComponentOne (unitary A)

instance : (unitaryComponentOne A).Normal := Subgroup.Normal.pathComponentOne (unitary A)

theorem mem_unitaryComponentOne_iff {u : unitary A} :
    u ∈ unitaryComponentOne A ↔ Joined (1 : unitary A) u := Iff.rfl

theorem mem_unitaryComponentOne_iff_mem_pathComponent {u : unitary A} :
    u ∈ unitaryComponentOne A ↔ u ∈ pathComponent (1 : unitary A) := Iff.rfl

/-- The standard description of `U_0(A)`: a unitary lies in the identity component exactly when
it is a finite product of exponential unitaries `exp (i h)` with `h` selfadjoint.  This is
`Unitary.mem_pathComponentOne_iff`, restated for `unitaryComponentOne`. -/
theorem mem_unitaryComponentOne_iff_exists_list {u : unitary A} :
    u ∈ unitaryComponentOne A ↔
      ∃ l : List (selfAdjoint A), (l.map selfAdjoint.expUnitary).prod = u :=
  Unitary.mem_pathComponentOne_iff

theorem expUnitary_mem_unitaryComponentOne (x : selfAdjoint A) :
    selfAdjoint.expUnitary x ∈ unitaryComponentOne A :=
  selfAdjoint.joined_one_expUnitary x

/-- `U_0(A)` is the subgroup generated by the exponential unitaries.  This is the form in which
the identity component is usually used: it is *both* the path component of `1` and the subgroup
generated by `{exp (i h) : h selfadjoint}`. -/
theorem unitaryComponentOne_eq_closure_range_expUnitary :
    unitaryComponentOne A =
      Subgroup.closure (Set.range (selfAdjoint.expUnitary : selfAdjoint A → unitary A)) := by
  refine le_antisymm ?_ ?_
  · intro u hu
    obtain ⟨l, rfl⟩ := mem_unitaryComponentOne_iff_exists_list.mp hu
    refine Subgroup.list_prod_mem ?_
    intro x hx
    obtain ⟨y, _, rfl⟩ := List.mem_map.mp hx
    exact Subgroup.subset_closure ⟨y, rfl⟩
  · refine Subgroup.closure_le _ |>.mpr ?_
    rintro - ⟨x, rfl⟩
    exact expUnitary_mem_unitaryComponentOne x

/-- A unitary within distance `2` of the identity lies in the identity component. -/
theorem mem_unitaryComponentOne_of_norm_sub_one_lt_two {u : unitary A}
    (hu : ‖(u : A) - 1‖ < 2) : u ∈ unitaryComponentOne A := by
  have := Unitary.joined (1 : unitary A) u (by simpa using hu)
  exact this

variable (A) in
/-- The unitary class group `U(A) / U_0(A)` of a unital C-star algebra. -/
abbrev UnitaryClass : Type _ := unitary A ⧸ unitaryComponentOne A

variable (A) in
/-- The quotient homomorphism `U(A) →* U(A) / U_0(A)`. -/
def unitaryClass : unitary A →* UnitaryClass A := QuotientGroup.mk' (unitaryComponentOne A)

@[simp] theorem unitaryClass_apply (u : unitary A) :
    unitaryClass A u = QuotientGroup.mk u := rfl

theorem unitaryClass_eq_one_iff {u : unitary A} :
    unitaryClass A u = 1 ↔ u ∈ unitaryComponentOne A :=
  QuotientGroup.eq_one_iff u

theorem unitaryClass_surjective : Function.Surjective (unitaryClass A) :=
  QuotientGroup.mk'_surjective _

end CStar

end GroupApproximation
