import GroupApproximation.Analysis.MFAlgebraAmalgamFactorMap
import GroupApproximation.Analysis.ShulmanFillNormingCoronaRoute

/-!
# Theorem 13 at a `Type`-valued target: the repair of the universe gap

`Analysis/ShulmanFillSymmetricDoubleEmbedTheorem13` states Theorem 13 as an
embedding `A *_C B →⋆ₐ[ℂ] D *_C D` and builds it as
`factorAmalgamToSymmetricTarget … (StarAlgHom.id _)`.  That cannot be typed.
`MFAlgebraAmalgamCriterion.factorAmalgamToSymmetricTarget` fixes its target in
`Type`, because it is `universalCStarAmalgamEval` at a
`CStarAmalgamRepresentation`, whose carrier lies in the same universe as
`C`, `A`, `B`; and `UniversalCStarAmalgam gamma gamma` lies one universe *up*,
being a subalgebra of a product indexed by a `Type`-valued structure.  Making
the carrier universe-polymorphic does not help: it would need `v = max (u+1) (v+1)`.

So `symmetricDoubleEmbedding` and everything after it in that module is void,
including `amalgamEmbedsSymmetricDouble_of_calkinWitness`.  This module repairs
the route without touching either file, and without any universe descent.

## Why no descent is needed

The consumer never wanted the embedding itself.
`isMFAlgebra_of_injective_into_symmetricDouble` takes `e : A *_C B → D *_C D`
and an MF structure on `D *_C D`, and immediately *composes* `e` with the
corona embedding that MF structure provides.  That composite has a `Type`
target, and `factorAmalgamToSymmetricTarget` produces exactly it —
`factorAmalgamToSymmetricTarget_eq_comp` says the composite *is* `g ∘ e`
whenever `e` exists.  So the honest hypothesis is

> whenever the symmetric double embeds faithfully in a `Type`-valued C-star
> algebra, the factor map of the amalgam into that same algebra is faithful,

which is well-typed, is what Enders--Shulman's argument delivers, and is
strictly weaker than the ill-typed embedding.  Only the corona case is used
below, since that is what MF-ness supplies.

The hypothesis is carried as a binder, never as a `Prop` definition, so a
consumer's type names it.
-/

namespace GroupApproximation
namespace ShulmanFill

open Filter Topology MFAlgebraAmalgamCriterion
open Manuscript.OneSidedMFRadical.HNNCoronaConjugatorSentenceAudit

noncomputable section

section Witness

variable {C A B D : Type} [CStarAlgebra C] [CStarAlgebra A] [CStarAlgebra B]
  [CStarAlgebra D] [Nontrivial D]
  (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)
  [Nonempty (CStarAmalgamRepresentation iA iB)]
  (gamma : C →⋆ₐ[ℂ] D) (alpha : A →⋆ₐ[ℂ] D) (beta : B →⋆ₐ[ℂ] D)
  (hA : alpha.comp iA = gamma) (hB : beta.comp iB = gamma)

/-- **Theorem 13's content, in the form the route consumes.**  If the double is
MF and its faithful `Type`-valued images detect the amalgam through the factor
map, then the amalgam is MF.  The target chosen is the corona that MF-ness of
the double supplies, so no universe descent occurs anywhere. -/
theorem isMFAlgebra_of_factorMap_injective
    [TopologicalSpace.SeparableSpace A] [TopologicalSpace.SeparableSpace B]
    [Nonempty (CStarAmalgamRepresentation gamma gamma)]
    (hdouble : IsMFAlgebra (UniversalCStarAmalgam gamma gamma))
    (hwit : ∀ (E : Type) (_ : CStarAlgebra E) (_ : Nontrivial E)
      (g : UniversalCStarAmalgam gamma gamma →⋆ₐ[ℂ] E),
        Function.Injective g →
          Function.Injective
            (factorAmalgamToSymmetricTarget iA iB gamma alpha beta hA hB g)) :
    IsMFAlgebra (UniversalCStarAmalgam iA iB) := by
  haveI : Nontrivial (UniversalCStarAmalgam gamma gamma) :=
    nontrivial_universalCStarAmalgam gamma gamma
  obtain ⟨Z, hZ, g, hg⟩ :=
    MFAlgebraUnitalCoronaEmbedding.exists_injective_unital_coronaEmbedding
      hdouble
  letI : ∀ n, Nonempty (Z n) := hZ
  haveI : TopologicalSpace.SeparableSpace (UniversalCStarAmalgam iA iB) :=
    separableSpace_universalCStarAmalgam iA iB
  refine ⟨inferInstance, ?_⟩
  exact (normMatrixCorona_hasMFEmbedding_of_positive Z
      hZ).of_injective_nonUnitalStarAlgHom
    (factorAmalgamToSymmetricTarget iA iB gamma alpha beta hA hB
      g).toNonUnitalStarAlgHom
    (hwit (NormMatrixCStarCorona (fun n ↦ Z n)) inferInstance inferInstance g hg)

end Witness

/-! ## Theorem 16 on the repaired route -/

/-- **Shulman's Theorem 16 from Theorem 10 and the repaired Theorem 13.**  The
steps are those of `ShulmanSymmetricDouble.shulmanTheorem16_of_symmetricDouble`
— unitalize the corona pair on its common support corner, take `D` to be the
corona algebra generated by the two unital images — with the void embedding
step replaced by `isMFAlgebra_of_factorMap_injective`. -/
theorem shulmanTheorem16_of_typeZeroWitness
    (hDouble : ShulmanSymmetricDouble.SymmetricDoubleMFStatement)
    (hwit : ∀ {C A B D : Type} [CStarAlgebra C] [CStarAlgebra A]
      [CStarAlgebra B] [CStarAlgebra D] [Nontrivial D]
      (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)
      [Nonempty (CStarAmalgamRepresentation iA iB)]
      (gamma : C →⋆ₐ[ℂ] D) (alpha : A →⋆ₐ[ℂ] D) (beta : B →⋆ₐ[ℂ] D)
      (hA : alpha.comp iA = gamma) (hB : beta.comp iB = gamma),
        TopologicalSpace.SeparableSpace C →
        Function.Injective alpha → Function.Injective beta →
          ∀ (E : Type) (_ : CStarAlgebra E) (_ : Nontrivial E)
            (g : UniversalCStarAmalgam gamma gamma →⋆ₐ[ℂ] E),
            Function.Injective g →
              Function.Injective (factorAmalgamToSymmetricTarget iA iB gamma
                alpha beta hA hB g)) :
    Manuscript.MFRecognition.HNNPermanence.ShulmanTheorem16Statement := by
  intro C A₁ A₂ _ _ _ iA iB _ hC hA₁ hA₂ Y _ phiA phiB hphiA hphiB hcomp
  haveI : TopologicalSpace.SeparableSpace A₁ := hA₁
  haveI : TopologicalSpace.SeparableSpace A₂ := hA₂
  haveI : Nontrivial A₁ := nontrivial_left_of_nonempty_representation iA iB
  obtain ⟨Z, hZ, l, r, hl, hr, hlr⟩ :=
    CompatibleCoronaSupportCorner.exists_compatible_injective_unital_supportCornerEmbeddings
      Y iA iB phiA phiB hphiA hphiB (by ext c; exact hcomp c)
  letI : ∀ n, Nonempty (Z n) := hZ
  letI : CStarAlgebra (compatibleGeneratedSubalgebra Z l r) :=
    compatibleGeneratedCStarAlgebra Z l r
  obtain ⟨hinjL, hinjR⟩ := compatibleGenerated_factor_injective Z l r hl hr
  haveI : Nontrivial (compatibleGeneratedSubalgebra Z l r) := by
    obtain ⟨x, y, hxy⟩ := exists_pair_ne A₁
    exact ⟨⟨leftToCompatibleGenerated Z l r x, leftToCompatibleGenerated Z l r y,
      fun h ↦ hxy (hinjL h)⟩⟩
  have hDsep : TopologicalSpace.SeparableSpace
      (compatibleGeneratedSubalgebra Z l r) :=
    compatibleGenerated_separableSpace Z l r
  have hDmf : IsMFAlgebra (compatibleGeneratedSubalgebra Z l r) := by
    refine ⟨hDsep, ?_⟩
    refine (normMatrixCorona_hasMFEmbedding_of_positive Z
        hZ).of_injective_nonUnitalStarAlgHom
      (compatibleGeneratedSubalgebra Z l r).subtype.toNonUnitalStarAlgHom ?_
    intro x y h
    exact Subtype.ext h
  set k : C →⋆ₐ[ℂ] compatibleGeneratedSubalgebra Z l r :=
    (leftToCompatibleGenerated Z l r).comp iA with hk_def
  have hkA : (leftToCompatibleGenerated Z l r).comp iA = k := hk_def.symm
  have hkB : (rightToCompatibleGenerated Z l r).comp iB = k := by
    rw [hk_def]
    exact (compatibleGenerated_comp_eq iA iB Z l r hlr).symm
  haveI := MFAlgebraAmalgamCriterion.symmetricAmalgamRepresentationNonempty k
  exact isMFAlgebra_of_factorMap_injective iA iB k
    (leftToCompatibleGenerated Z l r) (rightToCompatibleGenerated Z l r)
    hkA hkB (hDouble k hDmf)
    (hwit iA iB k (leftToCompatibleGenerated Z l r)
      (rightToCompatibleGenerated Z l r) hkA hkB hC hinjL hinjR)

/-- **The recognition debt on the repaired route.**  With the equivalence of
`Analysis/ShulmanFillNormingCoronaRoute`, the conjugate residual follows from
Theorem 10 and the repaired Theorem 13. -/
theorem conjugateWordNorming_of_typeZeroWitness
    (hDouble : ShulmanSymmetricDouble.SymmetricDoubleMFStatement)
    (hwit : ∀ {C A B D : Type} [CStarAlgebra C] [CStarAlgebra A]
      [CStarAlgebra B] [CStarAlgebra D] [Nontrivial D]
      (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)
      [Nonempty (CStarAmalgamRepresentation iA iB)]
      (gamma : C →⋆ₐ[ℂ] D) (alpha : A →⋆ₐ[ℂ] D) (beta : B →⋆ₐ[ℂ] D)
      (hA : alpha.comp iA = gamma) (hB : beta.comp iB = gamma),
        TopologicalSpace.SeparableSpace C →
        Function.Injective alpha → Function.Injective beta →
          ∀ (E : Type) (_ : CStarAlgebra E) (_ : Nontrivial E)
            (g : UniversalCStarAmalgam gamma gamma →⋆ₐ[ℂ] E),
            Function.Injective g →
              Function.Injective (factorAmalgamToSymmetricTarget iA iB gamma
                alpha beta hA hB g)) :
    ConjugateWordNormingStatement :=
  conjugateWordNorming_of_shulmanTheorem16
    (shulmanTheorem16_of_typeZeroWitness hDouble hwit)

end

end ShulmanFill
