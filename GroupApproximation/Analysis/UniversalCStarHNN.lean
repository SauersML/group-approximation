import GroupApproximation.Analysis.MFAlgebra
import Mathlib.Analysis.CStarAlgebra.Hom
import Mathlib.Analysis.CStarAlgebra.lpSpace

/-!
# A universe-relative universal C-star HNN algebra

This file constructs the universal C-star algebra generated by a C-star
algebra `D` and one unitary which conjugates a closed star subalgebra `B₀`
onto another `B₁` along a prescribed star-algebra equivalence `theta`.

The construction is deliberately concrete.  Its ambient algebra is the
bounded product of every same-universe covariant representation.  The
universal HNN algebra is the closed star subalgebra generated by the diagonal
copy of `D` and the diagonal stable unitary.  This is the partial-isomorphism
analogue of `Analysis.MaximalGroupCStar` and avoids assuming a C-star free
product or an HNN completion from the literature.

The representation family is assumed nonempty.  This is exactly the form
needed by the corona-conjugator application: its supplied covariant corona
representation is a member of the family.  The hard MF-permanence step is not
asserted here; this file only builds the universal object to which that step
will apply.
-/

namespace GroupApproximation

open scoped CStarAlgebra ENNReal

noncomputable section

universe u

variable {D : Type u} [CStarAlgebra D]
variable (B0 B1 : StarSubalgebra ℂ D) (theta : B0 ≃⋆ₐ[ℂ] B1)

/-- A same-universe covariant representation of the C-star HNN datum.

The covariance equation is written without an inverse,
`v · pi(b) = pi(theta(b)) · v`; for a unitary `v` this is equivalent to
the usual conjugation equation. -/
structure CStarHNNRepresentation where
  carrier : Type u
  instCStarAlgebra : CStarAlgebra carrier
  instNontrivial : Nontrivial carrier
  base : letI : CStarAlgebra carrier := instCStarAlgebra
    D →⋆ₐ[ℂ] carrier
  stable : letI : CStarAlgebra carrier := instCStarAlgebra
    unitary carrier
  covariance : letI : CStarAlgebra carrier := instCStarAlgebra
    ∀ b : B0,
      (stable : carrier) * base (b : D) =
        base ((theta b : B1) : D) * (stable : carrier)

namespace CStarHNNRepresentation

instance (R : CStarHNNRepresentation B0 B1 theta) : CStarAlgebra R.carrier :=
  R.instCStarAlgebra

instance (R : CStarHNNRepresentation B0 B1 theta) : Nontrivial R.carrier :=
  R.instNontrivial

/-- Package a covariant pair on a nontrivial same-universe target. -/
def ofCovariantPair {E : Type u} [CStarAlgebra E] [Nontrivial E]
    (pi : D →⋆ₐ[ℂ] E) (v : unitary E)
    (hcov : ∀ b : B0,
      (v : E) * pi (b : D) = pi ((theta b : B1) : D) * (v : E)) :
    CStarHNNRepresentation B0 B1 theta where
  carrier := E
  instCStarAlgebra := inferInstance
  instNontrivial := inferInstance
  base := pi
  stable := v
  covariance := hcov

end CStarHNNRepresentation

/-- The bounded product containing every same-universe covariant
representation of the HNN datum. -/
abbrev UniversalCStarHNNAmbient :=
  lp (fun R : CStarHNNRepresentation B0 B1 theta ↦ R.carrier) ∞

/-- The universal product is a unital complex C-star algebra. -/
noncomputable instance universalCStarHNNAmbientCStarAlgebra
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    CStarAlgebra (UniversalCStarHNNAmbient B0 B1 theta) where
  toNormedRing := inferInstance
  toStarRing := inferInstance
  toCompleteSpace := inferInstance
  toCStarRing := inferInstance
  toNormedAlgebra := inferInstance
  toStarModule := inferInstance

/-- The diagonal copy of the base algebra in the universal product. -/
def universalCStarHNNBaseAmbient
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    D →⋆ₐ[ℂ] UniversalCStarHNNAmbient B0 B1 theta where
  toFun d := ⟨fun R ↦ R.base d, memℓp_infty ⟨‖d‖, by
    rintro _ ⟨R, rfl⟩
    exact NonUnitalStarAlgHom.norm_apply_le R.base d⟩⟩
  map_one' := by apply lp.ext; funext R; exact map_one R.base
  map_mul' _ _ := by apply lp.ext; funext R; exact map_mul R.base _ _
  map_zero' := by apply lp.ext; funext R; exact map_zero R.base
  map_add' _ _ := by apply lp.ext; funext R; exact map_add R.base _ _
  commutes' _ := by apply lp.ext; funext R; exact R.base.commutes _
  map_star' _ := by apply lp.ext; funext R; exact map_star R.base _

/-- The diagonal stable unitary in the universal product. -/
def universalCStarHNNStableAmbient
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    unitary (UniversalCStarHNNAmbient B0 B1 theta) :=
  ⟨⟨fun R ↦ (R.stable : R.carrier), memℓp_infty ⟨1, by
      rintro _ ⟨R, rfl⟩
      exact (CStarRing.norm_of_mem_unitary R.stable.property).le⟩⟩, by
    constructor
    · apply lp.ext
      funext R
      exact R.stable.property.1
    · apply lp.ext
      funext R
      exact R.stable.property.2⟩

/-- The closed star subalgebra generated by the base and the stable unitary. -/
def universalCStarHNNSubalgebra
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    StarSubalgebra ℂ (UniversalCStarHNNAmbient B0 B1 theta) :=
  (StarAlgebra.adjoin ℂ
    (Set.range (universalCStarHNNBaseAmbient B0 B1 theta) ∪
      {(universalCStarHNNStableAmbient B0 B1 theta :
        UniversalCStarHNNAmbient B0 B1 theta)})).topologicalClosure

/-- The universe-relative universal C-star HNN algebra. -/
abbrev UniversalCStarHNN
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] : Type (u + 1) :=
  universalCStarHNNSubalgebra B0 B1 theta

instance universalCStarHNN_isClosed
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    IsClosed (universalCStarHNNSubalgebra B0 B1 theta :
      Set (UniversalCStarHNNAmbient B0 B1 theta)) :=
  StarSubalgebra.isClosed_topologicalClosure _

noncomputable instance universalCStarHNNCStarAlgebra
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    CStarAlgebra (UniversalCStarHNN B0 B1 theta) :=
  inferInstance

/-- The canonical copy of the base algebra. -/
def universalCStarHNNBase
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    D →⋆ₐ[ℂ] UniversalCStarHNN B0 B1 theta where
  toFun d := ⟨universalCStarHNNBaseAmbient B0 B1 theta d,
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨d, rfl⟩))⟩
  map_one' := Subtype.ext (map_one (universalCStarHNNBaseAmbient B0 B1 theta))
  map_mul' _ _ := Subtype.ext (map_mul (universalCStarHNNBaseAmbient B0 B1 theta) _ _)
  map_zero' := Subtype.ext (map_zero (universalCStarHNNBaseAmbient B0 B1 theta))
  map_add' _ _ := Subtype.ext (map_add (universalCStarHNNBaseAmbient B0 B1 theta) _ _)
  commutes' _ := Subtype.ext ((universalCStarHNNBaseAmbient B0 B1 theta).commutes _)
  map_star' _ := Subtype.ext (map_star (universalCStarHNNBaseAmbient B0 B1 theta) _)

/-- The canonical stable unitary. -/
def universalCStarHNNStable
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] :
    unitary (UniversalCStarHNN B0 B1 theta) :=
  ⟨⟨(universalCStarHNNStableAmbient B0 B1 theta :
      UniversalCStarHNNAmbient B0 B1 theta),
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inr (Set.mem_singleton _)))⟩, by
    constructor
    · apply Subtype.ext
      exact (universalCStarHNNStableAmbient B0 B1 theta).property.1
    · apply Subtype.ext
      exact (universalCStarHNNStableAmbient B0 B1 theta).property.2⟩

/-- The canonical generators satisfy the HNN covariance relation. -/
theorem universalCStarHNN_covariance
    [Nonempty (CStarHNNRepresentation B0 B1 theta)] (b : B0) :
    (universalCStarHNNStable B0 B1 theta : UniversalCStarHNN B0 B1 theta) *
        universalCStarHNNBase B0 B1 theta (b : D) =
      universalCStarHNNBase B0 B1 theta ((theta b : B1) : D) *
        (universalCStarHNNStable B0 B1 theta : UniversalCStarHNN B0 B1 theta) := by
  apply Subtype.ext
  apply lp.ext
  funext R
  exact R.covariance b

/-- Evaluation at a covariant-representation coordinate. -/
def universalCStarHNNEval
    [Nonempty (CStarHNNRepresentation B0 B1 theta)]
    (R : CStarHNNRepresentation B0 B1 theta) :
    UniversalCStarHNN B0 B1 theta →⋆ₐ[ℂ] R.carrier :=
  ({ toFun := fun f ↦ f R
     map_one' := rfl
     map_mul' := fun _ _ ↦ rfl
     map_zero' := rfl
     map_add' := fun _ _ ↦ rfl
     commutes' := fun _ ↦ rfl
     map_star' := fun _ ↦ rfl } :
      UniversalCStarHNNAmbient B0 B1 theta →⋆ₐ[ℂ] R.carrier).comp
    (universalCStarHNNSubalgebra B0 B1 theta).subtype

@[simp] theorem universalCStarHNNEval_base
    [Nonempty (CStarHNNRepresentation B0 B1 theta)]
    (R : CStarHNNRepresentation B0 B1 theta) (d : D) :
    universalCStarHNNEval B0 B1 theta R
        (universalCStarHNNBase B0 B1 theta d) = R.base d :=
  rfl

@[simp] theorem universalCStarHNNEval_stable
    [Nonempty (CStarHNNRepresentation B0 B1 theta)]
    (R : CStarHNNRepresentation B0 B1 theta) :
    universalCStarHNNEval B0 B1 theta R
        (universalCStarHNNStable B0 B1 theta : UniversalCStarHNN B0 B1 theta) =
      (R.stable : R.carrier) :=
  rfl

/-- The coordinate evaluations are jointly faithful on the concrete universal
HNN algebra.  This is immediate from its realization as a subalgebra of the
bounded product, but naming it is useful when one faithful covariant
coordinate is used to certify a later group representation. -/
theorem universalCStarHNN_eq_of_forall_eval_eq
    [Nonempty (CStarHNNRepresentation B0 B1 theta)]
    {x y : UniversalCStarHNN B0 B1 theta}
    (h : ∀ R : CStarHNNRepresentation B0 B1 theta,
      universalCStarHNNEval B0 B1 theta R x =
        universalCStarHNNEval B0 B1 theta R y) :
    x = y := by
  apply Subtype.ext
  apply lp.ext
  funext R
  exact h R

/-- One covariant coordinate faithful on the base algebra makes the canonical
base map of the universal HNN algebra faithful. -/
theorem universalCStarHNNBase_injective_of_coordinate
    [Nonempty (CStarHNNRepresentation B0 B1 theta)]
    (R : CStarHNNRepresentation B0 B1 theta)
    (hR : Function.Injective R.base) :
    Function.Injective (universalCStarHNNBase B0 B1 theta) := by
  intro d e hde
  apply hR
  have := congrArg (universalCStarHNNEval B0 B1 theta R) hde
  simpa using this

/-- Evaluation at a coordinate detects any equality whose two sides are
already separated by that coordinate. -/
theorem universalCStarHNN_ne_of_eval_ne
    [Nonempty (CStarHNNRepresentation B0 B1 theta)]
    (R : CStarHNNRepresentation B0 B1 theta)
    {x y : UniversalCStarHNN B0 B1 theta}
    (h : universalCStarHNNEval B0 B1 theta R x ≠
      universalCStarHNNEval B0 B1 theta R y) :
    x ≠ y := by
  intro hxy
  exact h (congrArg (universalCStarHNNEval B0 B1 theta R) hxy)

/-- Universal property of the concrete C-star HNN algebra. -/
theorem universalCStarHNN_existsUnique_lift
    [Nonempty (CStarHNNRepresentation B0 B1 theta)]
    {E : Type u} [CStarAlgebra E] [Nontrivial E]
    (pi : D →⋆ₐ[ℂ] E) (v : unitary E)
    (hcov : ∀ b : B0,
      (v : E) * pi (b : D) = pi ((theta b : B1) : D) * (v : E)) :
    ∃! f : UniversalCStarHNN B0 B1 theta →⋆ₐ[ℂ] E,
      (∀ d : D, f (universalCStarHNNBase B0 B1 theta d) = pi d) ∧
      f (universalCStarHNNStable B0 B1 theta : UniversalCStarHNN B0 B1 theta) =
        (v : E) := by
  let R := CStarHNNRepresentation.ofCovariantPair B0 B1 theta pi v hcov
  let f := universalCStarHNNEval B0 B1 theta R
  refine ⟨f, ⟨fun _ ↦ rfl, rfl⟩, ?_⟩
  intro q hq
  apply StarAlgHom.ext_topologicalClosure
      (R := ℂ) (A := UniversalCStarHNNAmbient B0 B1 theta) (B := E)
      (map_continuous q) (map_continuous f)
  apply StarAlgHom.ext_adjoin
  intro x hx
  rcases hx with hx | hx
  · obtain ⟨d, hd⟩ := hx
    have hx' : x =
        ⟨universalCStarHNNBaseAmbient B0 B1 theta d,
          StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨d, rfl⟩)⟩ := by
      apply Subtype.ext
      exact hd.symm
    rw [hx']
    exact hq.1 d
  · have hx' : x =
        ⟨(universalCStarHNNStableAmbient B0 B1 theta :
            UniversalCStarHNNAmbient B0 B1 theta),
          StarAlgebra.subset_adjoin ℂ _ (Or.inr (Set.mem_singleton _))⟩ := by
      apply Subtype.ext
      exact (Set.mem_singleton_iff.mp hx)
    rw [hx']
    exact hq.2

end

end GroupApproximation
