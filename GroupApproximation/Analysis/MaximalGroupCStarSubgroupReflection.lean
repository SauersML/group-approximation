import GroupApproximation.Analysis.MaximalGroupCStarTrace
import GroupApproximation.Sofic.SymmetricDoubleSubgroupReflection
import GroupApproximation.Meta.AxiomGuard

/-!
# Subgroups are reflected inside the maximal group C-star algebra

For a subgroup `Γ ≤ G`, let `C*(Γ; G)` be the closed star subalgebra of
`C*(G)` generated by the canonical unitaries indexed by `Γ`.  The canonical
unitary `u_g` belongs to `C*(Γ; G)` exactly when `g ∈ Γ`.

The proof is intrinsic.  If `g ∉ Γ`, the continuous coefficient functional

`a ↦ τ_G(u_g⋆ a)`

vanishes on the algebraic star algebra generated by `Γ`, hence on its norm
closure, while it takes the value one at `u_g`.  This exact reflection property
and the normal-form criterion for symmetric doubles give a canonical faithful
homomorphism

`G *_Γ G → U(C*(G)) *_{U(C*(Γ; G))} U(C*(G))`.

No MF hypothesis occurs here.  Thus this file isolates the analytic issue in
the MF permanence argument: one still needs an MF realization of the relevant
C-star-algebraic amalgam, but no additional group-theoretic injectivity step.
-/

open scoped CStarAlgebra

namespace GroupApproximation

noncomputable section

variable (G : Type) [Group G]

local instance maximalGroupCStarSubgroupDecidableEq : DecidableEq G :=
  Classical.decEq G

/-- The canonical generators of `C*(G)`, regarded as a monoid homomorphism
into the underlying multiplicative monoid of the algebra. -/
def maximalGroupCStarGeneratorHom : G →* MaximalGroupCStar G :=
  (unitary (MaximalGroupCStar G)).subtype.comp
    (maximalGroupCStarUnitaryHom G)

@[simp]
theorem maximalGroupCStarGeneratorHom_apply (g : G) :
    maximalGroupCStarGeneratorHom G g = maximalGroupCStarGenerator G g :=
  rfl

/-- Taking star sends a canonical generator to the generator indexed by the
inverse group element. -/
theorem star_maximalGroupCStarGeneratorHom (g : G) :
    star (maximalGroupCStarGeneratorHom G g) =
      maximalGroupCStarGeneratorHom G g⁻¹ := by
  have hright : maximalGroupCStarGeneratorHom G g *
      star (maximalGroupCStarGeneratorHom G g) = 1 :=
    (maximalGroupCStarUnitaryHom G g).property.2
  have hleft : maximalGroupCStarGeneratorHom G g⁻¹ *
      maximalGroupCStarGeneratorHom G g = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  calc
    star (maximalGroupCStarGeneratorHom G g) =
        maximalGroupCStarGeneratorHom G g⁻¹ *
          maximalGroupCStarGeneratorHom G g *
            star (maximalGroupCStarGeneratorHom G g) := by
              rw [hleft, one_mul]
    _ = maximalGroupCStarGeneratorHom G g⁻¹ *
          (maximalGroupCStarGeneratorHom G g *
            star (maximalGroupCStarGeneratorHom G g)) := by
              rw [mul_assoc]
    _ = maximalGroupCStarGeneratorHom G g⁻¹ := by
              rw [hright, mul_one]

variable (Γ : Subgroup G)

/-- The subgroup generators, as a monoid homomorphism into `C*(G)`. -/
def maximalSubgroupGeneratorHom : ↥Γ →* MaximalGroupCStar G :=
  (maximalGroupCStarGeneratorHom G).comp Γ.subtype

@[simp]
theorem maximalSubgroupGeneratorHom_apply (γ : ↥Γ) :
    maximalSubgroupGeneratorHom (G := G) Γ γ =
      maximalGroupCStarGenerator G (γ : G) :=
  rfl

/-- The closed star subalgebra of `C*(G)` generated by the canonical
unitaries indexed by `Γ`. -/
def maximalSubgroupCStar : StarSubalgebra ℂ (MaximalGroupCStar G) :=
  (StarAlgebra.adjoin ℂ
    (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))).topologicalClosure

/-- Every canonical generator indexed by `Γ` belongs to the closed subgroup
algebra. -/
theorem maximalGroupCStarGenerator_mem_maximalSubgroupCStar
    {g : G} (hg : g ∈ Γ) :
    maximalGroupCStarGenerator G g ∈ maximalSubgroupCStar (G := G) Γ := by
  let γ : ↥Γ := ⟨g, hg⟩
  apply StarSubalgebra.le_topologicalClosure
  exact StarAlgebra.subset_adjoin ℂ _ ⟨γ, rfl⟩

/-- The coefficient of `a` in the canonical basis direction indexed by `g`:
left-multiply by `u_g⋆` and then apply the canonical trace. -/
def canonicalMaximalCoefficientAgainst (g : G) :
    MaximalGroupCStar G →L[ℂ] ℂ :=
  (canonicalMaximalTrace G).comp
    (ContinuousLinearMap.mul ℂ (MaximalGroupCStar G)
      (star (maximalGroupCStarGeneratorHom G g)))

@[simp]
theorem canonicalMaximalCoefficientAgainst_apply (g : G)
    (a : MaximalGroupCStar G) :
    canonicalMaximalCoefficientAgainst (G := G) g a =
      canonicalMaximalTrace G
        (star (maximalGroupCStarGeneratorHom G g) * a) :=
  rfl

/-- The canonical coefficient functional is the Kronecker delta on canonical
generators. -/
theorem canonicalMaximalCoefficientAgainst_generator (g h : G) :
    canonicalMaximalCoefficientAgainst (G := G) g
        (maximalGroupCStarGenerator G h) =
      if g = h then 1 else 0 := by
  classical
  rw [canonicalMaximalCoefficientAgainst_apply,
    star_maximalGroupCStarGeneratorHom]
  change canonicalMaximalTrace G
      (maximalGroupCStarGeneratorHom G g⁻¹ *
        maximalGroupCStarGeneratorHom G h) = _
  rw [← map_mul]
  by_cases hgh : g = h
  · subst h
    rw [if_pos rfl, inv_mul_cancel, map_one, canonicalMaximalTrace_one]
  · rw [if_neg hgh]
    apply canonicalMaximalTrace_generator_of_ne_one
    intro hprod
    exact hgh (inv_mul_eq_one.mp hprod)

/-- The algebraic star algebra generated by the subgroup generators is
contained in their complex linear span. -/
theorem maximalSubgroupCStarAdjoin_le_span :
    (StarAlgebra.adjoin ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))).toSubalgebra.toSubmodule ≤
      Submodule.span ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) := by
  rw [StarAlgebra.adjoin_eq_span]
  apply Submodule.span_mono
  have hle : Submonoid.closure
      (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ) ∪
        star (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))) ≤
      MonoidHom.mrange (maximalSubgroupGeneratorHom (G := G) Γ) := by
    apply Submonoid.closure_le.mpr
    rintro x (⟨γ, rfl⟩ | hx)
    · exact ⟨γ, rfl⟩
    · rw [← Set.image_star] at hx
      obtain ⟨y, ⟨γ, rfl⟩, rfl⟩ := hx
      refine ⟨γ⁻¹, ?_⟩
      simpa using (star_maximalGroupCStarGeneratorHom G (γ : G)).symm
  intro x hx
  exact hle hx

/-- If `g` is outside `Γ`, its coefficient functional vanishes on the
algebraic star algebra generated by `Γ`. -/
theorem maximalSubgroupCStarAdjoin_le_coefficientKernel {g : G}
    (hg : g ∉ Γ) :
    (StarAlgebra.adjoin ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))).toSubalgebra.toSubmodule ≤
      (canonicalMaximalCoefficientAgainst (G := G) g).ker := by
  refine (maximalSubgroupCStarAdjoin_le_span (G := G) Γ).trans ?_
  apply Submodule.span_le.mpr
  rintro _ ⟨γ, rfl⟩
  apply (canonicalMaximalCoefficientAgainst (G := G) g).mem_ker.mpr
  change canonicalMaximalCoefficientAgainst (G := G) g
    (maximalGroupCStarGenerator G (γ : G)) = 0
  rw [canonicalMaximalCoefficientAgainst_generator, if_neg]
  intro hggamma
  apply hg
  rw [hggamma]
  exact γ.property

/-- If `g` is outside `Γ`, its coefficient functional vanishes on the closed
star algebra generated by `Γ`. -/
theorem canonicalMaximalCoefficientAgainst_eq_zero_of_mem_maximalSubgroupCStar
    {g : G} (hg : g ∉ Γ) {a : MaximalGroupCStar G}
    (ha : a ∈ maximalSubgroupCStar (G := G) Γ) :
    canonicalMaximalCoefficientAgainst (G := G) g a = 0 := by
  have hadjoin :
      ((StarAlgebra.adjoin ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) :
          StarSubalgebra ℂ (MaximalGroupCStar G)) :
        Set (MaximalGroupCStar G)) ⊆
      ((canonicalMaximalCoefficientAgainst (G := G) g).ker :
        Set (MaximalGroupCStar G)) :=
    maximalSubgroupCStarAdjoin_le_coefficientKernel (G := G) Γ hg
  have hclosure :
      closure
          ((StarAlgebra.adjoin ℂ
            (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) :
              StarSubalgebra ℂ (MaximalGroupCStar G)) :
            Set (MaximalGroupCStar G)) ⊆
        ((canonicalMaximalCoefficientAgainst (G := G) g).ker :
          Set (MaximalGroupCStar G)) :=
    closure_minimal hadjoin
      (canonicalMaximalCoefficientAgainst (G := G) g).isClosed_ker
  apply (canonicalMaximalCoefficientAgainst (G := G) g).mem_ker.mp
  apply hclosure
  change a ∈ closure
    ((StarAlgebra.adjoin ℂ
      (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) :
        StarSubalgebra ℂ (MaximalGroupCStar G)) :
      Set (MaximalGroupCStar G)) at ha
  exact ha

/-- **Exact subgroup reflection in `C*(G)`.**  A canonical group unitary lies
in the closed star algebra generated by `Γ` exactly when its index lies in
`Γ`. -/
theorem maximalGroupCStarGenerator_mem_maximalSubgroupCStar_iff (g : G) :
    maximalGroupCStarGenerator G g ∈ maximalSubgroupCStar (G := G) Γ ↔ g ∈ Γ := by
  constructor
  · intro hmem
    by_contra hg
    have hzero :=
      canonicalMaximalCoefficientAgainst_eq_zero_of_mem_maximalSubgroupCStar
        (G := G) Γ hg hmem
    have hone : canonicalMaximalCoefficientAgainst (G := G) g
        (maximalGroupCStarGenerator G g) = 1 := by
      rw [canonicalMaximalCoefficientAgainst_generator, if_pos rfl]
    exact one_ne_zero (hone.symm.trans hzero)
  · exact maximalGroupCStarGenerator_mem_maximalSubgroupCStar (G := G) Γ

/-- The subgroup of all unitaries of `C*(G)` which lie in the closed star
subalgebra generated by `Γ`. -/
def maximalSubgroupUnitary :
    Subgroup (unitary (MaximalGroupCStar G)) where
  carrier := {u | (u : MaximalGroupCStar G) ∈
    maximalSubgroupCStar (G := G) Γ}
  one_mem' := (maximalSubgroupCStar (G := G) Γ).one_mem
  mul_mem' := fun hu hv ↦
    (maximalSubgroupCStar (G := G) Γ).mul_mem hu hv
  inv_mem' := by
    intro u hu
    change star (u : MaximalGroupCStar G) ∈
      maximalSubgroupCStar (G := G) Γ
    exact star_mem hu

/-- The canonical unitary representation reflects membership in the
subgroup of unitaries generated by `Γ`. -/
theorem maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff (g : G) :
    maximalGroupCStarUnitaryHom G g ∈
      maximalSubgroupUnitary (G := G) Γ ↔ g ∈ Γ := by
  exact maximalGroupCStarGenerator_mem_maximalSubgroupCStar_iff (G := G) Γ g

/-- The canonical map from the symmetric group double to the double of the
unitary groups of the maximal group C-star algebra. -/
def maximalCStarSymmetricDoubleMap :
    SymmetricDouble G Γ →*
      SymmetricDouble ↥(unitary (MaximalGroupCStar G))
        (maximalSubgroupUnitary (G := G) Γ) :=
  symmetricDoubleMap Γ (maximalSubgroupUnitary (G := G) Γ)
    (maximalGroupCStarUnitaryHom G)
    (fun g hg ↦
      (maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
        (G := G) Γ g).mpr hg)

/-- **Canonical faithful realization of the group double.**  The maximal
group C-star algebra reflects the edge subgroup, so the induced map of
symmetric doubles is injective. -/
theorem maximalCStarSymmetricDoubleMap_injective :
    Function.Injective (maximalCStarSymmetricDoubleMap (G := G) Γ) := by
  apply (symmetricDoubleMap_injective_iff_reflects_mem
    Γ (maximalSubgroupUnitary (G := G) Γ) (maximalGroupCStarUnitaryHom G)
    (fun g hg ↦
      (maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
        (G := G) Γ g).mpr hg)
    (maximalGroupCStarUnitaryHom_injective G)).mpr
  intro g hg
  exact (maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
    (G := G) Γ g).mp hg

#audit_axioms maximalGroupCStarGenerator_mem_maximalSubgroupCStar_iff
#audit_axioms maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
#audit_axioms maximalCStarSymmetricDoubleMap_injective

end

end GroupApproximation
