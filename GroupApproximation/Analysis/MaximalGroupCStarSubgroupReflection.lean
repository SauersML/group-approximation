import GroupApproximation.Analysis.MaximalGroupCStarTrace
import GroupApproximation.Sofic.SymmetricDoubleSubgroupReflection
import GroupApproximation.Sofic.SymmetricDoubleFlip
import GroupApproximation.Meta.AxiomGuard

/-!
# Subgroups are reflected inside the maximal group C-star algebra

For a subgroup `Γ ≤ G`, let `C*(Γ; G)` be the closed star subalgebra of
`C*(G)` generated by the canonical unitaries indexed by `Γ`.  The canonical
unitary `u_g` belongs to `C*(Γ; G)` exactly when `g ∈ Γ`.

The proof is intrinsic.  If `g ∉ Γ`, the continuous coefficient functional

`a ↦ τ_G(u_g⋆ a)`

vanishes on the algebraic star algebra generated by `Γ`, hence on its norm
closure, while it takes the value one at `u_g`.  This exact reflection property
and the normal-form criterion for symmetric doubles give a canonical faithful
homomorphism

`G *_Γ G → U(C*(G)) *_{U(C*(Γ; G))} U(C*(G))`.

No MF hypothesis occurs here.  Thus this file isolates the analytic issue in
the MF permanence argument: one still needs an MF realization of the relevant
C-star-algebraic amalgam, but no additional group-theoretic injectivity step.

The final section explains why an arbitrary faithful corona representation
cannot replace the canonical maximal representation in this argument.  For a
representation `rho : G → U(A)`, it defines the closed star algebra generated by
`rho(Γ)` and proves that the induced map of doubles is faithful exactly when
membership in that algebra reflects membership in `Γ`.  The scalar
representation of `C₂` gives a closed counterexample to this reflection step,
even when `A` is a norm-matrix corona: the nontrivial element is represented by
`-1`, which already belongs to the unital algebra generated by the trivial
subgroup.  This refutes only the passage from an arbitrary faithful factor
representation to a faithful representation of the double; it does not refute
MF permanence by some different construction.
-/

open scoped CStarAlgebra

namespace GroupApproximation

noncomputable section

variable (G : Type) [Group G]

local instance maximalGroupCStarSubgroupDecidableEq : DecidableEq G :=
  Classical.decEq G

/-- The canonical generators of `C*(G)`, regarded as a monoid homomorphism
into the underlying multiplicative monoid of the algebra. -/
def maximalGroupCStarGeneratorHom : G →* MaximalGroupCStar G :=
  (unitary (MaximalGroupCStar G)).subtype.comp
    (maximalGroupCStarUnitaryHom G)

@[simp]
theorem maximalGroupCStarGeneratorHom_apply (g : G) :
    maximalGroupCStarGeneratorHom G g = maximalGroupCStarGenerator G g :=
  rfl

/-- Taking star sends a canonical generator to the generator indexed by the
inverse group element. -/
theorem star_maximalGroupCStarGeneratorHom (g : G) :
    star (maximalGroupCStarGeneratorHom G g) =
      maximalGroupCStarGeneratorHom G g⁻¹ := by
  have hright : maximalGroupCStarGeneratorHom G g *
      star (maximalGroupCStarGeneratorHom G g) = 1 :=
    (maximalGroupCStarUnitaryHom G g).property.2
  have hleft : maximalGroupCStarGeneratorHom G g⁻¹ *
      maximalGroupCStarGeneratorHom G g = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  calc
    star (maximalGroupCStarGeneratorHom G g) =
        maximalGroupCStarGeneratorHom G g⁻¹ *
          maximalGroupCStarGeneratorHom G g *
            star (maximalGroupCStarGeneratorHom G g) := by
              rw [hleft, one_mul]
    _ = maximalGroupCStarGeneratorHom G g⁻¹ *
          (maximalGroupCStarGeneratorHom G g *
            star (maximalGroupCStarGeneratorHom G g)) := by
              rw [mul_assoc]
    _ = maximalGroupCStarGeneratorHom G g⁻¹ := by
              rw [hright, mul_one]

variable (Γ : Subgroup G)

/-- The subgroup generators, as a monoid homomorphism into `C*(G)`. -/
def maximalSubgroupGeneratorHom : ↥Γ →* MaximalGroupCStar G :=
  (maximalGroupCStarGeneratorHom G).comp Γ.subtype

@[simp]
theorem maximalSubgroupGeneratorHom_apply (γ : ↥Γ) :
    maximalSubgroupGeneratorHom (G := G) Γ γ =
      maximalGroupCStarGenerator G (γ : G) :=
  rfl

/-- The closed star subalgebra of `C*(G)` generated by the canonical
unitaries indexed by `Γ`. -/
def maximalSubgroupCStar : StarSubalgebra ℂ (MaximalGroupCStar G) :=
  (StarAlgebra.adjoin ℂ
    (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))).topologicalClosure

/-- Every canonical generator indexed by `Γ` belongs to the closed subgroup
algebra. -/
theorem maximalGroupCStarGenerator_mem_maximalSubgroupCStar
    {g : G} (hg : g ∈ Γ) :
    maximalGroupCStarGenerator G g ∈ maximalSubgroupCStar (G := G) Γ := by
  let γ : ↥Γ := ⟨g, hg⟩
  apply StarSubalgebra.le_topologicalClosure
  exact StarAlgebra.subset_adjoin ℂ _ ⟨γ, rfl⟩

/-- The coefficient of `a` in the canonical basis direction indexed by `g`:
left-multiply by `u_g⋆` and then apply the canonical trace. -/
def canonicalMaximalCoefficientAgainst (g : G) :
    MaximalGroupCStar G →L[ℂ] ℂ :=
  (canonicalMaximalTrace G).comp
    (ContinuousLinearMap.mul ℂ (MaximalGroupCStar G)
      (star (maximalGroupCStarGeneratorHom G g)))

@[simp]
theorem canonicalMaximalCoefficientAgainst_apply (g : G)
    (a : MaximalGroupCStar G) :
    canonicalMaximalCoefficientAgainst (G := G) g a =
      canonicalMaximalTrace G
        (star (maximalGroupCStarGeneratorHom G g) * a) :=
  rfl

/-- The canonical coefficient functional is the Kronecker delta on canonical
generators. -/
theorem canonicalMaximalCoefficientAgainst_generator (g h : G) :
    canonicalMaximalCoefficientAgainst (G := G) g
        (maximalGroupCStarGenerator G h) =
      if g = h then 1 else 0 := by
  classical
  rw [canonicalMaximalCoefficientAgainst_apply,
    star_maximalGroupCStarGeneratorHom]
  change canonicalMaximalTrace G
      (maximalGroupCStarGeneratorHom G g⁻¹ *
        maximalGroupCStarGeneratorHom G h) = _
  rw [← map_mul]
  by_cases hgh : g = h
  · subst h
    rw [if_pos rfl, inv_mul_cancel, map_one, canonicalMaximalTrace_one]
  · rw [if_neg hgh]
    apply canonicalMaximalTrace_generator_of_ne_one
    intro hprod
    exact hgh (inv_mul_eq_one.mp hprod)

/-- The algebraic star algebra generated by the subgroup generators is
contained in their complex linear span. -/
theorem maximalSubgroupCStarAdjoin_le_span :
    (StarAlgebra.adjoin ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))).toSubalgebra.toSubmodule ≤
      Submodule.span ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) := by
  rw [StarAlgebra.adjoin_eq_span]
  apply Submodule.span_mono
  have hle : Submonoid.closure
      (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ) ∪
        star (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))) ≤
      MonoidHom.mrange (maximalSubgroupGeneratorHom (G := G) Γ) := by
    apply Submonoid.closure_le.mpr
    rintro x (⟨γ, rfl⟩ | hx)
    · exact ⟨γ, rfl⟩
    · rw [← Set.image_star] at hx
      obtain ⟨y, ⟨γ, rfl⟩, rfl⟩ := hx
      refine ⟨γ⁻¹, ?_⟩
      simpa using (star_maximalGroupCStarGeneratorHom G (γ : G)).symm
  intro x hx
  exact hle hx

/-- If `g` is outside `Γ`, its coefficient functional vanishes on the
algebraic star algebra generated by `Γ`. -/
theorem maximalSubgroupCStarAdjoin_le_coefficientKernel {g : G}
    (hg : g ∉ Γ) :
    (StarAlgebra.adjoin ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ))).toSubalgebra.toSubmodule ≤
      (canonicalMaximalCoefficientAgainst (G := G) g).ker := by
  refine (maximalSubgroupCStarAdjoin_le_span (G := G) Γ).trans ?_
  apply Submodule.span_le.mpr
  rintro _ ⟨γ, rfl⟩
  apply (canonicalMaximalCoefficientAgainst (G := G) g).mem_ker.mpr
  change canonicalMaximalCoefficientAgainst (G := G) g
    (maximalGroupCStarGenerator G (γ : G)) = 0
  rw [canonicalMaximalCoefficientAgainst_generator, if_neg]
  intro hggamma
  apply hg
  rw [hggamma]
  exact γ.property

/-- If `g` is outside `Γ`, its coefficient functional vanishes on the closed
star algebra generated by `Γ`. -/
theorem canonicalMaximalCoefficientAgainst_eq_zero_of_mem_maximalSubgroupCStar
    {g : G} (hg : g ∉ Γ) {a : MaximalGroupCStar G}
    (ha : a ∈ maximalSubgroupCStar (G := G) Γ) :
    canonicalMaximalCoefficientAgainst (G := G) g a = 0 := by
  have hadjoin :
      ((StarAlgebra.adjoin ℂ
        (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) :
          StarSubalgebra ℂ (MaximalGroupCStar G)) :
        Set (MaximalGroupCStar G)) ⊆
      ((canonicalMaximalCoefficientAgainst (G := G) g).ker :
        Set (MaximalGroupCStar G)) :=
    maximalSubgroupCStarAdjoin_le_coefficientKernel (G := G) Γ hg
  have hclosure :
      closure
          ((StarAlgebra.adjoin ℂ
            (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) :
              StarSubalgebra ℂ (MaximalGroupCStar G)) :
            Set (MaximalGroupCStar G)) ⊆
        ((canonicalMaximalCoefficientAgainst (G := G) g).ker :
          Set (MaximalGroupCStar G)) :=
    closure_minimal hadjoin
      (canonicalMaximalCoefficientAgainst (G := G) g).isClosed_ker
  apply (canonicalMaximalCoefficientAgainst (G := G) g).mem_ker.mp
  apply hclosure
  change a ∈ closure
    ((StarAlgebra.adjoin ℂ
      (Set.range ⇑(maximalSubgroupGeneratorHom (G := G) Γ)) :
        StarSubalgebra ℂ (MaximalGroupCStar G)) :
      Set (MaximalGroupCStar G)) at ha
  exact ha

/-- **Exact subgroup reflection in `C*(G)`.**  A canonical group unitary lies
in the closed star algebra generated by `Γ` exactly when its index lies in
`Γ`. -/
theorem maximalGroupCStarGenerator_mem_maximalSubgroupCStar_iff (g : G) :
    maximalGroupCStarGenerator G g ∈ maximalSubgroupCStar (G := G) Γ ↔ g ∈ Γ := by
  constructor
  · intro hmem
    by_contra hg
    have hzero :=
      canonicalMaximalCoefficientAgainst_eq_zero_of_mem_maximalSubgroupCStar
        (G := G) Γ hg hmem
    have hone : canonicalMaximalCoefficientAgainst (G := G) g
        (maximalGroupCStarGenerator G g) = 1 := by
      rw [canonicalMaximalCoefficientAgainst_generator, if_pos rfl]
    exact one_ne_zero (hone.symm.trans hzero)
  · exact maximalGroupCStarGenerator_mem_maximalSubgroupCStar (G := G) Γ

/-- The subgroup of all unitaries of `C*(G)` which lie in the closed star
subalgebra generated by `Γ`. -/
def maximalSubgroupUnitary :
    Subgroup (unitary (MaximalGroupCStar G)) where
  carrier := {u | (u : MaximalGroupCStar G) ∈
    maximalSubgroupCStar (G := G) Γ}
  one_mem' := (maximalSubgroupCStar (G := G) Γ).one_mem
  mul_mem' := fun hu hv ↦
    (maximalSubgroupCStar (G := G) Γ).mul_mem hu hv
  inv_mem' := by
    intro u hu
    change star (u : MaximalGroupCStar G) ∈
      maximalSubgroupCStar (G := G) Γ
    exact star_mem hu

/-- The canonical unitary representation reflects membership in the
subgroup of unitaries generated by `Γ`. -/
theorem maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff (g : G) :
    maximalGroupCStarUnitaryHom G g ∈
      maximalSubgroupUnitary (G := G) Γ ↔ g ∈ Γ := by
  exact maximalGroupCStarGenerator_mem_maximalSubgroupCStar_iff (G := G) Γ g

/-- The canonical map from the symmetric group double to the double of the
unitary groups of the maximal group C-star algebra. -/
def maximalCStarSymmetricDoubleMap :
    SymmetricDouble G Γ →*
      SymmetricDouble ↥(unitary (MaximalGroupCStar G))
        (maximalSubgroupUnitary (G := G) Γ) :=
  symmetricDoubleMap Γ (maximalSubgroupUnitary (G := G) Γ)
    (maximalGroupCStarUnitaryHom G)
    (fun g hg ↦
      (maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
        (G := G) Γ g).mpr hg)

/-- **Canonical faithful realization of the group double.**  The maximal
group C-star algebra reflects the edge subgroup, so the induced map of
symmetric doubles is injective. -/
theorem maximalCStarSymmetricDoubleMap_injective :
    Function.Injective (maximalCStarSymmetricDoubleMap (G := G) Γ) := by
  apply (symmetricDoubleMap_injective_iff_reflects_mem
    Γ (maximalSubgroupUnitary (G := G) Γ) (maximalGroupCStarUnitaryHom G)
    (fun g hg ↦
      (maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
        (G := G) Γ g).mpr hg)
    (maximalGroupCStarUnitaryHom_injective G)).mpr
  intro g hg
  exact (maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
    (G := G) Γ g).mp hg

#audit_axioms maximalGroupCStarGenerator_mem_maximalSubgroupCStar_iff
#audit_axioms maximalGroupCStarUnitaryHom_mem_maximalSubgroupUnitary_iff
#audit_axioms maximalCStarSymmetricDoubleMap_injective

/-! ## Why an arbitrary faithful corona representation is insufficient -/

variable {A : Type*} [CStarAlgebra A]

/-- The represented subgroup generators, regarded as elements of the ambient
C-star algebra. -/
def representedSubgroupGeneratorHom
    (rho : G →* unitary A) : ↥Γ →* A :=
  (unitary A).subtype.comp (rho.comp Γ.subtype)

/-- The closed star subalgebra generated by the represented subgroup. -/
def representedSubgroupCStar
    (rho : G →* unitary A) : StarSubalgebra ℂ A :=
  (StarAlgebra.adjoin ℂ
    (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho))).topologicalClosure

/-- A represented subgroup generator belongs to the represented subgroup
C-star algebra. -/
theorem representedGenerator_mem_representedSubgroupCStar
    (rho : G →* unitary A) {g : G} (hg : g ∈ Γ) :
    (rho g : A) ∈ representedSubgroupCStar (G := G) Γ rho := by
  let gamma : ↥Γ := ⟨g, hg⟩
  apply StarSubalgebra.le_topologicalClosure
  exact StarAlgebra.subset_adjoin ℂ _ ⟨gamma, rfl⟩

/-- The adjoint of a represented group element is the represented inverse. -/
theorem star_coe_unitaryHom (rho : G →* unitary A) (g : G) :
    star (rho g : A) = (rho g⁻¹ : A) := by
  change ((((rho g)⁻¹ : unitary A) : A)) = (rho g⁻¹ : A)
  exact congrArg (fun u : unitary A ↦ (u : A)) (map_inv rho g).symm

/-- The algebraic star algebra generated by a represented subgroup is
contained in the complex linear span of the represented subgroup itself. -/
theorem representedSubgroupCStarAdjoin_le_span
    (rho : G →* unitary A) :
    (StarAlgebra.adjoin ℂ
        (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho))).toSubalgebra.toSubmodule ≤
      Submodule.span ℂ
        (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho)) := by
  rw [StarAlgebra.adjoin_eq_span]
  apply Submodule.span_mono
  have hle : Submonoid.closure
      (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho) ∪
        star (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho))) ≤
      MonoidHom.mrange (representedSubgroupGeneratorHom (G := G) Γ rho) := by
    apply Submonoid.closure_le.mpr
    rintro x (⟨gamma, rfl⟩ | hx)
    · exact ⟨gamma, rfl⟩
    · rw [← Set.image_star] at hx
      obtain ⟨y, ⟨gamma, rfl⟩, rfl⟩ := hx
      refine ⟨gamma⁻¹, ?_⟩
      exact (star_coe_unitaryHom (G := G) rho (gamma : G)).symm
  intro x hx
  exact hle hx

/-- The continuous coefficient functional obtained by multiplying against a
represented group element and applying a continuous linear functional. -/
def representedCoefficientAgainst
    (rho : G →* unitary A) (tau : A →L[ℂ] ℂ) (g : G) : A →L[ℂ] ℂ :=
  tau.comp (ContinuousLinearMap.mul ℂ A (star (rho g : A)))

@[simp]
theorem representedCoefficientAgainst_apply
    (rho : G →* unitary A) (tau : A →L[ℂ] ℂ) (g : G) (a : A) :
    representedCoefficientAgainst (G := G) rho tau g a =
      tau (star (rho g : A) * a) :=
  rfl

/-- Regular coefficients vanish on the algebraic star algebra generated by a
subgroup whenever the tested group element lies outside that subgroup. -/
theorem representedSubgroupCStarAdjoin_le_coefficientKernel
    (rho : G →* unitary A) (tau : A →L[ℂ] ℂ)
    (hcoeff : ∀ g h : G,
      representedCoefficientAgainst (G := G) rho tau g (rho h : A) =
        if g = h then 1 else 0)
    {g : G} (hg : g ∉ Γ) :
    (StarAlgebra.adjoin ℂ
        (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho))).toSubalgebra.toSubmodule ≤
      (representedCoefficientAgainst (G := G) rho tau g).ker := by
  refine (representedSubgroupCStarAdjoin_le_span (G := G) Γ rho).trans ?_
  apply Submodule.span_le.mpr
  rintro _ ⟨gamma, rfl⟩
  apply (representedCoefficientAgainst (G := G) rho tau g).mem_ker.mpr
  change representedCoefficientAgainst (G := G) rho tau g
    (rho (gamma : G) : A) = 0
  rw [hcoeff, if_neg]
  intro hggamma
  apply hg
  rw [hggamma]
  exact gamma.property

/-- Regular coefficients vanish on the closed represented subgroup algebra
outside the subgroup. -/
theorem representedCoefficientAgainst_eq_zero_of_mem_representedSubgroupCStar
    (rho : G →* unitary A) (tau : A →L[ℂ] ℂ)
    (hcoeff : ∀ g h : G,
      representedCoefficientAgainst (G := G) rho tau g (rho h : A) =
        if g = h then 1 else 0)
    {g : G} (hg : g ∉ Γ) {a : A}
    (ha : a ∈ representedSubgroupCStar (G := G) Γ rho) :
    representedCoefficientAgainst (G := G) rho tau g a = 0 := by
  have hadjoin :
      ((StarAlgebra.adjoin ℂ
        (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho)) :
          StarSubalgebra ℂ A) : Set A) ⊆
      ((representedCoefficientAgainst (G := G) rho tau g).ker : Set A) :=
    representedSubgroupCStarAdjoin_le_coefficientKernel
      (G := G) Γ rho tau hcoeff hg
  have hclosure :
      closure
          ((StarAlgebra.adjoin ℂ
            (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho)) :
              StarSubalgebra ℂ A) : Set A) ⊆
        ((representedCoefficientAgainst (G := G) rho tau g).ker : Set A) :=
    closure_minimal hadjoin
      (representedCoefficientAgainst (G := G) rho tau g).isClosed_ker
  apply (representedCoefficientAgainst (G := G) rho tau g).mem_ker.mp
  apply hclosure
  change a ∈ closure
    ((StarAlgebra.adjoin ℂ
      (Set.range ⇑(representedSubgroupGeneratorHom (G := G) Γ rho)) :
        StarSubalgebra ℂ A) : Set A) at ha
  exact ha

/-- **Regular coefficients force subgroup reflection.**  If a continuous
functional has the regular Kronecker-delta coefficients on the represented
group, then the closed algebra generated by the represented subgroup contains
exactly the represented group elements indexed by that subgroup. -/
theorem representedGenerator_mem_representedSubgroupCStar_iff_of_regularCoefficients
    (rho : G →* unitary A) (tau : A →L[ℂ] ℂ)
    (hcoeff : ∀ g h : G,
      representedCoefficientAgainst (G := G) rho tau g (rho h : A) =
        if g = h then 1 else 0)
    (g : G) :
    (rho g : A) ∈ representedSubgroupCStar (G := G) Γ rho ↔ g ∈ Γ := by
  constructor
  · intro hmem
    by_contra hg
    have hzero :=
      representedCoefficientAgainst_eq_zero_of_mem_representedSubgroupCStar
        (G := G) Γ rho tau hcoeff hg hmem
    have hone : representedCoefficientAgainst (G := G) rho tau g (rho g : A) = 1 := by
      rw [hcoeff, if_pos rfl]
    exact one_ne_zero (hone.symm.trans hzero)
  · exact representedGenerator_mem_representedSubgroupCStar
      (G := G) Γ rho

/-- The unitaries lying in the closed star algebra generated by the represented
subgroup. -/
def representedSubgroupUnitary
    (rho : G →* unitary A) : Subgroup (unitary A) where
  carrier := {u | (u : A) ∈ representedSubgroupCStar (G := G) Γ rho}
  one_mem' := (representedSubgroupCStar (G := G) Γ rho).one_mem
  mul_mem' := fun hu hv ↦
    (representedSubgroupCStar (G := G) Γ rho).mul_mem hu hv
  inv_mem' := by
    intro u hu
    change star (u : A) ∈ representedSubgroupCStar (G := G) Γ rho
    exact star_mem hu

/-- The map of symmetric doubles obtained from one represented vertex group
and the unitary group of its represented edge algebra. -/
def representedSymmetricDoubleMap
    (rho : G →* unitary A) :
    SymmetricDouble G Γ →*
      SymmetricDouble (unitary A)
        (representedSubgroupUnitary (G := G) Γ rho) :=
  symmetricDoubleMap Γ (representedSubgroupUnitary (G := G) Γ rho) rho
    (fun _ hg ↦
      representedGenerator_mem_representedSubgroupCStar
        (G := G) Γ rho hg)

/-- **Exact represented-double criterion.**  A faithful representation of the
vertex group induces a faithful map of doubles precisely when its represented
edge algebra contains no represented group elements from outside the edge
subgroup. -/
theorem representedSymmetricDoubleMap_injective_iff
    (rho : G →* unitary A) (hrho : Function.Injective rho) :
    Function.Injective
        (representedSymmetricDoubleMap (G := G) Γ rho) ↔
      ∀ g : G, (rho g : A) ∈ representedSubgroupCStar (G := G) Γ rho →
        g ∈ Γ := by
  have hcriterion :=
    symmetricDoubleMap_injective_iff_reflects_mem
      Γ (representedSubgroupUnitary (G := G) Γ rho) rho
      (fun g hg ↦
        representedGenerator_mem_representedSubgroupCStar
          (G := G) Γ rho hg)
      hrho
  constructor
  · intro hinjective
    have hreflect := hcriterion.mp hinjective
    intro g hg
    exact hreflect g hg
  · intro hreflect
    apply hcriterion.mpr
    intro g hg
    exact hreflect g hg

/-- A faithful represented group with regular continuous coefficients induces
a faithful map of symmetric doubles. -/
theorem representedSymmetricDoubleMap_injective_of_regularCoefficients
    (rho : G →* unitary A) (hrho : Function.Injective rho)
    (tau : A →L[ℂ] ℂ)
    (hcoeff : ∀ g h : G,
      representedCoefficientAgainst (G := G) rho tau g (rho h : A) =
        if g = h then 1 else 0) :
    Function.Injective
      (representedSymmetricDoubleMap (G := G) Γ rho) := by
  apply (representedSymmetricDoubleMap_injective_iff
    (G := G) Γ rho hrho).mpr
  intro g hg
  exact (representedGenerator_mem_representedSubgroupCStar_iff_of_regularCoefficients
    (G := G) Γ rho tau hcoeff g).mp hg

/-- The scalar unitary `-1`. -/
def minusOneUnitary : unitary A :=
  -1

@[simp]
theorem coe_minusOneUnitary : (minusOneUnitary (A := A) : A) = -1 :=
  rfl

/-- The faithful scalar representation of the group of order two. -/
def flipScalarUnitaryHom : FlipC2 →* unitary A where
  toFun
    | .one => 1
    | .swap => minusOneUnitary (A := A)
  map_one' := rfl
  map_mul' x y := by
    cases x <;> cases y <;> apply Subtype.ext <;>
      norm_num [minusOneUnitary]

@[simp]
theorem flipScalarUnitaryHom_one :
    flipScalarUnitaryHom (A := A) FlipC2.one = 1 :=
  rfl

@[simp]
theorem flipScalarUnitaryHom_swap :
    flipScalarUnitaryHom (A := A) FlipC2.swap =
      minusOneUnitary (A := A) :=
  rfl

/-- The scalar representation of `C₂` is faithful in every complex C-star
algebra. -/
theorem flipScalarUnitaryHom_injective [Nontrivial A] :
    Function.Injective (flipScalarUnitaryHom (A := A)) := by
  have honeNeg : (1 : A) ≠ -1 := by
    intro h
    have hsmul : (2 : ℂ) • (1 : A) = 0 := by
      calc
        (2 : ℂ) • (1 : A) = 1 + 1 := two_smul ℂ (1 : A)
        _ = -1 + 1 := congrArg (fun x : A ↦ x + 1) h
        _ = 0 := neg_add_cancel 1
    have honezero : (1 : A) = 0 :=
      (smul_eq_zero.mp hsmul).resolve_left (by norm_num)
    exact (one_ne_zero : (1 : A) ≠ 0) honezero
  intro x y hxy
  cases x <;> cases y
  · rfl
  · exfalso
    have h : (1 : A) = -1 :=
      congrArg (fun u : unitary A ↦ (u : A)) hxy
    exact honeNeg h
  · exfalso
    have h : (-1 : A) = 1 :=
      congrArg (fun u : unitary A ↦ (u : A)) hxy
    exact honeNeg h.symm
  · rfl

/-- In the scalar representation, the nontrivial element of `C₂` already
lies in the unital C-star algebra generated by the trivial subgroup. -/
theorem flipScalar_swap_mem_representedSubgroupCStar_bot :
    ((flipScalarUnitaryHom (A := A) FlipC2.swap : unitary A) : A) ∈
      representedSubgroupCStar (G := FlipC2)
        (⊥ : Subgroup FlipC2) (flipScalarUnitaryHom (A := A)) := by
  change (-1 : A) ∈
    representedSubgroupCStar (G := FlipC2)
      (⊥ : Subgroup FlipC2) (flipScalarUnitaryHom (A := A))
  exact (representedSubgroupCStar (G := FlipC2)
    (⊥ : Subgroup FlipC2) (flipScalarUnitaryHom (A := A))).neg_mem
      (representedSubgroupCStar (G := FlipC2)
        (⊥ : Subgroup FlipC2) (flipScalarUnitaryHom (A := A))).one_mem

/-- **Closed counterexample to the arbitrary-representation inference.**  The
faithful scalar representation of `C₂` does not induce a faithful map from
the free product `C₂ * C₂` when the target edge group is the unitary group
of the represented trivial-subgroup algebra. -/
theorem flipScalar_representedSymmetricDoubleMap_not_injective [Nontrivial A] :
    ¬ Function.Injective
      (representedSymmetricDoubleMap (G := FlipC2)
        (⊥ : Subgroup FlipC2) (flipScalarUnitaryHom (A := A))) := by
  intro hinjective
  have hreflect :=
    (representedSymmetricDoubleMap_injective_iff
      (G := FlipC2) (⊥ : Subgroup FlipC2)
      (flipScalarUnitaryHom (A := A))
      (flipScalarUnitaryHom_injective (A := A))).mp hinjective
  have hbot : FlipC2.swap ∈ (⊥ : Subgroup FlipC2) :=
    hreflect FlipC2.swap
      (flipScalar_swap_mem_representedSubgroupCStar_bot (A := A))
  have hswap : FlipC2.swap = 1 := by
    simp at hbot
  exact (by decide : FlipC2.swap ≠ 1) hswap

/-- The counterexample occurs inside every norm-matrix corona.  Thus an actual
faithful homomorphism `G → U(Q_d)` does not, by itself, provide the faithful
double realization needed to apply a C-star amalgamation theorem. -/
theorem exists_faithful_corona_representation_not_faithful_on_double
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)] :
    ∃ rho : FlipC2 →*
        unitary (NormMatrixCStarCorona (fun n ↦ X n)),
      Function.Injective rho ∧
        ¬ Function.Injective
          (representedSymmetricDoubleMap (G := FlipC2)
            (⊥ : Subgroup FlipC2) rho) := by
  refine ⟨flipScalarUnitaryHom, flipScalarUnitaryHom_injective, ?_⟩
  exact flipScalar_representedSymmetricDoubleMap_not_injective

#audit_axioms representedSymmetricDoubleMap_injective_iff
#audit_axioms representedGenerator_mem_representedSubgroupCStar_iff_of_regularCoefficients
#audit_axioms representedSymmetricDoubleMap_injective_of_regularCoefficients
#audit_axioms flipScalarUnitaryHom_injective
#audit_axioms flipScalar_representedSymmetricDoubleMap_not_injective
#audit_axioms exists_faithful_corona_representation_not_faithful_on_double

end

