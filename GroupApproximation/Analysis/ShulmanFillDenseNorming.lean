import GroupApproximation.Analysis.ShulmanFillTheorem16

/-!
# The remaining input of Theorem 16, only on a dense set

`ShulmanFill.CompatibleCoronaNormingStatement` asks that every element of the
amalgam have its norm approximated by an evaluation with an MF carrier.  Norm
approximation is stable under small perturbations of the element: evaluations
are contractive, so an `ε/3` argument moves the approximation from a nearby
element to the given one.

So the input only has to be checked on a dense set — in practice on the
`*`-algebra generated by the two factor images, that is on *words* in the
generators, never on limits.  `CompatibleCoronaDenseNormingStatement` below is
that weakened input, with the dense set chosen by whoever discharges it, and
`shulmanTheorem16_of_denseNorming` closes Theorem 16 from it.

This module is not named in the root import list, but it reaches the root
closure through `Analysis/ShulmanFillWordNorming` and
`Analysis/ShulmanFillConjugatePair`.  It was authored while builds were
suspended and has not been elaborated since.
-/

namespace GroupApproximation
namespace ShulmanFill

noncomputable section

variable {C A B : Type}
  [CStarAlgebra C] [CStarAlgebra A] [CStarAlgebra B]
  (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)
  [Nonempty (CStarAmalgamRepresentation iA iB)]

/-- **Norming on a dense set is norming.**  Every evaluation coordinate is
contractive, so an element within `ε/3` of one that is normed to within `ε/3`
is normed to within `ε`. -/
theorem norming_of_dense_norming
    {D : Set (UniversalCStarAmalgam iA iB)} (hD : Dense D)
    (hdense : ∀ y ∈ D, ∀ δ : ℝ, 0 < δ →
      ∃ R : CStarAmalgamRepresentation iA iB,
        HasMFEmbedding R.carrier ∧
          ‖y‖ - δ ≤ ‖universalCStarAmalgamEval iA iB R y‖)
    (x : UniversalCStarAmalgam iA iB) (ε : ℝ) (hε : 0 < ε) :
    ∃ R : CStarAmalgamRepresentation iA iB,
      HasMFEmbedding R.carrier ∧
        ‖x‖ - ε ≤ ‖universalCStarAmalgamEval iA iB R x‖ := by
  obtain ⟨y, hyD, hy⟩ :=
    Metric.mem_closure_iff.mp (hD x) (ε / 3) (by linarith)
  obtain ⟨R, hRMF, hR⟩ := hdense y hyD (ε / 3) (by linarith)
  refine ⟨R, hRMF, ?_⟩
  have hxy : ‖x - y‖ < ε / 3 := by
    rwa [← dist_eq_norm]
  have hsub : ‖universalCStarAmalgamEval iA iB R y‖ -
      ‖universalCStarAmalgamEval iA iB R x‖ ≤ ‖x - y‖ := by
    calc ‖universalCStarAmalgamEval iA iB R y‖ -
          ‖universalCStarAmalgamEval iA iB R x‖
        ≤ ‖universalCStarAmalgamEval iA iB R y -
            universalCStarAmalgamEval iA iB R x‖ := norm_sub_norm_le _ _
      _ = ‖universalCStarAmalgamEval iA iB R (y - x)‖ := by rw [map_sub]
      _ ≤ ‖y - x‖ :=
          NonUnitalStarAlgHom.norm_apply_le
            (universalCStarAmalgamEval iA iB R) (y - x)
      _ = ‖x - y‖ := norm_sub_rev _ _
  have hylower : ‖x‖ - ‖x - y‖ ≤ ‖y‖ := by
    have h := norm_sub_norm_le x (x - y)
    simpa using h
  linarith

/-- **The remaining input of Theorem 16, only on a dense set.**  The dense set
is chosen by whoever discharges the statement; the `*`-algebra generated by the
two factor images is the intended choice, so that only words in the generators
have to be normed. -/
def CompatibleCoronaDenseNormingStatement : Prop :=
  ∀ {C A₁ A₂ : Type} [CStarAlgebra C] [CStarAlgebra A₁]
    [CStarAlgebra A₂] (iA : C →⋆ₐ[ℂ] A₁) (iB : C →⋆ₐ[ℂ] A₂)
    [Nonempty (CStarAmalgamRepresentation iA iB)],
      TopologicalSpace.SeparableSpace C →
      TopologicalSpace.SeparableSpace A₁ →
      TopologicalSpace.SeparableSpace A₂ →
      ∀ (Y : ℕ → FiniteModel) [∀ n, Nonempty (Y n)]
        (phiA : A₁ →⋆ₙₐ[ℂ] NormMatrixCStarCorona (fun n ↦ Y n))
        (phiB : A₂ →⋆ₙₐ[ℂ] NormMatrixCStarCorona (fun n ↦ Y n)),
        Function.Injective phiA → Function.Injective phiB →
          (∀ c : C, phiA (iA c) = phiB (iB c)) →
            ∃ D : Set (UniversalCStarAmalgam iA iB), Dense D ∧
              ∀ y ∈ D, ∀ δ : ℝ, 0 < δ →
                ∃ R : CStarAmalgamRepresentation iA iB,
                  HasMFEmbedding R.carrier ∧
                    ‖y‖ - δ ≤ ‖universalCStarAmalgamEval iA iB R y‖

/-- The dense form of the input implies the full one. -/
theorem compatibleCoronaNorming_of_dense
    (hdense : CompatibleCoronaDenseNormingStatement) :
    CompatibleCoronaNormingStatement := by
  intro C A₁ A₂ _ _ _ iA iB _ hC hA₁ hA₂ Y _ phiA phiB hphiA hphiB hcomp x ε hε
  obtain ⟨D, hD, hnorm⟩ :=
    hdense iA iB hC hA₁ hA₂ Y phiA phiB hphiA hphiB hcomp
  exact norming_of_dense_norming iA iB hD hnorm x ε hε

/-- **Shulman's Theorem 16 from the dense form of the input.** -/
theorem shulmanTheorem16_of_denseNorming
    (hdense : CompatibleCoronaDenseNormingStatement) :
    Manuscript.MFRecognition.HNNPermanence.ShulmanTheorem16Statement :=
  shulmanTheorem16_of_compatibleCoronaNorming
    (compatibleCoronaNorming_of_dense hdense)

end

end ShulmanFill
end GroupApproximation
