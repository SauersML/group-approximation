import GroupApproximation.Analysis.GroupVonNeumannAlgebra

/-!
# The reduced algebra is the closed linear span of the translations

Toward the *forward* half of the Lance debt.  `Analysis/LanceNuclearity`
proves Lance's arrow in the direction the manuscript's nonnuclearity
paragraph needs --- completely positive approximation forces an invariant
mean.  `QuasidiagonalMF.AmenableNuclearInput` needs the other direction:
an amenable group has a nuclear reduced algebra.  Every construction on
that side produces maps defined on *translations* and has to conclude
something about arbitrary elements of the algebra, so it needs to know that
the translations span a dense subspace.  That is what this file proves.

The point is that no monomials are needed.  `StarAlgebra.adjoin_eq_span`
writes the generated star algebra as the span of the multiplicative closure
of `s ∪ star s`; here `s = λ(G)` is *already* a submonoid --- `λ` is a
monoid homomorphism --- and it is already star-closed, since
`star (λ g) = λ g⁻¹`.  So the multiplicative closure collapses and the star
algebra is the plain `ℂ`-span of `λ(G)`.

* `leftRegularOperator_one`, `leftRegularOperator_mul` --- `λ` is
  multiplicative, packaged as `lambdaSubmonoid`;
* `star_range_leftRegularOperator` --- the image is star-closed *as a set*
  (`GroupVonNeumann.star_mem_range_leftRegularOperator` is the elementwise
  form);
* `adjoin_toSubmodule_eq_span` --- the collapse;
* `exists_translationSum_approx` --- **the usable form**: every element of
  `C⋆_λ(G)` is within `ε` of a finite `ℂ`-combination of translations.

## Manuscript status

Infrastructure for the Lance lane; certifies no manuscript step on its own.
-/

namespace GroupApproximation
namespace ReducedGroupCStarTrace

noncomputable section

open scoped Pointwise

universe u

variable (G : Type u) [Group G]

/-! ## The translations form a star-closed submonoid -/

/-- The left regular representation sends the identity to the identity. -/
@[simp]
theorem leftRegularOperator_one : leftRegularOperator G (1 : G) = 1 := by
  apply ContinuousLinearMap.ext
  intro f
  apply lp.ext
  funext x
  simp

/-- The left regular representation is multiplicative. -/
theorem leftRegularOperator_mul (g h : G) :
    leftRegularOperator G g * leftRegularOperator G h
      = leftRegularOperator G (g * h) := by
  apply ContinuousLinearMap.ext
  intro f
  apply lp.ext
  funext x
  simp [mul_assoc]

/-- The image of the left regular representation, as a submonoid of the
bounded operators. -/
def lambdaSubmonoid : Submonoid (GroupHilbert G →L[ℂ] GroupHilbert G) where
  carrier := Set.range (leftRegularOperator G)
  mul_mem' := by
    rintro _ _ ⟨g, rfl⟩ ⟨h, rfl⟩
    exact ⟨g * h, (leftRegularOperator_mul G g h).symm⟩
  one_mem' := ⟨1, leftRegularOperator_one G⟩

@[simp]
theorem coe_lambdaSubmonoid :
    (lambdaSubmonoid G : Set (GroupHilbert G →L[ℂ] GroupHilbert G))
      = Set.range (leftRegularOperator G) :=
  rfl

/-- The multiplicative closure of the translations is the translations. -/
theorem closure_range_leftRegularOperator :
    Submonoid.closure (Set.range (leftRegularOperator G)) = lambdaSubmonoid G :=
  Submonoid.closure_eq (lambdaSubmonoid G)

/-- The set of translations is closed under the adjoint. -/
theorem star_range_leftRegularOperator :
    star (Set.range (leftRegularOperator G))
      = Set.range (leftRegularOperator G) := by
  rw [← Set.image_star]
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact GroupVonNeumann.star_mem_range_leftRegularOperator G hy
  · intro hx
    exact ⟨star x, GroupVonNeumann.star_mem_range_leftRegularOperator G hx,
      star_star x⟩

/-! ## The collapse of the generated star algebra -/

/-- **The star algebra generated by the translations is their span.**  No
monomials survive: the generating set is already a star-closed submonoid. -/
theorem adjoin_toSubmodule_eq_span :
    (StarAlgebra.adjoin ℂ
        (Set.range (leftRegularOperator G))).toSubalgebra.toSubmodule
      = Submodule.span ℂ (Set.range (leftRegularOperator G)) := by
  rw [StarAlgebra.adjoin_eq_span, star_range_leftRegularOperator,
    Set.union_self, closure_range_leftRegularOperator]
  rfl

/-- Membership form of `adjoin_toSubmodule_eq_span`. -/
theorem mem_adjoin_iff_mem_span
    {x : GroupHilbert G →L[ℂ] GroupHilbert G} :
    x ∈ StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G)) ↔
      x ∈ Submodule.span ℂ (Set.range (leftRegularOperator G)) := by
  constructor
  · intro hx
    rw [← adjoin_toSubmodule_eq_span]
    exact hx
  · intro hx
    rw [← adjoin_toSubmodule_eq_span] at hx
    exact hx

/-- Every translation lies in the reduced algebra.  (`LanceNuclearity`
carries the `Type 0` special case; this is the universe-polymorphic one.) -/
theorem leftRegularOperator_mem_reduced (g : G) :
    leftRegularOperator G g ∈ reducedGroupCStarSubalgebra G :=
  (StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G))).le_topologicalClosure
    (StarAlgebra.subset_adjoin ℂ _ ⟨g, rfl⟩)

/-- Left translation is a linear isometry, so it acts by norm-preserving
operators. -/
theorem norm_leftRegularOperator_apply (g : G) (f : GroupHilbert G) :
    ‖leftRegularOperator G g f‖ = ‖f‖ :=
  (leftRegular G g).norm_map f

/-- Hence each translation is a contraction. -/
theorem norm_leftRegularOperator_le_one (g : G) :
    ‖leftRegularOperator G g‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun f ↦ by
    rw [norm_leftRegularOperator_apply, one_mul]

/-- The reduced algebra is closed.  (`LanceNuclearity` carries the `Type 0`
special case; this is the universe-polymorphic one.) -/
theorem isClosed_reducedGroupCStar :
    IsClosed ((reducedGroupCStarSubalgebra G :
      StarSubalgebra ℂ (GroupHilbert G →L[ℂ] GroupHilbert G)) :
      Set (GroupHilbert G →L[ℂ] GroupHilbert G)) := by
  rw [reducedGroupCStarSubalgebra, StarSubalgebra.topologicalClosure_coe]
  exact isClosed_closure

/-! ## Density -/

/-- **The usable density statement.**  Every element of the reduced group
C⋆-algebra is within `ε` of a finite `ℂ`-linear combination of
translations. -/
theorem exists_translationSum_approx
    {a : GroupHilbert G →L[ℂ] GroupHilbert G}
    (ha : a ∈ reducedGroupCStarSubalgebra G) {ε : ℝ} (hε : 0 < ε) :
    ∃ (n : ℕ) (c : Fin n → ℂ) (γ : Fin n → G),
      ‖a - ∑ i, c i • leftRegularOperator G (γ i)‖ < ε := by
  classical
  have hmem : a ∈ closure
      ((StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G)) :
        StarSubalgebra ℂ (GroupHilbert G →L[ℂ] GroupHilbert G)) :
        Set (GroupHilbert G →L[ℂ] GroupHilbert G)) := by
    rw [← StarSubalgebra.topologicalClosure_coe]
    exact ha
  obtain ⟨b, hb, hdist⟩ := Metric.mem_closure_iff.mp hmem ε hε
  have hb' : b ∈ StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G)) := hb
  obtain ⟨n, f, gvec, hsum⟩ :=
    Submodule.mem_span_set'.mp ((mem_adjoin_iff_mem_span G).mp hb')
  refine ⟨n, f, fun i ↦ Classical.choose (gvec i).2, ?_⟩
  have hg : ∀ i : Fin n,
      f i • leftRegularOperator G (Classical.choose (gvec i).2)
        = f i • ((gvec i : GroupHilbert G →L[ℂ] GroupHilbert G)) := by
    intro i
    rw [Classical.choose_spec (gvec i).2]
  rw [Finset.sum_congr rfl (fun i _ ↦ hg i), hsum, ← dist_eq_norm]
  exact hdist

end

end ReducedGroupCStarTrace
end GroupApproximation
