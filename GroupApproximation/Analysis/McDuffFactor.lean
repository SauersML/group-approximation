import GroupApproximation.Analysis.VonNeumannTwistedAmplification
import GroupApproximation.Analysis.PauliHyperfiniteFactor
import GroupApproximation.Analysis.GroupVonNeumannUnitaryGroup
import GroupApproximation.Analysis.GroupVonNeumannIIOneFactor
import GroupApproximation.Meta.AxiomGuard

/-!
# `M ⊗̄ 𝓡`, McDuff factors, and the group inside the unitary group of `L(G) ⊗̄ 𝓡`

Lane `oa-mcduff` for `simple_kazhdan_sofic_group.tex` at origin/main 37551fd93, "Brown's formulation",
tex 280–283 (census row `97438886a277`): "`L(G) ⊗̄ 𝓡` is a McDuff factor [McDuff] that embeds in `𝓡^ω` and
whose unitary group contains `G`".

* `tensorHyperfinite M`: `M ⊗̄ 𝓡` on `ℓ²(Γ; H) = H ⊗ ℓ²(Γ)`, the von Neumann algebra generated by
  `M ⊗ 1` and `1 ⊗ 𝓡`, where `𝓡 = L_β(Γ)` is the Pauli model of lane oa-hyperfinite
  (`Hyperfinite.hyperfiniteFactor`, a II₁ factor by `Hyperfinite.isIIOneFactor_hyperfiniteFactor`).
* `IsMcDuffFactor M`: a II₁ factor with `M ≅ M ⊗̄ 𝓡` as unital ⋆-algebras.  McDuff's characterization
  by central sequences is not used.
* `groupUnitaryHom G`: `g ↦ λ(g) ⊗ 1`, an injective group homomorphism into the unitary group of
  `L(G) ⊗̄ 𝓡` (`groupUnitaryHom_injective`).
* `printedTensorHyperfiniteUnitaryContainsGroup`: "whose unitary group contains `G`", for every group.
-/

namespace GroupApproximation
namespace McDuff

noncomputable section

universe v

/-- **`M ⊗̄ 𝓡`** on `ℓ²(Γ; H)`, with `𝓡 = L_β(Γ)` the Pauli model. -/
abbrev tensorHyperfinite {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (M : VonNeumannAlgebra H) :
    VonNeumannAlgebra (TwistedTensor.VecHilbert Hyperfinite.PauliGroup H) :=
  TwistedTensor.twistedTensor M Hyperfinite.pauliCocycle

/-- **A McDuff factor**: a II₁ factor `M` with `M ≅ M ⊗̄ 𝓡` as unital ⋆-algebras. -/
def IsMcDuffFactor {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (M : VonNeumannAlgebra H) : Prop :=
  IIOneFactor.IsIIOneFactor M ∧
    Nonempty (↥M.toStarSubalgebra ≃⋆ₐ[ℂ] ↥(tensorHyperfinite M).toStarSubalgebra)

/-- **tex 280–283, last clause** (census `97438886a277`): "whose unitary group contains `G`".  Every
group is a subgroup of the unitary group of `L(G) ⊗̄ 𝓡`. -/
def PrintedTensorHyperfiniteUnitaryContainsGroup : Prop :=
  ∀ (G : Type v) [Group G],
    ∃ φ : G →* unitary
        ↥(tensorHyperfinite (GroupVonNeumann.groupVonNeumannAlgebra G)).toStarSubalgebra,
      Function.Injective φ

section Group

variable (G : Type v) [Group G]

/-- `g ↦ λ(g) ⊗ 1`, into the unitary group of `L(G) ⊗̄ 𝓡`. -/
def groupUnitaryHom :
    G →* unitary ↥(tensorHyperfinite (GroupVonNeumann.groupVonNeumannAlgebra G)).toStarSubalgebra :=
  (TwistedTensor.unitaryAmp (GroupVonNeumann.groupVonNeumannAlgebra G)
      Hyperfinite.pauliCocycle).comp (GroupVonNeumann.leftRegularUnitaryHom G)

/-- **`g ↦ λ(g) ⊗ 1` is injective.** -/
theorem groupUnitaryHom_injective : Function.Injective (groupUnitaryHom G) :=
  (TwistedTensor.unitaryAmp_injective _ _).comp (GroupVonNeumann.leftRegularUnitaryHom_injective G)

end Group

theorem printedTensorHyperfiniteUnitaryContainsGroup :
    PrintedTensorHyperfiniteUnitaryContainsGroup.{v} := by
  intro G _
  exact ⟨groupUnitaryHom G, groupUnitaryHom_injective G⟩

end

end McDuff
end GroupApproximation

#audit_closed_axioms GroupApproximation.McDuff.printedTensorHyperfiniteUnitaryContainsGroup
