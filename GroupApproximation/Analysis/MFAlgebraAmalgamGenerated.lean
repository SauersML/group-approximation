import GroupApproximation.Analysis.CStarGeneratedSeparable
import GroupApproximation.Analysis.UniversalCStarAmalgam

/-!
# The corona algebra generated by a compatible pair

Given compatible maps from two separable C-star algebras into one norm-matrix
corona, this file constructs the closed C-star subalgebra generated by their
images.  It proves that the factor maps remain compatible and faithful after
corestriction and that the generated algebra is MF.
-/

namespace GroupApproximation
namespace MFAlgebraAmalgamCriterion

open scoped Pointwise

noncomputable section

variable {C A B : Type}
  [CStarAlgebra C] [CStarAlgebra A] [CStarAlgebra B]
  (iA : C →⋆ₐ[ℂ] A) (iB : C →⋆ₐ[ℂ] B)

/-- Shulman's intermediate algebra
`D = C⁺(left(A), right(B))` inside the common norm-matrix corona. -/
def compatibleGeneratedSubalgebra
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    StarSubalgebra ℂ (NormMatrixCStarCorona (fun n ↦ X n)) :=
  (StarAlgebra.adjoin ℂ (Set.range left ∪ Set.range right)).topologicalClosure

instance compatibleGenerated_isClosed
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    IsClosed (compatibleGeneratedSubalgebra X left right :
      Set (NormMatrixCStarCorona (fun n ↦ X n))) :=
  StarSubalgebra.isClosed_topologicalClosure _

@[reducible] noncomputable def compatibleGeneratedCStarAlgebra
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    CStarAlgebra (compatibleGeneratedSubalgebra X left right) :=
  { toNormedRing := inferInstance
    toStarRing := inferInstance
    toCompleteSpace :=
      (compatibleGenerated_isClosed X left right).completeSpace_coe
    toCStarRing := inferInstance
    toNormedAlgebra :=
      (compatibleGeneratedSubalgebra X left right).toSubalgebra.toNormedAlgebra
    toStarModule :=
      StarSubalgebra.starModule (compatibleGeneratedSubalgebra X left right) }

/-- The left factor, corestricted to the generated corona algebra. -/
def leftToCompatibleGenerated
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    A →⋆ₐ[ℂ] compatibleGeneratedSubalgebra X left right :=
  left.codRestrict (compatibleGeneratedSubalgebra X left right) fun a ↦
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨a, rfl⟩))

/-- The right factor, corestricted to the generated corona algebra. -/
def rightToCompatibleGenerated
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    B →⋆ₐ[ℂ] compatibleGeneratedSubalgebra X left right :=
  right.codRestrict (compatibleGeneratedSubalgebra X left right) fun b ↦
    StarSubalgebra.le_topologicalClosure _
      (StarAlgebra.subset_adjoin ℂ _ (Or.inr ⟨b, rfl⟩))

@[simp] theorem coe_leftToCompatibleGenerated
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (a : A) :
    ((leftToCompatibleGenerated X left right a :
        compatibleGeneratedSubalgebra X left right) :
      NormMatrixCStarCorona (fun n ↦ X n)) = left a :=
  rfl

@[simp] theorem coe_rightToCompatibleGenerated
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (b : B) :
    ((rightToCompatibleGenerated X left right b :
        compatibleGeneratedSubalgebra X left right) :
      NormMatrixCStarCorona (fun n ↦ X n)) = right b :=
  rfl

/-- Compatibility is preserved when the two maps are corestricted to the
corona algebra they generate. -/
theorem compatibleGenerated_comp_eq
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (hcompatible : left.comp iA = right.comp iB) :
    (leftToCompatibleGenerated X left right).comp iA =
      (rightToCompatibleGenerated X left right).comp iB := by
  apply StarAlgHom.ext
  intro c
  apply Subtype.ext
  exact DFunLike.congr_fun hcompatible c

/-- The two corestricted factor maps remain faithful. -/
theorem compatibleGenerated_factor_injective
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (hleft : Function.Injective left) (hright : Function.Injective right) :
    Function.Injective (leftToCompatibleGenerated X left right) ∧
      Function.Injective (rightToCompatibleGenerated X left right) := by
  constructor
  · intro a a' h
    apply hleft
    exact congrArg Subtype.val h
  · intro b b' h
    apply hright
    exact congrArg Subtype.val h

/-- The generated corona algebra has a faithful norm-matrix-corona embedding.
The size hypotheses are exactly those in the repository's bare MF-embedding
predicate. -/
theorem compatibleGenerated_hasMFEmbedding
    (X : ℕ → FiniteModel) (hne : ∀ n, Nonempty (X n))
    (hpos : ∀ n, 0 < Fintype.card (X n))
    (hmono : StrictMono (fun n ↦ Fintype.card (X n)))
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    @HasMFEmbedding (compatibleGeneratedSubalgebra X left right)
      (compatibleGeneratedCStarAlgebra X left right).toNonUnitalCStarAlgebra := by
  letI : ∀ n, Nonempty (X n) := hne
  letI : CStarAlgebra (compatibleGeneratedSubalgebra X left right) :=
    compatibleGeneratedCStarAlgebra X left right
  exact (normMatrixCStarCorona_hasMFEmbedding X hne hpos hmono).of_injective_nonUnitalStarAlgHom
    (compatibleGeneratedSubalgebra X left right).subtype.toNonUnitalStarAlgHom
    fun x y h ↦ Subtype.ext
      (show (x : NormMatrixCStarCorona (fun n ↦ X n)) =
        (y : NormMatrixCStarCorona (fun n ↦ X n)) from h)

/-- If the two factors are separable, the corona algebra generated by their
images is separable even though the ambient corona need not be. -/
theorem compatibleGenerated_separableSpace
    [TopologicalSpace.SeparableSpace A]
    [TopologicalSpace.SeparableSpace B]
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)]
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    TopologicalSpace.SeparableSpace
      (compatibleGeneratedSubalgebra X left right) := by
  change TopologicalSpace.SeparableSpace
    ((StarAlgebra.adjoin ℂ
      (Set.range left ∪ Set.range right)).topologicalClosure)
  exact topologicalClosure_adjoin_union_range_separable left right

/-- The corona algebra generated by compatible images of two separable
factors is itself an MF algebra. -/
theorem compatibleGenerated_isMFAlgebra
    [TopologicalSpace.SeparableSpace A]
    [TopologicalSpace.SeparableSpace B]
    (X : ℕ → FiniteModel) (hne : ∀ n, Nonempty (X n))
    (hpos : ∀ n, 0 < Fintype.card (X n))
    (hmono : StrictMono (fun n ↦ Fintype.card (X n)))
    (left : A →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n))
    (right : B →⋆ₐ[ℂ] NormMatrixCStarCorona (fun n ↦ X n)) :
    @IsMFAlgebra (compatibleGeneratedSubalgebra X left right)
      (compatibleGeneratedCStarAlgebra X left right).toNonUnitalCStarAlgebra := by
  letI : ∀ n, Nonempty (X n) := hne
  letI : CStarAlgebra (compatibleGeneratedSubalgebra X left right) :=
    compatibleGeneratedCStarAlgebra X left right
  exact ⟨compatibleGenerated_separableSpace X left right,
    compatibleGenerated_hasMFEmbedding X hne hpos hmono left right⟩

end

end MFAlgebraAmalgamCriterion
end GroupApproximation
