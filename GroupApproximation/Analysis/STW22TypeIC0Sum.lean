import GroupApproximation.Analysis.STW22TypeIUnitization

/-!
# Type I passes through a countable `c₀`-sum

This discharges the last permanence clause of the STW Problem XXII audit's step
(A5).  With `Analysis/STW22TypeIUnitization` (unitization) it completes

> each `D s` is type I; these properties pass through a countable `c₀`-sum and
> unitization; hence `A` is type I

modulo only the type I-ness of the blocks themselves.

## The abstraction

Exactly as `IsScalarExtension` abstracted the unitization, `IsIdealHom` and
`IsSummandExhaustive` abstract the `c₀`-sum to the two properties the proof
actually consumes, so no `c₀`-sum type has to be constructed:

* `IsIdealHom (ι s)` — the range of each summand inclusion is a two-sided ideal;
* `IsSummandExhaustive ι` — a representation vanishing on every summand is zero.

Both hold for the genuine `c₀`-sum: the summands are ideals by coordinatewise
multiplication, and their span is dense, so a contractive `⋆`-homomorphism
killing all of them kills everything.

## The mathematical core

`isIrreducibleNonUnitalRep_restrict`: **an irreducible representation restricted
to a two-sided ideal is irreducible as soon as it is nonzero.**  Two invariant
subspaces do the work.

1. The joint kernel `{ζ | ∀ x, σ x ζ = 0}` is closed and `π(B)`-invariant — this
   is where the *right* ideal property is spent, via `σ x (π b ζ) = π (ι x * b) ζ`.
   Irreducibility of `π` makes it `⊥` or `⊤`, and `σ ≠ 0` rules out `⊤`.
2. For `M` closed, `σ`-invariant and nonzero, the closed span `N` of `σ(D) · M`
   sits inside `M`, is nonzero by step 1, and is `π(B)`-invariant — this is where
   the *left* ideal property is spent, via `π b (σ x η) = π (b * ι x) η`.
   Irreducibility of `π` forces `N = ⊤`, hence `M = ⊤`.

`Submodule.topologicalClosure` supplies the closed span, and invariance passes
to it because `π b` is continuous (`mapsTo_topologicalClosure`).

The resulting permanence theorem is used directly by the concrete `c₀`-sum
construction; no hypothesis bundle is needed.
-/

namespace GroupApproximation
namespace STW22

set_option linter.unusedSectionVars false

noncomputable section

universe u v

/-! ## The joint kernel of a family of operators -/

section JointKernel

variable {ιx : Type*} {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The joint kernel of a family of continuous operators, as a submodule. -/
def jointKernel (f : ιx → (H →L[ℂ] H)) : Submodule ℂ H where
  carrier := {ζ : H | ∀ x : ιx, f x ζ = 0}
  zero_mem' := fun x => map_zero (f x)
  add_mem' := by
    intro a b ha hb x
    rw [map_add, ha x, hb x, add_zero]
  smul_mem' := by
    intro c a ha x
    rw [ContinuousLinearMap.map_smul, ha x, smul_zero]

theorem mem_jointKernel {f : ιx → (H →L[ℂ] H)} {ζ : H} :
    ζ ∈ jointKernel f ↔ ∀ x : ιx, f x ζ = 0 := Iff.rfl

theorem isClosed_jointKernel (f : ιx → (H →L[ℂ] H)) :
    IsClosed ((jointKernel f : Submodule ℂ H) : Set H) := by
  have hset : ((jointKernel f : Submodule ℂ H) : Set H) = ⋂ x : ιx, {ζ : H | f x ζ = 0} := by
    ext ζ
    simp only [SetLike.mem_coe, mem_jointKernel, Set.mem_iInter, Set.mem_setOf_eq]
  rw [hset]
  exact isClosed_iInter fun x => isClosed_eq (f x).continuous continuous_const

/-- The set `f(ιx) · M`, whose closed span is the invariant subspace generated by
`M`. -/
def imageSet (f : ιx → (H →L[ℂ] H)) (M : Submodule ℂ H) : Set H :=
  {ζ : H | ∃ (x : ιx) (η : H), η ∈ M ∧ ζ = f x η}

theorem mem_imageSet {f : ιx → (H →L[ℂ] H)} {M : Submodule ℂ H} {ζ : H} :
    ζ ∈ imageSet f M ↔ ∃ (x : ιx) (η : H), η ∈ M ∧ ζ = f x η := Iff.rfl

theorem apply_mem_span_imageSet {f : ιx → (H →L[ℂ] H)} {M : Submodule ℂ H}
    (x : ιx) {η : H} (hη : η ∈ M) : f x η ∈ Submodule.span ℂ (imageSet f M) :=
  Submodule.subset_span ⟨x, η, hη, rfl⟩

/-- A continuous operator preserving a submodule preserves its closure. -/
theorem mapsTo_topologicalClosure (T : H →L[ℂ] H) {P : Submodule ℂ H}
    (hT : ∀ ζ ∈ P, T ζ ∈ P) :
    ∀ ζ ∈ P.topologicalClosure, T ζ ∈ P.topologicalClosure := by
  intro ζ hζ
  have h1 : ζ ∈ closure (P : Set H) := hζ
  have h2 : T ζ ∈ T '' closure (P : Set H) := ⟨ζ, h1, rfl⟩
  have h3 : T '' closure (P : Set H) ⊆ closure (T '' (P : Set H)) :=
    image_closure_subset_closure_image T.continuous
  have h4 : T '' (P : Set H) ⊆ (P : Set H) := by
    rintro _ ⟨w, hw, rfl⟩
    exact hT w hw
  exact closure_mono h4 (h3 h2)

end JointKernel

/-! ## Ideal summands -/

/-- The range of `ι` is a two-sided ideal. -/
structure IsIdealHom {D B : Type u} [NonUnitalCStarAlgebra D] [NonUnitalCStarAlgebra B]
    (ι : D →⋆ₙₐ[ℂ] B) : Prop where
  /-- The range absorbs multiplication on the left. -/
  left : ∀ (b : B) (x : D), ∃ y : D, b * ι x = ι y
  /-- The range absorbs multiplication on the right. -/
  right : ∀ (b : B) (x : D), ∃ y : D, ι x * b = ι y

/-- A representation of `B` turns products into compositions. -/
theorem rep_apply_mul {B : Type u} [NonUnitalCStarAlgebra B] {H : Type v} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] (π : B →⋆ₙₐ[ℂ] (H →L[ℂ] H)) (b c : B) (ζ : H) :
    π (b * c) ζ = π b (π c ζ) := by
  rw [map_mul, ContinuousLinearMap.mul_def, ContinuousLinearMap.comp_apply]

/-- **An irreducible representation restricted to a two-sided ideal is
irreducible as soon as it is nonzero.** -/
theorem isIrreducibleNonUnitalRep_restrict
    {D B : Type u} [NonUnitalCStarAlgebra D] [NonUnitalCStarAlgebra B]
    {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {ι : D →⋆ₙₐ[ℂ] B} (hideal : IsIdealHom ι)
    {π : B →⋆ₙₐ[ℂ] (H →L[ℂ] H)} (hπ : IsIrreducibleNonUnitalRep π)
    {σ : D →⋆ₙₐ[ℂ] (H →L[ℂ] H)} (hσ : ∀ x : D, σ x = π (ι x))
    (hne : ∃ x : D, σ x ≠ 0) :
    IsIrreducibleNonUnitalRep σ := by
  obtain ⟨x₀, hx₀⟩ := hne
  refine ⟨⟨x₀, hx₀⟩, ?_⟩
  -- Step 1: the joint kernel of `σ` is trivial.
  have hK_inv : ∀ b : B, ∀ ζ ∈ jointKernel (σ : D → (H →L[ℂ] H)),
      π b ζ ∈ jointKernel (σ : D → (H →L[ℂ] H)) := by
    intro b ζ hζ
    rw [mem_jointKernel] at hζ ⊢
    intro x
    obtain ⟨y, hy⟩ := hideal.right b x
    have h1 : σ x (π b ζ) = π (ι x * b) ζ := by
      rw [hσ x, rep_apply_mul]
    rw [h1, hy, ← hσ y, hζ y]
  have hK_bot : jointKernel (σ : D → (H →L[ℂ] H)) = ⊥ := by
    rcases hπ.2 _ (isClosed_jointKernel _) hK_inv with h | h
    · exact h
    · exfalso
      refine hx₀ (ContinuousLinearMap.ext fun ζ => ?_)
      have hζ : ζ ∈ jointKernel (σ : D → (H →L[ℂ] H)) := by
        rw [h]
        exact Submodule.mem_top
      rw [mem_jointKernel] at hζ
      rw [hζ x₀]
      rfl
  -- Step 2: a nonzero closed invariant subspace is everything.
  intro M hMclosed hMinv
  by_cases hMbot : M = ⊥
  · exact Or.inl hMbot
  right
  obtain ⟨ξ, hξM, hξ0⟩ : ∃ ξ ∈ M, ξ ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hMbot (le_antisymm (fun z hz => (Submodule.mem_bot ℂ).mpr (hcon z hz)) bot_le)
  obtain ⟨x₁, hx₁⟩ : ∃ x : D, σ x ξ ≠ 0 := by
    by_contra hcon
    push Not at hcon
    have hmem : ξ ∈ jointKernel (σ : D → (H →L[ℂ] H)) := hcon
    rw [hK_bot] at hmem
    exact hξ0 ((Submodule.mem_bot ℂ).mp hmem)
  -- the closed span of `σ(D) · M`
  have hspan_le : Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M) ≤ M := by
    refine Submodule.span_le.mpr ?_
    rintro ζ ⟨x, η, hη, rfl⟩
    exact hMinv x η hη
  have hN_le : (Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M)).topologicalClosure ≤ M :=
    Submodule.topologicalClosure_minimal _ hspan_le hMclosed
  have hspan_inv : ∀ b : B, ∀ ζ ∈ Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M),
      π b ζ ∈ Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M) := by
    intro b
    have hle : Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M) ≤
        Submodule.comap ((π b : H →L[ℂ] H) : H →ₗ[ℂ] H)
          (Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M)) := by
      refine Submodule.span_le.mpr ?_
      rintro w ⟨x, η, hη, rfl⟩
      obtain ⟨y, hy⟩ := hideal.left b x
      have hbx : π b (σ x η) = σ y η := by
        rw [hσ x, hσ y, ← rep_apply_mul, hy]
      show π b (σ x η) ∈ Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M)
      rw [hbx]
      exact apply_mem_span_imageSet y hη
    intro ζ hζ
    exact hle hζ
  have hN_inv : ∀ b : B,
      ∀ ζ ∈ (Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M)).topologicalClosure,
        π b ζ ∈ (Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M)).topologicalClosure :=
    fun b => mapsTo_topologicalClosure (π b) (hspan_inv b)
  have hN_ne_bot :
      (Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M)).topologicalClosure ≠ ⊥ := by
    intro hbot
    refine hx₁ ?_
    have hmem : σ x₁ ξ ∈
        (Submodule.span ℂ (imageSet (σ : D → (H →L[ℂ] H)) M)).topologicalClosure :=
      Submodule.le_topologicalClosure _ (apply_mem_span_imageSet x₁ hξM)
    rw [hbot] at hmem
    exact (Submodule.mem_bot ℂ).mp hmem
  rcases hπ.2 _ (Submodule.isClosed_topologicalClosure _) hN_inv with h | h
  · exact absurd h hN_ne_bot
  · rw [h] at hN_le
    exact top_le_iff.mp hN_le

/-! ## Permanence through the `c₀`-sum -/

/-- A representation vanishing on every summand is zero.  This is the only
global property of the `c₀`-sum the permanence theorem uses; for the genuine
`c₀`-sum it follows from density of the algebraic sum and contractivity. -/
def IsSummandExhaustive {D : ℕ → Type u} [∀ s, NonUnitalCStarAlgebra (D s)]
    {B : Type u} [NonUnitalCStarAlgebra B] (ι : ∀ s, D s →⋆ₙₐ[ℂ] B) : Prop :=
  ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (π : B →⋆ₙₐ[ℂ] (H →L[ℂ] H)), (∀ (s : ℕ) (x : D s), π (ι s x) = 0) → ∀ b : B, π b = 0

/-- **Type I passes through a countable `c₀`-sum.**  This discharges the
`sum_typeI` clause of the audit's step (A5). -/
theorem isTypeINonUnital_of_summands {D : ℕ → Type u} [∀ s, NonUnitalCStarAlgebra (D s)]
    {B : Type u} [NonUnitalCStarAlgebra B] (ι : ∀ s, D s →⋆ₙₐ[ℂ] B)
    (hideal : ∀ s, IsIdealHom (ι s)) (hexh : IsSummandExhaustive.{u, v} ι)
    (h : ∀ s, IsTypeINonUnital.{u, v} (D s)) :
    IsTypeINonUnital.{u, v} B := by
  intro H _ _ _ π hπ T hT
  obtain ⟨s, x₀, hx₀⟩ : ∃ (s : ℕ) (x : D s), π (ι s x) ≠ 0 := by
    by_contra hcon
    push Not at hcon
    obtain ⟨b, hb⟩ := hπ.1
    exact hb (hexh H π hcon b)
  obtain ⟨σ, hσ⟩ : ∃ σ : D s →⋆ₙₐ[ℂ] (H →L[ℂ] H), ∀ x : D s, σ x = π (ι s x) :=
    ⟨π.comp (ι s), fun _ => rfl⟩
  have hσne : ∃ x : D s, σ x ≠ 0 := ⟨x₀, by rw [hσ x₀]; exact hx₀⟩
  have hσirr : IsIrreducibleNonUnitalRep σ :=
    isIrreducibleNonUnitalRep_restrict (hideal s) hπ hσ hσne
  obtain ⟨x, hx⟩ := h s H σ hσirr T hT
  exact ⟨ι s x, (hσ x).symm.trans hx⟩

end

end STW22
end GroupApproximation
