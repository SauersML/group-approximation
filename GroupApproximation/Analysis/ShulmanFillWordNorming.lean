import GroupApproximation.Analysis.ShulmanFillAdjoinDense
import GroupApproximation.Analysis.ShulmanFillDenseNorming

/-!
# The remaining input of Theorem 16, only on words

`ShulmanFill.CompatibleCoronaDenseNormingStatement` lets the norming input be
checked on any dense set.  `Analysis/ShulmanFillAdjoinDense` supplies the set
and its density: `adjoinSet iA iB`, the elements of the amalgam lying in the
`*`-algebra generated by the two factor images, is dense because the amalgam
is by construction its closure.  Together they cut the input down to *words*:
finite sums of finite products of images of the two factors, and their
adjoints.

`WordNormingStatement` is that cut.  No limit, no dense sequence and no
closure argument survives in it: an element of `adjoinSet iA iB` is a
polynomial expression in the generators, and the statement asks that its norm
be approximated by an evaluation with an MF carrier.

This module is not named in the root import list, but
`Analysis/ShulmanFillConjugatePair` imports it and the root imports that, so it
is in the root closure.  It was authored while builds were suspended and has
not been elaborated since.
-/

namespace GroupApproximation
namespace ShulmanFill

noncomputable section

/-- **The remaining input of Theorem 16, only on words.**  Under the
hypotheses of the printed criterion, every element of the generated
`*`-algebra has its norm approximated by an evaluation with an MF carrier. -/
def WordNormingStatement : Prop :=
  ∀ {C A₁ A₂ : Type} [CStarAlgebra C] [CStarAlgebra A₁]
    [CStarAlgebra A₂] (iA : C →⋆ₐ[ℂ] A₁) (iB : C →⋆ₐ[ℂ] A₂)
    [Nonempty (CStarAmalgamRepresentation iA iB)],
      TopologicalSpace.SeparableSpace C →
      TopologicalSpace.SeparableSpace A₁ →
      TopologicalSpace.SeparableSpace A₂ →
      ∀ (Y : ℕ → FiniteModel) [∀ n, Nonempty (Y n)]
        (phiA : A₁ →⋆ₙₐ[ℂ] NormMatrixCStarCorona (fun n ↦ Y n))
        (phiB : A₂ →⋆ₙₐ[ℂ] NormMatrixCStarCorona (fun n ↦ Y n)),
        Function.Injective phiA → Function.Injective phiB →
          (∀ c : C, phiA (iA c) = phiB (iB c)) →
            ∀ y ∈ adjoinSet iA iB, ∀ δ : ℝ, 0 < δ →
              ∃ R : CStarAmalgamRepresentation iA iB,
                HasMFEmbedding R.carrier ∧
                  ‖y‖ - δ ≤ ‖universalCStarAmalgamEval iA iB R y‖

/-- Words suffice: the dense form of the input follows from the word form. -/
theorem compatibleCoronaDenseNorming_of_wordNorming
    (hword : WordNormingStatement) :
    CompatibleCoronaDenseNormingStatement := by
  intro C A₁ A₂ _ _ _ iA iB _ hC hA₁ hA₂ Y _ phiA phiB hphiA hphiB hcomp
  exact ⟨adjoinSet iA iB, dense_adjoin_universalCStarAmalgam iA iB,
    hword iA iB hC hA₁ hA₂ Y phiA phiB hphiA hphiB hcomp⟩

/-- **Shulman's Theorem 16 from the word form of the input.** -/
theorem shulmanTheorem16_of_wordNorming (hword : WordNormingStatement) :
    Manuscript.MFRecognition.HNNPermanence.ShulmanTheorem16Statement :=
  shulmanTheorem16_of_denseNorming
    (compatibleCoronaDenseNorming_of_wordNorming hword)

end

end ShulmanFill
end GroupApproximation
