import GroupApproximation.Steinberg.ElementaryIndexPadding
import GroupApproximation.Meta.AxiomGuard

/-!
# Identity padding along an index embedding is injective

`non_mf_groups_exist.tex`, proof of Proposition `prop:torsion-defect-ring`
(line 1072):

> Let `S` be the unital subring generated by `s, t`, and let `L = EL₃(S)`
> occupy coordinates `1, 2, 3` of `EL₄(S)`; it has
> property~\textup{(T)}~\cite[Theorem~1.1]{EJZ}.

The printed verb is *occupy*: `L` is a copy of `EL₃(S)` sitting inside
`EL₄(S)`, so the identification has to be faithful.  `ElementaryPadding`
supplies the map `elementaryPad e : EL_ι(R) →* EL_κ(R)` along an index
embedding `e : ι ↪ κ`, but nothing in the tree recorded that it is injective,
which is what makes the printed reading correct.

## The proof

`padHom e M` is `M` in the `e`-block and the identity outside it, transported
by `padEquiv e`.  Reading the `(e i, e j)` entry undoes both steps and returns
`M i j`, so `padHom e` is injective on the nose; the unit-group and
elementary-subgroup versions then follow by `Units.ext` and `Subtype.ext`.

Nothing here is specific to rank three or four, to Leavitt coefficients, or to
the manuscript: the statement is for an arbitrary ring and arbitrary finite
index types.
-/

namespace GroupApproximation
namespace ElementaryPadding

noncomputable section

variable {ι κ R : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
  [Ring R]

/-- **The padded matrix reproduces the original entries on the image of the
embedding.**  The identity block and the transport both disappear. -/
theorem padHom_apply_embed (e : ι ↪ κ) (M : Matrix ι ι R) (i j : ι) :
    padHom e M (e i) (e j) = M i j := by
  have hi : (padEquiv e).symm (e i) = Sum.inl i := by
    rw [Equiv.symm_apply_eq]
    exact (padEquiv_inl e i).symm
  have hj : (padEquiv e).symm (e j) = Sum.inl j := by
    rw [Equiv.symm_apply_eq]
    exact (padEquiv_inl e j).symm
  rw [padHom_apply, Matrix.reindex_apply, Matrix.submatrix_apply, hi, hj]
  simp

/-- **Identity padding is injective on matrices.** -/
theorem padHom_injective (e : ι ↪ κ) :
    Function.Injective (padHom (R := R) e) := by
  intro M N h
  ext i j
  have hentry : padHom e M (e i) (e j) = padHom e N (e i) (e j) := by
    rw [h]
  rwa [padHom_apply_embed, padHom_apply_embed] at hentry

/-- **Identity padding is injective on unit groups.** -/
theorem padUnitHom_injective (e : ι ↪ κ) :
    Function.Injective (padUnitHom (R := R) e) := by
  intro u v h
  have hval : padHom e (u : Matrix ι ι R) = padHom e (v : Matrix ι ι R) := by
    have hcoe := congrArg (fun w : (Matrix κ κ R)ˣ ↦ (w : Matrix κ κ R)) h
    simpa [padUnitHom] using hcoe
  exact Units.ext (padHom_injective e hval)

/-- **`EL_ι(R)` sits inside `EL_κ(R)` as a copy.**  The padding homomorphism of
elementary groups along an index embedding is injective, so the printed phrase
"`EL₃(S)` occupies coordinates `1, 2, 3` of `EL₄(S)`" is faithful. -/
theorem elementaryPad_injective (e : ι ↪ κ) :
    Function.Injective (elementaryPad (R := R) e) := by
  intro g h hgh
  have hval : padUnitHom e (g : (Matrix ι ι R)ˣ) = padUnitHom e (h : (Matrix ι ι R)ˣ) :=
    congrArg Subtype.val hgh
  exact Subtype.ext (padUnitHom_injective e hval)

/-! ### The printed sentence

The property-`(T)` half of the printed sentence is carried by
`Manuscript.NonMFSentences.HeadlineCitationSentences.manuscriptSentence_pairSubringElementaryPropertyT`;
this is the other half, the faithfulness of the occupation. -/

/-- **Printed:** "let `L = EL₃(S)` occupy coordinates `1, 2, 3` of `EL₄(S)`",
for an arbitrary ring and an arbitrary index embedding. -/
def PrintedElementaryPaddingFaithful : Prop :=
  ∀ (ι κ R : Type) [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    [Ring R] (e : ι ↪ κ), Function.Injective (elementaryPad (R := R) e)

/-- Closed proof that the occupation is faithful. -/
theorem manuscriptSentence_elementaryPaddingFaithful :
    PrintedElementaryPaddingFaithful := by
  intro ι κ R _ _ _ _ _ e
  exact elementaryPad_injective e

end

end ElementaryPadding
end GroupApproximation

/-! ### Axiom audit -/

#audit_axioms GroupApproximation.ElementaryPadding.padHom_injective
#audit_axioms GroupApproximation.ElementaryPadding.elementaryPad_injective
#audit_closed_axioms
  GroupApproximation.ElementaryPadding.manuscriptSentence_elementaryPaddingFaithful
