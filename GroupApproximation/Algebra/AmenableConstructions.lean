import GroupApproximation.Algebra.AmenableLocallyFiniteByInt
import Mathlib.GroupTheory.SemidirectProduct

/-!
# Amenability of images and semidirect products

Two more closure properties, both needed to reach the groups the
manuscript actually builds.

Images are easy and were missing: pushing a mean forward along a
surjection is invariant because every element of the target lifts.  With
images available, a cyclic group is amenable without exhibiting an
isomorphism to `ℤ` --- it is a quotient of `ℤ`.

Semidirect products follow from the extension theorem once the two
canonical pieces are identified: the left factor is the kernel of the
right projection, and the quotient by it is the right factor.
-/

namespace GroupApproximation
namespace Amenability

/-! ## Images -/

/-- **Amenability passes to images**, in particular to quotients. -/
theorem hasInvariantMean_of_surjective {G H : Type*} [Group G] [Group H]
    (π : G →* H) (hπ : Function.Surjective π) (h : HasInvariantMean G) :
    HasInvariantMean H := by
  classical
  obtain ⟨m⟩ := h
  refine ⟨{ eval := fun f ↦ m.eval fun x ↦ f (π x)
            eval_add := ?_
            eval_nonneg := ?_
            eval_const := ?_
            eval_invariant := ?_ }⟩
  · intro f g hf hg
    obtain ⟨C, hC⟩ := hf
    obtain ⟨D, hD⟩ := hg
    exact m.eval_add _ _ ⟨C, fun x ↦ hC _⟩ ⟨D, fun x ↦ hD _⟩
  · intro f hf hpos
    obtain ⟨C, hC⟩ := hf
    exact m.eval_nonneg _ ⟨C, fun x ↦ hC _⟩ fun x ↦ hpos _
  · intro c
    exact m.eval_const c
  · intro g f hf
    obtain ⟨C, hC⟩ := hf
    obtain ⟨a, rfl⟩ := hπ g
    have hfun : (fun x ↦ f (π a * π x)) = fun x ↦ (fun y ↦ f (π y)) (a * x) := by
      funext x
      show f (π a * π x) = f (π (a * x))
      rw [map_mul]
    show m.eval (fun x ↦ f (π a * π x)) = m.eval fun x ↦ f (π x)
    rw [hfun]
    exact m.eval_invariant a (fun y ↦ f (π y)) ⟨C, fun x ↦ hC _⟩

/-- A group generated by a single element is amenable: it is an image of
`ℤ`. -/
theorem hasInvariantMean_zpowers {G : Type} [Group G] (g : G) :
    HasInvariantMean (Subgroup.zpowers g) := by
  refine hasInvariantMean_of_surjective
    (G := Multiplicative ℤ) ?_ ?_ hasInvariantMean_int
  · exact (zpowersHom G g).codRestrict (Subgroup.zpowers g)
      fun n ↦ ⟨Multiplicative.toAdd n, rfl⟩
  · rintro ⟨x, n, rfl⟩
    exact ⟨Multiplicative.ofAdd n, Subtype.ext rfl⟩

/-! ## Semidirect products -/

variable {N H : Type*} [Group N] [Group H] {φ : H →* MulAut N}

/-- **Amenability of a semidirect product.** -/
theorem hasInvariantMean_semidirectProduct (hN : HasInvariantMean N)
    (hH : HasInvariantMean H) : HasInvariantMean (N ⋊[φ] H) := by
  classical
  have hsurj : Function.Surjective (SemidirectProduct.rightHom : N ⋊[φ] H →* H) :=
    fun g ↦ ⟨SemidirectProduct.inr g, SemidirectProduct.rightHom_inr g⟩
  haveI : (SemidirectProduct.rightHom : N ⋊[φ] H →* H).ker.Normal :=
    MonoidHom.normal_ker _
  refine hasInvariantMean_of_extension
    (SemidirectProduct.rightHom : N ⋊[φ] H →* H).ker ?_ ?_
  · -- the kernel is the left factor
    refine hasInvariantMean_congr ?_ hN
    refine MulEquiv.subgroupCongr
      (SemidirectProduct.range_inl_eq_ker_rightHom (φ := φ)).symm |>.trans ?_
    exact (MonoidHom.ofInjective
      (SemidirectProduct.inl_injective : Function.Injective
        (SemidirectProduct.inl : N →* N ⋊[φ] H))).symm
  · -- the quotient is the right factor
    exact hasInvariantMean_congr
      (QuotientGroup.quotientKerEquivOfSurjective _ hsurj) hH

end Amenability
end GroupApproximation
