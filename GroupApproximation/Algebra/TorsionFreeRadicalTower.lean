import GroupApproximation.Algebra.TorsionFreeRadical

/-!
# Chiodo's transfinite tower, and its agreement with the radical

Chiodo, arXiv:1107.1489v4, Definition 3.1, builds the torsion-free radical
from below:

    Tor₀(G) = 1,
    Tor_{i+1}(G) = ⟪ { g : g Torᵢ(G) is torsion in G / Torᵢ(G) } ⟫^G,
    Tor_∞(G) = ⋃ᵢ Torᵢ(G),

Lemma 3.2 says `G / Tor_∞(G)` is torsion-free, and Proposition 3.3 says
`Tor_∞(G) = ρ(G)`, the torsion-free radical.  This file is those three
statements.

`Algebra.TorsionFreeRadical` already has `ρ(G)` and everything the rest of
the development uses, obtained from the infimum description in a few lines,
so nothing downstream depends on this file.  It is here because the tower is
Chiodo's own definition and because Proposition 3.3 is what licenses reading
`ρ` as "the subgroup generated by iterated torsion" --- which is how the
literature refers to it, and how one computes with it.

## The step

Chiodo's condition on `g` at stage `i + 1` is that `g Torᵢ(G)` is a torsion
element of `G / Torᵢ(G)`; unfolded, that `g ^ n ∈ Torᵢ(G)` for some `n > 0`.
The unfolded form is what `torsionStep` uses, exactly as
`Algebra.TorsionFreeRadical` uses `IsIsolated` in place of "the quotient is
torsion-free": it avoids the quotient type, and here it also avoids carrying
a `Normal` instance through the recursion just to be able to *state* the next
stage.

## A warning Chiodo records, and this file cannot

One step does not suffice: page 4 of arXiv:1107.1489v4 exhibits
`⟨x, y, z | x², y³, xy = z⁶⟩` with `Tor₁ ≠ Tor_∞`, so the union really is
needed and "quotient by the torsion elements" is not the torsion-free
radical.  That example is not formalized here --- it needs the word problem
for a specific one-relator-plus-torsion presentation --- and no declaration
below asserts the tower stabilizes at any finite stage.  Nothing in this
development uses a finite stage.
-/

namespace GroupApproximation
namespace Chiodo

universe u

variable {G : Type u} [Group G]

/-! ## 1.  The tower -/

/-- **One stage of Chiodo's Definition 3.1.**  The normal closure of the
elements that are torsion modulo `N`. -/
def torsionStep (N : Subgroup G) : Subgroup G :=
  Subgroup.normalClosure {g : G | ∃ n : ℕ, 0 < n ∧ g ^ n ∈ N}

instance torsionStep_normal (N : Subgroup G) : (torsionStep N).Normal := by
  unfold torsionStep
  infer_instance

/-- The stage contains what it is built over: take `n = 1`. -/
theorem le_torsionStep (N : Subgroup G) : N ≤ torsionStep N := by
  intro g hg
  unfold torsionStep
  refine Subgroup.subset_normalClosure ?_
  exact ⟨1, Nat.one_pos, by rwa [pow_one]⟩

/-- The stage is monotone in the subgroup it is built over. -/
theorem torsionStep_mono {N N' : Subgroup G} (h : N ≤ N') :
    torsionStep N ≤ torsionStep N' := by
  unfold torsionStep
  refine Subgroup.normalClosure_mono ?_
  rintro g ⟨n, hn, hpow⟩
  exact ⟨n, hn, h hpow⟩

/-- A normal isolated subgroup absorbs the stage built over any subgroup it
contains.  This is the one inequality Proposition 3.3 needs. -/
theorem torsionStep_le_of_isIsolated {N M : Subgroup G} (hM : M.Normal)
    (hiso : IsIsolated M) (h : N ≤ M) : torsionStep N ≤ M := by
  letI := hM
  unfold torsionStep
  refine Subgroup.normalClosure_le_normal ?_
  rintro g ⟨n, hn, hpow⟩
  exact hiso g n hn (h hpow)

/-- **Chiodo's Definition 3.1**, as a tower indexed by the naturals. -/
def torsionTower (G : Type u) [Group G] : ℕ → Subgroup G
  | 0 => ⊥
  | i + 1 => torsionStep (torsionTower G i)

@[simp] theorem torsionTower_zero : torsionTower G 0 = ⊥ := rfl

@[simp] theorem torsionTower_succ (i : ℕ) :
    torsionTower G (i + 1) = torsionStep (torsionTower G i) := rfl

theorem torsionTower_normal (i : ℕ) : (torsionTower G i).Normal := by
  cases i with
  | zero =>
      rw [torsionTower_zero]
      exact normal_bot
  | succ j =>
      rw [torsionTower_succ]
      exact torsionStep_normal (torsionTower G j)

theorem torsionTower_monotone : Monotone (torsionTower G) := by
  refine monotone_nat_of_le_succ ?_
  intro i
  rw [torsionTower_succ]
  exact le_torsionStep _

/-- **`Tor_∞`**, the union of the tower. -/
def torsionOmega (G : Type u) [Group G] : Subgroup G :=
  ⨆ i : ℕ, torsionTower G i

theorem torsionTower_le_torsionOmega (i : ℕ) :
    torsionTower G i ≤ torsionOmega G := by
  unfold torsionOmega
  exact le_iSup (fun j : ℕ => torsionTower G j) i

/-- The union is a union: membership is witnessed at a finite stage.  This is
where monotonicity of the tower is used. -/
theorem mem_torsionOmega_iff {g : G} :
    g ∈ torsionOmega G ↔ ∃ i : ℕ, g ∈ torsionTower G i := by
  unfold torsionOmega
  exact Subgroup.mem_iSup_of_directed (torsionTower_monotone.directed_le)

instance torsionOmega_normal : (torsionOmega G).Normal := by
  constructor
  intro n hn g
  obtain ⟨i, hi⟩ := mem_torsionOmega_iff.mp hn
  refine mem_torsionOmega_iff.mpr ⟨i, ?_⟩
  exact (torsionTower_normal i).conj_mem n hi g

/-! ## 2.  Lemma 3.2 and Proposition 3.3 -/

/-- **Chiodo's Lemma 3.2.**  `G / Tor_∞(G)` is torsion-free, in the internal
form: `Tor_∞` is isolated.  If `g ^ n` lies at stage `i`, then `g` lies at
stage `i + 1`, and both stages are inside the union. -/
theorem isIsolated_torsionOmega : IsIsolated (torsionOmega G) := by
  intro g n hn hpow
  obtain ⟨i, hi⟩ := mem_torsionOmega_iff.mp hpow
  refine mem_torsionOmega_iff.mpr ⟨i + 1, ?_⟩
  rw [torsionTower_succ]
  unfold torsionStep
  exact Subgroup.subset_normalClosure ⟨n, hn, hi⟩

/-- Lemma 3.2 in quotient form. -/
theorem isPowerTorsionFree_quotient_torsionOmega :
    IsPowerTorsionFree (G ⧸ torsionOmega G) :=
  (isPowerTorsionFree_quotient_iff _).mpr isIsolated_torsionOmega

/-- Every stage of the tower is inside the radical. -/
theorem torsionTower_le_torsionFreeRadical (i : ℕ) :
    torsionTower G i ≤ torsionFreeRadical G := by
  induction i with
  | zero =>
      rw [torsionTower_zero]
      exact bot_le
  | succ j ih =>
      rw [torsionTower_succ]
      exact torsionStep_le_of_isIsolated torsionFreeRadical_normal
        isIsolated_torsionFreeRadical ih

/-- **Chiodo's Proposition 3.3.**  The tower computes the torsion-free
radical.

Both inequalities are one line off the two descriptions: the union is normal
and isolated, so it contains the infimum; and the radical is normal and
isolated, so it absorbs every stage. -/
theorem torsionOmega_eq_torsionFreeRadical :
    torsionOmega G = torsionFreeRadical G := by
  refine le_antisymm ?_ ?_
  · intro g hg
    obtain ⟨i, hi⟩ := mem_torsionOmega_iff.mp hg
    exact torsionTower_le_torsionFreeRadical i hi
  · exact torsionFreeRadical_le torsionOmega_normal isIsolated_torsionOmega

/-- Proposition 3.3, in the direction the literature quotes: the radical is
generated by iterated torsion. -/
theorem torsionFreeRadical_eq_torsionOmega :
    torsionFreeRadical G = torsionOmega G :=
  torsionOmega_eq_torsionFreeRadical.symm

end Chiodo
end GroupApproximation
