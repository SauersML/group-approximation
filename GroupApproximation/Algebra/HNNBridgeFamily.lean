import Mathlib.GroupTheory.FreeGroup.Basic
import Mathlib.Tactic.Common
import Mathlib.Tactic.Group

/-!
# The conjugate family of the Higman--Neumann--Neumann bridge

`Higman.CountableToFG` embeds a countable group `A` in a finitely generated one
by forming `A ∗ F₂`, with `F₂ = ⟨a, b⟩`, and taking an HNN extension that
identifies the family

    uₖ = a^{k+1} · b · a^{-(k+1)}

with the family `gen k · uₖ`.  The stable letter then gives
`gen k = t uₖ t⁻¹ uₖ⁻¹`, so the extension is generated by `a`, `b`, `t`.

This file fixes the family and records the exponent homomorphisms that
separate its blocks.  They are the standard tool for this construction: `bExp`
counts occurrences of `b`, so it detects that each `uₖ` is nontrivial, and
`aExp` counts occurrences of `a`, so it vanishes on the whole family --- which
is the reason the `a`-parts cancel at the junctions of a product of `uₖ`'s and
only the differences `k_{i+1} - kᵢ` survive.  That cancellation is what makes
the family free, and it is why the indices being distinct is exactly the
hypothesis needed.
-/

namespace GroupApproximation
namespace HNNBridgeFamily

/-- The first free generator. -/
def a2 : FreeGroup (Fin 2) := FreeGroup.of 0

/-- The second free generator. -/
def b2 : FreeGroup (Fin 2) := FreeGroup.of 1

/-- The `k`-th member of the conjugate family. -/
def u (k : ℕ) : FreeGroup (Fin 2) := a2 ^ (k + 1) * b2 * (a2 ^ (k + 1))⁻¹

/-- The exponent sum of `a`. -/
def aExp : FreeGroup (Fin 2) →* Multiplicative ℤ :=
  FreeGroup.lift fun i ↦ if i = 0 then Multiplicative.ofAdd (1 : ℤ) else 1

/-- The exponent sum of `b`. -/
def bExp : FreeGroup (Fin 2) →* Multiplicative ℤ :=
  FreeGroup.lift fun i ↦ if i = 1 then Multiplicative.ofAdd (1 : ℤ) else 1

@[simp] theorem aExp_a2 : aExp a2 = Multiplicative.ofAdd (1 : ℤ) := by
  simp [aExp, a2]

@[simp] theorem aExp_b2 : aExp b2 = 1 := by
  simp [aExp, b2]

@[simp] theorem bExp_a2 : bExp a2 = 1 := by
  simp [bExp, a2]

@[simp] theorem bExp_b2 : bExp b2 = Multiplicative.ofAdd (1 : ℤ) := by
  simp [bExp, b2]

/-- Each member of the family carries exactly one `b`. -/
@[simp] theorem bExp_u (k : ℕ) : bExp (u k) = Multiplicative.ofAdd (1 : ℤ) := by
  simp [u]

/-- Each member of the family carries no `a` at all: the conjugating powers
cancel.  This is the invariant that makes the junctions of a product collapse
to `a^{k_{i+1} - kᵢ}`. -/
@[simp] theorem aExp_u (k : ℕ) : aExp (u k) = 1 := by
  simp [u]

/-- **Every member of the family is nontrivial.** -/
theorem u_ne_one (k : ℕ) : u k ≠ 1 := by
  intro h
  have h1 := congrArg bExp h
  have h2 := congrArg (fun z : Multiplicative ℤ ↦ z.toAdd) h1
  simp at h2

/-! ## Infinite order of the generators, and powers of the family

The expansion of a product `u_{k₁}^{n₁} ⋯ u_{k_m}^{n_m}` is

    a^{k₁+1} b^{n₁} a^{k₂-k₁} b^{n₂} ⋯ a^{k_m-k_{m-1}} b^{n_m} a^{-(k_m+1)} ,

and it is reduced exactly because each block is nontrivial: the `b`-blocks
because `nᵢ ≠ 0`, the interior `a`-blocks because `kᵢ ≠ k_{i+1}`, and the two
outer `a`-blocks because `kᵢ + 1 ≠ 0`.  The three lemmas below are those three
facts, and `u_zpow` is the rewriting that produces the expansion. -/

@[simp] theorem aExp_zpow (m : ℤ) :
    aExp (a2 ^ m) = Multiplicative.ofAdd m := by
  rw [map_zpow, aExp_a2, ← ofAdd_zsmul]
  simp

@[simp] theorem bExp_zpow (m : ℤ) :
    bExp (b2 ^ m) = Multiplicative.ofAdd m := by
  rw [map_zpow, bExp_b2, ← ofAdd_zsmul]
  simp

/-- `a` has infinite order. -/
theorem a2_zpow_ne_one {m : ℤ} (hm : m ≠ 0) : a2 ^ m ≠ 1 := by
  intro h
  have h1 := congrArg aExp h
  rw [aExp_zpow, map_one] at h1
  exact hm (congrArg Multiplicative.toAdd h1)

/-- `b` has infinite order. -/
theorem b2_zpow_ne_one {m : ℤ} (hm : m ≠ 0) : b2 ^ m ≠ 1 := by
  intro h
  have h1 := congrArg bExp h
  rw [bExp_zpow, map_one] at h1
  exact hm (congrArg Multiplicative.toAdd h1)

/-- **Powers of a member of the family are conjugates of powers of `b`.**  This
is the rewriting that turns a product of powers of the `uₖ` into an alternating
word in `a` and `b`. -/
theorem u_zpow (k : ℕ) (n : ℤ) :
    u k ^ n = a2 ^ (k + 1) * b2 ^ n * (a2 ^ (k + 1))⁻¹ := by
  unfold u
  induction n using Int.induction_on with
  | zero => simp
  | succ n ih =>
      rw [zpow_add, zpow_one, zpow_add, zpow_one, ih]
      group
  | pred n ih =>
      rw [zpow_sub, zpow_one, zpow_sub, zpow_one, ih]
      group

/-- A power of a member of the family is nontrivial when the exponent is. -/
theorem u_zpow_ne_one (k : ℕ) {n : ℤ} (hn : n ≠ 0) : u k ^ n ≠ 1 := by
  intro h
  have h1 := congrArg bExp h
  rw [u_zpow, map_mul, map_mul, map_inv, map_pow, bExp_a2, one_pow, one_mul,
    inv_one, mul_one, bExp_zpow, map_one] at h1
  exact hn (congrArg Multiplicative.toAdd h1)

/-! ## The junction identity

The computational heart of the freeness argument.  In a product of two members
of the family the conjugating powers meet and collapse:

    a^{-(k+1)} · a^{l+1} = a^{l-k} ,

which is nontrivial exactly when `k ≠ l`.  Everything else in the expansion is
a `b`-block, nontrivial exactly when its exponent is. -/

theorem u_zpow' (k : ℕ) (n : ℤ) :
    u k ^ n = a2 ^ ((k : ℤ) + 1) * b2 ^ n * a2 ^ (-((k : ℤ) + 1)) := by
  rw [u_zpow]
  group

/-- **The junction identity.**  Two consecutive blocks meet in `a^{l-k}`. -/
theorem u_zpow_mul_u_zpow (k l : ℕ) (m n : ℤ) :
    u k ^ m * u l ^ n
      = a2 ^ ((k : ℤ) + 1) * b2 ^ m * a2 ^ ((l : ℤ) - (k : ℤ)) * b2 ^ n
          * a2 ^ (-((l : ℤ) + 1)) := by
  rw [u_zpow', u_zpow']
  group

/-- The junction is nontrivial exactly when the indices differ. -/
theorem junction_ne_one {k l : ℕ} (h : k ≠ l) :
    a2 ^ ((l : ℤ) - (k : ℤ)) ≠ 1 := by
  refine a2_zpow_ne_one ?_
  intro hz
  exact h (by omega)

end HNNBridgeFamily
end GroupApproximation
