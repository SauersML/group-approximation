import GroupApproximation.Algebra.FreeProductCyclicWord
import GroupApproximation.Algebra.WordMetric

/-!
# The word length of a free product over a union alphabet is a sum over syllables

Give each factor `G i` of a free product a symmetric generating set `S i`, and
give `CoprodI G` the alphabet whose letters are the letters of every `S i`,
each in its own factor.  Then

> `|g| = Σ |gₖ|`, the sum of the factor word lengths of the syllables of the
> normal form of `g`.

`wordNorm_eq_syllableNorm` is that statement.  It is the structural fact under
everything metric about a free product spelled in the generating sets of its
factors: distances are sums along syllables, so the Cayley graph is the tree of
the factor Cayley graphs, glued at the syllable boundaries.

## Why it is stated here, and at this generality

Two lanes need it.  Hull's Corollary 7.4 needs the free product `E ∗ H₀` over
the union of the two Hull alphabets — `GGT.HullSC.FreeProductUnionGeometryStatement`
— and Osin's relative small cancellation needs `X ∪ U`, which is this alphabet
with `S i` taken to be the whole factor at the peripheral indices
(`Sofic.OsinWeightedMetric.RelativeLength`, whose `len_source_le_one` says
exactly that).  Stating it over an arbitrary index type and an arbitrary family
of factor alphabets covers both, and the binary free product reaches it through
`Higman.coprodEquiv` together with
`GGT.HullSC.wordNorm_of_mulEquiv`, which carries a word length along an
isomorphism.

## The proof, and what it reuses

`Algebra/FreeProductCyclicWord.lean` already develops the syllable *count*:
`sylLength`, and the computation of what left multiplication by one letter does
to a normal form.  This file is that development weighted — each syllable costs
its factor word length rather than one — and the two halves are:

* `syllableNorm_le_wordNorm`: `syllableNorm` grows by at most `|z|` when a letter
  `z` is multiplied on the left (`syllableNorm_of_mul_le`, the weighted
  `sylLength_of_mul_le`), and a letter of the union alphabet has factor length at
  most one, so a spelling word of length `n` bounds `syllableNorm` by `n`.
* `wordNorm_le_syllableNorm`: spell each syllable by a geodesic word of its own
  factor and concatenate, by induction over the normal form
  (`Monoid.CoprodI.Word.consRecOn`).

Neither half needs any geometry, and the only input from the factors is that
each `S i` is a symmetric generating set.
-/

namespace GroupApproximation
namespace FreeProductUnionNorm

open Monoid Monoid.CoprodI WordMetric FreeProductCyclic

variable {ι : Type*} [DecidableEq ι] {G : ι → Type*} [∀ i, Group (G i)]
  [∀ i, DecidableEq (G i)]

/-! ## The union alphabet -/

/-- **The union alphabet**: the letters of `S i`, each in its own factor. -/
def unionCarrier (S : ∀ i, Set (G i)) : Set (CoprodI G) :=
  {x : CoprodI G | ∃ i, ∃ a ∈ S i, (CoprodI.of a : CoprodI G) = x}

omit [DecidableEq ι] [∀ i, DecidableEq (G i)] in
theorem mem_unionCarrier_of (S : ∀ i, Set (G i)) {i : ι} {a : G i} (ha : a ∈ S i) :
    (CoprodI.of a : CoprodI G) ∈ unionCarrier S :=
  ⟨i, a, ha, rfl⟩

omit [DecidableEq ι] [∀ i, DecidableEq (G i)] in
/-- **The union alphabet is a symmetric generating set.**  Symmetry is symmetry
of each `S i`; generation is that each factor is generated by its own letters,
and that the factors generate the free product. -/
theorem isSymmetricGeneratingSet_unionCarrier {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) :
    IsSymmetricGeneratingSet (unionCarrier S) := by
  constructor
  · rintro _ ⟨i, a, ha, rfl⟩
    refine ⟨i, a⁻¹, (hS i).inv_mem a ha, ?_⟩
    rw [map_inv]
  · rw [eq_top_iff]
    rintro g -
    induction g using CoprodI.induction_on with
    | one => exact one_mem _
    | of i x =>
        have hle : Subgroup.closure (S i) ≤
            (Subgroup.closure (unionCarrier S)).comap
              (CoprodI.of : G i →* CoprodI G) := by
          rw [Subgroup.closure_le]
          intro a ha
          exact Subgroup.subset_closure (mem_unionCarrier_of S ha)
        rw [(hS i).closure_eq] at hle
        exact hle (Subgroup.mem_top x)
    | mul u v hu hv => exact mul_mem hu hv

/-! ## The weighted length of a normal form -/

/-- The weight of a normal form: the sum of the factor word lengths of its
letters. -/
noncomputable def wsum (S : ∀ i, Set (G i)) (w : Word G) : ℕ :=
  (w.toList.map fun l => wordNorm (S l.1) l.2).sum

/-- **The syllable norm**: the weight of the normal form of `g`. -/
noncomputable def syllableNorm (S : ∀ i, Set (G i)) (g : CoprodI G) : ℕ :=
  wsum S (Word.equiv g)

omit [DecidableEq ι] [∀ i, DecidableEq (G i)] in
theorem wsum_empty (S : ∀ i, Set (G i)) : wsum S (Word.empty : Word G) = 0 := by
  simp [wsum, Word.empty]

@[simp] theorem syllableNorm_one (S : ∀ i, Set (G i)) :
    syllableNorm S (1 : CoprodI G) = 0 := by
  simp only [syllableNorm, equiv_one]
  exact wsum_empty S

omit [DecidableEq ι] in
/-- The weight of a `rcons`: the new head costs its factor length, unless it is
trivial and disappears. -/
theorem wsum_rcons (S : ∀ i, Set (G i)) {i : ι} (p : Word.Pair G i) :
    wsum S (Word.rcons p)
      = if p.head = 1 then wsum S p.tail
        else wordNorm (S i) p.head + wsum S p.tail := by
  simp only [wsum]
  rw [toList_rcons]
  by_cases h : p.head = 1 <;> simp [h]

omit [DecidableEq ι] in
/-- The `rcons` bound, in the form that does not case on the head. -/
theorem wsum_rcons_le (S : ∀ i, Set (G i)) {i : ι} (p : Word.Pair G i) :
    wsum S (Word.rcons p) ≤ wordNorm (S i) p.head + wsum S p.tail := by
  rw [wsum_rcons]
  split_ifs <;> omega

/-- **Splitting off the letter at `i`.**  The weight of a word is the factor
length of its head at `i` plus the weight of its tail — with no case split,
because a trivial head has factor length zero. -/
theorem wsum_equivPair_eq (S : ∀ i, Set (G i)) (i : ι) (w : Word G) :
    wsum S w = wordNorm (S i) (Word.equivPair i w).head
      + wsum S (Word.equivPair i w).tail := by
  conv_lhs => rw [← rcons_equivPair i w]
  rw [wsum_rcons]
  split_ifs with h
  · rw [h, wordNorm_one]
    omega
  · rfl

/-- **Left multiplication by one letter costs at most that letter.**  The
weighted form of `FreeProductCyclic.sylLength_of_mul_le`. -/
theorem syllableNorm_of_mul_le {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) {i : ι} (z : G i) (g : CoprodI G) :
    syllableNorm S (CoprodI.of z * g)
      ≤ wordNorm (S i) z + syllableNorm S g := by
  have h1 : wsum S (CoprodI.of z • Word.equiv g)
      ≤ wordNorm (S i) (z * (Word.equivPair i (Word.equiv g)).head)
        + wsum S (Word.equivPair i (Word.equiv g)).tail := by
    rw [Word.of_smul_def]
    exact wsum_rcons_le S _
  have h2 := wordNorm_mul_le (hS i) z (Word.equivPair i (Word.equiv g)).head
  have h3 := wsum_equivPair_eq S i (Word.equiv g)
  simp only [syllableNorm, equiv_of_mul]
  omega

/-! ## The syllable norm is bounded by the word length -/

/-- Every spelling of `g` in the union alphabet is at least as long as the
syllable norm: each letter adds at most its own factor length, which is at most
one. -/
theorem syllableNorm_le_length {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) :
    ∀ (l : List (CoprodI G)) (g : CoprodI G), IsWord (unionCarrier S) l g →
      syllableNorm S g ≤ l.length := by
  intro l
  induction l with
  | nil =>
      intro g hg
      have hg1 : g = 1 := hg.prod_eq.symm.trans List.prod_nil
      rw [hg1, syllableNorm_one]
      exact Nat.zero_le _
  | cons a l ih =>
      intro g hg
      have ha : a ∈ unionCarrier S := hg.letters a (by simp)
      obtain ⟨i, x, hx, rfl⟩ := ha
      have hl : IsWord (unionCarrier S) l l.prod :=
        ⟨fun y hy => hg.letters y (by simp [hy]), rfl⟩
      have hprod : g = CoprodI.of x * l.prod :=
        hg.prod_eq.symm.trans List.prod_cons
      have hih : syllableNorm S l.prod ≤ l.length := ih l.prod hl
      have hstep := syllableNorm_of_mul_le hS x l.prod
      have hone : wordNorm (S i) x ≤ 1 := wordNorm_le_one_of_mem hx
      rw [hprod, List.length_cons]
      omega

theorem syllableNorm_le_wordNorm {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) (g : CoprodI G) :
    syllableNorm S g ≤ wordNorm (unionCarrier S) g := by
  obtain ⟨l, hl, hlen⟩ :=
    exists_isWord_length_eq (isSymmetricGeneratingSet_unionCarrier hS) g
  have h := syllableNorm_le_length hS l g hl
  rw [hlen] at h
  exact h

/-! ## The word length is bounded by the syllable norm -/

omit [DecidableEq ι] [∀ i, DecidableEq (G i)] in
/-- A factor element is spelled in the union alphabet by its own factor word. -/
theorem wordNorm_of_le {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) {i : ι} (x : G i) :
    wordNorm (unionCarrier S) (CoprodI.of x) ≤ wordNorm (S i) x := by
  obtain ⟨l, hl, hlen⟩ := exists_isWord_length_eq (hS i) x
  have hmap : ∀ m : List (G i),
      ((m.map fun a => (CoprodI.of a : CoprodI G)).prod)
        = CoprodI.of m.prod := by
    intro m
    induction m with
    | nil => rw [List.map_nil, List.prod_nil, List.prod_nil, map_one]
    | cons b m ih =>
        rw [List.map_cons, List.prod_cons, List.prod_cons, ih, map_mul]
  have himg : IsWord (unionCarrier S)
      (l.map fun a => (CoprodI.of a : CoprodI G)) (CoprodI.of x) := by
    refine ⟨?_, ?_⟩
    · intro y hy
      obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hy
      exact mem_unionCarrier_of S (hl.letters a ha)
    · rw [hmap l, hl.prod_eq]
  have h := wordNorm_le_length himg
  rw [List.length_map, hlen] at h
  exact h

omit [DecidableEq ι] [∀ i, DecidableEq (G i)] in
/-- **Spelling a normal form syllable by syllable.** -/
theorem wordNorm_prod_le_wsum {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) (w : Word G) :
    wordNorm (unionCarrier S) w.prod ≤ wsum S w := by
  induction w using CoprodI.Word.consRecOn with
  | empty =>
      have h0 : wsum S (Word.empty : Word G) = 0 := wsum_empty S
      have h1 : wordNorm (unionCarrier S) (Word.empty : Word G).prod = 0 := by
        rw [Word.prod_empty, wordNorm_one]
      omega
  | cons i x w hidx hx ih =>
      have hcons : (Word.cons x w hidx hx).toList = ⟨i, x⟩ :: w.toList := rfl
      have h3 : wsum S (Word.cons x w hidx hx) = wordNorm (S i) x + wsum S w := by
        simp only [wsum, hcons, List.map_cons, List.sum_cons]
      have h1 : wordNorm (unionCarrier S) (CoprodI.of x * w.prod)
          ≤ wordNorm (unionCarrier S) (CoprodI.of x)
            + wordNorm (unionCarrier S) w.prod :=
        wordNorm_mul_le (isSymmetricGeneratingSet_unionCarrier hS) _ _
      have h2 := wordNorm_of_le hS x
      rw [Word.prod_cons]
      omega

theorem wordNorm_le_syllableNorm {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) (g : CoprodI G) :
    wordNorm (unionCarrier S) g ≤ syllableNorm S g := by
  have h := wordNorm_prod_le_wsum hS (Word.equiv g)
  rw [prod_equiv g] at h
  exact h

/-! ## The formula -/

/-- **The word length of a free product over a union alphabet is the sum of the
factor word lengths of the syllables.** -/
theorem wordNorm_eq_syllableNorm {S : ∀ i, Set (G i)}
    (hS : ∀ i, IsSymmetricGeneratingSet (S i)) (g : CoprodI G) :
    wordNorm (unionCarrier S) g = syllableNorm S g :=
  le_antisymm (wordNorm_le_syllableNorm hS g) (syllableNorm_le_wordNorm hS g)

end FreeProductUnionNorm
end GroupApproximation
