import Mathlib.Algebra.BigOperators.Fin
import Mathlib.GroupTheory.Perm.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.Tactic.Abel
import Mathlib.Tactic.Ring

/-!
# The `S₃`-coinvariants of the `SL₃` coweight lattice vanish

The coweight lattice of `SL₃` is `L = {v : Fin 3 → ℤ // v 0 + v 1 + v 2 = 0}`,
carrying the Weyl group `S₃ = Equiv.Perm (Fin 3)` by permutation of
coordinates.  This file proves that the subgroup of `L` generated by the
differences `σ • v - v` is all of `L`: the coinvariants `L_{S₃} = L / ⟨σ • v -
v⟩` are trivial.  Equivalently, and this is the form the applications use,
**every `S₃`-invariant additive map out of `L` is identically zero.**

## Why it is true, in one line

`L` is generated by the two roots `α = ε₀ - ε₁` and `β = ε₁ - ε₂`, and each of
those is *itself* a single difference: the transposition `(0 1)` carries
`ε₂ - ε₀` to `ε₂ - ε₁`, and `(ε₂ - ε₁) - (ε₂ - ε₀) = α`; the transposition
`(1 2)` carries `α` to `ε₀ - ε₂`, and `(ε₀ - ε₂) - α = β`.  No `ℤ`-combination
of differences is needed anywhere — both generators are on the nose of the
form `σ • w - w`.  (This is special to rank two and up.  For the coweight
lattice of `SL₂` the same computation only produces `2α`, which is exactly why
the corresponding sector there survives with a sign ambiguity.)

## What is proved

* `span_perm_sub_self_eq_top`: the `ℤ`-span of `{σ • w - w}` inside the lattice
  is `⊤`.
* `eq_zero_of_perm_invariant`: an additive `f : L → A` into any abelian group
  with `f (σ • v) = f v` for all `σ` and `v` vanishes identically.

Everything is over `ℤ`, with no finiteness or torsion hypothesis on the
target `A`.

## Design notes

The lattice is the sum-zero `Submodule ℤ (Fin 3 → ℤ)`, so its module structure
is free; the action is the plain function `permute σ v = v ∘ σ⁻¹` rather than a
`MulAction` instance, since a global `SMul (Equiv.Perm (Fin 3)) (Fin 3 → ℤ)`
would be a new instance visible to the whole development for the sake of two
lemmas.  All vector algebra happens in the ambient `Fin 3 → ℤ` and is
transferred to the subtype once, at the very end.

## Consumers

* `odd-congruence-lambda-exact-sector-collapses` — the Weyl-evaluation step
  that forces the corrector `W` to be exactly `1`.  The three-term relation
  `h′ = h · h″⁻¹` among the coweights is precisely the statement that the
  coinvariants carry no information, so an invariant corrector is trivial.
* `bounded-p-part-sector-reduces-to-twisted-weyl-homs` — the same evaluation on
  the coprime leg, where what survives is an `S₃`-equivariant homomorphism of
  the coweight lattice twisted through a fixed finite gauge; the untwisted part
  is killed here.
-/

namespace GroupApproximation
namespace CoweightCoinvariants

/-! ## The lattice -/

/-- The `SL₃` coweight lattice: the integer vectors of length three whose
coordinates sum to zero. -/
def coweight : Submodule ℤ (Fin 3 → ℤ) where
  carrier := {v | ∑ i, v i = 0}
  add_mem' := by
    intro u w hu hw
    have hu' : ∑ i, u i = 0 := hu
    have hw' : ∑ i, w i = 0 := hw
    show ∑ i, (u i + w i) = 0
    rw [Finset.sum_add_distrib, hu', hw', add_zero]
  zero_mem' := by
    show ∑ _i : Fin 3, (0 : ℤ) = 0
    rw [Finset.sum_const_zero]
  smul_mem' := by
    intro c w hw
    have hw' : ∑ i, w i = 0 := hw
    show ∑ i, c • w i = 0
    rw [← Finset.smul_sum, hw', smul_zero]

/-- Membership in the lattice, in coordinates. -/
theorem sum_eq_zero_of_mem {v : Fin 3 → ℤ} (hv : v ∈ coweight) :
    v 0 + v 1 + v 2 = 0 := by
  have h : ∑ i, v i = 0 := hv
  rwa [Fin.sum_univ_three] at h

/-- The coordinate criterion for membership in the lattice. -/
theorem mem_coweight_of_sum {v : Fin 3 → ℤ} (hv : v 0 + v 1 + v 2 = 0) :
    v ∈ coweight := by
  show ∑ i, v i = 0
  rw [Fin.sum_univ_three]
  exact hv

/-! ## The Weyl action -/

/-- Permutation of the coordinates of an integer vector.  This is the left
action `(σ • v) i = v (σ⁻¹ i)`, kept as a plain function rather than a
`MulAction` instance. -/
def permute (σ : Equiv.Perm (Fin 3)) (v : Fin 3 → ℤ) : Fin 3 → ℤ := fun i ↦ v (σ⁻¹ i)

theorem permute_apply (σ : Equiv.Perm (Fin 3)) (v : Fin 3 → ℤ) (i : Fin 3) :
    permute σ v i = v (σ⁻¹ i) := rfl

theorem permute_sub (σ : Equiv.Perm (Fin 3)) (u w : Fin 3 → ℤ) :
    permute σ (u - w) = permute σ u - permute σ w := by
  funext i
  rfl

/-- Permuting coordinates permutes the standard basis vectors. -/
theorem permute_single (σ : Equiv.Perm (Fin 3)) (i : Fin 3) (c : ℤ) :
    permute σ (Pi.single i c) = Pi.single (σ i) c := by
  funext j
  by_cases h : j = σ i
  · subst h
    rw [permute_apply, Equiv.Perm.inv_apply_self, Pi.single_eq_same, Pi.single_eq_same]
  · have hne : σ⁻¹ j ≠ i := by
      intro hcon
      apply h
      rw [← hcon, Equiv.Perm.apply_inv_self]
    rw [permute_apply, Pi.single_eq_of_ne hne, Pi.single_eq_of_ne h]

/-- Permuting coordinates does not change the coordinate sum, so the lattice is
invariant. -/
theorem permute_mem {σ : Equiv.Perm (Fin 3)} {v : Fin 3 → ℤ} (hv : v ∈ coweight) :
    permute σ v ∈ coweight := by
  have h : ∑ i, v i = 0 := hv
  show ∑ i, permute σ v i = 0
  exact (Fintype.sum_equiv σ⁻¹ (fun i ↦ permute σ v i) v fun _ ↦ rfl).trans h

/-! ## The roots -/

/-- The difference `εᵢ - εⱼ` of two standard basis vectors. -/
def rootVec (i j : Fin 3) : Fin 3 → ℤ := Pi.single i 1 - Pi.single j 1

theorem rootVec_apply_self (i j : Fin 3) (h : i ≠ j) : rootVec i j i = 1 := by
  show Pi.single i (1 : ℤ) i - Pi.single j (1 : ℤ) i = 1
  rw [Pi.single_eq_same, Pi.single_eq_of_ne h, sub_zero]

theorem rootVec_apply_other (i j : Fin 3) (h : j ≠ i) : rootVec i j j = -1 := by
  show Pi.single i (1 : ℤ) j - Pi.single j (1 : ℤ) j = -1
  rw [Pi.single_eq_of_ne h, Pi.single_eq_same, zero_sub]

theorem rootVec_apply_ne (i j k : Fin 3) (hi : k ≠ i) (hj : k ≠ j) :
    rootVec i j k = 0 := by
  show Pi.single i (1 : ℤ) k - Pi.single j (1 : ℤ) k = 0
  rw [Pi.single_eq_of_ne hi, Pi.single_eq_of_ne hj, sub_zero]

theorem permute_rootVec (σ : Equiv.Perm (Fin 3)) (i j : Fin 3) :
    permute σ (rootVec i j) = rootVec (σ i) (σ j) := by
  show permute σ (Pi.single i 1 - Pi.single j 1)
      = Pi.single (σ i) (1 : ℤ) - Pi.single (σ j) (1 : ℤ)
  rw [permute_sub, permute_single, permute_single]

theorem rootVec01_mem : rootVec 0 1 ∈ coweight := by
  refine mem_coweight_of_sum ?_
  rw [rootVec_apply_self 0 1 (by decide), rootVec_apply_other 0 1 (by decide),
    rootVec_apply_ne 0 1 2 (by decide) (by decide)]
  norm_num

theorem rootVec12_mem : rootVec 1 2 ∈ coweight := by
  refine mem_coweight_of_sum ?_
  rw [rootVec_apply_ne 1 2 0 (by decide) (by decide), rootVec_apply_self 1 2 (by decide),
    rootVec_apply_other 1 2 (by decide)]
  norm_num

theorem rootVec20_mem : rootVec 2 0 ∈ coweight := by
  refine mem_coweight_of_sum ?_
  rw [rootVec_apply_other 2 0 (by decide), rootVec_apply_ne 2 0 1 (by decide) (by decide),
    rootVec_apply_self 2 0 (by decide)]
  norm_num

/-! ## Each root is a single difference

The transposition `(0 1)` carries `ε₂ - ε₀` to `ε₂ - ε₁`, and the two differ by
`ε₀ - ε₁`; the transposition `(1 2)` carries `ε₀ - ε₁` to `ε₀ - ε₂`, and the two
differ by `ε₁ - ε₂`. -/

theorem rootVec01_eq_diff :
    rootVec 0 1 = permute (Equiv.swap 0 1) (rootVec 2 0) - rootVec 2 0 := by
  rw [permute_rootVec,
    Equiv.swap_apply_of_ne_of_ne (by decide : (2 : Fin 3) ≠ 0) (by decide : (2 : Fin 3) ≠ 1),
    Equiv.swap_apply_left (0 : Fin 3) 1]
  simp only [rootVec]
  abel

theorem rootVec12_eq_diff :
    rootVec 1 2 = permute (Equiv.swap 1 2) (rootVec 0 1) - rootVec 0 1 := by
  rw [permute_rootVec,
    Equiv.swap_apply_of_ne_of_ne (by decide : (0 : Fin 3) ≠ 1) (by decide : (0 : Fin 3) ≠ 2),
    Equiv.swap_apply_left (1 : Fin 3) 2]
  simp only [rootVec]
  abel

/-! ## The two roots generate -/

theorem fin3_cases : ∀ k : Fin 3, k = 0 ∨ k = 1 ∨ k = 2 := by decide

/-- Every sum-zero vector is the combination of the two simple roots read off
its own coordinates. -/
theorem eq_root_combination {v : Fin 3 → ℤ} (hv : v ∈ coweight) :
    v = v 0 • rootVec 0 1 + (v 0 + v 1) • rootVec 1 2 := by
  have hsum : v 0 + v 1 + v 2 = 0 := sum_eq_zero_of_mem hv
  funext k
  -- `show` rather than `Pi.smul_apply`: a coordinate of `c • w` is `c * w k`
  -- definitionally under either `SMul ℤ` instance that search can return here,
  -- so no rewrite has to commit to one of them.
  rcases fin3_cases k with rfl | rfl | rfl
  · show v 0 = v 0 * rootVec 0 1 0 + (v 0 + v 1) * rootVec 1 2 0
    rw [rootVec_apply_self 0 1 (by decide), rootVec_apply_ne 1 2 0 (by decide) (by decide)]
    ring
  · show v 1 = v 0 * rootVec 0 1 1 + (v 0 + v 1) * rootVec 1 2 1
    rw [rootVec_apply_other 0 1 (by decide), rootVec_apply_self 1 2 (by decide)]
    ring
  · show v 2 = v 0 * rootVec 0 1 2 + (v 0 + v 1) * rootVec 1 2 2
    rw [rootVec_apply_ne 0 1 2 (by decide) (by decide), rootVec_apply_other 1 2 (by decide)]
    omega

/-! ## The lattice, its action, and its roots as a module -/

/-- The Weyl action on the lattice itself. -/
def permAct (σ : Equiv.Perm (Fin 3)) (v : coweight) : coweight :=
  ⟨permute σ (v : Fin 3 → ℤ), permute_mem v.2⟩

/-- The simple root `α = ε₀ - ε₁`, in the lattice. -/
def root01 : coweight := ⟨rootVec 0 1, rootVec01_mem⟩

/-- The simple root `β = ε₁ - ε₂`, in the lattice. -/
def root12 : coweight := ⟨rootVec 1 2, rootVec12_mem⟩

/-- The remaining root `ε₂ - ε₀`, which is what `(0 1)` moves to produce `α`. -/
def root20 : coweight := ⟨rootVec 2 0, rootVec20_mem⟩

theorem root01_eq_diff : root01 = permAct (Equiv.swap 0 1) root20 - root20 := by
  refine Subtype.ext ?_
  show rootVec 0 1 = permute (Equiv.swap 0 1) (rootVec 2 0) - rootVec 2 0
  exact rootVec01_eq_diff

theorem root12_eq_diff : root12 = permAct (Equiv.swap 1 2) root01 - root01 := by
  refine Subtype.ext ?_
  show rootVec 1 2 = permute (Equiv.swap 1 2) (rootVec 0 1) - rootVec 0 1
  exact rootVec12_eq_diff

/-- Every lattice vector is the combination of the two simple roots read off its
own coordinates. -/
theorem eq_root_combination' (v : coweight) :
    v = (v : Fin 3 → ℤ) 0 • root01
      + ((v : Fin 3 → ℤ) 0 + (v : Fin 3 → ℤ) 1) • root12 :=
  Subtype.ext (eq_root_combination v.2)

/-! ## The two statements -/

/-- **The `S₃`-coinvariants of the coweight lattice vanish.**  The `ℤ`-span of
the differences `σ • w - w` is the whole lattice: both simple roots are
themselves differences, and they generate. -/
theorem span_perm_sub_self_eq_top :
    Submodule.span ℤ
        {x : coweight | ∃ (σ : Equiv.Perm (Fin 3)) (w : coweight), x = permAct σ w - w}
      = ⊤ := by
  refine eq_top_iff.mpr ?_
  intro v _
  rw [eq_root_combination' v]
  refine Submodule.add_mem _ (Submodule.smul_mem _ _ ?_) (Submodule.smul_mem _ _ ?_)
  · exact Submodule.subset_span ⟨Equiv.swap 0 1, root20, root01_eq_diff⟩
  · exact Submodule.subset_span ⟨Equiv.swap 1 2, root01, root12_eq_diff⟩

/-- **An `S₃`-invariant additive map out of the coweight lattice is zero.**
This is the form the Weyl-evaluation step of the two consuming routes uses: a
corrector that is constant on Weyl orbits has nothing left to be. -/
theorem eq_zero_of_perm_invariant {A : Type*} [AddCommGroup A] (f : coweight →+ A)
    (hf : ∀ (σ : Equiv.Perm (Fin 3)) (v : coweight), f (permAct σ v) = f v)
    (v : coweight) : f v = 0 := by
  -- Stated at the ambient `•` and discharged by `map_zsmul` up to defeq, so the
  -- rewrite below matches whichever `SMul ℤ` instance the statement elaborated.
  have hsmul : ∀ (c : ℤ) (x : coweight), f (c • x) = c • f x := fun c x ↦ map_zsmul f c x
  have h01 : f root01 = 0 := by
    rw [root01_eq_diff, map_sub, hf]
    exact sub_self _
  have h12 : f root12 = 0 := by
    rw [root12_eq_diff, map_sub, hf]
    exact sub_self _
  rw [eq_root_combination' v, map_add, hsmul, hsmul, h01, h12]
  simp

end CoweightCoinvariants
end GroupApproximation
