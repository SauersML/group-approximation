import Mathlib.GroupTheory.HNNExtension
import Mathlib.GroupTheory.FinitelyPresentedGroup

/-!
# An HNN extension of a finitely presented group is finitely presented

Provided the associated subgroups are finitely generated.  Mathlib has neither
this statement nor any part of it, and it is the one genuinely missing
ingredient of item **S8** of the Novikov--Boone roadmap in
`GroupApproximation.Computability.BooneGroupBase`: the final group of the tower
cannot be called *finitely presented* without it.  Nothing here is specific to
that tower.

## Why it is short

Because Mathlib defines `HNNExtension G A B φ` as a quotient of the free
product `G ∗ Multiplicative ℤ` --- `HNNExtension.con` is the congruence
generated by the pairs `(t · a, φ a · t)` for `a : A` --- and closes
`Group.IsFinitelyPresented` under free products and under quotients by
finitely normally generated subgroups.  So the whole content is that the
*infinite* relation family `{ t a t⁻¹ (φ a)⁻¹ : a ∈ A }` may be replaced by the
finitely many relators coming from a generating set of `A`.

That replacement is the one place finite generation of `A` is used, and it is
an equalizer argument rather than a computation: `a ↦ x · f a · x⁻¹` and
`a ↦ f (φ a)` are both homomorphisms `A →* Q`, so the set where they agree is a
subgroup, and a homomorphism pair agreeing on a generating set agrees
everywhere (`MonoidHom.eq_of_eqOn_dense`).

The rest is bookkeeping: the canonical map `G ∗ ℤ →* HNNExtension G A B φ`
kills the relators, so it factors through the finitely presented quotient, and
`HNNExtension.lift` supplies the inverse.
-/

namespace GroupApproximation
namespace HNNFinitePresentation

open Monoid

variable {G : Type} [Group G] {A B : Subgroup G} (φ : A ≃* B)

/-! ## The ambient free product, and the finitely many relators -/

/-- The free product `G ∗ ℤ`, of which the HNN extension is a quotient. -/
abbrev Amb (G : Type) [Group G] : Type := Coprod G (Multiplicative ℤ)

/-- The stable letter, before any relation is imposed. -/
def tAmb : Amb G := Coprod.inr (Multiplicative.ofAdd 1)

/-- The relator attached to `a : A`, namely `t · a · (φ a · t)⁻¹`.  The
congruence defining the HNN extension is generated by exactly these, one for
every `a`; the point of this file is that a generating set of `A` suffices. -/
def relator (a : A) : Amb G :=
  tAmb * Coprod.inl (a : G) * (Coprod.inl (φ a : G) * tAmb)⁻¹

/-- The relators coming from a set of elements of `A`. -/
def relators (S : Set A) : Set (Amb G) := relator φ '' S

theorem relators_finite {S : Set A} (hS : S.Finite) : (relators φ S).Finite :=
  hS.image _

/-! ## The canonical map onto the HNN extension -/

/-- `G ∗ ℤ →* HNNExtension G A B φ`, sending the free factor by `of` and the
generator of `ℤ` to the stable letter. -/
def toHNN : Amb G →* HNNExtension G A B φ :=
  Coprod.lift HNNExtension.of (zpowersHom (HNNExtension G A B φ) HNNExtension.t)

@[simp] theorem toHNN_inl (g : G) : toHNN φ (Coprod.inl g) = HNNExtension.of g :=
  Coprod.lift_apply_inl _ _ _

@[simp] theorem toHNN_inr (n : Multiplicative ℤ) :
    toHNN φ (Coprod.inr n) = HNNExtension.t ^ (Multiplicative.toAdd n) :=
  Coprod.lift_apply_inr _ _ _

@[simp] theorem toHNN_tAmb : toHNN φ (tAmb : Amb G) = HNNExtension.t := by
  simp [tAmb]

/-- Every relator dies in the HNN extension: that is the defining relation
`t · a = φ a · t`. -/
theorem toHNN_relator (a : A) : toHNN φ (relator φ a) = 1 := by
  have h := HNNExtension.t_mul_of (φ := φ) a
  simp only [relator, map_mul, map_inv, toHNN_inl, toHNN_tAmb]
  rw [h, mul_inv_cancel]

theorem normalClosure_relators_le_ker (S : Set A) :
    Subgroup.normalClosure (relators φ S) ≤ (toHNN φ).ker := by
  refine Subgroup.normalClosure_le_normal ?_
  rintro _ ⟨a, -, rfl⟩
  exact toHNN_relator φ a

/-! ## The quotient by the finitely many relators -/

section Quotient

variable (S : Set A)

/-- The normal closure of the relators of `S` inside `G ∗ ℤ`. -/
abbrev Rel : Subgroup (Amb G) := Subgroup.normalClosure (relators φ S)

/-- The candidate presentation of the HNN extension: `G ∗ ℤ` modulo the
finitely many relators. -/
abbrev Q : Type := Amb G ⧸ Rel φ S

/-- The image of the free factor in the quotient. -/
def qOf : G →* Q φ S := (QuotientGroup.mk' (Rel φ S)).comp Coprod.inl

/-- The image of the stable letter in the quotient. -/
def qT : Q φ S := QuotientGroup.mk' (Rel φ S) tAmb

variable {S}

/-- The defining relation, in the quotient, for a generator of `A`. -/
theorem relation_of_mem {a : A} (ha : a ∈ S) :
    qT φ S * qOf φ S (a : G) = qOf φ S (φ a : G) * qT φ S := by
  have hmem : relator φ a ∈ Rel φ S := Subgroup.subset_normalClosure ⟨a, ha, rfl⟩
  have h1 : QuotientGroup.mk' (Rel φ S) (relator φ a) = 1 :=
    (QuotientGroup.eq_one_iff _).2 hmem
  simp only [relator, map_mul, map_inv] at h1
  exact mul_inv_eq_one.mp h1

/-- Conjugation by the stable letter, as a homomorphism out of `A`. -/
def conjHom : A →* Q φ S :=
  ((MulAut.conj (qT φ S)).toMonoidHom).comp ((qOf φ S).comp A.subtype)

/-- The other side of the defining relation, as a homomorphism out of `A`. -/
def phiHom : A →* Q φ S :=
  (qOf φ S).comp (B.subtype.comp (φ : A →* B))

@[simp] theorem conjHom_apply (a : A) :
    conjHom φ (S := S) a = qT φ S * qOf φ S (a : G) * (qT φ S)⁻¹ := rfl

@[simp] theorem phiHom_apply (a : A) :
    phiHom φ (S := S) a = qOf φ S (φ a : G) := rfl

theorem conjHom_eq_phiHom_of_mem {a : A} (ha : a ∈ S) :
    conjHom φ (S := S) a = phiHom φ (S := S) a := by
  rw [conjHom_apply, phiHom_apply, relation_of_mem φ ha, mul_inv_cancel_right]

/-- **Where finite generation of `A` is used.**  Two homomorphisms agreeing on
a generating set agree everywhere, so the relations imposed for `S` already
impose the relation for every element of `A`. -/
theorem conjHom_eq_phiHom (hS : Subgroup.closure S = ⊤) :
    conjHom φ (S := S) = phiHom φ (S := S) :=
  MonoidHom.eq_of_eqOn_dense hS fun _ ha => conjHom_eq_phiHom_of_mem φ ha

theorem lift_relation (hS : Subgroup.closure S = ⊤) (a : A) :
    qT φ S * qOf φ S (a : G) = qOf φ S (φ a : G) * qT φ S := by
  have h := congrArg (fun f : A →* Q φ S => f a) (conjHom_eq_phiHom φ hS)
  rw [conjHom_apply, phiHom_apply] at h
  rw [← h, inv_mul_cancel_right]

/-- The inverse map, out of the HNN extension. -/
def fromHNN (hS : Subgroup.closure S = ⊤) : HNNExtension G A B φ →* Q φ S :=
  HNNExtension.lift (qOf φ S) (qT φ S) (lift_relation φ hS)

@[simp] theorem fromHNN_of (hS : Subgroup.closure S = ⊤) (g : G) :
    fromHNN φ hS (HNNExtension.of g) = qOf φ S g :=
  HNNExtension.lift_of _ _ _ _

@[simp] theorem fromHNN_t (hS : Subgroup.closure S = ⊤) :
    fromHNN φ hS (HNNExtension.t) = qT φ S :=
  HNNExtension.lift_t _ _ _

/-- The quotient map, factored through the relators. -/
def toHNN' : Q φ S →* HNNExtension G A B φ :=
  QuotientGroup.lift _ (toHNN φ) (normalClosure_relators_le_ker φ S)

@[simp] theorem toHNN'_mk (x : Amb G) :
    toHNN' φ (S := S) (QuotientGroup.mk' (Rel φ S) x) = toHNN φ x := rfl

theorem toHNN'_comp_fromHNN (hS : Subgroup.closure S = ⊤) :
    (toHNN' φ (S := S)).comp (fromHNN φ hS) = MonoidHom.id _ := by
  refine HNNExtension.hom_ext ?_ ?_
  · ext g
    show toHNN' φ (S := S) (fromHNN φ hS (HNNExtension.of g)) = HNNExtension.of g
    rw [fromHNN_of]
    exact toHNN_inl φ g
  · show toHNN' φ (S := S) (fromHNN φ hS HNNExtension.t) = HNNExtension.t
    rw [fromHNN_t]
    exact toHNN_tAmb φ

theorem fromHNN_comp_toHNN' (hS : Subgroup.closure S = ⊤) :
    (fromHNN φ hS).comp (toHNN' φ (S := S)) = MonoidHom.id _ := by
  have key : ((fromHNN φ hS).comp (toHNN' φ (S := S))).comp
      (QuotientGroup.mk' (Rel φ S))
      = (MonoidHom.id (Q φ S)).comp (QuotientGroup.mk' (Rel φ S)) := by
    refine Coprod.hom_ext ?_ ?_
    · ext g
      show fromHNN φ hS (toHNN φ (Coprod.inl g)) = QuotientGroup.mk' (Rel φ S) (Coprod.inl g)
      rw [toHNN_inl, fromHNN_of]
      rfl
    · -- only the generator of `ℤ` has to be checked
      refine MonoidHom.ext_mint ?_
      show fromHNN φ hS (toHNN φ (tAmb : Amb G)) = QuotientGroup.mk' (Rel φ S) tAmb
      rw [toHNN_tAmb, fromHNN_t]
      rfl
  refine MonoidHom.ext fun q => ?_
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (Rel φ S) q
  exact congrArg (fun f : Amb G →* Q φ S => f x) key

/-- The candidate presentation really does present the HNN extension. -/
def quotientEquiv (hS : Subgroup.closure S = ⊤) :
    Q φ S ≃* HNNExtension G A B φ where
  toFun := toHNN' φ
  invFun := fromHNN φ hS
  left_inv q := congrArg (fun f : Q φ S →* Q φ S => f q) (fromHNN_comp_toHNN' φ hS)
  right_inv x :=
    congrArg (fun f : HNNExtension G A B φ →* HNNExtension G A B φ => f x)
      (toHNN'_comp_fromHNN φ hS)
  map_mul' := map_mul _

end Quotient

/-! ## The permanence theorem -/

/-- **An HNN extension of a finitely presented group along finitely generated
associated subgroups is finitely presented.**  Not in Mathlib in any form, and
the missing ingredient of S8. -/
theorem isFinitelyPresented_hnnExtension
    [Group.IsFinitelyPresented G] [Group.FG A] :
    Group.IsFinitelyPresented (HNNExtension G A B φ) := by
  obtain ⟨S, hclosure, hfinite⟩ := Group.fg_iff.mp (inferInstance : Group.FG A)
  haveI : Group.IsFinitelyPresented (Q φ S) :=
    Group.IsFinitelyPresented.quotient (Rel φ S)
      ⟨relators φ S, relators_finite φ hfinite, rfl⟩
  exact Group.IsFinitelyPresented.equiv (quotientEquiv φ hclosure)

end HNNFinitePresentation
end GroupApproximation
