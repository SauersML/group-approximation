import Mathlib.GroupTheory.HNNExtension
import Mathlib.GroupTheory.PresentedGroup
import Mathlib.Tactic.Group

/-!
# An HNN extension of a presented group is presented

Adjoining a stable letter `s` to `⟨X | R⟩`, conjugating a subgroup generated by
words `w i` onto one generated by words `v i`, gives

    `⟨X, s | R, s (w i) s⁻¹ = v i⟩`.

Mathlib has HNN extensions and presented groups but no statement relating them.

`Algebra.HNNFinitePresentation` proves the *abstract* closure property --- that
`Group.IsFinitelyPresented` survives an HNN extension along a finitely generated
subgroup --- by realising the extension as a quotient of `G * ℤ`.  That is what
S8 consumes.  This file proves the *word-level* statement instead: the extension
is the presented group on an explicit generating set with explicit relators.
The two are not interchangeable.  Finite presentability is a property; a
presentation code, which an effective Adian--Rabin construction has to compute
with, is data, and it is the relators below that give it.

The forward map is `PresentedGroup.toGroup`: only the relators have to be
checked, and the new ones are exactly `HNNExtension.equiv_eq_conj` at the
generators.  The backward map is `HNNExtension.lift`, and its side condition is
the one real step: `lift` demands the conjugation identity for **every** element
of the associated subgroup, while the presentation only supplies it for the
generators.  Both sides of that identity are homomorphisms on the subgroup, so
`Subgroup.closure_induction` extends it --- that is `conj_eq_of_mem` below.
-/

namespace GroupApproximation
namespace HNNPresentation

variable {X I : Type}

/-- The old generators, inside the free group with the stable letter adjoined. -/
def emb : FreeGroup X →* FreeGroup (Option X) := FreeGroup.map some

/-- The stable letter, as a word. -/
def stableWord : FreeGroup (Option X) := FreeGroup.of none

@[simp] theorem emb_of (x : X) : (emb (FreeGroup.of x) : FreeGroup (Option X))
    = FreeGroup.of (some x) := FreeGroup.map.of

/-- Lifting a composite: `FreeGroup.lift` of `F ∘ f` is `F` after `lift f`. -/
theorem lift_comp {α : Type} {H K : Type} [Group H] [Group K] (f : α → H) (F : H →* K) :
    (FreeGroup.lift fun a => F (f a)) = F.comp (FreeGroup.lift f) :=
  FreeGroup.ext_hom _ _ fun a => by simp

/-- Lifting after `emb` is lifting the composite. -/
theorem lift_emb {H : Type} [Group H] (f : Option X → H) :
    (FreeGroup.lift f).comp emb = FreeGroup.lift fun x => f (some x) :=
  FreeGroup.ext_hom _ _ fun a => by simp [emb]

/-- `PresentedGroup.mk` is the lift of `PresentedGroup.of`. -/
theorem lift_of_eq_mk (rels : Set (FreeGroup X)) :
    (FreeGroup.lift fun x => (PresentedGroup.of x : PresentedGroup rels))
      = PresentedGroup.mk rels :=
  FreeGroup.ext_hom _ _ fun a => by simp [PresentedGroup.of]

variable (rels : Set (FreeGroup X)) (w v : I → FreeGroup X)

/-- **The relators of the extended presentation**: the old ones, and one
conjugation relator for each generator of the associated subgroup. -/
def hnnRels : Set (FreeGroup (Option X)) :=
  (fun r => emb r) '' rels ∪
    Set.range fun i =>
      stableWord * emb (w i) * stableWord⁻¹ * (emb (v i))⁻¹

/-- The `i`-th generator of the source subgroup. -/
def srcGen (i : I) : PresentedGroup rels := PresentedGroup.mk rels (w i)

/-- The `i`-th generator of the target subgroup. -/
def tgtGen (i : I) : PresentedGroup rels := PresentedGroup.mk rels (v i)

/-- The source subgroup. -/
def srcSub : Subgroup (PresentedGroup rels) := Subgroup.closure (Set.range (srcGen rels w))

/-- The target subgroup. -/
def tgtSub : Subgroup (PresentedGroup rels) := Subgroup.closure (Set.range (tgtGen rels v))

theorem srcGen_mem (i : I) : srcGen rels w i ∈ srcSub rels w :=
  Subgroup.subset_closure ⟨i, rfl⟩

theorem tgtGen_mem (i : I) : tgtGen rels v i ∈ tgtSub rels v :=
  Subgroup.subset_closure ⟨i, rfl⟩

variable (φ : srcSub rels w ≃* tgtSub rels v)

/-- The extension being presented. -/
abbrev Ext : Type := HNNExtension (PresentedGroup rels) (srcSub rels w) (tgtSub rels v) φ

/-- The presented group being compared to it. -/
abbrev Pres : Type := PresentedGroup (hnnRels rels w v)

/-! ## The conjugation identity, off the generators

`HNNExtension.lift` wants `s · f a = f (φ a) · s` for every `a` in the source
subgroup.  Both sides are homomorphisms in `a`, so it is enough to have it on a
generating set --- which is what the new relators give. -/

theorem conj_eq_of_mem {H : Type} [Group H] (f : PresentedGroup rels →* H) (s : H)
    (hφ : ∀ i, ((φ ⟨srcGen rels w i, srcGen_mem rels w i⟩ : tgtSub rels v)
        : PresentedGroup rels) = tgtGen rels v i)
    (hgen : ∀ i, s * f (srcGen rels w i) = f (tgtGen rels v i) * s) :
    ∀ a : srcSub rels w, s * f (a : PresentedGroup rels)
      = f ((φ a : tgtSub rels v) : PresentedGroup rels) * s := by
  rintro ⟨a, ha⟩
  induction ha using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      rw [hφ i]
      exact hgen i
  | one =>
      have h1 : ((φ ⟨1, Subgroup.one_mem _⟩ : tgtSub rels v) : PresentedGroup rels) = 1 := by
        have h : (φ ⟨1, Subgroup.one_mem _⟩ : tgtSub rels v) = 1 := by
          rw [show (⟨1, Subgroup.one_mem _⟩ : srcSub rels w) = 1 from rfl, map_one]
        rw [h]
        rfl
      rw [h1]
      show s * f 1 = f 1 * s
      simp
  | mul x y hx hy ihx ihy =>
      have ihx' : s * f x = f ((φ ⟨x, hx⟩ : tgtSub rels v) : PresentedGroup rels) * s := ihx
      have ihy' : s * f y = f ((φ ⟨y, hy⟩ : tgtSub rels v) : PresentedGroup rels) * s := ihy
      have hmul : (φ ⟨x * y, Subgroup.mul_mem _ hx hy⟩ : tgtSub rels v)
          = φ ⟨x, hx⟩ * φ ⟨y, hy⟩ := by
        rw [← map_mul]
        exact congrArg φ (Subtype.ext rfl)
      rw [hmul]
      show s * f (x * y)
        = f (((φ ⟨x, hx⟩ : tgtSub rels v) : PresentedGroup rels) *
            ((φ ⟨y, hy⟩ : tgtSub rels v) : PresentedGroup rels)) * s
      rw [map_mul, map_mul, ← mul_assoc, ihx', mul_assoc, ihy', mul_assoc]
  | inv x hx ihx =>
      have ihx' : s * f x = f ((φ ⟨x, hx⟩ : tgtSub rels v) : PresentedGroup rels) * s := ihx
      have key : (f ((φ ⟨x, hx⟩ : tgtSub rels v) : PresentedGroup rels))⁻¹ * s
          = s * (f x)⁻¹ := by
        rw [inv_mul_eq_iff_eq_mul, ← mul_assoc, ← ihx', mul_assoc, mul_inv_cancel, mul_one]
      have hinv : (φ ⟨x⁻¹, Subgroup.inv_mem _ hx⟩ : tgtSub rels v) = (φ ⟨x, hx⟩)⁻¹ := by
        rw [← map_inv]
        exact congrArg φ (Subtype.ext rfl)
      rw [hinv]
      show s * f x⁻¹
        = f ((((φ ⟨x, hx⟩ : tgtSub rels v))⁻¹ : tgtSub rels v) : PresentedGroup rels) * s
      rw [Subgroup.coe_inv, map_inv, map_inv]
      exact key.symm

/-! ## The two maps -/

variable (hφ : ∀ i, ((φ ⟨srcGen rels w i, srcGen_mem rels w i⟩ : tgtSub rels v)
    : PresentedGroup rels) = tgtGen rels v i)

/-- Where the extended presentation's generators go in the extension. -/
def fwdGen : Option X → Ext rels w v φ
  | none => HNNExtension.t
  | some x => HNNExtension.of (PresentedGroup.of x)

theorem lift_fwdGen_emb (r : FreeGroup X) :
    FreeGroup.lift (fwdGen rels w v φ) (emb r)
      = HNNExtension.of (PresentedGroup.mk rels r) := by
  rw [← MonoidHom.comp_apply, lift_emb]
  show FreeGroup.lift (fun x => HNNExtension.of (PresentedGroup.of x)) r = _
  rw [lift_comp, MonoidHom.comp_apply, lift_of_eq_mk]

include hφ in
theorem fwd_rels : ∀ r ∈ hnnRels rels w v, FreeGroup.lift (fwdGen rels w v φ) r = 1 := by
  rintro r (⟨r₀, hr₀, rfl⟩ | ⟨i, rfl⟩)
  · rw [lift_fwdGen_emb,
      PresentedGroup.mk_eq_one_iff.2 (Subgroup.subset_normalClosure hr₀), map_one]
  · have hc : (HNNExtension.of (tgtGen rels v i) : Ext rels w v φ)
        = HNNExtension.t * HNNExtension.of (srcGen rels w i) * HNNExtension.t⁻¹ := by
      have h := HNNExtension.equiv_eq_conj (φ := φ) ⟨srcGen rels w i, srcGen_mem rels w i⟩
      rw [hφ i] at h
      exact h
    show FreeGroup.lift (fwdGen rels w v φ)
        (stableWord * emb (w i) * stableWord⁻¹ * (emb (v i))⁻¹) = 1
    simp only [map_mul, map_inv, lift_fwdGen_emb]
    show HNNExtension.t * HNNExtension.of (srcGen rels w i) * HNNExtension.t⁻¹ *
        (HNNExtension.of (tgtGen rels v i))⁻¹ = 1
    rw [hc]
    group

/-- **The forward map.** -/
def fwd : Pres rels w v →* Ext rels w v φ :=
  PresentedGroup.toGroup (fwd_rels rels w v φ hφ)

/-- Where the extension's base group goes in the presentation. -/
def bwdBase : PresentedGroup rels →* Pres rels w v :=
  PresentedGroup.toGroup (f := fun x => PresentedGroup.of (some x)) (by
    intro r hr
    show FreeGroup.lift (fun x : X => (PresentedGroup.of (some x) : Pres rels w v)) r = 1
    have h : (FreeGroup.lift fun x : X => (PresentedGroup.of (some x) : Pres rels w v))
        = (PresentedGroup.mk (hnnRels rels w v)).comp emb := by
      refine FreeGroup.ext_hom _ _ fun x => ?_
      simp [PresentedGroup.of]
    rw [h, MonoidHom.comp_apply]
    exact PresentedGroup.mk_eq_one_iff.2
      (Subgroup.subset_normalClosure (Or.inl ⟨r, hr, rfl⟩)))

theorem bwdBase_mk (r : FreeGroup X) :
    bwdBase rels w v (PresentedGroup.mk rels r)
      = PresentedGroup.mk (hnnRels rels w v) (emb r) := by
  have h : (bwdBase rels w v).comp (PresentedGroup.mk rels)
      = (PresentedGroup.mk (hnnRels rels w v)).comp emb := by
    refine FreeGroup.ext_hom _ _ fun x => ?_
    show bwdBase rels w v (PresentedGroup.of x) = _
    rw [bwdBase, PresentedGroup.toGroup.of]
    simp [PresentedGroup.of]
  exact DFunLike.congr_fun h r

theorem bwd_hgen (i : I) :
    (PresentedGroup.of none : Pres rels w v) * bwdBase rels w v (srcGen rels w i)
      = bwdBase rels w v (tgtGen rels v i) * (PresentedGroup.of none : Pres rels w v) := by
  have hrel : (PresentedGroup.mk (hnnRels rels w v)
      (stableWord * emb (w i) * stableWord⁻¹ * (emb (v i))⁻¹) : Pres rels w v) = 1 :=
    PresentedGroup.mk_eq_one_iff.2 (Subgroup.subset_normalClosure (Or.inr ⟨i, rfl⟩))
  simp only [map_mul, map_inv] at hrel
  have hs : (PresentedGroup.mk (hnnRels rels w v) stableWord : Pres rels w v)
      = PresentedGroup.of none := rfl
  rw [hs] at hrel
  rw [srcGen, tgtGen, bwdBase_mk, bwdBase_mk]
  have := mul_inv_eq_one.1 hrel
  rw [← this]
  group

include hφ in
/-- **The backward map.** -/
def bwd : Ext rels w v φ →* Pres rels w v :=
  HNNExtension.lift (bwdBase rels w v) (PresentedGroup.of none)
    (conj_eq_of_mem rels w v φ (bwdBase rels w v) (PresentedGroup.of none) hφ
      (bwd_hgen rels w v))

/-! ## They are mutually inverse -/

include hφ in
theorem bwd_fwd : (bwd rels w v φ hφ).comp (fwd rels w v φ hφ) = MonoidHom.id _ := by
  refine PresentedGroup.ext fun x => ?_
  cases x with
  | none =>
      show bwd rels w v φ hφ (fwd rels w v φ hφ (PresentedGroup.of none))
        = PresentedGroup.of none
      rw [fwd, PresentedGroup.toGroup.of]
      show bwd rels w v φ hφ HNNExtension.t = _
      rw [bwd, HNNExtension.lift_t]
  | some y =>
      show bwd rels w v φ hφ (fwd rels w v φ hφ (PresentedGroup.of (some y)))
        = PresentedGroup.of (some y)
      rw [fwd, PresentedGroup.toGroup.of]
      show bwd rels w v φ hφ (HNNExtension.of (PresentedGroup.of y)) = _
      rw [bwd, HNNExtension.lift_of, bwdBase, PresentedGroup.toGroup.of]

include hφ in
theorem fwd_bwd : (fwd rels w v φ hφ).comp (bwd rels w v φ hφ) = MonoidHom.id _ := by
  refine HNNExtension.hom_ext ?_ ?_
  · refine MonoidHom.ext fun g => ?_
    show fwd rels w v φ hφ (bwd rels w v φ hφ (HNNExtension.of g)) = HNNExtension.of g
    rw [bwd, HNNExtension.lift_of]
    induction g using PresentedGroup.induction_on with
    | _ r =>
        rw [bwdBase_mk]
        show fwd rels w v φ hφ (PresentedGroup.mk (hnnRels rels w v) (emb r)) = _
        have h : (fwd rels w v φ hφ).comp (PresentedGroup.mk (hnnRels rels w v))
            = FreeGroup.lift (fwdGen rels w v φ) := by
          refine FreeGroup.ext_hom _ _ fun x => ?_
          show fwd rels w v φ hφ (PresentedGroup.of x) = _
          rw [fwd, PresentedGroup.toGroup.of]
          simp
        rw [← MonoidHom.comp_apply, h, lift_fwdGen_emb]
  · show fwd rels w v φ hφ (bwd rels w v φ hφ HNNExtension.t) = HNNExtension.t
    rw [bwd, HNNExtension.lift_t, fwd, PresentedGroup.toGroup.of]
    rfl

include hφ in
/-- **An HNN extension of a presented group is presented.**  Adjoining a stable
letter conjugating `⟨w i⟩` onto `⟨v i⟩` is adjoining a generator and the
relators `s (w i) s⁻¹ = v i`. -/
def equivPres : Pres rels w v ≃* Ext rels w v φ where
  toFun := fwd rels w v φ hφ
  invFun := bwd rels w v φ hφ
  left_inv x := congrArg (fun F : Pres rels w v →* Pres rels w v => F x) (bwd_fwd rels w v φ hφ)
  right_inv g :=
    congrArg (fun F : Ext rels w v φ →* Ext rels w v φ => F g) (fwd_bwd rels w v φ hφ)
  map_mul' := map_mul _

end HNNPresentation
end GroupApproximation
