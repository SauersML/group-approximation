import Mathlib.GroupTheory.CoprodI
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# Property `P_naive`: free products with a single infinite-order element

Bekka, Cowling and de la Harpe call a group `G` *naive* (property `P_nai`) when
for every finite subset `F ⊆ G ∖ {1}` there is an element `y` of infinite order
such that, for each `f ∈ F`, the subgroup generated by `f` and `y` is the free
product of `⟨f⟩` and `⟨y⟩` in the canonical way.  Abbott and Dahmani prove that
every acylindrically hyperbolic group with no nontrivial finite normal subgroup
has this property.

## The statement fixed here

The two factors are indexed by `Bool`: `cyclicPair f y false = ⟨f⟩` and
`cyclicPair f y true = ⟨y⟩`.  *"The free product in the canonical way"* is
injectivity of `cyclicPairLift f y`, the lift to `Monoid.CoprodI` of the two
inclusions `⟨f⟩ →* G`, `⟨y⟩ →* G`: the canonical homomorphism `⟨f⟩ ∗ ⟨y⟩ →* G`
has trivial kernel.  The order of `f` is not restricted, so `⟨f⟩` may be finite;
`y` has infinite order.

The indexed coproduct `Monoid.CoprodI` is used rather than the binary
`Monoid.Coprod` because both halves of the argument need its API at the pinned
Mathlib: the ping-pong lemma `Monoid.CoprodI.lift_injective_of_ping_pong` (the
natural producer of injectivity) and the reduced-word action
`Monoid.CoprodI.Word` (what the consumer uses) are stated for `CoprodI`, and the
pin has no equivalence between the two coproducts.

This module fixes the interface between the two halves of Dahmani, Guirardel
and Osin's Theorem 2.35 as `cor:regular-nonmf-algebra` uses it:

* the geometric half proves `NaiveFreeProductProperty G` for every countable
  acylindrically hyperbolic `G` with trivial finite radical
  (`Manuscript/NonMF/NaiveFreeProductAtAcylindricallyHyperbolic`);
* the analytic half proves that `NaiveFreeProductProperty G` gives Powers'
  averaging estimate for `C*_r(G)`, hence simplicity and a unique tracial state.

It imports only Mathlib, so either half can depend on it without the other.

## Manuscript status

Interface statement for `cor:regular-nonmf-algebra`; certifies no printed
sentence on its own.
-/

namespace GroupApproximation
namespace NaiveFreeProduct

universe u

variable {G : Type u} [Group G]

/-- The two cyclic subgroups of the canonical free product: `⟨f⟩` at index
`false` and `⟨y⟩` at index `true`. -/
def cyclicPair (f y : G) : Bool → Subgroup G :=
  fun b ↦ cond b (Subgroup.zpowers y) (Subgroup.zpowers f)

/-- **The canonical homomorphism `⟨f⟩ ∗ ⟨y⟩ →* G`**: the lift of the two
inclusions to the coproduct of the family `cyclicPair f y`. -/
def cyclicPairLift (f y : G) :
    Monoid.CoprodI (fun b : Bool ↦ ↥(cyclicPair f y b)) →* G :=
  Monoid.CoprodI.lift fun b ↦ (cyclicPair f y b).subtype

/-- **Property `P_naive`.**  For every finite `F ⊆ G ∖ {1}` there is an element
`y` of infinite order such that for every `f ∈ F` the canonical homomorphism
`⟨f⟩ ∗ ⟨y⟩ →* G` is injective. -/
def NaiveFreeProductProperty (G : Type u) [Group G] : Prop :=
  ∀ F : Finset G, (1 : G) ∉ F →
    ∃ y : G, (∀ k : ℤ, k ≠ 0 → y ^ k ≠ 1) ∧
      ∀ f ∈ F, Function.Injective (cyclicPairLift f y)

end NaiveFreeProduct
end GroupApproximation

open GroupApproximation.NaiveFreeProduct

#audit_axioms cyclicPair
#audit_axioms cyclicPairLift
#audit_axioms NaiveFreeProductProperty
