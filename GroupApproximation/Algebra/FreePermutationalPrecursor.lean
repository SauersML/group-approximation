import Mathlib.GroupTheory.CoprodI
import GroupApproximation.Algebra.PermutationalWreathSimple

/-!
# The free permutational precursor

Section 54.3 of the dossier proves that a transitive permutational wreath
product `K^{(X)} ⋊ G` with finite lamp group is finitely presented only when the
diagonal action of `G` on `X × X` has finitely many orbits.  The argument runs
through an auxiliary group: instead of the finitely supported configurations one
takes the *free* product of one copy of `K` per site, keeps the site permutation
action, and forms the semidirect product

  `E = (*_{x ∈ X} K_x) ⋊ G`.

This is the free permutational precursor.  It surjects onto the wreath product,
the kernel of that surjection being generated by the cross-site commutators
`[k_x, ℓ_y]`; the dossier then intercalates a graph product between the two and
plays the surviving commutators against a two-site retraction.

This file builds the precursor and the two structural maps the argument uses.
`FreeLamp K X` is the free lamp group, carrying the site action `freeLampMap` of
any group acting on `X`, packaged as `freeLampActionHom : G →* MulAut (FreeLamp
K X)`, and `FreeWreath K G X` is the resulting semidirect product.  The collapse
`freeLampToLamp` sends the `x`-th free factor onto the one-site lamps at `x`; it
is surjective and equivariant, and `freeWreathToWreath` extends it to a
surjection of `FreeWreath K G X` onto `Wreath K G X` which is the identity on the
acting group.  Finally `siteRetract` is the retraction of the free lamp group
onto the free product of the two factors sitting at a pair of distinct sites, and
`cross_commutator_ne_one` is the nontriviality (54.22) of the reduced word
`k_x ℓ_y k_x⁻¹ ℓ_y⁻¹`, proved from the normal form for reduced words in a free
product rather than from any ping-pong hypothesis.

What is *not* here is the graph product `B_𝒢` interpolating between the free
product and the restricted direct product, and the Tietze bookkeeping that turns
a finite presentation of the wreath product into a finite normal generating set
for the kernel.  Mathlib has neither graph products nor Tietze transformations,
so the passage from the two ends assembled here to Lemma 54.3 itself stays on
paper.
-/

namespace GroupApproximation

namespace FreePrecursor

universe u v w

open Monoid.CoprodI

open scoped commutatorElement

/-! ## The free lamp group -/

section FreeLampDef

variable (K : Type u) [Group K] (X : Type v)

/-- The **free lamp group** over the site set `X`: the free product of one copy
of the lamp group `K` for every site, with no relation at all between distinct
sites.  It is the object `*_{x ∈ X} K_x` of (54.16). -/
abbrev FreeLamp : Type (max u v) := Monoid.CoprodI fun _ : X => K

end FreeLampDef

/-! ## The site-permutation action -/

section SiteAction

variable (K : Type u) [Group K] (X : Type v) {G : Type w} [Group G] [MulAction G X]

/-- The endomorphism of the free lamp group induced by a site permutation: it
carries the free factor at `x` identically onto the free factor at `g • x`. -/
def freeLampMap (g : G) : FreeLamp K X →* FreeLamp K X :=
  lift fun x => of (M := fun _ : X => K) (i := g • x)

@[simp] theorem freeLampMap_of (g : G) (x : X) (k : K) :
    freeLampMap K X g (of (i := x) k) = of (i := g • x) k := by
  simp [freeLampMap]

/-- The identity of the acting group acts trivially. -/
theorem freeLampMap_one : freeLampMap K X (1 : G) = MonoidHom.id (FreeLamp K X) := by
  refine ext_hom _ _ fun x => MonoidHom.ext fun k => ?_
  simp

/-- Site permutations compose the way the acting group multiplies. -/
theorem freeLampMap_comp (g h : G) :
    (freeLampMap K X g).comp (freeLampMap K X h) = freeLampMap K X (g * h) := by
  refine ext_hom _ _ fun x => MonoidHom.ext fun k => ?_
  simp [mul_smul]

/-- The site permutation attached to `g`, as an automorphism of the free lamp
group; its inverse is the permutation attached to `g⁻¹`. -/
def freeLampAut (g : G) : MulAut (FreeLamp K X) where
  toFun := freeLampMap K X g
  invFun := freeLampMap K X g⁻¹
  left_inv := fun z => by
    have h := freeLampMap_comp K X g⁻¹ g
    rw [inv_mul_cancel, freeLampMap_one] at h
    exact DFunLike.congr_fun h z
  right_inv := fun z => by
    have h := freeLampMap_comp K X g g⁻¹
    rw [mul_inv_cancel, freeLampMap_one] at h
    exact DFunLike.congr_fun h z
  map_mul' := fun a b => map_mul (freeLampMap K X g) a b

/-- The site-permutation action as a homomorphism into the automorphism group of
the free lamp group.  This is the datum the precursor's semidirect product is
formed along. -/
def freeLampActionHom : G →* MulAut (FreeLamp K X) where
  toFun := freeLampAut K X
  map_one' := by
    refine MulEquiv.ext fun z => ?_
    show freeLampMap K X (1 : G) z = z
    rw [freeLampMap_one]
    rfl
  map_mul' := fun g h => by
    refine MulEquiv.ext fun z => ?_
    show freeLampMap K X (g * h) z = freeLampMap K X g (freeLampMap K X h z)
    rw [← freeLampMap_comp]
    rfl

@[simp] theorem freeLampActionHom_apply (g : G) (z : FreeLamp K X) :
    freeLampActionHom K X g z = freeLampMap K X g z := rfl

end SiteAction

/-- The **free permutational precursor** `E = (*_{x ∈ X} K_x) ⋊ G` of (54.16):
the free lamp group with the acting group permuting its free factors. -/
abbrev FreeWreath (K : Type u) [Group K] (G : Type w) [Group G] (X : Type v)
    [MulAction G X] : Type (max u v w) :=
  FreeLamp K X ⋊[freeLampActionHom (K := K) (X := X) (G := G)] G

/-! ## The collapse onto the wreath product -/

section Collapse

variable (K : Type u) [Group K] (X : Type v) [DecidableEq X]

/-- The collapse of the free lamp group onto the finitely supported one: the
`x`-th free factor goes to the one-site lamps at `x`.  Its kernel is the normal
closure of the cross-site commutators (54.19). -/
def freeLampToLamp : FreeLamp K X →* Lamp K X :=
  lift fun x => Lamp.singleHom x

@[simp] theorem freeLampToLamp_of (x : X) (k : K) :
    freeLampToLamp K X (of (i := x) k) = Lamp.single x k :=
  lift_of _ _

/-- The collapse is surjective, because the one-site lamps generate the whole
lamp group. -/
theorem freeLampToLamp_surjective : Function.Surjective (freeLampToLamp K X) := by
  intro f
  have hle : Subgroup.closure {g : Lamp K X | ∃ (x : X) (k : K), g = Lamp.single x k}
      ≤ (freeLampToLamp K X).range := by
    rw [Subgroup.closure_le]
    rintro g ⟨x, k, rfl⟩
    exact MonoidHom.mem_range.mpr ⟨of (i := x) k, freeLampToLamp_of K X x k⟩
  exact MonoidHom.mem_range.mp (hle (Lamp.mem_closure_singles f))

end Collapse

section CollapseEquivariance

variable (K : Type u) [Group K] (X : Type v) [DecidableEq X] {G : Type w} [Group G]
  [MulAction G X]

omit [DecidableEq X] in
/-- The site action on the finitely supported lamp group, read off the
homomorphism the wreath product is formed along. -/
@[simp] theorem lampActionHom_apply' (g : G) (f : Lamp K X) :
    lampActionHom (K := K) (X := X) g f = lampAut (K := K) g f := rfl

/-- The collapse intertwines the two site actions: moving a free factor and then
collapsing is collapsing and then moving the lamp. -/
theorem freeLampToLamp_equivariant (g : G) :
    (freeLampToLamp K X).comp (freeLampActionHom K X g).toMonoidHom
      = (lampActionHom (K := K) (X := X) g).toMonoidHom.comp (freeLampToLamp K X) := by
  refine ext_hom _ _ fun x => MonoidHom.ext fun k => ?_
  simp [lampActionHom_apply', lampAut_single]

/-- The canonical surjection (54.18) of the precursor onto the permutational
wreath product: the collapse on the lamp coordinate, the identity on the acting
group. -/
def freeWreathToWreath : FreeWreath K G X →* Wreath K G X :=
  SemidirectProduct.map (freeLampToLamp K X) (MonoidHom.id G) fun g => by
    simpa using freeLampToLamp_equivariant K X g

@[simp] theorem freeWreathToWreath_inl (z : FreeLamp K X) :
    freeWreathToWreath K X (SemidirectProduct.inl z : FreeWreath K G X)
      = SemidirectProduct.inl (freeLampToLamp K X z) := by
  simp [freeWreathToWreath]

/-- The surjection is the identity on the acting group. -/
@[simp] theorem freeWreathToWreath_inr (g : G) :
    freeWreathToWreath K X (SemidirectProduct.inr g : FreeWreath K G X)
      = SemidirectProduct.inr g := by
  simp [freeWreathToWreath]

/-- The precursor surjects onto the permutational wreath product. -/
theorem freeWreathToWreath_surjective :
    Function.Surjective (freeWreathToWreath K X (G := G)) := by
  intro y
  obtain ⟨z, hz⟩ := freeLampToLamp_surjective K X y.left
  exact ⟨⟨z, y.right⟩, SemidirectProduct.ext hz rfl⟩

end CollapseEquivariance

/-! ## Two sites: the free product of two copies of the lamp group -/

section TwoFactors

variable (K : Type u) [Group K]

/-- The free product of two copies of the lamp group, indexed by `Bool`.  This is
the target of the two-site retraction of Section 54.3. -/
abbrev BoolCoprod : Type u := Monoid.CoprodI fun _ : Bool => K

/-- The inclusion of the `b`-th of the two factors. -/
def boolOf (b : Bool) : K →* BoolCoprod K := of (M := fun _ : Bool => K) (i := b)

/-- The reduced word `k · ℓ · k⁻¹ · ℓ⁻¹` of (54.22), alternating between the two
factors.  Its letters are nontrivial and its adjacent indices differ, so it is a
genuine normal form. -/
def crossWord {k l : K} (hk : k ≠ 1) (hl : l ≠ 1) : Word fun _ : Bool => K :=
  Word.cons (i := true) k
    (Word.cons (i := false) l
      (Word.cons (i := true) k⁻¹
        (Word.cons (i := false) l⁻¹ Word.empty (by simp [Word.fstIdx]) (inv_ne_one.mpr hl))
        (by simp) (inv_ne_one.mpr hk))
      (by simp) hl)
    (by simp) hk

@[simp] theorem crossWord_fstIdx {k l : K} (hk : k ≠ 1) (hl : l ≠ 1) :
    (crossWord K hk hl).fstIdx = some true := by
  simp [crossWord]

/-- The reduced word multiplies out to the cross-factor commutator. -/
theorem crossWord_prod {k l : K} (hk : k ≠ 1) (hl : l ≠ 1) :
    (crossWord K hk hl).prod = ⁅boolOf K true k, boolOf K false l⁆ := by
  simp [crossWord, boolOf, commutatorElement_def, mul_assoc]

/-- **The cross-factor commutator is nontrivial in a free product of two copies
of `K`.**  This is (54.22): the word is already reduced and nonempty, and reduced
words are a normal form for the free product, so it cannot equal the identity.
No hypothesis beyond nontriviality of the two letters is needed. -/
theorem boolOf_commutator_ne_one {k l : K} (hk : k ≠ 1) (hl : l ≠ 1) :
    ⁅boolOf K true k, boolOf K false l⁆ ≠ 1 := by
  classical
  intro hcon
  have hprod : (crossWord K hk hl).prod = (Word.empty : Word fun _ : Bool => K).prod := by
    rw [crossWord_prod, hcon, Word.prod_empty]
  have hinj : Function.Injective (Word.prod : (Word fun _ : Bool => K) → BoolCoprod K) :=
    Word.equiv.right_inv.injective
  have hfst := congrArg Word.fstIdx (hinj hprod)
  rw [crossWord_fstIdx] at hfst
  simp [Word.fstIdx] at hfst

end TwoFactors

/-! ## The two-site retraction -/

section Retract

variable (K : Type u) [Group K] (X : Type v) [DecidableEq X]

/-- The **two-site retraction**: kill every free factor except the ones at `x`
and `y`, and send those two identically onto the two factors of a free product of
two copies of `K`.  This is the map used at the end of Section 54.3 to detect a
surviving cross-site commutator at a nonedge. -/
def siteRetract (x y : X) : FreeLamp K X →* BoolCoprod K :=
  lift fun z => if z = x then boolOf K true else if z = y then boolOf K false else 1

/-- The section of the retraction: the two factors go back to the sites `x` and
`y`. -/
def twoSiteSection (x y : X) : BoolCoprod K →* FreeLamp K X :=
  lift fun b => of (M := fun _ : X => K) (i := cond b x y)

@[simp] theorem siteRetract_of_left (x y : X) (k : K) :
    siteRetract K X x y (of (i := x) k) = boolOf K true k := by
  simp [siteRetract]

@[simp] theorem siteRetract_of_right {x y : X} (h : y ≠ x) (k : K) :
    siteRetract K X x y (of (i := y) k) = boolOf K false k := by
  simp [siteRetract, h]

/-- Every factor away from the two chosen sites is killed. -/
@[simp] theorem siteRetract_of_other {x y z : X} (hzx : z ≠ x) (hzy : z ≠ y) (k : K) :
    siteRetract K X x y (of (i := z) k) = 1 := by
  simp [siteRetract, hzx, hzy]

/-- The retraction really retracts: it is a left inverse of the two-site
section, so the free product of the two chosen factors sits inside the free lamp
group as a retract. -/
theorem siteRetract_comp_twoSiteSection {x y : X} (hxy : x ≠ y) :
    (siteRetract K X x y).comp (twoSiteSection K X x y) = MonoidHom.id (BoolCoprod K) := by
  refine ext_hom _ _ fun b => MonoidHom.ext fun k => ?_
  cases b with
  | false => simp [twoSiteSection, boolOf, siteRetract_of_right K X (Ne.symm hxy)]
  | true => simp [twoSiteSection, boolOf]

/-- In particular the retraction is onto the free product of the two factors. -/
theorem siteRetract_surjective {x y : X} (hxy : x ≠ y) :
    Function.Surjective (siteRetract K X x y) := fun z =>
  ⟨twoSiteSection K X x y z,
    DFunLike.congr_fun (siteRetract_comp_twoSiteSection K X hxy) z⟩

/-- **The cross-site commutator survives the retraction.**  For distinct sites and
nontrivial values the image of `[k_x, ℓ_y]` is the reduced word (54.22) in the
free product of the two factors, hence nontrivial. -/
theorem siteRetract_commutator_ne_one {x y : X} (hxy : x ≠ y) {k l : K} (hk : k ≠ 1)
    (hl : l ≠ 1) :
    siteRetract K X x y
        ⁅(of (i := x) k : FreeLamp K X), (of (i := y) l : FreeLamp K X)⁆ ≠ 1 := by
  have hval : siteRetract K X x y
      ⁅(of (i := x) k : FreeLamp K X), (of (i := y) l : FreeLamp K X)⁆
      = ⁅boolOf K true k, boolOf K false l⁆ := by
    simp [commutatorElement_def, siteRetract_of_right K X (Ne.symm hxy)]
  rw [hval]
  exact boolOf_commutator_ne_one K hk hl

/-- **The cross-site commutator is nontrivial in the free lamp group.**  This is
the input to the last step of Section 54.3: in the precursor, unlike in the
wreath product, lamps at distinct sites do not commute. -/
theorem cross_commutator_ne_one {x y : X} (hxy : x ≠ y) {k l : K} (hk : k ≠ 1) (hl : l ≠ 1) :
    ⁅(of (i := x) k : FreeLamp K X), (of (i := y) l : FreeLamp K X)⁆ ≠ 1 := fun hcon =>
  siteRetract_commutator_ne_one K X hxy hk hl (by rw [hcon, map_one])

/-- Nontriviality of the lamp group is all the hypothesis the last step needs:
at any two distinct sites some cross-site commutator is nontrivial in the free
lamp group. -/
theorem exists_cross_commutator_ne_one [Nontrivial K] {x y : X} (hxy : x ≠ y) :
    ∃ k l : K, ⁅(of (i := x) k : FreeLamp K X), (of (i := y) l : FreeLamp K X)⁆ ≠ 1 := by
  obtain ⟨k, hk⟩ := exists_ne (1 : K)
  exact ⟨k, k, cross_commutator_ne_one K X hxy hk hk⟩

/-- The collapse does destroy the commutator: in the wreath product lamps at
distinct sites commute, so the whole cross-site commutator lies in the kernel of
`freeLampToLamp`.  Together with `cross_commutator_ne_one` this exhibits the
kernel `C` of (54.18) as nontrivial. -/
theorem freeLampToLamp_commutator {x y : X} (hxy : x ≠ y) (k l : K) :
    freeLampToLamp K X
        ⁅(of (i := x) k : FreeLamp K X), (of (i := y) l : FreeLamp K X)⁆ = 1 := by
  have hcomm : Lamp.single x k * Lamp.single y l = Lamp.single y l * Lamp.single x k :=
    Lamp.single_commute hxy k l
  simp only [commutatorElement_def, map_mul, map_inv, freeLampToLamp_of]
  rw [hcomm, mul_assoc, mul_assoc, mul_inv_cancel_left, mul_inv_cancel]

end Retract

end FreePrecursor

end GroupApproximation
