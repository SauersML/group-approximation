import GroupApproximation.Algebra.AmenableConstructions

/-!
# The additive rationals are amenable

`ℚ` is the directed union of the cyclic subgroups generated by `1/n!`, and
each of those is amenable as an image of `ℤ`.  So the directed-union
theorem applies, and no new analysis is needed.

This is the kernel shape of `BS(1,2)`: the manuscript's `ℤ[1/2]` sits
inside `ℚ`, and the repository's `BSLike` is literally
`Multiplicative ℚ ⋊ Multiplicative ℤ`, so with this result and the
semidirect-product theorem `BSLike` is amenable, and with the locally
finite lamp kernel on top so is `CliffordBS`.
-/

namespace GroupApproximation
namespace Amenability

open scoped Nat

/-- The generator of the `n`-th step of the exhaustion of `ℚ`. -/
noncomputable def qStep (n : ℕ) : Multiplicative ℚ :=
  Multiplicative.ofAdd (1 / (n ! : ℚ))

/-- The `n`-th step of the exhaustion of `ℚ`. -/
noncomputable def qK (n : ℕ) : Subgroup (Multiplicative ℚ) :=
  Subgroup.zpowers (qStep n)

theorem mem_qK_iff (n : ℕ) (q : ℚ) :
    (Multiplicative.ofAdd q) ∈ qK n ↔ ∃ k : ℤ, (k : ℚ) * (1 / (n ! : ℚ)) = q := by
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    have hk' := congrArg Multiplicative.toAdd hk
    simpa [qStep, ← ofAdd_zsmul, zsmul_eq_mul] using hk'
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    simp only [qStep, ← ofAdd_zsmul, zsmul_eq_mul]
    rw [hk]

theorem qK_mono : Monotone qK := by
  refine monotone_nat_of_le_succ fun n ↦ ?_
  intro x hx
  obtain ⟨k, hk⟩ := hx
  have hk' : qStep n ^ k = x := hk
  have hne : ((n ! : ℚ)) ≠ 0 := by exact_mod_cast Nat.factorial_ne_zero n
  have hn1 : ((n : ℚ) + 1) ≠ 0 := by positivity
  have hstep : qStep n = qStep (n + 1) ^ ((n : ℤ) + 1) := by
    simp only [qStep, ← ofAdd_zsmul, zsmul_eq_mul]
    congr 1
    have hfac : ((n + 1)! : ℚ) = ((n : ℚ) + 1) * (n ! : ℚ) := by
      rw [Nat.factorial_succ]
      push_cast
      ring
    rw [hfac]
    push_cast
    field_simp
  refine ⟨k * ((n : ℤ) + 1), ?_⟩
  show qStep (n + 1) ^ (k * ((n : ℤ) + 1)) = x
  rw [← hk', hstep, ← zpow_mul]
  congr 1
  ring

theorem qK_cover (g : Multiplicative ℚ) : ∃ n, g ∈ qK n := by
  classical
  set q : ℚ := Multiplicative.toAdd g with hq
  refine ⟨q.den, ?_⟩
  have hg : g = Multiplicative.ofAdd q := rfl
  rw [hg, mem_qK_iff]
  have hden : 0 < q.den := q.pos
  have hdvd : (q.den : ℤ) ∣ ((q.den ! : ℕ) : ℤ) :=
    Int.natCast_dvd_natCast.mpr (Nat.dvd_factorial hden le_rfl)
  obtain ⟨c, hc⟩ := hdvd
  have hfacne : ((q.den ! : ℚ)) ≠ 0 := by
    exact_mod_cast Nat.factorial_ne_zero q.den
  have hdenne : ((q.den : ℚ)) ≠ 0 := by
    exact_mod_cast hden.ne'
  have hcq : ((q.den ! : ℚ)) = (q.den : ℚ) * (c : ℚ) := by
    exact_mod_cast congrArg (fun z : ℤ ↦ (z : ℚ)) hc
  have hcne : ((c : ℚ)) ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hcq
    exact hfacne hcq
  refine ⟨q.num * c, ?_⟩
  have hgoal : ((q.num * c : ℤ) : ℚ) * (1 / (q.den ! : ℚ)) =
      (q.num : ℚ) / (q.den : ℚ) := by
    rw [hcq]
    push_cast
    field_simp
  rw [hgoal, Rat.num_div_den]

/-- **The additive rationals are amenable.** -/
theorem hasInvariantMean_rat : HasInvariantMean (Multiplicative ℚ) :=
  hasInvariantMean_of_directed qK
    (fun n ↦ (hasInvariantMean_zpowers (qStep n)).some) ⟨0⟩ qK_mono qK_cover

end Amenability
end GroupApproximation
