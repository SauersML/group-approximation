import GroupApproximation.Meta.AxiomGuard
import Mathlib.Algebra.Group.Basic
import Mathlib.Algebra.Ring.Basic
import Mathlib.Algebra.Group.Units.Basic
import Mathlib.Tactic.NoncommRing
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-!
# The levels of the three-coordinate bilateral cell

`non_mf_groups_exist.tex`, proof of Proposition `prop:bilateral-three`
(`\label{prop:bilateral-three}`, tex 1549–1566 at origin/main 68481e4d7):

> Take a clopen $P$ with $T(P)\subseteq P$ and nonempty $D=P\setminus T(P)$.  Put $p=1_P$,
> $d=1_D$, and $f_{ab}=u^a d u^{-b}$ for $a,b\in\mathbb Z$.  Wandering gives
> $f_{ab}f_{ce}=\delta_{bc}f_{ae}$.  Negative levels lie outside $P$.
> The unital subalgebra $S\subseteq pR_Xp$ generated by $s=up$, $t=pu^{-1}$ and $kp$
> satisfies $ts=p$, $st=p-d$. [...]
> Let $r$ cycle the three negative levels $-1\mapsto-2\mapsto-3\mapsto-1$:
> $r=1-\sum_{j=1}^3 f_{-j,-j}+f_{-2,-1}+f_{-3,-2}+f_{-1,-3}$. [...]
> The correction $r$ acts outside $P$ and centralizes $L$.

Everything here is ring algebra.  A `Cell R` is a unit `u` and an idempotent `p` of a ring with
`u p u⁻¹ ≤ p` (`(u p u⁻¹) p = u p u⁻¹ = p (u p u⁻¹)`).  In `R_X` these are the implementing unit
and `1_P` for a compressed clopen `P`, and `d = p - u p u⁻¹ = 1_{P∖T(P)}`
(`ClopenCrossedProduct.defectD_eq_sub`).

* `Cell.lvl j = u^j p u^{-j}` (in `R_X`: `1_{T^j(P)}`) and the nesting `lvl_mul_lvl_of_le`;
* `Cell.f a b = u^a d u^{-b}`, **wandering** `f_mul_f`, and **negative levels lie outside `P`**
  (`p_mul_f`, `f_mul_p`, with corner forms `corner_mul_f`, `f_mul_corner`);
* `Cell.s`, `Cell.t` with `t_mul_s : t s = p` and `s_mul_t : s t = p - d`; `s` and `t` lie in the
  corner `pRp`, and conjugation by `u` on the corner is `a ↦ s a t` (`unit_conj_eq_s_mul_t`);
* `Cell.r`, its inverse `Cell.rInv`, the unit `Cell.rUnit`, and "$r$ acts outside $P$":
  `r_mul_corner`, `corner_mul_r` (and the same for `rInv`).
-/

namespace GroupApproximation
namespace BilateralThreeCell

/-- The data of the three-coordinate bilateral cell: a unit `u` and an idempotent `p` with
`u p u⁻¹ ≤ p`.  In `R_X` (tex 1550): `u` the implementing unit, `p = 1_P`, `T(P) ⊆ P`. -/
structure Cell (R : Type*) [Ring R] where
  /-- The implementing unit `u`. -/
  u : Rˣ
  /-- The idempotent `p = 1_P`. -/
  p : R
  p_mul_p : p * p = p
  conj_mul_p : (↑u * p * ↑u⁻¹) * p = ↑u * p * ↑u⁻¹
  p_mul_conj : p * (↑u * p * ↑u⁻¹) = ↑u * p * ↑u⁻¹

namespace Cell

variable {R : Type*} [Ring R] (C : Cell R)

/-! ### Powers of `u` -/

/-- `u^j` in `R`. -/
def pw (j : ℤ) : R := ((C.u ^ j : Rˣ) : R)

theorem pw_add (a b : ℤ) : C.pw (a + b) = C.pw a * C.pw b := by
  rw [pw, pw, pw, zpow_add, Units.val_mul]

theorem pw_zero : C.pw 0 = 1 := by
  rw [pw, zpow_zero, Units.val_one]

theorem pw_one : C.pw 1 = C.u := by
  rw [pw, zpow_one]

theorem pw_neg_one : C.pw (-1) = ↑C.u⁻¹ := by
  rw [pw, zpow_neg_one]

theorem pw_mul_pw_neg (j : ℤ) : C.pw j * C.pw (-j) = 1 := by
  rw [← pw_add, add_neg_cancel, pw_zero]

theorem pw_neg_mul_pw (j : ℤ) : C.pw (-j) * C.pw j = 1 := by
  rw [← pw_add, neg_add_cancel, pw_zero]

/-- Conjugation by `u^j` is multiplicative. -/
theorem conj_mul (j : ℤ) (x y : R) :
    C.pw j * (x * y) * C.pw (-j) = (C.pw j * x * C.pw (-j)) * (C.pw j * y * C.pw (-j)) := by
  have h := C.pw_neg_mul_pw j
  calc C.pw j * (x * y) * C.pw (-j) = C.pw j * x * 1 * y * C.pw (-j) := by
        simp only [mul_one, mul_assoc]
    _ = C.pw j * x * (C.pw (-j) * C.pw j) * y * C.pw (-j) := by rw [h]
    _ = (C.pw j * x * C.pw (-j)) * (C.pw j * y * C.pw (-j)) := by simp only [mul_assoc]

theorem conj_conj (i j : ℤ) (x : R) :
    C.pw i * (C.pw j * x * C.pw (-j)) * C.pw (-i) = C.pw (i + j) * x * C.pw (-(i + j)) := by
  rw [C.pw_add i j, neg_add_rev, C.pw_add (-j) (-i)]
  simp only [mul_assoc]

/-! ### Levels -/

/-- The level idempotent `u^j p u^{-j}` (in `R_X`: `1_{T^j(P)}`). -/
def lvl (j : ℤ) : R := C.pw j * C.p * C.pw (-j)

@[simp] theorem conj_p (j : ℤ) : C.pw j * C.p * C.pw (-j) = C.lvl j := rfl

theorem lvl_zero : C.lvl 0 = C.p := by
  rw [lvl, neg_zero, pw_zero, one_mul, mul_one]

theorem lvl_one : C.lvl 1 = ↑C.u * C.p * ↑C.u⁻¹ := by
  rw [lvl, pw_one, pw_neg_one]

theorem lvl_add (i j : ℤ) : C.pw i * C.lvl j * C.pw (-i) = C.lvl (i + j) := by
  rw [lvl, lvl]
  exact C.conj_conj i j C.p

theorem lvl_mul_self (j : ℤ) : C.lvl j * C.lvl j = C.lvl j := by
  rw [lvl, ← C.conj_mul, C.p_mul_p]

theorem lvl_one_mul_p : C.lvl 1 * C.p = C.lvl 1 := by
  rw [lvl_one]
  exact C.conj_mul_p

theorem p_mul_lvl_one : C.p * C.lvl 1 = C.lvl 1 := by
  rw [lvl_one]
  exact C.p_mul_conj

theorem lvl_succ_mul (j : ℤ) : C.lvl (j + 1) * C.lvl j = C.lvl (j + 1) := by
  have h : C.pw j * (C.lvl 1 * C.p) * C.pw (-j) = C.pw j * C.lvl 1 * C.pw (-j) := by
    rw [C.lvl_one_mul_p]
  rw [C.conj_mul, C.lvl_add, C.conj_p] at h
  exact h

theorem lvl_mul_succ (j : ℤ) : C.lvl j * C.lvl (j + 1) = C.lvl (j + 1) := by
  have h : C.pw j * (C.p * C.lvl 1) * C.pw (-j) = C.pw j * C.lvl 1 * C.pw (-j) := by
    rw [C.p_mul_lvl_one]
  rw [C.conj_mul, C.lvl_add, C.conj_p] at h
  exact h

theorem lvl_nested (i : ℤ) (n : ℕ) :
    C.lvl (i + n) * C.lvl i = C.lvl (i + n) ∧ C.lvl i * C.lvl (i + n) = C.lvl (i + n) := by
  induction n with
  | zero =>
      simp only [Nat.cast_zero, add_zero]
      exact ⟨C.lvl_mul_self i, C.lvl_mul_self i⟩
  | succ n ih =>
      have e : i + ((n + 1 : ℕ) : ℤ) = (i + n) + 1 := by push_cast; ring
      rw [e]
      constructor
      · calc C.lvl (i + n + 1) * C.lvl i = C.lvl (i + n + 1) * C.lvl (i + n) * C.lvl i := by
              rw [C.lvl_succ_mul]
          _ = C.lvl (i + n + 1) * (C.lvl (i + n) * C.lvl i) := by rw [mul_assoc]
          _ = C.lvl (i + n + 1) := by rw [ih.1, C.lvl_succ_mul]
      · calc C.lvl i * C.lvl (i + n + 1) = C.lvl i * (C.lvl (i + n) * C.lvl (i + n + 1)) := by
              rw [C.lvl_mul_succ]
          _ = (C.lvl i * C.lvl (i + n)) * C.lvl (i + n + 1) := by rw [mul_assoc]
          _ = C.lvl (i + n + 1) := by rw [ih.2, C.lvl_mul_succ]

/-- The levels are nested: `lvl j ≤ lvl i` for `i ≤ j`, right form. -/
theorem lvl_mul_lvl_of_le {i j : ℤ} (h : i ≤ j) : C.lvl j * C.lvl i = C.lvl j := by
  obtain ⟨n, hn⟩ := Int.le.dest h
  subst hn
  exact (C.lvl_nested i n).1

/-- The levels are nested: `lvl j ≤ lvl i` for `i ≤ j`, left form. -/
theorem lvl_mul_lvl_of_le' {i j : ℤ} (h : i ≤ j) : C.lvl i * C.lvl j = C.lvl j := by
  obtain ⟨n, hn⟩ := Int.le.dest h
  subst hn
  exact (C.lvl_nested i n).2

/-! ### The defect and the matrix units `f_{ab}` -/

/-- `d = p - u p u⁻¹` (in `R_X`: `1_{P∖T(P)}`). -/
def d : R := C.p - C.lvl 1

/-- `f_{ab} = u^a d u^{-b}` (tex 1552). -/
def f (a b : ℤ) : R := C.pw a * C.d * C.pw (-b)

theorem f_zero_zero : C.f 0 0 = C.d := by
  rw [f, neg_zero, pw_zero, one_mul, mul_one]

theorem conj_d (a : ℤ) : C.pw a * C.d * C.pw (-a) = C.lvl a - C.lvl (a + 1) := by
  rw [d, mul_sub, sub_mul, C.conj_p, C.lvl_add]

theorem d_mul_d : C.d * C.d = C.d := by
  simp only [d, sub_mul, mul_sub, C.p_mul_p, C.p_mul_lvl_one, C.lvl_one_mul_p, C.lvl_mul_self]
  abel

theorem p_mul_d : C.p * C.d = C.d := by
  rw [d, mul_sub, C.p_mul_p, C.p_mul_lvl_one]

theorem d_mul_p : C.d * C.p = C.d := by
  rw [d, sub_mul, C.p_mul_p, C.lvl_one_mul_p]

/-- A positive level difference is orthogonal to `d`, right form. -/
theorem diff_mul_d {m : ℤ} (hm : 1 ≤ m) : (C.lvl m - C.lvl (m + 1)) * C.d = 0 := by
  have h0 : (0 : ℤ) ≤ m := by omega
  have h0' : (0 : ℤ) ≤ m + 1 := by omega
  have h1' : (1 : ℤ) ≤ m + 1 := by omega
  rw [d, sub_mul, mul_sub, mul_sub, ← C.lvl_zero, C.lvl_mul_lvl_of_le h0, C.lvl_mul_lvl_of_le hm,
    C.lvl_mul_lvl_of_le h0', C.lvl_mul_lvl_of_le h1', sub_self, sub_self, sub_self]

/-- A positive level difference is orthogonal to `d`, left form. -/
theorem d_mul_diff {m : ℤ} (hm : 1 ≤ m) : C.d * (C.lvl m - C.lvl (m + 1)) = 0 := by
  have h0 : (0 : ℤ) ≤ m := by omega
  have h0' : (0 : ℤ) ≤ m + 1 := by omega
  have h1' : (1 : ℤ) ≤ m + 1 := by omega
  rw [d, sub_mul, mul_sub, mul_sub, ← C.lvl_zero, C.lvl_mul_lvl_of_le' h0,
    C.lvl_mul_lvl_of_le' h0', C.lvl_mul_lvl_of_le' hm, C.lvl_mul_lvl_of_le' h1', sub_self]

/-- The core of wandering: `d u^j d = δ_{j0} d`. -/
theorem d_mul_pw_mul_d (j : ℤ) : C.d * C.pw j * C.d = if j = 0 then C.d else 0 := by
  rcases lt_trichotomy j 0 with hj | hj | hj
  · rw [if_neg hj.ne]
    have e : C.d * C.pw j * C.d = C.pw j * (C.pw (-j) * C.d * C.pw (-(-j))) * C.d := by
      rw [neg_neg]
      calc C.d * C.pw j * C.d = 1 * C.d * C.pw j * C.d := by rw [one_mul]
        _ = (C.pw j * C.pw (-j)) * C.d * C.pw j * C.d := by rw [C.pw_mul_pw_neg]
        _ = C.pw j * (C.pw (-j) * C.d * C.pw j) * C.d := by simp only [mul_assoc]
    have h1 : (1 : ℤ) ≤ -j := by omega
    rw [e, C.conj_d, mul_assoc, C.diff_mul_d h1, mul_zero]
  · subst hj
    rw [if_pos rfl, pw_zero, mul_one, d_mul_d]
  · rw [if_neg hj.ne']
    have e : C.d * C.pw j * C.d = C.d * (C.pw j * C.d * C.pw (-j)) * C.pw j := by
      calc C.d * C.pw j * C.d = C.d * C.pw j * C.d * 1 := by rw [mul_one]
        _ = C.d * C.pw j * C.d * (C.pw (-j) * C.pw j) := by rw [C.pw_neg_mul_pw]
        _ = C.d * (C.pw j * C.d * C.pw (-j)) * C.pw j := by simp only [mul_assoc]
    have h1 : (1 : ℤ) ≤ j := by omega
    rw [e, C.conj_d, C.d_mul_diff h1, zero_mul]

/-- **Wandering** (tex 1552–1553): `f_{ab} f_{ce} = δ_{bc} f_{ae}`. -/
theorem f_mul_f (a b c e : ℤ) : C.f a b * C.f c e = if b = c then C.f a e else 0 := by
  have e1 : C.f a b * C.f c e = C.pw a * (C.d * C.pw (-b + c) * C.d) * C.pw (-e) := by
    rw [C.pw_add]
    simp only [f, mul_assoc]
  rw [e1, C.d_mul_pw_mul_d]
  by_cases h : b = c
  · subst h
    rw [if_pos (neg_add_cancel b), if_pos rfl, f]
  · have h' : -b + c ≠ 0 := by omega
    rw [if_neg h', if_neg h, mul_zero, zero_mul]

/-- **Negative levels lie outside `P`** (tex 1553), left form. -/
theorem p_mul_f {a : ℤ} (ha : a < 0) (b : ℤ) : C.p * C.f a b = 0 := by
  have e : C.p * C.f a b = C.p * (C.pw a * C.d * C.pw (-a)) * (C.pw a * C.pw (-b)) := by
    calc C.p * C.f a b = C.p * (C.pw a * C.d * 1 * C.pw (-b)) := by rw [f, mul_one]
      _ = C.p * (C.pw a * C.d * (C.pw (-a) * C.pw a) * C.pw (-b)) := by rw [C.pw_neg_mul_pw]
      _ = C.p * (C.pw a * C.d * C.pw (-a)) * (C.pw a * C.pw (-b)) := by simp only [mul_assoc]
  have h0 : a ≤ 0 := ha.le
  have h1 : a + 1 ≤ 0 := by omega
  rw [e, C.conj_d, mul_sub, ← C.lvl_zero, C.lvl_mul_lvl_of_le h0, C.lvl_mul_lvl_of_le h1, sub_self,
    zero_mul]

/-- **Negative levels lie outside `P`** (tex 1553), right form. -/
theorem f_mul_p (a : ℤ) {b : ℤ} (hb : b < 0) : C.f a b * C.p = 0 := by
  have e : C.f a b * C.p = (C.pw a * C.pw (-b)) * (C.pw b * C.d * C.pw (-b)) * C.p := by
    calc C.f a b * C.p = C.pw a * 1 * C.d * C.pw (-b) * C.p := by rw [f, mul_one]
      _ = C.pw a * (C.pw (-b) * C.pw b) * C.d * C.pw (-b) * C.p := by rw [C.pw_neg_mul_pw]
      _ = (C.pw a * C.pw (-b)) * (C.pw b * C.d * C.pw (-b)) * C.p := by simp only [mul_assoc]
  have h0 : b ≤ 0 := hb.le
  have h1 : b + 1 ≤ 0 := by omega
  rw [e, C.conj_d, mul_assoc, sub_mul, ← C.lvl_zero, C.lvl_mul_lvl_of_le' h0,
    C.lvl_mul_lvl_of_le' h1, sub_self, mul_zero]

theorem corner_mul_f {a : R} (ha : C.p * a * C.p = a) {c : ℤ} (hc : c < 0) (e : ℤ) :
    a * C.f c e = 0 := by
  rw [← ha, mul_assoc, C.p_mul_f hc, mul_zero]

theorem f_mul_corner {a : R} (ha : C.p * a * C.p = a) (c : ℤ) {e : ℤ} (he : e < 0) :
    C.f c e * a = 0 := by
  rw [← ha, ← mul_assoc, ← mul_assoc, C.f_mul_p c he, zero_mul, zero_mul]

theorem p_mul_f_zero (b : ℤ) : C.p * C.f 0 b = C.f 0 b := by
  rw [f, pw_zero, one_mul, ← mul_assoc, C.p_mul_d]

theorem unit_mul_f (a b : ℤ) : ↑C.u * C.f a b = C.f (a + 1) b := by
  rw [f, f, ← C.pw_one, ← mul_assoc, ← mul_assoc, ← C.pw_add, add_comm 1 a]

theorem f_mul_unit (a b : ℤ) : C.f a b * ↑C.u = C.f a (b - 1) := by
  rw [f, f, ← C.pw_one, mul_assoc, ← C.pw_add, show -b + 1 = -(b - 1) by ring]

/-! ### The corner algebra generators `s`, `t` -/

/-- `s = u p` (tex 1555). -/
def s : R := ↑C.u * C.p

/-- `t = p u⁻¹` (tex 1555). -/
def t : R := C.p * ↑C.u⁻¹

/-- `ts = p` (tex 1555). -/
theorem t_mul_s : C.t * C.s = C.p := by
  rw [t, s, mul_assoc, ← mul_assoc (↑C.u⁻¹ : R), Units.inv_mul, one_mul, C.p_mul_p]

/-- `st = p - d` (tex 1555). -/
theorem s_mul_t : C.s * C.t = C.p - C.d := by
  rw [d, sub_sub_cancel, lvl_one, s, t, ← mul_assoc, mul_assoc (↑C.u : R) C.p C.p, C.p_mul_p]

theorem s_mul_p : C.s * C.p = C.s := by
  rw [s, mul_assoc, C.p_mul_p]

theorem p_mul_t : C.p * C.t = C.t := by
  rw [t, ← mul_assoc, C.p_mul_p]

/-- `s` lies in the corner `pRp`. -/
theorem p_mul_s_mul_p : C.p * C.s * C.p = C.s := by
  have h : C.p * ↑C.u * C.p = ↑C.u * C.p := by
    calc C.p * ↑C.u * C.p = C.p * (↑C.u * C.p * ↑C.u⁻¹) * ↑C.u := by
          simp only [mul_assoc, Units.inv_mul, mul_one]
      _ = ↑C.u * C.p * ↑C.u⁻¹ * ↑C.u := by rw [C.p_mul_conj]
      _ = ↑C.u * C.p := by simp only [mul_assoc, Units.inv_mul, mul_one]
  rw [mul_assoc, C.s_mul_p, s, ← mul_assoc, h]

/-- `t` lies in the corner `pRp`. -/
theorem p_mul_t_mul_p : C.p * C.t * C.p = C.t := by
  rw [C.p_mul_t, t]
  calc C.p * ↑C.u⁻¹ * C.p = ↑C.u⁻¹ * (↑C.u * C.p * ↑C.u⁻¹ * C.p) := by
        simp only [mul_assoc, Units.inv_mul_cancel_left]
    _ = ↑C.u⁻¹ * (↑C.u * C.p * ↑C.u⁻¹) := by rw [C.conj_mul_p]
    _ = C.p * ↑C.u⁻¹ := by simp only [mul_assoc, Units.inv_mul_cancel_left]

/-- On the corner `pRp`, conjugation by `u` is `a ↦ s a t` (tex 1567–1568). -/
theorem unit_conj_eq_s_mul_t {a : R} (ha : C.p * a * C.p = a) :
    ↑C.u * a * ↑C.u⁻¹ = C.s * a * C.t := by
  conv_lhs => rw [← ha]
  simp only [s, t, mul_assoc]

/-! ### The correction `r` -/

/-- `r = 1 - ∑_{j=1}^3 f_{-j,-j} + f_{-2,-1} + f_{-3,-2} + f_{-1,-3}` (tex 1560–1563). -/
def r : R :=
  1 - C.f (-1) (-1) - C.f (-2) (-2) - C.f (-3) (-3) + C.f (-2) (-1) + C.f (-3) (-2) +
    C.f (-1) (-3)

/-- The inverse cycle `-1 ↦ -3 ↦ -2 ↦ -1`. -/
def rInv : R :=
  1 - C.f (-1) (-1) - C.f (-2) (-2) - C.f (-3) (-3) + C.f (-1) (-2) + C.f (-2) (-3) +
    C.f (-3) (-1)

theorem r_mul_rInv : C.r * C.rInv = 1 := by
  simp only [r, rInv, mul_add, add_mul, mul_sub, sub_mul, one_mul, mul_one, C.f_mul_f]
  norm_num
  abel

theorem rInv_mul_r : C.rInv * C.r = 1 := by
  simp only [r, rInv, mul_add, add_mul, mul_sub, sub_mul, one_mul, mul_one, C.f_mul_f]
  norm_num
  abel

/-- `r` as a unit. -/
def rUnit : Rˣ := ⟨C.r, C.rInv, C.r_mul_rInv, C.rInv_mul_r⟩

theorem r_mul_rInv_cancel_left (x : R) : C.r * (C.rInv * x) = x := by
  rw [← mul_assoc, C.r_mul_rInv, one_mul]

theorem rInv_mul_r_cancel_left (x : R) : C.rInv * (C.r * x) = x := by
  rw [← mul_assoc, C.rInv_mul_r, one_mul]

/-- "The correction $r$ acts outside $P$" (tex 1566): `r a = a` on the corner. -/
theorem r_mul_corner {a : R} (ha : C.p * a * C.p = a) : C.r * a = a := by
  simp only [r, add_mul, sub_mul, one_mul, C.f_mul_corner ha (-1) (by norm_num : (-1 : ℤ) < 0),
    C.f_mul_corner ha (-2) (by norm_num : (-1 : ℤ) < 0),
    C.f_mul_corner ha (-2) (by norm_num : (-2 : ℤ) < 0),
    C.f_mul_corner ha (-3) (by norm_num : (-3 : ℤ) < 0),
    C.f_mul_corner ha (-3) (by norm_num : (-2 : ℤ) < 0),
    C.f_mul_corner ha (-1) (by norm_num : (-3 : ℤ) < 0)]
  abel

theorem corner_mul_r {a : R} (ha : C.p * a * C.p = a) : a * C.r = a := by
  simp only [r, mul_add, mul_sub, mul_one, C.corner_mul_f ha (by norm_num : (-1 : ℤ) < 0),
    C.corner_mul_f ha (by norm_num : (-2 : ℤ) < 0), C.corner_mul_f ha (by norm_num : (-3 : ℤ) < 0)]
  abel

theorem rInv_mul_corner {a : R} (ha : C.p * a * C.p = a) : C.rInv * a = a := by
  simp only [rInv, add_mul, sub_mul, one_mul,
    C.f_mul_corner ha (-1) (by norm_num : (-1 : ℤ) < 0),
    C.f_mul_corner ha (-2) (by norm_num : (-2 : ℤ) < 0),
    C.f_mul_corner ha (-3) (by norm_num : (-3 : ℤ) < 0),
    C.f_mul_corner ha (-1) (by norm_num : (-2 : ℤ) < 0),
    C.f_mul_corner ha (-2) (by norm_num : (-3 : ℤ) < 0),
    C.f_mul_corner ha (-3) (by norm_num : (-1 : ℤ) < 0)]
  abel

theorem corner_mul_rInv {a : R} (ha : C.p * a * C.p = a) : a * C.rInv = a := by
  simp only [rInv, mul_add, mul_sub, mul_one, C.corner_mul_f ha (by norm_num : (-1 : ℤ) < 0),
    C.corner_mul_f ha (by norm_num : (-2 : ℤ) < 0), C.corner_mul_f ha (by norm_num : (-3 : ℤ) < 0)]
  abel

/-- `r f_{-1,b} = f_{-2,b}`: `r` sends level `-1` to level `-2`. -/
theorem r_mul_f_neg_one (b : ℤ) : C.r * C.f (-1) b = C.f (-2) b := by
  simp only [r, add_mul, sub_mul, one_mul, C.f_mul_f]
  norm_num

/-- `f_{a,-3} r = f_{a,-2}`. -/
theorem f_neg_three_mul_r (a : ℤ) : C.f a (-3) * C.r = C.f a (-2) := by
  simp only [r, mul_add, mul_sub, mul_one, C.f_mul_f]
  norm_num

end Cell

