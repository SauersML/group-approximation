import GroupApproximation.Algebra.PurelyInfiniteSimpleMatrix
import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.RingTheory.SimpleRing.Basic
import Mathlib.Algebra.BigOperators.Fin

/-!
# The idempotent form of pure infiniteness implies the sandwich form

`Algebra/PurelyInfiniteBridge.lean` proves *sandwich ⇒ idempotent*.  This module
proves the converse, which is the direction `AGPMenalMoncasiReduction` and
`AGPStepOne` need: both hypothesise `IsPurelyInfiniteSimpleRing` (the idempotent
form of Ara--Goodearl--Pardo, Definitions 1.2) while every tool that opens their
proofs — comparability above all — takes the sandwich clause.

Ara--Goodearl--Pardo reach this through their §1, whose centrepiece is that every
nonzero idempotent of a purely infinite simple ring is *properly* infinite.
**That is not needed.**  What follows is elementary, and the reason is the shape
of the collapse.

## The route

Let `a ≠ 0`.  Pure infiniteness gives an idempotent `e = a * r` in `aR` that is
infinite: `e = f + g` with `f ⊥ g`, `f ~ e`, `g ≠ 0`.

*Normalise the equivalence.*  Replacing the witnesses `x, y` of `e = x*y`,
`f = y*x` by `e*x*f` and `f*y*e` produces `s, t` with

    `t * s = e`,  `s * t = f`,  and `e*s = s*e = s`, `e*t = t*e = t`.

Then `g = e - f` satisfies `g*s = 0` and `t*g = 0`: the two relations that make
the powers of `s` and `t` shift `g` off itself.

*Copies of `g`, not of `e`.*  Two orthogonal copies of `e` inside `e` would be
proper infiniteness and is exactly what we do not have.  But `g` has as many
orthogonal copies as we like, `s^k g t^k`, and that is enough, because

    `(g * t^(i+1)) * e * (s^(j+1) * g) = if i = j then g else 0`.

*The collapse.*  Simplicity makes the two-sided ideal generated by `g` the whole
ring, so `1` is a finite sum `∑ aᵢ * g * bᵢ`.  Feeding the copies in,

    `X = ∑ aᵢ * (g * t^(i+1))`,   `Y = ∑ (s^(j+1) * g) * bᵢ`

gives `X * e * Y = ∑ aᵢ * g * bᵢ = 1`, and then `X * a * (r * Y) = 1`.

So the finite sum from simplicity is collapsed by orthogonality of the copies —
one sandwich, no comparison theory, no proper infiniteness.

## What is genuinely used

`IsSimpleRing` only through `TwoSidedIdeal.span {g} = ⊤`, and infiniteness of `e`
only through the single decomposition `e = f + g`.  Nothing iterates the
decomposition and nothing needs `e` to dominate two disjoint copies of itself.
-/

namespace GroupApproximation
namespace MFQuotientUnits

open scoped Pointwise

section Sandwich

variable {R : Type*} [Ring R]

/-! ### Finite sums of two-sided multiples -/

/-- `z` is a finite sum `∑ aᵢ * g * bᵢ`. -/
def IsFiniteMultipleSum (g z : R) : Prop :=
  ∃ (n : ℕ) (a b : Fin n → R), z = ∑ i, a i * g * b i

theorem isFiniteMultipleSum_zero (g : R) : IsFiniteMultipleSum g 0 :=
  ⟨0, Fin.elim0, Fin.elim0, by simp⟩

theorem isFiniteMultipleSum_add {g z w : R} (hz : IsFiniteMultipleSum g z)
    (hw : IsFiniteMultipleSum g w) : IsFiniteMultipleSum g (z + w) := by
  obtain ⟨n, a, b, rfl⟩ := hz
  obtain ⟨m, c, d, rfl⟩ := hw
  refine ⟨n + m, Fin.append a c, Fin.append b d, ?_⟩
  rw [Fin.sum_univ_add]
  congr 1
  · exact Finset.sum_congr rfl fun i _ => by rw [Fin.append_left, Fin.append_left]
  · exact Finset.sum_congr rfl fun i _ => by
      rw [Fin.append_right, Fin.append_right]

theorem isFiniteMultipleSum_neg {g z : R} (hz : IsFiniteMultipleSum g z) :
    IsFiniteMultipleSum g (-z) := by
  obtain ⟨n, a, b, rfl⟩ := hz
  refine ⟨n, fun i => -a i, b, ?_⟩
  simp

/-- The finite sums of two-sided multiples of `g`, as an additive subgroup. -/
def multipleSumSubgroup (g : R) : AddSubgroup R where
  carrier := {z | IsFiniteMultipleSum g z}
  zero_mem' := isFiniteMultipleSum_zero g
  add_mem' := isFiniteMultipleSum_add
  neg_mem' := isFiniteMultipleSum_neg

/-- **Simplicity gives a finite representation.**  In a simple ring every element,
`1` included, is a finite sum of two-sided multiples of any nonzero `g`. -/
theorem isFiniteMultipleSum_one_of_isSimpleRing [IsSimpleRing R] {g : R}
    (hg : g ≠ 0) : IsFiniteMultipleSum g 1 := by
  have hspan : TwoSidedIdeal.span ({g} : Set R) = ⊤ := by
    rcases IsSimpleRing.simple.eq_bot_or_eq_top
      (TwoSidedIdeal.span ({g} : Set R)) with h | h
    · exfalso
      apply hg
      have hmem : g ∈ TwoSidedIdeal.span ({g} : Set R) :=
        TwoSidedIdeal.subset_span rfl
      rw [h] at hmem
      simpa using hmem
    · exact h
  have hone : (1 : R) ∈ TwoSidedIdeal.span ({g} : Set R) := by
    rw [hspan]
    trivial
  rw [TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hone
  have hle : AddSubgroup.closure (Set.univ * ({g} : Set R) * Set.univ)
      ≤ multipleSumSubgroup g := by
    rw [AddSubgroup.closure_le]
    rintro z ⟨p, ⟨u, -, y, hy, rfl⟩, v, -, rfl⟩
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact ⟨1, fun _ => u, fun _ => v, by simp⟩
  exact hle hone

/-! ### The shifted copies of `g` -/

variable {e f g s t : R}

theorem pow_mul_self_eq (hts : t * s = e) (hes : e * s = s) :
    ∀ i : ℕ, t ^ (i + 1) * s ^ (i + 1) = e := by
  have hpow : ∀ m : ℕ, e * s ^ (m + 1) = s ^ (m + 1) := by
    intro m
    induction m with
    | zero => simpa using hes
    | succ j ihj => rw [pow_succ' s, ← mul_assoc, hes]
  intro i
  induction i with
  | zero => simpa using hts
  | succ i ih =>
      have h1 : t ^ (i + 2) = t ^ (i + 1) * t := pow_succ t (i + 1)
      have h2 : s ^ (i + 2) = s * s ^ (i + 1) := pow_succ' s (i + 1)
      rw [h1, h2, mul_assoc, ← mul_assoc t s, hts, hpow i]
      exact ih

theorem mul_pow_eq_zero_left (hgs : g * s = 0) :
    ∀ m : ℕ, g * s ^ (m + 1) = 0 := by
  intro m
  rw [pow_succ' s, ← mul_assoc, hgs, zero_mul]

theorem pow_mul_eq_zero_right (htg : t * g = 0) :
    ∀ m : ℕ, t ^ (m + 1) * g = 0 := by
  intro m
  rw [pow_succ, mul_assoc, htg, mul_zero]


/-! ### Normalising the equivalence to an isometry pair -/

/-- Replacing the witnesses of `e ~ f` by `e*x*f` and `f*y*e` produces an
isometry pair inside the corner: `t*s = e`, `s*t = f`, and both fixed by `e`. -/
theorem exists_normalized_isometry {e f : R} (he : IsIdempotentElem e)
    (hf : IsIdempotentElem f) (hef : e * f = f) (hfe : f * e = f)
    (hequiv : IsEquivalentIdempotent R e f) :
    ∃ s t : R, t * s = e ∧ s * t = f ∧
      e * s = s ∧ s * e = s ∧ e * t = t ∧ t * e = t := by
  obtain ⟨x, y, hex, hfy⟩ := hequiv
  have hxfy : x * f * y = e := by
    have h1 : x * f * y = x * y * (x * y) := by rw [hfy]; noncomm_ring
    rw [h1, ← hex]; exact he
  have hyex : y * e * x = f := by
    have h1 : y * e * x = y * x * (y * x) := by rw [hex]; noncomm_ring
    rw [h1, ← hfy]; exact hf
  refine ⟨f * y * e, e * x * f, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have h1 : e * x * f * (f * y * e) = e * (x * (f * f) * y) * e := by
      noncomm_ring
    have h2 : e * (x * f * y) * e = e * e * e := by rw [hxfy]
    rw [h1, hf, h2, he, he]
  · have h1 : f * y * e * (e * x * f) = f * (y * (e * e) * x) * f := by
      noncomm_ring
    have h2 : f * (y * e * x) * f = f * f * f := by rw [hyex]
    rw [h1, he, h2, hf, hf]
  · have h1 : e * (f * y * e) = e * f * y * e := by noncomm_ring
    rw [h1, hef]
  · have h1 : f * y * e * e = f * y * (e * e) := by noncomm_ring
    rw [h1, he]
  · have h1 : e * (e * x * f) = e * e * x * f := by noncomm_ring
    rw [h1, he]
  · have h1 : e * x * f * e = e * x * (f * e) := by noncomm_ring
    rw [h1, hfe]

/-! ### Orthogonality of the shifted copies of `g` -/

/-- **The copies are orthogonal across the `e`-sandwich.**  This is what lets a
finite sum collapse to a single sandwich, and it is where `g*s = 0` and
`t*g = 0` are spent. -/
theorem shifted_copy_orthogonal
    (hts : t * s = e) (hes : e * s = s) (hte : t * e = t)
    (hgs : g * s = 0) (htg : t * g = 0) (hge : g * e = g) (heg : e * g = g)
    (hgg : IsIdempotentElem g) (i j : ℕ) :
    (g * t ^ (i + 1)) * e * (s ^ (j + 1) * g) = if i = j then g else 0 := by
  have hpowte : ∀ m : ℕ, t ^ (m + 1) * e = t ^ (m + 1) := by
    intro m
    induction m with
    | zero => simpa using hte
    | succ n ihn => rw [pow_succ, mul_assoc, hte]
  have hstrip : (g * t ^ (i + 1)) * e * (s ^ (j + 1) * g)
      = g * (t ^ (i + 1) * s ^ (j + 1)) * g := by
    have h1 : (g * t ^ (i + 1)) * e = g * (t ^ (i + 1) * e) := by noncomm_ring
    rw [h1, hpowte i]
    noncomm_ring
  rw [hstrip]
  rcases lt_trichotomy i j with hlt | heq | hgt
  · rw [if_neg (by omega)]
    have hsplit : s ^ (j + 1) = s ^ (i + 1) * s ^ (j - i) := by
      rw [← pow_add]; congr 1; omega
    have hje : j - i = (j - i - 1) + 1 := by omega
    have hz : g * s ^ (j - i) = 0 := by
      rw [hje]; exact mul_pow_eq_zero_left hgs (j - i - 1)
    calc g * (t ^ (i + 1) * s ^ (j + 1)) * g
        = g * (t ^ (i + 1) * (s ^ (i + 1) * s ^ (j - i))) * g := by rw [hsplit]
      _ = g * (t ^ (i + 1) * s ^ (i + 1) * s ^ (j - i)) * g := by noncomm_ring
      _ = g * (e * s ^ (j - i)) * g := by rw [pow_mul_self_eq hts hes i]
      _ = g * e * s ^ (j - i) * g := by noncomm_ring
      _ = g * s ^ (j - i) * g := by rw [hge]
      _ = 0 := by rw [hz, zero_mul]
  · subst heq
    rw [if_pos rfl, pow_mul_self_eq hts hes i]
    calc g * e * g = g * g := by rw [hge]
      _ = g := hgg
  · rw [if_neg (by omega)]
    have hsplit : t ^ (i + 1) = t ^ (i - j) * t ^ (j + 1) := by
      rw [← pow_add]; congr 1; omega
    have hij : i - j = (i - j - 1) + 1 := by omega
    have hz : t ^ (i - j) * g = 0 := by
      rw [hij]; exact pow_mul_eq_zero_right htg (i - j - 1)
    calc g * (t ^ (i + 1) * s ^ (j + 1)) * g
        = g * (t ^ (i - j) * t ^ (j + 1) * s ^ (j + 1)) * g := by rw [hsplit]
      _ = g * (t ^ (i - j) * (t ^ (j + 1) * s ^ (j + 1))) * g := by noncomm_ring
      _ = g * (t ^ (i - j) * e) * g := by rw [pow_mul_self_eq hts hes j]
      _ = g * (t ^ (i - j) * (e * g)) := by noncomm_ring
      _ = g * (t ^ (i - j) * g) := by rw [heg]
      _ = 0 := by rw [hz, mul_zero]


/-! ### The collapse, and the endpoint -/

/-- **A finite sum of two-sided multiples of `g` is a single `e`-sandwich.**
The double sum collapses because the shifted copies are orthogonal. -/
theorem exists_sandwich_of_finiteMultipleSum
    (hts : t * s = e) (hes : e * s = s) (hte : t * e = t)
    (hgs : g * s = 0) (htg : t * g = 0) (hge : g * e = g) (heg : e * g = g)
    (hgg : IsIdempotentElem g) {z : R} (hz : IsFiniteMultipleSum g z) :
    ∃ x y : R, x * e * y = z := by
  obtain ⟨n, a, b, rfl⟩ := hz
  refine ⟨∑ i : Fin n, a i * (g * t ^ ((i : ℕ) + 1)),
    ∑ j : Fin n, s ^ ((j : ℕ) + 1) * g * b j, ?_⟩
  calc (∑ i : Fin n, a i * (g * t ^ ((i : ℕ) + 1))) * e *
        (∑ j : Fin n, s ^ ((j : ℕ) + 1) * g * b j)
      = ∑ i : Fin n, ∑ j : Fin n, a i * (g * t ^ ((i : ℕ) + 1)) * e *
          (s ^ ((j : ℕ) + 1) * g * b j) := by
        rw [Finset.sum_mul, Finset.sum_mul]
        exact Finset.sum_congr rfl fun i _ => Finset.mul_sum _ _ _
    _ = ∑ i : Fin n, ∑ j : Fin n, a i *
          ((g * t ^ ((i : ℕ) + 1)) * e * (s ^ ((j : ℕ) + 1) * g)) * b j :=
        Finset.sum_congr rfl fun i _ =>
          Finset.sum_congr rfl fun j _ => by noncomm_ring
    _ = ∑ i : Fin n, ∑ j : Fin n,
          a i * (if (i : ℕ) = (j : ℕ) then g else 0) * b j :=
        Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by
          rw [shifted_copy_orthogonal hts hes hte hgs htg hge heg hgg]
    _ = ∑ i : Fin n, a i * g * b i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.sum_eq_single i]
        · simp
        · intro j _ hji
          have hne : (i : ℕ) ≠ (j : ℕ) := fun h => hji (Fin.ext h.symm)
          rw [if_neg hne]
          simp
        · intro h
          exact absurd (Finset.mem_univ i) h

/-- **The idempotent form of pure infiniteness implies the sandwich form.**

Every nonzero element of a purely infinite simple ring sandwiches to the unit.
Ara--Goodearl--Pardo obtain this through their §1; the proof below uses only the
single decomposition `e = f + g` of one infinite idempotent, and simplicity. -/
theorem exists_sandwich_of_isPurelyInfiniteSimpleRing
    (hR : IsPurelyInfiniteSimpleRing R) {a : R} (ha : a ≠ 0) :
    ∃ x y : R, x * a * y = 1 := by
  haveI : IsSimpleRing R := hR.1
  obtain ⟨e, r, her, he, hinf⟩ := hR.exists_infiniteIdempotent ha
  obtain ⟨f, g, hf, hg, hfg, hgf, hsum, hequiv, hgne⟩ := hinf
  -- `f` and `g` sit below `e`
  have hef : e * f = f := by rw [hsum, add_mul, hf, hgf, add_zero]
  have hfe : f * e = f := by rw [hsum, mul_add, hf, hfg, add_zero]
  have hge : g * e = g := by rw [hsum, mul_add, hgf, hg, zero_add]
  have heg : e * g = g := by rw [hsum, add_mul, hfg, hg, zero_add]
  -- normalise the equivalence `e ~ f` to an isometry pair
  obtain ⟨s, t, hts, hst, hes, hse, het, hte⟩ :=
    exists_normalized_isometry he hf hef hfe hequiv
  -- `g` is annihilated on the correct sides
  have hfs : f * s = s := by
    calc f * s = s * t * s := by rw [hst]
      _ = s * (t * s) := by noncomm_ring
      _ = s * e := by rw [hts]
      _ = s := hse
  have htf : t * f = t := by
    calc t * f = t * (s * t) := by rw [hst]
      _ = t * s * t := by noncomm_ring
      _ = e * t := by rw [hts]
      _ = t := het
  have hgs : g * s = 0 := by
    have h1 : e * s = f * s + g * s := by rw [hsum, add_mul]
    rw [hes, hfs] at h1
    have h3 : s + g * s = s + 0 := by rw [add_zero, ← h1]
    exact add_left_cancel h3
  have htg : t * g = 0 := by
    have h1 : t * e = t * f + t * g := by rw [hsum, mul_add]
    rw [hte, htf] at h1
    have h3 : t + t * g = t + 0 := by rw [add_zero, ← h1]
    exact add_left_cancel h3
  -- simplicity gives a finite representation of `1`, and the copies collapse it
  obtain ⟨X, Y, hXY⟩ := exists_sandwich_of_finiteMultipleSum hts hes hte hgs htg
    hge heg hg (isFiniteMultipleSum_one_of_isSimpleRing hgne)
  refine ⟨X, r * Y, ?_⟩
  calc X * a * (r * Y) = X * (a * r) * Y := by noncomm_ring
    _ = X * e * Y := by rw [← her]
    _ = 1 := hXY

end Sandwich

end MFQuotientUnits
