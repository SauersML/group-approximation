/-! ## The ring `ℤ[1/2]` -/

/-- A rational number is *dyadic* when it can be written `k / 2 ^ n` with
`k : ℤ` and `n : ℕ`. -/
def IsDyadic (q : ℚ) : Prop := ∃ (k : ℤ) (n : ℕ), q = (k : ℚ) / 2 ^ n

/-- Every integer is dyadic. -/
theorem isDyadic_intCast (k : ℤ) : IsDyadic (k : ℚ) := ⟨k, 0, by norm_num⟩

/-- `0` is dyadic. -/
theorem isDyadic_zero : IsDyadic 0 := ⟨0, 0, by norm_num⟩

/-- `1` is dyadic. -/
theorem isDyadic_one : IsDyadic 1 := ⟨1, 0, by norm_num⟩

/-- `2` is dyadic. -/
theorem isDyadic_two : IsDyadic 2 := ⟨2, 0, by norm_num⟩

/-- `1/2` is dyadic. -/
theorem isDyadic_half : IsDyadic (2 : ℚ)⁻¹ := ⟨1, 1, by norm_num⟩

/-- The dyadic rationals are closed under addition: bring the two
representations to the common denominator `2 ^ (n + m)`. -/
theorem isDyadic_add {q r : ℚ} (hq : IsDyadic q) (hr : IsDyadic r) :
    IsDyadic (q + r) := by
  obtain ⟨k, n, rfl⟩ := hq
  obtain ⟨l, m, rfl⟩ := hr
  have hn : ((2 : ℚ)) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
  have hm : ((2 : ℚ)) ^ m ≠ 0 := pow_ne_zero _ (by norm_num)
  refine ⟨k * 2 ^ m + 2 ^ n * l, n + m, ?_⟩
  push_cast
  rw [pow_add, div_add_div _ _ hn hm]

/-- The dyadic rationals are closed under multiplication. -/
theorem isDyadic_mul {q r : ℚ} (hq : IsDyadic q) (hr : IsDyadic r) :
    IsDyadic (q * r) := by
  obtain ⟨k, n, rfl⟩ := hq
  obtain ⟨l, m, rfl⟩ := hr
  refine ⟨k * l, n + m, ?_⟩
  push_cast
  rw [pow_add, div_mul_div_comm]

/-- The dyadic rationals are closed under negation. -/
theorem isDyadic_neg {q : ℚ} (hq : IsDyadic q) : IsDyadic (-q) := by
  obtain ⟨k, n, rfl⟩ := hq
  refine ⟨-k, n, ?_⟩
  push_cast
  rw [neg_div]

/-- The dyadic rationals are closed under halving. -/
theorem isDyadic_div_two {q : ℚ} (hq : IsDyadic q) : IsDyadic (q / 2) := by
  obtain ⟨k, n, rfl⟩ := hq
  refine ⟨k, n + 1, ?_⟩
  rw [pow_succ, div_div]

/-- **`ℤ[1/2]`**, the ring of dyadic rationals, as a subring of `ℚ`. -/
def dyadicSubring : Subring ℚ where
  carrier := {q : ℚ | IsDyadic q}
  zero_mem' := isDyadic_zero
  one_mem' := isDyadic_one
  add_mem' := isDyadic_add
  mul_mem' := isDyadic_mul
  neg_mem' := isDyadic_neg

/-- Membership in `ℤ[1/2]` is exactly dyadicity. -/
theorem mem_dyadicSubring {q : ℚ} : q ∈ dyadicSubring ↔ IsDyadic q := Iff.rfl

/-- The type of dyadic rationals. -/
abbrev Dyadic : Type := ↥dyadicSubring

/-- The underlying rational of a dyadic rational is dyadic. -/
theorem isDyadic_coe (x : Dyadic) : IsDyadic (x : ℚ) :=
  mem_dyadicSubring.mp x.property

/-- The two-existential form of membership, convenient for destructuring. -/
theorem exists_rep (x : Dyadic) : ∃ (k : ℤ) (n : ℕ), (x : ℚ) = (k : ℚ) / 2 ^ n :=
  isDyadic_coe x

/-- **`ℤ[1/2]` is the subring of `ℚ` generated by `1/2`.**  This is the
identification behind the notation: the smallest subring of `ℚ` containing
`1/2` consists exactly of the fractions `k / 2 ^ n`. -/
theorem dyadicSubring_eq_closure :
    dyadicSubring = Subring.closure {(2 : ℚ)⁻¹} := by
  apply le_antisymm
  · intro q hq
    obtain ⟨k, n, rfl⟩ := mem_dyadicSubring.mp hq
    have hhalf : (2 : ℚ)⁻¹ ∈ Subring.closure {(2 : ℚ)⁻¹} :=
      Subring.subset_closure (Set.mem_singleton _)
    have hk : ((k : ℚ)) ∈ Subring.closure {(2 : ℚ)⁻¹} := intCast_mem _ k
    have hpow : ((2 : ℚ)⁻¹) ^ n ∈ Subring.closure {(2 : ℚ)⁻¹} := pow_mem hhalf n
    have hq' : ((k : ℚ)) / 2 ^ n = (k : ℚ) * ((2 : ℚ)⁻¹) ^ n := by
      rw [div_eq_mul_inv, ← inv_pow]
    rw [hq']
    exact mul_mem hk hpow
  · refine Subring.closure_le.mpr ?_
    rw [Set.singleton_subset_iff]
    show IsDyadic ((2 : ℚ)⁻¹)
    exact isDyadic_half

/-! ## Distinguished dyadic rationals, doubling and halving -/

/-- The integer `k`, as a dyadic rational. -/
def ofInt (k : ℤ) : Dyadic :=
  ⟨(k : ℚ), mem_dyadicSubring.mpr (isDyadic_intCast k)⟩

/-- The underlying rational of `ofInt k` is `k`. -/
@[simp] theorem coe_ofInt (k : ℤ) : ((ofInt k : Dyadic) : ℚ) = (k : ℚ) := rfl

/-- The dyadic rational `k / 2 ^ n`. -/
def dyadicOf (k : ℤ) (n : ℕ) : Dyadic :=
  ⟨(k : ℚ) / 2 ^ n, mem_dyadicSubring.mpr ⟨k, n, rfl⟩⟩

/-- The underlying rational of `dyadicOf k n` is `k / 2 ^ n`. -/
@[simp] theorem coe_dyadicOf (k : ℤ) (n : ℕ) :
    ((dyadicOf k n : Dyadic) : ℚ) = (k : ℚ) / 2 ^ n := rfl

/-- Denominator `2 ^ 0` is no denominator at all. -/
theorem dyadicOf_zero_exp (k : ℤ) : dyadicOf k 0 = ofInt k := by
  apply Subtype.ext
  show (k : ℚ) / 2 ^ (0 : ℕ) = (k : ℚ)
  norm_num

/-- The zero of `ℤ[1/2]`, written as a fraction. -/
theorem dyadicOf_zero_zero : dyadicOf 0 0 = 0 := by
  apply Subtype.ext
  show ((0 : ℤ) : ℚ) / 2 ^ (0 : ℕ) = (0 : ℚ)
  norm_num

/-- Halving numerator and denominator together. -/
theorem dyadicOf_two_succ (n : ℕ) : dyadicOf 2 (n + 1) = dyadicOf 1 n := by
  apply Subtype.ext
  show ((2 : ℤ) : ℚ) / 2 ^ (n + 1) = ((1 : ℤ) : ℚ) / 2 ^ n
  have h2n : ((2 : ℚ)) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
  have h2n' : ((2 : ℚ)) ^ (n + 1) ≠ 0 := pow_ne_zero _ (by norm_num)
  rw [div_eq_div_iff h2n' h2n, pow_succ]
  push_cast
  ring

/-- `k ↦ k / 2 ^ n`, as an additive homomorphism `ℤ →+ ℤ[1/2]`. -/
def dyadicOfHom (n : ℕ) : ℤ →+ Dyadic where
  toFun k := dyadicOf k n
  map_zero' := by
    apply Subtype.ext
    show ((0 : ℤ) : ℚ) / 2 ^ n = (0 : ℚ)
    norm_num
  map_add' k l := by
    apply Subtype.ext
    show ((k + l : ℤ) : ℚ) / 2 ^ n
      = ((k : ℤ) : ℚ) / 2 ^ n + ((l : ℤ) : ℚ) / 2 ^ n
    push_cast
    rw [add_div]

/-- Every dyadic rational with denominator `2 ^ n` is an integer multiple of
`1 / 2 ^ n`. -/
theorem zsmul_dyadicOf_one (k : ℤ) (n : ℕ) :
    k • dyadicOf 1 n = dyadicOf k n :=
  (AddMonoidHom.apply_int (f := dyadicOfHom n) (n := k)).symm

/-- `ℤ → ℤ[1/2]`, as an additive homomorphism. -/
def ofIntHom : ℤ →+ Dyadic where
  toFun := ofInt
  map_zero' := by
    apply Subtype.ext
    show ((0 : ℤ) : ℚ) = (0 : ℚ)
    norm_num
  map_add' k l := by
    apply Subtype.ext
    show ((k + l : ℤ) : ℚ) = ((k : ℤ) : ℚ) + ((l : ℤ) : ℚ)
    push_cast
    ring

/-- The integer `k` is `k` times the generator `1` of the copy of `ℤ` inside
`ℤ[1/2]`. -/
theorem zsmul_ofInt_one (k : ℤ) : k • ofInt 1 = ofInt k :=
  (AddMonoidHom.apply_int (f := ofIntHom) (n := k)).symm

/-- Doubling, as a map `ℤ[1/2] → ℤ[1/2]`. -/
def doubleFun (x : Dyadic) : Dyadic :=
  ⟨2 * (x : ℚ),
    mem_dyadicSubring.mpr (isDyadic_mul isDyadic_two (isDyadic_coe x))⟩

/-- Doubling, read in `ℚ`. -/
@[simp] theorem coe_doubleFun (x : Dyadic) :
    ((doubleFun x : Dyadic) : ℚ) = 2 * (x : ℚ) := rfl

/-- Halving, as a map `ℤ[1/2] → ℤ[1/2]`.  This is where the dyadic rationals
differ from their subgroup `ℤ`: doubling is surjective here. -/
def halveFun (x : Dyadic) : Dyadic :=
  ⟨(x : ℚ) / 2, mem_dyadicSubring.mpr (isDyadic_div_two (isDyadic_coe x))⟩

/-- Halving, read in `ℚ`. -/
@[simp] theorem coe_halveFun (x : Dyadic) :
    ((halveFun x : Dyadic) : ℚ) = (x : ℚ) / 2 := rfl

/-- Halving undoes doubling. -/
theorem halveFun_doubleFun (x : Dyadic) : halveFun (doubleFun x) = x := by
  apply Subtype.ext
  show (2 * (x : ℚ)) / 2 = (x : ℚ)
  ring

/-- Doubling undoes halving: this is the surjectivity of `×2`. -/
theorem doubleFun_halveFun (x : Dyadic) : doubleFun (halveFun x) = x := by
  apply Subtype.ext
  show 2 * ((x : ℚ) / 2) = (x : ℚ)
  ring

/-- Doubling is additive. -/
theorem doubleFun_add (x y : Dyadic) :
    doubleFun (x + y) = doubleFun x + doubleFun y := by
  apply Subtype.ext
  show 2 * ((x : ℚ) + (y : ℚ)) = 2 * (x : ℚ) + 2 * (y : ℚ)
  ring

/-- Halving raises the denominator by one. -/
theorem halveFun_dyadicOf (k : ℤ) (n : ℕ) :
    halveFun (dyadicOf k n) = dyadicOf k (n + 1) := by
  apply Subtype.ext
  show ((k : ℚ) / 2 ^ n) / 2 = (k : ℚ) / 2 ^ (n + 1)
  rw [pow_succ, div_div]

/-- **Doubling is an automorphism of the additive group `ℤ[1/2]`**, written
multiplicatively.  Injectivity is clear in `ℚ`; surjectivity is `halveFun`,
which is the whole point of inverting `2`. -/
def doublingAut : MulAut (Multiplicative Dyadic) where
  toFun x := Multiplicative.ofAdd (doubleFun x.toAdd)
  invFun x := Multiplicative.ofAdd (halveFun x.toAdd)
  left_inv x := by
    show Multiplicative.ofAdd (halveFun (doubleFun x.toAdd)) = x
    rw [halveFun_doubleFun]
    exact ofAdd_toAdd x
  right_inv x := by
    show Multiplicative.ofAdd (doubleFun (halveFun x.toAdd)) = x
    rw [doubleFun_halveFun]
    exact ofAdd_toAdd x
  map_mul' x y := by
    show Multiplicative.ofAdd (doubleFun (x * y).toAdd) =
      Multiplicative.ofAdd (doubleFun x.toAdd) *
        Multiplicative.ofAdd (doubleFun y.toAdd)
    rw [toAdd_mul, doubleFun_add, ofAdd_add]

/-- Evaluation of the doubling automorphism. -/
@[simp] theorem doublingAut_ofAdd (x : Dyadic) :
    doublingAut (Multiplicative.ofAdd x) = Multiplicative.ofAdd (doubleFun x) :=
  rfl

/-- Evaluation of the inverse doubling automorphism. -/
@[simp] theorem doublingAut_inv_ofAdd (x : Dyadic) :
    doublingAut⁻¹ (Multiplicative.ofAdd x) =
      Multiplicative.ofAdd (halveFun x) := rfl

/-! ## The literal affine group `ℤ[1/2] ⋊ ℤ` -/

/-- The `ℤ`-action on `ℤ[1/2]` by powers of doubling. -/
def actingHom : Multiplicative ℤ →* MulAut (Multiplicative Dyadic) :=
  zpowersHom _ doublingAut

/-- The action at `m` is the `m`-th power of doubling. -/
theorem actingHom_ofAdd (m : ℤ) :
    actingHom (Multiplicative.ofAdd m) = doublingAut ^ m := by
  rw [actingHom, zpowersHom_apply, toAdd_ofAdd]

/-- The action at the generator of `ℤ` is doubling. -/
theorem actingHom_ofAdd_one :
    actingHom (Multiplicative.ofAdd (1 : ℤ)) = doublingAut := by
  rw [actingHom_ofAdd, zpow_one]

/-- Pointwise form of `actingHom_ofAdd_one`. -/
theorem actingHom_ofAdd_one_apply (x : Multiplicative Dyadic) :
    actingHom (Multiplicative.ofAdd (1 : ℤ)) x = doublingAut x := by
  rw [actingHom_ofAdd_one]

/-- **The literal affine group** `ℤ[1/2] ⋊ ℤ`: the manuscript's `BS(1,2)`,
with `ℤ` acting on the dyadic rationals by doubling. -/
abbrev Affine : Type :=
  SemidirectProduct (Multiplicative Dyadic) (Multiplicative ℤ) actingHom

/-- The translation generator `γ₀`: translation by `1 ∈ ℤ[1/2]`. -/
def gammaZero : Affine :=
  SemidirectProduct.inl (Multiplicative.ofAdd (ofInt 1))

/-- The doubling stable letter `t`. -/
def tZero : Affine := SemidirectProduct.inr (Multiplicative.ofAdd (1 : ℤ))

/-- Left-factor elements conjugate by the doubling action. -/
theorem inr_mul_inl (g : Multiplicative ℤ) (x : Multiplicative Dyadic) :
    (SemidirectProduct.inr g * SemidirectProduct.inl x : Affine) =
      SemidirectProduct.inl (actingHom g x) * SemidirectProduct.inr g := by
  rw [SemidirectProduct.inl_aut, mul_assoc, ← map_mul, inv_mul_cancel,
    map_one, mul_one]

/-- **The Baumslag--Solitar relation holds in the affine model.** -/
theorem conj_gammaZero : tZero * gammaZero * tZero⁻¹ = gammaZero ^ 2 := by
  have h : tZero * gammaZero * tZero⁻¹ =
      SemidirectProduct.inl
        (actingHom (Multiplicative.ofAdd (1 : ℤ))
          (Multiplicative.ofAdd (ofInt 1))) := by
    rw [tZero, gammaZero, ← map_inv, SemidirectProduct.inl_aut]
  have hval : doubleFun (ofInt 1) = ofInt 1 + ofInt 1 := by
    apply Subtype.ext
    show (2 : ℚ) * ((1 : ℤ) : ℚ) = ((1 : ℤ) : ℚ) + ((1 : ℤ) : ℚ)
    norm_num
  rw [h, actingHom_ofAdd_one_apply, doublingAut_ofAdd, hval, ofAdd_add,
    gammaZero, ← map_pow, pow_two]

/-- Integer powers of the translation generator are the integer
translations. -/
theorem gammaZero_zpow (k : ℤ) :
    gammaZero ^ k = SemidirectProduct.inl (Multiplicative.ofAdd (ofInt k)) := by
  have h : (Multiplicative.ofAdd (ofInt 1)) ^ k =
      Multiplicative.ofAdd (ofInt k) := by
    rw [← ofAdd_zsmul, zsmul_ofInt_one]
  rw [gammaZero, ← map_zpow, h]

/-- Integer powers of the stable letter. -/
theorem tZero_zpow (m : ℤ) :
    tZero ^ m = SemidirectProduct.inr (Multiplicative.ofAdd m) := by
  have hm : m • (1 : ℤ) = m := by simp
  have h : (Multiplicative.ofAdd (1 : ℤ)) ^ m = Multiplicative.ofAdd m := by
    rw [← ofAdd_zsmul, hm]
  rw [tZero, ← map_zpow, h]

/-- Conjugating a translation by a power of the stable letter applies the
corresponding power of doubling. -/
theorem conj_inl (m : ℤ) (y : Multiplicative Dyadic) :
    tZero ^ m * SemidirectProduct.inl y * (tZero ^ m)⁻¹ =
      SemidirectProduct.inl (actingHom (Multiplicative.ofAdd m) y) := by
  rw [tZero_zpow, ← map_inv, SemidirectProduct.inl_aut]

/-- Conjugating a translation by `t⁻¹` halves it. -/
theorem tZero_inv_conj_inl (y : Multiplicative Dyadic) :
    tZero⁻¹ * SemidirectProduct.inl y * tZero =
      SemidirectProduct.inl (doublingAut⁻¹ y) := by
  have h := SemidirectProduct.inl_aut_inv (φ := actingHom)
    (Multiplicative.ofAdd (1 : ℤ)) y
  rw [actingHom_ofAdd_one] at h
  rw [tZero, ← map_inv]
  exact h.symm

/-! ## Ascending HNN words in an arbitrary group

Everything the affine group knows about `BS(1,2)` is carried by the words
`t⁻ⁿ aᵏ tⁿ`.  This section develops them in an arbitrary group with the
compression relation `t a t⁻¹ = a²`; it is the normal-form input to the
universal property below. -/

/-- The ascending-HNN word `t⁻ⁿ aᵏ tⁿ`.  In the affine model this is the
translation by `k / 2ⁿ`. -/
def hnnWord {H : Type*} [Group H] (t a : H) (k : ℤ) (n : ℕ) : H :=
  MulAut.conj ((t ^ n)⁻¹) (a ^ k)

/-- The HNN word, written out. -/
theorem hnnWord_eq {H : Type*} [Group H] (t a : H) (k : ℤ) (n : ℕ) :
    hnnWord t a k n = (t ^ n)⁻¹ * a ^ k * t ^ n := by
  rw [hnnWord, MulAut.conj_apply, inv_inv]

/-- Numerator `0` gives the trivial word. -/
theorem hnnWord_zero_num {H : Type*} [Group H] (t a : H) (n : ℕ) :
    hnnWord t a 0 n = 1 := by
  rw [hnnWord, zpow_zero, map_one]

/-- Denominator `2 ^ 0`: the word is a plain power of `a`. -/
theorem hnnWord_zero_exp {H : Type*} [Group H] (t a : H) (k : ℤ) :
    hnnWord t a k 0 = a ^ k := by
  rw [hnnWord_eq, pow_zero, inv_one, one_mul, mul_one]

/-- At a fixed denominator, numerators add. -/
theorem hnnWord_add_num {H : Type*} [Group H] (t a : H) (k l : ℤ) (n : ℕ) :
    hnnWord t a (k + l) n = hnnWord t a k n * hnnWord t a l n := by
  rw [hnnWord, hnnWord, hnnWord, zpow_add, map_mul]

/-- Raising the denominator by one is conjugation by `t⁻¹`. -/
theorem hnnWord_succ_exp {H : Type*} [Group H] (t a : H) (k : ℤ) (n : ℕ) :
    hnnWord t a k (n + 1) = t⁻¹ * hnnWord t a k n * t := by
  rw [hnnWord_eq, hnnWord_eq, pow_succ, mul_inv_rev]
  simp only [mul_assoc]

/-- Homomorphisms evaluate HNN words componentwise. -/
theorem map_hnnWord {H K : Type*} [Group H] [Group K] (f : H →* K) (t a : H)
    (k : ℤ) (n : ℕ) : f (hnnWord t a k n) = hnnWord (f t) (f a) k n := by
  rw [hnnWord_eq, hnnWord_eq, map_mul, map_mul, map_inv, map_pow, map_zpow]

/-- The compression relation, on all integer powers. -/
theorem conj_zpow_of_rel {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (k : ℤ) :
    t * a ^ k * t⁻¹ = a ^ (2 * k) := by
  have h2 : a ^ (2 : ℤ) = a ^ (2 : ℕ) := by rw [zpow_two, pow_two]
  calc t * a ^ k * t⁻¹ = (t * a * t⁻¹) ^ k := conj_zpow.symm
    _ = (a ^ (2 : ℕ)) ^ k := by rw [hrel]
    _ = (a ^ (2 : ℤ)) ^ k := by rw [h2]
    _ = a ^ ((2 : ℤ) * k) := (zpow_mul a 2 k).symm

/-- The compression relation, read as a halving rule. -/
theorem push_zpow_of_rel {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (k : ℤ) :
    t⁻¹ * a ^ (2 * k) * t = a ^ k := by
  have hconj : t * a ^ k * t⁻¹ = a ^ (2 * k) := conj_zpow_of_rel hrel k
  calc t⁻¹ * a ^ (2 * k) * t = t⁻¹ * (t * a ^ k * t⁻¹) * t := by rw [hconj]
    _ = t⁻¹ * t * a ^ k * (t⁻¹ * t) := by simp only [mul_assoc]
    _ = a ^ k := by rw [inv_mul_cancel, one_mul, mul_one]

/-- Doubling the numerator and the denominator does not change the word: this
is the well-definedness of `k / 2ⁿ ↦ t⁻ⁿ aᵏ tⁿ`. -/
theorem hnnWord_two_mul {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (k : ℤ) (n : ℕ) :
    hnnWord t a (2 * k) (n + 1) = hnnWord t a k n := by
  have hpush : t⁻¹ * a ^ (2 * k) * t = a ^ k := push_zpow_of_rel hrel k
  rw [hnnWord_eq, hnnWord_eq, pow_succ', mul_inv_rev]
  calc (t ^ n)⁻¹ * t⁻¹ * a ^ (2 * k) * (t * t ^ n)
      = (t ^ n)⁻¹ * (t⁻¹ * a ^ (2 * k) * t) * t ^ n := by simp only [mul_assoc]
    _ = (t ^ n)⁻¹ * a ^ k * t ^ n := by rw [hpush]

/-- Multiplying numerator and denominator by `2 ^ j`. -/
theorem hnnWord_shift {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (k : ℤ) (n j : ℕ) :
    hnnWord t a (k * 2 ^ j) (n + j) = hnnWord t a k n := by
  induction j with
  | zero => rw [pow_zero, mul_one, Nat.add_zero]
  | succ j ih =>
      have hnum : k * 2 ^ (j + 1) = 2 * (k * 2 ^ j) := by ring
      have hexp : n + (j + 1) = n + j + 1 := (Nat.add_assoc n j 1).symm
      rw [hnum, hexp, hnnWord_two_mul hrel, ih]

/-- **The word depends only on the dyadic rational `k / 2ⁿ`.** -/
theorem hnnWord_congr {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) {k l : ℤ} {n m : ℕ}
    (h : k * 2 ^ m = l * 2 ^ n) :
    hnnWord t a k n = hnnWord t a l m := by
  calc hnnWord t a k n = hnnWord t a (k * 2 ^ m) (n + m) :=
        (hnnWord_shift hrel k n m).symm
    _ = hnnWord t a (l * 2 ^ n) (m + n) := by rw [h, Nat.add_comm]
    _ = hnnWord t a l m := hnnWord_shift hrel l m n

/-- Conjugation by `t` doubles the dyadic rational. -/
theorem hnnWord_conj {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (k : ℤ) (n : ℕ) :
    t * hnnWord t a k n * t⁻¹ = hnnWord t a (2 * k) n := by
  have hc : Commute t (t ^ n) := (Commute.refl t).pow_right n
  have hcomm : t * (t ^ n)⁻¹ = (t ^ n)⁻¹ * t := hc.inv_right.eq
  have hcomm' : t ^ n * t⁻¹ = t⁻¹ * t ^ n := hc.symm.inv_right.eq
  rw [hnnWord_eq, hnnWord_eq]
  calc t * ((t ^ n)⁻¹ * a ^ k * t ^ n) * t⁻¹
      = t * (t ^ n)⁻¹ * a ^ k * (t ^ n * t⁻¹) := by simp only [mul_assoc]
    _ = (t ^ n)⁻¹ * t * a ^ k * (t⁻¹ * t ^ n) := by rw [hcomm, hcomm']
    _ = (t ^ n)⁻¹ * (t * a ^ k * t⁻¹) * t ^ n := by simp only [mul_assoc]
    _ = (t ^ n)⁻¹ * a ^ (2 * k) * t ^ n := by rw [conj_zpow_of_rel hrel k]

/-- The affine model realizes the HNN word as the translation by `k / 2ⁿ`. -/
theorem hnnWord_affine (k : ℤ) (n : ℕ) :
    hnnWord tZero gammaZero k n =
      SemidirectProduct.inl (Multiplicative.ofAdd (dyadicOf k n)) := by
  induction n with
  | zero =>
      rw [hnnWord_zero_exp, gammaZero_zpow, dyadicOf_zero_exp]
  | succ n ih =>
      rw [hnnWord_succ_exp, ih, tZero_inv_conj_inl, doublingAut_inv_ofAdd,
        halveFun_dyadicOf]

/-! ## The universal property of `ℤ[1/2] ⋊ ℤ` -/

/-- A chosen numerator for a dyadic rational. -/
noncomputable def repNum (x : Dyadic) : ℤ := (exists_rep x).choose

/-- A chosen exponent for a dyadic rational. -/
noncomputable def repExp (x : Dyadic) : ℕ := (exists_rep x).choose_spec.choose

/-- The chosen numerator and exponent do represent the element. -/
theorem rep_spec (x : Dyadic) : (x : ℚ) = (repNum x : ℚ) / 2 ^ repExp x :=
  (exists_rep x).choose_spec.choose_spec

/-- The element of `H` attached to a dyadic rational by a compression pair
`(t, a)`. -/
noncomputable def dyadicElt {H : Type*} [Group H] (t a : H) (x : Dyadic) : H :=
  hnnWord t a (repNum x) (repExp x)

/-- The attached element can be computed from *any* representation. -/
theorem dyadicElt_eq {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (x : Dyadic) (k : ℤ) (n : ℕ)
    (hx : (x : ℚ) = (k : ℚ) / 2 ^ n) :
    dyadicElt t a x = hnnWord t a k n := by
  show hnnWord t a (repNum x) (repExp x) = hnnWord t a k n
  refine hnnWord_congr hrel ?_
  have hval : ((repNum x : ℚ)) / 2 ^ repExp x = (k : ℚ) / 2 ^ n := by
    rw [← rep_spec x, hx]
  have hn : ((2 : ℚ)) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
  have he : ((2 : ℚ)) ^ repExp x ≠ 0 := pow_ne_zero _ (by norm_num)
  have hq : ((repNum x : ℚ)) * 2 ^ n = (k : ℚ) * 2 ^ repExp x :=
    (div_eq_div_iff he hn).mp hval
  exact_mod_cast hq

/-- The element attached to the explicit fraction `k / 2 ^ n`. -/
theorem dyadicElt_dyadicOf {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (k : ℤ) (n : ℕ) :
    dyadicElt t a (dyadicOf k n) = hnnWord t a k n :=
  dyadicElt_eq hrel (dyadicOf k n) k n rfl

/-- **`ℤ[1/2]` maps to any group carrying the compression relation.** -/
noncomputable def dyadicHom {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) : Multiplicative Dyadic →* H where
  toFun x := dyadicElt t a x.toAdd
  map_one' := by
    show dyadicElt t a (0 : Dyadic) = 1
    rw [← dyadicOf_zero_zero, dyadicElt_dyadicOf hrel, hnnWord_zero_num]
  map_mul' x y := by
    obtain ⟨k, n, hx⟩ := exists_rep x.toAdd
    obtain ⟨l, m, hy⟩ := exists_rep y.toAdd
    have hn : ((2 : ℚ)) ^ n ≠ 0 := pow_ne_zero _ (by norm_num)
    have hm : ((2 : ℚ)) ^ m ≠ 0 := pow_ne_zero _ (by norm_num)
    have hxy : (((x * y).toAdd : Dyadic) : ℚ)
        = ((k * 2 ^ m + 2 ^ n * l : ℤ) : ℚ) / 2 ^ (n + m) := by
      have hsum : (((x * y).toAdd : Dyadic) : ℚ)
          = ((x.toAdd : Dyadic) : ℚ) + ((y.toAdd : Dyadic) : ℚ) := rfl
      rw [hsum, hx, hy]
      push_cast
      rw [pow_add, div_add_div _ _ hn hm]
    show dyadicElt t a ((x * y).toAdd)
      = dyadicElt t a x.toAdd * dyadicElt t a y.toAdd
    rw [dyadicElt_eq hrel _ _ _ hxy, dyadicElt_eq hrel _ _ _ hx,
      dyadicElt_eq hrel _ _ _ hy, hnnWord_add_num]
    congr 1
    · exact hnnWord_shift hrel k n m
    · have hcomm : (2 : ℤ) ^ n * l = l * 2 ^ n := mul_comm _ _
      rw [hcomm, Nat.add_comm n m]
      exact hnnWord_shift hrel l m n

/-- The homomorphism sends `k / 2 ^ n` to `t⁻ⁿ aᵏ tⁿ`. -/
theorem dyadicHom_dyadicOf {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (k : ℤ) (n : ℕ) :
    dyadicHom hrel (Multiplicative.ofAdd (dyadicOf k n)) = hnnWord t a k n :=
  dyadicElt_dyadicOf hrel k n

/-- The image of `1 ∈ ℤ[1/2]` is the compressed generator. -/
theorem dyadicHom_ofInt_one {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) :
    dyadicHom hrel (Multiplicative.ofAdd (ofInt 1)) = a := by
  have h : dyadicElt t a (ofInt 1) = hnnWord t a 1 0 := by
    refine dyadicElt_eq hrel (ofInt 1) 1 0 ?_
    show ((1 : ℤ) : ℚ) = ((1 : ℤ) : ℚ) / 2 ^ (0 : ℕ)
    norm_num
  show dyadicElt t a (ofInt 1) = a
  rw [h, hnnWord_zero_exp, zpow_one]

/-- The homomorphism turns doubling into conjugation by `t`. -/
theorem dyadicHom_doubling {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (x : Multiplicative Dyadic) :
    dyadicHom hrel (doublingAut x) = t * dyadicHom hrel x * t⁻¹ := by
  obtain ⟨k, n, hx⟩ := exists_rep x.toAdd
  have hd : (((doublingAut x).toAdd : Dyadic) : ℚ)
      = ((2 * k : ℤ) : ℚ) / 2 ^ n := by
    show (2 : ℚ) * ((x.toAdd : Dyadic) : ℚ) = ((2 * k : ℤ) : ℚ) / 2 ^ n
    rw [hx]
    push_cast
    ring
  show dyadicElt t a ((doublingAut x).toAdd)
    = t * dyadicElt t a x.toAdd * t⁻¹
  rw [dyadicElt_eq hrel _ _ _ hd, dyadicElt_eq hrel _ _ _ hx,
    hnnWord_conj hrel]

/-- The homomorphism turns halving into conjugation by `t⁻¹`. -/
theorem dyadicHom_doubling_inv {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (x : Multiplicative Dyadic) :
    dyadicHom hrel (doublingAut⁻¹ x) = t⁻¹ * dyadicHom hrel x * t := by
  have h := dyadicHom_doubling hrel (doublingAut⁻¹ x)
  rw [MulAut.apply_inv_self] at h
  calc dyadicHom hrel (doublingAut⁻¹ x)
      = t⁻¹ * t * dyadicHom hrel (doublingAut⁻¹ x) * (t⁻¹ * t) := by
        rw [inv_mul_cancel, one_mul, mul_one]
    _ = t⁻¹ * (t * dyadicHom hrel (doublingAut⁻¹ x) * t⁻¹) * t := by
        simp only [mul_assoc]
    _ = t⁻¹ * dyadicHom hrel x * t := by rw [h]

/-- The conjugation identity that assembles the semidirect product. -/
theorem dyadicHom_zpow_doubling {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (m : ℤ) :
    ∀ x : Multiplicative Dyadic,
      dyadicHom hrel ((doublingAut ^ m) x)
        = t ^ m * dyadicHom hrel x * (t ^ m)⁻¹ := by
  induction m with
  | zero => intro x; simp
  | succ i ih =>
      intro x
      have hstep : (doublingAut ^ ((i : ℤ) + 1)) x
          = (doublingAut ^ (i : ℤ)) (doublingAut x) := by
        rw [zpow_add_one, MulAut.mul_apply]
      have hT : t ^ ((i : ℤ) + 1) = t ^ (i : ℤ) * t := zpow_add_one t (i : ℤ)
      calc dyadicHom hrel ((doublingAut ^ ((i : ℤ) + 1)) x)
          = dyadicHom hrel ((doublingAut ^ (i : ℤ)) (doublingAut x)) := by
            rw [hstep]
        _ = t ^ (i : ℤ) * dyadicHom hrel (doublingAut x) * (t ^ (i : ℤ))⁻¹ :=
            ih _
        _ = t ^ (i : ℤ) * (t * dyadicHom hrel x * t⁻¹) * (t ^ (i : ℤ))⁻¹ := by
            rw [dyadicHom_doubling hrel x]
        _ = t ^ (i : ℤ) * t * dyadicHom hrel x * (t⁻¹ * (t ^ (i : ℤ))⁻¹) := by
            simp only [mul_assoc]
        _ = t ^ ((i : ℤ) + 1) * dyadicHom hrel x * (t ^ ((i : ℤ) + 1))⁻¹ := by
            rw [hT, mul_inv_rev]
  | pred i ih =>
      intro x
      have hstep : (doublingAut ^ (-(i : ℤ) - 1)) x
          = (doublingAut ^ (-(i : ℤ))) (doublingAut⁻¹ x) := by
        rw [zpow_sub_one, MulAut.mul_apply]
      have hT : t ^ (-(i : ℤ) - 1) = t ^ (-(i : ℤ)) * t⁻¹ :=
        zpow_sub_one t (-(i : ℤ))
      calc dyadicHom hrel ((doublingAut ^ (-(i : ℤ) - 1)) x)
          = dyadicHom hrel ((doublingAut ^ (-(i : ℤ))) (doublingAut⁻¹ x)) := by
            rw [hstep]
        _ = t ^ (-(i : ℤ)) * dyadicHom hrel (doublingAut⁻¹ x) *
              (t ^ (-(i : ℤ)))⁻¹ := ih _
        _ = t ^ (-(i : ℤ)) * (t⁻¹ * dyadicHom hrel x * t) *
              (t ^ (-(i : ℤ)))⁻¹ := by rw [dyadicHom_doubling_inv hrel x]
        _ = t ^ (-(i : ℤ)) * t⁻¹ * dyadicHom hrel x *
              (t * (t ^ (-(i : ℤ)))⁻¹) := by simp only [mul_assoc]
        _ = t ^ (-(i : ℤ) - 1) * dyadicHom hrel x *
              (t ^ (-(i : ℤ) - 1))⁻¹ := by rw [hT, mul_inv_rev, inv_inv]

/-- **The universal property of `ℤ[1/2] ⋊ ℤ`.**  Every pair `(t, a)` in a
group with `t a t⁻¹ = a²` extends to a homomorphism out of the literal affine
group.  This is the content that makes `BS(1,2) ≅ ℤ[1/2] ⋊ ℤ` a theorem rather
than a definition. -/
noncomputable def affineLift {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) : Affine →* H :=
  SemidirectProduct.lift (dyadicHom hrel) (zpowersHom H t) (by
    intro g
    apply MonoidHom.ext
    intro x
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
      zpowersHom_apply, actingHom]
    exact dyadicHom_zpow_doubling hrel g.toAdd x)

/-- The lift on the translation subgroup. -/
theorem affineLift_inl {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (x : Multiplicative Dyadic) :
    affineLift hrel (SemidirectProduct.inl x) = dyadicHom hrel x := by
  rw [affineLift, SemidirectProduct.lift_inl]

/-- The lift on the stable-letter subgroup. -/
theorem affineLift_inr {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) (z : Multiplicative ℤ) :
    affineLift hrel (SemidirectProduct.inr z) = t ^ z.toAdd := by
  rw [affineLift, SemidirectProduct.lift_inr, zpowersHom_apply]

/-- The lift sends the unit translation to `a`. -/
theorem affineLift_gammaZero {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) : affineLift hrel gammaZero = a := by
  rw [gammaZero, affineLift_inl, dyadicHom_ofInt_one hrel]

/-- The lift sends the stable letter to `t`. -/
theorem affineLift_tZero {H : Type*} [Group H] {t a : H}
    (hrel : t * a * t⁻¹ = a ^ 2) : affineLift hrel tZero = t := by
  rw [tZero, affineLift_inr, toAdd_ofAdd, zpow_one]

/-! ## `BS(1,2)` and the manuscript's identification -/

/-- The two letters of `BS(1,2)`: `a` and `t`. -/
abbrev BSGenerator := Fin 2

/-- The index of the compressed generator `a`. -/
abbrev aIndex : BSGenerator := 0

/-- The index of the stable letter `t`. -/
abbrev tIndex : BSGenerator := 1

/-- The letter `a`, as a free-group word. -/
abbrev aWord : FreeGroup BSGenerator := FreeGroup.of aIndex

/-- The letter `t`, as a free-group word. -/
abbrev tWord : FreeGroup BSGenerator := FreeGroup.of tIndex

/-- The single Baumslag--Solitar relator `t a t⁻¹ (a²)⁻¹`. -/
abbrev bsRelator : FreeGroup BSGenerator :=
  tWord * aWord * tWord⁻¹ * (aWord ^ 2)⁻¹

/-- The one-element relator set of `BS(1,2)`. -/
abbrev bsRelators : Finset (FreeGroup BSGenerator) := {bsRelator}

/-- **`BS(1,2) = ⟨a, t | t a t⁻¹ = a²⟩`**, the literal presented group. -/
abbrev BS : Type :=
  PresentedGroup
    ((bsRelators : Finset (FreeGroup BSGenerator)) : Set (FreeGroup BSGenerator))

/-- Evaluation of a free word in `BS(1,2)`. -/
abbrev evalWord : FreeGroup BSGenerator →* BS := PresentedGroup.mk _

/-- The compressed generator of `BS(1,2)`. -/
abbrev aGen : BS := evalWord aWord

/-- The stable letter of `BS(1,2)`. -/
abbrev tGen : BS := evalWord tWord

/-- `BS(1,2)` is finitely presented: one relator, two generators. -/
instance bs_isFinitelyPresented : Group.IsFinitelyPresented BS := inferInstance

/-- The defining relation of `BS(1,2)`. -/
theorem bs_relation : tGen * aGen * tGen⁻¹ = aGen ^ 2 := by
  apply mul_inv_eq_one.mp
  change evalWord bsRelator = 1
  apply PresentedGroup.one_of_mem
  simp

/-- The affine images of the two letters. -/
def affineGenerator : BSGenerator → Affine
  | 0 => gammaZero
  | 1 => tZero

/-- The affine image of the letter `a`. -/
@[simp] theorem affineGenerator_a : affineGenerator aIndex = gammaZero := rfl

/-- The affine image of the letter `t`. -/
@[simp] theorem affineGenerator_t : affineGenerator tIndex = tZero := rfl

/-- The affine images satisfy the Baumslag--Solitar relator. -/
theorem affine_kills_relators :
    ∀ r ∈ ((bsRelators : Finset (FreeGroup BSGenerator)) :
        Set (FreeGroup BSGenerator)),
      FreeGroup.lift affineGenerator r = 1 := by
  intro r hr
  have hr' : r = bsRelator := by simpa using hr
  subst hr'
  simpa only [bsRelator, aWord, tWord, map_mul, map_inv, map_pow,
    FreeGroup.lift_apply_of, affineGenerator_a, affineGenerator_t] using
      mul_inv_eq_one.mpr conj_gammaZero

/-- The affine realization of `BS(1,2)`. -/
def toAffine : BS →* Affine := PresentedGroup.toGroup affine_kills_relators

/-- The affine realization, on generators. -/
@[simp] theorem toAffine_of (i : BSGenerator) :
    toAffine (PresentedGroup.of i) = affineGenerator i :=
  PresentedGroup.toGroup.of _

/-- The affine realization of `a` is the unit translation. -/
theorem toAffine_aGen : toAffine aGen = gammaZero := toAffine_of aIndex

/-- The affine realization of `t` is the stable letter. -/
theorem toAffine_tGen : toAffine tGen = tZero := toAffine_of tIndex

/-- The inverse map, supplied by the universal property. -/
noncomputable def fromAffine : Affine →* BS := affineLift bs_relation

/-- The inverse map sends the unit translation to `a`. -/
theorem fromAffine_aGen : fromAffine gammaZero = aGen := by
  rw [fromAffine, affineLift_gammaZero bs_relation]

/-- The inverse map sends the stable letter to `t`. -/
theorem fromAffine_tGen : fromAffine tZero = tGen := by
  rw [fromAffine, affineLift_tZero bs_relation]

/-- The composite `BS(1,2) → Affine → BS(1,2)` is the identity. -/
theorem fromAffine_comp_toAffine :
    fromAffine.comp toAffine = MonoidHom.id BS := by
  apply PresentedGroup.ext
  intro i
  fin_cases i
  · exact (congrArg fromAffine (toAffine_of aIndex)).trans fromAffine_aGen
  · exact (congrArg fromAffine (toAffine_of tIndex)).trans fromAffine_tGen

/-- The composite `Affine → BS(1,2) → Affine` fixes every translation. -/
theorem toAffine_fromAffine_inl (x : Multiplicative Dyadic) :
    toAffine (fromAffine (SemidirectProduct.inl x)) =
      SemidirectProduct.inl x := by
  obtain ⟨k, n, hx⟩ := exists_rep x.toAdd
  have hval : x = Multiplicative.ofAdd (dyadicOf k n) := by
    apply Multiplicative.toAdd.injective
    apply Subtype.ext
    exact hx
  rw [fromAffine, affineLift_inl]
  show toAffine (dyadicElt tGen aGen x.toAdd) = SemidirectProduct.inl x
  rw [dyadicElt_eq bs_relation _ k n hx, map_hnnWord, toAffine_tGen,
    toAffine_aGen, hnnWord_affine, hval]

/-- The composite `Affine → BS(1,2) → Affine` fixes the stable letter. -/
theorem toAffine_fromAffine_inr (z : Multiplicative ℤ) :
    toAffine (fromAffine (SemidirectProduct.inr z)) =
      SemidirectProduct.inr z := by
  rw [fromAffine, affineLift_inr, map_zpow, toAffine_tGen, tZero_zpow,
    ofAdd_toAdd]

/-- The composite `Affine → BS(1,2) → Affine` is the identity. -/
theorem toAffine_comp_fromAffine :
    toAffine.comp fromAffine = MonoidHom.id Affine := by
  refine SemidirectProduct.hom_ext ?_ ?_
  · apply MonoidHom.ext
    intro x
    exact toAffine_fromAffine_inl x
  · apply MonoidHom.ext
    intro z
    exact toAffine_fromAffine_inr z

/-- **`BS(1,2) ≅ ℤ[1/2] ⋊ ℤ`**, the isomorphism asserted in the manuscript's
sharpness paragraph.  Both directions are constructed: the forward map is the
affine realization of the presentation, the backward map is the universal
property of the ascending HNN extension. -/
noncomputable def bsEquivAffine : BS ≃* Affine :=
  MonoidHom.toMulEquiv toAffine fromAffine fromAffine_comp_toAffine
    toAffine_comp_fromAffine

/-- The isomorphism sends the compressed generator to the unit translation. -/
theorem bsEquivAffine_aGen : bsEquivAffine aGen = gammaZero := toAffine_aGen

/-- The isomorphism sends the stable letter to the stable letter. -/
theorem bsEquivAffine_tGen : bsEquivAffine tGen = tZero := toAffine_tGen

/-- The literal affine group is finitely presented, being `BS(1,2)`. -/
instance affine_isFinitelyPresented : Group.IsFinitelyPresented Affine :=
  Group.IsFinitelyPresented.equiv bsEquivAffine

/-- `BS(1,2)` is countable, being a quotient of the free group on two
letters. -/
instance bs_countable : Countable BS := by
  have hfree : Function.Surjective
      (FreeGroup.mk : List (BSGenerator × Bool) → FreeGroup BSGenerator) := by
    intro g
    obtain ⟨L, hL⟩ := Quot.exists_rep g
    exact ⟨L, by rw [← FreeGroup.quot_mk_eq_mk, hL]⟩
  letI : Countable (FreeGroup BSGenerator) := hfree.countable
  exact (PresentedGroup.mk_surjective
    ((bsRelators : Finset (FreeGroup BSGenerator)) :
      Set (FreeGroup BSGenerator))).countable

/-- The affine group is countable. -/
instance affine_countable : Countable Affine :=
  bsEquivAffine.toEquiv.surjective.countable

/-- The manuscript's identification, packaged: the affine group is exactly
`ℤ[1/2] ⋊ ℤ` with `ℤ` acting by doubling, its distinguished pair satisfies the
Baumslag--Solitar relation, `ℤ[1/2]` is the subring of `ℚ` generated by `1/2`,
and the presented group `⟨a, t | t a t⁻¹ = a²⟩` is isomorphic to it. -/
theorem manuscript_bs_affine_identification :
    dyadicSubring = Subring.closure {(2 : ℚ)⁻¹} ∧
      (∀ x : Multiplicative Dyadic,
        doublingAut x = Multiplicative.ofAdd (doubleFun x.toAdd)) ∧
      tZero * gammaZero * tZero⁻¹ = gammaZero ^ 2 ∧
      Nonempty (BS ≃* Affine) :=
  ⟨dyadicSubring_eq_closure, fun _ => rfl, conj_gammaZero, ⟨bsEquivAffine⟩⟩

end DyadicRationals
end GroupApproximation
