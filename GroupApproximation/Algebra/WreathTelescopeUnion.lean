import GroupApproximation.Algebra.WreathLampPushforward

/-!
# The limit kernel of a telescope of pushforwards

**Theorem 37.5** of the ascending-HNN dossier, the union step, on the lamp
model of `Algebra/WreathLampPushforward`.

Once the stage kernel is known to be generated by the same-fibre differences
(`ker_pushHom`), the passage to the limit is a statement about *pairs* of
sites and nothing else: two sites lie in the same limit fibre exactly when they
lie in the same fibre at some finite stage.  So

    ker (pushHom q∞) = ⨆ n, ker (pushHom qₙ),

and the hypothesis needed is only

    q∞ x = q∞ y  →  ∃ n, qₙ x = qₙ y,

which in the ascending-HNN application is the statement that `g⁻¹h ∈ N = ⋃ Γₙ`
puts `g⁻¹h` in some single `Γₙ`.

The consequence `ker_pushHom_le_of_stages` is the shape the radical argument
consumes: to place the whole limit kernel inside a normal subgroup it is enough
to place each stage kernel there.
-/

namespace GroupApproximation
namespace WreathLampPushforward

universe u v w

variable {K : Type u} [CommGroup K] [DecidableEq K] {X : Type v} [DecidableEq X]

omit [DecidableEq K] in
/-- A stage refinement pushes its fibre differences into the limit's. -/
theorem fiberDiffs_mono {Y : Type w} {Z : Type w} {q : X → Y} {qinf : X → Z}
    (p : Y → Z) (hp : qinf = p ∘ q) :
    fiberDiffs (K := K) q ⊆ fiberDiffs (K := K) qinf := by
  rintro w ⟨x, x', k, hq, rfl⟩
  refine ⟨x, x', k, ?_, rfl⟩
  rw [hp]
  exact congrArg p hq

/-- **Theorem 37.5, the union step.**  If every pair of sites identified in the
limit is already identified at some finite stage, the limit kernel is the
supremum of the stage kernels. -/
theorem ker_pushHom_eq_iSup {Y : ℕ → Type w} [∀ n, DecidableEq (Y n)]
    {Z : Type w} [DecidableEq Z]
    (q : ∀ n, X → Y n) (qinf : X → Z)
    (hfac : ∀ n, ∃ p : Y n → Z, qinf = p ∘ q n)
    (hsep : ∀ x y : X, qinf x = qinf y → ∃ n, q n x = q n y) :
    (pushHom (K := K) qinf).ker = ⨆ n, (pushHom (K := K) (q n)).ker := by
  refine le_antisymm ?_ ?_
  · rw [ker_pushHom, Subgroup.closure_le]
    rintro w ⟨x, x', k, hq, rfl⟩
    obtain ⟨n, hn⟩ := hsep x x' hq
    refine Subgroup.mem_iSup_of_mem n ?_
    rw [ker_pushHom]
    exact Subgroup.subset_closure ⟨x, x', k, hn, rfl⟩
  · refine iSup_le fun n => ?_
    obtain ⟨p, hp⟩ := hfac n
    rw [ker_pushHom, ker_pushHom]
    exact Subgroup.closure_mono (fiberDiffs_mono p hp)

/-- **The reduction the radical argument consumes.**  To place the whole limit
kernel inside a subgroup it is enough to place every stage kernel there. -/
theorem ker_pushHom_le_of_stages {Y : ℕ → Type w} [∀ n, DecidableEq (Y n)]
    {Z : Type w} [DecidableEq Z]
    (q : ∀ n, X → Y n) (qinf : X → Z)
    (hfac : ∀ n, ∃ p : Y n → Z, qinf = p ∘ q n)
    (hsep : ∀ x y : X, qinf x = qinf y → ∃ n, q n x = q n y)
    {R : Subgroup (Lamp K X)}
    (hstage : ∀ n, (pushHom (K := K) (q n)).ker ≤ R) :
    (pushHom (K := K) qinf).ker ≤ R := by
  rw [ker_pushHom_eq_iSup q qinf hfac hsep]
  exact iSup_le hstage

end WreathLampPushforward
end GroupApproximation
