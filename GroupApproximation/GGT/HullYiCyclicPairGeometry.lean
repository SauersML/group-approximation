import GroupApproximation.GGT.HullSCConeOffHeavyB2
import GroupApproximation.GGT.HullSCConeOffHeavyUnconditional

/-!
# The cyclic `yi` family: all cone-off geometry except local finiteness

Hull's `yi` conclusion identifies every elementary closure in the selected
family with the cyclic subgroup generated by its loxodromic element.  At that
point the coarse-translation input of DGO Lemma 6.5 is no longer needed:

* closeness of the elementary closure to the powers holds with constant zero;
* the existing acylindrical common-power threshold proves geometric
  separation;
* the existing quasiconvexity argument proves hyperbolicity of the cone-off.

Thus, for the cyclic family actually returned by `yi`, the only remaining
clause of prescribed-base hyperbolic embeddedness is local finiteness of the
relative metric.  The last theorem records that exact interface without a
literature proposition, axiom, or hidden choice of a different base alphabet.
-/

namespace GroupApproximation
namespace HullSC

open GroupApproximation.GGT
open GroupApproximation.HullGeometry
open GroupApproximation.WordMetric
open GroupApproximation.Manuscript.NonMF.TorsionFree

universe u w

variable {G : Type u} [Group G]

/-- If the elementary closure is cyclic, its distance from the powers is zero. -/
theorem closureNearPowers_zero_of_elementaryClosure_eq_zpowers
    (A : Alphabet G) {g : G}
    (hcyc : Elementary.elementaryClosure g = Subgroup.zpowers g) :
    ClosureNearPowers A g 0 := by
  intro x hx
  rw [hcyc] at hx
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  exact ⟨k, by rw [wordDist_self]⟩

/-- A finite cyclic elementary-closure family is geometrically separated.

The common-power threshold is supplied by acylindricity on the geodesic model;
cyclicity supplies the former coarse-translation premise at radius zero. -/
theorem isGeometricallySeparated_zpowers_of_elementaryClosure_eq
    {Λ : Type w} [Fintype Λ] [Nonempty Λ]
    (A : HullGeneratingSet G) (g : Λ → G)
    (hncom : PairwiseNonCommensurable g)
    (hlox : ∀ lam : Λ, IsLoxodromic (g lam) (Cayley.base A.alphabet))
    (hcyc : ∀ lam : Λ,
      Elementary.elementaryClosure (g lam) = Subgroup.zpowers (g lam)) :
    IsGeometricallySeparated A.alphabet
      (fun lam => Subgroup.zpowers (g lam)) := by
  have hdelta0 : 0 ≤ A.delta :=
    Elementary.nonneg_of_isHyperbolicSpace A.hyperbolic
      (Cayley.base A.alphabet)
  have hgeo : IsGeodesicSpace
      (CayleyGeodesicModel.PointQuot A.alphabet) :=
    CayleyGeodesicModel.isGeodesicRealisationQuot A.alphabet
  have hhyp : IsHyperbolicSpace (A.delta + 6)
      (CayleyGeodesicModel.PointQuot A.alphabet) :=
    CayleyGeodesicModel.isHyperbolicSpace_pointQuot
      (CayleyGeodesicModel.isHyperbolicSpace_point A.alphabet A.hyperbolic)
  have hiso : IsIsometricAction G
      (CayleyGeodesicModel.PointQuot A.alphabet) :=
    CayleyGeodesicModel.isIsometricAction_pointQuot A.alphabet
  have hacy : IsAcylindrical G
      (CayleyGeodesicModel.PointQuot A.alphabet) :=
    isAcylindrical_of_additiveDistortion_of_dense zero_le_one
      (CayleyGeodesicModel.hasAdditiveDistortion_iotaQuot A.alphabet)
      (CayleyGeodesicModel.hasDenseImage_iotaQuot A.alphabet)
      (CayleyGeodesicModel.isEquivariant_iotaQuot A.alphabet) hiso
      A.acylindrical
  have hunif : UniformCommonZpowThreshold G
      (CayleyGeodesicModel.PointQuot A.alphabet) :=
    uniformCommonZpowThreshold_of_acylindrical hhyp (by linarith) hgeo hiso hacy
  have hclose : ∀ lam : Λ, ClosureNearPowers A.alphabet (g lam) 0 :=
    fun lam =>
      closureNearPowers_zero_of_elementaryClosure_eq_zpowers
        A.alphabet (hcyc lam)
  have hsep := isGeometricallySeparated_of_uniformThreshold_of_finite
    A.alphabet g hncom hclose hlox hunif
  simpa only [hcyc] using hsep

/-- For the cyclic family selected by `yi`, hyperbolicity and geometric
separation are unconditional. -/
theorem zpowersFamily_geometry_of_elementaryClosure_eq
    {Λ : Type w} [Fintype Λ] [Nonempty Λ]
    (A : HullGeneratingSet G) (g : Λ → G)
    (hncom : PairwiseNonCommensurable g)
    (hlox : ∀ lam : Λ, IsLoxodromic (g lam) (Cayley.base A.alphabet))
    (hcyc : ∀ lam : Λ,
      Elementary.elementaryClosure (g lam) = Subgroup.zpowers (g lam)) :
    (∃ delta' : ℝ, IsHyperbolicSpace delta'
      (Cayley (coneOffFamily A.alphabet
        (fun lam => Subgroup.zpowers (g lam))).alphabet)) ∧
      IsGeometricallySeparated A.alphabet
        (fun lam => Subgroup.zpowers (g lam)) := by
  exact ⟨exists_hyperbolic_coneOffFamily_zpowers A g hlox,
    isGeometricallySeparated_zpowers_of_elementaryClosure_eq
      A g hncom hlox hcyc⟩

/-- Full prescribed-base hyperbolic embeddedness of the cyclic `yi` family is
now exactly local finiteness of its relative balls. -/
theorem isHyperbolicallyEmbedded_zpowers_of_elementaryClosure_eq
    {Λ : Type w} [Fintype Λ] [Nonempty Λ]
    (A : HullGeneratingSet G) (g : Λ → G)
    (hncom : PairwiseNonCommensurable g)
    (hlox : ∀ lam : Λ, IsLoxodromic (g lam) (Cayley.base A.alphabet))
    (hcyc : ∀ lam : Λ,
      Elementary.elementaryClosure (g lam) = Subgroup.zpowers (g lam))
    (hloc : ∀ (lam : Λ) (n : ℕ),
      ((coneOffFamily A.alphabet
        (fun nu => Subgroup.zpowers (g nu))).relBall lam n).Finite) :
    (coneOffFamily A.alphabet
      (fun lam => Subgroup.zpowers (g lam))).IsHyperbolicallyEmbedded := by
  obtain ⟨hhyp, -⟩ :=
    zpowersFamily_geometry_of_elementaryClosure_eq A g hncom hlox hcyc
  exact ⟨hhyp, hloc⟩

end HullSC
end GroupApproximation
