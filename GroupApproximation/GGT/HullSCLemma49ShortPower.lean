import GroupApproximation.GGT.HullSCLemma49LongPeriod
import GroupApproximation.GGT.HullSCLemma44CertificateInjectivity

/-!
# The short non-loxodromic branch of Hull's Lemma 4.9

Hull's proof treats a non-loxodromic lift by conjugating its kernel power into
the radius-`8 * delta + 1` ball and applying the ball-injectivity clause of
Lemma 4.4.  This module proves that reduction without assuming an
elliptic/loxodromic dichotomy.

Choose a shortest ordinary conjugate of the kernel power.  If its geodesic
word had length at least `8 * delta + 2`, the local-to-global theorem in
`HullSCLemma49PowerChain` would make that conjugate loxodromic.  Conjugacy
invariance and descent from a positive power would then make the original
period loxodromic.  A non-loxodromic period thus supplies a nontrivial short
kernel element, contradicting injectivity on the protected ball.
-/

namespace GroupApproximation
namespace HullSC

open GroupApproximation.HullGeometry
open GroupApproximation.Manuscript.NonMF.TorsionFree
open GroupApproximation.WordMetric

universe u w

/-! ## The power represented by the cells lies in the one-relator kernel -/

/-- The value of every oriented cell in a one-relator power diagram belongs
to the normal closure of the original relator value. -/
theorem Lemma44OrientedRelatorCell.value_mem_normalClosure
    {G : Type u} [Group G] {Lambda : Type w}
    {v : List (GGT.RelLetter G Lambda)}
    (C : Lemma44OrientedRelatorCell (RelWord.symmetrized v)) :
    C.value ∈ Subgroup.normalClosure
      ({GGT.RelLetter.listVal v} : Set G) := by
  let N : Subgroup G :=
    Subgroup.normalClosure ({GGT.RelLetter.listVal v} : Set G)
  have hrelator : GGT.RelLetter.listVal C.relator ∈ N :=
    listVal_mem_normalClosure_of_mem_symmetrized C.relator_mem
  change C.conjugator * GGT.RelLetter.listVal C.relator *
      C.conjugator⁻¹ ∈ N
  exact (Subgroup.normalClosure_normal : N.Normal).conj_mem
    (GGT.RelLetter.listVal C.relator) hrelator C.conjugator

/-- The product of all oriented cell values belongs to the one-relator normal
closure. -/
theorem Lemma49GeodesicPowerDiagram.cells_prod_mem_normalClosure
    {G : Type u} [Group G] {Lambda : Type w}
    {D : GGT.RelGenSet G Lambda}
    {v : List (GGT.RelLetter G Lambda)} {g : G} {n : ℕ}
    (Z : Lemma49GeodesicPowerDiagram D v g n) :
    (Z.cells.map Lemma44OrientedRelatorCell.value).prod ∈
      Subgroup.normalClosure ({GGT.RelLetter.listVal v} : Set G) := by
  apply Subgroup.list_prod_mem
  intro x hx
  rw [List.mem_map] at hx
  obtain ⟨C, _, rfl⟩ := hx
  exact C.value_mem_normalClosure

/-- The outer power represented by a geodesic power diagram lies in the
normal closure generated by its relator. -/
theorem Lemma49GeodesicPowerDiagram.power_mem_normalClosure
    {G : Type u} [Group G] {Lambda : Type w}
    {D : GGT.RelGenSet G Lambda}
    {v : List (GGT.RelLetter G Lambda)} {g : G} {n : ℕ}
    (Z : Lemma49GeodesicPowerDiagram D v g n) :
    g ^ n ∈ Subgroup.normalClosure
      ({GGT.RelLetter.listVal v} : Set G) := by
  have hcells := Z.cells_prod_mem_normalClosure
  rw [← Z.boundaryPower_value_eq_cells] at hcells
  rw [listVal_lemma49BoundaryPower] at hcells
  have hvalue : GGT.RelLetter.listVal Z.boundaryWord = g := by
    simpa using Z.boundary_geodesic.2.1
  rwa [hvalue] at hcells

/-! ## A long shortest ordinary conjugate is loxodromic -/

/-- Minimality modulo a normal subgroup implies minimality under ordinary
conjugacy, expressed as minimality modulo the trivial subgroup. -/
theorem shortestModuloConjugacy_bot_of_shortestModuloConjugacy
    {G : Type u} [Group G] {A : Set G} {N : Subgroup G} [N.Normal]
    {g : G} (hshort : IsShortestModuloConjugacy A N g) :
    IsShortestModuloConjugacy A (⊥ : Subgroup G) g := by
  intro h hh
  obtain ⟨a, k, hk, hvalue⟩ := hh
  have hkOne : k = 1 := by
    simpa only [Subgroup.mem_bot] using hk
  subst k
  apply hshort h
  refine ⟨a, 1, N.one_mem, ?_⟩
  simpa only [mul_one] using hvalue

/-- A shortest ordinary conjugacy representative with period at least
`8 * delta + 2` is loxodromic.  This is Hull's `nolongell` lemma, obtained
from the finite-chain local-to-global theorem already used by the long-period
diagram branch. -/
theorem isLoxodromic_of_long_shortestModuloConjugacy
    {G : Type u} [Group G] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda) {g : G}
    (hshort : IsShortestModuloConjugacy D.alphabet.carrier
      (⊥ : Subgroup G) g)
    {word : List (GGT.RelLetter G Lambda)}
    (hword : GGT.OsinComponents.IsGeodesicWord D 1 g word)
    {delta : ℕ}
    (hdelta : Hyperbolic.IsFourPointHyperbolic D.alphabet.carrier delta)
    (hlong : 8 * delta + 2 ≤ word.length) :
    IsLoxodromic g (Cayley.base D.alphabet) := by
  letI : (⊥ : Subgroup G).Normal := Subgroup.normal_bot
  let slope : ℝ := (word.length : ℝ) / 4
  let error : ℝ := 8 * delta + 2
  have hwordPos : 0 < word.length := by omega
  have hslope : 0 < slope := by
    dsimp [slope]
    positivity
  have herror : 0 ≤ error := by
    dsimp [error]
    positivity
  refine ⟨slope, hslope, error, herror, ?_⟩
  intro m
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · simp [slope, error]
    positivity
  · have hchain := isQuasiGeodesicChainAt_power_of_long_period
      D (⊥ : Subgroup G) hshort hword hm hdelta hlong
    have hlower := (hchain 0 (lemma49BoundaryPower word m).length
      (Nat.zero_le _) le_rfl).1
    have hend : GGT.OsinComponents.vertex 1
        (lemma49BoundaryPower word m)
        (lemma49BoundaryPower word m).length = g ^ m := by
      rw [GGT.OsinComponents.vertex_length, one_mul,
        listVal_lemma49BoundaryPower]
      have hvalue : GGT.RelLetter.listVal word = g := by
        simpa using hword.2.1
      rw [hvalue]
    dsimp only at hlower
    rw [GGT.OsinComponents.vertex_zero, hend, wordDist_one_left,
      lemma49BoundaryPower_length] at hlower
    have hdist :
        dist (Cayley.base D.alphabet) ((g ^ m) • Cayley.base D.alphabet) =
          (wordNorm D.alphabet.carrier (g ^ m) : ℝ) := by
      simp [Cayley.dist_eq, Cayley.base, wordDist_one_left]
    rw [hdist]
    dsimp [slope, error]
    push_cast at hlower ⊢
    linarith

/-! ## Conjugating a non-loxodromic power into the protected ball -/

/-- If `g` is not loxodromic, every positive power has an ordinary conjugate
of word norm at most `8 * delta + 1`.  Otherwise a shortest conjugate would be
long, so the preceding theorem would make the power, and then `g`,
loxodromic. -/
theorem exists_short_conjugate_power_of_not_isLoxodromic
    {G : Type u} [Group G] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda) {g : G} {n delta : ℕ}
    (hn : 0 < n)
    (hdelta : Hyperbolic.IsFourPointHyperbolic D.alphabet.carrier delta)
    (hnlox : ¬ IsLoxodromic g (Cayley.base D.alphabet)) :
    ∃ a h : G, h = a * g ^ n * a⁻¹ ∧
      wordNorm D.alphabet.carrier h ≤ 8 * delta + 1 := by
  letI : (⊥ : Subgroup G).Normal := Subgroup.normal_bot
  obtain ⟨h, hconj, hshort⟩ :=
    exists_shortest_conjugateModulo D.alphabet.carrier
      (⊥ : Subgroup G) (g ^ n)
  obtain ⟨a, k, hk, hvalue⟩ := hconj
  have hkOne : k = 1 := by
    simpa only [Subgroup.mem_bot] using hk
  subst k
  have hconjValue : h = a * g ^ n * a⁻¹ := by
    simpa only [mul_one] using hvalue
  refine ⟨a, h, hconjValue, ?_⟩
  by_contra hnotShort
  have hlongNorm : 8 * delta + 2 ≤ wordNorm D.alphabet.carrier h := by
    omega
  obtain ⟨word, hword⟩ := GGT.OsinComponents.existsGeodesicWord D 1 h
  have hlength : word.length = wordNorm D.alphabet.carrier h := by
    have h := hword.2.2
    simpa only [wordDist_one_left] using h
  have hlongWord : 8 * delta + 2 ≤ word.length := by
    rw [hlength]
    exact hlongNorm
  have hhlox : IsLoxodromic h (Cayley.base D.alphabet) :=
    isLoxodromic_of_long_shortestModuloConjugacy D hshort hword hdelta
      hlongWord
  have hconjLox := isLoxodromic_conj
    (isIsometricAction_cayley D.alphabet) (a := a⁻¹) hhlox
  have hcancel : a⁻¹ * h * (a⁻¹)⁻¹ = g ^ n := by
    rw [hconjValue]
    group
  rw [hcancel] at hconjLox
  exact hnlox (isLoxodromic_of_pow_isLoxodromic
    (isIsometricAction_cayley D.alphabet) hn hconjLox)

/-- Ball injectivity rules out a power diagram whose period is not
loxodromic.  The nontrivial kernel power is conjugated into the protected
radius, where it has the same quotient image as the identity. -/
theorem false_of_powerDiagram_of_not_isLoxodromic_of_ballInjective
    {G : Type u} [Group G] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda)
    {v : List (GGT.RelLetter G Lambda)} {g : G} {n delta : ℕ}
    (Z : Lemma49GeodesicPowerDiagram D v g n)
    (hdelta : Hyperbolic.IsFourPointHyperbolic D.alphabet.carrier delta)
    (hnlox : ¬ IsLoxodromic g (Cayley.base D.alphabet))
    (hinj : Set.InjOn
      (QuotientGroup.mk'
        (Subgroup.normalClosure ({GGT.RelLetter.listVal v} : Set G)))
      (cayleyBall D.alphabet (8 * delta + 1))) : False := by
  let N : Subgroup G :=
    Subgroup.normalClosure ({GGT.RelLetter.listVal v} : Set G)
  letI : N.Normal := Subgroup.normalClosure_normal
  have hpowMem : g ^ n ∈ N := Z.power_mem_normalClosure
  obtain ⟨a, h, hvalue, hshort⟩ :=
    exists_short_conjugate_power_of_not_isLoxodromic D Z.exponent_pos
      hdelta hnlox
  have hhMem : h ∈ N := by
    rw [hvalue]
    exact (inferInstance : N.Normal).conj_mem (g ^ n) hpowMem a
  have hhNe : h ≠ 1 := by
    intro hh
    apply Z.power_ne_one
    calc
      g ^ n = a⁻¹ * h * a := by rw [hvalue]; group
      _ = 1 := by rw [hh]; simp
  have hhBall : h ∈ cayleyBall D.alphabet (8 * delta + 1) := by
    rw [mem_cayleyBall_iff, wordDist_one_left]
    exact hshort
  have hOneBall : (1 : G) ∈ cayleyBall D.alphabet (8 * delta + 1) := by
    rw [mem_cayleyBall_iff, wordDist_self]
    omega
  have himages : QuotientGroup.mk' N h = QuotientGroup.mk' N 1 := by
    have himageOne : QuotientGroup.mk' N h = 1 :=
      (QuotientGroup.eq_one_iff h).mpr hhMem
    simpa only [map_one] using himageOne
  exact hhNe (hinj hhBall hOneBall himages)

/-! ## Model check -/

/-- The non-loxodromic branch is empty for a power diagram over the trivial
group because its required outer power is nontrivial. -/
theorem no_short_nonLoxodromic_powerDiagram_trivialModel
    {Lambda : Type w} (D : GGT.RelGenSet PUnit Lambda)
    (v : List (GGT.RelLetter PUnit Lambda)) (n : ℕ) :
    IsEmpty (Lemma49GeodesicPowerDiagram D v 1 n) := by
  exact ⟨fun Z => Z.power_ne_one (Subsingleton.elim _ _)⟩

end HullSC
end GroupApproximation
