import GroupApproximation.GGT.BassSerreHNNLength
import Mathlib.Combinatorics.SimpleGraph.Metric
import Mathlib.GroupTheory.GroupAction.Quotient

/-!
# The Bass--Serre graph of an HNN extension

`E = HNNExtension G A B φ` splits over its base copy `Δ = of '' G` with one
stable letter, and the graph of that splitting is:

* vertices --- the left cosets `xΔ`, i.e. `E ⧸ of.range`;
* edges --- `xΔ` joined to `xtΔ`.

The left translation action of `E` is by graph automorphisms, and this module
proves everything about the graph that does not need acyclicity:

* `tree_connected` --- `E` is generated by `Δ` and `t`, so the graph is
  connected.
* `dist_vmk` --- **the graph distance is the syllable length**:
  `d(xΔ, yΔ) = tLen φ (x⁻¹y)`.  The upper bound walks along a reduced spelling;
  the lower bound is subadditivity of `tLen` along an arbitrary walk.
* `mem_stabilizer_vmk_iff'` --- vertex stabilizers are the conjugates
  `xΔx⁻¹`, and `mem_stabilizer_edge_iff` --- edge stabilizers are the
  conjugates `x·of(B)·x⁻¹` of the second associated subgroup.
* `exists_fixed_vertex_of_pow_eq_one` --- **an element of finite order fixes a
  vertex**, by cyclic reduction: a cyclically reduced word with a stable letter
  has infinite order, so a torsion element is conjugate into `Δ`.  The HNN
  torsion theorem `isPowerTorsionFree_via_tree` is the immediate corollary, and
  is the tree proof of `HNNBritton.isPowerTorsionFree_hnn`.
* `step` --- **the parent of a vertex is unique.**  Crossing an edge out of the
  vertex spelled by `L ++ [(v,c)]` either lengthens the spelling by one, or the
  new syllable pinches against `(v,c)` and the new vertex is the one spelled by
  `L` --- which does not depend on the edge crossed.  `exists_parent` packages
  this, and `tLen_adj` records that the syllable length changes by exactly one
  across every edge, so the graph is bipartite over the parity of `tLen`.

Acyclicity is `GGT/BassSerreHNNIsTree.lean`, which runs on `exists_parent`
alone.
-/

namespace GroupApproximation
namespace GGT
namespace BassSerreHNN

open GroupApproximation.HNNBritton

universe u

variable {G : Type u} [Group G] {A B : Subgroup G}

/-! ## Vertices -/

/-- **The vertex set of the Bass--Serre tree**: the left cosets of the base
copy of `G`. -/
def Vertex (φ : A ≃* B) : Type u :=
  HNNExtension G A B φ ⧸ (HNNExtension.of : G →* HNNExtension G A B φ).range

/-- The vertex `xΔ`. -/
def vmk (φ : A ≃* B) (x : HNNExtension G A B φ) : Vertex φ :=
  QuotientGroup.mk x

instance instMulActionVertex (φ : A ≃* B) :
    MulAction (HNNExtension G A B φ) (Vertex φ) :=
  inferInstanceAs (MulAction (HNNExtension G A B φ)
    (HNNExtension G A B φ ⧸
      (HNNExtension.of : G →* HNNExtension G A B φ).range))

@[simp] theorem smul_vmk (φ : A ≃* B) (a x : HNNExtension G A B φ) :
    a • vmk φ x = vmk φ (a * x) := rfl

theorem vmk_eq_iff (φ : A ≃* B) (x y : HNNExtension G A B φ) :
    vmk φ x = vmk φ y ↔
      x⁻¹ * y ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range := by
  show (QuotientGroup.mk x : HNNExtension G A B φ ⧸
      (HNNExtension.of : G →* HNNExtension G A B φ).range)
        = QuotientGroup.mk y ↔
      x⁻¹ * y ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range
  exact QuotientGroup.eq

theorem vmk_surjective (φ : A ≃* B) : Function.Surjective (vmk φ) := by
  intro v
  obtain ⟨x, hx⟩ := QuotientGroup.mk_surjective
    (s := (HNNExtension.of : G →* HNNExtension G A B φ).range)
    (show HNNExtension G A B φ ⧸
      (HNNExtension.of : G →* HNNExtension G A B φ).range from v)
  exact ⟨x, hx⟩

@[simp] theorem vmk_mul_of (φ : A ≃* B) (x : HNNExtension G A B φ) (g : G) :
    vmk φ (x * HNNExtension.of g) = vmk φ x := by
  rw [vmk_eq_iff]
  exact ⟨g⁻¹, by simp⟩

theorem vmk_eq_one_iff (φ : A ≃* B) (x : HNNExtension G A B φ) :
    vmk φ x = vmk φ 1 ↔
      x ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range := by
  rw [vmk_eq_iff, mul_one]
  constructor
  · rintro ⟨g, hg⟩
    exact ⟨g⁻¹, by rw [map_inv, hg, inv_inv]⟩
  · rintro ⟨g, hg⟩
    exact ⟨g⁻¹, by rw [map_inv, hg]⟩

/-- The stable letter is outside the base copy. -/
theorem t_notMem_range (φ : A ≃* B) :
    (HNNExtension.t : HNNExtension G A B φ) ∉
      (HNNExtension.of : G →* HNNExtension G A B φ).range := by
  have h := HNNBritton.t_zpow_notMem_range φ (n := 1) one_ne_zero
  rwa [zpow_one] at h

/-! ## The graph -/

/-- Adjacency: `xΔ` is joined to `xtΔ`. -/
def treeAdj (φ : A ≃* B) (v w : Vertex φ) : Prop :=
  ∃ g : HNNExtension G A B φ,
    (v = vmk φ g ∧ w = vmk φ (g * HNNExtension.t)) ∨
      (v = vmk φ (g * HNNExtension.t) ∧ w = vmk φ g)

theorem treeAdj_symm (φ : A ≃* B) {v w : Vertex φ} (h : treeAdj φ v w) :
    treeAdj φ w v := by
  obtain ⟨g, hc | hc⟩ := h
  · exact ⟨g, Or.inr ⟨hc.2, hc.1⟩⟩
  · exact ⟨g, Or.inl ⟨hc.2, hc.1⟩⟩

theorem treeAdj_irrefl (φ : A ≃* B) (v : Vertex φ) : ¬ treeAdj φ v v := by
  rintro ⟨g, ⟨h1, h2⟩ | ⟨h1, h2⟩⟩
  · have hmem :=
      (vmk_eq_iff φ g (g * HNNExtension.t)).1 (h1.symm.trans h2)
    rw [inv_mul_cancel_left] at hmem
    exact t_notMem_range φ hmem
  · have hmem :=
      (vmk_eq_iff φ g (g * HNNExtension.t)).1 (h2.symm.trans h1)
    rw [inv_mul_cancel_left] at hmem
    exact t_notMem_range φ hmem

/-- **The Bass--Serre graph of `HNNExtension G A B φ`.** -/
def tree (φ : A ≃* B) : SimpleGraph (Vertex φ) where
  Adj := treeAdj φ
  symm := fun _ _ h => treeAdj_symm φ h
  loopless := fun v h => treeAdj_irrefl φ v h

@[simp] theorem tree_adj_iff (φ : A ≃* B) (v w : Vertex φ) :
    (tree φ).Adj v w ↔ treeAdj φ v w := Iff.rfl

theorem adj_vmk_mul_t (φ : A ≃* B) (g : HNNExtension G A B φ) :
    (tree φ).Adj (vmk φ g) (vmk φ (g * HNNExtension.t)) :=
  ⟨g, Or.inl ⟨rfl, rfl⟩⟩

theorem adj_vmk_mul_t_zpow (φ : A ≃* B) (y : HNNExtension G A B φ) (u : ℤˣ) :
    (tree φ).Adj (vmk φ y)
      (vmk φ (y * (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ))) := by
  rcases Int.units_eq_one_or u with rfl | rfl
  · have hv : (((1 : ℤˣ)) : ℤ) = 1 := rfl
    rw [hv, zpow_one]
    exact adj_vmk_mul_t φ y
  · have hv : (((-1 : ℤˣ)) : ℤ) = -1 := rfl
    have h := adj_vmk_mul_t φ
      (y * (HNNExtension.t : HNNExtension G A B φ)⁻¹)
    rw [inv_mul_cancel_right] at h
    rw [hv, zpow_neg, zpow_one]
    exact h.symm

/-- **The characterisation of adjacency.**  Two vertices are joined exactly
when the quotient of their names is a base element times a signed stable letter
times a base element. -/
theorem adj_of_eq (φ : A ≃* B) {x y : HNNExtension G A B φ} {a b : G} {u : ℤˣ}
    (h : x⁻¹ * y = HNNExtension.of a *
      (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) * HNNExtension.of b) :
    (tree φ).Adj (vmk φ x) (vmk φ y) := by
  have hy : y = x * HNNExtension.of a *
      (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) *
      HNNExtension.of b := by
    have h1 : y = x * (HNNExtension.of a *
        (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) *
        HNNExtension.of b) := by
      rw [← h]; group
    rw [h1]; group
  have hx : vmk φ x = vmk φ (x * HNNExtension.of a) := (vmk_mul_of φ x a).symm
  have hyv : vmk φ y = vmk φ (x * HNNExtension.of a *
      (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) := by
    rw [hy, vmk_mul_of]
  rw [hx, hyv]
  exact adj_vmk_mul_t_zpow φ (x * HNNExtension.of a) u

theorem exists_of_adj (φ : A ≃* B) {x y : HNNExtension G A B φ}
    (h : (tree φ).Adj (vmk φ x) (vmk φ y)) :
    ∃ (a b : G) (u : ℤˣ), x⁻¹ * y = HNNExtension.of a *
      (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) *
      HNNExtension.of b := by
  obtain ⟨g, hc | hc⟩ := h
  · obtain ⟨a, ha⟩ := (vmk_eq_iff φ x g).1 hc.1
    obtain ⟨b, hb⟩ := (vmk_eq_iff φ y (g * HNNExtension.t)).1 hc.2
    have h1 : y * HNNExtension.of b = g * HNNExtension.t := by
      rw [hb]; group
    have h2 : g = x * HNNExtension.of a := by rw [ha]; group
    have h4 : y = x * HNNExtension.of a * HNNExtension.t *
        (HNNExtension.of b)⁻¹ := by
      rw [← h2, ← h1]; group
    refine ⟨a, b⁻¹, 1, ?_⟩
    have hv : (((1 : ℤˣ)) : ℤ) = 1 := rfl
    rw [hv, zpow_one, map_inv, h4]
    group
  · obtain ⟨a, ha⟩ := (vmk_eq_iff φ x (g * HNNExtension.t)).1 hc.1
    obtain ⟨b, hb⟩ := (vmk_eq_iff φ y g).1 hc.2
    have h1 : y * HNNExtension.of b = g := by rw [hb]; group
    have h2 : g * HNNExtension.t = x * HNNExtension.of a := by
      rw [ha]; group
    have h4 : y = x * HNNExtension.of a * HNNExtension.t⁻¹ *
        (HNNExtension.of b)⁻¹ := by
      rw [← h2, ← h1]; group
    refine ⟨a, b⁻¹, -1, ?_⟩
    have hv : (((-1 : ℤˣ)) : ℤ) = -1 := rfl
    rw [hv, zpow_neg, zpow_one, map_inv, h4]
    group

/-! ## Translation is by graph automorphisms -/

theorem adj_smul (φ : A ≃* B) (a : HNNExtension G A B φ) {v w : Vertex φ}
    (h : (tree φ).Adj v w) : (tree φ).Adj (a • v) (a • w) := by
  obtain ⟨g, hc | hc⟩ := h
  · refine ⟨a * g, Or.inl ⟨?_, ?_⟩⟩
    · rw [hc.1]; simp only [smul_vmk]
    · rw [hc.2]; simp only [smul_vmk, mul_assoc]
  · refine ⟨a * g, Or.inr ⟨?_, ?_⟩⟩
    · rw [hc.1]; simp only [smul_vmk, mul_assoc]
    · rw [hc.2]; simp only [smul_vmk]

/-- Left translation as a graph endomorphism. -/
def smulHom (φ : A ≃* B) (a : HNNExtension G A B φ) : tree φ →g tree φ where
  toFun := fun v => a • v
  map_rel' := fun h => adj_smul φ a h

@[simp] theorem smulHom_apply (φ : A ≃* B) (a : HNNExtension G A B φ)
    (v : Vertex φ) : smulHom φ a v = a • v := rfl

/-! ## Connectivity -/

theorem reachable_of_eq (φ : A ≃* B) {v w : Vertex φ} (h : v = w) :
    (tree φ).Reachable v w := by
  subst h
  exact SimpleGraph.Reachable.refl v

theorem reachable_vmk_one (φ : A ≃* B) (x : HNNExtension G A B φ) :
    (tree φ).Reachable (vmk φ 1) (vmk φ x) := by
  induction x using HNNExtension.induction_on with
  | of g =>
      have h : vmk φ (HNNExtension.of g) = vmk φ 1 := by
        rw [vmk_eq_one_iff]
        exact ⟨g, rfl⟩
      exact reachable_of_eq φ h.symm
  | t =>
      have h := adj_vmk_mul_t φ (1 : HNNExtension G A B φ)
      rw [one_mul] at h
      exact h.reachable
  | mul x y hx hy =>
      have h1 := hy.map (smulHom φ x)
      simp only [smulHom_apply, smul_vmk, mul_one] at h1
      exact hx.trans h1
  | inv x hx =>
      have h1 := hx.map (smulHom φ x⁻¹)
      simp only [smulHom_apply, smul_vmk, mul_one, inv_mul_cancel] at h1
      exact h1.symm

instance instNonemptyVertex (φ : A ≃* B) : Nonempty (Vertex φ) := ⟨vmk φ 1⟩

theorem tree_preconnected (φ : A ≃* B) : (tree φ).Preconnected := by
  intro v w
  obtain ⟨x, rfl⟩ := vmk_surjective φ v
  obtain ⟨y, rfl⟩ := vmk_surjective φ w
  exact (reachable_vmk_one φ x).symm.trans (reachable_vmk_one φ y)

theorem tree_connected (φ : A ≃* B) : (tree φ).Connected :=
  ⟨tree_preconnected φ⟩

/-! ## The graph distance is the syllable length -/

theorem tLen_t_zpow (φ : A ≃* B) (u : ℤˣ) :
    tLen φ ((HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) = 1 := by
  rcases Int.units_eq_one_or u with rfl | rfl
  · have hv : (((1 : ℤˣ)) : ℤ) = 1 := rfl
    rw [hv, zpow_one, tLen_t]
  · have hv : (((-1 : ℤˣ)) : ℤ) = -1 := rfl
    rw [hv, zpow_neg, zpow_one, tLen_inv, tLen_t]

/-- Adjacent vertices are at syllable distance one. -/
theorem tLen_eq_one_of_adj (φ : A ≃* B) {x y : HNNExtension G A B φ}
    (h : (tree φ).Adj (vmk φ x) (vmk φ y)) : tLen φ (x⁻¹ * y) = 1 := by
  obtain ⟨a, b, u, hab⟩ := exists_of_adj φ h
  rw [hab, tLen_mul_of, tLen_of_mul, tLen_t_zpow]

theorem dist_vmk_mul_wordProd_le (φ : A ≃* B) :
    ∀ (l : List (ℤˣ × G)) (x : HNNExtension G A B φ) (g : G),
      (tree φ).dist (vmk φ x) (vmk φ (x * wordProd φ g l)) ≤ l.length := by
  intro l
  induction l with
  | nil =>
      intro x g
      rw [wordProd_nil, vmk_mul_of]
      simp [SimpleGraph.dist_self]
  | cons bb L ih =>
      intro x g
      obtain ⟨u, h⟩ := bb
      have hkey : x * wordProd φ g ((u, h) :: L)
          = (x * HNNExtension.of g *
              (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) *
            wordProd φ h L := by
        rw [wordProd_cons]
        simp only [mul_assoc]
      have h1 : (tree φ).dist (vmk φ x)
          (vmk φ (x * HNNExtension.of g *
            (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ))) ≤ 1 := by
        have hadj := adj_vmk_mul_t_zpow φ (x * HNNExtension.of g) u
        rw [vmk_mul_of] at hadj
        exact le_of_eq (SimpleGraph.dist_eq_one_iff_adj.2 hadj)
      have h2 := ih (x * HNNExtension.of g *
        (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) h
      have h3 := (tree_connected φ).dist_triangle (u := vmk φ x)
        (v := vmk φ (x * HNNExtension.of g *
          (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)))
        (w := vmk φ ((x * HNNExtension.of g *
          (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) *
          wordProd φ h L))
      rw [hkey]
      simp only [List.length_cons]
      omega

theorem dist_vmk_le_tLen (φ : A ≃* B) (x y : HNNExtension G A B φ) :
    (tree φ).dist (vmk φ x) (vmk φ y) ≤ tLen φ (x⁻¹ * y) := by
  obtain ⟨g, l, _, hp, hlen⟩ := tLen_mem φ (x⁻¹ * y)
  have h := dist_vmk_mul_wordProd_le φ l x g
  rw [hp, mul_inv_cancel_left, hlen] at h
  exact h

theorem tLen_le_walk_length (φ : A ≃* B) :
    ∀ {v w : Vertex φ} (p : (tree φ).Walk v w) (x y : HNNExtension G A B φ),
      v = vmk φ x → w = vmk φ y → tLen φ (x⁻¹ * y) ≤ p.length := by
  intro v w p
  induction p with
  | nil =>
      intro x y hx hy
      have h0 : tLen φ (x⁻¹ * y) = 0 :=
        (tLen_eq_zero_iff φ _).2 ((vmk_eq_iff φ x y).1 (hx.symm.trans hy))
      simp [h0]
  | @cons av bv cv hadj q ih =>
      intro x y hx hy
      obtain ⟨z, hz⟩ := vmk_surjective φ bv
      have hadj' : (tree φ).Adj (vmk φ x) (vmk φ z) := by
        rw [← hx, hz]; exact hadj
      have h1 : tLen φ (x⁻¹ * z) = 1 := tLen_eq_one_of_adj φ hadj'
      have h2 : tLen φ (z⁻¹ * y) ≤ q.length := ih z y hz.symm hy
      have h3 : tLen φ (x⁻¹ * y) ≤ tLen φ (x⁻¹ * z) + tLen φ (z⁻¹ * y) := by
        have h4 := tLen_mul_le φ (x⁻¹ * z) (z⁻¹ * y)
        rwa [show (x⁻¹ * z) * (z⁻¹ * y) = x⁻¹ * y by group] at h4
      simp only [SimpleGraph.Walk.length_cons]
      omega

/-- **The graph distance of the Bass--Serre tree is the syllable length.** -/
theorem dist_vmk (φ : A ≃* B) (x y : HNNExtension G A B φ) :
    (tree φ).dist (vmk φ x) (vmk φ y) = tLen φ (x⁻¹ * y) := by
  refine le_antisymm (dist_vmk_le_tLen φ x y) ?_
  obtain ⟨p, hp⟩ :=
    ((tree_connected φ).preconnected (vmk φ x) (vmk φ y)).exists_walk_length_eq_dist
  have h := tLen_le_walk_length φ p x y rfl rfl
  rwa [hp] at h

@[simp] theorem dist_vmk_one (φ : A ≃* B) (y : HNNExtension G A B φ) :
    (tree φ).dist (vmk φ 1) (vmk φ y) = tLen φ y := by
  rw [dist_vmk]
  simp

/-! ## Stabilisers -/

theorem smul_vmk_eq_iff (φ : A ≃* B) (a x : HNNExtension G A B φ) :
    a • vmk φ x = vmk φ x ↔
      x⁻¹ * a * x ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range := by
  rw [smul_vmk, eq_comm, vmk_eq_iff, ← mul_assoc]

theorem mem_stabilizer_vmk_iff (φ : A ≃* B) (a x : HNNExtension G A B φ) :
    a ∈ MulAction.stabilizer (HNNExtension G A B φ) (vmk φ x) ↔
      x⁻¹ * a * x ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range := by
  have h1 : a • vmk φ x = vmk φ (a * x) := rfl
  rw [MulAction.mem_stabilizer_iff, h1, eq_comm, vmk_eq_iff, ← mul_assoc]

/-- **Vertex stabilisers are the conjugates of the base copy.** -/
theorem mem_stabilizer_vmk_iff' (φ : A ≃* B) (a x : HNNExtension G A B φ) :
    a ∈ MulAction.stabilizer (HNNExtension G A B φ) (vmk φ x) ↔
      ∃ g : G, a = x * HNNExtension.of g * x⁻¹ := by
  rw [mem_stabilizer_vmk_iff]
  constructor
  · rintro ⟨g, hg⟩
    exact ⟨g, by rw [hg]; group⟩
  · rintro ⟨g, rfl⟩
    exact ⟨g, by group⟩

/-- The base copy meets its `t`-conjugate in the second associated subgroup:
this is the two single-letter pinch criteria read as one statement. -/
theorem mem_range_and_conj_iff (φ : A ≃* B) (y : HNNExtension G A B φ) :
    (y ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range ∧
        (HNNExtension.t : HNNExtension G A B φ)⁻¹ * y * HNNExtension.t
          ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range) ↔
      ∃ b : G, b ∈ B ∧ HNNExtension.of b = y := by
  constructor
  · rintro ⟨⟨a, rfl⟩, h2⟩
    exact ⟨a, (t_inv_conj_mem_range_iff φ a).1 h2, rfl⟩
  · rintro ⟨b, hb, rfl⟩
    refine ⟨⟨b, rfl⟩, ?_⟩
    rw [t_inv_conj_of_mem φ hb]
    exact ⟨_, rfl⟩

/-- **Edge stabilisers are the conjugates of the second associated
subgroup.** -/
theorem mem_stabilizer_edge_iff (φ : A ≃* B) (a x : HNNExtension G A B φ) :
    (a ∈ MulAction.stabilizer (HNNExtension G A B φ) (vmk φ x) ∧
        a ∈ MulAction.stabilizer (HNNExtension G A B φ)
          (vmk φ (x * HNNExtension.t))) ↔
      ∃ b : G, b ∈ B ∧ a = x * HNNExtension.of b * x⁻¹ := by
  rw [mem_stabilizer_vmk_iff, mem_stabilizer_vmk_iff]
  have hrw : (x * HNNExtension.t)⁻¹ * a * (x * HNNExtension.t)
      = (HNNExtension.t : HNNExtension G A B φ)⁻¹ * (x⁻¹ * a * x) *
        HNNExtension.t := by
    group
  rw [hrw, mem_range_and_conj_iff]
  constructor
  · rintro ⟨b, hb, hbe⟩
    exact ⟨b, hb, by rw [hbe]; group⟩
  · rintro ⟨b, hb, rfl⟩
    exact ⟨b, hb, by group⟩

/-- **The pointwise stabiliser of an edge**, in the fixed-point form the
WPD interface consumes. -/
theorem smul_edge_eq_iff (φ : A ≃* B) (a x : HNNExtension G A B φ) :
    (a • vmk φ x = vmk φ x ∧
        a • vmk φ (x * HNNExtension.t) = vmk φ (x * HNNExtension.t)) ↔
      ∃ b : G, b ∈ B ∧ a = x * HNNExtension.of b * x⁻¹ := by
  rw [smul_vmk_eq_iff, smul_vmk_eq_iff]
  have hrw : (x * HNNExtension.t)⁻¹ * a * (x * HNNExtension.t)
      = (HNNExtension.t : HNNExtension G A B φ)⁻¹ * (x⁻¹ * a * x) *
        HNNExtension.t := by
    group
  rw [hrw, mem_range_and_conj_iff]
  constructor
  · rintro ⟨b, hb, hbe⟩
    exact ⟨b, hb, by rw [hbe]; group⟩
  · rintro ⟨b, hb, rfl⟩
    exact ⟨b, hb, by group⟩

/-! ## Torsion elements fix a vertex -/

/-- **An element of finite order fixes a vertex.**  Cyclic reduction puts every
element either into a conjugate of the base copy --- and those fix the
corresponding vertex --- or into a conjugate of a cyclically reduced word,
which has infinite order. -/
theorem exists_fixed_vertex_of_pow_eq_one (φ : A ≃* B)
    {a : HNNExtension G A B φ} {n : ℕ} (hn : n ≠ 0) (ha : a ^ n = 1) :
    ∃ v : Vertex φ, a • v = v := by
  rcases HNNBritton.existsCyclicConjugate φ a with ⟨h, b, hb⟩ | ⟨h, c, hc⟩
  · refine ⟨vmk φ h, ?_⟩
    have hmem : a ∈ MulAction.stabilizer (HNNExtension G A B φ) (vmk φ h) :=
      (mem_stabilizer_vmk_iff' φ a h).2 ⟨b, hb⟩
    exact MulAction.mem_stabilizer_iff.1 hmem
  · exfalso
    refine HNNTorsionFree.CyclicWord.elem_pow_ne_one φ c hn ?_
    have h0 : h * c.elem φ ^ n * h⁻¹ = 1 := by
      rw [← conj_pow, ← hc]
      exact ha
    have h3 := congrArg (fun z => h⁻¹ * z * h) h0
    simpa [mul_assoc] using h3

/-- **The HNN torsion theorem, through the tree.**  A torsion element fixes a
vertex, hence is conjugate into the base copy, where torsion-freeness of the
base finishes.  This reproves `HNNBritton.isPowerTorsionFree_hnn`. -/
theorem isPowerTorsionFree_via_tree (φ : A ≃* B) (hG : IsPowerTorsionFree G) :
    IsPowerTorsionFree (HNNExtension G A B φ) := by
  intro x n hn hx
  obtain ⟨v, hv⟩ := exists_fixed_vertex_of_pow_eq_one φ hn.ne' hx
  obtain ⟨y, rfl⟩ := vmk_surjective φ v
  obtain ⟨g, hg⟩ := (mem_stabilizer_vmk_iff' φ x y).1
    (MulAction.mem_stabilizer_iff.2 hv)
  have hgn : (HNNExtension.of g : HNNExtension G A B φ) ^ n = 1 := by
    have h1 : (y * HNNExtension.of g * y⁻¹) ^ n = 1 := by rw [← hg]; exact hx
    rw [conj_pow] at h1
    have h2 := congrArg (fun z => y⁻¹ * z * y) h1
    simpa [mul_assoc] using h2
  have hg1 : g ^ n = 1 := by
    refine HNNExtension.of_injective φ ?_
    rw [map_pow, hgn, map_one]
  rw [hg, hG g n hn hg1, map_one, mul_one, mul_inv_cancel]

/-! ## The unique parent -/

/-- **The step lemma.**  Crossing one edge out of the vertex named by a reduced
spelling whose final syllable is `(v, c)`: either the new syllable survives and
the syllable count goes up by one, or the new syllable pinches against `(v, c)`
and the new vertex is the one named by the truncated spelling. -/
theorem step (φ : A ≃* B) (g : G) (L : List (ℤˣ × G)) (v : ℤˣ) (c : G)
    (hl : NoPinch A B (L ++ [(v, c)])) (a : G) (u : ℤˣ) :
    tLen φ (wordProd φ g (L ++ [(v, c)]) * HNNExtension.of a *
        (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) = L.length + 2 ∨
      (vmk φ (wordProd φ g (L ++ [(v, c)]) * HNNExtension.of a *
            (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ))
          = vmk φ (wordProd φ g L) ∧
        tLen φ (wordProd φ g (L ++ [(v, c)]) * HNNExtension.of a *
            (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) = L.length) := by
  have hL : NoPinch A B L := hl.infix ⟨[], [(v, c)], by simp⟩
  have hkey : wordProd φ g (L ++ [(v, c)]) * HNNExtension.of a *
        (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)
      = wordProd φ g L * ((HNNExtension.t : HNNExtension G A B φ) ^ (v : ℤ) *
          HNNExtension.of (c * a) *
          (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) := by
    rw [wordProd_concat, map_mul]
    simp only [mul_assoc]
  by_cases hpinch : c * a ∈ HNNExtension.toSubgroup A B v ∧ u = -v
  · right
    obtain ⟨hca, rfl⟩ := hpinch
    obtain ⟨d, hd⟩ := t_zpow_conj_mem_range (φ := φ) hca
    have hval : wordProd φ g (L ++ [(v, c)]) * HNNExtension.of a *
          (HNNExtension.t : HNNExtension G A B φ) ^ ((-v : ℤˣ) : ℤ)
        = wordProd φ g L * HNNExtension.of d := by
      rw [hkey, t_zpow_neg, hd]
    refine ⟨?_, ?_⟩
    · rw [hval, vmk_mul_of]
    · rw [hval, tLen_mul_of, tLen_eq φ hL rfl]
  · left
    have hseamL := (List.isChain_append.1 hl).2.2
    have hnew1 : NoPinch A B (L ++ [(v, c * a)]) :=
      List.IsChain.append hL (noPinch_singleton _) (by
        intro p hp q hq hmem
        rw [List.head?_cons, Option.mem_some_iff] at hq
        subst hq
        exact hseamL p hp (v, c) (by simp) hmem)
    have hnew : NoPinch A B ((L ++ [(v, c * a)]) ++ [(u, (1 : G))]) := by
      refine noPinch_concat hnew1 ?_
      intro hmem
      by_contra hne
      have hvu : v = -u := Int.units_ne_iff_eq_neg.1 hne
      have huv : u = -v := by rw [hvu, neg_neg]
      exact hpinch ⟨hmem, huv⟩
    have hprod : wordProd φ g ((L ++ [(v, c * a)]) ++ [(u, (1 : G))])
        = wordProd φ g (L ++ [(v, c)]) * HNNExtension.of a *
          (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) := by
      rw [wordProd_concat, wordProd_concat, map_one, mul_one, hkey]
      group
    have hlen2 : ((L ++ [((v : ℤˣ), c * a)]) ++ [((u : ℤˣ), (1 : G))]).length
        = L.length + 2 := by simp
    rw [← hprod, tLen_eq φ hnew rfl, hlen2]

/-- **The parent of a vertex is unique.**  Every vertex other than the base one
has exactly one neighbour of smaller syllable length. -/
theorem exists_parent (φ : A ≃* B) {x : HNNExtension G A B φ}
    (hx : tLen φ x ≠ 0) :
    ∃ p : HNNExtension G A B φ,
      tLen φ p + 1 = tLen φ x ∧
      (tree φ).Adj (vmk φ x) (vmk φ p) ∧
      ∀ w : HNNExtension G A B φ, (tree φ).Adj (vmk φ x) (vmk φ w) →
        tLen φ w + 1 = tLen φ x → vmk φ w = vmk φ p := by
  obtain ⟨g, l, hl, hp, hlen⟩ := tLen_mem φ x
  rcases List.eq_nil_or_concat' l with rfl | ⟨L, bb, rfl⟩
  · exact absurd hlen.symm hx
  · obtain ⟨v, c⟩ := bb
    have hL : NoPinch A B L := hl.infix ⟨[], [(v, c)], by simp⟩
    have hxt : tLen φ x = L.length + 1 := by rw [← hlen, length_concat]
    refine ⟨wordProd φ g L, ?_, ?_, ?_⟩
    · rw [tLen_eq φ hL rfl, hxt]
    · refine adj_of_eq φ (a := c⁻¹) (u := -v) (b := (1 : G)) ?_
      rw [← hp, wordProd_concat, t_zpow_neg, map_inv, map_one, mul_one]
      group
    · intro w hadj hwlen
      obtain ⟨a, b, u, hab⟩ := exists_of_adj φ hadj
      have hw2 : w = (x * HNNExtension.of a *
          (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) *
          HNNExtension.of b := by
        have hw : w = x * (HNNExtension.of a *
            (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) *
            HNNExtension.of b) := by
          rw [← hab]; group
        rw [hw]; group
      have hstep := step φ g L v c hl a u
      rw [hp] at hstep
      rcases hstep with hup | ⟨hvmk, _⟩
      · exfalso
        have hwt : tLen φ w = L.length + 2 := by
          rw [hw2, tLen_mul_of, hup]
        omega
      · rw [hw2, vmk_mul_of, hvmk]

/-- **The syllable length changes by exactly one across every edge.**  The
graph is bipartite over the parity of `tLen`. -/
theorem tLen_adj (φ : A ≃* B) {x w : HNNExtension G A B φ}
    (hadj : (tree φ).Adj (vmk φ x) (vmk φ w)) :
    tLen φ w = tLen φ x + 1 ∨ tLen φ w + 1 = tLen φ x := by
  obtain ⟨a, b, u, hab⟩ := exists_of_adj φ hadj
  have hw2 : w = (x * HNNExtension.of a *
      (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) *
      HNNExtension.of b := by
    have hw : w = x * (HNNExtension.of a *
        (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) *
        HNNExtension.of b) := by
      rw [← hab]; group
    rw [hw]; group
  have hwt : tLen φ w = tLen φ (x * HNNExtension.of a *
      (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) := by
    rw [hw2, tLen_mul_of]
  obtain ⟨g, l, hl, hp, hlen⟩ := tLen_mem φ x
  rcases List.eq_nil_or_concat' l with rfl | ⟨L, bb, rfl⟩
  · left
    have hx0 : tLen φ x = 0 := hlen.symm
    have hxg : x = HNNExtension.of g := by rw [← hp, wordProd_nil]
    have hprod : wordProd φ (g * a) [(u, (1 : G))]
        = x * HNNExtension.of a *
          (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) := by
      have h1 : wordProd φ (g * a) [(u, (1 : G))]
          = wordProd φ (g * a) [] *
            ((HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ) *
              HNNExtension.of (1 : G)) :=
        wordProd_concat φ (g * a) [] u 1
      rw [h1, wordProd_nil, map_one, mul_one, hxg, map_mul]
    have h2 : tLen φ (x * HNNExtension.of a *
        (HNNExtension.t : HNNExtension G A B φ) ^ (u : ℤ)) = 1 := by
      have h3 := tLen_eq φ (noPinch_singleton ((u : ℤˣ), (1 : G))) hprod
      simpa using h3
    omega
  · obtain ⟨v, c⟩ := bb
    have hstep := step φ g L v c hl a u
    rw [hp] at hstep
    have hxt : tLen φ x = L.length + 1 := by rw [← hlen, length_concat]
    rcases hstep with hup | ⟨_, hdown⟩
    · left; omega
    · right; omega

/-- Adjacent vertices have different syllable lengths. -/
theorem tLen_ne_of_adj (φ : A ≃* B) {x w : HNNExtension G A B φ}
    (hadj : (tree φ).Adj (vmk φ x) (vmk φ w)) : tLen φ w ≠ tLen φ x := by
  rcases tLen_adj φ hadj with h | h <;> omega

