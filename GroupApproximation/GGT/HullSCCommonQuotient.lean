import GroupApproximation.GGT.HullSC
import GroupApproximation.Manuscript.NonMF.FournierFacioInput

/-!
# Hull's Corollary 7.4: a common quotient of `E` and `H₀`

M. Hull, *Small cancellation in acylindrically hyperbolic groups*, Groups
Geom. Dyn. 10 (2016), Corollary 7.4, in the form
`Manuscript.NonMF.TheoremC.HullCommonQuotientStatement` records it:

> Applied to `E` and `H₀` it gives a surjection `π : E ↠ G₀` onto a finitely
> presented torsion-free group with property (T), injective on a prescribed
> finite subset of `E`; since `E` is finitely generated, the proof of that
> corollary produces `G₀` acylindrically hyperbolic.

## The proof, and why it is two applications of Theorem 7.1

Form the free product `Γ = E ∗ H₀`.  Its Bass-Serre tree has trivial edge
stabilizers, so `Γ` is acylindrically hyperbolic (Minasyan-Osin), and each free
factor acts non-elementarily on it; over torsion-free factors the third clause
of Hull's Definition 1.4 is free, so both factors are *suitable* in `Γ`.  That
package is `FreeProductInput`, and the assertion that it exists is
`FreeProductStatement` -- the one input of this module that is not Hull's
Theorem 7.1.

Now apply Theorem 7.1 twice.

* **First**, at `Γ`, with `N` the image of `E` and with `t₁, …, t_m` a finite
  generating set of `Γ`.  The conclusion `q₁(tᵢ) ∈ q₁(E)` forces
  `Q₁ = ⟨q₁(t₁), …, q₁(t_m)⟩ ≤ q₁(E) ≤ Q₁`, so **`Q₁` is a quotient of `E`**.
* **Second**, at `Q₁`, with `N` the image of `H₀` and with a finite generating
  set of `Q₁`.  The same display gives `Q₂ = q₂(q₁(H₀))`, so **`Q₂` is a
  quotient of `H₀`**; and `Q₂` is a quotient of `Q₁`, hence of `E`.

The second application is why Hull's theorem has to be stated with the clause
that the image of a *prescribed* suitable subgroup stays suitable
(`HullStep.suitable_map_family`): the subgroup that has to survive the first
quotient is the image of `H₀`, which is not the subgroup the first quotient was
taken along.  Hull's own induction on `m` needs only the weaker clause for `N`
itself; Corollary 7.4 needs the family.

Torsion-freeness and finite presentation are carried through each application
by the clauses of Theorem 7.1 -- finite order lifts with the order preserved,
and the kernel is normally generated by finitely many elements -- and property
(T) of `G₀` is property (T) of `H₀` transported along the surjection
`H₀ ↠ G₀`.

Everything here is proved from `HullSC.HullTowerStatement` and
`FreeProductStatement`; and `HullSC.hullTowerStatement_of_oneStep` reduces the
first of those to `HullSC.HullOneStepStatement`.  So closing Hull's Theorem 7.1
for one relator closes Corollary 7.4 as well, up to the free-product input:
`hullCommonQuotient_of_oneStep` is that statement.
-/

namespace GroupApproximation
namespace HullSC

open GroupApproximation.HullGeometry
open GroupApproximation.Manuscript.NonMF.TorsionFree

/-! ## The free product input -/

/-- **The free product `E ∗ H₀`, with everything Hull's Corollary 7.4 asks of
it.**  The construction is the free product and the geometry is the action on
its Bass-Serre tree, but nothing here commits to a construction: a term of this
structure is exactly the data the proof below consumes.

`inj` is the only injectivity needed -- the prescribed finite set lies in `E`,
so only `E` has to embed. -/
structure FreeProductInput (E H : Type) [Group E] [Group H] where
  /-- The ambient group `Γ`. -/
  Gamma : Type
  /-- Its group structure. -/
  [group : Group Gamma]
  /-- `Γ` is finitely presented. -/
  [fp : Group.IsFinitelyPresented Gamma]
  /-- `Γ` is torsion-free. -/
  torsionFree : IsPowerTorsionFree Gamma
  /-- The first factor. -/
  emb : E →* Gamma
  /-- The second factor. -/
  emb' : H →* Gamma
  /-- The first factor embeds. -/
  inj : Function.Injective emb
  /-- Hull's alphabet for `Γ`. -/
  alphabet : HullGeneratingSet Gamma
  /-- The first factor is suitable. -/
  suitable : Suitable alphabet.alphabet emb.range
  /-- The second factor is suitable. -/
  suitable' : Suitable alphabet.alphabet emb'.range

namespace FreeProductInput

instance instGroup {E H : Type} [Group E] [Group H] (I : FreeProductInput E H) :
    Group I.Gamma := I.group

instance instFP {E H : Type} [Group E] [Group H] (I : FreeProductInput E H) :
    Group.IsFinitelyPresented I.Gamma := I.fp

end FreeProductInput

/-- **The free product input, as a statement.**  Minasyan-Osin's criterion for
acylindrical hyperbolicity of a group acting on a tree, applied to the
Bass-Serre tree of `E ∗ H₀`, together with the standard closure properties of
free products (finite presentation, and torsion-freeness by Kurosh).

This is the one citation of this module that is not Hull's Theorem 7.1.  It is
owned by the trees lane; `FreeProductInput` is the interface. -/
def FreeProductStatement : Prop :=
  ∀ (E H : Type) [Group E] [Group H],
    Group.IsFinitelyPresented E → Group.IsFinitelyPresented H →
      IsPowerTorsionFree E → IsPowerTorsionFree H →
        IsAcylindricallyHyperbolic E → Infinite H →
          Nonempty (FreeProductInput E H)

/-! ## Corollary 7.4 -/

/-- **Hull's Corollary 7.4**, in the form
`Manuscript.NonMF.TheoremC.HullCommonQuotientStatement` records it, from Hull's
Theorem 7.1 and the free product input.

The proof is the two applications of Theorem 7.1 described in the module
header.  Every other step is bookkeeping already in the repository:
`Saturation.exists_finite_generating_family` for the targets,
`Saturation.map_eq_top_of_generators_mem` for the display
`Q = ⟨q(t₁), …, q(t_m)⟩ ≤ q(N) ≤ Q`,
`Saturation.torsionFree_of_finiteOrder_lift` for torsion-freeness,
`Group.IsFinitelyPresented.of_surjective` for finite presentation, and
`HasKazhdanPropertyT.of_surjective` for property (T). -/
theorem hullCommonQuotient_of_tower (htower : HullTowerStatement.{0})
    (hfree : FreeProductStatement) :
    Manuscript.NonMF.TheoremC.HullCommonQuotientStatement := by
  classical
  intro E instE H₀ instH₀ hEfp hEtf hEah hH₀inf hH₀fp hH₀tf _ hH₀T F
  letI := instE
  letI := instH₀
  -- `Γ = E ∗ H₀`, with both factors suitable.
  obtain ⟨I⟩ := hfree E H₀ hEfp hH₀fp hEtf hH₀tf hEah hH₀inf
  -- a ball of `Γ(Γ, 𝒜)` containing the image of the prescribed finite set
  have hFfin : ((I.emb : E → I.Gamma) '' (F : Set E)).Finite :=
    Set.Finite.image _ F.finite_toSet
  obtain ⟨R₁, hR₁⟩ := exists_subset_cayleyBall I.alphabet.alphabet hFfin
  -- a finite generating family of `Γ`
  obtain ⟨m, t, htop⟩ := exists_finite_generating_family I.Gamma
  -- **First application**: absorb all of `Γ` into the image of `E`.
  obtain ⟨D₁⟩ := htower (S := fun _ : Fin 1 => I.emb'.range) I.alphabet
    I.suitable (fun _ => I.suitable') t R₁
  have hq₁top : I.emb.range.map D₁.step.q = ⊤ :=
    map_eq_top_of_generators_mem D₁.step.q D₁.step.surjective htop D₁.mem_map
  have hQ₁tf : IsPowerTorsionFree D₁.step.Q :=
    torsionFree_of_finiteOrder_lift I.torsionFree D₁.step.q
      D₁.step.finiteOrder_lift
  obtain ⟨T₁, -, hT₁ker⟩ := D₁.kerNormallyGenerated
  haveI : Group.IsFinitelyPresented D₁.step.Q :=
    Group.IsFinitelyPresented.of_surjective D₁.step.q D₁.step.surjective
      ⟨(T₁ : Set I.Gamma), T₁.finite_toSet, hT₁ker.symm⟩
  -- a ball of `Γ(Q₁, 𝒜₁)` containing the image of the prescribed finite set
  have hFfin₂ : ((D₁.step.q : I.Gamma → D₁.step.Q) ''
      ((I.emb : E → I.Gamma) '' (F : Set E))).Finite := hFfin.image _
  obtain ⟨R₂, hR₂⟩ :=
    exists_subset_cayleyBall D₁.step.hullSet.alphabet hFfin₂
  -- a finite generating family of `Q₁`
  obtain ⟨m₂, t₂, htop₂⟩ := exists_finite_generating_family D₁.step.Q
  -- **Second application**: absorb all of `Q₁` into the image of `H₀`.
  obtain ⟨D₂⟩ := htower (S := fun j : Fin 0 => Fin.elim0 j) D₁.step.hullSet
    (D₁.step.suitable_map_family 0) (fun j : Fin 0 => Fin.elim0 j) t₂ R₂
  have hq₂top : (I.emb'.range.map D₁.step.q).map D₂.step.q = ⊤ :=
    map_eq_top_of_generators_mem D₂.step.q D₂.step.surjective htop₂ D₂.mem_map
  have hQ₂tf : IsPowerTorsionFree D₂.step.Q :=
    torsionFree_of_finiteOrder_lift hQ₁tf D₂.step.q D₂.step.finiteOrder_lift
  obtain ⟨T₂, -, hT₂ker⟩ := D₂.kerNormallyGenerated
  haveI hQ₂fp : Group.IsFinitelyPresented D₂.step.Q :=
    Group.IsFinitelyPresented.of_surjective D₂.step.q D₂.step.surjective
      ⟨(T₂ : Set D₁.step.Q), T₂.finite_toSet, hT₂ker.symm⟩
  -- the composite `Γ ↠ Q₂`
  have hcomp : ∀ (K : Subgroup I.Gamma),
      (K.map D₁.step.q).map D₂.step.q
        = K.map (D₂.step.q.comp D₁.step.q) := by
    intro K
    rw [Subgroup.map_map]
  -- `E ↠ Q₂`
  have hEtop : I.emb.range.map (D₂.step.q.comp D₁.step.q) = ⊤ := by
    rw [← hcomp, hq₁top]
    exact Subgroup.map_top_of_surjective D₂.step.q D₂.step.surjective
  -- `H₀ ↠ Q₂`
  have hHtop : I.emb'.range.map (D₂.step.q.comp D₁.step.q) = ⊤ := by
    rw [← hcomp]
    exact hq₂top
  have hsurj : ∀ (K : Type) [Group K] (e : K →* I.Gamma),
      e.range.map (D₂.step.q.comp D₁.step.q) = ⊤ →
        Function.Surjective ((D₂.step.q.comp D₁.step.q).comp e) := by
    intro K _ e hK y
    have hy : y ∈ e.range.map (D₂.step.q.comp D₁.step.q) := by
      rw [hK]
      exact Subgroup.mem_top y
    obtain ⟨g, hg, hgy⟩ := Subgroup.mem_map.mp hy
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hg
    refine ⟨x, ?_⟩
    show (D₂.step.q.comp D₁.step.q) (e x) = y
    rw [hx]
    exact hgy
  -- property (T) travels along `H₀ ↠ Q₂`
  have hQ₂T : HasKazhdanPropertyT.{0, 0} D₂.step.Q :=
    HasKazhdanPropertyT.of_surjective ((D₂.step.q.comp D₁.step.q).comp I.emb')
      (hsurj H₀ I.emb' hHtop) hH₀T
  refine ⟨D₂.step.Q, D₂.step.group,
    (D₂.step.q.comp D₁.step.q).comp I.emb,
    hsurj E I.emb hEtop, hQ₂fp, hQ₂tf, hQ₂T,
    isAcylindricallyHyperbolic_of_hullGeneratingSet D₂.step.hullSet, ?_⟩
  -- injectivity on the prescribed finite set
  intro x hx y hy hxy
  have hx₁ : I.emb x ∈ cayleyBall I.alphabet.alphabet R₁ :=
    hR₁ (Set.mem_image_of_mem _ hx)
  have hy₁ : I.emb y ∈ cayleyBall I.alphabet.alphabet R₁ :=
    hR₁ (Set.mem_image_of_mem _ hy)
  have hx₂ : D₁.step.q (I.emb x) ∈ cayleyBall D₁.step.hullSet.alphabet R₂ :=
    hR₂ (Set.mem_image_of_mem _ (Set.mem_image_of_mem _ hx))
  have hy₂ : D₁.step.q (I.emb y) ∈ cayleyBall D₁.step.hullSet.alphabet R₂ :=
    hR₂ (Set.mem_image_of_mem _ (Set.mem_image_of_mem _ hy))
  have hstep₂ : D₂.step.q (D₁.step.q (I.emb x))
      = D₂.step.q (D₁.step.q (I.emb y)) := hxy
  have hstep₁ : D₁.step.q (I.emb x) = D₁.step.q (I.emb y) :=
    D₂.step.injOn hx₂ hy₂ hstep₂
  exact I.inj (D₁.step.injOn hx₁ hy₁ hstep₁)

/-- **Hull's Corollary 7.4 from Hull's Theorem 7.1 for one relator.**  Closing
`HullSC.HullOneStepStatement` closes both the manuscript's `thm:hull`
(`HullSC.hullBallFormNG_of_oneStep`) and the common quotient theorem, up to the
free product input. -/
theorem hullCommonQuotient_of_oneStep (h : HullOneStepStatement.{0})
    (hfree : FreeProductStatement) :
    Manuscript.NonMF.TheoremC.HullCommonQuotientStatement :=
  hullCommonQuotient_of_tower (hullTowerStatement_of_oneStep h) hfree

end HullSC
end GroupApproximation
