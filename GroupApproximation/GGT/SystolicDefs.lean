import Mathlib.Combinatorics.SimpleGraph.Metric
import Mathlib.Combinatorics.SimpleGraph.Clique
import Mathlib.Combinatorics.SimpleGraph.Maps
import Mathlib.Algebra.Order.Group.End
import Mathlib.Data.List.Chain
import Mathlib.Logic.Relation

/-!
# Two-dimensional simplicial complexes: simple connectivity and 6-large links

Vocabulary for Carbone--Cordero--Kangaslampi--Walker Theorem 3.1(ii) and the
Januszkiewicz--Świątkowski projection lemma in dimension two.

* `TriangleComplex V`: a simple graph on `V` together with a symmetric set of triangles
  whose edges are edges of the graph.  The triangles are data: three pairwise adjacent
  vertices need not span a triangle (flagness is a consequence of systolicity, not an
  assumption).
* `TriangleMove X p q`: `q` is obtained from the edge path `p` by deleting a backtrack
  `u v u ↦ u` or by shortcutting a triangle `u v w ↦ u w` across a triangle of `X`.
  These are the elementary homotopies of edge paths in `X`.
* `SimplyConnected X`: every closed edge path based at `v` is equivalent to the constant
  path `[v]` under the equivalence relation generated by `TriangleMove X`.
* `LinksSixLarge X`: the link of every vertex (its neighbours, joined when they span a
  triangle with the vertex) has no cycle of length `3`, `4` or `5`.

## Manuscript status

Infrastructure for the torsion-free hyperbolic property (T) witness on the
Kotowski--Ollivier route; certifies no manuscript step on its own.
-/

namespace GroupApproximation
namespace Systolic

variable {V : Type*}

/-- A 2-dimensional simplicial complex: a graph and a symmetric set of triangles on its edges. -/
structure TriangleComplex (V : Type*) where
  G : SimpleGraph V
  Tri : V → V → V → Prop
  tri_swap12 : ∀ {x y z}, Tri x y z → Tri y x z
  tri_swap23 : ∀ {x y z}, Tri x y z → Tri x z y
  tri_adj : ∀ {x y z}, Tri x y z → G.Adj x y ∧ G.Adj y z ∧ G.Adj x z

variable (X : TriangleComplex V)

/-- **Elementary homotopies of edge paths in `X`.** -/
inductive TriangleMove : List V → List V → Prop
  | backtrack (p q : List V) (u v : V) (h : X.G.Adj u v) :
      TriangleMove (p ++ u :: v :: u :: q) (p ++ u :: q)
  | triangle (p q : List V) (u v w : V) (h : X.Tri u v w) :
      TriangleMove (p ++ u :: v :: w :: q) (p ++ u :: w :: q)

/-- **`X` is simply connected**: every closed edge path based at `v` reduces to the
constant path under the equivalence generated by triangle moves. -/
def SimplyConnected : Prop :=
  ∀ (v : V) (l : List V), List.IsChain X.G.Adj (v :: l ++ [v]) →
    Relation.EqvGen (TriangleMove X) (v :: l ++ [v]) [v]

/-- Vertex links (neighbours of `v`, joined when they span a triangle with `v`) have girth ≥ 6. -/
def LinksSixLarge : Prop :=
  ∀ (v : V) (c : List V), 3 ≤ c.length → c.length ≤ 5 → c.Nodup → (∀ x ∈ c, X.G.Adj v x) →
    ¬ List.IsChain (X.Tri v) (c ++ c.take 1)

/-- The automorphisms of the underlying graph form a group (`RelIso`'s instance through the
`Iso` abbrev), so an action by graph automorphisms is a homomorphism `Γ →* (X.G ≃g X.G)`. -/
example : Group (X.G ≃g X.G) := inferInstance

end Systolic
end GroupApproximation
