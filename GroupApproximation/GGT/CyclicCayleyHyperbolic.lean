import GroupApproximation.GGT.CayleyFourPointBridge
import GroupApproximation.GGT.HyperbolicFreeGroupAH
import GroupApproximation.GGT.WPDElementaryEmbedding

/-!
# The Cayley graph of a cyclic group over one generator

Osin drops the two elementary members of a filling quotient's peripheral family
with the words "As any elementary group is hyperbolic" (`embed-final.tex`,
`1956-1959`), and applies Lemma `exhyp`, the finitely generated hyperbolic case
of Theorem 2.40 of his Memoir.  Dahmani--Guirardel--Osin's Proposition 4.35 in
its printed direction asks for the same input in the shape of a hyperbolically
embedded subfamily: the empty family over a finite symmetric generating set of
the member, whose only nontrivial clause is hyperbolicity of the member's own
Cayley graph.  The members dropped in the application are cyclic, so this file
proves that clause for a group generated by one element, over the two-letter
alphabet `{y, y⁻¹}`.

## The two branches

If `m ↦ yᵐ` is injective, then the word length of `yᵐ` is exactly `|m|`: a word
in `{y, y⁻¹}` of length `L` spells `yˢ` with `|s| ≤ L`, and injectivity
identifies `s` with `m`.  So the Cayley graph is the line, and Gromov's
four-point condition holds at `δ = 0`, by the four inequalities

```
    (X - Z) + (Y - W) ≤ |X - W| + |Y - Z|
    (X - Z) - (Y - W) ≤ |Z - W| + |X - Y|
```

and their two mirror images, one for each pair of signs.

If it is not injective, some `yⁿ = 1` with `n > 0`, every element is `yʳ` with
`r < n`, and the Cayley graph has diameter at most `n`.  A bounded space is
hyperbolic, so the constant is `n`.

Both branches are needed: the four-cycle, the Cayley graph of a cyclic group of
order four over one generator, has Gromov products `1, 1, 0` at a suitable
quadruple, so it is not `0`-hyperbolic, while the line is unbounded.

The passage from the four-point condition to
`HullGeometry.IsHyperbolicSpace` is `GGT.min_gromov_le_of_fourPoint`.
-/

namespace GroupApproximation
namespace GGT
namespace CyclicCayley

open GroupApproximation.HullGeometry
open GroupApproximation.WordMetric
open GroupApproximation.Manuscript.NonMF.TorsionFree

universe u

variable {E : Type u} [Group E]

/-! ## The two-letter alphabet -/

/-- The alphabet `{y, y⁻¹}` of a group generated by `y`. -/
def pairSet (y : E) : Set E := {y, y⁻¹}

theorem mem_pairSet_iff {y x : E} : x ∈ pairSet y ↔ x = y ∨ x = y⁻¹ := by
  simp [pairSet]

theorem mem_pairSet_self (y : E) : y ∈ pairSet y :=
  mem_pairSet_iff.mpr (Or.inl rfl)

theorem inv_mem_pairSet (y : E) : y⁻¹ ∈ pairSet y :=
  mem_pairSet_iff.mpr (Or.inr rfl)

theorem finite_pairSet (y : E) : (pairSet y).Finite :=
  (Set.finite_singleton y⁻¹).insert y

/-- The two letters generate, and they are closed under inversion. -/
theorem isSymmetricGeneratingSet_pairSet (y : E)
    (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) :
    IsSymmetricGeneratingSet (pairSet y) := by
  constructor
  · intro x hx
    rcases mem_pairSet_iff.mp hx with h | h
    · rw [h]
      exact inv_mem_pairSet y
    · rw [h, inv_inv]
      exact mem_pairSet_self y
  · rw [eq_top_iff]
    intro x _
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hgen x)
    rw [← hm]
    exact Subgroup.zpow_mem _ (Subgroup.subset_closure (mem_pairSet_self y)) m

/-! ## Words in the two letters are powers -/

/-- A word in `{y, y⁻¹}` spells a power of `y` whose exponent is at most the
length of the word in absolute value. -/
theorem exists_zpow_prod {y : E} :
    ∀ {l : List E}, (∀ x ∈ l, x ∈ pairSet y) →
      ∃ s : ℤ, s.natAbs ≤ l.length ∧ l.prod = y ^ s := by
  intro l
  induction l with
  | nil =>
      intro _
      exact ⟨0, by simp, by simp⟩
  | cons a t ih =>
      intro hl
      obtain ⟨s, hs, hprod⟩ := ih (fun x hx => hl x (List.mem_cons_of_mem a hx))
      have ha : a = y ∨ a = y⁻¹ :=
        mem_pairSet_iff.mp (hl a (List.mem_cons_self ..))
      rcases ha with rfl | rfl
      · refine ⟨s + 1, ?_, ?_⟩
        · have hle : (s + 1).natAbs ≤ s.natAbs + (1 : ℤ).natAbs :=
            Int.natAbs_add_le s 1
          rw [Int.natAbs_one] at hle
          rw [List.length_cons]
          omega
        · rw [List.prod_cons, hprod,
            show (s + 1 : ℤ) = 1 + s from by ring, zpow_add, zpow_one]
      · refine ⟨s - 1, ?_, ?_⟩
        · have hle : (s - 1).natAbs ≤ s.natAbs + (1 : ℤ).natAbs :=
            Int.natAbs_sub_le s 1
          rw [Int.natAbs_one] at hle
          rw [List.length_cons]
          omega
        · rw [List.prod_cons, hprod,
            show (s - 1 : ℤ) = -1 + s from by ring, zpow_add, zpow_neg_one]

/-! ## The exponent of an element -/

/-- One integer exponent spelling a given element. -/
noncomputable def expo (y : E) (hgen : ∀ x : E, x ∈ Subgroup.zpowers y)
    (x : E) : ℤ :=
  Classical.choose (Subgroup.mem_zpowers_iff.mp (hgen x))

theorem zpow_expo (y : E) (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) (x : E) :
    y ^ expo y hgen x = x :=
  Classical.choose_spec (Subgroup.mem_zpowers_iff.mp (hgen x))

/-! ## The injective branch: the alphabet realizes the line -/

/-- With `m ↦ yᵐ` injective the word length of `yᵐ` is exactly `|m|`. -/
theorem wordNorm_zpow_eq {y : E} (hinj : Function.Injective fun m : ℤ => y ^ m)
    (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) (m : ℤ) :
    wordNorm (pairSet y) (y ^ m) = m.natAbs := by
  refine le_antisymm ?_ ?_
  · exact wordNorm_zpow_le (isSymmetricGeneratingSet_pairSet y hgen)
      (mem_pairSet_self y) m
  · obtain ⟨l, hl, hlen⟩ :=
      exists_isWord_length_eq (isSymmetricGeneratingSet_pairSet y hgen) (y ^ m)
    obtain ⟨s, hs, hprod⟩ := exists_zpow_prod (y := y) hl.letters
    have hEq : y ^ s = y ^ m := by
      rw [← hprod]
      exact hl.prod_eq
    have hsm : s = m := hinj hEq
    rw [hsm] at hs
    rw [hlen] at hs
    exact hs

/-- The word metric of the two letters is the distance between exponents. -/
theorem wordDist_pairSet_eq {y : E}
    (hinj : Function.Injective fun m : ℤ => y ^ m)
    (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) (a b : E) :
    wordDist (pairSet y) a b = (expo y hgen b - expo y hgen a).natAbs := by
  have h : a⁻¹ * b = y ^ (expo y hgen b - expo y hgen a) := by
    rw [show expo y hgen b - expo y hgen a
          = -expo y hgen a + expo y hgen b from by ring,
      zpow_add, zpow_neg, zpow_expo y hgen a, zpow_expo y hgen b]
  show wordNorm (pairSet y) (a⁻¹ * b) = (expo y hgen b - expo y hgen a).natAbs
  rw [h]
  exact wordNorm_zpow_eq hinj hgen _

/-- **Gromov's four-point condition on the reals, with no constant.**  Each of
the four sign combinations of the left-hand side is bounded by one of the two
terms on the right. -/
theorem abs_fourPoint (W X Y Z : ℝ) :
    |Y - W| + |X - Z| ≤ max (|X - W| + |Y - Z|) (|Z - W| + |X - Y|) := by
  have hXW := le_abs_self (X - W)
  have hXW' := neg_abs_le (X - W)
  have hYZ := le_abs_self (Y - Z)
  have hYZ' := neg_abs_le (Y - Z)
  have hZW := le_abs_self (Z - W)
  have hZW' := neg_abs_le (Z - W)
  have hXY := le_abs_self (X - Y)
  have hXY' := neg_abs_le (X - Y)
  rcases abs_cases (Y - W) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
      rcases abs_cases (X - Z) with ⟨h2, _⟩ | ⟨h2, _⟩ <;> rw [h1, h2]
  · refine le_trans ?_ (le_max_left _ _)
    linarith
  · refine le_trans ?_ (le_max_right _ _)
    linarith
  · refine le_trans ?_ (le_max_right _ _)
    linarith
  · refine le_trans ?_ (le_max_left _ _)
    linarith

/-- **The infinite cyclic branch.**  The Cayley graph of the two letters is the
line, so it is `0`-hyperbolic. -/
theorem isHyperbolicSpace_zero_of_injective {y : E}
    (hinj : Function.Injective fun m : ℤ => y ^ m)
    (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) (A : Alphabet E)
    (hA : A.carrier = pairSet y) :
    IsHyperbolicSpace 0 (Cayley A) := by
  have hdist : ∀ p q : Cayley A, dist p q
      = |((expo y hgen (Cayley.val p) : ℤ) : ℝ)
          - ((expo y hgen (Cayley.val q) : ℤ) : ℝ)| := by
    intro p q
    rw [Cayley.dist_eq, hA, wordDist_pairSet_eq hinj hgen, Nat.cast_natAbs,
      Int.cast_abs, Int.cast_sub, abs_sub_comm]
  intro w a b c
  simp only [gromovProduct, hdist]
  refine min_gromov_le_of_fourPoint ?_
  have hfour := abs_fourPoint ((expo y hgen (Cayley.val w) : ℤ) : ℝ)
    ((expo y hgen (Cayley.val a) : ℤ) : ℝ)
    ((expo y hgen (Cayley.val b) : ℤ) : ℝ)
    ((expo y hgen (Cayley.val c) : ℤ) : ℝ)
  linarith

/-! ## The finite branch: a bounded Cayley graph -/

/-- A vanishing integer power gives a vanishing natural power. -/
theorem pow_natAbs_eq_one {y : E} {k : ℤ} (hk : y ^ k = 1) :
    y ^ k.natAbs = 1 := by
  rcases Int.natAbs_eq k with h | h
  · have h' : y ^ ((k.natAbs : ℤ)) = 1 := by
      rw [← h]
      exact hk
    rwa [zpow_natCast] at h'
  · have h' : y ^ (-(k.natAbs : ℤ)) = 1 := by
      rw [← h]
      exact hk
    rw [zpow_neg, inv_eq_one, zpow_natCast] at h'
    exact h'

/-- With `yⁿ = 1` every element is `yʳ` for some `r < n`, so no element is
longer than `n`. -/
theorem wordNorm_le_of_pow_eq_one {y : E} {n : ℕ} (hn : 0 < n) (hy : y ^ n = 1)
    (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) (x : E) :
    wordNorm (pairSet y) x ≤ n := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hgen x)
  have hnpos : (0 : ℤ) < (n : ℤ) := by exact_mod_cast hn
  have hnz : ((n : ℤ)) ≠ 0 := ne_of_gt hnpos
  have hmod_nonneg : 0 ≤ m % (n : ℤ) := Int.emod_nonneg m hnz
  have hmod_lt : m % (n : ℤ) < (n : ℤ) := Int.emod_lt_of_pos m hnpos
  have hkey : y ^ m = y ^ (m % (n : ℤ)) := by
    conv_lhs => rw [← Int.mul_ediv_add_emod m (n : ℤ)]
    rw [zpow_add, zpow_mul, zpow_natCast, hy, one_zpow, one_mul]
  obtain ⟨r, hrcast⟩ : ∃ r : ℕ, ((r : ℤ)) = m % (n : ℤ) :=
    ⟨(m % (n : ℤ)).toNat, Int.toNat_of_nonneg hmod_nonneg⟩
  have hxr : y ^ r = x := by
    rw [← zpow_natCast, hrcast, ← hkey]
    exact hm
  have hrlt : ((r : ℤ)) < ((n : ℤ)) := by
    rw [hrcast]
    exact hmod_lt
  have hrlt' : r < n := by exact_mod_cast hrlt
  rw [← hxr]
  exact le_trans (wordNorm_pow_le (isSymmetricGeneratingSet_pairSet y hgen)
    (mem_pairSet_self y) r) (le_of_lt hrlt')

/-- **The finite cyclic branch.**  The Cayley graph has diameter at most `n`,
and a bounded space is hyperbolic. -/
theorem isHyperbolicSpace_of_pow_eq_one {y : E} {n : ℕ} (hn : 0 < n)
    (hy : y ^ n = 1) (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) (A : Alphabet E)
    (hA : A.carrier = pairSet y) :
    IsHyperbolicSpace (n : ℝ) (Cayley A) := by
  refine isHyperbolicSpace_of_bounded ?_
  intro p q
  rw [Cayley.dist_eq]
  have h : wordNorm (pairSet y) ((Cayley.val p)⁻¹ * Cayley.val q) ≤ n :=
    wordNorm_le_of_pow_eq_one hn hy hgen _
  have h' : wordDist A.carrier (Cayley.val p) (Cayley.val q) ≤ n := by
    rw [hA]
    exact h
  exact_mod_cast h'

/-! ## The two branches together -/

/-- **A group generated by one element has a hyperbolic Cayley graph over the
two letters `{y, y⁻¹}`.**  This is the input Proposition 4.35 needs to drop a
cyclic member of a peripheral family, and it is the content of Osin's "any
elementary group is hyperbolic" in the cyclic case. -/
theorem exists_isHyperbolicSpace_cayley_of_zpowers {y : E}
    (hgen : ∀ x : E, x ∈ Subgroup.zpowers y) (A : Alphabet E)
    (hA : A.carrier = pairSet y) :
    ∃ delta : ℝ, IsHyperbolicSpace delta (Cayley A) := by
  by_cases hinj : Function.Injective fun m : ℤ => y ^ m
  · exact ⟨0, isHyperbolicSpace_zero_of_injective hinj hgen A hA⟩
  · obtain ⟨a, b, hab, hne⟩ : ∃ a b : ℤ, y ^ a = y ^ b ∧ a ≠ b := by
      by_contra hcon
      apply hinj
      intro u v huv
      by_contra hne
      exact hcon ⟨u, v, huv, hne⟩
    have hone : y ^ (a - b) = 1 := by
      rw [zpow_sub, hab, mul_inv_cancel]
    have hpos : 0 < (a - b).natAbs := Int.natAbs_pos.mpr (sub_ne_zero.mpr hne)
    exact ⟨((a - b).natAbs : ℝ),
      isHyperbolicSpace_of_pow_eq_one hpos (pow_natAbs_eq_one hone) hgen A hA⟩

/-! ## Model tests -/

/-- Every element of the integers is a power of one generator. -/
theorem mem_zpowers_ofAdd_one (x : Multiplicative ℤ) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ℤ)) := by
  refine Subgroup.mem_zpowers_iff.mpr ⟨Multiplicative.toAdd x, ?_⟩
  rw [← ofAdd_zsmul, zsmul_eq_mul, mul_one, Int.cast_id]

/-- **The unbounded model.**  The infinite cyclic group over one generator: the
injective branch applies and the Cayley graph is the line. -/
theorem exists_isHyperbolicSpace_line :
    ∃ delta : ℝ, IsHyperbolicSpace delta
      (Cayley (⟨pairSet (Multiplicative.ofAdd (1 : ℤ)),
        isSymmetricGeneratingSet_pairSet _ mem_zpowers_ofAdd_one⟩ :
          Alphabet (Multiplicative ℤ))) :=
  exists_isHyperbolicSpace_cayley_of_zpowers mem_zpowers_ofAdd_one _ rfl

/-- **The degenerate model.**  A group generated by the identity is trivial, the
bounded branch applies, and the bound is `1`. -/
theorem wordNorm_pairSet_one_le (hgen : ∀ x : E, x ∈ Subgroup.zpowers (1 : E))
    (x : E) : wordNorm (pairSet (1 : E)) x ≤ 1 :=
  wordNorm_le_of_pow_eq_one Nat.one_pos (one_pow 1) hgen x

