import GroupApproximation.GGT.DGOProposition435
import GroupApproximation.GGT.HullLemma35Printed
import GroupApproximation.Meta.AxiomGuard

/-!
# Hull's Lemma 3.5: the relative generating set of the subfamilies

The manuscript's paragraph on Fournier-Facio's group (section `sec:torsion-free`, tex 1680-1684)
says:

> The group $G_0$ is obtained there as a common quotient of two finitely generated acylindrically
> hyperbolic groups by Hull's theorem~\cite[Corollary~7.4]{Hull}, which allows the quotient to be
> chosen acylindrically hyperbolic; we take $G_0$ to be such a quotient.

Hull's proof of Corollary 7.4 (arXiv:1308.4345v2, §7) uses Lemma 3.5 (§3, p. 12): if
`{H_i} ↪h G` and `{K_{ij}}_j ↪h H_i` for each `i`, then `{K_{ij}}_{i,j} ↪h G`.  The statement is
`PrintedHullLemma35` in `GGT/HullLemma35Printed.lean`.

This module builds the relative generating set that witnesses the conclusion.  Given `D` with
peripheral family `H` and, for each `i`, a structure `E i` on `H i`, it takes:

* base letters: the letters of `D.base` that lie in no `H i` (`RelHyp.properBase`), together
  with the images of the bases of the `E i`;
* members: `K_{ij}` carried into `G` along `H i ↪ G`.

The base is inversion-closed and generates with the members, because every `H i` is generated by
the letters of `E i` (`isSymmetricGeneratingSet_transitive`).  Every letter is a letter of `D`
(`transitive_alphabet_subset`).

The base in Hull's printed statement is existential, so dropping the peripheral letters of
`D.base` costs nothing.  Keeping them fails: `RelGenSet` needs an inversion-closed alphabet, but
the inverse of a letter of `D.base` that lies in `H i` may be a letter only of `H i`.
-/

namespace GroupApproximation
namespace GGT
namespace HullLemma35

open GroupApproximation.WordMetric

universe u v w

variable {G : Type u} [Group G] {Λ : Type v} {M : Λ → Type w}

/-- **The base of the transitive structure**: the proper letters of `D.base`, and the images of
the bases of the `E i`. -/
def transitiveBase (D : RelGenSet G Λ) (E : ∀ i : Λ, RelGenSet (D.fam i) (M i)) : Set G :=
  RelHyp.properBase D ∪ ⋃ i : Λ, (D.fam i).subtype '' (E i).base

/-- **The members of the transitive structure**: `K_{ij}` carried into `G`. -/
def transitiveFam (D : RelGenSet G Λ) (E : ∀ i : Λ, RelGenSet (D.fam i) (M i))
    (p : (i : Λ) × M i) : Subgroup G :=
  ((E p.1).fam p.2).map (D.fam p.1).subtype

/-- Every member of `H i` is a product of images of letters of `E i`, so it lies in the subgroup
generated by the transitive alphabet. -/
theorem fam_subset_closure_transitive (D : RelGenSet G Λ) (E : ∀ i : Λ, RelGenSet (D.fam i) (M i))
    (i : Λ) :
    ((D.fam i : Subgroup G) : Set G) ⊆ Subgroup.closure
      (transitiveBase D E ∪ ⋃ p : (i : Λ) × M i, ((transitiveFam D E p : Subgroup G) : Set G)) := by
  intro x hx
  have hmem : (⟨x, hx⟩ : D.fam i) ∈
      Subgroup.closure ((E i).base ∪ ⋃ j : M i, (((E i).fam j : Subgroup (D.fam i)) : Set (D.fam i))) := by
    rw [(E i).symmetricGenerating.closure_eq]
    exact Subgroup.mem_top _
  have hmap := Subgroup.mem_map_of_mem (D.fam i).subtype hmem
  rw [MonoidHom.map_closure] at hmap
  refine Subgroup.closure_mono ?_ hmap
  rintro y ⟨e, he, rfl⟩
  rcases he with hb | hf
  · exact Or.inl (Or.inr (Set.mem_iUnion.mpr ⟨i, ⟨e, hb, rfl⟩⟩))
  · obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hf
    exact Or.inr (Set.mem_iUnion.mpr ⟨⟨i, j⟩, ⟨e, hj, rfl⟩⟩)

/-- **The transitive alphabet is symmetric and generates `G`.** -/
theorem isSymmetricGeneratingSet_transitive (D : RelGenSet G Λ)
    (E : ∀ i : Λ, RelGenSet (D.fam i) (M i)) :
    IsSymmetricGeneratingSet
      (transitiveBase D E ∪ ⋃ p : (i : Λ) × M i, ((transitiveFam D E p : Subgroup G) : Set G)) := by
  refine ⟨?_, ?_⟩
  · rintro x ((hx | hx) | hx)
    · exact Or.inl (Or.inl (RelHyp.properBase_inv D hx))
    · obtain ⟨i, e, he, rfl⟩ := Set.mem_iUnion.mp hx
      rcases (E i).symmetricGenerating.inv_mem e (Or.inl he) with hb | hf
      · exact Or.inl (Or.inr (Set.mem_iUnion.mpr ⟨i, ⟨e⁻¹, hb, map_inv _ e⟩⟩))
      · obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hf
        exact Or.inr (Set.mem_iUnion.mpr ⟨⟨i, j⟩, ⟨e⁻¹, hj, map_inv _ e⟩⟩)
    · obtain ⟨p, hp⟩ := Set.mem_iUnion.mp hx
      have hp' : x ∈ transitiveFam D E p := hp
      exact Or.inr (Set.mem_iUnion.mpr ⟨p, (transitiveFam D E p).inv_mem hp'⟩)
  · rw [eq_top_iff, ← D.symmetricGenerating.closure_eq, Subgroup.closure_le]
    rintro x (hb | hf)
    · rcases RelHyp.base_subset_properBase_union D hb with hp | hf
      · exact Subgroup.subset_closure (Or.inl (Or.inl hp))
      · obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hf
        exact fam_subset_closure_transitive D E i hi
    · obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hf
      exact fam_subset_closure_transitive D E i hi

/-- **The transitive relative generating set** of `G` over `{K_{ij}}_{i,j}`. -/
def transitiveRelGenSet (D : RelGenSet G Λ) (E : ∀ i : Λ, RelGenSet (D.fam i) (M i)) :
    RelGenSet G ((i : Λ) × M i) where
  base := transitiveBase D E
  fam := transitiveFam D E
  symmetricGenerating := isSymmetricGeneratingSet_transitive D E

@[simp] theorem transitiveRelGenSet_base (D : RelGenSet G Λ)
    (E : ∀ i : Λ, RelGenSet (D.fam i) (M i)) :
    (transitiveRelGenSet D E).base = transitiveBase D E := rfl

@[simp] theorem transitiveRelGenSet_fam (D : RelGenSet G Λ)
    (E : ∀ i : Λ, RelGenSet (D.fam i) (M i)) (p : (i : Λ) × M i) :
    (transitiveRelGenSet D E).fam p = ((E p.1).fam p.2).map (D.fam p.1).subtype := rfl

/-- **Every transitive letter is a letter of `D`.** -/
theorem transitive_alphabet_subset (D : RelGenSet G Λ) (E : ∀ i : Λ, RelGenSet (D.fam i) (M i)) :
    (transitiveRelGenSet D E).alphabet.carrier ⊆ D.alphabet.carrier := by
  rintro x ((hx | hx) | hx)
  · exact Or.inl (RelHyp.properBase_subset_base D hx)
  · obtain ⟨i, e, -, rfl⟩ := Set.mem_iUnion.mp hx
    exact Or.inr (Set.mem_iUnion.mpr ⟨i, e.2⟩)
  · obtain ⟨p, hp⟩ := Set.mem_iUnion.mp hx
    obtain ⟨e, -, rfl⟩ := (show x ∈ transitiveFam D E p from hp)
    exact Or.inr (Set.mem_iUnion.mpr ⟨p.1, e.2⟩)

/-- The letters of a relative generating set spell elements of its alphabet. -/
theorem val_mem_alphabet {Λ' : Type*} (J : RelGenSet G Λ') {a : RelLetter G Λ'}
    (ha : J.IsLetter a) : a.val ∈ J.alphabet.carrier := by
  cases a with
  | base x => exact Or.inl ha
  | comp lam h => exact Or.inr (Set.mem_iUnion.mpr ⟨lam, ha⟩)

/-- A letter of `J` that is a component letter of `lam` spells an element of `J.fam lam`. -/
theorem val_mem_of_isCompOf {Λ' : Type*} (J : RelGenSet G Λ') {lam : Λ'} {b : RelLetter G Λ'}
    (hb : J.IsLetter b) (hc : RelLetter.IsCompOf lam b) : b.val ∈ J.fam lam := by
  cases b with
  | base x => exact (hc : False).elim
  | comp mu h =>
      obtain rfl : mu = lam := hc
      exact hb

/-- Every element of the alphabet of `J` is spelled by one letter of `J`. -/
theorem exists_letter_of_mem_alphabet {Λ' : Type*} (J : RelGenSet G Λ') {x : G}
    (hx : x ∈ J.alphabet.carrier) : ∃ b : RelLetter G Λ', J.IsLetter b ∧ b.val = x := by
  rcases hx with hb | hf
  · exact ⟨RelLetter.base x, hb, rfl⟩
  · obtain ⟨lam, hlam⟩ := Set.mem_iUnion.mp hf
    exact ⟨RelLetter.comp lam x, hlam, rfl⟩

end HullLemma35
end GGT
end GroupApproximation

#audit_axioms GroupApproximation.GGT.HullLemma35.isSymmetricGeneratingSet_transitive
#audit_axioms GroupApproximation.GGT.HullLemma35.transitive_alphabet_subset
#audit_axioms GroupApproximation.GGT.HullLemma35.val_mem_of_isCompOf
