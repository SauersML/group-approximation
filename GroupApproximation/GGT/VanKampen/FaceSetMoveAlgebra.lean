import GroupApproximation.GGT.VanKampen.FaceSetWordHomotopy
import GroupApproximation.GGT.VanKampen.FaceSetWordHomotopyCore

/-!
# The word algebra of face-set peel moves

`FaceSetMoveSequence` is generated by four elementary moves: erasing or
inserting a complete selected face boundary, and erasing or inserting an
immediately adjacent `alpha`-pair.  Because both erasures come paired with
their insertions, the relation is an equivalence relation which is stable
under concatenation on either side.  That is exactly the presentation of the
group generated by the darts modulo `d * alpha d = 1` and one relator per
selected face.

The consequence proved here is the one the planar peel producer needs: a
*cyclic rotation* of a trivial word is trivial.  Rotation is not a generator,
and indeed it must not be one — a rotation conjugates the value of a dart
word, so a rotation generator would be unsound for the value theorem in
`GRegionBoundaryValue`.  It is nevertheless *derivable* for words which are
already trivial, by inserting the cancelling pair `invDarts A ++ A` in front
and erasing it again at the end.  So the base dart of a `FaceSetBoundary` is
free for a peel producer, and the one-face model no longer needs its cycle to
start exactly where `Delta.faceBoundary` starts.
-/

namespace GroupApproximation
namespace GGT
namespace VanKampen
namespace Embedded

open GroupApproximation.HullSC

universe u w v

variable {G : Type u} [Group G] {Lambda : Type w}
  {W : Set (List (GGT.RelLetter G Lambda))}
  {Delta : DiscDiagram.{u, w, v} W}

/-- The reverse-orientation list of the empty dart list is empty. -/
theorem invDarts_nil :
    invDarts Delta ([] : List Delta.toCombMap.Dart) = [] := by
  simp [invDarts]

/-- Prefixing a dart appends its reverse at the end of the inverse list. -/
theorem invDarts_cons (dart : Delta.toCombMap.Dart)
    (darts : List Delta.toCombMap.Dart) :
    invDarts Delta (dart :: darts) =
      invDarts Delta darts ++ [Delta.toCombMap.alpha dart] := by
  simp [invDarts]

/-! ## Elementary moves are reversible and context stable -/

/-- Every elementary peel move has an elementary inverse: the two erasure
generators are inverse to the two insertion generators. -/
theorem FaceSetElementaryMove.symm
    {faces : Finset Delta.toCombMap.Face}
    {first second : List Delta.toCombMap.Dart}
    (move : FaceSetElementaryMove (faces := faces) first second) :
    FaceSetElementaryMove (faces := faces) second first := by
  cases move with
  | eraseFace face hface before after =>
      exact FaceSetElementaryMove.insertFace face hface before after
  | insertFace face hface before after =>
      exact FaceSetElementaryMove.eraseFace face hface before after
  | eraseAlphaPair dart before after =>
      exact FaceSetElementaryMove.insertAlphaPair dart before after
  | insertAlphaPair dart before after =>
      exact FaceSetElementaryMove.eraseAlphaPair dart before after

/-- An elementary move stays an elementary move inside any word context. -/
theorem FaceSetElementaryMove.append_context
    {faces : Finset Delta.toCombMap.Face}
    {first second : List Delta.toCombMap.Dart}
    (move : FaceSetElementaryMove (faces := faces) first second)
    (pre post : List Delta.toCombMap.Dart) :
    FaceSetElementaryMove (faces := faces)
      (pre ++ first ++ post) (pre ++ second ++ post) := by
  cases move with
  | eraseFace face hface before after =>
      have hleft :
          pre ++ (before ++ (Delta.faceBoundary face).darts ++ after) ++ post =
            (pre ++ before) ++ (Delta.faceBoundary face).darts ++
              (after ++ post) := by
        simp only [List.append_assoc]
      have hright : pre ++ (before ++ after) ++ post =
          (pre ++ before) ++ (after ++ post) := by
        simp only [List.append_assoc]
      rw [hleft, hright]
      exact FaceSetElementaryMove.eraseFace face hface (pre ++ before)
        (after ++ post)
  | insertFace face hface before after =>
      have hleft : pre ++ (before ++ after) ++ post =
          (pre ++ before) ++ (after ++ post) := by
        simp only [List.append_assoc]
      have hright :
          pre ++ (before ++ (Delta.faceBoundary face).darts ++ after) ++ post =
            (pre ++ before) ++ (Delta.faceBoundary face).darts ++
              (after ++ post) := by
        simp only [List.append_assoc]
      rw [hleft, hright]
      exact FaceSetElementaryMove.insertFace face hface (pre ++ before)
        (after ++ post)
  | eraseAlphaPair dart before after =>
      have hleft :
          pre ++ (before ++ dart :: Delta.toCombMap.alpha dart :: after) ++
              post =
            (pre ++ before) ++ dart :: Delta.toCombMap.alpha dart ::
              (after ++ post) := by
        simp only [List.append_assoc, List.cons_append]
      have hright : pre ++ (before ++ after) ++ post =
          (pre ++ before) ++ (after ++ post) := by
        simp only [List.append_assoc]
      rw [hleft, hright]
      exact FaceSetElementaryMove.eraseAlphaPair dart (pre ++ before)
        (after ++ post)
  | insertAlphaPair dart before after =>
      have hleft : pre ++ (before ++ after) ++ post =
          (pre ++ before) ++ (after ++ post) := by
        simp only [List.append_assoc]
      have hright :
          pre ++ (before ++ dart :: Delta.toCombMap.alpha dart :: after) ++
              post =
            (pre ++ before) ++ dart :: Delta.toCombMap.alpha dart ::
              (after ++ post) := by
        simp only [List.append_assoc, List.cons_append]
      rw [hleft, hright]
      exact FaceSetElementaryMove.insertAlphaPair dart (pre ++ before)
        (after ++ post)

namespace FaceSetMoveSequence

/-! ## Move sequences form a congruence -/

/-- A single elementary move is a one-step move sequence. -/
theorem single
    {faces : Finset Delta.toCombMap.Face}
    {first second : List Delta.toCombMap.Dart}
    (move : FaceSetElementaryMove (faces := faces) first second) :
    FaceSetMoveSequence (faces := faces) first second :=
  FaceSetMoveSequence.cons move (FaceSetMoveSequence.refl second)

/-- Move sequences compose. -/
theorem trans
    {faces : Finset Delta.toCombMap.Face}
    {first second third : List Delta.toCombMap.Dart}
    (moves : FaceSetMoveSequence (faces := faces) first second)
    (later : FaceSetMoveSequence (faces := faces) second third) :
    FaceSetMoveSequence (faces := faces) first third := by
  revert later
  induction moves with
  | refl _ => exact fun h => h
  | cons head _ ih => exact fun h => FaceSetMoveSequence.cons head (ih h)

/-- Move sequences are reversible: every generator has an inverse
generator. -/
theorem symm
    {faces : Finset Delta.toCombMap.Face}
    {first second : List Delta.toCombMap.Dart}
    (moves : FaceSetMoveSequence (faces := faces) first second) :
    FaceSetMoveSequence (faces := faces) second first := by
  induction moves with
  | refl word => exact FaceSetMoveSequence.refl word
  | cons head _ ih =>
      exact ih.trans (FaceSetMoveSequence.single head.symm)

/-- Move sequences are stable under concatenation on both sides. -/
theorem append_context
    {faces : Finset Delta.toCombMap.Face}
    {first second : List Delta.toCombMap.Dart}
    (moves : FaceSetMoveSequence (faces := faces) first second)
    (pre post : List Delta.toCombMap.Dart) :
    FaceSetMoveSequence (faces := faces)
      (pre ++ first ++ post) (pre ++ second ++ post) := by
  induction moves with
  | refl word => exact FaceSetMoveSequence.refl (pre ++ word ++ post)
  | cons head _ ih =>
      exact FaceSetMoveSequence.cons (head.append_context pre post) ih

/-! ## Cancelling an `alpha`-pair in either order -/

/-- The reverse-first form of the `alpha`-pair erasure.  It is the erasure
generator applied to `alpha dart`, using that `alpha` is an involution. -/
theorem eraseAlphaPair_reverse
    {faces : Finset Delta.toCombMap.Face}
    (dart : Delta.toCombMap.Dart)
    (before after : List Delta.toCombMap.Dart) :
    FaceSetMoveSequence (faces := faces)
      (before ++ Delta.toCombMap.alpha dart :: dart :: after)
      (before ++ after) := by
  have hinv : Delta.toCombMap.alpha (Delta.toCombMap.alpha dart) = dart :=
    Delta.toCombMap.alpha_involutive dart
  have hmove : FaceSetElementaryMove (faces := faces)
      (before ++ Delta.toCombMap.alpha dart ::
        Delta.toCombMap.alpha (Delta.toCombMap.alpha dart) :: after)
      (before ++ after) :=
    FaceSetElementaryMove.eraseAlphaPair (Delta.toCombMap.alpha dart) before
      after
  rw [hinv] at hmove
  exact FaceSetMoveSequence.single hmove

/-- A dart list followed by its reverse-orientation list is trivial. -/
theorem append_invDarts
    {faces : Finset Delta.toCombMap.Face}
    (darts : List Delta.toCombMap.Dart) :
    FaceSetMoveSequence (faces := faces) (darts ++ invDarts Delta darts) [] := by
  induction darts with
  | nil =>
      have hnil : ([] : List Delta.toCombMap.Dart) ++
          invDarts Delta ([] : List Delta.toCombMap.Dart) = [] := by
        simp [invDarts]
      rw [hnil]
      exact FaceSetMoveSequence.refl []
  | cons dart darts ih =>
      have hsplit : (dart :: darts) ++ invDarts Delta (dart :: darts) =
          [dart] ++ (darts ++ invDarts Delta darts) ++
            [Delta.toCombMap.alpha dart] := by
        rw [invDarts_cons]
        simp
      have hpair : FaceSetMoveSequence (faces := faces)
          ([dart] ++ ([] : List Delta.toCombMap.Dart) ++
            [Delta.toCombMap.alpha dart]) [] := by
        have hmove : FaceSetElementaryMove (faces := faces)
            (([] : List Delta.toCombMap.Dart) ++
              dart :: Delta.toCombMap.alpha dart :: ([] : List Delta.toCombMap.Dart))
            (([] : List Delta.toCombMap.Dart) ++
              ([] : List Delta.toCombMap.Dart)) :=
          FaceSetElementaryMove.eraseAlphaPair dart [] []
        have hmove' : FaceSetElementaryMove (faces := faces)
            ([dart] ++ ([] : List Delta.toCombMap.Dart) ++
              [Delta.toCombMap.alpha dart])
            ([] : List Delta.toCombMap.Dart) := by
          simpa using hmove
        exact FaceSetMoveSequence.single hmove'
      rw [hsplit]
      exact (ih.append_context [dart] [Delta.toCombMap.alpha dart]).trans hpair

/-- The reverse-orientation list followed by the original dart list is
trivial. -/
theorem invDarts_append
    {faces : Finset Delta.toCombMap.Face}
    (darts : List Delta.toCombMap.Dart) :
    FaceSetMoveSequence (faces := faces) (invDarts Delta darts ++ darts) [] := by
  induction darts with
  | nil =>
      have hnil : invDarts Delta ([] : List Delta.toCombMap.Dart) ++
          ([] : List Delta.toCombMap.Dart) = [] := by
        simp [invDarts]
      rw [hnil]
      exact FaceSetMoveSequence.refl []
  | cons dart darts ih =>
      have hsplit : invDarts Delta (dart :: darts) ++ (dart :: darts) =
          invDarts Delta darts ++
            Delta.toCombMap.alpha dart :: dart :: darts := by
        rw [invDarts_cons]
        simp
      rw [hsplit]
      exact (FaceSetMoveSequence.eraseAlphaPair_reverse dart
        (invDarts Delta darts) darts).trans ih

/-! ## Rotation of a trivial word -/

/-- Cyclic rotation of a trivial word is trivial.  The proof conjugates by
the cancelling pair `invDarts left ++ left`; no rotation generator is
added. -/
theorem rotate_nil
    {faces : Finset Delta.toCombMap.Face}
    (left right : List Delta.toCombMap.Dart)
    (moves : FaceSetMoveSequence (faces := faces) (left ++ right) []) :
    FaceSetMoveSequence (faces := faces) (right ++ left) [] := by
  have hcancel : FaceSetMoveSequence (faces := faces)
      (invDarts Delta left ++ left) [] :=
    FaceSetMoveSequence.invDarts_append left
  have hstart : FaceSetMoveSequence (faces := faces)
      (right ++ left) ((invDarts Delta left ++ left) ++ (right ++ left)) := by
    have hstep := hcancel.symm.append_context
      ([] : List Delta.toCombMap.Dart) (right ++ left)
    simpa using hstep
  have hmid : FaceSetMoveSequence (faces := faces)
      ((invDarts Delta left ++ left) ++ (right ++ left))
      (invDarts Delta left ++ left) := by
    have hstep := moves.append_context (invDarts Delta left) left
    have hleft : invDarts Delta left ++ (left ++ right) ++ left =
        (invDarts Delta left ++ left) ++ (right ++ left) := by
      simp
    have hright : invDarts Delta left ++ ([] : List Delta.toCombMap.Dart) ++
        left = invDarts Delta left ++ left := by
      simp
    rw [hleft, hright] at hstep
    exact hstep
  exact (hstart.trans hmid).trans hcancel

/-- Rotating a trivial word by an arbitrary amount keeps it trivial. -/
theorem of_rotate
    {faces : Finset Delta.toCombMap.Face}
    {word : List Delta.toCombMap.Dart} (k : ℕ)
    (moves : FaceSetMoveSequence (faces := faces) word []) :
    FaceSetMoveSequence (faces := faces) (word.rotate k) [] := by
  have hsplit : word.rotate k =
      word.drop (k % word.length) ++ word.take (k % word.length) :=
    List.rotate_eq_drop_append_take_mod
  have hword : word.take (k % word.length) ++ word.drop (k % word.length) =
      word := List.take_append_drop _ word
  rw [hsplit]
  apply FaceSetMoveSequence.rotate_nil
  rw [hword]
  exact moves

/-! ## Face boundaries and exposed arcs -/

/-- The complete boundary of a selected face is a trivial word. -/
theorem faceBoundary_nil
    {faces : Finset Delta.toCombMap.Face}
    {face : Delta.toCombMap.Face} (hface : face ∈ faces) :
    FaceSetMoveSequence (faces := faces) (Delta.faceBoundary face).darts [] := by
  have hmove : FaceSetElementaryMove (faces := faces)
      (([] : List Delta.toCombMap.Dart) ++ (Delta.faceBoundary face).darts ++
        ([] : List Delta.toCombMap.Dart))
      (([] : List Delta.toCombMap.Dart) ++ ([] : List Delta.toCombMap.Dart)) :=
    FaceSetElementaryMove.eraseFace face hface [] []
  have hmove' : FaceSetElementaryMove (faces := faces)
      (Delta.faceBoundary face).darts ([] : List Delta.toCombMap.Dart) := by
    simpa using hmove
  exact FaceSetMoveSequence.single hmove'

/-- Every cyclic rotation of the boundary of a selected face is a trivial
word.  This is the basepoint freedom used by the peel producer. -/
theorem faceBoundary_rotate_nil
    {faces : Finset Delta.toCombMap.Face}
    {face : Delta.toCombMap.Face} (hface : face ∈ faces) (k : ℕ) :
    FaceSetMoveSequence (faces := faces)
      ((Delta.faceBoundary face).darts.rotate k) [] :=
  FaceSetMoveSequence.of_rotate k (FaceSetMoveSequence.faceBoundary_nil hface)

/-- If an exposed arc together with the rest of a face boundary is trivial,
then the arc may be replaced by the reverse orientation of that rest.  This is
the single word move performed when a planar ear is peeled. -/
theorem to_invDarts
    {faces : Finset Delta.toCombMap.Face}
    (arc interior : List Delta.toCombMap.Dart)
    (moves : FaceSetMoveSequence (faces := faces) (arc ++ interior) []) :
    FaceSetMoveSequence (faces := faces) arc (invDarts Delta interior) := by
  have hcancel : FaceSetMoveSequence (faces := faces)
      (interior ++ invDarts Delta interior) [] :=
    FaceSetMoveSequence.append_invDarts interior
  have hstart : FaceSetMoveSequence (faces := faces)
      arc (arc ++ (interior ++ invDarts Delta interior)) := by
    have hstep := hcancel.symm.append_context arc
      ([] : List Delta.toCombMap.Dart)
    simpa using hstep
  have hfinish : FaceSetMoveSequence (faces := faces)
      (arc ++ (interior ++ invDarts Delta interior))
      (invDarts Delta interior) := by
    have hstep := moves.append_context ([] : List Delta.toCombMap.Dart)
      (invDarts Delta interior)
    have hleft : ([] : List Delta.toCombMap.Dart) ++ (arc ++ interior) ++
        invDarts Delta interior =
          arc ++ (interior ++ invDarts Delta interior) := by
      simp
    have hright : ([] : List Delta.toCombMap.Dart) ++
        ([] : List Delta.toCombMap.Dart) ++ invDarts Delta interior =
          invDarts Delta interior := by
      simp
    rw [hleft, hright] at hstep
    exact hstep
  exact hstart.trans hfinish

end FaceSetMoveSequence

