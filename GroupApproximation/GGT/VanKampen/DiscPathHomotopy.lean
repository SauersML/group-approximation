import GroupApproximation.GGT.VanKampen.CombMap
import GroupApproximation.GGT.VanKampen.DiscDiagram
import GroupApproximation.GGT.VanKampen.CombMapStars

/-!
# Rooted paths and face-boundary homotopy

This module gives the path vocabulary used by the girth-eight Cayley-label
construction without importing the higher-level girth-eight primitives.  A
path is an inductive list of oriented darts with typed endpoints.  The
homotopy relation is generated by insertion or erasure of an inner-face
boundary and by immediate edge backtracking.

The exact planar completeness assertion is exposed as
`RootedPathsFaceComplete`, the name consumed by the girth-eight interface.
The present clean Van Kampen import boundary contains the rotation-system
facts and the canonical ordered face boundaries, but not the face-deletion
map required to carry out the planar induction.  Accordingly,
`FaceDeletionCompletenessWitness` is the explicit handoff for that missing
topological operation; no proposition is proved by an unsound declaration.
The elementary model below uses the canonical face boundary of the committed
six-dart one-triangle map.
-/

namespace GroupApproximation
namespace GGT
namespace GirthEightPrimitives2

open GroupApproximation.GGT.VanKampen

universe u w v

/-! ## Typed dart paths -/

/-- A directed edge path in the one-skeleton of a combinatorial map. -/
inductive DartPath (M : CombMap.{u}) : M.Vertex → M.Vertex → Type u
  | nil (vertex : M.Vertex) : DartPath M vertex vertex
  | cons (dart : M.Dart) {finish : M.Vertex}
      (rest : DartPath M (M.vertexOf (M.alpha dart)) finish) :
      DartPath M (M.vertexOf dart) finish

namespace DartPath

variable {M : CombMap.{u}}

/-- Concatenate two typed dart paths. -/
def append {x y z : M.Vertex} :
    DartPath M x y → DartPath M y z → DartPath M x z
  | .nil _, q => q
  | .cons d rest, q => .cons d (rest.append q)

/-- The one-edge path in the direction of a dart. -/
def single (d : M.Dart) :
    DartPath M (M.vertexOf d) (M.vertexOf (M.alpha d)) :=
  .cons d (.nil _)

/-- The ordered darts traversed by a typed path. -/
def darts {x y : M.Vertex} : DartPath M x y → List M.Dart
  | .nil _ => []
  | .cons d rest => d :: rest.darts

@[simp]
theorem darts_append {x y z : M.Vertex}
    (p : DartPath M x y) (q : DartPath M y z) :
    (p.append q).darts = p.darts ++ q.darts := by
  induction p with
  | nil => rfl
  | cons d rest ih => simp [append, darts, ih]

@[simp]
theorem darts_single (d : M.Dart) : (single d).darts = [d] :=
  rfl

end DartPath

/-! ## Root choices and elementary face moves -/

/-- A chosen path from one root vertex to every vertex of a connected map. -/
structure RootedPathSystem (M : CombMap.{u}) where
  /-- The common initial vertex. -/
  root : M.Vertex
  /-- The selected path from the root to a target vertex. -/
  pathTo : ∀ vertex, DartPath M root vertex

/-- Inserting or erasing a complete inner-face boundary, or an immediate
edge backtrack, is the elementary planar path move.  The relation is on dart
words because the endpoint typing is supplied by the surrounding paths. -/
inductive InnerFaceWordHomotopy
    {G : Type u} [Group G] {Lambda : Type w}
    {W : Set (List (GGT.RelLetter G Lambda))}
    (Delta : DiscDiagram.{u, w, v} W) :
    List Delta.toCombMap.Dart → List Delta.toCombMap.Dart → Prop
  | refl (word) : InnerFaceWordHomotopy Delta word word
  | erase (face : Delta.toCombMap.Face) (hface : face ≠ Delta.outerFace)
      (before after : List Delta.toCombMap.Dart) :
      InnerFaceWordHomotopy Delta
        (before ++ (Delta.faceBoundary face).darts ++ after) (before ++ after)
  | eraseBacktrack (dart : Delta.toCombMap.Dart)
      (before after : List Delta.toCombMap.Dart) :
      InnerFaceWordHomotopy Delta
        (before ++ dart :: Delta.toCombMap.alpha dart :: after) (before ++ after)
  | symm {a b} : InnerFaceWordHomotopy Delta a b →
      InnerFaceWordHomotopy Delta b a
  | trans {a b c} : InnerFaceWordHomotopy Delta a b →
      InnerFaceWordHomotopy Delta b c → InnerFaceWordHomotopy Delta a c

namespace InnerFaceWordHomotopy

variable {G : Type u} [Group G] {Lambda : Type w}
  {W : Set (List (GGT.RelLetter G Lambda))}
  {Delta : DiscDiagram.{u, w, v} W}

/-- Every word is homotopic to itself. -/
theorem refl_word (word : List Delta.toCombMap.Dart) :
    InnerFaceWordHomotopy Delta word word :=
  .refl word

/-- Elementary face erasure can be reversed to insertion. -/
theorem insert_innerFace
    (face : Delta.toCombMap.Face) (hface : face ≠ Delta.outerFace)
    (before after : List Delta.toCombMap.Dart) :
    InnerFaceWordHomotopy Delta
      (before ++ after)
      (before ++ (Delta.faceBoundary face).darts ++ after) :=
  .symm (.erase face hface before after)

/-- Homotopy is an equivalence relation. -/
theorem equivalence : Equivalence (@InnerFaceWordHomotopy G _ Lambda _ Delta) := by
  refine ⟨refl_word, ?_, ?_⟩
  · intro a b h
    exact .symm h
  · intro a b c hab hbc
    exact .trans hab hbc

end InnerFaceWordHomotopy

/-! ## The exact consumer proposition -/

/-- Two rooted edge paths to the same vertex differ by inner-face boundary
insertions/erasures and immediate backtracks.  This is the exact proposition
expected by the girth-eight path-integral consumer. -/
abbrev RootedPathsFaceComplete
    {G : Type u} [Group G] {Lambda : Type w}
    {W : Set (List (GGT.RelLetter G Lambda))}
    (Delta : DiscDiagram.{u, w, v} W)
    (R : RootedPathSystem Delta.toCombMap) : Prop :=
  ∀ (vertex : Delta.toCombMap.Vertex)
    (p q : DartPath Delta.toCombMap R.root vertex),
    InnerFaceWordHomotopy Delta p.darts q.darts

/-- A face-deletion implementation supplies exactly the output needed by
`RootedPathsFaceComplete`.  The eventual proof may establish this witness by
strong induction on the number of inner faces, deleting one enclosed face at
each step and lifting the resulting homotopy back across the surgery. -/
structure FaceDeletionCompletenessWitness
    {G : Type u} [Group G] {Lambda : Type w}
    {W : Set (List (GGT.RelLetter G Lambda))}
    (Delta : DiscDiagram.{u, w, v} W)
    (R : RootedPathSystem Delta.toCombMap) : Prop where
  /-- The lifted induction conclusion for every endpoint and path pair. -/
  complete : RootedPathsFaceComplete Delta R

/-- The clean interface turns a face-deletion witness into the exact named
path-completeness proposition. -/
theorem rootedPathsFaceComplete_of_faceDeletion
    {G : Type u} [Group G] {Lambda : Type w}
    {W : Set (List (GGT.RelLetter G Lambda))}
    (Delta : DiscDiagram.{u, w, v} W)
    (R : RootedPathSystem Delta.toCombMap)
    (H : FaceDeletionCompletenessWitness Delta R) :
    RootedPathsFaceComplete Delta R :=
  H.complete

/-! ## One-triangle model checks -/

noncomputable section OneTriangleModel

local instance oneTriangleDartDecidableEq : DecidableEq OneTriangleDart :=
  Classical.decEq _

/-- The canonical ordered boundary of the one-triangle model is the closed
orbit list supplied by the Van Kampen boundary API. -/
theorem oneTriangle_faceBoundary_model (d : OneTriangleDart) :
    (FaceBoundary.based oneTriangleCombMap d).darts =
      closedOrbitList oneTriangleCombMap.facePerm d :=
  rfl

/-- The elementary insertion/erasure constructor is inhabited on the
one-triangle face boundary.  This tests the exact face-move relation on the
six-dart one-triangle disc skeleton. -/
theorem oneTriangle_faceMove_model
    {G : Type u} [Group G] {Lambda : Type w}
    {W : Set (List (GGT.RelLetter G Lambda))}
    (Delta : DiscDiagram.{u, w, v} W)
    (face : Delta.toCombMap.Face) (hface : face ≠ Delta.outerFace)
    (before after : List Delta.toCombMap.Dart) :
    InnerFaceWordHomotopy Delta
      (before ++ (Delta.faceBoundary face).darts ++ after)
      (before ++ after) :=
  .erase face hface before after

end OneTriangleModel

end GirthEightPrimitives2
end GGT
end GroupApproximation
