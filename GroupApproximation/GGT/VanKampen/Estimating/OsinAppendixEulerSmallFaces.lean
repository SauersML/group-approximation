/-!
# The small faces of `Φ'_M` with one outer vertex

Osin, arXiv:math/0411039v3, Appendix, proof of Lemma 9.3: "By (∗), every region of it (except
possibly for the outer one) has degree at least three. Hence f ≤ 2e/3+1. By the Euler formula, we
have e ≤ v+f −2 ≤ v+2e/3−1. This implies e ≤ 3(v − 1) ≤ 3(n + 3) ≤ 12n."

The subdivided multigraph `phiMapO family E` (`Estimating/OsinAppendixEulerExterior.lean`) merges
Osin's outer vertices `O_1, …, O_r` into one vertex, the outer face.  On the component `E` of an
exterior region, Euler's count is `|E| + 6 ≤ 3|ends of E| + t`, where `t` counts the faces of
degree less than six (`card_add_six_le_linkedComponentO`).  This module splits `t` into three named
counts and assembles `PhiPrimeCountInput` from them.

* `FaceClassO`, `faceOf_eq_of_faceClassO`: a face class of the collapsed map lies in one face of
  `Φ'_M`, through (J).
* `HoldsCornerO`, `HoldsCellO`: a face holds a corner of the sections, or a relator cell that is
  not an end of `E`.
* `CornerFacesInput` (C4), `CellFacesInput` (C5), `SmallFaceHoldsInput` (C6′): the three counts.
* `phiPrimeCountInput_of_smallFaces`: `PhiPrimeCountInput` from the three counts.

## Manuscript status

Infrastructure for `thm:hull` (tex 1636, through Osin's Lemma 9.7(a)); certifies no printed
sentence on its own.
-/

namespace GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate

universe u w v

variable {G : Type u} [Group G] {Lambda : Type w} {W : Set (List (RelLetter G Lambda))}
  {D : RelGenSet G Lambda} {eps : ℕ} {Delta : DiscDiagram.{u, w, v} W}
  {family E : Finset (RegionCandidate D eps Delta)}

/-- The faces of `Φ'_M` of degree less than six, counted by
`card_add_six_le_linkedComponentO`. -/
noncomputable def smallFacesO (family E : Finset (RegionCandidate D eps Delta)) :
    Finset (phiMapO family E).Face :=
  Finset.univ.filter fun f => (phiMapO family E).faceDegree f < 6

theorem mem_smallFacesO {f : (phiMapO family E).Face} :
    f ∈ smallFacesO family E ↔ (phiMapO family E).faceDegree f < 6 := by
  simp only [smallFacesO, Finset.mem_filter, Finset.mem_univ, true_and]

/-- The regions of `family` outside `E`. -/
noncomputable def outsideO (family E : Finset (RegionCandidate D eps Delta)) :
    Finset (RegionCandidate D eps Delta) := by
  classical
  exact family \ E

theorem mem_outsideO {a : RegionCandidate D eps Delta} :
    a ∈ outsideO family E ↔ a ∈ family ∧ a ∉ E := by
  classical
  simp only [outsideO, Finset.mem_sdiff]

theorem card_outsideO_add_card (h : E ⊆ family) :
    (outsideO family E).card + E.card = family.card := by
  classical
  exact Finset.card_sdiff_add_card_eq_card h

/-- **The face class of a dart of the collapsed map**: the equivalence generated by advancing
around a vertex of the collapsed map, and by crossing an edge that `Φ'_M` does not cross. -/
def FaceClassO (family E : Finset (RegionCandidate D eps Delta)) :
    (collapsedMap family).Dart → (collapsedMap family).Dart → Prop :=
  Relation.EqvGen (CombMap.FaceClassStep (collapsedMap family).dual (PhiKeepO family E))

/-- The face class of `x` meets the face `f` of `Φ'_M`. -/
def ClassMeetsO (family E : Finset (RegionCandidate D eps Delta))
    (x : (collapsedMap family).Dart) (f : (phiMapO family E).Face) : Prop :=
  ∃ y : (phiMapO family E).Dart, (phiMapO family E).faceOf y = f ∧ FaceClassO family E x y.1

/-- **The face `f` of `Φ'_M` holds a relator cell** that is not an end of a region of `E`: the
face class of a dart on the cell meets `f`. -/
def HoldsCellO (family E : Finset (RegionCandidate D eps Delta)) (f : (phiMapO family E).Face) :
    Prop :=
  ∃ i : Fin Delta.rCellCount, some i ∉ endCellsO E ∧
    ∃ x : (collapsedMap family).Dart, Delta.toCombMap.faceOf x.1 = (cell Delta i).face ∧
      ClassMeetsO family E x f

/-- **The face `f` of `Φ'_M` holds a corner of the sections**: the face class of a dart at an
end of the boundary edge at the start of a section meets `f`.  Both ends are allowed, so the
corner between two sections is held whichever end of that edge it is. -/
def HoldsCornerO {lambda c : ℝ} {word : List (RelLetter G Lambda)}
    (cuts : SectionCuts D lambda c word) (family E : Finset (RegionCandidate D eps Delta))
    (f : (phiMapO family E).Face) : Prop :=
  ∃ k : Fin cuts.count, ∃ d : Delta.toCombMap.Dart,
    (outerDarts Delta)[cuts.cut k.castSucc % (outerDarts Delta).length]? = some d ∧
      ∃ x : (collapsedMap family).Dart,
        (Delta.toCombMap.vertexOf x.1 = Delta.toCombMap.vertexOf d ∨
          Delta.toCombMap.vertexOf x.1 = Delta.toCombMap.vertexOf (Delta.toCombMap.alpha d)) ∧
        ClassMeetsO family E x f

/-- The small faces of `Φ'_M` that hold a corner of the sections. -/
noncomputable def cornerFacesO {lambda c : ℝ} {word : List (RelLetter G Lambda)}
    (cuts : SectionCuts D lambda c word) (family E : Finset (RegionCandidate D eps Delta)) :
    Finset (phiMapO family E).Face := by
  classical
  exact (smallFacesO family E).filter (HoldsCornerO cuts family E)

theorem mem_cornerFacesO {lambda c : ℝ} {word : List (RelLetter G Lambda)}
    {cuts : SectionCuts D lambda c word} {f : (phiMapO family E).Face} :
    f ∈ cornerFacesO cuts family E ↔
      f ∈ smallFacesO family E ∧ HoldsCornerO cuts family E f := by
  classical
  simp only [cornerFacesO, Finset.mem_filter]

/-- The small faces of `Φ'_M` that hold a relator cell that is not an end of `E`. -/
noncomputable def cellFacesO (family E : Finset (RegionCandidate D eps Delta)) :
    Finset (phiMapO family E).Face := by
  classical
  exact (smallFacesO family E).filter (HoldsCellO family E)

theorem mem_cellFacesO {f : (phiMapO family E).Face} :
    f ∈ cellFacesO family E ↔ f ∈ smallFacesO family E ∧ HoldsCellO family E f := by
  classical
  simp only [cellFacesO, Finset.mem_filter]

/-- **A face class of the collapsed map lies in one face of `Φ'_M`**, when the regions of `E` are
linked through shared ends: (J) at the restriction `phiMapO family E` of the planar dual of the
collapsed map. -/
theorem faceOf_eq_of_faceClassO (P : ExtPhiData family E)
    (hlinked : ∀ a ∈ E, ∀ b ∈ E, Relation.ReflTransGen (SharesEndO E) a b)
    {y y' : (phiMapO family E).Dart} (h : FaceClassO family E y.1 y'.1) :
    (phiMapO family E).faceOf y = (phiMapO family E).faceOf y' := by
  refine (phiMapO_isRestriction family E).faceOf_eq_of_faceClass
    (CombMap.dual_planar _ (collapsedMap_planar P.pairwise y.1)) (phiMapO_connected P hlinked) ?_
  refine Relation.EqvGen.mono ?_ _ _ h
  intro a b hab
  rcases hab with hab | ⟨hna, hab⟩
  · exact Or.inl hab
  · refine Or.inr ⟨fun hmem => hna ?_, hab⟩
    obtain ⟨z, rfl⟩ := hmem
    exact z.2

end GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate

namespace GroupApproximation.GGT.VanKampen

universe u w v

open Embedded

variable {G : Type u} [Group G] {Lambda : Type w}

/-- **C4: the corners of the sections hold at most `2r` small faces of `Φ'_M`.**  From the
proof of Osin's Lemma 9.3: "By (∗), every region of it (except possibly for the outer one) has
degree at least three."  Take a least-area diagram, a globally distinguished system `S` without
loops or multiple edges, and an exterior region `a₀` of `S`.  On the component of `a₀`, at most
`2r` small faces of `Φ'_M` hold a corner of the sections, where `r` is the number of sections.

The route: the darts of the collapsed map at one vertex of `Δ` form one orbit of its rotation, so
one face class, and each end of each of the `r` boundary edges gives at most one face
(`faceOf_eq_of_faceClassO`). -/
def CornerFacesInput (D : RelGenSet G Lambda) (lambda c : ℝ) (eps : ℕ)
    (W : Set (List (RelLetter G Lambda))) : Prop :=
  ∀ (Delta : DiscDiagram.{u, w, v} W) (cuts : SectionCuts D lambda c Delta.boundaryWord),
    Delta.LeastArea →
      ∀ S : GloballyDistinguishedSectionFamily D lambda c eps Delta cuts,
        S.NoLoops → S.NoMultipleEdges →
          ∀ a₀ ∈ S.family, a₀.2.target = none →
            (RegionCandidate.cornerFacesO cuts S.family
              (RegionCandidate.linkedComponentO S.family a₀)).card ≤ 2 * cuts.count

/-- **C5: the small faces of `Φ'_M` that hold a relator cell, with the regions outside the
component.**  From the proof of Osin's Lemma 9.3: "By (∗), every region of it (except possibly for
the outer one) has degree at least three."  Take a least-area diagram with `n` relator cells, a
globally distinguished system `S` without loops or multiple edges, and an exterior region `a₀` of
`S`, with component `E` and ends `V`.  The small faces of `Φ'_M` on `E` that hold a relator cell
not in `V`, plus the regions of `S` outside `E`, plus `3|V|`, number at most `3n + 3`.

The route: the cells not in `V`, joined by the regions outside `E`, split into components.  Each
component lies in one face class, so the small faces holding a cell inject into the components
(`faceOf_eq_of_faceClassO`).  `card_le_of_endpoints` bounds the regions of a component with `m`
cells by `3(m − 1)`, and `V` holds `|V| − 1` cells. -/
def CellFacesInput (D : RelGenSet G Lambda) (lambda c : ℝ) (eps : ℕ)
    (W : Set (List (RelLetter G Lambda))) : Prop :=
  ∀ (Delta : DiscDiagram.{u, w, v} W) (cuts : SectionCuts D lambda c Delta.boundaryWord),
    Delta.LeastArea →
      ∀ S : GloballyDistinguishedSectionFamily D lambda c eps Delta cuts,
        S.NoLoops → S.NoMultipleEdges →
          ∀ a₀ ∈ S.family, a₀.2.target = none →
            (RegionCandidate.cellFacesO S.family
                (RegionCandidate.linkedComponentO S.family a₀)).card +
              (RegionCandidate.outsideO S.family
                (RegionCandidate.linkedComponentO S.family a₀)).card +
              3 * (RegionCandidate.endCellsO
                (RegionCandidate.linkedComponentO S.family a₀)).card ≤
              3 * S.diagram.rCellCount + 3

/-- **C6′: every small face of `Φ'_M` holds a corner of the sections or a relator cell.**  Osin,
the assumption before Lemma 9.3: "For any distinguished system of ε-contiguity subdiagrams `M` in
`∆`, the graph `Φ_M` is simple and inside every 2-gon of `Φ′_M`, there is a vertex of `Φ_M`."
Here the outer vertices are merged, so a two-gon whose gap at the outer vertex holds a corner is
not a two-gon of Osin's `Φ′_M`.  Take a least-area diagram, a globally distinguished system `S`
without loops or multiple edges, and an exterior region `a₀` of `S`.  On the component of `a₀`,
every face of `Φ'_M` of degree less than six holds a corner or a relator cell that is not an end.

The route: a small face is a two-gon between two different exterior regions `a`, `b` of one cell
(`exterior_of_isTwoGon`), or the only face when the component has one region.  If the face holds
no corner, `a` and `b` target one section.  If it also holds no relator cell, the pocket between
`a` and `b` holds no relator cell and meets no other selected region, and `EmptyTwoGonInput`
gives a contradiction. -/
def SmallFaceHoldsInput (D : RelGenSet G Lambda) (lambda c : ℝ) (eps : ℕ)
    (W : Set (List (RelLetter G Lambda))) : Prop :=
  ∀ (Delta : DiscDiagram.{u, w, v} W) (cuts : SectionCuts D lambda c Delta.boundaryWord),
    Delta.LeastArea →
      ∀ S : GloballyDistinguishedSectionFamily D lambda c eps Delta cuts,
        S.NoLoops → S.NoMultipleEdges →
          ∀ a₀ ∈ S.family, a₀.2.target = none →
            ∀ f ∈ RegionCandidate.smallFacesO S.family
                (RegionCandidate.linkedComponentO S.family a₀),
              RegionCandidate.HoldsCornerO cuts S.family
                  (RegionCandidate.linkedComponentO S.family a₀) f ∨
                RegionCandidate.HoldsCellO S.family
                  (RegionCandidate.linkedComponentO S.family a₀) f

/-- **`PhiPrimeCountInput` from the three counts of the small faces of `Φ'_M`**: Osin's "This
implies e ≤ 3(v − 1)" with the outer vertices merged.

With an exterior region `a₀`, let `E` be its component, `V` its ends and `t` its small faces.
Then `|E| + 6 ≤ 3|V| + t` (`card_add_six_le_linkedComponentO`), `t` is at most the corner faces
plus the cell faces (C6′), the corner faces number at most `2r` (C4), and C5 bounds the rest,
so `|M| ≤ 3n + 2r − 3 ≤ 3(n + r − 1)`.  Without an exterior region every region joins two cells, and
`card_le_of_endpoints` gives `|M| ≤ 3(n − 1)`. -/
theorem phiPrimeCountInput_of_smallFaces {D : RelGenSet G Lambda} {lambda c : ℝ} {eps : ℕ}
    {W : Set (List (RelLetter G Lambda))}
    (hcorner : CornerFacesInput.{u, w, v} D lambda c eps W)
    (hcell : CellFacesInput.{u, w, v} D lambda c eps W)
    (hholds : SmallFaceHoldsInput.{u, w, v} D lambda c eps W) :
    PhiPrimeCountInput.{u, w, v} D lambda c eps W := by
  intro Delta cuts hlea hcells S hloops hmulti
  classical
  have hleaS : S.diagram.LeastArea := S.equiv.leastArea hlea
  have hn : S.diagram.rCellCount = Delta.rCellCount := S.equiv.rCellCount_eq
  have hr := cuts.count_pos
  by_cases hext : ∃ a₀ ∈ S.family, a₀.2.target = none
  · obtain ⟨a₀, ha₀, hat⟩ := hext
    have P : RegionCandidate.ExtPhiData S.family S.family :=
      { subset := Finset.Subset.refl _
        pairwise := S.pairwise
        cell_not_mem := fun a _ i =>
          (a.2.innerGRegion hleaS).cells_avoid _ (cell_mem S.diagram i)
        nondegenerate := S.nondegenerate
        noLoop := hloops }
    have h2 : (RegionCandidate.linkedComponentO S.family a₀).card + 6 ≤
        3 * (RegionCandidate.endCellsO (RegionCandidate.linkedComponentO S.family a₀)).card +
          (RegionCandidate.smallFacesO S.family
            (RegionCandidate.linkedComponentO S.family a₀)).card :=
      RegionCandidate.card_add_six_le_linkedComponentO P ha₀
    have hsmall : RegionCandidate.smallFacesO S.family
        (RegionCandidate.linkedComponentO S.family a₀) ⊆
          RegionCandidate.cornerFacesO cuts S.family
              (RegionCandidate.linkedComponentO S.family a₀) ∪
            RegionCandidate.cellFacesO S.family
              (RegionCandidate.linkedComponentO S.family a₀) := by
      intro f hf
      rcases hholds Delta cuts hlea S hloops hmulti a₀ ha₀ hat f hf with h | h
      · exact Finset.mem_union_left _ (RegionCandidate.mem_cornerFacesO.mpr ⟨hf, h⟩)
      · exact Finset.mem_union_right _ (RegionCandidate.mem_cellFacesO.mpr ⟨hf, h⟩)
    have hT := (Finset.card_le_card hsmall).trans (Finset.card_union_le _ _)
    have h4 := hcorner Delta cuts hlea S hloops hmulti a₀ ha₀ hat
    have h5 := hcell Delta cuts hlea S hloops hmulti a₀ ha₀ hat
    have hsd := RegionCandidate.card_outsideO_add_card
      (RegionCandidate.linkedComponentO_subset S.family a₀)
    omega
  · have P : RegionCandidate.PhiData S.family S.family :=
      { subset := Finset.Subset.refl _
        pairwise := S.pairwise
        cell_not_mem := fun a _ i =>
          (a.2.innerGRegion hleaS).cells_avoid _ (cell_mem S.diagram i)
        interior := fun a ha => Option.isSome_iff_ne_none.mpr fun h => hext ⟨a, ha, h⟩
        nondegenerate := S.nondegenerate
        noLoop := hloops
        noMultiple := hmulti }
    have h := RegionCandidate.card_le_of_endpoints P Finset.univ
      (fun _ _ _ => Finset.mem_univ _) ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
    simp only [Finset.card_univ, Fintype.card_fin] at h
    omega

end GroupApproximation.GGT.VanKampen

#audit_axioms GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate.card_outsideO_add_card
#audit_axioms GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate.mem_cornerFacesO
#audit_axioms GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate.mem_cellFacesO
#audit_axioms GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate.faceOf_eq_of_faceClassO
