/-!
# The small faces of `Φ'_M` with one outer vertex

Osin, arXiv:math/0411039v3, Appendix, proof of Lemma 9.3: "By (∗), every region of it (except
possibly for the outer one) has degree at least three. Hence f ≤ 2e/3+1. By the Euler formula, we
have e ≤ v+f −2 ≤ v+2e/3−1. This implies e ≤ 3(v − 1) ≤ 3(n + 3) ≤ 12n."

The subdivided multigraph `phiMapO family E` (`Estimating/OsinAppendixEulerExterior.lean`) merges
Osin's outer vertices `O_1, …, O_r` into one vertex, the outer face.  On the component `C` of an
exterior region, Euler's count is `|C| + 6 ≤ 3|ends of C| + t`, where `t` counts the faces of
degree less than six (`card_add_six_le_linkedComponentO`).  When `C` has two regions, every such
face is a two-gon (`isTwoGon_of_faceDegree_lt_six`).  This module assembles `PhiPrimeCountInput`
from three named pieces.

* `CornerTwoGonInput` (C4, `Estimating/OsinAppendixEulerCornerTwoGon.lean`): at most `r` two-gons
  have a corner in their gap at the outer vertex.
* `CellFaceCountInput` (C5, `Estimating/OsinAppendixEulerExteriorCellFaces.lean`): the faces that
  hold a relator cell, against the regions outside `C` and the cells that are not ends.
* `TwoGonHoldsInput` (C6′): every two-gon has a corner in its gap or holds a relator cell.
* `phiPrimeCountInput_of_smallFaces`: `PhiPrimeCountInput` from the three pieces.

`faceOf_eq_of_faceClassO` is (J) at `phiMapO family E`: a face class of the collapsed map lies in
one face of `Φ'_M`.

## Manuscript status

Infrastructure for `thm:hull` (tex 1636, through Osin's Lemma 9.7(a)); certifies no printed
sentence on its own.
-/

namespace GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate

universe u w v

variable {G : Type u} [Group G] {Lambda : Type w} {W : Set (List (RelLetter G Lambda))}
  {D : RelGenSet G Lambda} {eps : ℕ} {Delta : DiscDiagram.{u, w, v} W}
  {family E : Finset (RegionCandidate D eps Delta)}

/-- **The face class of a dart of the collapsed map**: the equivalence generated by advancing
around a vertex of the collapsed map, and by crossing an edge that `Φ'_M` does not cross. -/
def FaceClassO (family E : Finset (RegionCandidate D eps Delta)) :
    (collapsedMap family).Dart → (collapsedMap family).Dart → Prop :=
  Relation.EqvGen (CombMap.FaceClassStep (collapsedMap family).dual (PhiKeepO family E))

/-- **A face class of the collapsed map lies in one face of `Φ'_M`**, when the regions of `E` are
linked through shared ends: (J) at the restriction `phiMapO family E` of the planar dual of the
collapsed map. -/
theorem faceOf_eq_of_faceClassO (P : ExtPhiData family E)
    (hlinked : ∀ a ∈ E, ∀ b ∈ E, Relation.ReflTransGen (SharesEndO E) a b)
    {y y' : (phiMapO family E).Dart} (h : FaceClassO family E y.1 y'.1) :
    (phiMapO family E).faceOf y = (phiMapO family E).faceOf y' := by
  refine (phiMapO_isRestriction family E).faceOf_eq_of_faceClass
    (CombMap.dual_planar _ (collapsedMap_planar P.pairwise y.1)) (phiMapO_connected P hlinked) ?_
  refine Relation.EqvGen.mono ?_ _ _ h
  intro a b hab
  rcases hab with hab | ⟨hna, hab⟩
  · exact Or.inl hab
  · refine Or.inr ⟨fun hmem => hna ?_, hab⟩
    obtain ⟨z, rfl⟩ := hmem
    exact z.2

end GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate

namespace GroupApproximation.GGT.VanKampen

universe u w v

open Embedded

variable {G : Type u} [Group G] {Lambda : Type w}

/-- **C6′: every two-gon of `Φ'_M` has a corner in its gap or holds a relator cell.**  Osin, the
assumption before Lemma 9.3: "For any distinguished system of ε-contiguity subdiagrams `M` in
`∆`, the graph `Φ_M` is simple and inside every 2-gon of `Φ′_M`, there is a vertex of `Φ_M`."
Here the outer vertices are merged, so a two-gon with a corner in its gap at the outer vertex is
not a two-gon of Osin's `Φ′_M`.  Take a least-area diagram, a globally distinguished system `S`
without loops or multiple edges, an exterior region `a₀` of `S` and its component `C`.  A two-gon
of `phiMapO S.family C` with no corner in its gap (`GapAtOHoldsCorner`) that holds no relator
cell other than an end of `C` (`HoldsCellO`) gives a contradiction.

The route: the two-gon passes through one cell `i` and two different regions `a`, `b`.  If both
join `i` to a second cell, `S.NoMultipleEdges` is contradicted.  Otherwise both are exterior
regions of `i`.  With no corner in the gap, `a` and `b` target one section.  If the two-gon also
holds no relator cell, the pocket between `a` and `b` holds no relator cell and meets no other
selected region, and `EmptyTwoGonInput` gives a contradiction.  A pocket built by
`PocketRegion.ofSimpleClosedWalk` follows its boundary (`ofSimpleClosedWalk_followsBoundary`). -/
def TwoGonHoldsInput (D : RelGenSet G Lambda) (lambda c : ℝ) (eps : ℕ)
    (W : Set (List (RelLetter G Lambda))) : Prop :=
  ∀ (Delta : DiscDiagram.{u, w, v} W) (cuts : SectionCuts D lambda c Delta.boundaryWord),
    Delta.LeastArea →
      ∀ S : GloballyDistinguishedSectionFamily D lambda c eps Delta cuts,
        S.NoLoops → S.NoMultipleEdges →
          ∀ a₀ ∈ S.family, a₀.2.target = none →
            ∀ (P : RegionCandidate.ExtPhiData S.family
                (RegionCandidate.linkedComponentO S.family a₀))
              (f : (RegionCandidate.phiMapO S.family
                (RegionCandidate.linkedComponentO S.family a₀)).Face),
              (RegionCandidate.phiSubdividedMultigraphO P).IsTwoGon f →
              ¬RegionCandidate.GapAtOHoldsCorner cuts S.family
                (RegionCandidate.linkedComponentO S.family a₀) f →
              ¬RegionCandidate.HoldsCellO S.family
                (RegionCandidate.linkedComponentO S.family a₀) f →
              False

open scoped Classical in
/-- **`PhiPrimeCountInput` from C4, C5 and C6′**: Osin's "This implies e ≤ 3(v − 1)" with the
outer vertices merged.

With an exterior region `a₀`, let `C` be its component, `V` its ends, `t` its small faces, `H` the
faces holding a relator cell that is not an end, and `N` the cells that are not ends.  Then
`|C| + 6 ≤ 3|V| + t` (`card_add_six_le_linkedComponentO`).  C5 gives `|M| + 3H ≤ |C| + 3N`, and
`N + |V| ≤ n + 1`.  If `|C| ≥ 2`, `Φ'_M` has more than four darts, so every small face is a
two-gon, and C6′ and C4 give `t ≤ r + H`; so `|M| ≤ 3n + r − 3`.  If `|C| = 1`, `V` holds the
source of `a₀` and `none`, and C5 alone gives `|M| ≤ 3n − 2`.  Without an exterior region every
region joins two cells, and `card_le_of_endpoints` gives `|M| ≤ 3(n − 1)`. -/
theorem phiPrimeCountInput_of_smallFaces {D : RelGenSet G Lambda} {lambda c : ℝ} {eps : ℕ}
    {W : Set (List (RelLetter G Lambda))}
    (hcorner : CornerTwoGonInput.{u, w, v} D lambda c eps W)
    (hcell : CellFaceCountInput.{u, w, v} D eps W)
    (hholds : TwoGonHoldsInput.{u, w, v} D lambda c eps W) :
    PhiPrimeCountInput.{u, w, v} D lambda c eps W := by
  intro Delta cuts hlea hcells S hloops hmulti
  have hleaS : S.diagram.LeastArea := S.equiv.leastArea hlea
  have hn : S.diagram.rCellCount = Delta.rCellCount := S.equiv.rCellCount_eq
  have hr := cuts.count_pos
  by_cases hext : ∃ a₀ ∈ S.family, a₀.2.target = none
  · obtain ⟨a₀, ha₀, hat⟩ := hext
    have P : RegionCandidate.ExtPhiData S.family S.family :=
      { subset := Finset.Subset.refl _
        pairwise := S.pairwise
        cell_not_mem := fun a _ i =>
          (a.2.innerGRegion hleaS).cells_avoid _ (cell_mem S.diagram i)
        nondegenerate := S.nondegenerate
        noLoop := hloops }
    obtain ⟨C, hC⟩ : ∃ C, RegionCandidate.linkedComponentO S.family a₀ = C := ⟨_, rfl⟩
    have h2 := RegionCandidate.card_add_six_le_linkedComponentO P ha₀
    have h5 := hcell S.diagram S.family S.family P hmulti a₀ ha₀ hat
    have h6 := hholds Delta cuts hlea S hloops hmulti a₀ ha₀ hat
    have hlinked := RegionCandidate.linked_linkedComponentO S.family a₀
    have hsubC := RegionCandidate.linkedComponentO_subset S.family a₀
    have ha₀C := RegionCandidate.self_mem_linkedComponentO ha₀
    rw [hC] at h2 h5 h6 hlinked hsubC ha₀C
    have hsrc : some a₀.2.source ∈ RegionCandidate.endCellsO C :=
      RegionCandidate.sideCellO_mem_endCellsO ha₀C true
    have hnone : a₀.2.target ∈ RegionCandidate.endCellsO C :=
      RegionCandidate.sideCellO_mem_endCellsO ha₀C false
    rw [hat] at hnone
    have hV2 : 2 ≤ (RegionCandidate.endCellsO C).card := by
      have hpair : ({some a₀.2.source, none} : Finset (Option (Fin S.diagram.rCellCount))) ⊆
          RegionCandidate.endCellsO C := by
        intro x hx
        rcases Finset.mem_insert.mp hx with rfl | hx
        · exact hsrc
        · rw [Finset.mem_singleton.mp hx]
          exact hnone
      exact (Finset.card_pair (Option.some_ne_none _)).symm.le.trans (Finset.card_le_card hpair)
    have hends : (Finset.univ.filter fun i : Fin S.diagram.rCellCount =>
        some i ∉ RegionCandidate.endCellsO C).card + (RegionCandidate.endCellsO C).card ≤
          S.diagram.rCellCount + 1 := by
      have hsplit := Finset.card_filter_add_card_filter_not
        (s := (Finset.univ : Finset (Fin S.diagram.rCellCount)))
        (fun i => some i ∈ RegionCandidate.endCellsO C)
      have hins : RegionCandidate.endCellsO C ⊆ Finset.insertNone
          (Finset.univ.filter fun i : Fin S.diagram.rCellCount =>
            some i ∈ RegionCandidate.endCellsO C) := by
        intro x hx
        refine Finset.mem_insertNone.mpr fun i hi => ?_
        obtain rfl := Option.mem_def.mp hi
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hx⟩
      have hle := Finset.card_le_card hins
      rw [Finset.card_insertNone] at hle
      simp only [Finset.card_univ, Fintype.card_fin] at hsplit
      omega
    by_cases hC2 : 2 ≤ C.card
    · have P' : RegionCandidate.ExtPhiData S.family C := P.mono hsubC
      have hconn := RegionCandidate.phiMapO_connected P' hlinked
      have hcount : 4 < (RegionCandidate.phiMapO S.family C).dartCount := by
        rw [RegionCandidate.phiMapO_dartCount P']
        omega
      have hsmall : (Finset.univ.filter fun f : (RegionCandidate.phiMapO S.family C).Face =>
          (RegionCandidate.phiMapO S.family C).faceDegree f < 6) ⊆
            (Finset.univ.filter fun f : (RegionCandidate.phiMapO S.family C).Face =>
              (RegionCandidate.phiSubdividedMultigraphO P').IsTwoGon f ∧
                RegionCandidate.GapAtOHoldsCorner cuts S.family C f) ∪
              Finset.univ.filter fun f : (RegionCandidate.phiMapO S.family C).Face =>
                RegionCandidate.HoldsCellO S.family C f := by
        intro f hf
        have htwo :=
          (RegionCandidate.phiSubdividedMultigraphO P').isTwoGon_of_faceDegree_lt_six hconn
            hcount f (Finset.mem_filter.mp hf).2
        by_cases hgap : RegionCandidate.GapAtOHoldsCorner cuts S.family C f
        · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, htwo, hgap⟩)
        · by_cases hheld : RegionCandidate.HoldsCellO S.family C f
          · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hheld⟩)
          · exact (h6 P' f htwo hgap hheld).elim
      have ht := (Finset.card_le_card hsmall).trans (Finset.card_union_le _ _)
      have h4 := hcorner Delta cuts S C P'
      omega
    · omega
  · have P : RegionCandidate.PhiData S.family S.family :=
      { subset := Finset.Subset.refl _
        pairwise := S.pairwise
        cell_not_mem := fun a _ i =>
          (a.2.innerGRegion hleaS).cells_avoid _ (cell_mem S.diagram i)
        interior := fun a ha => Option.isSome_iff_ne_none.mpr fun h => hext ⟨a, ha, h⟩
        nondegenerate := S.nondegenerate
        noLoop := hloops
        noMultiple := hmulti }
    have h := RegionCandidate.card_le_of_endpoints P Finset.univ
      (fun _ _ _ => Finset.mem_univ _) ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
    simp only [Finset.card_univ, Fintype.card_fin] at h
    omega

end GroupApproximation.GGT.VanKampen

#audit_axioms GroupApproximation.GGT.VanKampen.Embedded.RegionCandidate.faceOf_eq_of_faceClassO
#audit_axioms GroupApproximation.GGT.VanKampen.phiPrimeCountInput_of_smallFaces
