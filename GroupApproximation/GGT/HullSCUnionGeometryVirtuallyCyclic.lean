import GroupApproximation.GGT.HullSCUnionGeometryWitness
import GroupApproximation.GGT.RelHypKazhdanNonElementary

/-!
# If every element shares a power with `g`, the group is elementary

This closes the second witness of `GGT/HullSCUnionGeometryWitness.lean`.  Suppose
`H` is hyperbolic with finite alphabet `A`, that `g` has infinite order, and that

> every `t ≠ 1` satisfies `gⁱ = tᵐ` for some nonzero `i, m`.

Then `H` is elementary --- it has a cyclic subgroup of finite index --- which for
an infinite `H` with property `(T)` is impossible by
`GGT.RelHyp.not_isElementaryGroup_of_infinite_of_kazhdan'`.  So
`exists_no_common_zpow` produces the missing `t`, and
`freeProductUnionGeometryStatement_of_acylindricalUnion` leaves the
tree-of-spaces crossing estimate as the *only* hypothesis of
`HullSC.FreeProductUnionGeometryStatement`.

## The uniform exponent is free

The one difficulty is that `t` commutes with `g^{iₜ}` for an exponent depending
on `t`, while every geometric tool is stated at one fixed loxodromic element.
Finite generation removes it at no cost: `H` is generated by the finite alphabet,
each of whose letters `a` centralizes some `g^{iₐ}` with `iₐ ≠ 0`, so every
letter --- hence every element --- centralizes `g ^ ∏ iₐ`.
`exists_central_zpow` is that argument, and after it `g ^ n` is *central*, so the
whole of `H` is the centralizer of one loxodromic element.

## Why the centralizer is virtually cyclic

`GGT.Elementary.CentralizerOrbitNearAxis` --- available at any hyperbolic
alphabet by `centralizerOrbitNearAxis_cayley_of_alphabet` --- says that every
element commuting with a loxodromic `q` sends the basepoint to within one
constant `K` of the orbit of `q`.  Over a *finite* alphabet the ball of radius
`K` is finite, so each element of the centralizer differs from a power of `q` by
one of finitely many elements: `exists_ball_bound_of_commute`.  With `q = g ^ n`
central, that is a finite set of coset representatives for `⟨g ^ n⟩` in `H`, so
the quotient is finite and `⟨g ^ n⟩` --- infinite cyclic --- has finite index.

No pigeonhole over acylindricity constants is needed: properness of the action of
a hyperbolic group on its own Cayley graph does the counting directly.
-/

namespace GroupApproximation
namespace HullSCUnionGeometry

open GroupApproximation.HullGeometry
open GroupApproximation.WordMetric
open GroupApproximation.Manuscript.NonMF.TorsionFree

universe u

/-! ## 1.  A shared power gives a commuting power -/

/-- **An element sharing a nonzero power with `g` centralizes a nonzero power of
`g`.**  From `gⁱ = tᵐ`, the element `t` commutes with `tᵐ`, hence with `gⁱ`. -/
theorem exists_commute_zpow_of_share {H : Type u} [Group H] {g : H}
    (hshare : ∀ t : H, t ≠ 1 → ∃ i m : ℤ, i ≠ 0 ∧ m ≠ 0 ∧ g ^ i = t ^ m) (a : H) :
    ∃ i : ℤ, i ≠ 0 ∧ Commute a (g ^ i) := by
  by_cases ha : a = 1
  · refine ⟨1, one_ne_zero, ?_⟩
    rw [ha]
    exact Commute.one_left _
  · obtain ⟨i, m, hi, -, he⟩ := hshare a ha
    refine ⟨i, hi, ?_⟩
    rw [he]
    exact (Commute.refl a).zpow_right m

/-! ## 2.  Finite generation makes one power central -/

/-- **A central power of `g`.**  Each letter of a finite generating set
centralizes some nonzero power of `g`; the product of those exponents is
centralized by every letter, hence by the whole group. -/
theorem exists_central_zpow {H : Type u} [Group H] {g : H} {T : Finset H}
    (hgen : Subgroup.closure (T : Set H) = ⊤)
    (hshare : ∀ t : H, t ≠ 1 → ∃ i m : ℤ, i ≠ 0 ∧ m ≠ 0 ∧ g ^ i = t ^ m) :
    ∃ n : ℤ, n ≠ 0 ∧ ∀ t : H, Commute t (g ^ n) := by
  classical
  choose f hf0 hfc using exists_commute_zpow_of_share hshare
  have hTcomm : ∀ a ∈ T, Commute a (g ^ (∏ b ∈ T, f b)) := by
    intro a ha
    obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem f ha
    have hgk : g ^ (∏ b ∈ T, f b) = (g ^ f a) ^ k := by
      rw [hk, zpow_mul]
    rw [hgk]
    exact (hfc a).zpow_right k
  refine ⟨∏ b ∈ T, f b, Finset.prod_ne_zero_iff.mpr fun a _ => hf0 a, fun t => ?_⟩
  have hle : Subgroup.closure (T : Set H)
      ≤ Subgroup.centralizer ({g ^ (∏ b ∈ T, f b)} : Set H) := by
    rw [Subgroup.closure_le]
    intro a haT
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact (hTcomm a (Finset.mem_coe.mp haT)).symm
  rw [hgen] at hle
  have hmem := hle (Subgroup.mem_top t)
  rw [Subgroup.mem_centralizer_iff] at hmem
  exact (hmem (g ^ (∏ b ∈ T, f b)) rfl).symm

/-! ## 3.  The centralizer of a loxodromic is covered by finitely many cosets -/

/-- **Properness bounds the centralizer.**  Every element commuting with a
loxodromic `q` differs from a power of `q` by an element of one fixed ball, and
over a finite alphabet that ball is finite. -/
theorem exists_ball_bound_of_commute {G : Type u} [Group G] (A : Alphabet G)
    (hfin : A.carrier.Finite) {δ : ℝ} (hδ : IsHyperbolicSpace δ (Cayley A))
    {q : G} (hq : ¬ IsOfFinOrder q) :
    ∃ N : ℕ, ∀ c : G, Commute c q →
      ∃ j : ℤ, wordNorm A.carrier (q ^ (-j) * c) ≤ N := by
  obtain ⟨K, -, hK⟩ := centralizerOrbitNearAxis_cayley_of_alphabet A hδ q
    (isLoxodromic_cayley_of_not_isOfFinOrder A hfin hδ hq)
  refine ⟨⌈K⌉₊, fun c hc => ?_⟩
  obtain ⟨j, hj⟩ := hK c hc 1
  refine ⟨j, ?_⟩
  rw [zpow_one, HullSC.cayleyDist_smul_smul] at hj
  have heq : wordNorm A.carrier (q ^ (-j) * c) = wordDist A.carrier c (q ^ j) := by
    show wordNorm A.carrier (q ^ (-j) * c) = wordNorm A.carrier (c⁻¹ * q ^ j)
    rw [← wordNorm_inv A.symmetricGenerating (q ^ (-j) * c)]
    congr 1
    group
  rw [heq]
  have h1 : ((wordDist A.carrier c (q ^ j) : ℕ) : ℝ) ≤ ((⌈K⌉₊ : ℕ) : ℝ) :=
    le_trans hj (Nat.le_ceil K)
  exact_mod_cast h1

/-! ## 4.  The group is elementary -/

/-- **A power of `g` of infinite order.**  If `g ^ n` had finite order then so
would `g`, since `n ≠ 0`. -/
theorem not_isOfFinOrder_zpow {H : Type u} [Group H] {g : H}
    (hg : ¬ IsOfFinOrder g) {n : ℤ} (hn : n ≠ 0) : ¬ IsOfFinOrder (g ^ n) := by
  intro hfin
  obtain ⟨k, hk0, hk⟩ := isOfFinOrder_iff_pow_eq_one.mp hfin
  have hinj : Function.Injective (fun m : ℤ => g ^ m) :=
    injective_zpow_iff_not_isOfFinOrder.mpr hg
  have h1 : g ^ (n * (k : ℤ)) = g ^ (0 : ℤ) := by
    rw [zpow_mul, zpow_natCast, hk, zpow_zero]
  have h2 : n * (k : ℤ) = 0 := hinj h1
  have hk' : (k : ℤ) ≠ 0 := Int.natCast_ne_zero.mpr hk0.ne'
  exact hn ((mul_eq_zero.mp h2).resolve_right hk')

/-- **Sharing a power with `g` makes the group elementary.**

`exists_central_zpow` makes `g ^ n` central, so the whole group is the
centralizer of the loxodromic `g ^ n`; `exists_ball_bound_of_commute` then
supplies finitely many coset representatives for `⟨g ^ n⟩`, so that subgroup ---
infinite cyclic --- has finite index. -/
theorem isElementaryGroup_of_share {H : Type} [Group H] (A : Alphabet H)
    (hfin : A.carrier.Finite) {δ : ℝ} (hδ : IsHyperbolicSpace δ (Cayley A))
    {g : H} (hg : ¬ IsOfFinOrder g)
    (hshare : ∀ t : H, t ≠ 1 → ∃ i m : ℤ, i ≠ 0 ∧ m ≠ 0 ∧ g ^ i = t ^ m) :
    GGT.RelHyp.IsElementaryGroup H := by
  classical
  obtain ⟨n, hn, hcent⟩ := exists_central_zpow (T := hfin.toFinset)
    (by rw [Set.Finite.coe_toFinset]; exact A.symmetricGenerating.closure_eq) hshare
  obtain ⟨N, hN⟩ :=
    exists_ball_bound_of_commute A hfin hδ (not_isOfFinOrder_zpow hg hn)
  have hball : {h : H | wordNorm A.carrier h ≤ N}.Finite :=
    GGT.wordNorm_ball_finite A.symmetricGenerating hfin N
  haveI : Finite ↥{h : H | wordNorm A.carrier h ≤ N} := hball.to_subtype
  have hsurj : Function.Surjective
      (fun b : ↥{h : H | wordNorm A.carrier h ≤ N} =>
        (QuotientGroup.mk (b : H) : H ⧸ Subgroup.zpowers (g ^ n))) := by
    intro x
    induction x using QuotientGroup.induction_on with
    | H t =>
        obtain ⟨j, hj⟩ := hN t (hcent t)
        refine ⟨⟨(g ^ n) ^ (-j) * t, hj⟩, ?_⟩
        show (QuotientGroup.mk ((g ^ n) ^ (-j) * t) : H ⧸ Subgroup.zpowers (g ^ n))
          = QuotientGroup.mk t
        rw [QuotientGroup.eq]
        have hcj : Commute t ((g ^ n) ^ j) := (hcent t).zpow_right j
        have hc : ((g ^ n) ^ (-j) * t)⁻¹ * t = (g ^ n) ^ j := by
          have h1 : ((g ^ n) ^ (-j) * t)⁻¹ * t = t⁻¹ * ((g ^ n) ^ j * t) := by
            group
          rw [h1, ← hcj.eq]
          group
        rw [hc]
        exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) j
  haveI : Finite (H ⧸ Subgroup.zpowers (g ^ n)) := Finite.of_surjective _ hsurj
  haveI : (Subgroup.zpowers (g ^ n)).FiniteIndex :=
    Subgroup.finiteIndex_of_finite_quotient
  have hcyc : IsCyclic ↥(Subgroup.zpowers (g ^ n)) := by
    refine ⟨⟨⟨g ^ n, Subgroup.mem_zpowers _⟩, ?_⟩⟩
    rintro ⟨x, hx⟩
    obtain ⟨k, hk⟩ := hx
    refine ⟨k, ?_⟩
    ext
    simpa using hk
  exact ⟨Subgroup.zpowers (g ^ n), inferInstance, hcyc⟩

/-! ## 5.  The second witness, discharged -/

/-- **An infinite hyperbolic group with property `(T)` has an element sharing no
power with `g`.**

If none did, `isElementaryGroup_of_share` would make it elementary, and
`GGT.RelHyp.not_isElementaryGroup_of_infinite_of_kazhdan'` forbids that for an
infinite Kazhdan group. -/
theorem exists_no_common_zpow {H : Type} [Group H] (hinf : Infinite H)
    (hhyp : GroupApproximation.Hyperbolic.IsHyperbolicGroup H)
    (hKT : HasKazhdanPropertyT.{0, 0} H) {g : H} (hg : ¬ IsOfFinOrder g) :
    ∃ t : H, t ≠ 1 ∧ ∀ i m : ℤ, i ≠ 0 → m ≠ 0 → g ^ i ≠ t ^ m := by
  haveI := hinf
  by_contra hcon
  push Not at hcon
  obtain ⟨T, hTsym, δ, hδ⟩ := hhyp
  exact GGT.RelHyp.not_isElementaryGroup_of_infinite_of_kazhdan' hKT
    (isElementaryGroup_of_share (⟨(T : Set H), hTsym⟩ : Alphabet H)
      T.finite_toSet (GGT.isHyperbolicSpace_cayley_of_fourPoint _ hδ) hg hcon)

/-- **`HullSC.FreeProductUnionGeometryStatement` from the acylindricity of the
union alphabet alone.**

Every other clause of the free product input is now a theorem: the choice of
alphabet, hyperbolicity of `Γ(E ∗ H, A ⊔ B)`, the Hull generating set on `E`,
and --- through `exists_not_isOfFinOrder_of_infinite` and
`exists_no_common_zpow` --- the Hull generating set on `H`.  What is left is the
tree-of-spaces crossing estimate, and nothing else. -/
theorem freeProductUnionGeometryStatement_of_acylindricalUnion
    (hacyl : ∀ (E H : Type) [Group E] [Group H] (A : HullGeneratingSet E)
      (B : HullGeneratingSet H),
        IsAcylindrical (Monoid.Coprod E H)
          (Cayley (HullSC.unionAlphabet A.alphabet B.alphabet))) :
    HullSC.FreeProductUnionGeometryStatement := by
  refine freeProductUnionGeometryStatement_of_noCommonZpow hacyl ?_
  intro H instH hinf _htf hhyp hKT g hg
  letI := instH
  exact exists_no_common_zpow hinf hhyp hKT hg

end HullSCUnionGeometry
end GroupApproximation
