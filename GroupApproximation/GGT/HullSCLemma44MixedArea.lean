import GroupApproximation.GGT.HullSCLemma44PrefixCellPresentation
import GroupApproximation.GGT.HullSCLemma44RelativeDehn
import GroupApproximation.GGT.HullSCLemma44WeightedArea
import GroupApproximation.GGT.OsinGeodesicWord

/-!
# From weighted Hull area to a bounded prefix filling

The weighted Greendlinger induction is stated in the source group: a
quotient-null element is a product of conjugates of Hull relator values.  A
relative presentation needs a corresponding statement in a free group.

This file performs that lift.  Each long relator factor expands through the
prefix fan into two bounded cells per letter.  Conjugating elements are lifted
to legal relative words.  Comparing the resulting legal source word with the
original boundary leaves one legal element in the kernel of source
evaluation.  That last element is exactly the source-presentation part of
Osin's relative-area argument.
-/

namespace GroupApproximation
namespace HullSC

open GroupApproximation.WordMetric

universe u v w

/-! ## Legal free relative words -/

/-- Evaluation from the free group on relative letters to the underlying
group. -/
def RelWord.freeEval
    {G : Type u} [Group G] {Lambda : Type w} :
    FreeGroup (GGT.RelLetter G Lambda) →* G :=
  FreeGroup.lift GGT.RelLetter.val

@[simp] theorem RelWord.freeEval_freeVal
    {G : Type u} [Group G] {Lambda : Type w}
    (word : List (GGT.RelLetter G Lambda)) :
    RelWord.freeEval (RelWord.freeVal word) =
      GGT.RelLetter.listVal word :=
  RelWord.lift_freeVal word

/-- The subgroup generated by legal relative letters. -/
def RelWord.legalFreeSubgroup
    {G : Type u} [Group G] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda) :
    Subgroup (FreeGroup (GGT.RelLetter G Lambda)) :=
  Subgroup.closure (FreeGroup.of '' {a | D.IsLetter a})

/-- A legal relative word gives an element of the legal free subgroup. -/
theorem RelWord.freeVal_mem_legalFreeSubgroup
    {G : Type u} [Group G] {Lambda : Type w}
    {D : GGT.RelGenSet G Lambda}
    {word : List (GGT.RelLetter G Lambda)}
    (hword : RelWord.IsAdmissible D word) :
    RelWord.freeVal word ∈ RelWord.legalFreeSubgroup D := by
  induction word with
  | nil =>
      rw [RelWord.freeVal_nil]
      exact Subgroup.one_mem _
  | cons a word ih =>
      rw [RelWord.freeVal_cons]
      apply Subgroup.mul_mem
      · apply Subgroup.subset_closure
        exact ⟨a, hword a List.mem_cons_self, rfl⟩
      · apply ih
        intro b hb
        exact hword b (List.mem_cons_of_mem a hb)

/-- Every group element has a legal free relative representative. -/
theorem exists_legalFreeRepresentative
    {G : Type u} [Group G] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda) (g : G) :
    ∃ z : FreeGroup (GGT.RelLetter G Lambda),
      z ∈ RelWord.legalFreeSubgroup D ∧ RelWord.freeEval z = g := by
  obtain ⟨raw, hraw⟩ := exists_isWord D.alphabet.symmetricGenerating g
  obtain ⟨word, hlegal, hvalue, hlength⟩ :=
    GGT.OsinComponents.exists_relWord D raw hraw.letters
  refine ⟨RelWord.freeVal word,
    RelWord.freeVal_mem_legalFreeSubgroup hlegal, ?_⟩
  rw [RelWord.freeEval_freeVal, hvalue, hraw.prod_eq]

/-! ## Lifting a weighted relator product -/

/-- A source representative of a weighted product whose image in the
quotient free group already has a bounded prefix-cell filling. -/
structure WeightedPrefixLift
    {G : Type u} {Q : Type v} [Group G] [Group Q] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda)
    (W : Set (List (GGT.RelLetter G Lambda))) (q : G →* Q)
    (weight : ℕ) (g : G) where
  sourceWord : FreeGroup (GGT.RelLetter G Lambda)
  sourceWord_legal : sourceWord ∈ RelWord.legalFreeSubgroup D
  sourceWord_value : RelWord.freeEval sourceWord = g
  mapped_cells : IsPrefixCellProduct
    (RelWord.prefixPresentationCells W q) (2 * weight)
    (FreeGroup.map (GGT.RelLetter.mapHom q) sourceWord)

namespace WeightedPrefixLift

/-- Weighted relator products lift to bounded prefix-cell products. -/
theorem of_isWeightedRelatorProduct
    {G : Type u} {Q : Type v} [Group G] [Group Q] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda)
    {W : Set (List (GGT.RelLetter G Lambda))} (q : G →* Q)
    (hadmissible : ∀ word ∈ W, RelWord.IsAdmissible D word)
    (hkill : ∀ word ∈ W, q (GGT.RelLetter.listVal word) = 1)
    {weight : ℕ} {g : G}
    (hproduct : RelatorLengthBudget.IsWeightedRelatorProduct W weight g) :
    Nonempty (WeightedPrefixLift D W q weight g) := by
  induction hproduct with
  | one =>
      refine ⟨{
        sourceWord := 1
        sourceWord_legal := Subgroup.one_mem _
        sourceWord_value := map_one _
        mapped_cells := ?_ }⟩
      simpa only [map_one, mul_zero] using
        (IsPrefixCellProduct.one :
          IsPrefixCellProduct (RelWord.prefixPresentationCells W q) 0 1)
  | @base word hword =>
      refine ⟨{
        sourceWord := RelWord.freeVal word
        sourceWord_legal :=
          RelWord.freeVal_mem_legalFreeSubgroup (hadmissible word hword)
        sourceWord_value := RelWord.freeEval_freeVal word
        mapped_cells := ?_ }⟩
      simpa only [RelWord.map_freeVal] using
        mappedRelator_isPrefixCellProduct q hword (hkill word hword)
  | @inv weight g hproduct ih =>
      obtain ⟨P⟩ := ih
      refine ⟨{
        sourceWord := P.sourceWord⁻¹
        sourceWord_legal := Subgroup.inv_mem _ P.sourceWord_legal
        sourceWord_value := ?_
        mapped_cells := ?_ }⟩
      · rw [map_inv, P.sourceWord_value]
      · simpa only [map_inv] using P.mapped_cells.inv
  | @conj weight g hproduct c ih =>
      obtain ⟨P⟩ := ih
      obtain ⟨conjugator, hconjugatorLegal, hconjugatorValue⟩ :=
        exists_legalFreeRepresentative D c
      refine ⟨{
        sourceWord := conjugator * P.sourceWord * conjugator⁻¹
        sourceWord_legal := ?_
        sourceWord_value := ?_
        mapped_cells := ?_ }⟩
      · exact Subgroup.mul_mem _
          (Subgroup.mul_mem _ hconjugatorLegal P.sourceWord_legal)
          (Subgroup.inv_mem _ hconjugatorLegal)
      · simp only [map_mul, map_inv, hconjugatorValue,
          P.sourceWord_value]
      · simpa only [map_mul, map_inv] using
          P.mapped_cells.conj
            (FreeGroup.map (GGT.RelLetter.mapHom q) conjugator)
  | @mul leftWeight rightWeight g h hleft hright ihleft ihright =>
      obtain ⟨Pleft⟩ := ihleft
      obtain ⟨Pright⟩ := ihright
      refine ⟨{
        sourceWord := Pleft.sourceWord * Pright.sourceWord
        sourceWord_legal :=
          Subgroup.mul_mem _ Pleft.sourceWord_legal Pright.sourceWord_legal
        sourceWord_value := ?_
        mapped_cells := ?_ }⟩
      · rw [map_mul, Pleft.sourceWord_value, Pright.sourceWord_value]
      · have hcells := Pleft.mapped_cells.mul Pright.mapped_cells
        simpa only [map_mul, Nat.mul_add] using hcells

end WeightedPrefixLift

/-! ## The mixed source-and-prefix filling -/

/-- A quotient-null legal relative word split into one source relation and a
linearly bounded product of prefix-presentation cells. -/
structure RelativePrefixCellFilling
    {G : Type u} {Q : Type v} [Group G] [Group Q] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda)
    (W : Set (List (GGT.RelLetter G Lambda))) (q : G →* Q)
    (boundary : List (GGT.RelLetter G Lambda)) where
  sourceDefect : FreeGroup (GGT.RelLetter G Lambda)
  sourceDefect_legal : sourceDefect ∈ RelWord.legalFreeSubgroup D
  sourceDefect_value : RelWord.freeEval sourceDefect = 1
  prefixArea : ℕ
  prefixArea_le : prefixArea ≤ 20 * boundary.length
  prefixPart : FreeGroup (GGT.RelLetter Q Lambda)
  prefixCells : IsPrefixCellProduct
    (RelWord.prefixPresentationCells W q) prefixArea prefixPart
  decomposition :
    RelWord.freeVal (boundary.map (GGT.RelLetter.mapHom q)) =
      FreeGroup.map (GGT.RelLetter.mapHom q) sourceDefect * prefixPart

/-- Weighted kernel area produces the exact mixed filling used by the bounded
prefix presentation. -/
theorem relativePrefixCellFilling_of_weightedKernelArea
    {G : Type u} {Q : Type v} [Group G] [Group Q] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda)
    {W : Set (List (GGT.RelLetter G Lambda))} (q : G →* Q)
    (hadmissible : ∀ word ∈ W, RelWord.IsAdmissible D word)
    (hkill : ∀ word ∈ W, q (GGT.RelLetter.listVal word) = 1)
    (harea : RelativeWeightedKernelArea D W q)
    {boundary : List (GGT.RelLetter G Lambda)}
    (hboundary : RelWord.IsAdmissible D boundary)
    (hboundaryKill : q (GGT.RelLetter.listVal boundary) = 1) :
    Nonempty (RelativePrefixCellFilling D W q boundary) := by
  let groupWord : List G := boundary.map GGT.RelLetter.val
  have hgroupWord : IsWord D.alphabet.carrier groupWord groupWord.prod := by
    refine ⟨?_, rfl⟩
    intro x hx
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hx
    exact RelativeBoundaryContiguity.val_mem_alphabet_of_isLetter D
      (hboundary a ha)
  have hgroupValue : groupWord.prod = GGT.RelLetter.listVal boundary := rfl
  obtain ⟨weight, hweight, hproduct⟩ :=
    harea groupWord hgroupWord (by simpa only [hgroupValue] using hboundaryKill)
  obtain ⟨P⟩ := WeightedPrefixLift.of_isWeightedRelatorProduct
    D q hadmissible hkill hproduct
  let defect : FreeGroup (GGT.RelLetter G Lambda) :=
    RelWord.freeVal boundary * P.sourceWord⁻¹
  have hdefectLegal : defect ∈ RelWord.legalFreeSubgroup D := by
    exact Subgroup.mul_mem _
      (RelWord.freeVal_mem_legalFreeSubgroup hboundary)
      (Subgroup.inv_mem _ P.sourceWord_legal)
  have hdefectValue : RelWord.freeEval defect = 1 := by
    dsimp only [defect]
    rw [map_mul, map_inv, RelWord.freeEval_freeVal,
      P.sourceWord_value]
    rw [← hgroupValue]
    group
  have hdecomposition :
      RelWord.freeVal (boundary.map (GGT.RelLetter.mapHom q)) =
        FreeGroup.map (GGT.RelLetter.mapHom q) defect *
          FreeGroup.map (GGT.RelLetter.mapHom q) P.sourceWord := by
    rw [← RelWord.map_freeVal]
    dsimp only [defect]
    simp only [map_mul, map_inv]
    group
  refine ⟨{
    sourceDefect := defect
    sourceDefect_legal := hdefectLegal
    sourceDefect_value := hdefectValue
    prefixArea := 2 * weight
    prefixArea_le := ?_
    prefixPart := FreeGroup.map (GGT.RelLetter.mapHom q) P.sourceWord
    prefixCells := P.mapped_cells
    decomposition := hdecomposition }⟩
  have hlength : groupWord.length = boundary.length :=
    by simp only [groupWord, List.length_map]
  rw [← hlength]
  omega

/-! ## Fillings from the canonical quotient kernel -/

/-- The canonical kernel equation kills the value of every member of the
relator family. -/
theorem relator_value_map_eq_one_of_kernel
    {G : Type u} {Q : Type v} [Group G] [Group Q] {Lambda : Type w}
    {W : Set (List (GGT.RelLetter G Lambda))} (q : G →* Q)
    (hker : q.ker =
      Subgroup.normalClosure (GGT.RelLetter.listVal '' W))
    {word : List (GGT.RelLetter G Lambda)} (hword : word ∈ W) :
    q (GGT.RelLetter.listVal word) = 1 := by
  apply MonoidHom.mem_ker.mp
  rw [hker]
  exact Subgroup.subset_normalClosure ⟨word, hword, rfl⟩

/-- Weighted kernel area and the canonical kernel equation give a bounded
prefix-cell filling without a separate relator-killing premise. -/
theorem relativePrefixCellFilling_of_weightedKernelArea_of_kernel
    {G : Type u} {Q : Type v} [Group G] [Group Q] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda)
    {W : Set (List (GGT.RelLetter G Lambda))}
    {eps rho : ℕ} {mu : ℝ}
    (hsc : RelWord.IsLemma44Input D W eps mu rho)
    (q : G →* Q)
    (hker : q.ker =
      Subgroup.normalClosure (GGT.RelLetter.listVal '' W))
    (harea : RelativeWeightedKernelArea D W q)
    {boundary : List (GGT.RelLetter G Lambda)}
    (hboundary : RelWord.IsAdmissible D boundary)
    (hboundaryKill : q (GGT.RelLetter.listVal boundary) = 1) :
    Nonempty (RelativePrefixCellFilling D W q boundary) := by
  apply relativePrefixCellFilling_of_weightedKernelArea D q
    hsc.admissible
  · intro word hword
    exact relator_value_map_eq_one_of_kernel q hker hword
  · exact harea
  · exact hboundary
  · exact hboundaryKill

/-- Greendlinger certificates for every prescribed reduced boundary produce
the bounded mixed filling used by the prefix relative presentation. -/
theorem relativePrefixCellFilling_of_certificates
    {G : Type u} {Q : Type v} [Group G] [Group Q] {Lambda : Type w}
    (D : GGT.RelGenSet G Lambda)
    {W : Set (List (GGT.RelLetter G Lambda))}
    {eps rho : ℕ} {mu : ℝ}
    (hsc : RelWord.IsLemma44Input D W eps mu rho)
    (hmu : mu ≤ 1 / 1000) (hrho : 100 * (eps + 1) ≤ rho)
    (q : G →* Q)
    (hker : q.ker =
      Subgroup.normalClosure (GGT.RelLetter.listVal '' W))
    (hcert : ∀ (R : ℕ) (Z : RelativeReducedDiagram D W R),
      Nonempty (RelativeDiagramCertificate D W eps mu Z))
    {boundary : List (GGT.RelLetter G Lambda)}
    (hboundary : RelWord.IsAdmissible D boundary)
    (hboundaryKill : q (GGT.RelLetter.listVal boundary) = 1) :
    Nonempty (RelativePrefixCellFilling D W q boundary) := by
  have harea : RelativeWeightedKernelArea D W q :=
    relativeWeightedKernelArea_of_certificates D hsc hmu hrho q hker hcert
  exact relativePrefixCellFilling_of_weightedKernelArea_of_kernel
    D hsc q hker harea hboundary hboundaryKill

end HullSC
