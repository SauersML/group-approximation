import GroupApproximation.GGT.KazhdanHypSymplecticQuadrangle
import GroupApproximation.GGT.KazhdanHypSymplecticQuadrangleStrongRegular
import GroupApproximation.GGT.KazhdanHypSymplecticQuadrangleSeven
import GroupApproximation.GGT.KazhdanHypGQSevenScheme

/-!
# Adapter for the finite geometry export

The search program labels a `GF(8)` coordinate by its `to_integer` value and
uses base-eight encodings for four-tuples.  This file keeps that external
labeling separate from the quotient-based Lean projective point type.  An
export supplies the field-basis equivalence and the point/line maps; the
checks below then certify that those maps are bijections and that the JSON
incidence bits agree with the algebraic incidence relations.

No arbitrary `Fintype.equivFin` is used as a hidden reindexing of a search
result.  The supplied `fieldOfInteger` is the place where the script's
polynomial-basis convention is recorded, and the supplied point and line
maps are the labels that the export actually printed.
-/

noncomputable section

namespace GroupApproximation
namespace KazhdanHyp
namespace KazhdanHypGQTableAdapter

open scoped LinearAlgebra.Projectivization

/-! ## External labels -/

abbrev W8Field := SymplecticQuadrangle.FieldEight
abbrev W8Vec := SymplecticQuadrangle.Vec
abbrev W8Point := SymplecticQuadrangle.Point
abbrev W8Line := SymplecticQuadrangle.Line

abbrev W7Field := SymplecticQuadrangleSeven.FieldSeven
abbrev W7Vec := SymplecticQuadrangleSeven.Vec
abbrev W7Point := SymplecticQuadrangleSeven.Point
abbrev W7Line := SymplecticQuadrangleSeven.Line

/-- The script's integer labels for elements of `GF(8)`. -/
abbrev ScriptQ8FieldLabel := Fin 8

/-- A four-coordinate vector written with the script's field labels. -/
abbrev ScriptQ8Vector := Fin 4 → ScriptQ8FieldLabel

/-- Row labels for the 585 points and 585 lines of `W(8)`. -/
abbrev ScriptQ8PointLabel := Fin 585
abbrev ScriptQ8LineLabel := Fin 585

/-- The q = 7 row labels, retained for the same point/line adapter shape. -/
abbrev ScriptQ7PointLabel := Fin 400
abbrev ScriptQ7LineLabel := Fin 400

/-- The external field encoding used by the search program.  The zero field
value condition is needed to transport nonzero vector representatives. -/
structure Q8CoordinateEncoding where
  fieldOfInteger : ScriptQ8FieldLabel ≃ W8Field
  fieldOfInteger_zero : fieldOfInteger 0 = 0

/-- The field labels are converted coordinatewise, without changing their
coordinate order. -/
def Q8CoordinateEncoding.toLeanVector (e : Q8CoordinateEncoding)
    (v : ScriptQ8Vector) : W8Vec :=
  fun i ↦ e.fieldOfInteger (v i)

theorem Q8CoordinateEncoding.toLeanVector_ne_zero
    (e : Q8CoordinateEncoding) (v : ScriptQ8Vector)
    (hv : ∃ i, v i ≠ 0) : e.toLeanVector v ≠ 0 := by
  intro hzero
  obtain ⟨i, hi⟩ := hv
  have hzero_i := congrFun hzero i
  apply hi
  apply e.fieldOfInteger.injective
  change e.fieldOfInteger (v i) = 0 at hzero_i
  calc
    e.fieldOfInteger (v i) = 0 := hzero_i
    _ = e.fieldOfInteger 0 := e.fieldOfInteger_zero.symm

/-- The script's `to_integer` value for a field label. -/
def scriptFieldToInteger (a : ScriptQ8FieldLabel) : ℕ := a.val

/-- Base-eight little-endian encoding of a four-coordinate script vector.
This is the vector-level composition of the script's field `to_integer`
operation. -/
def scriptVectorToInteger (v : ScriptQ8Vector) : Fin 4096 :=
  ⟨scriptFieldToInteger (v 0) +
      8 * scriptFieldToInteger (v 1) +
      64 * scriptFieldToInteger (v 2) +
      512 * scriptFieldToInteger (v 3), by
    have h0 := (v 0).isLt
    have h1 := (v 1).isLt
    have h2 := (v 2).isLt
    have h3 := (v 3).isLt
    simp only [scriptFieldToInteger]
    omega⟩

theorem scriptFieldToInteger_lt (a : ScriptQ8FieldLabel) :
    scriptFieldToInteger a < 8 := a.isLt

theorem scriptVectorToInteger_val (v : ScriptQ8Vector) :
    (scriptVectorToInteger v).val =
      scriptFieldToInteger (v 0) +
        8 * scriptFieldToInteger (v 1) +
        64 * scriptFieldToInteger (v 2) +
        512 * scriptFieldToInteger (v 3) := rfl

/-! ## Bijections between export rows and algebraic objects -/

/-- A q = 8 point/line export, with the script coordinates retained so that
the numeric labels can be audited rather than regenerated by Lean. -/
structure Q8GeometryExport where
  coordinateEncoding : Q8CoordinateEncoding
  pointCoordinates : ScriptQ8PointLabel → ScriptQ8Vector
  pointCoordinates_ne_zero : ∀ i, ∃ k, pointCoordinates i k ≠ 0
  pointOfLabel : ScriptQ8PointLabel → W8Point
  pointOfLabel_eq_projectivization : ∀ i,
    pointOfLabel i =
      Projectivization.mk W8Field
        (coordinateEncoding.toLeanVector (pointCoordinates i))
        (coordinateEncoding.toLeanVector_ne_zero _
          (pointCoordinates_ne_zero i))
  pointIntegerLabel_injective : Function.Injective
    (fun i ↦ scriptVectorToInteger (pointCoordinates i))
  point_bijective : Function.Bijective pointOfLabel
  lineOfLabel : ScriptQ8LineLabel → W8Line
  line_bijective : Function.Bijective lineOfLabel
  exportedIncident : ScriptQ8PointLabel → ScriptQ8LineLabel → Bool
  incidence_agrees : ∀ i j,
    exportedIncident i j =
      decide (SymplecticQuadrangle.Incident (pointOfLabel i) (lineOfLabel j))

/-- The script's point label is its printed vector code. -/
def Q8GeometryExport.pointIntegerLabel (E : Q8GeometryExport)
    (i : ScriptQ8PointLabel) : Fin 4096 :=
  scriptVectorToInteger (E.pointCoordinates i)

/-- The point-label bijection used by all downstream W(8) checks. -/
noncomputable def Q8GeometryExport.pointEquiv (E : Q8GeometryExport) :
    ScriptQ8PointLabel ≃ W8Point :=
  Equiv.ofBijective E.pointOfLabel E.point_bijective

/-- The line-label bijection used by all downstream W(8) checks. -/
noncomputable def Q8GeometryExport.lineEquiv (E : Q8GeometryExport) :
    ScriptQ8LineLabel ≃ W8Line :=
  Equiv.ofBijective E.lineOfLabel E.line_bijective

theorem q8_point_label_card :
    Fintype.card ScriptQ8PointLabel = Fintype.card W8Point := by
  norm_num [SymplecticQuadrangle.point_card]

theorem q8_line_label_card :
    Fintype.card ScriptQ8LineLabel = Fintype.card W8Line := by
  norm_num [SymplecticQuadrangle.line_card]

/-- The q = 7 point and line rows have the same adapter shape, even though
the divisibility theorem in `KazhdanHypGQSevenScheme` rules out a one-vertex
triangle table on these rows. -/
structure Q7GeometryIndexing where
  pointOfLabel : ScriptQ7PointLabel → W7Point
  point_bijective : Function.Bijective pointOfLabel
  lineOfLabel : ScriptQ7LineLabel → W7Line
  line_bijective : Function.Bijective lineOfLabel

noncomputable def Q7GeometryIndexing.pointEquiv (E : Q7GeometryIndexing) :
    ScriptQ7PointLabel ≃ W7Point :=
  Equiv.ofBijective E.pointOfLabel E.point_bijective

noncomputable def Q7GeometryIndexing.lineEquiv (E : Q7GeometryIndexing) :
    ScriptQ7LineLabel ≃ W7Line :=
  Equiv.ofBijective E.lineOfLabel E.line_bijective

theorem q7_point_label_card :
    Fintype.card ScriptQ7PointLabel = Fintype.card W7Point := by
  norm_num [SymplecticQuadrangleSeven.point_card]

theorem q7_line_label_card :
    Fintype.card ScriptQ7LineLabel = Fintype.card W7Line := by
  norm_num [SymplecticQuadrangleSeven.line_card]

/-! ## Decidable export checks -/

/-- A finite map is checked as a bijection, not accepted merely because its
domain and codomain have equal cardinalities. -/
def bijectionCheck {Label Point : Type*} [Fintype Label] [DecidableEq Label]
    [Fintype Point] [DecidableEq Point] (f : Label → Point) : Bool :=
  decide (Function.Bijective f)

theorem bijectionCheck_eq_true_iff
    {Label Point : Type*} [Fintype Label] [DecidableEq Label]
    [Fintype Point] [DecidableEq Point] (f : Label → Point) :
    bijectionCheck f = true ↔ Function.Bijective f := by
  simp [bijectionCheck]

/-- A serialized vector-code column is checked for duplicate labels. -/
def injectivityCheck {Label Point : Type*} [Fintype Label] [DecidableEq Label]
    [DecidableEq Point] (f : Label → Point) : Bool :=
  decide (Function.Injective f)

theorem injectivityCheck_eq_true_iff
    {Label Point : Type*} [Fintype Label] [DecidableEq Label]
    [DecidableEq Point] (f : Label → Point) :
    injectivityCheck f = true ↔ Function.Injective f := by
  simp [injectivityCheck]

/-- Check the Boolean incidence matrix against the algebraic W(8) relation. -/
def q8IncidenceCheck
    (pointOfLabel : ScriptQ8PointLabel → W8Point)
    (lineOfLabel : ScriptQ8LineLabel → W8Line)
    (exportedIncident : ScriptQ8PointLabel → ScriptQ8LineLabel → Bool) : Bool :=
  decide (∀ i j, exportedIncident i j =
    decide (SymplecticQuadrangle.Incident (pointOfLabel i) (lineOfLabel j)))

theorem q8IncidenceCheck_eq_true_iff
    (pointOfLabel : ScriptQ8PointLabel → W8Point)
    (lineOfLabel : ScriptQ8LineLabel → W8Line)
    (exportedIncident : ScriptQ8PointLabel → ScriptQ8LineLabel → Bool) :
    q8IncidenceCheck pointOfLabel lineOfLabel exportedIncident = true ↔
      ∀ i j, exportedIncident i j =
        decide (SymplecticQuadrangle.Incident (pointOfLabel i) (lineOfLabel j)) := by
  simp [q8IncidenceCheck]

/-- Complete decidable check for the q = 8 geometry export. -/
def q8GeometryCheck (E : Q8GeometryExport) : Bool :=
  injectivityCheck E.pointIntegerLabel &&
    bijectionCheck E.pointOfLabel &&
      bijectionCheck E.lineOfLabel &&
        q8IncidenceCheck E.pointOfLabel E.lineOfLabel E.exportedIncident

theorem q8GeometryCheck_eq_true (E : Q8GeometryExport) :
    q8GeometryCheck E = true := by
  have hv : injectivityCheck E.pointIntegerLabel = true := by
    apply (injectivityCheck_eq_true_iff E.pointIntegerLabel).2
    change Function.Injective
      (fun i ↦ scriptVectorToInteger (E.pointCoordinates i))
    exact E.pointIntegerLabel_injective
  have hp : bijectionCheck E.pointOfLabel = true :=
    (bijectionCheck_eq_true_iff E.pointOfLabel).2 E.point_bijective
  have hl : bijectionCheck E.lineOfLabel = true :=
    (bijectionCheck_eq_true_iff E.lineOfLabel).2 E.line_bijective
  have hi : q8IncidenceCheck E.pointOfLabel E.lineOfLabel E.exportedIncident =
      true :=
    (q8IncidenceCheck_eq_true_iff E.pointOfLabel E.lineOfLabel
      E.exportedIncident).2 E.incidence_agrees
  simp [q8GeometryCheck, hv, hp, hl, hi]

end KazhdanHypGQTableAdapter
end KazhdanHyp
end GroupApproximation
