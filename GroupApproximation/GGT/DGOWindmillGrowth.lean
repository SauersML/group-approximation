import GroupApproximation.GGT.DGOWindmillLoxodromic
import GroupApproximation.GGT.DGOWindmillPathStage

/-!
# The unfolded and thickened windmill of one growth stage

This module defines DGO's `W₂` and `W'` for the concrete stage constructed in
`DGOWindmillStage`:

* `stageOrbit` is the orbit of `stageOne δ C W` under the next-stage group;
* `nextWindmill` is its closed `18δ`-neighbourhood.

The choice `18δ` is the one used by the proved estimates in
`DGOWindmillStage`: an external apex is `75δ` from `stageOne`, so after
thickening there remains `57δ`, which clears the windmill's `55δ` far clause.
It also contains the `10δ` growth demanded by `WindmillGrowth`.

The results here discharge apex retention, the required `10δ` gain, the
external-apex estimate, invariance, and the subgroup bound from the next
windmill group to the explicit stage group.  Cyclic reduction retains its
stage-group conjugator and supplies the direct rotation-or-loxodromic
dichotomy, including location of the translated rotation apex in the next
windmill.  The ordered reduced-spelling chain supplies the remaining uniform
quasiconvexity estimate and the final constructor assembles the growth stage.
-/

namespace GroupApproximation
namespace DGOWindmill

open GroupApproximation.HullGeometry
open GroupApproximation.HullSC

universe u v

variable {G : Type u} [Group G] {X : Type v} [PseudoMetricSpace X]
  [MulAction G X]

/-- **DGO's unfolded windmill `W₂`.**  It is the orbit of the spoke set `W₁`
under the group generated by the old windmill group and the rotations at the
new apices. -/
def stageOrbit (δ : ℝ) (C : Set X) (Rot : X → Subgroup G) (W : Set X) : Set X :=
  {x : X | ∃ g ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W),
    ∃ p ∈ stageOne δ C W, x = g • p}

theorem mem_stageOrbit_iff {δ : ℝ} {C : Set X} {Rot : X → Subgroup G}
    {W : Set X} {x : X} :
    x ∈ stageOrbit δ C Rot W ↔
      ∃ g ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W),
        ∃ p ∈ stageOne δ C W, x = g • p := Iff.rfl

/-- The spoke set is the identity translate inside the unfolded windmill. -/
theorem stageOne_subset_stageOrbit {δ : ℝ} {C : Set X}
    {Rot : X → Subgroup G} {W : Set X} :
    stageOne δ C W ⊆ stageOrbit δ C Rot W := by
  intro p hp
  exact ⟨1, Subgroup.one_mem _, p, hp, (one_smul G p).symm⟩

/-- **The old windmill group preserves the spoke set of the stage.**

Because the spoke set is defined by witnesses instead of chosen segments, the
action transports the old windmill, the new tip, its reach witness, and metric
betweenness directly. -/
theorem smul_mem_stageOne {δ : ℝ} {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) {W : Set X}
    (hW : IsWindmill G X δ C Rot W) {a : G}
    (ha : a ∈ windmillGroup C Rot W) {p : X} (hp : p ∈ stageOne δ C W) :
    a • p ∈ stageOne δ C W := by
  rcases mem_spokeSet_iff.mp hp with hpW | ⟨e, he, w, hw, hew, hep⟩
  · exact subset_stageOne (hW.invariant a ha p hpW)
  · refine Or.inr ⟨a • e, smul_mem_newApices hfam hW ha he,
      a • w, hW.invariant a ha w hw, ?_, ?_⟩
    · rwa [hfam.isometric a e w]
    · exact smul_between hfam.isometric a hep

/-- A stage-group translate of a point of the spoke set belongs to the
unfolded orbit. -/
theorem smul_mem_stageOrbit_of_mem_stageOne {δ : ℝ} {C : Set X}
    {Rot : X → Subgroup G} {W : Set X} {a : G}
    (ha : a ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W))
    {p : X} (hp : p ∈ stageOne δ C W) : a • p ∈ stageOrbit δ C Rot W :=
  ⟨a, ha, p, hp, rfl⟩

/-- **The stage group preserves the unfolded windmill.** -/
theorem smul_mem_stageOrbit {δ : ℝ} {C : Set X} {Rot : X → Subgroup G}
    {W : Set X} {a : G}
    (ha : a ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W))
    {x : X} (hx : x ∈ stageOrbit δ C Rot W) :
    a • x ∈ stageOrbit δ C Rot W := by
  obtain ⟨g, hg, p, hp, rfl⟩ := mem_stageOrbit_iff.mp hx
  refine ⟨a * g, (stepGroup Rot (newApices δ C W)
    (windmillGroup C Rot W)).mul_mem ha hg, p, hp, ?_⟩
  rw [mul_smul]

/-- **A geodesic whose endpoints lie in one translate of the spoke set stays
`12δ` from the unfolded orbit.**

This is the local side estimate used between consecutive developed apices.
It pulls the caller's geodesic back by the inverse translate, applies the
`12δ` quasiconvexity of `stageOne`, and pushes the witness forward again. -/
theorem exists_stageOrbit_dist_le_of_endpoints_in_stageOne_translate
    {δ : ℝ} (hδ : 0 < δ) (hhyp : IsHyperbolicSpace δ X)
    (hgeo : IsGeodesicSpace X) {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) {W : Set X}
    (hW : IsWindmill G X δ C Rot W) {a : G}
    (ha : a ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W))
    {p q : X} (hp : p ∈ stageOne δ C W) (hq : q ∈ stageOne δ C W)
    {f : ℝ → X} (hf : IsGeodesicSegment f 0 (dist (a • p) (a • q)))
    (hf0 : f 0 = a • p) (hf1 : f (dist (a • p) (a • q)) = a • q)
    {t : ℝ} (ht : t ∈ Set.Icc (0 : ℝ) (dist (a • p) (a • q))) :
    ∃ z ∈ stageOrbit δ C Rot W, dist (f t) z ≤ 12 * δ := by
  have hdist : dist (a • p) (a • q) = dist p q := hfam.isometric a p q
  let f' : ℝ → X := fun s => a⁻¹ • f s
  have hf' : IsGeodesicSegment f' 0 (dist p q) := by
    intro s hs u hu
    have hs' : s ∈ Set.Icc (0 : ℝ) (dist (a • p) (a • q)) := by
      rwa [hdist]
    have hu' : u ∈ Set.Icc (0 : ℝ) (dist (a • p) (a • q)) := by
      rwa [hdist]
    show dist (a⁻¹ • f s) (a⁻¹ • f u) = |s - u|
    rw [hfam.isometric]
    exact hf s hs' u hu'
  have hf'0 : f' 0 = p := by
    simp only [f', hf0, inv_smul_smul]
  have hf'1 : f' (dist p q) = q := by
    show a⁻¹ • f (dist p q) = q
    rw [← hdist, hf1, inv_smul_smul]
  have ht' : t ∈ Set.Icc (0 : ℝ) (dist p q) := by
    rwa [← hdist]
  obtain ⟨r, hr, hnear⟩ :=
    isQuasiconvexSet_stageOne (le_of_lt hδ) hhyp hgeo hW
      p hp q hq f' hf' hf'0 hf'1 t ht'
  refine ⟨a • r, smul_mem_stageOrbit_of_mem_stageOne ha hr, ?_⟩
  calc
    dist (f t) (a • r) = dist (a⁻¹ • f t) r := by
      calc
        dist (f t) (a • r) = dist (a • (a⁻¹ • f t)) (a • r) := by
          rw [smul_smul, mul_inv_cancel, one_smul]
        _ = dist (a⁻¹ • f t) r := hfam.isometric a (a⁻¹ • f t) r
    _ ≤ 12 * δ := hnear

/-! ## The ordered chain carried by a reduced spelling -/

/-- The finite ordered chain used to cover a geodesic between the endpoints of
a reduced spelling.  Every consecutive edge has both endpoints in one
stage-group translate of `stageOne`. -/
structure StageChainData (δ : ℝ) (C : Set X) (Rot : X → Subgroup G)
    (W : Set X) (x y : X) where
  N : ℕ
  point : ℕ → X
  start : point 0 = x
  finish : point N = y
  between : ∀ i, i ≤ N → Between x (point i) y
  step : ∀ i, i < N → Between x (point i) (point (i + 1))
  edge : ∀ i, i < N →
    ∃ a ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W),
      ∃ p ∈ stageOne δ C W, ∃ q ∈ stageOne δ C W,
        point i = a • p ∧ point (i + 1) = a • q

/-- **A valid reduced spelling gives the ordered stage chain.**  The induction
prepends the first endpoint and translates the tail chain by the first
syllable.  The boundary-spoke reduction is supplied by
`between_and_dist_of_reducedList_stageOne`. -/
theorem exists_stageChainData_of_reducedList {δ ρ : ℝ} (hδ : 0 < δ)
    (hρ : 200 * δ ≤ ρ) (hhyp : IsHyperbolicSpace δ X)
    (hgeo : IsGeodesicSpace X) {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) (hvr : IsVeryRotating G X δ C Rot)
    (hsep : IsSeparated C ρ) {W : Set X} (hW : IsWindmill G X δ C Rot W)
    {y : X} (hy : y ∈ stageOne δ C W) :
    ∀ (l : List (Syll G X)) (w : Syll G X),
      (∀ u ∈ w :: l,
        Syll.IsValid Rot (newApices δ C W) (windmillGroup C Rot W) u) →
      ReducedList (w :: l) → ∀ x : X, w.pre⁻¹ • x ∈ stageOne δ C W →
      Nonempty (StageChainData δ C Rot W x (listEval (w :: l) • y)) := by
  intro l
  induction l with
  | nil =>
      intro w hvalid hred x hx
      have hw := hvalid w (by simp)
      obtain ⟨hb, -⟩ := between_and_dist_of_reducedList_stageOne hδ hρ
        hhyp hgeo hfam hvr hsep hW hy ([] : List (Syll G X)) w hvalid hred x hx
      let endpoint : X := listEval [w] • y
      let point : ℕ → X := fun n =>
        if n = 0 then x else if n = 1 then w.pre • w.dir else endpoint
      have hendpoint : endpoint = (w.pre * w.rot) • y := by
        simp [endpoint]
      have hbEndpoint : Between x (w.pre • w.dir) endpoint := by
        simpa only [endpoint] using hb
      have hfix : w.rot • w.dir = w.dir :=
        hfam.rot_fix (newApices_subset hw.dir_mem) w.rot hw.rot_mem
      refine ⟨⟨2, point, ?_, ?_, ?_, ?_, ?_⟩⟩
      · simp [point]
      · simp [point, hendpoint]
      · intro i hi
        have hiCases : i = 0 ∨ i = 1 ∨ i = 2 := by omega
        rcases hiCases with rfl | rfl | rfl
        · simpa [point, hendpoint] using between_self_left x endpoint
        · simpa [point, hendpoint] using hbEndpoint
        · simpa [point, hendpoint] using between_self_right x endpoint
      · intro i hi
        have hiCases : i = 0 ∨ i = 1 := by omega
        rcases hiCases with rfl | rfl
        · simpa [point] using between_self_left x (w.pre • w.dir)
        · simpa [point, hendpoint] using hbEndpoint
      · intro i hi
        have hiCases : i = 0 ∨ i = 1 := by omega
        rcases hiCases with rfl | rfl
        · refine ⟨w.pre, gw_le_stepGroup hw.pre_mem,
            w.pre⁻¹ • x, hx, w.dir, newApices_subset_stageOne hw.dir_mem, ?_, ?_⟩
          · simp [point]
          · simp [point]
        · have ha : w.pre * w.rot ∈
              stepGroup Rot (newApices δ C W) (windmillGroup C Rot W) :=
            (stepGroup Rot (newApices δ C W) (windmillGroup C Rot W)).mul_mem
              (gw_le_stepGroup hw.pre_mem) (rot_le_stepGroup hw.dir_mem hw.rot_mem)
          refine ⟨w.pre * w.rot, ha, w.dir, newApices_subset_stageOne hw.dir_mem,
            y, hy, ?_, ?_⟩
          · change (if True then w.pre • w.dir else endpoint) =
              (w.pre * w.rot) • w.dir
            rw [if_pos trivial, mul_smul, hfix]
          · simp [point, hendpoint]
  | cons t l' ih =>
      intro w hvalid hred x hx
      have hw := hvalid w (by simp)
      have ht := hvalid t (by simp)
      have hredC : List.IsChain Seam (w :: t :: l') := hred
      obtain ⟨-, hredtail⟩ := List.isChain_cons_cons.mp hredC
      have htailStart : t.pre⁻¹ • w.dir ∈ stageOne δ C W :=
        newApices_subset_stageOne
          (smul_mem_newApices hfam hW (inv_mem ht.pre_mem) hw.dir_mem)
      obtain ⟨tail⟩ := ih t
        (fun u hu => hvalid u (List.mem_cons_of_mem w hu)) hredtail w.dir htailStart
      obtain ⟨hb, -⟩ := between_and_dist_of_reducedList_stageOne hδ hρ
        hhyp hgeo hfam hvr hsep hW hy (t :: l') w hvalid hred x hx
      let b : G := w.pre * w.rot
      let endpoint : X := listEval (w :: t :: l') • y
      let point : ℕ → X := fun n => if n = 0 then x else b • tail.point (n - 1)
      have hbEndpoint : Between x (w.pre • w.dir) endpoint := by
        simpa only [endpoint] using hb
      have hbStep : b ∈
          stepGroup Rot (newApices δ C W) (windmillGroup C Rot W) := by
        exact (stepGroup Rot (newApices δ C W) (windmillGroup C Rot W)).mul_mem
          (gw_le_stepGroup hw.pre_mem) (rot_le_stepGroup hw.dir_mem hw.rot_mem)
      have hfix : w.rot • w.dir = w.dir :=
        hfam.rot_fix (newApices_subset hw.dir_mem) w.rot hw.rot_mem
      have hfirst : b • tail.point 0 = w.pre • w.dir := by
        rw [tail.start]
        simp [b, mul_smul, hfix]
      have hb0 : b • w.dir = w.pre • w.dir := by
        simp [b, mul_smul, hfix]
      have hbEnd : b • (listEval (t :: l') • y) = endpoint := by
        dsimp only [b, endpoint]
        simp only [listEval, List.map_cons, List.prod_cons, Syll.eval,
          mul_assoc, mul_smul]
      refine ⟨⟨tail.N + 1, point, ?_, ?_, ?_, ?_, ?_⟩⟩
      · simp [point]
      · have hnonzero : tail.N + 1 ≠ 0 := by omega
        have hindex : tail.N + 1 - 1 = tail.N := by omega
        change (if tail.N + 1 = 0 then x else
          b • tail.point (tail.N + 1 - 1)) = listEval (w :: t :: l') • y
        rw [if_neg hnonzero, hindex, tail.finish]
        dsimp only [b]
        simp only [listEval, List.map_cons, List.prod_cons, Syll.eval,
          mul_assoc, mul_smul]
      · intro i hi
        by_cases hi0 : i = 0
        · subst i
          simpa only [point, if_pos rfl, endpoint] using between_self_left x endpoint
        · have hik : i - 1 ≤ tail.N := by omega
          have htail := tail.between (i - 1) hik
          have htr := smul_between hfam.isometric b htail
          have htr' : Between (w.pre • w.dir) (b • tail.point (i - 1)) endpoint := by
            simpa only [hb0, hbEnd] using htr
          exact Between.trans_right hbEndpoint
            (by simpa only [point, if_neg hi0] using htr')
      · intro i hi
        by_cases hi0 : i = 0
        · subst i
          simpa [point, hfirst] using between_self_left x (w.pre • w.dir)
        · have hik : i - 1 < tail.N := by omega
          have htail := tail.step (i - 1) hik
          have htr := smul_between hfam.isometric b htail
          have htr' : Between (w.pre • w.dir) (b • tail.point (i - 1))
              (b • tail.point ((i - 1) + 1)) := by
            simpa only [hb0] using htr
          have htailFar := tail.between ((i - 1) + 1) (by omega)
          have htrFar := smul_between hfam.isometric b htailFar
          have htrFar' : Between (w.pre • w.dir)
              (b • tail.point ((i - 1) + 1)) endpoint := by
            simpa only [hb0, hbEnd] using htrFar
          have hprefix := Between.prefix_of_trans_right hbEndpoint htrFar'
          have hpointCur : point i = b • tail.point (i - 1) := by
            simp only [point, if_neg hi0]
          have hsuccIndex : i + 1 - 1 = (i - 1) + 1 := by omega
          have hpointSucc : point (i + 1) = b • tail.point ((i - 1) + 1) := by
            simp only [point, if_neg (by omega : ¬ i + 1 = 0), hsuccIndex]
          rw [hpointCur, hpointSucc]
          exact Between.trans_right hprefix htr'
      · intro i hi
        by_cases hi0 : i = 0
        · subst i
          refine ⟨w.pre, gw_le_stepGroup hw.pre_mem,
            w.pre⁻¹ • x, hx, w.dir, newApices_subset_stageOne hw.dir_mem, ?_, ?_⟩
          · simp [point]
          · simp [point, hfirst]
        · have hik : i - 1 < tail.N := by omega
          obtain ⟨a, ha, p, hp, q, hq, heq1, heq2⟩ := tail.edge (i - 1) hik
          refine ⟨b * a,
            (stepGroup Rot (newApices δ C W) (windmillGroup C Rot W)).mul_mem
              hbStep ha, p, hp, q, hq, ?_, ?_⟩
          · simp [point, hi0, heq1, b, mul_smul]
          · have hidx : i + 1 - 1 = (i - 1) + 1 := by omega
            simp [point, hi0, hidx, heq2, b, mul_smul]

/-- **The unfolded stage orbit is `18δ`-quasiconvex.**

Reduce the relative stage element between the two orbit representatives.  Its
developed apices give `StageChainData`; the metric range-cover theorem then
uses one `6δ` quadrilateral over one local `12δ` translated-stage side.
Empty spellings are already contained in one translate of `stageOne`. -/
theorem isQuasiconvexSet_stageOrbit {δ ρ : ℝ} (hδ : 0 < δ)
    (hρ : 200 * δ ≤ ρ) (hhyp : IsHyperbolicSpace δ X)
    (hgeo : IsGeodesicSpace X) {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) (hvr : IsVeryRotating G X δ C Rot)
    (hsep : IsSeparated C ρ) {W : Set X} (hW : IsWindmill G X δ C Rot W) :
    IsQuasiconvexSet (stageOrbit δ C Rot W) (18 * δ) := by
  intro x hx y hy f hf hf0 hf1 t ht
  obtain ⟨g, hg, p, hp, rfl⟩ := mem_stageOrbit_iff.mp hx
  obtain ⟨h, hh, q, hq, rfl⟩ := mem_stageOrbit_iff.mp hy
  let a : G := g⁻¹ * h
  have ha : a ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W) :=
    (stepGroup Rot (newApices δ C W) (windmillGroup C Rot W)).mul_mem
      (inv_mem hg) hh
  let F : ℝ → X := fun s => g⁻¹ • f s
  have hdist : dist (g • p) (h • q) = dist p (a • q) := by
    calc
      dist (g • p) (h • q) = dist (g⁻¹ • (g • p)) (g⁻¹ • (h • q)) := by
        symm
        exact hfam.isometric g⁻¹ (g • p) (h • q)
      _ = dist p (a • q) := by simp [a, mul_smul]
  have hF : IsGeodesicSegment F 0 (dist p (a • q)) := by
    intro s hs u hu
    have hs' : s ∈ Set.Icc (0 : ℝ) (dist (g • p) (h • q)) := by rwa [hdist]
    have hu' : u ∈ Set.Icc (0 : ℝ) (dist (g • p) (h • q)) := by rwa [hdist]
    dsimp [F]
    rw [hfam.isometric]
    exact hf s hs' u hu'
  have hF0 : F 0 = p := by simp [F, hf0]
  have hF1 : F (dist p (a • q)) = a • q := by
    dsimp [F]
    rw [← hdist, hf1]
    simp [a, mul_smul]
  have htF : t ∈ Set.Icc (0 : ℝ) (dist p (a • q)) := by rwa [← hdist]
  have hconj : ∀ (c : G) (d : X), d ∈ newApices δ C W →
      ∀ b ∈ Rot d, c * b * c⁻¹ ∈ Rot (c • d) := by
    intro c d hd b hb
    apply (hfam.rot_equivariant c (newApices_subset hd) (c * b * c⁻¹)).2
    have heq : c⁻¹ * (c * b * c⁻¹) * c = b := by group
    rwa [heq]
  obtain ⟨s, hs, hseval, hsred⟩ := exists_reduced hconj ha
  cases hsylls : s.sylls with
  | nil =>
      have hae : a = s.tail := by
        rw [← hseval, Spelling.eval_def, hsylls, listEval_nil, one_mul]
      have haq : a • q ∈ stageOne δ C W := by
        rw [hae]
        exact smul_mem_stageOne hfam hW hs.tail_mem hq
      obtain ⟨z, hz, hnear⟩ :=
        exists_stageOrbit_dist_le_of_endpoints_in_stageOne_translate hδ hhyp
          hgeo hfam hW (p := p) (q := a • q) (Subgroup.one_mem _) hp haq
          (f := F) (by simpa only [one_smul] using hF)
          (by simpa only [one_smul] using hF0)
          (by simpa only [one_smul] using hF1) (t := t)
          (by simpa only [one_smul] using htF)
      refine ⟨g • z, smul_mem_stageOrbit hg hz, ?_⟩
      calc
        dist (f t) (g • z) = dist (g⁻¹ • f t) z := by
          calc
            dist (f t) (g • z) = dist (g • (g⁻¹ • f t)) (g • z) := by
              rw [smul_smul, mul_inv_cancel, one_smul]
            _ = dist (g⁻¹ • f t) z := hfam.isometric g (g⁻¹ • f t) z
        _ ≤ 18 * δ := le_trans hnear (by linarith)
  | cons w l =>
      have hw : Syll.IsValid Rot (newApices δ C W) (windmillGroup C Rot W) w :=
        hs.sylls_valid w (by rw [hsylls]; simp)
      let y0 : X := s.tail • q
      have hy0 : y0 ∈ stageOne δ C W :=
        smul_mem_stageOne hfam hW hs.tail_mem hq
      have hx0 : w.pre⁻¹ • p ∈ stageOne δ C W :=
        smul_mem_stageOne hfam hW (inv_mem hw.pre_mem) hp
      have hvalid : ∀ u ∈ w :: l,
          Syll.IsValid Rot (newApices δ C W) (windmillGroup C Rot W) u := by
        intro u hu
        exact hs.sylls_valid u (by rwa [hsylls])
      have hred : ReducedList (w :: l) := by
        rw [← hsylls]
        exact hsred
      obtain ⟨data⟩ := exists_stageChainData_of_reducedList hδ hρ hhyp
        hgeo hfam hvr hsep hW hy0 l w hvalid hred p hx0
      have hend : listEval (w :: l) • y0 = a • q := by
        dsimp [y0]
        rw [← mul_smul, ← hsylls, ← Spelling.eval_def, hseval]
      have hdataFinish : data.point data.N = a • q := by
        rw [data.finish, hend]
      have hdataMem : ∀ i, i ≤ data.N → data.point i ∈ stageOrbit δ C Rot W := by
        intro i hi
        by_cases hiN : i = data.N
        · rw [hiN, hdataFinish]
          exact smul_mem_stageOrbit_of_mem_stageOne ha hq
        · have hil : i < data.N := lt_of_le_of_ne hi hiN
          obtain ⟨c, hc, r, hr, -, -, heq, -⟩ := data.edge i hil
          rw [heq]
          exact smul_mem_stageOrbit_of_mem_stageOne hc hr
      have hlocal : ∀ i, i < data.N → ∀ k : ℝ → X,
          IsGeodesicSegment k 0 (dist (data.point i) (data.point (i + 1))) →
          k 0 = data.point i →
          k (dist (data.point i) (data.point (i + 1))) = data.point (i + 1) →
          ∀ r ∈ Set.Icc (0 : ℝ) (dist (data.point i) (data.point (i + 1))),
            ∃ z ∈ stageOrbit δ C Rot W, dist (k r) z ≤ 12 * δ := by
        intro i hi k hk hk0 hk1 r hr
        obtain ⟨c, hc, p', hp', q', hq', heq0, heq1⟩ := data.edge i hi
        exact exists_stageOrbit_dist_le_of_endpoints_in_stageOne_translate hδ
          hhyp hgeo hfam hW (a := c) hc (p := p') (q := q') hp' hq'
          (f := k) (by simpa only [heq0, heq1] using hk)
          (by simpa only [heq0] using hk0)
          (by simpa only [heq0, heq1] using hk1)
          (t := r) (by simpa only [heq0, heq1] using hr)
      obtain ⟨z, hz, hnear⟩ := exists_close_of_ordered_between_chain hδ hhyp
        hgeo data.point data.N data.start hdataFinish
        (fun i hi => by simpa only [hend] using data.between i hi) data.step hdataMem
        hlocal hF hF0 hF1 htF
      refine ⟨g • z, smul_mem_stageOrbit hg hz, ?_⟩
      calc
        dist (f t) (g • z) = dist (g⁻¹ • f t) z := by
          calc
            dist (f t) (g • z) = dist (g • (g⁻¹ • f t)) (g • z) := by
              rw [smul_smul, mul_inv_cancel, one_smul]
            _ = dist (g⁻¹ • f t) z := hfam.isometric g (g⁻¹ • f t) z
        _ ≤ 18 * δ := hnear

/-- An apex within the eventual `18δ` thickening radius of the spoke set is
already old or newly attached.  On the old-windmill part this is its `55δ` far
clause; on a spoke the apex is within `18δ + 76δ` of the tip, still strictly
below the `200δ` separation scale. -/
theorem apex_mem_old_or_new_of_dist_stageOne_le {δ ρ : ℝ} (hδ : 0 < δ)
    (hρ : 200 * δ ≤ ρ) {C : Set X} {Rot : X → Subgroup G}
    (hsep : IsSeparated C ρ) {W : Set X} (hW : IsWindmill G X δ C Rot W)
    {c p : X} (hcC : c ∈ C) (hp : p ∈ stageOne δ C W)
    (hcp : dist c p ≤ 18 * δ) : c ∈ W ∨ c ∈ newApices δ C W := by
  rcases mem_spokeSet_iff.mp hp with hpW | ⟨e, he, w, hw, hew, hep⟩
  · left
    by_contra hcW
    have hfar := hW.far c hcC hcW p hpW
    linarith
  · right
    have heC : e ∈ C := newApices_subset he
    have hep' : dist e p ≤ dist e w := Between.dist_le_left hep
    have hpe : dist p e = dist e p := dist_comm p e
    have htri := dist_triangle c p e
    have hlt : dist c e < ρ := by linarith
    have hce : c = e := eq_of_dist_lt_of_isSeparated hsep hcC heC hlt
    rwa [hce]

/-- **The next windmill `W'`.**  The `18δ` thickness is the budget proved in
`DGOWindmillStage`, not a transcription of DGO's constants. -/
def nextWindmill (δ : ℝ) (C : Set X) (Rot : X → Subgroup G) (W : Set X) : Set X :=
  thicken (stageOrbit δ C Rot W) (18 * δ)

/-- An `18δ` quasiconvexity estimate for the unfolded orbit is exactly enough:
the `18δ` thickening is then `6δ`-quasiconvex. -/
theorem isQuasiconvexSet_nextWindmill_of_stageOrbit {δ : ℝ} (hδ : 0 < δ)
    (hhyp : IsHyperbolicSpace δ X) (hgeo : IsGeodesicSpace X)
    {C : Set X} {Rot : X → Subgroup G} {W : Set X}
    (hOrbit : IsQuasiconvexSet (stageOrbit δ C Rot W) (18 * δ)) :
    IsQuasiconvexSet (nextWindmill δ C Rot W) (6 * δ) :=
  isQuasiconvexSet_thicken hhyp (le_of_lt hδ) hgeo hOrbit (by linarith)

/-- The old windmill is retained by the next stage. -/
theorem subset_nextWindmill {δ : ℝ} (hδ : 0 < δ) {C : Set X}
    {Rot : X → Subgroup G} {W : Set X} :
    W ⊆ nextWindmill δ C Rot W := by
  intro w hw
  apply subset_thicken (by linarith : 0 ≤ 18 * δ)
  exact stageOne_subset_stageOrbit (subset_stageOne hw)

/-- Every apex attached in this stage lies in the next windmill. -/
theorem newApices_subset_nextWindmill {δ : ℝ} (hδ : 0 < δ) {C : Set X}
    {Rot : X → Subgroup G} {W : Set X} :
    newApices δ C W ⊆ nextWindmill δ C Rot W := by
  intro d hd
  apply subset_thicken (by linarith : 0 ≤ 18 * δ)
  exact stageOne_subset_stageOrbit (newApices_subset_stageOne hd)

/-- The next windmill contains an apex because it contains the old windmill. -/
theorem nextWindmill_apex_mem {δ : ℝ} (hδ : 0 < δ) {C : Set X}
    {Rot : X → Subgroup G} {W : Set X} (hW : IsWindmill G X δ C Rot W) :
    ∃ c ∈ C, c ∈ nextWindmill δ C Rot W := by
  obtain ⟨c, hcC, hcW⟩ := hW.apex_mem
  exact ⟨c, hcC, subset_nextWindmill hδ hcW⟩

/-- **The next stage gains the `10δ` required by `WindmillGrowth`.** -/
theorem thicken_subset_nextWindmill {δ : ℝ} (hδ : 0 < δ) {C : Set X}
    {Rot : X → Subgroup G} {W : Set X} :
    thicken W (10 * δ) ⊆ nextWindmill δ C Rot W := by
  intro x hx
  obtain ⟨w, hw, hxw⟩ := mem_thicken_iff.mp hx
  refine mem_thicken_of_dist_le
    (stageOne_subset_stageOrbit (subset_stageOne hw)) ?_
  linarith

/-- **The stage group preserves the thickened next windmill.**  This is the
isometric-action transport of `smul_mem_stageOrbit`. -/
theorem smul_mem_nextWindmill {δ : ℝ} {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) {W : Set X} {a : G}
    (ha : a ∈ stepGroup Rot (newApices δ C W) (windmillGroup C Rot W))
    {x : X} (hx : x ∈ nextWindmill δ C Rot W) :
    a • x ∈ nextWindmill δ C Rot W := by
  obtain ⟨q, hq, hxq⟩ := mem_thicken_iff.mp hx
  refine mem_thicken_of_dist_le (smul_mem_stageOrbit ha hq) ?_
  rwa [hfam.isometric a x q]

/-- **The rotation-generated group of the next windmill is contained in the
explicit stage group.**

An apex of the thickened orbit is pulled back by the orbit translate.  The
preceding `18δ` lemma makes the pulled-back apex old or newly attached, so its
rotation lies in the stage group.  Equivariance then conjugates that rotation
back, still inside the same subgroup. -/
theorem windmillGroup_nextWindmill_le_stepGroup {δ ρ : ℝ} (hδ : 0 < δ)
    (hρ : 200 * δ ≤ ρ) {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) (hsep : IsSeparated C ρ) {W : Set X}
    (hW : IsWindmill G X δ C Rot W) :
    windmillGroup C Rot (nextWindmill δ C Rot W) ≤
      stepGroup Rot (newApices δ C W) (windmillGroup C Rot W) := by
  refine windmillGroup_le ?_
  intro c hcC hcNext r hr
  obtain ⟨q, hq, hcq⟩ := mem_thicken_iff.mp hcNext
  obtain ⟨g, hg, p, hp, hqeq⟩ := mem_stageOrbit_iff.mp hq
  have hc0C : g⁻¹ • c ∈ C := hfam.apex_smul g⁻¹ hcC
  have hc0p : dist (g⁻¹ • c) p ≤ 18 * δ := by
    rw [hqeq] at hcq
    have hiso := hfam.isometric g⁻¹ c q
    rw [hqeq, inv_smul_smul] at hiso
    rw [hiso]
    exact hcq
  have hgc0 : g • (g⁻¹ • c) = c := smul_inv_smul g c
  have hr0 : g⁻¹ * r * g ∈ Rot (g⁻¹ • c) := by
    apply (hfam.rot_equivariant g hc0C r).mp
    rwa [hgc0]
  have hrStage : g⁻¹ * r * g ∈
      stepGroup Rot (newApices δ C W) (windmillGroup C Rot W) := by
    rcases apex_mem_old_or_new_of_dist_stageOne_le hδ hρ hsep hW hc0C hp hc0p
        with hc0W | hc0New
    · exact gw_le_stepGroup (mem_windmillGroup hc0C hc0W hr0)
    · exact rot_le_stepGroup hc0New hr0
  have hmem := (stepGroup Rot (newApices δ C W) (windmillGroup C Rot W)).mul_mem
    ((stepGroup Rot (newApices δ C W) (windmillGroup C Rot W)).mul_mem hg hrStage)
    (inv_mem hg)
  have heq : g * (g⁻¹ * r * g) * g⁻¹ = r := by group
  rwa [heq] at hmem

/-- Invariance of the next windmill follows once its rotation-generated group
is bounded by the explicit stage group. -/
theorem nextWindmill_invariant_of_le {δ : ℝ} {C : Set X}
    {Rot : X → Subgroup G} (hfam : IsRotatingFamily G X C Rot) {W : Set X}
    (hle : windmillGroup C Rot (nextWindmill δ C Rot W) ≤
      stepGroup Rot (newApices δ C W) (windmillGroup C Rot W)) :
    ∀ g ∈ windmillGroup C Rot (nextWindmill δ C Rot W),
      ∀ x ∈ nextWindmill δ C Rot W, g • x ∈ nextWindmill δ C Rot W := by
  intro g hg x hx
  exact smul_mem_nextWindmill hfam (hle hg) hx

/-- **The next windmill is invariant under its own windmill group.** -/
theorem nextWindmill_invariant {δ ρ : ℝ} (hδ : 0 < δ)
    (hρ : 200 * δ ≤ ρ) {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) (hsep : IsSeparated C ρ) {W : Set X}
    (hW : IsWindmill G X δ C Rot W) :
    ∀ g ∈ windmillGroup C Rot (nextWindmill δ C Rot W),
      ∀ x ∈ nextWindmill δ C Rot W, g • x ∈ nextWindmill δ C Rot W :=
  nextWindmill_invariant_of_le hfam
    (windmillGroup_nextWindmill_le_stepGroup hδ hρ hfam hsep hW)

/-- **Apices outside the next windmill satisfy its `55δ` far clause.**

Pull an external apex back along a stage-group translate of `stageOne`.  It is
still outside `nextWindmill`, hence outside both the old windmill and the new
apices.  The proved `75δ` spoke-set estimate applies there; the final `18δ`
thickening leaves `57δ`, with two units of slack. -/
theorem nextWindmill_far {δ ρ : ℝ} (hδ : 0 < δ) (hρ : 200 * δ ≤ ρ)
    {C : Set X} {Rot : X → Subgroup G} (hfam : IsRotatingFamily G X C Rot)
    (hsep : IsSeparated C ρ) {W : Set X} :
    ∀ c ∈ C, c ∉ nextWindmill δ C Rot W →
      ∀ x ∈ nextWindmill δ C Rot W, 55 * δ ≤ dist c x := by
  intro c hcC hcNext x hx
  have hδ0 : (0 : ℝ) ≤ δ := le_of_lt hδ
  have hOrbit : ∀ q ∈ stageOrbit δ C Rot W, 75 * δ ≤ dist c q := by
    intro q hq
    obtain ⟨g, hg, p, hp, hqeq⟩ := mem_stageOrbit_iff.mp hq
    have hc0C : g⁻¹ • c ∈ C := hfam.apex_smul g⁻¹ hcC
    have hc0Next : g⁻¹ • c ∉ nextWindmill δ C Rot W := by
      intro hc0
      apply hcNext
      have h := smul_mem_nextWindmill hfam hg hc0
      rwa [smul_inv_smul] at h
    have hc0W : g⁻¹ • c ∉ W := fun hc0 =>
      hc0Next (subset_nextWindmill hδ hc0)
    have hc0New : g⁻¹ • c ∉ newApices δ C W := fun hc0 =>
      hc0Next (newApices_subset_nextWindmill hδ hc0)
    have hfar := le_dist_of_mem_stageOne hδ0 hρ hsep hc0C hc0W hc0New p hp
    have hiso := hfam.isometric g⁻¹ c q
    rw [hqeq, inv_smul_smul] at hiso
    calc
      75 * δ ≤ dist (g⁻¹ • c) p := hfar
      _ = dist c (g • p) := hiso
      _ = dist c q := by rw [hqeq]
  have hthick := le_dist_of_mem_thicken hOrbit hx
  linarith

/-- **The direct dichotomy for the next windmill.**

The cyclic-reduction theorem now retains that its conjugator lies in the stage
group.  Hence the inverse conjugator preserves `nextWindmill`; moving the
rotation apex by it turns a conjugate rotation into a direct rotation at an
apex of the next windmill. -/
theorem nextWindmill_dichotomy {δ ρ : ℝ} (hδ : 0 < δ)
    (hρ : 200 * δ ≤ ρ) (hhyp : IsHyperbolicSpace δ X)
    (hgeo : IsGeodesicSpace X) {C : Set X} {Rot : X → Subgroup G}
    (hfam : IsRotatingFamily G X C Rot) (hvr : IsVeryRotating G X δ C Rot)
    (hsep : IsSeparated C ρ) {W : Set X} (hW : IsWindmill G X δ C Rot W) :
    ∀ g ∈ windmillGroup C Rot (nextWindmill δ C Rot W),
      (∃ c ∈ C, c ∈ nextWindmill δ C Rot W ∧ g ∈ Rot c) ∨
        ∃ x : X, IsLoxodromic g x := by
  intro g hg
  have hgStep := windmillGroup_nextWindmill_le_stepGroup hδ hρ hfam hsep hW hg
  rcases rotation_or_loxodromic_of_mem_stepGroup hδ hρ hhyp hgeo hfam hvr hsep
      hW hgStep with ⟨a, d, haStep, hdC, hdStage, hrot⟩ | hlox
  · left
    let e : X := a⁻¹ • d
    have heC : e ∈ C := hfam.apex_smul a⁻¹ hdC
    have hdNext : d ∈ nextWindmill δ C Rot W := by
      rcases hdStage with hdW | hdNew
      · exact subset_nextWindmill hδ hdW
      · exact newApices_subset_nextWindmill hδ hdNew
    have heNext : e ∈ nextWindmill δ C Rot W :=
      smul_mem_nextWindmill hfam (inv_mem haStep) hdNext
    have hrot' : g ∈ Rot e := by
      have hback := (hfam.rot_equivariant a heC (a * g * a⁻¹)).mp (by
        change a * g * a⁻¹ ∈ Rot (a • (a⁻¹ • d))
        simpa only [smul_inv_smul] using hrot)
      have heq : a⁻¹ * (a * g * a⁻¹) * a = g := by group
      rwa [heq] at hback
    exact ⟨e, heC, heNext, hrot'⟩
  · exact Or.inr hlox

/-- **Assembly of the concrete next windmill.**  Four parts of the growth step
are now discharged: apex retention, the far clause, invariance, and the `10δ`
gain (the latter is stated separately as `thicken_subset_nextWindmill`).  The
only inputs left here are uniform quasiconvexity of the unfolded/thickened orbit
and the direct rotation-or-loxodromic dichotomy for its windmill group. -/
theorem isWindmill_nextWindmill_of_quasiconvex_of_dichotomy
    {δ ρ : ℝ} (hδ : 0 < δ) (hρ : 200 * δ ≤ ρ)
    {C : Set X} {Rot : X → Subgroup G} (hfam : IsRotatingFamily G X C Rot)
    (hsep : IsSeparated C ρ) {W : Set X} (hW : IsWindmill G X δ C Rot W)
    (hqc : IsQuasiconvexSet (nextWindmill δ C Rot W) (6 * δ))
    (hdich : ∀ g ∈ windmillGroup C Rot (nextWindmill δ C Rot W),
      (∃ c ∈ C, c ∈ nextWindmill δ C Rot W ∧ g ∈ Rot c) ∨
        ∃ x : X, IsLoxodromic g x) :
    IsWindmill G X δ C Rot (nextWindmill δ C Rot W) where
  quasiconvex := hqc
  apex_mem := nextWindmill_apex_mem hδ hW
  far := nextWindmill_far hδ hρ hfam hsep
  invariant := nextWindmill_invariant hδ hρ hfam hsep hW
  dichotomy := hdich

/-- **Only quasiconvexity remains in the concrete growth step.**  The direct
dichotomy is supplied by cyclic reduction with its stage-group conjugator
invariant and the loxodromic axis estimate. -/
theorem isWindmill_nextWindmill_of_quasiconvex
    {δ ρ : ℝ} (hδ : 0 < δ) (hρ : 200 * δ ≤ ρ)
    (hhyp : IsHyperbolicSpace δ X) (hgeo : IsGeodesicSpace X)
    {C : Set X} {Rot : X → Subgroup G} (hfam : IsRotatingFamily G X C Rot)
    (hvr : IsVeryRotating G X δ C Rot) (hsep : IsSeparated C ρ)
    {W : Set X} (hW : IsWindmill G X δ C Rot W)
    (hqc : IsQuasiconvexSet (nextWindmill δ C Rot W) (6 * δ)) :
    IsWindmill G X δ C Rot (nextWindmill δ C Rot W) :=
  isWindmill_nextWindmill_of_quasiconvex_of_dichotomy hδ hρ hfam hsep hW hqc
    (nextWindmill_dichotomy hδ hρ hhyp hgeo hfam hvr hsep hW)

/-- **The growth step reduced to quasiconvexity of the unfolded orbit.** -/
theorem isWindmill_nextWindmill_of_stageOrbit_quasiconvex
    {δ ρ : ℝ} (hδ : 0 < δ) (hρ : 200 * δ ≤ ρ)
    (hhyp : IsHyperbolicSpace δ X) (hgeo : IsGeodesicSpace X)
    {C : Set X} {Rot : X → Subgroup G} (hfam : IsRotatingFamily G X C Rot)
    (hvr : IsVeryRotating G X δ C Rot) (hsep : IsSeparated C ρ)
    {W : Set X} (hW : IsWindmill G X δ C Rot W)
    (hOrbit : IsQuasiconvexSet (stageOrbit δ C Rot W) (18 * δ)) :
    IsWindmill G X δ C Rot (nextWindmill δ C Rot W) :=
  isWindmill_nextWindmill_of_quasiconvex hδ hρ hhyp hgeo hfam hvr hsep hW
    (isQuasiconvexSet_nextWindmill_of_stageOrbit hδ hhyp hgeo hOrbit)

/-- **The complete concrete growth step.**  The reduced-spelling chain gives
the required `18δ` quasiconvexity of the unfolded orbit, so no geometric
premise remains at this stage. -/
theorem isWindmill_nextWindmill
    {δ ρ : ℝ} (hδ : 0 < δ) (hρ : 200 * δ ≤ ρ)
    (hhyp : IsHyperbolicSpace δ X) (hgeo : IsGeodesicSpace X)
    {C : Set X} {Rot : X → Subgroup G} (hfam : IsRotatingFamily G X C Rot)
    (hvr : IsVeryRotating G X δ C Rot) (hsep : IsSeparated C ρ)
    {W : Set X} (hW : IsWindmill G X δ C Rot W) :
    IsWindmill G X δ C Rot (nextWindmill δ C Rot W) :=
  isWindmill_nextWindmill_of_stageOrbit_quasiconvex hδ hρ hhyp hgeo hfam hvr
    hsep hW (isQuasiconvexSet_stageOrbit hδ hρ hhyp hgeo hfam hvr hsep hW)

end DGOWindmill
end GroupApproximation
