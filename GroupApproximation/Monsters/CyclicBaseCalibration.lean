import GroupApproximation.Monsters.CliffordAlgebraLamp
import GroupApproximation.Criterion.FiniteDimensionalKill
import GroupApproximation.Sofic.NormMFResidualDetector
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.GroupTheory.GroupAction.Quotient

/-!
# A rational-overgroup cyclic calibration

This file proves the algebraic cyclic-base calibration around Theorem C of the
non-MF manuscript.  It shows that the marked relations and the Clifford
witness survive after the Kazhdan base is replaced by a cyclic compression
pattern.

We build a concrete countable model `BSLike = Multiplicative ℚ ⋊ ℤ`
containing the Baumslag--Solitar pattern `t γ₀ t⁻¹ = γ₀²`, its coset
`BSLike`-set `Sites`, the Clifford extension
`CliffordBS = lampGroup Sites ⋊ BSLike` with its central sign.  The marked
commutator is proved equal to that sign, hence is nontrivial, central, and of
order two, while every exact finite-dimensional linear representation kills
it.

This is not yet the Lean counterpart of the manuscript's literal
`BS(1,2)` theorem.  The group `BSLike` is the larger rational semidirect
product; the subgroup generated by `gammaZero` and `tZero` is the
Baumslag--Solitar copy, but `Sites` and `CliffordBS` are formed using the
larger ambient group.  This module does not construct the paper's literal
presentation or prove its amenability/MF assertions, and therefore makes no
approximation-theoretic claim.
-/

namespace GroupApproximation
namespace CyclicBaseCalibration

open scoped commutatorElement
open scoped Matrix.Norms.L2Operator
open CliffordAlgebraLamp

/-! ## The concrete cyclic-base model -/

/-- The doubling automorphism of the additive rationals, written
multiplicatively. -/
def doublingAut : MulAut (Multiplicative ℚ) where
  toFun q := Multiplicative.ofAdd (2 * q.toAdd)
  invFun q := Multiplicative.ofAdd (q.toAdd / 2)
  left_inv q := by
    simp only [toAdd_ofAdd]
    rw [mul_div_cancel_left₀ _ (two_ne_zero (α := ℚ))]
    exact ofAdd_toAdd q
  right_inv q := by
    simp only [toAdd_ofAdd]
    rw [mul_comm, div_mul_cancel₀ _ (two_ne_zero (α := ℚ))]
    exact ofAdd_toAdd q
  map_mul' a b := by
    rw [toAdd_mul, mul_add, ofAdd_add]

/-- Evaluation of the doubling automorphism. -/
theorem doublingAut_ofAdd (q : ℚ) :
    doublingAut (Multiplicative.ofAdd q) = Multiplicative.ofAdd (2 * q) := by
  show Multiplicative.ofAdd
    (2 * Multiplicative.toAdd (Multiplicative.ofAdd q)) = _
  rw [toAdd_ofAdd]

/-- The `ℤ`-action on `Multiplicative ℚ` generated by doubling. -/
def actingHom : Multiplicative ℤ →* MulAut (Multiplicative ℚ) :=
  zpowersHom _ doublingAut

/-- Evaluation of the action at the generator. -/
theorem actingHom_ofAdd_one (q : Multiplicative ℚ) :
    actingHom (Multiplicative.ofAdd (1 : ℤ)) q = doublingAut q := by
  rw [actingHom, zpowersHom_apply, toAdd_ofAdd, zpow_one]

/-- The concrete countable group carrying the Baumslag--Solitar pattern:
`Multiplicative ℚ ⋊ ℤ` with `ℤ` acting by powers of doubling.  It contains
`BS(1,2)` as the subgroup generated by the two distinguished elements
below; the calibration uses only the pattern, so the ambient overgroup is
harmless and spares all normal-form theory. -/
abbrev BSLike : Type :=
  SemidirectProduct (Multiplicative ℚ) (Multiplicative ℤ) actingHom

/-- The translation generator `γ₀`. -/
def gammaZero : BSLike :=
  SemidirectProduct.inl (Multiplicative.ofAdd (1 : ℚ))

/-- The doubling stable letter `t`. -/
def tZero : BSLike :=
  SemidirectProduct.inr (Multiplicative.ofAdd (1 : ℤ))

/-- Left-factor elements conjugate by the doubling action. -/
theorem inr_mul_inl (g : Multiplicative ℤ) (x : Multiplicative ℚ) :
    (SemidirectProduct.inr g * SemidirectProduct.inl x : BSLike) =
      SemidirectProduct.inl (actingHom g x) * SemidirectProduct.inr g := by
  rw [SemidirectProduct.inl_aut, mul_assoc, ← map_mul, inv_mul_cancel,
    map_one, mul_one]

/-- The Baumslag--Solitar relation for the distinguished elements. -/
theorem conj_gammaZero : tZero * gammaZero * tZero⁻¹ = gammaZero ^ 2 := by
  have h : tZero * gammaZero * tZero⁻¹ =
      SemidirectProduct.inl
        (actingHom (Multiplicative.ofAdd (1 : ℤ))
          (Multiplicative.ofAdd (1 : ℚ))) := by
    rw [tZero, gammaZero, ← map_inv, SemidirectProduct.inl_aut]
  rw [h, actingHom_ofAdd_one, doublingAut_ofAdd, gammaZero, ← map_pow]
  congr 1

/-- The cyclic subgroup generated by `γ₀`. -/
def Gamma0 : Subgroup BSLike := Subgroup.zpowers gammaZero

/-- The coset space on which the lamps live. -/
abbrev Sites : Type := BSLike ⧸ Gamma0

/-- The basepoint coset. -/
def basepoint : Sites := QuotientGroup.mk 1

/-- `γ₀` fixes the basepoint. -/
theorem gammaZero_smul_basepoint : gammaZero • basepoint = basepoint := by
  rw [basepoint, MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
  exact (QuotientGroup.eq).mpr
    (by rw [mul_one]; exact Gamma0.inv_mem (Subgroup.mem_zpowers gammaZero))

/-- Integer powers of `γ₀` in the left factor. -/
theorem gammaZero_zpow (n : ℤ) :
    gammaZero ^ n =
      SemidirectProduct.inl (Multiplicative.ofAdd ((n : ℚ))) := by
  rw [gammaZero, ← map_zpow]
  congr 1
  apply Multiplicative.toAdd.injective
  simp

/-- `γ₀` moves the site `t • basepoint`: the two lamp sites of the marked
word are distinct. -/
theorem gammaZero_moves :
    gammaZero • (tZero • basepoint) ≠ tZero • basepoint := by
  intro h
  rw [smul_smul, basepoint, MulAction.Quotient.smul_mk,
    MulAction.Quotient.smul_mk, smul_eq_mul, smul_eq_mul, mul_one,
    mul_one] at h
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp ((QuotientGroup.eq).mp h)
  -- hn : γ₀ ^ n = (γ₀ * t)⁻¹ * t
  have hn' : tZero * gammaZero ^ n = gammaZero⁻¹ * tZero := by
    rw [hn, mul_inv_rev, mul_assoc]
    rw [mul_inv_cancel_left]
  rw [gammaZero_zpow, tZero, inr_mul_inl, actingHom_ofAdd_one,
    doublingAut_ofAdd, gammaZero, ← map_inv, ← ofAdd_neg, ← tZero] at hn'
  have hcomp := mul_right_cancel hn'
  have hq : 2 * (n : ℚ) = -1 := by
    have hq' := SemidirectProduct.inl_injective hcomp
    exact congrArg Multiplicative.toAdd hq'
  have hz : 2 * n = -1 := by exact_mod_cast hq
  omega

/-! ## The Clifford semidirect witness -/

/-- The left action of the Baumslag--Solitar model on its cosets, transported
to the Clifford lamp group by relabeling lamp sites. -/
noncomputable def lampAction : BSLike →* MulAut (lampGroup Sites) :=
  (permHom Sites).comp (MulAction.toPermHom BSLike Sites)

@[simp] theorem lampAction_lampGen (g : BSLike) (x : Sites) :
    lampAction g (lampGen Sites x) = lampGen Sites (g • x) := by
  change permHom Sites (MulAction.toPermHom BSLike Sites g)
      (lampGen Sites x) = lampGen Sites (g • x)
  rw [permHom_lampGen]
  rfl

@[simp] theorem lampAction_zGen (g : BSLike) :
    lampAction g (zGen Sites) = zGen Sites := by
  change permHom Sites (MulAction.toPermHom BSLike Sites g) (zGen Sites) = _
  exact permHom_zGen Sites _

/-- The concrete Clifford-lamp extension of the cyclic compression model. -/
noncomputable abbrev CliffordBS : Type :=
  SemidirectProduct (lampGroup Sites) BSLike lampAction

noncomputable instance : Group CliffordBS :=
  inferInstanceAs (Group (SemidirectProduct (lampGroup Sites) BSLike lampAction))

/-- The cyclic base generator inside the Clifford extension. -/
noncomputable def gammaBS : CliffordBS := SemidirectProduct.inr gammaZero

/-- The stable letter inside the Clifford extension. -/
noncomputable def tBS : CliffordBS := SemidirectProduct.inr tZero

/-- The root Clifford lamp. -/
noncomputable def cBS : CliffordBS :=
  SemidirectProduct.inl (lampGen Sites basepoint)

/-- The surviving central Clifford sign. -/
noncomputable def zBS : CliffordBS :=
  SemidirectProduct.inl (zGen Sites)

/-- Conjugation by a base-group element relabels a Clifford lamp. -/
theorem conj_lamp (g : BSLike) (x : Sites) :
    (SemidirectProduct.inr g : CliffordBS) *
        SemidirectProduct.inl (lampGen Sites x) *
          (SemidirectProduct.inr g)⁻¹ =
      SemidirectProduct.inl (lampGen Sites (g • x)) := by
  rw [← map_inv, ← SemidirectProduct.inl_aut, lampAction_lampGen]

/-- The cyclic base generator fixes the root lamp. -/
theorem gammaBS_conj_cBS : gammaBS * cBS * gammaBS⁻¹ = cBS := by
  rw [gammaBS, cBS, conj_lamp, gammaZero_smul_basepoint]

/-- The root lamp commutes with the cyclic base generator. -/
theorem cBS_comm_gammaBS : Commute cBS gammaBS := by
  have h : gammaBS * cBS = cBS * gammaBS :=
    mul_inv_eq_iff_eq_mul.mp gammaBS_conj_cBS
  exact h.symm

/-- The stable letter compresses the cyclic base generator by doubling. -/
theorem tBS_conj_gammaBS : tBS * gammaBS * tBS⁻¹ = gammaBS ^ 2 := by
  show SemidirectProduct.inr tZero * SemidirectProduct.inr gammaZero *
      (SemidirectProduct.inr tZero : CliffordBS)⁻¹ =
        (SemidirectProduct.inr gammaZero : CliffordBS) ^ 2
  rw [← map_inv, ← map_mul, ← map_mul, conj_gammaZero, map_pow]

/-- The two conjugated lamp sites in the marked word are distinct. -/
theorem marked_sites_ne :
    tZero • basepoint ≠ (gammaZero * tZero) • basepoint := by
  intro h
  exact gammaZero_moves (by simpa only [smul_smul] using h.symm)

/-- The manuscript's marked compression word evaluates to the Clifford sign
in the cyclic-base witness. -/
theorem markedWord_eq_zBS :
    markedCompressionWord tBS gammaBS cBS = zBS := by
  have ht : tBS * cBS * tBS⁻¹ =
      SemidirectProduct.inl (lampGen Sites (tZero • basepoint)) := by
    rw [tBS, cBS, conj_lamp]
  have hgt : gammaBS *
      SemidirectProduct.inl (lampGen Sites (tZero • basepoint)) * gammaBS⁻¹ =
        SemidirectProduct.inl
          (lampGen Sites ((gammaZero * tZero) • basepoint)) := by
    rw [gammaBS, conj_lamp, smul_smul]
  rw [markedCompressionWord, ht, hgt, ← map_commutatorElement,
    commutator_lampGen Sites marked_sites_ne]
  rfl

/-- The marked sign is nontrivial in the Clifford semidirect witness. -/
theorem zBS_ne_one : zBS ≠ 1 := by
  intro h
  apply zGen_ne_one Sites
  have hleft := congrArg SemidirectProduct.left h
  simpa [zBS] using hleft

/-- Consequently the marked compression word genuinely survives. -/
theorem markedWord_ne_one :
    markedCompressionWord tBS gammaBS cBS ≠ 1 := by
  rw [markedWord_eq_zBS]
  exact zBS_ne_one

/-- The surviving sign has order two. -/
theorem zBS_sq : zBS ^ 2 = 1 := by
  rw [zBS, ← map_pow, zGen_sq, map_one]

/-- The surviving sign is central in the whole semidirect product. -/
theorem zBS_central (g : CliffordBS) : Commute zBS g := by
  obtain ⟨n, v⟩ := g
  show zBS * ⟨n, v⟩ = ⟨n, v⟩ * zBS
  show (⟨zGen Sites, 1⟩ : CliffordBS) * ⟨n, v⟩ =
    ⟨n, v⟩ * ⟨zGen Sites, 1⟩
  apply SemidirectProduct.ext
  · change zGen Sites * lampAction 1 n = n * lampAction v (zGen Sites)
    rw [map_one, lampAction_zGen]
    exact ((Subgroup.mem_center_iff.mp (zGen_mem_center Sites)) n).symm
  · change (1 : BSLike) * v = v * 1
    simp

/-- The marked word is itself a central involution. -/
theorem markedWord_sq : markedCompressionWord tBS gammaBS cBS ^ 2 = 1 := by
  rw [markedWord_eq_zBS]
  exact zBS_sq

theorem markedWord_central (g : CliffordBS) :
    Commute (markedCompressionWord tBS gammaBS cBS) g := by
  rw [markedWord_eq_zBS]
  exact zBS_central g

/-! ## Exact finite-dimensional sterility -/

/-- The cyclic subset used as the compressed base in Theorem B. -/
def cyclicBase : Set CliffordBS :=
  {g | ∃ n : ℤ, g = gammaBS ^ n}

theorem gammaBS_mem_cyclicBase : gammaBS ∈ cyclicBase := by
  exact ⟨1, (pow_one gammaBS).symm⟩

/-- Conjugation by the stable letter carries the cyclic base into itself. -/
theorem tBS_compresses_cyclicBase :
    ∀ g ∈ cyclicBase, tBS * g * tBS⁻¹ ∈ cyclicBase := by
  rintro g ⟨n, rfl⟩
  refine ⟨2 * n, ?_⟩
  rw [← conj_zpow, tBS_conj_gammaBS]
  exact (zpow_mul gammaBS 2 n).symm

/-- The root lamp centralizes every power of the cyclic generator. -/
theorem cBS_centralizes_cyclicBase :
    ∀ g ∈ cyclicBase, cBS * g = g * cBS := by
  rintro g ⟨n, rfl⟩
  exact (cBS_comm_gammaBS.zpow_right n).eq

/-- Every finite-dimensional representation of the Clifford cyclic witness,
over every field, kills its nontrivial marked sign.  This is the cyclic-base
instance of the manuscript's Theorem B and uses no amenability or MF input. -/
theorem clifford_findim_kill
    {k V : Type*} [Field k] [AddCommGroup V] [Module k V]
    [FiniteDimensional k V]
    (pi : CliffordBS →* (Module.End k V)ˣ) :
    pi (markedCompressionWord tBS gammaBS cBS) = 1 := by
  simpa [markedCompressionWord] using
    map_marked_commutator_eq_one_units pi gammaBS_mem_cyclicBase
      tBS_compresses_cyclicBase cBS_centralizes_cyclicBase

end CyclicBaseCalibration
end GroupApproximation
