import GroupApproximation.Monsters.P13SteinbergCalculus
import GroupApproximation.Monsters.SL3ElementaryGeneration

/-!
# Unipotent injectivity in the P13 presentation

The upper-triangular root subgroup of `P13` — generated by the roots
`e₁₂, e₁₃, e₂₃` — is a discrete Heisenberg group: every element has the
normal form `x₁₂(a) · x₁₃(b) · x₂₃(c)`, and the matrix model recovers
`(a, b, c)` from the entries of the image, so the canonical homomorphism
`toSL3` is injective there.

This is the `n = 3` case of the classical triangular-subgroup fact for
Steinberg groups (compare Weibel, *The K-book*, Ex. III.5.2), and the
first pillar of the kernel computation for the completeness programme:
the kernel of `toSL3` meets the unipotent root subgroup trivially.
-/

namespace GroupApproximation
namespace P13UnipotentInjectivity

open LiteralP13Presentation P13SteinbergCalculus LiteralP13MatrixModel
open SL3ElementaryGeneration

noncomputable section

/-! ## Root powers in the matrix model -/

theorem toSL3_x (i : Fin 6) (a : ℤ) :
    toSL3 (x i a) = (elem i) ^ a := by
  unfold x
  rw [map_zpow, toSL3_of]

theorem tv_one_zpow (i j : Fin 3) (hij : i ≠ j) (a : ℤ) :
    (tv i j hij 1) ^ a = tv i j hij a := by
  induction a using Int.induction_on with
  | zero => simpa using (tv_zero i j hij).symm
  | succ n ih =>
      rw [zpow_add, zpow_one, ih, tv_mul_tv]
  | pred n ih =>
      rw [sub_eq_add_neg, zpow_add, zpow_neg_one, ih, ← tv_neg,
        tv_mul_tv]

/-- The three upper root powers as integer transvections. -/
theorem elem0_zpow (a : ℤ) : (elem 0) ^ a = tv 0 1 (by decide) a := by
  rw [show elem 0 = tv 0 1 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

theorem elem1_zpow (a : ℤ) : (elem 1) ^ a = tv 0 2 (by decide) a := by
  rw [show elem 1 = tv 0 2 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

theorem elem3_zpow (a : ℤ) : (elem 3) ^ a = tv 1 2 (by decide) a := by
  rw [show elem 3 = tv 1 2 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

/-! ## The upper-triangular subgroup -/

/-- The upper-triangular normal form `x₁₂(a) x₁₃(b) x₂₃(c)`. -/
def upper (a b c : ℤ) : P13 := x 0 a * x 1 b * x 3 c

/-- The generating set of the upper-triangular subgroup. -/
def upperGens : Set P13 :=
  {PresentedGroup.of 0, PresentedGroup.of 1, PresentedGroup.of 3}

/-- Right absorption of `x₁₂(d)`. -/
theorem upper_mul_e12 (a b c d : ℤ) :
    upper a b c * x 0 d = upper (a + d) (b - d * c) c := by
  have hconj := x_conj_12_23 d c
  have h1 : x 0 d * x 3 c = x 1 (d * c) * x 3 c * x 0 d := by
    have h2 := congrArg (· * x 0 d) hconj
    simpa [mul_assoc] using h2
  have h3 : x 1 (-(d * c)) * (x 0 d * x 3 c) = x 3 c * x 0 d := by
    rw [h1, x_neg]
    group
  have hswap : x 3 c * x 0 d = x 0 d * (x 1 (-(d * c)) * x 3 c) := by
    rw [← h3, ← mul_assoc,
      ((x_commute_12_13 d (-(d * c))).eq).symm, mul_assoc]
  show x 0 a * x 1 b * x 3 c * x 0 d = _
  calc x 0 a * x 1 b * x 3 c * x 0 d
      = x 0 a * x 1 b * (x 3 c * x 0 d) := by group
    _ = x 0 a * x 1 b * (x 0 d * (x 1 (-(d * c)) * x 3 c)) := by
        rw [hswap]
    _ = x 0 a * (x 1 b * x 0 d) * x 1 (-(d * c)) * x 3 c := by group
    _ = x 0 a * (x 0 d * x 1 b) * x 1 (-(d * c)) * x 3 c := by
        rw [((x_commute_12_13 d b).eq).symm]
    _ = (x 0 a * x 0 d) * (x 1 b * x 1 (-(d * c))) * x 3 c := by group
    _ = x 0 (a + d) * x 1 (b + -(d * c)) * x 3 c := by
        rw [x_add, x_add]

/-- Right absorption of `x₁₃(d)`. -/
theorem upper_mul_e13 (a b c d : ℤ) :
    upper a b c * x 1 d = upper a (b + d) c := by
  show x 0 a * x 1 b * x 3 c * x 1 d = _
  calc x 0 a * x 1 b * x 3 c * x 1 d
      = x 0 a * x 1 b * (x 3 c * x 1 d) := by group
    _ = x 0 a * x 1 b * (x 1 d * x 3 c) := by
        rw [((x_commute_13_23 d c).eq).symm]
    _ = x 0 a * (x 1 b * x 1 d) * x 3 c := by group
    _ = x 0 a * x 1 (b + d) * x 3 c := by rw [x_add]

/-- Right absorption of `x₂₃(d)`. -/
theorem upper_mul_e23 (a b c d : ℤ) :
    upper a b c * x 3 d = upper a b (c + d) := by
  show x 0 a * x 1 b * x 3 c * x 3 d = _
  rw [mul_assoc, x_add]
  rfl

/-- Products of normal forms are normal forms, with explicit
coefficients. -/
theorem upper_mul_upper (a b c a' b' c' : ℤ) :
    upper a b c * upper a' b' c' =
      upper (a + a') (b - a' * c + b') (c + c') := by
  have hsplit : upper a b c * upper a' b' c' =
      ((upper a b c * x 0 a') * x 1 b') * x 3 c' := by
    show upper a b c * (x 0 a' * x 1 b' * x 3 c') = _
    group
  rw [hsplit, upper_mul_e12, upper_mul_e13, upper_mul_e23]

/-- Inverses of normal forms are normal forms. -/
theorem upper_inv (a b c : ℤ) :
    (upper a b c)⁻¹ = upper (-a) (-b - a * c) (-c) := by
  apply inv_eq_of_mul_eq_one_right
  rw [upper_mul_upper]
  have h1 : a + -a = 0 := by ring
  have h2 : b - -a * c + (-b - a * c) = 0 := by ring
  have h3 : c + -c = 0 := by ring
  rw [h1, h2, h3]
  show x 0 0 * x 1 0 * x 3 0 = 1
  simp

/-- Every element of the upper-triangular subgroup is a normal form. -/
theorem exists_upper_of_mem {g : P13}
    (hg : g ∈ Subgroup.closure upperGens) :
    ∃ a b c : ℤ, g = upper a b c := by
  induction hg using Subgroup.closure_induction with
  | mem g hgen =>
      simp only [upperGens, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hgen
      rcases hgen with h | h | h
      · exact ⟨1, 0, 0, by simp [h, upper]⟩
      · exact ⟨0, 1, 0, by simp [h, upper]⟩
      · exact ⟨0, 0, 1, by simp [h, upper]⟩
  | one => exact ⟨0, 0, 0, by simp [upper]⟩
  | mul g h _ _ ihg ihh =>
      obtain ⟨a, b, c, rfl⟩ := ihg
      obtain ⟨a', b', c', rfl⟩ := ihh
      exact ⟨_, _, _, upper_mul_upper a b c a' b' c'⟩
  | inv g _ ih =>
      obtain ⟨a, b, c, rfl⟩ := ih
      exact ⟨_, _, _, upper_inv a b c⟩

/-! ## Injectivity through the matrix model -/

/-- The matrix image of the upper normal form. -/
theorem toSL3_upper (a b c : ℤ) :
    (toSL3 (upper a b c) : Matrix (Fin 3) (Fin 3) ℤ) =
      !![1, a, b + a * c; 0, 1, c; 0, 0, 1] := by
  show ((toSL3 (x 0 a * x 1 b * x 3 c) : SL3) :
    Matrix (Fin 3) (Fin 3) ℤ) = _
  rw [map_mul, map_mul, toSL3_x, toSL3_x, toSL3_x,
    elem0_zpow, elem1_zpow, elem3_zpow,
    Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
    tv_coe, tv_coe, tv_coe]
  ext p q
  fin_cases p <;> fin_cases q <;>
    (simp [Matrix.transvection, Matrix.mul_apply, Matrix.single,
      Matrix.one_apply, Fin.sum_univ_three]; try ring)

/-- Distinct coefficient triples give distinct normal forms. -/
theorem upper_coeff_inj {a b c a' b' c' : ℤ}
    (h : upper a b c = upper a' b' c') : a = a' ∧ b = b' ∧ c = c' := by
  have himg := congrArg
    (fun g => (toSL3 g : Matrix (Fin 3) (Fin 3) ℤ)) h
  simp only [toSL3_upper] at himg
  have e01 : a = a' := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 0 1) himg
    simpa using this
  have e12 : c = c' := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 1 2) himg
    simpa using this
  have e02 : b + a * c = b' + a' * c' := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 0 2) himg
    simpa using this
  refine ⟨e01, ?_, e12⟩
  rw [e01, e12] at e02
  linarith

/-- **Unipotent kernel triviality.**  An element of the upper-triangular
root subgroup that the matrix model sends to the identity is the
identity. -/
theorem eq_one_of_mem_upper_of_map_eq_one {g : P13}
    (hg : g ∈ Subgroup.closure upperGens) (h1 : toSL3 g = 1) :
    g = 1 := by
  obtain ⟨a, b, c, rfl⟩ := exists_upper_of_mem hg
  have himg : (toSL3 (upper a b c) : Matrix (Fin 3) (Fin 3) ℤ) =
      (1 : Matrix (Fin 3) (Fin 3) ℤ) := by
    rw [h1]
    simp
  rw [toSL3_upper] at himg
  have ha : a = 0 := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 0 1) himg
    simpa [Matrix.one_apply] using this
  have hc : c = 0 := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 1 2) himg
    simpa [Matrix.one_apply] using this
  have hb : b + a * c = 0 := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 0 2) himg
    simpa [Matrix.one_apply] using this
  have hb0 : b = 0 := by
    rw [ha, hc] at hb
    linarith
  rw [ha, hb0, hc]
  show x 0 0 * x 1 0 * x 3 0 = 1
  simp

end

end P13UnipotentInjectivity
end GroupApproximation
