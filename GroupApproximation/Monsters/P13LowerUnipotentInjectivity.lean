import GroupApproximation.Monsters.P13UnipotentInjectivity

/-!
# Lower unipotent injectivity in the P13 presentation

The lower-triangular root subgroup of `P13` — generated by the roots
`e₂₁, e₃₁, e₃₂` — is again a discrete Heisenberg group: every element
has the normal form `x₂₁(a) · x₃₁(b) · x₃₂(c)`, and the matrix model
recovers `(a, b, c)` from the entries of the image, so the canonical
homomorphism `toSL3` is injective there.

This is the mirror of the upper-triangular pillar
(`P13UnipotentInjectivity`); together they show that the kernel of
`toSL3` meets both maximal unipotent root subgroups trivially.
-/

namespace GroupApproximation
namespace P13LowerUnipotentInjectivity

open LiteralP13Presentation P13SteinbergCalculus LiteralP13MatrixModel
open SL3ElementaryGeneration P13UnipotentInjectivity

noncomputable section

/-! ## Root powers in the matrix model -/

/-- The three lower root powers as integer transvections. -/
theorem elem2_zpow (a : ℤ) : (elem 2) ^ a = tv 1 0 (by decide) a := by
  rw [show elem 2 = tv 1 0 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

theorem elem4_zpow (a : ℤ) : (elem 4) ^ a = tv 2 0 (by decide) a := by
  rw [show elem 4 = tv 2 0 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

theorem elem5_zpow (a : ℤ) : (elem 5) ^ a = tv 2 1 (by decide) a := by
  rw [show elem 5 = tv 2 1 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

/-! ## The lower-triangular subgroup -/

/-- The lower-triangular normal form `x₂₁(a) x₃₁(b) x₃₂(c)`. -/
def lower (a b c : ℤ) : P13 := x 2 a * x 4 b * x 5 c

/-- The generating set of the lower-triangular subgroup. -/
def lowerGens : Set P13 :=
  {PresentedGroup.of 2, PresentedGroup.of 4, PresentedGroup.of 5}

/-- Right absorption of `x₂₁(d)`. -/
theorem lower_mul_e21 (a b c d : ℤ) :
    lower a b c * x 2 d = lower (a + d) (b + c * d) c := by
  have hconj := x_conj_32_21 c d
  have hswap : x 5 c * x 2 d = x 4 (c * d) * x 2 d * x 5 c := by
    have h2 := congrArg (· * x 5 c) hconj
    simpa [mul_assoc] using h2
  show x 2 a * x 4 b * x 5 c * x 2 d = _
  calc x 2 a * x 4 b * x 5 c * x 2 d
      = x 2 a * x 4 b * (x 5 c * x 2 d) := by group
    _ = x 2 a * x 4 b * (x 4 (c * d) * x 2 d * x 5 c) := by rw [hswap]
    _ = x 2 a * (x 4 b * x 4 (c * d)) * x 2 d * x 5 c := by group
    _ = x 2 a * x 4 (b + c * d) * x 2 d * x 5 c := by rw [x_add]
    _ = x 2 a * (x 4 (b + c * d) * x 2 d) * x 5 c := by group
    _ = x 2 a * (x 2 d * x 4 (b + c * d)) * x 5 c := by
        rw [((x_commute_21_31 d (b + c * d)).eq).symm]
    _ = (x 2 a * x 2 d) * x 4 (b + c * d) * x 5 c := by group
    _ = x 2 (a + d) * x 4 (b + c * d) * x 5 c := by rw [x_add]

/-- Right absorption of `x₃₁(d)`. -/
theorem lower_mul_e31 (a b c d : ℤ) :
    lower a b c * x 4 d = lower a (b + d) c := by
  show x 2 a * x 4 b * x 5 c * x 4 d = _
  calc x 2 a * x 4 b * x 5 c * x 4 d
      = x 2 a * x 4 b * (x 5 c * x 4 d) := by group
    _ = x 2 a * x 4 b * (x 4 d * x 5 c) := by
        rw [((x_commute_31_32 d c).eq).symm]
    _ = x 2 a * (x 4 b * x 4 d) * x 5 c := by group
    _ = x 2 a * x 4 (b + d) * x 5 c := by rw [x_add]

/-- Right absorption of `x₃₂(d)`. -/
theorem lower_mul_e32 (a b c d : ℤ) :
    lower a b c * x 5 d = lower a b (c + d) := by
  show x 2 a * x 4 b * x 5 c * x 5 d = _
  rw [mul_assoc, x_add]
  rfl

/-- Products of normal forms are normal forms, with explicit
coefficients. -/
theorem lower_mul_lower (a b c a' b' c' : ℤ) :
    lower a b c * lower a' b' c' =
      lower (a + a') (b + c * a' + b') (c + c') := by
  have hsplit : lower a b c * lower a' b' c' =
      ((lower a b c * x 2 a') * x 4 b') * x 5 c' := by
    show lower a b c * (x 2 a' * x 4 b' * x 5 c') = _
    group
  rw [hsplit, lower_mul_e21, lower_mul_e31, lower_mul_e32]

/-- Inverses of normal forms are normal forms. -/
theorem lower_inv (a b c : ℤ) :
    (lower a b c)⁻¹ = lower (-a) (a * c - b) (-c) := by
  apply inv_eq_of_mul_eq_one_right
  rw [lower_mul_lower]
  have h1 : a + -a = 0 := by ring
  have h2 : b + c * -a + (a * c - b) = 0 := by ring
  have h3 : c + -c = 0 := by ring
  rw [h1, h2, h3]
  show x 2 0 * x 4 0 * x 5 0 = 1
  simp

/-- Every element of the lower-triangular subgroup is a normal form. -/
theorem exists_lower_of_mem {g : P13}
    (hg : g ∈ Subgroup.closure lowerGens) :
    ∃ a b c : ℤ, g = lower a b c := by
  induction hg using Subgroup.closure_induction with
  | mem g hgen =>
      simp only [lowerGens, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hgen
      rcases hgen with h | h | h
      · exact ⟨1, 0, 0, by simp [h, lower]⟩
      · exact ⟨0, 1, 0, by simp [h, lower]⟩
      · exact ⟨0, 0, 1, by simp [h, lower]⟩
  | one => exact ⟨0, 0, 0, by simp [lower]⟩
  | mul g h _ _ ihg ihh =>
      obtain ⟨a, b, c, rfl⟩ := ihg
      obtain ⟨a', b', c', rfl⟩ := ihh
      exact ⟨_, _, _, lower_mul_lower a b c a' b' c'⟩
  | inv g _ ih =>
      obtain ⟨a, b, c, rfl⟩ := ih
      exact ⟨_, _, _, lower_inv a b c⟩

/-! ## Injectivity through the matrix model -/

/-- The matrix image of the lower normal form. -/
theorem toSL3_lower (a b c : ℤ) :
    (toSL3 (lower a b c) : Matrix (Fin 3) (Fin 3) ℤ) =
      !![1, 0, 0; a, 1, 0; b, c, 1] := by
  show ((toSL3 (x 2 a * x 4 b * x 5 c) : SL3) :
    Matrix (Fin 3) (Fin 3) ℤ) = _
  rw [map_mul, map_mul, toSL3_x, toSL3_x, toSL3_x,
    elem2_zpow, elem4_zpow, elem5_zpow,
    Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
    tv_coe, tv_coe, tv_coe]
  ext p q
  fin_cases p <;> fin_cases q <;>
    (simp [Matrix.transvection, Matrix.mul_apply, Matrix.single,
      Matrix.one_apply, Fin.sum_univ_three]; try ring)

/-- Distinct coefficient triples give distinct normal forms. -/
theorem lower_coeff_inj {a b c a' b' c' : ℤ}
    (h : lower a b c = lower a' b' c') : a = a' ∧ b = b' ∧ c = c' := by
  have himg := congrArg
    (fun g => (toSL3 g : Matrix (Fin 3) (Fin 3) ℤ)) h
  simp only [toSL3_lower] at himg
  refine ⟨?_, ?_, ?_⟩
  · have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 1 0) himg
    simpa using this
  · have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 2 0) himg
    simpa using this
  · have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 2 1) himg
    simpa using this

/-- **Lower unipotent kernel triviality.**  An element of the
lower-triangular root subgroup that the matrix model sends to the
identity is the identity. -/
theorem eq_one_of_mem_lower_of_map_eq_one {g : P13}
    (hg : g ∈ Subgroup.closure lowerGens) (h1 : toSL3 g = 1) :
    g = 1 := by
  obtain ⟨a, b, c, rfl⟩ := exists_lower_of_mem hg
  have himg : (toSL3 (lower a b c) : Matrix (Fin 3) (Fin 3) ℤ) =
      (1 : Matrix (Fin 3) (Fin 3) ℤ) := by
    rw [h1]
    simp
  rw [toSL3_lower] at himg
  have ha : a = 0 := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 1 0) himg
    simpa [Matrix.one_apply] using this
  have hb : b = 0 := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 2 0) himg
    simpa [Matrix.one_apply] using this
  have hc : c = 0 := by
    have := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℤ => M 2 1) himg
    simpa [Matrix.one_apply] using this
  rw [ha, hb, hc]
  show x 2 0 * x 4 0 * x 5 0 = 1
  simp

end

end P13LowerUnipotentInjectivity
end GroupApproximation
