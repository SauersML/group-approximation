import GroupApproximation.Monsters.P13UnipotentInjectivity

/-!
# Lower unipotent injectivity in the P13 presentation

The lower-triangular root subgroup of `P13` — generated by the roots
`e₂₁, e₃₁, e₃₂` — is again a discrete Heisenberg group: every element
has the normal form `x₂₁(a) · x₃₁(b) · x₃₂(c)`, and the matrix model
recovers `(a, b, c)` from the entries of the image, so the canonical
homomorphism `toSL3` is injective there.

This is the mirror of the upper-triangular pillar
(`P13UnipotentInjectivity`); together they show that the kernel of
`toSL3` meets both maximal unipotent root subgroups trivially.
-/

namespace GroupApproximation
namespace P13LowerUnipotentInjectivity

open LiteralP13Presentation P13SteinbergCalculus LiteralP13MatrixModel
open SL3ElementaryGeneration P13UnipotentInjectivity

noncomputable section

/-! ## Root powers in the matrix model -/

/-- The three lower root powers as integer transvections. -/
theorem elem2_zpow (a : ℤ) : (elem 2) ^ a = tv 1 0 (by decide) a := by
  rw [show elem 2 = tv 1 0 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

theorem elem4_zpow (a : ℤ) : (elem 4) ^ a = tv 2 0 (by decide) a := by
  rw [show elem 4 = tv 2 0 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

theorem elem5_zpow (a : ℤ) : (elem 5) ^ a = tv 2 1 (by decide) a := by
  rw [show elem 5 = tv 2 1 (by decide) 1 from Subtype.ext (by decide),
    tv_one_zpow]

/-! ## The lower-triangular subgroup -/

/-- The lower-triangular normal form `x₂₁(a) x₃₁(b) x₃₂(c)`. -/
def lower (a b c : ℤ) : P13 := x 2 a * x 4 b * x 5 c

/-! ## Injectivity through the matrix model -/

/-- The matrix image of the lower normal form. -/
theorem toSL3_lower (a b c : ℤ) :
    (toSL3 (lower a b c) : Matrix (Fin 3) (Fin 3) ℤ) =
      !![1, 0, 0; a, 1, 0; b, c, 1] := by
  show ((toSL3 (x 2 a * x 4 b * x 5 c) : SL3) :
    Matrix (Fin 3) (Fin 3) ℤ) = _
  rw [map_mul, map_mul, toSL3_x, toSL3_x, toSL3_x,
    elem2_zpow, elem4_zpow, elem5_zpow,
    Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
    tv_coe, tv_coe, tv_coe]
  ext p q
  fin_cases p <;> fin_cases q <;>
    (simp [Matrix.transvection, Matrix.mul_apply, Matrix.single,
      Matrix.one_apply, Fin.sum_univ_three]; try ring)

end

end P13LowerUnipotentInjectivity
end GroupApproximation
