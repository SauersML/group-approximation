import Mathlib.GroupTheory.HNNExtension
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.SetTheory.Cardinal.Free
import GroupApproximation.Algebra.GroupTorsionFree

/-!
# A torsion-free cyclic HNN conjugacy step

For two nonidentity elements `x` and `y` of a torsion-free group, their
infinite cyclic subgroups are canonically isomorphic by sending `x` to `y`.
The corresponding HNN extension embeds the original group and conjugates
the two selected elements.

This is the elementary one-pair step used in an internal construction of a
two-conjugacy-class envelope.  No embedding theorem is assumed here.
-/

namespace GroupApproximation.Monsters

universe u

variable {G : Type u} [Group G]

/-- The distinguished generator of the cyclic subgroup generated by `x`. -/
def zpowersGenerator (x : G) : Subgroup.zpowers x :=
  ⟨x, Subgroup.mem_zpowers x⟩

@[simp] theorem coe_zpowersGenerator (x : G) :
    (zpowersGenerator x : G) = x := rfl

/-- The distinguished generator generates the whole cyclic subgroup, now
viewed as an abstract group. -/
theorem zpowers_zpowersGenerator_eq_top (x : G) :
    Subgroup.zpowers (zpowersGenerator x) = ⊤ := by
  apply (Subgroup.eq_top_iff' _).2
  intro z
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp z.2
  apply Subgroup.mem_zpowers_iff.mpr
  exact ⟨n, Subtype.ext hn⟩

/-- A nontrivial element in a torsion-free group generates an infinite cyclic
subgroup. -/
theorem infinite_zpowers_of_ne_one (hG : IsPowerTorsionFree G)
    (x : G) (hx : x ≠ 1) :
    Infinite (Subgroup.zpowers x) := by
  exact (infinite_zpowers.mpr (hG.not_isOfFinOrder hx)).to_subtype

/-- The cyclic-subgroup isomorphism carrying `x` to `y`. -/
noncomputable def zpowersMulEquiv (hG : IsPowerTorsionFree G)
    (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) :
    Subgroup.zpowers x ≃* Subgroup.zpowers y := by
  letI : Infinite (Subgroup.zpowers x) := infinite_zpowers_of_ne_one hG x hx
  letI : Infinite (Subgroup.zpowers y) := infinite_zpowers_of_ne_one hG y hy
  exact
    (intEquivOfZPowersEqTop (zpowersGenerator x)
      (zpowers_zpowersGenerator_eq_top x)).symm.trans
      (intEquivOfZPowersEqTop (zpowersGenerator y)
        (zpowers_zpowersGenerator_eq_top y))

@[simp] theorem zpowersMulEquiv_generator
    (hG : IsPowerTorsionFree G) (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) :
    zpowersMulEquiv hG x y hx hy (zpowersGenerator x) = zpowersGenerator y := by
  simp [zpowersMulEquiv]

/-- The HNN extension identifying the cyclic subgroups generated by `x` and
`y`. -/
abbrev TorsionFreeConjugacyExtension
    (hG : IsPowerTorsionFree G)
    (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) : Type u :=
  HNNExtension G (Subgroup.zpowers x) (Subgroup.zpowers y)
    (zpowersMulEquiv hG x y hx hy)

/-- The canonical embedding into the one-pair conjugacy extension. -/
noncomputable def torsionFreeConjugacyEmbedding
    (hG : IsPowerTorsionFree G)
    (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) :
    G →* TorsionFreeConjugacyExtension hG x y hx hy :=
  HNNExtension.of

/-- Britton normal form makes the canonical base map injective. -/
theorem torsionFreeConjugacyEmbedding_injective
    (hG : IsPowerTorsionFree G)
    (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) :
    Function.Injective (torsionFreeConjugacyEmbedding hG x y hx hy) :=
  HNNExtension.of_injective (zpowersMulEquiv hG x y hx hy)

/-- In the explicit extension, the selected base elements are conjugate by
the stable letter. -/
theorem torsionFreeConjugacyEmbedding_isConj
    (hG : IsPowerTorsionFree G)
    (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) :
    IsConj
      (torsionFreeConjugacyEmbedding hG x y hx hy x)
      (torsionFreeConjugacyEmbedding hG x y hx hy y) := by
  apply isConj_iff.mpr
  refine ⟨HNNExtension.t, ?_⟩
  have h := HNNExtension.equiv_eq_conj
    (φ := zpowersMulEquiv hG x y hx hy) (zpowersGenerator x)
  rw [zpowersMulEquiv_generator] at h
  simpa [torsionFreeConjugacyEmbedding, zpowersGenerator] using h.symm

/-- Countability is preserved by the explicit HNN quotient. -/
noncomputable instance torsionFreeConjugacyExtension_countable
    [Countable G] (hG : IsPowerTorsionFree G)
    (x y : G) (hx : x ≠ 1) (hy : y ≠ 1) :
    Countable (TorsionFreeConjugacyExtension hG x y hx hy) := by
  letI : Countable (Multiplicative ℤ) :=
    Countable.of_equiv ℤ Multiplicative.ofAdd
  letI : Countable (Monoid.Coprod G (Multiplicative ℤ)) :=
    Monoid.Coprod.mk_surjective.countable
  unfold TorsionFreeConjugacyExtension HNNExtension
  exact Con.mk'_surjective.countable

end GroupApproximation.Monsters
