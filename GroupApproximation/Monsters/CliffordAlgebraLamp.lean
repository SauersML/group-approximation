import Mathlib.Data.Real.Basic
import Mathlib.LinearAlgebra.CliffordAlgebra.Basic
import Mathlib.LinearAlgebra.CliffordAlgebra.Contraction
import Mathlib.LinearAlgebra.QuadraticForm.IsometryEquiv
import Mathlib.LinearAlgebra.Finsupp.LSum
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Algebra.CharP.Invertible

/-!
# The Clifford lamp realization over an arbitrary site set

The witness side of the non-MF manuscript (`non_mf_groups_exist.tex`,
Construction 4.1) needs, over an arbitrary — typically infinite — set `X`
of sites, elements `c_x` of a real unital algebra with

* `c_x * c_x = 1`,
* `c_x * c_y = -(c_y * c_x)` for `x ≠ y`, and
* `(-1 : A) ≠ 1`,

together with an action of any permutation of `X` by algebra
automorphisms relabeling the generators.  This file realizes all of that
inside `CliffordAlgebra (euclidQ X)`, the Clifford algebra of the
pointwise-square quadratic form on the free module `X →₀ ℝ`, and then
exports a group-level interface:

* `CliffordAlgebraLamp.lamp X x` — the generator at site `x`, with
  `lamp_mul_self`, `lamp_mul_lamp_of_ne` (anticommutation), and
  `lamp_comm_word_eq_neg_one` (the sign wall);
* `CliffordAlgebraLamp.neg_one_ne_one` — the sign is nontrivial;
* `CliffordAlgebraLamp.lampGroup` — the subgroup of the unit group generated by
  the lamp involutions `lampGen` and the central sign `zGen`, with
  `lampGen_sq`, `zGen_sq`, `zGen_ne_one`, `zGen_mem_center`, and
  `commutator_lampGen : ⁅lampGen x, lampGen y⁆ = zGen` for `x ≠ y`
  (Proposition 4.3 of the manuscript consumes exactly this);
* `CliffordAlgebraLamp.permHom : Equiv.Perm X →* MulAut ↥(lampGroup X)` — site
  permutations act by group automorphisms, relabeling the generators
  (`permHom_lampGen`) and fixing the sign (`permHom_zGen`).

The further group-theoretic packaging of the witness (the semidirect
product with the acting group and the consumption of the marked word `w`)
is deliberately out of scope here and lives with the group-side
formalization.

The mathematical Clifford-sign/shift package has a close predecessor in
William Slofstra, *A group with at least subexponential hyperlinear profile*,
arXiv:1806.05267, Section 2.
-/

namespace GroupApproximation
namespace CliffordAlgebraLamp

open Module

open scoped commutatorElement

variable (X : Type*)

/-- The pointwise dot product, as a bilinear form on the free real module
on `X`: `dotForm X f g = ∑ x, f x * g x`, the sum ranging over the
(finite) support of `f`. -/
noncomputable def dotForm : (X →₀ ℝ) →ₗ[ℝ] (X →₀ ℝ) →ₗ[ℝ] ℝ :=
  Finsupp.lsum ℝ fun x =>
    LinearMap.toSpanSingleton ℝ ((X →₀ ℝ) →ₗ[ℝ] ℝ) (Finsupp.lapply x)

@[simp] theorem dotForm_single_same (x : X) (a b : ℝ) :
    dotForm X (Finsupp.single x a) (Finsupp.single x b) = a * b := by
  simp [dotForm, Finsupp.lsum_single, LinearMap.toSpanSingleton_apply]

theorem dotForm_single_of_ne {x y : X} (h : x ≠ y) (a b : ℝ) :
    dotForm X (Finsupp.single x a) (Finsupp.single y b) = 0 := by
  have hy : (Finsupp.single y b) x = 0 :=
    Finsupp.single_eq_of_ne h
  simp [dotForm, Finsupp.lsum_single, LinearMap.toSpanSingleton_apply, hy]

/-- The Euclidean quadratic form on the free real module on `X`: the
standard basis is orthonormal.  Its Clifford algebra carries the lamp
generators. -/
noncomputable def euclidQ : QuadraticForm ℝ (X →₀ ℝ) :=
  LinearMap.BilinMap.toQuadraticMap (dotForm X)

@[simp] theorem euclidQ_single (x : X) (a : ℝ) :
    euclidQ X (Finsupp.single x a) = a * a := by
  simp [euclidQ, LinearMap.BilinMap.toQuadraticMap_apply]

/-- Distinct basis vectors are orthogonal for `euclidQ`. -/
theorem isOrtho_single {x y : X} (h : x ≠ y) :
    (euclidQ X).IsOrtho (Finsupp.single x (1 : ℝ)) (Finsupp.single y 1) := by
  rw [QuadraticMap.isOrtho_def]
  simp [euclidQ, LinearMap.BilinMap.toQuadraticMap_apply, map_add,
    LinearMap.add_apply, dotForm_single_of_ne X h,
    dotForm_single_of_ne X (Ne.symm h)]

/-- The lamp generator at site `x`: the image of the `x`-th basis vector
in the Clifford algebra of `euclidQ X`. -/
noncomputable def lamp (x : X) : CliffordAlgebra (euclidQ X) :=
  CliffordAlgebra.ι (euclidQ X) (Finsupp.single x 1)

/-- Each lamp generator is an involution. -/
@[simp] theorem lamp_mul_self (x : X) : lamp X x * lamp X x = 1 := by
  simp only [lamp, CliffordAlgebra.ι_sq_scalar, euclidQ_single, one_mul,
    map_one]

/-- Lamp generators at distinct sites anticommute. -/
theorem lamp_mul_lamp_of_ne {x y : X} (h : x ≠ y) :
    lamp X x * lamp X y = -(lamp X y * lamp X x) := by
  have h0 := CliffordAlgebra.ι_mul_ι_add_swap_of_isOrtho (isOrtho_single X h)
  simp only [lamp]
  exact eq_neg_of_add_eq_zero_left h0

/-- **The sign wall**: the group commutator word of two lamps at distinct
sites is the central sign `-1`.  Since each lamp is its own inverse, the
word `c_x c_y c_x c_y` is literally `[c_x, c_y] = c_x c_y c_x⁻¹ c_y⁻¹`;
this is what the marked word `w` of the non-MF manuscript evaluates to
under the witness homomorphism (Proposition 4.3 there). -/
theorem lamp_comm_word_eq_neg_one {x y : X} (h : x ≠ y) :
    lamp X x * lamp X y * lamp X x * lamp X y = -1 := by
  rw [lamp_mul_lamp_of_ne X h, neg_mul, neg_mul,
    mul_assoc (lamp X y) (lamp X x) (lamp X x), lamp_mul_self, mul_one,
    lamp_mul_self]

/-- The central sign is nontrivial: `-1 ≠ 1` in the Clifford algebra.
The proof uses only that the algebra is a nontrivial real vector space,
so that `1 + 1 = 0` would force `1 = 0`. -/
theorem neg_one_ne_one : (-1 : CliffordAlgebra (euclidQ X)) ≠ 1 := by
  intro h
  have h0 : (1 : CliffordAlgebra (euclidQ X)) + 1 = 0 := by
    nth_rw 2 [← h]
    exact add_neg_cancel 1
  have h1 : (1 : CliffordAlgebra (euclidQ X)) = 0 := by
    have hs : ((2 : ℝ)⁻¹ * 2) • (1 : CliffordAlgebra (euclidQ X))
        = (2 : ℝ)⁻¹ • ((1 : CliffordAlgebra (euclidQ X))
          + (1 : CliffordAlgebra (euclidQ X))) := by
      rw [mul_smul]
      congr 1
      rw [two_smul]
    rw [h0, smul_zero, inv_mul_cancel₀ (by norm_num : (2 : ℝ) ≠ 0),
      one_smul] at hs
    exact hs
  exact one_ne_zero h1

/-- Relabeling the sites by a permutation, as a linear equivalence of the
free module.  Pinning the scalar and coefficient types here keeps every
later use of `Finsupp.domLCongr` fully determined. -/
noncomputable def relabel (σ : Equiv.Perm X) : (X →₀ ℝ) ≃ₗ[ℝ] (X →₀ ℝ) :=
  Finsupp.domLCongr σ

@[simp] theorem relabel_single (σ : Equiv.Perm X) (x : X) (a : ℝ) :
    relabel X σ (Finsupp.single x a) = Finsupp.single (σ x) a :=
  Finsupp.domLCongr_single σ x a

/-- Relabeling the sites by a permutation preserves the dot product. -/
theorem dotForm_relabel (σ : Equiv.Perm X) (f g : X →₀ ℝ) :
    dotForm X (relabel X σ f) (relabel X σ g)
      = dotForm X f g := by
  set L : (X →₀ ℝ) →ₗ[ℝ] (X →₀ ℝ) := (relabel X σ).toLinearMap with hL
  have hB : (dotForm X).compl₁₂ L L = dotForm X := by
    refine Finsupp.lhom_ext' fun x => LinearMap.ext_ring
      (Finsupp.lhom_ext' fun y => LinearMap.ext_ring ?_)
    by_cases hxy : x = y
    · subst hxy
      simp [hL, LinearMap.compl₁₂_apply, LinearMap.comp_apply,
        Finsupp.lsingle_apply, relabel_single]
    · simp [hL, LinearMap.compl₁₂_apply, LinearMap.comp_apply,
        Finsupp.lsingle_apply, relabel_single, dotForm_single_of_ne X hxy,
        dotForm_single_of_ne X fun hc => hxy (σ.injective hc)]
  have happ := LinearMap.congr_fun (LinearMap.congr_fun hB f) g
  simpa [hL, LinearMap.compl₁₂_apply, LinearEquiv.coe_toLinearMap]
    using happ

/-- Relabeling the sites by a permutation, as an isometry of the
Euclidean quadratic form. -/
noncomputable def permIsometry (σ : Equiv.Perm X) :
    (euclidQ X).IsometryEquiv (euclidQ X) where
  toLinearEquiv := relabel X σ
  map_app' := fun f => by
    have h := dotForm_relabel X σ f f
    show euclidQ X (relabel X σ f) = euclidQ X f
    simp only [euclidQ, LinearMap.BilinMap.toQuadraticMap_apply]
    exact h

/-- A permutation of the sites acts on the Clifford lamp algebra as an
algebra automorphism.  Being an algebra automorphism, it fixes `1` and
`-1`; by `permAut_lamp` it relabels the lamp generators. -/
noncomputable def permAut (σ : Equiv.Perm X) :
    CliffordAlgebra (euclidQ X) ≃ₐ[ℝ] CliffordAlgebra (euclidQ X) :=
  CliffordAlgebra.equivOfIsometry (permIsometry X σ)

/-- The permutation automorphism on the image of the base module. -/
@[simp] theorem permAut_ι (σ : Equiv.Perm X) (m : X →₀ ℝ) :
    permAut X σ (CliffordAlgebra.ι (euclidQ X) m)
      = CliffordAlgebra.ι (euclidQ X) (relabel X σ m) :=
  CliffordAlgebra.map_apply_ι (permIsometry X σ).toIsometry m

/-- The permutation automorphism relabels the lamp generators. -/
@[simp] theorem permAut_lamp (σ : Equiv.Perm X) (x : X) :
    permAut X σ (lamp X x) = lamp X (σ x) := by
  simp only [lamp, permAut_ι, relabel_single]

/-! ## The lamp group: the exported group-level interface

The consumers downstream (the semidirect-product packaging of the
witness) work with a genuine group: the subgroup of the unit group of the
Clifford algebra generated by the lamp involutions and the central sign.
Everything below is a unit- or subgroup-level restatement of the algebra
lemmas above.
-/

/-- The lamp generator at `x`, as a unit of the Clifford algebra: it is
its own inverse. -/
noncomputable def lampUnit (x : X) : (CliffordAlgebra (euclidQ X))ˣ :=
  ⟨lamp X x, lamp X x, lamp_mul_self X x, lamp_mul_self X x⟩

@[simp] theorem lampUnit_val (x : X) :
    (lampUnit X x : CliffordAlgebra (euclidQ X)) = lamp X x := rfl

/-- The central sign `-1`, as a unit of the Clifford algebra. -/
noncomputable def zUnit : (CliffordAlgebra (euclidQ X))ˣ :=
  ⟨-1, -1, by rw [neg_mul_neg, one_mul], by rw [neg_mul_neg, one_mul]⟩

@[simp] theorem zUnit_val :
    (zUnit X : CliffordAlgebra (euclidQ X)) = -1 := rfl

/-- Each lamp unit is its own inverse. -/
theorem lampUnit_inv (x : X) : (lampUnit X x)⁻¹ = lampUnit X x :=
  Units.ext rfl

/-- The lamp units are involutions. -/
theorem lampUnit_sq (x : X) : lampUnit X x ^ 2 = 1 := by
  rw [pow_two]
  exact Units.ext (lamp_mul_self X x)

/-- The sign unit is an involution. -/
theorem zUnit_sq : zUnit X ^ 2 = 1 := by
  rw [pow_two]
  exact Units.ext (by
    rw [Units.val_mul, zUnit_val, neg_mul_neg, one_mul, Units.val_one])

/-- The sign unit is nontrivial. -/
theorem zUnit_ne_one : zUnit X ≠ 1 :=
  fun h => neg_one_ne_one X (congrArg Units.val h)

/-- The sign unit commutes with every unit of the Clifford algebra; in
particular it is central in every subgroup containing it. -/
theorem zUnit_commute (g : (CliffordAlgebra (euclidQ X))ˣ) :
    Commute (zUnit X) g := by
  show zUnit X * g = g * zUnit X
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, zUnit_val, neg_one_mul, mul_neg_one]

/-- **The sign wall, in group form**: the group commutator of two lamp
units at distinct sites is the central sign. -/
theorem commutator_lampUnit {x y : X} (h : x ≠ y) :
    ⁅lampUnit X x, lampUnit X y⁆ = zUnit X := by
  rw [commutatorElement_def, lampUnit_inv, lampUnit_inv]
  exact Units.ext (lamp_comm_word_eq_neg_one X h)

/-- The Clifford lamp group: the subgroup of the unit group generated by
the lamp involutions and the central sign. -/
noncomputable def lampGroup : Subgroup (CliffordAlgebra (euclidQ X))ˣ :=
  Subgroup.closure (Set.range (lampUnit X) ∪ {zUnit X})

theorem lampUnit_mem (x : X) : lampUnit X x ∈ lampGroup X :=
  Subgroup.subset_closure (Or.inl ⟨x, rfl⟩)

theorem zUnit_mem : zUnit X ∈ lampGroup X :=
  Subgroup.subset_closure (Or.inr rfl)

/-- The lamp generator, as an element of the lamp group. -/
noncomputable def lampGen (x : X) : lampGroup X :=
  ⟨lampUnit X x, lampUnit_mem X x⟩

/-- The central sign, as an element of the lamp group. -/
noncomputable def zGen : lampGroup X :=
  ⟨zUnit X, zUnit_mem X⟩

/-- The lamp generators of the lamp group are involutions. -/
theorem lampGen_mul_self (x : X) : lampGen X x * lampGen X x = 1 := by
  have h := lampUnit_sq X x
  rw [pow_two] at h
  exact Subtype.ext h

/-- The lamp generators of the lamp group square to one. -/
theorem lampGen_sq (x : X) : lampGen X x ^ 2 = 1 := by
  rw [pow_two]
  exact lampGen_mul_self X x

/-- The sign element of the lamp group squares to one. -/
theorem zGen_sq : zGen X ^ 2 = 1 := by
  have h := zUnit_sq X
  rw [pow_two] at h
  rw [pow_two]
  exact Subtype.ext h

/-- The sign element of the lamp group is nontrivial. -/
theorem zGen_ne_one : zGen X ≠ 1 :=
  fun h => zUnit_ne_one X (congrArg Subtype.val h)

/-- The sign element is central in the lamp group. -/
theorem zGen_mem_center : zGen X ∈ Subgroup.center ↥(lampGroup X) := by
  rw [Subgroup.mem_center_iff]
  intro g
  exact Subtype.ext ((zUnit_commute X g.1).symm.eq)

/-- **The sign wall in the lamp group**: the group commutator of two lamp
generators at distinct sites is the central sign.  This is what the
marked word `w` of the non-MF manuscript evaluates to under the witness
homomorphism (Proposition 4.3 there). -/
theorem commutator_lampGen {x y : X} (h : x ≠ y) :
    ⁅lampGen X x, lampGen X y⁆ = zGen X := by
  have h' := commutator_lampUnit X h
  rw [commutatorElement_def] at h' ⊢
  exact Subtype.ext h'

/-- The group-level Clifford-lamp package used by the manuscript's
`con:clifford`: the distinguished sign is a nontrivial central involution,
each site generator is an involution, and distinct site generators have
commutator equal to that sign. -/
theorem cliffordLamp_group_package :
    zGen X ^ 2 = 1 ∧
      zGen X ≠ 1 ∧
      zGen X ∈ Subgroup.center ↥(lampGroup X) ∧
      (∀ x : X, lampGen X x ^ 2 = 1) ∧
      (∀ x y : X, x ≠ y → ⁅lampGen X x, lampGen X y⁆ = zGen X) := by
  exact ⟨zGen_sq X, zGen_ne_one X, zGen_mem_center X,
    lampGen_sq X, fun _ _ h ↦ commutator_lampGen X h⟩

/-! ## The permutation action on the lamp group -/

/-- Relabelings compose, pointwise on the base module. -/
theorem relabel_comp_point (σ τ : Equiv.Perm X) (m : X →₀ ℝ) :
    relabel X σ (relabel X τ m) = relabel X (σ * τ) m := by
  have hlin : ((relabel X σ).toLinearMap.comp (relabel X τ).toLinearMap)
      = (relabel X (σ * τ)).toLinearMap := by
    refine Finsupp.lhom_ext' fun x => LinearMap.ext_ring ?_
    simp [LinearMap.comp_apply, Finsupp.lsingle_apply,
      relabel_single, Equiv.Perm.mul_apply]
  have h := LinearMap.congr_fun hlin m
  simpa [LinearMap.comp_apply, LinearEquiv.coe_toLinearMap] using h

/-- The identity relabeling is the identity, pointwise on the base
module. -/
theorem relabel_one_point (m : X →₀ ℝ) :
    relabel X (1 : Equiv.Perm X) m = m := by
  have hlin : (relabel X (1 : Equiv.Perm X)).toLinearMap = LinearMap.id := by
    refine Finsupp.lhom_ext' fun x => LinearMap.ext_ring ?_
    simp [LinearMap.comp_apply, Finsupp.lsingle_apply,
      relabel_single]
  have h := LinearMap.congr_fun hlin m
  simpa [LinearEquiv.coe_toLinearMap] using h

/-- Composing site relabelings composes the Clifford automorphisms. -/
theorem permAut_comp_apply (σ τ : Equiv.Perm X)
    (a : CliffordAlgebra (euclidQ X)) :
    permAut X σ (permAut X τ a) = permAut X (σ * τ) a := by
  have h : ((permAut X σ).toAlgHom.comp (permAut X τ).toAlgHom)
      = (permAut X (σ * τ)).toAlgHom := by
    apply CliffordAlgebra.hom_ext
    apply LinearMap.ext
    intro m
    show permAut X σ (permAut X τ (CliffordAlgebra.ι (euclidQ X) m))
        = permAut X (σ * τ) (CliffordAlgebra.ι (euclidQ X) m)
    rw [permAut_ι, permAut_ι, permAut_ι, relabel_comp_point]
  simpa using AlgHom.congr_fun h a

/-- The identity relabeling acts as the identity automorphism. -/
theorem permAut_one_apply (a : CliffordAlgebra (euclidQ X)) :
    permAut X (1 : Equiv.Perm X) a = a := by
  have h : (permAut X (1 : Equiv.Perm X)).toAlgHom
      = AlgHom.id ℝ (CliffordAlgebra (euclidQ X)) := by
    apply CliffordAlgebra.hom_ext
    apply LinearMap.ext
    intro m
    show permAut X (1 : Equiv.Perm X) (CliffordAlgebra.ι (euclidQ X) m)
        = CliffordAlgebra.ι (euclidQ X) m
    rw [permAut_ι, relabel_one_point]
  simpa using AlgHom.congr_fun h a

/-- The permutation action on units of the Clifford algebra. -/
noncomputable def unitsMap (σ : Equiv.Perm X) :
    (CliffordAlgebra (euclidQ X))ˣ →* (CliffordAlgebra (euclidQ X))ˣ :=
  Units.map (permAut X σ).toAlgHom.toRingHom.toMonoidHom

@[simp] theorem unitsMap_lampUnit (σ : Equiv.Perm X) (x : X) :
    unitsMap X σ (lampUnit X x) = lampUnit X (σ x) := by
  apply Units.ext
  simp [unitsMap]

@[simp] theorem unitsMap_zUnit (σ : Equiv.Perm X) :
    unitsMap X σ (zUnit X) = zUnit X := by
  apply Units.ext
  simp [unitsMap]

/-- The permutation action preserves the lamp group. -/
theorem unitsMap_mem (σ : Equiv.Perm X) {u : (CliffordAlgebra (euclidQ X))ˣ}
    (hu : u ∈ lampGroup X) : unitsMap X σ u ∈ lampGroup X := by
  induction hu using Subgroup.closure_induction with
  | mem v hv =>
      rcases hv with ⟨x, rfl⟩ | rfl
      · rw [unitsMap_lampUnit]
        exact lampUnit_mem X (σ x)
      · rw [unitsMap_zUnit]
        exact zUnit_mem X
  | one =>
      rw [map_one]
      exact one_mem _
  | mul a b _ _ iha ihb =>
      rw [map_mul]
      exact mul_mem iha ihb
  | inv a _ iha =>
      rw [map_inv]
      exact inv_mem iha

theorem unitsMap_comp_apply (σ τ : Equiv.Perm X)
    (u : (CliffordAlgebra (euclidQ X))ˣ) :
    unitsMap X σ (unitsMap X τ u) = unitsMap X (σ * τ) u := by
  apply Units.ext
  have h := permAut_comp_apply X σ τ (u : CliffordAlgebra (euclidQ X))
  simpa [unitsMap] using h

theorem unitsMap_one_apply (u : (CliffordAlgebra (euclidQ X))ˣ) :
    unitsMap X (1 : Equiv.Perm X) u = u := by
  apply Units.ext
  have h := permAut_one_apply X (u : CliffordAlgebra (euclidQ X))
  simpa [unitsMap] using h

/-- **Site permutations act on the lamp group by automorphisms**,
relabeling the lamp generators (`permHom_lampGen`) and fixing the sign
(`permHom_zGen`). -/
noncomputable def permHom : Equiv.Perm X →* MulAut ↥(lampGroup X) where
  toFun σ :=
    { toFun := fun g => ⟨unitsMap X σ g.1, unitsMap_mem X σ g.2⟩
      invFun := fun g => ⟨unitsMap X σ⁻¹ g.1, unitsMap_mem X σ⁻¹ g.2⟩
      left_inv := fun g => Subtype.ext (by
        show unitsMap X σ⁻¹ (unitsMap X σ g.1) = g.1
        rw [unitsMap_comp_apply, inv_mul_cancel, unitsMap_one_apply])
      right_inv := fun g => Subtype.ext (by
        show unitsMap X σ (unitsMap X σ⁻¹ g.1) = g.1
        rw [unitsMap_comp_apply, mul_inv_cancel, unitsMap_one_apply])
      map_mul' := fun g h => Subtype.ext (map_mul (unitsMap X σ) g.1 h.1) }
  map_one' := by
    ext g
    exact congrArg Units.val (unitsMap_one_apply X g.1)
  map_mul' := fun σ τ => by
    ext g
    exact congrArg Units.val (unitsMap_comp_apply X σ τ g.1).symm

@[simp] theorem permHom_lampGen (σ : Equiv.Perm X) (x : X) :
    permHom X σ (lampGen X x) = lampGen X (σ x) :=
  Subtype.ext (unitsMap_lampUnit X σ x)

@[simp] theorem permHom_zGen (σ : Equiv.Perm X) :
    permHom X σ (zGen X) = zGen X :=
  Subtype.ext (unitsMap_zUnit X σ)

/-- Every permutation of the site set acts by a lamp-group automorphism,
relabels the site generators, and fixes the central sign. -/
theorem cliffordLamp_permutation_package :
    (∀ (σ : Equiv.Perm X) (x : X),
      permHom X σ (lampGen X x) = lampGen X (σ x)) ∧
      (∀ σ : Equiv.Perm X, permHom X σ (zGen X) = zGen X) := by
  exact ⟨permHom_lampGen X, permHom_zGen X⟩

end CliffordAlgebraLamp
end GroupApproximation
