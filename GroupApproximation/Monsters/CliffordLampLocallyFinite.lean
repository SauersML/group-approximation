import GroupApproximation.Monsters.CliffordAlgebraLamp
import GroupApproximation.Sofic.CentralInvolutionFinite

/-!
# The Clifford lamp group is locally finite

`CliffordAlgebraLamp.lampGroup X` is generated by the lamp units together with
the central sign `zUnit X`.  Each lamp unit is an involution, and two lamp
units at distinct sites commute up to that one sign
(`commutator_lampUnit`).  That is exactly the hypothesis pattern of
`isLocallyFiniteGroup_closure_of_central_involution`, so the lamp group is
locally finite -- for any site set whatsoever, finite or not.

Two consequences follow immediately.  On a finite site set the lamp group is
finite, which is the statement that a finite Clifford lamp configuration space
is a finite group.  On an arbitrary site set the lamp group is LEF and
weak-MF, and operator-MF once it is countable.

The proof never inspects the Clifford algebra: it consumes only the four group
relations `zUnit ^ 2 = 1`, `zUnit` central, `lampUnit x ^ 2 = 1`, and
`⁅lampUnit x, lampUnit y⁆ = zUnit` for `x ≠ y`.
-/

namespace GroupApproximation
namespace CliffordAlgebraLamp

open scoped commutatorElement

variable (X : Type*)

/-- The lamp group with its central sign displayed as the adjoined
generator. -/
theorem lampGroup_eq_closure_insert :
    lampGroup X =
      Subgroup.closure (insert (zUnit X) (Set.range (lampUnit X))) := by
  rw [lampGroup, Set.union_comm, Set.singleton_union]

/-- The commutator of two lamp units always lies in the cyclic group generated
by the sign: it is `1` at equal sites and the sign at distinct sites. -/
theorem lampUnit_commutator_mem_zpowers (x y : X) :
    lampUnit X x * lampUnit X y * (lampUnit X x)⁻¹ * (lampUnit X y)⁻¹ ∈
      Subgroup.zpowers (zUnit X) := by
  by_cases hxy : x = y
  · subst hxy
    have h : lampUnit X x * lampUnit X x * (lampUnit X x)⁻¹ *
        (lampUnit X x)⁻¹ = 1 := by group
    rw [h]
    exact Subgroup.one_mem _
  · have h := commutator_lampUnit X hxy
    rw [commutatorElement_def] at h
    rw [h]
    exact Subgroup.mem_zpowers _

/-- **The Clifford lamp group is locally finite.** -/
theorem isLocallyFiniteGroup_lampGroup :
    IsLocallyFiniteGroup (lampGroup X) := by
  rw [lampGroup_eq_closure_insert]
  refine isLocallyFiniteGroup_closure_of_central_involution
    (zUnit_sq X) (fun g ↦ zUnit_commute X g) ?_ ?_
  · rintro _ ⟨x, rfl⟩
    exact lampUnit_sq X x
  · rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
    exact lampUnit_commutator_mem_zpowers X x y

/-- On a finite site set the lamp group is a finite group. -/
theorem finite_lampGroup [Finite X] : Finite (lampGroup X) := by
  rw [lampGroup_eq_closure_insert]
  refine finite_closure_of_central_involution (zUnit_sq X)
    (fun g ↦ zUnit_commute X g) (Set.finite_range _) ?_ ?_
  · rintro _ ⟨x, rfl⟩
    exact lampUnit_sq X x
  · rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
    exact lampUnit_commutator_mem_zpowers X x y

/-- The lamp group is locally embeddable into finite groups. -/
theorem isLEF_lampGroup : IsLEF (lampGroup X) :=
  isLEF_of_locallyFinite (isLocallyFiniteGroup_lampGroup X)

/-- The lamp group is weak-MF, with exact finite models. -/
theorem isWeakMF_lampGroup : IsWeakMF (lampGroup X) :=
  isWeakMF_of_locallyFinite (isLocallyFiniteGroup_lampGroup X)

/-- A countable lamp group is operator-MF. -/
theorem isOperatorMF_lampGroup [Countable (lampGroup X)] :
    IsOperatorMF (lampGroup X) :=
  isOperatorMF_of_locallyFinite (isLocallyFiniteGroup_lampGroup X)

/-! ## Positive controls -/

example : IsLocallyFiniteGroup (lampGroup (Fin 3)) :=
  isLocallyFiniteGroup_lampGroup _

example : Finite (lampGroup (Fin 3)) := finite_lampGroup _

example : IsLEF (lampGroup ℕ) := isLEF_lampGroup _

/-- The sign is a genuine nontrivial element, so these are not statements
about the trivial group. -/
example : zGen (Fin 3) ≠ 1 := zGen_ne_one _

end CliffordAlgebraLamp
end GroupApproximation
