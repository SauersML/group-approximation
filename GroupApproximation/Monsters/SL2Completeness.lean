import GroupApproximation.Monsters.SL2PingPong
import GroupApproximation.Monsters.SL2WeylRelations

/-!
# Completeness of the rank-two braid presentation

The canonical homomorphism `toSL2 : SL2P →* SL₂(ℤ)` from
`⟨a, b ∣ aba = bab, (aba)⁴⟩` is injective — with surjectivity
(`SL2BraidPresentation`) this identifies the presented group with
`SL₂(ℤ)`.

The kernel chase composes the pieces already on the board.  The
assignment `a ↦ v⁻¹u`, `b ↦ u⁻¹v²` kills both relators in the free
product `ℤ/2 ∗ ℤ/3` and induces `α : SL2P →* ℤ/2 ∗ ℤ/3`; through the
ping-pong embedding `ψ` this agrees with the boundary representation of
the matrix image, and through the cyclic homomorphisms onto `s̄, t̄` it
agrees with the projection to `SL2P / ⟨s²⟩` — the Tietze cancellations
`t⁻¹s = a`, `s⁻¹t² = b` are exactly the generator checks.  An element
of the kernel of `toSL2` therefore dies in `ℤ/2 ∗ ℤ/3`, hence in
`SL2P / ⟨s²⟩`, so it is a power of the central element `s²`; its matrix
image is the same power of `-1`, which forces the power to be even, and
even powers die by `s⁴ = 1`.
-/

namespace GroupApproximation
namespace SL2Completeness

open SL2BraidPresentation SL2WeylRelations SL2PingPong
open MoebiusIrrationalAction FiniteCyclicHom PresentedGroupRelatorReplay

noncomputable section

/-! ## The comparison map into the free product -/

/-- The generator of the `ℤ/2` factor. -/
def ugen : fam 0 := Multiplicative.ofAdd ((1 : ℤ) : ZMod 2)

/-- The generator of the `ℤ/3` factor. -/
def vgen : fam 1 := Multiplicative.ofAdd ((1 : ℤ) : ZMod 3)

theorem of_u_sq :
    Monoid.CoprodI.of ugen * Monoid.CoprodI.of ugen = 1 := by
  rw [← map_mul, show ugen * ugen = 1 from by decide, map_one]

theorem of_v_cube :
    Monoid.CoprodI.of vgen * Monoid.CoprodI.of vgen *
      Monoid.CoprodI.of vgen = 1 := by
  rw [← map_mul, ← map_mul,
    show vgen * vgen * vgen = 1 from by decide, map_one]

/-- The generator assignment `a ↦ v⁻¹u`, `b ↦ u⁻¹v²`. -/
def alphaGen : Fin 2 → Monoid.CoprodI fam
  | 0 => (Monoid.CoprodI.of vgen)⁻¹ * Monoid.CoprodI.of ugen
  | 1 => (Monoid.CoprodI.of ugen)⁻¹ *
      (Monoid.CoprodI.of vgen * Monoid.CoprodI.of vgen)

private theorem lift_relator_zero :
    FreeGroup.lift alphaGen (sl2Relator 0) = 1 := by
  calc FreeGroup.lift alphaGen (sl2Relator 0)
      = Monoid.CoprodI.of ugen *
        (Monoid.CoprodI.of vgen * Monoid.CoprodI.of vgen *
          Monoid.CoprodI.of vgen)⁻¹ * Monoid.CoprodI.of ugen := by
        simp only [sl2Relator, sl2RelatorLetters, word, FreeGroup.lift_mk,
          List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
          cond_true, cond_false, alphaGen]
        group
    _ = 1 := by rw [of_v_cube, inv_one, mul_one, of_u_sq]

private theorem lift_relator_one :
    FreeGroup.lift alphaGen (sl2Relator 1) = 1 := by
  calc FreeGroup.lift alphaGen (sl2Relator 1)
      = (Monoid.CoprodI.of ugen * Monoid.CoprodI.of ugen) *
        (Monoid.CoprodI.of ugen * Monoid.CoprodI.of ugen) := by
        simp only [sl2Relator, sl2RelatorLetters, word, FreeGroup.lift_mk,
          List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
          cond_true, alphaGen]
        group
    _ = 1 := by rw [of_u_sq, one_mul]

theorem lift_alphaGen_eq_one_of_mem {r : FreeGroup SL2BraidGenerator}
    (hr : r ∈ (sl2Relators : Set (FreeGroup SL2BraidGenerator))) :
    FreeGroup.lift alphaGen r = 1 := by
  obtain ⟨i, rfl⟩ := (mem_sl2Relators_iff r).mp hr
  fin_cases i
  · exact lift_relator_zero
  · exact lift_relator_one

/-- The comparison homomorphism into the free product. -/
noncomputable def alpha : SL2P →* Monoid.CoprodI fam :=
  PresentedGroup.toGroup (f := alphaGen) fun _ hr =>
    lift_alphaGen_eq_one_of_mem hr

@[simp] theorem alpha_of (i : SL2BraidGenerator) :
    alpha (PresentedGroup.of i) = alphaGen i :=
  PresentedGroup.toGroup.of _

/-! ## The central quotient -/

/-- The subgroup generated by the central element `s²`. -/
def weylSq : Subgroup SL2P := Subgroup.zpowers (s * s)

instance weylSq_normal : weylSq.Normal := by
  constructor
  intro n hn g
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hn
  have hconj : g * (s * s) ^ k * g⁻¹ = (s * s) ^ k := by
    calc g * (s * s) ^ k * g⁻¹
        = (s * s) ^ k * g * g⁻¹ := by
          rw [← ((s_sq_commute g).zpow_left k).eq]
      _ = (s * s) ^ k := by group
  rw [← hk, hconj]
  exact Subgroup.zpow_mem_zpowers _ _

/-- The quotient by the central `⟨s²⟩`. -/
abbrev Q : Type := SL2P ⧸ weylSq

/-- The projection to the central quotient. -/
def piQ : SL2P →* Q := QuotientGroup.mk' weylSq

theorem piQ_s_sq : piQ (s * s) = 1 := by
  show QuotientGroup.mk' weylSq (s * s) = 1
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact Subgroup.mem_zpowers _

theorem piQ_s_pow_two : piQ s ^ 2 = 1 := by
  rw [pow_two, ← map_mul, piQ_s_sq]

theorem piQ_t_pow_three : piQ t ^ 3 = 1 := by
  rw [pow_succ, pow_two, ← map_mul, ← map_mul, t_cubed, piQ_s_sq]

/-- Retraction of the free product onto the central quotient. -/
noncomputable def gammaHom : ∀ i : Fin 2, fam i →* Q := fun i =>
  match i with
  | 0 => cyclicHom 2 (piQ s) piQ_s_pow_two
  | 1 => cyclicHom 3 (piQ t) piQ_t_pow_three

noncomputable def gamma : Monoid.CoprodI fam →* Q :=
  Monoid.CoprodI.lift gammaHom

/-! ## The two commuting squares -/

/-- Through the cyclic retractions, `α` covers the central quotient:
the Tietze cancellations are the generator checks. -/
theorem gamma_comp_alpha : gamma.comp alpha = piQ := by
  apply PresentedGroup.ext
  intro i
  match i with
  | 0 =>
      show gamma (alpha (PresentedGroup.of 0)) = piQ (PresentedGroup.of 0)
      rw [alpha_of]
      show gamma ((Monoid.CoprodI.of vgen)⁻¹ * Monoid.CoprodI.of ugen) = _
      rw [map_mul, map_inv]
      simp only [gamma, Monoid.CoprodI.lift_of]
      rw [show gammaHom 1 vgen = piQ t from
          cyclicHom_one_val 3 (piQ t) piQ_t_pow_three,
        show gammaHom 0 ugen = piQ s from
          cyclicHom_one_val 2 (piQ s) piQ_s_pow_two]
      rw [← map_inv, ← map_mul, t_inv_mul_s]
  | 1 =>
      show gamma (alpha (PresentedGroup.of 1)) = piQ (PresentedGroup.of 1)
      rw [alpha_of]
      show gamma ((Monoid.CoprodI.of ugen)⁻¹ *
        (Monoid.CoprodI.of vgen * Monoid.CoprodI.of vgen)) = _
      rw [map_mul, map_inv, map_mul]
      simp only [gamma, Monoid.CoprodI.lift_of]
      rw [show gammaHom 0 ugen = piQ s from
          cyclicHom_one_val 2 (piQ s) piQ_s_pow_two,
        show gammaHom 1 vgen = piQ t from
          cyclicHom_one_val 3 (piQ t) piQ_t_pow_three]
      rw [← map_inv, ← map_mul, ← map_mul, s_inv_mul_t_sq]

/-- Through the ping-pong embedding, `α` covers the boundary
representation of the matrix image. -/
theorem psi_comp_alpha : psi.comp alpha = rep.comp toSL2 := by
  apply PresentedGroup.ext
  intro i
  match i with
  | 0 =>
      show psi (alpha (PresentedGroup.of 0)) = rep (toSL2 (PresentedGroup.of 0))
      rw [alpha_of, toSL2_of]
      show psi ((Monoid.CoprodI.of vgen)⁻¹ * Monoid.CoprodI.of ugen) =
        rep Amat
      rw [map_mul, map_inv]
      simp only [psi, Monoid.CoprodI.lift_of]
      rw [show pingHom 1 vgen = rhoPerm from
          cyclicHom_one_val 3 rhoPerm rhoPerm_cube,
        show pingHom 0 ugen = sigmaPerm from
          cyclicHom_one_val 2 sigmaPerm sigmaPerm_sq]
      have hmat : Rmat⁻¹ * Smat = Amat := by
        show (Amat * Bmat)⁻¹ * (Amat * Bmat * Amat) = Amat
        group
      calc rhoPerm⁻¹ * sigmaPerm
          = (rep Rmat)⁻¹ * rep Smat := rfl
        _ = rep (Rmat⁻¹ * Smat) := by rw [map_mul, map_inv]
        _ = rep Amat := by rw [hmat]
  | 1 =>
      show psi (alpha (PresentedGroup.of 1)) = rep (toSL2 (PresentedGroup.of 1))
      rw [alpha_of, toSL2_of]
      show psi ((Monoid.CoprodI.of ugen)⁻¹ *
        (Monoid.CoprodI.of vgen * Monoid.CoprodI.of vgen)) = rep Bmat
      rw [map_mul, map_inv, map_mul]
      simp only [psi, Monoid.CoprodI.lift_of]
      rw [show pingHom 0 ugen = sigmaPerm from
          cyclicHom_one_val 2 sigmaPerm sigmaPerm_sq,
        show pingHom 1 vgen = rhoPerm from
          cyclicHom_one_val 3 rhoPerm rhoPerm_cube]
      have hmat : Smat⁻¹ * (Rmat * Rmat) = Bmat := by
        show (Amat * Bmat * Amat)⁻¹ * (Amat * Bmat * (Amat * Bmat)) = Bmat
        group
      calc sigmaPerm⁻¹ * (rhoPerm * rhoPerm)
          = (rep Smat)⁻¹ * (rep Rmat * rep Rmat) := rfl
        _ = rep (Smat⁻¹ * (Rmat * Rmat)) := by
            rw [map_mul, map_mul, map_inv]
        _ = rep Bmat := by rw [hmat]

/-! ## The kernel chase -/

theorem toSL2_s : toSL2 s = Smat := by
  show toSL2 (ga * gb * ga) = Smat
  rw [map_mul, map_mul, toSL2_of, toSL2_of]
  rfl

theorem negOne_sq : negOne * negOne = 1 := by
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_mul]
  decide

theorem negOne_ne_one : negOne ≠ 1 := by decide

theorem s_sq_sq : (s * s) * (s * s) = 1 := by
  calc (s * s) * (s * s) = s * s * s * s := by group
    _ = 1 := s_pow_four

/-- **Completeness, injectivity half.**  The canonical map from the
rank-two braid presentation to `SL₂(ℤ)` has trivial kernel. -/
theorem toSL2_injective : Function.Injective toSL2 := by
  apply (injective_iff_map_eq_one toSL2).mpr
  intro g hg
  have h1 : psi (alpha g) = 1 := by
    have hsq := congrArg (fun φ : SL2P →* Equiv.Perm Irr => φ g)
      psi_comp_alpha
    simp only [MonoidHom.comp_apply] at hsq
    rw [hsq, hg, map_one]
  have h2 : alpha g = 1 := psi_injective (by rw [h1, map_one])
  have h3 : piQ g = 1 := by
    have hsq := congrArg (fun φ : SL2P →* Q => φ g) gamma_comp_alpha
    simp only [MonoidHom.comp_apply] at hsq
    rw [← hsq, h2, map_one]
  have h4 : g ∈ weylSq := by
    have := (QuotientGroup.eq_one_iff g).mp h3
    exact this
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp h4
  have hss : toSL2 (s * s) = negOne := by
    rw [map_mul, toSL2_s, Smat_sq]
  have hkneg : negOne ^ k = 1 := by
    rw [← hss, ← map_zpow, hk, hg]
  have hnegOne_zpow_two : negOne ^ (2 : ℤ) = 1 := by
    rw [show (2 : ℤ) = 1 + 1 from rfl, zpow_add, zpow_one, negOne_sq]
  rcases Int.even_or_odd k with ⟨m, hm⟩ | ⟨m, hm⟩
  · -- even powers of the central element die by `s⁴ = 1`
    rw [← hk, hm, show m + m = 2 * m from by ring, zpow_mul,
      show (s * s) ^ (2 : ℤ) = (s * s) * (s * s) from by
        rw [show (2 : ℤ) = 1 + 1 from rfl, zpow_add, zpow_one],
      s_sq_sq, one_zpow]
  · -- an odd power would send `-1` to `1`
    exfalso
    apply negOne_ne_one
    calc negOne = negOne ^ (2 * m) * negOne := by
          rw [zpow_mul, hnegOne_zpow_two, one_zpow, one_mul]
      _ = negOne ^ (2 * m + 1) := by
          rw [zpow_add, zpow_one]
      _ = negOne ^ k := by rw [← hm]
      _ = 1 := hkneg

end

end SL2Completeness
end GroupApproximation
