import GroupApproximation.Higman.RowBasis

/-!
# Conjugates of a free generator are a free basis

Higman's construction attaches to a sequence `f` the element `a^{b_f}` of
`F₃ = ⟨a, b, c⟩`, and to a set `B` of sequences the subgroup generated by the
corresponding conjugates.  For that dictionary to be faithful --- for `B` to be
recoverable from the subgroup --- the conjugates have to be a free basis.  They
are, and this file proves it by the same device as `Higman.RowBasis`: an
explicit action.

Let `K = ⟨b, c⟩ ≤ F₃` and let `F₃` act on `FreeGroup F₃ × F₃` by

    b · (w, g) = (w, b·g),   c · (w, g) = (w, c·g),   a · (w, g) = (of g · w, g).

Then `a^h = h⁻¹ a h`, for `h ∈ K`, acts on the slice `g = 1` as left
multiplication by `of h`, and preserves that slice.  So a word in the `a^h`
that dies in `F₃` gives a word in the `of h` that dies in `FreeGroup F₃`,
hence was trivial.

No normal form theorem and no ping-pong sets are used; only the universal
property of a free group.
-/

namespace GroupApproximation
namespace Higman
namespace Conj

/-- The free group of rank three. -/
abbrev F₃ : Type := FreeGroup (Fin 3)

/-- The conjugated generator. -/
def a : F₃ := FreeGroup.of 0

/-- The first generator of the conjugating subgroup. -/
def b : F₃ := FreeGroup.of 1

/-- The second generator of the conjugating subgroup. -/
def c : F₃ := FreeGroup.of 2

/-- The conjugating subgroup `⟨b, c⟩`. -/
def K : Subgroup F₃ := Subgroup.closure {b, c}

theorem b_mem_K : b ∈ K := Subgroup.subset_closure (Set.mem_insert _ _)

theorem c_mem_K : c ∈ K :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)

/-! ## 1.  The action -/

/-- The set acted on. -/
abbrev Slice : Type := FreeGroup F₃ × F₃

/-- Left translation of the second coordinate. -/
def lPerm (k : F₃) : Equiv.Perm Slice where
  toFun p := (p.1, k * p.2)
  invFun p := (p.1, k⁻¹ * p.2)
  left_inv p := by
    refine Prod.ext rfl ?_
    show k⁻¹ * (k * p.2) = p.2
    group
  right_inv p := by
    refine Prod.ext rfl ?_
    show k * (k⁻¹ * p.2) = p.2
    group

/-- The permutation `a` acts by. -/
def aPerm : Equiv.Perm Slice where
  toFun p := (FreeGroup.of p.2 * p.1, p.2)
  invFun p := ((FreeGroup.of p.2)⁻¹ * p.1, p.2)
  left_inv p := by
    refine Prod.ext ?_ rfl
    show (FreeGroup.of p.2)⁻¹ * (FreeGroup.of p.2 * p.1) = p.1
    group
  right_inv p := by
    refine Prod.ext ?_ rfl
    show FreeGroup.of p.2 * ((FreeGroup.of p.2)⁻¹ * p.1) = p.1
    group

/-- The action of `F₃`. -/
def act : F₃ →* Equiv.Perm Slice :=
  FreeGroup.lift (fun i : Fin 3 =>
    if i = 0 then aPerm else if i = 1 then lPerm b else lPerm c)

@[simp] theorem act_a : act a = aPerm := by
  simp [act, a]

@[simp] theorem act_b : act b = lPerm b := by
  simp [act, b]

@[simp] theorem act_c : act c = lPerm c := by
  simp [act, c]

/-- **The conjugating subgroup acts by left translation.** -/
theorem act_of_mem_K {x : F₃} (hx : x ∈ K) (p : Slice) :
    act x p = (p.1, x * p.2) := by
  induction hx using Subgroup.closure_induction generalizing p with
  | mem y hy =>
      rcases hy with rfl | hy
      · rw [act_b]
        rfl
      · rw [Set.mem_singleton_iff] at hy
        subst hy
        rw [act_c]
        rfl
  | one =>
      rw [map_one]
      refine Prod.ext rfl ?_
      show p.2 = 1 * p.2
      rw [one_mul]
  | mul y z _ _ ihy ihz =>
      rw [map_mul]
      show act y (act z p) = _
      rw [ihz, ihy]
      refine Prod.ext rfl ?_
      show y * (z * p.2) = y * z * p.2
      group
  | inv y _ ihy =>
      rw [map_inv]
      apply (act y).symm_apply_eq.mpr
      show p = act y (p.1, y⁻¹ * p.2)
      rw [ihy]
      exact Prod.ext rfl (by group)

/-- **What a conjugate does on the trivial slice.** -/
theorem act_conj {h : F₃} (hh : h ∈ K) (w : FreeGroup F₃) :
    act (h⁻¹ * a * h) (w, (1 : F₃)) = (FreeGroup.of h * w, 1) := by
  rw [map_mul, map_mul]
  show act h⁻¹ (act a (act h (w, (1 : F₃)))) = _
  rw [act_of_mem_K hh]
  show act h⁻¹ (act a (w, h * (1 : F₃))) = _
  rw [act_a]
  show act h⁻¹ (FreeGroup.of (h * (1 : F₃)) * w, h * (1 : F₃)) = _
  rw [act_of_mem_K (Subgroup.inv_mem _ hh)]
  refine Prod.ext ?_ ?_
  · show FreeGroup.of (h * (1 : F₃)) * w = FreeGroup.of h * w
    rw [mul_one]
  · show h⁻¹ * (h * (1 : F₃)) = 1
    group

/-! ## 2.  The basis map -/

/-- The homomorphism from the free group on the conjugating subgroup, sending
the generator indexed by `h` to `a^h`. -/
def cbHom : FreeGroup ↥K →* F₃ :=
  FreeGroup.lift (fun h : ↥K => (h : F₃)⁻¹ * a * (h : F₃))

@[simp] theorem cbHom_of (h : ↥K) :
    cbHom (FreeGroup.of h) = (h : F₃)⁻¹ * a * (h : F₃) := by
  simp [cbHom]

/-- The inclusion of index sets. -/
def incl : FreeGroup ↥K →* FreeGroup F₃ := FreeGroup.map (fun h : ↥K => (h : F₃))

@[simp] theorem incl_of (h : ↥K) : incl (FreeGroup.of h) = FreeGroup.of (h : F₃) := by
  unfold incl
  rw [FreeGroup.map.of]

theorem incl_injective : Function.Injective incl :=
  FreeGroup.map_injective (fun _ _ h => Subtype.ext h)

/-! ## 3.  The action computes the basis map -/

/-- The words whose image acts on the trivial slice by left multiplication with
their inclusion. -/
def GoodSub : Subgroup (FreeGroup ↥K) where
  carrier := {W : FreeGroup ↥K | ∀ w : FreeGroup F₃,
    act (cbHom W) (w, (1 : F₃)) = (incl W * w, 1)}
  one_mem' := by
    intro w
    rw [map_one, map_one, map_one, one_mul]
    rfl
  mul_mem' := by
    intro x y hx hy w
    simp only [map_mul]
    show act (cbHom x) (act (cbHom y) (w, (1 : F₃))) = _
    rw [hy w, hx (incl y * w)]
    exact Prod.ext (by group) rfl
  inv_mem' := by
    intro x hx w
    have hkey : act (cbHom x) ((incl x)⁻¹ * w, (1 : F₃)) = (w, 1) := by
      rw [hx ((incl x)⁻¹ * w)]
      refine Prod.ext ?_ rfl
      show incl x * ((incl x)⁻¹ * w) = w
      group
    have hinv : (act (cbHom x))⁻¹ (w, (1 : F₃)) = ((incl x)⁻¹ * w, 1) :=
      (act (cbHom x)).symm_apply_eq.mpr hkey.symm
    simpa only [map_inv] using hinv

theorem goodSub_eq_top : GoodSub = ⊤ := by
  apply top_unique
  intro W _
  refine FreeGroup.induction_on W ?_ ?_ ?_ ?_
  · exact Subgroup.one_mem _
  · intro h w
    rw [cbHom_of, incl_of]
    exact act_conj h.2 w
  · intro h hmem
    exact Subgroup.inv_mem _ hmem
  · intro x y hx hy
    exact Subgroup.mul_mem _ hx hy

/-! ## 4.  The conjugates freely generate -/

/-- **The conjugates `a^h`, `h ∈ K`, are a free basis of the subgroup they
generate.** -/
theorem cbHom_injective : Function.Injective cbHom := by
  rw [injective_iff_map_eq_one]
  intro W hW
  have hgood : W ∈ GoodSub := by
    rw [goodSub_eq_top]
    exact Subgroup.mem_top W
  have h := hgood 1
  rw [hW, map_one] at h
  have h1 : ((1 : FreeGroup F₃), (1 : F₃)) = (incl W * 1, 1) := h
  have h2 : incl W = 1 := by
    have hfst := congrArg Prod.fst h1
    show incl W = 1
    rw [← mul_one (incl W)]
    exact hfst.symm
  apply incl_injective
  rw [h2, map_one]

end Conj
end Higman
end GroupApproximation
