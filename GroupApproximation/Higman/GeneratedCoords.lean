import GroupApproximation.Higman.GeneratedBasic

/-!
# Pinning a value: the first non-lattice fact about `HigmanGenerated`

`Higman/GeneratedBasic.lean` supplies the lattice bottom of the calculus.  This
module takes the first step that actually uses the arithmetic content of `S`,
and it settles the question the workstream flagged as `R2`: can the generated
family pin a *specific nonzero value* at a coordinate?

It can, and cheaply.  `S` is the set of sequences `a·e₀ + (a+1)·e₁`, and `atZero`
is the set of sequences vanishing away from the origin.  A member of `S` lies in
`atZero` exactly when its index-`1` entry `a + 1` vanishes, which pins `a = -1`
and leaves the single sequence `-e₀`.  So

    S ∩ ζ(Z) = { -e₀ },

a one-point set, generated by one `inter` from two already-generated sets.

This matters out of proportion to its length.  The lattice operations alone can
never produce a set smaller than `Z = {0}`, so before this lemma there was no
evidence that the family contained *any* nonzero point.  With `-e₀` in hand the
remaining values are reachable by the operations that move and compress
coordinates, which is the subject of the layer above this one.
-/

namespace GroupApproximation
namespace Higman
namespace Seq

/-- The one-point set `{-e₀}`. -/
noncomputable def negOneAtZero : Set E := {Finsupp.single (0 : ℤ) (-1 : ℤ)}

theorem succSeq_apply_zero (a : ℤ) : succSeq a 0 = a := by
  simp [succSeq]

theorem succSeq_apply_one (a : ℤ) : succSeq a 1 = a + 1 := by
  simp [succSeq]

theorem succSeq_neg_one : succSeq (-1) = Finsupp.single (0 : ℤ) (-1 : ℤ) := by
  simp [succSeq]

/-- **`S` meets `atZero` in exactly one point.**  Membership in `atZero` kills
the index-`1` entry `a + 1`, so `a = -1`. -/
theorem Sset_inter_atZero : Sset ∩ atZero = negOneAtZero := by
  ext f
  constructor
  · rintro ⟨⟨a, ha⟩, hz⟩
    have h1 : f 1 = 0 := hz 1 (by decide)
    rw [← ha, succSeq_apply_one] at h1
    have ha' : a = -1 := by omega
    rw [← ha, ha', succSeq_neg_one]
    rfl
  · intro hf
    have hf' : f = Finsupp.single (0 : ℤ) (-1 : ℤ) := hf
    refine ⟨⟨-1, ?_⟩, ?_⟩
    · rw [succSeq_neg_one, hf']
    · intro i hi
      have hne : (0 : ℤ) ≠ i := Ne.symm hi
      rw [hf']
      simp [hne]

/-- **A specific nonzero point is generated.**  This is the base of the value
calculus: `Z` gives the zero sequence, and this gives `-e₀`. -/
theorem higmanGenerated_negOneAtZero : HigmanGenerated negOneAtZero := by
  rw [← Sset_inter_atZero]
  exact HigmanGenerated.inter HigmanGenerated.succ higmanGenerated_atZero

end Seq
end Higman
end GroupApproximation
