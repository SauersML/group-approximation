import GroupApproximation.Higman.ConjugatorGraphProfinite
import GroupApproximation.Higman.PairedReturnEdgeGraph

/-!
# The left matched-factor product

The paired edge is generated by its returning kernel and the untwisted path.
The returning kernel already lies in Higman's conjugator graph.  Therefore the
set product `graphSub * M` reduces to `graphSub * alpha(K)`.  This is the
left-side normal-form simplification needed for separability of the literal
five-generator cutter.
-/

namespace GroupApproximation
namespace Higman
namespace PairedReturnLeftProduct

open Conj
open PairedReturnGraphIntersection
open scoped Pointwise

abbrev P : Type := PairedReturnGraphIntersection.P
abbrev Edge : Type := ↥PairedReturnGraphIntersection.M
abbrev Sync : Type := ↥K

/-- Every edge element is a returning element followed by an untwisted-path
element. -/
theorem exists_delta_mul_alpha (m : Edge) :
    ∃ d ∈ deltaSub, ∃ k : Sync, (m : P) = d * alpha k := by
  obtain ⟨w, hw⟩ := m.property
  let k : Sync := PairedFoldKernel.fold Sync w
  let v : Monoid.Coprod Sync Sync :=
    w * (Monoid.Coprod.inl k)⁻¹
  have hvfold : PairedFoldKernel.fold Sync v = 1 := by
    simp [v, k]
  have hd : mu v ∈ deltaSub :=
    fold_ker_le_mu_comap_deltaSub (MonoidHom.mem_ker.mpr hvfold)
  refine ⟨mu v, hd, k, ?_⟩
  rw [← hw]
  simp only [v, map_mul, map_inv, mu_inl]
  change mu w = mu w * (alpha k)⁻¹ * alpha k
  group

/-- Multiplication by the whole paired edge adds nothing beyond multiplication
by the untwisted path: its returning part is absorbed by `graphSub`. -/
theorem graphSub_mul_edge_eq_graphSub_mul_alpha :
    (Star.graphSub : Set P) * (PairedReturnGraphIntersection.M : Set P) =
      (Star.graphSub : Set P) * (alpha.range : Set P) := by
  ext z
  constructor
  · rintro ⟨g, hg, m, hm, rfl⟩
    let ms : Edge := ⟨m, hm⟩
    obtain ⟨d, hd, k, hk⟩ := exists_delta_mul_alpha ms
    change m = d * alpha k at hk
    refine ⟨g * d, Star.graphSub.mul_mem hg
      (deltaSub_le_graphSub hd), alpha k, ⟨k, rfl⟩, ?_⟩
    change (g * d) * alpha k = g * m
    rw [hk]
    group
  · rintro ⟨g, hg, _, ⟨k, rfl⟩, rfl⟩
    refine ⟨g, hg, alpha k, ?_, rfl⟩
    exact ⟨Monoid.Coprod.inl k, mu_inl k⟩

/-- Coordinate form of the simplified product. -/
theorem mem_graphSub_mul_edge_iff {x y : F₃} :
    (x, y) ∈
        (Star.graphSub : Set P) *
          (PairedReturnGraphIntersection.M : Set P) ↔
      ∃ (w : FreeGroup Sync) (k : Sync),
        x = cbHom w * (k : F₃) ∧ y = Star.evalHom w := by
  rw [graphSub_mul_edge_eq_graphSub_mul_alpha]
  constructor
  · rintro ⟨g, hg, _, ⟨k, rfl⟩, hprod⟩
    obtain ⟨w, hw⟩ := Star.mem_graphSub.mp hg
    subst g
    refine ⟨w, k, ?_, ?_⟩
    · simpa only [Star.graphHom_apply, alpha_apply, Prod.fst_mul] using
        congrArg Prod.fst hprod.symm
    · simpa only [Star.graphHom_apply, alpha_apply, Prod.snd_mul, mul_one] using
        congrArg Prod.snd hprod.symm
  · rintro ⟨w, k, rfl, rfl⟩
    refine ⟨Star.graphHom w, ⟨w, rfl⟩, alpha k, ⟨k, rfl⟩, ?_⟩
    simp only [Star.graphHom_apply, alpha_apply, Prod.mk_mul_mk, mul_one]

end PairedReturnLeftProduct
end Higman
end GroupApproximation
