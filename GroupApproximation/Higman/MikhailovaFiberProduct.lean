import GroupApproximation.Algebra.ProductFinitePresentation

/-!
# The Mikhailova fibre product, internally

Let `R` be a set of relators in a group `G`.  Inside `G × G`, generate a
subgroup by the diagonal and the pairs `(r, 1)` for `r ∈ R`.  This file proves
directly that the resulting subgroup is exactly the fibre product of the two
quotient maps to `G / ⟨⟨R⟩⟩`.

For a free group it is enough to use the diagonal pairs of the free basis.
Thus a finite alphabet and a finite relator set give the classical finitely
generated Mikhailova subgroup.  No embedding theorem, decidability theorem,
or literature-shaped interface occurs in the statements or proofs.
-/

namespace GroupApproximation
namespace Higman
namespace Mikhailova

variable {G : Type*} [Group G]

/-! ## The group-independent fibre-product theorem -/

/-- The diagonal homomorphism into the square. -/
def diagonalHom : G →* G × G :=
  (MonoidHom.id G).prod (MonoidHom.id G)

@[simp] theorem diagonalHom_apply (g : G) : diagonalHom g = (g, g) := rfl

/-- Inclusion in the first factor. -/
abbrev firstHom : G →* G × G := MonoidHom.inl G G

@[simp] theorem firstHom_apply (g : G) : firstHom g = (g, 1) := rfl

/-- The diagonal together with the relators in the first factor. -/
def generators (R : Set G) : Set (G × G) :=
  Set.range (diagonalHom (G := G)) ∪ firstHom '' R

/-- The subgroup generated by the Mikhailova pairs. -/
def subgroup (R : Set G) : Subgroup (G × G) :=
  Subgroup.closure (generators R)

/-- The quotient map by the normal closure of `R`. -/
def quotientMap (R : Set G) : G →* G ⧸ Subgroup.normalClosure R :=
  QuotientGroup.mk' (Subgroup.normalClosure R)

@[simp] theorem quotientMap_apply (R : Set G) (g : G) :
    quotientMap R g = QuotientGroup.mk g := rfl

/-- The fibre product of the quotient map `G → G / ⟨⟨R⟩⟩` with itself. -/
def fiberProduct (R : Set G) : Subgroup (G × G) where
  carrier := {p | quotientMap R p.1 = quotientMap R p.2}
  one_mem' := by
    change quotientMap R (1 : G) = quotientMap R 1
    rfl
  mul_mem' := by
    rintro ⟨a₁, a₂⟩ ⟨b₁, b₂⟩ ha hb
    change quotientMap R (a₁ * b₁) = quotientMap R (a₂ * b₂)
    rw [map_mul, map_mul, ha, hb]
  inv_mem' := by
    rintro ⟨a₁, a₂⟩ ha
    change quotientMap R a₁⁻¹ = quotientMap R a₂⁻¹
    rw [map_inv, map_inv, ha]

theorem mem_fiberProduct_iff (R : Set G) (a b : G) :
    (a, b) ∈ fiberProduct R ↔
      quotientMap R a = quotientMap R b :=
  Iff.rfl

/-- Every displayed Mikhailova generator lies in the fibre product. -/
theorem generators_subset_fiberProduct (R : Set G) :
    generators R ⊆ fiberProduct R := by
  rintro p (hp | hp)
  · obtain ⟨g, rfl⟩ := hp
    exact rfl
  · obtain ⟨r, hr, rfl⟩ := hp
    change quotientMap R r = 1
    exact (QuotientGroup.eq_one_iff _).2
      (Subgroup.subset_normalClosure hr)

theorem subgroup_le_fiberProduct (R : Set G) :
    subgroup R ≤ fiberProduct R := by
  rw [subgroup, Subgroup.closure_le]
  exact generators_subset_fiberProduct R

/-! The reverse inclusion is the normal-closure argument. -/

/-- Elements whose first-factor pair belongs to the Mikhailova subgroup. -/
def firstKernel (R : Set G) : Subgroup G :=
  (subgroup R).comap firstHom

theorem relators_le_firstKernel (R : Set G) : R ⊆ firstKernel R := by
  intro r hr
  exact Subgroup.subset_closure (Or.inr ⟨r, hr, rfl⟩)

/-- The diagonal generators make the first-factor kernel normal. -/
instance firstKernel_normal (R : Set G) : (firstKernel R).Normal where
  conj_mem := by
    intro x hx g
    have hdiag : (g, g) ∈ subgroup R :=
      Subgroup.subset_closure (Or.inl ⟨g, rfl⟩)
    change (x, 1) ∈ subgroup R at hx
    have hconj := (subgroup R).mul_mem
      ((subgroup R).mul_mem hdiag hx) ((subgroup R).inv_mem hdiag)
    have heq : (g, g) * (x, 1) * (g, g)⁻¹ =
        (g * x * g⁻¹, 1) := by
      apply Prod.ext <;> simp
    change (g * x * g⁻¹, 1) ∈ subgroup R
    rw [← heq]
    exact hconj

theorem normalClosure_le_firstKernel (R : Set G) :
    Subgroup.normalClosure R ≤ firstKernel R :=
  Subgroup.normalClosure_le_normal (relators_le_firstKernel R)

theorem first_pair_mem_of_mem_normalClosure (R : Set G) {x : G}
    (hx : x ∈ Subgroup.normalClosure R) : (x, 1) ∈ subgroup R :=
  normalClosure_le_firstKernel R hx

theorem fiberProduct_le_subgroup (R : Set G) :
    fiberProduct R ≤ subgroup R := by
  rintro ⟨a, b⟩ hab
  have hquot : quotientMap R (a * b⁻¹) = 1 := by
    rw [map_mul, map_inv, hab, mul_inv_cancel]
  have hnormal : a * b⁻¹ ∈ Subgroup.normalClosure R :=
    (QuotientGroup.eq_one_iff _).1 hquot
  have hfirst : (a * b⁻¹, 1) ∈ subgroup R :=
    first_pair_mem_of_mem_normalClosure R hnormal
  have hdiag : (b, b) ∈ subgroup R :=
    Subgroup.subset_closure (Or.inl ⟨b, rfl⟩)
  have hmul := (subgroup R).mul_mem hfirst hdiag
  have heq : (a * b⁻¹, 1) * (b, b) = (a, b) := by
    apply Prod.ext <;> simp [mul_assoc]
  rw [← heq]
  exact hmul

/-- **Mikhailova fibre-product theorem.**  Diagonal pairs and first-coordinate
relator pairs generate exactly the pullback of the quotient map with itself. -/
theorem subgroup_eq_fiberProduct (R : Set G) :
    subgroup R = fiberProduct R :=
  le_antisymm (subgroup_le_fiberProduct R) (fiberProduct_le_subgroup R)

theorem mem_subgroup_iff_quotient_eq (R : Set G) (a b : G) :
    (a, b) ∈ subgroup R ↔
      quotientMap R a = quotientMap R b := by
  rw [subgroup_eq_fiberProduct]
  rfl

/-! ## Free-group basis form -/

variable {X : Type*}

/-- The classical generating set: diagonal free generators and relators in
the first coordinate. -/
def freeGenerators (R : Set (FreeGroup X)) :
    Set (FreeGroup X × FreeGroup X) :=
  Set.range (fun x : X => (FreeGroup.of x, FreeGroup.of x)) ∪
    firstHom '' R

/-- The classical Mikhailova subgroup attached to a presentation. -/
def freeSubgroup (R : Set (FreeGroup X)) :
    Subgroup (FreeGroup X × FreeGroup X) :=
  Subgroup.closure (freeGenerators R)

theorem diagonal_mem_freeSubgroup (R : Set (FreeGroup X))
    (w : FreeGroup X) : (w, w) ∈ freeSubgroup R := by
  refine FreeGroup.induction_on
    (C := fun w : FreeGroup X => (w, w) ∈ freeSubgroup R) w ?_ ?_ ?_ ?_
  · exact (freeSubgroup R).one_mem
  · intro x
    exact Subgroup.subset_closure (Or.inl ⟨x, rfl⟩)
  · intro x hx
    change ((FreeGroup.of x)⁻¹, (FreeGroup.of x)⁻¹) ∈ freeSubgroup R
    exact (freeSubgroup R).inv_mem hx
  · intro x y hx hy
    change (x * y, x * y) ∈ freeSubgroup R
    exact (freeSubgroup R).mul_mem hx hy

theorem freeSubgroup_eq_subgroup (R : Set (FreeGroup X)) :
    freeSubgroup R = subgroup R := by
  apply le_antisymm
  · rw [freeSubgroup, Subgroup.closure_le]
    rintro p (hp | hp)
    · obtain ⟨x, rfl⟩ := hp
      exact Subgroup.subset_closure
        (Or.inl ⟨FreeGroup.of x, rfl⟩)
    · exact Subgroup.subset_closure (Or.inr hp)
  · rw [subgroup, Subgroup.closure_le]
    rintro p (hp | hp)
    · obtain ⟨w, rfl⟩ := hp
      exact diagonal_mem_freeSubgroup R w
    · exact Subgroup.subset_closure (Or.inr hp)

/-- **Free-group Mikhailova theorem.**  The basis-diagonal construction is
exactly the fibre product of the presented quotient with itself. -/
theorem freeSubgroup_eq_fiberProduct (R : Set (FreeGroup X)) :
    freeSubgroup R = fiberProduct R := by
  rw [freeSubgroup_eq_subgroup, subgroup_eq_fiberProduct]

theorem mem_freeSubgroup_iff_quotient_eq (R : Set (FreeGroup X))
    (u v : FreeGroup X) :
    (u, v) ∈ freeSubgroup R ↔
      quotientMap R u = quotientMap R v := by
  rw [freeSubgroup_eq_fiberProduct]
  rfl

/-- In the repository's presented-group notation, Mikhailova membership is
literal equality of the represented words. -/
theorem mem_freeSubgroup_iff_presented_mk_eq (R : Set (FreeGroup X))
    (u v : FreeGroup X) :
    (u, v) ∈ freeSubgroup R ↔
      PresentedGroup.mk R u = PresentedGroup.mk R v := by
  exact mem_freeSubgroup_iff_quotient_eq R u v

/-- Finite alphabets and finite relator sets give a finitely generated
Mikhailova subgroup, with the displayed generators themselves as witness. -/
theorem freeSubgroup_fg [Finite X] {R : Set (FreeGroup X)} (hR : R.Finite) :
    (freeSubgroup R).FG := by
  refine (Subgroup.fg_iff _).2 ⟨freeGenerators R, rfl, ?_⟩
  exact (Set.finite_range _).union (hR.image firstHom)

end Mikhailova
end Higman
end GroupApproximation
