import GroupApproximation.Higman.HNNCentralizer

/-!
# The pinch lemma

In the HNN extension `Γ = P ∗_M t` whose stable letter centralizes `M`, let
`Z` and `Q` be subgroups of the base that cover each other's intersection
with `M`:

    Q ⊓ M ≤ Z    and    Z ⊓ M ≤ Q.

Then the subgroup generated by `Z` and by the conjugate `Qᵗ` meets the base
exactly in `Z`.  That is `pinch` below, and it is the one word lemma Higman's
Lemma 3.2 needs once the two benign witnesses are glued by a direct product
instead of by an amalgam; `Higman.BenignJoin` is that gluing, and it applies
this lemma twice.

## The shape of the argument

Every element of `⟨Z, Qᵗ⟩` can be written as

    z₀ · (t⁻¹q₁t · z₁) · (t⁻¹q₂t · z₂) ⋯ (t⁻¹qₖt · zₖ)

with all `zᵢ ∈ Z` and all `qᵢ ∈ Q` (`exists_blockForm`).  Read as a word in
the stable letter that is

    head z₀, then (-1, q₁), (1, z₁), (-1, q₂), (1, z₂), …

which is *reduced* in the sense of Mathlib's `HNNExtension.ReducedWord`
exactly when no `qᵢ` lies in `M` and no `zᵢ` except the last one does; that
condition is `Clean`.  Then:

* if some `qᵢ ∈ M` then `qᵢ ∈ Q ⊓ M ≤ Z`, the stable letter passes through it
  (`blockOf_of_mem`), and the block collapses into its neighbour on the left,
  which stays in `Z`;
* if some non-final `zᵢ ∈ M` then `zᵢ ∈ Z ⊓ M ≤ Q`, the stable letter passes
  through it the other way (`blockOf_mul_blockOf`), and two consecutive
  blocks merge into one whose `Q`-entry stays in `Q`;
* otherwise the word is reduced, and Britton's lemma --- Mathlib's
  `ReducedWord.toList_eq_nil_of_mem_of_range`, which
  `Higman.mem_of_conj_mem_range` already uses in its one-letter form --- says
  its product cannot lie in the base unless the list is empty.

Each of the first two cases shortens the list by one, so the induction on
length reaches the third, and there the element is `of z₀` with `z₀ ∈ Z`.
-/

namespace GroupApproximation
namespace Higman
namespace Pinch

open HNNExtension

variable {P : Type} [Group P] (M : Subgroup P)

/-- **Every element of a generated subgroup is a product of generators and
inverses of generators.**  Mathlib states this for submonoids only; the
subgroup form is the submonoid statement applied to `s ∪ s⁻¹`, which is what
`Subgroup.closure_toSubmonoid` identifies the closure with. -/
theorem exists_list_of_mem_closure {G : Type*} [Group G] {s : Set G} {x : G}
    (hx : x ∈ Subgroup.closure s) :
    ∃ L : List G, (∀ y ∈ L, y ∈ s ∨ y⁻¹ ∈ s) ∧ L.prod = x := by
  have hxm : x ∈ Submonoid.closure (s ∪ s⁻¹) := by
    rw [← Subgroup.closure_toSubmonoid]
    exact hx
  obtain ⟨L, hL, hprod⟩ := Submonoid.exists_list_of_mem_closure hxm
  refine ⟨L, fun y hy ↦ ?_, hprod⟩
  rcases hL y hy with h | h
  · exact Or.inl h
  · exact Or.inr (Set.mem_inv.mp h)

/-! ## 1.  Words in block form -/

/-- One block: a conjugate of a base element by the stable letter, followed by
a base element. -/
def blockOf (p : P × P) : CentHNN M :=
  (t : CentHNN M)⁻¹ * of p.1 * t * of p.2

/-- A word in block form: a leading base element, then a list of blocks. -/
def word (z₀ : P) (l : List (P × P)) : CentHNN M :=
  of z₀ * ((l.map (blockOf M)).prod)

@[simp] theorem word_nil (z₀ : P) : word M z₀ [] = of z₀ := by
  unfold word
  simp

theorem word_cons (z₀ : P) (p : P × P) (l : List (P × P)) :
    word M z₀ (p :: l) = of z₀ * blockOf M p * ((l.map (blockOf M)).prod) := by
  unfold word
  rw [List.map_cons, List.prod_cons, ← mul_assoc]

theorem word_append (z₀ : P) (l₁ l₂ : List (P × P)) :
    word M z₀ (l₁ ++ l₂) =
      of z₀ * ((l₁.map (blockOf M)).prod) * ((l₂.map (blockOf M)).prod) := by
  unfold word
  rw [List.map_append, List.prod_append, ← mul_assoc]

/-! ## 2.  The two collapses -/

/-- **A block whose conjugated entry lies in `M` is a base element.** -/
theorem blockOf_of_mem (q z : P) (hq : q ∈ M) :
    blockOf M (q, z) = of (q * z) := by
  have h : (t : CentHNN M)⁻¹ * of q * t = of q := conj_eq_self_of_mem M hq
  unfold blockOf
  rw [h, ← map_mul]

/-- **A block absorbs a following base element.** -/
theorem blockOf_mul_of (q z a : P) :
    blockOf M (q, z) * of a = blockOf M (q, z * a) := by
  unfold blockOf
  rw [mul_assoc, ← map_mul]

/-- **Two blocks whose middle base element lies in `M` merge into one.** -/
theorem blockOf_mul_blockOf (q z q' z' : P) (hz : z ∈ M) :
    blockOf M (q, z) * blockOf M (q', z') = blockOf M (q * z * q', z') := by
  have h : (t : CentHNN M)⁻¹ * of z * t = of z := conj_eq_self_of_mem M hz
  have hz' : (t : CentHNN M) * of z * (t : CentHNN M)⁻¹ = of z :=
    calc (t : CentHNN M) * of z * (t : CentHNN M)⁻¹
        = (t : CentHNN M) * ((t : CentHNN M)⁻¹ * of z * (t : CentHNN M))
            * (t : CentHNN M)⁻¹ := by rw [h]
      _ = of z := by group
  unfold blockOf
  calc
    (t : CentHNN M)⁻¹ * of q * t * of z *
        ((t : CentHNN M)⁻¹ * of q' * t * of z')
        = (t : CentHNN M)⁻¹ * of q * ((t : CentHNN M) * of z * (t : CentHNN M)⁻¹) *
            of q' * t * of z' := by
          group
    _ = (t : CentHNN M)⁻¹ * of q * of z * of q' * t * of z' := by
          rw [hz']
    _ = (t : CentHNN M)⁻¹ * of (q * z * q') * t * of z' := by
          rw [map_mul, map_mul]
          group

/-! ## 3.  Multiplying block words on the left -/

/-- A base element merges into the leading base element. -/
theorem of_mul_word (a z₀ : P) (l : List (P × P)) :
    of a * word M z₀ l = word M (a * z₀) l := by
  unfold word
  rw [← mul_assoc, ← map_mul]

/-- A conjugate starts a new block. -/
theorem conj_mul_word (q z₀ : P) (l : List (P × P)) :
    ((t : CentHNN M)⁻¹ * of q * t) * word M z₀ l = word M 1 ((q, z₀) :: l) := by
  rw [word_cons]
  unfold word blockOf
  simp only [map_one, one_mul]
  group

/-! ## 4.  The reduced word attached to a block word -/

/-- The letters of a block word, read as a word in the stable letter. -/
def redList : List (P × P) → List (ℤˣ × P)
  | [] => []
  | p :: l => ((-1 : ℤˣ), p.1) :: ((1 : ℤˣ), p.2) :: redList l

omit [Group P] in
@[simp] theorem redList_nil : redList (P := P) [] = [] := rfl

omit [Group P] in
@[simp] theorem redList_cons (p : P × P) (l : List (P × P)) :
    redList (p :: l)
      = ((-1 : ℤˣ), p.1) :: ((1 : ℤˣ), p.2) :: redList l := rfl

omit [Group P] in
theorem redList_eq_nil_iff (l : List (P × P)) : redList l = [] ↔ l = [] := by
  cases l with
  | nil => simp
  | cons p l => simp

/-- The product of the letters is the product of the blocks. -/
theorem prod_redList (l : List (P × P)) :
    (((redList l).map
        (fun x : ℤˣ × P => (t : CentHNN M) ^ (x.1 : ℤ) * of x.2)).prod)
      = ((l.map (blockOf M)).prod) := by
  induction l with
  | nil => simp
  | cons p l ih =>
      rw [redList_cons, List.map_cons, List.map_cons, List.prod_cons,
        List.prod_cons, List.map_cons, List.prod_cons, ih]
      have hneg : (((-1 : ℤˣ) : ℤ)) = -1 := rfl
      have hone : (((1 : ℤˣ) : ℤ)) = 1 := rfl
      rw [hneg, hone, zpow_neg_one, zpow_one]
      unfold blockOf
      group

/-! ## 5.  When the letters form a reduced word -/

/-- The condition making the letters of a block word reduced: no conjugated
entry lies in `M`, and no base entry except the last one does. -/
def Clean : List (P × P) → Prop
  | [] => True
  | [p] => p.1 ∉ M
  | p :: q :: l => p.1 ∉ M ∧ p.2 ∉ M ∧ Clean (q :: l)

theorem isChain_redList : ∀ (l : List (P × P)), Clean M l →
    List.IsChain (fun a b : ℤˣ × P => a.2 ∈ toSubgroup M M a.1 → a.1 = b.1)
      (redList l)
  | [], _ => by
      rw [redList_nil]
      exact List.isChain_nil
  | [p], hc => by
      have hc' : p.1 ∉ M := hc
      rw [redList_cons, redList_nil]
      refine List.isChain_cons_cons.mpr ⟨?_, List.isChain_singleton _⟩
      intro hmem
      rw [toSubgroup_self M] at hmem
      exact absurd hmem hc'
  | p :: q :: l, hc => by
      have hc' : p.1 ∉ M ∧ p.2 ∉ M ∧ Clean M (q :: l) := hc
      obtain ⟨h1, h2, hrest⟩ := hc'
      rw [redList_cons]
      refine List.isChain_cons_cons.mpr ⟨?_, ?_⟩
      · intro hmem
        rw [toSubgroup_self M] at hmem
        exact absurd hmem h1
      · show List.IsChain _ (((1 : ℤˣ), p.2) :: redList (q :: l))
        rw [redList_cons]
        refine List.isChain_cons_cons.mpr ⟨?_, ?_⟩
        · intro hmem
          rw [toSubgroup_self M] at hmem
          exact absurd hmem h2
        · have := isChain_redList (q :: l) hrest
          rw [redList_cons] at this
          exact this

/-- **Britton, for block words.**  A clean block word lies in the base only if
it has no blocks at all. -/
theorem eq_nil_of_clean (z₀ : P) (l : List (P × P)) (hc : Clean M l)
    (hmem : word M z₀ l ∈ (of : P →* CentHNN M).range) : l = [] := by
  let w : HNNExtension.NormalWord.ReducedWord P M M :=
    { head := z₀
      toList := redList l
      chain := isChain_redList M l hc }
  have hprod : w.prod (MulEquiv.refl M) = word M z₀ l := by
    show of z₀ * (((redList l).map
      (fun x : ℤˣ × P => (t : CentHNN M) ^ (x.1 : ℤ) * of x.2)).prod) = _
    rw [prod_redList]
    rfl
  have hnil : w.toList = [] := by
    refine ReducedWord.toList_eq_nil_of_mem_of_range (MulEquiv.refl M) w ?_
    rw [hprod]
    exact hmem
  exact (redList_eq_nil_iff l).mp hnil

/-! ## 6.  Where a word fails to be clean -/

/-- An unclean block word has a block whose conjugated entry lies in `M`, or
two consecutive blocks whose middle base entry does. -/
theorem exists_violation : ∀ (l : List (P × P)), ¬ Clean M l →
    (∃ (l₁ : List (P × P)) (q z : P) (l₂ : List (P × P)),
        l = l₁ ++ (q, z) :: l₂ ∧ q ∈ M) ∨
    (∃ (l₁ : List (P × P)) (q z q' z' : P) (l₂ : List (P × P)),
        l = l₁ ++ (q, z) :: (q', z') :: l₂ ∧ z ∈ M)
  | [], h => absurd trivial h
  | [p], h => by
      have hp : p.1 ∈ M := by
        by_contra hcon
        exact h hcon
      left
      exact ⟨[], p.1, p.2, [], by simp, hp⟩
  | p :: q :: l, h => by
      by_cases h1 : p.1 ∈ M
      · left
        exact ⟨[], p.1, p.2, q :: l, by simp, h1⟩
      · by_cases h2 : p.2 ∈ M
        · right
          exact ⟨[], p.1, p.2, q.1, q.2, l, by simp, h2⟩
        · have hrest : ¬ Clean M (q :: l) := by
            intro hc
            exact h ⟨h1, h2, hc⟩
          rcases exists_violation (q :: l) hrest with
            ⟨l₁, a, b, l₂, heq, hmem⟩ | ⟨l₁, a, b, a', b', l₂, heq, hmem⟩
          · left
            exact ⟨p :: l₁, a, b, l₂, by rw [heq]; simp, hmem⟩
          · right
            exact ⟨p :: l₁, a, b, a', b', l₂, by rw [heq]; simp, hmem⟩


/-! ## 7.  The descent -/

/-- A list is empty or ends in a single element.  Proved here rather than
cited, so that the descent does not depend on the spelling of Mathlib's
`concat` lemmas. -/
private theorem eq_nil_or_append_singleton {α : Type*} :
    ∀ l : List α, l = [] ∨ ∃ (L : List α) (b : α), l = L ++ [b]
  | [] => Or.inl rfl
  | a :: l => by
      rcases eq_nil_or_append_singleton l with rfl | ⟨L, b, hL⟩
      · exact Or.inr ⟨[], a, rfl⟩
      · exact Or.inr ⟨a :: L, b, by rw [hL]; simp⟩


variable (Z Q : Subgroup P)

/-- **The descent.**  A block word with entries in `Z` and `Q` that lands in
the base is a base element of `Z`.

The induction is on a length bound: each of the two collapses shortens the
list by one, and a list that admits neither is clean, where Britton's lemma
forces it to be empty. -/
theorem descent (hQZ : Q ⊓ M ≤ Z) (hZQ : Z ⊓ M ≤ Q) :
    ∀ (n : ℕ) (z₀ : P) (l : List (P × P)), l.length ≤ n →
      z₀ ∈ Z → (∀ p ∈ l, p.1 ∈ Q ∧ p.2 ∈ Z) →
      word M z₀ l ∈ (of : P →* CentHNN M).range →
      ∃ y ∈ Z, word M z₀ l = of y := by
  intro n
  induction n with
  | zero =>
      intro z₀ l hlen hz₀ _ _
      have hnil : l = [] := by
        cases l with
        | nil => rfl
        | cons a t => simp at hlen
      subst hnil
      exact ⟨z₀, hz₀, word_nil M z₀⟩
  | succ n ih =>
      intro z₀ l hlen hz₀ hinv hmem
      by_cases hc : Clean M l
      · have hnil : l = [] := eq_nil_of_clean M z₀ l hc hmem
        subst hnil
        exact ⟨z₀, hz₀, word_nil M z₀⟩
      · rcases exists_violation M l hc with
          ⟨l₁, q, z, l₂, heq, hqM⟩ | ⟨l₁, q, z, q', z', l₂, heq, hzM⟩
        · -- A block whose conjugated entry lies in `M`.
          subst heq
          have hqz : (q, z) ∈ l₁ ++ (q, z) :: l₂ := by simp
          obtain ⟨hqQ, hzZ⟩ := hinv (q, z) hqz
          have hqZ : q ∈ Z := hQZ ⟨hqQ, hqM⟩
          rcases eq_nil_or_append_singleton l₁ with rfl | ⟨l₁', p₀, rfl⟩
          · -- the block is the first one: it merges into the leading element
            have hrw : word M z₀ ([] ++ (q, z) :: l₂) = word M (z₀ * (q * z)) l₂ := by
              rw [List.nil_append, word_cons, blockOf_of_mem M q z hqM, ← map_mul]
              rfl
            have hlen' : l₂.length ≤ n := by
              simp only [List.nil_append, List.length_cons] at hlen
              omega
            have hz₀' : z₀ * (q * z) ∈ Z :=
              Subgroup.mul_mem Z hz₀ (Subgroup.mul_mem Z hqZ hzZ)
            have hinv' : ∀ p ∈ l₂, p.1 ∈ Q ∧ p.2 ∈ Z := by
              intro p hp
              exact hinv p (by simp [hp])
            have hmem' : word M (z₀ * (q * z)) l₂ ∈ (of : P →* CentHNN M).range := by
              rw [← hrw]
              exact hmem
            obtain ⟨y, hy, hyeq⟩ := ih (z₀ * (q * z)) l₂ hlen' hz₀' hinv' hmem'
            exact ⟨y, hy, by rw [hrw, hyeq]⟩
          · -- the block merges into the block before it
            obtain ⟨q₀, z₀'⟩ := p₀
            have hp₀ : (q₀, z₀') ∈ l₁' ++ [(q₀, z₀')] ++ (q, z) :: l₂ := by simp
            obtain ⟨hq₀Q, hz₀'Z⟩ := hinv (q₀, z₀') hp₀
            have hrw : word M z₀ (l₁' ++ [(q₀, z₀')] ++ (q, z) :: l₂)
                = word M z₀ (l₁' ++ (q₀, z₀' * (q * z)) :: l₂) := by
              rw [word_append, word_append]
              rw [List.map_append, List.prod_append, List.map_cons, List.prod_cons,
                List.map_cons, List.prod_cons, List.map_nil, List.prod_nil]
              rw [blockOf_of_mem M q z hqM, ← blockOf_mul_of M q₀ z₀' (q * z)]
              group
            have hlen' : (l₁' ++ (q₀, z₀' * (q * z)) :: l₂).length ≤ n := by
              simp only [List.length_append, List.length_cons, List.length_nil] at hlen ⊢
              omega
            have hinv' : ∀ p ∈ l₁' ++ (q₀, z₀' * (q * z)) :: l₂, p.1 ∈ Q ∧ p.2 ∈ Z := by
              intro p hp
              rcases List.mem_append.mp hp with hp' | hp'
              · exact hinv p (by simp [hp'])
              · rcases List.mem_cons.mp hp' with rfl | hp''
                · exact ⟨hq₀Q, Subgroup.mul_mem Z hz₀'Z (Subgroup.mul_mem Z hqZ hzZ)⟩
                · exact hinv p (by simp [hp''])
            have hmem' : word M z₀ (l₁' ++ (q₀, z₀' * (q * z)) :: l₂)
                ∈ (of : P →* CentHNN M).range := by
              rw [← hrw]
              exact hmem
            obtain ⟨y, hy, hyeq⟩ :=
              ih z₀ (l₁' ++ (q₀, z₀' * (q * z)) :: l₂) hlen' hz₀ hinv' hmem'
            exact ⟨y, hy, by rw [hrw, hyeq]⟩
        · -- Two blocks whose middle base entry lies in `M`.
          subst heq
          have hqz : (q, z) ∈ l₁ ++ (q, z) :: (q', z') :: l₂ := by simp
          have hqz' : (q', z') ∈ l₁ ++ (q, z) :: (q', z') :: l₂ := by simp
          obtain ⟨hqQ, hzZ⟩ := hinv (q, z) hqz
          obtain ⟨hq'Q, hz'Z⟩ := hinv (q', z') hqz'
          have hzQ : z ∈ Q := hZQ ⟨hzZ, hzM⟩
          have hrw : word M z₀ (l₁ ++ (q, z) :: (q', z') :: l₂)
              = word M z₀ (l₁ ++ (q * z * q', z') :: l₂) := by
            rw [word_append, word_append]
            rw [List.map_cons, List.prod_cons, List.map_cons, List.prod_cons,
              List.map_cons, List.prod_cons]
            rw [← blockOf_mul_blockOf M q z q' z' hzM]
            group
          have hlen' : (l₁ ++ (q * z * q', z') :: l₂).length ≤ n := by
            simp only [List.length_append, List.length_cons] at hlen ⊢
            omega
          have hinv' : ∀ p ∈ l₁ ++ (q * z * q', z') :: l₂, p.1 ∈ Q ∧ p.2 ∈ Z := by
            intro p hp
            rcases List.mem_append.mp hp with hp' | hp'
            · exact hinv p (by simp [hp'])
            · rcases List.mem_cons.mp hp' with rfl | hp''
              · exact ⟨Subgroup.mul_mem Q (Subgroup.mul_mem Q hqQ hzQ) hq'Q, hz'Z⟩
              · exact hinv p (by simp [hp''])
          have hmem' : word M z₀ (l₁ ++ (q * z * q', z') :: l₂)
              ∈ (of : P →* CentHNN M).range := by
            rw [← hrw]
            exact hmem
          obtain ⟨y, hy, hyeq⟩ :=
            ih z₀ (l₁ ++ (q * z * q', z') :: l₂) hlen' hz₀ hinv' hmem'
          exact ⟨y, hy, by rw [hrw, hyeq]⟩

/-! ## 8.  Every element of the generated subgroup is a block word -/

/-- The generating set: the image of `Z`, together with the conjugate of the
image of `Q` by the stable letter. -/
def genSet : Set (CentHNN M) :=
  ((Z.map (of : P →* CentHNN M)) : Set (CentHNN M)) ∪
    (((Q.map (of : P →* CentHNN M)).map (conjT M).toMonoidHom) : Set (CentHNN M))

theorem mem_genSet_of_inv_mem {y : CentHNN M} (h : y⁻¹ ∈ genSet M Z Q) :
    y ∈ genSet M Z Q := by
  rcases h with h | h
  · left
    have := Subgroup.inv_mem _ h
    rwa [inv_inv] at this
  · right
    have := Subgroup.inv_mem _ h
    rwa [inv_inv] at this

/-- Every element of `⟨Z, Qᵗ⟩` is a block word with entries in `Z` and `Q`. -/
theorem exists_blockForm {x : CentHNN M} (hx : x ∈ Subgroup.closure (genSet M Z Q)) :
    ∃ (z₀ : P) (l : List (P × P)), z₀ ∈ Z ∧ (∀ p ∈ l, p.1 ∈ Q ∧ p.2 ∈ Z) ∧
      x = word M z₀ l := by
  obtain ⟨L, hL, rfl⟩ := exists_list_of_mem_closure hx
  clear hx
  induction L with
  | nil =>
      refine ⟨1, [], Subgroup.one_mem Z, by simp, ?_⟩
      rw [List.prod_nil, word_nil, map_one]
  | cons y L ih =>
      have hLtail : ∀ u ∈ L, u ∈ genSet M Z Q ∨ u⁻¹ ∈ genSet M Z Q := by
        intro u hu
        exact hL u (List.mem_cons_of_mem _ hu)
      obtain ⟨z₀, l, hz₀, hinv, hprod⟩ := ih hLtail
      have hy : y ∈ genSet M Z Q := by
        rcases hL y List.mem_cons_self with h | h
        · exact h
        · exact mem_genSet_of_inv_mem M Z Q h
      rw [List.prod_cons, hprod]
      rcases hy with hy | hy
      · obtain ⟨a, ha, rfl⟩ := hy
        refine ⟨a * z₀, l, Subgroup.mul_mem Z ha hz₀, hinv, ?_⟩
        exact (of_mul_word M a z₀ l).symm
      · obtain ⟨u, hu, rfl⟩ := hy
        obtain ⟨qq, hqq, rfl⟩ := hu
        refine ⟨1, (qq, z₀) :: l, Subgroup.one_mem Z, ?_, ?_⟩
        · intro p hp
          rcases List.mem_cons.mp hp with rfl | hp'
          · exact ⟨hqq, hz₀⟩
          · exact hinv p hp'
        · rw [← conj_mul_word M qq z₀ l]
          show ((conjT M).toMonoidHom (of qq)) * word M z₀ l = _
          simp only [conjT_apply, inv_inv]

/-! ## 9.  The pinch lemma -/

/-- **The pinch lemma.**  `⟨Z, Qᵗ⟩ ∩ P = Z`, when `Z` and `Q` cover each
other's intersection with the centralized subgroup. -/
theorem pinch (hQZ : Q ⊓ M ≤ Z) (hZQ : Z ⊓ M ≤ Q) :
    Subgroup.closure (genSet M Z Q) ⊓ (of : P →* CentHNN M).range
      ≤ (Z.map (of : P →* CentHNN M)) := by
  rintro x ⟨hx₁, hx₂⟩
  obtain ⟨z₀, l, hz₀, hinv, rfl⟩ := exists_blockForm M Z Q hx₁
  obtain ⟨y, hy, hyeq⟩ :=
    descent M Z Q hQZ hZQ l.length z₀ l le_rfl hz₀ hinv hx₂
  rw [hyeq]
  exact ⟨y, hy, rfl⟩

end Pinch
end Higman
end GroupApproximation
