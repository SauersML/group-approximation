import GroupApproximation.Higman.MatchedSubgroupAmalgam
import GroupApproximation.Higman.PairedReturnGraphIntersection

/-!
# The five-generator paired-return cutter

This file instantiates `MatchedSubgroupAmalgam` at Higman's fixed conjugator
graph.  The right vertex group is `M × K`; its synchronized subgroup is the
range of

`K * K → M × K,  w ↦ (mu(w), fold(w))`.

The two exact comap identities are proved elementwise.  The resulting matched
sub-amalgam meets the left factor in precisely `Star.graphSub`.  The last
section identifies that matched subgroup with the subgroup generated by the
five literal elements `x, p_b, p_c, q_b, q_c`.
-/

namespace GroupApproximation
namespace Higman
namespace PairedReturnCutter

open Monoid
open scoped Monoid.Coprod
open Conj

/-- The four-generated edge group inside `P = F₃ × F₃`. -/
abbrev Edge : Type := ↥PairedReturnGraphIntersection.M

/-- The free synchronization group `K = ⟨b,c⟩`. -/
abbrev Sync : Type := ↥K

/-- The right vertex group of the final amalgam. -/
abbrev C : Type := Edge × Sync

/-- Inclusion of the edge in the left vertex group. -/
def edgeToP : Edge →* PairedReturnGraphIntersection.P :=
  PairedReturnGraphIntersection.M.subtype

/-- Inclusion of the edge as the first direct-product factor on the right. -/
def edgeToC : Edge →* C :=
  (MonoidHom.id Edge).prod (1 : Edge →* Sync)

@[simp] theorem edgeToC_apply (m : Edge) : edgeToC m = (m, 1) := rfl

/-- The synchronized transition map. -/
def transition : Monoid.Coprod Sync Sync →* C :=
  PairedReturnGraphIntersection.muToM.prod (PairedFoldKernel.fold Sync)

@[simp] theorem transition_apply (w : Monoid.Coprod Sync Sync) :
    transition w = (PairedReturnGraphIntersection.muToM w,
      PairedFoldKernel.fold Sync w) := rfl

/-- The synchronized right-factor subgroup generated by the two graph lifts. -/
def Q : Subgroup C := transition.range

/-- The left synchronized lift. -/
def leftLift : Sync →* C :=
  transition.comp (Monoid.Coprod.inl : Sync →* Monoid.Coprod Sync Sync)

/-- The right synchronized lift. -/
def rightLift : Sync →* C :=
  transition.comp (Monoid.Coprod.inr : Sync →* Monoid.Coprod Sync Sync)

@[simp] theorem leftLift_apply (h : Sync) :
    leftLift h = (PairedReturnGraphIntersection.muToM (Monoid.Coprod.inl h), h) := by
  rfl

@[simp] theorem rightLift_apply (h : Sync) :
    rightLift h = (PairedReturnGraphIntersection.muToM (Monoid.Coprod.inr h), h) := by
  rfl

theorem leftLift_mem_Q (h : Sync) : leftLift h ∈ Q :=
  ⟨Monoid.Coprod.inl h, rfl⟩

theorem rightLift_mem_Q (h : Sync) : rightLift h ∈ Q :=
  ⟨Monoid.Coprod.inr h, rfl⟩

/-- The synchronized subgroup returns to the edge precisely in `Delta`. -/
theorem Q_comap_edgeToC_eq_Delta :
    Q.comap edgeToC = PairedReturnGraphIntersection.Delta := by
  ext m
  constructor
  · intro hm
    obtain ⟨w, hw⟩ := hm
    have hfold : PairedFoldKernel.fold Sync w = 1 := by
      exact congrArg Prod.snd hw
    have hdelta : PairedReturnGraphIntersection.mu w ∈
        PairedReturnGraphIntersection.deltaSub :=
      PairedReturnGraphIntersection.fold_ker_le_mu_comap_deltaSub
        (MonoidHom.mem_ker.mpr hfold)
    have hfirst : PairedReturnGraphIntersection.muToM w = m := congrArg Prod.fst hw
    change (m : PairedReturnGraphIntersection.P) ∈
      PairedReturnGraphIntersection.deltaSub
    have hfirst' : PairedReturnGraphIntersection.mu w =
        (m : PairedReturnGraphIntersection.P) := congrArg Subtype.val hfirst
    rwa [hfirst'] at hdelta
  · intro hm
    have hmker : m ∈ PairedReturnGraphIntersection.psi.ker := by
      rw [PairedReturnGraphIntersection.psi_ker_eq_Delta]
      exact hm
    obtain ⟨w, hw⟩ := m.property
    have hmuToM : PairedReturnGraphIntersection.muToM w = m := Subtype.ext hw
    have hfold : PairedFoldKernel.fold Sync w = 1 := by
      have hpsi := PairedReturnGraphIntersection.psi_mu w
      rw [hmuToM, MonoidHom.mem_ker.mp hmker] at hpsi
      exact Subtype.ext hpsi.symm
    refine ⟨w, ?_⟩
    apply Prod.ext
    · exact hmuToM
    · exact hfold

/-- The graph has the same edge comap as the synchronized transition group. -/
theorem graphSub_comap_edgeToP_eq_Delta :
    Star.graphSub.comap edgeToP = PairedReturnGraphIntersection.Delta :=
  PairedReturnGraphIntersection.graphSub_comap_M_eq_Delta

theorem edgeToP_injective : Function.Injective edgeToP := Subtype.val_injective

theorem edgeToC_injective : Function.Injective edgeToC := by
  intro x y h
  exact congrArg Prod.fst h

/-- The final ambient amalgam `P *_M (M × K)`. -/
abbrev Ambient : Type := Amalgam.Push edgeToP edgeToC

/-- The subgroup generated by the graph on the left and the synchronized
transition group on the right. -/
def matchedCutter : Subgroup Ambient :=
  Subgroup.closure (MatchedSubgroupAmalgam.generatorSet
    edgeToP edgeToC Star.graphSub Q)

/-- **Concrete matched-subgroup intersection.** -/
theorem matchedCutter_inf_leftRange :
    matchedCutter ⊓
        (MatchedSubgroupAmalgam.bigInA edgeToP edgeToC).range =
      Star.graphSub.map
        (MatchedSubgroupAmalgam.bigInA edgeToP edgeToC) := by
  exact MatchedSubgroupAmalgam.generatorClosure_inf_leftRange edgeToP edgeToC
    Star.graphSub Q PairedReturnGraphIntersection.Delta
    edgeToP_injective edgeToC_injective
    graphSub_comap_edgeToP_eq_Delta Q_comap_edgeToC_eq_Delta

end PairedReturnCutter
end Higman
end GroupApproximation
