import GroupApproximation.Higman.PairedFoldKernel

/-!
# The first paired-return intersection

This is the concrete two-factor model behind the first exact intersection in
the paired-return cutter.  Put `D = K * K`.  Inside `D × K`, the two graph
lifts are

* `k ↦ (inl k, k)`, and
* `k ↦ (inr k, k)`.

Their generated subgroup is the range `Q` of the graph of the fold
`D → K`.  The first factor is `M = D × 1`, and the returning subgroup is
`Delta = ker(fold) × 1`.  Hence

`Q ∩ M = Delta`.

The proof below is an elementwise calculation in a direct product.  The
substantive kernel identification is imported from `PairedFoldKernel`, so for
a finite free group `Delta` is also identified with the normal closure of the
finitely many basis differences.  There are no construction hypotheses.
-/

namespace GroupApproximation
namespace Higman
namespace PairedReturnFirstIntersection

open scoped Monoid.Coprod
open PairedFoldKernel

variable (K : Type*) [Group K]

/-- The free product carrying the two input paths. -/
abbrev Double : Type* := Monoid.Coprod K K

/-- The left graph lift `k ↦ (inl k, k)`. -/
def leftLift : K →* Double K × K :=
  (Monoid.Coprod.inl : K →* Double K).prod (MonoidHom.id K)

/-- The right graph lift `k ↦ (inr k, k)`. -/
def rightLift : K →* Double K × K :=
  (Monoid.Coprod.inr : K →* Double K).prod (MonoidHom.id K)

/-- The common extension of the two graph lifts.  It is literally the graph
of the fold homomorphism. -/
def transition : Double K →* Double K × K :=
  (MonoidHom.id (Double K)).prod (fold K)

@[simp] theorem transition_apply (w : Double K) :
    transition K w = (w, fold K w) := rfl

@[simp] theorem transition_inl (k : K) :
    transition K (Monoid.Coprod.inl k) = leftLift K k := by
  simp [leftLift]

@[simp] theorem transition_inr (k : K) :
    transition K (Monoid.Coprod.inr k) = rightLift K k := by
  simp [rightLift]

/-- The graph map is exactly the coproduct extension of the two lifts. -/
theorem transition_eq_lift :
    transition K = Monoid.Coprod.lift (leftLift K) (rightLift K) := by
  refine Monoid.Coprod.hom_ext ?_ ?_
  · apply MonoidHom.ext
    intro k
    rw [transition_inl, Monoid.Coprod.lift_apply_inl]
  · apply MonoidHom.ext
    intro k
    rw [transition_inr, Monoid.Coprod.lift_apply_inr]

/-- The subgroup generated by the two synchronized graph lifts.  Since
`transition` is the coproduct extension of those lifts, its range is exactly
their generated subgroup. -/
def Q : Subgroup (Double K × K) := (transition K).range

/-- The first direct-product factor, viewed as the edge subgroup. -/
def M : Subgroup (Double K × K) :=
  (⊤ : Subgroup (Double K)).prod (⊥ : Subgroup K)

/-- The matched-return subgroup in the first factor. -/
def Delta : Subgroup (Double K × K) :=
  (fold K).ker.prod (⊥ : Subgroup K)

/-- Membership in `Q` is the concrete graph equation. -/
theorem mem_Q {x : Double K × K} :
    x ∈ Q K ↔ ∃ w : Double K, (w, fold K w) = x := by
  rw [Q, MonoidHom.mem_range]
  constructor
  · rintro ⟨w, hw⟩
    exact ⟨w, (transition_apply K w).symm.trans hw⟩
  · rintro ⟨w, rfl⟩
    exact ⟨w, transition_apply K w⟩

/-- **First exact paired-return intersection.**  A synchronized graph word
returns to the first factor exactly when its stable component lies in the
fold kernel. -/
theorem Q_inf_M_eq_Delta :
    Q K ⊓ M K = Delta K := by
  ext x
  constructor
  · intro hx
    obtain ⟨hxQ, hxM⟩ := Subgroup.mem_inf.mp hx
    obtain ⟨w, hw⟩ := mem_Q K |>.mp hxQ
    subst x
    obtain ⟨-, hstable⟩ := Subgroup.mem_prod.mp hxM
    refine Subgroup.mem_prod.mpr ⟨?_, hstable⟩
    exact Subgroup.mem_bot.mp hstable
  · intro hx
    obtain ⟨hfold, hstable⟩ := Subgroup.mem_prod.mp hx
    have hx2 : x.2 = 1 := Subgroup.mem_bot.mp hstable
    have hx1 : fold K x.1 = 1 := hfold
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · apply (mem_Q K).mpr
      refine ⟨x.1, ?_⟩
      apply Prod.ext
      · rfl
      · exact hx1.trans hx2.symm
    · exact Subgroup.mem_prod.mpr ⟨Subgroup.mem_top _, hstable⟩

/-- The returning subgroup is the copy-difference normal closure in the first
factor. -/
theorem Delta_eq_differenceRel_prod :
    Delta K =
      (differenceRel K Set.univ).prod (⊥ : Subgroup K) := by
  rw [Delta, fold_ker_eq_differenceRel]

/-- For a finite free basis, the first intersection is cut out by finitely
many explicit paired-return differences. -/
theorem freeGroup_Delta_eq_basisDifference_prod
    (α : Type*) [Fintype α] :
    Delta (FreeGroup α) =
      (Subgroup.normalClosure
        (difference (FreeGroup α) ''
          ((Finset.univ.image FreeGroup.of : Finset (FreeGroup α)) :
            Set (FreeGroup α))).prod
        (⊥ : Subgroup (FreeGroup α)) := by
  rw [Delta, freeGroup_fold_ker_eq_basisDifferences]

/-- The finite-basis version of the exact intersection, in one statement. -/
theorem freeGroup_Q_inf_M_eq_basisDifference_prod
    (α : Type*) [Fintype α] :
    Q (FreeGroup α) ⊓ M (FreeGroup α) =
      (Subgroup.normalClosure
        (difference (FreeGroup α) ''
          ((Finset.univ.image FreeGroup.of : Finset (FreeGroup α)) :
            Set (FreeGroup α))).prod
        (⊥ : Subgroup (FreeGroup α)) := by
  rw [Q_inf_M_eq_Delta, freeGroup_Delta_eq_basisDifference_prod]

end PairedReturnFirstIntersection
end Higman
end GroupApproximation
