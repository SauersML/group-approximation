import GroupApproximation.Higman.CentralHNNFreeLabelFaithful
import GroupApproximation.Higman.HNNDescent

/-!
# Coordinate subgroups in a central HNN kernel

The base-retraction kernel is freely based by right cosets of the centralized
subgroup.  This file identifies which of those free coordinates occur inside
the subgroup generated by a chosen base subgroup and the stable letter.
-/

namespace GroupApproximation
namespace Higman
namespace CentralHNNFreeLabel

open HNNExtension
open scoped Pointwise

variable {G : Type} [Group G] (M : Subgroup G)

noncomputable section

/-! ## Coordinate intersections in an arbitrary free group -/

namespace Coordinate

variable {ι : Type}

/-- Kill the free generators outside `S`. -/
noncomputable def killOutside (S : Set ι) : FreeGroup ι →* FreeGroup ι := by
  classical
  exact FreeGroup.lift (fun i => if i ∈ S then FreeGroup.of i else 1)

theorem killOutside_of_mem {S : Set ι} {i : ι} (hi : i ∈ S) :
    killOutside S (FreeGroup.of i) = FreeGroup.of i := by
  classical
  simp [killOutside, hi]

theorem killOutside_of_notMem {S : Set ι} {i : ι} (hi : i ∉ S) :
    killOutside S (FreeGroup.of i) = 1 := by
  classical
  simp [killOutside, hi]

theorem killOutside_fixes {S : Set ι} {w : FreeGroup ι}
    (hw : w ∈ Subgroup.closure (FreeGroup.of '' S)) :
    killOutside S w = w := by
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      exact killOutside_of_mem hi
  | one => simp
  | mul x y hx hy ihx ihy => simp [map_mul, ihx, ihy]
  | inv x hx ih => simp [map_inv, ih]

theorem killOutside_lands {S T : Set ι} {w : FreeGroup ι}
    (hw : w ∈ Subgroup.closure (FreeGroup.of '' T)) :
    killOutside S w ∈ Subgroup.closure (FreeGroup.of '' (S ∩ T)) := by
  classical
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      by_cases hS : i ∈ S
      · rw [killOutside_of_mem hS]
        exact Subgroup.subset_closure ⟨i, ⟨hS, hi⟩, rfl⟩
      · rw [killOutside_of_notMem hS]
        exact Subgroup.one_mem _
  | one => simp
  | mul x y hx hy ihx ihy => simpa only [map_mul] using Subgroup.mul_mem _ ihx ihy
  | inv x hx ih => simpa only [map_inv] using Subgroup.inv_mem _ ih

/-- Coordinate subgroups of every free group intersect on their index sets. -/
theorem closure_inter_le (S T : Set ι) :
    Subgroup.closure (FreeGroup.of '' S) ⊓
        Subgroup.closure (FreeGroup.of '' T) ≤
      Subgroup.closure (FreeGroup.of '' (S ∩ T)) := by
  rintro w ⟨hwS, hwT⟩
  have hfix := killOutside_fixes hwS
  have hland := killOutside_lands (S := S) hwT
  rwa [hfix] at hland

/-- A basis letter belongs to a coordinate subgroup only when its index is
one of the selected coordinates. -/
theorem index_mem_of_of_mem_closure {S : Set ι} {i : ι}
    (hi : FreeGroup.of i ∈ Subgroup.closure (FreeGroup.of '' S)) : i ∈ S := by
  classical
  by_contra hiS
  have hfix := killOutside_fixes hi
  rw [killOutside_of_notMem hiS] at hfix
  let exponent : FreeGroup ι →* Multiplicative ℤ :=
    FreeGroup.lift fun _ => Multiplicative.ofAdd 1
  have hone := congrArg exponent hfix.symm
  change Multiplicative.ofAdd (1 : ℤ) = 1 at hone
  have hzero : (1 : ℤ) = 0 := by
    simpa using congrArg (fun x : Multiplicative ℤ => Multiplicative.toAdd x) hone
  exact one_ne_zero hzero

/-- The image of a free word under a map of alphabets is supported on the
range of that alphabet map. -/
theorem map_mem_closure_range {κ : Type} (f : ι → κ) (w : FreeGroup ι) :
    FreeGroup.map f w ∈ Subgroup.closure (FreeGroup.of '' Set.range f) := by
  induction w using FreeGroup.induction_on with
  | C1 => simp
  | of i =>
      rw [FreeGroup.map.of]
      exact Subgroup.subset_closure ⟨f i, ⟨i, rfl⟩, rfl⟩
  | mul x y hx hy => simpa only [map_mul] using Subgroup.mul_mem _ hx hy
  | inv_of i hi =>
      rw [map_inv, FreeGroup.map.of]
      exact Subgroup.inv_mem _
        (Subgroup.subset_closure ⟨f i, ⟨i, rfl⟩, rfl⟩)

/-- Reflect support through an injective map of free alphabets. -/
theorem mem_closure_preimage_of_map_mem
    {κ : Type} {f : ι → κ} (hf : Function.Injective f)
    (T : Set κ) {w : FreeGroup ι}
    (hw : FreeGroup.map f w ∈ Subgroup.closure (FreeGroup.of '' T)) :
    w ∈ Subgroup.closure (FreeGroup.of '' (f ⁻¹' T)) := by
  have hrange := map_mem_closure_range f w
  have hinter : FreeGroup.map f w ∈
      Subgroup.closure (FreeGroup.of '' (Set.range f ∩ T)) :=
    closure_inter_le (Set.range f) T ⟨hrange, hw⟩
  have hle : Subgroup.closure (FreeGroup.of '' (Set.range f ∩ T)) ≤
      (Subgroup.closure (FreeGroup.of '' (f ⁻¹' T))).map (FreeGroup.map f) := by
    rw [Subgroup.closure_le]
    rintro _ ⟨j, ⟨⟨i, rfl⟩, hiT⟩, rfl⟩
    exact ⟨FreeGroup.of i,
      Subgroup.subset_closure ⟨i, hiT, rfl⟩, by rw [FreeGroup.map.of]⟩
  obtain ⟨v, hv, hvw⟩ := hle hinter
  have : v = w := FreeGroup.map_injective hf hvw
  rwa [← this]

end Coordinate

/-- Right-coset labels met by a base subgroup. -/
def labelSet (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) : Set (Label M d) :=
  (fun s : G => ((d.compl (1 : ℤˣ)).equiv s).2) '' (S : Set G)

/-- The free coordinate subgroup supported on the cosets met by `S`. -/
def labelSub (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) : Subgroup (FreeGroup (Label M d)) :=
  Subgroup.closure (FreeGroup.of '' labelSet M d S)

theorem of_label_mem_labelSub
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) {s : G} (hs : s ∈ S) :
    FreeGroup.of ((d.compl (1 : ℤˣ)).equiv s).2 ∈ labelSub M d S := by
  apply Subgroup.subset_closure
  exact ⟨((d.compl (1 : ℤˣ)).equiv s).2, ⟨s, hs, rfl⟩, rfl⟩

/-- The product region preserved by the subgroup generated by `S` and the
stable letter. -/
def Inside (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) (p : Space M d) : Prop :=
  p.1 ∈ S ∧ p.2 ∈ labelSub M d S

/-- Every element of `⟨S,t⟩` preserves `S × labelSub(S)` in both directions. -/
theorem action_inside_iff_of_mem_closure
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) {z : CentHNN M}
    (hz : z ∈ Subgroup.closure
      (HNNDescent.genSet (MulEquiv.refl M) S)) :
    ∀ p : Space M d, Inside M d S (action M d z p) ↔ Inside M d S p := by
  induction hz using Subgroup.closure_induction with
  | mem z hz =>
      intro p
      rcases hz with hz | hz
      · obtain ⟨s, hs, rfl⟩ := hz
        rcases p with ⟨x, w⟩
        simp only [Inside, action_of, basePerm_apply]
        constructor
        · rintro ⟨hsx, hw⟩
          exact ⟨by
            have hmem := S.mul_mem (S.inv_mem hs) hsx
            simpa [mul_assoc] using hmem, hw⟩
        · rintro ⟨hx, hw⟩
          exact ⟨S.mul_mem hs hx, hw⟩
      · rw [Set.mem_singleton_iff] at hz
        subst z
        rcases p with ⟨x, w⟩
        simp only [Inside, action_t, stablePerm_apply]
        constructor
        · rintro ⟨hx, hlw⟩
          have hl := of_label_mem_labelSub M d S hx
          exact ⟨hx, by
            have := (labelSub M d S).mul_mem ((labelSub M d S).inv_mem hl) hlw
            simpa [mul_assoc] using this⟩
        · rintro ⟨hx, hw⟩
          exact ⟨hx, (labelSub M d S).mul_mem
            (of_label_mem_labelSub M d S hx) hw⟩
  | one => intro p; simp [Inside]
  | mul x y hx hy ihx ihy =>
      intro p
      rw [map_mul, Equiv.Perm.mul_apply, ihx, ihy]
  | inv x hx ih =>
      intro p
      rw [map_inv]
      have h := ih ((action M d x)⁻¹ p)
      simpa using h.symm

/-- Words supported on the labels met by `S` map into `⟨S,t⟩`. -/
theorem stableConjLift_mem_closure_of_mem_labelSub
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) {w : FreeGroup (Label M d)}
    (hw : w ∈ labelSub M d S) :
    stableConjLift M d w ∈ Subgroup.closure
      (HNNDescent.genSet (MulEquiv.refl M) S) := by
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨q, ⟨s, hs, hsq⟩, rfl⟩ := hx
      have hof : of s ∈ Subgroup.closure
          (HNNDescent.genSet (MulEquiv.refl M) S) :=
        Subgroup.subset_closure (Set.mem_union_left _ ⟨s, hs, rfl⟩)
      have ht : (t : CentHNN M) ∈ Subgroup.closure
          (HNNDescent.genSet (MulEquiv.refl M) S) :=
        Subgroup.subset_closure (Set.mem_union_right _ rfl)
      simp only [stableConjLift, FreeGroup.lift_apply_of]
      rw [stableConj_eq_conj_of_label_eq M d q s hsq]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hof) ht) hof
  | one => simp
  | mul x y hx hy ihx ihy => simpa only [map_mul] using Subgroup.mul_mem _ ihx ihy
  | inv x hx ih => simpa only [map_inv] using Subgroup.inv_mem _ ih

/-- **Coordinate form of the matched-spelling theorem.**  Inside the kernel
of the base retraction, `⟨S,t⟩` is exactly the free subgroup supported on the
right cosets met by `S`. -/
theorem closure_inf_ker_baseRet
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) :
    Subgroup.closure (HNNDescent.genSet (MulEquiv.refl M) S) ⊓
        (baseRet M).ker =
      (labelSub M d S).map (stableConjLift M d) := by
  apply le_antisymm
  · intro z hz
    have hzrange : z ∈ (stableConjLift M d).range := by
      rw [range_stableConjLift_eq_ker_baseRet]
      exact hz.2
    obtain ⟨w, rfl⟩ := hzrange
    have hinside := (action_inside_iff_of_mem_closure M d S hz.1
      ((1 : G), (1 : FreeGroup (Label M d)))).2
      ⟨Subgroup.one_mem S, Subgroup.one_mem (labelSub M d S)⟩
    rw [action_stableConjLift_apply_one] at hinside
    exact ⟨w, hinside.2, rfl⟩
  · rintro z ⟨w, hw, rfl⟩
    constructor
    · exact stableConjLift_mem_closure_of_mem_labelSub M d S hw
    · change baseRet M (stableConjLift M d w) = 1
      rw [← MonoidHom.comp_apply, baseRet_comp_stableConjLift]
      rfl

end

end CentralHNNFreeLabel
end Higman
end GroupApproximation
