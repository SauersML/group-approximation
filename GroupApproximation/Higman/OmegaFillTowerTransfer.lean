import GroupApproximation.Higman.OmegaTowerInterfaceCounterexample

/-!
# Morphisms of `ωₘ` towers, and the transfer of the descent

`Higman.OmegaTower` splits the `ωₘ` closure into two obligations on a single
tower (`Omega.TowerClosure`): `W_B` is benign, and `F₃ ∩ W_B ≤ A_{ωₘ B}`.
Mikaelian's construction does **not** discharge them in the same group.  The
normal-form half is run in the slim tower `Ω′`, which is built over the free
group `⟨b, c⟩` and whose full relation list is therefore available; the
benignness half is run in the fat tower `Ω`, which is built over benign
witnesses and is finitely presented.  The two are joined by his Lemma 2.4,
which this repository has as `HNNSubextension.injective_of_isSubextensionHom`.

This file supplies the joint at the level of the tower interface.  A
`TowerHom` is a homomorphism of the ambient groups matching the three pieces
of data that `Omega.W` is built from --- the embedded copy of `F₃`, the block
generators, and the stable letter.  Then `W` is functorial
(`TowerHom.map_W`), so an **injective** `TowerHom` carries the descent
*forward*:

    descent for `T`  +  injective `TowerHom T T'`  ⟹  descent for `T'` ,

with no exactness hypothesis on the image, because `W T' B` is by construction
the image of `W T B`.  Combined with benignness of `W T' B` this inhabits
`Omega.TowerClosure T' B`, and hence discharges `ωₘ` at `B`
(`benignTF_ASub_omegaOp_of_towerHom`).

The direction matters: the descent transfers along an injection *out of* the
tower that has it, so the group with the normal form is the *source*.  Taking
`T = T'` and the identity morphism recovers the one-tower statement
(`benignTF_ASub_omegaOp_of_descent`), which is the shape the slim tower's own
descent consumes.

`no_injective_towerHom_of_twoSidedRowsCommute` records the constraint this
puts on the target: a tower whose block generators centralize the rows on both
sides of the window cannot receive an injective morphism from a tower with the
descent.  It is `OmegaTowerInterfaceCounterexample` read as a statement about
the *link*, not about the interface, and it is the reason the fat tower's
second stage has to be sheared rather than taken over a direct product.
-/

namespace GroupApproximation
namespace Higman
namespace Omega

open GroupApproximation.Higman.Conj
open GroupApproximation.Higman.Seq

/-! ## 1.  Morphisms -/

/-- **A morphism of `ωₘ` towers.**  Only the three pieces of data that
`Omega.W` is built from have to be respected; the three defining relations of
`Omega.Tower` are then automatic on the image, being equations between the
images of the elements they relate. -/
structure TowerHom {m : ℕ} (T T' : Tower m) where
  /-- The homomorphism of ambient groups. -/
  map : T.G →* T'.G
  /-- It carries the embedded copy of `F₃` to the embedded copy of `F₃`. -/
  map_emb : ∀ x : F₃, map (T.emb x) = T'.emb x
  /-- ... the block generator `g_β` to the block generator `g_β`. -/
  map_gen : ∀ β ∈ blockSet m, map (T.gen β) = T'.gen β
  /-- ... and the stable letter to the stable letter. -/
  map_stable : map T.stable = T'.stable

/-- The identity morphism. -/
def TowerHom.refl {m : ℕ} (T : Tower m) : TowerHom T T where
  map := MonoidHom.id T.G
  map_emb _ := rfl
  map_gen _ _ := rfl
  map_stable := rfl

@[simp] theorem TowerHom.refl_map {m : ℕ} (T : Tower m) :
    (TowerHom.refl T).map = MonoidHom.id T.G := rfl

/-- Morphisms compose. -/
def TowerHom.comp {m : ℕ} {T T' T'' : Tower m} (Ψ : TowerHom T' T'')
    (Φ : TowerHom T T') : TowerHom T T'' where
  map := Ψ.map.comp Φ.map
  map_emb x := by
    show Ψ.map (Φ.map (T.emb x)) = T''.emb x
    rw [Φ.map_emb x, Ψ.map_emb x]
  map_gen β hβ := by
    show Ψ.map (Φ.map (T.gen β)) = T''.gen β
    rw [Φ.map_gen β hβ, Ψ.map_gen β hβ]
  map_stable := by
    show Ψ.map (Φ.map T.stable) = T''.stable
    rw [Φ.map_stable, Ψ.map_stable]

@[simp] theorem TowerHom.comp_map {m : ℕ} {T T' T'' : Tower m}
    (Ψ : TowerHom T' T'') (Φ : TowerHom T T') :
    (Ψ.comp Φ).map = Ψ.map.comp Φ.map := rfl

/-! ## 2.  `W` is functorial -/

/-- The block generators of `B` go to the block generators of `B`. -/
theorem TowerHom.image_gen {m : ℕ} {T T' : Tower m} (Φ : TowerHom T T')
    (B : Set E) :
    Φ.map '' (T.gen '' (B ∩ blockSet m)) = T'.gen '' (B ∩ blockSet m) := by
  rw [Set.image_image]
  exact Set.image_congr fun β hβ => Φ.map_gen β hβ.2

/-- **`W_B` is the image of `W_B`.**  This is the whole content of the
transfer: the target's `W` is not merely contained in the image of the
source's, it *is* that image, because both are generated by corresponding
lists. -/
theorem TowerHom.map_W {m : ℕ} {T T' : Tower m} (Φ : TowerHom T T')
    (B : Set E) : (W T B).map Φ.map = W T' B := by
  unfold W
  rw [MonoidHom.map_closure, Set.image_union, Φ.image_gen B,
    Set.image_insert_eq, Set.image_singleton, Φ.map_emb a, Φ.map_stable]

/-! ## 3.  The descent transfers forward along an injection -/

/-- **An injective morphism carries the descent to the target.**  No
hypothesis on the image is needed: `W T' B` is the image of `W T B`, so an
element of `F₃` landing in `W T' B` already lands in `W T B` before the
injection. -/
theorem TowerHom.descent {m : ℕ} {T T' : Tower m} (Φ : TowerHom T T')
    (hinj : Function.Injective Φ.map) {B : Set E}
    (hd : ∀ x : F₃, T.emb x ∈ W T B → x ∈ ASub (omegaOp m B)) :
    ∀ x : F₃, T'.emb x ∈ W T' B → x ∈ ASub (omegaOp m B) := by
  intro x hx
  rw [← Φ.map_W B, ← Φ.map_emb x, Subgroup.mem_map] at hx
  obtain ⟨y, hy, hyx⟩ := hx
  rw [hinj hyx] at hy
  exact hd x hy

/-- **The two obligations, discharged in two groups.**  The descent is proved
in `T`, the benignness in `T'`, and an injective morphism joins them. -/
theorem towerClosure_of_towerHom {m : ℕ} {T T' : Tower m} (Φ : TowerHom T T')
    (hinj : Function.Injective Φ.map) {B : Set E}
    (hd : ∀ x : F₃, T.emb x ∈ W T B → x ∈ ASub (omegaOp m B))
    (hb : BenignTF (W T' B)) : TowerClosure T' B where
  benign := hb
  descent := Φ.descent hinj hd

/-- **Higman's `ωₘ` closure at `B`, from a linked pair of towers.** -/
theorem benignTF_ASub_omegaOp_of_towerHom {m : ℕ} (hm : 0 < m)
    {T T' : Tower m} (Φ : TowerHom T T')
    (hinj : Function.Injective Φ.map) {B : Set E} (h0 : (0 : E) ∈ B)
    (hd : ∀ x : F₃, T.emb x ∈ W T B → x ∈ ASub (omegaOp m B))
    (hb : BenignTF (W T' B)) : BenignTF (ASub (omegaOp m B)) :=
  benignTF_ASub_omegaOp_of_tower hm T' h0
    (towerClosure_of_towerHom Φ hinj hd hb)

/-- **The one-tower case**, which is the linked statement at the identity
morphism: a single tower with both the descent and a benign `W_B` closes
`ωₘ` at `B`. -/
theorem benignTF_ASub_omegaOp_of_descent {m : ℕ} (hm : 0 < m) (T : Tower m)
    {B : Set E} (h0 : (0 : E) ∈ B)
    (hd : ∀ x : F₃, T.emb x ∈ W T B → x ∈ ASub (omegaOp m B))
    (hb : BenignTF (W T B)) : BenignTF (ASub (omegaOp m B)) :=
  benignTF_ASub_omegaOp_of_tower hm T h0 ⟨hb, hd⟩

/-! ## 4.  Pushing a tower forward

The target of the transfer is never built from scratch: it is the same tower
read inside a larger group.  So the only datum a construction has to produce
is an injective homomorphism out of `T.G`; the three relations of
`Omega.Tower` are then images of `T`'s, and the morphism is the map itself. -/

/-- **A tower, read inside a larger group.**  Every relation is the image of
the corresponding relation of `T`. -/
def Tower.pushforward {m : ℕ} (T : Tower m) {H : Type} [Group H]
    (Ψ : T.G →* H) (hΨ : Function.Injective Ψ) : Tower m where
  G := H
  emb := Ψ.comp T.emb
  emb_injective := hΨ.comp T.emb_injective
  gen β := Ψ (T.gen β)
  stable := Ψ T.stable
  conj_stable x := by
    show (Ψ T.stable)⁻¹ * Ψ (T.emb x) * Ψ T.stable = Ψ (T.emb _)
    rw [← map_inv, ← map_mul, ← map_mul, T.conj_stable x]
  conj_gen β hβ := by
    show (Ψ (T.gen β))⁻¹ * Ψ (T.emb a) * Ψ (T.gen β) = Ψ (T.emb (aElt β))
    rw [← map_inv, ← map_mul, ← map_mul, T.conj_gen β hβ]
  commute_row β hβ i hi := (T.commute_row β hβ i hi).map Ψ

/-- The tautological morphism into a pushforward. -/
def TowerHom.push {m : ℕ} (T : Tower m) {H : Type} [Group H] (Ψ : T.G →* H)
    (hΨ : Function.Injective Ψ) : TowerHom T (T.pushforward Ψ hΨ) where
  map := Ψ
  map_emb _ := rfl
  map_gen _ _ := rfl
  map_stable := rfl

@[simp] theorem TowerHom.push_map {m : ℕ} (T : Tower m) {H : Type} [Group H]
    (Ψ : T.G →* H) (hΨ : Function.Injective Ψ) :
    (TowerHom.push T Ψ hΨ).map = Ψ := rfl

/-- **`ωₘ` at `B` from an injective homomorphism alone.**  The descent is
proved in `T`; the benignness is asked of the image of `W_B` in whatever group
`Ψ` lands in. -/
theorem benignTF_ASub_omegaOp_of_pushforward {m : ℕ} (hm : 0 < m) (T : Tower m)
    {H : Type} [Group H] (Ψ : T.G →* H) (hΨ : Function.Injective Ψ)
    {B : Set E} (h0 : (0 : E) ∈ B)
    (hd : ∀ x : F₃, T.emb x ∈ W T B → x ∈ ASub (omegaOp m B))
    (hb : BenignTF (W (T.pushforward Ψ hΨ) B)) :
    BenignTF (ASub (omegaOp m B)) :=
  benignTF_ASub_omegaOp_of_towerHom hm (TowerHom.push T Ψ hΨ) hΨ h0 hd hb

/-! ## 5.  What the target may not be

The counterexample of `OmegaTowerInterfaceCounterexample` is stated there as a
no-go for a *strengthening of the interface*.  Read through the transfer it
becomes a constraint on the group the descent is carried into: the target of
an injective morphism out of a tower with the descent may not centralize the
rows on the left of the window.  A fat second stage taken over a direct
product does exactly that, so it cannot be the target; the link has to be
sheared so that the block generator and the rows stay in one noncommuting
factor. -/

/-- **No injective morphism into a two-sided tower.**  If `T` has the descent
at the maximal one-block alphabet, then no tower whose block generators
centralize every row receives `T` injectively. -/
theorem no_injective_towerHom_of_twoSidedRowsCommute {T T' : Tower 1}
    (Φ : TowerHom T T') (hinj : Function.Injective Φ.map)
    (htwo : TwoSidedRowsCommute T')
    (hd : ∀ x : F₃, T.emb x ∈ W T (blockSet 1) →
      x ∈ ASub (omegaOp 1 (blockSet 1))) : False :=
  not_tower_descent_one_blockSet T' htwo (Φ.descent hinj hd)

end Omega
end Higman
end GroupApproximation
