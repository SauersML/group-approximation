import GroupApproximation.Higman.SeqFilter
import GroupApproximation.Higman.Operations

/-!
# Higman's operations `ζ` and `π`

Both of these operations say the same thing with a different set of
coordinates:

* `ζ B` --- the sequences agreeing with a member of `B` off the coordinate `0`;
* `π B` --- the sequences agreeing with a member of `B` on the coordinates
  `i ≤ 0`.

So both are `agreeOp p` for a predicate `p` on the index set, and this file
proves *one* closure theorem, `benignTF_ASub_agreeOp`, and reads `ζ` and `π`
off it.

## The identity

Write `V` for a subgroup of `FreeGroup ℤ` that is

* **killed** by the deletion retraction `killOn p` (`hle`), and
* **big enough** to contain the ratio `(elt g)⁻¹ · elt f` of the codes of any
  two sequences agreeing on `p` (`hcov`).

Then, with `A(S)` the subgroup generated by the conjugates `a^u`, `u ∈ S`
(`Higman.Coord`),

    b '' (agreeOp p B)  =  (b '' B) · rowHom V  ∩  range b ,

which is `bElt_image_agreeOp`.  The forward inclusion is `hcov`; the reverse
one is `hle` together with `Split.agree_of_mul_ker`: the deletion retraction
computes the filtered sequence, so it turns "the codes differ by something
`killOn p` kills" into "the sequences agree on `p`", and `elt` is injective.
No manipulation of the sorted list defining `elt` occurs in either direction.

Translating through `Higman.Coord`,

    A_{agreeOp p B} = ((A_B ⊔ rowHom V) ⊓ ker retK) ⊓ A_{all sequences} ,

a join, a meet with the benign `ker retK`, and a meet.  So the closure holds as
soon as two subgroups are benign: `rowHom V`, and the subgroup of **all** coded
sequences.

## The two inputs, and what they are

`rowHom V` is, for the two instantiations:

* `π`: the **positive half-row** `⟨bᵢ : i > 0⟩`.  This is Higman's Example 3.7,
  for which `Higman.RowKernel` and `Higman.HalfRowEndo` already build the
  machinery (the endomorphisms `ξ₀, ξ₁`, their injectivity, and the two-way
  stability of the half row) --- everything except the two-stable-letter HNN
  extension and the descent, which `Higman.HNNDescent.closure_inf_range`
  supplies in the exact shape needed.
* `ζ`: the **normal closure of `b` in the row**, `ker (killOn (· ≠ 0))`
  transported.  A smaller choice would do --- `hcov` only asks for the
  conjugates `b^v` with `v` a coded positive sequence --- but the kernel is
  the one for which `hle` is a definition.

`A_{all sequences}` is `Seq.ASub Set.univ`.  It is **not** a weaker statement
than the closures proved here: `piOp_nonpos_eq_univ` below exhibits
`Set.univ` as `piOp` of the sequences supported in `i ≤ 0`, so this input is
one instance of `π` itself.  It is recorded as a separate input rather than
hidden, because that is where the honest boundary of this file lies.

Both are stated as fields of `AgreeInputs` and **nothing inhabits it.**
-/

namespace GroupApproximation
namespace Higman
namespace Agree

open GroupApproximation.Higman.Conj
open GroupApproximation.Higman.Seq
open GroupApproximation.Higman.Split
open scoped Pointwise

/-! ## 1.  The common shape of `ζ` and `π` -/

/-- The sequences agreeing with a member of `B` on the coordinates satisfying
`p`. -/
def agreeOp (p : ℤ → Prop) (B : Set E) : Set E := {f | ∃ g ∈ B, ∀ i, p i → f i = g i}

theorem zetaOp_eq_agreeOp (B : Set E) : zetaOp B = agreeOp (fun i : ℤ => i ≠ 0) B := rfl

theorem piOp_eq_agreeOp (B : Set E) : piOp B = agreeOp (fun i : ℤ => i ≤ 0) B := rfl

/-! ## 2.  Subgroups of the row, inside `F₃` -/

/-- A subgroup of `FreeGroup ℤ`, carried into `F₃` along the row coding. -/
def rowSub (V : Subgroup (FreeGroup ℤ)) : Subgroup F₃ := V.map rowHom

theorem rowSub_le_K (V : Subgroup (FreeGroup ℤ)) : rowSub V ≤ K := by
  rintro _ ⟨w, _, rfl⟩
  exact rowHom_mem_K w

theorem bElt_eq_rowHom (f : E) : bElt f = rowHom (elt f) := rfl

theorem bElt_image_subset_K (B : Set E) : bElt '' B ⊆ (K : Set F₃) := by
  rintro _ ⟨f, _, rfl⟩
  exact bElt_mem_K f

theorem range_bElt_subset_K : Set.range bElt ⊆ (K : Set F₃) := by
  rintro _ ⟨f, rfl⟩
  exact bElt_mem_K f

/-! ## 3.  The index-set identity -/

/-- **The coded index set of an agreement class.** -/
theorem bElt_image_agreeOp (p : ℤ → Prop) [DecidablePred p]
    {V : Subgroup (FreeGroup ℤ)} (hle : V ≤ MonoidHom.ker (killOn p))
    (hcov : ∀ f g : E, (∀ i, p i → f i = g i) → (elt g)⁻¹ * elt f ∈ V) (B : Set E) :
    bElt '' (agreeOp p B) = ((bElt '' B) * (rowSub V : Set F₃)) ∩ Set.range bElt := by
  refine Set.ext fun x => ?_
  constructor
  · rintro ⟨f, ⟨g, hg, hagree⟩, rfl⟩
    refine ⟨⟨bElt g, ⟨g, hg, rfl⟩, rowHom ((elt g)⁻¹ * elt f), ?_, ?_⟩, ⟨f, rfl⟩⟩
    · exact ⟨(elt g)⁻¹ * elt f, hcov f g hagree, rfl⟩
    · show bElt g * rowHom ((elt g)⁻¹ * elt f) = bElt f
      rw [bElt_eq_rowHom, bElt_eq_rowHom, ← map_mul]
      congr 1
      group
  · rintro ⟨⟨_, ⟨g, hg, rfl⟩, w, hw, rfl⟩, ⟨f, hf⟩⟩
    obtain ⟨w₀, hw₀, rfl⟩ := hw
    have hcode : elt f = elt g * w₀ := by
      refine rowHom_injective ?_
      rw [map_mul, ← bElt_eq_rowHom, ← bElt_eq_rowHom]
      exact hf
    have hker : killOn p w₀ = 1 := MonoidHom.mem_ker.mp (hle hw₀)
    exact ⟨f, ⟨g, hg, agree_of_mul_ker hker hcode⟩, hf⟩

/-! ## 4.  The subgroup identity -/

/-- **The subgroup of an agreement class**: a join, a meet with the kernel of
the retraction, and a meet with the subgroup of all coded sequences. -/
theorem ASub_agreeOp (p : ℤ → Prop) [DecidablePred p]
    {V : Subgroup (FreeGroup ℤ)} (hle : V ≤ MonoidHom.ker (killOn p))
    (hcov : ∀ f g : E, (∀ i, p i → f i = g i) → (elt g)⁻¹ * elt f ∈ V) (B : Set E) :
    ASub (agreeOp p B)
      = ((ASub B ⊔ rowSub V) ⊓ MonoidHom.ker Coord.retK) ⊓ ASub (Set.univ : Set E) := by
  have hmul : (bElt '' B) * (rowSub V : Set F₃) ⊆ (K : Set F₃) := by
    rintro _ ⟨y, hy, u, hu, rfl⟩
    exact K.mul_mem (bElt_image_subset_K B hy) (rowSub_le_K V hu)
  have huniv : ASub (Set.univ : Set E) = Coord.Aset (Set.range bElt) := by
    rw [Coord.ASub_eq_Aset, Set.image_univ]
  rw [Coord.ASub_eq_Aset, bElt_image_agreeOp p hle hcov B,
    Coord.Aset_inter hmul range_bElt_subset_K,
    ← Coord.Aset_mul_subgroup (bElt_image_subset_K B) (rowSub_le_K V),
    ← Coord.ASub_eq_Aset, ← huniv]

/-! ## 5.  The closure theorem -/

/-- **Closure of benignness under an agreement operation.** -/
theorem benignTF_ASub_agreeOp (p : ℤ → Prop) [DecidablePred p]
    {V : Subgroup (FreeGroup ℤ)} (hle : V ≤ MonoidHom.ker (killOn p))
    (hcov : ∀ f g : E, (∀ i, p i → f i = g i) → (elt g)⁻¹ * elt f ∈ V)
    (hV : BenignTF (rowSub V)) (hall : BenignTF (ASub (Set.univ : Set E)))
    {B : Set E} (hB : BenignTF (ASub B)) : BenignTF (ASub (agreeOp p B)) := by
  letI : Group.FG F₃ := ProductFinitePresentation.fg_of_isFinitelyPresented F₃
  rw [ASub_agreeOp p hle hcov B]
  exact BenignTF.inf (BenignTF.inf (BenignTF.sup hB hV) Coord.benignTF_ker_retK) hall

/-- **The canonical choice of `V`: everything the deletion kills.**

With `V = ker (killOn p)` both hypotheses of `benignTF_ASub_agreeOp` are
automatic --- `hle` is `le_rfl` and `hcov` is `Split.killOn_ratio_eq_one`,
which is already general in `p`.  So a *new* agreement operation costs exactly
one benignness statement and no covariance work at all.

This is the entry point for any agreement operation beyond `ζ` and `π` ---
`θ`, whose residual is `agreeOp (fun i => ∃ k, i = 2 * k)`, included. -/
theorem benignTF_ASub_agreeOp_ker (p : ℤ → Prop) [DecidablePred p]
    (hV : BenignTF (rowSub (MonoidHom.ker (killOn p))))
    (hall : BenignTF (ASub (Set.univ : Set E)))
    {B : Set E} (hB : BenignTF (ASub B)) : BenignTF (ASub (agreeOp p B)) :=
  benignTF_ASub_agreeOp p le_rfl
    (fun _ _ h => MonoidHom.mem_ker.mpr (killOn_ratio_eq_one h)) hV hall hB

/-! ## 6.  The two instantiations -/

/-- The subgroup of `FreeGroup ℤ` used for `ζ`: everything the deletion of the
coordinate `0` kills, i.e. the normal closure of `of 0`. -/
def zetaV : Subgroup (FreeGroup ℤ) := MonoidHom.ker (killOn (fun i : ℤ => i ≠ 0))

/-- The subgroup of `FreeGroup ℤ` used for `π`: the strictly positive
coordinate subgroup.  Its image in `F₃` is the positive half-row. -/
def piV : Subgroup (FreeGroup ℤ) :=
  Subgroup.closure (FreeGroup.of '' {i : ℤ | ¬ i ≤ 0})

theorem zetaV_le : zetaV ≤ MonoidHom.ker (killOn (fun i : ℤ => i ≠ 0)) := le_rfl

theorem zetaV_cov (f g : E) (h : ∀ i, (i ≠ 0) → f i = g i) :
    (elt g)⁻¹ * elt f ∈ zetaV :=
  MonoidHom.mem_ker.mpr (killOn_ratio_eq_one h)

theorem piV_le : piV ≤ MonoidHom.ker (killOn (fun i : ℤ => i ≤ 0)) := by
  intro w hw
  exact MonoidHom.mem_ker.mpr (killOn_eq_one_of_mem_closure hw)

/-- The positive part of a sequence codes into the positive coordinate
subgroup. -/
theorem elt_filter_pos_mem (f : E) :
    elt (Finsupp.filter (fun i : ℤ => ¬ i ≤ 0) f) ∈ piV := by
  refine elt_mem_closure fun i hi => ?_
  rw [Finsupp.support_filter, Finset.mem_filter] at hi
  exact hi.2

theorem piV_cov (f g : E) (h : ∀ i, (i ≤ 0) → f i = g i) :
    (elt g)⁻¹ * elt f ∈ piV := by
  have hfil : Finsupp.filter (fun i : ℤ => i ≤ 0) f
      = Finsupp.filter (fun i : ℤ => i ≤ 0) g := filter_eq_iff_agree.mpr h
  have hsf := elt_split 0 f
  have hsg := elt_split 0 g
  have hratio : (elt g)⁻¹ * elt f
      = (elt (Finsupp.filter (fun i : ℤ => ¬ i ≤ 0) g))⁻¹
        * elt (Finsupp.filter (fun i : ℤ => ¬ i ≤ 0) f) := by
    rw [hsf, hsg, hfil]
    group
  rw [hratio]
  exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (elt_filter_pos_mem g)) (elt_filter_pos_mem f)

/-! ## 7.  What is still owed -/

/-- **Input: the two benign subgroups the agreement closures need.**

`half` is Higman's Example 3.7 (the positive half-row is benign); `zeta` is the
normal closure of `b` in the row; `all` is the subgroup of all coded
sequences.

**Nothing inhabits this structure.** -/
structure AgreeInputs where
  /-- The positive half-row `⟨bᵢ : i > 0⟩` is benign. -/
  half : BenignTF (rowSub piV)
  /-- The normal closure of `b` in the row is benign. -/
  zeta : BenignTF (rowSub zetaV)
  /-- The subgroup of all coded sequences is benign. -/
  all : BenignTF (ASub (Set.univ : Set E))

/-- **Higman's operation `ζ` preserves benignness.** -/
theorem benignTF_ASub_zetaOp (h : AgreeInputs) (B : Set E)
    (hB : BenignTF (ASub B)) : BenignTF (ASub (zetaOp B)) := by
  rw [zetaOp_eq_agreeOp]
  exact benignTF_ASub_agreeOp _ zetaV_le zetaV_cov h.zeta h.all hB

/-- **Higman's operation `π` preserves benignness.** -/
theorem benignTF_ASub_piOp (h : AgreeInputs) (B : Set E)
    (hB : BenignTF (ASub B)) : BenignTF (ASub (piOp B)) := by
  rw [piOp_eq_agreeOp]
  exact benignTF_ASub_agreeOp _ piV_le piV_cov h.half h.all hB

/-! ## 8.  The third input is one instance of the first two

`Set.univ` is `piOp` of the sequences supported in `i ≤ 0`, so
`AgreeInputs.all` is not an independent weakening: it is the value of `π` at
one explicit set.  Recording this keeps the boundary honest --- the input
cannot be discharged by any argument that itself runs through `π`. -/
theorem piOp_nonpos_eq_univ :
    piOp {f : E | ∀ i : ℤ, ¬ i ≤ 0 → f i = 0} = (Set.univ : Set E) := by
  refine Set.eq_univ_of_forall fun f => ?_
  refine ⟨Finsupp.filter (fun i : ℤ => i ≤ 0) f, ?_, ?_⟩
  · intro i hi
    rw [Finsupp.filter_apply, if_neg hi]
  · intro i hi
    rw [Finsupp.filter_apply, if_pos hi]

end Agree
end Higman
end GroupApproximation
