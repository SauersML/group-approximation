import GroupApproximation.Higman.MikhailovaRopeCode
import GroupApproximation.Computability.DirectProductCodeSemantics
import GroupApproximation.Computability.FreeEdgeTowerSemantics

/-!
# Semantics of the effective Mikhailova rope code

This file identifies the three concrete compiler layers with their semantic
counterparts.  The centralizing layer needs no freeness hypothesis: its source
and target word families are literally equal, so its subgroup equivalence is
the identity.  The middle layer is the direct-product carrier equivalence.
The final layer is parameterized by exactly the subgroup equivalence and
generator compatibility required by the HNN presentation theorem.
-/

namespace GroupApproximation
namespace Higman
namespace MikhailovaRopeCodeSemantics

open PresentationCodes FreeEdgeTowerCode
open MikhailovaRopeCode
open FreeEdgeTowerSemantics

theorem central_sourceWord_eq_targetWord (ambient : PresentationCode)
    (cuttingWords : List MikhailovaRopeCode.Raw) :
    sourceWord ambient (centralEdges cuttingWords) =
      targetWord ambient (centralEdges cuttingWords) := by
  funext i
  simp [sourceWord, targetWord, centralEdges]

theorem centralSubgroup_eq (ambient : PresentationCode)
    (cuttingWords : List MikhailovaRopeCode.Raw) :
    HNNPresentation.srcSub (codeRels ambient)
        (sourceWord ambient (centralEdges cuttingWords)) =
      HNNPresentation.tgtSub (codeRels ambient)
        (targetWord ambient (centralEdges cuttingWords)) := by
  rw [← central_sourceWord_eq_targetWord ambient cuttingWords]
  rfl

/-- The first HNN layer uses the identity equivalence of the subgroup generated
by the displayed cutting words. -/
noncomputable def centralSubgroupEquiv (ambient : PresentationCode)
    (cuttingWords : List MikhailovaRopeCode.Raw) :
    HNNPresentation.srcSub (codeRels ambient)
        (sourceWord ambient (centralEdges cuttingWords)) ≃*
      HNNPresentation.tgtSub (codeRels ambient)
        (targetWord ambient (centralEdges cuttingWords)) :=
  MulEquiv.subgroupCongr (centralSubgroup_eq ambient cuttingWords)

theorem centralSubgroupEquiv_gen (ambient : PresentationCode)
    (cuttingWords : List MikhailovaRopeCode.Raw)
    (i : Fin (centralEdges cuttingWords).length) :
    ((centralSubgroupEquiv ambient cuttingWords
        ⟨HNNPresentation.srcGen (codeRels ambient)
            (sourceWord ambient (centralEdges cuttingWords)) i,
          HNNPresentation.srcGen_mem (codeRels ambient)
            (sourceWord ambient (centralEdges cuttingWords)) i⟩ :
      HNNPresentation.tgtSub (codeRels ambient)
        (targetWord ambient (centralEdges cuttingWords))) : Carrier ambient) =
      HNNPresentation.tgtGen (codeRels ambient)
        (targetWord ambient (centralEdges cuttingWords)) i := by
  change HNNPresentation.srcGen (codeRels ambient)
      (sourceWord ambient (centralEdges cuttingWords)) i =
    HNNPresentation.tgtGen (codeRels ambient)
      (targetWord ambient (centralEdges cuttingWords)) i
  simp only [HNNPresentation.srcGen, HNNPresentation.tgtGen,
    central_sourceWord_eq_targetWord]

/-- The first concrete code is the HNN extension centralizing the subgroup
generated by `cuttingWords`. -/
noncomputable def firstStageCodeEquiv (ambient : PresentationCode)
    (cuttingWords : List MikhailovaRopeCode.Raw) :
    Carrier (firstStageCode ambient cuttingWords) ≃*
      HNNPresentation.Ext (codeRels ambient)
        (sourceWord ambient (centralEdges cuttingWords))
        (targetWord ambient (centralEdges cuttingWords))
        (centralSubgroupEquiv ambient cuttingWords) :=
  edgeCodeEquivOfSubgroupEquiv ambient (centralEdges cuttingWords)
    (centralSubgroupEquiv ambient cuttingWords)
    (centralSubgroupEquiv_gen ambient cuttingWords)

/-- Product of two multiplicative equivalences. -/
def prodMulEquiv {G H K L : Type} [Group G] [Group H] [Group K] [Group L]
    (e : G ≃* H) (f : K ≃* L) : G × K ≃* H × L where
  toFun x := (e x.1, f x.2)
  invFun x := (e.symm x.1, f.symm x.2)
  left_inv x := by simp
  right_inv x := by simp
  map_mul' x y := by simp

/-- The middle concrete code has the semantic product of the central HNN layer
and the source coded group as carrier. -/
noncomputable def outerBaseCodeEquiv (ambient source : PresentationCode)
    (cuttingWords : List MikhailovaRopeCode.Raw) :
    Carrier (outerBaseCode ambient source cuttingWords) ≃*
      (HNNPresentation.Ext (codeRels ambient)
          (sourceWord ambient (centralEdges cuttingWords))
          (targetWord ambient (centralEdges cuttingWords))
          (centralSubgroupEquiv ambient cuttingWords) × Carrier source) :=
  (DirectProductCodeSemantics.productCodeEquiv
      (firstStageCode ambient cuttingWords) source).trans
    (prodMulEquiv (firstStageCodeEquiv ambient cuttingWords) (MulEquiv.refl _))

/-- The strongest unconditional semantic reading of the complete compiler.
The sole remaining input is the actual equivalence between the two generated
outer subgroups and its values on the displayed rope generators. -/
noncomputable def compileEquivOfSubgroupEquiv
    (ambient source : PresentationCode)
    (cuttingWords : List MikhailovaRopeCode.Raw)
    (marked : List (MikhailovaRopeCode.Raw × MikhailovaRopeCode.Raw))
    (phi : HNNPresentation.srcSub
        (codeRels (outerBaseCode ambient source cuttingWords))
        (sourceWord (outerBaseCode ambient source cuttingWords)
          (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked)) ≃*
      HNNPresentation.tgtSub
        (codeRels (outerBaseCode ambient source cuttingWords))
        (targetWord (outerBaseCode ambient source cuttingWords)
          (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked)))
    (hphi : ∀ i,
      ((phi ⟨HNNPresentation.srcGen
            (codeRels (outerBaseCode ambient source cuttingWords))
            (sourceWord (outerBaseCode ambient source cuttingWords)
              (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked)) i,
          HNNPresentation.srcGen_mem
            (codeRels (outerBaseCode ambient source cuttingWords))
            (sourceWord (outerBaseCode ambient source cuttingWords)
              (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked)) i⟩ :
        HNNPresentation.tgtSub
          (codeRels (outerBaseCode ambient source cuttingWords))
          (targetWord (outerBaseCode ambient source cuttingWords)
            (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked))) :
        Carrier (outerBaseCode ambient source cuttingWords)) =
      HNNPresentation.tgtGen
        (codeRels (outerBaseCode ambient source cuttingWords))
        (targetWord (outerBaseCode ambient source cuttingWords)
          (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked)) i) :
    Carrier (compile (ambient, (source, (cuttingWords, marked)))) ≃*
      HNNPresentation.Ext
        (codeRels (outerBaseCode ambient source cuttingWords))
        (sourceWord (outerBaseCode ambient source cuttingWords)
          (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked))
        (targetWord (outerBaseCode ambient source cuttingWords)
          (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked)) phi := by
  exact edgeCodeEquivOfSubgroupEquiv
    (outerBaseCode ambient source cuttingWords)
    (ropeEdges ambient (firstStageCode ambient cuttingWords) source marked)
    phi hphi

end MikhailovaRopeCodeSemantics
end Higman
end GroupApproximation
