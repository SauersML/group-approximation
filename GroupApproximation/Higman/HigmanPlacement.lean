import GroupApproximation.Higman.HigmanPrimitiveRecursion
import GroupApproximation.Higman.HigmanAtoms
import GroupApproximation.Higman.HigmanVariableCalculus

/-!
# Finite-coordinate placement

This file begins the missing placement step used by the primitive-recursion
trace.  Its first concrete operation is agreement on a finite interval: all
coordinates outside that interval are existentially forgotten, using the two
half-line agreement operations already generated by `π`, reflection and shift.
-/

namespace GroupApproximation
namespace Higman
namespace Seq

/-- Composing two agreement operations keeps precisely the intersection of
their coordinate predicates. -/
theorem agreeOp_comp (p q : ℤ → Prop) [DecidablePred p] [DecidablePred q]
    (B : Set E) :
    Agree.agreeOp p (Agree.agreeOp q B) =
      Agree.agreeOp (fun i => p i ∧ q i) B := by
  ext f
  constructor
  · rintro ⟨g, ⟨h, hh, hgh⟩, hfg⟩
    exact ⟨h, hh, fun i hi => (hfg i hi.1).trans (hgh i hi.2)⟩
  · rintro ⟨h, hh, hfh⟩
    let g : E := Finsupp.filter p f + Finsupp.filter (fun i => ¬p i) h
    refine ⟨g, ⟨h, hh, ?_⟩, ?_⟩
    · intro i hi
      simp only [g, Finsupp.add_apply, Finsupp.filter_apply]
      by_cases hp : p i
      · rw [if_pos hp, if_neg (not_not.mpr hp), add_zero]
        exact hfh i ⟨hp, hi⟩
      · rw [if_neg hp, if_pos hp, zero_add]
    · intro i hi
      simp only [g, Finsupp.add_apply, Finsupp.filter_apply]
      rw [if_pos hi, if_neg (not_not.mpr hi), add_zero]

/-- Forget every coordinate outside the integer interval `[a, a+n)`. -/
noncomputable def agreeInterval (a n : ℕ) (B : Set E) : Set E :=
  Agree.agreeOp (fun i : ℤ => (a : ℤ) ≤ i ∧ i < (a + n : ℕ)) B

/-- Agreement on a finite interval preserves generation.  This is the concrete
two-half-line operation needed before a relation can be copied to arbitrary
coordinates. -/
theorem higmanGenerated_agreeInterval (a n : ℕ) {B : Set E}
    (hB : HigmanGenerated B) : HigmanGenerated (agreeInterval a n B) := by
  have hlower : HigmanGenerated
      (conjAt a (fun i : ℤ => 0 ≤ i) B) :=
    higmanGenerated_conjAt a
      (fun _ h => higmanGenerated_agreeOp_nonneg h) hB
  have hupper : HigmanGenerated
      (conjAt (a + n) (fun i : ℤ => i ≤ -1)
        (conjAt a (fun i : ℤ => 0 ≤ i) B)) :=
    higmanGenerated_conjAt (a + n)
      (fun _ h => higmanGenerated_agreeOp_le_neg_one h) hlower
  rw [conjAt_eq, conjAt_eq, agreeOp_comp] at hupper
  have heq : Agree.agreeOp
      (fun i : ℤ => i - ((a + n : ℕ) : ℤ) ≤ -1 ∧ 0 ≤ i - (a : ℤ)) B =
      agreeInterval a n B := by
    unfold agreeInterval
    apply agreeOp_congr
    intro i
    constructor <;> intro hi <;> constructor <;> omega
  rwa [heq] at hupper

/-- A relation translated to a fresh interval, with every coordinate outside
that interval forgotten. -/
noncomputable def auxPlace (n q : ℕ) (R : Set E) : Set E :=
  agreeInterval q n (sigmaOp^[q] R)

theorem mem_auxPlace_iff (n q : ℕ) (R : Set E) (f : E) :
    f ∈ auxPlace n q R ↔
      ∃ w ∈ R, ∀ j : ℕ, j < n → f ((q + j : ℕ) : ℤ) = w (j : ℤ) := by
  unfold auxPlace agreeInterval
  constructor
  · rintro ⟨x, hx, hfx⟩
    obtain ⟨w, hw, hxw⟩ := (mem_sigmaOp_iterate_iff q R x).mp hx
    refine ⟨w, hw, fun j hj => ?_⟩
    rw [hfx ((q + j : ℕ) : ℤ) (by constructor <;> omega), hxw]
    congr 1
    push_cast
    omega
  · rintro ⟨w, hw, hfw⟩
    refine ⟨(shiftSeq^[q] w), ?_, ?_⟩
    · exact (mem_sigmaOp_iterate_iff q R _).mpr
        ⟨w, hw, fun i => shiftSeq_iterate_apply q w i⟩
    · intro i hi
      have hi0 : 0 ≤ i - (q : ℤ) := by omega
      obtain ⟨j, hj⟩ : ∃ j : ℕ, i - (q : ℤ) = (j : ℤ) :=
        ⟨(i - (q : ℤ)).toNat, by omega⟩
      have hjn : j < n := by
        have hcast : ((q + n : ℕ) : ℤ) = (q : ℤ) + (n : ℤ) := by push_cast; ring
        rw [hcast] at hi
        omega
      rw [shiftSeq_iterate_apply, hj]
      have hqj : i = ((q + j : ℕ) : ℤ) := by push_cast; omega
      rw [hqj]
      exact hfw j hjn

theorem higmanGenerated_auxPlace (n q : ℕ) {R : Set E}
    (hR : HigmanGenerated R) : HigmanGenerated (auxPlace n q R) :=
  higmanGenerated_agreeInterval q n (higmanGenerated_sigmaOp_iterate q hR)

/-- Tie each fresh auxiliary coordinate to its requested target coordinate. -/
noncomputable def tiedPlace (n q : ℕ) (c : ℕ → ℤ) (R : Set E) : Set E :=
  auxPlace n q R ∩ ⋂ j ∈ Finset.range n, eqRel ((q + j : ℕ) : ℤ) (c j)

theorem higmanGenerated_tiedPlace (n q : ℕ) (c : ℕ → ℤ) {R : Set E}
    (hR : HigmanGenerated R) : HigmanGenerated (tiedPlace n q c R) := by
  unfold tiedPlace
  exact HigmanGenerated.inter (higmanGenerated_auxPlace n q hR)
    (higmanGenerated_biInter (Finset.range n)
      (fun j => eqRel ((q + j : ℕ) : ℤ) (c j))
      fun j _ => higmanGenerated_eqRel _ _)

/-- Existentially forget the `n` fresh auxiliary coordinates. -/
noncomputable def freeAux (n q : ℕ) (B : Set E) : Set E :=
  Agree.agreeOp (fun i : ℤ => ∀ j : ℕ, j < n → i ≠ ((q + j : ℕ) : ℤ)) B

theorem higmanGenerated_freeAux (n q : ℕ) {B : Set E}
    (hB : HigmanGenerated B) : HigmanGenerated (freeAux n q B) := by
  induction n with
  | zero =>
      have heq : freeAux 0 q B = B := by
        ext f
        constructor
        · rintro ⟨g, hg, hfg⟩
          have : f = g := Finsupp.ext fun i => hfg i (by omega)
          rwa [this]
        · intro hf
          exact ⟨f, hf, fun _ _ => rfl⟩
      rwa [heq]
  | succ n ih =>
      have hstep := higmanGenerated_agreeOp_ne ((q + n : ℕ) : ℤ) ih
      have heq : Agree.agreeOp (fun i : ℤ => i ≠ ((q + n : ℕ) : ℤ))
          (freeAux n q B) = freeAux (n + 1) q B := by
        unfold freeAux
        rw [agreeOp_comp]
        apply agreeOp_congr
        intro i
        constructor
        · rintro ⟨hlast, hall⟩ j hj
          rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
          · exact hall j hj
          · exact hlast
        · intro hall
          exact ⟨hall n (by omega), fun j hj => hall j (by omega)⟩
      rwa [heq] at hstep

/-- The concrete placement construction: translate to fresh coordinates, tie
them to the targets, then existentially forget the fresh coordinates. -/
noncomputable def placeConstruction (n q : ℕ) (c : ℕ → ℤ) (R : Set E) : Set E :=
  freeAux n q (tiedPlace n q c R)

theorem higmanGenerated_placeConstruction (n q : ℕ) (c : ℕ → ℤ) {R : Set E}
    (hR : HigmanGenerated R) : HigmanGenerated (placeConstruction n q c R) :=
  higmanGenerated_freeAux n q (higmanGenerated_tiedPlace n q c hR)

private theorem finsupp_finsetSum_apply {α : Type*} (s : Finset α) (u : α → E) (i : ℤ) :
    (∑ j ∈ s, u j) i = ∑ j ∈ s, u j i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih => simp [ha, ih, Finsupp.add_apply]

private noncomputable def overwriteAux (n q : ℕ) (f w : E) : E :=
  f + ∑ j ∈ Finset.range n,
    Finsupp.single ((q + j : ℕ) : ℤ) (w (j : ℤ) - f ((q + j : ℕ) : ℤ))

private theorem overwriteAux_at (n q : ℕ) (f w : E) {j : ℕ} (hj : j < n) :
    overwriteAux n q f w ((q + j : ℕ) : ℤ) = w (j : ℤ) := by
  classical
  unfold overwriteAux
  rw [Finsupp.add_apply, finsupp_finsetSum_apply]
  simp only [Finsupp.single_apply]
  have hsum :
      (∑ x ∈ Finset.range n,
          if ((q + x : ℕ) : ℤ) = ((q + j : ℕ) : ℤ)
          then w (x : ℤ) - f ((q + x : ℕ) : ℤ) else 0) =
        w (j : ℤ) - f ((q + j : ℕ) : ℤ) := by
    rw [Finset.sum_eq_single j]
    · simp
    · intro x hx hxj
      have hcast : (((q + x : ℕ) : ℤ) = ((q + j : ℕ) : ℤ)) ↔ x = j := by
        constructor
        · intro h
          have hnat : q + x = q + j := by exact_mod_cast h
          omega
        · rintro rfl
          rfl
      rw [if_neg (hcast.not.mpr hxj)]
    · simp [hj]
  rw [hsum]
  abel

private theorem overwriteAux_off (n q : ℕ) (f w : E) {i : ℤ}
    (hi : ∀ j : ℕ, j < n → i ≠ ((q + j : ℕ) : ℤ)) :
    overwriteAux n q f w i = f i := by
  classical
  unfold overwriteAux
  rw [Finsupp.add_apply, finsupp_finsetSum_apply]
  simp only [Finsupp.single_apply]
  have hsum :
      (∑ x ∈ Finset.range n,
          if ((q + x : ℕ) : ℤ) = i
          then w (x : ℤ) - f ((q + x : ℕ) : ℤ) else 0) = 0 := by
    apply Finset.sum_eq_zero
    intro x hx
    rw [Finset.mem_range] at hx
    rw [if_neg (hi x hx).symm]
  rw [hsum, add_zero]

/-- With the auxiliary interval disjoint from every target, the concrete
construction is exactly `placeAt`. -/
theorem placeConstruction_eq_placeAt (n q : ℕ) (c : ℕ → ℤ) (R : Set E)
    (hfresh : ∀ i : ℕ, i < n → ∀ j : ℕ, j < n →
      c i ≠ ((q + j : ℕ) : ℤ)) :
    placeConstruction n q c R = placeAt n c R := by
  ext f
  constructor
  · rintro ⟨g, hg, hfg⟩
    rcases hg with ⟨haux, heq⟩
    obtain ⟨w, hw, hgw⟩ := (mem_auxPlace_iff n q R g).mp haux
    refine ⟨w, hw, fun j hj => ?_⟩
    have htarget : f (c j) = g (c j) := hfg (c j) (fun k hk => hfresh j hj k hk)
    have htie : g ((q + j : ℕ) : ℤ) = g (c j) := by
      exact Set.mem_iInter₂.mp heq j (Finset.mem_range.mpr hj)
    exact htarget.trans (htie.symm.trans (hgw j hj))
  · rintro ⟨w, hw, hfw⟩
    let g := overwriteAux n q f w
    refine ⟨g, ⟨(mem_auxPlace_iff n q R g).mpr ⟨w, hw, ?_⟩, ?_⟩, ?_⟩
    · intro j hj
      exact overwriteAux_at n q f w hj
    · refine Set.mem_iInter₂.mpr fun j hj => ?_
      have hjn : j < n := Finset.mem_range.mp hj
      have htarget : g (c j) = f (c j) :=
        overwriteAux_off n q f w (fun k hk => hfresh j hjn k hk)
      change g ((q + j : ℕ) : ℤ) = g (c j)
      rw [overwriteAux_at n q f w hjn, htarget, hfw j hjn]
    · intro i hi
      exact (overwriteAux_off n q f w hi).symm

end Seq
end Higman
end GroupApproximation
