import GroupApproximation.Higman.AmalgamPresentation

/-!
# The kernel of the paired fold map

For a group `K`, fold the free product of two copies of `K` by sending both
canonical copies identically to `K`.  This file proves internally that the
kernel is exactly the normal closure of the copy-difference elements

`inl k * (inr k)^{-1}`.

The proof uses only the universal property of `Monoid.Coprod` and the
elementary quotient criterion `QuotientGroup.eq_one_iff`.  In particular it
does not appeal to a presentation theorem or a free-product normal-form
result.  A generating subset of `K` suffices, and the final theorem records
the finite free-basis specialization used by paired-return constructions.
-/

namespace GroupApproximation
namespace Higman
namespace PairedFoldKernel

open scoped Monoid.Coprod

variable (K : Type*) [Group K]

/-- Fold the two factors of `K * K` identically onto `K`. -/
def fold : Monoid.Coprod K K →* K :=
  Monoid.Coprod.lift (MonoidHom.id K) (MonoidHom.id K)

@[simp] theorem fold_inl (k : K) :
    fold K (Monoid.Coprod.inl k) = k := by
  rw [fold, Monoid.Coprod.lift_apply_inl]
  rfl

@[simp] theorem fold_inr (k : K) :
    fold K (Monoid.Coprod.inr k) = k := by
  rw [fold, Monoid.Coprod.lift_apply_inr]
  rfl

/-- The relator identifying the two copies of one element. -/
def difference (k : K) : Monoid.Coprod K K :=
  Monoid.Coprod.inl k * (Monoid.Coprod.inr k)⁻¹

/-- The normal subgroup generated by copy differences over `S`.  It is
defined directly here so the fold theorem is universe-polymorphic. -/
def differenceRel (S : Set K) : Subgroup (Monoid.Coprod K K) :=
  Subgroup.normalClosure (difference K '' S)

instance differenceRel_normal (S : Set K) : (differenceRel K S).Normal := by
  unfold differenceRel
  infer_instance

/-- Every copy-difference relator dies under the fold. -/
theorem difference_mem_fold_ker (k : K) :
    difference K k ∈ (fold K).ker := by
  simp only [difference, MonoidHom.mem_ker, map_mul, map_inv, fold_inl,
    fold_inr, mul_inv_cancel]

/-- The copy-difference normal closure is contained in the fold kernel. -/
theorem differenceRel_le_fold_ker :
    differenceRel K Set.univ ≤ (fold K).ker := by
  unfold differenceRel
  apply Subgroup.normalClosure_le_normal
  rintro _ ⟨k, -, rfl⟩
  exact difference_mem_fold_ker K k

/-- In the quotient by the copy differences, the two canonical copies of
`K` agree. -/
theorem quotient_inl_eq_inr (k : K) :
    QuotientGroup.mk' (differenceRel K Set.univ) (Monoid.Coprod.inl k) =
      QuotientGroup.mk' (differenceRel K Set.univ)
        (Monoid.Coprod.inr k) := by
  let π := QuotientGroup.mk' (differenceRel K Set.univ)
  have hmem : difference K k ∈ differenceRel K Set.univ :=
    Subgroup.subset_normalClosure ⟨k, Set.mem_univ k, rfl⟩
  have hzero : π (difference K k) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr hmem
  have hmul : π (Monoid.Coprod.inl k) *
      (π (Monoid.Coprod.inr k))⁻¹ = 1 := by
    rw [← map_inv, ← map_mul]
    exact hzero
  exact mul_inv_eq_one.mp hmul

/-- The quotient map factors through `fold`, by reinserting the folded
element through the left copy. -/
theorem quotientMap_eq_left_comp_fold :
    QuotientGroup.mk' (differenceRel K Set.univ) =
      ((QuotientGroup.mk' (differenceRel K Set.univ)).comp
        Monoid.Coprod.inl).comp (fold K) := by
  refine Monoid.Coprod.hom_ext ?_ ?_
  · apply MonoidHom.ext
    intro k
    change QuotientGroup.mk' (differenceRel K Set.univ)
        (Monoid.Coprod.inl k) =
      QuotientGroup.mk' (differenceRel K Set.univ)
        (Monoid.Coprod.inl (fold K (Monoid.Coprod.inl k)))
    rw [fold_inl]
  · apply MonoidHom.ext
    intro k
    change QuotientGroup.mk' (differenceRel K Set.univ)
        (Monoid.Coprod.inr k) =
      QuotientGroup.mk' (differenceRel K Set.univ)
        (Monoid.Coprod.inl k)
    exact (quotient_inl_eq_inr K k).symm

/-- **Fold-kernel theorem.**  The kernel of `K * K → K` is precisely the
normal closure of all elements `inl k * (inr k)^{-1}`. -/
theorem fold_ker_eq_differenceRel :
    (fold K).ker = differenceRel K Set.univ := by
  refine le_antisymm ?_ (differenceRel_le_fold_ker K)
  intro x hx
  have hquot : QuotientGroup.mk' (differenceRel K Set.univ) x = 1 := by
    rw [quotientMap_eq_left_comp_fold K]
    change QuotientGroup.mk' (differenceRel K Set.univ)
      (Monoid.Coprod.inl (fold K x)) = 1
    rw [show fold K x = 1 from hx]
    simp only [map_one]
  exact (QuotientGroup.eq_one_iff x).mp hquot

/-- A generating subset supplies all copy-difference relators. -/
theorem fold_ker_eq_differenceRel_of_closure {S : Set K}
    (hS : Subgroup.closure S = ⊤) :
    (fold K).ker = differenceRel K S := by
  rw [fold_ker_eq_differenceRel K]
  apply le_antisymm
  · unfold differenceRel
    apply Subgroup.normalClosure_le_normal
    rintro _ ⟨k, -, rfl⟩
    let N : Subgroup (Monoid.Coprod K K) :=
      Subgroup.normalClosure (difference K '' S)
    let π := QuotientGroup.mk' N
    let left : K →* (Monoid.Coprod K K) ⧸ N := π.comp Monoid.Coprod.inl
    let right : K →* (Monoid.Coprod K K) ⧸ N := π.comp Monoid.Coprod.inr
    have hsub : S ⊆ (left.eqLocus right : Set K) := by
      intro s hs
      have hmem : difference K s ∈ N :=
        Subgroup.subset_normalClosure ⟨s, hs, rfl⟩
      have hzero : π (difference K s) = 1 :=
        (QuotientGroup.eq_one_iff _).mpr hmem
      have hmul : π (Monoid.Coprod.inl s) *
          (π (Monoid.Coprod.inr s))⁻¹ = 1 := by
        rw [← map_inv, ← map_mul]
        exact hzero
      exact mul_inv_eq_one.mp hmul
    have hall : left.eqLocus right = ⊤ := by
      apply top_unique
      rw [← hS]
      exact Subgroup.closure_le _ |>.mpr hsub
    have hk : left k = right k := by
      have : k ∈ left.eqLocus right := by rw [hall]; exact Subgroup.mem_top k
      exact this
    apply (QuotientGroup.eq_one_iff (difference K k)).mp
    change π (difference K k) = 1
    unfold difference
    rw [map_mul, map_inv]
    exact mul_inv_eq_one.mpr hk
  · unfold differenceRel
    exact Subgroup.normalClosure_mono (Set.image_mono (Set.subset_univ S))

/-- Finite-set form of the generating-subset theorem. -/
theorem fold_ker_eq_finiteDifferences (S : Finset K)
    (hS : Subgroup.closure (S : Set K) = ⊤) :
    (fold K).ker =
      Subgroup.normalClosure (difference K '' (S : Set K)) := by
  simpa only [differenceRel] using fold_ker_eq_differenceRel_of_closure K hS

/-- **Finite free-basis specialization.**  For a finite alphabet, the fold
kernel of `FreeGroup α * FreeGroup α` is normally generated by the
finitely many differences of the canonical free generators. -/
theorem freeGroup_fold_ker_eq_basisDifferences
    (α : Type*) [Fintype α] :
    (fold (FreeGroup α)).ker =
      Subgroup.normalClosure
        (difference (FreeGroup α) '' Set.range FreeGroup.of) := by
  exact fold_ker_eq_differenceRel_of_closure (FreeGroup α)
    (FreeGroup.closure_range_of α)

end PairedFoldKernel
end Higman
end GroupApproximation
