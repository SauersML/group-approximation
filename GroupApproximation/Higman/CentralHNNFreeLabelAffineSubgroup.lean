import GroupApproximation.Higman.CentralHNNFreeLabelAffine
import GroupApproximation.Higman.HNNDescent

/-!
# Subgroup scans in affine free-label coordinates

For a base subgroup `S` and a subgroup `V` of free stable-conjugate words,
the subgroup generated by `S`, the central stable letter, and `V` has base
return in `S`.  Its free coordinate is generated by the labels met by `S`
and by every right translate of `V` by an element of `S`.
-/

namespace GroupApproximation
namespace Higman
namespace CentralHNNFreeLabel

open HNNExtension

variable {G : Type} [Group G] (M : Subgroup G)

/-- All right translates, by elements of `S`, of words in `V`. -/
def orbitWordSet
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) (V : Subgroup (FreeGroup (Label M d))) :
    Set (FreeGroup (Label M d)) :=
  {w | ∃ g : G, g ∈ S ∧ ∃ v : FreeGroup (Label M d),
    v ∈ V ∧ w = FreeGroup.map (rightLabel (M := M) d g) v}

/-- The coordinate subgroup generated by the intrinsic labels of `S` and
the full `S`-orbit of `V`. -/
def affineCoordSub
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) (V : Subgroup (FreeGroup (Label M d))) :
    Subgroup (FreeGroup (Label M d)) :=
  Subgroup.closure
    (FreeGroup.of '' labelSet M d S ∪ orbitWordSet M d S V)

/-- The affine coordinate subgroup is stable under every right translation
coming from `S`. -/
theorem map_rightLabel_mem_affineCoordSub
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) (V : Subgroup (FreeGroup (Label M d)))
    {g : G} (hg : g ∈ S) {w : FreeGroup (Label M d)}
    (hw : w ∈ affineCoordSub M d S V) :
    FreeGroup.map (rightLabel (M := M) d g) w ∈
      affineCoordSub M d S V := by
  refine Subgroup.closure_induction
    (p := fun w _ => FreeGroup.map (rightLabel (M := M) d g) w ∈
      affineCoordSub M d S V) ?_ ?_ ?_ ?_ hw
  · intro x hx
    rcases hx with hx | hx
    · obtain ⟨q, hq, rfl⟩ := hx
      rw [FreeGroup.map.of]
      apply Subgroup.subset_closure
      left
      refine ⟨rightLabel (M := M) d g q, ?_, rfl⟩
      rw [← image_rightLabel_labelSet M d S hg]
      exact ⟨q, hq, rfl⟩
    · obtain ⟨h, hh, v, hv, rfl⟩ := hx
      rw [← MonoidHom.comp_apply,
        freeGroupMap_rightLabel_comp]
      apply Subgroup.subset_closure
      right
      exact ⟨h * g, S.mul_mem hh hg, v, hv, rfl⟩
  · rw [map_one]
    exact Subgroup.one_mem _
  · intro x y _ _ hx hy
    rw [map_mul]
    exact Subgroup.mul_mem _ hx hy
  · intro x _ hx
    rw [map_inv]
    exact Subgroup.inv_mem _ hx

/-- The central-HNN subgroup generated by the base subgroup, its stable
letter, and the prescribed free-coordinate subgroup. -/
def affineGeneratedSub
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) (V : Subgroup (FreeGroup (Label M d))) :
    Subgroup (CentHNN M) :=
  Subgroup.closure
    (HNNDescent.genSet (MulEquiv.refl M) S ∪
      stableConjLift M d '' (V : Set (FreeGroup (Label M d))))

/-- The generated-set definition is exactly the join of the usual central-HNN
subgroup with the prescribed stable-conjugate image. -/
theorem affineGeneratedSub_eq
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) (V : Subgroup (FreeGroup (Label M d))) :
    affineGeneratedSub M d S V =
      Subgroup.closure (HNNDescent.genSet (MulEquiv.refl M) S) ⊔
        V.map (stableConjLift M d) := by
  unfold affineGeneratedSub
  rw [Subgroup.closure_union]
  congr 1
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro z ⟨v, hv, rfl⟩
    exact ⟨v, hv, rfl⟩
  · rintro z ⟨v, hv, rfl⟩
    exact Subgroup.subset_closure ⟨v, hv, rfl⟩

/-- Exact affine invariant of the generated subgroup. -/
theorem baseRet_mem_and_freeCoord_mem_of_mem_affineGeneratedSub
    (d : HNNExtension.NormalWord.TransversalPair G M M)
    (S : Subgroup G) (V : Subgroup (FreeGroup (Label M d)))
    {z : CentHNN M} (hz : z ∈ affineGeneratedSub M d S V) :
    baseRet M z ∈ S ∧ freeCoord M d z ∈ affineCoordSub M d S V := by
  refine Subgroup.closure_induction
    (p := fun z _ => baseRet M z ∈ S ∧
      freeCoord M d z ∈ affineCoordSub M d S V) ?_ ?_ ?_ ?_ hz
  · intro z hz
    rcases hz with hz | hz
    · rcases hz with hz | hz
      · obtain ⟨s, hs, rfl⟩ := hz
        exact ⟨by simpa using hs, by simp [affineCoordSub]⟩
      · rw [Set.mem_singleton_iff] at hz
        subst z
        constructor
        · simp
        · rw [freeCoord_t]
          apply Subgroup.subset_closure
          left
          refine ⟨((d.compl (1 : ℤˣ)).equiv 1).2, ?_, rfl⟩
          exact ⟨1, Subgroup.one_mem S, rfl⟩
    · obtain ⟨v, hv, rfl⟩ := hz
      constructor
      · have hbase : baseRet M (stableConjLift M d v) = 1 := by
          rw [← MonoidHom.comp_apply, baseRet_comp_stableConjLift]
          rfl
        rw [hbase]
        exact Subgroup.one_mem S
      · rw [freeCoord_stableConjLift]
        apply Subgroup.subset_closure
        right
        have hmap : FreeGroup.map (rightLabel (M := M) d 1) =
            MonoidHom.id (FreeGroup (Label M d)) := by
          refine FreeGroup.ext_hom _ _ fun q => ?_
          simp only [FreeGroup.map.of, MonoidHom.id_apply, rightLabel_one]
        refine ⟨1, Subgroup.one_mem S, v, hv, ?_⟩
        rw [hmap, MonoidHom.id_apply]
  · exact ⟨by simp, by simp⟩
  · intro x y _ _ hx hy
    constructor
    · rw [map_mul]
      exact S.mul_mem hx.1 hy.1
    · rw [freeCoord_mul]
      exact Subgroup.mul_mem _
        (map_rightLabel_mem_affineCoordSub M d S V hy.1 hx.2) hy.2
  · intro x _ hx
    constructor
    · rw [map_inv]
      exact S.inv_mem hx.1
    · rw [freeCoord_inv]
      apply Subgroup.inv_mem
      apply map_rightLabel_mem_affineCoordSub M d S V
      · rw [map_inv]
        exact S.inv_mem hx.1
      · exact hx.2

end CentralHNNFreeLabel
end Higman
end GroupApproximation
