import GroupApproximation.Higman.HNNDescent

/-!
# The stable hull of a subgroup in an HNN base

For an arbitrary base subgroup `Z`, the subgroup generated by `Z` and the
stable letter need not meet the base in `Z`: the edge equivalence may move
parts of `Z`.  This file isolates the exact unconditional replacement.  The
intersection is contained in the least edge-stable subgroup containing `Z`.

This construction is useful for the Omega tower, whose outer alphabet is
deliberately not stable under the shift.
-/

namespace GroupApproximation
namespace Higman
namespace HNNDescent

open HNNExtension

variable {P : Type} [Group P] {A B : Subgroup P} (phi : A ≃* B)

/-- The least subgroup of the base that contains `Z` and is stable under both
directions of the edge equivalence. -/
def stableHull (Z : Subgroup P) : Subgroup P :=
  sInf {Y : Subgroup P | Z ≤ Y ∧ Stable phi Y}

/-- The original subgroup lies in its stable hull. -/
theorem le_stableHull (Z : Subgroup P) : Z ≤ stableHull phi Z := by
  intro z hz
  rw [stableHull, Subgroup.mem_sInf]
  intro Y hY
  exact hY.1 hz

/-- The stable hull is stable. -/
theorem stable_stableHull (Z : Subgroup P) : Stable phi (stableHull phi Z) := by
  constructor
  · intro a ha
    rw [stableHull, Subgroup.mem_sInf] at ha ⊢
    intro Y hY
    exact hY.2.fwd a (ha Y hY)
  · intro b hb
    rw [stableHull, Subgroup.mem_sInf] at hb ⊢
    intro Y hY
    exact hY.2.bwd b (hb Y hY)

/-- Minimality of the stable hull. -/
theorem stableHull_le {Z Y : Subgroup P} (hZY : Z ≤ Y) (hY : Stable phi Y) :
    stableHull phi Z ≤ Y := by
  exact sInf_le ⟨hZY, hY⟩

/-- **Unconditional HNN base-return bound.**  Any base element represented by
a word in `Z` and the stable letter lies in the stable hull of `Z`.

No stability of `Z` is assumed.  This is the precise sound replacement for
applying `closure_inf_range` to a non-stable alphabet. -/
theorem mem_stableHull_of_of_mem_closure {Z : Subgroup P} {x : P}
    (hx : (of x : HNNExtension P A B phi) ∈
      Subgroup.closure (genSet phi Z)) :
    x ∈ stableHull phi Z := by
  apply mem_of_of_mem_closure phi (stable_stableHull phi Z)
  refine Subgroup.closure_mono ?_ hx
  rintro y (hy | hy)
  · obtain ⟨z, hz, rfl⟩ := hy
    exact Or.inl ⟨z, le_stableHull phi Z hz, rfl⟩
  · exact Or.inr hy

/-! ## Exactness

The stable hull is not merely an upper bound.  It is exactly the part of the
HNN base which is generated by `Z` together with the stable letter.  This
form is useful when the starting subgroup is not stable: it replaces an
invalid application of `closure_inf_range` by an equality with a canonical
least stable subgroup.
-/

/-- The subgroup of the HNN base whose embedded elements belong to
`\langle Z,t\rangle`. -/
def generatedBase (Z : Subgroup P) : Subgroup P :=
  (Subgroup.closure (genSet phi Z)).comap
    (HNNExtension.of : P →* HNNExtension P A B phi)

/-- The original subgroup is contained in the base part generated with the
stable letter. -/
theorem le_generatedBase (Z : Subgroup P) : Z ≤ generatedBase phi Z := by
  intro z hz
  change (HNNExtension.of z : HNNExtension P A B phi) ∈
    Subgroup.closure (genSet phi Z)
  exact Subgroup.subset_closure (Or.inl ⟨z, hz, rfl⟩)

/-- The base part of `\langle Z,t\rangle` is stable under both edge maps. -/
theorem stable_generatedBase (Z : Subgroup P) : Stable phi (generatedBase phi Z) := by
  let C : Subgroup (HNNExtension P A B phi) := Subgroup.closure (genSet phi Z)
  have ht : (HNNExtension.t : HNNExtension P A B phi) ∈ C :=
    Subgroup.subset_closure (Or.inr rfl)
  constructor
  · intro a ha
    change HNNExtension.of ((phi a : B) : P) ∈ C
    have ha' : HNNExtension.of (a : P) ∈ C := ha
    have hconj := HNNExtension.equiv_eq_conj (φ := phi) a
    rw [hconj]
    exact C.mul_mem (C.mul_mem ht ha') (C.inv_mem ht)
  · intro b hb
    change HNNExtension.of ((phi.symm b : A) : P) ∈ C
    have hb' : HNNExtension.of (b : P) ∈ C := hb
    have hconj := HNNExtension.equiv_symm_eq_conj (φ := phi) b
    rw [hconj]
    exact C.mul_mem (C.mul_mem (C.inv_mem ht) hb') ht

/-- **Exact stable-hull theorem.**  The least stable subgroup containing `Z`
is precisely the intersection of `\langle Z,t\rangle` with the HNN base,
read back along the injective base map. -/
theorem stableHull_eq_generatedBase (Z : Subgroup P) :
    stableHull phi Z = generatedBase phi Z := by
  apply le_antisymm
  · exact stableHull_le phi (le_generatedBase phi Z) (stable_generatedBase phi Z)
  · intro x hx
    exact mem_stableHull_of_of_mem_closure phi hx

end HNNDescent
end Higman
end GroupApproximation
