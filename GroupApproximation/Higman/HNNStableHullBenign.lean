import GroupApproximation.Higman.HNNStableHull
import GroupApproximation.Higman.TorsionFreeImageClosure

/-!
# Benignness of a full-automorphism stable hull

If `H` is benign in a finitely presented torsion-free group `P`, then the
least subgroup containing `H` and stable under a full automorphism of `P` is
again benign.  The witness is concrete: form the mapping torus, join the image
of `H` with the cyclic stable-letter subgroup, and pull that join back to the
base.  `HNNDescent.stableHull_eq_generatedBase` computes the pullback exactly.
-/

namespace GroupApproximation
namespace Higman

open HNNExtension

variable {P : Type} [Group P]

/-- A full automorphism, regarded as an isomorphism between two copies of the
top subgroup. -/
def topAut (phi : MulAut P) : ↑(⊤ : Subgroup P) ≃* ↑(⊤ : Subgroup P) :=
  (Subgroup.topEquiv (G := P)).trans
    (phi.trans (Subgroup.topEquiv (G := P)).symm)

@[simp] theorem coe_topAut (phi : MulAut P) (x : ↑(⊤ : Subgroup P)) :
    ((topAut phi x : ↑(⊤ : Subgroup P)) : P) = phi (x : P) := rfl

/-- The mapping torus of a full automorphism. -/
abbrev MappingTorus (phi : MulAut P) : Type :=
  HNNExtension P ⊤ ⊤ (topAut phi)

/-- The cyclic subgroup generated by the mapping-torus stable letter. -/
def stableCyclic (phi : MulAut P) : Subgroup (MappingTorus phi) :=
  Subgroup.closure {(HNNExtension.t : MappingTorus phi)}

theorem stableCyclic_fg (phi : MulAut P) : (stableCyclic phi).FG := by
  exact (Subgroup.fg_iff _).mpr
    ⟨{(HNNExtension.t : MappingTorus phi)}, rfl, Set.finite_singleton _⟩

/-- In the mapping torus, adjoining the stable letter to the image of `H` is
literally the closure of `HNNDescent.genSet`. -/
theorem map_sup_stableCyclic_eq_generated
    (phi : MulAut P) (H : Subgroup P) :
    H.map (HNNExtension.of : P →* MappingTorus phi) ⊔ stableCyclic phi =
      Subgroup.closure (HNNDescent.genSet (topAut phi) H) := by
  apply le_antisymm
  · apply sup_le
    · rintro x ⟨y, hy, rfl⟩
      exact Subgroup.subset_closure (Or.inl ⟨y, hy, rfl⟩)
    · refine (Subgroup.closure_le _).mpr ?_
      rintro _ (rfl : _ = HNNExtension.t)
      exact Subgroup.subset_closure (Or.inr rfl)
  · refine (Subgroup.closure_le _).mpr ?_
    rintro x (hx | hx)
    · obtain ⟨y, hy, rfl⟩ := hx
      exact Subgroup.mem_sup_left ⟨y, hy, rfl⟩
    · rw [Set.mem_singleton_iff] at hx
      subst x
      exact Subgroup.mem_sup_right (Subgroup.subset_closure rfl)

/-- The join's pullback to the base is exactly the stable hull. -/
theorem comap_map_sup_stableCyclic_eq_stableHull
    (phi : MulAut P) (H : Subgroup P) :
    (H.map (HNNExtension.of : P →* MappingTorus phi) ⊔
        stableCyclic phi).comap
          (HNNExtension.of : P →* MappingTorus phi) =
      HNNDescent.stableHull (topAut phi) H := by
  rw [map_sup_stableCyclic_eq_generated]
  exact (HNNDescent.stableHull_eq_generatedBase (topAut phi) H).symm

/-- **Stable hulls under full automorphisms preserve torsion-free
benignness.** -/
theorem BenignTF.stableHull [Group.IsFinitelyPresented P] [Group.FG P]
    (hP : IsPowerTorsionFree P) (phi : MulAut P) {H : Subgroup P}
    (hH : BenignTF H) :
    BenignTF (HNNDescent.stableHull (topAut phi) H) := by
  let E := MappingTorus phi
  letI : Group.IsFinitelyPresented E := by
    letI : Group.FG ↑(⊤ : Subgroup P) :=
      Group.fg_of_surjective
        (f := (Subgroup.topEquiv (G := P)).symm.toMonoidHom)
        (Subgroup.topEquiv (G := P)).symm.surjective
    exact HNNFinitePresentation.isFinitelyPresented_hnnExtension (topAut phi)
  have hE : IsPowerTorsionFree E :=
    HNNBritton.isPowerTorsionFree_hnn (topAut phi) hP
  have hof : Function.Injective (HNNExtension.of : P →* E) :=
    HNNExtension.of_injective (topAut phi)
  have hmap : BenignTF (H.map (HNNExtension.of : P →* E)) :=
    BenignTF.mapEmb hE hH (HNNExtension.of : P →* E) hof
  have hcyc : BenignTF (stableCyclic phi) :=
    benignTF_of_fg hE (stableCyclic_fg phi)
  letI : Group.FG E :=
    ProductFinitePresentation.fg_of_isFinitelyPresented E
  have hjoin : BenignTF
      (H.map (HNNExtension.of : P →* E) ⊔ stableCyclic phi) :=
    BenignTF.sup hmap hcyc
  let self : TorsionFreeFPOvergroup P :=
    { K := P
      torsionFree := hP
      emb := MonoidHom.id P
      emb_injective := Function.injective_id }
  have hcomap := BenignTF.comap self
    (HNNExtension.of : P →* E) hjoin
  rwa [comap_map_sup_stableCyclic_eq_stableHull] at hcomap

end Higman
end GroupApproximation
