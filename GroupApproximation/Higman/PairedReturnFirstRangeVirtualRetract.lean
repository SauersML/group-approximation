import GroupApproximation.Higman.PairedReturnEdgeProfinite

/-!
# An index-two virtual retraction onto the paired first path

The subgroup generated by `K` and `a K a⁻¹` is a retract of the index-two
subgroup of `F₃` consisting of words with even `a`-parity.  We construct the
retraction directly from the two-state action used to prove freeness: an even
word acts on the false state by left multiplication by a word in `K * K`, and
that word is the retraction value.
-/

namespace GroupApproximation
namespace Higman
namespace PairedReturnFirstRangeVirtualRetract

open Conj
open PairedReturnEdgeGraph
open PairedReturnEdgeProfinite

/-- Boolean negation as a permutation. -/
def boolToggle : Equiv.Perm Bool where
  toFun s := !s
  invFun s := !s
  left_inv s := by cases s <;> rfl
  right_inv s := by cases s <;> rfl

/-- The `a`-parity action: `a` toggles and `b,c` act trivially. -/
def stateAct : F₃ →* Equiv.Perm Bool :=
  FreeGroup.lift fun i : Fin 3 ↦ if i = 0 then boolToggle else 1

@[simp] theorem stateAct_a : stateAct a = boolToggle := by
  simp [stateAct, a]

@[simp] theorem stateAct_b : stateAct b = 1 := by
  simp [stateAct, b]

@[simp] theorem stateAct_c : stateAct c = 1 := by
  simp [stateAct, c]

/-- The Boolean component of the two-state action is exactly `stateAct` and
does not depend on the word coordinate. -/
theorem act_snd (x : F₃) (w : Double) (s : Bool) :
    (act x (w, s)).2 = stateAct x s := by
  induction x using FreeGroup.induction_on with
  | one => simp
  | of i =>
      fin_cases i <;> cases s <;> rfl
  | inv x ih =>
      rw [map_inv, map_inv]
      apply (stateAct x).injective
      rw [Equiv.apply_symm_apply]
      have h := congrArg Prod.snd ((act x).apply_symm_apply (w, s))
      rw [ih] at h
      exact h
  | mul x y hx hy =>
      rw [map_mul, map_mul]
      change (act x (act y (w, s))).2 = stateAct x (stateAct y s)
      rw [hx, hy]

/-- Every action element is a left writer on the word coordinate. -/
def Writer : Subgroup (Equiv.Perm StateSpace) where
  carrier := {p | ∀ u w s,
    p (u * w, s) = ((p (u, s)).1 * w, (p (u, s)).2)}
  one_mem' := by intro u w s; rfl
  mul_mem' := by
    intro p q hp hq u w s
    change p (q (u * w, s)) = _
    rw [hq]
    rw [hp]
    rfl
  inv_mem' := by
    intro p hp u w s
    apply p.injective
    rw [p.apply_symm_apply]
    have h := hp ((p.symm (u, s)).1) w ((p.symm (u, s)).2)
    rw [p.apply_symm_apply] at h
    exact h.symm

theorem writePerm_mem_Writer (h : Sync) : writePerm h ∈ Writer := by
  intro u w s
  simp only [writePerm_apply]
  apply Prod.ext
  · group
  · rfl

theorem togglePerm_mem_Writer : togglePerm ∈ Writer := by
  intro u w s
  rfl

theorem act_mem_Writer (x : F₃) : act x ∈ Writer := by
  induction x using FreeGroup.induction_on with
  | one => exact Writer.one_mem
  | of i =>
      fin_cases i
      · simpa [act] using togglePerm_mem_Writer
      · simpa [act] using writePerm_mem_Writer PairedReturnCutter.bSync
      · simpa [act] using writePerm_mem_Writer PairedReturnCutter.cSync
  | inv x hx => exact Writer.inv_mem hx
  | mul x y hx hy => exact Writer.mul_mem hx hy

theorem act_mul_right (x : F₃) (u w : Double) (s : Bool) :
    act x (u * w, s) =
      ((act x (u, s)).1 * w, (act x (u, s)).2) :=
  act_mem_Writer x u w s

/-- The index-two even-parity subgroup. -/
def Even : Subgroup F₃ := stateAct.ker

/-- Read the word written by an even element on the false state. -/
def read : Even →* Double where
  toFun x := (act (x : F₃) (1, false)).1
  map_one' := by simp
  map_mul' := by
    intro x y
    rw [Subgroup.coe_mul, map_mul]
    change (act (x : F₃) (act (y : F₃) (1, false))).1 = _
    have hy : (act (y : F₃) (1, false)).2 = false := by
      rw [act_snd]
      have hyker : stateAct (y : F₃) = 1 := MonoidHom.mem_ker.mp y.property
      rw [hyker]
      rfl
    conv_lhs =>
      rw [show act (y : F₃) (1, false) =
          ((act (y : F₃) (1, false)).1, false) by
        apply Prod.ext
        · rfl
        · exact hy]
    rw [act_mul_right]
    rfl

/-- Every first-path element has even `a`-parity. -/
theorem firstPath_mem_Even (z : Double) : firstPath z ∈ Even := by
  rw [Even, MonoidHom.mem_ker]
  apply Equiv.ext
  intro s
  have hs := act_snd (firstPath z) 1 s
  induction z using Monoid.Coprod.induction_on with
  | inl h =>
      rw [firstPath_inl, act_of_mem_K h.property] at hs
      exact hs.symm
  | inr h =>
      rw [firstPath_inr, map_mul, map_mul, map_inv, act_a] at hs
      change (!(!s)) = stateAct (a * (h : F₃) * a⁻¹) s at hs
      cases s <;> exact hs.symm
  | mul x y hx hy =>
      rw [map_mul, hx, hy]
      rfl

/-- Reading a first-path element recovers the original two-copy word. -/
theorem read_firstPath (z : Double) :
    read ⟨firstPath z, firstPath_mem_Even z⟩ = z := by
  change (act (firstPath z) (1, false)).1 = z
  rw [act_firstPath]
  simp

/-- Inclusion of the first-coordinate range into the even subgroup. -/
noncomputable def firstRangeToEven : FirstRange →* Even where
  toFun j := ⟨j, by
    obtain ⟨z, hz⟩ := j.property
    rw [← hz]
    exact firstPath_mem_Even z⟩
  map_one' := Subtype.ext (by simp)
  map_mul' _ _ := Subtype.ext rfl

/-- The explicit retraction from the even subgroup onto the first-coordinate
range. -/
def evenToFirstRange : Even →* FirstRange :=
  firstPath.rangeRestrict.comp read

theorem evenToFirstRange_comp_firstRangeToEven :
    evenToFirstRange.comp firstRangeToEven = MonoidHom.id FirstRange := by
  ext j
  obtain ⟨z, hz⟩ := j.property
  apply Subtype.ext
  change firstPath (read ⟨(j : F₃), _⟩) = (j : F₃)
  rw [← hz]
  rw [read_firstPath]

end PairedReturnFirstRangeVirtualRetract
end Higman
end GroupApproximation
