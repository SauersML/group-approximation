import GroupApproximation.Higman.OmegaTowerStaticSeamOrbitWord

/-!
# The selected first-stage code subgroup as a free group

The selected code subgroup is not merely generated by the displayed block
codes.  Those codes form a free basis, detected by `genProjection3` and the
conjugate-basis embedding.  This gives the remaining orbit scan a unique
reduced signed block word instead of an opaque subgroup-closure witness.
-/

namespace GroupApproximation
namespace Higman
namespace Omega

open GroupApproximation.Higman.Conj
open GroupApproximation.Higman.Seq

/-- The literal selected window-block alphabet. -/
abbrev SelectedBlock (m : ℕ) (B : Set E) := ↥(B ∩ blockSet m)

noncomputable def selectedBlockToK (m : ℕ) (B : Set E) :
    SelectedBlock m B → ↥Conj.K := fun β => bK (β : E)

theorem selectedBlockToK_injective (m : ℕ) (B : Set E) :
    Function.Injective (selectedBlockToK m B) := by
  intro β γ hβγ
  exact Subtype.ext (bK_injective hβγ)

/-- Evaluation of a selected block word in the second copy of `F₃`. -/
noncomputable def selectedAHom (m : ℕ) (B : Set E) :
    FreeGroup (SelectedBlock m B) →* F₃ :=
  Conj.cbHom.comp (FreeGroup.map (selectedBlockToK m B))

@[simp] theorem selectedAHom_of (m : ℕ) (B : Set E)
    (β : SelectedBlock m B) :
    selectedAHom m B (FreeGroup.of β) = aElt (β : E) := by
  simp only [selectedAHom, MonoidHom.comp_apply, FreeGroup.map.of,
    Conj.cbHom_of]
  rfl

theorem selectedAHom_injective (m : ℕ) (B : Set E) :
    Function.Injective (selectedAHom m B) :=
  Conj.cbHom_injective.comp
    (FreeGroup.map_injective (selectedBlockToK_injective m B))

/-- Evaluation of the same reduced word in the concrete first-stage code
subgroup. -/
noncomputable def selectedCodeHom (m : ℕ) (B : Set E) :
    FreeGroup (SelectedBlock m B) →* Cent3 (rowOut m) :=
  (genHom (rowOut m)).comp (selectedAHom m B)

@[simp] theorem selectedCodeHom_of (m : ℕ) (B : Set E)
    (β : SelectedBlock m B) :
    selectedCodeHom m B (FreeGroup.of β) = slimGenCode m (β : E) := by
  simp only [selectedCodeHom, MonoidHom.comp_apply, selectedAHom_of,
    slimGenCode]

theorem selectedCodeHom_injective (m : ℕ) (B : Set E) :
    Function.Injective (selectedCodeHom m B) :=
  (genHom_injective m).comp (selectedAHom_injective m B)

/-- The range of the free selected-code evaluation is exactly the subgroup
used in the static Omega seam. -/
theorem selectedCodeHom_range (m : ℕ) (B : Set E) :
    (selectedCodeHom m B).range = slimGenSub m B := by
  apply le_antisymm
  · rintro _ ⟨w, rfl⟩
    induction w using FreeGroup.induction_on with
    | C1 =>
        rw [map_one]
        exact Subgroup.one_mem _
    | of β =>
        rw [selectedCodeHom_of]
        exact Subgroup.subset_closure ⟨(β : E), β.property, rfl⟩
    | inv_of β hβ =>
        rw [map_inv]
        exact Subgroup.inv_mem _ hβ
    | mul x y hx hy =>
        rw [map_mul]
        exact Subgroup.mul_mem _ hx hy
  · rw [slimGenSub, Subgroup.closure_le]
    rintro _ ⟨β, hβ, rfl⟩
    exact ⟨FreeGroup.of ⟨β, hβ⟩, selectedCodeHom_of m B ⟨β, hβ⟩⟩

/-- Every selected first-stage element has a unique reduced block word. -/
theorem existsUnique_selectedCodeWord
    {m : ℕ} {B : Set E} {g : Cent3 (rowOut m)}
    (hg : g ∈ slimGenSub m B) :
    ∃! w : FreeGroup (SelectedBlock m B), selectedCodeHom m B w = g := by
  have hrange : g ∈ (selectedCodeHom m B).range := by
    rwa [selectedCodeHom_range]
  obtain ⟨w, hw⟩ := hrange
  exact ⟨w, hw, fun v hv => selectedCodeHom_injective m B (hv.trans hw.symm)⟩

end Omega
end Higman
end GroupApproximation
