import GroupApproximation.Higman.EnumeratedRangeExtract
import GroupApproximation.Higman.HigmanBoundedWindowRE
import GroupApproximation.Meta.AxiomGuard

/-!
# The enumerated-range step, unconditionally

`HigmanBoundedWindowRE` proves the bounded arithmetic theorem required by the
trace construction.  `EnumeratedRangeExtract` proves that this theorem makes
the range of every total computable enumeration Higman-generated.  This module
assembles those two results and exposes the formerly named input as a closed
theorem.
-/

namespace GroupApproximation
namespace Higman

/-- The range of every total computable enumeration is Higman-generated. -/
theorem enumeratedRangeGenerated : EnumeratedRangeGenerated :=
  enumeratedRangeGenerated_of_boundedWindowRE boundedWindowRE

/-- Higman's theorem that every recursively enumerable sequence set is
generated by the nine operations. -/
theorem higmanTheoremThree : HigmanTheoremThree :=
  higmanTheoremThree_of_enumeratedRange enumeratedRangeGenerated

end Higman
end GroupApproximation

#audit_closed_axioms GroupApproximation.Higman.enumeratedRangeGenerated
#audit_closed_axioms GroupApproximation.Higman.higmanTheoremThree
