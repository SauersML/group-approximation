import GroupApproximation.Algebra.TorsionFreeRadicalTower
import GroupApproximation.Higman.EvalRaw

/-!
# Normal closure as a product of conjugates

Membership in `Subgroup.normalClosure S` is, by definition, membership in the
subgroup generated by the conjugates of `S`.  Turning that into *data* --- an
explicit list of (conjugator, base) pairs whose conjugates multiply to the
element --- is what any effective argument about normal closures has to do
first, and Mathlib does not have it: it has
`Submonoid.exists_list_of_mem_closure`, but nothing for subgroups and nothing
for normal closures.

This file supplies it, for a **symmetric** generating set:

    g ∈ normalClosure S  ↔  ∃ l, (∀ p ∈ l, p.2 ∈ S) ∧ conjProd l = g .

Symmetry (`∀ x ∈ S, x⁻¹ ∈ S`) is what lets the list be taken with all bases in
`S` rather than in `S ∪ S⁻¹`, and it costs nothing here because the set
Chiodo's tower is built from --- the elements that become torsion modulo the
previous stage --- is symmetric (`torsionSet_symm`).

## Why this is in the Higman lane

`Higman.Program`'s input (B2) is Chiodo's Proposition 3.8, and
`Higman.QuotientPresentation` reduces it to recursive enumerability of

    { w | ∃ i, evalRaw pcGen w ∈ torsionTower PCDirectSum i } .

`torsionTower _ (i+1)` is a normal closure, so making that predicate effective
means exhibiting tower membership as a finite list of conjugation data, one
level at a time --- which is exactly `mem_torsionStep_iff_conjProd` below.  The
remaining work, not done here, is to flatten the *nested* certificates (a base
at level `i+1` needs its own witness at level `i`) into a single
`Primcodable` derivation list checked against its own prefix; that is the
standard proof-checking format and it is the shape (B1)'s
`Higman.BlockSearch` already put its own search into.
-/

namespace GroupApproximation
namespace Higman

variable {A : Type*} [Group A]

/-! ## 1.  Products of conjugates -/

/-- The product of a list of conjugates: `p.1 * p.2 * p.1⁻¹` for each entry. -/
def conjProd (l : List (A × A)) : A :=
  (l.map fun p ↦ p.1 * p.2 * p.1⁻¹).prod

@[simp] theorem conjProd_nil : conjProd ([] : List (A × A)) = 1 := rfl

@[simp] theorem conjProd_cons (p : A × A) (l : List (A × A)) :
    conjProd (p :: l) = p.1 * p.2 * p.1⁻¹ * conjProd l := rfl

theorem conjProd_append (l m : List (A × A)) :
    conjProd (l ++ m) = conjProd l * conjProd m := by
  simp [conjProd, List.prod_append]

/-- The formal inverse of a list of conjugates: reverse it and invert each
base.  The conjugators are unchanged, which is why symmetry of the base set is
all that is needed. -/
def conjInv (l : List (A × A)) : List (A × A) :=
  (l.map fun p ↦ (p.1, p.2⁻¹)).reverse

theorem conjInv_cons (p : A × A) (l : List (A × A)) :
    conjInv (p :: l) = conjInv l ++ [(p.1, p.2⁻¹)] := by
  simp [conjInv]

theorem conjProd_conjInv (l : List (A × A)) :
    conjProd (conjInv l) = (conjProd l)⁻¹ := by
  induction l with
  | nil => simp [conjInv]
  | cons p l ih =>
      rw [conjInv_cons, conjProd_append, ih, conjProd_cons, conjProd_cons,
        conjProd_nil, mul_one]
      group

theorem conjInv_base {S : Set A} (hsymm : ∀ x ∈ S, x⁻¹ ∈ S) {l : List (A × A)}
    (hl : ∀ p ∈ l, p.2 ∈ S) : ∀ p ∈ conjInv l, p.2 ∈ S := by
  intro p hp
  rw [conjInv, List.mem_reverse, List.mem_map] at hp
  obtain ⟨q, hq, rfl⟩ := hp
  exact hsymm q.2 (hl q hq)

/-! ## 2.  The characterization -/

theorem conjProd_mem_normalClosure {S : Set A} :
    ∀ l : List (A × A), (∀ p ∈ l, p.2 ∈ S) →
      conjProd l ∈ Subgroup.normalClosure S := by
  intro l
  induction l with
  | nil =>
      intro _
      simpa using Subgroup.one_mem (Subgroup.normalClosure S)
  | cons p l ih =>
      intro hl
      rw [conjProd_cons]
      refine Subgroup.mul_mem _ ?_
        (ih fun q hq => hl q (List.mem_cons_of_mem _ hq))
      exact Subgroup.normalClosure_normal.conj_mem p.2
        (Subgroup.subset_normalClosure (hl p (by simp))) p.1

/-- **Normal closure of a symmetric set, as data.**  Membership is a finite
list of conjugation instances. -/
theorem mem_normalClosure_iff_conjProd {S : Set A}
    (hsymm : ∀ x ∈ S, x⁻¹ ∈ S) (g : A) :
    g ∈ Subgroup.normalClosure S ↔
      ∃ l : List (A × A), (∀ p ∈ l, p.2 ∈ S) ∧ conjProd l = g := by
  constructor
  · intro hg
    let P : Subgroup A :=
      { carrier := {x : A | ∃ l : List (A × A), (∀ p ∈ l, p.2 ∈ S) ∧ conjProd l = x}
        one_mem' := ⟨[], by simp, rfl⟩
        mul_mem' := by
          rintro x y ⟨l, hl, rfl⟩ ⟨m, hm, rfl⟩
          refine ⟨l ++ m, ?_, conjProd_append l m⟩
          intro p hp
          rcases List.mem_append.1 hp with h | h
          · exact hl p h
          · exact hm p h
        inv_mem' := by
          rintro x ⟨l, hl, rfl⟩
          exact ⟨conjInv l, conjInv_base hsymm hl, conjProd_conjInv l⟩ }
    have hsub : Subgroup.conjugatesOfSet S ⊆ (P : Set A) := by
      intro x hx
      obtain ⟨a, ha, hconj⟩ := Subgroup.mem_conjugatesOfSet_iff.1 hx
      obtain ⟨c, hc⟩ := isConj_iff.1 hconj
      exact ⟨[(c, a)], by simpa using ha, by simpa using hc⟩
    exact (Subgroup.closure_le P).2 hsub hg
  · rintro ⟨l, hl, rfl⟩
    exact conjProd_mem_normalClosure l hl

/-! ## 3.  At Chiodo's tower -/

/-- The set the tower's step is the normal closure of. -/
def torsionSet (N : Subgroup A) : Set A := {g : A | ∃ n : ℕ, 0 < n ∧ g ^ n ∈ N}

theorem torsionStep_eq (N : Subgroup A) :
    Chiodo.torsionStep N = Subgroup.normalClosure (torsionSet N) := rfl

/-- **The torsion set is symmetric**, which is what
`mem_normalClosure_iff_conjProd` needs. -/
theorem torsionSet_symm (N : Subgroup A) :
    ∀ x ∈ torsionSet N, x⁻¹ ∈ torsionSet N := by
  rintro x ⟨n, hn, hx⟩
  exact ⟨n, hn, by rw [inv_pow]; exact Subgroup.inv_mem _ hx⟩

/-- **One level of the tower, as data.**  An element lies in the next stage
exactly when it is a finite product of conjugates of elements that become
torsion at the current stage. -/
theorem mem_torsionStep_iff_conjProd (N : Subgroup A) (g : A) :
    g ∈ Chiodo.torsionStep N ↔
      ∃ l : List (A × A),
        (∀ p ∈ l, ∃ n : ℕ, 0 < n ∧ p.2 ^ n ∈ N) ∧ conjProd l = g := by
  rw [torsionStep_eq]
  exact mem_normalClosure_iff_conjProd (torsionSet_symm N) g

/-- The same, at a stage of Chiodo's tower. -/
theorem mem_torsionTower_succ_iff_conjProd (i : ℕ) (g : A) :
    g ∈ Chiodo.torsionTower A (i + 1) ↔
      ∃ l : List (A × A),
        (∀ p ∈ l, ∃ n : ℕ, 0 < n ∧ p.2 ^ n ∈ Chiodo.torsionTower A i) ∧
          conjProd l = g :=
  mem_torsionStep_iff_conjProd _ g

/-! ## 4.  Tower membership as raw data

The last step before (B2) becomes a computability question: with a generating
family in hand, the conjugation data of the previous section can be taken to
be *raw words*, so a witness for membership at stage `i + 1` is a finite list
of pairs of raw words together with exponents, plus witnesses for the bases at
stage `i`.  The nesting is genuine, and flattening it into a single
`Primcodable` derivation list is what remains. -/

theorem mem_torsionTower_succ_iff_raw {A : Type} [Group A] (gen : ℕ → A)
    (hspan : Subgroup.closure (Set.range gen) = ⊤) (i : ℕ) (g : A) :
    g ∈ Chiodo.torsionTower A (i + 1) ↔
      ∃ l : List (RawWord × RawWord),
        (∀ p ∈ l, ∃ n : ℕ, 0 < n ∧
          (evalRaw gen p.2) ^ n ∈ Chiodo.torsionTower A i) ∧
        conjProd (l.map fun p ↦ (evalRaw gen p.1, evalRaw gen p.2)) = g := by
  rw [mem_torsionTower_succ_iff_conjProd]
  constructor
  · rintro ⟨l, hl, rfl⟩
    classical
    have hword : ∀ x : A, ∃ v : RawWord, evalRaw gen v = x := fun x =>
      (mem_closure_iff_exists_evalRaw gen x).1 (by rw [hspan]; exact Subgroup.mem_top x)
    refine ⟨l.map fun p ↦ (Classical.choose (hword p.1), Classical.choose (hword p.2)),
      ?_, ?_⟩
    · intro q hq
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hq
      rw [Classical.choose_spec (hword p.2)]
      exact hl p hp
    · congr 1
      rw [List.map_map]
      refine List.map_congr_left fun p _ ↦ ?_
      rw [Classical.choose_spec (hword p.1), Classical.choose_spec (hword p.2)]
  · rintro ⟨l, hl, rfl⟩
    refine ⟨l.map fun p ↦ (evalRaw gen p.1, evalRaw gen p.2), ?_, rfl⟩
    intro q hq
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hq
    exact hl p hp

end Higman
end GroupApproximation
