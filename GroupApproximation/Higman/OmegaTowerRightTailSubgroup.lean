import GroupApproximation.Higman.OmegaTowerRightTailCollapse
import GroupApproximation.Higman.OmegaTowerStaticSeam

/-!
# Subgroup-level right-tail closure for the Omega scan

The one-letter collapse extends over arbitrary words in coded conjugates whose
indices all lie in the right tail.  This is the algebraic induction used after
the inner Britton scan has ruled out every pre-tail coordinate.
-/

namespace GroupApproximation
namespace Higman
namespace Omega

open GroupApproximation.Higman.Conj
open GroupApproximation.Higman.Seq

def rightTailSet (m : ℕ) : Set E :=
  {l | ∀ i : ℤ, l i ≠ 0 → (m : ℤ) ≤ i}

def prependBlock (β : E) (S : Set E) : Set E :=
  (fun l : E => β + l) '' S

/-- Conjugation by one selected code carries the subgroup generated by
right-tail conjugates into the subgroup generated by their canonical block
prependings. -/
theorem slimGen_conj_ASub_rightTail
    {m : ℕ} {β : E} (hβ : β ∈ blockSet m) (S : Set E)
    (hS : S ⊆ rightTailSet m) {x : F₃} (hx : x ∈ ASub S) :
    (slimPiOf m (slimGenCode m β))⁻¹ * slimPiF3Hom m x *
        slimPiOf m (slimGenCode m β) ∈
      (ASub (prependBlock β S)).map (slimPiF3Hom m) := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨l, hl, rfl⟩ := hx
      refine ⟨aElt (β + l), Subgroup.subset_closure ?_, ?_⟩
      · exact ⟨β + l, ⟨l, hl, rfl⟩, rfl⟩
      · exact (slimGen_conj_aElt_eq_aElt_add_rightTail hβ (hS hl)).symm
  | one =>
      simp
  | mul x y _ _ hx hy =>
      have hxy :
          (slimPiOf m (slimGenCode m β))⁻¹ * slimPiF3Hom m (x * y) *
              slimPiOf m (slimGenCode m β) =
            ((slimPiOf m (slimGenCode m β))⁻¹ * slimPiF3Hom m x *
              slimPiOf m (slimGenCode m β)) *
            ((slimPiOf m (slimGenCode m β))⁻¹ * slimPiF3Hom m y *
              slimPiOf m (slimGenCode m β)) := by
        rw [map_mul]
        group
      rw [hxy]
      exact Subgroup.mul_mem _ hx hy
  | inv x _ hx =>
      rw [map_inv]
      have hinv :
          (slimPiOf m (slimGenCode m β))⁻¹ * (slimPiF3Hom m x)⁻¹ *
              slimPiOf m (slimGenCode m β) =
            ((slimPiOf m (slimGenCode m β))⁻¹ * slimPiF3Hom m x *
              slimPiOf m (slimGenCode m β))⁻¹ := by
        group
      rw [hinv]
      exact Subgroup.inv_mem _ hx

/-- If every right-tail generator already belongs to `omegaOp`, the entire
conjugated subgroup lands in the desired embedded Omega range. -/
theorem slimGen_conj_ASub_le_omegaRange
    {m : ℕ} (hm : 0 < m) {B S : Set E} {β : E}
    (hβ : β ∈ B ∩ blockSet m) (hS : S ⊆ rightTailSet m)
    (hSOmega : S ⊆ omegaOp m B) {x : F₃} (hx : x ∈ ASub S) :
    (slimPiOf m (slimGenCode m β))⁻¹ * slimPiF3Hom m x *
      slimPiOf m (slimGenCode m β) ∈ omegaRangeSub m B := by
  have hconj := slimGen_conj_ASub_rightTail hβ.2 S hS hx
  obtain ⟨z, hz, hzEq⟩ := hconj
  refine ⟨z, ?_, hzEq⟩
  apply Subgroup.closure_mono ?_ hz
  rintro _ ⟨f, ⟨l, hl, rfl⟩, rfl⟩
  exact ⟨β + l, add_rightTail_mem_omegaOp hm hβ (hS hl) (hSOmega hl), rfl⟩

end Omega
end Higman
end GroupApproximation
