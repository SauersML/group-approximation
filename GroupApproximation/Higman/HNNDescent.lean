import Mathlib.GroupTheory.HNNExtension
import Mathlib.Data.List.Chain

/-!
# Descent in a general HNN extension

`Higman.Pinch` proves, for the special HNN extension whose stable letter
*centralizes* a subgroup, that a subgroup generated by base elements and one
conjugate meets the base in the obvious place.  Every remaining construction
in Higman's embedding theorem needs the same statement for a *general* HNN
extension, where the stable letter conjugates `A` onto `B` by an isomorphism
`φ` that is neither the identity nor an automorphism of the base.  This file
is that generalization, and it is stated in the only form the constructions
use:

> Let `Z ≤ P` be *stable*: `φ` carries `Z ⊓ A` into `Z`, and `φ⁻¹` carries
> `Z ⊓ B` into `Z`.  Then
>
>     ⟨Z, t⟩ ⊓ P = Z .

The inclusion `⊇` is trivial.  The content is `⊆`, and it is Britton's lemma
run as a descent, exactly as in `Higman.Pinch` but with a simpler bookkeeping,
because in the general extension there is no reason to group the letters into
blocks: a word in `Z` and `t` is already of Mathlib's own shape

    of z₀ · (t^u₁ · of z₁) · (t^u₂ · of z₂) ⋯ (t^uₖ · of zₖ)

which is `HNNExtension.NormalWord.ReducedWord.prod` verbatim (`gword` below is
that product, definitionally).  So:

* if the letters form a *chain* in Mathlib's sense --- no `t^u · z · t^(-u)`
  with `z ∈ toSubgroup A B u` --- the word is reduced, and Britton's lemma
  `ReducedWord.toList_eq_nil_of_mem_of_range` says it cannot lie in the base
  unless there are no letters at all, in which case the element is `of z₀`
  with `z₀ ∈ Z`;
* otherwise some consecutive pair is `t^u · z · t^(-u) · z'` with
  `z ∈ Z ⊓ toSubgroup A B u`, the stable letter passes through it by the
  defining relation, and stability says the element it becomes is *again in
  `Z`*, so the word shortens by two letters and keeps its shape.

The descent is on the length, and each collapse removes exactly two letters.

## Why stability is the right hypothesis

`Higman.Pinch`'s hypotheses `Q ⊓ M ≤ Z` and `Z ⊓ M ≤ Q` are the special case
`φ = id`, `A = B = M`, of `Stable` for the subgroup `⟨Z, Q⟩` --- the two
directions of the same condition.  Stability is also exactly what is available
in Higman's examples: there the base is free, `φ` is an injective endomorphism
of it, and the subgroup to be cut out is chosen so that the endomorphism
permutes its distinguished generators.

## Contents

* `letter`, `gword` --- the shape of a word in `Z` and `t`.
* `Stable` --- the hypothesis.
* `exists_collapse` --- the defining relation, as a statement about `Z`.
* `eq_nil_of_isChain` --- Britton's lemma, for `gword`.
* `exists_gword` --- every element of `⟨Z, t⟩` is a `gword`.
* `descent` --- the induction.
* `closure_inf_range` --- `⟨Z, t⟩ ⊓ P = Z`, and `mem_of_mem_closure_subset`,
  the elementwise form the benign witnesses consume.
-/

namespace GroupApproximation
namespace Higman
namespace HNNDescent

open HNNExtension

variable {P : Type} [Group P] {A B : Subgroup P} (φ : A ≃* B)

/-! ## 0.  Two list lemmas -/

/-- **Every element of a generated subgroup is a product of generators and
inverses of generators.**  Mathlib states this for submonoids only. -/
theorem exists_list_of_mem_closure {G : Type*} [Group G] {s : Set G} {x : G}
    (hx : x ∈ Subgroup.closure s) :
    ∃ L : List G, (∀ y ∈ L, y ∈ s ∨ y⁻¹ ∈ s) ∧ L.prod = x := by
  have hxm : x ∈ Submonoid.closure (s ∪ s⁻¹) := by
    rw [← Subgroup.closure_toSubmonoid]
    exact hx
  obtain ⟨L, hL, hprod⟩ := Submonoid.exists_list_of_mem_closure hxm
  refine ⟨L, fun y hy ↦ ?_, hprod⟩
  rcases hL y hy with h | h
  · exact Or.inl h
  · exact Or.inr (Set.mem_inv.mp h)

/-- **A list that is not a chain has a consecutive pair that fails the
relation.**  Proved here rather than cited, so that the descent does not
depend on the spelling of Mathlib's chain-splitting lemmas. -/
theorem exists_not_rel {α : Type*} {R : α → α → Prop} :
    ∀ l : List α, ¬ l.IsChain R →
      ∃ (l₁ : List α) (a b : α) (l₂ : List α), l = l₁ ++ a :: b :: l₂ ∧ ¬ R a b
  | [], h => absurd List.isChain_nil h
  | [a], h => absurd (List.isChain_singleton a) h
  | a :: b :: l, h => by
      by_cases hab : R a b
      · have hrest : ¬ (b :: l).IsChain R := by
          intro hc
          exact h (List.isChain_cons_cons.mpr ⟨hab, hc⟩)
        obtain ⟨l₁, c, d, l₂, heq, hcd⟩ := exists_not_rel (b :: l) hrest
        exact ⟨a :: l₁, c, d, l₂, by rw [heq]; simp, hcd⟩
      · exact ⟨[], a, b, l, rfl, hab⟩

/-- The two units of `ℤ` are the only ones, so two distinct ones are
negatives. -/
theorem eq_neg_of_ne {u u' : ℤˣ} (h : u ≠ u') : u' = -u := by
  rcases Int.units_eq_one_or u with rfl | rfl <;>
    rcases Int.units_eq_one_or u' with rfl | rfl <;> simp_all

/-- A list is empty or ends in a single element. -/
theorem eq_nil_or_append_singleton {α : Type*} :
    ∀ l : List α, l = [] ∨ ∃ (L : List α) (b : α), l = L ++ [b]
  | [] => Or.inl rfl
  | a :: l => by
      rcases eq_nil_or_append_singleton l with rfl | ⟨L, b, hL⟩
      · exact Or.inr ⟨[], a, rfl⟩
      · exact Or.inr ⟨a :: L, b, by rw [hL]; simp⟩

/-! ## 1.  Words in the extension -/

/-- One letter of a word: `t^u · g`. -/
def letter (x : ℤˣ × P) : HNNExtension P A B φ :=
  (t : HNNExtension P A B φ) ^ (x.1 : ℤ) * of x.2

/-- A word: a head in the base, then a list of letters.  This is
`HNNExtension.NormalWord.ReducedWord.prod` of the record with this head and
this list, definitionally. -/
def gword (z₀ : P) (l : List (ℤˣ × P)) : HNNExtension P A B φ :=
  of z₀ * ((l.map (letter φ)).prod)

@[simp] theorem gword_nil (z₀ : P) : gword φ z₀ [] = of z₀ := by
  simp [gword]

theorem gword_cons (z₀ : P) (x : ℤˣ × P) (l : List (ℤˣ × P)) :
    gword φ z₀ (x :: l) = of z₀ * (letter φ x * ((l.map (letter φ)).prod)) := by
  rw [gword, List.map_cons, List.prod_cons]

theorem gword_append (z₀ : P) (l₁ l₂ : List (ℤˣ × P)) :
    gword φ z₀ (l₁ ++ l₂)
      = of z₀ * (((l₁.map (letter φ)).prod) * ((l₂.map (letter φ)).prod)) := by
  rw [gword, List.map_append, List.prod_append]

/-- Rewriting a suffix of a word. -/
theorem gword_append_eq (z₀ : P) (l₁ m₁ m₂ : List (ℤˣ × P))
    (h : ((m₁.map (letter φ)).prod) = ((m₂.map (letter φ)).prod)) :
    gword φ z₀ (l₁ ++ m₁) = gword φ z₀ (l₁ ++ m₂) := by
  rw [gword_append, gword_append, h]

/-- A base element merges into the head. -/
theorem of_mul_gword (a z₀ : P) (l : List (ℤˣ × P)) :
    (of a : HNNExtension P A B φ) * gword φ z₀ l = gword φ (a * z₀) l := by
  rw [gword, gword, ← mul_assoc, ← map_mul]

/-- A power of the stable letter starts a new letter. -/
theorem zpow_mul_gword (u : ℤˣ) (z₀ : P) (l : List (ℤˣ × P)) :
    ((t : HNNExtension P A B φ) ^ (u : ℤ)) * gword φ z₀ l
      = gword φ 1 ((u, z₀) :: l) := by
  rw [gword_cons, map_one, one_mul, gword]
  simp only [letter, mul_assoc]

theorem t_mul_gword (z₀ : P) (l : List (ℤˣ × P)) :
    (t : HNNExtension P A B φ) * gword φ z₀ l = gword φ 1 (((1 : ℤˣ), z₀) :: l) := by
  have h : ((1 : ℤˣ) : ℤ) = 1 := rfl
  rw [← zpow_mul_gword φ 1 z₀ l, h, zpow_one]

theorem inv_t_mul_gword (z₀ : P) (l : List (ℤˣ × P)) :
    (t : HNNExtension P A B φ)⁻¹ * gword φ z₀ l
      = gword φ 1 (((-1 : ℤˣ), z₀) :: l) := by
  have h : ((-1 : ℤˣ) : ℤ) = -1 := rfl
  rw [← zpow_mul_gword φ (-1) z₀ l, h, zpow_neg, zpow_one]

/-- A letter absorbs a following base element. -/
theorem letter_mul_of (v : ℤˣ) (w a : P) :
    letter φ (v, w) * (of a : HNNExtension P A B φ) = letter φ (v, w * a) := by
  simp only [letter, mul_assoc, ← map_mul]

/-! ## 2.  Stability, and the collapse it licenses -/

/-- **The hypothesis of the descent.**  `φ` carries the part of `Z` inside `A`
into `Z`, and `φ⁻¹` carries the part of `Z` inside `B` into `Z`. -/
structure Stable (Z : Subgroup P) : Prop where
  /-- `φ` does not leave `Z`. -/
  fwd : ∀ a : A, (a : P) ∈ Z → ((φ a : B) : P) ∈ Z
  /-- `φ⁻¹` does not leave `Z`. -/
  bwd : ∀ b : B, (b : P) ∈ Z → ((φ.symm b : A) : P) ∈ Z

/-- **The defining relation, as a statement about a stable subgroup.**
Conjugating an element of `Z ⊓ toSubgroup A B u` by `t^u` returns to the base,
and lands again in `Z`. -/
theorem exists_collapse {Z : Subgroup P} (hst : Stable φ Z) (u : ℤˣ) {g : P}
    (hgZ : g ∈ Z) (hgu : g ∈ toSubgroup A B u) :
    ∃ y ∈ Z, (t : HNNExtension P A B φ) ^ (u : ℤ) * of g
        * ((t : HNNExtension P A B φ) ^ (u : ℤ))⁻¹ = of y := by
  rcases Int.units_eq_one_or u with rfl | rfl
  · rw [toSubgroup_one] at hgu
    refine ⟨((φ ⟨g, hgu⟩ : B) : P), hst.fwd ⟨g, hgu⟩ hgZ, ?_⟩
    have h := equiv_eq_conj (φ := φ) ⟨g, hgu⟩
    have hu : ((1 : ℤˣ) : ℤ) = 1 := rfl
    rw [hu, zpow_one]
    exact h.symm
  · rw [toSubgroup_neg_one] at hgu
    refine ⟨((φ.symm ⟨g, hgu⟩ : A) : P), hst.bwd ⟨g, hgu⟩ hgZ, ?_⟩
    have h := equiv_symm_eq_conj (φ := φ) ⟨g, hgu⟩
    have hu : ((-1 : ℤˣ) : ℤ) = -1 := rfl
    rw [hu, zpow_neg, zpow_one, inv_inv]
    exact h.symm

/-- **The collapse, at the level of products.**  Two consecutive letters with
opposite exponents, the first of which the stable letter passes through,
become one base element. -/
theorem prod_cons_cons (u u' : ℤˣ) (g g' y : P) (l : List (ℤˣ × P))
    (hu' : u' = -u)
    (hy : (t : HNNExtension P A B φ) ^ (u : ℤ) * of g
        * ((t : HNNExtension P A B φ) ^ (u : ℤ))⁻¹ = of y) :
    ((((u, g) :: (u', g') :: l).map (letter φ)).prod)
      = of (y * g') * ((l.map (letter φ)).prod) := by
  have hu : (t : HNNExtension P A B φ) ^ ((u' : ℤˣ) : ℤ)
      = ((t : HNNExtension P A B φ) ^ (u : ℤ))⁻¹ := by
    rw [hu', Units.val_neg, zpow_neg]
  rw [List.map_cons, List.map_cons, List.prod_cons, List.prod_cons]
  simp only [letter, hu, map_mul]
  rw [← hy]
  simp only [mul_assoc]

/-! ## 3.  Britton's lemma, for words -/

/-- **Britton's lemma.**  A word whose letters form a chain lies in the base
only if it has no letters. -/
theorem eq_nil_of_isChain (z₀ : P) (l : List (ℤˣ × P))
    (hc : l.IsChain (fun a b : ℤˣ × P => a.2 ∈ toSubgroup A B a.1 → a.1 = b.1))
    (hmem : gword φ z₀ l ∈ (of : P →* HNNExtension P A B φ).range) : l = [] := by
  let w : NormalWord.ReducedWord P A B :=
    { head := z₀
      toList := l
      chain := hc }
  have hprod : w.prod φ = gword φ z₀ l := rfl
  have hnil : w.toList = [] := by
    refine ReducedWord.toList_eq_nil_of_mem_of_range φ w ?_
    rw [hprod]
    exact hmem
  exact hnil

/-! ## 4.  Every element of `⟨Z, t⟩` is a word -/

/-- The generating set of the subgroup the descent is about. -/
def genSet (Z : Subgroup P) : Set (HNNExtension P A B φ) :=
  ((Z.map (of : P →* HNNExtension P A B φ)) : Set (HNNExtension P A B φ)) ∪
    {(t : HNNExtension P A B φ)}

/-- A generator, or the inverse of one, is a base element of `Z`, the stable
letter, or its inverse. -/
theorem three_cases {Z : Subgroup P} {y : HNNExtension P A B φ}
    (hy : y ∈ genSet φ Z ∨ y⁻¹ ∈ genSet φ Z) :
    (∃ a ∈ Z, y = of a) ∨ y = (t : HNNExtension P A B φ) ∨
      y = (t : HNNExtension P A B φ)⁻¹ := by
  rcases hy with hy | hy
  · rcases hy with hy | hy
    · obtain ⟨a, ha, hay⟩ := hy
      exact Or.inl ⟨a, ha, hay.symm⟩
    · exact Or.inr (Or.inl (Set.mem_singleton_iff.mp hy))
  · rcases hy with hy | hy
    · obtain ⟨a, ha, hay⟩ := hy
      refine Or.inl ⟨a⁻¹, Subgroup.inv_mem Z ha, ?_⟩
      rw [map_inv, hay, inv_inv]
    · refine Or.inr (Or.inr ?_)
      rw [← Set.mem_singleton_iff.mp hy, inv_inv]

/-- **Every element of `⟨Z, t⟩` is a word with head and letters in `Z`.** -/
theorem exists_gword {Z : Subgroup P} {x : HNNExtension P A B φ}
    (hx : x ∈ Subgroup.closure (genSet φ Z)) :
    ∃ (z₀ : P) (l : List (ℤˣ × P)), z₀ ∈ Z ∧ (∀ p ∈ l, p.2 ∈ Z) ∧
      x = gword φ z₀ l := by
  obtain ⟨L, hL, rfl⟩ := exists_list_of_mem_closure hx
  clear hx
  induction L with
  | nil =>
      refine ⟨1, [], Subgroup.one_mem Z, by simp, ?_⟩
      rw [List.prod_nil, gword_nil, map_one]
  | cons y L ih =>
      have hLtail : ∀ z ∈ L, z ∈ genSet φ Z ∨ z⁻¹ ∈ genSet φ Z := by
        intro z hz
        exact hL z (List.mem_cons_of_mem _ hz)
      obtain ⟨z₀, l, hz₀, hlZ, hprod⟩ := ih hLtail
      have hy := three_cases φ (hL y List.mem_cons_self)
      rw [List.prod_cons, hprod]
      rcases hy with ⟨a, ha, rfl⟩ | rfl | rfl
      · exact ⟨a * z₀, l, Subgroup.mul_mem Z ha hz₀, hlZ,
          (of_mul_gword φ a z₀ l).symm⟩
      · refine ⟨1, ((1 : ℤˣ), z₀) :: l, Subgroup.one_mem Z, ?_,
          (t_mul_gword φ z₀ l).symm⟩
        intro p hp
        rcases List.mem_cons.mp hp with rfl | hp'
        · exact hz₀
        · exact hlZ p hp'
      · refine ⟨1, ((-1 : ℤˣ), z₀) :: l, Subgroup.one_mem Z, ?_,
          (inv_t_mul_gword φ z₀ l).symm⟩
        intro p hp
        rcases List.mem_cons.mp hp with rfl | hp'
        · exact hz₀
        · exact hlZ p hp'

/-! ## 5.  The descent -/

/-- **The descent.**  A word with head and letters in a stable `Z` that lands
in the base is a base element of `Z`.

The induction is on a length bound: a word that is not a chain has a
consecutive pair the stable letter passes through, and collapsing it removes
two letters while keeping every entry in `Z`; a word that is a chain and lands
in the base has no letters at all, by Britton's lemma. -/
theorem descent {Z : Subgroup P} (hst : Stable φ Z) :
    ∀ (n : ℕ) (z₀ : P) (l : List (ℤˣ × P)), l.length ≤ n → z₀ ∈ Z →
      (∀ p ∈ l, p.2 ∈ Z) →
      gword φ z₀ l ∈ (of : P →* HNNExtension P A B φ).range →
      ∃ y ∈ Z, gword φ z₀ l = of y := by
  intro n
  induction n with
  | zero =>
      intro z₀ l hlen hz₀ _ _
      have hnil : l = [] := by
        cases l with
        | nil => rfl
        | cons a l => simp at hlen
      subst hnil
      exact ⟨z₀, hz₀, gword_nil φ z₀⟩
  | succ n ih =>
      intro z₀ l hlen hz₀ hlZ hmem
      by_cases hc : l.IsChain
          (fun a b : ℤˣ × P => a.2 ∈ toSubgroup A B a.1 → a.1 = b.1)
      · have hnil : l = [] := eq_nil_of_isChain φ z₀ l hc hmem
        subst hnil
        exact ⟨z₀, hz₀, gword_nil φ z₀⟩
      · obtain ⟨l₁, a, b, l₂, rfl, hab⟩ := exists_not_rel l hc
        obtain ⟨u, g⟩ := a
        obtain ⟨u', g'⟩ := b
        have hgu : g ∈ toSubgroup A B u := by
          by_contra hcon
          exact hab fun hmem' => absurd hmem' hcon
        have hne : u ≠ u' := fun heq => hab fun _ => heq
        have hu' : u' = -u := eq_neg_of_ne hne
        have hgZ : g ∈ Z := hlZ (u, g) (by simp)
        have hg'Z : g' ∈ Z := hlZ (u', g') (by simp)
        obtain ⟨y, hyZ, hy⟩ := exists_collapse φ hst u hgZ hgu
        have hyg' : y * g' ∈ Z := Subgroup.mul_mem Z hyZ hg'Z
        rcases eq_nil_or_append_singleton l₁ with rfl | ⟨l₁', c, rfl⟩
        · -- the collapsing pair is at the front: it merges into the head
          have hrw : gword φ z₀ ([] ++ (u, g) :: (u', g') :: l₂)
              = gword φ (z₀ * (y * g')) l₂ := by
            simp only [List.nil_append, gword]
            rw [prod_cons_cons φ u u' g g' y l₂ hu' hy, ← mul_assoc, ← map_mul]
          have hlen' : l₂.length ≤ n := by
            simp only [List.nil_append, List.length_cons] at hlen
            omega
          have hz₀' : z₀ * (y * g') ∈ Z := Subgroup.mul_mem Z hz₀ hyg'
          have hlZ' : ∀ p ∈ l₂, p.2 ∈ Z := by
            intro p hp
            exact hlZ p (by simp [hp])
          have hmem' : gword φ (z₀ * (y * g')) l₂
              ∈ (of : P →* HNNExtension P A B φ).range := by
            rw [← hrw]
            exact hmem
          obtain ⟨w, hw, hweq⟩ := ih (z₀ * (y * g')) l₂ hlen' hz₀' hlZ' hmem'
          exact ⟨w, hw, by rw [hrw, hweq]⟩
        · -- the collapsing pair follows a letter: it merges into that letter
          obtain ⟨v, w₀⟩ := c
          have hw₀Z : w₀ ∈ Z := hlZ (v, w₀) (by simp)
          have hlist : l₁' ++ [(v, w₀)] ++ (u, g) :: (u', g') :: l₂
              = l₁' ++ ((v, w₀) :: (u, g) :: (u', g') :: l₂) := by simp
          have htail : ((((v, w₀) :: (u, g) :: (u', g') :: l₂).map (letter φ)).prod)
              = ((((v, w₀ * (y * g')) :: l₂).map (letter φ)).prod) := by
            rw [List.map_cons, List.prod_cons,
              prod_cons_cons φ u u' g g' y l₂ hu' hy, ← mul_assoc,
              letter_mul_of φ v w₀ (y * g'), List.map_cons, List.prod_cons]
          have hrw : gword φ z₀ (l₁' ++ [(v, w₀)] ++ (u, g) :: (u', g') :: l₂)
              = gword φ z₀ (l₁' ++ (v, w₀ * (y * g')) :: l₂) := by
            rw [hlist]
            exact gword_append_eq φ z₀ l₁' _ _ htail
          have hlen' : (l₁' ++ (v, w₀ * (y * g')) :: l₂).length ≤ n := by
            simp only [List.length_append, List.length_cons,
              List.length_nil] at hlen ⊢
            omega
          have hlZ' : ∀ p ∈ l₁' ++ (v, w₀ * (y * g')) :: l₂, p.2 ∈ Z := by
            intro p hp
            rcases List.mem_append.mp hp with hp' | hp'
            · exact hlZ p (by simp [hp'])
            · rcases List.mem_cons.mp hp' with rfl | hp''
              · exact Subgroup.mul_mem Z hw₀Z hyg'
              · exact hlZ p (by simp [hp''])
          have hmem' : gword φ z₀ (l₁' ++ (v, w₀ * (y * g')) :: l₂)
              ∈ (of : P →* HNNExtension P A B φ).range := by
            rw [← hrw]
            exact hmem
          obtain ⟨w, hw, hweq⟩ :=
            ih z₀ (l₁' ++ (v, w₀ * (y * g')) :: l₂) hlen' hz₀ hlZ' hmem'
          exact ⟨w, hw, by rw [hrw, hweq]⟩

/-! ## 6.  The statements the constructions use -/

/-- **The descent, in subgroup form.** -/
theorem descent_mem {Z : Subgroup P} (hst : Stable φ Z)
    {x : HNNExtension P A B φ} (hx : x ∈ Subgroup.closure (genSet φ Z))
    (hrange : x ∈ (of : P →* HNNExtension P A B φ).range) :
    x ∈ Z.map (of : P →* HNNExtension P A B φ) := by
  obtain ⟨z₀, l, hz₀, hlZ, rfl⟩ := exists_gword φ hx
  obtain ⟨y, hy, hyeq⟩ := descent φ hst l.length z₀ l le_rfl hz₀ hlZ hrange
  exact ⟨y, hy, hyeq.symm⟩

/-- **`⟨Z, t⟩ ⊓ P = Z`**, the statement this file exists for. -/
theorem closure_inf_range {Z : Subgroup P} (hst : Stable φ Z) :
    Subgroup.closure (genSet φ Z) ⊓ (of : P →* HNNExtension P A B φ).range
      = Z.map (of : P →* HNNExtension P A B φ) := by
  refine le_antisymm (fun x hx => descent_mem φ hst hx.1 hx.2) ?_
  rintro _ ⟨z, hz, rfl⟩
  exact ⟨Subgroup.subset_closure (Or.inl ⟨z, hz, rfl⟩), ⟨z, rfl⟩⟩

/-- The elementwise form. -/
theorem mem_of_of_mem_closure {Z : Subgroup P} (hst : Stable φ Z) {x : P}
    (hx : (of x : HNNExtension P A B φ) ∈ Subgroup.closure (genSet φ Z)) :
    x ∈ Z := by
  obtain ⟨z, hz, hzx⟩ := descent_mem φ hst hx ⟨x, rfl⟩
  have hzx' : z = x := of_injective (φ := φ) hzx
  rwa [← hzx']

/-- **The form a benign witness consumes.**  If a set of base elements lies in
a stable subgroup, then the subgroup it generates together with the stable
letter sees no more of the base than that stable subgroup does. -/
theorem mem_of_mem_closure_subset {Z : Subgroup P} (hst : Stable φ Z)
    (S : Set P) (hS : S ⊆ (Z : Set P)) {x : P}
    (hx : (of x : HNNExtension P A B φ) ∈
      Subgroup.closure ((of : P →* HNNExtension P A B φ) '' S ∪
        {(t : HNNExtension P A B φ)})) :
    x ∈ Z := by
  refine mem_of_of_mem_closure φ hst (Subgroup.closure_mono ?_ hx)
  rintro y (⟨a, ha, rfl⟩ | hy)
  · exact Or.inl ⟨a, hS ha, rfl⟩
  · exact Or.inr hy

end HNNDescent
end Higman
end GroupApproximation
