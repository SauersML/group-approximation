import GroupApproximation.Higman.Operations

/-!
# Elementary calculus of `HigmanGenerated`

`Higman/Operations.lean` defines `Seq.HigmanGenerated` as the inductive family
built from `Z` and `S` by the nine operations, and Higman's Section 2 — the
statement that this family is exactly the recursively enumerable subsets of the
sequence space — is the open input `HigmanTheoremThree`
(`Higman/TheoremFour.lean`).  Before that statement can be attacked at all the
family needs a working calculus: until now the only facts available about it
were its eleven constructors.

This module supplies the lattice-theoretic bottom of that calculus.  Everything
here is unconditional.

## What is proved

* `higmanGenerated_empty` — the empty set.  `Z` and `S` are disjoint, because a
  sequence in `S` has value `a` at index `0` and `a + 1` at index `1`, and both
  vanish only for contradictory `a`.  So `∅ = Z ∩ S` is generated by a single
  application of `inter`.
* `higmanGenerated_univ` — the whole space.  This one is less obvious and is the
  reason `ω` is worth having so early: `blockAt 1 i f` is by construction
  supported in `{0}`, so *every* `1`-block of *every* sequence lies in
  `ζ(Z) = atZero`.  Hence `ω₁ (ζ Z)` imposes no condition at all and is `univ`.
* closure under finite unions and finite intersections, indexed by a `Finset`.
  The two base cases are exactly the two sets above, which is why they come
  first.

## Where this is going

`HigmanGenerated` is closed under binary `∩` and `∪` by fiat, but a family
closed under binary operations and containing neither `∅` nor `univ` cannot
start an induction over a finite index set.  Every later layer — the
coordinate/support calculus, and above it the arithmetic — indexes over finite
sets of coordinates, so these are the load-bearing bottom.

The measurable exit criterion for the whole workstream: inhabiting
`Higman.HigmanTheoremThree` turns `Higman.FinalReduction.statement_of_four` into
a statement of three inputs and retires one line of the
`scripts/Audit.lean` `literaturePackages` roster.
-/

namespace GroupApproximation
namespace Higman
namespace Seq

/-! ## The two lattice bounds -/

/-- The sequences vanishing away from the origin.  This is `ζ` applied to `Z`. -/
def atZero : Set E := {f | ∀ i : ℤ, i ≠ 0 → f i = 0}

theorem zetaOp_Zset : zetaOp Zset = atZero := by
  ext f
  constructor
  · rintro ⟨g, hg, h⟩ i hi
    have hg0 : g = 0 := hg
    rw [h i hi, hg0]
    simp
  · intro h
    refine ⟨0, rfl, fun i hi => ?_⟩
    rw [h i hi]
    simp

theorem higmanGenerated_atZero : HigmanGenerated atZero := by
  rw [← zetaOp_Zset]
  exact HigmanGenerated.zeta HigmanGenerated.zero

/-- Every `1`-block is supported in `{0}`, whatever the sequence. -/
theorem blockAt_one_mem_atZero (i : ℤ) (f : E) : blockAt 1 i f ∈ atZero := by
  intro j hj
  have hnot : j ∉ Finset.Ico (0 : ℤ) ((1 : ℕ) : ℤ) := by
    simp only [Nat.cast_one, Finset.mem_Ico, not_and, not_lt]
    intro h0
    omega
  simp only [blockAt, Finsupp.onFinset_apply]
  exact if_neg hnot

/-- **The whole space is generated.**  `ω₁` of `atZero` imposes no condition,
because a `1`-block always lies in `atZero`. -/
theorem omegaOp_one_atZero : omegaOp 1 atZero = (Set.univ : Set E) := by
  ext f
  simp only [Set.mem_univ, iff_true]
  intro i
  exact blockAt_one_mem_atZero i f

theorem higmanGenerated_univ : HigmanGenerated (Set.univ : Set E) := by
  rw [← omegaOp_one_atZero]
  exact HigmanGenerated.omega 1 one_pos higmanGenerated_atZero

/-- `Z` and `S` are disjoint: a member of `S` reads `a` at index `0` and `a + 1`
at index `1`, and the zero sequence forces both to vanish. -/
theorem Zset_inter_Sset : Zset ∩ Sset = (∅ : Set E) := by
  ext f
  simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
  intro hz hs
  obtain ⟨a, ha⟩ := hs
  have hz' : f = 0 := hz
  rw [← ha] at hz'
  have h0 := congrArg (fun g : E => g 0) hz'
  have h1 := congrArg (fun g : E => g 1) hz'
  simp [succSeq] at h0 h1
  omega

theorem higmanGenerated_empty : HigmanGenerated (∅ : Set E) := by
  rw [← Zset_inter_Sset]
  exact HigmanGenerated.inter HigmanGenerated.zero HigmanGenerated.succ

/-! ## Finite unions and intersections -/

/-- **Closure under finite unions.**  The induction needs `∅` for its base
case. -/
theorem higmanGenerated_biUnion {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (B : ι → Set E) (h : ∀ i ∈ s, HigmanGenerated (B i)) :
    HigmanGenerated (⋃ i ∈ s, B i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using higmanGenerated_empty
  | insert a s ha ih =>
      rw [Finset.set_biUnion_insert]
      refine HigmanGenerated.union (h a (Finset.mem_insert_self a s))
        (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- **Closure under finite intersections.**  The induction needs `univ` for its
base case. -/
theorem higmanGenerated_biInter {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (B : ι → Set E) (h : ∀ i ∈ s, HigmanGenerated (B i)) :
    HigmanGenerated (⋂ i ∈ s, B i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using higmanGenerated_univ
  | insert a s ha ih =>
      rw [Finset.set_biInter_insert]
      refine HigmanGenerated.inter (h a (Finset.mem_insert_self a s))
        (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

end Seq
end Higman
end GroupApproximation
