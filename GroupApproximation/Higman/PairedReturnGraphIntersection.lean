import GroupApproximation.Higman.PairedReturnFirstIntersection
import GroupApproximation.Higman.TransportStar
import GroupApproximation.Higman.CoordCalculus

/-!
# The second paired-return intersection

This file specializes the paired-fold calculation to Higman's rank-three
conjugator graph.  In `P = F₃ × F₃`, put

* `alpha(h) = (h, 1)`,
* `beta(h) = (a h a⁻¹, h)`, and
* `M = ⟨alpha(K), beta(K)⟩`.

The returning differences are

`delta(h) = alpha(h)⁻¹ beta(h) = (h⁻¹ a h a⁻¹, h)`.

Their closure is normalized by both copies of `K`.  The decisive calculation
is the Cayley-edge identity

`alpha(k) delta(h) alpha(k)⁻¹ = delta(h k⁻¹) delta(k⁻¹)⁻¹`.

Consequently this closure is the kernel, inside `M`, of the retraction which
kills `a`.  On the other hand every `delta(h)` is the graph word
`genPair(h) genPair(1)⁻¹`, while the whole conjugator graph is killed by the
same retraction in its first coordinate.  This proves, without construction
hypotheses,

`Star.graphSub ⊓ M = deltaSub`.
-/

namespace GroupApproximation
namespace Higman
namespace PairedReturnGraphIntersection

open scoped Monoid.Coprod
open Conj
open PairedFoldKernel

/-- The two-coordinate ambient group. -/
abbrev P : Type := F₃ × F₃

/-- The untwisted return path `h ↦ (h,1)`. -/
def alpha : ↥K →* P where
  toFun h := ((h : F₃), 1)
  map_one' := rfl
  map_mul' _ _ := rfl

/-- The conjugated return path `h ↦ (a h a⁻¹,h)`. -/
def beta : ↥K →* P where
  toFun h := (a * (h : F₃) * a⁻¹, (h : F₃))
  map_one' := by
    apply Prod.ext <;> simp
  map_mul' h k := by
    apply Prod.ext
    · change a * ((h : F₃) * (k : F₃)) * a⁻¹ =
        (a * (h : F₃) * a⁻¹) * (a * (k : F₃) * a⁻¹)
      group
    · rfl

@[simp] theorem alpha_apply (h : ↥K) :
    alpha h = ((h : F₃), 1) := rfl

@[simp] theorem beta_apply (h : ↥K) :
    beta h = (a * (h : F₃) * a⁻¹, (h : F₃)) := rfl

/-- The map from the two-copy free product generated by `alpha` and `beta`. -/
def mu : Monoid.Coprod ↥K ↥K →* P :=
  Monoid.Coprod.lift alpha beta

@[simp] theorem mu_inl (h : ↥K) :
    mu (Monoid.Coprod.inl h) = alpha h := by
  rw [mu, Monoid.Coprod.lift_apply_inl]

@[simp] theorem mu_inr (h : ↥K) :
    mu (Monoid.Coprod.inr h) = beta h := by
  rw [mu, Monoid.Coprod.lift_apply_inr]

/-- The four-generator paired-return edge group. -/
def M : Subgroup P := mu.range

/-- The returning difference between the two paths. -/
def delta (h : ↥K) : P := (alpha h)⁻¹ * beta h

@[simp] theorem delta_apply (h : ↥K) :
    delta h = ((h : F₃)⁻¹ * a * (h : F₃) * a⁻¹, (h : F₃)) := by
  apply Prod.ext <;> simp [delta, alpha, beta]
  group

/-- The subgroup generated by all returning differences. -/
def deltaSub : Subgroup P := Subgroup.closure (Set.range delta)

theorem delta_mem_deltaSub (h : ↥K) : delta h ∈ deltaSub :=
  Subgroup.subset_closure ⟨h, rfl⟩

/-- The Cayley-edge identity controlling conjugation by the first path. -/
theorem alpha_conj_delta (h k : ↥K) :
    alpha k * delta h * (alpha k)⁻¹ =
      delta ⟨(h : F₃) * (k : F₃)⁻¹,
        K.mul_mem h.property (K.inv_mem k.property)⟩ *
        (delta ⟨(k : F₃)⁻¹, K.inv_mem k.property⟩)⁻¹ := by
  apply Prod.ext <;> simp [alpha, delta_apply]
  group

/-- Every element of the first return path normalizes the difference
subgroup. -/
theorem alpha_conj_mem_deltaSub (k : ↥K) {z : P}
    (hz : z ∈ deltaSub) :
    alpha k * z * (alpha k)⁻¹ ∈ deltaSub := by
  induction hz using Subgroup.closure_induction with
  | mem z hz =>
      obtain ⟨h, rfl⟩ := hz
      rw [alpha_conj_delta]
      exact (deltaSub.mul_mem (delta_mem_deltaSub _) (deltaSub.inv_mem (delta_mem_deltaSub _)))
  | one =>
      simpa only [mul_one, mul_inv_cancel] using deltaSub.one_mem
  | mul x y _ _ hx hy =>
      rw [show alpha k * (x * y) * (alpha k)⁻¹ =
        (alpha k * x * (alpha k)⁻¹) *
          (alpha k * y * (alpha k)⁻¹) by group]
      exact deltaSub.mul_mem hx hy
  | inv x _ hx =>
      rw [show alpha k * x⁻¹ * (alpha k)⁻¹ =
        (alpha k * x * (alpha k)⁻¹)⁻¹ by group]
      exact deltaSub.inv_mem hx

theorem alpha_mem_normalizer (k : ↥K) :
    alpha k ∈ Subgroup.normalizer (deltaSub : Set P) := by
  rw [Subgroup.mem_normalizer_iff]
  intro z
  constructor
  · exact alpha_conj_mem_deltaSub k
  · intro hz
    have hback := alpha_conj_mem_deltaSub ⟨(k : F₃)⁻¹, K.inv_mem k.property⟩ hz
    have halpha : alpha ⟨(k : F₃)⁻¹, K.inv_mem k.property⟩ = (alpha k)⁻¹ := by
      exact map_inv alpha k
    rw [halpha] at hback
    have heq : (alpha k)⁻¹ * (alpha k * z * (alpha k)⁻¹) * ((alpha k)⁻¹)⁻¹ = z := by
      group
    rw [heq] at hback
    exact hback

/-- The second path is the first path followed by its returning difference. -/
theorem beta_eq_alpha_mul_delta (k : ↥K) :
    beta k = alpha k * delta k := by
  simp only [delta]
  group

theorem beta_mem_normalizer (k : ↥K) :
    beta k ∈ Subgroup.normalizer (deltaSub : Set P) := by
  rw [beta_eq_alpha_mul_delta]
  exact (Subgroup.normalizer (deltaSub : Set P)).mul_mem
    (alpha_mem_normalizer k) (deltaSub.le_normalizer (delta_mem_deltaSub k))

/-- Every paired-return word normalizes the difference subgroup. -/
theorem mu_mem_normalizer (w : Monoid.Coprod ↥K ↥K) :
    mu w ∈ Subgroup.normalizer (deltaSub : Set P) := by
  induction w using Monoid.Coprod.induction_on with
  | inl h => simpa using alpha_mem_normalizer h
  | inr h => simpa using beta_mem_normalizer h
  | mul x y hx hy => simpa using (Subgroup.normalizer (deltaSub : Set P)).mul_mem hx hy

theorem deltaSub_le_M : deltaSub ≤ M := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨h, rfl⟩
  change (alpha h)⁻¹ * beta h ∈ M
  exact M.mul_mem
    (M.inv_mem ⟨Monoid.Coprod.inl h, mu_inl h⟩)
    ⟨Monoid.Coprod.inr h, mu_inr h⟩

/-- The returning subgroup, now regarded inside the paired-return edge group. -/
def Delta : Subgroup ↥M := deltaSub.subgroupOf M

/-- Retraction of the edge group onto `K`, obtained from the first coordinate
by killing `a`. -/
def psi : ↥M →* F₃ :=
  Coord.retK.comp ((MonoidHom.fst F₃ F₃).comp M.subtype)

/-- The canonical surjection from the two-copy free product onto `M`. -/
def muToM : Monoid.Coprod ↥K ↥K →* ↥M := mu.rangeRestrict

/-- On the two-copy presentation of `M`, `psi` is exactly the fold map. -/
theorem psi_comp_muToM :
    psi.comp muToM = K.subtype.comp (fold ↥K) := by
  refine Monoid.Coprod.hom_ext ?_ ?_
  · apply MonoidHom.ext
    intro h
    change Coord.retK (h : F₃) = (h : F₃)
    exact Coord.retK_of_mem_K h.property
  · apply MonoidHom.ext
    intro h
    change Coord.retK (a * (h : F₃) * a⁻¹) = (h : F₃)
    simp only [map_mul, map_inv, Coord.retK_a,
      Coord.retK_of_mem_K h.property, inv_one, one_mul, mul_one]

theorem psi_mu (w : Monoid.Coprod ↥K ↥K) :
    psi (muToM w) = (fold ↥K w : ↥K) := by
  exact DFunLike.congr_fun psi_comp_muToM w

/-- The preimage of `deltaSub` in the free product is normal: all conjugators
map into `M`, and every element of `M` normalizes `deltaSub`. -/
instance mu_comap_deltaSub_normal : (deltaSub.comap mu).Normal where
  conj_mem := by
    intro x hx g
    change mu (g * x * g⁻¹) ∈ deltaSub
    simp only [map_mul, map_inv]
    exact (Subgroup.mem_normalizer_iff.mp (mu_mem_normalizer g) (mu x)).mp hx

/-- The fold kernel maps into the concrete returning subgroup. -/
theorem fold_ker_le_mu_comap_deltaSub :
    (fold ↥K).ker ≤ deltaSub.comap mu := by
  rw [fold_ker_eq_differenceRel]
  apply Subgroup.normalClosure_le_normal
  rintro _ ⟨h, -, rfl⟩
  change mu (difference ↥K h) ∈ deltaSub
  have heq : mu (difference ↥K h) =
      delta ⟨(h : F₃)⁻¹, K.inv_mem h.property⟩ := by
    simp only [difference, map_mul, map_inv, mu_inl, mu_inr, map_inv]
    apply Prod.ext
    · simp [delta, alpha, beta]
      group
    · simp [delta, alpha, beta]
  rw [heq]
  exact delta_mem_deltaSub _

/-- The retraction kills every returning difference. -/
theorem deltaSub_le_retK_fst_ker :
    deltaSub ≤ (Coord.retK.comp (MonoidHom.fst F₃ F₃)).ker := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨h, rfl⟩
  apply MonoidHom.mem_ker.mpr
  simp [delta_apply, Coord.retK_of_mem_K h.property]

/-- **Fold kernel inside the edge group.**  The retraction kernel is exactly
the concrete returning subgroup. -/
theorem psi_ker_eq_Delta : psi.ker = Delta := by
  ext m
  constructor
  · intro hm
    obtain ⟨w, hw⟩ := m.property
    have hfold : fold ↥K w = 1 := by
      have hpsi : psi (muToM w) = 1 := by
        have hmEq : muToM w = m := Subtype.ext hw
        rw [hmEq]
        exact hm
      rw [psi_mu] at hpsi
      exact Subtype.ext hpsi
    have hdelta : mu w ∈ deltaSub :=
      fold_ker_le_mu_comap_deltaSub (MonoidHom.mem_ker.mpr hfold)
    change (m : P) ∈ deltaSub
    simpa [hw] using hdelta
  · intro hm
    change Coord.retK (m : P).1 = 1
    change (m : P) ∈ deltaSub at hm
    exact MonoidHom.mem_ker.mp (deltaSub_le_retK_fst_ker hm)

/-- Every returning difference is a word in Higman's conjugator graph. -/
theorem delta_mem_graphSub (h : ↥K) : delta h ∈ Star.graphSub := by
  apply Star.mem_graphSub.mpr
  refine ⟨FreeGroup.of h * (FreeGroup.of (1 : ↥K))⁻¹, ?_⟩
  simp only [map_mul, map_inv, Star.graphHom_of]
  apply Prod.ext <;> simp [Star.genPair, delta_apply]

theorem deltaSub_le_graphSub : deltaSub ≤ Star.graphSub := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨h, rfl⟩
  exact delta_mem_graphSub h

/-- The first coordinate of every graph word is killed by `retK`. -/
theorem graphSub_le_retK_fst_ker :
    Star.graphSub ≤
      (Coord.retK.comp (MonoidHom.fst F₃ F₃)).ker := by
  rw [Star.graphSub_eq_closure]
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨h, rfl⟩
  exact MonoidHom.mem_ker.mpr (Coord.retK_conjA h.property)

/-- **Second exact paired-return intersection.**  Higman's infinite
conjugator graph meets the four-generator paired-return edge group in exactly
the returning difference subgroup. -/
theorem graphSub_inf_M_eq_deltaSub :
    Star.graphSub ⊓ M = deltaSub := by
  refine le_antisymm ?_ ?_
  · intro z hz
    obtain ⟨hzGraph, hzM⟩ := Subgroup.mem_inf.mp hz
    let m : ↥M := ⟨z, hzM⟩
    have hmker : m ∈ psi.ker := by
      apply MonoidHom.mem_ker.mpr
      exact graphSub_le_retK_fst_ker hzGraph
    rw [psi_ker_eq_Delta] at hmker
    exact hmker
  · intro z hz
    exact Subgroup.mem_inf.mpr ⟨deltaSub_le_graphSub hz, deltaSub_le_M hz⟩

/-- Subtype form used by the subsequent amalgam descent. -/
theorem graphSub_comap_M_eq_Delta :
    Star.graphSub.comap M.subtype = Delta := by
  ext m
  change (m : P) ∈ Star.graphSub ↔ (m : P) ∈ deltaSub
  constructor
  · intro hm
    exact graphSub_inf_M_eq_deltaSub.le ⟨hm, m.property⟩
  · intro hm
    exact deltaSub_le_graphSub hm

end PairedReturnGraphIntersection
end Higman
end GroupApproximation
