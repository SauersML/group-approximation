import GroupApproximation.Higman.OmegaFillLinkResidue
import GroupApproximation.Higman.OmegaFillSlimClosureClosed
import GroupApproximation.Higman.HNNStableHullBenign
import GroupApproximation.Higman.SwapWitnessTower
import GroupApproximation.Higman.OperationClosureTau
import GroupApproximation.Higman.SeqFilter
import GroupApproximation.Higman.OmegaTowerStages

/-!
# The sheared link is benign: Mikaelian's Examples 3.10–3.12 in the fat stage

`Higman.OmegaFillLinkResidue` reduces Higman's `ωₘ` closure to one statement,

    ∀ m, BenignTF (Omega.fatShearedBlockLink m) ,

the subgroup `Z = ⟨z_β : β ∈ ℰ_m⟩` of `Q = FatCent3 m × F₃` generated by
`z_β = (g_β b_β⁻¹, b_β⁻¹)`.  This file proves it.  The group `Q` is finitely
presented and torsion-free, so the torsion-free benign calculus applies inside
it: finitely generated subgroups are benign (`benignTF_of_fg`), joins of benign
subgroups are benign (`BenignTF.sup`), and the stable hull of a benign subgroup
under an automorphism of `Q` is benign (`BenignTF.stableHull`).

## The construction (Mikaelian, arXiv:1908.10153, Examples 3.10–3.12)

Write `h_i = h^{kⁱ}` for the second copy of the rows, `h_β` for the ascending
product `∏ h_i^{β i}`, and `g_β = g^{h_β}`; on the first coordinate of `Q`
these are `genHom (rowElt i)`, `genHom (bElt β)`, `fatGenCode m β`.

* **The automorphisms.**  For each `j`, the map `g ↦ g^{h_j}`, fixing `h`, `k`
  and the fat base, is an automorphism `φ_j` of `FatCent3 m`: it is well
  defined because `g^{h_j}` centralizes the cutter as `g` does, and its inverse
  is `g ↦ h_j g h_j⁻¹`.  Let `Φ_j = φ_j × id` on `Q`.  Since `φ_j` fixes every
  `h_i`, `φ_j (g_β) = g^{h_j h_β}`, and when `β` vanishes below `j` the
  ascending product gives `h_j h_β = h_{β + e_j}`, so
  `φ_j (g_β) = g_{β + e_j}`.  This is why the hulls below are taken in the
  order `j = r, r - 1, …, 0`: each step prepends a row to a product supported
  strictly to its right, which is where Mikaelian's "trivial to verify" holds.
* **Example 3.11, the `V`-subgroups.**  For `β` supported on `[0, r]` put
  `v_β = (g_{β + e_r} b_r⁻¹ g_β⁻¹, b_r⁻¹)`, and let `T_j` be generated by the
  `v_β` with `β` supported on `[j, r]`.  Then `T_{r+1} = ⟨v_0⟩` is cyclic, and
  `T_j` is exactly the stable hull of `T_{j+1}` under `Φ_j`, because
  `Φ_j v_β = v_{β + e_j}` for `β` supported on `[j, r]`
  (`linkAut_vElem`): the hull is generated by the `Φ_j^n`-images of the
  generators of `T_{j+1}`, and those are the `v_β` with `β_j = n`.  So every
  `T_j`, in particular `V^{(r)} = T_0`, is benign.
* **Example 3.12, the join.**  Let `Z_r` be generated by the `z_β` with `β`
  supported on `[0, r)`.  The identity `v_β z_β = z_{β + e_r}` for `β`
  supported on `[0, r]` (`vElem_mul_linkElem`) gives `Z_{r+1} = Z_r ⊔ V^{(r)}`:
  every `z_β` with `β_r = n` is reached from `z_{β - n e_r} ∈ Z_r` by `n`
  multiplications by elements of `V^{(r)}`, and conversely
  `v_β = z_{β + e_r} z_β⁻¹ ∈ Z_{r+1}`.  So `Z_r` is benign by induction from
  `Z_0 = ⟨z_0⟩`, and `Z_m` is the sheared link.

Nothing here uses a normal form: only the three closure lemmas of the benign
calculus and the ascending-product bookkeeping of the coding.
-/

namespace GroupApproximation
namespace Higman
namespace Omega
namespace LeadLink

open GroupApproximation.Higman.Conj
open GroupApproximation.Higman.Seq

/-! ## 1.  Windows and the ascending product -/

/-- Sequences supported on the closed window `[j, r]`. -/
def windowSet (j r : ℤ) : Set E := {f : E | ∀ i ∈ f.support, j ≤ i ∧ i ≤ r}

/-- Sequences supported on `[0, r)`. -/
def lowSet (r : ℤ) : Set E := {f : E | ∀ i ∈ f.support, 0 ≤ i ∧ i < r}

theorem windowSet_mono_succ {j r : ℤ} {f : E} (hf : f ∈ windowSet (j + 1) r) :
    f ∈ windowSet j r := by
  intro i hi
  obtain ⟨h1, h2⟩ := hf i hi
  exact ⟨by omega, h2⟩

theorem erase_mem_windowSet {j r : ℤ} {f : E} (hf : f ∈ windowSet j r) :
    f.erase j ∈ windowSet (j + 1) r := by
  intro i hi
  rw [Finsupp.support_erase, Finset.mem_erase] at hi
  obtain ⟨hne, hi⟩ := hi
  obtain ⟨h1, h2⟩ := hf i hi
  exact ⟨by omega, h2⟩

theorem add_single_mem_windowSet {j r : ℤ} {f : E} (hf : f ∈ windowSet j r) {k : ℤ}
    (hjk : j ≤ k) (hkr : k ≤ r) (n : ℤ) :
    f + Finsupp.single k n ∈ windowSet j r := by
  intro i hi
  by_cases hik : i = k
  · subst hik
    exact ⟨hjk, hkr⟩
  · have hfi : f i ≠ 0 := by
      intro h0
      apply Finsupp.mem_support_iff.mp hi
      rw [Finsupp.add_apply, Finsupp.single_apply, if_neg (Ne.symm hik), h0, add_zero]
    exact hf i (Finsupp.mem_support_iff.mpr hfi)

theorem lowSet_subset_windowSet {r : ℤ} {f : E} (hf : f ∈ lowSet (r + 1)) :
    f ∈ windowSet 0 r := by
  intro i hi
  obtain ⟨h1, h2⟩ := hf i hi
  exact ⟨h1, by omega⟩

theorem windowSet_subset_lowSet {r : ℤ} {f : E} (hf : f ∈ windowSet 0 r) :
    f ∈ lowSet (r + 1) := by
  intro i hi
  obtain ⟨h1, h2⟩ := hf i hi
  exact ⟨h1, by omega⟩

theorem lowSet_mono_succ {r : ℤ} {f : E} (hf : f ∈ lowSet r) : f ∈ lowSet (r + 1) := by
  intro i hi
  obtain ⟨h1, h2⟩ := hf i hi
  exact ⟨h1, by omega⟩

theorem erase_mem_lowSet {r : ℤ} {f : E} (hf : f ∈ lowSet (r + 1)) :
    f.erase r ∈ lowSet r := by
  intro i hi
  rw [Finsupp.support_erase, Finset.mem_erase] at hi
  obtain ⟨hne, hi⟩ := hi
  obtain ⟨h1, h2⟩ := hf i hi
  exact ⟨h1, lt_of_le_of_ne (by omega) hne⟩

theorem zero_mem_windowSet (j r : ℤ) : (0 : E) ∈ windowSet j r := by
  intro i hi
  rw [Finsupp.support_zero] at hi
  exact absurd hi (Finset.notMem_empty i)

theorem eq_zero_of_mem_windowSet_succ {r : ℤ} {f : E} (hf : f ∈ windowSet (r + 1) r) :
    f = 0 := by
  refine Finsupp.ext fun i => ?_
  by_contra h
  obtain ⟨h1, h2⟩ := hf i (Finsupp.mem_support_iff.mpr h)
  omega

theorem eq_zero_of_mem_lowSet_zero {f : E} (hf : f ∈ lowSet 0) : f = 0 := by
  refine Finsupp.ext fun i => ?_
  by_contra h
  obtain ⟨h1, h2⟩ := hf i (Finsupp.mem_support_iff.mpr h)
  omega

/-- **Appending a row at or above the support is right multiplication.**  The
index `r` may already carry a coefficient: the two coefficients add. -/
theorem elt_add_single_of_le {f : E} {r : ℤ} (hf : ∀ i ∈ f.support, i ≤ r) (n : ℤ) :
    elt (f + Finsupp.single r n) = elt f * FreeGroup.of r ^ n := by
  have hlt : ∀ k : ℤ, ∀ i ∈ (f.erase r).support,
      ∀ j ∈ (Finsupp.single r k).support, i < j := by
    intro k i hi j hj
    rw [Finsupp.support_erase, Finset.mem_erase] at hi
    have hj' : j = r := Finset.mem_singleton.mp (Finsupp.support_single_subset hj)
    subst hj'
    exact lt_of_le_of_ne (hf i hi.2) hi.1
  have h1 : f + Finsupp.single r n = f.erase r + Finsupp.single r (f r + n) := by
    rw [Finsupp.single_add, ← add_assoc, Finsupp.erase_add_single]
  have h2 : elt f = elt (f.erase r) * FreeGroup.of r ^ (f r) := by
    conv_lhs => rw [← Finsupp.erase_add_single r f]
    rw [elt_add_of_lt (hlt (f r)), Split.elt_single]
  rw [h1, elt_add_of_lt (hlt (f r + n)), Split.elt_single, h2, zpow_add, mul_assoc]

/-- **Prepending a row at or below the support is left multiplication.** -/
theorem elt_single_add_of_le {f : E} {j : ℤ} (hf : ∀ i ∈ f.support, j ≤ i) (n : ℤ) :
    elt (Finsupp.single j n + f) = FreeGroup.of j ^ n * elt f := by
  have hlt : ∀ k : ℤ, ∀ i ∈ (Finsupp.single j k).support,
      ∀ i' ∈ (f.erase j).support, i < i' := by
    intro k i hi i' hi'
    rw [Finsupp.support_erase, Finset.mem_erase] at hi'
    have hi2 : i = j := Finset.mem_singleton.mp (Finsupp.support_single_subset hi)
    subst hi2
    exact lt_of_le_of_ne (hf i' hi'.2) (Ne.symm hi'.1)
  have h1 : Finsupp.single j n + f = Finsupp.single j (n + f j) + f.erase j := by
    conv_lhs => rw [← Finsupp.single_add_erase j f]
    rw [← add_assoc, ← Finsupp.single_add]
  have h2 : elt f = FreeGroup.of j ^ (f j) * elt (f.erase j) := by
    conv_lhs => rw [← Finsupp.single_add_erase j f]
    rw [elt_add_of_lt (hlt (f j)), Split.elt_single]
  rw [h1, elt_add_of_lt (hlt (n + f j)), Split.elt_single, h2, zpow_add, mul_assoc]

theorem bElt_add_single_of_le {f : E} {r : ℤ} (hf : ∀ i ∈ f.support, i ≤ r) (n : ℤ) :
    bElt (f + Finsupp.single r n) = bElt f * rowElt r ^ n := by
  unfold Seq.bElt
  rw [elt_add_single_of_le hf, map_mul, map_zpow, rowHom_of]

theorem bElt_single_add_of_le {f : E} {j : ℤ} (hf : ∀ i ∈ f.support, j ≤ i) (n : ℤ) :
    bElt (Finsupp.single j n + f) = rowElt j ^ n * bElt f := by
  unfold Seq.bElt
  rw [elt_single_add_of_le hf, map_mul, map_zpow, rowHom_of]

/-! ## 2.  The automorphism `a ↦ a^{bⱼ}` of `F₃` -/

/-- `a ↦ a^{bⱼ}`, fixing `b` and `c`. -/
def rowConjHom (j : ℤ) : F₃ →* F₃ :=
  FreeGroup.lift (fun i : Fin 3 =>
    if i = 0 then (rowElt j)⁻¹ * a * rowElt j else if i = 1 then b else c)

/-- `a ↦ bⱼ a bⱼ⁻¹`, fixing `b` and `c`: the inverse of `rowConjHom`. -/
def rowConjHomInv (j : ℤ) : F₃ →* F₃ :=
  FreeGroup.lift (fun i : Fin 3 =>
    if i = 0 then rowElt j * a * (rowElt j)⁻¹ else if i = 1 then b else c)

@[simp] theorem rowConjHom_a (j : ℤ) :
    rowConjHom j a = (rowElt j)⁻¹ * a * rowElt j := by
  unfold rowConjHom a
  rw [FreeGroup.lift_apply_of]
  simp

@[simp] theorem rowConjHom_b (j : ℤ) : rowConjHom j b = b := by
  unfold rowConjHom b
  rw [FreeGroup.lift_apply_of]
  simp

@[simp] theorem rowConjHom_c (j : ℤ) : rowConjHom j c = c := by
  unfold rowConjHom c
  rw [FreeGroup.lift_apply_of]
  simp

@[simp] theorem rowConjHomInv_a (j : ℤ) :
    rowConjHomInv j a = rowElt j * a * (rowElt j)⁻¹ := by
  unfold rowConjHomInv a
  rw [FreeGroup.lift_apply_of]
  simp

@[simp] theorem rowConjHomInv_b (j : ℤ) : rowConjHomInv j b = b := by
  unfold rowConjHomInv b
  rw [FreeGroup.lift_apply_of]
  simp

@[simp] theorem rowConjHomInv_c (j : ℤ) : rowConjHomInv j c = c := by
  unfold rowConjHomInv c
  rw [FreeGroup.lift_apply_of]
  simp

theorem rowConjHom_rowElt (j i : ℤ) : rowConjHom j (rowElt i) = rowElt i := by
  unfold Seq.rowElt
  rw [map_mul, map_mul, map_zpow, map_zpow, rowConjHom_b, rowConjHom_c]

theorem rowConjHomInv_rowElt (j i : ℤ) : rowConjHomInv j (rowElt i) = rowElt i := by
  unfold Seq.rowElt
  rw [map_mul, map_mul, map_zpow, map_zpow, rowConjHomInv_b, rowConjHomInv_c]

theorem rowConjHom_comp_rowHom (j : ℤ) : (rowConjHom j).comp rowHom = rowHom := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  show rowConjHom j (rowHom (FreeGroup.of i)) = rowHom (FreeGroup.of i)
  rw [rowHom_of, rowConjHom_rowElt]

theorem rowConjHomInv_comp_rowHom (j : ℤ) : (rowConjHomInv j).comp rowHom = rowHom := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  show rowConjHomInv j (rowHom (FreeGroup.of i)) = rowHom (FreeGroup.of i)
  rw [rowHom_of, rowConjHomInv_rowElt]

theorem rowConjHom_bElt (j : ℤ) (f : E) : rowConjHom j (bElt f) = bElt f := by
  unfold Seq.bElt
  exact congrArg (fun φ : FreeGroup ℤ →* F₃ => φ (elt f)) (rowConjHom_comp_rowHom j)

theorem rowConjHomInv_bElt (j : ℤ) (f : E) : rowConjHomInv j (bElt f) = bElt f := by
  unfold Seq.bElt
  exact congrArg (fun φ : FreeGroup ℤ →* F₃ => φ (elt f)) (rowConjHomInv_comp_rowHom j)

theorem rowConjHomInv_comp_rowConjHom (j : ℤ) :
    (rowConjHomInv j).comp (rowConjHom j) = MonoidHom.id F₃ := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  fin_cases i
  · show rowConjHomInv j (rowConjHom j a) = a
    rw [rowConjHom_a, map_mul, map_mul, map_inv, rowConjHomInv_rowElt, rowConjHomInv_a]
    group
  · show rowConjHomInv j (rowConjHom j b) = b
    rw [rowConjHom_b, rowConjHomInv_b]
  · show rowConjHomInv j (rowConjHom j c) = c
    rw [rowConjHom_c, rowConjHomInv_c]

theorem rowConjHom_comp_rowConjHomInv (j : ℤ) :
    (rowConjHom j).comp (rowConjHomInv j) = MonoidHom.id F₃ := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  fin_cases i
  · show rowConjHom j (rowConjHomInv j a) = a
    rw [rowConjHomInv_a, map_mul, map_mul, map_inv, rowConjHom_rowElt, rowConjHom_a]
    group
  · show rowConjHom j (rowConjHomInv j b) = b
    rw [rowConjHomInv_b, rowConjHom_b]
  · show rowConjHom j (rowConjHomInv j c) = c
    rw [rowConjHomInv_c, rowConjHom_c]

/-- **`a ↦ a^{bⱼ}` prepends `bⱼ` to a coded conjugator supported at or after
`j`.**  This is the ascending-product identity behind Mikaelian's
"`v_f^{t_r} = v_{f_r^+}`", and it is true exactly when `f` vanishes before `r`. -/
theorem rowConjHom_aElt {j : ℤ} {f : E} (hf : ∀ i ∈ f.support, j ≤ i) :
    rowConjHom j (aElt f) = aElt (f + Finsupp.single j 1) := by
  have hb : bElt (f + Finsupp.single j 1) = rowElt j * bElt f := by
    rw [add_comm, bElt_single_add_of_le hf, zpow_one]
  unfold Seq.aElt
  rw [map_mul, map_mul, map_inv, rowConjHom_bElt, rowConjHom_a, hb]
  group

theorem rowConjHomInv_aElt {j : ℤ} {f : E} (hf : ∀ i ∈ f.support, j ≤ i) :
    rowConjHomInv j (aElt f) = aElt (f + Finsupp.single j (-1)) := by
  have hb : bElt (f + Finsupp.single j (-1)) = (rowElt j)⁻¹ * bElt f := by
    rw [add_comm, bElt_single_add_of_le hf, zpow_neg_one]
  unfold Seq.aElt
  rw [map_mul, map_mul, map_inv, rowConjHomInv_bElt, rowConjHomInv_a, hb]
  group

/-! ## 3.  The automorphism `g ↦ g^{hⱼ}` of `Σ`

`Σ = Cent3 P` is three centralizing HNN extensions.  The endomorphism fixing
the base and `h`, `k` and sending `g` to `g^{hⱼ}` is built by three lifts; it
is well defined because `g^{hⱼ}` centralizes the cutter, all three letters
doing so.  The inverse sends `g` to `hⱼ g hⱼ⁻¹`. -/

section GenConj

variable {G₀ : Type} [Group G₀] (P : Subgroup G₀) (j : ℤ)

/-- `hⱼ`, in `Σ`. -/
def genRow : Cent3 P := genHom P (rowElt j)

theorem commute_genRow_emb3 {x : G₀} (hx : x ∈ P) : Commute (genRow P j) (emb3 P x) :=
  commute_genHom (rowElt j) hx

/-- `g^{hⱼ}`. -/
def genConjTarget : Cent3 P := (genRow P j)⁻¹ * gen1 P * genRow P j

/-- `hⱼ g hⱼ⁻¹`. -/
def genConjTargetInv : Cent3 P := genRow P j * gen1 P * (genRow P j)⁻¹

theorem commute_genConjTarget {x : G₀} (hx : x ∈ P) :
    Commute (genConjTarget P j) (emb3 P x) :=
  ((commute_genRow_emb3 P j hx).inv_left.mul_left (commute_gen1 hx)).mul_left
    (commute_genRow_emb3 P j hx)

theorem commute_genConjTargetInv {x : G₀} (hx : x ∈ P) :
    Commute (genConjTargetInv P j) (emb3 P x) :=
  ((commute_genRow_emb3 P j hx).mul_left (commute_gen1 hx)).mul_left
    (commute_genRow_emb3 P j hx).inv_left

/-- Level one of the lift: the base to `Σ`, and `g` to a prescribed element
`y` commuting with the cutter. -/
noncomputable def genLift1 (y : Cent3 P) (hy : ∀ x ∈ P, Commute y (emb3 P x)) :
    Cent1 P →* Cent3 P :=
  HNNExtension.lift (emb3 P) y (fun x => by
    show y * emb3 P (x : G₀) = emb3 P (((MulEquiv.refl P) x : P) : G₀) * y
    rw [MulEquiv.refl_apply]
    exact (hy x x.2).eq)

/-- Level two: `h` to `h`. -/
noncomputable def genLift2 (y : Cent3 P) (hy : ∀ x ∈ P, Commute y (emb3 P x)) :
    Cent2 P →* Cent3 P :=
  HNNExtension.lift (genLift1 P y hy) (gen2 P) (fun z => by
    obtain ⟨x, hx, hxz⟩ := z.2
    show gen2 P * genLift1 P y hy (z : Cent1 P)
      = genLift1 P y hy (((MulEquiv.refl (push1 P)) z : push1 P) : Cent1 P) * gen2 P
    rw [MulEquiv.refl_apply, ← hxz]
    change gen2 P * genLift1 P y hy (HNNExtension.of x)
      = genLift1 P y hy (HNNExtension.of x) * gen2 P
    unfold genLift1
    rw [HNNExtension.lift_of]
    exact (commute_gen2 hx).eq)

/-- Level three: `k` to `k`. -/
noncomputable def genLift3 (y : Cent3 P) (hy : ∀ x ∈ P, Commute y (emb3 P x)) :
    Cent3 P →* Cent3 P :=
  HNNExtension.lift (genLift2 P y hy) (gen3 P) (fun w => by
    obtain ⟨z, hz, hzw⟩ := w.2
    obtain ⟨x, hx, hxz⟩ := hz
    show gen3 P * genLift2 P y hy (w : Cent2 P)
      = genLift2 P y hy (((MulEquiv.refl (push2 P)) w : push2 P) : Cent2 P) * gen3 P
    rw [MulEquiv.refl_apply, ← hzw]
    unfold genLift2
    rw [HNNExtension.lift_of, ← hxz]
    change gen3 P * genLift1 P y hy (HNNExtension.of x)
      = genLift1 P y hy (HNNExtension.of x) * gen3 P
    unfold genLift1
    rw [HNNExtension.lift_of]
    exact (commute_gen3 hx).eq)

theorem genLift3_emb3 (y : Cent3 P) (hy : ∀ x ∈ P, Commute y (emb3 P x)) (x : G₀) :
    genLift3 P y hy (emb3 P x) = emb3 P x := by
  change genLift3 P y hy
    ((HNNExtension.of : Cent2 P →* Cent3 P)
      ((HNNExtension.of : Cent1 P →* Cent2 P)
        ((HNNExtension.of : G₀ →* Cent1 P) x))) = emb3 P x
  unfold genLift3
  rw [HNNExtension.lift_of]
  unfold genLift2
  rw [HNNExtension.lift_of]
  unfold genLift1
  rw [HNNExtension.lift_of]

theorem genLift3_gen1 (y : Cent3 P) (hy : ∀ x ∈ P, Commute y (emb3 P x)) :
    genLift3 P y hy (gen1 P) = y := by
  show genLift3 P y hy
    ((HNNExtension.of : Cent2 P →* Cent3 P)
      ((HNNExtension.of : Cent1 P →* Cent2 P) (HNNExtension.t : Cent1 P))) = y
  unfold genLift3
  rw [HNNExtension.lift_of]
  unfold genLift2
  rw [HNNExtension.lift_of]
  unfold genLift1
  rw [HNNExtension.lift_t]

theorem genLift3_gen2 (y : Cent3 P) (hy : ∀ x ∈ P, Commute y (emb3 P x)) :
    genLift3 P y hy (gen2 P) = gen2 P := by
  show genLift3 P y hy
    ((HNNExtension.of : Cent2 P →* Cent3 P) (HNNExtension.t : Cent2 P)) = gen2 P
  unfold genLift3
  rw [HNNExtension.lift_of]
  unfold genLift2
  rw [HNNExtension.lift_t]

theorem genLift3_gen3 (y : Cent3 P) (hy : ∀ x ∈ P, Commute y (emb3 P x)) :
    genLift3 P y hy (gen3 P) = gen3 P := by
  show genLift3 P y hy (HNNExtension.t : Cent3 P) = gen3 P
  unfold genLift3
  rw [HNNExtension.lift_t]

/-- **`g ↦ g^{hⱼ}`**, as an endomorphism of `Σ`. -/
noncomputable def genConjHom : Cent3 P →* Cent3 P :=
  genLift3 P (genConjTarget P j) (fun _ hx => commute_genConjTarget P j hx)

/-- **`g ↦ hⱼ g hⱼ⁻¹`**, its inverse. -/
noncomputable def genConjHomInv : Cent3 P →* Cent3 P :=
  genLift3 P (genConjTargetInv P j) (fun _ hx => commute_genConjTargetInv P j hx)

@[simp] theorem genConjHom_emb3 (x : G₀) : genConjHom P j (emb3 P x) = emb3 P x := by
  unfold genConjHom
  exact genLift3_emb3 P _ _ x

@[simp] theorem genConjHom_gen1 : genConjHom P j (gen1 P) = genConjTarget P j := by
  unfold genConjHom
  exact genLift3_gen1 P _ _

@[simp] theorem genConjHom_gen2 : genConjHom P j (gen2 P) = gen2 P := by
  unfold genConjHom
  exact genLift3_gen2 P _ _

@[simp] theorem genConjHom_gen3 : genConjHom P j (gen3 P) = gen3 P := by
  unfold genConjHom
  exact genLift3_gen3 P _ _

@[simp] theorem genConjHomInv_emb3 (x : G₀) : genConjHomInv P j (emb3 P x) = emb3 P x := by
  unfold genConjHomInv
  exact genLift3_emb3 P _ _ x

@[simp] theorem genConjHomInv_gen1 : genConjHomInv P j (gen1 P) = genConjTargetInv P j := by
  unfold genConjHomInv
  exact genLift3_gen1 P _ _

@[simp] theorem genConjHomInv_gen2 : genConjHomInv P j (gen2 P) = gen2 P := by
  unfold genConjHomInv
  exact genLift3_gen2 P _ _

@[simp] theorem genConjHomInv_gen3 : genConjHomInv P j (gen3 P) = gen3 P := by
  unfold genConjHomInv
  exact genLift3_gen3 P _ _

/-- **`g ↦ g^{hⱼ}` intertwines the second copy of the coding with
`a ↦ a^{bⱼ}`.** -/
theorem genConjHom_comp_genHom :
    (genConjHom P j).comp (genHom P) = (genHom P).comp (rowConjHom j) := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  fin_cases i
  · show genConjHom P j (genHom P a) = genHom P (rowConjHom j a)
    rw [genHom_a, genConjHom_gen1, rowConjHom_a, map_mul, map_mul, map_inv, genHom_a]
    rfl
  · show genConjHom P j (genHom P b) = genHom P (rowConjHom j b)
    rw [genHom_b, genConjHom_gen2, rowConjHom_b]
  · show genConjHom P j (genHom P c) = genHom P (rowConjHom j c)
    rw [genHom_c, genConjHom_gen3, rowConjHom_c]

theorem genConjHomInv_comp_genHom :
    (genConjHomInv P j).comp (genHom P) = (genHom P).comp (rowConjHomInv j) := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  fin_cases i
  · show genConjHomInv P j (genHom P a) = genHom P (rowConjHomInv j a)
    rw [genHom_a, genConjHomInv_gen1, rowConjHomInv_a, map_mul, map_mul, map_inv, genHom_a]
    rfl
  · show genConjHomInv P j (genHom P b) = genHom P (rowConjHomInv j b)
    rw [genHom_b, genConjHomInv_gen2, rowConjHomInv_b]
  · show genConjHomInv P j (genHom P c) = genHom P (rowConjHomInv j c)
    rw [genHom_c, genConjHomInv_gen3, rowConjHomInv_c]

theorem genConjHom_genHom (y : F₃) :
    genConjHom P j (genHom P y) = genHom P (rowConjHom j y) :=
  congrArg (fun φ : F₃ →* Cent3 P => φ y) (genConjHom_comp_genHom P j)

theorem genConjHomInv_genHom (y : F₃) :
    genConjHomInv P j (genHom P y) = genHom P (rowConjHomInv j y) :=
  congrArg (fun φ : F₃ →* Cent3 P => φ y) (genConjHomInv_comp_genHom P j)

theorem genConjHom_genRow : genConjHom P j (genRow P j) = genRow P j := by
  unfold genRow
  rw [genConjHom_genHom, rowConjHom_rowElt]

theorem genConjHomInv_genRow : genConjHomInv P j (genRow P j) = genRow P j := by
  unfold genRow
  rw [genConjHomInv_genHom, rowConjHomInv_rowElt]

theorem genConjHomInv_comp_genConjHom :
    (genConjHomInv P j).comp (genConjHom P j) = MonoidHom.id (Cent3 P) := by
  refine HNNExtension.hom_ext ?_ ?_
  · refine HNNExtension.hom_ext ?_ ?_
    · refine HNNExtension.hom_ext ?_ ?_
      · ext x
        show genConjHomInv P j (genConjHom P j (emb3 P x)) = emb3 P x
        rw [genConjHom_emb3, genConjHomInv_emb3]
      · show genConjHomInv P j (genConjHom P j (gen1 P)) = gen1 P
        rw [genConjHom_gen1]
        unfold genConjTarget
        rw [map_mul, map_mul, map_inv, genConjHomInv_gen1, genConjHomInv_genRow]
        unfold genConjTargetInv
        group
    · show genConjHomInv P j (genConjHom P j (gen2 P)) = gen2 P
      rw [genConjHom_gen2, genConjHomInv_gen2]
  · show genConjHomInv P j (genConjHom P j (gen3 P)) = gen3 P
    rw [genConjHom_gen3, genConjHomInv_gen3]

theorem genConjHom_comp_genConjHomInv :
    (genConjHom P j).comp (genConjHomInv P j) = MonoidHom.id (Cent3 P) := by
  refine HNNExtension.hom_ext ?_ ?_
  · refine HNNExtension.hom_ext ?_ ?_
    · refine HNNExtension.hom_ext ?_ ?_
      · ext x
        show genConjHom P j (genConjHomInv P j (emb3 P x)) = emb3 P x
        rw [genConjHomInv_emb3, genConjHom_emb3]
      · show genConjHom P j (genConjHomInv P j (gen1 P)) = gen1 P
        rw [genConjHomInv_gen1]
        unfold genConjTargetInv
        rw [map_mul, map_mul, map_inv, genConjHom_gen1, genConjHom_genRow]
        unfold genConjTarget
        group
    · show genConjHom P j (genConjHomInv P j (gen2 P)) = gen2 P
      rw [genConjHomInv_gen2, genConjHom_gen2]
  · show genConjHom P j (genConjHomInv P j (gen3 P)) = gen3 P
    rw [genConjHomInv_gen3, genConjHom_gen3]

/-- **The automorphism `φⱼ : g ↦ g^{hⱼ}` of `Σ`.** -/
noncomputable def genConjAut : MulAut (Cent3 P) :=
  MonoidHom.toMulEquiv (genConjHom P j) (genConjHomInv P j)
    (genConjHomInv_comp_genConjHom P j) (genConjHom_comp_genConjHomInv P j)

@[simp] theorem genConjAut_apply (x : Cent3 P) : genConjAut P j x = genConjHom P j x := rfl

@[simp] theorem genConjAut_symm_apply (x : Cent3 P) :
    (genConjAut P j).symm x = genConjHomInv P j x := rfl

end GenConj

/-! ## 4.  The ambient group, the automorphisms `Φⱼ`, and the elements -/

/-- The ambient group of the sheared link. -/
abbrev LinkAmbient (m : ℕ) : Type := FatCent3 m × F₃

theorem isPowerTorsionFree_linkAmbient (m : ℕ) : IsPowerTorsionFree (LinkAmbient m) :=
  IsPowerTorsionFree.prod (isPowerTorsionFree_fatCent3 m)
    IsPowerTorsionFree.of_isMulTorsionFree

/-- `Φⱼ = φⱼ × id`. -/
noncomputable def linkAut (m : ℕ) (j : ℤ) : MulAut (LinkAmbient m) :=
  MulEquiv.prodCongr (genConjAut (fatOutside m) j) (MulEquiv.refl F₃)

/-- `b_β`, in the fat first stage. -/
noncomputable def fatB (m : ℕ) (f : E) : FatCent3 m :=
  fatCent3Emb m (Row.basisHom (elt f))

/-- `bᵢ`, in the fat first stage. -/
noncomputable def fatRow (m : ℕ) (i : ℤ) : FatCent3 m := fatCent3Emb m (Row.row i)

theorem fatB_add_single_of_le (m : ℕ) {f : E} {r : ℤ} (hf : ∀ i ∈ f.support, i ≤ r)
    (n : ℤ) : fatB m (f + Finsupp.single r n) = fatB m f * fatRow m r ^ n := by
  unfold fatB fatRow
  rw [elt_add_single_of_le hf, map_mul, map_zpow, Row.basisHom_of, map_mul, map_zpow]

theorem genConjAut_fatGenCode (m : ℕ) {j : ℤ} {f : E} (hf : ∀ i ∈ f.support, j ≤ i) :
    genConjAut (fatOutside m) j (fatGenCode m f) = fatGenCode m (f + Finsupp.single j 1) := by
  unfold fatGenCode
  rw [genConjAut_apply, genConjHom_genHom, rowConjHom_aElt hf]

theorem genConjAut_symm_fatGenCode (m : ℕ) {j : ℤ} {f : E}
    (hf : ∀ i ∈ f.support, j ≤ i) :
    (genConjAut (fatOutside m) j).symm (fatGenCode m f)
      = fatGenCode m (f + Finsupp.single j (-1)) := by
  unfold fatGenCode
  rw [genConjAut_symm_apply, genConjHomInv_genHom, rowConjHomInv_aElt hf]

theorem genConjAut_fatRow (m : ℕ) (j i : ℤ) :
    genConjAut (fatOutside m) j (fatRow m i) = fatRow m i := by
  unfold fatRow fatCent3Emb
  rw [genConjAut_apply, MonoidHom.comp_apply, genConjHom_emb3]

theorem genConjAut_symm_fatRow (m : ℕ) (j i : ℤ) :
    (genConjAut (fatOutside m) j).symm (fatRow m i) = fatRow m i := by
  unfold fatRow fatCent3Emb
  rw [genConjAut_symm_apply, MonoidHom.comp_apply, genConjHomInv_emb3]

/-- `z_β = (g_β b_β⁻¹, b_β⁻¹)`, the generator of the sheared link. -/
noncomputable def linkElem (m : ℕ) (f : E) : LinkAmbient m :=
  (fatGenCode m f * (fatB m f)⁻¹, (bElt f)⁻¹)

theorem linkElem_eq (m : ℕ) (f : E) :
    linkElem m f = slimFatSemanticBaseEmb m (slimLinkElem m f) := by
  unfold linkElem fatB
  exact (slimFatSemanticBaseEmb_slimLinkElem m f).symm

/-- `v_β = (g_{β+eᵣ} bᵣ⁻¹ g_β⁻¹, bᵣ⁻¹)`, Mikaelian's `v_f` at the window end `r`. -/
noncomputable def vElem (m : ℕ) (r : ℤ) (f : E) : LinkAmbient m :=
  (fatGenCode m (f + Finsupp.single r 1) * (fatRow m r)⁻¹ * (fatGenCode m f)⁻¹,
    (rowElt r)⁻¹)

/-- **`v_β z_β = z_{β + eᵣ}`** when `β` is supported at or before `r`. -/
theorem vElem_mul_linkElem (m : ℕ) {r : ℤ} {f : E} (hf : ∀ i ∈ f.support, i ≤ r) :
    vElem m r f * linkElem m f = linkElem m (f + Finsupp.single r 1) := by
  unfold vElem linkElem
  rw [fatB_add_single_of_le m hf, bElt_add_single_of_le hf, zpow_one, zpow_one]
  refine Prod.ext ?_ ?_
  · show fatGenCode m (f + Finsupp.single r 1) * (fatRow m r)⁻¹ * (fatGenCode m f)⁻¹
        * (fatGenCode m f * (fatB m f)⁻¹)
      = fatGenCode m (f + Finsupp.single r 1) * (fatB m f * fatRow m r)⁻¹
    group
  · show (rowElt r)⁻¹ * (bElt f)⁻¹ = (bElt f * rowElt r)⁻¹
    group

/-- **`Φⱼ v_β = v_{β + eⱼ}`** for `β` supported on `[j, r]`. -/
theorem linkAut_vElem (m : ℕ) {r j : ℤ} (hjr : j ≤ r) {f : E} (hf : f ∈ windowSet j r) :
    linkAut m j (vElem m r f) = vElem m r (f + Finsupp.single j 1) := by
  have hf' : ∀ i ∈ f.support, j ≤ i := fun i hi => (hf i hi).1
  have hf'' : ∀ i ∈ (f + Finsupp.single r 1).support, j ≤ i :=
    fun i hi => ((add_single_mem_windowSet hf hjr le_rfl 1) i hi).1
  refine Prod.ext ?_ ?_
  · show genConjAut (fatOutside m) j
        (fatGenCode m (f + Finsupp.single r 1) * (fatRow m r)⁻¹ * (fatGenCode m f)⁻¹)
      = fatGenCode m (f + Finsupp.single j 1 + Finsupp.single r 1) * (fatRow m r)⁻¹
          * (fatGenCode m (f + Finsupp.single j 1))⁻¹
    rw [map_mul, map_mul, map_inv, map_inv, genConjAut_fatGenCode m hf'',
      genConjAut_fatGenCode m hf', genConjAut_fatRow, add_right_comm]
  · show (MulEquiv.refl F₃) (rowElt r)⁻¹ = (rowElt r)⁻¹
    rfl

/-- **`Φⱼ⁻¹ v_β = v_{β - eⱼ}`** for `β` supported on `[j, r]`. -/
theorem linkAut_symm_vElem (m : ℕ) {r j : ℤ} (hjr : j ≤ r) {f : E}
    (hf : f ∈ windowSet j r) :
    (linkAut m j).symm (vElem m r f) = vElem m r (f + Finsupp.single j (-1)) := by
  have hf' : ∀ i ∈ f.support, j ≤ i := fun i hi => (hf i hi).1
  have hf'' : ∀ i ∈ (f + Finsupp.single r 1).support, j ≤ i :=
    fun i hi => ((add_single_mem_windowSet hf hjr le_rfl 1) i hi).1
  refine Prod.ext ?_ ?_
  · show (genConjAut (fatOutside m) j).symm
        (fatGenCode m (f + Finsupp.single r 1) * (fatRow m r)⁻¹ * (fatGenCode m f)⁻¹)
      = fatGenCode m (f + Finsupp.single j (-1) + Finsupp.single r 1) * (fatRow m r)⁻¹
          * (fatGenCode m (f + Finsupp.single j (-1)))⁻¹
    rw [map_mul, map_mul, map_inv, map_inv, genConjAut_symm_fatGenCode m hf'',
      genConjAut_symm_fatGenCode m hf', genConjAut_symm_fatRow, add_right_comm]
  · show (MulEquiv.refl F₃).symm (rowElt r)⁻¹ = (rowElt r)⁻¹
    rfl

/-! ## 5.  Stable hulls under a full automorphism, on elements -/

section TopAut

variable {Q : Type} [Group Q] (phi : MulAut Q)

theorem coe_topAut_symm (x : (⊤ : Subgroup Q)) :
    (((topAut phi).symm x : (⊤ : Subgroup Q)) : Q) = phi.symm (x : Q) := by
  apply phi.injective
  rw [MulEquiv.apply_symm_apply, ← coe_topAut phi, MulEquiv.apply_symm_apply]

theorem Stable.map_mem {Y : Subgroup Q} (hY : HNNDescent.Stable (topAut phi) Y) {y : Q}
    (hy : y ∈ Y) : phi y ∈ Y := by
  have h := hY.fwd ⟨y, Subgroup.mem_top y⟩ hy
  rwa [coe_topAut] at h

theorem Stable.symm_mem {Y : Subgroup Q} (hY : HNNDescent.Stable (topAut phi) Y) {y : Q}
    (hy : y ∈ Y) : phi.symm y ∈ Y := by
  have h := hY.bwd ⟨y, Subgroup.mem_top y⟩ hy
  rwa [coe_topAut_symm] at h

/-- A subgroup carried into itself by `φ` and `φ⁻¹` is stable. -/
theorem stable_of_map_le {Y : Subgroup Q} (h1 : ∀ y ∈ Y, phi y ∈ Y)
    (h2 : ∀ y ∈ Y, phi.symm y ∈ Y) : HNNDescent.Stable (topAut phi) Y := by
  constructor
  · intro x hx
    rw [coe_topAut]
    exact h1 _ hx
  · intro x hx
    rw [coe_topAut_symm]
    exact h2 _ hx

end TopAut

/-! ## 6.  Example 3.11: the `V`-subgroups are iterated stable hulls -/

/-- `T_j`: generated by the `v_β` with `β` supported on `[j, r]`. -/
noncomputable def vSub (m : ℕ) (r j : ℤ) : Subgroup (LinkAmbient m) :=
  Subgroup.closure (vElem m r '' windowSet j r)

theorem vSub_succ_le (m : ℕ) (r j : ℤ) : vSub m r (j + 1) ≤ vSub m r j := by
  unfold vSub
  apply Subgroup.closure_mono
  rintro _ ⟨f, hf, rfl⟩
  exact ⟨f, windowSet_mono_succ hf, rfl⟩

theorem stable_vSub (m : ℕ) {r j : ℤ} (hjr : j ≤ r) :
    HNNDescent.Stable (topAut (linkAut m j)) (vSub m r j) := by
  refine stable_of_map_le (linkAut m j) ?_ ?_
  · intro y hy
    have hmap : (vSub m r j).map (linkAut m j).toMonoidHom ≤ vSub m r j := by
      unfold vSub
      rw [MonoidHom.map_closure]
      refine Subgroup.closure_le.mpr ?_
      rintro _ ⟨_, ⟨f, hf, rfl⟩, rfl⟩
      refine Subgroup.subset_closure ⟨f + Finsupp.single j 1,
        add_single_mem_windowSet hf le_rfl hjr 1, ?_⟩
      exact (linkAut_vElem m hjr hf).symm
    exact hmap ⟨y, hy, rfl⟩
  · intro y hy
    have hmap : (vSub m r j).map (linkAut m j).symm.toMonoidHom ≤ vSub m r j := by
      unfold vSub
      rw [MonoidHom.map_closure]
      refine Subgroup.closure_le.mpr ?_
      rintro _ ⟨_, ⟨f, hf, rfl⟩, rfl⟩
      refine Subgroup.subset_closure ⟨f + Finsupp.single j (-1),
        add_single_mem_windowSet hf le_rfl hjr (-1), ?_⟩
      exact (linkAut_symm_vElem m hjr hf).symm
    exact hmap ⟨y, hy, rfl⟩

/-- Every `v_β` with `β` supported on `[j, r]` lies in the `Φⱼ`-hull of
`T_{j+1}`: peel the coefficient at `j` one step at a time. -/
theorem vElem_mem_stableHull (m : ℕ) {r j : ℤ} (hjr : j ≤ r) {f : E}
    (hf : f ∈ windowSet j r) :
    vElem m r f ∈ HNNDescent.stableHull (topAut (linkAut m j)) (vSub m r (j + 1)) := by
  have hst := HNNDescent.stable_stableHull (topAut (linkAut m j)) (vSub m r (j + 1))
  have herase : f.erase j ∈ windowSet (j + 1) r := erase_mem_windowSet hf
  have key : ∀ n : ℤ, vElem m r (f.erase j + Finsupp.single j n)
      ∈ HNNDescent.stableHull (topAut (linkAut m j)) (vSub m r (j + 1)) := by
    intro n
    induction n using Int.induction_on with
    | hz =>
        rw [Finsupp.single_zero, add_zero]
        exact HNNDescent.le_stableHull _ _
          (Subgroup.subset_closure ⟨f.erase j, herase, rfl⟩)
    | hp k ih =>
        have hw : f.erase j + Finsupp.single j (k : ℤ) ∈ windowSet j r :=
          add_single_mem_windowSet (windowSet_mono_succ herase) le_rfl hjr _
        rw [Finsupp.single_add, ← add_assoc, ← linkAut_vElem m hjr hw]
        exact Stable.map_mem _ hst ih
    | hn k ih =>
        have hw : f.erase j + Finsupp.single j (-(k : ℤ)) ∈ windowSet j r :=
          add_single_mem_windowSet (windowSet_mono_succ herase) le_rfl hjr _
        have hsplit : f.erase j + Finsupp.single j (-(k : ℤ) - 1)
            = f.erase j + Finsupp.single j (-(k : ℤ)) + Finsupp.single j (-1) := by
          rw [add_assoc, ← Finsupp.single_add, sub_eq_add_neg]
        rw [hsplit, ← linkAut_symm_vElem m hjr hw]
        exact Stable.symm_mem _ hst ih
  have hdec : f = f.erase j + Finsupp.single j (f j) := (Finsupp.erase_add_single j f).symm
  rw [hdec]
  exact key (f j)

/-- **`T_j` is the `Φⱼ`-stable hull of `T_{j+1}`.** -/
theorem vSub_eq_stableHull (m : ℕ) {r j : ℤ} (hjr : j ≤ r) :
    vSub m r j = HNNDescent.stableHull (topAut (linkAut m j)) (vSub m r (j + 1)) := by
  apply le_antisymm
  · show Subgroup.closure (vElem m r '' windowSet j r) ≤ _
    refine Subgroup.closure_le.mpr ?_
    rintro _ ⟨f, hf, rfl⟩
    exact vElem_mem_stableHull m hjr hf
  · exact HNNDescent.stableHull_le _ (vSub_succ_le m r j) (stable_vSub m hjr)

theorem vSub_top_eq (m : ℕ) (r : ℤ) : vSub m r (r + 1) = Subgroup.closure {vElem m r 0} := by
  unfold vSub
  congr 1
  ext y
  constructor
  · rintro ⟨f, hf, rfl⟩
    rw [eq_zero_of_mem_windowSet_succ hf]
    exact Set.mem_singleton _
  · intro hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact ⟨0, zero_mem_windowSet _ _, rfl⟩

theorem benignTF_vSub_top (m : ℕ) (r : ℤ) : BenignTF (vSub m r (r + 1)) := by
  letI : Group.IsFinitelyPresented (FatCent3 m) := isFinitelyPresented_fatCent3 m
  letI : Group.IsFinitelyPresented (LinkAmbient m) := inferInstance
  refine benignTF_of_fg (isPowerTorsionFree_linkAmbient m) ?_
  rw [vSub_top_eq]
  exact (Subgroup.fg_iff _).mpr ⟨{vElem m r 0}, rfl, Set.finite_singleton _⟩

theorem benignTF_vSub (m : ℕ) (r : ℤ) : ∀ k : ℕ, BenignTF (vSub m r (r + 1 - k))
  | 0 => by
      rw [Nat.cast_zero, sub_zero]
      exact benignTF_vSub_top m r
  | k + 1 => by
      letI : Group.IsFinitelyPresented (FatCent3 m) := isFinitelyPresented_fatCent3 m
      letI : Group.IsFinitelyPresented (LinkAmbient m) := inferInstance
      letI : Group.FG (LinkAmbient m) :=
        ProductFinitePresentation.fg_of_isFinitelyPresented (LinkAmbient m)
      have hjr : r + 1 - ((k + 1 : ℕ) : ℤ) ≤ r := by
        push_cast
        omega
      have hnext : r + 1 - ((k + 1 : ℕ) : ℤ) + 1 = r + 1 - (k : ℤ) := by
        push_cast
        ring
      rw [vSub_eq_stableHull m hjr, hnext]
      exact BenignTF.stableHull (isPowerTorsionFree_linkAmbient m) (linkAut m _)
        (benignTF_vSub m r k)

/-- **Example 3.11: `V^{(r)} = T_0` is benign.** -/
theorem benignTF_vSub_zero (m : ℕ) (r : ℕ) : BenignTF (vSub m r 0) := by
  have h := benignTF_vSub m r (r + 1)
  have hzero : (r : ℤ) + 1 - ((r + 1 : ℕ) : ℤ) = 0 := by
    push_cast
    ring
  rwa [hzero] at h

/-! ## 7.  Example 3.12: the join, and the sheared link -/

/-- `Z_r`: generated by the `z_β` with `β` supported on `[0, r)`. -/
noncomputable def zSub (m : ℕ) (r : ℤ) : Subgroup (LinkAmbient m) :=
  Subgroup.closure (linkElem m '' lowSet r)

theorem zSub_zero_eq (m : ℕ) : zSub m 0 = Subgroup.closure {linkElem m 0} := by
  unfold zSub
  congr 1
  ext y
  constructor
  · rintro ⟨f, hf, rfl⟩
    rw [eq_zero_of_mem_lowSet_zero hf]
    exact Set.mem_singleton _
  · intro hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    refine ⟨0, ?_, rfl⟩
    intro i hi
    rw [Finsupp.support_zero] at hi
    exact absurd hi (Finset.notMem_empty i)

theorem benignTF_zSub_zero (m : ℕ) : BenignTF (zSub m 0) := by
  letI : Group.IsFinitelyPresented (FatCent3 m) := isFinitelyPresented_fatCent3 m
  letI : Group.IsFinitelyPresented (LinkAmbient m) := inferInstance
  refine benignTF_of_fg (isPowerTorsionFree_linkAmbient m) ?_
  rw [zSub_zero_eq]
  exact (Subgroup.fg_iff _).mpr ⟨{linkElem m 0}, rfl, Set.finite_singleton _⟩

theorem zSub_le_succ (m : ℕ) (r : ℤ) : zSub m r ≤ zSub m (r + 1) := by
  unfold zSub
  apply Subgroup.closure_mono
  rintro _ ⟨f, hf, rfl⟩
  exact ⟨f, lowSet_mono_succ hf, rfl⟩

/-- **`Z_{r+1} = Z_r ⊔ V^{(r)}`.** -/
theorem zSub_succ_eq (m : ℕ) {r : ℤ} (hr : 0 ≤ r) :
    zSub m (r + 1) = zSub m r ⊔ vSub m r 0 := by
  apply le_antisymm
  · show Subgroup.closure (linkElem m '' lowSet (r + 1)) ≤ _
    refine Subgroup.closure_le.mpr ?_
    rintro _ ⟨f, hf, rfl⟩
    have herase : f.erase r ∈ lowSet r := erase_mem_lowSet hf
    have hwin : f.erase r ∈ windowSet 0 r :=
      lowSet_subset_windowSet (lowSet_mono_succ herase)
    have key : ∀ n : ℤ, linkElem m (f.erase r + Finsupp.single r n) ∈ zSub m r ⊔ vSub m r 0 := by
      intro n
      induction n using Int.induction_on with
      | hz =>
          rw [Finsupp.single_zero, add_zero]
          exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨f.erase r, herase, rfl⟩)
      | hp k ih =>
          have hw : f.erase r + Finsupp.single r (k : ℤ) ∈ windowSet 0 r :=
            add_single_mem_windowSet hwin (by omega) le_rfl _
          have hle : ∀ i ∈ (f.erase r + Finsupp.single r (k : ℤ)).support, i ≤ r :=
            fun i hi => (hw i hi).2
          rw [Finsupp.single_add, ← add_assoc, ← vElem_mul_linkElem m hle]
          exact Subgroup.mul_mem _
            (Subgroup.mem_sup_right (Subgroup.subset_closure ⟨_, hw, rfl⟩)) ih
      | hn k ih =>
          have hw : f.erase r + Finsupp.single r (-(k : ℤ) - 1) ∈ windowSet 0 r :=
            add_single_mem_windowSet hwin (by omega) le_rfl _
          have hle : ∀ i ∈ (f.erase r + Finsupp.single r (-(k : ℤ) - 1)).support, i ≤ r :=
            fun i hi => (hw i hi).2
          have hstep : f.erase r + Finsupp.single r (-(k : ℤ) - 1) + Finsupp.single r 1
              = f.erase r + Finsupp.single r (-(k : ℤ)) := by
            rw [add_assoc, ← Finsupp.single_add, sub_add_cancel]
          have hmul := vElem_mul_linkElem m hle
          rw [hstep] at hmul
          rw [eq_inv_mul_of_mul_eq hmul]
          exact Subgroup.mul_mem _
            (Subgroup.inv_mem _ (Subgroup.mem_sup_right (Subgroup.subset_closure ⟨_, hw, rfl⟩)))
            ih
    have hdec : f = f.erase r + Finsupp.single r (f r) := (Finsupp.erase_add_single r f).symm
    rw [hdec]
    exact key (f r)
  · refine sup_le (zSub_le_succ m r) ?_
    show Subgroup.closure (vElem m r '' windowSet 0 r) ≤ _
    refine Subgroup.closure_le.mpr ?_
    rintro _ ⟨f, hf, rfl⟩
    have hle : ∀ i ∈ f.support, i ≤ r := fun i hi => (hf i hi).2
    rw [eq_mul_inv_of_mul_eq (vElem_mul_linkElem m hle)]
    refine Subgroup.mul_mem _ (Subgroup.subset_closure ⟨_, ?_, rfl⟩)
      (Subgroup.inv_mem _ (Subgroup.subset_closure ⟨f, windowSet_subset_lowSet hf, rfl⟩))
    exact windowSet_subset_lowSet (add_single_mem_windowSet hf (by omega) le_rfl 1)

/-- **Example 3.12: every `Z_r` is benign.** -/
theorem benignTF_zSub (m : ℕ) : ∀ r : ℕ, BenignTF (zSub m r)
  | 0 => by
      rw [Nat.cast_zero]
      exact benignTF_zSub_zero m
  | r + 1 => by
      letI : Group.IsFinitelyPresented (FatCent3 m) := isFinitelyPresented_fatCent3 m
      letI : Group.IsFinitelyPresented (LinkAmbient m) := inferInstance
      letI : Group.FG (LinkAmbient m) :=
        ProductFinitePresentation.fg_of_isFinitelyPresented (LinkAmbient m)
      rw [Nat.cast_succ, zSub_succ_eq m (by omega)]
      exact BenignTF.sup (benignTF_zSub m r) (benignTF_vSub_zero m r)

theorem lowSet_eq_blockSet (m : ℕ) : lowSet (m : ℤ) = blockSet m := by
  ext f
  constructor
  · intro hf i hi
    by_contra h0
    exact hi (Finset.mem_Ico.mpr (hf i (Finsupp.mem_support_iff.mpr h0)))
  · intro hf i hi
    by_contra h
    exact Finsupp.mem_support_iff.mp hi (hf i (fun hmem => h (Finset.mem_Ico.mp hmem)))

/-- **`Z_m` is the sheared link.** -/
theorem zSub_eq_fatShearedBlockLink (m : ℕ) : zSub m m = fatShearedBlockLink m := by
  rw [fatShearedBlockLink_eq_map]
  unfold zSub slimLink
  rw [MonoidHom.map_closure, lowSet_eq_blockSet, Set.image_image]
  congr 1
  exact Set.image_congr fun f _ => linkElem_eq m f

/-- **The sheared link is benign**, Mikaelian's Example 3.12 in the fat first
stage. -/
theorem benignTF_fatShearedBlockLink (m : ℕ) : BenignTF (fatShearedBlockLink m) := by
  rw [← zSub_eq_fatShearedBlockLink m]
  exact benignTF_zSub m m

end LeadLink

/-! ## 8.  Higman's `ωₘ` closure -/

/-- **Higman's operation `ωₘ` preserves benignness.**  The slim descent is
`Omega.slimDescent`; the benignness of the sheared link is
`LeadLink.benignTF_fatShearedBlockLink`. -/
theorem omegaInputProved : OmegaInput :=
  omegaInput_of_shearedLinkBenign slimDescent LeadLink.benignTF_fatShearedBlockLink

theorem omegaInput_nonempty : Nonempty OmegaInput := ⟨omegaInputProved⟩

end Omega
end Higman
end GroupApproximation
