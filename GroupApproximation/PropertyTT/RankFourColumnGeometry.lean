import GroupApproximation.PropertyTT.RankFourRootGeometry
import GroupApproximation.PropertyT.ClassTwoNormalForm
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# The three-root column subgroup in rank four

The subgroup generated by `X₀₃`, `X₁₃`, and `X₂₃` is normalized by the
four upper-left root directions used in the rank-four key trick.  This file
also records the two successive coordinate factorizations of that subgroup.
-/

namespace GroupApproximation
namespace RankFourColumnGeometry

open RankFourRootGeometry
open scoped commutatorElement Pointwise

noncomputable section

variable (X : Type*)

abbrev R := FreeAlgebra (ZMod 2) X
abbrev G4 := elementaryGroup (Fin 4) (R X)

noncomputable def X03 : Subgroup (G4 X) :=
  elementaryRootSubgroup 0 3 (by decide)

noncomputable def X13 : Subgroup (G4 X) :=
  elementaryRootSubgroup 1 3 (by decide)

noncomputable def X23 : Subgroup (G4 X) :=
  elementaryRootSubgroup 2 3 (by decide)

noncomputable def columnPlane : Subgroup (G4 X) := X13 X ⊔ X23 X

noncomputable def columnGroup : Subgroup (G4 X) := X03 X ⊔ columnPlane X

/-- An adjacent elementary root normalizes the two roots in a common column.
This rank-independent form is proved directly from the Steinberg relations. -/
theorem root_mem_normalizer_columnPlane
    {I : Type*} [Fintype I] [DecidableEq I]
    (i j k : I) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    (a : R X) :
    elementaryRoot i j hij a ∈ Subgroup.normalizer
      (elementaryRootSubgroup i k hik ⊔
        elementaryRootSubgroup j k hjk :
          Subgroup (elementaryGroup I (R X))) := by
  let Xij : Subgroup (elementaryGroup I (R X)) :=
    elementaryRootSubgroup i j hij
  let Xjk : Subgroup (elementaryGroup I (R X)) :=
    elementaryRootSubgroup j k hjk
  let Xik : Subgroup (elementaryGroup I (R X)) :=
    elementaryRootSubgroup i k hik
  have hYX : ⁅Xij, Xjk⁆ ≤ Xik := by
    apply Subgroup.commutator_le.mpr
    rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
    rw [elementaryRoot_commutator i j k hij hjk hik x y]
    exact ⟨x * y, rfl⟩
  have hYZ : ⁅Xij, Xik⁆ ≤ Xik := by
    apply Subgroup.commutator_le.mpr
    rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
    have hcomm := elementaryRoot_commute_of_ne i j i k hij hik
      hij.symm hik.symm x y
    rw [commutatorElement_eq_one_iff_commute.mpr hcomm]
    exact Xik.one_mem
  have hnormal : Xij ≤ Subgroup.normalizer (Xik ⊔ Xjk :
      Subgroup (elementaryGroup I (R X))) := by
    simpa only [sup_comm] using
      ClassTwoNormalForm.le_normalizer_sup Xjk Xij Xik hYX hYZ
  exact hnormal ⟨a, rfl⟩

/-- Two root subgroups in non-addable positions centralize one another. -/
theorem root_mem_centralizer_rootSubgroup
    {I : Type*} [Fintype I] [DecidableEq I]
    (i j k l : I) (hij : i ≠ j) (hkl : k ≠ l)
    (hjk : j ≠ k) (hli : l ≠ i) (a : R X) :
    elementaryRoot i j hij a ∈
      Subgroup.centralizer (elementaryRootSubgroup (R := R X) k l hkl :
        Set (elementaryGroup I (R X))) := by
  rw [Subgroup.mem_centralizer_iff]
  rintro _ ⟨b, rfl⟩
  exact (elementaryRoot_commute_of_ne i j k l hij hkl hjk hli a b).eq.symm

/-- The corresponding normalizer membership. -/
theorem root_mem_normalizer_rootSubgroup
    {I : Type*} [Fintype I] [DecidableEq I]
    (i j k l : I) (hij : i ≠ j) (hkl : k ≠ l)
    (hjk : j ≠ k) (hli : l ≠ i) (a : R X) :
    elementaryRoot i j hij a ∈
      Subgroup.normalizer (elementaryRootSubgroup k l hkl :
        Subgroup (elementaryGroup I (R X))) :=
  Subgroup.centralizer_le_normalizer _ <|
    root_mem_centralizer_rootSubgroup X i j k l hij hkl hjk hli a

/-- Every `X₀₁` element normalizes the full three-root column. -/
theorem root01_mem_normalizer_columnGroup (a : R X) :
    elementaryRoot (0 : Fin 4) 1 (by decide) a ∈
      Subgroup.normalizer (columnGroup X) := by
  have hpair := root_mem_normalizer_columnPlane X
    (0 : Fin 4) 1 3 (by decide) (by decide) (by decide) a
  have h23 := root_mem_normalizer_rootSubgroup X
    (0 : Fin 4) 1 2 3 (by decide) (by decide) (by decide) (by decide) a
  have h := Subgroup.normalizer_inf_normalizer_le_normalizer_sup
    (X03 X ⊔ X13 X) (X23 X) ⟨hpair, h23⟩
  simpa only [columnGroup, columnPlane, sup_assoc] using h

/-- Every `X₀₂` element normalizes the full three-root column. -/
theorem root02_mem_normalizer_columnGroup (a : R X) :
    elementaryRoot (0 : Fin 4) 2 (by decide) a ∈
      Subgroup.normalizer (columnGroup X) := by
  have hpair := root_mem_normalizer_columnPlane X
    (0 : Fin 4) 2 3 (by decide) (by decide) (by decide) a
  have h13 := root_mem_normalizer_rootSubgroup X
    (0 : Fin 4) 2 1 3 (by decide) (by decide) (by decide) (by decide) a
  have h := Subgroup.normalizer_inf_normalizer_le_normalizer_sup
    (X03 X ⊔ X23 X) (X13 X) ⟨hpair, h13⟩
  simpa only [columnGroup, columnPlane, sup_assoc, sup_comm, sup_left_comm]
    using h

/-- Every `X₁₂` element normalizes the full three-root column. -/
theorem root12_mem_normalizer_columnGroup (a : R X) :
    elementaryRoot (1 : Fin 4) 2 (by decide) a ∈
      Subgroup.normalizer (columnGroup X) := by
  have h03 := root_mem_normalizer_rootSubgroup X
    (1 : Fin 4) 2 0 3 (by decide) (by decide) (by decide) (by decide) a
  have hplane := root_mem_normalizer_columnPlane X
    (1 : Fin 4) 2 3 (by decide) (by decide) (by decide) a
  exact Subgroup.normalizer_inf_normalizer_le_normalizer_sup
    (X03 X) (columnPlane X) ⟨h03, hplane⟩

/-- Every `X₂₁` element normalizes the full three-root column. -/
theorem root21_mem_normalizer_columnGroup (a : R X) :
    elementaryRoot (2 : Fin 4) 1 (by decide) a ∈
      Subgroup.normalizer (columnGroup X) := by
  have h03 := root_mem_normalizer_rootSubgroup X
    (2 : Fin 4) 1 0 3 (by decide) (by decide) (by decide) (by decide) a
  have hplane := root_mem_normalizer_columnPlane X
    (2 : Fin 4) 1 3 (by decide) (by decide) (by decide) a
  have h := Subgroup.normalizer_inf_normalizer_le_normalizer_sup
    (X03 X) (X23 X ⊔ X13 X) ⟨h03, hplane⟩
  simpa only [columnGroup, columnPlane, sup_comm] using h

/-- The first root of the column lies in the column subgroup. -/
theorem root03_mem_columnGroup (a : R X) :
    elementaryRoot (0 : Fin 4) 3 (by decide) a ∈ columnGroup X :=
  (show X03 X ≤ columnGroup X from le_sup_left) ⟨a, rfl⟩

/-- The second root of the column lies in the column subgroup. -/
theorem root13_mem_columnGroup (a : R X) :
    elementaryRoot (1 : Fin 4) 3 (by decide) a ∈ columnGroup X :=
  (show columnPlane X ≤ columnGroup X from le_sup_right)
    ((show X13 X ≤ columnPlane X from le_sup_left) ⟨a, rfl⟩)

/-- The third root of the column lies in the column subgroup. -/
theorem root23_mem_columnGroup (a : R X) :
    elementaryRoot (2 : Fin 4) 3 (by decide) a ∈ columnGroup X :=
  (show columnPlane X ≤ columnGroup X from le_sup_right)
    ((show X23 X ≤ columnPlane X from le_sup_right) ⟨a, rfl⟩)

/-- Every element of the last-two-entry column plane factors into its two
root coordinates. -/
theorem exists_root13_mul_root23_of_mem_columnPlane
    {g : G4 X} (hg : g ∈ columnPlane X) :
    ∃ a b : R X,
      elementaryRoot (1 : Fin 4) 3 (by decide) a *
        elementaryRoot (2 : Fin 4) 3 (by decide) b = g := by
  have hnorm : X13 X ≤ Subgroup.normalizer (X23 X : Set (G4 X)) := by
    intro _
    rintro ⟨a, rfl⟩
    exact root_mem_normalizer_rootSubgroup X
      (1 : Fin 4) 3 2 3 (by decide) (by decide) (by decide) (by decide) a
  have hgset : g ∈ (↑(X13 X ⊔ X23 X) : Set (G4 X)) := hg
  rw [show ((↑(X13 X ⊔ X23 X) : Set (G4 X))) =
      (X13 X : Set (G4 X)) * (X23 X : Set (G4 X)) from
        Subgroup.coe_mul_of_left_le_normalizer_right (X13 X) (X23 X) hnorm]
    at hgset
  rcases hgset with ⟨_, ⟨a, rfl⟩, _, ⟨b, rfl⟩, rfl⟩
  exact ⟨a, b, rfl⟩

/-- Every element of the three-root column factors as an `X₀₃` element
times an element of the other two roots. -/
theorem exists_root03_mul_plane_of_mem_columnGroup
    {g : G4 X} (hg : g ∈ columnGroup X) :
    ∃ a : R X, ∃ p ∈ columnPlane X,
      elementaryRoot (0 : Fin 4) 3 (by decide) a * p = g := by
  have hnorm : X03 X ≤
      Subgroup.normalizer (columnPlane X : Set (G4 X)) := by
    intro _
    rintro ⟨a, rfl⟩
    have h13 := root_mem_normalizer_rootSubgroup X
      (0 : Fin 4) 3 1 3 (by decide) (by decide) (by decide) (by decide) a
    have h23 := root_mem_normalizer_rootSubgroup X
      (0 : Fin 4) 3 2 3 (by decide) (by decide) (by decide) (by decide) a
    exact Subgroup.normalizer_inf_normalizer_le_normalizer_sup
      (X13 X) (X23 X) ⟨h13, h23⟩
  have hgset : g ∈ (↑(X03 X ⊔ columnPlane X) : Set (G4 X)) := hg
  rw [show ((↑(X03 X ⊔ columnPlane X) : Set (G4 X))) =
      (X03 X : Set (G4 X)) * (columnPlane X : Set (G4 X)) from
        Subgroup.coe_mul_of_left_le_normalizer_right
          (X03 X) (columnPlane X) hnorm] at hgset
  rcases hgset with ⟨_, ⟨a, rfl⟩, p, hp, rfl⟩
  exact ⟨a, p, hp, rfl⟩

/-- The Steinberg commutator producing the first column coordinate. -/
theorem root01_root13_commutator (a : R X) :
    ⁅elementaryRoot (0 : Fin 4) 1 (by decide) a,
      elementaryRoot (1 : Fin 4) 3 (by decide) 1⁆ =
        elementaryRoot (0 : Fin 4) 3 (by decide) a := by
  simpa using elementaryRoot_commutator
    (0 : Fin 4) 1 3 (by decide) (by decide) (by decide) a 1

/-- Every target root element is an involution. -/
theorem root03_sq (a : R X) :
    elementaryRoot (0 : Fin 4) 3 (by decide) a ^ 2 = 1 :=
  elementaryRoot_pow_char 2 (0 : Fin 4) 3 (by decide) a

end
end RankFourColumnGeometry
end GroupApproximation
