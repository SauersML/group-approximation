import GroupApproximation.GroupTheory.HigmanThompson.RstabIso
import GroupApproximation.Algebra.ProductFinitePresentation

/-!
# Point stabilizers of geometric Thompson groups are finitely generated

Let `p > 0` be a grid point of `ℤ[1/(m+2)]`.  The stabilizer of `p` in `geoF m` is generated by
two finitely generated subgroups:
* `rstab m 0 p`, the elements supported in `[0, p]`;
* the conjugate of `geoF m` by the translation `t ↦ t + p`, the elements supported in `[p, ∞)`.

An element `γ` fixing `p` is the product of its cut `cutBelow p γ`, equal to `γ` on `(-∞, p]` and
to the identity on `[p, ∞)`, and of `(cutBelow p γ)⁻¹ * γ`, which is the identity on `(-∞, p]`.
Both pieces are piecewise linear over the grid because `p` is a grid point
(`HigmanThompson.GridAffine.glue`).  Both subgroups are finitely presented on main
(`HigmanThompson.isFinitelyPresented_rstab`, `HigmanThompson.geoF_isFinitelyPresented`).

* `geoF_stabilizer_fg`: `Stab_{geoF m}(p)` is finitely generated.
* `geoF_zero_stabilizer_fg`: the case `m = 0`, with `p ∈ ℤ[1/2]`.
-/

namespace GroupApproximation
namespace TypeA2

open HigmanThompson MulAction

variable {m : ℕ} {p : ℚ} {f : Equiv.Perm ℚ}

/-! ## Cutting a permutation at a fixed point -/

/-- The cut of a strictly increasing permutation `f` fixing `p`: it agrees with `f` on
`(-∞, p]` and is the identity on `[p, ∞)`. -/
def cutBelow (p : ℚ) (f : Equiv.Perm ℚ) (hf : StrictMono f) (hp : f p = p) : Equiv.Perm ℚ where
  toFun t := if t ≤ p then f t else t
  invFun t := if t ≤ p then f⁻¹ t else t
  left_inv t := by
    by_cases ht : t ≤ p
    · have h : f t ≤ p := by
        have h' := hf.monotone ht
        rwa [hp] at h'
      simp [ht, h, perm_inv_apply_self]
    · simp [ht]
  right_inv t := by
    by_cases ht : t ≤ p
    · have hpi : f⁻¹ p = p := Equiv.Perm.inv_eq_iff_eq.mpr hp.symm
      have h : f⁻¹ t ≤ p := by
        have h' := (strictMono_perm_inv hf).monotone ht
        rwa [hpi] at h'
      simp only [if_pos ht, if_pos h, perm_apply_inv_self]
    · simp [ht]

theorem cutBelow_of_le (hf : StrictMono f) (hp : f p = p) {t : ℚ} (ht : t ≤ p) :
    cutBelow p f hf hp t = f t :=
  if_pos ht

theorem cutBelow_of_ge (hf : StrictMono f) (hp : f p = p) {t : ℚ} (ht : p ≤ t) :
    cutBelow p f hf hp t = t := by
  by_cases h : t ≤ p
  · show (if t ≤ p then f t else t) = t
    rw [if_pos h, le_antisymm h ht, hp]
  · exact if_neg h

theorem cutBelow_inv_of_le (hf : StrictMono f) (hp : f p = p) {t : ℚ} (ht : t ≤ p) :
    (cutBelow p f hf hp)⁻¹ t = f⁻¹ t := by
  have hpi : f⁻¹ p = p := Equiv.Perm.inv_eq_iff_eq.mpr hp.symm
  have h : f⁻¹ t ≤ p := by
    have h' := (strictMono_perm_inv hf).monotone ht
    rwa [hpi] at h'
  exact Equiv.Perm.inv_eq_iff_eq.mpr
    ((cutBelow_of_le hf hp h).trans (perm_apply_inv_self f t)).symm

theorem cutBelow_inv_of_ge (hf : StrictMono f) (hp : f p = p) {t : ℚ} (ht : p ≤ t) :
    (cutBelow p f hf hp)⁻¹ t = t :=
  Equiv.Perm.inv_eq_iff_eq.mpr (cutBelow_of_ge hf hp ht).symm

/-- The cut at a grid point of a piecewise linear permutation is piecewise linear. -/
theorem cutBelow_mem {M : ℕ} (hpM : p ∈ Grid (m + 2) M) (hf : StrictMono f) (hp : f p = p)
    (hfP : f ∈ PLGroup (m + 2) (powSlopes m)) :
    cutBelow p f hf hp ∈ PLGroup (m + 2) (powSlopes m) := by
  obtain ⟨-, ⟨N, B, hN⟩, ⟨Ni, Bi, hNi⟩⟩ := hfP
  refine ⟨fun a b hab => ?_, ⟨max N M, B + max N M, ?_⟩, ⟨max Ni M, Bi + max Ni M, ?_⟩⟩
  · by_cases hb : b ≤ p
    · rw [cutBelow_of_le hf hp (hab.le.trans hb), cutBelow_of_le hf hp hb]
      exact hf hab
    · have hb' : p < b := not_le.mp hb
      rw [cutBelow_of_ge hf hp hb'.le]
      by_cases ha : a ≤ p
      · rw [cutBelow_of_le hf hp ha]
        calc f a ≤ f p := hf.monotone ha
          _ = p := hp
          _ < b := hb'
      · rw [cutBelow_of_ge hf hp (not_le.mp ha).le]
        exact hab
  · exact GridAffine.glue (hN.mono_level (le_max_left N M))
      (((gridAffine_id (m := m + 2) (Ω := powSlopes m)).mono_level
        (Nat.zero_le (max N M))).mono_bound (Nat.add_le_add_right (Nat.zero_le B) (max N M)))
      (grid_mono (le_max_right N M) hpM) (fun t ht => cutBelow_of_le hf hp ht)
      (fun t ht => cutBelow_of_ge hf hp ht)
  · exact GridAffine.glue (hNi.mono_level (le_max_left Ni M))
      (((gridAffine_id (m := m + 2) (Ω := powSlopes m)).mono_level
        (Nat.zero_le (max Ni M))).mono_bound (Nat.add_le_add_right (Nat.zero_le Bi) (max Ni M)))
      (grid_mono (le_max_right Ni M) hpM) (fun t ht => cutBelow_inv_of_le hf hp ht)
      (fun t ht => cutBelow_inv_of_ge hf hp ht)

/-! ## The two subgroups -/

theorem rstab_zero_le_geoF (p : ℚ) : rstab m 0 p ≤ geoF m := by
  rintro f ⟨hfP, hf0, hf1⟩
  refine ⟨hfP, hf0, ⌈p⌉₊, 0, fun t ht => ?_⟩
  rw [hf1 t ((Nat.le_ceil p).trans ht), Int.cast_zero, add_zero]

/-- Conjugation by the translation `t ↦ t + p` maps `geoF m` into itself, for a grid point
`p ≥ 0`. -/
theorem transPerm_conj_mem_geoF (hp0 : 0 ≤ p) {M : ℕ} (hpM : p ∈ Grid (m + 2) M)
    {g : Equiv.Perm ℚ} (hg : g ∈ geoF m) : transPerm p * g * (transPerm p)⁻¹ ∈ geoF m := by
  obtain ⟨hgP, hg0, T, c, hgT⟩ := hg
  have hτ := transPerm_mem m hpM
  refine ⟨(PLGroup (m + 2) (powSlopes m)).mul_mem
      ((PLGroup (m + 2) (powSlopes m)).mul_mem hτ hgP) ((PLGroup (m + 2) (powSlopes m)).inv_mem hτ),
    fun t ht => ?_, T + ⌈p⌉₊, c, fun t ht => ?_⟩
  · rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, transPerm_inv_apply,
      hg0 (t - p) (by linarith), transPerm_apply, sub_add_cancel]
  · have hTt : (T : ℚ) ≤ t - p := by
      have h := Nat.le_ceil p
      push_cast at ht
      linarith
    rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, transPerm_inv_apply, hgT (t - p) hTt,
      transPerm_apply]
    ring

/-- Conjugation by `t ↦ t + p`, as an endomorphism of `geoF m`. -/
def shiftConj (hp0 : 0 ≤ p) {M : ℕ} (hpM : p ∈ Grid (m + 2) M) : geoF m →* geoF m where
  toFun g := ⟨transPerm p * g * (transPerm p)⁻¹, transPerm_conj_mem_geoF hp0 hpM g.2⟩
  map_one' := Subtype.ext (by
    show transPerm p * (1 : Equiv.Perm ℚ) * (transPerm p)⁻¹ = 1
    simp)
  map_mul' g h := Subtype.ext (by
    show transPerm p * ((g : Equiv.Perm ℚ) * h) * (transPerm p)⁻¹ =
      (transPerm p * g * (transPerm p)⁻¹) * (transPerm p * h * (transPerm p)⁻¹)
    simp [mul_assoc])

/-! ## The stabilizer -/

/-- **Point stabilizers of `geoF m` are finitely generated.**  For a grid point `p > 0`,
`Stab_{geoF m}(p)` is generated by `rstab m 0 p` and a conjugate of `geoF m`. -/
theorem geoF_stabilizer_fg (hpM : ∃ M, p ∈ Grid (m + 2) M) (hp0 : 0 < p) :
    (stabilizer (geoF m) p).FG := by
  obtain ⟨M, hM⟩ := hpM
  have hle : rstab m 0 p ≤ geoF m := rstab_zero_le_geoF p
  haveI : Group.IsFinitelyPresented (rstab m 0 p) :=
    isFinitelyPresented_rstab ⟨0, by simpa using int_mem_grid (m := m + 2) 0 0⟩ ⟨M, hM⟩ hp0
  haveI : Group.FG (rstab m 0 p) := ProductFinitePresentation.fg_of_isFinitelyPresented _
  haveI : Group.IsFinitelyPresented (geoF m) := geoF_isFinitelyPresented m
  haveI : Group.FG (geoF m) := ProductFinitePresentation.fg_of_isFinitelyPresented _
  have hL : (Subgroup.inclusion hle).range.FG :=
    (Group.fg_iff_subgroup_fg _).mp
      (Group.fg_of_surjective (Subgroup.inclusion hle).rangeRestrict_surjective)
  have hR : (shiftConj hp0.le hM).range.FG :=
    (Group.fg_iff_subgroup_fg _).mp
      (Group.fg_of_surjective (shiftConj hp0.le hM).rangeRestrict_surjective)
  have heq : stabilizer (geoF m) p = (Subgroup.inclusion hle).range ⊔ (shiftConj hp0.le hM).range := by
    apply le_antisymm
    · intro γ hγ
      have hγp : (γ : Equiv.Perm ℚ) p = p := hγ
      obtain ⟨hγP, hγ0, -⟩ := γ.2
      have hmono : StrictMono (γ : Equiv.Perm ℚ) := ((mem_PLGroup (m + 2) (powSlopes m)).mp hγP).1
      have hcut : cutBelow p γ hmono hγp ∈ rstab m 0 p := by
        refine ⟨cutBelow_mem hM hmono hγp hγP, fun t ht => ?_, fun t ht => cutBelow_of_ge hmono hγp ht⟩
        rw [cutBelow_of_le hmono hγp (ht.trans hp0.le)]
        exact hγ0 t ht
      let γL : geoF m := ⟨cutBelow p γ hmono hγp, hle hcut⟩
      have hmemL : γL ∈ (Subgroup.inclusion hle).range := MonoidHom.mem_range.mpr ⟨⟨_, hcut⟩, rfl⟩
      have hρ : ∀ t, t ≤ p → ((γL⁻¹ * γ : geoF m) : Equiv.Perm ℚ) t = t := by
        intro t ht
        show (cutBelow p γ hmono hγp)⁻¹ ((γ : Equiv.Perm ℚ) t) = t
        rw [Equiv.Perm.inv_eq_iff_eq, cutBelow_of_le hmono hγp ht]
      obtain ⟨hρP, -, T, c, hρT⟩ := (γL⁻¹ * γ).2
      have hτ := transPerm_mem m hM
      have hg : (transPerm p)⁻¹ * ((γL⁻¹ * γ : geoF m) : Equiv.Perm ℚ) * transPerm p ∈ geoF m := by
        refine ⟨(PLGroup (m + 2) (powSlopes m)).mul_mem
            ((PLGroup (m + 2) (powSlopes m)).mul_mem ((PLGroup (m + 2) (powSlopes m)).inv_mem hτ)
              hρP) hτ, fun t ht => ?_, T, c, fun t ht => ?_⟩
        · rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, transPerm_apply, hρ (t + p) (by linarith),
            transPerm_inv_apply, add_sub_cancel_right]
        · rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, transPerm_apply,
            hρT (t + p) (by linarith), transPerm_inv_apply]
          ring
      have hmemR : γL⁻¹ * γ ∈ (shiftConj hp0.le hM).range := by
        refine MonoidHom.mem_range.mpr ⟨⟨_, hg⟩, Subtype.ext ?_⟩
        show transPerm p * ((transPerm p)⁻¹ * ((γL⁻¹ * γ : geoF m) : Equiv.Perm ℚ) * transPerm p) *
          (transPerm p)⁻¹ = ((γL⁻¹ * γ : geoF m) : Equiv.Perm ℚ)
        simp [mul_assoc]
      have h := Subgroup.mul_mem_sup hmemL hmemR
      rwa [mul_inv_cancel_left] at h
    · refine sup_le ?_ ?_
      · intro x hx
        obtain ⟨f, rfl⟩ := MonoidHom.mem_range.mp hx
        obtain ⟨-, -, hf1⟩ := f.2
        show (f : Equiv.Perm ℚ) p = p
        exact hf1 p le_rfl
      · intro x hx
        obtain ⟨g, rfl⟩ := MonoidHom.mem_range.mp hx
        obtain ⟨-, hg0, -⟩ := g.2
        show (transPerm p * (g : Equiv.Perm ℚ) * (transPerm p)⁻¹) p = p
        rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, transPerm_inv_apply, sub_self,
          hg0 0 le_rfl, transPerm_apply, zero_add]
  rw [heq]
  exact hL.sup hR

/-- The case `m = 0`: point stabilizers of `F = geoF 0` at positive dyadic rationals are finitely
generated. -/
theorem geoF_zero_stabilizer_fg (hpM : ∃ M, p ∈ Grid 2 M) (hp0 : 0 < p) :
    (stabilizer (geoF 0) p).FG :=
  geoF_stabilizer_fg hpM hp0

end TypeA2
end GroupApproximation
