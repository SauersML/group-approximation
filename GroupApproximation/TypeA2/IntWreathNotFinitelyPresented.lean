/-!
# The integer wreath product is not finitely presented

`ℤ ≀ ℤ` is not finitely presented (Baumslag 1961).  This is the non-finite-presentability input
for Fournier-Facio--Wu--Zaremsky Question 5.8 (arXiv:2603.24687v2): the image of the witness
action retracts onto a copy of `ℤ ≀ ℤ`.

* `IntWreath` -- the model `Multiplicative (ℤ →₀ ℤ) ⋊ Multiplicative ℤ`, generated by
  `IntWreath.lamp` and `IntWreath.shift`;
* `IntWreath.lift`, `IntWreath.hom_ext` -- the universal property: elements `a t` of any group
  whose conjugates `t ^ i * a * (t ^ i)⁻¹` commute pairwise extend uniquely;
* `IntWreath.presentedEquiv` -- the presentation `⟨a, t | [a, t ^ k * a * t ^ -k], k ≥ 1⟩`;
* `IntWreath.not_isFinitelyPresented` -- the theorem.

For the last step, a finite set of relators has indices at most some `M`.  In `Equiv.Perm ℤ` take
`a` to be the transposition `(0 N)` with `N = M + 2`, and `t` the translation by one.  Then
`t ^ k * a * t ^ -k` is `(k N+k)`.  For `k ≤ M + 1` it is disjoint from `a`, and for `k = M + 2`
it shares the point `N`, so the commutator moves `N`.  The violable-relator criterion
`PartialCommutation.not_isFinitelyPresented_of_violable` finishes the proof.
-/

noncomputable section

namespace GroupApproximation
namespace TypeA2

open scoped commutatorElement

/-- The lamp group `ℤ →₀ ℤ`, written multiplicatively. -/
abbrev IntLamps : Type := Multiplicative (ℤ →₀ ℤ)

namespace IntWreath

/-- Translation of `ℤ` by `n`. -/
def translatePerm (n : ℤ) : Equiv.Perm ℤ where
  toFun x := x + n
  invFun x := x - n
  left_inv x := by simp
  right_inv x := by simp

@[simp] theorem translatePerm_apply (n x : ℤ) : translatePerm n x = x + n := rfl

@[simp] theorem translatePerm_symm_apply (n x : ℤ) : (translatePerm n).symm x = x - n := rfl

/-- Shifting the lamps by `n`. -/
def shiftAut (n : ℤ) : MulAut IntLamps where
  toFun l := Multiplicative.ofAdd
    (Finsupp.equivMapDomain (translatePerm n) (Multiplicative.toAdd l))
  invFun l := Multiplicative.ofAdd
    (Finsupp.equivMapDomain (translatePerm n).symm (Multiplicative.toAdd l))
  left_inv l := by
    apply Multiplicative.toAdd.injective
    ext x
    simp
  right_inv l := by
    apply Multiplicative.toAdd.injective
    ext x
    simp
  map_mul' a b := by
    apply Multiplicative.toAdd.injective
    ext x
    simp

@[simp] theorem shiftAut_apply_toAdd (n : ℤ) (l : IntLamps) (x : ℤ) :
    Multiplicative.toAdd (shiftAut n l) x = Multiplicative.toAdd l (x - n) := rfl

theorem shiftAut_single (n i e : ℤ) :
    shiftAut n (Multiplicative.ofAdd (Finsupp.single i e)) =
      Multiplicative.ofAdd (Finsupp.single (i + n) e) := by
  show Multiplicative.ofAdd (Finsupp.equivMapDomain (translatePerm n) (Finsupp.single i e)) = _
  rw [Finsupp.equivMapDomain_single, translatePerm_apply]

/-- The shift action of `ℤ` on the lamps. -/
def action : Multiplicative ℤ →* MulAut IntLamps where
  toFun n := shiftAut (Multiplicative.toAdd n)
  map_one' := by
    refine MulEquiv.ext fun l => Multiplicative.toAdd.injective (Finsupp.ext fun x => ?_)
    simp
  map_mul' m n := by
    refine MulEquiv.ext fun l => Multiplicative.toAdd.injective (Finsupp.ext fun x => ?_)
    simp [sub_sub]

@[simp] theorem action_apply (n : Multiplicative ℤ) :
    action n = shiftAut (Multiplicative.toAdd n) := rfl

end IntWreath

/-- The integer wreath product `ℤ ≀ ℤ`, as a semidirect product. -/
abbrev IntWreath : Type := IntLamps ⋊[IntWreath.action] Multiplicative ℤ

namespace IntWreath

/-- The lamp at the origin. -/
def lamp : IntWreath := SemidirectProduct.inl (Multiplicative.ofAdd (Finsupp.single 0 1))

/-- The generator of the base `ℤ`. -/
def shift : IntWreath := SemidirectProduct.inr (Multiplicative.ofAdd 1)

theorem ofAdd_one_zpow (n : ℤ) :
    (Multiplicative.ofAdd (1 : ℤ)) ^ n = Multiplicative.ofAdd n :=
  Multiplicative.toAdd.injective (by simp)

theorem shift_zpow (n : ℤ) : shift ^ n = SemidirectProduct.inr (Multiplicative.ofAdd n) := by
  have h := map_zpow (SemidirectProduct.inr (φ := action) (N := IntLamps))
    (Multiplicative.ofAdd (1 : ℤ)) n
  rw [ofAdd_one_zpow] at h
  exact h.symm

theorem single_zpow (i e : ℤ) :
    (Multiplicative.ofAdd (Finsupp.single i (1 : ℤ)) : IntLamps) ^ e =
      Multiplicative.ofAdd (Finsupp.single i e) := by
  have h := map_zpow (AddMonoidHom.toMultiplicative (Finsupp.singleAddHom (M := ℤ) i))
    (Multiplicative.ofAdd (1 : ℤ)) e
  rw [ofAdd_one_zpow] at h
  exact h.symm

/-- Every lamp configuration `e δ_i` is a conjugate of a power of `lamp` by a power of `shift`. -/
theorem inl_single (i e : ℤ) :
    (SemidirectProduct.inl (Multiplicative.ofAdd (Finsupp.single i e)) : IntWreath) =
      shift ^ i * lamp ^ e * (shift ^ i)⁻¹ := by
  have hl : lamp ^ e =
      SemidirectProduct.inl (φ := action) (Multiplicative.ofAdd (Finsupp.single 0 e)) := by
    have h := map_zpow (SemidirectProduct.inl (φ := action) (G := Multiplicative ℤ))
      (Multiplicative.ofAdd (Finsupp.single (0 : ℤ) (1 : ℤ))) e
    rw [single_zpow] at h
    exact h.symm
  rw [shift_zpow, hl, ← map_inv, ← SemidirectProduct.inl_aut, action_apply, toAdd_ofAdd,
    shiftAut_single, zero_add]

section Lift

variable {H : Type*} [Group H] (a t : H)
  (hc : ∀ i j : ℤ, Commute (t ^ i * a * (t ^ i)⁻¹) (t ^ j * a * (t ^ j)⁻¹))

open scoped IsMulCommutative in
/-- The lamps map into the subgroup generated by the pairwise commuting conjugates of `a`. -/
def lampHom : IntLamps →* H :=
  haveI : IsMulCommutative (Subgroup.closure (Set.range fun i : ℤ => t ^ i * a * (t ^ i)⁻¹)) :=
    Subgroup.isMulCommutative_closure (by
      rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
      exact (hc i j).eq)
  (Subgroup.closure (Set.range fun i : ℤ => t ^ i * a * (t ^ i)⁻¹)).subtype.comp
    (AddMonoidHom.toMultiplicativeLeft (Finsupp.liftAddHom fun i : ℤ =>
      zmultiplesHom (Additive (Subgroup.closure (Set.range fun i : ℤ => t ^ i * a * (t ^ i)⁻¹)))
        (Additive.ofMul ⟨t ^ i * a * (t ^ i)⁻¹, Subgroup.subset_closure ⟨i, rfl⟩⟩)))

theorem lampHom_single (i e : ℤ) :
    lampHom a t hc (Multiplicative.ofAdd (Finsupp.single i e)) = t ^ i * a ^ e * (t ^ i)⁻¹ := by
  rw [← conj_zpow]
  simp only [lampHom, MonoidHom.coe_comp, Function.comp_apply, Subgroup.coe_subtype,
    AddMonoidHom.coe_toMultiplicativeLeft, toAdd_ofAdd, Finsupp.liftAddHom_apply_single,
    zmultiplesHom_apply, toMul_zsmul, toMul_ofMul, Subgroup.coe_zpow]

/-- **Universal property of `ℤ ≀ ℤ`.**  Elements `a t` whose conjugates `t ^ i * a * (t ^ i)⁻¹`
commute pairwise define a homomorphism sending `lamp` to `a` and `shift` to `t`. -/
def lift : IntWreath →* H :=
  SemidirectProduct.lift (lampHom a t hc) (zpowersHom H t) fun g => by
    refine Finsupp.mulHom_ext fun x y => ?_
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, action_apply,
      shiftAut_single, lampHom_single, zpowersHom_apply]
    group

@[simp] theorem lift_inl_single (i e : ℤ) :
    lift a t hc (SemidirectProduct.inl (Multiplicative.ofAdd (Finsupp.single i e))) =
      t ^ i * a ^ e * (t ^ i)⁻¹ := by
  simp only [lift, SemidirectProduct.lift_inl, lampHom_single]

@[simp] theorem lift_inr (n : Multiplicative ℤ) :
    lift a t hc (SemidirectProduct.inr n) = t ^ Multiplicative.toAdd n := by
  simp only [lift, SemidirectProduct.lift_inr, zpowersHom_apply]

@[simp] theorem lift_lamp : lift a t hc lamp = a := by
  simp only [lamp, lift_inl_single, zpow_zero, zpow_one, one_mul, inv_one, mul_one]

@[simp] theorem lift_shift : lift a t hc shift = t := by
  simp only [shift, lift_inr, toAdd_ofAdd, zpow_one]

/-- Homomorphisms out of `ℤ ≀ ℤ` agreeing on `lamp` and `shift` are equal. -/
theorem hom_ext {f g : IntWreath →* H} (hl : f lamp = g lamp) (hs : f shift = g shift) :
    f = g :=
  SemidirectProduct.hom_ext
    (Finsupp.mulHom_ext fun i e => by
      simp only [MonoidHom.comp_apply, inl_single, map_mul, map_inv, map_zpow, hl, hs])
    (MonoidHom.ext_mint hs)

end Lift

/-! ### The presentation -/

/-- The relator `[a, t ^ (j + 1) * a * t ^ -(j + 1)]`. -/
def relator (j : ℕ) : FreeGroup (Fin 2) :=
  ⁅FreeGroup.of (0 : Fin 2), FreeGroup.of (1 : Fin 2) ^ ((j : ℤ) + 1) * FreeGroup.of (0 : Fin 2) *
    (FreeGroup.of (1 : Fin 2) ^ ((j : ℤ) + 1))⁻¹⁆

/-- The group `⟨a, t | [a, t ^ k * a * t ^ -k], k ≥ 1⟩`. -/
abbrev Presented : Type := PresentedGroup (Set.range relator)

theorem lift_relator {K : Type*} [Group K] (f : Fin 2 → K) (j : ℕ) :
    FreeGroup.lift f (relator j) =
      ⁅f 0, f 1 ^ ((j : ℤ) + 1) * f 0 * (f 1 ^ ((j : ℤ) + 1))⁻¹⁆ := by
  simp only [relator, map_commutatorElement, map_mul, map_inv, map_zpow, FreeGroup.lift_apply_of]

theorem wreath_relator (j : ℕ) : FreeGroup.lift ![lamp, shift] (relator j) = 1 := by
  rw [lift_relator, commutatorElement_eq_one_iff_commute]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
  have h := inl_single ((j : ℤ) + 1) 1
  rw [zpow_one] at h
  rw [← h]
  exact (Commute.all (Multiplicative.ofAdd (Finsupp.single (0 : ℤ) (1 : ℤ)) : IntLamps)
    (Multiplicative.ofAdd (Finsupp.single ((j : ℤ) + 1) 1))).map SemidirectProduct.inl

/-- The presented group maps to `ℤ ≀ ℤ`. -/
def toWreath : Presented →* IntWreath :=
  PresentedGroup.toGroup (f := ![lamp, shift]) (by
    rintro _ ⟨j, rfl⟩
    exact wreath_relator j)

/-- The generator `a` of the presented group. -/
def presA : Presented := PresentedGroup.of 0

/-- The generator `t` of the presented group. -/
def presT : Presented := PresentedGroup.of 1

theorem toWreath_presA : toWreath presA = lamp := by
  simp only [toWreath, presA, PresentedGroup.toGroup.of, Matrix.cons_val_zero]

theorem toWreath_presT : toWreath presT = shift := by
  simp only [toWreath, presT, PresentedGroup.toGroup.of, Matrix.cons_val_one,
    Matrix.cons_val_zero]

theorem presented_commute_succ (m : ℕ) :
    Commute presA (presT ^ ((m : ℤ) + 1) * presA * (presT ^ ((m : ℤ) + 1))⁻¹) := by
  rw [← commutatorElement_eq_one_iff_commute]
  have h := PresentedGroup.one_of_mem (Set.mem_range_self (f := relator) m)
  simpa only [presA, presT, PresentedGroup.of, relator, map_commutatorElement, map_mul, map_inv,
    map_zpow] using h

theorem presented_commute_of_lt {i j : ℤ} (h : i < j) :
    Commute (presT ^ i * presA * (presT ^ i)⁻¹) (presT ^ j * presA * (presT ^ j)⁻¹) := by
  obtain ⟨m, rfl⟩ : ∃ m : ℕ, j = i + ((m : ℤ) + 1) := ⟨(j - i - 1).toNat, by omega⟩
  have hc := (presented_commute_succ m).map (MulAut.conj (presT ^ i))
  have e : presT ^ i * (presT ^ ((m : ℤ) + 1) * presA * (presT ^ ((m : ℤ) + 1))⁻¹) *
      (presT ^ i)⁻¹ = presT ^ (i + ((m : ℤ) + 1)) * presA * (presT ^ (i + ((m : ℤ) + 1)))⁻¹ := by
    group
  simp only [MulAut.conj_apply] at hc
  rwa [e] at hc

theorem presented_commute (i j : ℤ) :
    Commute (presT ^ i * presA * (presT ^ i)⁻¹) (presT ^ j * presA * (presT ^ j)⁻¹) := by
  rcases lt_trichotomy i j with h | rfl | h
  · exact presented_commute_of_lt h
  · exact Commute.refl _
  · exact (presented_commute_of_lt h).symm

theorem lift_comp_toWreath :
    (lift presA presT presented_commute).comp toWreath = MonoidHom.id Presented := by
  refine PresentedGroup.ext (Fin.forall_fin_two.mpr ⟨?_, ?_⟩)
  · show lift presA presT presented_commute (toWreath presA) = presA
    rw [toWreath_presA, lift_lamp]
  · show lift presA presT presented_commute (toWreath presT) = presT
    rw [toWreath_presT, lift_shift]

theorem toWreath_comp_lift :
    toWreath.comp (lift presA presT presented_commute) = MonoidHom.id IntWreath :=
  hom_ext (by rw [MonoidHom.comp_apply, lift_lamp, toWreath_presA, MonoidHom.id_apply])
    (by rw [MonoidHom.comp_apply, lift_shift, toWreath_presT, MonoidHom.id_apply])

/-- `ℤ ≀ ℤ` has the presentation `⟨a, t | [a, t ^ k * a * t ^ -k], k ≥ 1⟩`. -/
def presentedEquiv : Presented ≃* IntWreath :=
  MonoidHom.toMulEquiv toWreath (lift presA presT presented_commute) lift_comp_toWreath
    toWreath_comp_lift

/-! ### No finite subset of the relators suffices -/

/-- Translations of `ℤ`, as a homomorphism. -/
def translateHom : Multiplicative ℤ →* Equiv.Perm ℤ where
  toFun n := translatePerm (Multiplicative.toAdd n)
  map_one' := by
    ext x
    simp
  map_mul' m n := by
    ext x
    simp only [translatePerm_apply, toAdd_mul, Equiv.Perm.mul_apply]
    ring

theorem translatePerm_zpow (k : ℤ) : translatePerm 1 ^ k = translatePerm k := by
  have h := map_zpow translateHom (Multiplicative.ofAdd (1 : ℤ)) k
  rw [ofAdd_one_zpow] at h
  exact h.symm

theorem conj_swap (k a b : ℤ) :
    translatePerm k * Equiv.swap a b * (translatePerm k)⁻¹ = Equiv.swap (a + k) (b + k) := by
  rw [← Equiv.swap_apply_apply, translatePerm_apply, translatePerm_apply]

theorem swap_commute_of_ne {a b c d : ℤ} (hca : c ≠ a) (hcb : c ≠ b) (hda : d ≠ a)
    (hdb : d ≠ b) : Commute (Equiv.swap a b) (Equiv.swap c d) := by
  have h : Equiv.swap a b * Equiv.swap c d * (Equiv.swap a b)⁻¹ = Equiv.swap c d := by
    rw [← Equiv.swap_apply_apply, Equiv.swap_apply_of_ne_of_ne hca hcb,
      Equiv.swap_apply_of_ne_of_ne hda hdb]
  exact mul_inv_eq_iff_eq_mul.mp h

theorem commutator_swap_ne_one {a b c : ℤ} (hab : a ≠ b) (hbc : b ≠ c) (hac : a ≠ c) :
    ⁅Equiv.swap a b, Equiv.swap b c⁆ ≠ 1 := by
  intro h
  have h2 := congrArg (fun p : Equiv.Perm ℤ => p b) h
  simp only [commutatorElement_def, Equiv.Perm.mul_apply, Equiv.swap_inv, Equiv.Perm.one_apply,
    Equiv.swap_apply_left, Equiv.swap_apply_right,
    Equiv.swap_apply_of_ne_of_ne hac.symm hbc.symm] at h2
  exact hab h2

theorem not_isFinitelyPresented_presented : ¬ Group.IsFinitelyPresented Presented := by
  refine PartialCommutation.not_isFinitelyPresented_of_violable relator fun s hs => ?_
  obtain ⟨M, hM⟩ := hs.bddAbove
  refine ⟨M + 1, Equiv.Perm ℤ, inferInstance,
    ![Equiv.swap 0 ((M : ℤ) + 2), translatePerm 1], fun j hj => ?_, ?_⟩
  · have hjM : j ≤ M := hM hj
    rw [lift_relator, commutatorElement_eq_one_iff_commute]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, translatePerm_zpow, conj_swap]
    exact swap_commute_of_ne (by omega) (by omega) (by omega) (by omega)
  · rw [lift_relator]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, translatePerm_zpow, conj_swap]
    have e : (0 : ℤ) + (((M + 1 : ℕ) : ℤ) + 1) = (M : ℤ) + 2 := by omega
    rw [e]
    exact commutator_swap_ne_one (by omega) (by omega) (by omega)

/-- **Baumslag (1961).** The integer wreath product `ℤ ≀ ℤ` is not finitely presented. -/
theorem not_isFinitelyPresented : ¬ Group.IsFinitelyPresented IntWreath :=
  not_isFinitelyPresented_of_mulEquiv presentedEquiv not_isFinitelyPresented_presented

end IntWreath
end TypeA2
end GroupApproximation

end
