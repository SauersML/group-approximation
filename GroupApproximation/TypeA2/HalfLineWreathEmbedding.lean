import GroupApproximation.TypeA2.HalfLineWreath
import GroupApproximation.TypeA2.IntWreathNotFinitelyPresented

/-!
# A copy of `ℤ ≀ ℤ` in geometric Thompson `F`

`HalfLineWreath` gives a lamp `lampF`, supported in `[1, 4]`, and a shift `shiftF` with
`shiftF 1 = 4`, whose conjugates `shiftF ^ i * lampF * shiftF ^ -i` commute pairwise.  The
universal property of `ℤ ≀ ℤ` gives `wreathEmbedding : IntWreath →* geoF 0`, and this module
proves that it is injective (`wreathEmbedding_injective`).

On a point `wreathShift ^ j y` with `1 < y < 4`, a lamp configuration `f` acts as
`wreathLamp ^ f j` (`wreathEmbedding_inl_apply`).  Evaluating an element of the kernel at `2`
shows that its shift part is trivial.  Evaluating it at `wreathShift ^ j 2` then shows `f j = 0`.
-/

namespace GroupApproximation.TypeA2

open HigmanThompson

/-- The copy of `ℤ ≀ ℤ` in `geoF 0` generated by the lamp and the shift. -/
noncomputable def wreathEmbedding : IntWreath →* geoF 0 :=
  IntWreath.lift lampF shiftF shiftF_conj_commute

theorem wreathEmbedding_lamp : wreathEmbedding IntWreath.lamp = lampF :=
  IntWreath.lift_lamp lampF shiftF shiftF_conj_commute

theorem wreathEmbedding_shift : wreathEmbedding IntWreath.shift = shiftF :=
  IntWreath.lift_shift lampF shiftF shiftF_conj_commute

theorem coe_wreathEmbedding_inl_single (i e : ℤ) :
    ((wreathEmbedding (SemidirectProduct.inl (Multiplicative.ofAdd (Finsupp.single i e))) :
        geoF 0) : Equiv.Perm ℚ) = wreathShift ^ i * wreathLamp ^ e * (wreathShift ^ i)⁻¹ :=
  congrArg Subtype.val (IntWreath.lift_inl_single lampF shiftF shiftF_conj_commute i e)

theorem coe_wreathEmbedding_inr (n : ℤ) :
    ((wreathEmbedding (SemidirectProduct.inr (Multiplicative.ofAdd n)) : geoF 0) :
      Equiv.Perm ℚ) = wreathShift ^ n :=
  congrArg Subtype.val
    (IntWreath.lift_inr lampF shiftF shiftF_conj_commute (Multiplicative.ofAdd n))

/-- A lamp configuration `g` acts on `wreathShift ^ j y`, for `1 < y < 4`, as
`wreathLamp ^ g j`. -/
theorem wreathEmbedding_inl_apply (g : ℤ →₀ ℤ) (j : ℤ) {y : ℚ} (h1 : 1 < y) (h4 : y < 4) :
    ((wreathEmbedding (SemidirectProduct.inl (Multiplicative.ofAdd g)) : geoF 0) :
        Equiv.Perm ℚ) ((wreathShift ^ j) y) = (wreathShift ^ j) ((wreathLamp ^ g j) y) := by
  refine Finsupp.induction g ?_ ?_
  · simp
  · intro a b f _ _ ih
    simp only [ofAdd_add, map_mul, Subgroup.coe_mul, Equiv.Perm.mul_apply]
    rw [ih, coe_wreathEmbedding_inl_single, Finsupp.add_apply]
    by_cases hj : a = j
    · subst hj
      rw [Finsupp.single_eq_same, conj_zpow_wreathLamp_apply, zpow_add, Equiv.Perm.mul_apply]
    · have hm := zpow_wreathLamp_mapsTo (f j) h1 h4
      rw [Finsupp.single_eq_of_ne' hj, zero_add, conj_zpow_wreathLamp_fix hj b hm.1.le hm.2.le]

/-- **`ℤ ≀ ℤ` embeds in `geoF 0`.** -/
theorem wreathEmbedding_injective : Function.Injective wreathEmbedding := by
  rw [injective_iff_map_eq_one]
  intro x hx
  obtain ⟨f, n, rfl⟩ : ∃ (f : ℤ →₀ ℤ) (n : ℤ),
      x = SemidirectProduct.inl (Multiplicative.ofAdd f) *
        SemidirectProduct.inr (Multiplicative.ofAdd n) :=
    ⟨Multiplicative.toAdd x.left, Multiplicative.toAdd x.right,
      (SemidirectProduct.inl_left_mul_inr_right x).symm⟩
  have hperm : ∀ z : ℚ, ((wreathEmbedding (SemidirectProduct.inl (Multiplicative.ofAdd f)) :
      geoF 0) : Equiv.Perm ℚ) ((wreathShift ^ n) z) = z := by
    intro z
    have h := DFunLike.congr_fun (congrArg Subtype.val hx) z
    rw [map_mul, Subgroup.coe_mul, Equiv.Perm.mul_apply, coe_wreathEmbedding_inr,
      Subgroup.coe_one, Equiv.Perm.one_apply] at h
    exact h
  have hn : n = 0 := by
    by_contra hn
    have h2 := hperm 2
    rw [wreathEmbedding_inl_apply f n (y := 2) (by norm_num) (by norm_num)] at h2
    have hm := zpow_wreathLamp_mapsTo (f n) (show (1 : ℚ) < 2 by norm_num)
      (show (2 : ℚ) < 4 by norm_num)
    rcases wreathShift_zpow_out hn hm.1.le hm.2.le with h | h
    · rw [h2] at h
      norm_num at h
    · rw [h2] at h
      norm_num at h
  subst hn
  have hf : f = 0 := by
    ext j
    have h := hperm ((wreathShift ^ j) 2)
    rw [zpow_zero, Equiv.Perm.one_apply,
      wreathEmbedding_inl_apply f j (y := 2) (by norm_num) (by norm_num)] at h
    rw [Finsupp.coe_zero, Pi.zero_apply]
    by_contra hj
    exact zpow_wreathLamp_two_ne hj ((wreathShift ^ j).injective h)
  subst hf
  simp

end GroupApproximation.TypeA2
