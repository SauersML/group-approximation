import GroupApproximation.GraphCStar.Graph
import Mathlib.Analysis.CStarAlgebra.lpSpace
import Mathlib.Analysis.CStarAlgebra.Spectrum

/-!
# The graph C*-algebra of a finite graph

For a finite graph `G` this file constructs the universal C*-algebra `C*(G)` of unital
Cuntz–Krieger `G`-families (Kumjian–Pask–Raeburn 1998, §1). No existence theorem for universal
C*-algebras is assumed.

The ambient algebra is the bounded product `ℓ^∞` of every unital Cuntz–Krieger `G`-family in a
nontrivial C*-algebra in the universe of `G`. Each generator of a Cuntz–Krieger family has norm at
most one, so the diagonal generators lie in the product. `C*(G)` is the closed star subalgebra
generated by the diagonal family.

* `CKFamily.norm_p_le`, `CKFamily.norm_s_le`: the generators of a family have norm at most one.
* `GraphCStarAlgebra G`: the C*-algebra `C*(G)`, in `Type (u + 1)`.
* `ckFamily G`: its generating Cuntz–Krieger family.
* `lift G F`: the homomorphism `C*(G) → B` sending the generators to a family `F` in a nontrivial
  C*-algebra `B : Type u`.
* `hom_ext`: homomorphisms out of `C*(G)`, into any C*-algebra, agreeing on the generators are
  equal.
* `existsUnique_lift`: the universal property for targets in `Type u`.

The prose of this module was written by Claude (Anthropic).
-/

open scoped CStarAlgebra ENNReal

noncomputable section

universe u

namespace GroupApproximation
namespace GraphCStar

open Finset

variable {V E : Type u} [Fintype V] [Fintype E] [DecidableEq V]

namespace CKFamily

variable {G : Graph V E} {A : Type*} [CStarAlgebra A] (F : CKFamily G A)

theorem norm_p_le (v : V) : ‖F.p v‖ ≤ 1 :=
  IsStarProjection.norm_le _ ⟨F.p_mul_p_self v, F.star_p v⟩

theorem norm_s_le (e : E) : ‖F.s e‖ ≤ 1 := by
  have h : ‖F.s e‖ * ‖F.s e‖ ≤ 1 := by
    rw [← CStarRing.norm_star_mul_self, F.star_s_mul_s_self]
    exact F.norm_p_le _
  nlinarith [norm_nonneg (F.s e)]

end CKFamily

/-- A unital Cuntz–Krieger `G`-family in a nontrivial C*-algebra in the universe of `G`. -/
structure CKRepresentation (G : Graph V E) where
  /-- The carrier C*-algebra. -/
  carrier : Type u
  /-- The C*-algebra structure of the carrier. -/
  instCStarAlgebra : CStarAlgebra carrier
  /-- The carrier is nontrivial. -/
  instNontrivial : Nontrivial carrier
  /-- The Cuntz–Krieger family. -/
  family : letI : CStarAlgebra carrier := instCStarAlgebra
    CKFamily G carrier

namespace CKRepresentation

variable {G : Graph V E}

instance (R : CKRepresentation G) : CStarAlgebra R.carrier := R.instCStarAlgebra

instance (R : CKRepresentation G) : Nontrivial R.carrier := R.instNontrivial

end CKRepresentation

variable (G : Graph V E)

/-- The bounded product of all representations of `G`. -/
abbrev CKAmbient := lp (fun R : CKRepresentation G ↦ R.carrier) ∞

noncomputable instance ckAmbientCStarAlgebra : CStarAlgebra (CKAmbient G) where
  toNormedRing := inferInstance
  toStarRing := inferInstance
  toCompleteSpace := inferInstance
  toCStarRing := inferInstance
  toNormedAlgebra := inferInstance
  toStarModule := inferInstance

/-- The diagonal vertex projection `(p_v)_R`. -/
def ambientP (v : V) : CKAmbient G :=
  ⟨fun R ↦ R.family.p v, memℓp_infty ⟨1, by
    rintro _ ⟨R, rfl⟩
    exact R.family.norm_p_le v⟩⟩

/-- The diagonal edge partial isometry `(s_e)_R`. -/
def ambientS (e : E) : CKAmbient G :=
  ⟨fun R ↦ R.family.s e, memℓp_infty ⟨1, by
    rintro _ ⟨R, rfl⟩
    exact R.family.norm_s_le e⟩⟩

/-- Evaluation of the ambient product at one representation. -/
def ambientEval (R : CKRepresentation G) : CKAmbient G →⋆ₐ[ℂ] R.carrier where
  toFun f := f R
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl
  map_star' _ := rfl

/-- The diagonal Cuntz–Krieger family in the ambient product. -/
def ambientFamily : CKFamily G (CKAmbient G) :=
  CKFamily.ofJointlyInjective (ambientEval G) (fun _ _ h ↦ lp.ext (funext h))
    (fun R ↦ R.family) (ambientP G) (ambientS G) (fun _ _ ↦ rfl) (fun _ _ ↦ rfl)

/-- The diagonal generators. -/
def ckGenerators : Set (CKAmbient G) := Set.range (ambientP G) ∪ Set.range (ambientS G)

/-- The closed star subalgebra generated by the diagonal family. -/
def graphCStarSubalgebra : StarSubalgebra ℂ (CKAmbient G) :=
  (StarAlgebra.adjoin ℂ (ckGenerators G)).topologicalClosure

instance graphCStarSubalgebra_isClosed :
    IsClosed (graphCStarSubalgebra G : Set (CKAmbient G)) :=
  StarSubalgebra.isClosed_topologicalClosure _

/-- The graph C*-algebra `C*(G)` of a finite graph. -/
abbrev GraphCStarAlgebra : Type (u + 1) := graphCStarSubalgebra G

noncomputable instance : CStarAlgebra (GraphCStarAlgebra G) := inferInstance

theorem ambientP_mem (v : V) : ambientP G v ∈ graphCStarSubalgebra G :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨v, rfl⟩))

theorem ambientS_mem (e : E) : ambientS G e ∈ graphCStarSubalgebra G :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ (Or.inr ⟨e, rfl⟩))

/-- The generating Cuntz–Krieger family of `C*(G)`. -/
def ckFamily : CKFamily G (GraphCStarAlgebra G) :=
  CKFamily.ofJointlyInjective (ι := Unit) (fun _ ↦ (graphCStarSubalgebra G).subtype)
    (fun _ _ h ↦ Subtype.ext (h ())) (fun _ ↦ ambientFamily G)
    (fun v ↦ ⟨ambientP G v, ambientP_mem G v⟩) (fun e ↦ ⟨ambientS G e, ambientS_mem G e⟩)
    (fun _ _ ↦ rfl) (fun _ _ ↦ rfl)

theorem coe_ckFamily_p (v : V) : ((ckFamily G).p v : CKAmbient G) = ambientP G v := rfl

theorem coe_ckFamily_s (e : E) : ((ckFamily G).s e : CKAmbient G) = ambientS G e := rfl

section Lift

variable {B : Type u} [CStarAlgebra B] [Nontrivial B]

/-- The homomorphism `C*(G) → B` sending the generators to a unital Cuntz–Krieger family in a
nontrivial C*-algebra in the universe of `G`. -/
def lift (F : CKFamily G B) : GraphCStarAlgebra G →⋆ₐ[ℂ] B :=
  (ambientEval G ⟨B, inferInstance, inferInstance, F⟩).comp (graphCStarSubalgebra G).subtype

@[simp] theorem lift_p (F : CKFamily G B) (v : V) : lift G F ((ckFamily G).p v) = F.p v := rfl

@[simp] theorem lift_s (F : CKFamily G B) (e : E) : lift G F ((ckFamily G).s e) = F.s e := rfl

end Lift

/-- Two homomorphisms out of `C*(G)` that agree on the generators are equal. The target may lie in
any universe. -/
theorem hom_ext {B : Type*} [CStarAlgebra B] {φ ψ : GraphCStarAlgebra G →⋆ₐ[ℂ] B}
    (hp : ∀ v, φ ((ckFamily G).p v) = ψ ((ckFamily G).p v))
    (hs : ∀ e, φ ((ckFamily G).s e) = ψ ((ckFamily G).s e)) : φ = ψ := by
  apply StarAlgHom.ext_topologicalClosure (R := ℂ) (A := CKAmbient G) (B := B)
    (map_continuous φ) (map_continuous ψ)
  apply StarAlgHom.ext_adjoin
  intro x hx
  have hx' : (x : CKAmbient G) ∈ Set.range (ambientP G) ∨
      (x : CKAmbient G) ∈ Set.range (ambientS G) := hx
  rcases hx' with ⟨v, hv⟩ | ⟨e, he⟩
  · have hxv : x = ⟨ambientP G v, StarAlgebra.subset_adjoin ℂ _ (Or.inl ⟨v, rfl⟩)⟩ :=
      Subtype.ext hv.symm
    rw [hxv]
    exact hp v
  · have hxe : x = ⟨ambientS G e, StarAlgebra.subset_adjoin ℂ _ (Or.inr ⟨e, rfl⟩)⟩ :=
      Subtype.ext he.symm
    rw [hxe]
    exact hs e

theorem lift_unique {B : Type u} [CStarAlgebra B] [Nontrivial B] (F : CKFamily G B)
    {φ : GraphCStarAlgebra G →⋆ₐ[ℂ] B} (hp : ∀ v, φ ((ckFamily G).p v) = F.p v)
    (hs : ∀ e, φ ((ckFamily G).s e) = F.s e) : φ = lift G F :=
  hom_ext G (fun v ↦ (hp v).trans (lift_p G F v).symm) (fun e ↦ (hs e).trans (lift_s G F e).symm)

/-- **Universal property of `C*(G)`.** Every unital Cuntz–Krieger `G`-family in a C*-algebra in
the universe of `G` is the image of the generating family under a unique homomorphism. -/
theorem existsUnique_lift {B : Type u} [CStarAlgebra B] (F : CKFamily G B) :
    ∃! φ : GraphCStarAlgebra G →⋆ₐ[ℂ] B,
      (∀ v, φ ((ckFamily G).p v) = F.p v) ∧ ∀ e, φ ((ckFamily G).s e) = F.s e := by
  rcases subsingleton_or_nontrivial B with hB | hB
  · letI : Subsingleton B := hB
    let f : GraphCStarAlgebra G →⋆ₐ[ℂ] B :=
      { toFun := fun _ ↦ 0
        map_one' := Subsingleton.elim _ _
        map_mul' := fun _ _ ↦ Subsingleton.elim _ _
        map_zero' := rfl
        map_add' := fun _ _ ↦ Subsingleton.elim _ _
        commutes' := fun _ ↦ Subsingleton.elim _ _
        map_star' := fun _ ↦ Subsingleton.elim _ _ }
    refine ⟨f, ⟨fun _ ↦ Subsingleton.elim _ _, fun _ ↦ Subsingleton.elim _ _⟩, ?_⟩
    intro q _
    exact StarAlgHom.ext fun _ ↦ Subsingleton.elim _ _
  · letI : Nontrivial B := hB
    refine ⟨lift G F, ⟨lift_p G F, lift_s G F⟩, ?_⟩
    rintro q ⟨hqp, hqs⟩
    exact lift_unique G F hqp hqs

end GraphCStar
end GroupApproximation
