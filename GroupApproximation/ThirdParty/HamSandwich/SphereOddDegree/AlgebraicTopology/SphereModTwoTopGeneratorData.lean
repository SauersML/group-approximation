import Mathlib
import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.AlgebraicTopology.CoefficientReduction
import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.AlgebraicTopology.Branch2RankOne
import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.SphereModTwoHomologyVanishing
import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.AlgebraicTopology.SphereOrientationPosFromMV
import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.AlgebraicTopology.SphereModTwoTopClass
import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.TopCatBridge

/-!
# Prompt 04 Lean target: construct sphere mod-two top homology generator data

The current project already has the bundled structure

  SphereModTwoTopData e

but that structure includes the action of every self-map on the generator.  This
file separates the purely homological part:

  H_n(S^n; F_2) is generated by one nonzero class.

Prompt 05 should then prove the degree action on this generator and assemble the
existing `SphereModTwoTopData e`.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicTopology

namespace GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree

/-- The generator-only part of the sphere top `F_2`-homology datum.

This deliberately omits the degree-action field of `SphereModTwoTopData e`.
That action is Prompt 05. -/
structure SphereModTwoTopGeneratorData (n : Nat) where
  /-- A chosen top class in `H_n(S^n; F_2)`. -/
  g : homologyZMod2 (TopCat.of (Sphere n)) n
  /-- The chosen class is nonzero. -/
  g_ne : g ≠ 0
  /-- The chosen class spans the whole top `F_2`-homology group. -/
  spans : forall z : homologyZMod2 (TopCat.of (Sphere n)) n,
    exists a : ZMod 2, z = a • g

namespace SphereModTwoTopGeneratorData

variable {n : Nat} (D : SphereModTwoTopGeneratorData n)

/-- The top `F_2`-homology group is nontrivial. -/
theorem nontrivial (D : SphereModTwoTopGeneratorData n) :
    Nontrivial (homologyZMod2 (TopCat.of (Sphere n)) n) := by
  classical
  refine ⟨⟨D.g, 0, ?_⟩⟩
  exact D.g_ne

/-- A linear endomorphism is determined by its value on the chosen generator. -/
theorem linearMap_ext_on_generator
    (T U : homologyZMod2 (TopCat.of (Sphere n)) n →ₗ[ZMod 2]
      homologyZMod2 (TopCat.of (Sphere n)) n)
    (h : T D.g = U D.g) : T = U := by
  ext z
  obtain ⟨a, rfl⟩ := D.spans z
  simp [h]

/-- If a linear endomorphism sends the generator to `d • g`, then it is scalar
multiplication by `d` on every class. -/
theorem endomorphism_eq_scalar_of_generator_action
    (T : homologyZMod2 (TopCat.of (Sphere n)) n →ₗ[ZMod 2]
      homologyZMod2 (TopCat.of (Sphere n)) n)
    (d : ZMod 2) (hT : T D.g = d • D.g) :
    forall z, T z = d • z := by
  intro z
  obtain ⟨a, rfl⟩ := D.spans z
  calc
    T (a • D.g) = a • T D.g := by simp
    _ = a • (d • D.g) := by rw [hT]
    _ = (a * d) • D.g := by rw [smul_smul]
    _ = (d * a) • D.g := by rw [mul_comm]
    _ = d • (a • D.g) := by rw [smul_smul]

end SphereModTwoTopGeneratorData

/-! ## Transport from an explicit top homology iso -/

/-- A temporary explicit iso package for the top `F_2` homology of the sphere. -/
def SphereModTwoTopHomologyIso (n : Nat) : Type :=
  homologyZMod2 (TopCat.of (Sphere n)) n ≅ ModuleCat.of (ZMod 2) (ZMod 2)

/-- The underlying `ZMod 2`-linear equivalence of an explicit top `F_2`
homology iso. -/
def sphereModTwoTopLinearEquiv {n : Nat} (E : SphereModTwoTopHomologyIso n) :
    homologyZMod2 (TopCat.of (Sphere n)) n ≃ₗ[ZMod 2] (ZMod 2) :=
  Iso.toLinearEquiv E

/-- The generator induced by an explicit top `F_2` homology iso. -/
def sphereModTwoTopGeneratorOfIso {n : Nat} (E : SphereModTwoTopHomologyIso n) :
    homologyZMod2 (TopCat.of (Sphere n)) n :=
  (sphereModTwoTopLinearEquiv E).symm (1 : ZMod 2)

/-- The generator induced by an explicit top `F_2` homology iso is nonzero. -/
theorem sphereModTwoTopGeneratorOfIso_ne_zero {n : Nat}
    (E : SphereModTwoTopHomologyIso n) :
    sphereModTwoTopGeneratorOfIso E ≠ 0 := by
  intro h
  have h2 := congrArg (sphereModTwoTopLinearEquiv E) h
  simp only [sphereModTwoTopGeneratorOfIso, LinearEquiv.apply_symm_apply,
    map_zero] at h2
  exact one_ne_zero h2

/-- Every class is a scalar multiple of the generator induced by an explicit top
`F_2` homology iso. -/
theorem sphereModTwoTopGeneratorOfIso_spans {n : Nat}
    (E : SphereModTwoTopHomologyIso n) :
    forall z : homologyZMod2 (TopCat.of (Sphere n)) n,
      exists a : ZMod 2, z = a • sphereModTwoTopGeneratorOfIso E := by
  intro z
  refine ⟨(sphereModTwoTopLinearEquiv E) z, ?_⟩
  show z = (sphereModTwoTopLinearEquiv E) z •
    (sphereModTwoTopLinearEquiv E).symm (1 : ZMod 2)
  rw [← map_smul, smul_eq_mul, mul_one, LinearEquiv.symm_apply_apply]

/-- Generator data induced by an explicit top `F_2` homology iso. -/
def sphereModTwoTopGeneratorDataOfIso {n : Nat}
    (E : SphereModTwoTopHomologyIso n) : SphereModTwoTopGeneratorData n where
  g := sphereModTwoTopGeneratorOfIso E
  g_ne := sphereModTwoTopGeneratorOfIso_ne_zero E
  spans := sphereModTwoTopGeneratorOfIso_spans E

/-! ## Main Prompt 04 target -/

/-- Main theorem of Prompt 04: construct the explicit top `F_2` homology iso.

This reuses the already-constructed mod-two top homology iso `sphereModTwoTop_iso`,
obtained from the mod-two Mayer--Vietoris suspension tower (`sphereModTwoSuspension`)
with the base case `H_1(S^1; F_2) ≅ F_2`. -/
def construct_sphereModTwoTopHomologyIso (n : Nat) (hn : 1 <= n) :
    SphereModTwoTopHomologyIso n :=
  sphereModTwoTop_iso n hn

/-- Main theorem of Prompt 04: the top `F_2` homology of `S^n`, for `n >= 1`, has
one nonzero spanning generator. -/
def construct_SphereModTwoTopGeneratorData (n : Nat) (hn : 1 <= n) :
    SphereModTwoTopGeneratorData n :=
  sphereModTwoTopGeneratorDataOfIso (construct_sphereModTwoTopHomologyIso n hn)

end GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree

