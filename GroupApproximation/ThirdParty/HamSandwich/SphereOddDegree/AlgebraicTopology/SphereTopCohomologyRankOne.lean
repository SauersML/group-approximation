import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.AlgebraicTopology.SphereModTwoTopGeneratorData
import GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree.AlgebraicTopology.KroneckerNaturality

/-!
# Top mod-two cohomology of a sphere has rank one

This isolates the rank calculation needed by the unconditional projective-space
transfer argument from the larger Branch-4 assembly.
-/

noncomputable section

open AlgebraicTopology

namespace GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree

/-- Top mod-two homology of `Sⁿ`, for `n ≥ 1`, is generated by one nonzero
class and therefore has dimension one. -/
theorem sphere_top_homology_finrank_one_direct (n : ℕ) (hn : 1 ≤ n) :
    Module.finrank (ZMod 2) (homologyZMod2 (TopCat.of (Sphere n)) n) = 1 := by
  classical
  have D := construct_SphereModTwoTopGeneratorData n hn
  exact finrank_eq_one D.g D.g_ne
    (fun w => (D.spans w).imp (fun a ha => ha.symm))

/-- Top mod-two cohomology of `Sⁿ`, for `n ≥ 1`, has dimension one. -/
theorem sphere_top_cohomology_finrank_one_direct (n : ℕ) (hn : 1 ≤ n) :
    Module.finrank (ZMod 2) (sphereCohomology n n) = 1 := by
  have e : sphereCohomology n n ≃ₗ[ZMod 2]
      (homologyZMod2 (TopCat.of (Sphere n)) n →ₗ[ZMod 2] ZMod 2) :=
    (kroneckerEquiv (TopCat.of (Sphere n)) n).toLinearEquiv
  rw [e.finrank_eq]
  exact (Subspace.dual_finrank_eq).trans
    (sphere_top_homology_finrank_one_direct n hn)

end GroupApproximation.ThirdParty.HamSandwich.SphereOddDegree
