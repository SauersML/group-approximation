import GroupApproximation.BooneHigmanLinear.LSCore.PStable
import GroupApproximation.Meta.AxiomGuard

/-!
# Consistency checks for the H.L3 hypotheses used by LSCore

LSCore takes bh-pal-wire's H.L3 statements as hypotheses: `RelGen.Thm44Statement`,
`RelGen.Split44Statement` and `RelGen.Cor410Statement`. The identities of L–S 4.1 and 4.6 are not
hypotheses; they are proved in `LSCore/ZC*.lean`. The generation statements are universally
quantified theorems, so the only honest test short of proving them is to check their instances
in the degenerate cases. Here those instances are proved outright:
* `thm44_top`: `J = ⊤`: `St̄(R, R) = St(R)` is generated by the root elements (the statement
  specialises to generation by definition);
* `thm44_bot`: `J = ⊥`: both sides are trivial;
* `cor410_field`: Corollary 4.10 over a field (`𝔪 = 0`): both sides are trivial.
They catch transcription errors in the degenerate cases, e.g. a wrong side of an equality or a
missing generator family. A non-degenerate test of 4.10 would amount to proving it, which is H.L3's
job (lane bh-pal-wire).
-/

namespace GroupApproximation
namespace BooneHigmanLinear
namespace LSCore

open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.BooneHigmanLinear.RelGen
open Polynomial (X C)

variable {I : Type} [Fintype I] [DecidableEq I] {R : Type} [CommRing R]

theorem generators_top : Subgroup.closure (xSet I (⊤ : Ideal R)) = ⊤ := by
  rw [eq_top_iff, ← PresentedGroup.closure_range_of, Subgroup.closure_le]
  rintro _ ⟨⟨i, j, hij, a⟩, rfl⟩
  exact Subgroup.subset_closure ⟨i, j, hij, a, Submodule.mem_top, rfl⟩

/-- **Thm 4.4 at `J = ⊤`.** -/
theorem thm44_top (U : I → I → Prop) : relKer I (⊤ : Ideal R) = zGen I ⊤ U := by
  have hz : zGen I (⊤ : Ideal R) U = ⊤ := by
    rw [eq_top_iff, ← generators_top (R := R)]
    exact Subgroup.closure_mono Set.subset_union_left
  rw [hz, eq_top_iff, ← generators_top (R := R), Subgroup.closure_le]
  rintro _ ⟨i, j, hij, a, -, rfl⟩
  change x i j hij a ∈ K2Found.relSt I _
  rw [K2Found.mem_relSt, ringMap_x,
    Ideal.Quotient.eq_zero_iff_mem.mpr (Submodule.mem_top : a ∈ (⊤ : Ideal R)), x_zero]

#audit_axioms thm44_top

/-- **Thm 4.4 at `J = ⊥`.** -/
theorem thm44_bot (U : I → I → Prop) : relKer I (⊥ : Ideal R) = zGen I ⊥ U := by
  have hinj : Function.Injective (ringMap (I := I) (Ideal.Quotient.mk (⊥ : Ideal R))) :=
    ringMap_injective_of_leftInverse _
      (Ideal.Quotient.lift ⊥ (RingHom.id R) fun a ha => by
        rw [Ideal.mem_bot] at ha
        rw [ha, map_zero])
      fun a => Ideal.Quotient.lift_mk _ _ _
  have hk : relKer I (⊥ : Ideal R) = ⊥ := by
    rw [eq_bot_iff]
    intro g hg
    change g ∈ K2Found.relSt I _ at hg
    rw [K2Found.mem_relSt] at hg
    exact (Subgroup.mem_bot).mpr (hinj (hg.trans (map_one _).symm))
  rw [hk, eq_comm, eq_bot_iff, zGen, Subgroup.closure_le]
  rintro _ (⟨i, j, hij, s, hs, rfl⟩ | ⟨i, j, hij, s, ξ, -, hs, rfl⟩)
  · rw [Ideal.mem_bot] at hs
    rw [hs, x_zero]
    exact one_mem _
  · rw [Ideal.mem_bot] at hs
    rw [hs, zElt_zero_left]
    exact one_mem _

#audit_axioms thm44_bot

/-- **Cor 4.10 over a field**: `𝔪 = 0`, and both sides are trivial. -/
theorem cor410_field {K : Type} [Field K] (i₀ j₀ : I) (h₀ : i₀ ≠ j₀) :
    polyKer I (IsLocalRing.maximalIdeal K) =
      relKer I (xPolyIdeal (IsLocalRing.maximalIdeal K)) ⊔
        Subgroup.closure {g | ∃ (m : K) (η : Polynomial K),
          m ∈ IsLocalRing.maximalIdeal K ∧ cElt i₀ j₀ h₀ (C m) (X * η) = g} := by
  have hM : IsLocalRing.maximalIdeal K = ⊥ := IsLocalRing.maximalIdeal_eq_bot
  have hP : polyIdeal (IsLocalRing.maximalIdeal K) = ⊥ := by rw [hM, polyIdeal, Ideal.map_bot]
  have hXP : xPolyIdeal (IsLocalRing.maximalIdeal K) = ⊥ := by
    rw [xPolyIdeal, hP, Ideal.mul_bot]
  have hbot : relKer I (⊥ : Ideal (Polynomial K)) = ⊥ := by
    have := thm44_bot (I := I) (R := Polynomial K) (fun _ _ => True)
    rw [this, eq_bot_iff, zGen, Subgroup.closure_le]
    rintro _ (⟨i, j, hij, s, hs, rfl⟩ | ⟨i, j, hij, s, ξ, -, hs, rfl⟩)
    · rw [Ideal.mem_bot] at hs
      rw [hs, x_zero]
      exact one_mem _
    · rw [Ideal.mem_bot] at hs
      rw [hs, zElt_zero_left]
      exact one_mem _
  have hc : Subgroup.closure {g | ∃ (m : K) (η : Polynomial K),
      m ∈ IsLocalRing.maximalIdeal K ∧ cElt i₀ j₀ h₀ (C m) (X * η) = g} = ⊥ := by
    rw [eq_bot_iff, Subgroup.closure_le]
    rintro _ ⟨m, η, hm, rfl⟩
    rw [hM, Ideal.mem_bot] at hm
    rw [hm, map_zero, cElt_eq, x_zero, neg_zero, zElt_zero_left, one_mul]
    exact one_mem _
  rw [polyKer, hP, hbot, bot_inf_eq, hXP, hbot, hc, sup_bot_eq]

#audit_axioms cor410_field

end LSCore
end BooneHigmanLinear
end GroupApproximation
