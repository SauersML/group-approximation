import GroupApproximation.BooneHigmanLinear.LSCore.PLarge
import GroupApproximation.Meta.AxiomGuard

/-!
# `Z_α(A, M)` is stable under `x_β(b)` for `β ∈ Z(α)` (towards Lavrenov–Sinchuk, Lemma 5.15)

For `α = (i, j)`, `Z(α) = Z₀(α) ⊔ Z₊(α)` is the set of roots `β = (a, c)` with `a ≠ j`, `c ≠ i`
(`InZ`). `Z_α(A, M)` (`zAlpha`) is generated by `x_γ(m)`, `γ ∈ Z₊(α)`, and `z_γ(m, ζ)`,
`γ ∈ Z₀(α)`, with `m ∈ M`. L–S use without proof that it is stable under conjugation by
`x_β(b)`, `β ∈ Z(α)`, `b ∈ A` (proof of 5.15). Here (`cj_mem_zAlpha`, `|I| ≥ 5`):
* `x_γ(m)`: by (R2) and (R3); the new roots `β + γ` lie in `Z₊(α)`.
* `z_γ(m, ζ)`, `β ≠ γ`: by Lemma 4.1(1)–(4).
* `z_γ(m, ζ)`, `β = γ`: Lemma 4.1(5) through a fifth index `r ∉ {i, j, p, q}` writes `z_γ` as a
  product of elements of the previous kinds (`cj_zElt_self_mem`).
-/

namespace GroupApproximation
namespace BooneHigmanLinear
namespace LSCore

open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigmanLinear.RelGen (zElt)

variable {I : Type*} [Fintype I] [DecidableEq I] {A : Type*} [CommRing A] {M : Ideal A}
  {i j : I}

omit [DecidableEq I] in
theorem exists_ne4 (h5 : 5 ≤ Fintype.card I) (a b c d : I) :
    ∃ r, r ≠ a ∧ r ≠ b ∧ r ≠ c ∧ r ≠ d := by
  classical
  have hc : 0 < (Finset.univ \ ({a, b, c, d} : Finset I)).card := by
    have h1 := Finset.le_card_sdiff ({a, b, c, d} : Finset I) Finset.univ
    have h2 : ({a, b, c, d} : Finset I).card ≤ 4 := Finset.card_le_four
    rw [Finset.card_univ] at h1
    omega
  obtain ⟨r, hr⟩ := Finset.card_pos.mp hc
  simp only [Finset.mem_sdiff, Finset.mem_univ, true_and, Finset.mem_insert,
    Finset.mem_singleton, not_or] at hr
  exact ⟨r, hr.1, hr.2.1, hr.2.2.1, hr.2.2.2⟩

/-- `β = (a, c) ∈ Z(α)`: `a ≠ j` and `c ≠ i`. -/
def InZ (i j a c : I) : Prop := a ≠ j ∧ c ≠ i

theorem cj_x_eq_z {p q : I} (hpq : p ≠ q) (f ξ : A) :
    cj (x q p hpq.symm ξ) (x p q hpq f) = zElt p q hpq f ξ := by
  rw [cj, zElt, x_neg]

theorem zA_z {p q : I} (hpq : p ≠ q) (hO : Orth i j p q) {m : A} (hm : m ∈ M) (ζ : A) :
    zElt p q hpq m ζ ∈ zAlpha M i j :=
  Subgroup.subset_closure (Or.inr ⟨p, q, hpq, m, ζ, hm, hO, rfl⟩)

/-- `x_β(m) ∈ Z_α(A, M)` for `β ∈ Z(α)` and `m ∈ M`. -/
theorem zA_x (hij : i ≠ j) {p q : I} (hpq : p ≠ q) (hZ : InZ i j p q) {m : A} (hm : m ∈ M) :
    x p q hpq m ∈ zAlpha M i j := by
  by_cases h : p = i ∨ q = j
  · refine Subgroup.subset_closure (Or.inl ⟨p, q, hpq, m, hm, ?_, rfl⟩)
    by_cases hp : p = i
    · by_cases hq : q = j
      · exact Or.inl ⟨hp, hq⟩
      · exact Or.inr (Or.inl ⟨hp, hq⟩)
    · have hq : q = j := h.resolve_left hp
      exact Or.inr (Or.inr ⟨hq, hp⟩)
  · simp only [not_or] at h
    have := zA_z hpq ⟨h.1, hZ.1, hZ.2, h.2⟩ hm 0
    rwa [zElt_zero_right'] at this

theorem mem_M_mul {m : A} (hm : m ∈ M) (a : A) : a * m ∈ M := Ideal.mul_mem_left _ a hm

/-- Conjugating the generator `x_γ(m)`, `γ ∈ Z₊(α)`, by `x_β(η)`, `β ∈ Z(α)`. -/
theorem cj_x_mem (hij : i ≠ j) {a c : I} (hac : a ≠ c) (hZ : InZ i j a c) (η : A) {p q : I}
    (hpq : p ≠ q) (hγ : (p = i ∧ q = j) ∨ Acute i j p q) {m : A} (hm : m ∈ M) :
    cj (x a c hac η) (x p q hpq m) ∈ zAlpha M i j := by
  have hγZ : InZ i j p q := by
    rcases hγ with ⟨rfl, rfl⟩ | ⟨rfl, hq⟩ | ⟨rfl, hp⟩
    · exact ⟨hij, hij.symm⟩
    · exact ⟨hij, fun h => hpq h.symm⟩
    · exact ⟨hpq, hij.symm⟩
  have hw : x p q hpq m ∈ zAlpha M i j := zA_x hij hpq hγZ hm
  by_cases hap : a = p
  · by_cases hcq : c = q
    · subst hap hcq
      rw [cj_of_commute (x_commute_self hac _ _)]
      exact hw
    · subst hap
      rw [cj_of_commute (x_commute_of_ne a c a q hac hpq hac.symm hpq.symm _ _)]
      exact hw
  · by_cases haq : a = q
    · subst haq
      by_cases hcp : c = p
      · subst hcp
        exfalso
        rcases hγ with ⟨h1, -⟩ | ⟨h1, -⟩ | ⟨h1, -⟩
        · exact hZ.2 h1
        · exact hZ.2 h1
        · exact hZ.1 h1
      · rw [cj_x_left hpq hac (fun h => hcp h.symm)]
        exact mul_mem (zA_x hij (fun h => hcp h.symm) ⟨hγZ.1, hZ.2⟩ (Ideal.mul_mem_right _ _ hm))
          hw
    · by_cases hcp : c = p
      · subst hcp
        rw [cj_x_right hac hpq haq]
        exact mul_mem (zA_x hij haq ⟨hZ.1, hγZ.2⟩ (neg_mem (mem_M_mul hm _))) hw
      · by_cases hcq : c = q
        · subst hcq
          rw [cj_of_commute (x_commute_of_ne a c p c hac hpq (fun h => hcp h) (fun h => haq h.symm)
            _ _)]
          exact hw
        · rw [cj_of_commute (x_commute_of_ne a c p q hac hpq hcp (fun h => haq h.symm) _ _)]
          exact hw

#audit_axioms cj_x_mem

/-- The hard case: conjugating `z_γ(m, ζ)`, `γ = (p, q) ∈ Z₀(α)`, by `x_γ(η)`. -/
theorem cj_zElt_self_mem (h5 : 5 ≤ Fintype.card I) (hij : i ≠ j) {p q : I} (hpq : p ≠ q)
    (hO : Orth i j p q) {m : A} (hm : m ∈ M) (ζ η : A) :
    cj (x p q hpq η) (zElt p q hpq m ζ) ∈ zAlpha M i j := by
  obtain ⟨r, hri, hrj, hrp, hrq⟩ := exists_ne4 h5 i j p q
  have hpr : p ≠ r := fun h => hrp h.symm
  have hqr : q ≠ r := fun h => hrq h.symm
  have hni : ∀ a ∈ ({p, q, r} : Set I), a ≠ i ∧ a ≠ j := by
    intro a ha
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha
    rcases ha with rfl | rfl | rfl
    · exact ⟨hO.1, hO.2.1⟩
    · exact ⟨hO.2.2.1, hO.2.2.2⟩
    · exact ⟨hri, hrj⟩
  have hZ : ∀ {a c : I}, a ∈ ({p, q, r} : Set I) → c ∈ ({p, q, r} : Set I) → InZ i j a c :=
    fun ha hc => ⟨(hni _ ha).2, (hni _ hc).1⟩
  have hO' : ∀ {a c : I}, a ∈ ({p, q, r} : Set I) → c ∈ ({p, q, r} : Set I) → Orth i j a c :=
    fun ha hc => ⟨(hni _ ha).1, (hni _ ha).2, (hni _ hc).1, (hni _ hc).2⟩
  have mp : p ∈ ({p, q, r} : Set I) := by simp
  have mq : q ∈ ({p, q, r} : Set I) := by simp
  have mr : r ∈ ({p, q, r} : Set I) := by simp
  have h := z_add_eq hpr hrq hpq m ζ 1
  simp only [mul_one, one_pow] at h
  rw [h]
  simp only [cj_mul]
  refine mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem (mul_mem ?_ ?_) ?_) ?_) ?_) ?_) ?_) ?_
  · rw [cj_of_commute (x_commute_of_ne p q p r hpq hpr hpq.symm hrp _ _)]
    exact zA_x hij hpr (hZ mp mr) hm
  · rw [cj_x_right hpq hqr hpr]
    exact mul_mem (zA_x hij hpr (hZ mp mr) (neg_mem (mem_M_mul (neg_mem (Ideal.mul_mem_right ζ _
      hm)) η))) (zA_x hij hqr (hZ mq mr) (neg_mem (Ideal.mul_mem_right ζ _ hm)))
  · rw [cj_of_commute (x_commute_of_ne p q r q hpq hrq hqr hpq.symm _ _)]
    exact zA_x hij hrq (hZ mr mq) (Ideal.mul_mem_right ζ _ hm)
  · rw [cj_of_commute (x_commute_self hpq _ _)]
    exact zA_x hij hpq (hZ mp mq) hm
  · rw [z_conj_acute_row hpq hpr hrq]
    exact mul_mem (mul_mem (zA_x hij hpq (hZ mp mq) (Ideal.mul_mem_right η _
      (Ideal.mul_mem_right _ _ (neg_mem hm))))
      (zA_x hij hrq (hZ mr mq) (neg_mem (Ideal.mul_mem_right η _ (Ideal.mul_mem_right _ _
        (neg_mem hm)))))) (zA_z hpr (hO' mp mr) (neg_mem hm) _)
  · rw [cj_x_left hrp hpq hrq]
    exact mul_mem (zA_x hij hrq (hZ mr mq) (Ideal.mul_mem_right η _ (neg_mem
      (Ideal.mul_mem_right _ _ hm)))) (zA_x hij hrp (hZ mr mp) (neg_mem (Ideal.mul_mem_right _ _
      hm)))
  · rw [cj_x_eq_z hpq.symm]
    exact zA_z hpq.symm (hO' mq mp) (neg_mem (Ideal.mul_mem_right _ _ hm)) η
  · rw [z_conj_obtuse_row hpq hqr hpr]
    exact mul_mem (mul_mem (zA_x hij hpq (hZ mp mq) (neg_mem (Ideal.mul_mem_right η _
      (Ideal.mul_mem_right _ _ (Ideal.mul_mem_right ζ _ hm)))))
      (zA_x hij hpr (hZ mp mr) (neg_mem (Ideal.mul_mem_right η _ (Ideal.mul_mem_right ζ _ hm)))))
      (zA_z hqr (hO' mq mr) (Ideal.mul_mem_right ζ _ hm) _)

#audit_axioms cj_zElt_self_mem

/-- Conjugating the generator `z_γ(m, ζ)`, `γ ∈ Z₀(α)`, by `x_β(η)`, `β ∈ Z(α)`. -/
theorem cj_z_mem (h5 : 5 ≤ Fintype.card I) (hij : i ≠ j) {a c : I} (hac : a ≠ c)
    (hZ : InZ i j a c) (η : A) {p q : I} (hpq : p ≠ q) (hO : Orth i j p q) {m : A}
    (hm : m ∈ M) (ζ : A) : cj (x a c hac η) (zElt p q hpq m ζ) ∈ zAlpha M i j := by
  have hw : zElt p q hpq m ζ ∈ zAlpha M i j := zA_z hpq hO hm ζ
  by_cases hap : a = p
  · subst hap
    by_cases hcq : c = q
    · subst hcq
      exact cj_zElt_self_mem h5 hij hac hO hm ζ η
    · -- `β = (a, c)`, `γ = (a, q)`: Lemma 4.1(3)
      rw [z_conj_acute_row hac hpq (fun h => hcq h.symm)]
      exact mul_mem (mul_mem (zA_x hij hac hZ (Ideal.mul_mem_right η _ (Ideal.mul_mem_right ζ _
        hm))) (zA_x hij (fun h => hcq h.symm) ⟨hO.2.2.2, hZ.2⟩ (neg_mem (Ideal.mul_mem_right η _
        (Ideal.mul_mem_right _ _ hm))))) hw
  · by_cases haq : a = q
    · subst haq
      by_cases hcp : c = p
      · subst hcp
        rw [z_conj_neg]
        exact zA_z hpq hO hm _
      · -- `β = (a, c)`, `γ = (p, a)`: Lemma 4.1(2)
        rw [z_conj_obtuse_col hac hpq (fun h => hcp h.symm)]
        exact mul_mem (mul_mem (zA_x hij hac hZ (neg_mem (Ideal.mul_mem_right η _
          (Ideal.mul_mem_right ζ _ hm)))) (zA_x hij (fun h => hcp h.symm) ⟨hO.2.1, hZ.2⟩
          (Ideal.mul_mem_right η _ hm))) hw
    · by_cases hcp : c = p
      · subst hcp
        -- `β = (a, c)`, `γ = (c, q)`: Lemma 4.1(2)
        rw [z_conj_obtuse_row hac hpq haq]
        exact mul_mem (mul_mem (zA_x hij hac hZ (neg_mem (Ideal.mul_mem_right η _
          (Ideal.mul_mem_right ζ _ hm)))) (zA_x hij haq ⟨hZ.1, hO.2.2.1⟩
          (neg_mem (Ideal.mul_mem_right η _ hm)))) hw
      · by_cases hcq : c = q
        · subst hcq
          -- `β = (a, c)`, `γ = (p, c)`: Lemma 4.1(3)
          rw [z_conj_acute_col hac (fun h => hap h) hpq]
          exact mul_mem (mul_mem (zA_x hij hac hZ (Ideal.mul_mem_right η _
            (Ideal.mul_mem_right ζ _ hm))) (zA_x hij (fun h => hap h) ⟨hZ.1, hO.1⟩
            (Ideal.mul_mem_right η _ (Ideal.mul_mem_right _ _ hm)))) hw
        · rw [z_conj_disj hpq hac hap haq (fun h => hcp h) (fun h => hcq h)]
          exact hw

#audit_axioms cj_z_mem

/-- **`Z_α(A, M)` is stable under conjugation by `x_β(η)`, `β ∈ Z(α)`** (`|I| ≥ 5`). -/
theorem cj_mem_zAlpha (h5 : 5 ≤ Fintype.card I) (hij : i ≠ j) {a c : I} (hac : a ≠ c)
    (hZ : InZ i j a c) (η : A) {w : SteinbergGroup I A} (hw : w ∈ zAlpha M i j) :
    cj (x a c hac η) w ∈ zAlpha M i j := by
  unfold zAlpha at hw
  induction hw using Subgroup.closure_induction with
  | mem w hw =>
    rcases hw with ⟨p, q, hpq, m, hm, hγ, rfl⟩ | ⟨p, q, hpq, m, ζ, hm, hO, rfl⟩
    · exact cj_x_mem hij hac hZ η hpq hγ hm
    · exact cj_z_mem h5 hij hac hZ η hpq hO hm ζ
  | one =>
    rw [cj, mul_one, inv_mul_cancel]
    exact one_mem _
  | mul w w' _ _ hw hw' =>
    rw [cj_mul]
    exact mul_mem hw hw'
  | inv w _ hw =>
    rw [show cj (x a c hac η) w⁻¹ = (cj (x a c hac η) w)⁻¹ by
      unfold cj
      group]
    exact inv_mem hw

#audit_axioms cj_mem_zAlpha

