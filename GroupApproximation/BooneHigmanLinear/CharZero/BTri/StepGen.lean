import GroupApproximation.BooneHigmanLinear.CharZero.BTri.Action
import GroupApproximation.Meta.AxiomGuard

/-!
# `St₃(A[1/p])` is generated by three diagonal twists of `St₃(A)` (Z1-base, piece Z.6, part 1)

Let `B = A[1/p]`, `ι : A → B`, and `δᵢ = dgHom (dvec i)` the diagonal automorphisms of `St₃(B)`
for the standard chamber: `dvec 0 = 1`, `dvec 1 = (1, 1, p)`, `dvec 2 = (1, p, p)`
(`BTri/Diagonal.lean`). Then `St₃(B)` is generated by the three subgroups `δᵢ(ι(St₃(A)))`
(`twist_closure_eq_top`).

Proof. `δ₁` and `δ₂` produce `x₀₁(1/p)`, `x₀₂(1/p)` and `x₁₂(1/p)`. Commutators with `x_{kl}(1)`
give the three lower ones. Then `x_{kl}(a/pⁿ⁺¹) = ⁅x_{kj}(1/p), x_{jl}(a/pⁿ)⁆`, by induction on
`n`, and every element of `B` is some `a/pⁿ`.

In the colimit argument (piece Z.6, part 3) this identifies the extended homomorphism on
generators.
-/

namespace GroupApproximation
namespace BooneHigmanLinear
namespace BTri

open scoped commutatorElement
open GroupApproximation.SteinbergGroup

section Twist

variable (A : Type*) [CommRing A] (p : A)

/-- The diagonal vectors of the standard chamber: `1`, `(1, 1, p)` and `(1, p, p)`. -/
noncomputable def dvec : Fin 3 → Fin 3 → (Localization.Away p)ˣ :=
  ![1, ![1, 1, pUnit A p], ![1, pUnit A p, pUnit A p]]

/-- The three diagonal twists `δᵢ` of `St₃(A[1/p])`. -/
noncomputable def twist (i : Fin 3) :
    SteinbergGroup (Fin 3) (Localization.Away p) →* SteinbergGroup (Fin 3) (Localization.Away p) :=
  dgHom (dvec A p i)

/-- The subgroup generated by the three twisted images of `St₃(A)`. -/
noncomputable def twistSpan : Subgroup (SteinbergGroup (Fin 3) (Localization.Away p)) :=
  Subgroup.closure (⋃ i : Fin 3, twist A p i '' Set.range
    (ringMap (I := Fin 3) (algebraMap A (Localization.Away p))))

variable {A p}

theorem twist_ringMap_mem (i : Fin 3) (u : SteinbergGroup (Fin 3) A) :
    twist A p i (ringMap (algebraMap A (Localization.Away p)) u) ∈ twistSpan A p :=
  Subgroup.subset_closure (Set.mem_iUnion.mpr ⟨i, ringMap _ u, ⟨u, rfl⟩, rfl⟩)

#audit_axioms twist_ringMap_mem

theorem twist_x (i : Fin 3) (k l : Fin 3) (hkl : k ≠ l) (a : Localization.Away p) :
    twist A p i (x k l hkl a) = x k l hkl (dgCoeff (dvec A p i) k l a) :=
  dgHom_x _ k l hkl a

theorem x_algebraMap_mem (k l : Fin 3) (hkl : k ≠ l) (a : A) :
    x k l hkl (algebraMap A (Localization.Away p) a) ∈ twistSpan A p := by
  have h := twist_ringMap_mem (p := p) 0 (x k l hkl a)
  rwa [ringMap_x, twist_x, show dvec A p 0 = 1 from rfl, dgCoeff_one] at h

#audit_axioms x_algebraMap_mem

theorem x_one_mem (k l : Fin 3) (hkl : k ≠ l) :
    x k l hkl (1 : Localization.Away p) ∈ twistSpan A p := by
  simpa using x_algebraMap_mem (p := p) k l hkl 1

#audit_axioms x_one_mem

/-- The upper roots with coefficient `1/p` come from `δ₁` and `δ₂`. -/
theorem x_invp_mem_of_twist (i k l : Fin 3) (hkl : k ≠ l)
    (hd : dgCoeff (dvec A p i) k l 1 = ((pUnit A p)⁻¹ : (Localization.Away p)ˣ)) :
    x k l hkl (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈ twistSpan A p := by
  have h := twist_ringMap_mem (p := p) i (x k l hkl 1)
  rwa [ringMap_x, map_one, twist_x, hd] at h

#audit_axioms x_invp_mem_of_twist

theorem commutator_mem {S : Subgroup (SteinbergGroup (Fin 3) (Localization.Away p))} {a b}
    (ha : a ∈ S) (hb : b ∈ S) : ⁅a, b⁆ ∈ S := by
  rw [commutatorElement_def]
  exact S.mul_mem (S.mul_mem (S.mul_mem ha hb) (S.inv_mem ha)) (S.inv_mem hb)

#audit_axioms commutator_mem

/-- **All six roots with coefficient `1/p` lie in the twisted span.** -/
theorem x_invp_mem (k l : Fin 3) (hkl : k ≠ l) :
    x k l hkl (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈ twistSpan A p := by
  have h01 : x 0 1 (by decide) (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈
      twistSpan A p := x_invp_mem_of_twist 2 0 1 (by decide) (by simp [dgCoeff, dvec])
  have h02 : x 0 2 (by decide) (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈
      twistSpan A p := x_invp_mem_of_twist 1 0 2 (by decide) (by simp [dgCoeff, dvec])
  have h12 : x 1 2 (by decide) (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈
      twistSpan A p := x_invp_mem_of_twist 1 1 2 (by decide) (by simp [dgCoeff, dvec])
  have h10 : x 1 0 (by decide) (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈
      twistSpan A p := by
    have h := commutator_mem h12 (x_one_mem (p := p) 2 0 (by decide))
    rwa [x_commutator 1 2 0 (by decide) (by decide) (by decide), mul_one] at h
  have h21 : x 2 1 (by decide) (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈
      twistSpan A p := by
    have h := commutator_mem (x_one_mem (p := p) 2 0 (by decide)) h01
    rwa [x_commutator 2 0 1 (by decide) (by decide) (by decide), one_mul] at h
  have h20 : x 2 0 (by decide) (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ∈
      twistSpan A p := by
    have h := commutator_mem h21 (x_one_mem (p := p) 1 0 (by decide))
    rwa [x_commutator 2 1 0 (by decide) (by decide) (by decide), mul_one] at h
  fin_cases k <;> fin_cases l
  all_goals first
    | exact absurd rfl hkl
    | exact h01 | exact h02 | exact h12 | exact h10 | exact h21 | exact h20

#audit_axioms x_invp_mem

/-- A third index. -/
theorem exists_third (k l : Fin 3) (hkl : k ≠ l) : ∃ j : Fin 3, k ≠ j ∧ j ≠ l := by
  revert k l
  decide

#audit_axioms exists_third

/-- `x_{kl}(a/pⁿ)` lies in the twisted span, by induction on `n`. -/
theorem x_div_pow_mem (n : ℕ) : ∀ (k l : Fin 3) (hkl : k ≠ l) (a : A),
    x k l hkl (algebraMap A (Localization.Away p) a *
      (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ^ n) ∈ twistSpan A p := by
  induction n with
  | zero =>
      intro k l hkl a
      rw [pow_zero, mul_one]
      exact x_algebraMap_mem k l hkl a
  | succ n ih =>
      intro k l hkl a
      obtain ⟨j, hkj, hjl⟩ := exists_third k l hkl
      have h := commutator_mem (x_invp_mem (p := p) k j hkj) (ih j l hjl a)
      rw [x_commutator k j l hkj hjl hkl] at h
      convert h using 2
      ring

#audit_axioms x_div_pow_mem

/-- **The three twists of `St₃(A)` generate `St₃(A[1/p])`.** -/
theorem twist_closure_eq_top : twistSpan A p = ⊤ := by
  refine eq_top_iff.mpr fun g _ => PresentedGroup.generated_by _ (twistSpan A p) ?_ g
  rintro ⟨k, l, hkl, b⟩
  obtain ⟨n, a, hb⟩ := IsLocalization.Away.surj p b
  have hbe : b = algebraMap A (Localization.Away p) a *
      (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) ^ n := by
    have hu : ((pUnit A p : (Localization.Away p)ˣ) : Localization.Away p) =
        algebraMap A (Localization.Away p) p := IsUnit.unit_spec _
    rw [← hb, ← hu, mul_assoc, ← mul_pow, Units.mul_inv, one_pow, mul_one]
  change x k l hkl b ∈ twistSpan A p
  rw [hbe]
  exact x_div_pow_mem n k l hkl a

#audit_axioms twist_closure_eq_top

end Twist

end BTri
end BooneHigmanLinear
end GroupApproximation
