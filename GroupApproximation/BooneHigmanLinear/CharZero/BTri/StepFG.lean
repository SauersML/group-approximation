import GroupApproximation.BooneHigmanLinear.CharZero.BTri.StepMain
import GroupApproximation.BooneHigmanLinear.CharZero.BTri.DomainVertex
import Mathlib.GroupTheory.Schreier
import GroupApproximation.Meta.AxiomGuard

/-!
# The edge groups are finitely generated (Z1-base, piece Z.6, part 4)

Let `emb i : SL₃(A) →* SL₃(B)` be `γ ↦ Dᵢ ι(γ) Dᵢ⁻¹`. Its image is the vertex stabilizer `Pᵢ`.
Let `r : A →+* F` be a ring map to a finite ring whose kernel is `pA` (for `A = ℤ[1/m]`, this is
reduction to `F_p`). Then:

* the congruence kernel `Γ = ker (SL₃(A) → SL₃(F))` has finite index;
* `emb i` maps `Γ` into `Pᵢ ∩ Pⱼ` for all `i, j`, since conjugating by `Dⱼ⁻¹ Dᵢ` changes the
  off-diagonal entries by `p^{-1}`, `1` or `p` only (`emb_entry`, `stdExp_cross`);
* so `emb i⁻¹(Pᵢ ∩ Pⱼ)` has finite index in `SL₃(A)`. If `SL₃(A)` is finitely generated, it is
  finitely generated by Schreier's lemma, and so is its image `Pᵢ ∩ Pⱼ` (`edge_fg`).
-/

namespace GroupApproximation
namespace BooneHigmanLinear
namespace BTri

open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.BooneHigman.Metabelian
open Matrix

section FG

variable {A : Type*} [CommRing A] {p : A}

/-- `γ ↦ Dᵢ ι(γ) Dᵢ⁻¹`. -/
noncomputable def emb (i : Fin 3) : SL3 A →* SL3 (Localization.Away p) :=
  (slConj (stdMat A p i)⁻¹).comp
    (Matrix.SpecialLinearGroup.map (algebraMap A (Localization.Away p)))

theorem dvec_eq_pow (i k : Fin 3) : dvec A p i k = pUnit A p ^ stdExp i k := by
  fin_cases i <;> fin_cases k <;> simp [dvec, stdExp]

#audit_axioms dvec_eq_pow

theorem coe_stdMat_eq (i : Fin 3) :
    ((stdMat A p i : GL (Fin 3) (Localization.Away p)) : Matrix (Fin 3) (Fin 3) _) =
      diagonal fun k => ((dvec A p i k : (Localization.Away p)ˣ) : Localization.Away p) := by
  rw [← dgUnit_dvec]
  rfl

#audit_axioms coe_stdMat_eq

theorem coe_stdMat_inv_eq (i : Fin 3) :
    (((stdMat A p i)⁻¹ : GL (Fin 3) (Localization.Away p)) : Matrix (Fin 3) (Fin 3) _) =
      diagonal fun k => (((dvec A p i k)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) := by
  rw [← dgUnit_dvec]
  rfl

#audit_axioms coe_stdMat_inv_eq

/-- The entries of `Dⱼ⁻¹ Dᵢ ι(γ) Dᵢ⁻¹ Dⱼ`. -/
theorem emb_entry (i j : Fin 3) (γ : SL3 A) (k l : Fin 3) :
    ((slConj (stdMat A p j) (emb i γ) : SL3 _) :
      Matrix (Fin 3) (Fin 3) (Localization.Away p)) k l =
      (((dvec A p j k)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) *
        (dvec A p i k : Localization.Away p) *
        algebraMap A (Localization.Away p) ((γ : Matrix (Fin 3) (Fin 3) A) k l) *
        (((dvec A p i l)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) *
        (dvec A p j l : Localization.Away p) := by
  change ((((stdMat A p j)⁻¹ : GL (Fin 3) (Localization.Away p)) : Matrix (Fin 3) (Fin 3) _) *
      ((((stdMat A p i)⁻¹)⁻¹ : GL (Fin 3) (Localization.Away p)) *
        (γ : Matrix (Fin 3) (Fin 3) A).map (algebraMap A (Localization.Away p)) *
        (((stdMat A p i)⁻¹ : GL (Fin 3) (Localization.Away p)) : Matrix (Fin 3) (Fin 3) _)) *
      ((stdMat A p j : GL (Fin 3) (Localization.Away p)) : Matrix (Fin 3) (Fin 3) _)) k l = _
  rw [inv_inv, coe_stdMat_eq, coe_stdMat_eq, coe_stdMat_inv_eq, coe_stdMat_inv_eq]
  simp only [Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.map_apply]
  ring

#audit_axioms emb_entry

/-- The exponents of the standard chamber are nested. -/
theorem stdExp_cross : ∀ i j k l : Fin 3,
    stdExp j k + stdExp i l ≤ stdExp i k + stdExp j l + 1 := by
  decide

#audit_axioms stdExp_cross

theorem pow_mul_pow_of_mul_eq_one {R : Type*} [CommRing R] {π π' : R} (h : π * π' = 1)
    {a b : ℕ} (hab : b ≤ a) : π ^ a * π' ^ b = π ^ (a - b) := by
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hab
  rw [Nat.add_sub_cancel_left, pow_add, mul_comm (π ^ b), mul_assoc, ← mul_pow, h, one_pow,
    mul_one]

#audit_axioms pow_mul_pow_of_mul_eq_one

variable (hstab0 : ∀ γ : SL3 (Localization.Away p), γ • stdVertex A p 0 = stdVertex A p 0 ↔
    ∀ k l, (γ : Matrix (Fin 3) (Fin 3) (Localization.Away p)) k l ∈
      Set.range (algebraMap A (Localization.Away p)))

include hstab0 in
/-- **Congruence elements lie in every stabilizer after `emb i`.** -/
theorem emb_mem_of_cong (γ : SL3 A)
    (hγ : ∀ k l, k ≠ l → ∃ y, (γ : Matrix (Fin 3) (Fin 3) A) k l = p * y) (i j : Fin 3) :
    emb i γ ∈ vstab (A := A) (p := p) j := by
  rw [mem_vstab_iff]
  refine (hstab0 _).mpr fun k l => ?_
  rw [emb_entry]
  have hpU : ((pUnit A p : (Localization.Away p)ˣ) : Localization.Away p) =
      algebraMap A (Localization.Away p) p := IsUnit.unit_spec _
  simp only [dvec_eq_pow, ← inv_pow, Units.val_pow_eq_pow_val, hpU]
  generalize hπ : algebraMap A (Localization.Away p) p = π
  generalize hπ' : (((pUnit A p)⁻¹ : (Localization.Away p)ˣ) : Localization.Away p) = π'
  have hππ' : π * π' = 1 := by rw [← hπ, ← hπ', ← hpU, Units.mul_inv]
  by_cases hkl : k = l
  · rw [hkl]
    refine ⟨(γ : Matrix (Fin 3) (Fin 3) A) l l, ?_⟩
    calc algebraMap A (Localization.Away p) ((γ : Matrix (Fin 3) (Fin 3) A) l l)
        = algebraMap A (Localization.Away p) ((γ : Matrix (Fin 3) (Fin 3) A) l l) *
            (π * π') ^ stdExp i l * (π * π') ^ stdExp j l := by
          rw [hππ', one_pow, one_pow, mul_one, mul_one]
      _ = _ := by ring
  · obtain ⟨y, hy⟩ := hγ k l hkl
    refine ⟨y * p ^ (stdExp i k + stdExp j l + 1 - (stdExp j k + stdExp i l)), ?_⟩
    rw [hy, map_mul, map_mul, map_pow, hπ]
    rw [← pow_mul_pow_of_mul_eq_one hππ' (stdExp_cross i j k l)]
    ring

#audit_axioms emb_mem_of_cong

variable (hinj : Function.Injective (algebraMap A (Localization.Away p)))

include hinj in
/-- `emb i` hits every element of `Pᵢ`. -/
theorem emb_toA (i : Fin 3) (g : vstab (A := A) (p := p) i) :
    emb i (toA hinj hstab0 (toStab0 i g)) = g := by
  have h : Matrix.SpecialLinearGroup.map (algebraMap A (Localization.Away p))
      (toA hinj hstab0 (toStab0 i g)) = slConj (stdMat A p i) g :=
    Subtype.ext (map_toA hinj hstab0 (toStab0 i g))
  change slConj (stdMat A p i)⁻¹ (Matrix.SpecialLinearGroup.map
    (algebraMap A (Localization.Away p)) (toA hinj hstab0 (toStab0 i g))) = _
  rw [h]
  apply Matrix.SpecialLinearGroup.toGL_injective
  rw [toGL_slConj, toGL_slConj, inv_inv]
  simp only [mul_assoc, mul_inv_cancel, mul_one, mul_inv_cancel_left]

#audit_axioms emb_toA

variable {F : Type*} [CommRing F] [Finite F] (r : A →+* F)
  (hr : ∀ a : A, r a = 0 → ∃ y, a = p * y)

include hr in
/-- The congruence kernel is `≡ 1 mod p` off the diagonal. -/
theorem cong_of_mem_ker (γ : SL3 A) (hγ : γ ∈ (Matrix.SpecialLinearGroup.map r).ker) :
    ∀ k l, k ≠ l → ∃ y, (γ : Matrix (Fin 3) (Fin 3) A) k l = p * y := by
  intro k l hkl
  apply hr
  have h := congrArg (fun g : SL3 F => (g : Matrix (Fin 3) (Fin 3) F) k l)
    (MonoidHom.mem_ker.mp hγ)
  have h2 : r ((γ : Matrix (Fin 3) (Fin 3) A) k l) = (1 : Matrix (Fin 3) (Fin 3) F) k l := h
  rwa [Matrix.one_apply_ne hkl] at h2

#audit_axioms cong_of_mem_ker

include hinj hstab0 hr in
/-- **The edge groups are finitely generated.** -/
theorem edge_fg [Group.FG (SL3 A)] (i j : Fin 3) :
    Group.FG (vstab (A := A) (p := p) i ⊓ vstab (A := A) (p := p) j : Subgroup _) := by
  have hle : (Matrix.SpecialLinearGroup.map (n := Fin 3) r).ker ≤
      (vstab (A := A) (p := p) i ⊓ vstab (A := A) (p := p) j).comap (emb i) := fun γ hγ =>
    Subgroup.mem_comap.mpr (Subgroup.mem_inf.mpr
      ⟨emb_mem_of_cong hstab0 γ (cong_of_mem_ker r hr γ hγ) i i,
        emb_mem_of_cong hstab0 γ (cong_of_mem_ker r hr γ hγ) i j⟩)
  haveI := Subgroup.finiteIndex_of_le hle
  refine Group.fg_of_surjective
    (f := (emb i).subgroupComap (vstab (A := A) (p := p) i ⊓ vstab (A := A) (p := p) j)) ?_
  rintro ⟨g, hg⟩
  have hgi : g ∈ vstab (A := A) (p := p) i := (Subgroup.mem_inf.mp hg).1
  have he := emb_toA hstab0 hinj i ⟨g, hgi⟩
  have hmem : toA hinj hstab0 (toStab0 i ⟨g, hgi⟩) ∈
      (vstab (A := A) (p := p) i ⊓ vstab (A := A) (p := p) j).comap (emb i) := by
    rw [Subgroup.mem_comap, he]
    exact hg
  exact ⟨⟨_, hmem⟩, Subtype.ext he⟩

#audit_axioms edge_fg

variable (hSL : Absorption.SpecialLinearInElementary A 3)

include hSL in
/-- `SL₃(A)` is finitely generated when `St₃(A)` is and `SL₃(A) = E₃(A)`. -/
theorem sl3_fg [Group.FG (SteinbergGroup (Fin 3) A)] : Group.FG (SL3 A) := by
  refine Group.fg_of_surjective (f := (elemToSL (R := A)).comp projection) ?_
  intro γ
  obtain ⟨u, hu⟩ := projection_surjective (I := Fin 3) (R := A)
    ⟨Matrix.SpecialLinearGroup.toGL γ, hSL _ γ.2⟩
  refine ⟨u, ?_⟩
  rw [MonoidHom.comp_apply, hu]
  exact Subtype.ext rfl

#audit_axioms sl3_fg

end FG

end BTri
end BooneHigmanLinear
end GroupApproximation
