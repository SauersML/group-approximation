import GroupApproximation.BooneHigmanLinear.CharZero.K2Found.TulElemLocal
import Mathlib.Algebra.Module.BigOperators
import Mathlib.Algebra.BigOperators.Pi
import Mathlib.Data.Fintype.BigOperators
import Mathlib.GroupTheory.Subgroup.Centralizer
import GroupApproximation.Meta.AxiomGuard

/-!
# The commutative group of the elements `X(v, x)`, and canonical pieces (towards `X_{v,w}(a)`)

M. S. Tulenbaev, *The Steinberg group of a polynomial ring*, §1, before Lemma 1.2.
* `tx hX v x`: Tulenbaev's `X(v, x)` at some zero of `x`. By `ex_indep` it does not matter which
  zero (`tx_eq`).
* `Cv hX v`: the subgroup generated by the `X(v, x)`, `x ⊥ v` with two zeros. Under
  `IsLocal hX` it is commutative (T 1.1(e), `ex_commute_gen`); the instance takes
  `[Fact (IsLocal hX)]`.
* `tx_sum` (T 1.1(b)): `X(v, ∑ y_j) = ∏ X(v, y_j)` when the `y_j` share a zero.
* `pc v w u p q = (w_p u_q) (v_q e_p - v_p e_q)`: the canonical pieces. They are orthogonal to
  `v`, supported on `{p, q}`, and `∑_p pc v w u p q = (u_q v_q) w` for `w ⊥ v` (`pc_sum_left`).
-/

namespace GroupApproximation
namespace BooneHigmanLinear
namespace K2Found
namespace TulElem

open Matrix
open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigmanLinear.K2Found.VdK (Elements)

variable {I A : Type*} [Fintype I] [DecidableEq I] [CommRing A] (hX : Elements I A)

/-- A row with two distinct zero coordinates. -/
def TwoZ (x : I → A) : Prop :=
  ∃ r s, r ≠ s ∧ x r = 0 ∧ x s = 0

omit [Fintype I] [DecidableEq I] in
theorem TwoZ.smul {x : I → A} (h : TwoZ x) (c : A) : TwoZ (c • x) := by
  obtain ⟨r, s, hrs, hr, hs⟩ := h
  exact ⟨r, s, hrs, by rw [Pi.smul_apply, hr, smul_zero], by rw [Pi.smul_apply, hs, smul_zero]⟩

open Classical in
/-- Tulenbaev's `X(v, x)`, taken at some zero of `x` (and `1` if `x` has no zero). -/
noncomputable def tx (v x : I → A) : SteinbergGroup I A :=
  if h : ∃ r, x r = 0 then ex hX h.choose v x else 1

theorem tx_eq {r : I} {v x : I → A} (hr : x r = 0) (hxv : x ⬝ᵥ v = 0) :
    tx hX v x = ex hX r v x := by
  have h : ∃ r, x r = 0 := ⟨r, hr⟩
  rw [tx, dif_pos h]
  show ex hX h.choose v x = ex hX r v x
  by_cases hc : h.choose = r
  · rw [hc]
  · exact ex_indep hX hc h.choose_spec hr hxv

#audit_axioms tx_eq

theorem tx_zero (v : I → A) : tx hX v 0 = 1 := by
  by_cases h : ∃ r, (0 : I → A) r = 0
  · obtain ⟨r, hr⟩ := h
    rw [tx_eq hX hr (zero_dotProduct v), ex_zero_right]
  · rw [tx, dif_neg h]

/-- T 1.1(b) for `tx`: additivity along a common zero `r`. -/
theorem tx_add {r : I} {v x y : I → A} (hx : x r = 0) (hy : y r = 0) (hxv : x ⬝ᵥ v = 0)
    (hyv : y ⬝ᵥ v = 0) : tx hX v (x + y) = tx hX v x * tx hX v y := by
  rw [tx_eq hX (r := r) (by rw [Pi.add_apply, hx, hy, add_zero]) (add_dot hxv hyv),
    ex_add_right hX hx hy hxv hyv, ← tx_eq hX hx hxv, ← tx_eq hX hy hyv]

#audit_axioms tx_add

theorem tx_commute (hL : IsLocal hX) {v x v' x' : I → A} (hx : ∃ r, x r = 0) (hx' : TwoZ x')
    (h₁ : x ⬝ᵥ v = 0) (h₂ : x ⬝ᵥ v' = 0) (h₃ : x' ⬝ᵥ v = 0) (h₄ : x' ⬝ᵥ v' = 0) :
    Commute (tx hX v x) (tx hX v' x') := by
  obtain ⟨r, hr⟩ := hx
  obtain ⟨t, t', htt, ht, ht'⟩ := hx'
  rw [tx_eq hX hr h₁, tx_eq hX ht h₄]
  exact ex_commute_gen hX hL htt hr ht ht' h₁ h₂ h₃ h₄

/-- The generators `X(v, x)`, `x ⊥ v` with two zeros. -/
def Sv (v : I → A) : Set (SteinbergGroup I A) :=
  {g | ∃ x, x ⬝ᵥ v = 0 ∧ TwoZ x ∧ g = tx hX v x}

/-- The subgroup generated by `Sv v`. -/
abbrev Cv (v : I → A) : Subgroup (SteinbergGroup I A) :=
  Subgroup.closure (Sv hX v)

theorem Sv_comm (hL : IsLocal hX) (v : I → A) :
    ∀ a ∈ Sv hX v, ∀ b ∈ Sv hX v, a * b = b * a := by
  rintro _ ⟨x, hx, h2, rfl⟩ _ ⟨x', hx', h2', rfl⟩
  obtain ⟨r, -, -, hr, -⟩ := h2
  exact (tx_commute hX hL ⟨r, hr⟩ h2' hx hx hx' hx').eq

/-- Under `IsLocal`, `Cv v` is commutative (T 1.1(e)). -/
noncomputable instance cvCommGroup [hL : Fact (IsLocal hX)] (v : I → A) : CommGroup (Cv hX v) :=
  Subgroup.closureCommGroupOfComm (Sv_comm hX hL.out v)

/-- `X(v, x)` as an element of `Cv v`. -/
noncomputable def txc {v x : I → A} (hx : x ⬝ᵥ v = 0) (h2 : TwoZ x) : Cv hX v :=
  ⟨tx hX v x, Subgroup.subset_closure ⟨x, hx, h2, rfl⟩⟩

@[simp] theorem coe_txc {v x : I → A} (hx : x ⬝ᵥ v = 0) (h2 : TwoZ x) :
    (txc hX hx h2 : SteinbergGroup I A) = tx hX v x :=
  rfl

/-- **T 1.1(b)**: `X(v, ∑ y_j) = ∏ X(v, y_j)` when all `y_j` vanish at `r`. -/
theorem tx_sum [Fact (IsLocal hX)] {v : I → A} {ι : Type*} (s : Finset ι) (y : ι → I → A)
    {r : I} (hr : ∀ j, y j r = 0) (hv : ∀ j, y j ⬝ᵥ v = 0) (h2 : ∀ j, TwoZ (y j)) :
    tx hX v (∑ j ∈ s, y j) = ((∏ j ∈ s, txc hX (hv j) (h2 j) : Cv hX v) : SteinbergGroup I A) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [tx_zero]
  | insert a s ha ih =>
    have hS0 : (∑ j ∈ s, y j) r = 0 := by
      rw [Finset.sum_apply]
      exact Finset.sum_eq_zero fun j _ => hr j
    have hSv : (∑ j ∈ s, y j) ⬝ᵥ v = 0 := by
      rw [sum_dotProduct]
      exact Finset.sum_eq_zero fun j _ => hv j
    rw [Finset.sum_insert ha, Finset.prod_insert ha, Subgroup.coe_mul, ← ih,
      tx_add hX (hr a) hS0 (hv a) hSv, coe_txc]

#audit_axioms tx_sum

/-- The canonical pieces `(w_p u_q) (v_q e_p - v_p e_q)`. -/
def pc (v w u : I → A) (p q : I) : I → A :=
  (w p * u q) • (v q • Pi.single p 1 - v p • Pi.single q 1)

theorem pc_dot (v w u : I → A) (p q : I) : pc v w u p q ⬝ᵥ v = 0 := by
  rw [pc, smul_dotProduct, sub_dotProduct, smul_dotProduct, smul_dotProduct, single_one_dotProduct,
    single_one_dotProduct, smul_eq_mul, smul_eq_mul, smul_eq_mul]
  ring

omit [Fintype I] in
theorem pc_apply_of_ne (v w u : I → A) {p q l : I} (hp : l ≠ p) (hq : l ≠ q) :
    pc v w u p q l = 0 := by
  simp [pc, Pi.single_eq_of_ne hp, Pi.single_eq_of_ne hq]

omit [Fintype I] in
theorem pc_of_zero (v : I → A) {w : I → A} (u : I → A) {p : I} (h : w p = 0) (q : I) :
    pc v w u p q = 0 := by
  rw [pc, h, zero_mul, zero_smul]

/-- A zero `l ≠ q` of `w` is a zero of every piece `pc v w u p q`. -/
omit [Fintype I] in
theorem pc_zero_of (v : I → A) {w : I → A} (u : I → A) {l q : I} (hl : w l = 0) (hlq : l ≠ q)
    (p : I) : pc v w u p q l = 0 := by
  by_cases hp : l = p
  · subst hp
    rw [pc_of_zero v u hl q, Pi.zero_apply]
  · exact pc_apply_of_ne v w u hp hlq

theorem exists_two_ne (h4 : 4 ≤ Fintype.card I) (p q : I) :
    ∃ l m, l ≠ m ∧ l ≠ p ∧ l ≠ q ∧ m ≠ p ∧ m ≠ q := by
  have hc : 1 < (Finset.univ \ ({p, q} : Finset I)).card := by
    have h1 := Finset.le_card_sdiff ({p, q} : Finset I) Finset.univ
    have h2 : ({p, q} : Finset I).card ≤ 2 := Finset.card_le_two
    rw [Finset.card_univ] at h1
    omega
  obtain ⟨l, hl, m, hm, hlm⟩ := Finset.one_lt_card.mp hc
  simp only [Finset.mem_sdiff, Finset.mem_univ, true_and, Finset.mem_insert,
    Finset.mem_singleton, not_or] at hl hm
  exact ⟨l, m, hlm, hl.1, hl.2, hm.1, hm.2⟩

theorem pc_twoZ (h4 : 4 ≤ Fintype.card I) (v w u : I → A) (p q : I) : TwoZ (pc v w u p q) := by
  obtain ⟨l, m, hlm, hlp, hlq, hmp, hmq⟩ := exists_two_ne h4 p q
  exact ⟨l, m, hlm, pc_apply_of_ne v w u hlp hlq, pc_apply_of_ne v w u hmp hmq⟩

/-- `∑_p pc v w u p q = (u_q v_q) w` for `w ⊥ v`. -/
theorem pc_sum_left {v w : I → A} (u : I → A) (hw : w ⬝ᵥ v = 0) (q : I) :
    ∑ p, pc v w u p q = (u q * v q) • w := by
  have hw' : ∑ p, w p * v p = 0 := hw
  have e : ∀ p, pc v w u p q = (u q * v q) • (w p • Pi.single p (1 : A)) -
      (u q * (w p * v p)) • Pi.single q (1 : A) := by
    intro p
    rw [pc]
    module
  have e' : ∀ p, w p • Pi.single p (1 : A) = Pi.single p (w p) := by
    intro p
    rw [← Pi.single_smul', smul_eq_mul, mul_one]
  rw [Finset.sum_congr rfl fun p _ => e p, Finset.sum_sub_distrib, ← Finset.smul_sum,
    ← Finset.sum_smul, ← Finset.mul_sum, hw', mul_zero, zero_smul, sub_zero,
    Finset.sum_congr rfl fun p _ => e' p, Finset.univ_sum_single]

#audit_axioms pc_sum_left

omit [Fintype I] in
theorem pc_add (v w w' u : I → A) (p q : I) :
    pc v (w + w') u p q = pc v w u p q + pc v w' u p q := by
  rw [pc, pc, pc, Pi.add_apply, add_mul, add_smul]

omit [Fintype I] in
theorem pc_sum (v u : I → A) {ι : Type*} (s : Finset ι) (w : ι → I → A) (p q : I) :
    pc v (∑ k ∈ s, w k) u p q = ∑ k ∈ s, pc v (w k) u p q := by
  rw [pc, Finset.sum_apply, Finset.sum_mul, Finset.sum_smul]
  rfl

