import GroupApproximation.BooneHigmanLinear.RelGen.Defs
import GroupApproximation.Meta.AxiomGuard

/-!
# Lavrenov–Sinchuk §4 in type A: the statements of H.L3 (k2-poly)

Lane bh-pal-wire. These are the named statements that H.L3 proves and H.L4 (bh-pal-linear-char0,
LSCore) takes as hypotheses; each is exactly the form the proofs will have. The objects are those
of `RelGen.Defs`. The identities L–S Lemma 4.1 and 4.6 are H.L4's (`LSCore/ZC`), not stated here.

`ThirdIndex I` says that every pair of indices avoids a third (type A of rank `≥ 2`).

* `Thm42Statement` (Stein–Tits–Vaserstein, L–S 4.2): `St̄(R, J)` is generated by the `z_ij(s, ξ)`,
  `s ∈ J`, `ξ ∈ R`.
* `Thm44Statement` (Stepanov, L–S 4.4): for a parabolic root set `S` with nonempty special part
  `Σ_S`, `St̄(R, J) = 𝒵(Σ_S, R, J)`. In type A a parabolic set is a closed set containing `(i, j)`
  or `(j, i)` for every pair. Nonemptiness of `Σ_S` (that is, `S` is not all of `Φ`) is needed:
  `𝒵(∅, R, J) = St(Φ, J)` is not normal in general.
* `Split44Statement` (L–S (4.4)): every `g ∈ St̄(A[X], M[X])` is `C(g(0)) · k` with
  `g(0) ∈ St̄(A, M)` and `k ∈ K(A[X], M[X])`.
* `Thm48Statement` (Stein, L–S 4.8): over a local ring, `St̄(A, M) = U⁺(M) · H̄(A, M) · U⁻(M)` for
  a linear order on `I`.
* `Prop49Statement` (L–S 4.9) and `Cor410Statement` (L–S 4.10): over a local ring,
  `K(A[X], M[X])` is generated by `St̄(A[X], X·M[X])` and the `c_ij(m, X η)`, for all roots
  (4.9) or one fixed root (4.10).
-/

namespace GroupApproximation.BooneHigmanLinear.RelGen

open GroupApproximation.SteinbergGroup

/-- Every pair of indices avoids a third one. -/
def ThirdIndex (I : Type*) : Prop :=
  ∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.ThirdIndex

/-- **L–S Theorem 4.2 (Stein–Tits–Vaserstein).** -/
def Thm42Statement : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I], ThirdIndex I →
    ∀ (R : Type) [CommRing R] (J : Ideal R),
      relKer I J = Subgroup.closure (zSet I J fun _ _ => True)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.Thm42Statement

/-- A closed set of roots of type A: `(i, j), (j, k) ∈ S` and `i ≠ k` give `(i, k) ∈ S`. -/
def IsClosedRoots {I : Type*} (S : I → I → Prop) : Prop :=
  ∀ i j k : I, i ≠ k → S i j → S j k → S i k

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.IsClosedRoots

/-- A parabolic set of roots of type A: closed, and containing `(i, j)` or `(j, i)`. -/
def IsParabolicRoots {I : Type*} (S : I → I → Prop) : Prop :=
  IsClosedRoots S ∧ ∀ i j : I, i ≠ j → S i j ∨ S j i

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.IsParabolicRoots

/-- The special part `Σ_S = {α ∈ S | -α ∉ S}`. -/
def specialPart {I : Type*} (S : I → I → Prop) : I → I → Prop :=
  fun i j => S i j ∧ ¬ S j i

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.specialPart

/-- **L–S Theorem 4.4 (Stepanov)**, for parabolic `S` with nonempty special part. -/
def Thm44Statement : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I], ThirdIndex I →
    ∀ S : I → I → Prop, IsParabolicRoots S → (∃ i j : I, i ≠ j ∧ specialPart S i j) →
      ∀ (R : Type) [CommRing R] (J : Ideal R), relKer I J = zGen I J (specialPart S)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.Thm44Statement

/-- **L–S (4.4)**, the split `St̄(A[X], M[X]) = St̄(A, M) ⋉ K(A[X], M[X])`: every `g` is
`C(g(0)) · k` with `g(0) ∈ St̄(A, M)` and `k ∈ K(A[X], M[X])`. -/
def Split44Statement : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I] (A : Type) [CommRing A] (M : Ideal A),
    ∀ g ∈ relKer I (polyIdeal M),
      ringMap (Polynomial.evalRingHom 0 : Polynomial A →+* A) g ∈ relKer I M ∧
        (ringMap (Polynomial.C : A →+* Polynomial A)
            (ringMap (Polynomial.evalRingHom 0 : Polynomial A →+* A) g))⁻¹ * g ∈ polyKer I M

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.Split44Statement

/-- **L–S Theorem 4.8 (Stein).** Over a local ring, for a linear order on `I`,
`St̄(A, M) = U⁺(M) · H̄(A, M) · U⁻(M)`. -/
def Thm48Statement : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I] [LinearOrder I], ThirdIndex I →
    ∀ (A : Type) [CommRing A] [IsLocalRing A],
      ∀ g ∈ relKer I (IsLocalRing.maximalIdeal A),
        ∃ u ∈ rootGroup I (IsLocalRing.maximalIdeal A) (fun i j => i < j),
          ∃ t ∈ hBar I (IsLocalRing.maximalIdeal A),
            ∃ v ∈ rootGroup I (IsLocalRing.maximalIdeal A) (fun i j => j < i), g = u * t * v

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.Thm48Statement

/-- **L–S Proposition 4.9.** Over a local ring, `K(A[X], M[X])` is generated by
`St̄(A[X], X·M[X])` and the `c_ij(m, X ξ)`, `m ∈ M`, `ξ ∈ A[X]`, over all roots. -/
def Prop49Statement : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I], ThirdIndex I →
    ∀ (A : Type) [CommRing A] [IsLocalRing A],
      polyKer I (IsLocalRing.maximalIdeal A) =
        relKer I (xPolyIdeal (IsLocalRing.maximalIdeal A)) ⊔
          Subgroup.closure {g | ∃ (i j : I) (hij : i ≠ j) (m : A) (ξ : Polynomial A),
            m ∈ IsLocalRing.maximalIdeal A ∧
              cElt i j hij (Polynomial.C m) (Polynomial.X * ξ) = g}

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.Prop49Statement

/-- **L–S Corollary 4.10.** As `Prop49Statement`, with one fixed root `(i₀, j₀)`. -/
def Cor410Statement : Prop :=
  ∀ (I : Type) [Fintype I] [DecidableEq I], ThirdIndex I →
    ∀ (A : Type) [CommRing A] [IsLocalRing A] (i₀ j₀ : I) (h₀ : i₀ ≠ j₀),
      polyKer I (IsLocalRing.maximalIdeal A) =
        relKer I (xPolyIdeal (IsLocalRing.maximalIdeal A)) ⊔
          Subgroup.closure {g | ∃ (m : A) (η : Polynomial A),
            m ∈ IsLocalRing.maximalIdeal A ∧
              cElt i₀ j₀ h₀ (Polynomial.C m) (Polynomial.X * η) = g}

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.Cor410Statement

end GroupApproximation.BooneHigmanLinear.RelGen
