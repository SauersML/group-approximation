import GroupApproximation.BooneHigmanLinear.RelGen.TorusCalc
import GroupApproximation.Meta.AxiomGuard

/-!
# The torus meets `K₂` only in symbols

Lane bh-pal-wire, k2-poly H.L1 (ii). Over a commutative ring `R`, with a third index for every
pair, let `T_K` be generated by the `h_ab(u)` with `a, b ∈ K` and by all symbols
(`torusK I R K`). **`torus_faith`**: an element of `T_K` acting trivially on `R^I` is a product of
symbols.

The proof is induction on `K`. At a new index `L ∉ K`, with `m ∈ K`, every element of
`T_{K ∪ {L}}` is `t' h_mL(c)` with `t' ∈ T_K` (`torusK_insert_subset`). The generators are
absorbed as follows:
* `h_mL(u)` normalizes `T_K` (`hmL_conj_torusK`: it scales each root of `K`), and
  `h_mL(u) h_mL(c) = {c, u}⁻¹ h_mL(cu)`;
* `h_aL(u) = {-1, u}⁻¹ h_am(u) h_mL(u)` (`h_mul_h_third`), and `h_La(u) = {-1, u⁻¹} h_aL(u⁻¹)`
  (`h_swap`).
Then `T_K` fixes `e_L`, and `h_mL(c) e_L = c⁻¹ e_L`, so `c = 1`.
-/

namespace GroupApproximation.BooneHigmanLinear.RelGen

open GroupApproximation.SteinbergGroup
open GroupApproximation.SimpleKazhdanSofic.SkRows.SteinbergWeyl (h)
open GroupApproximation.BooneHigmanLinear.K2Poly (csym csym_commute)
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwo (act unitVec
  unitVec_apply act_mul act_one act_of_projection_eq_one)
open GroupApproximation.BooneHigman.SteinbergBasic (K2 mem_K2_iff)

variable (I : Type*) [Fintype I] [DecidableEq I] (R : Type*) [CommRing R]

/-- All Steinberg symbols `{u, v}_ij`. -/
def symSet : Set (SteinbergGroup I R) :=
  {g | ∃ (i j : I) (hij : i ≠ j) (u v : Rˣ), csym i j hij u v = g}

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.symSet

/-- The subgroup generated by all symbols. -/
def symGroup : Subgroup (SteinbergGroup I R) :=
  Subgroup.closure (symSet I R)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.symGroup

/-- The `h_ab(u)` with `a, b ∈ K`, and all symbols. -/
def torusSet (K : Finset I) : Set (SteinbergGroup I R) :=
  {g | ∃ (a b : I) (hab : a ≠ b) (u : Rˣ), (a ∈ K ∧ b ∈ K) ∧ h a b hab u = g} ∪ symSet I R

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.torusSet

/-- `T_K`. -/
def torusK (K : Finset I) : Subgroup (SteinbergGroup I R) :=
  Subgroup.closure (torusSet I R K)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.torusK

variable {I R}

theorem csym_mem_symGroup {i j : I} (hij : i ≠ j) (u v : Rˣ) :
    csym i j hij u v ∈ symGroup I R :=
  Subgroup.subset_closure ⟨i, j, hij, u, v, rfl⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.csym_mem_symGroup

theorem symGroup_le_K2 : symGroup I R ≤ K2 I R := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨i, j, hij, u, v, rfl⟩
  exact csym_mem_K2 i j hij u v

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.symGroup_le_K2

theorem act_of_mem_symGroup {z : SteinbergGroup I R} (hz : z ∈ symGroup I R) (y : I → R) :
    act z y = y :=
  act_of_projection_eq_one ((mem_K2_iff z).mp (symGroup_le_K2 hz)) y

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.act_of_mem_symGroup

theorem symGroup_le_torusK (K : Finset I) : symGroup I R ≤ torusK I R K :=
  Subgroup.closure_mono Set.subset_union_right

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.symGroup_le_torusK

theorem h_mem_torusK {K : Finset I} {a b : I} (hab : a ≠ b) (ha : a ∈ K) (hb : b ∈ K) (u : Rˣ) :
    h a b hab u ∈ torusK I R K :=
  Subgroup.subset_closure (Or.inl ⟨a, b, hab, u, ⟨ha, hb⟩, rfl⟩)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.h_mem_torusK

/-- If `g` sends each generator of `⟨S⟩` into `⟨S⟩`, it normalizes `⟨S⟩`. -/
theorem conj_closure_mem {G : Type*} [Group G] {S : Set G} {g : G}
    (hS : ∀ s ∈ S, g * s * g⁻¹ ∈ Subgroup.closure S) {y : G} (hy : y ∈ Subgroup.closure S) :
    g * y * g⁻¹ ∈ Subgroup.closure S := by
  induction hy using Subgroup.closure_induction with
  | mem y hy => exact hS y hy
  | one => simp only [mul_one, mul_inv_cancel, Subgroup.one_mem]
  | mul y₁ y₂ _ _ h₁ h₂ =>
    rw [show g * (y₁ * y₂) * g⁻¹ = (g * y₁ * g⁻¹) * (g * y₂ * g⁻¹) by group]
    exact Subgroup.mul_mem _ h₁ h₂
  | inv y _ h₁ =>
    rw [show g * y⁻¹ * g⁻¹ = (g * y * g⁻¹)⁻¹ by group]
    exact Subgroup.inv_mem _ h₁

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.conj_closure_mem

/-- `T_K` fixes `e_L` for `L ∉ K`. -/
theorem torusK_fix_L {K : Finset I} {L : I} (hLK : L ∉ K) {t : SteinbergGroup I R}
    (ht : t ∈ torusK I R K) : act t (unitVec L) = unitVec L := by
  rw [torusK] at ht
  induction ht using Subgroup.closure_induction with
  | mem y hy =>
    rcases hy with ⟨a, b, hab, u, ⟨ha, hb⟩, rfl⟩ | ⟨i, j, hij, u, v, rfl⟩
    · funext k
      rw [act_h_apply, unitVec_apply]
      by_cases hk : k = L
      · have hka : k ≠ a := fun e => hLK (by rw [← hk, e]; exact ha)
        have hkb : k ≠ b := fun e => hLK (by rw [← hk, e]; exact hb)
        rw [if_neg hka, if_neg hkb, if_pos hk, one_mul]
      · rw [if_neg hk, mul_zero]
    · exact act_of_mem_symGroup (csym_mem_symGroup hij u v) _
  | one => exact act_one _
  | mul y₁ y₂ _ _ h₁ h₂ => rw [act_mul, h₂, h₁]
  | inv y _ h₁ =>
    calc act y⁻¹ (unitVec L) = act y⁻¹ (act y (unitVec L)) := by rw [h₁]
      _ = unitVec L := by rw [← act_mul, inv_mul_cancel, act_one]

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.torusK_fix_L

/-- `h_mL(c) e_L = c⁻¹ e_L`. -/
theorem act_hmL_unitVec {m L : I} (hmL : m ≠ L) (c : Rˣ) :
    act (h m L hmL c) (unitVec L) = ((c⁻¹ : Rˣ) : R) • unitVec (R := R) L := by
  funext k
  rw [act_h_apply, Pi.smul_apply, smul_eq_mul, unitVec_apply]
  by_cases hk : k = L
  · rw [if_neg (fun e : k = m => hmL (e.symm.trans hk)), if_pos hk, if_pos hk]
  · rw [if_neg hk, if_neg hk, mul_zero, mul_zero]

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.act_hmL_unitVec

variable (third : ThirdIndex I)
include third

theorem symGroup_central {z : SteinbergGroup I R} (hz : z ∈ symGroup I R)
    (g : SteinbergGroup I R) : Commute z g := by
  have hle : symGroup I R ≤ Subgroup.center (SteinbergGroup I R) := by
    refine (Subgroup.closure_le _).mpr ?_
    rintro _ ⟨i, j, hij, u, v, rfl⟩
    exact Subgroup.mem_center_iff.mpr fun g => (csym_commute i j hij (third i j) u v g).eq.symm
  exact (Subgroup.mem_center_iff.mp (hle hz) g).symm

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.symGroup_central

/-- `h_mL(c)` sends each generator of `T_K` into `T_K`. -/
theorem hmL_conj_torusSet {K : Finset I} {m L : I} (hLK : L ∉ K) (hmL : m ≠ L) (c : Rˣ)
    {s : SteinbergGroup I R} (hs : s ∈ torusSet I R K) :
    h m L hmL c * s * (h m L hmL c)⁻¹ ∈ torusK I R K := by
  rcases hs with ⟨a, b, hab, u, ⟨ha, hb⟩, rfl⟩ | ⟨i, j, hij, u, v, rfl⟩
  · have haL : a ≠ L := fun e => hLK (by rw [← e]; exact ha)
    have hbL : b ≠ L := fun e => hLK (by rw [← e]; exact hb)
    obtain ⟨l, hl⟩ : ∃ l : Rˣ, h m L hmL c * h a b hab u * (h m L hmL c)⁻¹ =
        csym a b hab l u * h a b hab u := by
      by_cases ham : a = m
      · subst ham
        exact ⟨c, conj_h_of_map hab hab c (fun t => h_conj_x_row_i hmL c hab hbL.symm t)
          (fun t => h_conj_x_col_i hmL c hab.symm hbL t) u⟩
      · by_cases hbm : b = m
        · subst hbm
          refine ⟨c⁻¹, conj_h_of_map hab hab c⁻¹ (fun t => h_conj_x_col_i hmL c hab haL t)
            (fun t => ?_) u⟩
          rw [inv_inv]
          exact h_conj_x_row_i hmL c hab.symm haL.symm t
        · refine ⟨1, conj_h_of_map hab hab 1 (fun t => ?_) (fun t => ?_) u⟩
          · rw [Units.val_one, one_mul]
            exact h_conj_x_disjoint hmL c hab (Ne.symm ham) haL.symm (Ne.symm hbm) hbL.symm t
          · rw [inv_one, Units.val_one, one_mul]
            exact h_conj_x_disjoint hmL c hab.symm (Ne.symm hbm) hbL.symm (Ne.symm ham)
              haL.symm t
    rw [hl]
    exact Subgroup.mul_mem _ (symGroup_le_torusK K (csym_mem_symGroup hab l u))
      (h_mem_torusK hab ha hb u)
  · rw [← (symGroup_central third (csym_mem_symGroup hij u v) (h m L hmL c)).eq,
      mul_inv_cancel_right]
    exact symGroup_le_torusK K (csym_mem_symGroup hij u v)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.hmL_conj_torusSet

theorem hmL_conj_torusK {K : Finset I} {m L : I} (hLK : L ∉ K) (hmL : m ≠ L) (c : Rˣ)
    {y : SteinbergGroup I R} (hy : y ∈ torusK I R K) :
    h m L hmL c * y * (h m L hmL c)⁻¹ ∈ torusK I R K :=
  conj_closure_mem (fun _ hs => hmL_conj_torusSet third hLK hmL c hs) hy

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.hmL_conj_torusK

end GroupApproximation.BooneHigmanLinear.RelGen
