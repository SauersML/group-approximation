import GroupApproximation.BooneHigmanLinear.RelGen.Lemma46Mem
import GroupApproximation.Meta.AxiomGuard

/-!
# L–S Corollary 4.10: one root suffices (k2-poly H.L3)

Lane k2-hl3b. A. Lavrenov and S. Sinchuk, arXiv:1909.02637, §4.2, Corollary 4.10, in type A:
if `K(A[X], M[X])` is generated by `N = St̄(A[X], X·M[X])` and the `c_ij(m, X ξ)` over all roots
(Proposition 4.9), then the `c_{i₀j₀}(m, X η)` for one fixed root suffice.

`cor410_of_prop49 : Prop49Statement → Cor410Statement`. The proof is L–S's, via 4.6(4):

* `cElt_col_mem` and `cElt_row_mem` (with `J = X·M[X]`, since `m · X η ∈ X·M[X]`) give
  `c_pr(m, Xη) ∈ N · c_qr(-m, Xη)⁻¹` and `c_pr(m, Xη) ∈ N · c_pq(m, -Xη)⁻¹`. So the roots
  `(p, r)` whose `c`'s lie in `G₀ = N ⊔ ⟨c_{i₀j₀}(M, X·A[X])⟩` are closed under changing either
  index (`T_col`, `T_row`).
* Type A with a third index for every pair is connected under these moves (`reach_all`).

Nothing here uses that `A` is local; `cAll_le_cOne` holds for any ideal `M`.
-/

namespace GroupApproximation.BooneHigmanLinear.RelGen

open scoped commutatorElement
open GroupApproximation.SteinbergGroup

section Reach

variable {I : Type*}

/-- Pairs connected by changing one index at a time, through a third index. -/
theorem reach_all (third : ThirdIndex I) (T : I → I → Prop)
    (hcol : ∀ p q r : I, p ≠ q → q ≠ r → p ≠ r → T q r → T p r)
    (hrow : ∀ p q r : I, p ≠ q → q ≠ r → p ≠ r → T p q → T p r)
    {i₀ j₀ : I} (h₀ : i₀ ≠ j₀) (hT : T i₀ j₀) : ∀ i j : I, i ≠ j → T i j := by
  intro i j hij
  obtain ⟨k, hi₀k, hj₀k⟩ := third i₀ j₀
  by_cases hi : i = j₀
  · rw [hi] at hij ⊢
    by_cases hj : j = i₀
    · rw [hj] at hij ⊢
      exact hrow j₀ k i₀ hj₀k (Ne.symm hi₀k) hij
        (hcol j₀ i₀ k (Ne.symm h₀) hi₀k hj₀k (hrow i₀ j₀ k h₀ hj₀k hi₀k hT))
    · exact hcol j₀ i₀ j (Ne.symm h₀) (Ne.symm hj) hij (hrow i₀ j₀ j h₀ hij (Ne.symm hj) hT)
  · have hij₀ : T i j₀ := by
      by_cases hii : i = i₀
      · rw [hii]; exact hT
      · exact hcol i i₀ j₀ hii h₀ hi hT
    by_cases hj : j = j₀
    · rw [hj]; exact hij₀
    · exact hrow i j₀ j hi (Ne.symm hj) hij hij₀

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.reach_all

end Reach

section Transfer

variable {I : Type*} [Fintype I] [DecidableEq I] {A : Type*} [CommRing A]

theorem C_mul_X_mul_mem_xPolyIdeal {M : Ideal A} {m : A} (hm : m ∈ M) (η : Polynomial A) :
    Polynomial.C m * (Polynomial.X * η) ∈ xPolyIdeal M := by
  rw [show Polynomial.C m * (Polynomial.X * η) = Polynomial.X * (Polynomial.C m * η) by ring]
  exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _)
    (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hm))

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.C_mul_X_mul_mem_xPolyIdeal

variable {M : Ideal A} {H : Subgroup (SteinbergGroup I (Polynomial A))}

/-- Changing the first index: `c_qr`'s in `H` give `c_pr`'s in `H`. -/
theorem T_col (hN : relKer I (xPolyIdeal M) ≤ H) {p q r : I} (hpq : p ≠ q) (hqr : q ≠ r)
    (hpr : p ≠ r)
    (hT : ∀ m : A, m ∈ M → ∀ η : Polynomial A,
      cElt q r hqr (Polynomial.C m) (Polynomial.X * η) ∈ H) :
    ∀ m : A, m ∈ M → ∀ η : Polynomial A,
      cElt p r hpr (Polynomial.C m) (Polynomial.X * η) ∈ H := by
  intro m hm η
  have hn := hN (cElt_col_mem hpq hqr hpr (C_mul_X_mul_mem_xPolyIdeal hm η))
  have hc : cElt q r hqr (-Polynomial.C m) (Polynomial.X * η) ∈ H := by
    rw [← map_neg]
    exact hT (-m) (neg_mem hm) η
  have h := H.mul_mem hn (H.inv_mem hc)
  rwa [mul_inv_cancel_right] at h

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.T_col

/-- Changing the second index: `c_pq`'s in `H` give `c_pr`'s in `H`. -/
theorem T_row (hN : relKer I (xPolyIdeal M) ≤ H) {p q r : I} (hpq : p ≠ q) (hqr : q ≠ r)
    (hpr : p ≠ r)
    (hT : ∀ m : A, m ∈ M → ∀ η : Polynomial A,
      cElt p q hpq (Polynomial.C m) (Polynomial.X * η) ∈ H) :
    ∀ m : A, m ∈ M → ∀ η : Polynomial A,
      cElt p r hpr (Polynomial.C m) (Polynomial.X * η) ∈ H := by
  intro m hm η
  have hn := hN (cElt_row_mem hpq hqr hpr (C_mul_X_mul_mem_xPolyIdeal hm η))
  have hc : cElt p q hpq (Polynomial.C m) (-(Polynomial.X * η)) ∈ H := by
    rw [show -(Polynomial.X * η) = Polynomial.X * -η by ring]
    exact hT m hm (-η)
  have h := H.mul_mem hn (H.inv_mem hc)
  rwa [mul_inv_cancel_right] at h

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.T_row

end Transfer

section Cor410

variable {I : Type*} [Fintype I] [DecidableEq I] {A : Type*} [CommRing A]

/-- `N ⊔ ⟨c_ij(M, X·A[X]) : all roots⟩ ≤ N ⊔ ⟨c_{i₀j₀}(M, X·A[X])⟩`, for any ideal `M`. -/
theorem cAll_le_cOne (third : ThirdIndex I) (M : Ideal A) {i₀ j₀ : I} (h₀ : i₀ ≠ j₀) :
    relKer I (xPolyIdeal M) ⊔
        Subgroup.closure {g | ∃ (i j : I) (hij : i ≠ j) (m : A) (ξ : Polynomial A),
          m ∈ M ∧ cElt i j hij (Polynomial.C m) (Polynomial.X * ξ) = g} ≤
      relKer I (xPolyIdeal M) ⊔
        Subgroup.closure {g | ∃ (m : A) (η : Polynomial A),
          m ∈ M ∧ cElt i₀ j₀ h₀ (Polynomial.C m) (Polynomial.X * η) = g} := by
  refine sup_le le_sup_left ((Subgroup.closure_le _).mpr ?_)
  rintro _ ⟨i, j, hij, m, ξ, hm, rfl⟩
  have hN : relKer I (xPolyIdeal M) ≤ relKer I (xPolyIdeal M) ⊔
      Subgroup.closure {g | ∃ (m : A) (η : Polynomial A),
        m ∈ M ∧ cElt i₀ j₀ h₀ (Polynomial.C m) (Polynomial.X * η) = g} := le_sup_left
  refine reach_all third
    (fun a b => ∀ hab : a ≠ b, ∀ m : A, m ∈ M → ∀ η : Polynomial A,
      cElt a b hab (Polynomial.C m) (Polynomial.X * η) ∈ relKer I (xPolyIdeal M) ⊔
        Subgroup.closure {g | ∃ (m : A) (η : Polynomial A),
          m ∈ M ∧ cElt i₀ j₀ h₀ (Polynomial.C m) (Polynomial.X * η) = g})
    (fun _ _ _ hpq hqr _ hT hpr' => T_col hN hpq hqr hpr' (hT hqr))
    (fun _ _ _ hpq hqr _ hT hpr' => T_row hN hpq hqr hpr' (hT hpq))
    h₀ (fun _ m hm η => (le_sup_right : _ ≤ relKer I (xPolyIdeal M) ⊔ _)
      (Subgroup.subset_closure ⟨m, η, hm, rfl⟩)) i j hij hij m hm ξ

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.cAll_le_cOne

/-- **L–S Corollary 4.10** from Proposition 4.9. -/
theorem cor410_of_prop49 (h49 : Prop49Statement) : Cor410Statement := by
  intro I _ _ third A _ _ i₀ j₀ h₀
  rw [h49 I third A]
  refine le_antisymm (cAll_le_cOne third _ h₀) (sup_le_sup_left ?_ _)
  refine Subgroup.closure_mono ?_
  rintro _ ⟨m, η, hm, rfl⟩
  exact ⟨i₀, j₀, h₀, m, η, hm, rfl⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.cor410_of_prop49

end Cor410

end GroupApproximation.BooneHigmanLinear.RelGen
