import GroupApproximation.BooneHigmanLinear.RelGen.TorusFaith
import GroupApproximation.Meta.AxiomGuard

/-!
# Symbols avoid any given index

Lane bh-pal-wire, k2-poly H.L1 (ii). Over a commutative ring, with a third index for every
pair, every symbol `{u, v}_ij` lies in the subgroup generated by the roots `x_ab` with
`a, b ≠ k`, for any `k` (`symGroup_le_avoid`).

`{u, v}_ij` is a word in `x_ij`, `x_ji` (`csym_mem_pairSpan`). If `i = k`, pick `n ∉ {i, j}`.
Conjugation by `w_in(1)` sends `x_ij`, `x_ji` to roots on `{n, j}`, and the symbol is central,
so it equals its conjugate. If `j = k`, use `w_jn(1)` in the same way.
-/

namespace GroupApproximation.BooneHigmanLinear.RelGen

open GroupApproximation.SteinbergGroup
open GroupApproximation.SimpleKazhdanSofic.SkRows.SteinbergWeyl (w h w_conj_x_row_i
  w_conj_x_col_i)
open GroupApproximation.BooneHigmanLinear.K2Poly (csym csym_commute)
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwo (rootSpan x_mem_rootSpan
  rootSpan_induction)

variable {I : Type*} [Fintype I] [DecidableEq I] {R : Type*} [CommRing R]

variable (R) in
/-- The subgroup generated by the roots `x_ab` with `a, b ≠ k`. -/
def avoidGroup (k : I) : Subgroup (SteinbergGroup I R) :=
  Subgroup.closure {g | ∃ (a b : I) (hab : a ≠ b) (c : R), a ≠ k ∧ b ≠ k ∧ x a b hab c = g}

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.avoidGroup

theorem x_mem_avoidGroup {k a b : I} (hab : a ≠ b) (ha : a ≠ k) (hb : b ≠ k) (c : R) :
    x a b hab c ∈ avoidGroup R k :=
  Subgroup.subset_closure ⟨a, b, hab, c, ha, hb, rfl⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.x_mem_avoidGroup

variable (R) in
/-- The span of the roots `x_ij`, `x_ji`. -/
abbrev pairSpan (i j : I) : Subgroup (SteinbergGroup I R) :=
  rootSpan (R := R) (fun a b => (a = i ∧ b = j) ∨ (a = j ∧ b = i))

theorem w_mem_pairSpan {i j : I} (hij : i ≠ j) (u : Rˣ) : w i j hij u ∈ pairSpan R i j := by
  have h1 : ∀ t : R, x i j hij t ∈ pairSpan R i j := fun t =>
    x_mem_rootSpan hij t (Or.inl ⟨rfl, rfl⟩)
  have h2 : ∀ t : R, x j i hij.symm t ∈ pairSpan R i j := fun t =>
    x_mem_rootSpan hij.symm t (Or.inr ⟨rfl, rfl⟩)
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (h1 _) (h2 _)) (h1 _)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.w_mem_pairSpan

theorem csym_mem_pairSpan {i j : I} (hij : i ≠ j) (u v : Rˣ) :
    csym i j hij u v ∈ pairSpan R i j := by
  have hh : ∀ c : Rˣ, h i j hij c ∈ pairSpan R i j := fun c =>
    Subgroup.mul_mem _ (w_mem_pairSpan hij c) (w_mem_pairSpan hij (-1))
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (hh _) (Subgroup.inv_mem _ (hh _)))
    (Subgroup.inv_mem _ (hh _))

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.csym_mem_pairSpan

/-- If `g` conjugates `x_ij(t)` and `x_ji(t)` into a subgroup `H`, it conjugates `pairSpan i j`
into `H`. -/
theorem conj_pairSpan_mem {H : Subgroup (SteinbergGroup I R)} {g : SteinbergGroup I R} {i j : I}
    (hij : i ≠ j) (h1 : ∀ t : R, g * x i j hij t * g⁻¹ ∈ H)
    (h2 : ∀ t : R, g * x j i hij.symm t * g⁻¹ ∈ H) {y : SteinbergGroup I R}
    (hy : y ∈ pairSpan R i j) : g * y * g⁻¹ ∈ H := by
  refine rootSpan_induction (Q := fun y => g * y * g⁻¹ ∈ H) ?_ ?_ ?_ hy
  · rintro a b hab t (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · exact h1 t
    · exact h2 t
  · simp only [mul_one, mul_inv_cancel, Subgroup.one_mem]
  · intro y₁ y₂ _ _ hy₁ hy₂
    rw [show g * (y₁ * y₂) * g⁻¹ = (g * y₁ * g⁻¹) * (g * y₂ * g⁻¹) by group]
    exact Subgroup.mul_mem _ hy₁ hy₂

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.conj_pairSpan_mem

/-- **Every symbol lies in the roots avoiding `k`.** -/
theorem csym_mem_avoidGroup (third : ThirdIndex I) (k : I) {i j : I} (hij : i ≠ j) (u v : Rˣ) :
    csym i j hij u v ∈ avoidGroup R k := by
  obtain ⟨n, hin, hjn⟩ := third i j
  by_cases hik : i = k
  · have hnk : n ≠ k := fun e => hin (hik.trans e.symm)
    have hjk : j ≠ k := fun e => hij (hik.trans e.symm)
    have e := conj_pairSpan_mem (H := avoidGroup R k) (g := w i n hin 1) hij
      (fun t => by
        rw [w_conj_x_row_i i n j hin hij hjn.symm]
        exact x_mem_avoidGroup hjn.symm hnk hjk _)
      (fun t => by
        rw [w_conj_x_col_i i n j hin hij.symm hjn]
        exact x_mem_avoidGroup hjn hjk hnk _)
      (csym_mem_pairSpan hij u v)
    rwa [← (csym_commute i j hij ⟨n, hin, hjn⟩ u v (w i n hin 1)).eq, mul_inv_cancel_right] at e
  · by_cases hjk : j = k
    · have hnk : n ≠ k := fun e => hjn (hjk.trans e.symm)
      have e := conj_pairSpan_mem (H := avoidGroup R k) (g := w j n hjn 1) hij
        (fun t => by
          rw [w_conj_x_col_i j n i hjn hij hin]
          exact x_mem_avoidGroup hin hik hnk _)
        (fun t => by
          rw [w_conj_x_row_i j n i hjn hij.symm hin.symm]
          exact x_mem_avoidGroup hin.symm hnk hik _)
        (csym_mem_pairSpan hij u v)
      rwa [← (csym_commute i j hij ⟨n, hin, hjn⟩ u v (w j n hjn 1)).eq,
        mul_inv_cancel_right] at e
    · refine rootSpan_induction (Q := fun y => y ∈ avoidGroup R k) ?_ (Subgroup.one_mem _)
        (fun _ _ _ _ h₁ h₂ => Subgroup.mul_mem _ h₁ h₂) (csym_mem_pairSpan hij u v)
      rintro a b hab t (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
      · exact x_mem_avoidGroup hab hik hjk t
      · exact x_mem_avoidGroup hab hjk hik t

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.csym_mem_avoidGroup

theorem symGroup_le_avoidGroup (third : ThirdIndex I) (k : I) :
    symGroup I R ≤ avoidGroup R k := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨i, j, hij, u, v, rfl⟩
  exact csym_mem_avoidGroup third k hij u v

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.symGroup_le_avoidGroup

end GroupApproximation.BooneHigmanLinear.RelGen
