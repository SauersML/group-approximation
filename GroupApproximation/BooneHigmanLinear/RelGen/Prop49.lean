import GroupApproximation.BooneHigmanLinear.RelGen.Prop49Tools
import GroupApproximation.BooneHigmanLinear.RelGen.Lemma47
import GroupApproximation.Meta.AxiomGuard

/-!
# L–S Proposition 4.9 in type A

Lane bh-pal-wire, k2-poly H.L3. A. Lavrenov and S. Sinchuk, arXiv:1909.02637, §4.2,
Proposition 4.9: over a local ring `A` with maximal ideal `M`, and with a third index for every
pair, `K(A[X], M[X])` is generated by `N := St̄(A[X], X·M[X])` and the `c_ij(m, X ξ)`,
`m ∈ M`, `ξ ∈ A[X]`. Write `D` for the subgroup generated by the `c_ij(m, X ξ)`.

* `N ⊔ D` is normal: `c_ij(m, X ξ)` is central modulo `X·M[X]`, since `m · X ξ ∈ X·M[X]`
  (`commutator_cElt_mem_relKer`).
* `N ⊔ D ≤ K`: `N ≤ K` as in Lemma 4.7, and `c_ij(m, X ξ) = ⁅x_ji(X ξ), C(x_ij(m))⁆⁻¹` lies in
  `⁅St(X·A[X]), C(St̄(A, M))⁆ ≤ K`.
* `K ≤ N ⊔ D`: by Lemma 4.7 (from Theorem 4.2), `K = N ⊔ ⁅St(X·A[X]), C(St̄(A, M))⁆`. By
  Theorem 4.8 in the form `St̄(A, M) = St(Φ, M) ⊔ H̄(A, M)` (`relKer_eq_sup_hBar`), it is enough
  to check generator pairs. For `x_kl(f)`, `f ∈ X·A[X]`, against `C(x_ij(m))`: the pair
  `(k, l) = (j, i)` gives `c_ij(m, f)⁻¹ ∈ D`, and every other pair gives an element of
  `St̄(A[X], X·M[X])`. Against `C(g)`, `g ∈ H̄(A, M)`: `C(g)` acts on `x_kl` by a scalar
  `c ≡ 1 mod M[X]`, so the commutator is `x_kl((1 - c) f) ∈ N`.
-/

namespace GroupApproximation.BooneHigmanLinear.RelGen

open scoped commutatorElement
open GroupApproximation.SteinbergGroup
open scoped Polynomial
open IsLocalRing (maximalIdeal)
open Polynomial (C X)

variable {I : Type*} [Fintype I] [DecidableEq I] {A : Type*} [CommRing A] [IsLocalRing A]

/-- The generators `c_ij(m, X ξ)`, `m ∈ M`, of L–S Proposition 4.9. -/
abbrev cPolySet (I : Type*) [Fintype I] [DecidableEq I] (A : Type*) [CommRing A]
    [IsLocalRing A] : Set (SteinbergGroup I A[X]) :=
  {g | ∃ (i j : I) (hij : i ≠ j) (m : A) (ξ : A[X]), m ∈ maximalIdeal A ∧
    cElt i j hij (C m) (X * ξ) = g}

omit [IsLocalRing A] in
theorem C_mul_X_mul_mem {M : Ideal A} {m : A} (hm : m ∈ M) (ξ : A[X]) :
    C m * (X * ξ) ∈ xPolyIdeal M := by
  rw [mul_comm]
  exact Ideal.mul_mem_mul (Ideal.mul_mem_right ξ _ (Ideal.mem_span_singleton_self X))
    (Ideal.mem_map_of_mem C hm)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.C_mul_X_mul_mem

theorem cPoly_commutator_mem (third : ThirdIndex I) {d : SteinbergGroup I A[X]}
    (hd : d ∈ Subgroup.closure (cPolySet I A)) (g : SteinbergGroup I A[X]) :
    ⁅d, g⁆ ∈ relKer I (xPolyIdeal (maximalIdeal A)) := by
  have hle : ⁅Subgroup.closure (cPolySet I A), Subgroup.closure (Set.univ : Set _)⁆ ≤
      relKer I (xPolyIdeal (maximalIdeal A)) := by
    refine commutator_closure_le (K2Found.relSt_normal I _) fun a ha b _ => ?_
    obtain ⟨i, j, hij, m, ξ, hm, rfl⟩ := ha
    exact commutator_cElt_mem_relKer third hij (C_mul_X_mul_mem hm ξ) b
  exact hle (Subgroup.commutator_mem_commutator hd (Subgroup.subset_closure (Set.mem_univ g)))

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.cPoly_commutator_mem

/-- `c_ij(m, X ξ) = ⁅x_ji(X ξ), C(x_ij(m))⁆⁻¹` lies in `⁅St(X·A[X]), C(St̄(A, M))⁆`. -/
theorem cPoly_le_lemma47Sub : Subgroup.closure (cPolySet I A) ≤ lemma47Sub I (maximalIdeal A) := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨i, j, hij, m, ξ, hm, rfl⟩
  show ⁅x i j hij (C m), x j i hij.symm (X * ξ)⁆ ∈ lemma47Sub I (maximalIdeal A)
  rw [← commutatorElement_inv]
  refine Subgroup.mem_sup_right (Subgroup.inv_mem _ (Subgroup.commutator_mem_commutator ?_ ?_))
  · exact x_mem_xGroup_of_mem hij.symm
      (Ideal.mul_mem_right ξ _ (Ideal.mem_span_singleton_self X))
  · exact Subgroup.mem_map.mpr ⟨x i j hij m, mem_relKer_of_x hij hm, ringMap_x _ _ _ _ _⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.cPoly_le_lemma47Sub

omit [IsLocalRing A] in
theorem units_map_C_mem {M : Ideal A} (u : Aˣ) (hu : u ∈ unitsOneAdd M) :
    Units.map (C : A →+* A[X]).toMonoidHom u ∈ unitsOneAdd (polyIdeal M) := by
  show C (u : A) - 1 ∈ polyIdeal M
  rw [← map_one (C : A →+* A[X]), ← map_sub]
  exact Ideal.mem_map_of_mem _ hu

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.units_map_C_mem

/-- The generator pairs of `⁅St(X·A[X]), C(St̄(A, M))⁆`. -/
theorem commutator_gen_mem (third : ThirdIndex I) {k l : I} (hkl : k ≠ l) {f : A[X]}
    (hf : f ∈ Ideal.span {X}) {y : SteinbergGroup I A}
    (hy : y ∈ xSet I (maximalIdeal A) ∪ (hBar I (maximalIdeal A) : Set (SteinbergGroup I A))) :
    ⁅x k l hkl f, ringMap C y⁆ ∈
      relKer I (xPolyIdeal (maximalIdeal A)) ⊔ Subgroup.closure (cPolySet I A) := by
  rcases hy with ⟨i, j, hij, m, hm, rfl⟩ | hy
  · rw [ringMap_x]
    by_cases hji : k = j ∧ l = i
    · obtain ⟨e1, e2⟩ := hji
      subst e1
      subst e2
      obtain ⟨ξ, rfl⟩ := Ideal.mem_span_singleton'.mp hf
      rw [← commutatorElement_inv]
      refine Subgroup.inv_mem _ (Subgroup.mem_sup_right
        (Subgroup.subset_closure ⟨_, _, hij, m, ξ, hm, ?_⟩))
      rw [cElt, mul_comm X ξ]
    · exact Subgroup.mem_sup_left (commutator_x_mem_relKer hkl hij
        (Ideal.mul_mem_mul hf (Ideal.mem_map_of_mem C hm)) hji)
  · have hCy : ringMap C y ∈ hBar I (polyIdeal (maximalIdeal A)) :=
      hBar_map_le C (fun u hu => units_map_C_mem u hu) (Subgroup.mem_map_of_mem _ hy)
    exact Subgroup.mem_sup_left
      (commutator_x_hBar_mem third hkl (fun c hc => Ideal.mul_mem_mul hf hc) hCy)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.commutator_gen_mem

/-- **L–S Proposition 4.9.** -/
theorem prop49 : Prop49Statement := by
  intro I _ _ third A _ _
  show polyKer I (maximalIdeal A) =
    relKer I (xPolyIdeal (maximalIdeal A)) ⊔ Subgroup.closure (cPolySet I A)
  have hT : (relKer I (xPolyIdeal (maximalIdeal A)) ⊔ Subgroup.closure (cPolySet I A)).Normal :=
    sup_normal_of_commutator_mem (K2Found.relSt_normal I _)
      (fun d hd g => cPoly_commutator_mem third hd g)
  have hle : relKer I (xPolyIdeal (maximalIdeal A)) ⊔ Subgroup.closure (cPolySet I A) ≤
      lemma47Sub I (maximalIdeal A) :=
    sup_le le_sup_left cPoly_le_lemma47Sub
  refine le_antisymm ?_ (hle.trans (lemma47Sub_le_polyKer _))
  rw [lemma47_of_thm42 thm42 I third A (maximalIdeal A)]
  refine sup_le le_sup_left ?_
  rw [relKer_eq_sup_hBar (A := A) third, sup_hBar_eq_closure (A := A), MonoidHom.map_closure,
    xGroup]
  refine commutator_closure_le hT ?_
  rintro _ ⟨k, l, hkl, f, hf, rfl⟩ _ ⟨y, hy, rfl⟩
  exact commutator_gen_mem third hkl hf hy

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.prop49

end GroupApproximation.BooneHigmanLinear.RelGen
