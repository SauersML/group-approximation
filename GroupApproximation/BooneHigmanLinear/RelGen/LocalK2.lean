import GroupApproximation.BooneHigmanLinear.RelGen.LocalK2Rel
import GroupApproximation.BooneHigmanLinear.RelGen.LocalK2Avoid
import GroupApproximation.BooneHigmanLinear.K2Poly.FieldSymbolGen
import GroupApproximation.BooneHigman.SteinbergBasic.Naturality
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# `K₂` of a local ring is generated by symbols (Dennis–Vaserstein form for H.L1)

Lane bh-pal-wire, k2-poly H.L1 (ii). `A` is a local ring, and every pair of indices of `I` avoids
a third one.

* **`K2_le_symGroup_of_local`**: `K₂(I, A)` lies in the subgroup generated by the symbols.
  The image of `g ∈ K₂(I, A)` in `St_I(k)`, `k` the residue field, lies in `K₂(I, k)`, which is
  generated by symbols (`K2Poly.fsg_K2_le_Z`, Steinberg's theorem). Units of `k` lift to units of
  `A`, so some product of symbols `s` over `A` has the same image. Then `g s⁻¹ ∈ St̄(A, M)` acts
  trivially, and `relKer_act_le` applies.
* **`K2_le_avoid_of_local`** (T Lemma 3.1(d) input for k2-vdk's H.L1): for every `k`,
  `K₂(I, A) ≤ ⟨x_ab : a, b ≠ k⟩`.
-/

namespace GroupApproximation.BooneHigmanLinear.RelGen

open GroupApproximation.SteinbergGroup
open GroupApproximation.SimpleKazhdanSofic.SkRows.SteinbergWeyl (h)
open GroupApproximation.BooneHigmanLinear.K2Poly (csym fsgZ fsg_K2_le_Z)
open GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2 (symbol)
open GroupApproximation.BooneHigman.SteinbergBasic (K2 mem_K2_iff ringMap_mem_K2)
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwo (act_of_projection_eq_one)
open IsLocalRing

variable {I : Type} [Fintype I] [DecidableEq I] {A : Type} [CommRing A] [IsLocalRing A]

/-- Units of the residue field lift to units. -/
theorem exists_unit_lift (ub : (ResidueField A)ˣ) :
    ∃ u : Aˣ, Units.map (residue A).toMonoidHom u = ub := by
  obtain ⟨a, ha⟩ := residue_surjective (ub : ResidueField A)
  have hu : IsUnit a := (residue_ne_zero_iff_isUnit a).mp (by rw [ha]; exact ub.ne_zero)
  exact ⟨hu.unit, Units.ext (by rw [Units.coe_map, IsUnit.unit_spec]; exact ha)⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.exists_unit_lift

/-- The residue-field symbols are images of symbols over `A`. -/
theorem fsgZ_le_map_symGroup :
    fsgZ (I := I) (ResidueField A) ≤ (symGroup I A).map (ringMap (residue A)) := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨i, j, hij, ub, vb, rfl⟩
  obtain ⟨u, rfl⟩ := exists_unit_lift ub
  obtain ⟨v, rfl⟩ := exists_unit_lift vb
  refine ⟨csym i j hij u v, csym_mem_symGroup hij u v, ?_⟩
  simp only [csym, symbol, map_mul, map_inv, ringMap_h]

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.fsgZ_le_map_symGroup

/-- **`K₂` of a local ring is generated by symbols.** -/
theorem K2_le_symGroup_of_local (third : ThirdIndex I) : K2 I A ≤ symGroup I A := by
  intro g hg
  obtain ⟨s, hs, hsg⟩ := fsgZ_le_map_symGroup (fsg_K2_le_Z third (ringMap_mem_K2 (residue A) hg))
  have hrel : g * s⁻¹ ∈ relKer I (maximalIdeal A) := by
    have e : ringMap (residue A) (g * s⁻¹) = 1 := by
      rw [map_mul, map_inv, hsg, mul_inv_cancel]
    exact mem_relKer_iff_ringMap.mpr e
  have hfix := act_of_projection_eq_one ((mem_K2_iff _).mp
    (Subgroup.mul_mem _ hg (Subgroup.inv_mem _ (symGroup_le_K2 hs))))
  have hmem := Subgroup.mul_mem _ (relKer_act_le third hrel hfix) hs
  rwa [inv_mul_cancel_right] at hmem

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.K2_le_symGroup_of_local

/-- **Dennis–Vaserstein for local rings (the form H.L1 uses).** For every index `k`,
`K₂(I, A)` lies in the subgroup generated by the roots `x_ab` with `a, b ≠ k`. -/
theorem K2_le_avoid_of_local (third : ThirdIndex I) (k : I) :
    K2 I A ≤ Subgroup.closure
      {g | ∃ (a b : I) (hab : a ≠ b) (c : A), a ≠ k ∧ b ≠ k ∧ x a b hab c = g} :=
  (K2_le_symGroup_of_local third).trans (symGroup_le_avoidGroup third k)

#audit_axioms GroupApproximation.BooneHigmanLinear.RelGen.K2_le_avoid_of_local

end GroupApproximation.BooneHigmanLinear.RelGen
