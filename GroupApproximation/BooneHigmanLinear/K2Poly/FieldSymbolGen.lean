import GroupApproximation.BooneHigmanLinear.K2Poly.FieldSymbolCells
import GroupApproximation.BooneHigman.Metabelian.ElemFPFieldK2BruhatBigCellEndpoint
import GroupApproximation.Meta.AxiomGuard

/-!
# Symbols generate `K₂` of a field, part 3: Steinberg's theorem

k2-poly piece A5.1 (lane bh-pal-wire). Over any field `F`, with a third index for every pair
of `I`, `K₂(I, F)` lies in the subgroup `fsgZ F` generated by the Steinberg symbols
(`fsg_K2_le_Z`).

* `fsg_bigCell`: the big-cell factorization. If `g ∈ G_{K ∪ {L}}` and `(g e_L)_L ≠ 0`, then
  `g = u s v h_mL(c) z` with `z ∈ Z`. As in `ElemFPFieldK2BruhatBigCellEndpoint`, every element
  lies in a cell (`fsg_bru_of_mem`), and small cells kill `(g e_L)_L` (`fsg_small_act`).
* `fsg_mem_Z_of_act`: an element of `G_K` acting trivially on `F^I` lies in `Z`. This is the
  Finset induction of `ElemFPFieldK2BruhatFaithful`. The factor `z` acts trivially
  (`fsgZ_act`), so the old steps give `c = 1`, `u = 1`, `v = 1`, and `g = s z` with `s ∈ G_K`
  acting trivially.
-/

namespace GroupApproximation.BooneHigmanLinear.K2Poly

open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2
open GroupApproximation.BooneHigman.SteinbergBasic (K2 mem_K2_iff)
open GroupApproximation.SimpleKazhdanSofic.SkRows.SteinbergWeyl (w h)
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwo (rootSpan act unitVec
  unitVec_apply act_mul rootSpan_induction act_apply_of_rootSpan act_eq_self_of_rootSpan
  eq_one_of_col_fix_finset eq_one_of_row_zero_finset act_of_projection_eq_one
  mem_rootSpan_true rootSpan_mono)

variable {I : Type} [Fintype I] [DecidableEq I] {F : Type} [Field F]

/-- A small-cell element kills the `(L, L)` entry. -/
theorem fsg_small_act (σ : FsgData I) {g : SteinbergGroup I F} (hg : fsgSmall σ g) :
    act g (unitVec σ.L) σ.L = 0 := by
  obtain ⟨j, hj, c, s, hs, q, hq, rfl⟩ := hg
  obtain ⟨s', hs', v, hv, c', z, hz, rfl⟩ := (fsg_mem_par σ).mp hq
  have hw₀ : ∀ k ∈ σ.K, act (h σ.m σ.L σ.hmL c') (unitVec σ.L) k = 0 := by
    intro k hk
    rw [bruhat_act_h_unitVec, if_neg (bruhatBigCell_ne σ.hLK hk)]
  have hqe : act (s' * v * h σ.m σ.L σ.hmL c' * z) (unitVec σ.L) =
      act (h σ.m σ.L σ.hmL c') (unitVec σ.L) := by
    rw [act_mul, fsgZ_act hz, act_mul, act_mul,
      act_eq_self_of_rootSpan (p := fun i l => i = σ.L ∧ l ∈ σ.K)
        (w := act (h σ.m σ.L σ.hmL c') (unitVec σ.L)) (fun _ l hp => hw₀ l hp.2) hv,
      act_eq_self_of_rootSpan (p := fun i l => i ∈ σ.K ∧ l ∈ σ.K)
        (w := act (h σ.m σ.L σ.hmL c') (unitVec σ.L)) (fun _ l hp => hw₀ l hp.2) hs']
  rw [act_mul, act_mul,
    act_apply_of_rootSpan (p := fun i l => i ∈ σ.K ∧ l ∈ σ.K)
      (fun i _ hp => bruhatBigCell_ne σ.hLK hp.1) hs,
    hqe, bruhatBigCell_act_w_L, hw₀ j hj, mul_zero, neg_zero]

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_small_act

/-- Every element of `G_{K ∪ {L}}` lies in one of the cells. -/
theorem fsg_bru_of_mem (σ : FsgData I) {g : SteinbergGroup I F}
    (hg : g ∈ rootSpan (R := F) (fun i j => i ∈ insert σ.L σ.K ∧ j ∈ insert σ.L σ.K)) :
    fsgBru σ g := by
  have hone : fsgBru σ (1 : SteinbergGroup I F) :=
    Or.inl ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, by rw [one_mul]⟩
  have H : ∀ z, fsgBru σ z → fsgBru σ (g * z) := by
    refine rootSpan_induction (p := fun i j => i ∈ insert σ.L σ.K ∧ j ∈ insert σ.L σ.K)
      (Q := fun g => ∀ z, fsgBru σ z → fsgBru σ (g * z)) ?_ ?_ ?_ hg
    · intro i j hij a hp z hz
      obtain ⟨hi, hj⟩ := hp
      rcases Finset.mem_insert.mp hi with hiL | hiK
      · subst i
        rcases Finset.mem_insert.mp hj with hjL | hjK
        · exact absurd hjL.symm hij
        · exact fsg_bru_V σ hjK a hz
      · rcases Finset.mem_insert.mp hj with hjL | hjK
        · subst j
          exact fsg_bru_U σ (bruhatBigCell_x_mem_U hij a hiK) hz
        · exact fsg_bru_S σ (bruhatBigCell_x_mem_S hij a hiK hjK) hz
    · intro z hz
      rw [one_mul]
      exact hz
    · intro g₁ g₂ _ _ h₁ h₂ z hz
      rw [mul_assoc]
      exact h₁ _ (h₂ z hz)
  have h1 := H 1 hone
  rw [mul_one] at h1
  exact h1

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_bru_of_mem

/-- The big-cell factorization for fixed data `σ`, with the torus defect in `Z`. -/
theorem fsg_of_data (σ : FsgData I) {g : SteinbergGroup I F}
    (hg : g ∈ rootSpan (R := F) (fun i j => i ∈ insert σ.L σ.K ∧ j ∈ insert σ.L σ.K))
    (hact : act g (unitVec σ.L) σ.L ≠ 0) :
    ∃ u ∈ rootSpan (R := F) (fun i j => j = σ.L ∧ i ∈ σ.K),
      ∃ s ∈ rootSpan (R := F) (fun i j => i ∈ σ.K ∧ j ∈ σ.K),
        ∃ v ∈ rootSpan (R := F) (fun i j => i = σ.L ∧ j ∈ σ.K),
          ∃ c : Fˣ, ∃ z ∈ fsgZ F, g = u * s * v * h σ.m σ.L σ.hmL c * z := by
  rcases fsg_bru_of_mem σ hg with ⟨u, hu, q, hq, rfl⟩ | hsmall
  · obtain ⟨s, hs, v, hv, c, z, hz, rfl⟩ := (fsg_mem_par σ).mp hq
    exact ⟨u, hu, s, hs, v, hv, c, z, hz, by group⟩
  · exact absurd (fsg_small_act σ hsmall) hact

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_of_data

/-- **The big Bruhat cell over a field**, with the torus defect in `Z`. -/
theorem fsg_bigCell (third : ∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k) {K : Finset I} {L m : I}
    (hLK : L ∉ K) (hmK : m ∈ K) (hmL : m ≠ L) {g : SteinbergGroup I F}
    (hg : g ∈ rootSpan (R := F) (fun i j => i ∈ insert L K ∧ j ∈ insert L K))
    (hact : act g (unitVec L) L ≠ 0) :
    ∃ u ∈ rootSpan (R := F) (fun i j => j = L ∧ i ∈ K),
      ∃ s ∈ rootSpan (R := F) (fun i j => i ∈ K ∧ j ∈ K),
        ∃ v ∈ rootSpan (R := F) (fun i j => i = L ∧ j ∈ K),
          ∃ c : Fˣ, ∃ z ∈ fsgZ F, g = u * s * v * h m L hmL c * z :=
  fsg_of_data ⟨K, L, m, hmL, hLK, hmK, third⟩ hg hact

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_bigCell

/-- A span with no generating roots is trivial: roots inside `{L} × {L}` do not exist. -/
theorem fsg_rootSpan_singleton_eq_one (L : I) {g : SteinbergGroup I F}
    (hg : g ∈ rootSpan (R := F)
      (fun i j => i ∈ insert L (∅ : Finset I) ∧ j ∈ insert L (∅ : Finset I))) : g = 1 := by
  have key : ∀ y : I, y ∈ insert L (∅ : Finset I) → y = L := fun y hy =>
    (Finset.mem_insert.mp hy).resolve_right (Finset.notMem_empty y)
  exact rootSpan_induction (Q := fun g => g = 1)
    (fun i j hij _ hp => absurd ((key i hp.1).trans (key j hp.2).symm) hij) rfl
    (fun g₁ g₂ _ _ h1 h2 => show g₁ * g₂ = 1 by
      rw [show g₁ = 1 from h1, show g₂ = 1 from h2, mul_one]) hg

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_rootSpan_singleton_eq_one

/-- **Faithfulness up to symbols.** An element of `G_K` acting trivially on `F^I` lies in
`Z`. -/
theorem fsg_mem_Z_of_act (third : ∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k) (K : Finset I) :
    ∀ g ∈ rootSpan (R := F) (fun i j => i ∈ K ∧ j ∈ K),
      (∀ y : I → F, act g y = y) → g ∈ fsgZ F := by
  induction K using Finset.induction_on with
  | empty =>
    intro g hg _
    have e : g = 1 := rootSpan_induction (Q := fun g => g = 1)
      (fun i _ _ _ hp => absurd hp.1 (Finset.notMem_empty i)) rfl
      (fun g₁ g₂ _ _ h1 h2 => show g₁ * g₂ = 1 by
        rw [show g₁ = 1 from h1, show g₂ = 1 from h2, mul_one]) hg
    rw [e]
    exact Subgroup.one_mem _
  | insert L K hLK ih =>
    intro g hg hfix₀
    rcases K.eq_empty_or_nonempty with hK | ⟨m, hm⟩
    · subst hK
      rw [fsg_rootSpan_singleton_eq_one L hg]
      exact Subgroup.one_mem _
    · have hmL : m ≠ L := fun e => hLK (by rw [← e]; exact hm)
      have hLL : act g (unitVec L) L ≠ 0 := by
        rw [hfix₀, unitVec_apply, if_pos rfl]
        exact one_ne_zero
      obtain ⟨u, hu, s, hs, v, hv, c, z, hzZ, rfl⟩ := fsg_bigCell third hLK hm hmL hg hLL
      have hfix : ∀ y : I → F, act (u * s * v * h m L hmL c) y = y := fun y => by
        have e := hfix₀ y
        rwa [act_mul, fsgZ_act hzZ] at e
      refine Subgroup.mul_mem _ ?_ hzZ
      clear hfix₀ hLL hg
      -- Step 1: `c = 1`.
      have hz : ∀ j, j ∈ K → act (h m L hmL c) (unitVec L) j = 0 := fun j hj => by
        rw [bruhat_act_h_unitVec, if_neg (fun e : j = L => hLK (by rw [← e]; exact hj))]
      have hv' : act v (act (h m L hmL c) (unitVec L)) = act (h m L hmL c) (unitVec L) :=
        act_eq_self_of_rootSpan (p := fun i j => i = L ∧ j ∈ K) (fun _ j hp => hz j hp.2) hv
      have hs' : act s (act (h m L hmL c) (unitVec L)) = act (h m L hmL c) (unitVec L) :=
        act_eq_self_of_rootSpan (p := fun i j => i ∈ K ∧ j ∈ K) (fun _ j hp => hz j hp.2) hs
      have hu' : act u (act (h m L hmL c) (unitVec L)) L =
          act (h m L hmL c) (unitVec L) L :=
        act_apply_of_rootSpan (p := fun i j => j = L ∧ i ∈ K) (k := L)
          (fun i _ hp hiL => hLK (by rw [← hiL]; exact hp.2)) hu _
      have hc : c = 1 := by
        have e := congrFun (hfix (unitVec L)) L
        rw [act_mul, act_mul, act_mul, hv', hs', hu', bruhat_act_h_unitVec, if_pos rfl,
          unitVec_apply, if_pos rfl] at e
        exact inv_eq_one.mp (Units.val_eq_one.mp e)
      subst hc
      rw [bruhat_h_one, mul_one] at hfix
      rw [bruhat_h_one, mul_one]
      have hL0 : ∀ j, j ∈ K → unitVec (R := F) L j = 0 := fun j hj => by
        rw [unitVec_apply, if_neg (fun e : j = L => hLK (by rw [← e]; exact hj))]
      -- Step 2: `u = 1`.
      have hu1 : u = 1 := by
        refine eq_one_of_col_fix_finset L K hLK u hu ?_
        have e := hfix (unitVec L)
        have hvL : act v (unitVec (R := F) L) = unitVec L :=
          act_eq_self_of_rootSpan (p := fun i j => i = L ∧ j ∈ K) (fun _ j hp => hL0 j hp.2) hv
        have hsL : act s (unitVec (R := F) L) = unitVec L :=
          act_eq_self_of_rootSpan (p := fun i j => i ∈ K ∧ j ∈ K) (fun _ j hp => hL0 j hp.2) hs
        rw [act_mul, act_mul, hvL, hsL] at e
        exact e
      subst hu1
      rw [one_mul] at hfix
      rw [one_mul]
      -- Step 3: `v = 1`.
      have hv1 : v = 1 := by
        refine eq_one_of_row_zero_finset L K hLK v hv ?_
        intro k hk
        have e := congrFun (hfix (unitVec k)) L
        have hsL : act s (act v (unitVec k)) L = act v (unitVec k) L :=
          act_apply_of_rootSpan (p := fun i j => i ∈ K ∧ j ∈ K) (k := L)
            (fun i _ hp hiL => hLK (by rw [← hiL]; exact hp.1)) hs _
        rw [act_mul, hsL, unitVec_apply, if_neg hk.symm] at e
        exact e
      subst hv1
      rw [mul_one] at hfix
      rw [mul_one]
      -- Step 4: induction hypothesis.
      exact ih s hs hfix

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_mem_Z_of_act

/-- **Steinberg's theorem.** Over a field, with a third index for every pair, `K₂(I, F)` is
generated by symbols. -/
theorem fsg_K2_le_Z (third : ∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k) : K2 I F ≤ fsgZ F := by
  intro g hg
  refine fsg_mem_Z_of_act third Finset.univ g ?_
    (act_of_projection_eq_one ((mem_K2_iff g).mp hg))
  exact rootSpan_mono (p := fun _ _ : I => True)
    (fun i j _ _ => ⟨Finset.mem_univ i, Finset.mem_univ j⟩) (mem_rootSpan_true g)

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_K2_le_Z

end GroupApproximation.BooneHigmanLinear.K2Poly
