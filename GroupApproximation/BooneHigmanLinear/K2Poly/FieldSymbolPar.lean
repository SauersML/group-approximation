import GroupApproximation.BooneHigman.Metabelian.ElemFPFieldK2BruhatBigCellWeyl
import GroupApproximation.BooneHigmanLinear.K2Poly.FieldTorusK2
import GroupApproximation.Meta.AxiomGuard

/-!
# Symbols generate `K₂` of a field, part 1: the parabolic `P = S · V · T · Z`

k2-poly piece A5.1 (lane bh-pal-wire). The three `FieldSymbol*` files prove Steinberg's
theorem: over any field `F`, with a third index for every pair in `I`, `K₂(I, F)` lies in the
subgroup `Z = fsgZ F` generated by the Steinberg symbols. `FieldZCentral` then shows that
`C(K₂(I, F))` is central in `St_I(F[X])`.

The route is the big Bruhat cell of `ElemFPFieldK2BruhatBigCell*` (lanes bh-met-55/64c). That
chain is written over any field, but it assumes a multiplicative torus `h_mL`, which holds over
`F_p` because symbols vanish there. Over a general field the torus is multiplicative only up to
a symbol:

* `fsg_h_mul`: `h(c) h(c') = (symbol c' c)⁻¹ h(c' c)`;
* `fsg_h_inv`: `h(c)⁻¹ = h(c⁻¹) symbol(c⁻¹, c)`.

Symbols are central (`symbol_commute`), so `fsgPar F σ = {s v h(c) z : z ∈ Z}` is still a
subgroup. The σ-free lemmas of the ZMod chain are reused as they are.
-/

namespace GroupApproximation.BooneHigmanLinear.K2Poly

open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigman.Metabelian.ElemFP.FieldK2
open GroupApproximation.BooneHigman.SteinbergBasic (K2 mem_K2_iff)
open GroupApproximation.SimpleKazhdanSofic.SkRows.SteinbergWeyl (w h)
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwo (rootSpan
  rootSpan_induction rootSpan_conj_mem act act_of_projection_eq_one)

variable {I : Type} [Fintype I] [DecidableEq I] {F : Type} [Field F]

/-- `Z`, the subgroup of `St_I(F)` generated by all Steinberg symbols. -/
def fsgZ (F : Type) [Field F] : Subgroup (SteinbergGroup I F) :=
  Subgroup.closure {g | ∃ (i j : I) (hij : i ≠ j) (u v : Fˣ), g = symbol i j hij u v}

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsgZ

theorem fsg_symbol_mem (i j : I) (hij : i ≠ j) (u v : Fˣ) : symbol i j hij u v ∈ fsgZ (I := I) F :=
  Subgroup.subset_closure ⟨i, j, hij, u, v, rfl⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_symbol_mem

/-- `Z` is central, given a third index for every pair. -/
theorem fsgZ_comm (third : ∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k) {z : SteinbergGroup I F}
    (hz : z ∈ fsgZ F) (g : SteinbergGroup I F) : z * g = g * z := by
  have hle : fsgZ (I := I) F ≤ Subgroup.center (SteinbergGroup I F) := by
    refine (Subgroup.closure_le _).mpr ?_
    rintro _ ⟨i, j, hij, u, v, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_center_iff]
    intro g'
    obtain ⟨k, hik, hjk⟩ := third i j
    exact (symbol_commute i j k hij hik hjk u v g').eq.symm
  exact ((Subgroup.mem_center_iff.mp (hle hz)) g).symm

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsgZ_comm

/-- `Z ≤ K₂(I, F)`: symbols project to `1`. -/
theorem fsgZ_le_K2 : fsgZ (I := I) F ≤ K2 I F := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨i, j, hij, u, v, rfl⟩
  exact symbol_mem_K2 i j hij u v

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsgZ_le_K2

/-- Elements of `Z` act trivially on `F^I`. -/
theorem fsgZ_act {z : SteinbergGroup I F} (hz : z ∈ fsgZ F) (y : I → F) : act z y = y :=
  act_of_projection_eq_one ((mem_K2_iff z).mp (fsgZ_le_K2 hz)) y

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsgZ_act

/-- The torus law up to a symbol: `h(c) h(c') = (symbol c' c)⁻¹ h(c' c)`. -/
theorem fsg_h_mul (m L : I) (hmL : m ≠ L) (c c' : Fˣ) :
    h m L hmL c * h m L hmL c' = (symbol m L hmL c' c)⁻¹ * h m L hmL (c' * c) := by
  unfold symbol
  group

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_h_mul

/-- `h(c)⁻¹ = h(c⁻¹) symbol(c⁻¹, c)`. -/
theorem fsg_h_inv (m L : I) (hmL : m ≠ L) (c : Fˣ) :
    (h m L hmL c)⁻¹ = h m L hmL c⁻¹ * symbol m L hmL c⁻¹ c := by
  unfold symbol
  rw [inv_mul_cancel, bruhat_h_one]
  group

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_h_inv

/-- The data fixed along the big-cell factorization; no torus law is assumed. -/
structure FsgData (I : Type) where
  /-- The finset `K`. -/
  K : Finset I
  /-- The extra index `L ∉ K`. -/
  L : I
  /-- The index `m ∈ K` of the torus `h_mL`. -/
  m : I
  hmL : m ≠ L
  hLK : L ∉ K
  hmK : m ∈ K
  third : ∀ a b : I, ∃ k, a ≠ k ∧ b ≠ k

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.FsgData

/-- `h_mL(c)` normalizes `S = G_K`. -/
theorem fsg_h_conj_S (σ : FsgData I) (c : Fˣ) {s : SteinbergGroup I F}
    (hs : s ∈ bruhatBigCellS F σ.K) :
    h σ.m σ.L σ.hmL c * s * (h σ.m σ.L σ.hmL c)⁻¹ ∈ bruhatBigCellS F σ.K := by
  refine rootSpan_conj_mem (p := fun i j => i ∈ σ.K ∧ j ∈ σ.K) ?_ hs
  intro i j hij t hp
  obtain ⟨hi, hj⟩ := hp
  have hiL := bruhatBigCell_ne σ.hLK hi
  have hjL := bruhatBigCell_ne σ.hLK hj
  by_cases him : i = σ.m
  · subst i
    rw [h_conj_iq σ.m σ.L j σ.hmL hij hjL.symm c t]
    exact bruhatBigCell_x_mem_S hij _ σ.hmK hj
  · by_cases hjm : j = σ.m
    · subst j
      rw [h_conj_pi σ.m σ.L i σ.hmL hij hiL c t]
      exact bruhatBigCell_x_mem_S hij _ hi σ.hmK
    · rw [h_conj_pq σ.m σ.L i j σ.hmL hij (Ne.symm him) hiL.symm (Ne.symm hjm) hjL.symm c t]
      exact bruhatBigCell_x_mem_S hij _ hi hj

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_h_conj_S

/-- `h_mL(c)` normalizes `V`. -/
theorem fsg_h_conj_V (σ : FsgData I) (c : Fˣ) {v : SteinbergGroup I F}
    (hv : v ∈ bruhatBigCellV F σ.K σ.L) :
    h σ.m σ.L σ.hmL c * v * (h σ.m σ.L σ.hmL c)⁻¹ ∈ bruhatBigCellV F σ.K σ.L := by
  refine rootSpan_conj_mem (p := fun i j => i = σ.L ∧ j ∈ σ.K) ?_ hv
  intro i j hij t hp
  obtain ⟨hi, hj⟩ := hp
  subst i
  by_cases hjm : j = σ.m
  · subst j
    obtain ⟨k, hmk, hLk⟩ := σ.third σ.m σ.L
    rw [h_conj_ji σ.m σ.L k σ.hmL hmk hLk c t]
    exact bruhatBigCell_x_mem_V hij _ σ.hmK
  · rw [h_conj_jq σ.m σ.L j σ.hmL (Ne.symm hjm) hij c t]
    exact bruhatBigCell_x_mem_V hij _ hj

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_h_conj_V

/-- The group identity behind `fsg_par_mul`, with `z` and `ζ⁻¹` central. -/
theorem fsg_par_mul_eq {G : Type*} [Group G] (s v a z s' v' b z' ab ζ : G)
    (hz : ∀ g, z * g = g * z) (hζ : ∀ g, ζ⁻¹ * g = g * ζ⁻¹) (hab : a * b = ζ⁻¹ * ab) :
    s * v * a * z * (s' * v' * b * z') =
      s * (a * s' * a⁻¹) * ((a * s' * a⁻¹)⁻¹ * v * (a * s' * a⁻¹) * (a * v' * a⁻¹)) * ab *
        (ζ⁻¹ * z * z') := by
  have e₁ := hz (s' * v' * b)
  have e₂ : ab * ζ⁻¹ = a * b := by rw [← hζ ab, hab]
  calc s * v * a * z * (s' * v' * b * z') = s * v * a * (z * (s' * v' * b)) * z' := by group
    _ = s * v * a * (s' * v' * b * z) * z' := by rw [e₁]
    _ = s * (a * s' * a⁻¹) * ((a * s' * a⁻¹)⁻¹ * v * (a * s' * a⁻¹) * (a * v' * a⁻¹)) *
          (ab * ζ⁻¹) * z * z' := by rw [e₂]; group
    _ = _ := by group

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_par_mul_eq

/-- The group identity behind `fsg_par_inv`, with `z⁻¹` and `ζ` central. -/
theorem fsg_par_inv_eq {G : Type*} [Group G] (s v a z a' ζ : G)
    (hz : ∀ g, z⁻¹ * g = g * z⁻¹) (hζ : ∀ g, ζ * g = g * ζ) (ha : a⁻¹ = a' * ζ) :
    (s * v * a * z)⁻¹ =
      a' * s⁻¹ * a'⁻¹ * ((a' * s⁻¹ * a'⁻¹)⁻¹ * (a' * v⁻¹ * a'⁻¹) * (a' * s⁻¹ * a'⁻¹)) * a' *
        (ζ * z⁻¹) := by
  calc (s * v * a * z)⁻¹ = z⁻¹ * (a⁻¹ * v⁻¹ * s⁻¹) := by group
    _ = z⁻¹ * (a' * ζ * v⁻¹ * s⁻¹) := by rw [ha]
    _ = z⁻¹ * (a' * (ζ * (v⁻¹ * s⁻¹))) := by group
    _ = z⁻¹ * (a' * (v⁻¹ * s⁻¹ * ζ)) := by rw [hζ (v⁻¹ * s⁻¹)]
    _ = a' * (v⁻¹ * s⁻¹ * ζ) * z⁻¹ := by rw [hz (a' * (v⁻¹ * s⁻¹ * ζ))]
    _ = _ := by group

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_par_inv_eq

/-- Products of two elements `s v h(c) z` have the same form. -/
theorem fsg_par_mul (σ : FsgData I) {s v z s' v' z' : SteinbergGroup I F}
    (hs : s ∈ bruhatBigCellS F σ.K) (hv : v ∈ bruhatBigCellV F σ.K σ.L) (hz : z ∈ fsgZ F)
    (hs' : s' ∈ bruhatBigCellS F σ.K) (hv' : v' ∈ bruhatBigCellV F σ.K σ.L)
    (hz' : z' ∈ fsgZ F) (c c' : Fˣ) :
    ∃ s₂ ∈ bruhatBigCellS F σ.K, ∃ v₂ ∈ bruhatBigCellV F σ.K σ.L, ∃ c₂ : Fˣ, ∃ z₂ ∈ fsgZ F,
      s * v * h σ.m σ.L σ.hmL c * z * (s' * v' * h σ.m σ.L σ.hmL c' * z') =
        s₂ * v₂ * h σ.m σ.L σ.hmL c₂ * z₂ := by
  have ht := fsg_h_conj_S σ c hs'
  have hv₁ := bruhatBigCell_S_conj_V σ.hLK (Subgroup.inv_mem _ ht) hv
  rw [inv_inv] at hv₁
  have hv₃ := fsg_h_conj_V σ c hv'
  have hζ := Subgroup.inv_mem _ (fsg_symbol_mem (F := F) σ.m σ.L σ.hmL c' c)
  exact ⟨_, Subgroup.mul_mem _ hs ht, _, Subgroup.mul_mem _ hv₁ hv₃, c' * c, _,
    Subgroup.mul_mem _ (Subgroup.mul_mem _ hζ hz) hz',
    fsg_par_mul_eq _ _ _ _ _ _ _ _ _ _ (fsgZ_comm σ.third hz) (fsgZ_comm σ.third hζ)
      (fsg_h_mul σ.m σ.L σ.hmL c c')⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_par_mul

/-- The inverse of `s v h(c) z` has the same form. -/
theorem fsg_par_inv (σ : FsgData I) {s v z : SteinbergGroup I F}
    (hs : s ∈ bruhatBigCellS F σ.K) (hv : v ∈ bruhatBigCellV F σ.K σ.L) (hz : z ∈ fsgZ F)
    (c : Fˣ) :
    ∃ s₂ ∈ bruhatBigCellS F σ.K, ∃ v₂ ∈ bruhatBigCellV F σ.K σ.L, ∃ c₂ : Fˣ, ∃ z₂ ∈ fsgZ F,
      (s * v * h σ.m σ.L σ.hmL c * z)⁻¹ = s₂ * v₂ * h σ.m σ.L σ.hmL c₂ * z₂ := by
  have hs₂ := fsg_h_conj_S σ c⁻¹ (Subgroup.inv_mem _ hs)
  have hv₂ := bruhatBigCell_S_conj_V σ.hLK (Subgroup.inv_mem _ hs₂)
    (fsg_h_conj_V σ c⁻¹ (Subgroup.inv_mem _ hv))
  rw [inv_inv] at hv₂
  have hζ := fsg_symbol_mem (F := F) σ.m σ.L σ.hmL c⁻¹ c
  exact ⟨_, hs₂, _, hv₂, c⁻¹, _, Subgroup.mul_mem _ hζ (Subgroup.inv_mem _ hz),
    fsg_par_inv_eq _ _ _ _ _ _ (fsgZ_comm σ.third (Subgroup.inv_mem _ hz))
      (fsgZ_comm σ.third hζ) (fsg_h_inv σ.m σ.L σ.hmL c)⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_par_inv

/-- The parabolic subgroup `P = S · V · T · Z`. -/
def fsgPar (F : Type) [Field F] (σ : FsgData I) : Subgroup (SteinbergGroup I F) where
  carrier := {g | ∃ s ∈ bruhatBigCellS F σ.K, ∃ v ∈ bruhatBigCellV F σ.K σ.L, ∃ c : Fˣ,
    ∃ z ∈ fsgZ F, g = s * v * h σ.m σ.L σ.hmL c * z}
  mul_mem' := by
    rintro _ _ ⟨s, hs, v, hv, c, z, hz, rfl⟩ ⟨s', hs', v', hv', c', z', hz', rfl⟩
    exact fsg_par_mul σ hs hv hz hs' hv' hz' c c'
  one_mem' := ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, 1, 1, Subgroup.one_mem _, by
    simp only [bruhat_h_one, mul_one]⟩
  inv_mem' := by
    rintro _ ⟨s, hs, v, hv, c, z, hz, rfl⟩
    exact fsg_par_inv σ hs hv hz c

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsgPar

theorem fsg_mem_par (σ : FsgData I) {g : SteinbergGroup I F} :
    g ∈ fsgPar F σ ↔ ∃ s ∈ bruhatBigCellS F σ.K, ∃ v ∈ bruhatBigCellV F σ.K σ.L, ∃ c : Fˣ,
      ∃ z ∈ fsgZ F, g = s * v * h σ.m σ.L σ.hmL c * z :=
  Iff.rfl

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_mem_par

theorem fsg_S_le_par (σ : FsgData I) {s : SteinbergGroup I F}
    (hs : s ∈ bruhatBigCellS F σ.K) : s ∈ fsgPar F σ :=
  ⟨s, hs, 1, Subgroup.one_mem _, 1, 1, Subgroup.one_mem _, by
    simp only [bruhat_h_one, mul_one]⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_S_le_par

theorem fsg_V_le_par (σ : FsgData I) {v : SteinbergGroup I F}
    (hv : v ∈ bruhatBigCellV F σ.K σ.L) : v ∈ fsgPar F σ :=
  ⟨1, Subgroup.one_mem _, v, hv, 1, 1, Subgroup.one_mem _, by
    simp only [bruhat_h_one, one_mul, mul_one]⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_V_le_par

theorem fsg_h_mem_par (σ : FsgData I) (c : Fˣ) : h σ.m σ.L σ.hmL c ∈ fsgPar F σ :=
  ⟨1, Subgroup.one_mem _, 1, Subgroup.one_mem _, c, 1, Subgroup.one_mem _, by
    simp only [one_mul, mul_one]⟩

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_h_mem_par

/-- `h_bL(c) ∈ P` for every `b ∈ K`. -/
theorem fsg_hb_mem_par (σ : FsgData I) {b : I} (hb : b ∈ σ.K) (c : Fˣ) :
    h b σ.L (bruhatBigCell_ne σ.hLK hb) c ∈ fsgPar F σ := by
  by_cases hbm : b = σ.m
  · subst b
    exact fsg_h_mem_par σ c
  · have hbL := bruhatBigCell_ne σ.hLK hb
    rw [← bruhatBigCell_h_first b σ.m σ.L hbm hbL σ.hmL c]
    have hW := fsg_S_le_par σ (bruhatBigCell_w_mem_S (R := F) hbm (1 : Fˣ) hb σ.hmK)
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hW (fsg_h_mem_par σ c))
      (Subgroup.inv_mem _ hW)

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_hb_mem_par

/-- The column span `C_b` lies in `P` for `b ∈ K`. -/
theorem fsg_C_le_par (σ : FsgData I) {b : I} (hb : b ∈ σ.K) {g : SteinbergGroup I F}
    (hg : g ∈ bruhatBigCellC F σ.K σ.L b) : g ∈ fsgPar F σ := by
  refine rootSpan_induction (p := fun i j => j = b ∧ i ∈ insert σ.L σ.K)
    (Q := fun g => g ∈ fsgPar F σ) ?_ (Subgroup.one_mem _) ?_ hg
  · intro i j hij a hp
    obtain ⟨hjb, hi⟩ := hp
    subst j
    rcases Finset.mem_insert.mp hi with hiL | hiK
    · subst i
      exact fsg_V_le_par σ (bruhatBigCell_x_mem_V hij a hb)
    · exact fsg_S_le_par σ (bruhatBigCell_x_mem_S hij a hiK hb)
  · intro g k _ _ hg hk
    exact Subgroup.mul_mem _ hg hk

#audit_axioms GroupApproximation.BooneHigmanLinear.K2Poly.fsg_C_le_par

end GroupApproximation.BooneHigmanLinear.K2Poly
