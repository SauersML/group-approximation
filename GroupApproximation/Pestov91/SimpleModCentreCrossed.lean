import GroupApproximation.Pestov91.SimpleModCentre
import GroupApproximation.Pestov91.RingSimple
import Mathlib.Data.Int.Interval

/-!
# `EL_n(R)/Z` is simple for a simple crossed product, with no centre hypothesis

`GroupApproximation.Pestov91.SimpleModCentre` proves `EL_ι(R)/Z(EL_ι(R))` simple from
`IsSimpleRing R` and `LocalAnnihilation R`.  This module proves both hypotheses for a ring spanned
by the `φ (c j) * u ^ j`, with `u ^ j * φ a = φ (σ j a) * u ^ j`.  The input is the localisation
hypothesis `hkey` of `crossedProduct_isSimpleRing`.  Nothing about the centre of `R` is assumed.

* `SimpleModCentre.exists_sum_mul_eq_one_sub_prod`: in a commutative ring, `1 - ∏ (1 - a i)` is
  a sum `∑ a i * y i`.
* `localAnnihilation_of_crossedProduct`:
  - bound the exponents of the finite set `F` by `w`;
  - take `e` from `hkey` for `a = 1` and the window `[1, 2w+1]`;
  - the covering clause gives `1 = ∑ φ (σ i e) * φ (y i) = ∑ (u^i φ e) * (u^{-i} φ (y i))`.

  Every right multiple of `u^i φ e` is killed by `t = φ e u^{w+1-i}`, and so is `t F`.  The
  products reach `φ e u^n φ e = φ (e σ_n e) u^n` with `n ∈ [1, 2w+1]`, which is zero.  The same
  identity for `1` forces `φ e ≠ 0`.
* `isSimpleGroup_elementaryGroup_quotient_center_crossedProduct` and
  `isSimpleGroup_elementaryModCentre_crossedProduct`: the group statements.
* `isSimpleGroup_elementaryModCentre_of_minimal_free`: the case `LC(X, K) ⋊ ℤ` of a free minimal
  system, with `hkey` from `locallyConstant_cut_key`.
-/

namespace GroupApproximation
namespace Pestov91

open ElementarySimplicity

namespace SimpleModCentre

/-- In a commutative ring, `1 - ∏ i ∈ s, (1 - a i)` lies in the ideal generated by the `a i`. -/
theorem exists_sum_mul_eq_one_sub_prod {A κ : Type*} [CommRing A] (s : Finset κ) (a : κ → A) :
    ∃ y : κ → A, ∑ i ∈ s, a i * y i = 1 - ∏ i ∈ s, (1 - a i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | insert b s hb ih =>
    obtain ⟨y, hy⟩ := ih
    refine ⟨Function.update y b (∏ i ∈ s, (1 - a i)), ?_⟩
    have h2 : ∑ i ∈ s, a i * Function.update y b (∏ i ∈ s, (1 - a i)) i =
        ∑ i ∈ s, a i * y i :=
      Finset.sum_congr rfl fun i hi => by
        rw [Function.update_of_ne (show i ≠ b from fun h => hb (h ▸ hi))]
    rw [Finset.sum_insert hb, Finset.prod_insert hb, Function.update_self, h2, hy]
    ring

end SimpleModCentre

section CrossedProduct

variable {R A : Type*} [Ring R] [CommRing A]

/-- **Local annihilation for a crossed product.**  A nontrivial ring spanned by the
`φ (c j) * u ^ j`, with `u ^ j * φ a = φ (σ j a) * u ^ j` and the localisation hypothesis
`hkey`, satisfies `LocalAnnihilation`. -/
theorem localAnnihilation_of_crossedProduct [Nontrivial R] (φ : A →+* R) (u : Rˣ)
    (σ : ℤ → A → A)
    (hconj : ∀ (j : ℤ) (a : A), ((u ^ j : Rˣ) : R) * φ a = φ (σ j a) * ((u ^ j : Rˣ) : R))
    (hspan : ∀ x : R, ∃ (S : Finset ℤ) (c : ℤ → A), x = ∑ j ∈ S, φ (c j) * ((u ^ j : Rˣ) : R))
    (hkey : ∀ a : A, a ≠ 0 → ∀ F : Finset ℤ, (0 : ℤ) ∉ F → ∃ e b : A, b * e * a * e = e ∧
      (∀ j ∈ F, e * σ j e = 0) ∧ ∃ s : Finset ℤ, ∏ i ∈ s, (1 - σ i e) = 0) :
    LocalAnnihilation R := by
  classical
  have hUU : ∀ m n : ℤ,
      ((u ^ m : Rˣ) : R) * ((u ^ n : Rˣ) : R) = ((u ^ (m + n) : Rˣ) : R) := fun m n => by
    rw [← Units.val_mul, ← zpow_add]
  have hcomm : ∀ x y : A, φ x * φ y = φ y * φ x := fun x y => by
    rw [← map_mul φ, ← map_mul φ, mul_comm x y]
  have hA1 : (1 : A) ≠ 0 := fun h =>
    one_ne_zero (show (1 : R) = 0 by rw [← map_one φ, h, map_zero])
  unfold LocalAnnihilation
  intro F
  obtain ⟨w, hw⟩ : ∃ w : ℕ, ∀ f ∈ F, ∃ (S : Finset ℤ) (c : ℤ → A),
      (∀ j ∈ S, j.natAbs ≤ w) ∧ f = ∑ j ∈ S, φ (c j) * ((u ^ j : Rˣ) : R) := by
    induction F using Finset.induction_on with
    | empty => exact ⟨0, fun _ hf => by simp at hf⟩
    | insert g F _ ih =>
      obtain ⟨w, hw⟩ := ih
      obtain ⟨S, c, hS⟩ := hspan g
      refine ⟨max w (S.sup Int.natAbs), fun f hf => ?_⟩
      rcases Finset.mem_insert.mp hf with rfl | hf
      · exact ⟨S, c, fun j hj => le_max_of_le_right (Finset.le_sup (f := Int.natAbs) hj), hS⟩
      · obtain ⟨S', c', hS', hf'⟩ := hw f hf
        exact ⟨S', c', fun j hj => le_max_of_le_left (hS' j hj), hf'⟩
  obtain ⟨e, _, _, hFe, s, hs⟩ :=
    hkey 1 hA1 (Finset.Icc 1 (2 * (w : ℤ) + 1)) (by rw [Finset.mem_Icc]; omega)
  -- `φ e u^n φ e = 0` on the window.
  have hkill : ∀ n : ℤ, 1 ≤ n → n ≤ 2 * (w : ℤ) + 1 → ∀ z : R,
      φ e * ((u ^ n : Rˣ) : R) * (φ e * z) = 0 := by
    intro n h1 h2 z
    rw [← mul_assoc, mul_assoc (φ e), hconj n e, ← mul_assoc, ← map_mul φ,
      hFe n (Finset.mem_Icc.mpr ⟨h1, h2⟩), map_zero, zero_mul, zero_mul]
  -- Coefficients move left past `φ e u^n`.
  have hpush : ∀ (n : ℤ) (a : A) (x : R),
      φ e * (((u ^ n : Rˣ) : R) * (φ a * x)) =
        φ (σ n a) * (φ e * (((u ^ n : Rˣ) : R) * x)) := by
    intro n a x
    have h1 : φ e * ((u ^ n : Rˣ) : R) * φ a = φ (σ n a) * φ e * ((u ^ n : Rˣ) : R) := by
      rw [mul_assoc, hconj n a, ← mul_assoc, hcomm e (σ n a)]
    calc φ e * (((u ^ n : Rˣ) : R) * (φ a * x)) = φ e * ((u ^ n : Rˣ) : R) * φ a * x := by
          simp only [mul_assoc]
      _ = φ (σ n a) * φ e * ((u ^ n : Rˣ) : R) * x := by rw [h1]
      _ = φ (σ n a) * (φ e * (((u ^ n : Rˣ) : R) * x)) := by simp only [mul_assoc]
  have hσ : ∀ (n : ℤ) (a : A),
      φ (σ n a) = ((u ^ n : Rˣ) : R) * φ a * ((u ^ (-n) : Rˣ) : R) := by
    intro n a
    rw [hconj n a, mul_assoc, ← Units.val_mul, ← zpow_add, add_neg_cancel, zpow_zero,
      Units.val_one, mul_one]
  -- The covering clause writes `1` through the `u^i φ e`.
  obtain ⟨y, hy⟩ := SimpleModCentre.exists_sum_mul_eq_one_sub_prod s (fun i => σ i e)
  have hsum : ∑ i ∈ s, φ (σ i e) * φ (y i) = 1 := by
    have h := congrArg φ hy
    rw [hs, sub_zero, map_one, map_sum] at h
    simp only [map_mul] at h
    exact h
  have hone : ∑ i ∈ s, ((u ^ i : Rˣ) : R) * φ e * (((u ^ (-i) : Rˣ) : R) * φ (y i)) = 1 := by
    refine Eq.trans (Finset.sum_congr rfl fun i _ => ?_) hsum
    rw [hσ i e]
    simp only [mul_assoc]
  have he : φ e ≠ 0 := fun h => one_ne_zero (show (1 : R) = 0 from
    hone.symm.trans (Finset.sum_eq_zero fun i _ => by rw [h, mul_zero, zero_mul]))
  -- Every right multiple of `u^i φ e` is locally annihilated.
  have hmem : ∀ (i : ℤ) (z : R), ((u ^ i : Rˣ) : R) * φ e * z ∈
      {s : R | ∃ t : R, t ≠ 0 ∧ t * s = 0 ∧ ∀ f ∈ F, t * f * s = 0} := by
    intro i z
    rw [Set.mem_setOf_eq]
    refine ⟨φ e * ((u ^ ((w : ℤ) + 1 - i) : Rˣ) : R), fun h => he ?_, ?_, ?_⟩
    · calc φ e = φ e * ((u ^ ((w : ℤ) + 1 - i) : Rˣ) : R) *
            ((u ^ (i - ((w : ℤ) + 1)) : Rˣ) : R) := by
            rw [mul_assoc, hUU, show (w : ℤ) + 1 - i + (i - ((w : ℤ) + 1)) = 0 by ring,
              zpow_zero, Units.val_one, mul_one]
        _ = 0 := by rw [h, zero_mul]
    · have h := hkill ((w : ℤ) + 1 - i + i) (by omega) (by omega) z
      rw [← hUU] at h
      simp only [mul_assoc] at h ⊢
      exact h
    · intro f hf
      obtain ⟨S, c, hS, rfl⟩ := hw f hf
      rw [Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_eq_zero fun j hj => ?_
      have h := hkill ((w : ℤ) + 1 - i + j + i) (by have _hj := hS j hj; omega)
        (by have _hj := hS j hj; omega) z
      rw [← hUU, ← hUU] at h
      have h2 := hpush ((w : ℤ) + 1 - i) (c j)
        (((u ^ j : Rˣ) : R) * (((u ^ i : Rˣ) : R) * (φ e * z)))
      simp only [mul_assoc] at h ⊢
      rw [h2, h, mul_zero]
  refine (NonUnitalSubring.eq_top_iff' _).mpr fun r => ?_
  have hr : r = ∑ i ∈ s, ((u ^ i : Rˣ) : R) * φ e * (((u ^ (-i) : Rˣ) : R) * φ (y i) * r) :=
    calc r = (∑ i ∈ s, ((u ^ i : Rˣ) : R) * φ e * (((u ^ (-i) : Rˣ) : R) * φ (y i))) * r := by
          rw [hone, one_mul]
      _ = ∑ i ∈ s, ((u ^ i : Rˣ) : R) * φ e * (((u ^ (-i) : Rˣ) : R) * φ (y i) * r) := by
        rw [Finset.sum_mul]
        simp only [mul_assoc]
  rw [hr]
  exact NonUnitalSubring.sum_mem _ fun i _ => NonUnitalSubring.subset_closure (hmem i _)

end CrossedProduct

section Assembly

variable {ι R A : Type*} [Fintype ι] [DecidableEq ι] [Ring R] [CommRing A]

/-- **`EL_ι(R)/Z` is simple for a simple crossed product.**  With at least three indices, a
nontrivial ring spanned by the `φ (c j) * u ^ j` and satisfying `hkey` has a simple elementary
group modulo its centre.  No hypothesis on the centre of `R` is used. -/
theorem isSimpleGroup_elementaryGroup_quotient_center_crossedProduct
    (hcard : 3 ≤ Fintype.card ι) [Nontrivial R] (φ : A →+* R) (u : Rˣ) (σ : ℤ → A → A)
    (hconj : ∀ (j : ℤ) (a : A), ((u ^ j : Rˣ) : R) * φ a = φ (σ j a) * ((u ^ j : Rˣ) : R))
    (hspan : ∀ x : R, ∃ (S : Finset ℤ) (c : ℤ → A), x = ∑ j ∈ S, φ (c j) * ((u ^ j : Rˣ) : R))
    (hkey : ∀ a : A, a ≠ 0 → ∀ F : Finset ℤ, (0 : ℤ) ∉ F → ∃ e b : A, b * e * a * e = e ∧
      (∀ j ∈ F, e * σ j e = 0) ∧ ∃ s : Finset ℤ, ∏ i ∈ s, (1 - σ i e) = 0) :
    IsSimpleGroup (↥(elementaryGroup ι R) ⧸ Subgroup.center ↥(elementaryGroup ι R)) :=
  haveI : IsSimpleRing R := crossedProduct_isSimpleRing φ u σ hconj hspan hkey
  isSimpleGroup_elementaryGroup_quotient_center hcard
    (localAnnihilation_of_crossedProduct φ u σ hconj hspan hkey)

/-- **`EL₃(R)/Z` is simple for a simple crossed product**, with no centre hypothesis. -/
theorem isSimpleGroup_elementaryModCentre_crossedProduct [Nontrivial R] (φ : A →+* R)
    (u : Rˣ) (σ : ℤ → A → A)
    (hconj : ∀ (j : ℤ) (a : A), ((u ^ j : Rˣ) : R) * φ a = φ (σ j a) * ((u ^ j : Rˣ) : R))
    (hspan : ∀ x : R, ∃ (S : Finset ℤ) (c : ℤ → A), x = ∑ j ∈ S, φ (c j) * ((u ^ j : Rˣ) : R))
    (hkey : ∀ a : A, a ≠ 0 → ∀ F : Finset ℤ, (0 : ℤ) ∉ F → ∃ e b : A, b * e * a * e = e ∧
      (∀ j ∈ F, e * σ j e = 0) ∧ ∃ s : Finset ℤ, ∏ i ∈ s, (1 - σ i e) = 0) :
    IsSimpleGroup
      (↥(elementaryGroup (Fin 3) R) ⧸ Subgroup.center ↥(elementaryGroup (Fin 3) R)) :=
  isSimpleGroup_elementaryGroup_quotient_center_crossedProduct (by simp) φ u σ hconj hspan hkey

end Assembly

/-- **`EL₃(LC(X, K) ⋊ ℤ)/Z` is simple for a free minimal system.**  `X` is compact and totally
separated, `τ` is free with dense orbits, and the ring is spanned by the `φ (c j) * u ^ j` with
`u ^ j` acting through `σ j f = f ∘ τ j`. -/
theorem isSimpleGroup_elementaryModCentre_of_minimal_free {R X K : Type*} [Ring R]
    [Nontrivial R] [TopologicalSpace X] [CompactSpace X] [TotallySeparatedSpace X] [Field K]
    (φ : LocallyConstant X K →+* R) (u : Rˣ) (τ : ℤ → X → X) (hτ : ∀ j, Continuous (τ j))
    (hfree : ∀ j : ℤ, j ≠ 0 → ∀ x, τ j x ≠ x) (hmin : ∀ x, Dense (Set.range fun j => τ j x))
    (σ : ℤ → LocallyConstant X K → LocallyConstant X K) (hσ : ∀ j f x, σ j f x = f (τ j x))
    (hconj : ∀ (j : ℤ) (a : LocallyConstant X K),
      ((u ^ j : Rˣ) : R) * φ a = φ (σ j a) * ((u ^ j : Rˣ) : R))
    (hspan : ∀ x : R, ∃ (S : Finset ℤ) (c : ℤ → LocallyConstant X K),
      x = ∑ j ∈ S, φ (c j) * ((u ^ j : Rˣ) : R)) :
    IsSimpleGroup
      (↥(elementaryGroup (Fin 3) R) ⧸ Subgroup.center ↥(elementaryGroup (Fin 3) R)) :=
  isSimpleGroup_elementaryModCentre_crossedProduct φ u σ hconj hspan
    (locallyConstant_cut_key τ hτ hfree
      (fun _ hW hne => exists_finset_cover_of_dense_orbits τ hτ hmin hW hne) σ hσ)

end Pestov91
end GroupApproximation
