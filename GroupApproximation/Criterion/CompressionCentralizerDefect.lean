import GroupApproximation.Sofic.FreeLampRigidity

/-!
# The intrinsic compression--centralizer defect

For a subgroup `L ≤ H`, let the one-sided compressors be the elements `s`
with `s L s⁻¹ ⊆ L`, and let `G_comp` be the subgroup they generate.  The
compression--centralizer defect is the normal closure of

`[g z g⁻¹, ℓ]`,

where `g ∈ G_comp`, `z` centralizes `L`, and `ℓ ∈ L`.

This is the choice-free group-theoretic object behind the marked compression
word.  Its first application is entirely algebraic: every representation on a
finite-dimensional vector space, over every field, kills the whole defect
subgroup.  The proof uses no property `(T)`, unitarity, trace, or distinguished
lamp.  Finite-dimensional commutant rigidity makes every compressor stabilize
the commutant of the image of `L`; subgroup generation and normal closure do
the rest.
-/

namespace GroupApproximation

open scoped commutatorElement

/-! The ambient group is quantified at an arbitrary universe.  The manuscript
states the compression--centralizer defect for an arbitrary group `H`, and
nothing below — neither the group-theoretic definitions nor the
finite-dimensional sterility argument — uses the size of the universe `H` lives
in.  Keeping `H : Type*` is what lets the transport and obstruction theorems
built on `compressionGroup` be stated at the manuscript's quantification. -/
variable {H k V : Type*} [Group H] [Field k] [AddCommGroup V] [Module k V]

/-- The set of one-sided compressors of a subgroup `L ≤ H`. -/
def compressionSet (L : Subgroup H) : Set H :=
  {s | ∀ ℓ ∈ L, s * ℓ * s⁻¹ ∈ L}

@[simp]
theorem mem_compressionSet_iff {L : Subgroup H} {s : H} :
    s ∈ compressionSet L ↔ ∀ ℓ ∈ L, s * ℓ * s⁻¹ ∈ L :=
  Iff.rfl

/-- The subgroup generated by all one-sided compressors of `L`. -/
def compressionGroup (L : Subgroup H) : Subgroup H :=
  Subgroup.closure (compressionSet L)

/-- The intrinsic compression--centralizer defect generators. -/
def compressionCentralizerDefectSet (L : Subgroup H) : Set H :=
  {x | ∃ g ∈ compressionGroup L, ∃ z : H,
    (∀ ℓ ∈ L, Commute z ℓ) ∧ ∃ ℓ ∈ L, x = ⁅g * z * g⁻¹, ℓ⁆}

/-- The intrinsic compression--centralizer defect `𝔇(H,L)`. -/
def compressionCentralizerDefect (L : Subgroup H) : Subgroup H :=
  Subgroup.normalClosure (compressionCentralizerDefectSet L)

instance compressionCentralizerDefect_normal (L : Subgroup H) :
    (compressionCentralizerDefect L).Normal :=
  Subgroup.normalClosure_normal

/-- Every displayed compression--centralizer commutator belongs to the
intrinsic defect subgroup. -/
theorem compressionCentralizerDefect_generator_mem (L : Subgroup H)
    {g z ℓ : H} (hg : g ∈ compressionGroup L)
    (hz : ∀ δ ∈ L, Commute z δ) (hℓ : ℓ ∈ L) :
    ⁅g * z * g⁻¹, ℓ⁆ ∈ compressionCentralizerDefect L :=
  Subgroup.subset_normalClosure ⟨g, hg, z, hz, ℓ, hℓ, rfl⟩

/-- Every element generated by one-sided compressors stabilizes the
commutant of `π(L)` in finite dimension. -/
theorem compressionGroup_le_commutantStabilizer [FiniteDimensional k V]
    (π : H →* (V ≃ₗ[k] V)) (L : Subgroup H) :
    compressionGroup L ≤ commutantStabilizer π L := by
  rw [compressionGroup, Subgroup.closure_le]
  intro s hs
  have hinv : s⁻¹ ∈ commutantStabilizer π L :=
    inv_compressor_mem_commutantStabilizer π L hs
  simpa using (commutantStabilizer π L).inv_mem hinv

/-- A finite-dimensional representation kills each intrinsic defect
generator. -/
theorem map_compressionCentralizerDefect_generator_eq_one
    [FiniteDimensional k V] (π : H →* (V ≃ₗ[k] V)) (L : Subgroup H)
    {g z ℓ : H} (hg : g ∈ compressionGroup L)
    (hz : ∀ δ ∈ L, Commute z δ) (hℓ : ℓ ∈ L) :
    π ⁅g * z * g⁻¹, ℓ⁆ = 1 := by
  let x : V →ₗ[k] V := (π z : V →ₗ[k] V)
  have hx : ∀ δ ∈ L, adjointRep π δ x = x := by
    intro δ hδ
    rw [adjointRep_fixed_iff_commute]
    have hc : Commute (π δ) (π z) := (hz δ hδ).symm.map π
    ext v
    have hv := congrArg (fun e : V ≃ₗ[k] V ↦ e v) hc.eq
    simpa [x, LinearEquiv.mul_eq_trans, LinearEquiv.trans_apply,
      LinearMap.comp_apply, LinearEquiv.coe_coe] using hv
  have hg' : g ∈ commutantStabilizer π L :=
    compressionGroup_le_commutantStabilizer π L hg
  have hfixed : adjointRep π ℓ (adjointRep π g x) = adjointRep π g x :=
    ((hg' x).mpr hx) ℓ hℓ
  rw [adjointRep_fixed_iff_commute] at hfixed
  have hcomm : Commute (π (g * z * g⁻¹)) (π ℓ) := by
    apply Commute.symm
    apply LinearEquiv.ext
    intro v
    have hv := congrArg (fun f : V →ₗ[k] V ↦ f v) hfixed
    simpa [x, adjointRep_apply, LinearEquiv.mul_eq_trans,
      LinearEquiv.trans_apply, LinearMap.comp_apply, LinearEquiv.coe_coe]
      using hv
  rw [map_commutatorElement]
  exact commutatorElement_eq_one_iff_commute.mpr hcomm

/-- **Whole-defect finite-dimensional sterility.**  Every
finite-dimensional representation of `H`, over every field, kills the entire
intrinsic compression--centralizer defect `𝔇(H,L)`. -/
theorem compressionCentralizerDefect_le_ker :
    ∀ {H' k' V' : Type*} [Group H'] [Field k'] [AddCommGroup V'] [Module k' V']
      [FiniteDimensional k' V'] (π : H' →* (V' ≃ₗ[k'] V')) (L : Subgroup H'),
      compressionCentralizerDefect L ≤ π.ker := by
  intro H' k' V' _ _ _ _ _ π L
  apply Subgroup.normalClosure_le_normal
  rintro x ⟨g, hg, z, hz, ℓ, hℓ, rfl⟩
  exact MonoidHom.mem_ker.mpr
    (map_compressionCentralizerDefect_generator_eq_one π L hg hz hℓ)

end GroupApproximation
