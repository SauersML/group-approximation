import GroupApproximation.Manuscript.NonMFSentences.CoreMFRadicalGLKill
import GroupApproximation.Dynamics.CoreKernelFTwo
import GroupApproximation.Meta.AxiomGuard

/-!
# `thm:core-mf-radical`: the general linear restriction kernel lies in `EL_n(R_X, I)`

`non_mf_groups_exist.tex`, proof of Theorem `thm:core-mf-radical` (tex 1626–1641):

> First identify the full restriction kernel.  If $g\in\GL_n(R_X)$ restricts to the identity,
> put all entries of $g-1$ and $g^{-1}-1$ inside one finite matrix-product algebra
> $B=\prod_a M_{h_a}(\F_2)\subset I$, with local identity $p$.  [...]  Thus $g$ is generated by
> roots with coefficients in $I$.  This proves equality of the elementary and general linear
> restriction kernels with $\EL_n(R_X,I)$.

and Lemma `lem:transient-matrices` (tex 1469–1474): "The ideal $I$ is locally matricial and is
generated by the indicators $1_{P\setminus T(P)}$ of the defects".

This module discharges `CoreMFRadicalGLKill.CoreKernelLeRelativeElementaryStatement`, the input
`K_n ≤ EL_n(R_X, I)` of the general linear kill, over the two clauses of Lemma
`lem:transient-matrices`:

* `ClopenCrossedProduct.TransientIdealLocallyMatricialFTwoStatement` (`Dynamics/CoreKernelFTwo`):
  `I` is locally matricial over `F₂`;
* `CoreTransientIdealLeDefectIdealStatement` (stated here; owner chain-matricial, planned
  `transientIdeal_eq_span_defects`): `I` lies in the ideal generated by the defects,
  `BilateralThree.defectIdeal`.

The route is the printed one.  chain-radical's generic `ChainRadical.ker_elementaryMatrixUnitMap_eq`
(the general linear kernel of a restriction whose kernel `I` is locally matricial over `F₂` is
`EL_n(R, I)`) is applied at the core restriction, with the `F₂`-algebra structure
`ClopenCrossedProduct.zmodTwoAlgebra`, and `relativeElementary_mono` passes along
`I ≤ ⟨defects⟩`.  `coreMFRadicalKillGL_of_transientMatrices` composes this with
`CoreMFRadicalGLKill.coreMFRadicalKillGL_of_pieces`.
-/

namespace GroupApproximation
namespace ChainCore
namespace CoreMFRadicalGLKill

open GroupApproximation.Manuscript.ChainCore.BilateralThree

/-- **Piece: the defects generate `I`** (`lem:transient-matrices`, tex 1474: "[The ideal $I$] is
generated by the indicators $1_{P\setminus T(P)}$ of the defects"; tex 1598: "The defects
generate $I$"), in the inclusion the proof of `thm:core-mf-radical` uses: over `F₂`, the
transient ideal `I = ker (R_X → R_Y)` lies in the two-sided ideal generated by the defects
`1_{P∖T(P)}` of the clopen `P` with `T(P) ⊆ P`.  Owner chain-matricial (planned
`transientIdeal_eq_span_defects`). -/
def CoreTransientIdealLeDefectIdealStatement : Prop :=
  ∀ (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] [Nonempty X]
    (T : X ≃ₜ X),
    ClopenCrossedProduct.coreTransientIdeal T (ZMod 2) ≤ defectIdeal T (ZMod 2)

/-- **`K_n ≤ EL_n(R_X, I)` for `n ≥ 2` over `F₂`** (tex 1626–1641), from the two clauses of
Lemma `lem:transient-matrices`. -/
theorem coreKernelLeRelativeElementary_of_pieces
    (hmat : ClopenCrossedProduct.TransientIdealLocallyMatricialFTwoStatement)
    (hgen : CoreTransientIdealLeDefectIdealStatement) :
    CoreKernelLeRelativeElementaryStatement := by
  intro X _ _ _ _ T n hn
  letI := ClopenCrossedProduct.zmodTwoAlgebra T
  haveI : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.2 hn
  exact (ChainRadical.ker_elementaryMatrixUnitMap_eq (ι := Fin n)
      (ClopenCrossedProduct.restrict T (ZMod 2) (Dynamics.image_chainRecurrentSet T))
      (ClopenCrossedProduct.isLocallyMatricialIn_coreTransientIdeal hmat T)).le.trans
    (Subgroup.map_mono (relativeElementary_mono (hgen X T)))

/-- **The general linear kill of `thm:core-mf-radical`** (over `F₂`,
`K_n ≤ Rad_MF(GL_n(R_X))` for `n ≥ 3`), from Proposition `prop:bilateral-three` and the two
clauses of Lemma `lem:transient-matrices`. -/
theorem coreMFRadicalKillGL_of_transientMatrices (hbil : PrintedBilateralThree)
    (hmat : ClopenCrossedProduct.TransientIdealLocallyMatricialFTwoStatement)
    (hgen : CoreTransientIdealLeDefectIdealStatement) : CoreMFRadicalKillGLStatement :=
  coreMFRadicalKillGL_of_pieces hbil (coreKernelLeRelativeElementary_of_pieces hmat hgen)

end CoreMFRadicalGLKill
end ChainCore
end GroupApproximation

#audit_axioms GroupApproximation.ChainCore.CoreMFRadicalGLKill.coreKernelLeRelativeElementary_of_pieces
#audit_axioms GroupApproximation.ChainCore.CoreMFRadicalGLKill.coreMFRadicalKillGL_of_transientMatrices
