import Mathlib.RingTheory.TwoSidedIdeal.Operations
import Mathlib.RingTheory.TwoSidedIdeal.Lattice
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Algebra.Group.Idempotent
import Mathlib.Tactic.NoncommRing
import GroupApproximation.Meta.AxiomGuard

/-!
# `thm:full-defect-ring`: the printed gloss of the fullness hypothesis

`non_mf_groups_exist.tex`, Theorem `thm:full-defect-ring` (tex 931–938 at origin/main `68481e4d7`):

> Suppose that `s,t ∈ R` satisfy `ts = 1`, `R(1-st)R = R`; that is, `1-st` is a *full* idempotent,
> so that `1 = ∑_j a_j(1-st)b_j` for finitely many `a_j,b_j ∈ R`.

Every printed endpoint on main states the hypothesis through the finite-sum form.  This module proves
the "that is": `1 - st` is idempotent, and the two-sided ideal it generates is `R` exactly when some
finite sum `∑_j a_j(1-st)b_j` equals `1`.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMFSentences
namespace FullDefectIdealGloss

open scoped BigOperators

section Sums

variable {R : Type*} [Ring R]

/-- The finite sums `∑_k a_k e b_k`: the printed form of the elements of `R e R`. -/
def sandwichSums (e : R) : Set R :=
  {y | ∃ (m : ℕ) (a b : Fin m → R), ∑ k, a k * e * b k = y}

theorem sandwichSums_zero (e : R) : (0 : R) ∈ sandwichSums e :=
  ⟨0, Fin.elim0, Fin.elim0, by simp⟩

theorem sandwichSums_add {e x y : R} (hx : x ∈ sandwichSums e) (hy : y ∈ sandwichSums e) :
    x + y ∈ sandwichSums e := by
  obtain ⟨m, a, b, hab⟩ := hx
  obtain ⟨m', a', b', hab'⟩ := hy
  refine ⟨m + m', Fin.append a a', Fin.append b b', ?_⟩
  rw [Fin.sum_univ_add]
  simp only [Fin.append_left, Fin.append_right]
  rw [hab, hab']

theorem sandwichSums_neg {e x : R} (hx : x ∈ sandwichSums e) : -x ∈ sandwichSums e := by
  obtain ⟨m, a, b, hab⟩ := hx
  refine ⟨m, fun k ↦ -a k, b, ?_⟩
  rw [← hab, ← Finset.sum_neg_distrib]
  exact Finset.sum_congr rfl fun k _ ↦ by rw [neg_mul, neg_mul]

theorem sandwichSums_mul_left {e x y : R} (hy : y ∈ sandwichSums e) :
    x * y ∈ sandwichSums e := by
  obtain ⟨m, a, b, hab⟩ := hy
  refine ⟨m, fun k ↦ x * a k, b, ?_⟩
  rw [← hab, Finset.mul_sum]
  exact Finset.sum_congr rfl fun k _ ↦ by simp only [mul_assoc]

theorem sandwichSums_mul_right {e x y : R} (hx : x ∈ sandwichSums e) :
    x * y ∈ sandwichSums e := by
  obtain ⟨m, a, b, hab⟩ := hx
  refine ⟨m, a, fun k ↦ b k * y, ?_⟩
  rw [← hab, Finset.sum_mul]
  exact Finset.sum_congr rfl fun k _ ↦ by simp only [mul_assoc]

/-- The finite sums `∑_k a_k e b_k` form a two-sided ideal. -/
def sandwichIdeal (e : R) : TwoSidedIdeal R :=
  TwoSidedIdeal.mk' (sandwichSums e) (sandwichSums_zero e) sandwichSums_add sandwichSums_neg
    sandwichSums_mul_left sandwichSums_mul_right

theorem mem_sandwichIdeal {e x : R} : x ∈ sandwichIdeal e ↔ x ∈ sandwichSums e := by
  simp [sandwichIdeal]

/-- **The two readings of "full" agree.**  The two-sided ideal generated by `e` is the whole ring
exactly when `∑_k a_k e b_k = 1` for finitely many `a_k, b_k`. -/
theorem span_singleton_eq_top_iff_exists_sum (e : R) :
    TwoSidedIdeal.span ({e} : Set R) = ⊤ ↔
      ∃ (m : ℕ) (a b : Fin m → R), ∑ k, a k * e * b k = 1 := by
  constructor
  · intro htop
    have hle : TwoSidedIdeal.span ({e} : Set R) ≤ sandwichIdeal e := by
      rw [TwoSidedIdeal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact mem_sandwichIdeal.mpr ⟨1, fun _ ↦ 1, fun _ ↦ 1, by simp⟩
    have h1 : (1 : R) ∈ TwoSidedIdeal.span ({e} : Set R) :=
      (TwoSidedIdeal.one_mem_iff _).mpr htop
    exact mem_sandwichIdeal.mp (hle h1)
  · rintro ⟨m, a, b, hab⟩
    rw [← TwoSidedIdeal.one_mem_iff, ← hab]
    refine sum_mem fun k _ ↦ ?_
    exact TwoSidedIdeal.mul_mem_right _ _ _
      (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span (Set.mem_singleton e)))

/-- **`1 - st` is idempotent** once `ts = 1`. -/
theorem isIdempotentElem_one_sub_mul {s t : R} (hts : t * s = 1) :
    IsIdempotentElem (1 - s * t) := by
  have h : s * t * (s * t) = s * t := by
    rw [mul_assoc, ← mul_assoc t, hts, one_mul]
  show (1 - s * t) * (1 - s * t) = 1 - s * t
  calc (1 - s * t) * (1 - s * t) = 1 - s * t - s * t + s * t * (s * t) := by noncomm_ring
    _ = 1 - s * t := by rw [h]; abel

end Sums

/-- **Printed (tex 932–938).**  "Suppose that `s,t ∈ R` satisfy `ts = 1`, `R(1-st)R = R`; that is,
`1-st` is a *full* idempotent, so that `1 = ∑_j a_j(1-st)b_j` for finitely many `a_j,b_j ∈ R`."

For every ring and every pair with `ts = 1`: `1 - st` is idempotent, and `R(1-st)R = R` (the
two-sided ideal generated by `1 - st` is `⊤`) holds exactly when the printed finite sum exists. -/
def PrintedFullIdempotentGloss : Prop :=
  ∀ (R : Type) [Ring R] (s t : R), t * s = 1 →
    IsIdempotentElem (1 - s * t) ∧
      (TwoSidedIdeal.span ({1 - s * t} : Set R) = ⊤ ↔
        ∃ (m : ℕ) (a b : Fin m → R), ∑ k, a k * (1 - s * t) * b k = 1)

theorem manuscriptSentence_fullIdempotentGloss : PrintedFullIdempotentGloss :=
  fun _ _ _ _ hts ↦ ⟨isIdempotentElem_one_sub_mul hts, span_singleton_eq_top_iff_exists_sum _⟩

end FullDefectIdealGloss
end NonMFSentences
end Manuscript
end GroupApproximation

open GroupApproximation.Manuscript.NonMFSentences

#audit_closed_axioms FullDefectIdealGloss.manuscriptSentence_fullIdempotentGloss
#audit_axioms FullDefectIdealGloss.span_singleton_eq_top_iff_exists_sum
#audit_axioms FullDefectIdealGloss.isIdempotentElem_one_sub_mul
