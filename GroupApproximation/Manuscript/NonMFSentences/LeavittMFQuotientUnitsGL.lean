import GroupApproximation.Manuscript.OneSidedMFRadical.LeavittMFQuotientGeneral
import GroupApproximation.Meta.AxiomGuard
import Mathlib.Algebra.Module.Equiv.Basic
import Mathlib.Algebra.Module.LinearMap.End
import Mathlib.Algebra.Module.Opposite
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs

/-!
# `cor:leavitt-mf-quotient`: `R ≅ R^d` as right modules, so `R ≅ M_d(R)` and `H ≅ GL_d(R)`

`non_mf_groups_exist.tex`, line 1307, the first sentence of the proof of the corollary
`\label{cor:leavitt-mf-quotient}` (Leavitt unit groups), census row `7916c8696def`:

> The maps `x ↦ (t_1x,…,t_dx)` and `(y_1,…,y_d) ↦ ∑_i s_iy_i` are mutually inverse
> isomorphisms of right `R`-modules between `R` and `R^d`, so `R ≅ M_d(R)` and
> `H ≅ GL_d(R)`.

Here `R = L_k(1,d)` is `AryLeavitt.AryLeavittAlgebra k d`, generated by `s_i = genS k d i` and
`t_i = genT k d i` subject to exactly `t_is_j = δ_ij` and `∑_i s_it_i = 1`, and `H = R^×`.
Indices run over `Fin d` instead of `1,…,d`.

The module carries the three steps of the sentence along the printed route.

* `rightModuleEquiv` is the printed pair of maps, bundled as a `LinearEquiv` over `Rᵐᵒᵖ`,
  Mathlib's spelling of an isomorphism of right `R`-modules (`Semiring.toOppositeModule`
  reads `c • x` as `x * c.unop`).  The two printed formulas hold by `rfl`
  (`rightModuleEquiv_apply`, `rightModuleEquiv_symm_apply`); the `LinearEquiv` carries that
  the two maps are right-`R`-linear and mutually inverse.
* "so `R ≅ M_d(R)`": `R` is the endomorphism ring of the regular right module `R_R` by left
  multiplication (`RingEquiv.moduleEndSelfOp`), and conjugating by `rightModuleEquiv`
  (`LinearEquiv.conjRingEquiv`) gives `endEquiv : R ≃+* End_R(R^d)`.  In the standard
  coordinates of `R^d`, `endEquiv x` is left multiplication by the matrix `(t_ixs_j)_{ij}`
  (`endEquiv_apply_eq_mulVec`), and that matrix is the ring isomorphism
  `CompleteMatrixFamily.ringEquivMatrix` of the `d`-ary Leavitt family.  `endMatrixEquiv`
  is `End_R(R^d) ≅ M_d(R)`, the matrix of an endomorphism on the standard basis
  (`endMatrixEquiv_apply`).
* "and `H ≅ GL_d(R)`": `unitsEquivGLPrinted` restricts that ring isomorphism to units,
  landing in Mathlib's `Matrix.GeneralLinearGroup (Fin d) R`.  It agrees with the
  isomorphism the rest of the corollary consumes,
  `LeavittMFQuotientGeneral.unitsEquivGL` (`unitsEquivGLPrinted_val_eq_unitsEquivGL`).

`PrintedLeavittUnitsRightModuleIso` states the whole sentence as one closed proposition over
every countable field `k` and every `d ≥ 2`, as in the corollary; the proof uses neither
hypothesis.  No literature input enters: the only relations used are the two defining
relations of `L_k(1,d)`.
-/

namespace GroupApproximation
namespace LeavittMFQuotientUnitsGL

open AryLeavitt

noncomputable section

variable (k : Type) [Field k] (d : ℕ)

/-! ## The two defining relations -/

/-- `t_is_j = δ_ij`, the first defining relation of `L_k(1,d)`. -/
theorem genT_mul_genS (i j : Fin d) :
    genT k d i * genS k d j = if i = j then 1 else 0 :=
  (AryLeavitt.family k d).orthogonal i j

/-- `∑_i s_it_i = 1`, the second defining relation of `L_k(1,d)`. -/
theorem sum_genS_mul_genT :
    ∑ i : Fin d, genS k d i * genT k d i = 1 :=
  (AryLeavitt.family k d).complete

/-! ## The printed right-module isomorphism `R ≅ R^d` -/

/-- **The printed pair of maps** (`non_mf_groups_exist.tex` line 1307,
`\label{cor:leavitt-mf-quotient}`): `x ↦ (t_1x,…,t_dx)` and `(y_1,…,y_d) ↦ ∑_i s_iy_i` are
mutually inverse isomorphisms of right `R`-modules between `R` and `R^d`, for
`R = L_k(1,d)`.  Spelled as a `LinearEquiv` over `Rᵐᵒᵖ`, Mathlib's convention for a right
module as a left module over the opposite ring. -/
def rightModuleEquiv :
    AryLeavittAlgebra k d ≃ₗ[(AryLeavittAlgebra k d)ᵐᵒᵖ] (Fin d → AryLeavittAlgebra k d) where
  toFun x i := genT k d i * x
  map_add' x y := by
    funext i
    exact mul_add (genT k d i) x y
  map_smul' c x := by
    funext i
    exact (mul_assoc (genT k d i) x c.unop).symm
  invFun y := ∑ i, genS k d i * y i
  left_inv x := by
    change ∑ i, genS k d i * (genT k d i * x) = x
    simp_rw [← mul_assoc]
    rw [← Finset.sum_mul, sum_genS_mul_genT k d, one_mul]
  right_inv y := by
    funext i
    change genT k d i * ∑ j, genS k d j * y j = y i
    rw [Finset.mul_sum]
    simp_rw [← mul_assoc, genT_mul_genS k d]
    simp

/-- The printed formula `x ↦ (t_1x,…,t_dx)`. -/
theorem rightModuleEquiv_apply (x : AryLeavittAlgebra k d) (i : Fin d) :
    rightModuleEquiv k d x i = genT k d i * x :=
  rfl

/-- The printed formula `(y_1,…,y_d) ↦ ∑_i s_iy_i`. -/
theorem rightModuleEquiv_symm_apply (y : Fin d → AryLeavittAlgebra k d) :
    (rightModuleEquiv k d).symm y = ∑ i, genS k d i * y i :=
  rfl

/-! ## "so `R ≅ M_d(R)`" -/

/-- `R ≅ End_R(R_R) ≅ End_R(R^d)`: left multiplication identifies `R` with the endomorphism
ring of the regular right module, and the printed isomorphism `R ≅ R^d` transports it. -/
def endEquiv :
    AryLeavittAlgebra k d ≃+*
      Module.End (AryLeavittAlgebra k d)ᵐᵒᵖ (Fin d → AryLeavittAlgebra k d) :=
  (RingEquiv.moduleEndSelfOp (AryLeavittAlgebra k d)).trans
    (LinearEquiv.conjRingEquiv (rightModuleEquiv k d))

/-- `endEquiv x` is `y ↦ e(x · e⁻¹(y))` for `e` the printed isomorphism. -/
theorem endEquiv_apply (x : AryLeavittAlgebra k d) (y : Fin d → AryLeavittAlgebra k d) :
    endEquiv k d x y = rightModuleEquiv k d (x * (rightModuleEquiv k d).symm y) :=
  rfl

/-- In the standard coordinates of `R^d`, the endomorphism `endEquiv x` is left
multiplication by the matrix `(t_ixs_j)_{ij}`, which is `ringEquivMatrix x`. -/
theorem endEquiv_apply_eq_mulVec (x : AryLeavittAlgebra k d)
    (y : Fin d → AryLeavittAlgebra k d) :
    endEquiv k d x y = Matrix.mulVec ((AryLeavitt.family k d).ringEquivMatrix x) y := by
  rw [endEquiv_apply]
  funext i
  change genT k d i * (x * ∑ j, genS k d j * y j) =
    ∑ j, genT k d i * x * genS k d j * y j
  simp only [Finset.mul_sum, mul_assoc]

/-- The entries of `ringEquivMatrix x` are the coordinates of `endEquiv x` on the standard
basis of `R^d`. -/
theorem ringEquivMatrix_apply_eq_endEquiv (x : AryLeavittAlgebra k d) (i j : Fin d) :
    (AryLeavitt.family k d).ringEquivMatrix x i j =
      endEquiv k d x (Pi.single j (1 : AryLeavittAlgebra k d)) i := by
  have h := congrFun
    (Matrix.mulVec_single_one ((AryLeavitt.family k d).ringEquivMatrix x) j) i
  rw [← endEquiv_apply_eq_mulVec k d x] at h
  exact h.symm

/-- `End_R(R^d) ≅ M_d(R)`, through `R`. -/
def endMatrixEquiv :
    Module.End (AryLeavittAlgebra k d)ᵐᵒᵖ (Fin d → AryLeavittAlgebra k d) ≃+*
      Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d) :=
  (endEquiv k d).symm.trans (AryLeavitt.family k d).ringEquivMatrix

/-- `endMatrixEquiv` is the matrix of an endomorphism of `R^d` on the standard basis. -/
theorem endMatrixEquiv_apply
    (f : Module.End (AryLeavittAlgebra k d)ᵐᵒᵖ (Fin d → AryLeavittAlgebra k d))
    (i j : Fin d) :
    endMatrixEquiv k d f i j = f (Pi.single j (1 : AryLeavittAlgebra k d)) i := by
  change (AryLeavitt.family k d).ringEquivMatrix ((endEquiv k d).symm f) i j = _
  rw [ringEquivMatrix_apply_eq_endEquiv k d, RingEquiv.apply_symm_apply]

/-! ## "and `H ≅ GL_d(R)`" -/

/-- `H = R^× ≅ GL_d(R)`: the ring isomorphism `R ≅ M_d(R)` restricted to units. -/
def unitsEquivGLPrinted :
    (AryLeavittAlgebra k d)ˣ ≃* Matrix.GeneralLinearGroup (Fin d) (AryLeavittAlgebra k d) :=
  Units.mapEquiv (AryLeavitt.family k d).ringEquivMatrix.toMulEquiv

/-- `unitsEquivGLPrinted` is `ringEquivMatrix` on the underlying elements. -/
theorem unitsEquivGLPrinted_val (h : (AryLeavittAlgebra k d)ˣ) :
    ((unitsEquivGLPrinted k d h : Matrix.GeneralLinearGroup (Fin d) (AryLeavittAlgebra k d)) :
      Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d)) =
      (AryLeavitt.family k d).ringEquivMatrix (h : AryLeavittAlgebra k d) :=
  rfl

/-- `unitsEquivGLPrinted` is the isomorphism `H ≅ GL_d(R)` that the rest of the corollary
consumes, `LeavittMFQuotientGeneral.unitsEquivGL`. -/
theorem unitsEquivGLPrinted_val_eq_unitsEquivGL (h : (AryLeavittAlgebra k d)ˣ) :
    ((unitsEquivGLPrinted k d h : Matrix.GeneralLinearGroup (Fin d) (AryLeavittAlgebra k d)) :
      Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d)) =
      ((Manuscript.OneSidedMFRadical.LeavittMFQuotientGeneral.unitsEquivGL k d h :
        (Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d))ˣ) :
          Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d)) :=
  rfl

/-! ## The printed sentence -/

/-- **The printed sentence**, `non_mf_groups_exist.tex` line 1307, the first sentence of the
proof of `\label{cor:leavitt-mf-quotient}`: "The maps `x ↦ (t_1x,…,t_dx)` and
`(y_1,…,y_d) ↦ ∑_i s_iy_i` are mutually inverse isomorphisms of right `R`-modules between `R`
and `R^d`, so `R ≅ M_d(R)` and `H ≅ GL_d(R)`", for `R = L_k(1,d)` and `H = R^×`, over every
countable field `k` and every `d ≥ 2`, as in the corollary.

* `e` is an isomorphism of right `R`-modules (a `LinearEquiv` over `Rᵐᵒᵖ`) whose map and
  inverse are the two printed formulas.
* `φ : R ≃+* M_d(R)` is the ring isomorphism that "so" derives from `e`: acting on column
  vectors, `φ x` is the right-module endomorphism `y ↦ e(x · e⁻¹(y))` of `R^d`, which is left
  multiplication by `x` on `R_R` transported along `e`.  This pins `φ`, because an
  endomorphism of `R^d` is determined by its values on the standard basis.
* `ψ : H ≃* GL_d(R)` is `φ` restricted to units. -/
def PrintedLeavittUnitsRightModuleIso : Prop :=
  ∀ (k : Type) [Field k] [Countable k] (d : ℕ), 2 ≤ d →
    ∃ e : AryLeavittAlgebra k d ≃ₗ[(AryLeavittAlgebra k d)ᵐᵒᵖ] (Fin d → AryLeavittAlgebra k d),
      (∀ (x : AryLeavittAlgebra k d) (i : Fin d), e x i = genT k d i * x) ∧
      (∀ y : Fin d → AryLeavittAlgebra k d, e.symm y = ∑ i, genS k d i * y i) ∧
      ∃ φ : AryLeavittAlgebra k d ≃+* Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d),
        (∀ (x : AryLeavittAlgebra k d) (y : Fin d → AryLeavittAlgebra k d),
          Matrix.mulVec (φ x) y = e (x * e.symm y)) ∧
        ∃ ψ : (AryLeavittAlgebra k d)ˣ ≃*
            Matrix.GeneralLinearGroup (Fin d) (AryLeavittAlgebra k d),
          ∀ h : (AryLeavittAlgebra k d)ˣ,
            ((ψ h : Matrix.GeneralLinearGroup (Fin d) (AryLeavittAlgebra k d)) :
              Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d)) = φ (h : AryLeavittAlgebra k d)

/-- `PrintedLeavittUnitsRightModuleIso` holds. -/
theorem printedLeavittUnitsRightModuleIso : PrintedLeavittUnitsRightModuleIso := by
  intro k _ _ d _
  exact ⟨rightModuleEquiv k d, rightModuleEquiv_apply k d, rightModuleEquiv_symm_apply k d,
    (AryLeavitt.family k d).ringEquivMatrix,
    fun x y => (endEquiv_apply_eq_mulVec k d x y).symm.trans (endEquiv_apply k d x y),
    unitsEquivGLPrinted k d, unitsEquivGLPrinted_val k d⟩

end

end LeavittMFQuotientUnitsGL
end GroupApproximation

/-! ### Axiom audit -/

open GroupApproximation.LeavittMFQuotientUnitsGL

#audit_axioms genT_mul_genS
#audit_axioms sum_genS_mul_genT
#audit_axioms rightModuleEquiv_apply
#audit_axioms rightModuleEquiv_symm_apply
#audit_axioms endEquiv_apply
#audit_axioms endEquiv_apply_eq_mulVec
#audit_axioms ringEquivMatrix_apply_eq_endEquiv
#audit_axioms endMatrixEquiv_apply
#audit_axioms unitsEquivGLPrinted_val
#audit_axioms unitsEquivGLPrinted_val_eq_unitsEquivGL
#audit_closed_axioms GroupApproximation.LeavittMFQuotientUnitsGL.printedLeavittUnitsRightModuleIso
