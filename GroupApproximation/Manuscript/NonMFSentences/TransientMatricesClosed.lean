import GroupApproximation.Manuscript.NonMFSentences.TransientMatrices
import GroupApproximation.Manuscript.NonMFSentences.CoreRingReflection
import GroupApproximation.Meta.AxiomGuard

/-!
# `lem:transient-matrices`, closed

`non_mf_groups_exist.tex`, Lemma `lem:transient-matrices` (tex 1469–1477 at origin/main `68481e4d7`) and the
sentence "Laurent normal forms give exactness" of its proof (tex 1481).

`TransientMatrices` proves the printed lemma over `RestrictSurjectiveStatement`, the surjectivity of
restriction `R_X → R_Y` to a closed invariant set.  ct-return-tower's
`ChainCore.CoreRingReflection.restrict_surjective_of_isClosed` (landed 17817cdac) proves it: each Laurent
coefficient on `Y` extends to `X` by a finite clopen partition.  This consumer module discharges the
premise, so the printed lemma is closed.

It is a separate module so that `TransientMatrices` does not import `CoreRingReflection` and, through
it, `DynamicRankBudget`.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMFSentences
namespace TransientMatrices

/-- **Restriction to a closed invariant set is onto**, discharged by
`ChainCore.CoreRingReflection.restrict_surjective_of_isClosed`. -/
theorem restrictSurjectiveStatement_holds : RestrictSurjectiveStatement :=
  fun _ _ _ _ _ T k _ _ hY hYc =>
    ChainCore.CoreRingReflection.restrict_surjective_of_isClosed T k hY hYc

/-- **`lem:transient-matrices` as printed** (tex 1469–1477), closed: restriction to `Y = CR(T)` is
onto with kernel `I`, `I = LC_c(X∖Y,k) ⋊_T ℤ` coefficientwise, `I` is locally matricial, and `I` is
generated by the defect indicators `1_{P∖T(P)}`. -/
theorem printedTransientMatrices_closed : PrintedTransientMatrices :=
  printedTransientMatrices_of_restrictSurjective restrictSurjectiveStatement_holds

/-- **Printed (tex 1481).**  "Laurent normal forms give exactness", at both ends: `x` is in the kernel
of restriction to `Y = CR(T)` exactly when every Laurent coefficient of `x` vanishes on `Y`, and
restriction is onto. -/
def PrintedLaurentExactness : Prop :=
  ∀ (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] (T : X ≃ₜ X)
    (k : Type) [Ring k],
    (∀ x : ClopenCrossedProduct T k,
      x ∈ ClopenCrossedProduct.transientIdeal T k (Dynamics.image_chainRecurrentSet T) ↔
        ∀ (g : Multiplicative ℤ), ∀ y ∈ Dynamics.chainRecurrentSet ⇑T,
          (ClopenCoeff.of T k).symm (SkewMonoidAlgebra.coeff x g) y = 0) ∧
      Function.Surjective
        (ClopenCrossedProduct.restrict T k (Dynamics.image_chainRecurrentSet T))

theorem printedLaurentExactness : PrintedLaurentExactness :=
  fun X _ _ _ T k _ =>
    ⟨printedLaurentExactnessMiddle X T k,
      restrictSurjectiveStatement_holds X T k _ (Dynamics.image_chainRecurrentSet T)
        (Dynamics.isClosed_chainRecurrentSet T.continuous)⟩

end TransientMatrices
end NonMFSentences
end Manuscript
end GroupApproximation

open GroupApproximation.Manuscript.NonMFSentences

#audit_closed_axioms TransientMatrices.restrictSurjectiveStatement_holds
#audit_closed_axioms TransientMatrices.printedTransientMatrices_closed
#audit_closed_axioms TransientMatrices.printedLaurentExactness
