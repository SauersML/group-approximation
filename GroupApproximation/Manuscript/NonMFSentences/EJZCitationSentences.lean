import GroupApproximation.Manuscript.NonMFSentences.UniversalRingSentences
import GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonRankFourSentences
import GroupApproximation.Manuscript.OneSidedMFRadical.TorsionComplementaryIdempotentsJacobson
import GroupApproximation.Meta.AxiomGuard

/-!
# Two `[EJZ, Theorem 1.1]` sentences at their printed objects

`non_mf_groups_exist.tex` cites `\cite[Theorem~1.1]{EJZ}` five times.  The
theorem is proved in the repository, in the printed generality,
`IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT`:
`EL_n(A)` has property `(T)` for every finitely generated unital ring `A` and
every `n ≥ 3`.  No sentence takes it as an input.

This module closes two of the five sentences at the printed objects themselves.

* Proof of `thm:full-defect-ring` (tex 937--943):

  > Put `G = EL₄(𝒞)` and `L = EL₃(𝒞)` on coordinates `1,2,3`.  The ring `𝒞` is
  > nonzero, since it maps onto `L_{𝔽₂}(1,2)`, and finitely generated, so both
  > groups have property (T) by [EJZ, Theorem 1.1], and `EL₄(𝒞)` is finitely
  > generated [BHV, Theorem 1.3.1].

  `UniversalRingSentences.manuscriptSentence_universalRingPrintedReasons` states
  the second group as the abstract `EL₃(𝒞)`.  Here it is the printed `L`, the
  copy on the first three coordinates of `G`, `OneSidedCompressor.core`.
* The remark after `prop:torsion-defect-ring` (tex 1155--1157), about
  `J = 𝔽₂⟨s,t | ts=1⟩`:

  > Three coordinates carry property (T) [EJZ, Theorem 1.1], and the fourth makes
  > the compression by `s` invertible.

  `JacobsonRankFour.manuscriptSentence_threeCoordinatesCarryPropertyT` proves the
  first half for every finitely generated ring.  Here it is instantiated at the
  printed `J`, `TorsionComplementaryIdempotents.jacobsonAlgebra`, which is finitely
  generated because it is generated by the two shifts.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMFSentences
namespace EJZCitationSentences

open GroupApproximation.Manuscript.OneSidedMFRadical

/-- **Printed (tex 937--943), at the printed `L`.**  `𝒞` maps onto `L_{𝔽₂}(1,2)`,
so it is nonzero; it is finitely generated; `G = EL₄(𝒞)` and the copy `L` of
`EL₃(𝒞)` on coordinates `1,2,3` of `G` both have property (T); and `G` is
finitely generated. -/
def PrintedUniversalRingBothGroupsPropertyT : Prop :=
  Function.Surjective UniversalRingSentences.universalToLeavitt ∧
    Nontrivial UniversalPair.UniversalPairRing ∧
    IsFinitelyGeneratedRing UniversalPair.UniversalPairRing ∧
    HasKazhdanPropertyT.{0, 0} UniversalGroupB.B ∧
    HasKazhdanPropertyT.{0, 0}
      (GroupApproximation.OneSidedCompressor.core UniversalPair.UniversalPairRing) ∧
    Group.FG UniversalGroupB.B

theorem manuscriptSentence_universalRingBothGroupsPropertyT :
    PrintedUniversalRingBothGroupsPropertyT := by
  obtain ⟨hsurj, hnon, hfg, hG, hL, hGfg⟩ :=
    UniversalRingSentences.manuscriptSentence_universalRingPrintedReasons
  exact ⟨hsurj, hnon, hfg, hG,
    GroupApproximation.OneSidedCompressor.core_hasKazhdanPropertyT hL, hGfg⟩

/-- The printed `J = 𝔽₂⟨s,t | ts=1⟩` is a finitely generated ring: it is the
subring generated by the two shifts. -/
theorem isFinitelyGeneratedRing_jacobsonAlgebra :
    IsFinitelyGeneratedRing ↥TorsionComplementaryIdempotents.jacobsonAlgebra :=
  HeadlineCitationSentences.isFinitelyGeneratedRing_pairSubring
    TorsionComplementaryIdempotents.shiftUp TorsionComplementaryIdempotents.shiftDown

/-- **Printed (tex 1155--1156), at the printed `J`.**  "Three coordinates carry
property (T)": `J` is finitely generated, and the core `L = EL₃(J)` on coordinates
`1,2,3` of `EL₄(J)` has property (T). -/
def PrintedJacobsonThreeCoordinatesCarryPropertyT : Prop :=
  IsFinitelyGeneratedRing ↥TorsionComplementaryIdempotents.jacobsonAlgebra ∧
    HasKazhdanPropertyT.{0, 0}
      (GroupApproximation.OneSidedCompressor.core
        ↥TorsionComplementaryIdempotents.jacobsonAlgebra)

theorem manuscriptSentence_jacobsonThreeCoordinatesCarryPropertyT :
    PrintedJacobsonThreeCoordinatesCarryPropertyT :=
  ⟨isFinitelyGeneratedRing_jacobsonAlgebra,
    JacobsonRankFour.manuscriptSentence_threeCoordinatesCarryPropertyT
      ↥TorsionComplementaryIdempotents.jacobsonAlgebra
      isFinitelyGeneratedRing_jacobsonAlgebra⟩

end EJZCitationSentences
end NonMFSentences
end Manuscript
end GroupApproximation

