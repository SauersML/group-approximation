import GroupApproximation.Manuscript.SimpleKazhdanSofic.SubshiftMatricial
import GroupApproximation.Manuscript.SimpleKazhdanSofic.MatricialEndpoints
import GroupApproximation.Manuscript.SimpleKazhdanSofic.SimpleKazhdanSoficMainClosed
import GroupApproximation.Meta.AxiomGuard

/-!
# `simple_kazhdan_sofic_group.tex`, proof of `thm:main` (tex l.357–391)

> l.362–367: The ring $R=\LC(X,\F_2)\rtimes_T\Z$ is generated by $S=\{1,u,u^{-1}\}\cup\{e_a:a\in A\}$,
> where $e_a=e_{\{x:x_0=a\}}$, since products of the translates $u^je_au^{-j}$ are the indicators of
> the cylinders, the sets of points with a given word at given coordinates, which span $\LC(X,\F_2)$.
>
> l.383–388: Since $PD_\ell(f)P^{-1}=D_\ell(f\circ T^{-1})$ whenever $f$ depends only on coordinates in
> $[-\ell+1,\ell-1]$, for fixed $r,r'\in R$ the identities $\varphi_\ell(r+r')=\varphi_\ell(r)+\varphi_\ell(r')$
> and $\varphi_\ell(rr')=\varphi_\ell(r)\varphi_\ell(r')$ hold for large $\ell$, and $\varphi_\ell(1)=I$.
>
> l.390–391: Therefore $\varphi_\ell(S)$ generates $M_{N_\ell}(\F_2)$, and Theorem~\ref{thm:general}
> applies.

Objects.  `printedGeneratorsSet S = {1} ∪ {u, u⁻¹} ∪ {e_a}`; `coordIndicator S t a = [x_t = a]`.  The
periodic points `y_ℓ = periodicExt x (m ℓ)` of a point `x ∈ X`, their least periods `N_ℓ`, and the
diagonal models `D_ℓ` come from the absorbed `exists_asymptoticModels`; the printed `φ_ℓ` is
`cutoffModel (D ℓ) ℓ` (`Σ_j D_ℓ(f_j) P^j` when every `f_j` depends only on `[-ℓ, ℓ]`, and `0`
otherwise).  The formula clause `D_ℓ(f) δ_t = f(T^t y_ℓ)` pins `φ_ℓ`, since `φ_ℓ` only reads `D_ℓ` on
coefficients depending on `[-ℓ, ℓ]`.  `P^i D(f) = D(g • f) P^i` with `i = toAdd g` is the covariance
`P D(f) P⁻¹ = D(f ∘ T⁻¹)`, since `u^i f u^{-i} = g • f`.

Route.

* `manuscriptSentence_ringGeneratedByLettersAndShift`: generation is `subring_closure_eq_top`; the
  translate identity is `unit_zpow_mul_coeff_mul_inv` with `comap_letterIndicator`; products of
  coordinate indicators are evaluated pointwise; the cylinder expansion of a locally constant function
  through its radius (`WordGraph.exists_radius`).
* `exists_printedCutoffModels` bundles the models: the generation block (the shifts of `y_ℓ` are
  distinct, `subring_closure_periodicGenerators_eq_top`), the covariance (`shiftMatrix_mul_diagonal`
  with the covariance clause of the models), `cutoffModel_one`, and the identities
  (`eventually_cutoffModel_eq`, additivity of `periodicModel`, and the eventual multiplicativity).
* `manuscriptSentence_cutoffCovarianceIdentitiesUnit` and `manuscriptSentence_cutoffImageGenerates…`
  project it; the latter adds the matricial structure over `printedGenerators S`
  (`printedPeriodicMatricialStatement`) and the conclusion of `thm:main` for every `n ≥ 3`
  (`printedSimpleKazhdanSoficMain`).
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.AbstractIntro

open GroupApproximation.SimpleKazhdanSofic GroupApproximation.WordGraph GroupApproximation.Pestov91
  GroupApproximation.ClopenCrossedProduct SymbolicDynamics.FullShift Filter Matrix
open Multiplicative (toAdd)

/-! ## Generation of `R` -/

/-- A product of coordinate indicators is `1` at a point with the given word at the given coordinates. -/
theorem prod_coordIndicator_eq_one {A : Type} [TopologicalSpace A] [DiscreteTopology A] [DecidableEq A]
    (S : Subshift A ℤ) (I : Finset ℤ) (w : I → A) (x : S.carrier) (h : ∀ t : I, x.1 t = w t) :
    (∏ t : I, coordIndicator S t (w t)) x = 1 := by
  rw [show (∏ t : I, coordIndicator S t (w t)) x =
      LocallyConstant.evalRingHom x (∏ t : I, coordIndicator S t (w t)) from rfl, map_prod]
  exact Finset.prod_eq_one fun t _ => by
    show coordIndicator S t (w t) x = 1
    rw [coordIndicator_apply, if_pos (h t)]

/-- A product of coordinate indicators is `0` at a point without the given word at the given
coordinates. -/
theorem prod_coordIndicator_eq_zero {A : Type} [TopologicalSpace A] [DiscreteTopology A] [DecidableEq A]
    (S : Subshift A ℤ) (I : Finset ℤ) (w : I → A) (x : S.carrier) (h : ¬ ∀ t : I, x.1 t = w t) :
    (∏ t : I, coordIndicator S t (w t)) x = 0 := by
  obtain ⟨s, hs⟩ := not_forall.mp h
  rw [show (∏ t : I, coordIndicator S t (w t)) x =
      LocallyConstant.evalRingHom x (∏ t : I, coordIndicator S t (w t)) from rfl, map_prod]
  exact Finset.prod_eq_zero (Finset.mem_univ s) (by
    show coordIndicator S s (w s) x = 0
    rw [coordIndicator_apply, if_neg hs])

/-- Every locally constant `f : X → F₂` is a combination of cylinder indicators
`∏_{t ∈ I} [x_t = w_t]`. -/
theorem exists_eq_sum_cylinderIndicators {A : Type} [TopologicalSpace A] [DiscreteTopology A]
    [DecidableEq A] [Fintype A] (S : Subshift A ℤ) (f : LocallyConstant S.carrier (ZMod 2)) :
    ∃ (I : Finset ℤ) (c : (I → A) → ZMod 2),
      f = ∑ w : I → A, LocallyConstant.const S.carrier (c w) * ∏ t : I, coordIndicator S t (w t) := by
  classical
  obtain ⟨r, hr⟩ := exists_radius S.isClosed f
  obtain ⟨I, hIdef⟩ : ∃ I : Finset ℤ, I = Finset.Icc (-(r : ℤ)) r := ⟨_, rfl⟩
  obtain ⟨c, hcdef⟩ : ∃ c : (I → A) → ZMod 2, c = fun w =>
      if h : ∃ y : S.carrier, ∀ t : I, y.1 t = w t then f h.choose else 0 := ⟨_, rfl⟩
  refine ⟨I, c, ?_⟩
  ext x
  rw [show (∑ w : I → A, LocallyConstant.const S.carrier (c w) *
      ∏ t : I, coordIndicator S t (w t)) x =
      LocallyConstant.evalRingHom x (∑ w : I → A, LocallyConstant.const S.carrier (c w) *
        ∏ t : I, coordIndicator S t (w t)) from rfl, map_sum]
  rw [Finset.sum_eq_single (fun t : I => x.1 t)]
  · have hx : ∃ y : S.carrier, ∀ t : I, y.1 t = (fun t : I => x.1 t) t := ⟨x, fun _ => rfl⟩
    rw [map_mul, map_prod]
    rw [Finset.prod_eq_one fun t _ => by
      show coordIndicator S t (x.1 t) x = 1
      rw [coordIndicator_apply, if_pos rfl]]
    rw [mul_one]
    show f x = c fun t : I => x.1 t
    rw [hcdef]
    simp only [dif_pos hx]
    refine hr x hx.choose fun i hi => ?_
    have hiI : i ∈ I := by rw [hIdef]; exact Finset.mem_Icc.2 (abs_le.1 hi)
    exact (hx.choose_spec ⟨i, hiI⟩).symm
  · intro w _ hw
    obtain ⟨t, ht⟩ : ∃ t : I, x.1 t ≠ w t := by
      by_contra h
      push Not at h
      exact hw (funext fun t => (h t).symm)
    rw [map_mul, map_prod, Finset.prod_eq_zero (Finset.mem_univ t) (by
      show coordIndicator S t (w t) x = 0
      rw [coordIndicator_apply, if_neg ht]), mul_zero]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-- **tex l.362–367**: `R = LC(X, F₂) ⋊_T ℤ` is generated by `S = {1, u, u⁻¹} ∪ {e_a : a ∈ A}`; the
translate `u^j e_a u^{-j}` is the coordinate indicator `[x_{-j} = a]`; a product
`∏_{t ∈ I} [x_t = w_t]` is the indicator of the cylinder `{x : x_t = w_t for t ∈ I}`; and these
cylinder indicators span `LC(X, F₂)`. -/
theorem manuscriptSentence_ringGeneratedByLettersAndShift {A : Type} [TopologicalSpace A]
    [DiscreteTopology A] [DecidableEq A] [Fintype A] (S : Subshift A ℤ) :
    Subring.closure (printedGeneratorsSet S) = ⊤ ∧
      (∀ (j : ℤ) (a : A),
        ((unit (subshiftHomeo S) (ZMod 2) ^ j : (R S)ˣ) : R S) *
            coeff (subshiftHomeo S) (ZMod 2) (letterIndicator S a) *
            (((unit (subshiftHomeo S) (ZMod 2) ^ j)⁻¹ : (R S)ˣ) : R S) =
          coeff (subshiftHomeo S) (ZMod 2) (coordIndicator S (-j) a)) ∧
      (∀ (t : ℤ) (a : A) (x : S.carrier), coordIndicator S t a x = if x.1 t = a then 1 else 0) ∧
      (∀ (I : Finset ℤ) (w : I → A) (x : S.carrier),
        (∀ t : I, x.1 t = w t) → (∏ t : I, coordIndicator S t (w t)) x = 1) ∧
      (∀ (I : Finset ℤ) (w : I → A) (x : S.carrier),
        ¬ (∀ t : I, x.1 t = w t) → (∏ t : I, coordIndicator S t (w t)) x = 0) ∧
      ∀ f : LocallyConstant S.carrier (ZMod 2), ∃ (I : Finset ℤ) (c : (I → A) → ZMod 2),
        f = ∑ w : I → A, LocallyConstant.const S.carrier (c w) * ∏ t : I, coordIndicator S t (w t) :=
  ⟨eq_top_iff.2 ((subring_closure_eq_top S).ge.trans
      (Subring.closure_mono (Set.subset_insert 1 (ringGenerators S) :
        ringGenerators S ⊆ printedGeneratorsSet S))),
    fun j a => (unit_zpow_mul_coeff_mul_inv (subshiftHomeo S) (ZMod 2) j (letterIndicator S a)).trans
      (congrArg (fun g => coeff (subshiftHomeo S) (ZMod 2) g) (comap_letterIndicator S j a)),
    fun t a x => coordIndicator_apply S t a x,
    fun I w x h => prod_coordIndicator_eq_one S I w x h,
    fun I w x h => prod_coordIndicator_eq_zero S I w x h,
    fun f => exists_eq_sum_cylinderIndicators S f⟩

/-! ## The printed models `φ_ℓ` -/

/-- The printed `φ_ℓ = cutoffModel (D ℓ) ℓ`, with their defining data and their properties. -/
theorem exists_printedCutoffModels {A : Type} [TopologicalSpace A] [DiscreteTopology A] [DecidableEq A]
    [Finite A] (S : Subshift A ℤ) (hinf : Infinite S.carrier) (hmin : IsMinimal S) :
    ∃ (x : ℤ → A) (m N : ℕ → ℕ) (_ : ∀ ℓ, NeZero (N ℓ))
      (D : ∀ ℓ, ClopenCoeff (subshiftHomeo S) (ZMod 2) →+* (ZMod (N ℓ) → ZMod 2)),
      x ∈ S.carrier ∧ (∀ ℓ, N ℓ = leastPeriod (periodicExt x (m ℓ))) ∧
      (∀ (ℓ : ℕ) (f : ClopenCoeff (subshiftHomeo S) (ZMod 2)), DependsOnWindow (subshiftHomeo S) ℓ f →
        ∀ (t : ℤ) (z : S.carrier), (∀ i : ℤ, |i| ≤ ℓ → z.1 i = periodicExt x (m ℓ) (t + i)) →
          D ℓ f (t : ZMod (N ℓ)) = (ClopenCoeff.of (subshiftHomeo S) (ZMod 2)).symm f z) ∧
      (∀ (ℓ ℓ' : ℕ) (f : ClopenCoeff (subshiftHomeo S) (ZMod 2)),
        DependsOnWindow (subshiftHomeo S) ℓ' f → ∀ g : Multiplicative ℤ, (ℓ' : ℤ) + |toAdd g| ≤ (ℓ : ℤ) →
          shiftMatrix (ZMod 2) (N ℓ) (toAdd g) * diagonal (D ℓ f) =
            diagonal (D ℓ (g • f)) * shiftMatrix (ZMod 2) (N ℓ) (toAdd g)) ∧
      (∀ ℓ, cutoffModel (D ℓ) ℓ 1 = 1) ∧
      (∀ ℓ, Subring.closure (cutoffModel (D ℓ) ℓ '' printedGeneratorsSet S) = ⊤) ∧
      ∀ r r' : R S, ∀ᶠ ℓ in atTop,
        cutoffModel (D ℓ) ℓ (r + r') = cutoffModel (D ℓ) ℓ r + cutoffModel (D ℓ) ℓ r' ∧
          cutoffModel (D ℓ) ℓ (r * r') = cutoffModel (D ℓ) ℓ r * cutoffModel (D ℓ) ℓ r' := by
  classical
  obtain ⟨⟨x, hx⟩⟩ := hinf.nonempty
  obtain ⟨m, N, hNz, D, hwords, hform, hcov, -, hmul⟩ :=
    exists_asymptoticModels S.isClosed S.mapsTo (Set.infinite_coe_iff.1 hinf) hmin (subshiftHomeo S)
      (fun _ => rfl) hx (ZMod 2)
  haveI : ∀ ℓ, NeZero (N ℓ) := hNz
  refine ⟨x, m, N, hNz, D, hx, fun ℓ => (hwords ℓ).2.2.1, fun ℓ f hf => hform ℓ f hf,
    fun ℓ ℓ' f hf g hg => ?_, fun ℓ => cutoffModel_one (D ℓ) ℓ, fun ℓ => ?_, fun r r' => ?_⟩
  · -- covariance (tex l.383–385)
    rw [shiftMatrix_mul_diagonal]
    exact congrArg (fun d => diagonal d * shiftMatrix (ZMod 2) (N ℓ) (toAdd g))
      (funext fun n => (hcov ℓ ℓ' f hf g hg n).symm)
  · -- generation (tex l.388–391)
    set c : ZMod (N ℓ) → A := fun t => periodicExt x (m ℓ) ((t.val : ℕ) : ℤ)
    have hpt : ∀ t : ℤ, ∃ z : ↥S.carrier, ∀ i : ℤ, |i| ≤ ℓ → z.1 i = periodicExt x (m ℓ) (t + i) := by
      intro t
      obtain ⟨z0, hz0, hz0w⟩ := (hwords ℓ).2.2.2.subset
        (⟨t - ℓ, rfl⟩ : ∃ s : ℤ, word (periodicExt x (m ℓ)) s (2 * ℓ + 1) =
          word (periodicExt x (m ℓ)) (t - ℓ) (2 * ℓ + 1))
      refine ⟨⟨shift (ℓ : ℤ) z0, S.mapsTo ℓ hz0⟩, fun i hi => ?_⟩
      obtain ⟨hi1, hi2⟩ := abs_le.mp hi
      obtain ⟨j, hj⟩ : ∃ j : ℕ, (j : ℤ) = ℓ + i := ⟨(ℓ + i).toNat, Int.toNat_of_nonneg (by omega)⟩
      have h := congrFun hz0w ⟨j, by omega⟩
      simp only [word_apply, zero_add] at h
      show z0 (ℓ + i) = _
      rw [← hj, h]
      congr 1
      omega
    have hletter : ∀ a : A, cutoffModel (D ℓ) ℓ (coeff (subshiftHomeo S) (ZMod 2) (letterIndicator S a)) =
        letterDiagonal c a := by
      intro a
      have hdep : DependsOnWindow (subshiftHomeo S) ℓ (ClopenCoeff.of _ (ZMod 2) (letterIndicator S a)) :=
        fun y z hyz => by
          show (if y.1 0 = a then (1 : ZMod 2) else 0) = if z.1 0 = a then 1 else 0
          rw [hyz 0 (by simp)]
      rw [coeff_apply, Pestov91.CrossedProduct.C_apply, cutoffModel_eq_of (D ℓ) fun g _ => by
        rw [SkewMonoidAlgebra.coeff_single_apply]
        split_ifs
        · exact hdep
        · exact dependsOnWindow_zero_or_one (Or.inl rfl), periodicModel_single, toAdd_one,
        shiftMatrix_zero, mul_one]
      refine congrArg diagonal (funext fun t => ?_)
      obtain ⟨z, hz⟩ := hpt ((t.val : ℕ) : ℤ)
      have hform' := hform ℓ _ hdep ((t.val : ℕ) : ℤ) z hz
      rw [Int.cast_natCast, ZMod.natCast_zmod_val] at hform'
      rw [hform']
      show (if z.1 0 = a then (1 : ZMod 2) else 0) = if c t = a then 1 else 0
      rw [hz 0 (by simp), add_zero]
    have hdist : ∀ t t' : ZMod (N ℓ), (∀ i : ZMod (N ℓ), c (t + i) = c (t' + i)) → t = t' :=
      translates_distinct_of_leastPeriod (periodicExt x (m ℓ)) (hwords ℓ).2.2.1.symm
    have hsub : periodicGenerators c ⊆ cutoffModel (D ℓ) ℓ '' printedGeneratorsSet S := by
      rintro _ (h | ⟨a, rfl⟩)
      · rcases h with rfl | rfl
        · refine ⟨((unit (subshiftHomeo S) (ZMod 2) : (R S)ˣ) : R S),
            Set.mem_insert_of_mem _ (Or.inl (Or.inl rfl)), ?_⟩
          simpa only [zpow_one] using cutoffModel_unit_zpow (D ℓ) ℓ 1
        · refine ⟨(((unit (subshiftHomeo S) (ZMod 2))⁻¹ : (R S)ˣ) : R S),
            Set.mem_insert_of_mem _ (Or.inl (Or.inr rfl)), ?_⟩
          simpa only [zpow_neg, zpow_one] using cutoffModel_unit_zpow (D ℓ) ℓ (-1)
      · exact ⟨_, Set.mem_insert_of_mem _ (Or.inr ⟨a, rfl⟩), hletter a⟩
    exact eq_top_iff.2
      ((subring_closure_periodicGenerators_eq_top c hdist).ge.trans (Subring.closure_mono hsub))
  · -- the identities for large `ℓ` (tex l.385–388)
    filter_upwards [eventually_cutoffModel_eq S.isClosed D r, eventually_cutoffModel_eq S.isClosed D r',
      eventually_cutoffModel_eq S.isClosed D (r + r'), eventually_cutoffModel_eq S.isClosed D (r * r'),
      hmul r r'] with ℓ hr hs hrs hrms hm
    exact ⟨by rw [hrs, hr, hs, map_add], by rw [hrms, hr, hs, hm]⟩

/-- **tex l.383–388**: for the periodic points `y_ℓ` of a point `x ∈ X`, with least periods `N_ℓ` and
`D_ℓ(f) δ_t = f(T^t y_ℓ)` for `f` depending only on `[-ℓ, ℓ]`, the covariance
`P^i D_ℓ(f) = D_ℓ(g • f) P^i` (`i = toAdd g`) holds whenever `f` depends only on `[-ℓ', ℓ']` with
`ℓ' + |i| ≤ ℓ`; for fixed `r, r' ∈ R` the printed `φ_ℓ = cutoffModel (D ℓ) ℓ` satisfy
`φ_ℓ(r + r') = φ_ℓ(r) + φ_ℓ(r')` and `φ_ℓ(r r') = φ_ℓ(r) φ_ℓ(r')` for large `ℓ`; and `φ_ℓ(1) = I`. -/
theorem manuscriptSentence_cutoffCovarianceIdentitiesUnit {A : Type} [TopologicalSpace A]
    [DiscreteTopology A] [DecidableEq A] [Finite A] (S : Subshift A ℤ) (hinf : Infinite S.carrier)
    (hmin : IsMinimal S) :
    ∃ (x : ℤ → A) (m N : ℕ → ℕ) (_ : ∀ ℓ, NeZero (N ℓ))
      (D : ∀ ℓ, ClopenCoeff (subshiftHomeo S) (ZMod 2) →+* (ZMod (N ℓ) → ZMod 2)),
      x ∈ S.carrier ∧ (∀ ℓ, N ℓ = leastPeriod (periodicExt x (m ℓ))) ∧
      (∀ (ℓ : ℕ) (f : ClopenCoeff (subshiftHomeo S) (ZMod 2)), DependsOnWindow (subshiftHomeo S) ℓ f →
        ∀ (t : ℤ) (z : S.carrier), (∀ i : ℤ, |i| ≤ ℓ → z.1 i = periodicExt x (m ℓ) (t + i)) →
          D ℓ f (t : ZMod (N ℓ)) = (ClopenCoeff.of (subshiftHomeo S) (ZMod 2)).symm f z) ∧
      (∀ (ℓ ℓ' : ℕ) (f : ClopenCoeff (subshiftHomeo S) (ZMod 2)),
        DependsOnWindow (subshiftHomeo S) ℓ' f → ∀ g : Multiplicative ℤ, (ℓ' : ℤ) + |toAdd g| ≤ (ℓ : ℤ) →
          shiftMatrix (ZMod 2) (N ℓ) (toAdd g) * diagonal (D ℓ f) =
            diagonal (D ℓ (g • f)) * shiftMatrix (ZMod 2) (N ℓ) (toAdd g)) ∧
      (∀ r r' : R S, ∀ᶠ ℓ in atTop,
        cutoffModel (D ℓ) ℓ (r + r') = cutoffModel (D ℓ) ℓ r + cutoffModel (D ℓ) ℓ r' ∧
          cutoffModel (D ℓ) ℓ (r * r') = cutoffModel (D ℓ) ℓ r * cutoffModel (D ℓ) ℓ r') ∧
      ∀ ℓ, cutoffModel (D ℓ) ℓ 1 = 1 := by
  obtain ⟨x, m, N, hNz, D, hx, hN, hform, hcov, h1, -, hid⟩ := exists_printedCutoffModels S hinf hmin
  exact ⟨x, m, N, hNz, D, hx, hN, hform, hcov, hid, h1⟩

/-- **tex l.390–391**: for the same models, `φ_ℓ(S)` generates the ring `M_{N_ℓ}(F₂)` for every `ℓ`;
so `R` is matricial via `S` (the hypothesis of `thm:general`(b)), and `thm:general` gives, for every
`n ≥ 3`, that `EL_n(R)` is infinite, finitely generated, simple and Kazhdan, a marked limit of the
finite simple groups `SL_{nN}(F₂)` whose Cayley graphs form expanders, and LEF, sofic and hyperlinear. -/
theorem manuscriptSentence_cutoffImageGeneratesMatrixRingAndGeneralApplies {A : Type}
    [TopologicalSpace A] [DiscreteTopology A] [DecidableEq A] [Finite A] (S : Subshift A ℤ)
    (hinf : Infinite S.carrier) (hmin : IsMinimal S) :
    (∃ (x : ℤ → A) (m N : ℕ → ℕ) (_ : ∀ ℓ, NeZero (N ℓ))
      (D : ∀ ℓ, ClopenCoeff (subshiftHomeo S) (ZMod 2) →+* (ZMod (N ℓ) → ZMod 2)),
      x ∈ S.carrier ∧ (∀ ℓ, N ℓ = leastPeriod (periodicExt x (m ℓ))) ∧
      (∀ (ℓ : ℕ) (f : ClopenCoeff (subshiftHomeo S) (ZMod 2)), DependsOnWindow (subshiftHomeo S) ℓ f →
        ∀ (t : ℤ) (z : S.carrier), (∀ i : ℤ, |i| ≤ ℓ → z.1 i = periodicExt x (m ℓ) (t + i)) →
          D ℓ f (t : ZMod (N ℓ)) = (ClopenCoeff.of (subshiftHomeo S) (ZMod 2)).symm f z) ∧
      ∀ ℓ, Subring.closure (cutoffModel (D ℓ) ℓ '' printedGeneratorsSet S) = ⊤) ∧
    (∃ (N : ℕ → ℕ) (φ : ∀ k, R S → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)),
      IsMatricialVia (printedGenerators S) N φ) ∧
    ∀ n : ℕ, 3 ≤ n →
      Infinite ↥(elementaryGroup (Fin n) (R S)) ∧ Group.FG ↥(elementaryGroup (Fin n) (R S)) ∧
        IsSimpleGroup ↥(elementaryGroup (Fin n) (R S)) ∧
        HasKazhdanPropertyT.{0, 0} ↥(elementaryGroup (Fin n) (R S)) ∧
        PrintedMarkedLimitExpanders S n ∧ IsLEF ↥(elementaryGroup (Fin n) (R S)) ∧
        IsSofic ↥(elementaryGroup (Fin n) (R S)) ∧ IsHyperlinear ↥(elementaryGroup (Fin n) (R S)) := by
  obtain ⟨x, m, N, hNz, D, hx, hN, hform, -, -, hgen, -⟩ := exists_printedCutoffModels S hinf hmin
  exact ⟨⟨x, m, N, hNz, D, hx, hN, hform, hgen⟩, printedPeriodicMatricialStatement A S hinf hmin,
    fun n hn => printedSimpleKazhdanSoficMain A S hinf hmin n hn⟩

end GroupApproximation.Manuscript.SimpleKazhdanSofic.AbstractIntro

