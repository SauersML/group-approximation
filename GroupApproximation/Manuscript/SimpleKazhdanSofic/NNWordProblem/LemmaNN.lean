import GroupApproximation.Manuscript.SimpleKazhdanSofic.LEFLevelEmbedding
import GroupApproximation.Meta.AxiomGuard

/-!
# `lem:nn`: countable LEF groups in the commutator subgroup of a two-generated LEF group

Sentences of `simple_kazhdan_sofic_group.tex`, `lem:nn` and its proof (l.489–525).

* l.490–491: "Every countable LEF group is a subgroup of `[Δ,Δ]` for an infinite LEF group `Δ`
  generated by two elements."
* l.495–497: "Let `Γ={γ_1,γ_2,…}` be a countable LEF group; replacing `Γ` by `Γ×ℤ`, we may assume
  that `Γ` is infinite."
* l.499–502: "On `Q_k×ℤ/m_k`, with `m_k=|Q_k|`, let `t_k` add `1` to the second coordinate, and let
  `f_jk` multiply the first coordinate of `(x,i)` from the left by `μ_k(γ_j)^i`, which is well
  defined because the order of `μ_k(γ_j)` divides `m_k`."
* l.504–508: "On `Q_k×ℤ/m_k×ℤ/4^{k+1}` let `b_k` add `1` to the last coordinate, and let `a_k` act
  on the level `i` […] by `f_jk` if `i=2^{2j-1}` and by `t_k` if `i=4^j`, for `j≤k`, and trivially
  on the other levels."
* l.509–513: "As distinct ordered pairs of distinct powers of `2` have distinct nonzero differences,
  all of absolute value below a quarter of the modulus, the two conjugates in
  `w_j=[b^{-2^{2j-1}}ab^{2^{2j-1}}, b^{-4^j}ab^{4^j}]`, evaluated at `(a_k,b_k)`, cannot both act
  nontrivially on a level other than `0`."
* l.513–515: "So `w_j(a_k,b_k)` acts by `[f_jk,t_k]` on the level `0` and trivially on the other
  levels, for `j≤k`."
* l.522–524: "Finitely many equations and inequalities that hold in the ultraproduct hold in some
  coordinate, so `Δ` is LEF, and `Δ` is infinite because it contains `Γ`."

## Proof route

The construction is the one of `GroupApproximation.GroupTheory.LevelCommutatorWords(Levels)` and
`GroupApproximation.Manuscript.SimpleKazhdanSofic.LEFLevelEmbedding`: `tPerm`, `fPerm`, `aPerm`,
`bPerm`, `word`, the models `LEFLevelEmbedding.Models` of `Γ × ℤ`, and the subgroup
`LEFLevelEmbedding.Delta` of the algebraic ultraproduct generated by `a = (a_k)_k` and
`b = (b_k)_k`.  All reused results are closed (no statement hypotheses).  Here we add the
two-generation of `Δ` (the closure of the two generators, viewed inside `Δ`, is `⊤`), the
integer form of the power-of-two differences (nonzero, injective on ordered pairs, and below a
quarter of the modulus), the level-by-level description of `a_k`, `b_k` and `w_j(a_k,b_k)`, and the
statement that finitely many equations and inequalities of an ultraproduct hold in one coordinate.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace NNWordProblem

open Filter AlgebraicUltraproduct LevelCommutatorWords LEFLevelEmbedding
open scoped commutatorElement

/-! ### Two-generation of `Δ` -/

/-- If `H` is the closure of `{a, b}`, then `H` is generated by the two elements `a` and `b` of
`H`. -/
theorem closure_pair_eq_top {G : Type*} [Group G] {H : Subgroup G} {a b : G}
    (hH : H = Subgroup.closure {a, b}) (x y : H) (hx : (x : G) = a) (hy : (y : G) = b) :
    Subgroup.closure ({x, y} : Set H) = ⊤ := by
  subst hH
  have hset : ({x, y} : Set (Subgroup.closure ({a, b} : Set G))) =
      ((↑) : Subgroup.closure ({a, b} : Set G) → G) ⁻¹' {a, b} := by
    ext z
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_preimage, Subtype.ext_iff, hx, hy]
  rw [hset]
  exact Subgroup.closure_closure_coe_preimage

/-- `Δ` is generated by the two elements `a` and `b`. -/
theorem delta_two_generated {Γ : Type} [Group Γ] (M : Models Γ) (ω : Ultrafilter ℕ) :
    ∃ a b : Delta M ω, Subgroup.closure ({a, b} : Set (Delta M ω)) = ⊤ := by
  have ha : (QuotientGroup.mk (aSeq M) : Ultraproduct ω (SymX M)) ∈ Delta M ω :=
    Subgroup.subset_closure (Set.mem_insert _ _)
  have hb : (QuotientGroup.mk (bSeq M) : Ultraproduct ω (SymX M)) ∈ Delta M ω :=
    Subgroup.subset_closure (Set.mem_insert_of_mem _ rfl)
  exact ⟨⟨_, ha⟩, ⟨_, hb⟩, closure_pair_eq_top (H := Delta M ω)
    (a := QuotientGroup.mk (aSeq M)) (b := QuotientGroup.mk (bSeq M)) rfl ⟨_, ha⟩ ⟨_, hb⟩ rfl rfl⟩

#audit_axioms closure_pair_eq_top
#audit_axioms delta_two_generated

/-! ### l.490–491: the lemma -/

/-- **tex l.490–491 (`lem:nn`).**  Every countable LEF group `Γ` is a subgroup of `[Δ,Δ]` for an
infinite LEF group `Δ` generated by two elements. -/
theorem manuscriptSentence_countableLEFGroupInCommutatorOfTwoGenerated (Γ : Type) [Group Γ]
    (hc : Countable Γ) (hΓ : IsLEF Γ) :
    ∃ (Δ : Type) (_ : Group Δ), Infinite Δ ∧ IsLEF Δ ∧
      (∃ a b : Δ, Subgroup.closure ({a, b} : Set Δ) = ⊤) ∧
      ∃ f : Γ →* Δ, Function.Injective f ∧ f.range ≤ commutator Δ := by
  haveI : Countable Γ := hc
  haveI : Countable (Multiplicative ℤ) := inferInstanceAs (Countable ℤ)
  haveI : Infinite (Multiplicative ℤ) := inferInstanceAs (Infinite ℤ)
  have hΓ' : IsTextbookLEF (Γ × Multiplicative ℤ) :=
    isTextbookLEF_prod ((isLEF_iff_textbook Γ).1 hΓ) isTextbookLEF_multiplicative_int
  obtain ⟨M⟩ := models_nonempty (inferInstance : Countable (Γ × Multiplicative ℤ)) hΓ'
  have hω : ((Filter.hyperfilter ℕ : Ultrafilter ℕ) : Filter ℕ) ≤ cofinite :=
    Filter.hyperfilter_le_cofinite
  refine ⟨Delta M (Filter.hyperfilter ℕ), inferInstance, infinite_delta M hω,
    isLEF_delta M (Filter.hyperfilter ℕ), delta_two_generated M (Filter.hyperfilter ℕ),
    (embeddingΔ M hω).comp (MonoidHom.inl Γ (Multiplicative ℤ)), ?_, ?_⟩
  · exact (embeddingΔ_injective M hω).comp fun _ _ h => congrArg Prod.fst h
  · intro y hy
    obtain ⟨x, rfl⟩ := MonoidHom.mem_range.1 hy
    exact embeddingΔ_mem_commutator M hω _

#audit_axioms manuscriptSentence_countableLEFGroupInCommutatorOfTwoGenerated

/-! ### l.495–497: enumeration, and the reduction to `Γ × ℤ` -/

/-- **tex l.495–497.**  A countable group is enumerated as `γ_1, γ_2, …`; for a countable LEF group
`Γ`, the group `Γ × ℤ` is countable, infinite and LEF and contains `Γ`; and an embedding of `Γ × ℤ`
into `[Δ,Δ]` restricts to an embedding of `Γ` into `[Δ,Δ]`, so we may assume that `Γ` is
infinite. -/
theorem manuscriptSentence_enumerateAndReplaceByProductWithInt :
    (∀ (Γ : Type) [Group Γ], Countable Γ → ∃ γ : ℕ → Γ, ∀ x : Γ, ∃ j, 1 ≤ j ∧ γ j = x) ∧
    (∀ (Γ : Type) [Group Γ], Countable Γ → IsLEF Γ →
      Countable (Γ × Multiplicative ℤ) ∧ Infinite (Γ × Multiplicative ℤ) ∧
        IsLEF (Γ × Multiplicative ℤ) ∧ Function.Injective (MonoidHom.inl Γ (Multiplicative ℤ))) ∧
    ∀ (Γ Δ : Type) [Group Γ] [Group Δ] (f : Γ × Multiplicative ℤ →* Δ), Function.Injective f →
      f.range ≤ commutator Δ → ∃ f' : Γ →* Δ, Function.Injective f' ∧ f'.range ≤ commutator Δ := by
  refine ⟨?_, ?_, ?_⟩
  · intro Γ _ hc
    haveI : Countable Γ := hc
    obtain ⟨e, he⟩ := exists_surjective_nat Γ
    refine ⟨fun j => e (j - 1), fun x => ?_⟩
    obtain ⟨n, rfl⟩ := he x
    exact ⟨n + 1, by omega, by simp⟩
  · intro Γ _ hc hΓ
    haveI : Countable Γ := hc
    haveI : Countable (Multiplicative ℤ) := inferInstanceAs (Countable ℤ)
    haveI : Infinite (Multiplicative ℤ) := inferInstanceAs (Infinite ℤ)
    exact ⟨inferInstance, inferInstance,
      (isLEF_iff_textbook _).2
        (isTextbookLEF_prod ((isLEF_iff_textbook Γ).1 hΓ) isTextbookLEF_multiplicative_int),
      fun _ _ h => congrArg Prod.fst h⟩
  · intro Γ Δ _ _ f hf hr
    refine ⟨f.comp (MonoidHom.inl Γ (Multiplicative ℤ)),
      hf.comp fun _ _ h => congrArg Prod.fst h, ?_⟩
    intro y hy
    obtain ⟨x, rfl⟩ := MonoidHom.mem_range.1 hy
    exact hr (MonoidHom.mem_range.2 ⟨(x, 1), rfl⟩)

#audit_axioms manuscriptSentence_enumerateAndReplaceByProductWithInt

/-! ### l.499–502: `t_k` and `f_jk` -/

/-- **tex l.499–502.**  On `Q × ℤ/m`, `m = |Q|`, the permutation `t` adds `1` to the second
coordinate, and `f_x` multiplies the first coordinate of `(y, n)` from the left by `x ^ n`; this is
well defined because the order of `x` divides `m`, so `x ^ n` depends only on `n` modulo `m`. -/
theorem manuscriptSentence_tAndFOnFiniteModel (Q : Type) [Group Q] [Fintype Q] (x : Q) :
    (∀ (y : Q) (i : ZMod (Fintype.card Q)), tPerm Q (y, i) = (y, i + 1)) ∧
      orderOf x ∣ Fintype.card Q ∧
      (∀ n n' : ℕ, (n : ZMod (Fintype.card Q)) = n' → x ^ n = x ^ n') ∧
      ∀ (y : Q) (n : ℕ),
        fPerm Q x (y, (n : ZMod (Fintype.card Q))) = (x ^ n * y, (n : ZMod (Fintype.card Q))) := by
  refine ⟨fun _ _ => rfl, orderOf_dvd_card, fun n n' h => ?_, fun y n => ?_⟩
  · have h' := congrArg ZMod.val h
    rw [ZMod.val_natCast, ZMod.val_natCast] at h'
    rw [← pow_mod_card x n, h', pow_mod_card]
  · simp only [fPerm, levelwise_apply, Equiv.coe_mulLeft]
    rw [ZMod.val_natCast, pow_mod_card]

#audit_axioms manuscriptSentence_tAndFOnFiniteModel

/-! ### l.504–508: `a_k` and `b_k` on the levels -/

/-- **tex l.504–508.**  On `Q × ℤ/m × ℤ/4^{k+1}`, `b_k` adds `1` to the last coordinate, and `a_k`
acts on the level `2^{2j-1}` by `f_jk` (with `μ_k(γ_j) = g j`), on the level `4^j` by `t_k`, for
`1 ≤ j ≤ k`, and trivially on all other levels. -/
theorem manuscriptSentence_aAndBOnLevels (Q : Type) [Group Q] [Fintype Q] (k : ℕ) (g : ℕ → Q) :
    (∀ z : (Q × ZMod (Fintype.card Q)) × ZMod (4 ^ (k + 1)), bPerm Q k z = (z.1, z.2 + 1)) ∧
    (∀ j : ℕ, 1 ≤ j → j ≤ k → ∀ z : Q × ZMod (Fintype.card Q),
      aPerm Q k g (z, ((2 ^ (2 * j - 1) : ℕ) : ZMod (4 ^ (k + 1)))) =
        (fPerm Q (g j) z, ((2 ^ (2 * j - 1) : ℕ) : ZMod (4 ^ (k + 1))))) ∧
    (∀ j : ℕ, 1 ≤ j → j ≤ k → ∀ z : Q × ZMod (Fintype.card Q),
      aPerm Q k g (z, ((4 ^ j : ℕ) : ZMod (4 ^ (k + 1)))) =
        (tPerm Q z, ((4 ^ j : ℕ) : ZMod (4 ^ (k + 1))))) ∧
    ∀ i : ZMod (4 ^ (k + 1)),
      (∀ j : ℕ, 1 ≤ j → j ≤ k →
        i ≠ ((2 ^ (2 * j - 1) : ℕ) : ZMod (4 ^ (k + 1))) ∧ i ≠ ((4 ^ j : ℕ) : ZMod (4 ^ (k + 1)))) →
      ∀ z : Q × ZMod (Fintype.card Q), aPerm Q k g (z, i) = (z, i) := by
  refine ⟨fun _ => rfl, fun j hj hjk z => ?_, fun j hj hjk z => ?_, fun i hi z => ?_⟩
  · simp only [aPerm, levelwise_apply]
    rw [levelAction_two_pow Q k g (r := 2 * j - 1) (by omega) (by omega), letter_odd Q g hj]
  · simp only [aPerm, levelwise_apply]
    rw [four_pow_eq j, levelAction_two_pow Q k g (r := 2 * j) (by omega) (by omega),
      letter_even Q g j]
  · have hnot : ¬ IsLevel k i.val := by
      rintro ⟨h1, h2, h3⟩
      have hcast : i = ((2 ^ Nat.log 2 i.val : ℕ) : ZMod (4 ^ (k + 1))) := by
        rw [← h3, ZMod.natCast_zmod_val]
      rcases Nat.even_or_odd (Nat.log 2 i.val) with ⟨j, hj⟩ | ⟨j, hj⟩
      · have hj' : Nat.log 2 i.val = 2 * j := by omega
        exact (hi j (by omega) (by omega)).2 (by rw [hcast, hj', four_pow_eq j])
      · have hj' : Nat.log 2 i.val = 2 * (j + 1) - 1 := by omega
        exact (hi (j + 1) (by omega) (by omega)).1 (by rw [hcast, hj'])
    simp only [aPerm, levelwise_apply]
    rw [levelAction_eq_one Q k g hnot, Equiv.Perm.one_apply]

#audit_axioms manuscriptSentence_aAndBOnLevels

/-! ### l.509–513: the two conjugates cannot both act off the level `0` -/

/-- Distinct ordered pairs of distinct powers of `2` have distinct differences. -/
theorem int_two_pow_sub_inj (r s r' s' : ℕ) (hrs : r ≠ s) (hrs' : r' ≠ s')
    (h : (2 : ℤ) ^ s - 2 ^ r = 2 ^ s' - 2 ^ r') : r = r' ∧ s = s' := by
  rcases lt_or_gt_of_ne hrs with hlt | hgt <;> rcases lt_or_gt_of_ne hrs' with hlt' | hgt'
  · have hle : 2 ^ r ≤ 2 ^ s := Nat.pow_le_pow_right (by norm_num) hlt.le
    have hle' : 2 ^ r' ≤ 2 ^ s' := Nat.pow_le_pow_right (by norm_num) hlt'.le
    exact two_pow_sub_two_pow_inj r s r' s' hlt hlt' (by zify [hle, hle']; linarith)
  · exfalso
    linarith [pow_lt_pow_right₀ (by norm_num : (1 : ℤ) < 2) hlt,
      pow_lt_pow_right₀ (by norm_num : (1 : ℤ) < 2) hgt']
  · exfalso
    linarith [pow_lt_pow_right₀ (by norm_num : (1 : ℤ) < 2) hgt,
      pow_lt_pow_right₀ (by norm_num : (1 : ℤ) < 2) hlt']
  · have hle : 2 ^ s ≤ 2 ^ r := Nat.pow_le_pow_right (by norm_num) hgt.le
    have hle' : 2 ^ s' ≤ 2 ^ r' := Nat.pow_le_pow_right (by norm_num) hgt'.le
    have hres := two_pow_sub_two_pow_inj s r s' r' hgt hgt' (by zify [hle, hle']; linarith)
    exact ⟨hres.2, hres.1⟩

/-- The difference of two distinct powers of `2` is nonzero. -/
theorem two_pow_sub_ne_zero (r s : ℕ) (hrs : r ≠ s) : (2 : ℤ) ^ s - 2 ^ r ≠ 0 := by
  intro h
  rcases lt_or_gt_of_ne hrs with hlt | hgt
  · linarith [pow_lt_pow_right₀ (by norm_num : (1 : ℤ) < 2) hlt]
  · linarith [pow_lt_pow_right₀ (by norm_num : (1 : ℤ) < 2) hgt]

/-- The differences of the powers `2^r`, `r ≤ 2k`, have absolute value below a quarter of the
modulus `4^{k+1}`. -/
theorem abs_two_pow_sub_lt (k r s : ℕ) (hr : r ≤ 2 * k) (hs : s ≤ 2 * k) :
    4 * |(2 : ℤ) ^ s - 2 ^ r| < 4 ^ (k + 1) := by
  have h5 : (4 : ℤ) ^ (k + 1) = 2 ^ (2 * k) * 4 := by rw [pow_succ, pow_mul]; norm_num
  have h6 : |(2 : ℤ) ^ s - 2 ^ r| < 2 ^ (2 * k) :=
    abs_sub_lt_iff.2
      ⟨by linarith [(one_le_pow₀ (by norm_num : (1 : ℤ) ≤ 2) : (1 : ℤ) ≤ 2 ^ r),
          (pow_le_pow_right₀ (by norm_num : (1 : ℤ) ≤ 2) hs : (2 : ℤ) ^ s ≤ 2 ^ (2 * k))],
        by linarith [(one_le_pow₀ (by norm_num : (1 : ℤ) ≤ 2) : (1 : ℤ) ≤ 2 ^ s),
          (pow_le_pow_right₀ (by norm_num : (1 : ℤ) ≤ 2) hr : (2 : ℤ) ^ r ≤ 2 ^ (2 * k))]⟩
  rw [h5]
  linarith

/-- On a level `i ≠ 0`, one of the two conjugates in `w_j(a_k,b_k)` acts trivially. -/
theorem conjugate_trivial (Q : Type) [Group Q] [Fintype Q] (k : ℕ) (g : ℕ → Q) {j : ℕ}
    (hj : 1 ≤ j) (hjk : j ≤ k) (i : ZMod (4 ^ (k + 1))) (hi : i ≠ 0) :
    (∀ z : Q × ZMod (Fintype.card Q),
      conjPow (aPerm Q k g) (bPerm Q k) (2 ^ (2 * j - 1)) (z, i) = (z, i)) ∨
    ∀ z : Q × ZMod (Fintype.card Q), conjPow (aPerm Q k g) (bPerm Q k) (4 ^ j) (z, i) = (z, i) := by
  by_cases hx : IsLevel k (i + ((2 ^ (2 * j - 1) : ℕ) : ZMod (4 ^ (k + 1)))).val
  · by_cases hy : IsLevel k (i + ((2 ^ (2 * j) : ℕ) : ZMod (4 ^ (k + 1)))).val
    · exact absurd (level_difference_zero k hj hjk hx hy) hi
    · right
      intro z
      rw [conjPow_aPerm_bPerm, four_pow_eq j]
      simp only [levelwise_apply]
      rw [levelAction_eq_one Q k g hy, Equiv.Perm.one_apply]
  · left
    intro z
    rw [conjPow_aPerm_bPerm]
    simp only [levelwise_apply]
    rw [levelAction_eq_one Q k g hx, Equiv.Perm.one_apply]

#audit_axioms int_two_pow_sub_inj
#audit_axioms two_pow_sub_ne_zero
#audit_axioms abs_two_pow_sub_lt
#audit_axioms conjugate_trivial

/-- **tex l.509–513.**  Distinct ordered pairs of distinct powers of `2` have distinct nonzero
differences, all of absolute value below a quarter of the modulus `4^{k+1}` (for exponents
`≤ 2k`); so the two conjugates `b^{-2^{2j-1}} a b^{2^{2j-1}}` and `b^{-4^j} a b^{4^j}` in `w_j`,
evaluated at `(a_k, b_k)`, cannot both act nontrivially on a level `i ≠ 0`. -/
theorem manuscriptSentence_conjugatesCannotBothActOffLevelZero :
    (∀ r s r' s' : ℕ, r ≠ s → r' ≠ s' → (2 : ℤ) ^ s - 2 ^ r = 2 ^ s' - 2 ^ r' →
      r = r' ∧ s = s') ∧
    (∀ r s : ℕ, r ≠ s → (2 : ℤ) ^ s - 2 ^ r ≠ 0) ∧
    (∀ k r s : ℕ, r ≤ 2 * k → s ≤ 2 * k → 4 * |(2 : ℤ) ^ s - 2 ^ r| < 4 ^ (k + 1)) ∧
    ∀ (Q : Type) [Group Q] [Fintype Q] (k : ℕ) (g : ℕ → Q) (j : ℕ), 1 ≤ j → j ≤ k →
      ∀ i : ZMod (4 ^ (k + 1)), i ≠ 0 →
        (∀ z : Q × ZMod (Fintype.card Q),
          conjPow (aPerm Q k g) (bPerm Q k) (2 ^ (2 * j - 1)) (z, i) = (z, i)) ∨
        ∀ z : Q × ZMod (Fintype.card Q),
          conjPow (aPerm Q k g) (bPerm Q k) (4 ^ j) (z, i) = (z, i) := by
  refine ⟨int_two_pow_sub_inj, two_pow_sub_ne_zero, abs_two_pow_sub_lt, ?_⟩
  intro Q _ _ k g j hj hjk i hi
  exact conjugate_trivial Q k g hj hjk i hi

#audit_axioms manuscriptSentence_conjugatesCannotBothActOffLevelZero

/-! ### l.513–515: the word `w_j(a_k,b_k)` -/

/-- **tex l.513–515.**  For `1 ≤ j ≤ k`, `w_j(a_k,b_k)` acts by `[f_jk,t_k]` on the level `0` and
trivially on the other levels. -/
theorem manuscriptSentence_wordActsOnLevelZero :
    ∀ (Q : Type) [Group Q] [Fintype Q] (k : ℕ) (g : ℕ → Q) (j : ℕ), 1 ≤ j → j ≤ k →
      ∀ (z : Q × ZMod (Fintype.card Q)) (i : ZMod (4 ^ (k + 1))),
        word j (aPerm Q k g) (bPerm Q k) (z, i) =
          if i = 0 then (⁅fPerm Q (g j), tPerm Q⁆ z, i) else (z, i) := by
  intro Q _ _ k g j hj hjk z i
  rw [word_aPerm_bPerm Q k g hj hjk, commutator_fPerm_tPerm]
  by_cases hi : i = 0
  · subst hi
    simp [levelZeroMul]
  · simp [levelZeroMul, hi]

#audit_axioms manuscriptSentence_wordActsOnLevelZero

/-! ### l.522–524: `Δ` is LEF and infinite -/

/-- Finitely many equations `x * y = z` and inequalities `x ≠ y` that hold in an algebraic
ultraproduct hold, for chosen representatives, in some coordinate. -/
theorem exists_coordinate {ι : Type*} (ω : Ultrafilter ι) (G : ι → Type*) [∀ i, Group (G i)]
    (E : Finset (Ultraproduct ω G × Ultraproduct ω G × Ultraproduct ω G))
    (N : Finset (Ultraproduct ω G × Ultraproduct ω G))
    (hE : ∀ e ∈ E, e.1 * e.2.1 = e.2.2) (hN : ∀ n ∈ N, n.1 ≠ n.2) :
    ∃ i, (∀ e ∈ E, out ω G e.1 i * out ω G e.2.1 i = out ω G e.2.2 i) ∧
      ∀ n ∈ N, out ω G n.1 i ≠ out ω G n.2 i := by
  have hmul : ∀ e ∈ E,
      ∀ᶠ i in (ω : Filter ι), out ω G e.1 i * out ω G e.2.1 i = out ω G e.2.2 i := by
    intro e he
    have h : (QuotientGroup.mk (out ω G e.1 * out ω G e.2.1) : Ultraproduct ω G) =
        QuotientGroup.mk (out ω G e.2.2) := by
      rw [QuotientGroup.mk_mul, AlgebraicUltraproduct.mk_out, AlgebraicUltraproduct.mk_out,
        AlgebraicUltraproduct.mk_out]
      exact hE e he
    exact (mk_eq_mk_iff ω G).1 h
  have hne : ∀ n ∈ N, ∀ᶠ i in (ω : Filter ι), ¬ out ω G n.1 i = out ω G n.2 i := by
    intro n hn
    refine Ultrafilter.eventually_not.2 fun h => hN n hn ?_
    rw [← AlgebraicUltraproduct.mk_out ω G n.1, ← AlgebraicUltraproduct.mk_out ω G n.2]
    exact (mk_eq_mk_iff ω G).2 h
  exact (((Filter.eventually_all_finset E).2 hmul).and
    ((Filter.eventually_all_finset N).2 hne)).exists

#audit_axioms exists_coordinate

/-- **tex l.522–524.**  Finitely many equations and inequalities that hold in the ultraproduct hold
in some coordinate; so every subgroup of an algebraic ultraproduct of finite groups, in particular
`Δ`, is LEF; and `Δ` is infinite because it contains (an injective image of) the infinite group
`Γ`. -/
theorem manuscriptSentence_finitelyManyRelationsInSomeCoordinate :
    (∀ (ι : Type) (ω : Ultrafilter ι) (G : ι → Type) [∀ i, Group (G i)]
      (E : Finset (Ultraproduct ω G × Ultraproduct ω G × Ultraproduct ω G))
      (N : Finset (Ultraproduct ω G × Ultraproduct ω G)),
      (∀ e ∈ E, e.1 * e.2.1 = e.2.2) → (∀ n ∈ N, n.1 ≠ n.2) →
        ∃ i, (∀ e ∈ E, out ω G e.1 i * out ω G e.2.1 i = out ω G e.2.2 i) ∧
          ∀ n ∈ N, out ω G n.1 i ≠ out ω G n.2 i) ∧
    (∀ (ι : Type) (ω : Ultrafilter ι) (G : ι → Type) [∀ i, Group (G i)] [∀ i, Finite (G i)]
      (H : Subgroup (Ultraproduct ω G)), IsLEF H) ∧
    ∀ (Γ : Type) [Group Γ] [Infinite Γ] (M : Models Γ) (ω : Ultrafilter ℕ),
      (ω : Filter ℕ) ≤ cofinite →
        IsLEF (Delta M ω) ∧ Infinite (Delta M ω) ∧ ∃ f : Γ →* Delta M ω, Function.Injective f := by
  refine ⟨?_, ?_, ?_⟩
  · intro ι ω G _ E N hE hN
    exact exists_coordinate ω G E N hE hN
  · intro ι ω G _ _ H
    exact isLEF_subgroup_ultraproduct ω G H
  · intro Γ _ _ M ω hω
    exact ⟨isLEF_delta M ω, infinite_delta M hω, embeddingΔ M hω, embeddingΔ_injective M hω⟩

