/-!
# `thm:general` of `simple_kazhdan_sofic_group.tex`: the printed statement

Theorem `thm:general` (tex l.172–189):

> (l.173–175) Let a finitely generated group $\Lambda$ act minimally and topologically freely on a
> Cantor set $C$, and let the ring $R=\LC(C,\F_2)\rtimes\Lambda$ be generated by a finite set $S\ni1$.
>
> (l.177–178) [(a)] For every $n\ge3$, the group $\EL_n(R)$ is an infinite, finitely generated,
> simple Kazhdan group.
>
> (l.179–184) [(b)] Suppose that there are maps $\varphi_k\colon R\to M_{N_k}(\F_2)$ with
> $\varphi_k(1)=I$ such that $\varphi_k(S)$ generates the ring $M_{N_k}(\F_2)$, and for all
> $r,r'\in R$ and all large $k$, depending on $r$ and $r'$, we have
> $\varphi_k(r+r')=\varphi_k(r)+\varphi_k(r')$ and $\varphi_k(rr')=\varphi_k(r)\varphi_k(r')$.
>
> (l.184–187) Then for every $n\ge3$, $\EL_n(R)$, marked by the $e_{ij}(s)$ with $s\in S$, is an
> expander limit of the finite simple groups $\SL_{nN_k}(\F_2)$ marked by the $e_{ij}(\varphi_k(s))$.

The expander limit is the notion of tex l.92–100: marked convergence, the `Q_k` finite with
`|Q_k| → ∞`, and a uniform `ε > 0` such that every set of at most `|Q_k|/2` elements has at least
`ε` times as many neighbours outside it as it has elements, the neighbours of an element being its
products with the entries of the marking and their inverses.

## Formalization

* A Cantor set is carried by the instances `[CompactSpace C] [MetrizableSpace C]
  [TotallyDisconnectedSpace C] [PerfectSpace C] [Nonempty C]`; the action by
  `[MulAction Λ C] [ContinuousConstSMul Λ C]`; `R` is `ClopenGroupCrossedProduct Λ C (ZMod 2)`.
* `IsGeneralSetting Λ C S`: the printed setting (minimal, topologically free, `1 ∈ S`, `S`
  generates `R` as a ring).
* `rightNeighbourBoundary q F`, `IsExpanderLimit s σ`: the printed expander limit.
* `(b)`'s maps are `IsMatricialVia S N φ` (`GeneralTheorem`), which also records `N_k ≥ 1`,
  presupposed by "the finite simple groups `SL_{nN_k}(F₂)`".

## Proof route

* (a): property (T) and infiniteness are `printedGroupCrossedProductPropertyTInfinite` (the
  Ershov--Jaikin-Zapirain theorem proved in this repository, `printedEJZTheorem`); finite generation
  follows from property (T) (`KazhdanFiniteGeneration.fg_of_hasKazhdanPropertyT`); simplicity is
  `printedGeneralSimplicityStatement`.
* (b): `printedSimpleKazhdanGeneral` gives the marked limit, simplicity of `EL_n(M_{N_k}(F₂))` and
  edge expansion of the finite Cayley graphs.  `elementaryBlockEquivSL` carries
  `EL_n(M_{N_k}(F₂))` onto `SL_{nN_k}(F₂)`.  Edge expansion for left multiplication on `F⁻¹` gives
  vertex expansion for right neighbours of `F` with constant `ε / (|ι| + 1)`
  (`exists_vertexExpansion_of_isExpanderFamily`).
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace GeneralRing

open Filter

/-! ## The setting -/

/-- **The setting of `thm:general`** (tex l.173–175): `Λ` acts minimally and topologically freely
(no nontrivial element fixes a nonempty open set pointwise) on `C`, and the finite set `S ∋ 1`
generates `R = LC(C, F₂) ⋊ Λ` as a ring. -/
def IsGeneralSetting (Λ : Type) [Group Λ] (C : Type) [TopologicalSpace C] [MulAction Λ C]
    [ContinuousConstSMul Λ C] (S : Finset (ClopenGroupCrossedProduct Λ C (ZMod 2))) : Prop :=
  MulAction.IsMinimal Λ C ∧
    (∀ ξ : Λ, ξ ≠ 1 → ∀ U : Set C, IsOpen U → U.Nonempty → ∃ z ∈ U, ξ • z ≠ z) ∧
    1 ∈ S ∧ Subring.closure (S : Set (ClopenGroupCrossedProduct Λ C (ZMod 2))) = ⊤

/-! ## Expander limits (tex l.92–100) -/

/-- The neighbours outside `F` in the Cayley graph of `Q` for the marking `q`: the products `x q_i`
and `x q_i⁻¹` with `x ∈ F` that do not lie in `F`. -/
def rightNeighbourBoundary {ι Q : Type*} [Group Q] (q : ι → Q) (F : Set Q) : Set Q :=
  {y | y ∉ F ∧ ∃ x ∈ F, ∃ i, y = x * q i ∨ y = x * (q i)⁻¹}

theorem mem_rightNeighbourBoundary {ι Q : Type*} [Group Q] {q : ι → Q} {F : Set Q} {y : Q} :
    y ∈ rightNeighbourBoundary q F ↔ y ∉ F ∧ ∃ x ∈ F, ∃ i, y = x * q i ∨ y = x * (q i)⁻¹ :=
  Iff.rfl

/-- **Expander limit** (tex l.92–100): `(G, s)` is the limit of the marked groups `(H ℓ, σ ℓ)`, the
markings have the same finite length, the `H ℓ` are finite with `|H ℓ| → ∞`, and there is `ε > 0`
such that every set of at most `|H ℓ|/2` elements has at least `ε` times as many neighbours outside
it as it has elements. -/
def IsExpanderLimit {ι G : Type*} [Group G] (s : ι → G) {H : ℕ → Type*} [∀ ℓ, Group (H ℓ)]
    (σ : ∀ ℓ, ι → H ℓ) : Prop :=
  IsMarkedLimit s σ ∧ Finite ι ∧ (∀ ℓ, Finite (H ℓ)) ∧
    Tendsto (fun ℓ => Nat.card (H ℓ)) atTop atTop ∧
    ∃ ε : ℝ, 0 < ε ∧ ∀ (ℓ : ℕ) (F : Set (H ℓ)), 2 * F.ncard ≤ Nat.card (H ℓ) →
      ε * F.ncard ≤ (rightNeighbourBoundary (σ ℓ) F).ncard

/-- Edge expansion gives vertex expansion: an edge `x → σ_i x` leaving `F⁻¹` is sent to the
neighbour `(σ_i x)⁻¹ = x⁻¹ σ_i⁻¹` of `x⁻¹ ∈ F` outside `F`, and each neighbour receives at most
`|ι|` edges. -/
theorem exists_vertexExpansion_of_isExpanderFamily {ι : Type*} {H : ℕ → Type*}
    [∀ ℓ, Group (H ℓ)] {σ : ∀ ℓ, ι → H ℓ} (hexp : IsExpanderFamily σ) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ (ℓ : ℕ) (F : Set (H ℓ)), 2 * F.ncard ≤ Nat.card (H ℓ) →
      ε * F.ncard ≤ (rightNeighbourBoundary (σ ℓ) F).ncard := by
  obtain ⟨_, hfin, -, ε, hε, hbd⟩ := hexp
  have hpos : (0 : ℝ) < Nat.card ι + 1 := by positivity
  refine ⟨ε / (Nat.card ι + 1), div_pos hε hpos, fun ℓ F hF => ?_⟩
  haveI := hfin ℓ
  have hcard : ((fun x : H ℓ => x⁻¹) ⁻¹' F).ncard = F.ncard :=
    Set.ncard_preimage_of_injective_subset_range inv_injective fun x _ => ⟨x⁻¹, inv_inv x⟩
  have h3 := hbd ℓ ((fun x : H ℓ => x⁻¹) ⁻¹' F) (by rw [hcard]; exact hF)
  rw [hcard] at h3
  have hedge : ({p : H ℓ × ι | p.1 ∈ (fun x : H ℓ => x⁻¹) ⁻¹' F ∧
      σ ℓ p.2 * p.1 ∉ (fun x : H ℓ => x⁻¹) ⁻¹' F} : Set (H ℓ × ι)).ncard ≤
      (rightNeighbourBoundary (σ ℓ) F).ncard * Nat.card ι := by
    rw [← Set.ncard_univ ι, ← Set.ncard_prod]
    refine Set.ncard_le_ncard_of_injOn (fun p : H ℓ × ι => ((σ ℓ p.2 * p.1)⁻¹, p.2)) ?_ ?_
    · rintro ⟨x, i⟩ ⟨hx, hmove⟩
      refine Set.mem_prod.2 ⟨?_, Set.mem_univ _⟩
      exact mem_rightNeighbourBoundary.2 ⟨hmove, x⁻¹, hx, i, Or.inr (mul_inv_rev (σ ℓ i) x)⟩
    · rintro ⟨x, i⟩ - ⟨y, j⟩ - h
      simp only [Prod.mk.injEq, inv_inj] at h
      obtain ⟨h1, rfl⟩ := h
      rw [mul_left_cancel h1]
  rw [div_mul_eq_mul_div, div_le_iff₀ hpos]
  calc ε * (F.ncard : ℝ) ≤ _ := h3
    _ ≤ ((rightNeighbourBoundary (σ ℓ) F).ncard : ℝ) * Nat.card ι := by exact_mod_cast hedge
    _ ≤ ((rightNeighbourBoundary (σ ℓ) F).ncard : ℝ) * (Nat.card ι + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (by positivity)

/-- A marked limit whose finite Cayley graphs have uniform edge expansion is an expander limit. -/
theorem isExpanderLimit_of_isMarkedLimit {ι G : Type*} [Group G] {s : ι → G} {H : ℕ → Type*}
    [∀ ℓ, Group (H ℓ)] {σ : ∀ ℓ, ι → H ℓ} (hlim : IsMarkedLimit s σ)
    (hexp : IsExpanderFamily σ) : IsExpanderLimit s σ := by
  have hvert := exists_vertexExpansion_of_isExpanderFamily hexp
  obtain ⟨hι, hfin, hcard, -⟩ := hexp
  exact ⟨hlim, hι, hfin, hcard, hvert⟩

/-- The matrix sizes of a matricial approximation are positive. -/
theorem isMatricialVia_pos {R : Type*} [Ring R] {S : Finset R} {N : ℕ → ℕ}
    {φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)} (hφ : IsMatricialVia S N φ) (k : ℕ) :
    0 < N k := by
  obtain ⟨hpos, -⟩ := hφ
  exact hpos k

/-! ## Part (a) -/

/-- **`thm:general`(a)** (tex l.173–178): in the setting of the theorem, for every `n ≥ 3`, `EL_n(R)`
is an infinite, finitely generated, simple Kazhdan group. -/
theorem manuscriptSentence_generalElementaryInfiniteFGSimpleKazhdan :
    ∀ (Λ : Type) [Group Λ] [Group.FG Λ] (C : Type) [TopologicalSpace C] [CompactSpace C]
      [TopologicalSpace.MetrizableSpace C] [TotallyDisconnectedSpace C] [PerfectSpace C]
      [Nonempty C] [MulAction Λ C] [ContinuousConstSMul Λ C]
      (S : Finset (ClopenGroupCrossedProduct Λ C (ZMod 2))),
      IsGeneralSetting Λ C S → ∀ n : ℕ, 3 ≤ n →
        Infinite ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
        Group.FG ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
        IsSimpleGroup ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
        HasKazhdanPropertyT.{0, 0}
          ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) := by
  intro Λ _ _ C _ _ _ _ _ _ _ _ S hset n hn
  obtain ⟨hmin, hfree, -, hS⟩ := hset
  haveI : Infinite C := infinite_of_perfectSpace C
  obtain ⟨hT, hInf⟩ := printedGroupCrossedProductPropertyTInfinite Λ C S hS n hn
  exact ⟨hInf, KazhdanFiniteGeneration.fg_of_hasKazhdanPropertyT _ hT,
    printedGeneralSimplicityStatement Λ C hmin hfree n hn, hT⟩

/-! ## Part (b) -/

/-- **`thm:general`(b)** (tex l.173–175, l.179–187): in the setting of the theorem, for maps
`φ_k : R → M_{N_k}(F₂)` as printed and every `n ≥ 3`, the groups `SL_{nN_k}(F₂)` are simple, and
`EL_n(R)` marked by the `e_ij(s)`, `s ∈ S`, is an expander limit of the `SL_{nN_k}(F₂)` marked by
the `e_ij(φ_k(s))` (transported along `EL_n(M_{N_k}(F₂)) ≃* SL_{nN_k}(F₂)`). -/
theorem manuscriptSentence_generalExpanderLimit :
    ∀ (Λ : Type) [Group Λ] [Group.FG Λ] (C : Type) [TopologicalSpace C] [CompactSpace C]
      [TopologicalSpace.MetrizableSpace C] [TotallyDisconnectedSpace C] [PerfectSpace C]
      [Nonempty C] [MulAction Λ C] [ContinuousConstSMul Λ C]
      (S : Finset (ClopenGroupCrossedProduct Λ C (ZMod 2))),
      IsGeneralSetting Λ C S →
      ∀ (N : ℕ → ℕ)
        (φ : ∀ k, ClopenGroupCrossedProduct Λ C (ZMod 2) → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))
        (hφ : IsMatricialVia S N φ) (n : ℕ) (hn : 3 ≤ n),
        (∀ k, IsSimpleGroup (Matrix.SpecialLinearGroup (Fin n × Fin (N k)) (ZMod 2))) ∧
        IsExpanderLimit (H := fun k => Matrix.SpecialLinearGroup (Fin n × Fin (N k)) (ZMod 2))
          (elementaryMarking n S)
          (fun k p => elementaryBlockEquivSL n hn (N k) (isMatricialVia_pos hφ k)
            (matricialMarking n S N φ k p)) := by
  intro Λ _ _ C _ _ _ _ _ _ _ _ S hset N φ hφ n hn
  obtain ⟨hmin, hfree, hS1, hS⟩ := hset
  obtain ⟨-, -, -, -, hlim, hsl, -, hexp⟩ :=
    printedSimpleKazhdanGeneral Λ C hmin hfree S hS1 hS N φ hφ n hn
  refine ⟨fun k => (MulEquiv.isSimpleGroup_congr
    (elementaryBlockEquivSL n hn (N k) (isMatricialVia_pos hφ k))).1 (hsl k), ?_⟩
  exact isExpanderLimit_of_isMarkedLimit
    (hlim.map_target fun k => elementaryBlockEquivSL n hn (N k) (isMatricialVia_pos hφ k))
    (hexp.map_target fun k => elementaryBlockEquivSL n hn (N k) (isMatricialVia_pos hφ k))

