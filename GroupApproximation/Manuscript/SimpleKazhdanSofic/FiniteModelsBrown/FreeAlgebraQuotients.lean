import GroupApproximation.Manuscript.SimpleKazhdanSofic.MatricialMarkedLimitDegree
import GroupApproximation.Manuscript.SimpleKazhdanSofic.MarkedLimitSpecialLinear
import GroupApproximation.Meta.AxiomGuard
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# "Finite simple models", tex 318–331: the free algebra and its two quotients

`simple_kazhdan_sofic_group.tex`, subsection "Finite simple models" (proof of Theorem
`thm:general`(b)):

> (tex 318–321) Let $\mathcal A$ be the free algebra over $\F_2$ on letters $\tau_s$, $s\in S$, and
> let $\pi\colon\mathcal A\to R$ and $\rho_k\colon\mathcal A\to M_{N_k}(\F_2)$ be the ring
> homomorphisms with $\pi(\tau_s)=s$ and $\rho_k(\tau_s)=\varphi_k(s)$.
> (tex 321–322) Both are onto, so $G$ and $\EL_3(M_{N_k}(\F_2))$ are quotients of $\EL_3(\mathcal A)$.
> (tex 322–325) Here $\EL_3(M_{N_k}(\F_2))=\SL_{3N_k}(\F_2)$, as transvections generate
> $\SL_{3N_k}(\F_2)$, and each transvection inside one block is a commutator of transvections between
> blocks.
> (tex 325–327) The group $\EL_3(\mathcal A)$ is generated by the $e_{ij}(1)$ and $e_{ij}(\tau_s)$, and
> in both quotients $e_{ij}(1)$ and $e_{ij}(\tau_s)$ with $s=1$ have the same image.
> (tex 327–331) A word of length $\lambda$ or less in the $e_{ij}(\tau_s)$ has entries of degree at
> most $\lambda$ in $\mathcal A$, and $\varphi_k\circ\pi=\rho_k$ on the finitely many such entries for
> large $k$, where $\varphi_k(0)=0$ by additivity.

The sentences only use that `R` is an `F₂`-algebra generated by `S` and that the `φ_k` satisfy the
matricial axioms of `thm:general`, so every endpoint here is stated for an arbitrary ring
`R` with `[Algebra (ZMod 2) R]`; the crossed product `LC(Z, F₂) ⋊ Λ` of `thm:general` is one of
them. Rank `3` is stated for every `n` (for every `n ≥ 3` where the printed argument needs it).

Proof route (all ingredients are closed corpus declarations):

* `𝒜 = FreeAlgebra (ZMod 2) ↥S`, `π = piLetters S`, `ρ_k = rhoLetters S N φ k`, with the letter
  values `piLetters_ι`, `rhoLetters_ι`.
* Onto: `piLetters_surjective`, `rhoLetters_surjective`, `elementaryGroupMap_letters_surjective`;
  the quotient presentations are `QuotientGroup.quotientKerEquivOfSurjective`.
* `EL_n(M_N(F₂)) = SL_{nN}(F₂)`: `printedBlockElementarySpecialLinear` (block flattening onto
  `ker det`), `AlgebraicK.ker_detUnits` (`ker det` is generated by the transvections), and the
  in-block transvection `(i,k) → (i,l)` as the commutator of the between-block transvections
  `(i,k) → (j,k)` and `(j,k) → (i,l)` (`elementaryBlockUnitEquiv_single`,
  `elementaryUnit_commutator`).
* Generation and the images of `e_ij(τ_1)`: `closure_range_freeMarking_eq_top`,
  `piLetters_freeMarking_one`, `rhoLetters_freeMarking_one`.
* Degrees: `entries_lift_mem_degLE`, `degLE_mono`, `finite_degLE`,
  `eventually_forall_degLE_map_comp_eq`, and `eventually_map_zero`.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace FiniteModelsBrown

open Filter
open scoped commutatorElement

/-- **tex 318–321**: `π : 𝒜 → R` and `ρ_k : 𝒜 → M_{N_k}(F₂)` are ring homomorphisms out of the free
`F₂`-algebra on the letters `τ_s`, `s ∈ S`, with `π(τ_s) = s` and `ρ_k(τ_s) = φ_k(s)`. -/
theorem manuscriptSentence_freeAlgebraLetterHomomorphisms {R : Type*} [Ring R] [Algebra (ZMod 2) R]
    (S : Finset R) (N : ℕ → ℕ) (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)) :
    (∀ s : ↥S, piLetters S (FreeAlgebra.ι (ZMod 2) s) = (s : R)) ∧
      ∀ (k : ℕ) (s : ↥S), rhoLetters S N φ k (FreeAlgebra.ι (ZMod 2) s) = φ k (s : R) :=
  ⟨fun s => piLetters_ι S s, fun k s => rhoLetters_ι S N φ k s⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.FiniteModelsBrown.manuscriptSentence_freeAlgebraLetterHomomorphisms

/-- **tex 321–322**: `π` and every `ρ_k` are onto, hence so are the induced maps
`EL_n(𝒜) → EL_n(R)` and `EL_n(𝒜) → EL_n(M_{N_k}(F₂))`, and both targets are quotients of `EL_n(𝒜)`. -/
theorem manuscriptSentence_lettersOntoQuotients {R : Type*} [Ring R] [Algebra (ZMod 2) R]
    (S : Finset R) (hS : Subring.closure (S : Set R) = ⊤) (N : ℕ → ℕ)
    (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))
    (hgen : ∀ k, Subring.closure (φ k '' (S : Set R)) = ⊤) (n : ℕ) :
    Function.Surjective (piLetters S) ∧ (∀ k, Function.Surjective (rhoLetters S N φ k)) ∧
      Function.Surjective (elementaryGroupMap (ι := Fin n) (piLetters S)) ∧
      (∀ k, Function.Surjective (elementaryGroupMap (ι := Fin n) (rhoLetters S N φ k))) ∧
      Nonempty (↥(elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) ↥S)) ⧸
          (elementaryGroupMap (ι := Fin n) (piLetters S)).ker ≃* ↥(elementaryGroup (Fin n) R)) ∧
      ∀ k, Nonempty (↥(elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) ↥S)) ⧸
          (elementaryGroupMap (ι := Fin n) (rhoLetters S N φ k)).ker ≃*
        ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)))) := by
  obtain ⟨h3, h4⟩ := elementaryGroupMap_letters_surjective S N φ hS hgen n
  exact ⟨piLetters_surjective S hS, rhoLetters_surjective S N φ hgen, h3, h4,
    ⟨QuotientGroup.quotientKerEquivOfSurjective _ h3⟩,
    fun k => ⟨QuotientGroup.quotientKerEquivOfSurjective _ (h4 k)⟩⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.FiniteModelsBrown.manuscriptSentence_lettersOntoQuotients

/-- **tex 322–325**: for `n ≥ 3` and `N ≥ 1`,
* block flattening `M_n(M_N(F₂)) ≅ M_{n×N}(F₂)` carries `EL_n(M_N(F₂))` onto `SL_{nN}(F₂) = ker det`;
* `SL_{nN}(F₂) = ker det` is the group generated by the transvections `e_{(i,k),(j,l)}(a)`;
* a transvection `(i,k) → (i,l)` inside the block `i` is the commutator of the transvections
  `(i,k) → (j,k)` and `(j,k) → (i,l)` between the blocks `i ≠ j`; both are images of elementary
  matrices of `M_n(M_N(F₂))`. -/
theorem manuscriptSentence_blockElementaryEqSpecialLinear (n : ℕ) (hn : 3 ≤ n) (N : ℕ)
    (hN : 0 < N) :
    (elementaryGroup (Fin n) (Matrix (Fin N) (Fin N) (ZMod 2))).map
        (elementaryBlockUnitEquiv (ι := Fin n) (κ := Fin N) (R := ZMod 2)).toMonoidHom =
      (AlgebraicK.detUnits (ι := Fin n × Fin N) (k := ZMod 2)).ker ∧
    (AlgebraicK.detUnits (ι := Fin n × Fin N) (k := ZMod 2)).ker =
      elementaryGroup (Fin n × Fin N) (ZMod 2) ∧
    ∀ (i j : Fin n) (hij : i ≠ j) (k l : Fin N) (hkl : k ≠ l) (a : ZMod 2),
      ⁅elementaryBlockUnitEquiv (ι := Fin n) (κ := Fin N) (R := ZMod 2)
          (elementaryUnit i j hij (Matrix.single k k a)),
        elementaryBlockUnitEquiv (ι := Fin n) (κ := Fin N) (R := ZMod 2)
          (elementaryUnit j i hij.symm (Matrix.single k l (1 : ZMod 2)))⁆ =
        elementaryUnit (i, k) (i, l) (fun h => hkl (congrArg Prod.snd h)) a := by
  refine ⟨printedBlockElementarySpecialLinear n hn N hN, ?_, ?_⟩
  · haveI : Nonempty (Fin n × Fin N) := ⟨(⟨0, by omega⟩, ⟨0, hN⟩)⟩
    exact AlgebraicK.ker_detUnits
  · intro i j hij k l hkl a
    have h1 : ((i, k) : Fin n × Fin N) ≠ (j, k) := fun h => hij (congrArg Prod.fst h)
    have h2 : ((j, k) : Fin n × Fin N) ≠ (i, l) := fun h => hij (congrArg Prod.fst h).symm
    have h3 : ((i, k) : Fin n × Fin N) ≠ (i, l) := fun h => hkl (congrArg Prod.snd h)
    rw [elementaryBlockUnitEquiv_single i j hij k k a,
      elementaryBlockUnitEquiv_single j i hij.symm k l (1 : ZMod 2),
      elementaryUnit_commutator (i, k) (j, k) (i, l) h1 h2 h3 a 1, mul_one]

#audit_axioms GroupApproximation.SimpleKazhdanSofic.FiniteModelsBrown.manuscriptSentence_blockElementaryEqSpecialLinear

/-- **tex 325–327**: `EL_n(𝒜)`, `n ≥ 3`, is generated by the `e_ij(1)` (index `none`) and the
`e_ij(τ_s)` (index `some s`), and in both quotients `e_ij(τ_1)` and `e_ij(1)` have the same image. -/
theorem manuscriptSentence_freeMarkingGeneration {R : Type*} [Ring R] [Algebra (ZMod 2) R]
    (S : Finset R) (hS1 : (1 : R) ∈ S) (N : ℕ → ℕ)
    (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)) (h1 : ∀ k, φ k 1 = 1)
    (n : ℕ) (hn : 3 ≤ n) :
    (∀ (p : {p : Fin n × Fin n // p.1 ≠ p.2}) (s : ↥S),
      ((freeMarking n ↥S (p, some s) : ↥(elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) ↥S))) :
          (Matrix (Fin n) (Fin n) (FreeAlgebra (ZMod 2) ↥S))ˣ) =
        elementaryUnit p.1.1 p.1.2 p.2 (FreeAlgebra.ι (ZMod 2) s)) ∧
    (∀ p : {p : Fin n × Fin n // p.1 ≠ p.2},
      ((freeMarking n ↥S (p, none) : ↥(elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) ↥S))) :
          (Matrix (Fin n) (Fin n) (FreeAlgebra (ZMod 2) ↥S))ˣ) =
        elementaryUnit p.1.1 p.1.2 p.2 1) ∧
    Subgroup.closure (Set.range (freeMarking n ↥S)) = ⊤ ∧
    ∀ p : {p : Fin n × Fin n // p.1 ≠ p.2},
      elementaryGroupMap (piLetters S) (freeMarking n ↥S (p, some ⟨1, hS1⟩)) =
          elementaryGroupMap (piLetters S) (freeMarking n ↥S (p, none)) ∧
        ∀ k, elementaryGroupMap (rhoLetters S N φ k) (freeMarking n ↥S (p, some ⟨1, hS1⟩)) =
          elementaryGroupMap (rhoLetters S N φ k) (freeMarking n ↥S (p, none)) :=
  ⟨fun _ _ => rfl, fun _ => rfl, closure_range_freeMarking_eq_top hn, fun p =>
    ⟨piLetters_freeMarking_one S hS1 p, fun k => rhoLetters_freeMarking_one S N φ hS1 h1 k p⟩⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.FiniteModelsBrown.manuscriptSentence_freeMarkingGeneration

/-- **tex 327–331**: under the matricial axioms (`φ_k(1) = 1`, eventual additivity and
multiplicativity), a word `w` of length at most `λ` in the `e_ij(1)`, `e_ij(τ_s)` has all entries in
`degLE λ`, the span of the monomials of length at most `λ`; that set is finite; for large `k`,
`φ_k ∘ π = ρ_k` on all of it; and `φ_k(0) = 0` for large `k` by additivity. -/
theorem manuscriptSentence_wordEntriesDegreeAgreement {R : Type*} [Ring R] [Algebra (ZMod 2) R]
    [DecidableEq R] (S : Finset R) (N : ℕ → ℕ)
    (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)) (h1 : ∀ k, φ k 1 = 1)
    (hev : ∀ r s : R, ∀ᶠ k in atTop, φ k (r + s) = φ k r + φ k s ∧ φ k (r * s) = φ k r * φ k s)
    (n d : ℕ) (w : FreeGroup ({p : Fin n × Fin n // p.1 ≠ p.2} × Option ↥S))
    (hw : (FreeGroup.toWord w).length ≤ d) :
    (∀ i j, ((FreeGroup.lift (freeMarking n ↥S) w : (Matrix (Fin n) (Fin n) (FreeAlgebra (ZMod 2) ↥S))ˣ) :
        Matrix (Fin n) (Fin n) (FreeAlgebra (ZMod 2) ↥S)) i j ∈ degLE (↥S) d) ∧
      (degLE (↥S) d : Set (FreeAlgebra (ZMod 2) ↥S)).Finite ∧
      (∀ᶠ k in atTop, ∀ m ∈ (degLE (↥S) d : Set (FreeAlgebra (ZMod 2) ↥S)),
        φ k (piLetters S m) = rhoLetters S N φ k m) ∧
      ∀ᶠ k in atTop, φ k 0 = 0 :=
  ⟨fun i j => degLE_mono hw (entries_lift_mem_degLE w i j), finite_degLE d,
    eventually_forall_degLE_map_comp_eq S N φ h1 hev d,
    eventually_map_zero φ fun r s => (hev r s).mono fun _ h => h.1⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.FiniteModelsBrown.manuscriptSentence_wordEntriesDegreeAgreement

end FiniteModelsBrown
end SimpleKazhdanSofic
