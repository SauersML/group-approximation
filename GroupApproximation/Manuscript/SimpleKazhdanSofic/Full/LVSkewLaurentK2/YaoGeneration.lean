import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVSkewLaurentK2.Interface

/-!
# Yao's fibration: generation by the two half rings (lane LVSkewLaurentK2-3a)

`simple_kazhdan_sofic_group.tex` l.733-735 (`sec:questions`), leaf T1b.iii; work order
WO-LVCohnK2-3.  Ara–Brustenga–Cortiñas (2009) `thm:skewyao` (`yaoseq6.tex` l.574-640) derives
`K₂(S[t,t⁻¹;φ])` from the square of rings `S → S[t₊;φ], S[t₋;φ] → S[t₊,t₋;φ]`.  This file proves
the first input of the Mayer–Vietoris step: the Laurent ring is the sum of the two half rings, so
the Steinberg group `St_N(S[t,t⁻¹;φ])` is generated by the images of `St_N(S[t;φ])` and
`St_N(S[t⁻¹;φ⁻¹])`.

* `single_mul_tPow`: `(s t^m) · t^ε = s t^{m+ε}`;
* `single_natMul_mem_skewHalf`: `s t^{mε} ∈ S[t^ε;φ^ε]` for `m : ℕ`;
* `exists_add_skewHalf`: every `f ∈ S[t,t⁻¹;φ]` equals `f₊ + f₋` with `f_± ∈ S[t^{±1};φ^{±1}]`;
* `mem_sup_range_ringMap_halves`: `St_N(S[t,t⁻¹;φ]) = im St_N(S[t;φ]) ⊔ im St_N(S[t⁻¹;φ⁻¹])`.
-/

namespace GroupApproximation.Full.LVSkewLaurentK2

open SteinbergGroup

section Generation

variable {S : Type*} [Ring S] [MulSemiringAction (Multiplicative ℤ) S]

/-- `t^ε` lies in the half ring `S[t^ε; φ^ε]`.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem tPow_mem_skewHalf (ε : ℤ) : tPow S ε ∈ skewHalf S ε := by
  have ht : tPow S ε ∈ Set.range (constMap S) ∪ {tPow S ε} :=
    Set.mem_union_right (Set.range (constMap S)) (Set.mem_singleton (tPow S ε))
  exact Subring.subset_closure ht

/-- `(s t^m) · t^ε = s t^{m+ε}`.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem single_mul_tPow (m ε : ℤ) (s : S) :
    (SkewMonoidAlgebra.single (Multiplicative.ofAdd m) s : SkewLaurent S) * tPow S ε =
      SkewMonoidAlgebra.single (Multiplicative.ofAdd (m + ε)) s := by
  rw [tPow, SkewMonoidAlgebra.single_mul_single, smul_one, mul_one, ofAdd_add]

/-- `s t^{mε}` lies in the half ring `S[t^ε; φ^ε]` for every `m : ℕ`.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem single_natMul_mem_skewHalf (ε : ℤ) (s : S) (m : ℕ) :
    (SkewMonoidAlgebra.single (Multiplicative.ofAdd ((m : ℤ) * ε)) s : SkewLaurent S) ∈
      skewHalf S ε := by
  induction m with
  | zero =>
    have h0 : (SkewMonoidAlgebra.single (Multiplicative.ofAdd (((0 : ℕ) : ℤ) * ε)) s :
        SkewLaurent S) = constMap S s := by
      rw [Nat.cast_zero, zero_mul, ofAdd_zero]
      rfl
    rw [h0]
    exact constMap_mem_skewHalf S ε s
  | succ m ih =>
    have h1 : (SkewMonoidAlgebra.single (Multiplicative.ofAdd (((m + 1 : ℕ) : ℤ) * ε)) s :
        SkewLaurent S) =
        SkewMonoidAlgebra.single (Multiplicative.ofAdd ((m : ℤ) * ε)) s * tPow S ε := by
      rw [single_mul_tPow, show ((m + 1 : ℕ) : ℤ) * ε = (m : ℤ) * ε + ε by push_cast; ring]
    rw [h1]
    exact (skewHalf S ε).mul_mem ih (tPow_mem_skewHalf ε)

/-- **The Laurent ring is the sum of the half rings**: every `f ∈ S[t,t⁻¹;φ]` equals `f₊ + f₋`
with `f₊ ∈ S[t;φ]` and `f₋ ∈ S[t⁻¹;φ⁻¹]`.
(`yaoseq6.tex` `thm:skewyao`, Step 1; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem exists_add_skewHalf (f : SkewLaurent S) :
    ∃ f₊ ∈ skewHalf S 1, ∃ f₋ ∈ skewHalf S (-1), f = f₊ + f₋ := by
  induction f using SkewMonoidAlgebra.induction_on with
  | zero =>
    exact ⟨0, (skewHalf S 1).zero_mem, 0, (skewHalf S (-1)).zero_mem, (add_zero 0).symm⟩
  | single g a =>
    by_cases hg : 0 ≤ Multiplicative.toAdd g
    · have e : ((Multiplicative.toAdd g).toNat : ℤ) * 1 = Multiplicative.toAdd g := by omega
      have hm := single_natMul_mem_skewHalf (S := S) 1 a (Multiplicative.toAdd g).toNat
      rw [e, ofAdd_toAdd] at hm
      exact ⟨_, hm, 0, (skewHalf S (-1)).zero_mem, (add_zero _).symm⟩
    · have e : ((-Multiplicative.toAdd g).toNat : ℤ) * (-1) = Multiplicative.toAdd g := by
        omega
      have hm := single_natMul_mem_skewHalf (S := S) (-1) a (-Multiplicative.toAdd g).toNat
      rw [e, ofAdd_toAdd] at hm
      exact ⟨0, (skewHalf S 1).zero_mem, _, hm, (zero_add _).symm⟩
  | add f g hf hg =>
    obtain ⟨f₊, hf₊, f₋, hf₋, rfl⟩ := hf
    obtain ⟨g₊, hg₊, g₋, hg₋, rfl⟩ := hg
    exact ⟨f₊ + g₊, (skewHalf S 1).add_mem hf₊ hg₊, f₋ + g₋, (skewHalf S (-1)).add_mem hf₋ hg₋,
      add_add_add_comm f₊ f₋ g₊ g₋⟩

/-- **Generation.**  `St_N(S[t,t⁻¹;φ])` is generated by the images of `St_N(S[t;φ])` and
`St_N(S[t⁻¹;φ⁻¹])`: `x_{ij}(f₊ + f₋) = x_{ij}(f₊) x_{ij}(f₋)`.
(`yaoseq6.tex` `thm:skewyao`, Step 1; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem mem_sup_range_ringMap_halves {N : ℕ} (u : SteinbergGroup (Fin N) (SkewLaurent S)) :
    u ∈ (ringMap (I := Fin N) (skewHalf S 1).subtype).range ⊔
      (ringMap (I := Fin N) (skewHalf S (-1)).subtype).range := by
  refine PresentedGroup.generated_by _ _ ?_ u
  rintro ⟨i, j, hij, f⟩
  obtain ⟨f₊, h₊, f₋, h₋, hf⟩ := exists_add_skewHalf f
  change x i j hij f ∈ _
  rw [hf, ← x_mul]
  refine Subgroup.mul_mem _ (Subgroup.mem_sup_left ?_) (Subgroup.mem_sup_right ?_)
  · exact MonoidHom.mem_range.mpr
      ⟨x i j hij (⟨f₊, h₊⟩ : skewHalf S 1), ringMap_x (skewHalf S 1).subtype i j hij ⟨f₊, h₊⟩⟩
  · exact MonoidHom.mem_range.mpr
      ⟨x i j hij (⟨f₋, h₋⟩ : skewHalf S (-1)),
        ringMap_x (skewHalf S (-1)).subtype i j hij ⟨f₋, h₋⟩⟩

end Generation

end GroupApproximation.Full.LVSkewLaurentK2
