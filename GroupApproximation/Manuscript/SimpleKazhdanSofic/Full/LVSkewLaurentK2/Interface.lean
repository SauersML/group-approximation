import Mathlib.Algebra.SkewMonoidAlgebra.Basic
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVH2GL3.RankFive

/-!
# Interface of work order WO-LVCohnK2-3 (lane LVSkewLaurentK2)

`simple_kazhdan_sofic_group.tex` l.733-735 (`sec:questions`), leaf T1b.iii.  Work order
WO-LVCohnK2-3 asks for stable `K₂ = 0` of the skew Laurent ring `S[t, t⁻¹; φ]` over an
ultramatricial `𝔽₂`-ring `S`.  The source is Ara–Brustenga–Cortiñas, *K-theory of Leavitt path
algebras*, Münster J. Math. 2 (2009), `thm:skewyao` in degree two (`yaoseq6.tex` l.574-640,
Steps 1-2; Yao 1995, Thm 2.1): for an automorphism `φ` of `S`,

  `K₂(S[t,t⁻¹;φ]) = NK₂(S,φ)₊ ⊕ NK₂(S,φ)₋ ⊕ coker(1 - φ on K₂ S) ⊕ ker(1 - φ on K₁ S)`.

The work order is split into three lanes sharing this directory.  This file only fixes the
objects and the exact statements exchanged between them; it proves nothing.

* `SkewLaurent S`: the skew Laurent ring, as Mathlib's `SkewMonoidAlgebra S (Multiplicative ℤ)`
  (`single g a * single h b = single (g * h) (a * (g • b))`, so `t • a = φ a`);
* `constMap S`, `tPow S m`: the constants `a ↦ a t⁰` and the monomials `t^m`;
* `skewHalf S 1 = S[t; φ]`, `skewHalf S (-1) = S[t⁻¹; φ⁻¹]`: the subrings generated by the
  constants and `t^{±1}`;
* `IsUltramatricialF2 S`: every finite subset of `S` lies in a subring isomorphic to a finite
  product of full matrix rings over `𝔽₂` (the binder `hS` of the work order);
* `K1Statement S` (lane 3c, `Units*.lean`): `K₁(S) = 0` in the unstable form
  `GL_n(S) = E_n(S)` for `n ≥ 2`;
* `HalfK2Statement S` (lane 3b, `NK*.lean`): stable `K₂(S[t;φ]) = 0` and stable
  `K₂(S[t⁻¹;φ⁻¹]) = 0`, i.e. `NK₂(S,φ)_± = 0` together with `K₂(S) = 0`;
* `YaoFactorization S` (lane 3a, `Yao*.lean`): the Mayer–Vietoris step at a finite stage: every
  `k ∈ K₂(n, S[t,t⁻¹;φ])` becomes, after padding, a product `a · b` of elements of
  `St_N(S[t;φ])` and `St_N(S[t⁻¹;φ⁻¹])` whose projection `E_N(S[t;φ])` lies in `GL_N(S)`.

The lanes publish:
* 3c: `theorem k1Statement_of_ultramatricial {S : Type*} [Ring S] (hS : IsUltramatricialF2 S) :
  K1Statement S`;
* 3b: `theorem halfK2Statement_of_ultramatricial {S : Type*} [Ring S]
  [MulSemiringAction (Multiplicative ℤ) S] (hS : IsUltramatricialF2 S) : HalfK2Statement S`;
* 3a: `theorem yaoFactorization_of_ultramatricial` (same binders) `: YaoFactorization S`,
  `stableK2Trivial_of_yaoFactorization` and the endpoint
  `stableK2Trivial_skewLaurent_of_ultramatricial`.
-/

namespace GroupApproximation.Full.LVSkewLaurentK2

open SteinbergGroup

section Objects

variable (S : Type*) [Ring S] [MulSemiringAction (Multiplicative ℤ) S]

/-- The skew Laurent ring `S[t, t⁻¹; φ]`, `φ = (ofAdd 1 • ·)`.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
abbrev SkewLaurent : Type _ := SkewMonoidAlgebra S (Multiplicative ℤ)

/-- The constants `S → S[t, t⁻¹; φ]`, `a ↦ a t⁰`.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def constMap : S →+* SkewLaurent S :=
  SkewMonoidAlgebra.singleOneRingHom

/-- The monomial `t^m`.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def tPow (m : ℤ) : SkewLaurent S :=
  SkewMonoidAlgebra.single (Multiplicative.ofAdd m) (1 : S)

/-- The half ring `S[t^ε; φ^ε]`, generated by the constants and `t^ε`; for `ε = 1` this is
`S[t₊, φ]` and for `ε = -1` it is `S[t₋, φ]` of `yaoseq6.tex` `thm:skewyao`, Step 1.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def skewHalf (ε : ℤ) : Subring (SkewLaurent S) :=
  Subring.closure (Set.range (constMap S) ∪ {tPow S ε})

/-- The constants land in every half ring.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem constMap_mem_skewHalf (ε : ℤ) (a : S) : constMap S a ∈ skewHalf S ε := by
  have ha : constMap S a ∈ Set.range (constMap S) ∪ {tPow S ε} :=
    Set.mem_union_left {tPow S ε} (Set.mem_range_self a)
  exact Subring.subset_closure ha

/-- The constants `S → S[t^ε; φ^ε]`.
(`yaoseq6.tex` `thm:skewyao`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def halfConst (ε : ℤ) : S →+* skewHalf S ε :=
  (constMap S).codRestrict (skewHalf S ε) (constMap_mem_skewHalf S ε)

end Objects

section Statements

/-- **Ultramatricial `𝔽₂`-rings**: every finite subset lies in a subring isomorphic to a finite
product of full matrix rings over `𝔽₂` (binder `hS` of WO-LVCohnK2-3; Ara–Brustenga–Cortiñas
2009, Sec. 5).  (`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def IsUltramatricialF2 (S : Type*) [Ring S] : Prop :=
  ∀ s : Finset S, ∃ (k : ℕ) (d : Fin (k + 1) → ℕ) (T : Subring S), (s : Set S) ⊆ (T : Set S) ∧
    Nonempty (T ≃+* ((j : Fin (k + 1)) → Matrix (Fin (d j)) (Fin (d j)) (ZMod 2)))

/-- **Interface for lane 3c** (`Units*.lean`): `K₁(S) = 0` in the unstable form
`GL_n(S) = E_n(S)` for `n ≥ 2`.  For ultramatricial `𝔽₂`-rings this holds because
`GL_m(𝔽₂) = SL_m(𝔽₂) = E_m(𝔽₂)`.  (`yaoseq6.tex` `thm:skewyao`, the term
`ker(1 - φ on K₁)`; `simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def K1Statement (S : Type*) [Ring S] : Prop :=
  ∀ (n : ℕ), 2 ≤ n → ∀ g : (Matrix (Fin n) (Fin n) S)ˣ, g ∈ elementaryGroup (Fin n) S

/-- **Interface for lane 3b** (`NK*.lean`): stable `K₂ = 0` for both half rings `S[t;φ]` and
`S[t⁻¹;φ⁻¹]`, i.e. `K₂(S) = 0` and `NK₂(S, φ)_± = 0` (`yaoseq6.tex` l.1169ff: `NK(R,φ)_± = 0`
for regular supercoherent `R`).  (`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def HalfK2Statement (S : Type*) [Ring S] [MulSemiringAction (Multiplicative ℤ) S] : Prop :=
  LVH2GL3.StableK2Trivial (skewHalf S 1) ∧ LVH2GL3.StableK2Trivial (skewHalf S (-1))

/-- **Interface for lane 3a** (`Yao*.lean`): the Mayer–Vietoris step of Yao's fibration at a finite
stage.  Every `k ∈ K₂(n, S[t,t⁻¹;φ])` becomes, after padding to some `N ≥ 2`, a product
`a · b` with `a ∈ St_N(S[t;φ])`, `b ∈ St_N(S[t⁻¹;φ⁻¹])`, and the image of `a` in
`E_N(S[t;φ])` is a matrix with constant entries.  (`yaoseq6.tex` `thm:skewyao`, Step 1: exactness
of `K₂(R[t₊]) ⊕ K₂(R[t₋]) → K₂(R[t₊,t₋]) → K₁(R) ⊕ K₁(R)`;
`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def YaoFactorization (S : Type*) [Ring S] [MulSemiringAction (Multiplicative ℤ) S] : Prop :=
  ∀ (n : ℕ) (k : SteinbergGroup (Fin n) (SkewLaurent S)), projection k = 1 →
    ∃ (N : ℕ) (h : n ≤ N) (a : SteinbergGroup (Fin N) (skewHalf S 1))
      (b : SteinbergGroup (Fin N) (skewHalf S (-1))) (g : (Matrix (Fin N) (Fin N) S)ˣ),
      2 ≤ N ∧
      indexMap (Fin.castLEEmb h) k =
        ringMap (skewHalf S 1).subtype a * ringMap (skewHalf S (-1)).subtype b ∧
      ((projection a : elementaryGroup (Fin N) (skewHalf S 1)) :
        (Matrix (Fin N) (Fin N) (skewHalf S 1))ˣ) =
        elementaryMatrixUnitMap (halfConst S 1) g

end Statements

end GroupApproximation.Full.LVSkewLaurentK2
