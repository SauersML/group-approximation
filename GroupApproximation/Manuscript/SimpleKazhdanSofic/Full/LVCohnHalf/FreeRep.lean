import Mathlib.Algebra.Star.Free
import Mathlib.Algebra.Algebra.Opposite
import Mathlib.Data.Matrix.Basic
import Mathlib.Algebra.BigOperators.Fin
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCohnRelK1.Cohn

/-!
# The free algebras `𝔽₂⟨x₀,x₁⟩` and `𝔽₂⟨y₀,y₁⟩` inside the Cohn algebra

Let `F = 𝔽₂⟨X₀,X₁⟩`.  The Cohn algebra `C₂(𝔽₂)` acts on `F`: `xⱼ` acts by left
multiplication with `Xⱼ`, and `yᵢ` acts by the left derivative `∂ᵢ`.  Here
`∂ᵢ(Xⱼ w) = δᵢⱼ w` and `∂ᵢ(1) = 0`.  The derivative is the corner entry of an algebra map
`F → M₂(F)`, `a ↦ [[ε(a), ∂ᵢ a], [0, a]]`.  Since `x_μ` acts on `1 ∈ F` as `X_μ`, the
subalgebra of `C₂(𝔽₂)` generated by `x₀, x₁` is free.  An opposite action,
with `xᵢ ↦ ∂ᵢ` and `yⱼ ↦ Xⱼ`, gives the same for `y₀, y₁`.

These are the base cases `F₀ ≅ 𝔽₂⟨x₀,x₁⟩` and `G₀ ≅ 𝔽₂⟨y₀,y₁⟩` of the filtrations of `C_{≥0}`
and `C_{≤0}` in Ara-Brustenga-Cortiñas 2009, thm:skewyao Step 3 (yaoseq6.tex l.640-688).
This is the input to `simple_kazhdan_sofic_group.tex` l.733-735 (`sec:questions`,
leaf T1b.iii).
-/

namespace GroupApproximation.Full.LVCohnHalf

open GroupApproximation.Full.LVCohnRelK1

noncomputable section

/-- The free algebra `𝔽₂⟨X₀,X₁⟩` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
abbrev FreeF2 : Type := FreeAlgebra (ZMod 2) (Fin 2)

/-- The matrix `[[0, δᵢⱼ], [0, Xⱼ]]`: the image of `Xⱼ` under `a ↦ [[ε a, ∂ᵢ a], [0, a]]`. -/
def derivGen (i j : Fin 2) : Matrix (Fin 2) (Fin 2) FreeF2 :=
  Matrix.of ![![0, if j = i then 1 else 0], ![0, FreeAlgebra.ι (ZMod 2) j]]

/-- The algebra map `a ↦ [[ε a, ∂ᵢ a], [0, a]]` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def derivMat (i : Fin 2) : FreeF2 →ₐ[ZMod 2] Matrix (Fin 2) (Fin 2) FreeF2 :=
  FreeAlgebra.lift (ZMod 2) (derivGen i)

theorem derivMat_ι (i j : Fin 2) : derivMat i (FreeAlgebra.ι (ZMod 2) j) = derivGen i j :=
  FreeAlgebra.lift_ι_apply (derivGen i) j

theorem derivMat_mul_apply (i : Fin 2) (a b : FreeF2) (r c : Fin 2) :
    derivMat i (a * b) r c =
      derivMat i a r 0 * derivMat i b 0 c + derivMat i a r 1 * derivMat i b 1 c := by
  rw [map_mul, Matrix.mul_apply, Fin.sum_univ_two]

/-- The bottom row of `derivMat i a` is `[0, a]`. -/
theorem derivMat_lower (i : Fin 2) (a : FreeF2) :
    derivMat i a 1 0 = 0 ∧ derivMat i a 1 1 = a := by
  induction a using FreeAlgebra.induction with
  | grade0 r =>
    refine ⟨?_, ?_⟩
    · rw [AlgHom.commutes, Matrix.algebraMap_matrix_apply, if_neg (by decide : ¬((1 : Fin 2) = 0))]
    · rw [AlgHom.commutes, Matrix.algebraMap_matrix_apply, if_pos rfl]
  | grade1 j =>
    rw [derivMat_ι]
    exact ⟨rfl, rfl⟩
  | mul a b ha hb =>
    refine ⟨?_, ?_⟩
    · rw [derivMat_mul_apply, ha.1, hb.1, zero_mul, mul_zero, add_zero]
    · rw [derivMat_mul_apply, ha.1, ha.2, hb.2, zero_mul, zero_add]
  | add a b ha hb =>
    refine ⟨?_, ?_⟩
    · rw [map_add, Matrix.add_apply, ha.1, hb.1, add_zero]
    · rw [map_add, Matrix.add_apply, ha.2, hb.2]

/-- Left multiplication by `Xⱼ` on `F`. -/
def mulL (j : Fin 2) : Module.End (ZMod 2) FreeF2 where
  toFun w := FreeAlgebra.ι (ZMod 2) j * w
  map_add' a b := mul_add _ a b
  map_smul' c a := mul_smul_comm c _ a

theorem mulL_apply (j : Fin 2) (w : FreeF2) : mulL j w = FreeAlgebra.ι (ZMod 2) j * w := rfl

/-- The left derivative `∂ᵢ` on `F` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def leftDeriv (i : Fin 2) : Module.End (ZMod 2) FreeF2 where
  toFun a := derivMat i a 0 1
  map_add' a b := congrFun (congrFun (map_add (derivMat i) a b) 0) 1
  map_smul' c a := congrFun (congrFun (map_smul (derivMat i) c a) 0) 1

theorem leftDeriv_apply (i : Fin 2) (a : FreeF2) : leftDeriv i a = derivMat i a 0 1 := rfl

/-- `∂ᵢ(Xⱼ w) = δᵢⱼ w`. -/
theorem leftDeriv_ι_mul (i j : Fin 2) (w : FreeF2) :
    leftDeriv i (FreeAlgebra.ι (ZMod 2) j * w) = if j = i then w else 0 := by
  have h00 : derivGen i j 0 0 = 0 := rfl
  have h01 : derivGen i j 0 1 = if j = i then 1 else 0 := rfl
  rw [leftDeriv_apply, derivMat_mul_apply, derivMat_ι, h00, h01, (derivMat_lower i w).2,
    zero_mul, zero_add]
  by_cases h : j = i
  · rw [if_pos h, if_pos h, one_mul]
  · rw [if_neg h, if_neg h, zero_mul]

theorem leftDeriv_mul_mulL_self (i : Fin 2) : leftDeriv i * mulL i = 1 :=
  LinearMap.ext fun w => by
    show leftDeriv i (FreeAlgebra.ι (ZMod 2) i * w) = w
    rw [leftDeriv_ι_mul, if_pos rfl]

theorem leftDeriv_mul_mulL_ne {i j : Fin 2} (h : j ≠ i) : leftDeriv i * mulL j = 0 :=
  LinearMap.ext fun w => by
    show leftDeriv i (FreeAlgebra.ι (ZMod 2) j * w) = 0
    rw [leftDeriv_ι_mul, if_neg h]

/-! ### The action `xⱼ ↦ Xⱼ ·`, `yᵢ ↦ ∂ᵢ` -/

/-- The images of `s₀, s₁, t₀, t₁`. -/
def repGen : BinaryLeavitt.Generator → Module.End (ZMod 2) FreeF2 :=
  ![mulL 0, mulL 1, leftDeriv 0, leftDeriv 1]

/-- The free algebra on `s₀, s₁, t₀, t₁` acting on `F`. -/
def repEval : BinaryLeavitt.Free (ZMod 2) →ₐ[ZMod 2] Module.End (ZMod 2) FreeF2 :=
  FreeAlgebra.lift (ZMod 2) repGen

theorem repEval_s0 : repEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.s0) = mulL 0 := by
  rw [repEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repEval_s1 : repEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.s1) = mulL 1 := by
  rw [repEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repEval_t0 : repEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.t0) = leftDeriv 0 := by
  rw [repEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repEval_t1 : repEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.t1) = leftDeriv 1 := by
  rw [repEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repEval_respects :
    ∀ ⦃a b : BinaryLeavitt.Free (ZMod 2)⦄, CohnRel a b → repEval a = repEval b := by
  intro a b h
  cases h with
  | t0_s0 =>
    rw [map_mul, map_one, repEval_t0, repEval_s0]
    exact leftDeriv_mul_mulL_self 0
  | t0_s1 =>
    rw [map_mul, map_zero, repEval_t0, repEval_s1]
    exact leftDeriv_mul_mulL_ne (by decide)
  | t1_s0 =>
    rw [map_mul, map_zero, repEval_t1, repEval_s0]
    exact leftDeriv_mul_mulL_ne (by decide)
  | t1_s1 =>
    rw [map_mul, map_one, repEval_t1, repEval_s1]
    exact leftDeriv_mul_mulL_self 1

/-- The action of `C₂(𝔽₂)` on `F` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def rep : CohnTwoF2 →ₐ[ZMod 2] Module.End (ZMod 2) FreeF2 :=
  RingQuot.liftAlgHom (ZMod 2) ⟨repEval, repEval_respects⟩

theorem rep_cmk (a : BinaryLeavitt.Free (ZMod 2)) : rep (cmk a) = repEval a :=
  RingQuot.liftAlgHom_mkAlgHom_apply (ZMod 2) repEval repEval_respects a

theorem rep_cx_false : rep (cx false) = mulL 0 := by
  show rep (cmk (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.s0)) = mulL 0
  rw [rep_cmk, repEval_s0]

theorem rep_cx_true : rep (cx true) = mulL 1 := by
  show rep (cmk (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.s1)) = mulL 1
  rw [rep_cmk, repEval_s1]

/-! ### The opposite action `xᵢ ↦ ∂ᵢ`, `yⱼ ↦ Xⱼ ·` -/

/-- The images of `s₀, s₁, t₀, t₁` in the opposite algebra. -/
def repOpGen : BinaryLeavitt.Generator → (Module.End (ZMod 2) FreeF2)ᵐᵒᵖ :=
  ![MulOpposite.op (leftDeriv 0), MulOpposite.op (leftDeriv 1), MulOpposite.op (mulL 0),
    MulOpposite.op (mulL 1)]

/-- The free algebra on `s₀, s₁, t₀, t₁` acting on the right of `F`. -/
def repOpEval : BinaryLeavitt.Free (ZMod 2) →ₐ[ZMod 2] (Module.End (ZMod 2) FreeF2)ᵐᵒᵖ :=
  FreeAlgebra.lift (ZMod 2) repOpGen

theorem repOpEval_s0 :
    repOpEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.s0) = MulOpposite.op (leftDeriv 0) := by
  rw [repOpEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repOpEval_s1 :
    repOpEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.s1) = MulOpposite.op (leftDeriv 1) := by
  rw [repOpEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repOpEval_t0 :
    repOpEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.t0) = MulOpposite.op (mulL 0) := by
  rw [repOpEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repOpEval_t1 :
    repOpEval (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.t1) = MulOpposite.op (mulL 1) := by
  rw [repOpEval, FreeAlgebra.lift_ι_apply]
  rfl

theorem repOpEval_respects :
    ∀ ⦃a b : BinaryLeavitt.Free (ZMod 2)⦄, CohnRel a b → repOpEval a = repOpEval b := by
  intro a b h
  cases h with
  | t0_s0 =>
    rw [map_mul, map_one, repOpEval_t0, repOpEval_s0, ← MulOpposite.op_mul, leftDeriv_mul_mulL_self,
      MulOpposite.op_one]
  | t0_s1 =>
    rw [map_mul, map_zero, repOpEval_t0, repOpEval_s1, ← MulOpposite.op_mul,
      leftDeriv_mul_mulL_ne (by decide : (0 : Fin 2) ≠ 1), MulOpposite.op_zero]
  | t1_s0 =>
    rw [map_mul, map_zero, repOpEval_t1, repOpEval_s0, ← MulOpposite.op_mul,
      leftDeriv_mul_mulL_ne (by decide : (1 : Fin 2) ≠ 0), MulOpposite.op_zero]
  | t1_s1 =>
    rw [map_mul, map_one, repOpEval_t1, repOpEval_s1, ← MulOpposite.op_mul, leftDeriv_mul_mulL_self,
      MulOpposite.op_one]

/-- The right action of `C₂(𝔽₂)` on `F` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def repOp : CohnTwoF2 →ₐ[ZMod 2] (Module.End (ZMod 2) FreeF2)ᵐᵒᵖ :=
  RingQuot.liftAlgHom (ZMod 2) ⟨repOpEval, repOpEval_respects⟩

theorem repOp_cmk (a : BinaryLeavitt.Free (ZMod 2)) : repOp (cmk a) = repOpEval a :=
  RingQuot.liftAlgHom_mkAlgHom_apply (ZMod 2) repOpEval repOpEval_respects a

theorem repOp_cy_false : repOp (cy false) = MulOpposite.op (mulL 0) := by
  show repOp (cmk (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.t0)) = MulOpposite.op (mulL 0)
  rw [repOp_cmk, repOpEval_t0]

theorem repOp_cy_true : repOp (cy true) = MulOpposite.op (mulL 1) := by
  show repOp (cmk (FreeAlgebra.ι (ZMod 2) BinaryLeavitt.t1)) = MulOpposite.op (mulL 1)
  rw [repOp_cmk, repOpEval_t1]

/-! ### The free subalgebras -/

/-- `𝔽₂⟨X₀,X₁⟩ → C₂(𝔽₂)`, `Xᵢ ↦ xᵢ` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def xFree : FreeF2 →ₐ[ZMod 2] CohnTwoF2 := FreeAlgebra.lift (ZMod 2) ![cx false, cx true]

/-- `𝔽₂⟨Y₀,Y₁⟩ → C₂(𝔽₂)`, `Yⱼ ↦ yⱼ` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def yFree : FreeF2 →ₐ[ZMod 2] CohnTwoF2 := FreeAlgebra.lift (ZMod 2) ![cy false, cy true]

theorem xFree_ι_zero : xFree (FreeAlgebra.ι (ZMod 2) (0 : Fin 2)) = cx false :=
  FreeAlgebra.lift_ι_apply ![cx false, cx true] 0

theorem xFree_ι_one : xFree (FreeAlgebra.ι (ZMod 2) (1 : Fin 2)) = cx true :=
  FreeAlgebra.lift_ι_apply ![cx false, cx true] 1

theorem yFree_ι_zero : yFree (FreeAlgebra.ι (ZMod 2) (0 : Fin 2)) = cy false :=
  FreeAlgebra.lift_ι_apply ![cy false, cy true] 0

theorem yFree_ι_one : yFree (FreeAlgebra.ι (ZMod 2) (1 : Fin 2)) = cy true :=
  FreeAlgebra.lift_ι_apply ![cy false, cy true] 1

theorem rep_xFree_ι : ∀ j : Fin 2, rep (xFree (FreeAlgebra.ι (ZMod 2) j)) = mulL j := by
  refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
  · show rep (xFree (FreeAlgebra.ι (ZMod 2) (0 : Fin 2))) = mulL 0
    rw [xFree_ι_zero, rep_cx_false]
  · show rep (xFree (FreeAlgebra.ι (ZMod 2) (1 : Fin 2))) = mulL 1
    rw [xFree_ι_one, rep_cx_true]

theorem repOp_yFree_ι :
    ∀ j : Fin 2, repOp (yFree (FreeAlgebra.ι (ZMod 2) j)) = MulOpposite.op (mulL j) := by
  refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
  · show repOp (yFree (FreeAlgebra.ι (ZMod 2) (0 : Fin 2))) = MulOpposite.op (mulL 0)
    rw [yFree_ι_zero, repOp_cy_false]
  · show repOp (yFree (FreeAlgebra.ι (ZMod 2) (1 : Fin 2))) = MulOpposite.op (mulL 1)
    rw [yFree_ι_one, repOp_cy_true]

/-- `xFree a` acts on `F` as left multiplication by `a`. -/
theorem rep_xFree (a : FreeF2) : ∀ w : FreeF2, rep (xFree a) w = a * w := by
  induction a using FreeAlgebra.induction with
  | grade0 r =>
    intro w
    rw [AlgHom.commutes, AlgHom.commutes, Module.algebraMap_end_apply, Algebra.smul_def]
  | grade1 j =>
    intro w
    rw [rep_xFree_ι, mulL_apply]
  | mul a b ha hb =>
    intro w
    rw [map_mul, map_mul, Module.End.mul_apply, hb, ha, mul_assoc]
  | add a b ha hb =>
    intro w
    rw [map_add, map_add, LinearMap.add_apply, ha, hb, add_mul]

/-- `yFree a` acts on `F` (on the right) as left multiplication by the reversal `star a`. -/
theorem repOp_yFree (a : FreeF2) :
    ∀ w : FreeF2, MulOpposite.unop (repOp (yFree a)) w = star a * w := by
  induction a using FreeAlgebra.induction with
  | grade0 r =>
    intro w
    rw [AlgHom.commutes, AlgHom.commutes, MulOpposite.algebraMap_apply, MulOpposite.unop_op,
      Module.algebraMap_end_apply, FreeAlgebra.star_algebraMap, Algebra.smul_def]
  | grade1 j =>
    intro w
    rw [repOp_yFree_ι, MulOpposite.unop_op, mulL_apply, FreeAlgebra.star_ι]
  | mul a b ha hb =>
    intro w
    rw [map_mul, map_mul, MulOpposite.unop_mul, Module.End.mul_apply, ha, hb, star_mul, mul_assoc]
  | add a b ha hb =>
    intro w
    rw [map_add, map_add, MulOpposite.unop_add, LinearMap.add_apply, ha, hb, star_add, add_mul]

/-- `x₀, x₁` generate a free subalgebra of `C₂(𝔽₂)` (ABC 2009, thm:skewyao Step 3;
`simple_kazhdan_sofic_group.tex` l.733-735). -/
theorem xFree_injective : Function.Injective xFree := by
  intro a b h
  have ha := rep_xFree a 1
  rw [h, rep_xFree b 1, mul_one, mul_one] at ha
  exact ha.symm

/-- `y₀, y₁` generate a free subalgebra of `C₂(𝔽₂)` (ABC 2009, thm:skewyao Step 3;
`simple_kazhdan_sofic_group.tex` l.733-735). -/
theorem yFree_injective : Function.Injective yFree := by
  intro a b h
  have ha := repOp_yFree a 1
  rw [h, repOp_yFree b 1, mul_one, mul_one] at ha
  exact star_injective ha.symm

end

end GroupApproximation.Full.LVCohnHalf
