import GroupApproximation.KOne.AllRanksElementaryCore
import GroupApproximation.KOne.RefineLoopDischarge
import GroupApproximation.Leavitt.LeavittModuleRank
import GroupApproximation.Leavitt.BinaryLeavittAllRanksUnits
import GroupApproximation.Steinberg.Basic

/-!
# `GL₂(L) = E₂(L)` and `GL₃(L) = E₃(L)` for the Leavitt algebra `L = L_k(1,2)` (leaf T1a)

`simple_kazhdan_sofic_group.tex`, `sec:questions`, l.733-735: "Infinite finitely presented simple
Kazhdan groups exist [CapraceRemy]".  The repository reaches this sentence via
`E₅(L_{𝔽₂}(1,2))`, and the remaining input is `K₂(4, L) = ⊥` (Khanh, arXiv:2609.08428, Thm 5.1).
In that proof, leaf **T1a** is the statement that the general linear groups `GL₂(L)` and `GL₃(L)`
are generated by elementary matrices.  Khanh cites Ara-Goodearl-Pardo and uses `L ≅ L²` together
with `K₁(L) = 0`.

Everything here is unconditional, and it holds over every field `k`:

* `glTwo_eq_elementary`, `glThree_eq_elementary`: `elementaryGroup (Fin 2|3) L = ⊤`, i.e.
  `GL₂(L) = E₂(L)` and `GL₃(L) = E₃(L)`, with the membership forms `mem_elementaryTwo` and
  `mem_elementaryThree`.
* `glN_eq_elementary`: the all-ranks form `GLₙ(L) = Eₙ(L)` for `n ≥ 2`.
* `elementaryEquivGL`: `Eₙ(L) ≃* GLₙ(L)`.
* `steinbergToGL`, `steinbergToGL_surjective`, `steinbergToGL_ker`, `steinbergQuotientEquivGL`:
  the Steinberg projection `Stₙ(L) → GLₙ(L)` is onto, its kernel is the unstable `K₂(n, L)`
  (the kernel of `SteinbergGroup.projection`), and `Stₙ(L) ⧸ K₂(n, L) ≃* GLₙ(L)`.
* `leavittModuleIso`, `leavittRightModuleIso`: the Leavitt isomorphisms `L ≅ L ⊕ L` of left and
  of right `L`-modules.
* `K1_trivial`: `K₁(L) = 0` in Whitehead form (every unit is stably elementary).
* `nonempty_glEquivUnits`: `GLₙ(L) ≃* Lˣ` for `n ≥ 1`.
* The `𝔽₂` specialization `L = UniversalLeavitt.BinaryLeavittAlgebra`, which is the ring of the
  `LeavittFP`/`LeavittK2` development: `glTwo_eq_elementary_F2` and `glThree_eq_elementary_F2`.

The mathematics is already on main, and this file only packages it:
`BinaryLeavitt.elementaryGroup_eq_top` (`KOne/AllRanksElementaryCore.lean`) rests on the internally
proved rank-two elimination `BinaryLeavitt.glTwo_eq_elementary_holds`
(`KOne/RefineLoopDischarge.lean`), which uses the elementary two-exit refine loop in place of the
localization sequence, and it spreads to all ranks by the prefix-code self-similarity
`M_m(L) ≅ L`.  Every imported module is already reachable from `GroupApproximation.lean`, so this
file wires no orphans.
-/

namespace GroupApproximation.Full.LVEGen

section Field

variable (k : Type) [Field k]

/-- **Leaf T1a, all ranks**: `GLₙ(L_k(1,2)) = Eₙ(L_k(1,2))` for every `n ≥ 2`
(`simple_kazhdan_sofic_group.tex` l.733-735, `sec:questions`; Khanh arXiv:2609.08428, proof of
Thm 5.1; Ara-Goodearl-Pardo). -/
theorem glN_eq_elementary {n : ℕ} (hn : 2 ≤ n) :
    elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k) = ⊤ :=
  GroupApproximation.BinaryLeavitt.elementaryGroup_eq_top k n hn

/-- **Leaf T1a, rank two**: `GL₂(L) = E₂(L)`. -/
theorem glTwo_eq_elementary :
    elementaryGroup (Fin 2) (BinaryLeavitt.BinaryLeavittAlgebra k) = ⊤ :=
  glN_eq_elementary k (le_refl 2)

/-- **Leaf T1a, rank three**: `GL₃(L) = E₃(L)`. -/
theorem glThree_eq_elementary :
    elementaryGroup (Fin 3) (BinaryLeavitt.BinaryLeavittAlgebra k) = ⊤ :=
  glN_eq_elementary k (by omega)

/-- Every invertible `n × n` matrix over `L` (`n ≥ 2`) is a product of elementary matrices. -/
theorem mem_elementaryN {n : ℕ} (hn : 2 ≤ n)
    (M : (Matrix (Fin n) (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ) :
    M ∈ elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k) := by
  rw [glN_eq_elementary k hn]
  exact Subgroup.mem_top M

/-- Every invertible `2 × 2` matrix over `L` is a product of elementary matrices. -/
theorem mem_elementaryTwo
    (M : (Matrix (Fin 2) (Fin 2) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ) :
    M ∈ elementaryGroup (Fin 2) (BinaryLeavitt.BinaryLeavittAlgebra k) :=
  mem_elementaryN k (le_refl 2) M

/-- Every invertible `3 × 3` matrix over `L` is a product of elementary matrices. -/
theorem mem_elementaryThree
    (M : (Matrix (Fin 3) (Fin 3) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ) :
    M ∈ elementaryGroup (Fin 3) (BinaryLeavitt.BinaryLeavittAlgebra k) :=
  mem_elementaryN k (by omega) M

/-- `Eₙ(L) ≃* GLₙ(L)` for `n ≥ 2`: the inclusion of the elementary subgroup is onto. -/
noncomputable def elementaryEquivGL {n : ℕ} (hn : 2 ≤ n) :
    elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k) ≃*
      (Matrix (Fin n) (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ :=
  (MulEquiv.subgroupCongr (glN_eq_elementary k hn)).trans Subgroup.topEquiv

theorem elementaryEquivGL_apply {n : ℕ} (hn : 2 ≤ n)
    (x : elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k)) :
    elementaryEquivGL k hn x =
      (x : (Matrix (Fin n) (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ) :=
  rfl

/-- The Steinberg projection `Stₙ(L) → Eₙ(L)` followed by the inclusion `Eₙ(L) ≤ GLₙ(L)`. -/
noncomputable def steinbergToGL (n : ℕ) :
    SteinbergGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k) →*
      (Matrix (Fin n) (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ :=
  (elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k)).subtype.comp
    (SteinbergGroup.projection (I := Fin n) (R := BinaryLeavitt.BinaryLeavittAlgebra k))

/-- `Stₙ(L) → GLₙ(L)` is surjective for `n ≥ 2`. -/
theorem steinbergToGL_surjective {n : ℕ} (hn : 2 ≤ n) :
    Function.Surjective (steinbergToGL k n) := by
  intro M
  obtain ⟨g, hg⟩ :=
    SteinbergGroup.projection_surjective (I := Fin n) (R := BinaryLeavitt.BinaryLeavittAlgebra k)
      (⟨M, mem_elementaryN k hn M⟩ :
        elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k))
  exact ⟨g, congrArg Subtype.val hg⟩

/-- The kernel of `Stₙ(L) → GLₙ(L)` is the unstable `K₂(n, L) = ker (Stₙ(L) → Eₙ(L))`. -/
theorem steinbergToGL_ker (n : ℕ) :
    (steinbergToGL k n).ker =
      (SteinbergGroup.projection (I := Fin n) (R := BinaryLeavitt.BinaryLeavittAlgebra k)).ker :=
  MonoidHom.ker_comp_of_injective
    (SteinbergGroup.projection (I := Fin n) (R := BinaryLeavitt.BinaryLeavittAlgebra k))
    (elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k)).subtype
    (Subgroup.subtype_injective (elementaryGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k)))

/-- `Stₙ(L) ⧸ K₂(n, L) ≃* GLₙ(L)` for `n ≥ 2`. -/
noncomputable def steinbergQuotientEquivGL {n : ℕ} (hn : 2 ≤ n) :
    SteinbergGroup (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k) ⧸ (steinbergToGL k n).ker ≃*
      (Matrix (Fin n) (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ :=
  QuotientGroup.quotientKerEquivOfSurjective (steinbergToGL k n) (steinbergToGL_surjective k hn)

/-- **The Leavitt isomorphism `L ≅ L ⊕ L` of left `L`-modules**: `x ↦ (x s₀, x s₁)`. -/
noncomputable def leavittModuleIso :
    BinaryLeavitt.BinaryLeavittAlgebra k ≃ₗ[BinaryLeavitt.BinaryLeavittAlgebra k]
      BinaryLeavitt.BinaryLeavittAlgebra k × BinaryLeavitt.BinaryLeavittAlgebra k :=
  (BinaryLeavitt.family k).linearEquivSquare

/-- **The Leavitt isomorphism `L ≅ L ⊕ L` of right `L`-modules**: `x ↦ (t₀ x, t₁ x)`. -/
noncomputable def leavittRightModuleIso :
    BinaryLeavitt.BinaryLeavittAlgebra k ≃ₗ[(BinaryLeavitt.BinaryLeavittAlgebra k)ᵐᵒᵖ]
      BinaryLeavitt.BinaryLeavittAlgebra k × BinaryLeavitt.BinaryLeavittAlgebra k :=
  (BinaryLeavitt.family k).rightLinearEquivSquare

/-- **`K₁(L) = 0`, in Whitehead form**: for every unit `u` of `L`, `diag(u, 1)` lies in `E₂(L)`. -/
theorem K1_trivial (u : (BinaryLeavitt.BinaryLeavittAlgebra k)ˣ) :
    u ∈ MatrixDiagonalization.stableUnits (BinaryLeavitt.BinaryLeavittAlgebra k) :=
  GroupApproximation.BinaryLeavitt.K1_trivial k u

/-- `GLₙ(L) ≃* Lˣ` for every `n ≥ 1`, by the prefix-code self-similarity `M_n(L) ≅ L`. -/
theorem nonempty_glEquivUnits {n : ℕ} (hn : 1 ≤ n) :
    Nonempty ((Matrix (Fin n) (Fin n) (BinaryLeavitt.BinaryLeavittAlgebra k))ˣ ≃*
      (BinaryLeavitt.BinaryLeavittAlgebra k)ˣ) :=
  (BinaryLeavitt.family k).nonempty_prefixUnitsEquiv hn

end Field

section F2

/-- **Leaf T1a over `𝔽₂`**: `GL₂(L_{𝔽₂}(1,2)) = E₂(L_{𝔽₂}(1,2))`, for the ring
`UniversalLeavitt.BinaryLeavittAlgebra` of the `LeavittFP`/`LeavittK2` development. -/
theorem glTwo_eq_elementary_F2 :
    elementaryGroup (Fin 2) UniversalLeavitt.BinaryLeavittAlgebra = ⊤ :=
  glTwo_eq_elementary (ZMod 2)

/-- **Leaf T1a over `𝔽₂`**: `GL₃(L_{𝔽₂}(1,2)) = E₃(L_{𝔽₂}(1,2))`. -/
theorem glThree_eq_elementary_F2 :
    elementaryGroup (Fin 3) UniversalLeavitt.BinaryLeavittAlgebra = ⊤ :=
  glThree_eq_elementary (ZMod 2)

/-- The joint statement of leaf T1a over `𝔽₂`: `GL₂(L) = E₂(L)` and `GL₃(L) = E₃(L)`. -/
theorem leafT1a_F2 :
    elementaryGroup (Fin 2) UniversalLeavitt.BinaryLeavittAlgebra = ⊤ ∧
      elementaryGroup (Fin 3) UniversalLeavitt.BinaryLeavittAlgebra = ⊤ :=
  ⟨glTwo_eq_elementary_F2, glThree_eq_elementary_F2⟩

end F2

end GroupApproximation.Full.LVEGen
