import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVUnivLocK2.B1ModClass
import Mathlib.GroupTheory.FreeAbelianGroup
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Algebra.Module.Submodule.Equiv

/-!
# Bass `K₁` of an exact category of modules (lane LVUnivLocK2-B1)

`simple_kazhdan_sofic_group.tex` l.733-735 (`sec:questions`), leaf T1b.iii, input W1.
The localization sequence `K₂(R) → K₂(Σ⁻¹R) → K₁(T_Σ)` ends in `K₁` of the torsion category,
and dévissage kills it.  Both statements only need `K₁` through its universal property.

For an extension-closed class `C` of modules (`ModClass`), **Bass's `K₁`** (Bass 1968, Ch. VIII;
Nenashev 1998 compares it with Quillen's `K₁`) is the abelian group generated by the classes
`[M, α]` of automorphisms of objects of `C`, subject to

* `[M, β ∘ α] = [M, α] + [M, β]`;
* `[M, α] = [M', α'] + [M'', α'']` for every conflation `M' ↣ M ↠ M''` with automorphisms
  compatible with it.

This file defines it (`ModClass.K1`) with its generator map `K1.mk`, the two defining relations
(`K1.mk_trans`, `K1.mk_of_exact`), the sub/quotient form of additivity (`K1.mk_of_submodule`),
invariance under isomorphism (`K1.mk_congr`), the induction principle (`K1.induction_on`), the
universal property (`K1.lift`, `K1.lift_mk`, `K1.hom_ext`) and the vanishing criterion
`K1.subsingleton_of_mk_eq_zero` used by dévissage.
-/

namespace GroupApproximation.Full.LVUnivLocK2

universe u v

namespace ModClass

variable {R : Type u} [Ring R] (C : ModClass.{u, v} R)

/-- Generators of Bass `K₁`: an object of the class together with an automorphism. -/
abbrev K1Gen := Σ M : C.Obj, (M.1 ≃ₗ[R] M.1)

/-- The free generator attached to an automorphism. -/
def gen (M : C.Obj) (α : M.1 ≃ₗ[R] M.1) : FreeAbelianGroup C.K1Gen :=
  FreeAbelianGroup.of ⟨M, α⟩

/-- The defining relations of Bass `K₁`.  (`simple_kazhdan_sofic_group.tex` l.733-735,
leaf T1b.iii.) -/
inductive IsK1Rel : FreeAbelianGroup C.K1Gen → Prop
  /-- Composition: `[M, β ∘ α] = [M, α] + [M, β]`. -/
  | comp (M : C.Obj) (α β : M.1 ≃ₗ[R] M.1) :
      IsK1Rel (C.gen M (α.trans β) - C.gen M α - C.gen M β)
  /-- Additivity along a conflation with compatible automorphisms. -/
  | exact (M' M M'' : C.Obj) (f : M'.1 →ₗ[R] M.1) (g : M.1 →ₗ[R] M''.1)
      (hf : Function.Injective f) (hg : Function.Surjective g) (hfg : Function.Exact f g)
      (α' : M'.1 ≃ₗ[R] M'.1) (α : M.1 ≃ₗ[R] M.1) (α'' : M''.1 ≃ₗ[R] M''.1)
      (h₁ : ∀ x, α (f x) = f (α' x)) (h₂ : ∀ y, g (α y) = α'' (g y)) :
      IsK1Rel (C.gen M α - C.gen M' α' - C.gen M'' α'')

/-- The subgroup of relations. -/
def k1Rels : AddSubgroup (FreeAbelianGroup C.K1Gen) :=
  AddSubgroup.closure {w | C.IsK1Rel w}

/-- **Bass `K₁` of an exact category of modules.**  (`simple_kazhdan_sofic_group.tex`
l.733-735, leaf T1b.iii.) -/
abbrev K1 := FreeAbelianGroup C.K1Gen ⧸ C.k1Rels

variable {C}

/-- The class `[M, α] ∈ K₁(C)` of an automorphism. -/
def K1.mk (M : C.Obj) (α : M.1 ≃ₗ[R] M.1) : C.K1 :=
  QuotientAddGroup.mk' C.k1Rels (C.gen M α)

theorem K1.mk'_eq_zero_of_rel {w : FreeAbelianGroup C.K1Gen} (h : C.IsK1Rel w) :
    QuotientAddGroup.mk' C.k1Rels w = 0 := by
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
  exact AddSubgroup.subset_closure h

/-- **Composition relation.**  (`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem K1.mk_trans (M : C.Obj) (α β : M.1 ≃ₗ[R] M.1) :
    K1.mk M (α.trans β) = K1.mk M α + K1.mk M β := by
  have h := K1.mk'_eq_zero_of_rel (IsK1Rel.comp M α β)
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  exact h

/-- **Additivity along conflations.**  (`simple_kazhdan_sofic_group.tex` l.733-735,
leaf T1b.iii.) -/
theorem K1.mk_of_exact (M' M M'' : C.Obj) (f : M'.1 →ₗ[R] M.1) (g : M.1 →ₗ[R] M''.1)
    (hf : Function.Injective f) (hg : Function.Surjective g) (hfg : Function.Exact f g)
    (α' : M'.1 ≃ₗ[R] M'.1) (α : M.1 ≃ₗ[R] M.1) (α'' : M''.1 ≃ₗ[R] M''.1)
    (h₁ : ∀ x, α (f x) = f (α' x)) (h₂ : ∀ y, g (α y) = α'' (g y)) :
    K1.mk M α = K1.mk M' α' + K1.mk M'' α'' := by
  have h := K1.mk'_eq_zero_of_rel (IsK1Rel.exact M' M M'' f g hf hg hfg α' α α'' h₁ h₂)
  rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h
  exact h

/-- The identity has trivial class.  (`simple_kazhdan_sofic_group.tex` l.733-735,
leaf T1b.iii.) -/
theorem K1.mk_refl (M : C.Obj) : K1.mk M (LinearEquiv.refl R M.1) = 0 := by
  have h := K1.mk_trans M (LinearEquiv.refl R M.1) (LinearEquiv.refl R M.1)
  rw [LinearEquiv.refl_trans] at h
  exact add_left_cancel (h.symm.trans (add_zero _).symm)

/-- Inverse automorphisms have opposite classes.  (`simple_kazhdan_sofic_group.tex`
l.733-735, leaf T1b.iii.) -/
theorem K1.mk_symm (M : C.Obj) (α : M.1 ≃ₗ[R] M.1) : K1.mk M α.symm = -K1.mk M α := by
  have h := K1.mk_trans M α α.symm
  rw [LinearEquiv.self_trans_symm, K1.mk_refl] at h
  exact (neg_eq_of_add_eq_zero_right h.symm).symm

/-- Automorphisms of zero objects have trivial class.  (`simple_kazhdan_sofic_group.tex`
l.733-735, leaf T1b.iii.) -/
theorem K1.mk_eq_zero_of_subsingleton (M : C.Obj) [Subsingleton M.1] (α : M.1 ≃ₗ[R] M.1) :
    K1.mk M α = 0 := by
  have hα : α = LinearEquiv.refl R M.1 := LinearEquiv.ext fun _ => Subsingleton.elim _ _
  rw [hα, K1.mk_refl]

/-- **Invariance under isomorphism**: conjugate automorphisms have equal classes.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem K1.mk_congr {M N : C.Obj} (e : M.1 ≃ₗ[R] N.1) (α : M.1 ≃ₗ[R] M.1)
    (β : N.1 ≃ₗ[R] N.1) (h : ∀ x, β (e x) = e (α x)) : K1.mk N β = K1.mk M α := by
  rw [K1.mk_of_exact M N C.zeroObj e.toLinearMap 0 e.injective (C.surjective_zero N.1)
      (C.exact_equiv_zero e) α β (LinearEquiv.refl R _) h (fun _ => Subsingleton.elim _ _),
    K1.mk_eq_zero_of_subsingleton C.zeroObj, add_zero]

/-- **Additivity for a stable submodule** `N ⊆ M` (sub/quotient form of `mk_of_exact`).
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem K1.mk_of_submodule (M : C.Obj) (α : M.1 ≃ₗ[R] M.1) (N : Submodule R M.1)
    (h : N.map (α : M.1 →ₗ[R] M.1) = N) (hN : C.mem (ModuleCat.of R N))
    (hQ : C.mem (ModuleCat.of R (M.1 ⧸ N))) :
    K1.mk M α = K1.mk ⟨ModuleCat.of R N, hN⟩ (α.ofSubmodules N N h) +
      K1.mk ⟨ModuleCat.of R (M.1 ⧸ N), hQ⟩ (Submodule.Quotient.equiv N N α h) :=
  K1.mk_of_exact ⟨ModuleCat.of R N, hN⟩ M ⟨ModuleCat.of R (M.1 ⧸ N), hQ⟩ N.subtype N.mkQ
    N.injective_subtype N.mkQ_surjective (LinearMap.exact_subtype_mkQ N)
    (α.ofSubmodules N N h) α (Submodule.Quotient.equiv N N α h) (fun _ => rfl) (fun _ => rfl)

/-- **Generation**: a predicate holding on all classes `[M, α]` and closed under `0`, `+` and
`-` holds on `K₁(C)`.  (`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
@[elab_as_elim]
theorem K1.induction_on {p : C.K1 → Prop} (x : C.K1) (hzero : p 0)
    (hmk : ∀ (M : C.Obj) (α : M.1 ≃ₗ[R] M.1), p (K1.mk M α))
    (hadd : ∀ a b, p a → p b → p (a + b)) (hneg : ∀ a, p a → p (-a)) : p x := by
  obtain ⟨w, rfl⟩ := QuotientAddGroup.mk'_surjective C.k1Rels x
  induction w using FreeAbelianGroup.induction_on with
  | zero => rw [map_zero]; exact hzero
  | of g => exact hmk g.1 g.2
  | neg g ih => rw [map_neg]; exact hneg _ ih
  | add a b ha hb => rw [map_add]; exact hadd _ _ ha hb

/-- **Vanishing criterion** (the form used by dévissage): if every class `[M, α]` vanishes,
`K₁(C)` is trivial.  (`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem K1.subsingleton_of_mk_eq_zero
    (h : ∀ (M : C.Obj) (α : M.1 ≃ₗ[R] M.1), K1.mk M α = 0) : Subsingleton C.K1 := by
  have hx : ∀ x : C.K1, x = 0 := fun x =>
    K1.induction_on x rfl h (fun a b ha hb => by rw [ha, hb, add_zero])
      (fun a ha => by rw [ha, neg_zero])
  exact ⟨fun a b => (hx a).trans (hx b).symm⟩

/-- Homomorphisms out of `K₁(C)` are determined by the classes.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem K1.hom_ext {A : Type*} [AddCommGroup A] {F G : C.K1 →+ A}
    (h : ∀ (M : C.Obj) (α : M.1 ≃ₗ[R] M.1), F (K1.mk M α) = G (K1.mk M α)) : F = G :=
  AddMonoidHom.ext fun x => K1.induction_on x (by rw [map_zero, map_zero]) h
    (fun a b ha hb => by rw [map_add, map_add, ha, hb])
    (fun a ha => by rw [map_neg, map_neg, ha])

/-- **Universal property of Bass `K₁`**: a function on automorphisms satisfying the composition
and conflation relations factors through `K₁(C)`.  (`simple_kazhdan_sofic_group.tex` l.733-735,
leaf T1b.iii.) -/
def K1.lift {A : Type*} [AddCommGroup A] (φ : ∀ M : C.Obj, (M.1 ≃ₗ[R] M.1) → A)
    (hcomp : ∀ (M : C.Obj) (α β : M.1 ≃ₗ[R] M.1), φ M (α.trans β) = φ M α + φ M β)
    (hexact : ∀ (M' M M'' : C.Obj) (f : M'.1 →ₗ[R] M.1) (g : M.1 →ₗ[R] M''.1),
      Function.Injective f → Function.Surjective g → Function.Exact f g →
      ∀ (α' : M'.1 ≃ₗ[R] M'.1) (α : M.1 ≃ₗ[R] M.1) (α'' : M''.1 ≃ₗ[R] M''.1),
        (∀ x, α (f x) = f (α' x)) → (∀ y, g (α y) = α'' (g y)) →
          φ M α = φ M' α' + φ M'' α'') :
    C.K1 →+ A :=
  QuotientAddGroup.lift C.k1Rels (FreeAbelianGroup.lift fun g : C.K1Gen => φ g.1 g.2) (by
    rw [k1Rels, AddSubgroup.closure_le]
    intro w (hw : C.IsK1Rel w)
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker]
    cases hw with
    | comp M α β =>
      simp only [gen, map_sub, FreeAbelianGroup.lift_apply_of]
      rw [hcomp M α β, sub_sub, sub_self]
    | exact M' M M'' f g hf hg hfg α' α α'' h₁ h₂ =>
      simp only [gen, map_sub, FreeAbelianGroup.lift_apply_of]
      rw [hexact M' M M'' f g hf hg hfg α' α α'' h₁ h₂, sub_sub, sub_self])

theorem K1.lift_mk {A : Type*} [AddCommGroup A] (φ : ∀ M : C.Obj, (M.1 ≃ₗ[R] M.1) → A)
    (hcomp : ∀ (M : C.Obj) (α β : M.1 ≃ₗ[R] M.1), φ M (α.trans β) = φ M α + φ M β)
    (hexact : ∀ (M' M M'' : C.Obj) (f : M'.1 →ₗ[R] M.1) (g : M.1 →ₗ[R] M''.1),
      Function.Injective f → Function.Surjective g → Function.Exact f g →
      ∀ (α' : M'.1 ≃ₗ[R] M'.1) (α : M.1 ≃ₗ[R] M.1) (α'' : M''.1 ≃ₗ[R] M''.1),
        (∀ x, α (f x) = f (α' x)) → (∀ y, g (α y) = α'' (g y)) →
          φ M α = φ M' α' + φ M'' α'')
    (M : C.Obj) (α : M.1 ≃ₗ[R] M.1) : K1.lift φ hcomp hexact (K1.mk M α) = φ M α := by
  rw [K1.lift, K1.mk, QuotientAddGroup.mk'_apply, QuotientAddGroup.lift_mk, gen,
    FreeAbelianGroup.lift_apply_of]

end ModClass

end GroupApproximation.Full.LVUnivLocK2
