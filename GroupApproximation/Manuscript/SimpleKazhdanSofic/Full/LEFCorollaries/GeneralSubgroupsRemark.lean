import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LEFCorollaries.PrintedHost
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Host.Assembly
import GroupApproximation.Manuscript.SimpleKazhdanSofic.SimpleKazhdanGeneralClosed
import GroupApproximation.Manuscript.SimpleKazhdanSofic.MarkedLimitLEF
import GroupApproximation.Meta.AxiomGuard

/-!
# The countable subgroups of the groups in `thm:general`(b) are the countable LEF groups

`simple_kazhdan_sofic_group.tex`, remark after Theorem `thm:general` (l.191–194):

> Lamplighter actions show that the countable subgroups of the groups in
> Theorem `thm:general`(b) are exactly the countable LEF groups (Corollary `cor:host`).

## Spelling

* "The groups in Theorem `thm:general`(b)" are the groups `EL_n(R)`, `n ≥ 3`, where
  `R = LC(C, F₂) ⋊ Λ` for a finitely generated group `Λ` acting minimally and topologically freely on
  a Cantor set `C`, and `R` is generated by a finite set `S ∋ 1` that admits maps
  `φ_k : R → M_{N_k}(F₂)` as in (b). These are the hypotheses of `PrintedSimpleKazhdanGeneral`. A
  Cantor set is a compact, metrizable, totally disconnected, perfect, nonempty space, and `IsMatricialVia`
  is the hypothesis on the `φ_k`.
* "A subgroup of" means an injective homomorphism into `EL_n(R)`.
* LEF is the printed definition `IsTextbookLEF`.

## Proof route

* Subgroups of these groups are LEF: by `printedSimpleKazhdanGeneral`, `EL_n(R)` is a marked limit of
  finite groups, so it is LEF (`isTextbookLEF_of_isMarkedLimit`), and LEF passes to subgroups.
* Every countable LEF group is such a subgroup ("Lamplighter actions"): `lem:nn` and `lem:host` embed
  it in `EL_3(R_Δ)` for an infinite finitely generated LEF group `Δ`
  (`Host.manuscriptSentence_countableLEFSubgroupOfHost`). The lamplighter action `Λ ↷ Ω` of `Δ`
  satisfies the hypotheses of `thm:general`(b) (`Host.manuscriptSentence_generalTheoremApplies`).
-/

namespace GroupApproximation.Full.SK12

open GroupApproximation.SimpleKazhdanSofic

/-- **Remark after `thm:general`** (tex l.191–194): a countable group is LEF if and only if it is a
subgroup of one of the groups `EL_n(R)` of Theorem `thm:general`(b). -/
theorem countableSubgroupsOfGeneral_iff (Γ : Type) [Group Γ] (hc : Countable Γ) :
    IsTextbookLEF Γ ↔
      ∃ (Λ : Type) (_ : Group Λ) (_ : Group.FG Λ) (Z : Type) (_ : TopologicalSpace Z)
        (_ : CompactSpace Z) (_ : TopologicalSpace.MetrizableSpace Z)
        (_ : TotallyDisconnectedSpace Z) (_ : PerfectSpace Z) (_ : Nonempty Z) (_ : MulAction Λ Z)
        (_ : ContinuousConstSMul Λ Z),
        MulAction.IsMinimal Λ Z ∧
        (∀ ξ : Λ, ξ ≠ 1 → ∀ U : Set Z, IsOpen U → U.Nonempty → ∃ z ∈ U, ξ • z ≠ z) ∧
        ∃ (S : Finset (ClopenGroupCrossedProduct Λ Z (ZMod 2))) (N : ℕ → ℕ)
          (φ : ∀ k, ClopenGroupCrossedProduct Λ Z (ZMod 2) → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)),
          1 ∈ S ∧ Subring.closure (S : Set (ClopenGroupCrossedProduct Λ Z (ZMod 2))) = ⊤ ∧
          IsMatricialVia S N φ ∧
          ∃ n : ℕ, 3 ≤ n ∧
            ∃ f : Γ →* ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ Z (ZMod 2))),
              Function.Injective f := by
  constructor
  · intro hΓ
    obtain ⟨Δ, _, hinf, hfgΔ, hlefΔ, -, f, hf⟩ :=
      Host.manuscriptSentence_countableLEFSubgroupOfHost Γ hc ((isLEF_iff_textbook Γ).2 hΓ)
    haveI : Infinite Δ := hinf
    obtain ⟨hfgΛ, hcpt, hmet, htd, hperf, hne, hmin, hfree, S, N, φ, hS1, hS, hφ, -⟩ :=
      Host.manuscriptSentence_generalTheoremApplies Δ hfgΔ hlefΔ
    exact ⟨Lamplighter.LampAffine Δ, inferInstance, hfgΛ, Lamplighter.LampSpace Δ, inferInstance,
      hcpt, hmet, htd, hperf, hne, inferInstance, inferInstance, hmin, hfree, S, N, φ, hS1, hS, hφ,
      3, le_rfl, f, hf⟩
  · rintro ⟨Λ, _, _, Z, _, _, _, _, _, _, _, _, hmin, hfree, S, N, φ, hS1, hS, hφ, n, hn, f, hf⟩
    obtain ⟨-, -, -, -, hlim, -, -, hexp⟩ :=
      printedSimpleKazhdanGeneral Λ Z hmin hfree S hS1 hS N φ hφ n hn
    exact isTextbookLEF_of_injective f hf (isTextbookLEF_of_isMarkedLimit hexp.2.1 hlim)

#audit_axioms GroupApproximation.Full.SK12.countableSubgroupsOfGeneral_iff

end GroupApproximation.Full.SK12
