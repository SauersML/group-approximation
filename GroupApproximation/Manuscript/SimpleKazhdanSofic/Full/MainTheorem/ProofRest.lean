import GroupApproximation.Manuscript.SimpleKazhdanSofic.SubshiftMatricial
import GroupApproximation.Manuscript.SimpleKazhdanSofic.MatricialEndpoints
import GroupApproximation.Manuscript.SimpleKazhdanSofic.SimpleKazhdanGeneralClosed
import GroupApproximation.Meta.AxiomGuard

/-!
# Proof of `thm:main`: least periods, the maps `φ_ℓ` and the matrix units

`simple_kazhdan_sofic_group.tex`, section `sec:main` ("Proof of Theorem~\ref{thm:main}"), tex l.377–391:

> Let $N_\ell$ be its least period, and on $\F_2^{\Z/N_\ell\Z}$ let $P\delta_t=\delta_{t+1}$. For $f$
> depending only on coordinates in $[-\ell,\ell]$ let $D_\ell(f)\delta_t=f(T^ty_\ell)\delta_t$, where
> $f(T^ty_\ell)$ is the value of $f$ at any point of $X$ that agrees with $T^ty_\ell$ on
> $[-\ell,\ell]$. Put $\varphi_\ell(\sum_jf_ju^j)=\sum_jD_\ell(f_j)P^j$ when every $f_j$ is of this
> kind, and $\varphi_\ell=0$ otherwise. Since $PD_\ell(f)P^{-1}=D_\ell(f\circ T^{-1})$ whenever $f$
> depends only on coordinates in $[-\ell+1,\ell-1]$, for fixed $r,r'\in R$ the identities
> $\varphi_\ell(r+r')=\varphi_\ell(r)+\varphi_\ell(r')$ and
> $\varphi_\ell(rr')=\varphi_\ell(r)\varphi_\ell(r')$ hold for large $\ell$, and $\varphi_\ell(1)=I$.
> The shifts $T^ty_\ell$, $0\le t<N_\ell$, are distinct, so products of the $P^iD_\ell(e_a)P^{-i}$
> give every diagonal matrix unit, and with $P$ every matrix unit. Therefore $\varphi_\ell(S)$
> generates $M_{N_\ell}(\F_2)$, and Theorem~\ref{thm:general} applies.

The sentences are derived from the corpus modules packaged by `SK05.periodicMatricial`
(`FiniteModelsLeastPeriod`, `FiniteModelsAsymptotic`, `PeriodicMatrixUnits`, `SubshiftMatricial`).
Here `y_ℓ = periodicExt x (m ℓ)`, `P = shiftMatrix (ZMod 2) N 1`, `δ_t = Pi.single t 1`,
`D_ℓ(f) = diagonal (D ℓ f)`, `φ_ℓ = cutoffModel (D ℓ) ℓ`, and `ofAdd j • f` is `f ∘ T^{-j}`.

* `rest_leastPeriod`: `N_ℓ` is a positive period of `y_ℓ`;
* `rest_shiftMatrix_mulVec_single`, `rest_diagonal_mulVec_single`: `P δ_t = δ_{t+1}` and
  `diag(d) δ_t = d(t) δ_t`;
* `rest_cutoffModel_eq_sum`, `rest_cutoffModel_of_not`: the two cases of the definition of `φ_ℓ`;
* `rest_conj_diagonal`: `P^j diag(d) P^{-j} = diag(d(· - j))`;
* `rest_matrixUnits`: translated letters, diagonal matrix units, all matrix units, generation;
* `ProofRestModels`, `rest_models`: for an infinite minimal subshift and `x ∈ X`, the least periods,
  `N_ℓ → ∞`, `D_ℓ(f) δ_t = f(T^t y_ℓ) δ_t` at any agreeing point, covariance, eventual additivity
  and multiplicativity, `φ_ℓ(1) = I`, `φ_ℓ(u^j) = P^j`, `φ_ℓ(e_a) = D_ℓ(e_a)`, distinct translates,
  every matrix unit in the ring generated by `φ_ℓ(S)`, and `φ_ℓ(S)` generating `M_{N_ℓ}(F₂)`;
* `rest_theoremGeneralApplies`: `thm:general` applies and gives `thm:main`;
* `PrintedMainProofRest`, `printedMainProofRest`: the closed bundle.
-/

namespace GroupApproximation.Full.SK05

open GroupApproximation.SimpleKazhdanSofic
open GroupApproximation.ClopenCrossedProduct
open GroupApproximation.Pestov91
open SymbolicDynamics.FullShift Filter Matrix
open Multiplicative (toAdd ofAdd)

section Generic

/-- "Let `N_ℓ` be its least period" (tex l.377): the least period of a periodic extension is
positive and is a period. -/
theorem rest_leastPeriod {A : Type*} (x : ℤ → A) (m : ℕ) [NeZero m] :
    0 < leastPeriod (periodicExt x m) ∧
      ∀ t : ℤ, periodicExt x m (leastPeriod (periodicExt x m) + t) = periodicExt x m t :=
  ⟨leastPeriod_periodicExt_pos x, periodicExt_leastPeriod_add x m⟩

variable {N : ℕ} [NeZero N]

/-- "`P δ_t = δ_{t+1}`" (tex l.378). -/
theorem rest_shiftMatrix_mulVec_single (t : ZMod N) :
    shiftMatrix (ZMod 2) N 1 *ᵥ Pi.single t (1 : ZMod 2) = Pi.single (t + 1) 1 := by
  rw [Matrix.mulVec_single_one]
  funext a
  rw [Matrix.col_apply, shiftMatrix_apply, Int.cast_one, Pi.single_apply]
  by_cases h : a = t + 1
  · rw [if_pos h.symm, if_pos h]
  · rw [if_neg (Ne.symm h), if_neg h]

/-- "`D_ℓ(f) δ_t = f(T^t y_ℓ) δ_t`" (tex l.379): a diagonal matrix scales `δ_t` by its `t`-th entry. -/
theorem rest_diagonal_mulVec_single (d : ZMod N → ZMod 2) (t : ZMod N) :
    Matrix.diagonal d *ᵥ Pi.single t (1 : ZMod 2) = Pi.single t (d t) := by
  rw [Matrix.diagonal_mulVec_single, mul_one]

/-- "`P D_ℓ(f) P^{-1} = D_ℓ(f ∘ T^{-1})`" (tex l.384), matrix side: `P^j diag(d) P^{-j}` is the
translated diagonal. -/
theorem rest_conj_diagonal (j : ℤ) (d : ZMod N → ZMod 2) :
    shiftMatrix (ZMod 2) N j * Matrix.diagonal d * shiftMatrix (ZMod 2) N (-j) =
      Matrix.diagonal fun t => d (t - (j : ZMod N)) :=
  shiftMatrix_mul_diagonal_mul_shiftMatrix_neg j d

/-- "The shifts are distinct, so products of the `P^i D_ℓ(e_a) P^{-i}` give every diagonal matrix
unit, and with `P` every matrix unit" (tex l.388–391): for a cyclic word `c` with pairwise distinct
translates, the ring generated by `P`, `P⁻¹` and the letter diagonals contains the translated letter
diagonals, every diagonal matrix unit and every matrix unit, and is `M_N(F₂)`. -/
theorem rest_matrixUnits {A : Type*} [DecidableEq A] (c : ZMod N → A)
    (hdist : ∀ t t' : ZMod N, (∀ i : ZMod N, c (t + i) = c (t' + i)) → t = t') :
    (∀ (i : ZMod N) (a : A), (Matrix.diagonal fun t => if c (t + i) = a then (1 : ZMod 2) else 0) ∈
      Subring.closure (periodicGenerators c)) ∧
    (∀ t : ZMod N, Matrix.single t t (1 : ZMod 2) ∈ Subring.closure (periodicGenerators c)) ∧
    (∀ s t : ZMod N, Matrix.single s t (1 : ZMod 2) ∈ Subring.closure (periodicGenerators c)) ∧
    Subring.closure (periodicGenerators c) = ⊤ :=
  ⟨translatedLetter_mem_closure c, single_self_mem_closure c hdist, single_mem_closure c hdist,
    subring_closure_periodicGenerators_eq_top c hdist⟩

end Generic

section Cutoff

variable {A : Type} [TopologicalSpace A] {X : Set (ℤ → A)} {T : ↥X ≃ₜ ↥X} {N : ℕ} [NeZero N]

/-- "Put `φ_ℓ(Σ_j f_j u^j) = Σ_j D_ℓ(f_j) P^j` when every `f_j` is of this kind" (tex l.381–382). -/
theorem rest_cutoffModel_eq_sum (D : ClopenCoeff T (ZMod 2) →+* (ZMod N → ZMod 2)) {ℓ : ℕ}
    {r : ClopenCrossedProduct T (ZMod 2)}
    (hr : ∀ g ∈ SkewMonoidAlgebra.support r, DependsOnWindow T ℓ (SkewMonoidAlgebra.coeff r g)) :
    cutoffModel D ℓ r = ∑ g ∈ SkewMonoidAlgebra.support r,
      Matrix.diagonal (D (SkewMonoidAlgebra.coeff r g)) * shiftMatrix (ZMod 2) N (toAdd g) := by
  rw [cutoffModel_eq_of D hr, periodicModel_eq_sum]

/-- "... and `φ_ℓ = 0` otherwise" (tex l.383). -/
theorem rest_cutoffModel_of_not (D : ClopenCoeff T (ZMod 2) →+* (ZMod N → ZMod 2)) {ℓ : ℕ}
    {r : ClopenCrossedProduct T (ZMod 2)}
    (hr : ¬ ∀ g ∈ SkewMonoidAlgebra.support r, DependsOnWindow T ℓ (SkewMonoidAlgebra.coeff r g)) :
    cutoffModel D ℓ r = 0 := by
  unfold cutoffModel
  rw [if_neg hr]

end Cutoff

section Subshift

variable {A : Type} [TopologicalSpace A] [DiscreteTopology A] [DecidableEq A] [Finite A]

/-- **The sentences of tex l.377–391** for a point `x` of a subshift `S`: recurrence positions `m ℓ`,
least periods `N ℓ` of `y_ℓ = periodicExt x (m ℓ)`, and diagonal evaluations `D ℓ`, with the printed
properties of `D_ℓ`, `P` and `φ_ℓ = cutoffModel (D ℓ) ℓ`. -/
abbrev ProofRestModels (S : Subshift A ℤ) (x : ℤ → A) : Prop :=
  ∃ (m N : ℕ → ℕ) (_ : ∀ ℓ, NeZero (N ℓ))
    (D : ∀ ℓ, ClopenCoeff (subshiftHomeo S) (ZMod 2) →+* (ZMod (N ℓ) → ZMod 2)),
    (∀ ℓ, 2 * ℓ + 1 ≤ m ℓ ∧ N ℓ = leastPeriod (periodicExt x (m ℓ)) ∧ 0 < N ℓ) ∧
    Tendsto N atTop atTop ∧
    (∀ (ℓ : ℕ) (f : ClopenCoeff (subshiftHomeo S) (ZMod 2)), DependsOnWindow (subshiftHomeo S) ℓ f →
      ∀ (t : ℤ) (z : ↥S.carrier), (∀ i : ℤ, |i| ≤ ℓ → z.1 i = periodicExt x (m ℓ) (t + i)) →
        Matrix.diagonal (D ℓ f) *ᵥ Pi.single (t : ZMod (N ℓ)) (1 : ZMod 2) =
          Pi.single (t : ZMod (N ℓ)) ((ClopenCoeff.of (subshiftHomeo S) (ZMod 2)).symm f z)) ∧
    (∀ (ℓ ℓ' : ℕ) (f : ClopenCoeff (subshiftHomeo S) (ZMod 2)), DependsOnWindow (subshiftHomeo S) ℓ' f →
      ∀ j : ℤ, (ℓ' : ℤ) + |j| ≤ ℓ →
        shiftMatrix (ZMod 2) (N ℓ) j * Matrix.diagonal (D ℓ f) * shiftMatrix (ZMod 2) (N ℓ) (-j) =
          Matrix.diagonal (D ℓ (ofAdd j • f))) ∧
    (∀ r s : R S, ∀ᶠ ℓ in atTop,
      cutoffModel (D ℓ) ℓ (r + s) = cutoffModel (D ℓ) ℓ r + cutoffModel (D ℓ) ℓ s ∧
        cutoffModel (D ℓ) ℓ (r * s) = cutoffModel (D ℓ) ℓ r * cutoffModel (D ℓ) ℓ s) ∧
    (∀ ℓ, cutoffModel (D ℓ) ℓ 1 = 1) ∧
    (∀ (ℓ : ℕ) (j : ℤ), cutoffModel (D ℓ) ℓ ((unit (subshiftHomeo S) (ZMod 2) ^ j : (R S)ˣ) : R S) =
      shiftMatrix (ZMod 2) (N ℓ) j) ∧
    (∀ (ℓ : ℕ) (a : A), cutoffModel (D ℓ) ℓ (coeff (subshiftHomeo S) (ZMod 2) (letterIndicator S a)) =
      letterDiagonal (fun t : ZMod (N ℓ) => periodicExt x (m ℓ) ((t.val : ℕ) : ℤ)) a) ∧
    (∀ (ℓ : ℕ) (t t' : ZMod (N ℓ)), (∀ i : ZMod (N ℓ),
      periodicExt x (m ℓ) (((t + i).val : ℕ) : ℤ) = periodicExt x (m ℓ) (((t' + i).val : ℕ) : ℤ)) →
        t = t') ∧
    (∀ (ℓ : ℕ) (s t : ZMod (N ℓ)), Matrix.single s t (1 : ZMod 2) ∈
      Subring.closure (cutoffModel (D ℓ) ℓ '' printedGeneratorsSet S)) ∧
    ∀ ℓ, Subring.closure (cutoffModel (D ℓ) ℓ '' printedGeneratorsSet S) = ⊤

/-- **The rest of the proof of `thm:main`** (tex l.377–391), for every point of an infinite minimal
subshift. -/
theorem rest_models (S : Subshift A ℤ) (hinf : Infinite S.carrier) (hmin : IsMinimal S)
    {x : ℤ → A} (hx : x ∈ S.carrier) : ProofRestModels S x := by
  classical
  obtain ⟨m, N, hNz, D, hwords, hform, hcov, htend, hmul⟩ :=
    exists_asymptoticModels S.isClosed S.mapsTo (Set.infinite_coe_iff.1 hinf) hmin (subshiftHomeo S)
      (fun _ => rfl) hx (ZMod 2)
  haveI : ∀ ℓ, NeZero (N ℓ) := hNz
  have hpt : ∀ (ℓ : ℕ) (t : ℤ), ∃ z : ↥S.carrier, ∀ i : ℤ, |i| ≤ ℓ →
      z.1 i = periodicExt x (m ℓ) (t + i) := by
    intro ℓ t
    have hwin : WordGraph.word (periodicExt x (m ℓ)) (t - ℓ) (2 * ℓ + 1) ∈
        WordGraph.language S.carrier (2 * ℓ + 1) := by
      rw [← (hwords ℓ).2.2.2]
      exact ⟨t - ℓ, rfl⟩
    obtain ⟨z0, hz0, hz0w⟩ := hwin
    refine ⟨⟨shift (ℓ : ℤ) z0, S.mapsTo ℓ hz0⟩, fun i hi => ?_⟩
    obtain ⟨hi1, hi2⟩ := abs_le.mp hi
    obtain ⟨j, hj⟩ : ∃ j : ℕ, (j : ℤ) = ℓ + i := ⟨(ℓ + i).toNat, Int.toNat_of_nonneg (by omega)⟩
    have h := congrFun hz0w ⟨j, by omega⟩
    simp only [WordGraph.word_apply, zero_add] at h
    show z0 (ℓ + i) = _
    rw [← hj, h]
    congr 1
    omega
  have hletter : ∀ (ℓ : ℕ) (a : A),
      cutoffModel (D ℓ) ℓ (coeff (subshiftHomeo S) (ZMod 2) (letterIndicator S a)) =
        letterDiagonal (fun t : ZMod (N ℓ) => periodicExt x (m ℓ) ((t.val : ℕ) : ℤ)) a := by
    intro ℓ a
    have hdep : DependsOnWindow (subshiftHomeo S) ℓ (ClopenCoeff.of _ (ZMod 2) (letterIndicator S a)) :=
      fun y z hyz => by
        show (if y.1 0 = a then (1 : ZMod 2) else 0) = if z.1 0 = a then 1 else 0
        rw [hyz 0 (by simp)]
    rw [ClopenCrossedProduct.coeff_apply, Pestov91.CrossedProduct.C_apply,
      cutoffModel_eq_of (D ℓ) fun g _ => by
        rw [SkewMonoidAlgebra.coeff_single_apply]
        split_ifs
        · exact hdep
        · exact dependsOnWindow_zero_or_one (Or.inl rfl), periodicModel_single, toAdd_one,
      shiftMatrix_zero, mul_one]
    refine congrArg diagonal (funext fun t => ?_)
    obtain ⟨z, hz⟩ := hpt ℓ ((t.val : ℕ) : ℤ)
    have hform' := hform ℓ _ hdep ((t.val : ℕ) : ℤ) z hz
    rw [Int.cast_natCast, ZMod.natCast_zmod_val] at hform'
    rw [hform']
    show (if z.1 0 = a then (1 : ZMod 2) else 0) =
      if periodicExt x (m ℓ) ((t.val : ℕ) : ℤ) = a then 1 else 0
    rw [hz 0 (by simp), add_zero]
  have hdist : ∀ (ℓ : ℕ) (t t' : ZMod (N ℓ)), (∀ i : ZMod (N ℓ),
      periodicExt x (m ℓ) (((t + i).val : ℕ) : ℤ) = periodicExt x (m ℓ) (((t' + i).val : ℕ) : ℤ)) →
        t = t' :=
    fun ℓ => translates_distinct_of_leastPeriod (periodicExt x (m ℓ)) (hwords ℓ).2.2.1.symm
  have hsub : ∀ ℓ : ℕ,
      periodicGenerators (fun t : ZMod (N ℓ) => periodicExt x (m ℓ) ((t.val : ℕ) : ℤ)) ⊆
        cutoffModel (D ℓ) ℓ '' printedGeneratorsSet S := by
    intro ℓ
    rintro _ (h | ⟨a, rfl⟩)
    · rcases h with rfl | rfl
      · refine ⟨((unit (subshiftHomeo S) (ZMod 2) : (R S)ˣ) : R S),
          Set.mem_insert_of_mem _ (Or.inl (Or.inl rfl)), ?_⟩
        simpa only [zpow_one] using cutoffModel_unit_zpow (D ℓ) ℓ 1
      · refine ⟨(((unit (subshiftHomeo S) (ZMod 2))⁻¹ : (R S)ˣ) : R S),
          Set.mem_insert_of_mem _ (Or.inl (Or.inr rfl)), ?_⟩
        simpa only [zpow_neg, zpow_one] using cutoffModel_unit_zpow (D ℓ) ℓ (-1)
    · exact ⟨_, Set.mem_insert_of_mem _ (Or.inr ⟨a, rfl⟩), hletter ℓ a⟩
  refine ⟨m, N, hNz, D, fun ℓ => ⟨(hwords ℓ).1, (hwords ℓ).2.2.1, Nat.pos_of_ne_zero (NeZero.ne (N ℓ))⟩,
    htend, fun ℓ f hf t z hz => ?_, fun ℓ ℓ' f hf j hj => ?_, fun r s => ?_,
    fun ℓ => cutoffModel_one (D ℓ) ℓ, fun ℓ j => cutoffModel_unit_zpow (D ℓ) ℓ j, hletter, hdist,
    fun ℓ s t => Subring.closure_mono (hsub ℓ)
      (single_mem_closure (fun t : ZMod (N ℓ) => periodicExt x (m ℓ) ((t.val : ℕ) : ℤ)) (hdist ℓ) s t),
    fun ℓ => eq_top_iff.2 ((subring_closure_periodicGenerators_eq_top
      (fun t : ZMod (N ℓ) => periodicExt x (m ℓ) ((t.val : ℕ) : ℤ)) (hdist ℓ)).ge.trans
        (Subring.closure_mono (hsub ℓ)))⟩
  · rw [Matrix.diagonal_mulVec_single, mul_one, hform ℓ f hf t z hz]
  · rw [shiftMatrix_mul_diagonal_mul_shiftMatrix_neg]
    exact congrArg Matrix.diagonal (funext fun n => (hcov ℓ ℓ' f hf (ofAdd j) hj n).symm)
  · filter_upwards [eventually_cutoffModel_eq S.isClosed D r, eventually_cutoffModel_eq S.isClosed D s,
      eventually_cutoffModel_eq S.isClosed D (r + s), eventually_cutoffModel_eq S.isClosed D (r * s),
      hmul r s] with ℓ hr hs hrs hrms hm
    exact ⟨by rw [hrs, hr, hs, map_add], by rw [hrms, hr, hs, hm]⟩

end Subshift

/-- "... and Theorem~\ref{thm:general} applies" (tex l.391): `thm:general` together with the
periodic approximations gives `thm:main`. -/
theorem rest_theoremGeneralApplies : PrintedSimpleKazhdanSoficMain :=
  printedSimpleKazhdanSoficMain_of_periodic printedPeriodicMatricialStatement

/-- The sentences of tex l.377–391 as one closed statement: every point of every infinite minimal
subshift over a finite alphabet carries the least periods, the maps `φ_ℓ` and the matrix units of
the proof of `thm:main`. -/
def PrintedMainProofRest : Prop :=
  ∀ (A : Type) [TopologicalSpace A] [DiscreteTopology A] [DecidableEq A] [Finite A]
    (S : Subshift A ℤ), Infinite S.carrier → IsMinimal S → ∀ x ∈ S.carrier, ProofRestModels S x

/-- **The rest of the proof of `thm:main`** (tex l.377–391), unconditionally. -/
theorem printedMainProofRest : PrintedMainProofRest := by
  intro _ _ _ _ _ S hinf hmin _ hx
  exact rest_models S hinf hmin hx

end GroupApproximation.Full.SK05

