import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCohnHomog.Monomial
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCohnHomog.Shift
import GroupApproximation.Meta.AxiomGuard

/-!
# Splitting Steinberg generators into homogeneous pieces (lane sk-lv-05)

`simple_kazhdan_sofic_group.tex` l.733-735 (`sec:questions`), leaf T1b.iii: stable `K₂` of the
Cohn algebra `C = C_2(𝔽₂)` vanishes.  This file carries out the splitting step of the homogeneous
elimination route.

* `skCohnHo_x_mem_monoSt`: every `x_{ij}(a)` is a product of monomial generators
  `x_{ij}(x_μ y_ν)`.  Write `a` as a sum of monomials (`skCohnHo_mem_monoSpan`) and use
  `x_{ij}(a + b) = x_{ij}(a) x_{ij}(b)`.
* `skCohnHo_monoSt_eq_top`: the monomial generators generate `St_n(C)`.
* `skCohnHo_mono_mem_gradedSt`: `x_{ij}(x_μ y_ν)` lies in `skCohnGr_gradedSt m` whenever
  `m i + |μ| = m j + |ν|`.
* `skCohnHo_mono_exists_potential`: each monomial generator is graded for some potential.
* `skCohnHo_iSup_gradedSt_eq_top`: `St_n(C)` is generated by the graded subgroups
  `skCohnGr_gradedSt m`, with `m` ranging over all potentials.

**Obstacle (loud).**  This lane does not close `skCohnGr_gradedGenStatement`.  After the split,
a relation `k ∈ K₂` is a word in generators that are each graded for their own potential.  To get
into one `skCohnGr_gradedSt m` all letters must share a single potential.  That is exactly the
graded-generation statement.  It is equivalent to stable surjectivity of `K₂(C₀) → K₂(C)`
(`LVCohnGraded.Reduction`).  For a corner skew Laurent ring this surjectivity is the
`NK₂`-vanishing / localization (Yao, Quillen) part of the fundamental theorem.  It is not a formal
Steinberg manipulation.  For `A[t, t⁻¹]` the analogous graded-generation statement fails whenever
`A^× ≠ 1` or `NK₂(A) ≠ 0`.  The corpus has no free-algebra Gersten / homotopy-invariance input:
`LVFreeAlgK2/Endpoint.lean` imports a missing `LVFreeAlgGersten` module.  Every residual we could
state that implies the target is Prop-equivalent to it.  So, per the lane mandate, no residual is
stated here.
-/

namespace GroupApproximation.Full.LVCohnHomog

open LVCohnRelK1 SteinbergGroup

noncomputable section

/-- The subgroup of `St_n(C_2(𝔽₂))` generated by the monomial generators `x_{ij}(x_μ y_ν)`.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def skCohnHo_monoSt (n : ℕ) : Subgroup (SteinbergGroup (Fin n) CohnTwoF2) :=
  Subgroup.closure {g | ∃ (i j : Fin n) (hij : i ≠ j) (μ ν : List Bool),
    g = x i j hij (xw μ * yw ν)}

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_monoSt

/-- `x_{ij}(k • b) = x_{ij}(b)^k` stays in any subgroup containing `x_{ij}(b)`.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem skCohnHo_x_nsmul_mem {n : ℕ} {H : Subgroup (SteinbergGroup (Fin n) CohnTwoF2)}
    {i j : Fin n} (hij : i ≠ j) {b : CohnTwoF2} (hb : x i j hij b ∈ H) :
    ∀ k : ℕ, x i j hij (k • b) ∈ H
  | 0 => by
    rw [zero_nsmul, x_zero]
    exact one_mem H
  | k + 1 => by
    rw [succ_nsmul, ← x_mul]
    exact mul_mem (skCohnHo_x_nsmul_mem hij hb k) hb

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_x_nsmul_mem

/-- **Splitting**: every Steinberg generator `x_{ij}(a)` over `C_2(𝔽₂)` is a product of
monomial generators `x_{ij}(x_μ y_ν)`.  (`simple_kazhdan_sofic_group.tex` l.733-735,
leaf T1b.iii.) -/
theorem skCohnHo_x_mem_monoSt {n : ℕ} {i j : Fin n} (hij : i ≠ j) (a : CohnTwoF2) :
    x i j hij a ∈ skCohnHo_monoSt n := by
  have ha := skCohnHo_mem_monoSpan a
  unfold skCohnHo_monoSpan at ha
  induction ha using Submodule.span_induction with
  | mem _ hq =>
    obtain ⟨q, rfl⟩ := hq
    exact Subgroup.subset_closure ⟨i, j, hij, q.1, q.2, rfl⟩
  | zero =>
    rw [x_zero]
    exact one_mem _
  | add _ _ _ _ hb hc =>
    rw [← x_mul]
    exact mul_mem hb hc
  | smul r b _ hb =>
    rw [← ZMod.natCast_zmod_val r, Nat.cast_smul_eq_nsmul]
    exact skCohnHo_x_nsmul_mem hij hb r.val

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_x_mem_monoSt

/-- The monomial generators generate `St_n(C_2(𝔽₂))`.  (`simple_kazhdan_sofic_group.tex`
l.733-735, leaf T1b.iii.) -/
theorem skCohnHo_monoSt_eq_top (n : ℕ) : skCohnHo_monoSt n = ⊤ := by
  refine eq_top_iff.mpr fun g _ => ?_
  refine PresentedGroup.generated_by _ _ ?_ g
  rintro ⟨i, j, hij, a⟩
  change x i j hij a ∈ skCohnHo_monoSt n
  exact skCohnHo_x_mem_monoSt hij a

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_monoSt_eq_top

/-- A monomial generator `x_{ij}(x_μ y_ν)` is graded for every potential with
`m i + |μ| = m j + |ν|`.  (`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem skCohnHo_mono_mem_gradedSt {n : ℕ} (m : Fin n → ℕ) {i j : Fin n} (hij : i ≠ j)
    (μ ν : List Bool) (h : m i + μ.length = m j + ν.length) :
    x i j hij (xw μ * yw ν) ∈ LVCohnGraded.skCohnGr_gradedSt m :=
  LVCohnGraded.skCohnGr_x_mem_gradedSt m hij (LVCohnGraded.skCohnGr_admissible_xw_mul_yw μ ν h)

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_mono_mem_gradedSt

/-- The potential `k ↦ (|ν| if k = i, else |μ|)` aligns the degrees of `x_{ij}(x_μ y_ν)`.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def skCohnHo_alignPotential {n : ℕ} (i : Fin n) (μ ν : List Bool) : Fin n → ℕ :=
  fun k => if k = i then ν.length else μ.length

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_alignPotential

/-- Each monomial generator is graded for its aligning potential.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem skCohnHo_mono_mem_gradedSt_align {n : ℕ} {i j : Fin n} (hij : i ≠ j)
    (μ ν : List Bool) :
    x i j hij (xw μ * yw ν) ∈
      LVCohnGraded.skCohnGr_gradedSt (skCohnHo_alignPotential i μ ν) := by
  refine skCohnHo_mono_mem_gradedSt _ hij μ ν ?_
  unfold skCohnHo_alignPotential
  rw [if_pos rfl, if_neg (Ne.symm hij)]
  exact Nat.add_comm _ _

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_mono_mem_gradedSt_align

/-- Each monomial generator is graded for some potential.  (`simple_kazhdan_sofic_group.tex`
l.733-735, leaf T1b.iii.) -/
theorem skCohnHo_mono_exists_potential {n : ℕ} {i j : Fin n} (hij : i ≠ j) (μ ν : List Bool) :
    ∃ m : Fin n → ℕ, x i j hij (xw μ * yw ν) ∈ LVCohnGraded.skCohnGr_gradedSt m :=
  ⟨skCohnHo_alignPotential i μ ν, skCohnHo_mono_mem_gradedSt_align hij μ ν⟩

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_mono_exists_potential

/-- **Homogeneous generation**: `St_n(C_2(𝔽₂))` is generated by the graded subgroups
`skCohnGr_gradedSt m`, with `m` over all potentials.  The graded-generation statement asks for
one common potential on `K₂`.  That is the precise remaining obstacle; see the module docstring.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem skCohnHo_iSup_gradedSt_eq_top (n : ℕ) :
    ⨆ m : Fin n → ℕ, LVCohnGraded.skCohnGr_gradedSt m = ⊤ := by
  rw [eq_top_iff, ← skCohnHo_monoSt_eq_top n, skCohnHo_monoSt, Subgroup.closure_le]
  rintro g ⟨i, j, hij, μ, ν, rfl⟩
  exact Subgroup.mem_iSup_of_mem (skCohnHo_alignPotential i μ ν)
    (skCohnHo_mono_mem_gradedSt_align hij μ ν)

#audit_axioms GroupApproximation.Full.LVCohnHomog.skCohnHo_iSup_gradedSt_eq_top

end

end GroupApproximation.Full.LVCohnHomog
