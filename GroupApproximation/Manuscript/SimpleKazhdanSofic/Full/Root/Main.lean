/-!
# Root audit for `simple_kazhdan_sofic_group.tex`: the headline statements

Each printed label of the introduction is restated as one closed theorem, a conjunction of the
`Full` endpoints that formalize it.  Every conjunct is the type of a landed endpoint, written
`type_of% @Full.SKxx.name`, so the statement here is by construction the statement proved there, and
the proof is the tuple of those endpoints.

* `thm_main` (tex l.69–80, `thm:main`), `thm_main_brown_form` (tex l.82–84),
  `thm_main_definitions` (tex l.86–109);
* `thm_general` (tex l.172–187, `thm:general`), `general_remark` (tex l.191–195);
* `tab_props` (tex l.198–213, `tab:props`).

The remaining labels are in `Full.Root.Proof` and `Full.Root.Corollaries`; `Full.Root.Manuscript`
collects all of them.
-/

universe u v

namespace GroupApproximation.Full.SKRoot

/-- **`thm:main`** (tex l.69–80): for an infinite minimal subshift `X ⊆ A^ℤ` over a finite alphabet,
`G_X = EL_3(LC(X, F₂) ⋊_T ℤ)` is an infinite, finitely generated, simple group with property (T), an
expander limit of the finite simple groups `SL_{3N}(F₂)`, and so LEF, sofic and hyperlinear.

Conjuncts: the corpus statement `PrintedSimpleKazhdanSoficMain`; `SK05.PrintedMainTheorem` (the
printed sense of every adjective); `SK05.PrintedMainTheoremSK01` (the same with the printed
definitions of tex l.86–109 from `Full.SK01`); and `SK05.main_el`, every `n ≥ 3`. -/
theorem thm_main :
    type_of% @Full.SK05.main ∧
    type_of% @Full.SK05.printedMainTheorem ∧
    type_of% @Full.SK05.printedMainTheoremSK01 ∧
    type_of% @Full.SK05.main_el ∧
    type_of% @Full.SK05.main_printed :=
  ⟨@Full.SK05.main, @Full.SK05.printedMainTheorem, @Full.SK05.printedMainTheoremSK01,
    @Full.SK05.main_el, @Full.SK05.main_printed⟩

/-- **Brown's form of `thm:main`** (tex l.82–84): "In Brown's form, `G_X` lies in the unitary group
of the McDuff factor `L(G_X) ⊗̄ R`, which embeds in `R^ω`."  Conjuncts: `SK06.brownForm_gx`,
`SK06.brownForm_el`, and the instance `SK06.exists_gx_brownForm`. -/
theorem thm_main_brown_form :
    type_of% @Full.SK06.brownForm_gx ∧
    type_of% @Full.SK06.brownForm_el ∧
    type_of% @Full.SK06.exists_gx_brownForm :=
  ⟨@Full.SK06.brownForm_gx, @Full.SK06.brownForm_el, @Full.SK06.exists_gx_brownForm⟩

/-- **The definitions after `thm:main`** (tex l.86–109): marked limits of finite groups are LEF,
expander limits are LEF, the printed definitions of sofic and hyperlinear agree with the corpus
ones, LEF groups are sofic and hyperlinear, and the expander-family bridge (`Full.SK01`). -/
theorem thm_main_definitions :
    type_of% @Full.SK01.limitsOfFiniteGroupsAreLEF_holds.{u} ∧
    type_of% @Full.SK01.expanderLimitsAreLEF_holds.{u} ∧
    type_of% @Full.SK01.printedSoficIff_holds.{u} ∧
    type_of% @Full.SK01.printedHyperlinearIff_holds.{u} ∧
    type_of% @Full.SK01.printedSoficHyperlinear_holds.{u} ∧
    type_of% @Full.SK01.expanderFamilyBridge_holds.{u} :=
  ⟨@Full.SK01.limitsOfFiniteGroupsAreLEF_holds.{u}, @Full.SK01.expanderLimitsAreLEF_holds.{u},
    @Full.SK01.printedSoficIff_holds.{u}, @Full.SK01.printedHyperlinearIff_holds.{u},
    @Full.SK01.printedSoficHyperlinear_holds.{u}, @Full.SK01.expanderFamilyBridge_holds.{u}⟩

/-- **`thm:general`** (tex l.172–187): for a finitely generated group `Λ` acting minimally and
topologically freely on a Cantor set `C`, with `R = LC(C, F₂) ⋊ Λ` generated by a finite `S ∋ 1`,
(a) every `EL_n(R)`, `n ≥ 3`, is an infinite, finitely generated, simple Kazhdan group, and (b) given
asymptotically multiplicative maps `φ_k : R → M_{N_k}(F₂)` with `φ_k(S)` generating the ring,
`EL_n(R)` is an expander limit of the `SL_{nN_k}(F₂)`.

Conjuncts: `SK04.PrintedGeneralTheorem` (parts (a) and (b)); `SK03.PrintedGeneralPartA`; and the
simplicity step `SK02.generalSimple_printed`. -/
theorem thm_general :
    type_of% @Full.SK04.printedGeneralTheorem ∧
    type_of% @Full.SK03.printedGeneralPartA ∧
    type_of% @Full.SK02.generalSimple_printed.{u, v} :=
  ⟨@Full.SK04.printedGeneralTheorem, @Full.SK03.printedGeneralPartA,
    @Full.SK02.generalSimple_printed.{u, v}⟩

/-- **The remark after `thm:general`** (tex l.191–195): "Periodic approximations of `X` give such
maps, and Theorem `thm:main` follows.  Lamplighter actions show that the countable subgroups of the
groups in Theorem `thm:general`(b) are exactly the countable LEF groups (Corollary `cor:host`).  Over
`ℤ` the subshift hypothesis cannot be dropped (Section `sec:main`)."

Conjuncts: `SK05.periodicApproximationsRemark` (periodic approximations give the maps, and
`thm:main` follows); `SK12.countableSubgroupsOfGeneral_iff`; and
`SK07.subshiftHypothesisCannotBeDropped`. -/
theorem general_remark :
    type_of% @Full.SK05.periodicApproximationsRemark ∧
    type_of% @Full.SK12.countableSubgroupsOfGeneral_iff ∧
    type_of% @Full.SK07.subshiftHypothesisCannotBeDropped :=
  ⟨@Full.SK05.periodicApproximationsRemark, @Full.SK12.countableSubgroupsOfGeneral_iff,
    @Full.SK07.subshiftHypothesisCannotBeDropped⟩

/-- **`tab:props`** (tex l.198–213), "Properties of `G_X`", row by row:

* finitely generated, infinite, simple, property (T), expander limit of `SL_{3N}(F₂)`, and LEF,
  sofic, hyperlinear: `SK05.PrintedTabPropsFirstRows`;
* not residually finite, not finitely presented:
  `SK14.PrintedGXNotResiduallyFiniteNotFinitelyPresented`;
* `L(G_X)` is a `II₁` factor in `R^ω`: `SK06.tabProps_T3`;
* the word problem has the Turing degree of `L(X)`: `SK13.corollary`. -/
theorem tab_props :
    type_of% @Full.SK05.tabProps_first_rows ∧
    type_of% @Full.SK14.printedGXNotResiduallyFiniteNotFinitelyPresented ∧
    type_of% @Full.SK06.tabProps_T3 ∧
    type_of% @Full.SK13.corollary :=
  ⟨@Full.SK05.tabProps_first_rows, @Full.SK14.printedGXNotResiduallyFiniteNotFinitelyPresented,
    @Full.SK06.tabProps_T3, @Full.SK13.corollary⟩

end GroupApproximation.Full.SKRoot

