import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVFieldK2.Closure
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVFieldK2.Action

/-!
# Column and row root subgroups of `St_N(𝔽₂)`

`Col q T` is generated by the `x_{iq}(1)` with `i ∈ T`, and `Row p T` by the `x_{pj}(1)` with
`j ∈ T`. Both groups are elementary abelian. They act faithfully on `e_q` and on
`(e_l)_{l ∈ T}` respectively. We also record how `x_{qj}(1)` moves through `Col q T`. These
are the coset-representative facts for Steinberg's argument for `K₂(𝔽₂) = 0`
(Steinberg 1962; Milnor, *Introduction to algebraic K-theory*, §9-10), towards
`simple_kazhdan_sofic_group.tex` l.733-735 (leaf T1b.iii).
-/

namespace GroupApproximation.Full.LVFieldK2

open SteinbergGroup

theorem commute_closure {G : Type*} [Group G] {t : Set G} (x : G) (h : ∀ r ∈ t, Commute x r) :
    ∀ r ∈ Subgroup.closure t, Commute x r := by
  intro r hr
  induction hr using Subgroup.closure_induction with
  | mem a ha => exact h a ha
  | one => exact Commute.one_right x
  | mul a b _ _ ha hb => exact ha.mul_right hb
  | inv a _ ha => exact ha.inv_right

variable {N : ℕ}

theorem zmodTwo_eq_zero_or_one (x : ZMod 2) : x = 0 ∨ x = 1 := by
  revert x
  decide

theorem act_X_eq_self (i j : Fin N) (h : i ≠ j) {v : Fin N → ZMod 2} (hv : v j = 0) :
    act (X i j h) v = v := by
  funext k
  rw [act_X_apply, hv, ite_self, add_zero]

theorem rootSub_act_eq_self {Φ : Fin N → Fin N → Prop} {v : Fin N → ZMod 2}
    (hv : ∀ (i j : Fin N) (h : i ≠ j), Φ i j → act (X i j h) v = v) :
    ∀ y ∈ rootSub Φ, act y v = v := by
  rintro y (hy : y ∈ Subgroup.closure (rootGens Φ))
  induction hy using Subgroup.closure_induction with
  | mem a ha =>
    obtain ⟨i, j, h, hΦ, rfl⟩ := ha
    exact hv i j h hΦ
  | one => exact act_one v
  | mul a b _ _ ha hb => rw [act_mul, hb, ha]
  | inv a _ ha =>
    calc act a⁻¹ v = act a⁻¹ (act a v) := by rw [ha]
      _ = v := act_inv_act a v

/-- A coordinate that is never a row index of a generator is untouched. -/
theorem rootSub_act_apply_of_row {Φ : Fin N → Fin N → Prop} {k : Fin N}
    (hk : ∀ (i j : Fin N), i ≠ j → Φ i j → k ≠ i) :
    ∀ y ∈ rootSub Φ, ∀ v, act y v k = v k := by
  rintro y (hy : y ∈ Subgroup.closure (rootGens Φ))
  induction hy using Subgroup.closure_induction with
  | mem a ha =>
    obtain ⟨i, j, h, hΦ, rfl⟩ := ha
    exact fun v => act_X_apply_of_ne i j h v (hk i j h hΦ)
  | one => exact fun v => by rw [act_one]
  | mul a b _ _ ha hb => exact fun v => by rw [act_mul, ha, hb]
  | inv a _ ha =>
    intro v
    have hv := ha (act a⁻¹ v)
    rw [← act_mul, mul_inv_cancel, act_one] at hv
    exact hv.symm

/-- The Weyl element `w_{ab}` sends `e_b` to `e_a`. -/
theorem act_w_e (a b : Fin N) (hab : a ≠ b) : act (w a b hab) (e b) = e a := by
  funext k
  rw [act_w_apply]
  by_cases hka : k = a
  · rw [hka, Equiv.swap_apply_left, e_self, e_self]
  · by_cases hkb : k = b
    · rw [hkb, Equiv.swap_apply_right, e_ne hab, e_ne hab.symm]
    · rw [Equiv.swap_apply_of_ne_of_ne hka hkb, e_ne hkb, e_ne hka]

/-! ### Columns -/

/-- The column subgroup `⟨x_{iq}(1) : i ∈ T⟩`. -/
def Col (q : Fin N) (T : Finset (Fin N)) : Subgroup (St N) :=
  rootSub (fun i j => i ∈ T ∧ q = j)

theorem X_mem_Col {q : Fin N} {T : Finset (Fin N)} (i : Fin N) (hi : i ∈ T) (h : i ≠ q) :
    X i q h ∈ Col q T :=
  X_mem_rootSub i q h ⟨hi, rfl⟩

theorem Col_mono {q : Fin N} {S T : Finset (Fin N)} (hST : S ⊆ T) : Col q S ≤ Col q T :=
  rootSub_mono (Φ := fun i j => i ∈ S ∧ q = j) (Ψ := fun i j => i ∈ T ∧ q = j)
    fun _ _ _ hΦ => ⟨hST hΦ.1, hΦ.2⟩

theorem Col_act_apply_of_notMem {q k : Fin N} {T : Finset (Fin N)} (hk : k ∉ T) :
    ∀ y ∈ Col q T, ∀ v, act y v k = v k :=
  rootSub_act_apply_of_row (Φ := fun i j => i ∈ T ∧ q = j)
    fun _ _ _ hΦ hki => hk (by rw [hki]; exact hΦ.1)

theorem Col_act_apply_self {q : Fin N} {T : Finset (Fin N)} :
    ∀ y ∈ Col q T, ∀ v, act y v q = v q :=
  rootSub_act_apply_of_row (Φ := fun i j => i ∈ T ∧ q = j)
    fun _ _ hij hΦ hqi => hij (hqi.symm.trans hΦ.2)

theorem Col_split {q j : Fin N} {T : Finset (Fin N)} (hjq : j ≠ q) :
    ∀ y ∈ Col q (insert j T), ∃ y₀ ∈ Col q T, y = y₀ ∨ y = X j q hjq * y₀ := by
  have hconj : ∀ (i b : Fin N) (h : i ≠ b), (i ∈ T ∧ q = b) →
      X j q hjq * X i b h * (X j q hjq)⁻¹ ∈ Col q T := by
    rintro i b h ⟨hi, hqb⟩
    subst hqb
    rw [X_inv, X_comm j q i q hjq h h.symm hjq.symm, mul_assoc, X_mul_self, mul_one]
    exact X_mem_Col i hi h
  have hK : ∀ k ∈ Col q T, X j q hjq * k * X j q hjq ∈ Col q T := by
    intro k hk
    have hc : X j q hjq * k * (X j q hjq)⁻¹ ∈ Col q T := rootSub_conj (X j q hjq) hconj k hk
    rwa [X_inv] at hc
  have hS : ∀ x ∈ rootGens (fun i b => i ∈ insert j T ∧ q = b),
      ∃ k ∈ Col q T, x = k ∨ x = X j q hjq * k := by
    rintro x ⟨i, b, h, ⟨hi, hqb⟩, rfl⟩
    subst hqb
    rcases Finset.mem_insert.mp hi with hij | hi
    · refine ⟨1, (Col q T).one_mem, Or.inr ?_⟩
      rw [mul_one]
      exact X_congr hij rfl h hjq
    · exact ⟨X i q h, X_mem_Col i hi h, Or.inl rfl⟩
  exact closure_split (X j q hjq) (X_mul_self j q hjq) hK hS

theorem Col_split_erase {q j : Fin N} {A : Finset (Fin N)} (hjA : j ∈ A) (hjq : j ≠ q) :
    ∀ y ∈ Col q A, ∃ y₀ ∈ Col q (A.erase j), y = y₀ ∨ y = X j q hjq * y₀ :=
  fun y hy => Col_split hjq y (by rwa [Finset.insert_erase hjA])

/-- `Col q T` acts faithfully on `e_q`. -/
theorem Col_inj {q : Fin N} (T : Finset (Fin N)) :
    ∀ y ∈ Col q T, act y (e q) = e q → y = 1 := by
  induction T using Finset.induction_on with
  | empty =>
    intro y hy _
    have hle : Col q (∅ : Finset (Fin N)) ≤ ⊥ :=
      rootSub_le (Φ := fun i j => i ∈ (∅ : Finset (Fin N)) ∧ q = j)
        fun i _ _ hΦ => absurd hΦ.1 (Finset.notMem_empty i)
    exact Subgroup.mem_bot.mp (hle hy)
  | insert j T hj ih =>
    intro y hy hfix
    by_cases hjq : j = q
    · have hle : Col q (insert j T) ≤ Col q T :=
        rootSub_mono (Φ := fun i b => i ∈ insert j T ∧ q = b)
          (Ψ := fun i b => i ∈ T ∧ q = b)
          fun i b hib hΦ => ⟨(Finset.mem_insert.mp hΦ.1).resolve_left fun hij =>
            hib (hij.trans (hjq.trans hΦ.2)), hΦ.2⟩
      exact ih y (hle hy) hfix
    · obtain ⟨y₀, hy₀, hy'⟩ := Col_split hjq y hy
      rcases hy' with hy' | hy'
      · rw [hy'] at hfix ⊢
        exact ih y₀ hy₀ hfix
      · exfalso
        rw [hy'] at hfix
        have h1 : act y₀ (e q) j = 0 := by rw [Col_act_apply_of_notMem hj y₀ hy₀, e_ne hjq]
        have h2 : act y₀ (e q) q = 1 := by rw [Col_act_apply_self y₀ hy₀, e_self]
        have h3 := congrFun hfix j
        rw [act_mul, act_X_apply_self, h1, h2, e_ne hjq] at h3
        exact absurd h3 (by decide)

/-- Moving `x_{qj}(1)` through `Col q T` (`j ∉ T`) produces a factor in `Col j (T ∖ {q})`. -/
theorem Col_conj_X {q j : Fin N} {T : Finset (Fin N)} (hqj : q ≠ j) (hjT : j ∉ T) :
    ∀ y ∈ Col q T, ∃ c ∈ rootSub (fun a b => a ∈ T ∧ a ≠ q ∧ j = b),
      y⁻¹ * X q j hqj * y = c * X q j hqj := by
  have step : ∀ x ∈ rootGens (fun a b => a ∈ T ∧ q = b),
      ∀ y' ∈ Subgroup.closure (rootGens (fun a b => a ∈ T ∧ q = b)),
      (∃ c ∈ rootSub (fun a b => a ∈ T ∧ a ≠ q ∧ j = b),
        y'⁻¹ * X q j hqj * y' = c * X q j hqj) →
      ∃ c ∈ rootSub (fun a b => a ∈ T ∧ a ≠ q ∧ j = b),
        (x * y')⁻¹ * X q j hqj * (x * y') = c * X q j hqj := by
    rintro x ⟨l, b, hlb, ⟨hl, hqb⟩, rfl⟩ y' hy' ⟨c, hc, hce⟩
    subst hqb
    have hlj : l ≠ j := fun hlj => hjT (by rw [← hlj]; exact hl)
    have hcomm : X l j hlj * y' = y' * X l j hlj := by
      refine (commute_closure (X l j hlj) ?_ y' hy').eq
      rintro r ⟨k, b, hkb, ⟨hk, hqb⟩, rfl⟩
      subst hqb
      exact X_commute l j k q hlj hkb (fun hjk => hjT (by rw [hjk]; exact hk)) hlb.symm
    refine ⟨X l j hlj * c, Subgroup.mul_mem _ (X_mem_rootSub l j hlj ⟨hl, hlb, rfl⟩) hc, ?_⟩
    calc (X l q hlb * y')⁻¹ * X q j hqj * (X l q hlb * y')
        = y'⁻¹ * ((X l q hlb)⁻¹ * X q j hqj * X l q hlb) * y' := by group
      _ = y'⁻¹ * (X l j hlj * X q j hqj) * y' := by rw [X_inv, X_conj_adj l q j hlb hqj hlj]
      _ = y'⁻¹ * (X l j hlj * y') * y'⁻¹ * X q j hqj * y' := by group
      _ = X l j hlj * (y'⁻¹ * X q j hqj * y') := by rw [hcomm]; group
      _ = X l j hlj * c * X q j hqj := by rw [hce, mul_assoc]
  rintro y (hy : y ∈ Subgroup.closure (rootGens (fun a b => a ∈ T ∧ q = b)))
  induction hy using Subgroup.closure_induction_left with
  | one => exact ⟨1, Subgroup.one_mem _, by group⟩
  | mul_left x hx y' hy' ih => exact step x hx y' hy' ih
  | inv_mul_cancel x hx y' hy' ih => exact step x⁻¹ (rootGens_inv x hx) y' hy' ih

/-! ### Rows -/

/-- The row subgroup `⟨x_{pj}(1) : j ∈ T⟩`. -/
def Row (p : Fin N) (T : Finset (Fin N)) : Subgroup (St N) :=
  rootSub (fun i j => p = i ∧ j ∈ T)

theorem X_mem_Row {p : Fin N} {T : Finset (Fin N)} (j : Fin N) (hj : j ∈ T) (h : p ≠ j) :
    X p j h ∈ Row p T :=
  X_mem_rootSub p j h ⟨rfl, hj⟩

theorem Row_act_apply_of_ne {p k : Fin N} {T : Finset (Fin N)} (hk : k ≠ p) :
    ∀ r ∈ Row p T, ∀ v, act r v k = v k :=
  rootSub_act_apply_of_row (Φ := fun i j => p = i ∧ j ∈ T)
    fun _ _ _ hΦ hki => hk (hki.trans hΦ.1.symm)

theorem Row_fix {p : Fin N} {T : Finset (Fin N)} {v : Fin N → ZMod 2}
    (hv : ∀ j ∈ T, v j = 0) :
    ∀ r ∈ Row p T, act r v = v :=
  rootSub_act_eq_self (Φ := fun i j => p = i ∧ j ∈ T)
    fun i j h hΦ => act_X_eq_self i j h (hv j hΦ.2)

theorem Row_split {p j : Fin N} {T : Finset (Fin N)} (hpj : p ≠ j) :
    ∀ r ∈ Row p (insert j T), ∃ r₀ ∈ Row p T, r = r₀ ∨ r = X p j hpj * r₀ := by
  have hconj : ∀ (a k : Fin N) (h : a ≠ k), (p = a ∧ k ∈ T) →
      X p j hpj * X a k h * (X p j hpj)⁻¹ ∈ Row p T := by
    rintro a k h ⟨hpa, hk⟩
    subst hpa
    rw [X_inv, X_comm p j p k hpj h hpj.symm h.symm, mul_assoc, X_mul_self, mul_one]
    exact X_mem_Row k hk h
  have hK : ∀ k ∈ Row p T, X p j hpj * k * X p j hpj ∈ Row p T := by
    intro k hk
    have hc : X p j hpj * k * (X p j hpj)⁻¹ ∈ Row p T := rootSub_conj (X p j hpj) hconj k hk
    rwa [X_inv] at hc
  have hS : ∀ x ∈ rootGens (fun a k => p = a ∧ k ∈ insert j T),
      ∃ k ∈ Row p T, x = k ∨ x = X p j hpj * k := by
    rintro x ⟨a, k, h, ⟨hpa, hk⟩, rfl⟩
    subst hpa
    rcases Finset.mem_insert.mp hk with hkj | hk
    · refine ⟨1, (Row p T).one_mem, Or.inr ?_⟩
      rw [mul_one]
      exact X_congr rfl hkj h hpj
    · exact ⟨X p k h, X_mem_Row k hk h, Or.inl rfl⟩
  exact closure_split (X p j hpj) (X_mul_self p j hpj) hK hS

/-- `Row p T` (`p ∉ T`) acts faithfully on `(e_l)_{l ∈ T}`. -/
theorem Row_inj {p : Fin N} (T : Finset (Fin N)) :
    p ∉ T → ∀ r ∈ Row p T, (∀ l ∈ T, act r (e l) = e l) → r = 1 := by
  induction T using Finset.induction_on with
  | empty =>
    intro _ r hr _
    have hle : Row p (∅ : Finset (Fin N)) ≤ ⊥ :=
      rootSub_le (Φ := fun i j => p = i ∧ j ∈ (∅ : Finset (Fin N)))
        fun _ k _ hΦ => absurd hΦ.2 (Finset.notMem_empty k)
    exact Subgroup.mem_bot.mp (hle hr)
  | insert j T hj ih =>
    intro hpT r hr hfix
    have hpj : p ≠ j := fun hpj => hpT (by rw [hpj]; exact Finset.mem_insert_self j T)
    obtain ⟨r₀, hr₀, hr'⟩ := Row_split hpj r hr
    rcases hr' with hr' | hr'
    · rw [hr'] at hfix ⊢
      exact ih (fun hp => hpT (Finset.mem_insert_of_mem hp)) r₀ hr₀
        fun l hl => hfix l (Finset.mem_insert_of_mem hl)
    · exfalso
      rw [hr'] at hfix
      have h1 : act r₀ (e j) = e j :=
        Row_fix (p := p) (T := T) (v := e j)
          (fun k hk => e_ne fun hkj => hj (by rw [← hkj]; exact hk)) r₀ hr₀
      have h3 := congrFun (hfix j (Finset.mem_insert_self j T)) p
      rw [act_mul, h1, act_X_apply_self, e_ne hpj, e_self] at h3
      exact absurd h3 (by decide)

end GroupApproximation.Full.LVFieldK2
