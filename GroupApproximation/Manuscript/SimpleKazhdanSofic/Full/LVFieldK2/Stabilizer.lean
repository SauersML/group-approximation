import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVFieldK2.ColRow

/-!
# The inductive stabilizer step in Steinberg's argument for `K₂(𝔽₂) = 0`

`Blk A` is generated by the `x_{ij}(1)` with `i, j ∈ A`. `Hp p A` is the subgroup of those with
`j ≠ p`, and it contains the stabilizer of `e_p` in `Blk A` (proved by the Schreier argument in
`SchreierChecks`). For `A = insert p B` every element of `Hp p A` has the form `g₀ r` with
`g₀ ∈ Blk B` and `r` in the row group `Row p B`. So faithfulness of `Blk B` on `(e_l)_{l ∈ B}`
carries over to faithfulness of `Hp p A` on `(e_l)_{l ∈ A}`
(Steinberg 1962; Milnor, *Introduction to algebraic K-theory*, §9-10), towards
`simple_kazhdan_sofic_group.tex` l.733-735 (leaf T1b.iii).
-/

namespace GroupApproximation.Full.LVFieldK2

open SteinbergGroup

variable {N : ℕ}

/-- The block subgroup `⟨x_{ij}(1) : i, j ∈ A⟩`. -/
def Blk (A : Finset (Fin N)) : Subgroup (St N) :=
  rootSub (fun i j => i ∈ A ∧ j ∈ A)

/-- The subgroup `⟨x_{ij}(1) : i, j ∈ A, j ≠ p⟩`. -/
def Hp (p : Fin N) (A : Finset (Fin N)) : Subgroup (St N) :=
  rootSub (fun i j => i ∈ A ∧ j ∈ A ∧ j ≠ p)

theorem X_mem_Blk {A : Finset (Fin N)} (i j : Fin N) (h : i ≠ j) (hi : i ∈ A) (hj : j ∈ A) :
    X i j h ∈ Blk A :=
  X_mem_rootSub (Φ := fun i j => i ∈ A ∧ j ∈ A) i j h ⟨hi, hj⟩

theorem X_mem_Hp {p : Fin N} {A : Finset (Fin N)} (i j : Fin N) (h : i ≠ j) (hi : i ∈ A)
    (hj : j ∈ A) (hjp : j ≠ p) : X i j h ∈ Hp p A :=
  X_mem_rootSub (Φ := fun i j => i ∈ A ∧ j ∈ A ∧ j ≠ p) i j h ⟨hi, hj, hjp⟩

theorem Hp_le_Blk (p : Fin N) (A : Finset (Fin N)) : Hp p A ≤ Blk A :=
  rootSub_mono (Φ := fun i j => i ∈ A ∧ j ∈ A ∧ j ≠ p)
    (Ψ := fun i j => i ∈ A ∧ j ∈ A) fun _ _ _ hΦ => ⟨hΦ.1, hΦ.2.1⟩

theorem Blk_act_apply_of_notMem {k : Fin N} {A : Finset (Fin N)} (hk : k ∉ A) :
    ∀ g ∈ Blk A, ∀ v, act g v k = v k :=
  rootSub_act_apply_of_row (Φ := fun i j => i ∈ A ∧ j ∈ A)
    fun _ _ _ hΦ hki => hk (by rw [hki]; exact hΦ.1)

/-- `Blk B` normalizes `Row p B` when `p ∉ B`. -/
theorem Row_normal {p : Fin N} {B : Finset (Fin N)} (hpB : p ∉ B) :
    ∀ g ∈ Blk B, ∀ r ∈ Row p B, g * r * g⁻¹ ∈ Row p B := by
  have gen : ∀ x ∈ rootGens (fun i j => i ∈ B ∧ j ∈ B), ∀ r ∈ Row p B,
      x * r * x⁻¹ ∈ Row p B := by
    rintro x ⟨i, j, h, ⟨hi, hj⟩, rfl⟩
    have hpj : p ≠ j := fun hpj => hpB (by rw [hpj]; exact hj)
    refine rootSub_conj (Φ := fun a k => p = a ∧ k ∈ B) (X i j h) ?_
    rintro a k hak ⟨hpa, hk⟩
    subst hpa
    by_cases hik : i = k
    · subst hik
      rw [X_inv, X_conj_adj' p i j hak h hpj]
      exact Subgroup.mul_mem _ (X_mem_Row i hi hak) (X_mem_Row j hj hpj)
    · rw [X_inv, X_comm i j p k h hak hpj.symm (Ne.symm hik), mul_assoc, X_mul_self, mul_one]
      exact X_mem_Row k hk hak
  rintro g (hg : g ∈ Subgroup.closure (rootGens (fun i j => i ∈ B ∧ j ∈ B)))
  induction hg using Subgroup.closure_induction_left with
  | one =>
    intro r hr
    rw [one_mul, inv_one, mul_one]
    exact hr
  | mul_left x hx y _ ih =>
    intro r hr
    have he : x * y * r * (x * y)⁻¹ = x * (y * r * y⁻¹) * x⁻¹ := by group
    rw [he]
    exact gen x hx _ (ih r hr)
  | inv_mul_cancel x hx y _ ih =>
    intro r hr
    have he : x⁻¹ * y * r * (x⁻¹ * y)⁻¹ = x⁻¹ * (y * r * y⁻¹) * x⁻¹⁻¹ := by
      group
    rw [he]
    exact gen x⁻¹ (rootGens_inv x hx) _ (ih r hr)

/-- Every element of `Hp p (insert p B)` is `g₀ r` with `g₀ ∈ Blk B` and `r ∈ Row p B`. -/
theorem Hp_decomp {p : Fin N} {B : Finset (Fin N)} (hpB : p ∉ B) :
    ∀ k ∈ Hp p (insert p B), ∃ g₀ ∈ Blk B, ∃ r ∈ Row p B, k = g₀ * r := by
  have step : ∀ x ∈ rootGens (fun i j => i ∈ insert p B ∧ j ∈ insert p B ∧ j ≠ p),
      ∀ y : St N, (∃ g₀ ∈ Blk B, ∃ r ∈ Row p B, y = g₀ * r) →
      ∃ g₀ ∈ Blk B, ∃ r ∈ Row p B, x * y = g₀ * r := by
    rintro x ⟨i, j, h, ⟨hi, hj, hjp⟩, rfl⟩ y ⟨g₀, hg₀, r, hr, hy⟩
    have hjB : j ∈ B := (Finset.mem_insert.mp hj).resolve_left hjp
    rcases Finset.mem_insert.mp hi with hip | hiB
    · have hpj : p ≠ j := fun hpj => hjp hpj.symm
      have hx : X i j h = X p j hpj := X_congr hip rfl h hpj
      have hc : g₀⁻¹ * X p j hpj * g₀⁻¹⁻¹ ∈ Row p B :=
        Row_normal hpB g₀⁻¹ ((Blk B).inv_mem hg₀) (X p j hpj) (X_mem_Row j hjB hpj)
      rw [inv_inv] at hc
      refine ⟨g₀, hg₀, g₀⁻¹ * X p j hpj * g₀ * r, (Row p B).mul_mem hc hr, ?_⟩
      rw [hx, hy]
      group
    · refine ⟨X i j h * g₀, (Blk B).mul_mem (X_mem_Blk i j h hiB hjB) hg₀, r, hr, ?_⟩
      rw [hy, mul_assoc]
  rintro k (hk : k ∈ Subgroup.closure
    (rootGens (fun i j => i ∈ insert p B ∧ j ∈ insert p B ∧ j ≠ p)))
  induction hk using Subgroup.closure_induction_left with
  | one => exact ⟨1, (Blk B).one_mem, 1, (Row p B).one_mem, (mul_one 1).symm⟩
  | mul_left x hx y _ ih => exact step x hx y ih
  | inv_mul_cancel x hx y _ ih => exact step x⁻¹ (rootGens_inv x hx) y ih

/-- The inductive step: faithfulness of `Blk B` on `(e_l)_{l ∈ B}` gives faithfulness of
`Hp p (insert p B)` on `(e_l)_{l ∈ insert p B}`. -/
theorem stab_step {p : Fin N} {B : Finset (Fin N)} (hpB : p ∉ B)
    (ih : ∀ g ∈ Blk B, (∀ l ∈ B, act g (e l) = e l) → g = 1) :
    ∀ g ∈ Hp p (insert p B), (∀ l ∈ insert p B, act g (e l) = e l) → g = 1 := by
  intro g hg hfix
  obtain ⟨g₀, hg₀, r, hr, hgr⟩ := Hp_decomp hpB g hg
  rw [hgr] at hfix ⊢
  have hrfix : ∀ l ∈ B, act r (e l) = e l := by
    intro l hl
    funext k
    by_cases hkp : k = p
    · rw [hkp]
      have h1 := congrFun (hfix l (Finset.mem_insert_of_mem hl)) p
      rwa [act_mul, Blk_act_apply_of_notMem hpB g₀ hg₀] at h1
    · exact Row_act_apply_of_ne hkp r hr (e l)
  have hr1 : r = 1 := Row_inj B hpB r hr hrfix
  rw [hr1, mul_one] at hfix ⊢
  exact ih g₀ hg₀ fun l hl => hfix l (Finset.mem_insert_of_mem hl)

end GroupApproximation.Full.LVFieldK2
