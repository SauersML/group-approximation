import Mathlib.Algebra.Group.Subgroup.Pointwise
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVFieldK2.Relations

/-!
# Subgroup closures, the Schreier lemma, and root subgroups of `St_N(𝔽₂)`

Generic closure lemmas: conjugation invariance, a splitting lemma for a closure with one extra
normalizing involution, and the Schreier coset lemma (a stabilizer is contained in any subgroup
containing a transversal and all Schreier generators). These drive Steinberg's argument for
`K₂(𝔽₂) = 0` (Steinberg 1962; Milnor, *Introduction to algebraic K-theory*, §9-10), towards
`simple_kazhdan_sofic_group.tex` l.733-735 (leaf T1b.iii).
-/

namespace GroupApproximation.Full.LVFieldK2

open SteinbergGroup

section Generic

variable {G : Type*} [Group G]

theorem conj_mem_closure {t : Set G} {K : Subgroup G} (g : G) (h : ∀ r ∈ t, g * r * g⁻¹ ∈ K) :
    ∀ r ∈ Subgroup.closure t, g * r * g⁻¹ ∈ K := by
  intro r hr
  induction hr using Subgroup.closure_induction with
  | mem a ha => exact h a ha
  | one =>
    rw [mul_one, mul_inv_cancel]
    exact K.one_mem
  | mul a b _ _ ha hb =>
    have hab : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
    rw [hab]
    exact K.mul_mem ha hb
  | inv a _ ha =>
    have ha' : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
    rw [ha']
    exact K.inv_mem ha

/-- A closure generated by `K` together with an involution `s` normalizing `K` is `K ∪ sK`. -/
theorem closure_split {S : Set G} {K : Subgroup G} (s : G) (hs : s * s = 1)
    (hK : ∀ k ∈ K, s * k * s ∈ K) (hS : ∀ x ∈ S, ∃ k ∈ K, x = k ∨ x = s * k) :
    ∀ g ∈ Subgroup.closure S, ∃ k ∈ K, g = k ∨ g = s * k := by
  intro g hg
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact hS x hx
  | one => exact ⟨1, K.one_mem, Or.inl rfl⟩
  | mul a b _ _ iha ihb =>
    obtain ⟨k, hk, rfl | rfl⟩ := iha <;> obtain ⟨l, hl, rfl | rfl⟩ := ihb
    · exact ⟨k * l, K.mul_mem hk hl, Or.inl rfl⟩
    · refine ⟨s * k * s * l, K.mul_mem (hK k hk) hl, Or.inr ?_⟩
      rw [show s * (s * k * s * l) = (s * s) * (k * (s * l)) by simp only [mul_assoc], hs,
        one_mul]
    · exact ⟨k * l, K.mul_mem hk hl, Or.inr (mul_assoc s k l)⟩
    · exact ⟨s * k * s * l, K.mul_mem (hK k hk) hl, Or.inl (mul_assoc (s * k) s l).symm⟩
  | inv a _ iha =>
    obtain ⟨k, hk, rfl | rfl⟩ := iha
    · exact ⟨k⁻¹, K.inv_mem hk, Or.inl rfl⟩
    · refine ⟨s * k⁻¹ * s, hK _ (K.inv_mem hk), Or.inr ?_⟩
      rw [mul_inv_rev, inv_eq_of_mul_eq_one_right hs,
        show s * (s * k⁻¹ * s) = (s * s) * (k⁻¹ * s) by simp only [mul_assoc], hs, one_mul]

/-- The Schreier coset lemma.  `S` is a symmetric generating set acting on `V` through `f`,
`T v` is a set of coset representatives for the points `v`, and every Schreier generator
`t'⁻¹ s t` lies in `H`.  Then every element of `⟨S⟩` fixing `v₀` lies in `H`. -/
theorem schreier {S : Set G} (hSinv : ∀ s ∈ S, s⁻¹ ∈ S) {V : Type*} (f : G → V → V)
    (f_one : ∀ v, f 1 v = v) (f_mul : ∀ a b v, f (a * b) v = f a (f b v))
    (T : V → Set G) (H : Subgroup G)
    (hstep : ∀ s ∈ S, ∀ v, ∀ t ∈ T v, ∃ t' ∈ T (f s v), t'⁻¹ * (s * t) ∈ H)
    (v₀ : V) (hbase : T v₀ ⊆ H) (h1 : (1 : G) ∈ T v₀) :
    ∀ g ∈ Subgroup.closure S, f g v₀ = v₀ → g ∈ H := by
  have claim : ∀ y ∈ Subgroup.closure S, ∀ v, ∀ t ∈ T v,
      ∃ t' ∈ T (f y v), t'⁻¹ * (y * t) ∈ H := by
    intro y hy
    induction hy using Subgroup.closure_induction_left with
    | one =>
      intro v t ht
      rw [f_one]
      refine ⟨t, ht, ?_⟩
      rw [one_mul, inv_mul_cancel]
      exact H.one_mem
    | mul_left x hx y _ ih =>
      intro v t ht
      obtain ⟨t₁, ht₁, h₁⟩ := ih v t ht
      obtain ⟨t₂, ht₂, h₂⟩ := hstep x hx (f y v) t₁ ht₁
      rw [f_mul]
      refine ⟨t₂, ht₂, ?_⟩
      have e : t₂⁻¹ * (x * y * t) = (t₂⁻¹ * (x * t₁)) * (t₁⁻¹ * (y * t)) := by group
      rw [e]
      exact H.mul_mem h₂ h₁
    | inv_mul_cancel x hx y _ ih =>
      intro v t ht
      obtain ⟨t₁, ht₁, h₁⟩ := ih v t ht
      obtain ⟨t₂, ht₂, h₂⟩ := hstep x⁻¹ (hSinv x hx) (f y v) t₁ ht₁
      rw [f_mul]
      refine ⟨t₂, ht₂, ?_⟩
      have e : t₂⁻¹ * (x⁻¹ * y * t) = (t₂⁻¹ * (x⁻¹ * t₁)) * (t₁⁻¹ * (y * t)) := by group
      rw [e]
      exact H.mul_mem h₂ h₁
  intro g hg hfix
  obtain ⟨t', ht', hH⟩ := claim g hg v₀ 1 h1
  rw [hfix] at ht'
  have e : g = t' * (t'⁻¹ * (g * 1)) := by group
  rw [e]
  exact H.mul_mem (hbase ht') hH

end Generic

variable {N : ℕ}

/-- The root elements `x_{ij}(1)` with `Φ i j`. -/
def rootGens (Φ : Fin N → Fin N → Prop) : Set (St N) :=
  {g | ∃ (i j : Fin N) (h : i ≠ j), Φ i j ∧ g = X i j h}

/-- The subgroup of `St_N(𝔽₂)` generated by the root elements `x_{ij}(1)` with `Φ i j`. -/
def rootSub (Φ : Fin N → Fin N → Prop) : Subgroup (St N) :=
  Subgroup.closure (rootGens Φ)

theorem X_mem_rootGens {Φ : Fin N → Fin N → Prop} (i j : Fin N) (h : i ≠ j) (hΦ : Φ i j) :
    X i j h ∈ rootGens Φ :=
  ⟨i, j, h, hΦ, rfl⟩

theorem X_mem_rootSub {Φ : Fin N → Fin N → Prop} (i j : Fin N) (h : i ≠ j) (hΦ : Φ i j) :
    X i j h ∈ rootSub Φ :=
  Subgroup.subset_closure (X_mem_rootGens i j h hΦ)

theorem rootSub_le {Φ : Fin N → Fin N → Prop} {K : Subgroup (St N)}
    (hK : ∀ (i j : Fin N) (h : i ≠ j), Φ i j → X i j h ∈ K) : rootSub Φ ≤ K := by
  refine Subgroup.closure_le.mpr ?_
  rintro g ⟨i, j, h, hΦ, rfl⟩
  exact hK i j h hΦ

theorem rootSub_mono {Φ Ψ : Fin N → Fin N → Prop}
    (hle : ∀ (i j : Fin N), i ≠ j → Φ i j → Ψ i j) : rootSub Φ ≤ rootSub Ψ :=
  rootSub_le fun i j h hΦ => X_mem_rootSub i j h (hle i j h hΦ)

theorem rootGens_inv {Φ : Fin N → Fin N → Prop} : ∀ s ∈ rootGens Φ, s⁻¹ ∈ rootGens Φ := by
  rintro s ⟨i, j, h, hΦ, rfl⟩
  exact ⟨i, j, h, hΦ, X_inv i j h⟩

theorem rootSub_conj {Φ : Fin N → Fin N → Prop} {K : Subgroup (St N)} (g : St N)
    (hK : ∀ (i j : Fin N) (h : i ≠ j), Φ i j → g * X i j h * g⁻¹ ∈ K) :
    ∀ r ∈ rootSub Φ, g * r * g⁻¹ ∈ K := by
  refine conj_mem_closure g ?_
  rintro r ⟨i, j, h, hΦ, rfl⟩
  exact hK i j h hΦ

end GroupApproximation.Full.LVFieldK2
