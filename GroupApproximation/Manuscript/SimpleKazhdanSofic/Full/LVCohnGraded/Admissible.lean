import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCohnColimit.CohnLimK2DegZero
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCohnColimit.Shift
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCornerShift.StableK2
import GroupApproximation.Meta.AxiomGuard

/-!
# Potential-admissible coefficients of `C_2(𝔽₂)` (lane sk-lv-04)

`simple_kazhdan_sofic_group.tex` l.733-735 (`sec:questions`), leaf T1b.iii: stable `K₂` of the
Cohn algebra `C = C_2(𝔽₂)` vanishes.  The degree-zero part `C₀ = LVCohnDegZero.cohnDegreeZero`
has stable `K₂ = 0` (`LVCohnColimit.skCohnLimK2_stableK2Trivial_degreeZero`).  Here we use the
`ℤ`-grading of `C` to handle Steinberg words beyond `C₀`.

A *potential* is a map `m : Fin n → ℕ`.  A coefficient `a ∈ C` is `(p, q)`-*admissible* when
`x₀^p a y₀^q ∈ C₀`.  For example `x_μ y_ν` is `(p, q)`-admissible when `p + |μ| = q + |ν|`.
Admissible coefficients are closed under `+`, `-`, and under the product
`(p, q) × (q, r) → (p, r)`, because `y₀^q x₀^q = 1`.

* `skCohnGr_Admissible`: the admissibility predicate.
* `skCohnGr_gradedSt m`: the subgroup of `St_n(C)` generated by the `x_{ij}(a)` with `a`
  `(m i, m j)`-admissible.
* `skCohnGr_cornerMap_mem_range`: the corner map `x_{ij}(a) ↦ x_{ij}(x₀^{m i} a y₀^{m j})` sends
  `skCohnGr_gradedSt m` into the image of `St_n(C₀)`.
* `skCohnGr_ringMap_mem_gradedSt_zero`: for the zero potential, the image of `St_n(C₀)` lies in
  `skCohnGr_gradedSt 0`.
-/

namespace GroupApproximation.Full.LVCohnGraded

open SteinbergGroup

noncomputable section

/-- `a ∈ C_2(𝔽₂)` is `(p, q)`-admissible when `x₀^p a y₀^q` lies in the degree-zero part `C₀`.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
def skCohnGr_Admissible (p q : ℕ) (a : LVCohnRelK1.CohnTwoF2) : Prop :=
  LVCohnRelK1.cx false ^ p * a * LVCohnRelK1.cy false ^ q ∈ LVCohnDegZero.cohnDegreeZero

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_Admissible

/-- Prefixing `k` letters `0` multiplies `x_μ` by `x₀^k` on the left.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem skCohnGr_xw_replicate (k : ℕ) (μ : List Bool) :
    LVCohnRelK1.xw (List.replicate k false ++ μ) = LVCohnRelK1.cx false ^ k * LVCohnRelK1.xw μ := by
  induction k with
  | zero => rw [List.replicate_zero, List.nil_append, pow_zero, one_mul]
  | succ k ih =>
      rw [List.replicate_succ, List.cons_append, LVCohnRelK1.xw_cons, ih, pow_succ', mul_assoc]

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_xw_replicate

/-- Prefixing `k` letters `0` multiplies `y_ν` by `y₀^k` on the right.
(`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem skCohnGr_yw_replicate (k : ℕ) (ν : List Bool) :
    LVCohnRelK1.yw (List.replicate k false ++ ν) = LVCohnRelK1.yw ν * LVCohnRelK1.cy false ^ k := by
  induction k with
  | zero => rw [List.replicate_zero, List.nil_append, pow_zero, mul_one]
  | succ k ih =>
      rw [List.replicate_succ, List.cons_append, LVCohnRelK1.yw_cons, ih, pow_succ, mul_assoc]

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_yw_replicate

/-- **Homogeneous monomials are admissible**: `x_μ y_ν` is `(p, q)`-admissible when
`p + |μ| = q + |ν|`.  (`simple_kazhdan_sofic_group.tex` l.733-735, leaf T1b.iii.) -/
theorem skCohnGr_admissible_xw_mul_yw {p q : ℕ} (μ ν : List Bool)
    (h : p + μ.length = q + ν.length) :
    skCohnGr_Admissible p q (LVCohnRelK1.xw μ * LVCohnRelK1.yw ν) := by
  have e : LVCohnRelK1.cx false ^ p * (LVCohnRelK1.xw μ * LVCohnRelK1.yw ν) *
        LVCohnRelK1.cy false ^ q =
      LVCohnRelK1.xw (List.replicate p false ++ μ) *
        LVCohnRelK1.yw (List.replicate q false ++ ν) := by
    rw [skCohnGr_xw_replicate, skCohnGr_yw_replicate]
    simp only [mul_assoc]
  unfold skCohnGr_Admissible
  rw [e]
  refine LVCohnDegZero.xw_mul_yw_mem _ _ ?_
  rw [List.length_append, List.length_append, List.length_replicate, List.length_replicate]
  exact h

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_admissible_xw_mul_yw

/-- `(0, 0)`-admissible means lying in `C₀`.  (`simple_kazhdan_sofic_group.tex` l.733-735,
leaf T1b.iii.) -/
theorem skCohnGr_admissible_zero_iff (a : LVCohnRelK1.CohnTwoF2) :
    skCohnGr_Admissible 0 0 a ↔ a ∈ LVCohnDegZero.cohnDegreeZero := by
  unfold skCohnGr_Admissible
  rw [pow_zero, pow_zero, one_mul, mul_one]

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_admissible_zero_iff

/-- Admissible coefficients are closed under addition.  (`simple_kazhdan_sofic_group.tex`
l.733-735, leaf T1b.iii.) -/
theorem skCohnGr_admissible_add {p q : ℕ} {a b : LVCohnRelK1.CohnTwoF2}
    (ha : skCohnGr_Admissible p q a) (hb : skCohnGr_Admissible p q b) :
    skCohnGr_Admissible p q (a + b) := by
  unfold skCohnGr_Admissible at ha hb ⊢
  rw [mul_add, add_mul]
  exact add_mem ha hb

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_admissible_add

/-- Admissible coefficients are closed under negation.  (`simple_kazhdan_sofic_group.tex`
l.733-735, leaf T1b.iii.) -/
theorem skCohnGr_admissible_neg {p q : ℕ} {a : LVCohnRelK1.CohnTwoF2}
    (ha : skCohnGr_Admissible p q a) : skCohnGr_Admissible p q (-a) := by
  unfold skCohnGr_Admissible at ha ⊢
  rw [mul_neg, neg_mul]
  exact neg_mem ha

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_admissible_neg

/-- **Graded products**: a `(p, q)`-admissible times a `(q, r)`-admissible coefficient is
`(p, r)`-admissible, since `y₀^q x₀^q = 1`.  (`simple_kazhdan_sofic_group.tex` l.733-735,
leaf T1b.iii.) -/
theorem skCohnGr_admissible_mul {p q r : ℕ} {a b : LVCohnRelK1.CohnTwoF2}
    (ha : skCohnGr_Admissible p q a) (hb : skCohnGr_Admissible q r b) :
    skCohnGr_Admissible p r (a * b) := by
  unfold skCohnGr_Admissible at ha hb ⊢
  have e : LVCohnRelK1.cx false ^ p * (a * b) * LVCohnRelK1.cy false ^ r =
      LVCohnRelK1.cx false ^ p * a * LVCohnRelK1.cy false ^ q *
        (LVCohnRelK1.cx false ^ q * b * LVCohnRelK1.cy false ^ r) := by
    calc LVCohnRelK1.cx false ^ p * (a * b) * LVCohnRelK1.cy false ^ r
        = LVCohnRelK1.cx false ^ p * a *
            (LVCohnRelK1.cy false ^ q * LVCohnRelK1.cx false ^ q) * b *
            LVCohnRelK1.cy false ^ r := by
          rw [LVCohnColimit.cy_pow_mul_cx_pow, mul_one, mul_assoc (LVCohnRelK1.cx false ^ p) a b]
      _ = _ := by simp only [mul_assoc]
  rw [e]
  exact mul_mem ha hb

#audit_axioms GroupApproximation.Full.LVCohnGraded.skCohnGr_admissible_mul
