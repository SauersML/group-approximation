import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.SKTFG.Stages
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.SKTFG.Statements
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiRoomAlternating
import GroupApproximation.Meta.AxiomGuard

/-!
# The derived topological full group of a minimal subshift is finitely generated

Matui, *Some remarks on topological full groups of Cantor minimal systems* (Internat. J. Math.
2006), Theorem 5.4, the direction from subshifts to finite generation. This is the finite
generation input of SK row `e5932a45f053` (Grigorchuk–Medynets).

Let `S` be an infinite minimal subshift with shift `T`, `R` a radius with `SepRadius S 5 R` and
`N = 2R + 1`. The generating set `gens S N` is finite: the even tower permutations of the
five-level towers over the cylinders on the window `[0, N]`.

* The derived full group is the alternating full group, generated by three-cycles
  (`commutator_fullGroup_eq_alternatingFullGroup`).
* A three-cycle is a product of its restrictions to small pieces (`threeCycle_mem_of_local`,
  `threeCycle_mem_of_cyl`). On a small cylinder `P` it is the tower action of the three-cycle on
  three levels `0, E₁, E₂` (`exists_local_eight_tower`). So it is a three-cycle on a tall tower of
  consecutive levels over a translate of `P`, hence a product of consecutive three-cycles
  (`alternatingGroup_le_closure_consSet`). Each consecutive three-cycle is a three-cycle on the
  bottom three levels of a five-level tower over a long cylinder `B''`.
* Every long cylinder is good for `closure (gens S N)` (`good_left`, `good_right`, from
  `good_step`).
-/

namespace GroupApproximation.Full.SKTFG

open GroupApproximation.Full.StepanovMatui.Matui
open SymbolicDynamics.FullShift Equiv
open scoped commutatorElement

variable {A : Type} [TopologicalSpace A] [DiscreteTopology A] [Finite A] (S : Subshift A ℤ)

/-- The cylinder of a word on the window `[0, N]`. -/
def cylW (N : ℕ) (w : Finset.Icc (0 : ℤ) N → A) : Set S.carrier :=
  ⋂ n : Finset.Icc (0 : ℤ) N, {x : S.carrier | x.1 n = w n}

omit [Finite A] in
theorem isClopen_cylW (N : ℕ) (w : Finset.Icc (0 : ℤ) N → A) : IsClopen (cylW S N w) :=
  isClopen_iInter_of_finite fun n =>
    (isClopen_discrete {w n}).preimage ((continuous_apply (n : ℤ)).comp continuous_subtype_val)

omit [DiscreteTopology A] [Finite A] in
theorem cylW_eq (N : ℕ) (z : ℤ → A) : cylW S N (fun n => z n) = cyl S z 0 N := by
  ext x
  simp only [cylW, Set.mem_iInter, Set.mem_setOf_eq, mem_cyl]
  constructor
  · intro h n h1 h2
    exact h ⟨n, Finset.mem_Icc.mpr ⟨h1, h2⟩⟩
  · intro h n
    exact h n (Finset.mem_Icc.mp n.2).1 (Finset.mem_Icc.mp n.2).2

open Classical in
/-- The tower permutation of `p = (w, σ)` on the five-level tower over the cylinder of `w`, or `1`
if the tower is not disjoint. -/
noncomputable def genPerm (N : ℕ) (p : (Finset.Icc (0 : ℤ) N → A) × alternatingGroup (Fin 5)) :
    Perm S.carrier :=
  if h : TowerDisj (SimpleKazhdanSofic.subshiftHomeo S).toEquiv (cylW S N p.1) 4 then
    towerPerm (SimpleKazhdanSofic.subshiftHomeo S).toEquiv (cylW S N p.1) (towerLevels 4) h p.2.1
  else 1

/-- **The finite generating set**: the even tower permutations of the five-level towers over the
cylinders on `[0, N]`. -/
def gens (N : ℕ) : Set (Perm S.carrier) :=
  Set.range (genPerm S N)

omit [DiscreteTopology A] in
theorem gens_finite (N : ℕ) : (gens S N).Finite := Set.finite_range _

/-- Even tower permutations over clopen five-level towers lie in the derived full group. -/
theorem good_derived {B : Set S.carrier} (hB : IsClopen B) :
    Good S (derivedFullGroupSubshift S) B := by
  haveI := SimpleKazhdanSofic.compactSpace_carrier S
  have hT := toEquiv_mem_fullGroup (SimpleKazhdanSofic.subshiftHomeo S)
  refine good_of_cons S fun hd => consSet_four_cases ?_ ?_ ?_
  · rw [show (adjSwap (⟨0, by norm_num⟩ : Fin 4) * adjSwap (⟨1, by norm_num⟩ : Fin 4) :
      Perm (Fin 5)) = ⁅swap 0 1, swap 0 2⁆ by decide +kernel]
    exact towerPerm_commutator_mem hT hB hd _ _
  · rw [show (adjSwap (⟨1, by norm_num⟩ : Fin 4) * adjSwap (⟨2, by norm_num⟩ : Fin 4) :
      Perm (Fin 5)) = ⁅swap 1 2, swap 1 3⁆ by decide +kernel]
    exact towerPerm_commutator_mem hT hB hd _ _
  · rw [show (adjSwap (⟨2, by norm_num⟩ : Fin 4) * adjSwap (⟨3, by norm_num⟩ : Fin 4) :
      Perm (Fin 5)) = ⁅swap 2 3, swap 2 4⁆ by decide +kernel]
    exact towerPerm_commutator_mem hT hB hd _ _

omit [DiscreteTopology A] [Finite A] in
open Classical in
/-- The cylinders on `[0, N]` are good for the subgroup generated by `gens S N`. -/
theorem good_base (N : ℕ) (z : ℤ → A) : Good S (Subgroup.closure (gens S N)) (cyl S z 0 N) := by
  intro h σ hσ
  have hW := cylW_eq S N z
  have h' : TowerDisj (SimpleKazhdanSofic.subshiftHomeo S).toEquiv
      (cylW S N (fun n => z n)) 4 := by
    rw [hW]
    exact h
  have hmem : genPerm S N ((fun n => z n), ⟨σ, hσ⟩) ∈ Subgroup.closure (gens S N) :=
    Subgroup.subset_closure ⟨_, rfl⟩
  rw [genPerm, dif_pos h'] at hmem
  rwa [towerPerm_congr h' h (fun i x => by rw [hW]) (fun _ _ => rfl) σ] at hmem

end GroupApproximation.Full.SKTFG
