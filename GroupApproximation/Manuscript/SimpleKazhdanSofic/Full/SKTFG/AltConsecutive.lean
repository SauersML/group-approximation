import Mathlib
import GroupApproximation.Meta.AxiomGuard

/-!
# The alternating group is generated by consecutive three-cycles

Write `s i = (i, i+1)` for `i : Fin K` (adjacent transpositions of `Fin (K + 1)`). The products
`s i * s (i + 1)` are the consecutive three-cycles `(i, i+1, i+2)`. They generate
`alternatingGroup (Fin (K + 1))`:

* `adjSwap_mul_adjSwap_mem`: `s i * s j` lies in the subgroup `H` they generate, for all `i, j`.
  Telescoping gives `s i * s j = ∏_{i ≤ k < j} s k * s (k+1)`, since `s k * s k = 1`.
* Every permutation lies in `H` or in `H * s 0`: this is an induction along adjacent
  transpositions (`mclosure_swap_castSucc_succ`), since `s i * s 0 ∈ H`.
* `H` consists of even permutations, so an even permutation cannot lie in `H * s 0`.

This is used in `SKTFG.FG` to reduce a three-cycle on an arbitrary tall tower to three-cycles on
three consecutive levels.
-/

namespace GroupApproximation.Full.SKTFG

open Equiv

/-- The adjacent transposition `(i, i+1)` of `Fin (K + 1)`. -/
def adjSwap {K : ℕ} (i : Fin K) : Perm (Fin (K + 1)) := swap i.castSucc i.succ

/-- The consecutive three-cycles `s i * s (i+1)` of `Fin (K + 1)`. -/
def consSet (K : ℕ) : Set (Perm (Fin (K + 1))) :=
  {σ | ∃ i j : Fin K, (j : ℕ) = (i : ℕ) + 1 ∧ σ = adjSwap i * adjSwap j}

theorem adjSwap_mul_self {K : ℕ} (i : Fin K) : adjSwap i * adjSwap i = 1 :=
  swap_mul_self _ _

theorem adjSwap_inv {K : ℕ} (i : Fin K) : (adjSwap i)⁻¹ = adjSwap i :=
  swap_inv _ _

theorem sign_adjSwap {K : ℕ} (i : Fin K) : Perm.sign (adjSwap i) = -1 :=
  Perm.sign_swap (Fin.castSucc_lt_succ (i := i)).ne

/-- Telescoping: `s i * s j` lies in the subgroup generated by the consecutive three-cycles. -/
theorem adjSwap_mul_adjSwap_mem_of_le {K : ℕ} :
    ∀ d : ℕ, ∀ i j : Fin K, (j : ℕ) = (i : ℕ) + d →
      adjSwap i * adjSwap j ∈ Subgroup.closure (consSet K) := by
  intro d
  induction d with
  | zero =>
    intro i j hij
    have e : i = j := Fin.ext (by omega)
    rw [e, adjSwap_mul_self]
    exact Subgroup.one_mem _
  | succ d ih =>
    intro i j hij
    have hlt : (i : ℕ) + d < K := by have := j.isLt; omega
    let j' : Fin K := ⟨(i : ℕ) + d, hlt⟩
    have h1 := ih i j' rfl
    have h2 : adjSwap j' * adjSwap j ∈ Subgroup.closure (consSet K) :=
      Subgroup.subset_closure ⟨j', j, by show (j : ℕ) = (i : ℕ) + d + 1; omega, rfl⟩
    have e : adjSwap i * adjSwap j = (adjSwap i * adjSwap j') * (adjSwap j' * adjSwap j) := by
      rw [mul_assoc, ← mul_assoc (adjSwap j'), adjSwap_mul_self, one_mul]
    rw [e]
    exact Subgroup.mul_mem _ h1 h2

theorem adjSwap_mul_adjSwap_mem {K : ℕ} (i j : Fin K) :
    adjSwap i * adjSwap j ∈ Subgroup.closure (consSet K) := by
  rcases le_total (i : ℕ) (j : ℕ) with h | h
  · exact adjSwap_mul_adjSwap_mem_of_le ((j : ℕ) - i) i j (by omega)
  · have hji := adjSwap_mul_adjSwap_mem_of_le ((i : ℕ) - j) j i (by omega)
    have e : adjSwap i * adjSwap j = (adjSwap j * adjSwap i)⁻¹ := by
      rw [mul_inv_rev, adjSwap_inv, adjSwap_inv]
    rw [e]
    exact Subgroup.inv_mem _ hji

/-- The consecutive three-cycles are even. -/
theorem closure_consSet_le_alternatingGroup (K : ℕ) :
    Subgroup.closure (consSet K) ≤ alternatingGroup (Fin (K + 1)) := by
  rw [Subgroup.closure_le]
  rintro σ ⟨i, j, -, rfl⟩
  rw [SetLike.mem_coe, Perm.mem_alternatingGroup, Perm.sign_mul, sign_adjSwap]
  exact Int.units_mul_self _

/-- **The consecutive three-cycles generate the alternating group** of `Fin (K + 1)`. -/
theorem alternatingGroup_le_closure_consSet (K : ℕ) (hK : 1 ≤ K) :
    alternatingGroup (Fin (K + 1)) ≤ Subgroup.closure (consSet K) := by
  set H := Subgroup.closure (consSet K)
  set s₀ : Fin K := ⟨0, by omega⟩
  have key : ∀ σ : Perm (Fin (K + 1)), σ ∈ H ∨ σ * adjSwap s₀ ∈ H := by
    intro σ
    refine Submonoid.induction_of_closure_eq_top_right (mclosure_swap_castSucc_succ K) σ
      (Or.inl H.one_mem) ?_
    rintro x _ ⟨i, rfl⟩ hx
    change x * adjSwap i ∈ H ∨ x * adjSwap i * adjSwap s₀ ∈ H
    rcases hx with hx | hx
    · right
      rw [mul_assoc]
      exact H.mul_mem hx (adjSwap_mul_adjSwap_mem i s₀)
    · left
      have e : x * adjSwap i = (x * adjSwap s₀) * (adjSwap s₀ * adjSwap i) := by
        rw [mul_assoc, ← mul_assoc (adjSwap s₀), adjSwap_mul_self, one_mul]
      rw [e]
      exact H.mul_mem hx (adjSwap_mul_adjSwap_mem s₀ i)
  intro σ hσ
  rcases key σ with h | h
  · exact h
  · exfalso
    have hs := closure_consSet_le_alternatingGroup K h
    rw [Perm.mem_alternatingGroup, Perm.sign_mul, sign_adjSwap,
      (Perm.mem_alternatingGroup.mp hσ), one_mul] at hs
    exact units_ne_neg_self (1 : ℤˣ) hs.symm

/-! ## Values of a consecutive three-cycle

`s i * s j` with `j = i + 1` maps `i ↦ i+1 ↦ i+2 ↦ i` and fixes every other point. -/

section Values

variable {K : ℕ} {i j : Fin K} (hij : (j : ℕ) = (i : ℕ) + 1)
include hij

theorem cons_apply_castSucc : (adjSwap i * adjSwap j) i.castSucc = i.succ := by
  have h1 : i.castSucc ≠ j.castSucc := fun h => by
    have := congrArg Fin.val h
    simp only [Fin.val_castSucc] at this
    omega
  have h2 : i.castSucc ≠ j.succ := fun h => by
    have := congrArg Fin.val h
    simp only [Fin.val_castSucc, Fin.val_succ] at this
    omega
  rw [Perm.mul_apply, adjSwap, adjSwap, swap_apply_of_ne_of_ne h1 h2, swap_apply_left]

theorem cons_apply_succ : (adjSwap i * adjSwap j) i.succ = j.succ := by
  have e : i.succ = j.castSucc := Fin.ext (by simp only [Fin.val_castSucc, Fin.val_succ]; omega)
  have h1 : j.succ ≠ i.castSucc := fun h => by
    have := congrArg Fin.val h
    simp only [Fin.val_castSucc, Fin.val_succ] at this
    omega
  have h2 : j.succ ≠ i.succ := fun h => by
    have := congrArg Fin.val h
    simp only [Fin.val_succ] at this
    omega
  have hin : swap j.castSucc j.succ i.succ = j.succ := by rw [e, swap_apply_left]
  rw [Perm.mul_apply, adjSwap, adjSwap, hin, swap_apply_of_ne_of_ne h1 h2]

theorem cons_apply_jsucc : (adjSwap i * adjSwap j) j.succ = i.castSucc := by
  have e : j.castSucc = i.succ := Fin.ext (by simp only [Fin.val_castSucc, Fin.val_succ]; omega)
  rw [Perm.mul_apply, adjSwap, adjSwap, swap_apply_right, e, swap_apply_right]

theorem cons_apply_of_ne {x : Fin (K + 1)} (h0 : x ≠ i.castSucc) (h1 : x ≠ i.succ)
    (h2 : x ≠ j.succ) : (adjSwap i * adjSwap j) x = x := by
  have e : j.castSucc = i.succ := Fin.ext (by simp only [Fin.val_castSucc, Fin.val_succ]; omega)
  have h1' : x ≠ j.castSucc := by rw [e]; exact h1
  rw [Perm.mul_apply, adjSwap, adjSwap, swap_apply_of_ne_of_ne h1' h2,
    swap_apply_of_ne_of_ne h0 h1]

end Values

end GroupApproximation.Full.SKTFG

#audit_axioms GroupApproximation.Full.SKTFG.alternatingGroup_le_closure_consSet
