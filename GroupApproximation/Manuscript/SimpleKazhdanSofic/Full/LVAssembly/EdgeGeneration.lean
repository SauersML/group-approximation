import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Data.Fin.Embedding
import GroupApproximation.Steinberg.ElementaryIndexPadding
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVAssembly.EdgeStab

/-!
# Generation of the edge group (glue for `K₂(4, L) = ⊥`)

`simple_kazhdan_sofic_group.tex`, `sec:questions`, l.733-735.  This is part of the proof of
Khanh (arXiv:2609.08428), Thm 5.1.  Let `R` be a ring with `GL_2(R) = E_2(R)`.  Then
`K = edgeStab R` is generated by the elementary matrices `1 + E_{pq}(c)` with `q < 2`
(`edgeStab_le_closure`).

An element of `K` has the block form `[[A, 0], [C, I]]`.

* `blkHom`: `k ↦ A` is multiplicative on `K` (`blk_mul`), so `edgeBlock : K → GL_2(R)`.
* `padBlock A = [[A, 0], [0, I]]` lies in the closure of the generators, because `A ∈ E_2(R)` and
  padding along `Fin.castLE` sends `1 + E_{ij}(a)` to a generator (`pad_mem_closure`).
* `m = k · padBlock(A)⁻¹` has block `1`.  So `m = [[I, 0], [C', I]]`, which is the product of the
  four generators `1 + E_{2,0}`, `1 + E_{2,1}`, `1 + E_{3,0}`, `1 + E_{3,1}` (`unipotent_eq`).

This ports the unwired foreign draft `LeavittK2/EdgeTriangleLift/EdgeGeneration.lean`.  The entry
formula `padHom_entry` for padding is re-proved here instead of importing the unwired orphan
`Algebra/ElementaryPaddingInjective.lean`.
-/

namespace GroupApproximation.Full.LVAssembly

variable {R : Type*} [Ring R]

/-- The upper-left `2 × 2` block. -/
def blk (M : Matrix (Fin 4) (Fin 4) R) : Matrix (Fin 2) (Fin 2) R :=
  M.submatrix (Fin.castLE two_le_four) (Fin.castLE two_le_four)

/-- The block is multiplicative when the left factor has identity columns `2` and `3`. -/
theorem blk_mul {M N : Matrix (Fin 4) (Fin 4) R}
    (hM2 : ∀ p : Fin 4, M p 2 = (1 : Matrix (Fin 4) (Fin 4) R) p 2)
    (hM3 : ∀ p : Fin 4, M p 3 = (1 : Matrix (Fin 4) (Fin 4) R) p 3) :
    blk (M * N) = blk M * blk N := by
  ext a b
  have ha2 : Fin.castLE two_le_four a ≠ 2 := by revert a; decide
  have ha3 : Fin.castLE two_le_four a ≠ 3 := by revert a; decide
  have he0 : Fin.castLE two_le_four (0 : Fin 2) = 0 := rfl
  have he1 : Fin.castLE two_le_four (1 : Fin 2) = 1 := rfl
  simp only [blk, Matrix.submatrix_apply, Matrix.mul_apply, Fin.sum_univ_four, Fin.sum_univ_two,
    hM2, hM3, Matrix.one_apply_ne ha2, Matrix.one_apply_ne ha3, zero_mul, add_zero, he0, he1]

/-- **The block homomorphism `K → M_2(R)`.** -/
def blkHom (R : Type*) [Ring R] : edgeStab R →* Matrix (Fin 2) (Fin 2) R where
  toFun g := blk ((g : (Matrix (Fin 4) (Fin 4) R)ˣ) : Matrix (Fin 4) (Fin 4) R)
  map_one' := Matrix.submatrix_one _ (Fin.castLE_injective two_le_four)
  map_mul' g h :=
    blk_mul (N := ((h : (Matrix (Fin 4) (Fin 4) R)ˣ) : Matrix (Fin 4) (Fin 4) R))
      (mem_columnFixer.mp (mem_edgeStab.mp g.2).2) (mem_columnFixer.mp (mem_edgeStab.mp g.2).1)

/-- **The block homomorphism `K → GL_2(R)`** (Khanh, Thm 5.1). -/
def edgeBlock (R : Type*) [Ring R] : edgeStab R →* (Matrix (Fin 2) (Fin 2) R)ˣ :=
  (blkHom R).toHomUnits

/-- The `(e i, e j)` entry of a padded matrix is the `(i, j)` entry of the original. -/
theorem padHom_entry {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
    (e : ι ↪ κ) (M : Matrix ι ι R) (i j : ι) :
    ElementaryPadding.padHom e M (e i) (e j) = M i j := by
  have hi : (ElementaryPadding.padEquiv e).symm (e i) = Sum.inl i := by
    rw [Equiv.symm_apply_eq, ElementaryPadding.padEquiv_inl]
  have hj : (ElementaryPadding.padEquiv e).symm (e j) = Sum.inl j := by
    rw [Equiv.symm_apply_eq, ElementaryPadding.padEquiv_inl]
  rw [ElementaryPadding.padHom_apply, Matrix.reindex_apply, Matrix.submatrix_apply, hi, hj,
    Matrix.fromBlocks_apply₁₁]

/-- `[[A, 0], [0, I]]`, padding along `Fin.castLE`. -/
noncomputable def padBlock (R : Type*) [Ring R] (u : (Matrix (Fin 2) (Fin 2) R)ˣ) :
    (Matrix (Fin 4) (Fin 4) R)ˣ :=
  ElementaryPadding.padUnitHom (Fin.castLEEmb two_le_four) u

/-- If `GL_2(R) = E_2(R)`, every padded block is a product of generators. -/
theorem pad_mem_closure (hE2 : GroupApproximation.elementaryGroup (Fin 2) R = ⊤)
    (u : (Matrix (Fin 2) (Fin 2) R)ˣ) :
    padBlock R u ∈ Subgroup.closure (edgeGens R) := by
  have hu : u ∈ GroupApproximation.elementaryGroup (Fin 2) R := by
    rw [hE2]
    exact Subgroup.mem_top u
  have hle : GroupApproximation.elementaryGroup (Fin 2) R ≤ (Subgroup.closure (edgeGens R)).comap
      (ElementaryPadding.padUnitHom (Fin.castLEEmb two_le_four)) := by
    rw [GroupApproximation.elementaryGroup, Subgroup.closure_le]
    rintro z ⟨i, j, hij, a, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, ElementaryPadding.padUnitHom_elementaryUnit]
    exact Subgroup.subset_closure ⟨Fin.castLEEmb two_le_four i, Fin.castLEEmb two_le_four j,
      (Fin.castLEEmb two_le_four).injective.ne hij, a, j.isLt, rfl⟩
  exact Subgroup.mem_comap.mp (hle hu)

/-- The block of `padBlock u` is `u`. -/
theorem edgeBlock_pad (u : (Matrix (Fin 2) (Fin 2) R)ˣ) (hu : padBlock R u ∈ edgeStab R) :
    edgeBlock R ⟨padBlock R u, hu⟩ = u := by
  apply Units.ext
  ext a b
  exact padHom_entry (Fin.castLEEmb two_le_four) (u : Matrix (Fin 2) (Fin 2) R) a b

/-- The four elements of `Fin 4`. -/
theorem fin4_cases : ∀ p : Fin 4, p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 := by decide

/-- `(1 + X)(1 + Y) = 1 + (X + Y)` when `XY = 0`. -/
theorem one_add_mul_one_add {A : Type*} [Ring A] {X Y : A} (h : X * Y = 0) :
    (1 + X) * (1 + Y) = 1 + (X + Y) := by
  rw [add_mul, one_mul, mul_add, mul_one, h, add_zero, add_assoc, add_comm X Y]

/-- Entrywise form of a matrix `[[I, 0], [C, I]]`. -/
theorem unipotent_apply {M : Matrix (Fin 4) (Fin 4) R}
    (h2 : ∀ p : Fin 4, M p 2 = (1 : Matrix (Fin 4) (Fin 4) R) p 2)
    (h3 : ∀ p : Fin 4, M p 3 = (1 : Matrix (Fin 4) (Fin 4) R) p 3)
    (h00 : M 0 0 = 1) (h01 : M 0 1 = 0) (h10 : M 1 0 = 0) (h11 : M 1 1 = 1) :
    M = 1 + (Matrix.single 2 0 (M 2 0) + Matrix.single 2 1 (M 2 1) +
      Matrix.single 3 0 (M 3 0) + Matrix.single 3 1 (M 3 1)) := by
  have hr : ∀ i p : Fin 4, i ≠ p → ∀ (j q : Fin 4) (c : R), Matrix.single i j c p q = 0 :=
    fun i p h j q c => Matrix.single_apply_of_row_ne h j q c
  have hc : ∀ j q : Fin 4, j ≠ q → ∀ (i p : Fin 4) (c : R), Matrix.single i j c p q = 0 :=
    fun j q h i p c => Matrix.single_apply_of_col_ne i p h c
  ext p q
  rw [Matrix.add_apply, Matrix.add_apply, Matrix.add_apply, Matrix.add_apply]
  rcases fin4_cases p with rfl | rfl | rfl | rfl
  · rw [hr 2 0 (by decide) 0 q, hr 2 0 (by decide) 1 q, hr 3 0 (by decide) 0 q,
      hr 3 0 (by decide) 1 q, add_zero, add_zero, add_zero, add_zero]
    rcases fin4_cases q with rfl | rfl | rfl | rfl
    · rw [h00, Matrix.one_apply_eq]
    · rw [h01, Matrix.one_apply_ne (show (0 : Fin 4) ≠ 1 by decide)]
    · exact h2 0
    · exact h3 0
  · rw [hr 2 1 (by decide) 0 q, hr 2 1 (by decide) 1 q, hr 3 1 (by decide) 0 q,
      hr 3 1 (by decide) 1 q, add_zero, add_zero, add_zero, add_zero]
    rcases fin4_cases q with rfl | rfl | rfl | rfl
    · rw [h10, Matrix.one_apply_ne (show (1 : Fin 4) ≠ 0 by decide)]
    · rw [h11, Matrix.one_apply_eq]
    · exact h2 1
    · exact h3 1
  · rw [hr 3 2 (by decide) 0 q, hr 3 2 (by decide) 1 q, add_zero, add_zero]
    rcases fin4_cases q with rfl | rfl | rfl | rfl
    · rw [Matrix.single_apply_same, hc 1 0 (by decide) 2 2,
        Matrix.one_apply_ne (show (2 : Fin 4) ≠ 0 by decide), add_zero, zero_add]
    · rw [hc 0 1 (by decide) 2 2, Matrix.single_apply_same,
        Matrix.one_apply_ne (show (2 : Fin 4) ≠ 1 by decide), zero_add, zero_add]
    · rw [h2 2, hc 0 2 (by decide) 2 2, hc 1 2 (by decide) 2 2, add_zero, add_zero]
    · rw [h3 2, hc 0 3 (by decide) 2 2, hc 1 3 (by decide) 2 2, add_zero, add_zero]
  · rw [hr 2 3 (by decide) 0 q, hr 2 3 (by decide) 1 q, zero_add, zero_add]
    rcases fin4_cases q with rfl | rfl | rfl | rfl
    · rw [Matrix.single_apply_same, hc 1 0 (by decide) 3 3,
        Matrix.one_apply_ne (show (3 : Fin 4) ≠ 0 by decide), add_zero, zero_add]
    · rw [hc 0 1 (by decide) 3 3, Matrix.single_apply_same,
        Matrix.one_apply_ne (show (3 : Fin 4) ≠ 1 by decide), zero_add, zero_add]
    · rw [h2 3, hc 0 2 (by decide) 3 3, hc 1 2 (by decide) 3 3, add_zero, add_zero]
    · rw [h3 3, hc 0 3 (by decide) 3 3, hc 1 3 (by decide) 3 3, add_zero, add_zero]

/-- **A matrix of `K` with block `1` is `[[I, 0], [C, I]]`**, a product of four generators. -/
theorem unipotent_eq {M : Matrix (Fin 4) (Fin 4) R}
    (h2 : ∀ p : Fin 4, M p 2 = (1 : Matrix (Fin 4) (Fin 4) R) p 2)
    (h3 : ∀ p : Fin 4, M p 3 = (1 : Matrix (Fin 4) (Fin 4) R) p 3) (hb : blk M = 1) :
    M = (1 + Matrix.single 2 0 (M 2 0)) * (1 + Matrix.single 2 1 (M 2 1)) *
      (1 + Matrix.single 3 0 (M 3 0)) * (1 + Matrix.single 3 1 (M 3 1)) := by
  have h00 : M 0 0 = 1 := by
    have h := congrFun (congrFun hb 0) 0
    rw [Matrix.one_apply_eq] at h
    exact h
  have h11 : M 1 1 = 1 := by
    have h := congrFun (congrFun hb 1) 1
    rw [Matrix.one_apply_eq] at h
    exact h
  have h01 : M 0 1 = 0 := by
    have h := congrFun (congrFun hb 0) 1
    rw [Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide)] at h
    exact h
  have h10 : M 1 0 = 0 := by
    have h := congrFun (congrFun hb 1) 0
    rw [Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)] at h
    exact h
  have hAB : Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) * Matrix.single 2 1 (M 2 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide) _
  have hAC : Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) * Matrix.single 3 0 (M 3 0) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide) _
  have hAD : Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) * Matrix.single 3 1 (M 3 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide) _
  have hBC : Matrix.single (2 : Fin 4) (1 : Fin 4) (M 2 1) * Matrix.single 3 0 (M 3 0) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide) _
  have hBD : Matrix.single (2 : Fin 4) (1 : Fin 4) (M 2 1) * Matrix.single 3 1 (M 3 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide) _
  have hCD : Matrix.single (3 : Fin 4) (0 : Fin 4) (M 3 0) * Matrix.single 3 1 (M 3 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ _ (by decide) _
  have hABC : (Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) + Matrix.single 2 1 (M 2 1)) *
      Matrix.single 3 0 (M 3 0) = 0 := by
    rw [add_mul, hAC, hBC, add_zero]
  have hABCD : (Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) + Matrix.single 2 1 (M 2 1) +
      Matrix.single 3 0 (M 3 0)) * Matrix.single 3 1 (M 3 1) = 0 := by
    rw [add_mul, add_mul, hAD, hBD, hCD, add_zero, add_zero]
  rw [one_add_mul_one_add hAB, one_add_mul_one_add hABC, one_add_mul_one_add hABCD]
  exact unipotent_apply h2 h3 h00 h01 h10 h11

/-- **Generation of the edge group** (Khanh, Thm 5.1; tex l.733-735).  If `GL_2(R) = E_2(R)`, then
`K` is generated by the elementary matrices `1 + E_{pq}(c)` with `q < 2`. -/
theorem edgeStab_le_closure (hE2 : GroupApproximation.elementaryGroup (Fin 2) R = ⊤) :
    edgeStab R ≤ Subgroup.closure (edgeGens R) := by
  intro k hk
  generalize hu : edgeBlock R ⟨k, hk⟩ = u
  have hcl : padBlock R u ∈ Subgroup.closure (edgeGens R) := pad_mem_closure hE2 u
  have hhK : padBlock R u ∈ edgeStab R := closure_edgeGens_le hcl
  have hmK : k * (padBlock R u)⁻¹ ∈ edgeStab R := mul_mem hk (inv_mem hhK)
  have hblk : edgeBlock R ⟨k * (padBlock R u)⁻¹, hmK⟩ = 1 := by
    have e1 : (⟨k * (padBlock R u)⁻¹, hmK⟩ : edgeStab R) =
        ⟨k, hk⟩ * (⟨padBlock R u, hhK⟩ : edgeStab R)⁻¹ := rfl
    rw [e1, map_mul, map_inv, edgeBlock_pad u hhK, hu, mul_inv_cancel]
  have hb : blk (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) :
      Matrix (Fin 4) (Fin 4) R) = 1 := by
    have h := congrArg Units.val hblk
    exact h
  have hprod : k * (padBlock R u)⁻¹ =
      GroupApproximation.elementaryUnit (2 : Fin 4) 0 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 2 0) *
        GroupApproximation.elementaryUnit (2 : Fin 4) 1 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 2 1) *
        GroupApproximation.elementaryUnit (3 : Fin 4) 0 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 3 0) *
        GroupApproximation.elementaryUnit (3 : Fin 4) 1 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 3 1) :=
    Units.ext (unipotent_eq (mem_columnFixer.mp (mem_edgeStab.mp hmK).2)
      (mem_columnFixer.mp (mem_edgeStab.mp hmK).1) hb)
  have hgen : ∀ (p q : Fin 4) (hpq : p ≠ q) (c : R), q.val < 2 →
      GroupApproximation.elementaryUnit p q hpq c ∈ Subgroup.closure (edgeGens R) :=
    fun p q hpq c hq => Subgroup.subset_closure ⟨p, q, hpq, c, hq, rfl⟩
  have hm : k * (padBlock R u)⁻¹ ∈ Subgroup.closure (edgeGens R) := by
    rw [hprod]
    exact mul_mem (mul_mem (mul_mem (hgen _ _ _ _ (by decide)) (hgen _ _ _ _ (by decide)))
      (hgen _ _ _ _ (by decide))) (hgen _ _ _ _ (by decide))
  have hk' := mul_mem hm hcl
  rwa [inv_mul_cancel_right] at hk'

end GroupApproximation.Full.LVAssembly
