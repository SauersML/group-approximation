import Mathlib.Tactic.Group
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVAssembly.EdgeGeneration
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVAssembly.Triangle
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVEGen.GLEqElementary

/-!
# Brown's edge relation for a root lift (glue for `K₂(4, L) = ⊥`)

`simple_kazhdan_sofic_group.tex`, `sec:questions`, l.733-735.  This is part of the proof of
Khanh (arXiv:2609.08428), Thm 5.1, over `L = L_{𝔽₂}(1,2)`.  Let `σ : J → St_4(L)` send
`1 + E_{ij}(a)` (`j ≠ 3`) to `x_{ij}(a)` (`LiftsRoots`).  Then `σ` satisfies Brown's edge relation
`w₃₂ σ(k) w₃₂⁻¹ = σ(τ k τ⁻¹)` for `k ∈ K` (`edgeRelation_of_liftsRoots`).

* `K` is generated by `1 + E_{pq}(c)` with `q < 2` (`edgeStab_le_closure`, using
  `GL_2(L) = E_2(L)` from `Full/LVEGen/GLEqElementary`).
* Conjugation by `τ` sends a generator to a generator (`swapLast_conj_elementaryUnit`).  It is the
  image of the Weyl conjugation `w₃₂ x_{pq}(c) w₃₂⁻¹ = x_{(32)p,(32)q}(c)` (`weyl_conj_x`, in
  characteristic two).
* Both sides of the edge relation are multiplicative in `k`, so induction over the closure reduces
  it to generators, where it is `weyl_conj_x` again (`edge_aux`).

This ports the unwired foreign draft `LeavittK2/EdgeTriangleLift/EdgeConj.lean`.
-/

namespace GroupApproximation.Full.LVAssembly

open GroupApproximation.SteinbergGroup
open scoped Matrix

/-- `GL_2(L) = E_2(L)` for `L = L_{𝔽₂}(1,2)` (leaf T1a). -/
theorem hE2L : GroupApproximation.elementaryGroup (Fin 2) BinL = ⊤ :=
  GroupApproximation.Full.LVEGen.glTwo_eq_elementary (ZMod 2)

/-- Weyl conjugation by `w₃₂` in `St_4(L)`. -/
theorem weylLast_conj_x (p q : Fin 4) (hpq : p ≠ q) (c : BinL) :
    weylLast * x p q hpq c * weylLast⁻¹ =
      x (Equiv.swap (3 : Fin 4) 2 p) (Equiv.swap (3 : Fin 4) 2 q)
        ((Equiv.swap (3 : Fin 4) 2).injective.ne hpq) c :=
  weyl_conj_x (n := 4) two_eq_zero_binL (by decide) lastIdx_ne p q hpq c

/-- Conjugation by `τ` permutes the elementary matrices. -/
theorem swapLast_conj_elementaryUnit (p q : Fin 4) (hpq : p ≠ q) (c : BinL) :
    swapLast * GroupApproximation.elementaryUnit p q hpq c * swapLast⁻¹ =
      GroupApproximation.elementaryUnit (Equiv.swap (3 : Fin 4) 2 p) (Equiv.swap (3 : Fin 4) 2 q)
        ((Equiv.swap (3 : Fin 4) 2).injective.ne hpq) c := by
  have hc := congrArg
    (fun g => ((GroupApproximation.SteinbergGroup.projection g :
      GroupApproximation.elementaryGroup (Fin 4) BinL) : GLFour))
    (weylLast_conj_x p q hpq c)
  simp only [map_mul, map_inv, Subgroup.coe_mul, Subgroup.coe_inv,
    GroupApproximation.SteinbergGroup.projection_x, GroupApproximation.elementaryRoot_val] at hc
  exact hc

/-- Conjugation by `τ` preserves the closure of the edge generators. -/
theorem conj_mem_closure {g : GLFour} (hg : g ∈ Subgroup.closure (edgeGens BinL)) :
    swapLast * g * swapLast⁻¹ ∈ Subgroup.closure (edgeGens BinL) := by
  induction hg using Subgroup.closure_induction with
  | mem z hz =>
    obtain ⟨p, q, hpq, c, hq, rfl⟩ := hz
    have hsq : Equiv.swap (3 : Fin 4) 2 q = q :=
      Equiv.swap_apply_of_ne_of_ne (ne_three_of_lt_two hq) (ne_two_of_lt_two hq)
    have hq' : (Equiv.swap (3 : Fin 4) 2 q).val < 2 := by rw [hsq]; exact hq
    rw [swapLast_conj_elementaryUnit]
    exact Subgroup.subset_closure ⟨Equiv.swap (3 : Fin 4) 2 p, Equiv.swap (3 : Fin 4) 2 q,
      (Equiv.swap (3 : Fin 4) 2).injective.ne hpq, c, hq', rfl⟩
  | one =>
    rw [mul_one, mul_inv_cancel]
    exact one_mem _
  | mul a b _ _ iha ihb =>
    have e : swapLast * (a * b) * swapLast⁻¹ =
        swapLast * a * swapLast⁻¹ * (swapLast * b * swapLast⁻¹) := by group
    rw [e]
    exact mul_mem iha ihb
  | inv a _ ih =>
    have e : swapLast * a⁻¹ * swapLast⁻¹ = (swapLast * a * swapLast⁻¹)⁻¹ := by group
    rw [e]
    exact inv_mem ih

/-- The edge generators fix `e₃`. -/
theorem closure_le_vertexStab : Subgroup.closure (edgeGens BinL) ≤ vertexStab := by
  intro g hg
  show (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ Pi.single 3 1 = Pi.single 3 1
  exact (mulVec_single_iff _ 3).mpr
    (mem_columnFixer.mp (mem_edgeStab.mp (closure_edgeGens_le hg)).1)

/-- On a generator, the edge relation is Weyl conjugation. -/
theorem edge_gen (σ : vertexStab →* GroupApproximation.SteinbergGroup (Fin 4) BinL)
    (hσ : LiftsRoots σ) (p q : Fin 4) (hpq : p ≠ q) (c : BinL) (hq : q.val < 2)
    (h1 : GroupApproximation.elementaryUnit p q hpq c ∈ vertexStab)
    (h2 : swapLast * GroupApproximation.elementaryUnit p q hpq c * swapLast⁻¹ ∈ vertexStab) :
    weylLast * σ ⟨GroupApproximation.elementaryUnit p q hpq c, h1⟩ * weylLast⁻¹ =
      σ ⟨swapLast * GroupApproximation.elementaryUnit p q hpq c * swapLast⁻¹, h2⟩ := by
  have hq3 : q ≠ 3 := ne_three_of_lt_two hq
  have hsq : Equiv.swap (3 : Fin 4) 2 q = q :=
    Equiv.swap_apply_of_ne_of_ne hq3 (ne_two_of_lt_two hq)
  have hq3' : Equiv.swap (3 : Fin 4) 2 q ≠ 3 := by rw [hsq]; exact hq3
  have e2 : (⟨swapLast * GroupApproximation.elementaryUnit p q hpq c * swapLast⁻¹, h2⟩ :
      vertexStab) =
      ⟨GroupApproximation.elementaryUnit (Equiv.swap (3 : Fin 4) 2 p) (Equiv.swap (3 : Fin 4) 2 q)
        ((Equiv.swap (3 : Fin 4) 2).injective.ne hpq) c,
        elementaryUnit_mem_vertexStab _ _ _ hq3' c⟩ :=
    Subtype.ext (swapLast_conj_elementaryUnit p q hpq c)
  rw [e2, hσ p q hpq hq3 c, hσ _ _ _ hq3' c]
  exact weylLast_conj_x p q hpq c

/-- **The edge relation on the closure of the generators.** -/
theorem edge_aux (σ : vertexStab →* GroupApproximation.SteinbergGroup (Fin 4) BinL)
    (hσ : LiftsRoots σ) {g : GLFour} (hg : g ∈ Subgroup.closure (edgeGens BinL)) :
    ∀ (h1 : g ∈ vertexStab) (h2 : swapLast * g * swapLast⁻¹ ∈ vertexStab),
      weylLast * σ ⟨g, h1⟩ * weylLast⁻¹ = σ ⟨swapLast * g * swapLast⁻¹, h2⟩ := by
  induction hg using Subgroup.closure_induction with
  | mem z hz =>
    obtain ⟨p, q, hpq, c, hq, rfl⟩ := hz
    exact edge_gen σ hσ p q hpq c hq
  | one =>
    intro h1 h2
    have e0 : (⟨1, h1⟩ : vertexStab) = 1 := rfl
    have e1 : (⟨swapLast * 1 * swapLast⁻¹, h2⟩ : vertexStab) = 1 :=
      Subtype.ext (show swapLast * 1 * swapLast⁻¹ = 1 by rw [mul_one, mul_inv_cancel])
    rw [e0, e1, map_one, mul_one, mul_inv_cancel]
  | mul a b ha hb iha ihb =>
    intro h1 h2
    have haJ := closure_le_vertexStab ha
    have hbJ := closure_le_vertexStab hb
    have ha' := closure_le_vertexStab (conj_mem_closure ha)
    have hb' := closure_le_vertexStab (conj_mem_closure hb)
    have e1 : (⟨a * b, h1⟩ : vertexStab) = (⟨a, haJ⟩ : vertexStab) * (⟨b, hbJ⟩ : vertexStab) :=
      rfl
    have e2 : (⟨swapLast * (a * b) * swapLast⁻¹, h2⟩ : vertexStab) =
        (⟨swapLast * a * swapLast⁻¹, ha'⟩ : vertexStab) *
          (⟨swapLast * b * swapLast⁻¹, hb'⟩ : vertexStab) :=
      Subtype.ext (show swapLast * (a * b) * swapLast⁻¹ =
        swapLast * a * swapLast⁻¹ * (swapLast * b * swapLast⁻¹) by group)
    rw [e1, e2, map_mul, map_mul, ← iha haJ ha', ← ihb hbJ hb']
    group
  | inv a ha ih =>
    intro h1 h2
    have haJ := closure_le_vertexStab ha
    have ha' := closure_le_vertexStab (conj_mem_closure ha)
    have e1 : (⟨a⁻¹, h1⟩ : vertexStab) = (⟨a, haJ⟩ : vertexStab)⁻¹ := rfl
    have e2 : (⟨swapLast * a⁻¹ * swapLast⁻¹, h2⟩ : vertexStab) =
        (⟨swapLast * a * swapLast⁻¹, ha'⟩ : vertexStab)⁻¹ :=
      Subtype.ext (show swapLast * a⁻¹ * swapLast⁻¹ = (swapLast * a * swapLast⁻¹)⁻¹ by group)
    rw [e1, e2, map_inv, map_inv, ← ih haJ ha']
    group

/-- **Brown's edge relation for a root lift**, with `T = w₃₂` (Khanh, Thm 5.1;
tex l.733-735). -/
theorem edgeRelation_of_liftsRoots
    (σ : vertexStab →* GroupApproximation.SteinbergGroup (Fin 4) BinL) (hσ : LiftsRoots σ) :
    EdgeRelation σ weylLast := by
  rintro ⟨g, hg⟩ ⟨g', hg'⟩ hk hk'
  have hg3 : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ Pi.single 3 1 = Pi.single 3 1 := hg
  have hg2 : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ Pi.single 2 1 = Pi.single 2 1 := hk
  have hK : g ∈ edgeStab BinL :=
    mem_edgeStab.mpr ⟨mem_columnFixer.mpr ((mulVec_single_iff _ 3).mp hg3),
      mem_columnFixer.mpr ((mulVec_single_iff _ 2).mp hg2)⟩
  have hcl : g ∈ Subgroup.closure (edgeGens BinL) := edgeStab_le_closure hE2L hK
  have hk'' : g' = swapLast * g * swapLast⁻¹ := hk'
  subst hk''
  exact edge_aux σ hσ hcl hg hg'

end GroupApproximation.Full.LVAssembly
