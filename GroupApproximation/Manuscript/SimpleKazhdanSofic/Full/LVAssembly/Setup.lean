import Mathlib.Tactic.Group
import Mathlib.Data.Matrix.Basis
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Weyl.Basic
import GroupApproximation.Leavitt.UniversalLeavittOver
import GroupApproximation.Leavitt.ElementaryGroup

/-!
# The rank-four vertex setting and generation of `St_4(L)` (glue for `K₂(4, L) = ⊥`)

`simple_kazhdan_sofic_group.tex`, `sec:questions`, l.733-735.  This is the setting of the proof of
Khanh (arXiv:2609.08428), Thm 5.1, specialized to rank four over `L = L_{𝔽₂}(1,2)`.  Padding in
the corpus goes along `Fin.castSucc`, so the special index is `3`.

* `vertexStab = J = {g ∈ GL_4(L) | g e₃ = e₃}`, and `elementaryUnit_mem_vertexStab`.
* `weylLast = w₃₂`, whose image `swapLast = τ` swaps the base edge `(e₃, e₂)`.
* `swapMid = h`, the image of `w₂₁`.
* `steinberg_eq_top_of_mem`: `St_4(L)` is generated by the roots `x_{ij}(a)` with `j ≠ 3`,
  together with `w₃₂`.

This ports the unwired foreign drafts `LeavittK2/{CriterionSetup,CriterionGeneration}.lean`.
-/

namespace GroupApproximation.Full.LVAssembly

open scoped Matrix commutatorElement

noncomputable section

/-- The binary Leavitt algebra `L = L_{𝔽₂}(1,2)`. -/
abbrev BinL := GroupApproximation.BinaryLeavitt.BinaryLeavittAlgebra (ZMod 2)

/-- `GL_4(L)`. -/
abbrev GLFour := (Matrix (Fin 4) (Fin 4) BinL)ˣ

/-- The base vertex `e₃`. -/
def lastCol : Fin 4 → BinL := Pi.single 3 1

/-- The second vertex `e₂` of the base edge. -/
def prevCol : Fin 4 → BinL := Pi.single 2 1

/-- **The vertex stabilizer `J = {g | g e₃ = e₃}`** (Khanh, Thm 5.1; tex l.733-735). -/
def vertexStab : Subgroup GLFour where
  carrier := {g | (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol}
  mul_mem' {g g'} hg hg' := by
    have h₁ : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol := hg
    have h₂ : (g' : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol := hg'
    show ((g * g' : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, h₂, h₁]
  one_mem' := by
    show ((1 : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol
    rw [Units.val_one, Matrix.one_mulVec]
  inv_mem' {g} hg := by
    have h₁ : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol := hg
    show ((g⁻¹ : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol
    calc ((g⁻¹ : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol
        = ((g⁻¹ : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ
            ((g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol) := by rw [h₁]
      _ = lastCol := by
        rw [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
          Matrix.one_mulVec]

theorem mem_vertexStab {g : GLFour} :
    g ∈ vertexStab ↔ (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol :=
  Iff.rfl

/-- The elementary matrices `1 + E_{ij}(a)` with `j ≠ 3` fix `e₃`. -/
theorem elementaryUnit_mem_vertexStab (i j : Fin 4) (hij : i ≠ j) (hj : j ≠ 3) (a : BinL) :
    GroupApproximation.elementaryUnit i j hij a ∈ vertexStab := by
  show (1 + Matrix.single i j a) *ᵥ lastCol = lastCol
  have hj0 : lastCol j = 0 := by
    show Pi.single (3 : Fin 4) (1 : BinL) j = 0
    exact Pi.single_eq_of_ne hj 1
  rw [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.single_mulVec_eq, hj0, mul_zero, zero_smul,
    add_zero]

/-- The base-edge indices are distinct. -/
theorem lastIdx_ne : (3 : Fin 4) ≠ 2 := by decide

/-- The indices of `h` are distinct. -/
theorem midIdx_ne : (2 : Fin 4) ≠ 1 := by decide

/-- **The Weyl element `w₃₂` of the base edge.** -/
def weylLast : GroupApproximation.SteinbergGroup (Fin 4) BinL :=
  GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.weyl (R := BinL) (3 : Fin 4) 2
    lastIdx_ne

/-- `w₃₂` unfolded. -/
theorem weylLast_eq :
    weylLast = GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL) *
      GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm (1 : BinL) *
      GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL) :=
  rfl

/-- **The swap `τ` of the base edge `(e₃, e₂)`**: the image of `w₃₂` in `GL_4(L)`. -/
def swapLast : GLFour :=
  ((GroupApproximation.SteinbergGroup.projection weylLast :
      GroupApproximation.elementaryGroup (Fin 4) BinL) : GLFour)

/-- **Brown's element `h`**: the image of `w₂₁` in `GL_4(L)`. -/
def swapMid : GLFour :=
  ((GroupApproximation.SteinbergGroup.projection
      (GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.weyl (R := BinL) (2 : Fin 4) 1
        midIdx_ne) :
      GroupApproximation.elementaryGroup (Fin 4) BinL) : GLFour)

/-- A subgroup is closed under commutators. -/
theorem commutatorElement_mem {G : Type*} [Group G] (S : Subgroup G) {g h : G} (hg : g ∈ S)
    (hh : h ∈ S) : ⁅g, h⁆ ∈ S := by
  rw [commutatorElement_def]
  exact S.mul_mem (S.mul_mem (S.mul_mem hg hh) (S.inv_mem hg)) (S.inv_mem hh)

/-- **Generation of `St_4(L)`** by the roots `x_{ij}(a)` with `j ≠ 3`, together with `w₃₂`
(Khanh, Thm 5.1: `St_4` is generated by the lift of `J` and `w₃₂`; tex l.733-735). -/
theorem steinberg_eq_top_of_mem (S : Subgroup (GroupApproximation.SteinbergGroup (Fin 4) BinL))
    (hroot : ∀ (i j : Fin 4) (hij : i ≠ j), j ≠ 3 → ∀ a : BinL,
      GroupApproximation.SteinbergGroup.x i j hij a ∈ S)
    (hw : weylLast ∈ S) : S = ⊤ := by
  have hx32 : GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL) ∈ S :=
    hroot 3 2 lastIdx_ne (by decide) 1
  have h23 :
      GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm (1 : BinL) ∈ S := by
    have heq : GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm (1 : BinL) =
        (GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL))⁻¹ * weylLast *
          (GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL))⁻¹ := by
      rw [weylLast_eq]
      group
    rw [heq]
    exact S.mul_mem (S.mul_mem (S.inv_mem hx32) hw) (S.inv_mem hx32)
  have hi3 : ∀ (i : Fin 4), i ≠ 2 → ∀ (hi3 : i ≠ 3) (a : BinL),
      GroupApproximation.SteinbergGroup.x i 3 hi3 a ∈ S := by
    intro i hi2 hi3 a
    have hc := GroupApproximation.SteinbergGroup.x_commutator i 2 3 hi2 lastIdx_ne.symm hi3 a
      (1 : BinL)
    rw [mul_one] at hc
    rw [← hc]
    exact commutatorElement_mem S (hroot i 2 hi2 (by decide) a) h23
  have h23a : ∀ a : BinL,
      GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm a ∈ S := by
    intro a
    have h20 : (2 : Fin 4) ≠ 0 := by decide
    have h03 : (0 : Fin 4) ≠ 3 := by decide
    have hc := GroupApproximation.SteinbergGroup.x_commutator (2 : Fin 4) 0 3 h20 h03
      lastIdx_ne.symm a (1 : BinL)
    rw [mul_one] at hc
    rw [← hc]
    exact commutatorElement_mem S (hroot 2 0 h20 (by decide) a) (hi3 0 (by decide) h03 1)
  have hgen : ∀ s : GroupApproximation.SteinbergGenerator (Fin 4) BinL,
      (PresentedGroup.of s : GroupApproximation.SteinbergGroup (Fin 4) BinL) ∈ S := by
    rintro ⟨i, j, hij, a⟩
    show GroupApproximation.SteinbergGroup.x i j hij a ∈ S
    by_cases hj : j = 3
    · subst hj
      by_cases hi : i = 2
      · subst hi
        exact h23a a
      · exact hi3 i hi hij a
    · exact hroot i j hij hj a
  exact (Subgroup.eq_top_iff' S).mpr (PresentedGroup.generated_by _ S hgen)

end

end GroupApproximation.Full.LVAssembly
