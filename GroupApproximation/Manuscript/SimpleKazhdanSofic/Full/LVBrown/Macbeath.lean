import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVBrown.Action
import Mathlib.Algebra.Group.Action.Basic
import Mathlib.GroupTheory.PresentedGroup
import GroupApproximation.Meta.AxiomGuard

/-!
# The Brown–Macbeath presentation: generators, relations, and the covering relation (T1d)

`simple_kazhdan_sofic_group.tex`, `sec:questions`, l.733-735, leaf **T1d** (Brown's presentation
theorem; K. S. Brown, *Presentations for groups acting on simply-connected complexes*, J. Pure
Appl. Algebra 32 (1984); in the combinatorial form of A. M. Macbeath, *Groups of homeomorphisms
of a simply connected space*, Ann. of Math. 79 (1964)).

A `Datum X G` is a subset `F` of vertices, a connected "fundamental domain", with the following
properties.
* Every vertex is a translate of a vertex of `F`.
* `F` is connected by near pairs inside `F`.

The *Brown group* `D.Pres` is generated by the symbols `[g]` for `g : G` that carry some vertex
of `F` near some vertex of `F`.  Its relations are `[a][b] = [ab]` whenever
`(x, a•y, ab•z)` is a (possibly degenerate) cell with `x, y, z ∈ F`.  `D.toG : D.Pres →* G`
sends `[g]` to `g`.

This file proves the local algebra of the covering relation `D.Rel π y π' y'` on *states*
`(π, y)` with `y ∈ F`.  The position of a state is `toG π • y`.
-/

namespace GroupApproximation.Full.LVBrown

open GroupApproximation.Full.LVFrame

universe u

variable {V : Type u}

/-- Brown data: a connected fundamental domain `F` for an action of `G` on an ordered 2-complex
(Brown 1984, Thm 1; Macbeath 1964). -/
structure Datum (X : OrderedTwoComplex V) (G : Type*) [Group G] [MulAction G V] where
  /-- The fundamental domain. -/
  F : Set V
  /-- The action preserves edges and triangles. -/
  action : X.Action G
  /-- Every vertex is a translate of a vertex of `F`. -/
  cover : ∀ v : V, ∃ g : G, ∃ y ∈ F, g • y = v
  /-- A base vertex of `F`. -/
  base : V
  /-- The base vertex lies in `F`. -/
  base_mem : base ∈ F
  /-- `F` is connected through near pairs of vertices of `F`. -/
  connected : ∀ y ∈ F,
    Relation.ReflTransGen (fun u w : V => u ∈ F ∧ w ∈ F ∧ Near X u w) base y

variable {X : OrderedTwoComplex V} {G : Type*} [Group G] [MulAction G V]

namespace Datum

variable (D : Datum X G)

/-- Brown generators: group elements carrying a vertex of `F` near a vertex of `F`. -/
abbrev Gen : Type _ := {g : G // ∃ x ∈ D.F, ∃ y ∈ D.F, Near X x (g • y)}

/-- Build a Brown generator from a witness. -/
def mkGen (g : G) {x y : V} (hx : x ∈ D.F) (hy : y ∈ D.F) (h : Near X x (g • y)) : D.Gen :=
  ⟨g, x, hx, y, hy, h⟩

/-- Brown relators `[a][b][c]⁻¹` for `ab = c` and a cell `(x, a•y, c•z)` with `x, y, z ∈ F`. -/
def rels : Set (FreeGroup D.Gen) :=
  {r | ∃ a b c : D.Gen, a.1 * b.1 = c.1 ∧
    (∃ x ∈ D.F, ∃ y ∈ D.F, ∃ z ∈ D.F, Cell X x (a.1 • y) (c.1 • z)) ∧
    r = FreeGroup.of a * FreeGroup.of b * (FreeGroup.of c)⁻¹}

/-- The Brown group. -/
abbrev Pres : Type _ := PresentedGroup D.rels

/-- The canonical homomorphism `[g] ↦ g`. -/
def toG : D.Pres →* G :=
  PresentedGroup.toGroup (f := fun t : D.Gen => t.1) (by
    rintro r ⟨a, b, c, hab, -, rfl⟩
    simp only [map_mul, map_inv, FreeGroup.lift_apply_of]
    rw [hab, mul_inv_cancel])

theorem toG_of (t : D.Gen) : D.toG (PresentedGroup.of t) = t.1 :=
  PresentedGroup.toGroup.of _

/-- The Brown relation `[a][b] = [c]`. -/
theorem of_mul_of {a b c : D.Gen} (hab : a.1 * b.1 = c.1) {x y z : V} (hx : x ∈ D.F)
    (hy : y ∈ D.F) (hz : z ∈ D.F) (hcell : Cell X x (a.1 • y) (c.1 • z)) :
    (PresentedGroup.of a : D.Pres) * PresentedGroup.of b = PresentedGroup.of c := by
  have hr : FreeGroup.of a * FreeGroup.of b * (FreeGroup.of c)⁻¹ ∈ D.rels :=
    ⟨a, b, c, hab, ⟨x, hx, y, hy, z, hz, hcell⟩, rfl⟩
  have h1 := PresentedGroup.one_of_mem hr
  rw [map_mul, map_mul, map_inv] at h1
  exact mul_inv_eq_one.mp h1

/-- A generator representing `1` is trivial. -/
theorem of_eq_one (t : D.Gen) (ht : t.1 = 1) : (PresentedGroup.of t : D.Pres) = 1 := by
  obtain ⟨x, hx, -, -, -⟩ := t.2
  have h : (PresentedGroup.of t : D.Pres) * PresentedGroup.of t = PresentedGroup.of t :=
    D.of_mul_of (a := t) (b := t) (c := t) (by rw [ht, one_mul]) hx hx hx
      (by rw [ht, one_smul]; exact Cell.of_eq01 rfl (Near.refl x))
  exact mul_right_cancel (h.trans (one_mul _).symm)

/-- The covering relation between states `(π, y)` and `(π', y')`: `π' = π [t]` for a generator
`t` with `y` near `t • y'`.  The positions `toG π • y` and `toG π' • y'` are then near. -/
def Rel (π : D.Pres) (y : V) (π' : D.Pres) (y' : V) : Prop :=
  y ∈ D.F ∧ y' ∈ D.F ∧ ∃ t : D.Gen, π' = π * PresentedGroup.of t ∧ Near X y (t.1 • y')

/-- Two near vertices of `F` in the same frame are related. -/
theorem rel_same_frame (π : D.Pres) {u w : V} (hu : u ∈ D.F) (hw : w ∈ D.F) (h : Near X u w) :
    D.Rel π u π w := by
  have hn : Near X u ((1 : G) • w) := by rw [one_smul]; exact h
  refine ⟨hu, hw, D.mkGen 1 hu hw hn, ?_, hn⟩
  rw [D.of_eq_one (D.mkGen 1 hu hw hn) rfl, mul_one]

theorem rel_refl (π : D.Pres) {y : V} (hy : y ∈ D.F) : D.Rel π y π y :=
  D.rel_same_frame π hy hy (Near.refl y)

/-- Fork lemma: two generators out of one frame, related by a cell. -/
theorem rel_fork (π : D.Pres) {y₀ y₁ y₂ : V} (h₀ : y₀ ∈ D.F) (h₁ : y₁ ∈ D.F) (h₂ : y₂ ∈ D.F)
    (t₁ t₂ : D.Gen) (hcell : Cell X y₀ (t₁.1 • y₁) (t₂.1 • y₂)) :
    D.Rel (π * PresentedGroup.of t₁) y₁ (π * PresentedGroup.of t₂) y₂ := by
  have hnear : Near X y₁ ((t₁.1⁻¹ * t₂.1) • y₂) := by
    rw [mul_smul, ← near_smul_iff D.action t₁.1, smul_inv_smul]
    exact hcell.near12
  refine ⟨h₁, h₂, D.mkGen (t₁.1⁻¹ * t₂.1) h₁ h₂ hnear, ?_, hnear⟩
  have hrel := D.of_mul_of (a := t₁) (b := D.mkGen (t₁.1⁻¹ * t₂.1) h₁ h₂ hnear) (c := t₂)
    (mul_inv_cancel_left t₁.1 t₂.1) h₀ h₁ h₂ hcell
  rw [mul_assoc, hrel]

/-- Composition lemma: two consecutive generators, related by a cell. -/
theorem rel_comp (π : D.Pres) {y₀ y₁ y₂ : V} (h₀ : y₀ ∈ D.F) (h₁ : y₁ ∈ D.F) (h₂ : y₂ ∈ D.F)
    (t u : D.Gen) (hcell : Cell X y₀ (t.1 • y₁) ((t.1 * u.1) • y₂)) :
    D.Rel π y₀ (π * PresentedGroup.of t * PresentedGroup.of u) y₂ := by
  refine ⟨h₀, h₂, D.mkGen (t.1 * u.1) h₀ h₂ hcell.near02, ?_, hcell.near02⟩
  rw [mul_assoc, D.of_mul_of (a := t) (b := u) (c := D.mkGen (t.1 * u.1) h₀ h₂ hcell.near02)
    rfl h₀ h₁ h₂ hcell]

theorem Rel.symm {π π' : D.Pres} {y y' : V} (h : D.Rel π y π' y') : D.Rel π' y' π y := by
  obtain ⟨hy, hy', t, rfl, hn⟩ := h
  have hn1 : Near X y ((1 : G) • y) := Near.of_eq (one_smul G y).symm
  have key := D.rel_fork π hy hy' hy t (D.mkGen 1 hy hy hn1)
    (Cell.of_eq02 hn (one_smul G y).symm)
  rwa [D.of_eq_one (D.mkGen 1 hy hy hn1) rfl, mul_one] at key

/-- Two lifts of the same vertex out of one state are related. -/
theorem rel_of_fork {π π₁ π₂ : D.Pres} {y y₁ y₂ : V} (h₁ : D.Rel π y π₁ y₁)
    (h₂ : D.Rel π y π₂ y₂) (hpos : D.toG π₁ • y₁ = D.toG π₂ • y₂) : D.Rel π₁ y₁ π₂ y₂ := by
  obtain ⟨hy, hy₁, t₁, rfl, hn₁⟩ := h₁
  obtain ⟨-, hy₂, t₂, rfl, -⟩ := h₂
  rw [map_mul, map_mul, D.toG_of, D.toG_of, mul_smul, mul_smul] at hpos
  exact D.rel_fork π hy hy₁ hy₂ t₁ t₂ (Cell.of_eq12 hn₁ (smul_left_cancel _ hpos))

/-- Composition when the last step does not move the position. -/
theorem rel_trans_of_pos_eq_right {π₀ π₁ π₂ : D.Pres} {y₀ y₁ y₂ : V}
    (h₁ : D.Rel π₀ y₀ π₁ y₁) (h₂ : D.Rel π₁ y₁ π₂ y₂)
    (hpos : D.toG π₁ • y₁ = D.toG π₂ • y₂) : D.Rel π₀ y₀ π₂ y₂ := by
  obtain ⟨hy₀, hy₁, t, rfl, hn₁⟩ := h₁
  obtain ⟨-, hy₂, u, rfl, -⟩ := h₂
  rw [map_mul (D.toG) (π₀ * PresentedGroup.of t) (PresentedGroup.of u), D.toG_of u,
    mul_smul (D.toG (π₀ * PresentedGroup.of t)) u.1 y₂] at hpos
  have he : y₁ = u.1 • y₂ := smul_left_cancel _ hpos
  refine D.rel_comp π₀ hy₀ hy₁ hy₂ t u (Cell.of_eq12 hn₁ ?_)
  rw [mul_smul, he]

/-- Composition when the first step does not move the position. -/
theorem rel_trans_of_pos_eq_left {π₀ π₁ π₂ : D.Pres} {y₀ y₁ y₂ : V}
    (h₁ : D.Rel π₀ y₀ π₁ y₁) (h₂ : D.Rel π₁ y₁ π₂ y₂)
    (hpos : D.toG π₀ • y₀ = D.toG π₁ • y₁) : D.Rel π₀ y₀ π₂ y₂ := by
  obtain ⟨hy₀, hy₁, t, rfl, -⟩ := h₁
  obtain ⟨-, hy₂, u, rfl, hn₂⟩ := h₂
  rw [map_mul, D.toG_of, mul_smul] at hpos
  have he : y₀ = t.1 • y₁ := smul_left_cancel _ hpos
  have hn : Near X (t.1 • y₁) ((t.1 * u.1) • y₂) := by
    rw [mul_smul, near_smul_iff D.action]
    exact hn₂
  exact D.rel_comp π₀ hy₀ hy₁ hy₂ t u (Cell.of_eq01 he hn)

/-- Composition across an ordered triangle. -/
theorem rel_trans_of_tri {π₀ π₁ π₂ : D.Pres} {y₀ y₁ y₂ : V}
    (h₁ : D.Rel π₀ y₀ π₁ y₁) (h₂ : D.Rel π₁ y₁ π₂ y₂)
    (htri : X.tri (D.toG π₀ • y₀) (D.toG π₁ • y₁) (D.toG π₂ • y₂)) : D.Rel π₀ y₀ π₂ y₂ := by
  obtain ⟨hy₀, hy₁, t, rfl, -⟩ := h₁
  obtain ⟨-, hy₂, u, rfl, -⟩ := h₂
  have e₁ : D.toG (π₀ * PresentedGroup.of t) • y₁ = D.toG π₀ • t.1 • y₁ := by
    rw [map_mul, D.toG_of, mul_smul]
  have e₂ : D.toG (π₀ * PresentedGroup.of t * PresentedGroup.of u) • y₂ =
      D.toG π₀ • (t.1 * u.1) • y₂ := by
    rw [map_mul (D.toG) (π₀ * PresentedGroup.of t) (PresentedGroup.of u),
      map_mul (D.toG) π₀ (PresentedGroup.of t), D.toG_of t, D.toG_of u, mul_assoc,
      mul_smul (D.toG π₀) (t.1 * u.1) y₂]
  have h' : X.tri (D.toG π₀ • y₀) (D.toG π₀ • t.1 • y₁) (D.toG π₀ • (t.1 * u.1) • y₂) := by
    rw [← e₁, ← e₂]
    exact htri
  exact D.rel_comp π₀ hy₀ hy₁ hy₂ t u ((cell_smul_iff D.action (D.toG π₀)).mp (Cell.of_tri h'))

/-- One-step lifting: a state over `a` has a related state over any vertex near `a`. -/
theorem exists_rel {π : D.Pres} {y b : V} (hy : y ∈ D.F) (hb : Near X (D.toG π • y) b) :
    ∃ π' : D.Pres, ∃ y' : V, D.Rel π y π' y' ∧ D.toG π' • y' = b := by
  obtain ⟨h, z, hz, hhz⟩ := D.cover ((D.toG π)⁻¹ • b)
  have hn : Near X y (h • z) := by
    rw [← near_smul_iff D.action (D.toG π), hhz, smul_inv_smul]
    exact hb
  refine ⟨π * PresentedGroup.of (D.mkGen h hy hz hn), z, ⟨hy, hz, D.mkGen h hy hz hn, rfl, hn⟩, ?_⟩
  rw [map_mul, D.toG_of, mul_smul]
  show D.toG π • h • z = b
  rw [hhz, smul_inv_smul]

#audit_axioms GroupApproximation.Full.LVBrown.Datum.rel_trans_of_tri

end Datum

end GroupApproximation.Full.LVBrown
