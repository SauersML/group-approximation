import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.Halfline.HalflineB
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LamplighterWP.Generation
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LamplighterWordProblem
import GroupApproximation.Meta.AxiomGuard

/-!
# `G_Δ` has solvable word problem when `Δ` has

`simple_kazhdan_sofic_group.tex`, `lem:halfline` (b), tex l.609–610, used in the proof of the second statement of
`cor:lef` (tex l.448–455, `Lamplighter.PrintedLamplighterHostSolvableWordProblem`):

> (b) The word problem of G_Δ is Turing reducible to that of Δ.

So if `Δ` has solvable word problem, then `G_Δ = EL_3(R_Δ)` has solvable word problem.

## Proof route

* `Δ` has a finite generating family `t` with computable word problem.
* `G_Δ` is generated by the finite family `LamplighterWP.hostGen t` of matrices `e_ij(s)`, where `s` is `e_U` or
  `u_ξ^{±1}` for a letter `ξ` of `Λ` (`LamplighterWP.closure_range_hostGen`, tex l.365–368).
* The word problem of this family reduces to that of `t` (`halflineB_solvable`, i.e. `lem:halfline` (b)), so it is
  computable.
-/

namespace GroupApproximation.Full.SK11

open GroupApproximation.SimpleKazhdanSofic

/-- **`G_Δ` has solvable word problem when `Δ` has** (`lem:halfline` (b), tex l.609–610, as used at tex
l.448–455). This is the printed proposition `Lamplighter.PrintedLamplighterHostSolvableWordProblem`. -/
theorem lamplighterHostSolvableWP : Lamplighter.PrintedLamplighterHostSolvableWordProblem := by
  intro Δ _ hΔ
  obtain ⟨ι, _, _, t, ht, hpart⟩ := hΔ
  exact ⟨LamplighterWP.HGen ι, inferInstance, inferInstance, LamplighterWP.hostGen t,
    LamplighterWP.closure_range_hostGen t ht,
    halflineB_solvable Δ ⟨ι, inferInstance, inferInstance, t, ht, hpart⟩ (LamplighterWP.HGen ι)
      (LamplighterWP.hostGen t)⟩

#audit_axioms GroupApproximation.Full.SK11.lamplighterHostSolvableWP

end GroupApproximation.Full.SK11
