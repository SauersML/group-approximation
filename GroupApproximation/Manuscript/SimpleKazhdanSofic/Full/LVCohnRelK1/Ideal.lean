import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCohnRelK1.Words
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.Logic.Relation
import Mathlib.Tactic.Abel

/-!
# The kernel of `C₂(𝔽₂) → L_{𝔽₂}(1,2)` is spanned by matrix units

Let `I ⊆ C₂(𝔽₂)` be the `𝔽₂`-span of the matrix units `e_{μν} = x_μ p y_ν`.  It is a two-sided
ideal, and every element killed by `C₂(𝔽₂) → L_{𝔽₂}(1,2)` lies in `I`
(Ara-Brustenga-Cortiñas 2009: the kernel is the ideal generated by `p`, isomorphic to `M_∞(𝔽₂)`).
This is the excision input to step W1 of `simple_kazhdan_sofic_group.tex` l.733-735.
-/

namespace GroupApproximation.Full.LVCohnRelK1

noncomputable section

/-- The span of the matrix units `e_{μν}` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def cohnIdeal : Submodule (ZMod 2) CohnTwoF2 :=
  Submodule.span (ZMod 2) (Set.range fun q : List Bool × List Bool => unitE q.1 q.2)

theorem unitE_mem (μ ν : List Bool) : unitE μ ν ∈ cohnIdeal := by
  unfold cohnIdeal
  exact Submodule.subset_span ⟨(μ, ν), rfl⟩

theorem mul_mem_of_forall {c : CohnTwoF2} (hc : ∀ μ ν, c * unitE μ ν ∈ cohnIdeal)
    {z : CohnTwoF2} (hz : z ∈ cohnIdeal) : c * z ∈ cohnIdeal := by
  unfold cohnIdeal at hz
  induction hz using Submodule.span_induction with
  | mem _ hx =>
    obtain ⟨q, rfl⟩ := hx
    exact hc q.1 q.2
  | zero =>
    rw [mul_zero]
    exact Submodule.zero_mem _
  | add _ _ _ _ hx hy =>
    rw [mul_add]
    exact Submodule.add_mem _ hx hy
  | smul a _ _ hx =>
    rw [mul_smul_comm]
    exact Submodule.smul_mem _ a hx

theorem mem_mul_of_forall {c : CohnTwoF2} (hc : ∀ μ ν, unitE μ ν * c ∈ cohnIdeal)
    {z : CohnTwoF2} (hz : z ∈ cohnIdeal) : z * c ∈ cohnIdeal := by
  unfold cohnIdeal at hz
  induction hz using Submodule.span_induction with
  | mem _ hx =>
    obtain ⟨q, rfl⟩ := hx
    exact hc q.1 q.2
  | zero =>
    rw [zero_mul]
    exact Submodule.zero_mem _
  | add _ _ _ _ hx hy =>
    rw [add_mul]
    exact Submodule.add_mem _ hx hy
  | smul a _ _ hx =>
    rw [smul_mul_assoc]
    exact Submodule.smul_mem _ a hx

theorem cx_mul_mem (i : Bool) (μ ν : List Bool) : cx i * unitE μ ν ∈ cohnIdeal := by
  rw [cx_mul_unitE]
  exact unitE_mem _ _

theorem cy_mul_mem (i : Bool) (μ ν : List Bool) : cy i * unitE μ ν ∈ cohnIdeal := by
  cases μ with
  | nil =>
    rw [cy_mul_unitE_nil]
    exact Submodule.zero_mem _
  | cons j μ =>
    rw [cy_mul_unitE_cons]
    by_cases h : i = j
    · rw [h, cy_cx_self, one_mul]
      exact unitE_mem _ _
    · rw [cy_cx_ne h, zero_mul]
      exact Submodule.zero_mem _

theorem mul_cy_mem (i : Bool) (μ ν : List Bool) : unitE μ ν * cy i ∈ cohnIdeal := by
  rw [unitE_mul_cy]
  exact unitE_mem _ _

theorem mul_cx_mem (i : Bool) (μ ν : List Bool) : unitE μ ν * cx i ∈ cohnIdeal := by
  cases ν with
  | nil =>
    rw [unitE_nil_mul_cx]
    exact Submodule.zero_mem _
  | cons j ν =>
    rw [unitE_cons_mul_cx]
    by_cases h : j = i
    · rw [h, cy_cx_self, mul_one]
      exact unitE_mem _ _
    · rw [cy_cx_ne h, mul_zero]
      exact Submodule.zero_mem _

theorem gen_mul_mem (μ ν : List Bool) :
    ∀ g : BinaryLeavitt.Generator, cmk (FreeAlgebra.ι (ZMod 2) g) * unitE μ ν ∈ cohnIdeal
  | ⟨0, _⟩ => cx_mul_mem false μ ν
  | ⟨1, _⟩ => cx_mul_mem true μ ν
  | ⟨2, _⟩ => cy_mul_mem false μ ν
  | ⟨3, _⟩ => cy_mul_mem true μ ν
  | ⟨n + 4, h⟩ => absurd h (Nat.not_lt.mpr (Nat.le_add_left 4 n))

theorem mul_gen_mem (μ ν : List Bool) :
    ∀ g : BinaryLeavitt.Generator, unitE μ ν * cmk (FreeAlgebra.ι (ZMod 2) g) ∈ cohnIdeal
  | ⟨0, _⟩ => mul_cx_mem false μ ν
  | ⟨1, _⟩ => mul_cx_mem true μ ν
  | ⟨2, _⟩ => mul_cy_mem false μ ν
  | ⟨3, _⟩ => mul_cy_mem true μ ν
  | ⟨n + 4, h⟩ => absurd h (Nat.not_lt.mpr (Nat.le_add_left 4 n))

theorem cmk_mul_mem (a : BinaryLeavitt.Free (ZMod 2)) :
    ∀ z : CohnTwoF2, z ∈ cohnIdeal → cmk a * z ∈ cohnIdeal := by
  induction a using FreeAlgebra.induction with
  | grade0 r =>
    intro z hz
    rw [AlgHom.commutes, ← Algebra.smul_def]
    exact Submodule.smul_mem _ r hz
  | grade1 g =>
    intro z hz
    exact mul_mem_of_forall (fun μ ν => gen_mul_mem μ ν g) hz
  | mul _ _ ha hb =>
    intro z hz
    rw [map_mul, mul_assoc]
    exact ha _ (hb z hz)
  | add _ _ ha hb =>
    intro z hz
    rw [map_add, add_mul]
    exact Submodule.add_mem _ (ha z hz) (hb z hz)

theorem mul_cmk_mem (a : BinaryLeavitt.Free (ZMod 2)) :
    ∀ z : CohnTwoF2, z ∈ cohnIdeal → z * cmk a ∈ cohnIdeal := by
  induction a using FreeAlgebra.induction with
  | grade0 r =>
    intro z hz
    rw [AlgHom.commutes, ← Algebra.commutes, ← Algebra.smul_def]
    exact Submodule.smul_mem _ r hz
  | grade1 g =>
    intro z hz
    exact mem_mul_of_forall (fun μ ν => mul_gen_mem μ ν g) hz
  | mul _ _ ha hb =>
    intro z hz
    rw [map_mul, ← mul_assoc]
    exact hb _ (ha z hz)
  | add _ _ ha hb =>
    intro z hz
    rw [map_add, mul_add]
    exact Submodule.add_mem _ (ha z hz) (hb z hz)

/-- `I` is a left ideal (`simple_kazhdan_sofic_group.tex` l.733-735). -/
theorem cohn_mul_mem_left (c : CohnTwoF2) {z : CohnTwoF2} (hz : z ∈ cohnIdeal) :
    c * z ∈ cohnIdeal := by
  obtain ⟨a, rfl⟩ := mk_surjective c
  exact cmk_mul_mem a z hz

/-- `I` is a right ideal (`simple_kazhdan_sofic_group.tex` l.733-735). -/
theorem cohn_mul_mem_right (c : CohnTwoF2) {z : CohnTwoF2} (hz : z ∈ cohnIdeal) :
    z * c ∈ cohnIdeal := by
  obtain ⟨a, rfl⟩ := mk_surjective c
  exact mul_cmk_mem a z hz

theorem sub_mem_of_eq {x y : CohnTwoF2} (h : x = y) : x - y ∈ cohnIdeal := by
  rw [h, sub_self]
  exact Submodule.zero_mem _

theorem mem_of_eq_neg_cohnP {x : CohnTwoF2} (h : x = -unitE [] []) : x ∈ cohnIdeal := by
  rw [h]
  exact Submodule.neg_mem _ (unitE_mem [] [])

theorem sum_range_eq : cx false * cy false + cx true * cy true - 1 = -unitE [] [] := by
  rw [unitE_nil_nil, cohnP_def]
  abel

theorem sub_mem_of_relation {a b : BinaryLeavitt.Free (ZMod 2)}
    (h : BinaryLeavitt.Relation (ZMod 2) a b) : cmk a - cmk b ∈ cohnIdeal := by
  cases h with
  | t0_s0 => exact sub_mem_of_eq (mk_rel CohnRel.t0_s0)
  | t0_s1 => exact sub_mem_of_eq (mk_rel CohnRel.t0_s1)
  | t1_s0 => exact sub_mem_of_eq (mk_rel CohnRel.t1_s0)
  | t1_s1 => exact sub_mem_of_eq (mk_rel CohnRel.t1_s1)
  | sum_range =>
    apply mem_of_eq_neg_cohnP
    rw [map_add, map_mul, map_mul, map_one]
    exact sum_range_eq

theorem sub_mem_of_rel {a b : BinaryLeavitt.Free (ZMod 2)}
    (h : RingQuot.Rel (BinaryLeavitt.Relation (ZMod 2)) a b) : cmk a - cmk b ∈ cohnIdeal := by
  induction h with
  | of h => exact sub_mem_of_relation h
  | add_left _ ih =>
    rw [map_add, map_add, add_sub_add_right_eq_sub]
    exact ih
  | mul_left _ ih =>
    rw [map_mul, map_mul, ← sub_mul]
    exact cohn_mul_mem_right _ ih
  | mul_right _ ih =>
    rw [map_mul, map_mul, ← mul_sub]
    exact cohn_mul_mem_left _ ih

theorem sub_mem_of_eqvGen {a b : BinaryLeavitt.Free (ZMod 2)}
    (h : _root_.Relation.EqvGen (RingQuot.Rel (BinaryLeavitt.Relation (ZMod 2))) a b) :
    cmk a - cmk b ∈ cohnIdeal := by
  induction h with
  | rel _ _ h => exact sub_mem_of_rel h
  | refl _ =>
    rw [sub_self]
    exact Submodule.zero_mem _
  | symm _ _ _ ih =>
    rw [← neg_sub]
    exact Submodule.neg_mem _ ih
  | trans _ y _ _ _ ih1 ih2 =>
    rw [← sub_add_sub_cancel _ (cmk y)]
    exact Submodule.add_mem _ ih1 ih2

/-- Excision: the kernel of `C₂(𝔽₂) → L_{𝔽₂}(1,2)` lies in the span of the matrix units
(`simple_kazhdan_sofic_group.tex` l.733-735). -/
theorem mem_cohnIdeal_of_toLeavitt_eq_zero {z : CohnTwoF2} (hz : toLeavitt z = 0) :
    z ∈ cohnIdeal := by
  obtain ⟨a, rfl⟩ := mk_surjective z
  have h1 : RingQuot.mkRingHom (BinaryLeavitt.Relation (ZMod 2)) a =
      RingQuot.mkRingHom (BinaryLeavitt.Relation (ZMod 2)) 0 := by
    rw [← RingQuot.mkAlgHom_coe (ZMod 2) (BinaryLeavitt.Relation (ZMod 2))]
    exact (toLeavitt_mk a).symm.trans
      (hz.trans (map_zero (BinaryLeavitt.quotientMap (ZMod 2))).symm)
  have h2 : Quot.mk (RingQuot.Rel (BinaryLeavitt.Relation (ZMod 2))) a =
      Quot.mk (RingQuot.Rel (BinaryLeavitt.Relation (ZMod 2))) 0 := by
    have h3 := congrArg RingQuot.toQuot h1
    rw [RingQuot.mkRingHom_def] at h3
    exact h3
  have h4 := sub_mem_of_eqvGen (Quot.eqvGen_exact h2)
  rw [map_zero, sub_zero] at h4
  exact h4

/-- Elements of `I` are finite `𝔽₂`-combinations of matrix units. -/
theorem exists_finsupp_of_mem {z : CohnTwoF2} (hz : z ∈ cohnIdeal) :
    ∃ c : List Bool × List Bool →₀ ZMod 2, (c.sum fun q a => a • unitE q.1 q.2) = z := by
  unfold cohnIdeal at hz
  exact Finsupp.mem_span_range_iff_exists_finsupp.mp hz

end

end GroupApproximation.Full.LVCohnRelK1
