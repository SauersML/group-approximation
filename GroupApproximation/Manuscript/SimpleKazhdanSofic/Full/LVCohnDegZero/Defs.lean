import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LVCohnRelK1.Words

/-!
# The degree-zero part of the Cohn algebra `C₂(𝔽₂)`

Give `xᵢ` degree `1` and `yᵢ` degree `-1`.  The degree-zero part `C₀` of `C₂(𝔽₂)` is the
subring generated by the monomials `x_μ y_ν` with `|μ| = |ν|` (Ara-Brustenga-Cortiñas 2009,
Sec. 5 and the proof of Thm 3.6; `simple_kazhdan_sofic_group.tex` l.733-735, `sec:questions`,
leaf T1b.iii).

This file defines `cxWord`, `cyWord` and `cohnDegreeZero` exactly as in work order
WO-LVCohnK2-1.  It identifies them with the monomials `xw`, `yw` of `LVCohnRelK1.Words` and
proves the length calculus of products `y_ν x_α`:
* `y_μ x_μ = 1`;
* `y_ν x_α = 0` if `|ν| = |α|` and `ν ≠ α`;
* `p y_ν x_α = 0` if `|ν| < |α|`;
* `y_ν x_α p = 0` if `|α| < |ν|`.
-/

namespace GroupApproximation.Full.LVCohnDegZero

open GroupApproximation.Full.LVCohnRelK1

noncomputable section

/-- The monomial `x_μ = x_{μ₁} ⋯ x_{μ_k}` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def cxWord (mu : List Bool) : LVCohnRelK1.CohnTwoF2 := (mu.map LVCohnRelK1.cx).prod

/-- The monomial `y_ν = y_{ν_k} ⋯ y_{ν₁}` (`simple_kazhdan_sofic_group.tex` l.733-735). -/
def cyWord (nu : List Bool) : LVCohnRelK1.CohnTwoF2 := (nu.reverse.map LVCohnRelK1.cy).prod

/-- The degree-zero part `C₀ ⊆ C₂(𝔽₂)`, generated by the `x_μ y_ν` with `|μ| = |ν|`
(ABC 2009 Sec. 5; `simple_kazhdan_sofic_group.tex` l.733-735). -/
def cohnDegreeZero : Subring LVCohnRelK1.CohnTwoF2 :=
  Subring.closure {a | ∃ mu nu : List Bool, mu.length = nu.length ∧ a = cxWord mu * cyWord nu}

theorem cxWord_eq_xw : ∀ μ : List Bool, cxWord μ = xw μ
  | [] => rfl
  | i :: μ => by
    have h : cxWord (i :: μ) = cx i * cxWord μ := by
      simp only [cxWord, List.map_cons, List.prod_cons]
    rw [h, cxWord_eq_xw μ, xw_cons]

theorem cyWord_eq_yw : ∀ ν : List Bool, cyWord ν = yw ν
  | [] => rfl
  | i :: ν => by
    have h : cyWord (i :: ν) = cyWord ν * cy i := by
      rw [cyWord, List.reverse_cons, List.map_append, List.prod_append, cyWord, List.map_cons,
        List.map_nil, List.prod_cons, List.prod_nil, mul_one]
    rw [h, cyWord_eq_yw ν, yw_cons]

theorem xw_append_single : ∀ (μ : List Bool) (b : Bool), xw (μ ++ [b]) = xw μ * cx b
  | [], b => by rw [List.nil_append, xw_cons, xw_nil, mul_one, one_mul]
  | i :: μ, b => by rw [List.cons_append, xw_cons, xw_cons, xw_append_single μ b, mul_assoc]

theorem yw_append_single : ∀ (ν : List Bool) (b : Bool), yw (ν ++ [b]) = cy b * yw ν
  | [], b => by rw [List.nil_append, yw_cons, yw_nil, one_mul, mul_one]
  | i :: ν, b => by rw [List.cons_append, yw_cons, yw_cons, yw_append_single ν b, mul_assoc]

/-- The generators `x_μ y_ν` with `|μ| = |ν|` lie in `C₀`. -/
theorem xw_mul_yw_mem (μ ν : List Bool) (h : μ.length = ν.length) :
    xw μ * yw ν ∈ cohnDegreeZero := by
  have hs : xw μ * yw ν ∈ {a : CohnTwoF2 | ∃ mu nu : List Bool, mu.length = nu.length ∧
      a = cxWord mu * cyWord nu} := ⟨μ, ν, h, by rw [cxWord_eq_xw, cyWord_eq_yw]⟩
  exact Subring.subset_closure hs

theorem length_append_single_eq {μ ν : List Bool} (h : μ.length = ν.length) (b : Bool) :
    (μ ++ [b]).length = (ν ++ [b]).length := by
  rw [List.length_append, List.length_append, h]

/-- `e_{μν} = x_μ y_ν - x_{μ0} y_{ν0} - x_{μ1} y_{ν1}`. -/
theorem unitE_expand (μ ν : List Bool) :
    unitE μ ν = xw μ * yw ν - xw (μ ++ [false]) * yw (ν ++ [false]) -
      xw (μ ++ [true]) * yw (ν ++ [true]) := by
  rw [unitE_def, cohnP_def, xw_append_single, xw_append_single, yw_append_single,
    yw_append_single, mul_sub, mul_sub, mul_one, sub_mul, sub_mul]
  simp only [mul_assoc]

/-- The matrix units `e_{μν}` with `|μ| = |ν|` lie in `C₀`. -/
theorem unitE_mem (μ ν : List Bool) (h : μ.length = ν.length) :
    unitE μ ν ∈ cohnDegreeZero := by
  rw [unitE_expand]
  exact sub_mem (sub_mem (xw_mul_yw_mem μ ν h)
    (xw_mul_yw_mem _ _ (length_append_single_eq h false)))
    (xw_mul_yw_mem _ _ (length_append_single_eq h true))

theorem yw_mul_xw_self : ∀ μ : List Bool, yw μ * xw μ = 1
  | [] => by rw [yw_nil, xw_nil, one_mul]
  | i :: μ => by rw [yw_cons, xw_cons, yx_assoc, cy_cx_self, mul_one, yw_mul_xw_self μ]

theorem yw_mul_xw_of_ne :
    ∀ ν α : List Bool, ν.length = α.length → ν ≠ α → yw ν * xw α = 0
  | [], [], _, h => (h rfl).elim
  | [], _ :: _, hl, _ => by
    rw [List.length_nil, List.length_cons] at hl
    omega
  | _ :: _, [], hl, _ => by
    rw [List.length_nil, List.length_cons] at hl
    omega
  | i :: ν, j :: α, hl, h => by
    rw [yw_cons, xw_cons, yx_assoc]
    by_cases hij : i = j
    · subst hij
      have hne : ν ≠ α := fun e => h (congrArg (List.cons i) e)
      have hl' : ν.length = α.length := by
        rw [List.length_cons, List.length_cons] at hl
        omega
      rw [cy_cx_self, mul_one, yw_mul_xw_of_ne ν α hl' hne]
    · rw [cy_cx_ne hij, mul_zero, zero_mul]

/-- `p y_ν x_α = 0` when `|ν| < |α|`. -/
theorem cohnP_mul_yw_mul_xw_of_lt :
    ∀ ν α : List Bool, ν.length < α.length → cohnP * (yw ν * xw α) = 0
  | [], [], hl => absurd hl (Nat.lt_irrefl _)
  | [], _ :: _, _ => by
    rw [yw_nil, xw_cons, one_mul, ← mul_assoc, cohnP_cx, zero_mul]
  | _ :: _, [], hl => by
    rw [List.length_nil] at hl
    omega
  | i :: ν, j :: α, hl => by
    rw [yw_cons, xw_cons, yx_assoc]
    by_cases hij : i = j
    · subst hij
      have hl' : ν.length < α.length := by
        rw [List.length_cons, List.length_cons] at hl
        omega
      rw [cy_cx_self, mul_one, cohnP_mul_yw_mul_xw_of_lt ν α hl']
    · rw [cy_cx_ne hij, mul_zero, zero_mul, mul_zero]

/-- `y_ν x_α p = 0` when `|α| < |ν|`. -/
theorem yw_mul_xw_mul_cohnP_of_lt :
    ∀ ν α : List Bool, α.length < ν.length → yw ν * xw α * cohnP = 0
  | [], [], hl => absurd hl (Nat.lt_irrefl _)
  | [], _ :: _, hl => by
    rw [List.length_nil] at hl
    omega
  | _ :: _, [], _ => by
    rw [yw_cons, xw_nil, mul_one, mul_assoc, cy_cohnP, mul_zero]
  | i :: ν, j :: α, hl => by
    rw [yw_cons, xw_cons, yx_assoc]
    by_cases hij : i = j
    · subst hij
      have hl' : α.length < ν.length := by
        rw [List.length_cons, List.length_cons] at hl
        omega
      rw [cy_cx_self, mul_one, yw_mul_xw_mul_cohnP_of_lt ν α hl']
    · rw [cy_cx_ne hij, mul_zero, zero_mul, zero_mul]

end

end GroupApproximation.Full.LVCohnDegZero
