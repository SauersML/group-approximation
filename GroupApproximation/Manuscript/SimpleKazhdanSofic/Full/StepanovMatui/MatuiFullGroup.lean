import Mathlib
import GroupApproximation.Meta.AxiomGuard

/-!
# Topological full groups, swaps and three-cycles

`simple_kazhdan_sofic_group.tex`, remark at tex l.307–309:

> For derived topological full groups, Matui showed by a similar argument that a nontrivial normal
> subgroup meets a simple union of products of alternating groups on towers
> [Matui, Lemma 3.4 and Theorem 4.9].

This file sets up the objects of that sentence for a homeomorphism `T` of a compact Hausdorff space
`X`:

* `fullGroup T`: the topological full group `[[T]]`, the permutations `g` with `g x = T^{n(x)} x` for
  a continuous `n : X → ℤ`;
* `swapAlong f U`: the involution exchanging `U` and `f U` along `f` (identity elsewhere), which lies
  in `[[T]]` for `f ∈ [[T]]` and `U` clopen;
* `threeCycle f U = ⁅swapAlong f U, swapAlong f² U⁆`, the three-cycle `U → f U → f² U → U`
  (`threeCycle_apply_of_mem`), for `U, f U, f² U` pairwise disjoint (`IsThreeCycleDatum`);
* `alternatingFullGroup T`: the subgroup generated by these three-cycles, the union of the
  alternating groups on towers.  It lies in `⁅[[T]], [[T]]⁆` (`alternatingFullGroup_le_commutator`)
  and is normalized by `[[T]]` (`conj_mem_alternatingFullGroup`).
-/

namespace GroupApproximation
namespace Full
namespace StepanovMatui
namespace Matui

open scoped commutatorElement

variable {X : Type*}

/-! ## Powers of a homeomorphism -/

theorem zpow_apply_zpow_apply [TopologicalSpace X] (T : X ≃ₜ X) (a b : ℤ) (x : X) :
    (T ^ a) ((T ^ b) x) = (T ^ (a + b)) x := by
  rw [zpow_add, Homeomorph.mul_apply]

theorem zpow_neg_apply_zpow_apply [TopologicalSpace X] (T : X ≃ₜ X) (a : ℤ) (x : X) :
    (T ^ (-a)) ((T ^ a) x) = x := by
  rw [zpow_apply_zpow_apply, neg_add_cancel, zpow_zero, Homeomorph.one_apply]

/-- `x ↦ T^{n(x)} x` is continuous for a continuous `n : X → ℤ`. -/
theorem continuous_zpow_apply [TopologicalSpace X] (T : X ≃ₜ X) {n : X → ℤ} (hn : Continuous n) :
    Continuous fun x => (T ^ n x) x := by
  refine continuous_iff_continuousAt.2 fun x => ?_
  have hopen : IsOpen (n ⁻¹' {n x}) := hn.isOpen_preimage _ (isOpen_discrete _)
  refine ((T ^ n x).continuous.continuousAt).congr ?_
  refine Filter.eventually_of_mem (hopen.mem_nhds (Set.mem_preimage.2 (Set.mem_singleton _)))
    fun y hy => ?_
  have hy' : n y = n x := hy
  show (T ^ n x) y = (T ^ n y) y
  rw [hy']

open Classical in
/-- A function defined by cases on a clopen set is continuous. -/
theorem continuous_ite_of_isClopen [TopologicalSpace X] {Y : Type*} [TopologicalSpace Y]
    (p : X → Prop) (hp : IsClopen {x | p x}) {g h : X → Y} (hg : Continuous g)
    (hh : Continuous h) : Continuous fun x => if p x then g x else h x := by
  refine hg.if (fun a ha => ?_) hh
  have hfr : frontier {x | p x} = ∅ := isClopen_iff_frontier_eq_empty.mp hp
  rw [hfr] at ha
  exact absurd ha (Set.notMem_empty a)

theorem perm_inv_apply_self (f : Equiv.Perm X) (x : X) : f⁻¹ (f x) = x :=
  Equiv.symm_apply_apply f x

theorem perm_apply_inv_self (f : Equiv.Perm X) (x : X) : f (f⁻¹ x) = x :=
  Equiv.apply_symm_apply f x

/-! ## The topological full group -/

/-- `g` is a piecewise power of `T` with continuous exponent. -/
def IsFullGroupElement [TopologicalSpace X] (T : X ≃ₜ X) (g : Equiv.Perm X) : Prop :=
  ∃ n : X → ℤ, Continuous n ∧ ∀ x, g x = (T ^ n x) x

theorem IsFullGroupElement.continuous [TopologicalSpace X] {T : X ≃ₜ X} {g : Equiv.Perm X}
    (hg : IsFullGroupElement T g) : Continuous g := by
  obtain ⟨n, hn, hgn⟩ := hg
  have h : (g : X → X) = fun x => (T ^ n x) x := funext hgn
  rw [h]
  exact continuous_zpow_apply T hn

theorem isFullGroupElement_one [TopologicalSpace X] (T : X ≃ₜ X) :
    IsFullGroupElement T 1 := by
  refine ⟨fun _ => 0, continuous_const, fun x => ?_⟩
  show x = (T ^ (0 : ℤ)) x
  rw [zpow_zero, Homeomorph.one_apply]

theorem IsFullGroupElement.mul [TopologicalSpace X] {T : X ≃ₜ X} {g h : Equiv.Perm X}
    (hg : IsFullGroupElement T g) (hh : IsFullGroupElement T h) : IsFullGroupElement T (g * h) := by
  have hhc : Continuous h := hh.continuous
  obtain ⟨n, hn, hgn⟩ := hg
  obtain ⟨m, hm, hhm⟩ := hh
  refine ⟨fun x => n (h x) + m x, (hn.comp hhc).add hm, fun x => ?_⟩
  show g (h x) = (T ^ (n (h x) + m x)) x
  rw [hgn (h x), hhm x, zpow_apply_zpow_apply]

theorem IsFullGroupElement.inv [TopologicalSpace X] [CompactSpace X] [T2Space X] {T : X ≃ₜ X}
    {g : Equiv.Perm X} (hg : IsFullGroupElement T g) : IsFullGroupElement T g⁻¹ := by
  have hgc : Continuous g := hg.continuous
  have hinvc : Continuous (g⁻¹ : Equiv.Perm X) :=
    Continuous.continuous_symm_of_equiv_compact_to_t2 hgc
  obtain ⟨n, hn, hgn⟩ := hg
  refine ⟨fun x => -n (g⁻¹ x), (hn.comp hinvc).neg, fun x => ?_⟩
  show g⁻¹ x = (T ^ (-n (g⁻¹ x))) x
  have h1 : (T ^ n (g⁻¹ x)) (g⁻¹ x) = x := by
    rw [← hgn (g⁻¹ x)]
    exact perm_apply_inv_self g x
  calc g⁻¹ x = (T ^ (-n (g⁻¹ x))) ((T ^ n (g⁻¹ x)) (g⁻¹ x)) :=
        (zpow_neg_apply_zpow_apply T _ _).symm
    _ = (T ^ (-n (g⁻¹ x))) x := by rw [h1]

/-- **The topological full group** `[[T]]`. -/
def fullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X] (T : X ≃ₜ X) :
    Subgroup (Equiv.Perm X) where
  carrier := {g | IsFullGroupElement T g}
  mul_mem' := fun {a b} (ha : IsFullGroupElement T a) (hb : IsFullGroupElement T b) =>
    IsFullGroupElement.mul ha hb
  one_mem' := isFullGroupElement_one T
  inv_mem' := fun {a} (ha : IsFullGroupElement T a) => IsFullGroupElement.inv ha

theorem mem_fullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X] {T : X ≃ₜ X}
    {g : Equiv.Perm X} : g ∈ fullGroup T ↔ IsFullGroupElement T g :=
  Iff.rfl

theorem toEquiv_mem_fullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X] (T : X ≃ₜ X) :
    T.toEquiv ∈ fullGroup T := by
  refine mem_fullGroup.mpr ⟨fun _ => 1, continuous_const, fun x => ?_⟩
  show T x = (T ^ (1 : ℤ)) x
  rw [zpow_one]

/-! ## Swaps along a permutation -/

open Classical in
/-- The map exchanging `U` and `f U` along `f`. -/
noncomputable def swapFun (f : Equiv.Perm X) (U : Set X) (x : X) : X :=
  if x ∈ U then f x else if f⁻¹ x ∈ U then f⁻¹ x else x

theorem swapFun_of_mem {f : Equiv.Perm X} {U : Set X} {x : X} (hx : x ∈ U) :
    swapFun f U x = f x := by
  rw [swapFun, if_pos hx]

theorem swapFun_of_inv_mem {f : Equiv.Perm X} {U : Set X} {x : X} (hx : x ∉ U)
    (hfx : f⁻¹ x ∈ U) : swapFun f U x = f⁻¹ x := by
  rw [swapFun, if_neg hx, if_pos hfx]

theorem swapFun_of_not_mem {f : Equiv.Perm X} {U : Set X} {x : X} (hx : x ∉ U)
    (hfx : f⁻¹ x ∉ U) : swapFun f U x = x := by
  rw [swapFun, if_neg hx, if_neg hfx]

theorem swapFun_swapFun {f : Equiv.Perm X} {U : Set X} (hU : ∀ x ∈ U, f x ∉ U) (x : X) :
    swapFun f U (swapFun f U x) = x := by
  by_cases hx : x ∈ U
  · have h2 : f⁻¹ (f x) ∈ U := by
      rw [perm_inv_apply_self]
      exact hx
    rw [swapFun_of_mem hx, swapFun_of_inv_mem (hU x hx) h2, perm_inv_apply_self]
  · by_cases hfx : f⁻¹ x ∈ U
    · rw [swapFun_of_inv_mem hx hfx, swapFun_of_mem hfx, perm_apply_inv_self]
    · rw [swapFun_of_not_mem hx hfx, swapFun_of_not_mem hx hfx]

open Classical in
/-- **The swap** of `U` and `f U` along `f`, when `U` and `f U` are disjoint (and `1` otherwise). -/
noncomputable def swapAlong (f : Equiv.Perm X) (U : Set X) : Equiv.Perm X :=
  if hU : ∀ x ∈ U, f x ∉ U then
    { toFun := swapFun f U, invFun := swapFun f U,
      left_inv := swapFun_swapFun hU, right_inv := swapFun_swapFun hU }
  else 1

open Classical in
theorem swapAlong_apply {f : Equiv.Perm X} {U : Set X} (hU : ∀ x ∈ U, f x ∉ U) (x : X) :
    swapAlong f U x = swapFun f U x := by
  rw [swapAlong, dif_pos hU, Equiv.coe_fn_mk]

open Classical in
theorem swapAlong_of_not {f : Equiv.Perm X} {U : Set X} (hU : ¬∀ x ∈ U, f x ∉ U) :
    swapAlong f U = 1 := by
  rw [swapAlong, dif_neg hU]

theorem swapAlong_mul_self {f : Equiv.Perm X} {U : Set X} (hU : ∀ x ∈ U, f x ∉ U) :
    swapAlong f U * swapAlong f U = 1 := by
  refine Equiv.ext fun x => ?_
  rw [Equiv.Perm.mul_apply, swapAlong_apply hU, swapAlong_apply hU, swapFun_swapFun hU,
    Equiv.Perm.one_apply]

theorem swapAlong_inv {f : Equiv.Perm X} {U : Set X} (hU : ∀ x ∈ U, f x ∉ U) :
    (swapAlong f U)⁻¹ = swapAlong f U :=
  inv_eq_of_mul_eq_one_right (swapAlong_mul_self hU)

/-- A swap along an element of `[[T]]` across a clopen set lies in `[[T]]`. -/
theorem swapAlong_mem_fullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X]
    {T : X ≃ₜ X} {f : Equiv.Perm X} (hf : f ∈ fullGroup T) {U : Set X} (hUc : IsClopen U) :
    swapAlong f U ∈ fullGroup T := by
  classical
  by_cases hU : ∀ x ∈ U, f x ∉ U
  · have hinvc : Continuous (f⁻¹ : Equiv.Perm X) :=
      IsFullGroupElement.continuous (mem_fullGroup.mp ((fullGroup T).inv_mem hf))
    obtain ⟨n, hn, hfn⟩ := mem_fullGroup.mp hf
    refine mem_fullGroup.mpr ⟨fun x => if x ∈ U then n x else if f⁻¹ x ∈ U then -n (f⁻¹ x) else 0,
      ?_, fun x => ?_⟩
    · exact continuous_ite_of_isClopen (fun x => x ∈ U) hUc hn
        (continuous_ite_of_isClopen (fun x => f⁻¹ x ∈ U) (hUc.preimage hinvc) (hn.comp hinvc).neg
          continuous_const)
    · show swapAlong f U x =
        (T ^ (if x ∈ U then n x else if f⁻¹ x ∈ U then -n (f⁻¹ x) else 0)) x
      by_cases hx : x ∈ U
      · rw [if_pos hx, swapAlong_apply hU, swapFun_of_mem hx, hfn x]
      · by_cases hfx : f⁻¹ x ∈ U
        · rw [if_neg hx, if_pos hfx, swapAlong_apply hU, swapFun_of_inv_mem hx hfx]
          have h1 : (T ^ n (f⁻¹ x)) (f⁻¹ x) = x := by
            rw [← hfn (f⁻¹ x)]
            exact perm_apply_inv_self f x
          calc f⁻¹ x = (T ^ (-n (f⁻¹ x))) ((T ^ n (f⁻¹ x)) (f⁻¹ x)) :=
                (zpow_neg_apply_zpow_apply T _ _).symm
            _ = (T ^ (-n (f⁻¹ x))) x := by rw [h1]
        · rw [if_neg hx, if_neg hfx, swapAlong_apply hU, swapFun_of_not_mem hx hfx, zpow_zero,
            Homeomorph.one_apply]
  · rw [swapAlong_of_not hU]
    exact (fullGroup T).one_mem

/-- Conjugating a swap moves it along the conjugate permutation. -/
theorem conj_swapFun (f g : Equiv.Perm X) (U : Set X) (y : X) :
    g (swapFun f U (g⁻¹ y)) = swapFun (g * f * g⁻¹) (⇑g⁻¹ ⁻¹' U) y := by
  have hinv : (g * f * g⁻¹)⁻¹ = g * f⁻¹ * g⁻¹ := by group
  by_cases hy : g⁻¹ y ∈ U
  · rw [swapFun_of_mem hy, swapFun_of_mem (show y ∈ ⇑g⁻¹ ⁻¹' U from hy), Equiv.Perm.mul_apply,
      Equiv.Perm.mul_apply]
  · have hy' : y ∉ ⇑g⁻¹ ⁻¹' U := hy
    have hback : g⁻¹ ((g * f * g⁻¹)⁻¹ y) = f⁻¹ (g⁻¹ y) := by
      rw [hinv, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, perm_inv_apply_self]
    by_cases hfy : f⁻¹ (g⁻¹ y) ∈ U
    · have hmem : (g * f * g⁻¹)⁻¹ y ∈ ⇑g⁻¹ ⁻¹' U := by
        show g⁻¹ ((g * f * g⁻¹)⁻¹ y) ∈ U
        rw [hback]
        exact hfy
      rw [swapFun_of_inv_mem hy hfy, swapFun_of_inv_mem hy' hmem, hinv, Equiv.Perm.mul_apply,
        Equiv.Perm.mul_apply]
    · have hnm : (g * f * g⁻¹)⁻¹ y ∉ ⇑g⁻¹ ⁻¹' U := by
        show g⁻¹ ((g * f * g⁻¹)⁻¹ y) ∉ U
        rw [hback]
        exact hfy
      rw [swapFun_of_not_mem hy hfy, swapFun_of_not_mem hy' hnm, perm_apply_inv_self]

theorem conj_swapAlong {f : Equiv.Perm X} {U : Set X} (hU : ∀ x ∈ U, f x ∉ U)
    (g : Equiv.Perm X) : g * swapAlong f U * g⁻¹ = swapAlong (g * f * g⁻¹) (⇑g⁻¹ ⁻¹' U) := by
  have hU' : ∀ y ∈ ⇑g⁻¹ ⁻¹' U, (g * f * g⁻¹) y ∉ ⇑g⁻¹ ⁻¹' U := by
    intro y hy
    show g⁻¹ ((g * f * g⁻¹) y) ∉ U
    simp only [Equiv.Perm.mul_apply, perm_inv_apply_self]
    exact hU _ hy
  refine Equiv.ext fun y => ?_
  rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, swapAlong_apply hU, swapAlong_apply hU',
    conj_swapFun]

/-! ## Three-cycles and the alternating full group -/

/-- `U`, `f U` and `f² U` are pairwise disjoint. -/
def IsThreeCycleDatum (f : Equiv.Perm X) (U : Set X) : Prop :=
  (∀ x ∈ U, f x ∉ U) ∧ ∀ x ∈ U, f (f x) ∉ U

theorem IsThreeCycleDatum.conj {f : Equiv.Perm X} {U : Set X} (h : IsThreeCycleDatum f U)
    (g : Equiv.Perm X) : IsThreeCycleDatum (g * f * g⁻¹) (⇑g⁻¹ ⁻¹' U) := by
  refine ⟨fun y hy => ?_, fun y hy => ?_⟩
  · show g⁻¹ ((g * f * g⁻¹) y) ∉ U
    simp only [Equiv.Perm.mul_apply, perm_inv_apply_self]
    exact h.1 _ hy
  · show g⁻¹ ((g * f * g⁻¹) ((g * f * g⁻¹) y)) ∉ U
    simp only [Equiv.Perm.mul_apply, perm_inv_apply_self]
    exact h.2 _ hy

/-- **The three-cycle** `U → f U → f² U → U`, as the commutator of two swaps. -/
noncomputable def threeCycle (f : Equiv.Perm X) (U : Set X) : Equiv.Perm X :=
  ⁅swapAlong f U, swapAlong (f * f) U⁆

/-- The three-cycle maps `x ∈ U` to `f x`. -/
theorem threeCycle_apply_of_mem {f : Equiv.Perm X} {U : Set X} (h : IsThreeCycleDatum f U)
    {x : X} (hx : x ∈ U) : threeCycle f U x = f x := by
  have hff : ∀ y ∈ U, (f * f) y ∉ U := h.2
  have h1 : (f * f) x = f (f x) := rfl
  have h2 : (f * f)⁻¹ (f (f x)) = x := perm_inv_apply_self (f * f) x
  have h3 : f⁻¹ (f (f x)) = f x := perm_inv_apply_self f (f x)
  have h4 : f⁻¹ (f (f x)) ∉ U := by
    rw [h3]
    exact h.1 x hx
  have h5 : (f * f)⁻¹ (f (f x)) ∈ U := by
    rw [h2]
    exact hx
  unfold threeCycle
  rw [commutatorElement_def, swapAlong_inv h.1, swapAlong_inv hff, Equiv.Perm.mul_apply,
    Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, swapAlong_apply hff x, swapFun_of_mem hx, h1,
    swapAlong_apply h.1 (f (f x)), swapFun_of_not_mem (h.2 x hx) h4,
    swapAlong_apply hff (f (f x)), swapFun_of_inv_mem (h.2 x hx) h5, h2, swapAlong_apply h.1 x,
    swapFun_of_mem hx]

theorem conj_threeCycle {f : Equiv.Perm X} {U : Set X} (h : IsThreeCycleDatum f U)
    (g : Equiv.Perm X) : g * threeCycle f U * g⁻¹ = threeCycle (g * f * g⁻¹) (⇑g⁻¹ ⁻¹' U) := by
  have hff : ∀ y ∈ U, (f * f) y ∉ U := h.2
  have hsq : g * (f * f) * g⁻¹ = (g * f * g⁻¹) * (g * f * g⁻¹) := by group
  have hconj : ∀ a b : Equiv.Perm X, g * ⁅a, b⁆ * g⁻¹ = ⁅g * a * g⁻¹, g * b * g⁻¹⁆ := by
    intro a b
    simp only [commutatorElement_def]
    group
  unfold threeCycle
  rw [hconj, conj_swapAlong h.1, conj_swapAlong hff, hsq]

/-- The three-cycles of `[[T]]` on clopen sets. -/
def threeCycles [TopologicalSpace X] [CompactSpace X] [T2Space X] (T : X ≃ₜ X) :
    Set (Equiv.Perm X) :=
  {σ | ∃ f ∈ fullGroup T, ∃ U : Set X, IsClopen U ∧ IsThreeCycleDatum f U ∧ σ = threeCycle f U}

/-- **The alternating full group**: the subgroup generated by the three-cycles on clopen towers. -/
def alternatingFullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X] (T : X ≃ₜ X) :
    Subgroup (Equiv.Perm X) :=
  Subgroup.closure (threeCycles T)

theorem threeCycle_mem_commutator [TopologicalSpace X] [CompactSpace X] [T2Space X]
    {T : X ≃ₜ X} {f : Equiv.Perm X} (hf : f ∈ fullGroup T) {U : Set X} (hU : IsClopen U) :
    threeCycle f U ∈ ⁅fullGroup T, fullGroup T⁆ := by
  show ⁅swapAlong f U, swapAlong (f * f) U⁆ ∈ ⁅fullGroup T, fullGroup T⁆
  exact Subgroup.commutator_mem_commutator (swapAlong_mem_fullGroup hf hU)
    (swapAlong_mem_fullGroup ((fullGroup T).mul_mem hf hf) hU)

theorem threeCycle_mem_alternatingFullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X]
    {T : X ≃ₜ X} {f : Equiv.Perm X} (hf : f ∈ fullGroup T) {U : Set X} (hU : IsClopen U)
    (h : IsThreeCycleDatum f U) : threeCycle f U ∈ alternatingFullGroup T :=
  Subgroup.subset_closure ⟨f, hf, U, hU, h, rfl⟩

/-- The alternating full group lies in the derived full group. -/
theorem alternatingFullGroup_le_commutator [TopologicalSpace X] [CompactSpace X] [T2Space X]
    (T : X ≃ₜ X) : alternatingFullGroup T ≤ ⁅fullGroup T, fullGroup T⁆ := by
  rw [alternatingFullGroup, Subgroup.closure_le]
  rintro σ ⟨f, hf, U, hU, -, rfl⟩
  exact threeCycle_mem_commutator hf hU

/-- The alternating full group is normalized by `[[T]]`. -/
theorem conj_mem_alternatingFullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X]
    {T : X ≃ₜ X} {g : Equiv.Perm X} (hg : g ∈ fullGroup T) {a : Equiv.Perm X}
    (ha : a ∈ alternatingFullGroup T) : g * a * g⁻¹ ∈ alternatingFullGroup T := by
  have hinvc : Continuous (g⁻¹ : Equiv.Perm X) :=
    IsFullGroupElement.continuous (mem_fullGroup.mp ((fullGroup T).inv_mem hg))
  refine Subgroup.closure_induction (k := threeCycles T)
    (p := fun a _ => g * a * g⁻¹ ∈ alternatingFullGroup T) ?_ ?_ ?_ ?_ ha
  · rintro x ⟨f, hf, U, hU, hdat, rfl⟩
    show g * threeCycle f U * g⁻¹ ∈ alternatingFullGroup T
    rw [conj_threeCycle hdat]
    exact threeCycle_mem_alternatingFullGroup
      ((fullGroup T).mul_mem ((fullGroup T).mul_mem hg hf) ((fullGroup T).inv_mem hg))
      (hU.preimage hinvc) (hdat.conj g)
  · show g * 1 * g⁻¹ ∈ alternatingFullGroup T
    rw [mul_one, mul_inv_cancel]
    exact (alternatingFullGroup T).one_mem
  · intro x y _ _ hx hy
    show g * (x * y) * g⁻¹ ∈ alternatingFullGroup T
    have e : g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) := by group
    rw [e]
    exact (alternatingFullGroup T).mul_mem hx hy
  · intro x _ hx
    show g * x⁻¹ * g⁻¹ ∈ alternatingFullGroup T
    have e : g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ := by group
    rw [e]
    exact (alternatingFullGroup T).inv_mem hx

