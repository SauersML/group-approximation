import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiTowerCoords
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiTowerPerm
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiFragment
import GroupApproximation.Meta.AxiomGuard

/-!
# Level transpositions of Kakutani–Rokhlin towers

`simple_kazhdan_sofic_group.tex`, remark at tex l.307–315 (Matui, Lemma 3.4 and Theorem 4.9).

`thinGenSet T Y M` is `T` together with all elements of `[[T]]` supported in the thin set
`thin T Y M`. Take a clopen base `W ⊆ Y` whose points do not return to `Y` within `K` steps. Then
every transposition of levels `i ↔ j` (`i, j ≤ K`) of the tower over `W` lies in the subgroup
generated by `thinGenSet T Y M`. The reason is that `Perm (Fin (K + 1))` is generated by adjacent
transpositions (`Equiv.Perm.mclosure_swap_castSucc_succ`). On the tower, the adjacent transposition
`c ↔ c + 1` is the conjugate by `T^c` of the swap `swapAlong T W` of the two bottom levels, and that
swap is supported in `thin T Y 1`. This is the permutation step of the Kakutani–Rokhlin arguments of
Matui (Internat. J. Math. 2006, Lemma 3.4, §4) and Grigorchuk–Medynets (2014, §3).

* `exists_levelSwap_thinGenSet`: level transpositions lie in `closure (thinGenSet T Y M)`;
* `closure_thinGenSet_le`: `closure (thinGenSet T Y M) ≤ [[T]]`.
-/

namespace GroupApproximation
namespace Full
namespace StepanovMatui
namespace Matui

variable {X : Type*}

/-- The levels `0, 1, …, K` of a tower. -/
def towerLevels (K : ℕ) (i : Fin (K + 1)) : ℤ := ((i : ℕ) : ℤ)

/-- Tower actions only depend on the levels as sets and on the differences of the exponents. -/
theorem towerPerm_congr {f : Equiv.Perm X} {W W' : Set X} {n : ℕ} {E E' : Fin n → ℤ}
    (hdisj : ∀ i j x, (f ^ (-E i)) x ∈ W → (f ^ (-E j)) x ∈ W → i = j)
    (hdisj' : ∀ i j x, (f ^ (-E' i)) x ∈ W' → (f ^ (-E' j)) x ∈ W' → i = j)
    (hWW' : ∀ i x, (f ^ (-E i)) x ∈ W ↔ (f ^ (-E' i)) x ∈ W')
    (hEE' : ∀ i j, E i - E j = E' i - E' j) (σ : Equiv.Perm (Fin n)) :
    towerPerm f W E hdisj σ = towerPerm f W' E' hdisj' σ := by
  refine Equiv.ext fun x => ?_
  rw [towerPerm_apply, towerPerm_apply]
  by_cases h : ∃ i, (f ^ (-E i)) x ∈ W
  · obtain ⟨i, hi⟩ := h
    rw [towerFun_of_mem hdisj hi, towerFun_of_mem hdisj' ((hWW' i x).mp hi), hEE']
  · have h' : ¬∃ i, (f ^ (-E' i)) x ∈ W' := fun h' =>
      Exists.elim h' fun i hi => h ⟨i, (hWW' i x).mpr hi⟩
    rw [towerFun_of_not h, towerFun_of_not h']

/-- The adjacent transposition `c ↔ c + 1` of a tower along `f` is the conjugate by `f^c` of the
swap of the two bottom levels. -/
theorem towerPerm_swap_castSucc_succ {f : Equiv.Perm X} {W : Set X} {K : ℕ}
    (hdisj : ∀ i j x, (f ^ (-towerLevels K i)) x ∈ W → (f ^ (-towerLevels K j)) x ∈ W → i = j)
    (c : Fin K) :
    towerPerm f W (towerLevels K) hdisj (Equiv.swap c.castSucc c.succ) =
      f ^ ((c : ℕ) : ℤ) * swapAlong f W * (f ^ ((c : ℕ) : ℤ))⁻¹ := by
  have hc := c.isLt
  have hU : ∀ x ∈ W, f x ∉ W := by
    intro x hx hfx
    have h0 : (f ^ (-towerLevels K ⟨0, by omega⟩)) (f x) ∈ W := by
      show (f ^ (-((0 : ℕ) : ℤ))) (f x) ∈ W
      rw [Nat.cast_zero, neg_zero, zpow_zero, Equiv.Perm.one_apply]
      exact hfx
    have h1 : (f ^ (-towerLevels K ⟨1, by omega⟩)) (f x) ∈ W := by
      show (f ^ (-((1 : ℕ) : ℤ))) (f x) ∈ W
      rw [Nat.cast_one, zpow_neg_one, perm_inv_apply_self]
      exact hx
    have h01 : (0 : ℕ) = 1 := Fin.val_eq_of_eq (hdisj _ _ (f x) h0 h1)
    omega
  obtain ⟨k, hk⟩ : ∃ k : ℤ, k = ((c : ℕ) : ℤ) := ⟨_, rfl⟩
  rw [← hk, conj_swapAlong hU, (Commute.zpow_self f k).eq, mul_inv_cancel_right]
  have hWW' : ∀ i x, (f ^ (-towerLevels K i)) x ∈ W ↔
      (f ^ (-(towerLevels K i - k))) x ∈ ⇑(f ^ k)⁻¹ ⁻¹' W := by
    intro i x
    show _ ↔ (f ^ k)⁻¹ ((f ^ (-(towerLevels K i - k))) x) ∈ W
    rw [← zpow_neg, perm_zpow_apply_zpow_apply,
      show -k + -(towerLevels K i - k) = -towerLevels K i by ring]
  have hdisj' : ∀ i j x, (f ^ (-(towerLevels K i - k))) x ∈ ⇑(f ^ k)⁻¹ ⁻¹' W →
      (f ^ (-(towerLevels K j - k))) x ∈ ⇑(f ^ k)⁻¹ ⁻¹' W → i = j :=
    fun i j x hi hj => hdisj i j x ((hWW' i x).mpr hi) ((hWW' j x).mpr hj)
  rw [towerPerm_congr (E' := fun i => towerLevels K i - k) hdisj hdisj' hWW'
    (fun i j => by
      show towerLevels K i - towerLevels K j = (towerLevels K i - k) - (towerLevels K j - k)
      ring)]
  have hE0 : towerLevels K c.castSucc - k = 0 := by
    show ((c.castSucc : ℕ) : ℤ) - k = 0
    rw [Fin.val_castSucc, hk, sub_self]
  have hg : ∀ y ∈ ⇑(f ^ k)⁻¹ ⁻¹' W, f y = (f ^ (towerLevels K c.succ - k)) y := by
    intro y _
    show f y = (f ^ (((c.succ : ℕ) : ℤ) - k)) y
    rw [Fin.val_succ, hk, show (((c : ℕ) + 1 : ℕ) : ℤ) - ((c : ℕ) : ℤ) = 1 by omega, zpow_one]
  exact (swapAlong_eq_towerPerm (E := fun i => towerLevels K i - k) hdisj' hE0
    (Fin.castSucc_lt_succ (i := c)).ne hg).symm

/-- A subgroup containing `f` and the bottom swap contains every tower permutation. -/
theorem towerPerm_mem_of_swapAlong_mem {f : Equiv.Perm X} {W : Set X} {K : ℕ}
    (hdisj : ∀ i j x, (f ^ (-towerLevels K i)) x ∈ W → (f ^ (-towerLevels K j)) x ∈ W → i = j)
    {S : Subgroup (Equiv.Perm X)} (hf : f ∈ S) (hs : swapAlong f W ∈ S)
    (σ : Equiv.Perm (Fin (K + 1))) : towerPerm f W (towerLevels K) hdisj σ ∈ S := by
  have hle : Subgroup.closure (Set.range fun c : Fin K => Equiv.swap c.castSucc c.succ) ≤
      S.comap (towerPerm f W (towerLevels K) hdisj) := by
    rw [Subgroup.closure_le]
    rintro _ ⟨c, rfl⟩
    show towerPerm f W (towerLevels K) hdisj (Equiv.swap c.castSucc c.succ) ∈ S
    rw [towerPerm_swap_castSucc_succ hdisj c]
    exact S.mul_mem (S.mul_mem (S.zpow_mem hf _) hs) (S.inv_mem (S.zpow_mem hf _))
  have hσ : σ ∈ Subgroup.closure (Set.range fun c : Fin K => Equiv.swap c.castSucc c.succ) := by
    rw [Subgroup.closure_eq_top_of_mclosure_eq_top (Equiv.Perm.mclosure_swap_castSucc_succ K)]
    exact Subgroup.mem_top σ
  exact Subgroup.mem_comap.mp (hle hσ)

section Tower

variable [TopologicalSpace X] {T : X ≃ₜ X} {Y : Set X}

theorem isCoord_zpow_neg {W : Set X} (hWY : W ⊆ Y) {K : ℕ} (hWK : ∀ y ∈ W, NoReturn T Y y K)
    {a : ℕ} (ha : a ≤ K) {x : X} (hx : (T ^ (-(a : ℤ))) x ∈ W) :
    IsCoord T Y ((T ^ (-(a : ℤ))) x) a x :=
  ⟨hWY hx, (hWK _ hx).mono ha, by
    rw [zpow_apply_zpow_apply_of_eq T (a : ℤ) (-(a : ℤ)) 0 (by ring) x, homeo_zpow_zero_apply]⟩

/-- **Level transpositions** of the tower over `W`, inside any subgroup containing `T` and the
bottom swap. -/
theorem exists_levelSwap {S : Subgroup (Equiv.Perm X)} (hT : T.toEquiv ∈ S) {W : Set X}
    (hs : swapAlong T.toEquiv W ∈ S) (hWY : W ⊆ Y) {K : ℕ} (hWK : ∀ y ∈ W, NoReturn T Y y K)
    {i j : ℕ} (hi : i ≤ K) (hj : j ≤ K) :
    ∃ t ∈ S, (∀ y ∈ W, t ((T ^ (i : ℤ)) y) = (T ^ (j : ℤ)) y ∧
      t ((T ^ (j : ℤ)) y) = (T ^ (i : ℤ)) y) ∧
      ∀ z, (∀ y ∈ W, z ≠ (T ^ (i : ℤ)) y ∧ z ≠ (T ^ (j : ℤ)) y) → t z = z := by
  have hdisj : ∀ a b x, (T.toEquiv ^ (-towerLevels K a)) x ∈ W →
      (T.toEquiv ^ (-towerLevels K b)) x ∈ W → a = b := by
    intro a b x ha hb
    rw [toEquiv_zpow_apply] at ha hb
    have ha' := a.isLt
    have hb' := b.isLt
    exact Fin.ext (isCoord_unique (isCoord_zpow_neg hWY hWK (a := (a : ℕ)) (by omega) ha)
      (isCoord_zpow_neg hWY hWK (a := (b : ℕ)) (by omega) hb)).1
  have hlev : ∀ {a : ℕ} (ha : a < K + 1), ∀ y ∈ W,
      (T.toEquiv ^ (-towerLevels K ⟨a, ha⟩)) ((T ^ (a : ℤ)) y) ∈ W := by
    intro a ha y hy
    show (T.toEquiv ^ (-((a : ℕ) : ℤ))) ((T ^ (a : ℤ)) y) ∈ W
    rw [toEquiv_zpow_apply, zpow_neg_apply_zpow_apply]
    exact hy
  have hmove : ∀ {a b : ℕ} (ha : a < K + 1) (hb : b < K + 1), ∀ y : X,
      (T.toEquiv ^ (towerLevels K ⟨b, hb⟩ - towerLevels K ⟨a, ha⟩)) ((T ^ (a : ℤ)) y) =
        (T ^ (b : ℤ)) y := by
    intro a b ha hb y
    show (T.toEquiv ^ ((b : ℤ) - (a : ℤ))) ((T ^ (a : ℤ)) y) = (T ^ (b : ℤ)) y
    rw [toEquiv_zpow_apply]
    exact zpow_apply_zpow_apply_of_eq T _ _ _ (by ring) y
  have hi' : i < K + 1 := by omega
  have hj' : j < K + 1 := by omega
  refine ⟨towerPerm T.toEquiv W (towerLevels K) hdisj (Equiv.swap ⟨i, hi'⟩ ⟨j, hj'⟩),
    towerPerm_mem_of_swapAlong_mem hdisj hT hs _, fun y hy => ⟨?_, ?_⟩, fun z hz => ?_⟩
  · rw [towerPerm_apply, towerFun_of_mem hdisj (hlev hi' y hy), Equiv.swap_apply_left]
    exact hmove hi' hj' y
  · rw [towerPerm_apply, towerFun_of_mem hdisj (hlev hj' y hy), Equiv.swap_apply_right]
    exact hmove hj' hi' y
  · rw [towerPerm_apply]
    by_cases h : ∃ a, (T.toEquiv ^ (-towerLevels K a)) z ∈ W
    · obtain ⟨a, ha⟩ := h
      rw [towerFun_of_mem hdisj ha]
      have hne : ∀ {c : ℕ} (hc : c < K + 1), (c = i ∨ c = j) → a ≠ ⟨c, hc⟩ := by
        rintro c hc hcij rfl
        rw [toEquiv_zpow_apply] at ha
        have hcoord := isCoord_zpow_neg hWY hWK (a := c) (by omega) ha
        rcases hcij with rfl | rfl
        · exact (hz _ ha).1 hcoord.2.2.symm
        · exact (hz _ ha).2 hcoord.2.2.symm
      rw [Equiv.swap_apply_of_ne_of_ne (hne hi' (Or.inl rfl)) (hne hj' (Or.inr rfl)), sub_self,
        zpow_zero, Equiv.Perm.one_apply]
    · exact towerFun_of_not h

/-- Generators: `T` and the elements of `[[T]]` supported in the thin set `thin T Y M`. -/
def thinGenSet [CompactSpace X] [T2Space X] (T : X ≃ₜ X) (Y : Set X) (M : ℕ) :
    Set (Equiv.Perm X) :=
  insert T.toEquiv {r | r ∈ fullGroup T ∧ HydeLodha.SupportedIn r (thin T Y M)}

theorem closure_thinGenSet_le [CompactSpace X] [T2Space X] (T : X ≃ₜ X) (Y : Set X) (M : ℕ) :
    Subgroup.closure (thinGenSet T Y M) ≤ fullGroup T := by
  rw [Subgroup.closure_le]
  rintro r (rfl | ⟨hr, -⟩)
  · exact toEquiv_mem_fullGroup T
  · exact hr

theorem mem_thinGenSet_of_supportedIn [CompactSpace X] [T2Space X] {M : ℕ} {r : Equiv.Perm X}
    (hr : r ∈ fullGroup T) (hrZ : HydeLodha.SupportedIn r (thin T Y M)) : r ∈ thinGenSet T Y M :=
  Set.mem_insert_of_mem _ ⟨hr, hrZ⟩

/-- The bottom swap of a tower over `W ⊆ Y` is a generator. -/
theorem swapAlong_mem_thinGenSet [CompactSpace X] [T2Space X] {M : ℕ} (hM : 1 ≤ M) {W : Set X}
    (hWc : IsClopen W) (hWY : W ⊆ Y) : swapAlong T.toEquiv W ∈ thinGenSet T Y M := by
  refine mem_thinGenSet_of_supportedIn (swapAlong_mem_fullGroup (toEquiv_mem_fullGroup T) hWc)
    ((supportedIn_swapAlong T.toEquiv W).mono fun y hy => ?_)
  rcases hy with hy | hy
  · exact self_mem_thin (hWY hy) M
  · have e : (T ^ (-1 : ℤ)) y = T.toEquiv⁻¹ y := by
      rw [← toEquiv_zpow_apply, zpow_neg_one]
    refine mem_thin_of (k := -1) (by omega) (by omega) ?_
    rw [e]
    exact hWY hy

/-- **Level transpositions are generated by `T` and thin elements** (Matui 2006, Lemma 3.4, §4;
Grigorchuk–Medynets 2014, §3; tex l.307–315). -/
theorem exists_levelSwap_thinGenSet [CompactSpace X] [T2Space X] {M : ℕ} (hM : 1 ≤ M)
    {W : Set X} (hWc : IsClopen W) (hWY : W ⊆ Y) {K : ℕ} (hWK : ∀ y ∈ W, NoReturn T Y y K)
    {i j : ℕ} (hi : i ≤ K) (hj : j ≤ K) :
    ∃ t ∈ Subgroup.closure (thinGenSet T Y M), (∀ y ∈ W, t ((T ^ (i : ℤ)) y) = (T ^ (j : ℤ)) y ∧
      t ((T ^ (j : ℤ)) y) = (T ^ (i : ℤ)) y) ∧
      ∀ z, (∀ y ∈ W, z ≠ (T ^ (i : ℤ)) y ∧ z ≠ (T ^ (j : ℤ)) y) → t z = z :=
  exists_levelSwap (Subgroup.subset_closure (Set.mem_insert _ _))
    (Subgroup.subset_closure (swapAlong_mem_thinGenSet hM hWc hWY)) hWY hWK hi hj

