import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiDecompose
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiLevelSwaps
import GroupApproximation.Meta.AxiomGuard

/-!
# Elements of bounded displacement are generated by `T` and thin elements

`simple_kazhdan_sofic_group.tex`, remark at tex l.307–315 (Matui, Lemma 3.4 and Theorem 4.9).

Let `(X, T)` be an infinite minimal system, `Y` a nonempty clopen set and `M ≥ 1`. Every `g ∈ [[T]]`
with `g x ∈ {T^k x : |k| ≤ M}` for all `x` lies in the subgroup generated by `thinGenSet T Y M`,
that is, by `T` and the elements of `[[T]]` supported in `thin T Y M`. The proof sorts `g` level
by level on the Kakutani–Rokhlin towers over `Y` (`MatuiDecompose`). Each step multiplies `g` by a
level transposition from `MatuiLevelSwaps` over a clopen base. The base is clopen because `T` has
no periodic points, so `{x | g x = T^d x}` is the clopen level set of the cocycle of `g`. This is
the Kakutani–Rokhlin argument of Matui (Internat. J. Math. 2006, Lemma 3.4, §4) and
Grigorchuk–Medynets (2014, §3), without metrizability.

* `isClopen_setOf_apply_eq_zpow`: `{x | g x = T^d x}` is clopen;
* `mem_closure_thinGenSet`: the generation statement.
-/

namespace GroupApproximation
namespace Full
namespace StepanovMatui
namespace Matui

variable {X : Type*} [TopologicalSpace X] {T : X ≃ₜ X} {Y : Set X} {M : ℕ}

/-- For a system without periodic points, the set where `g ∈ [[T]]` acts as `T^d` is clopen. -/
theorem isClopen_setOf_apply_eq_zpow [CompactSpace X] [T2Space X] [Infinite X]
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) {g : Equiv.Perm X} (hg : g ∈ fullGroup T)
    (d : ℤ) : IsClopen {x | g x = (T ^ d) x} := by
  obtain ⟨n, hn, hgn⟩ := mem_fullGroup.mp hg
  have e : {x | g x = (T ^ d) x} = n ⁻¹' {d} := by
    ext x
    constructor
    · intro hx
      by_contra hne
      have hne' : n x ≠ d := hne
      refine SimpleKazhdanSofic.zpow_apply_ne_self T hmin (j := n x - d) (by omega) ((T ^ d) x) ?_
      rw [zpow_apply_zpow_apply_of_eq T (n x - d) d (n x) (by ring) x, ← hgn x]
      exact hx
    · intro hx
      show g x = (T ^ d) x
      rw [hgn x, show n x = d from hx]
  rw [e]
  exact (isClopen_discrete {d}).preimage hn

/-- One sorting step, with the clopen base of the level transposition. -/
theorem mem_closure_of_sortInv_succ [CompactSpace X] [T2Space X] [Infinite X]
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) (hYc : IsClopen Y) (hM : 1 ≤ M) {m J : ℕ}
    (hP : ∀ g ∈ fullGroup T, SortInv T Y M m (J + 1) g → g ∈ Subgroup.closure (thinGenSet T Y M))
    {g : Equiv.Perm X} (hg : g ∈ fullGroup T) (h : SortInv T Y M m J g) :
    g ∈ Subgroup.closure (thinGenSet T Y M) := by
  by_cases hJm : J = m
  · subst hJm
    exact hP g hg (sortInv_succ_of_eq h)
  obtain ⟨W, hW⟩ : ∃ W : Set X, ∀ y, y ∈ W ↔ y ∈ Y ∧ NoReturn T Y y m ∧ NoReturn T Y y J ∧
      (T ^ (m : ℤ)) y ∉ thin T Y M ∧ g ((T ^ (m : ℤ)) y) = (T ^ (J : ℤ)) y :=
    ⟨{y | y ∈ Y ∧ NoReturn T Y y m ∧ NoReturn T Y y J ∧
      (T ^ (m : ℤ)) y ∉ thin T Y M ∧ g ((T ^ (m : ℤ)) y) = (T ^ (J : ℤ)) y}, fun _ => Iff.rfl⟩
  have hWc : IsClopen W := by
    have e : W = Y ∩ ({y | NoReturn T Y y m} ∩ ({y | NoReturn T Y y J} ∩
        (⇑(T ^ (m : ℤ)) ⁻¹' (thin T Y M)ᶜ ∩
          ⇑(T ^ (m : ℤ)) ⁻¹' {x | g x = (T ^ ((J : ℤ) - m)) x}))) := by
      ext y
      rw [hW y]
      have e2 : g ((T ^ (m : ℤ)) y) = (T ^ ((J : ℤ) - m)) ((T ^ (m : ℤ)) y) ↔
          g ((T ^ (m : ℤ)) y) = (T ^ (J : ℤ)) y := by
        rw [zpow_apply_zpow_apply_of_eq T ((J : ℤ) - m) (m : ℤ) (J : ℤ) (by ring) y]
      exact ⟨fun hy => ⟨hy.1, hy.2.1, hy.2.2.1, hy.2.2.2.1, e2.mpr hy.2.2.2.2⟩,
        fun hy => ⟨hy.1, hy.2.1, hy.2.2.1, hy.2.2.2.1, e2.mp hy.2.2.2.2⟩⟩
    rw [e]
    exact hYc.inter ((isClopen_setOf_noReturn (T := T) hYc m).inter
      ((isClopen_setOf_noReturn (T := T) hYc J).inter
        (((isClopen_thin (T := T) hYc M).compl.preimage (T ^ (m : ℤ)).continuous).inter
          ((isClopen_setOf_apply_eq_zpow hmin hg ((J : ℤ) - m)).preimage
            (T ^ (m : ℤ)).continuous))))
  have hWK : ∀ y ∈ W, NoReturn T Y y (max m J) := fun y hy k hk1 hk2 => by
    by_cases hkm : k ≤ m
    · exact ((hW y).mp hy).2.1 k hk1 hkm
    · exact ((hW y).mp hy).2.2.1 k hk1 (by omega)
  obtain ⟨t, ht, ht1, ht2⟩ := exists_levelSwap_thinGenSet hM hWc (fun y hy => ((hW y).mp hy).1)
    hWK (le_max_left m J) (le_max_right m J)
  have htg : t * g ∈ Subgroup.closure (thinGenSet T Y M) :=
    hP (t * g) ((fullGroup T).mul_mem (closure_thinGenSet_le T Y M ht) hg)
      (sortInv_step hJm h hW ht1 ht2)
  have hmem := (Subgroup.closure (thinGenSet T Y M)).mul_mem
    ((Subgroup.closure (thinGenSet T Y M)).inv_mem ht) htg
  rwa [inv_mul_cancel_left] at hmem

/-- Downward induction on the sorting invariant. -/
theorem mem_closure_of_sortInv [CompactSpace X] [T2Space X] [Infinite X]
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) (hYc : IsClopen Y) (hM : 1 ≤ M) {H : ℕ}
    (hret : ∀ x : X, ∃ j : ℕ, j ≤ H ∧ (T ^ (-(j : ℤ))) x ∈ Y) {g : Equiv.Perm X}
    (hg : g ∈ fullGroup T) (h : SortInv T Y M 0 0 g) :
    g ∈ Subgroup.closure (thinGenSet T Y M) := by
  have hbase : ∀ g ∈ fullGroup T, SortInv T Y M (H + 1) 0 g →
      g ∈ Subgroup.closure (thinGenSet T Y M) := fun g hg h =>
    Subgroup.subset_closure (mem_thinGenSet_of_supportedIn hg (supportedIn_of_sortInv hret h))
  have hinner : ∀ m, (∀ g ∈ fullGroup T, SortInv T Y M m (H + 1) g →
      g ∈ Subgroup.closure (thinGenSet T Y M)) → ∀ k J, J + k = H + 1 →
      ∀ g ∈ fullGroup T, SortInv T Y M m J g → g ∈ Subgroup.closure (thinGenSet T Y M) := by
    intro m hm k
    induction k with
    | zero =>
      intro J hJ
      obtain rfl : J = H + 1 := by omega
      exact hm
    | succ k ih =>
      intro J hJ g hg h
      exact mem_closure_of_sortInv_succ hmin hYc hM (ih (J + 1) (by omega)) hg h
  have houter : ∀ k m, m + k = H + 1 → ∀ g ∈ fullGroup T, SortInv T Y M m 0 g →
      g ∈ Subgroup.closure (thinGenSet T Y M) := by
    intro k
    induction k with
    | zero =>
      intro m hm
      obtain rfl : m = H + 1 := by omega
      exact hbase
    | succ k ih =>
      intro m hm
      refine hinner m (fun g hg h => ?_) (H + 1) 0 (by omega)
      exact ih (m + 1) (by omega) g hg (sortInv_terminal hret h)
  exact houter (H + 1) 0 (by omega) g hg h

/-- **Generation by `T` and thin elements** (Matui 2006, Lemma 3.4, §4; Grigorchuk–Medynets 2014,
§3; tex l.307–315): an element of `[[T]]` moving points by at most `M ≥ 1` along their orbits
lies in the subgroup generated by `T` and the elements of `[[T]]` supported in `thin T Y M`. -/
theorem mem_closure_thinGenSet [CompactSpace X] [T2Space X] [Infinite X]
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) (hYc : IsClopen Y) (hYne : Y.Nonempty)
    (hM : 1 ≤ M) {g : Equiv.Perm X} (hg : g ∈ fullGroup T)
    (hbd : ∀ x, ∃ k : ℤ, -(M : ℤ) ≤ k ∧ k ≤ M ∧ g x = (T ^ k) x) :
    g ∈ Subgroup.closure (thinGenSet T Y M) := by
  obtain ⟨H, hret⟩ := exists_bounded_return hmin hYc hYne
  exact mem_closure_of_sortInv hmin hYc hM hret hg (sortInv_start hbd)

end Matui
end StepanovMatui
end Full
end GroupApproximation

#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.isClopen_setOf_apply_eq_zpow
#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.mem_closure_thinGenSet
