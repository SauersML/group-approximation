import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiAssembly
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiRoomAlternating
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiGeneration
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.Stepanov
import GroupApproximation.Meta.AxiomGuard

/-!
# Matui's simplicity theorem for derived topological full groups

`simple_kazhdan_sofic_group.tex`, remark at tex l.307–309:

> For derived topological full groups, Matui showed by a similar argument that a nontrivial normal
> subgroup meets a simple union of products of alternating groups on towers
> [Matui, Lemma 3.4 and Theorem 4.9].

Let `T` be a minimal homeomorphism of an infinite compact Hausdorff totally separated space,
`D = ⁅[[T]], [[T]]⁆` the derived topological full group and `A = alternatingFullGroup T`, the
subgroup generated by the three-cycles along `[[T]]` on clopen towers.  This file combines

* `exists_room_of_ne_bot` (`MatuiAssembly`): a nontrivial `N ≤ D` normalized by `D` contains
  `⁅a, b⁆` for `a, b ∈ D` supported in a nonempty clopen set;
* `alternatingFullGroup_le_of_room` (`MatuiRoomAlternating`): such an `N` contains `A`;
* `commutator_fullGroup_le_alternatingFullGroup` (`MatuiGeneration`): `D ≤ A`;
* `isSimpleGroup_of_le`, `commutator_fullGroup_ne_bot` (`MatuiAssembly`),

into the statement of the remark:

* `alternatingFullGroup_le_of_ne_bot`: a nontrivial subgroup of `D` normalized by `D` contains every
  three-cycle on a tower, hence all of `A` (Matui, Lemma 3.4);
* `commutator_fullGroup_eq_alternatingFullGroup`: `D = A`;
* `isSimpleGroup_commutator_fullGroup`: `D` is simple (Matui, Theorem 4.9);
* `isSimpleGroup_derivedFullGroupSubshift`: the same for the infinite minimal subshift of the
  note, with the shift `subshiftHomeo S`;
* `printedMatuiRemark`: the printed remark as a closed statement.
-/

namespace GroupApproximation
namespace Full
namespace StepanovMatui
namespace Matui

open scoped commutatorElement
open SymbolicDynamics.FullShift

variable {X : Type*}

/-- **A nontrivial normal subgroup contains the alternating full group** (tex l.307–309; Matui,
Lemma 3.4): every nontrivial subgroup `N` of the derived full group normalized by it contains
`alternatingFullGroup T`. -/
theorem alternatingFullGroup_le_of_ne_bot [TopologicalSpace X] [CompactSpace X] [T2Space X]
    [TotallySeparatedSpace X] [Infinite X] (T : X ≃ₜ X)
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) {N : Subgroup (Equiv.Perm X)}
    (hND : N ≤ ⁅fullGroup T, fullGroup T⁆) (hne : N ≠ ⊥)
    (hN : ∀ n ∈ N, ∀ g ∈ ⁅fullGroup T, fullGroup T⁆, g * n * g⁻¹ ∈ N) :
    alternatingFullGroup T ≤ N := by
  obtain ⟨V, hV, hVne, hroom⟩ := exists_room_of_ne_bot T hND hne hN
  exact alternatingFullGroup_le_of_room T hmin hN hV hVne hroom

/-- **A nontrivial normal subgroup meets the alternating groups on towers** (tex l.307–309): every
three-cycle along `[[T]]` on a clopen tower lies in `N`. -/
theorem threeCycle_mem_of_ne_bot [TopologicalSpace X] [CompactSpace X] [T2Space X]
    [TotallySeparatedSpace X] [Infinite X] (T : X ≃ₜ X)
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) {N : Subgroup (Equiv.Perm X)}
    (hND : N ≤ ⁅fullGroup T, fullGroup T⁆) (hne : N ≠ ⊥)
    (hN : ∀ n ∈ N, ∀ g ∈ ⁅fullGroup T, fullGroup T⁆, g * n * g⁻¹ ∈ N) {f : Equiv.Perm X}
    (hf : f ∈ fullGroup T) {U : Set X} (hU : IsClopen U) (hdat : IsThreeCycleDatum f U) :
    threeCycle f U ∈ N :=
  alternatingFullGroup_le_of_ne_bot T hmin hND hne hN
    (threeCycle_mem_alternatingFullGroup hf hU hdat)

/-- The derived full group is the alternating full group. -/
theorem commutator_fullGroup_eq_alternatingFullGroup [TopologicalSpace X] [CompactSpace X]
    [T2Space X] [TotallySeparatedSpace X] [Infinite X] (T : X ≃ₜ X)
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) :
    ⁅fullGroup T, fullGroup T⁆ = alternatingFullGroup T :=
  le_antisymm (commutator_fullGroup_le_alternatingFullGroup T hmin)
    (alternatingFullGroup_le_commutator T)

/-- **Matui's theorem** (tex l.307–309; Matui, Theorem 4.9): the derived topological full group of
a minimal homeomorphism of an infinite compact Hausdorff totally separated space is simple. -/
theorem isSimpleGroup_commutator_fullGroup [TopologicalSpace X] [CompactSpace X] [T2Space X]
    [TotallySeparatedSpace X] [Infinite X] (T : X ≃ₜ X)
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) :
    IsSimpleGroup ↥⁅fullGroup T, fullGroup T⁆ :=
  isSimpleGroup_of_le (commutator_fullGroup_le_alternatingFullGroup T hmin)
    (commutator_fullGroup_ne_bot T hmin) fun _ hND hne hN =>
      alternatingFullGroup_le_of_ne_bot T hmin hND hne hN

section Subshift

variable {A : Type} [TopologicalSpace A] [DiscreteTopology A] [Finite A]

/-- The derived topological full group `⁅[[T]], [[T]]⁆` of the shift `T` of a subshift (tex
l.44–46, l.71). -/
def derivedFullGroupSubshift (S : Subshift A ℤ) : Subgroup (Equiv.Perm S.carrier) :=
  haveI := SimpleKazhdanSofic.compactSpace_carrier S
  ⁅fullGroup (SimpleKazhdanSofic.subshiftHomeo S),
    fullGroup (SimpleKazhdanSofic.subshiftHomeo S)⁆

/-- **Matui's theorem for the subshift of the note** (tex l.307–309, with the setting of tex
l.44–46): for an infinite minimal subshift `S` with shift `T`, the derived topological full group
`⁅[[T]], [[T]]⁆` is simple. -/
theorem isSimpleGroup_derivedFullGroupSubshift (S : Subshift A ℤ) (hinf : Infinite S.carrier)
    (hmin : SimpleKazhdanSofic.IsMinimal S) : IsSimpleGroup ↥(derivedFullGroupSubshift S) := by
  haveI := SimpleKazhdanSofic.compactSpace_carrier S
  haveI := hinf
  exact isSimpleGroup_commutator_fullGroup (SimpleKazhdanSofic.subshiftHomeo S)
    (isMinimalSystem_subshiftHomeo S hmin)

end Subshift

/-- **Printed** (tex l.307–309): for a minimal homeomorphism `T` of an infinite compact Hausdorff
totally separated space, every nontrivial subgroup of the derived topological full group
normalized by it contains all three-cycles on clopen towers, and the derived topological full group
is simple. -/
def PrintedMatuiRemark : Prop :=
  ∀ (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] [TotallySeparatedSpace X]
    [Infinite X] (T : X ≃ₜ X), SimpleKazhdanSofic.IsMinimalSystem T →
      (∀ N : Subgroup (Equiv.Perm X), N ≤ ⁅fullGroup T, fullGroup T⁆ → N ≠ ⊥ →
        (∀ n ∈ N, ∀ g ∈ ⁅fullGroup T, fullGroup T⁆, g * n * g⁻¹ ∈ N) →
          ∀ f ∈ fullGroup T, ∀ U : Set X, IsClopen U → IsThreeCycleDatum f U →
            threeCycle f U ∈ N) ∧
        IsSimpleGroup ↥⁅fullGroup T, fullGroup T⁆

theorem printedMatuiRemark : PrintedMatuiRemark := by
  intro X _ _ _ _ _ T hmin
  exact ⟨fun _ hND hne hN _ hf _ hU hdat =>
      threeCycle_mem_of_ne_bot T hmin hND hne hN hf hU hdat,
    isSimpleGroup_commutator_fullGroup T hmin⟩

/-- **Printed** (tex l.307–309, at the subshift of the note): the derived topological full group
of the shift of every infinite minimal subshift is simple. -/
def PrintedMatuiRemarkSubshift : Prop :=
  ∀ (A : Type) [TopologicalSpace A] [DiscreteTopology A] [Finite A] (S : Subshift A ℤ),
    Infinite S.carrier → SimpleKazhdanSofic.IsMinimal S →
      IsSimpleGroup ↥(derivedFullGroupSubshift S)

theorem printedMatuiRemarkSubshift : PrintedMatuiRemarkSubshift :=
  fun _ _ _ _ S hinf hmin => isSimpleGroup_derivedFullGroupSubshift S hinf hmin

end Matui
end StepanovMatui
end Full
end GroupApproximation

#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.alternatingFullGroup_le_of_ne_bot
#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.commutator_fullGroup_eq_alternatingFullGroup
#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.isSimpleGroup_commutator_fullGroup
#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.isSimpleGroup_derivedFullGroupSubshift
#audit_closed_axioms GroupApproximation.Full.StepanovMatui.Matui.printedMatuiRemark
#audit_closed_axioms GroupApproximation.Full.StepanovMatui.Matui.printedMatuiRemarkSubshift
