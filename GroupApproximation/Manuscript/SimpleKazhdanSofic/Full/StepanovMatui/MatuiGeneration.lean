import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiDecomposeInduct
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiRotation
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiThinRoom
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.StepanovMatui.MatuiAssembly
import GroupApproximation.Meta.AxiomGuard

/-!
# The derived full group lies in the alternating full group

`simple_kazhdan_sofic_group.tex`, remark at tex l.307–315 (Matui, Lemma 3.4 and Theorem 4.9).

Let `(X, T)` be a minimal homeomorphism of an infinite compact Hausdorff totally separated space.
Then `⁅[[T]], [[T]]⁆ ≤ A(T)`, where `A(T)` is the subgroup generated by the three-cycles along
`[[T]]` on clopen towers. Take `g, h ∈ [[T]]`. Their cocycles are continuous on a compact space, so
they take finitely many values and are bounded by some `M ≥ 1`. Pick a clopen `Y` wandering up to
`6 M + 8` (`exists_wandering`). By `mem_closure_thinGenSet`, `g` and `h` lie in the subgroup
generated by `S = {T} ∪ {r ∈ [[T]] | r supported in thin T Y M}`. Commutators of generators lie in
`A(T)`: `⁅r, r'⁆` by `commutatorElement_mem_of_supportedIn_thin`, and `⁅T, r⁆` by
`commutatorElement_toEquiv_mem`. `A(T)` is normalized by `[[T]]`, so `commutator_closure_le` gives
`⁅g, h⁆ ∈ A(T)`. This is the Kakutani–Rokhlin argument of Matui (Internat. J. Math. 2006, Lemma
3.4, §4) and Grigorchuk–Medynets (2014, §3), without metrizability.

* `exists_cocycle_bound`: elements of `[[T]]` move points by boundedly many steps of `T`;
* `commutator_fullGroup_le_alternatingFullGroup`: `⁅[[T]], [[T]]⁆ ≤ A(T)`.
-/

namespace GroupApproximation
namespace Full
namespace StepanovMatui
namespace Matui

open scoped commutatorElement

variable {X : Type*} [TopologicalSpace X]

/-- An element of `[[T]]` moves every point by at most `M` steps along its orbit, for some `M`. -/
theorem exists_cocycle_bound [CompactSpace X] [T2Space X] {T : X ≃ₜ X} {g : Equiv.Perm X}
    (hg : g ∈ fullGroup T) :
    ∃ M : ℕ, ∀ x, ∃ k : ℤ, -(M : ℤ) ≤ k ∧ k ≤ M ∧ g x = (T ^ k) x := by
  obtain ⟨n, hn, hgn⟩ := mem_fullGroup.mp hg
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun j : ℤ => n ⁻¹' {j})
    (fun j => (isOpen_discrete {j}).preimage hn) fun x _ =>
      Set.mem_iUnion.mpr ⟨n x, Set.mem_singleton (n x)⟩
  refine ⟨t.sup Int.natAbs, fun x => ?_⟩
  obtain ⟨j, hj, hjx⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
  have hnx : n x = j := hjx
  have hjK : j.natAbs ≤ t.sup Int.natAbs := Finset.le_sup hj
  exact ⟨n x, by omega, by omega, hgn x⟩

theorem cocycle_bound_mono {T : X ≃ₜ X} {g : Equiv.Perm X} {M N : ℕ}
    (h : ∀ x, ∃ k : ℤ, -(M : ℤ) ≤ k ∧ k ≤ M ∧ g x = (T ^ k) x) (hMN : M ≤ N) :
    ∀ x, ∃ k : ℤ, -(N : ℤ) ≤ k ∧ k ≤ N ∧ g x = (T ^ k) x := fun x => by
  obtain ⟨k, hk1, hk2, hk⟩ := h x
  exact ⟨k, by omega, by omega, hk⟩

/-- **The derived full group lies in the alternating full group** (tex l.307–315; Matui 2006,
Lemma 3.4, §4; Grigorchuk–Medynets 2014, §3). -/
theorem commutator_fullGroup_le_alternatingFullGroup [CompactSpace X] [T2Space X]
    [TotallySeparatedSpace X] [Infinite X] (T : X ≃ₜ X)
    (hmin : SimpleKazhdanSofic.IsMinimalSystem T) :
    ⁅fullGroup T, fullGroup T⁆ ≤ alternatingFullGroup T := by
  rw [Subgroup.commutator_le]
  intro g hg h hh
  obtain ⟨Mg, hMg⟩ := exists_cocycle_bound hg
  obtain ⟨Mh, hMh⟩ := exists_cocycle_bound hh
  obtain ⟨M, hgM, hhM, hM⟩ : ∃ M : ℕ, Mg ≤ M ∧ Mh ≤ M ∧ 1 ≤ M :=
    ⟨max (max Mg Mh) 1, by omega, by omega, by omega⟩
  obtain ⟨Y, hYc, hYne, hY⟩ := exists_wandering T hmin (6 * M + 8)
  have hgS := mem_closure_thinGenSet hmin hYc hYne hM hg (cocycle_bound_mono hMg hgM)
  have hhS := mem_closure_thinGenSet hmin hYc hYne hM hh (cocycle_bound_mono hMh hhM)
  refine commutator_closure_le (S := thinGenSet T Y M) (A := alternatingFullGroup T) ?_ ?_
    (Subgroup.commutator_mem_commutator hgS hhS)
  · intro a ha k hk
    exact conj_mem_alternatingFullGroup (closure_thinGenSet_le T Y M hk) ha
  · rintro s (rfl | ⟨hs, hsZ⟩) t (rfl | ⟨ht, htZ⟩)
    · rw [commutatorElement_self]
      exact (alternatingFullGroup T).one_mem
    · exact commutatorElement_toEquiv_mem hYc hY (M := M) (by omega) ht htZ
    · have hc := (alternatingFullGroup T).inv_mem
        (commutatorElement_toEquiv_mem hYc hY (M := M) (by omega) hs hsZ)
      rwa [commutatorElement_inv] at hc
    · exact commutatorElement_mem_of_supportedIn_thin hYc hY (K := M) (by omega) hs ht hsZ htZ

end Matui
end StepanovMatui
end Full
end GroupApproximation

#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.exists_cocycle_bound
#audit_axioms GroupApproximation.Full.StepanovMatui.Matui.commutator_fullGroup_le_alternatingFullGroup
