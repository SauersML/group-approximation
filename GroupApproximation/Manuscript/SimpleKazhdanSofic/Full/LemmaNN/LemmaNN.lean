import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.LemmaNN.Embedding
import GroupApproximation.Meta.AxiomGuard
import Mathlib.Order.Filter.Ultrafilter.Basic
import Mathlib.Data.Countable.Basic
import Mathlib.Data.Fintype.EquivFin

/-!
# `lem:nn`: every countable LEF group lies in `[Δ, Δ]` for an infinite two-generated LEF group `Δ`

`simple_kazhdan_sofic_group.tex`, l.489–492:

> **Lemma** (`lem:nn`). Every countable LEF group is a subgroup of [Δ,Δ] for an infinite LEF group Δ generated by two
> elements.

The proof (l.494–525) is assembled from the steps of the lane files:

* `LevelWords.lean`: `t_k`, `f_jk`, their well-definedness and `[f_jk, t_k]` (l.499–504), the words `w_j`, and the
  arithmetic of differences of powers of `2` (l.510–511);
* `LevelAction.lean`: `a_k`, `b_k`, the conjugation by `b_k^n` (l.509–510), and `w_j(a_k, b_k)` at level `0` (l.510–517);
* `Ultraproduct.lean`: the algebraic ultraproduct, LEF for its subgroups (l.523–524), and `Γ × ℤ` (l.495–496);
* `Embedding.lean`: the models `μ_k` (l.497–499), the injective homomorphism into the ultraproduct sending `γ_j` to
  `w_j(a, b)` (l.517–521), `Δ = ⟨a, b⟩` with `Γ ≤ [Δ, Δ]` (l.521–522), `Δ` LEF and infinite (l.523–525).

Every endpoint below is a closed proposition, audited with `#audit_closed_axioms`.
-/

namespace GroupApproximation.Full.SK09

open Filter
open scoped commutatorElement

/-- **`lem:nn`** (simple_kazhdan_sofic_group.tex l.489–492): every countable LEF group `Γ` is a subgroup of `[Δ, Δ]` for
an infinite LEF group `Δ` generated by two elements `a, b`. The subgroup is recorded by an injective homomorphism
`Γ →* Δ` with values in the commutator subgroup. -/
def LemmaNNStatement : Prop :=
  ∀ (Γ : Type) [Group Γ], Countable Γ → IsLEF Γ →
    ∃ (Δ : Type) (_ : Group Δ), Infinite Δ ∧ IsLEF Δ ∧
      (∃ a b : Δ, Subgroup.closure ({a, b} : Set Δ) = ⊤) ∧
      ∃ f : Γ →* Δ, Function.Injective f ∧ ∀ γ, f γ ∈ commutator Δ

/-- **Proof of `lem:nn`** (simple_kazhdan_sofic_group.tex l.494–525): replace `Γ` by the infinite countable LEF group
`Γ × ℤ`, take the finite models `μ_k`, the ultrafilter `ω` given by a free ultrafilter on `ℕ`, and `Δ = ⟨a, b⟩` in the
algebraic ultraproduct of the symmetric groups of `Q_k × ℤ/m_k × ℤ/4^{k+1}`. -/
theorem lemmaNN : LemmaNNStatement := by
  intro Γ _ hc hΓ
  haveI : Countable Γ := hc
  haveI : Countable (Multiplicative ℤ) := inferInstanceAs (Countable ℤ)
  have hΓ' : IsTextbookLEF (Γ × Multiplicative ℤ) :=
    isTextbookLEF_prod ((isLEF_iff_textbook Γ).1 hΓ) isTextbookLEF_multiplicative_int
  obtain ⟨M⟩ := models_nonempty hΓ'
  have hω : ((hyperfilter ℕ : Ultrafilter ℕ) : Filter ℕ) ≤ cofinite := hyperfilter_le_cofinite
  refine ⟨↥(Delta M (hyperfilter ℕ)), inferInstance, infinite_delta M (hyperfilter ℕ) hω,
    isLEF_delta M (hyperfilter ℕ), ⟨_, _, closure_generators M (hyperfilter ℕ)⟩,
    (embeddingΔ M (hyperfilter ℕ) hω).comp (MonoidHom.inl Γ (Multiplicative ℤ)), ?_,
    fun x => embeddingΔ_mem_commutator M (hyperfilter ℕ) hω (x, 1)⟩
  intro x y h
  have h' : embeddingΔ M (hyperfilter ℕ) hω (x, 1) = embeddingΔ M (hyperfilter ℕ) hω (y, 1) := h
  exact congrArg Prod.fst (embeddingΔ_injective M (hyperfilter ℕ) hω h')

#audit_closed_axioms GroupApproximation.Full.SK09.lemmaNN

/-! ## Audited proof steps -/

/-- **`[f_jk, t_k]` multiplies the first coordinate by `μ_k(γ_j)`** (`lem:nn`, simple_kazhdan_sofic_group.tex
l.499–504), for any finite group `Q` and element `x`, with `f_jk` well defined because the order of `x` divides `|Q|`. -/
def CommutatorFTStatement : Prop :=
  ∀ (Q : Type) [Group Q] [Fintype Q] (x : Q), ⁅fPerm Q x, tPerm Q⁆ = levelwise fun _ => Equiv.mulLeft x

theorem commutatorFT : CommutatorFTStatement := by
  intro Q _ _ x
  exact commutator_fPerm_tPerm Q x

#audit_closed_axioms GroupApproximation.Full.SK09.commutatorFT

/-- **Distinct ordered pairs of distinct powers of `2` have distinct differences** (`lem:nn`,
simple_kazhdan_sofic_group.tex l.510–511). -/
def PowerDifferencesStatement : Prop :=
  ∀ r s r' s' : ℕ, r < s → r' < s' → 2 ^ s - 2 ^ r = 2 ^ s' - 2 ^ r' → r = r' ∧ s = s'

theorem powerDifferences : PowerDifferencesStatement :=
  two_pow_sub_two_pow_inj

#audit_closed_axioms GroupApproximation.Full.SK09.powerDifferences

/-- **`w_j(a_k, b_k)` acts by `[f_jk, t_k]` on the level `0` and trivially on the other levels, for `j ≤ k`** (`lem:nn`,
simple_kazhdan_sofic_group.tex l.504–517), for any finite group `Q_k` and values `g j = μ_k(γ_j)`. -/
def WordAtLevelZeroStatement : Prop :=
  ∀ (Q : Type) [Group Q] [Fintype Q] (k : ℕ) (g : ℕ → Q) (j : ℕ), 1 ≤ j → j ≤ k →
    word j (aPerm Q k g) (bPerm Q k) = levelZeroMul Q k (g j)

theorem wordAtLevelZero : WordAtLevelZeroStatement := by
  intro Q _ _ k g j hj hjk
  exact word_aPerm_bPerm Q k g hj hjk

#audit_closed_axioms GroupApproximation.Full.SK09.wordAtLevelZero

/-- **Finitely many equations and inequalities that hold in the ultraproduct hold in some coordinate, so every subgroup
of an algebraic ultraproduct of finite groups is LEF** (`lem:nn`, simple_kazhdan_sofic_group.tex l.523–524). -/
def UltraproductLEFStatement : Prop :=
  ∀ (G : ℕ → Type) [∀ i, Group (G i)] [∀ i, Finite (G i)] (ω : Ultrafilter ℕ)
    (H : Subgroup (Ultraproduct ω G)), IsLEF H

theorem ultraproductLEF : UltraproductLEFStatement := by
  intro G _ _ ω H
  exact isLEF_subgroup_ultraproduct ω G H

#audit_closed_axioms GroupApproximation.Full.SK09.ultraproductLEF

end GroupApproximation.Full.SK09
