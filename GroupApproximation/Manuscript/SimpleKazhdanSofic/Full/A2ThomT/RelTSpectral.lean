import GroupApproximation.PropertyT.IntegralColumnPlaneSpectralShear

/-!
# Relative property (T): the spectral layer for an abstract abelian plane

`simple_kazhdan_sofic_group.tex`, Introduction, tex l.57–59 (table row A2): Thom's Kazhdan group
uses property (T) of `SL_3(F_p[t,t⁻¹])` together with relative property (T) of
`(F_p[t,t⁻¹]^3 ⋊ SL_3, F_p[t,t⁻¹]^3)` (A. Thom, Groups Geom. Dyn. 4 (2010), §2.1, Lemma 2.1).
The relative statement is proved by Burger's spectral argument (Burger 1991; Shalom 1999;
Kassabov 2007, §2), run on the Gelfand spectrum of an abelian plane.

This file is the group-agnostic part.  A `RelTPlane G V` is an additive family
`vec : V → G`.  For an orthogonal representation and a unit vector we form the commutative
C*-algebra generated by the represented plane, its spectral measure, and for every element
normalizing the plane the dual measurable action on characters.  The main outputs are

* `RelTPlane.dual_coordinate`: the dual action pulls evaluation at `vec x` back to evaluation
  at the conjugate `vec y`;
* `RelTPlane.sqrt_measureReal_le_of_mapsTo`: Kassabov's transport inequality
  `√μ S ≤ √μ T + δ` whenever the dual action maps `S` into `T` and the element moves the vector
  by at most `δ`;
* `RelTPlane.displacement_sq_le`: the squared displacement by `vec x` is at most four times the
  mass of any measurable set containing the characters nontrivial at `vec x`.
-/

namespace GroupApproximation.Full.A2ThomT

open WeakDual MeasureTheory
open RepresentedRootPlaneSpectralMeasure

noncomputable section

universe u w v

/-- An abelian plane in a group: an additive map from an additive group into the group. -/
structure RelTPlane (G : Type u) [Group G] (V : Type w) [AddCommGroup V] where
  /-- The plane element attached to a vector. -/
  vec : V → G
  vec_add : ∀ x y : V, vec (x + y) = vec x * vec y

namespace RelTPlane

variable {G : Type u} [Group G] {V : Type w} [AddCommGroup V] (Q : RelTPlane G V)

theorem vec_zero : Q.vec 0 = 1 := by
  have h := Q.vec_add 0 0
  rw [add_zero] at h
  calc Q.vec 0 = Q.vec 0 * Q.vec 0 * (Q.vec 0)⁻¹ := (mul_inv_cancel_right _ _).symm
    _ = Q.vec 0 * (Q.vec 0)⁻¹ := by rw [← h]
    _ = 1 := mul_inv_cancel _

theorem vec_commute (x y : V) : Commute (Q.vec x) (Q.vec y) := by
  show Q.vec x * Q.vec y = Q.vec y * Q.vec x
  rw [← Q.vec_add, ← Q.vec_add, add_comm]

/-- The elements of the group conjugating the plane into itself. -/
def Normalizes (g : G) : Prop :=
  ∀ x : V, ∃ y : V, g * Q.vec x * g⁻¹ = Q.vec y

variable {E : Type v} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- The represented abelian plane in the complexification of an orthogonal representation. -/
def represented (rho : G →* (E ≃ₗᵢ[ℝ] E)) :
    RepresentedAbelianPlane G V (Complexification E) where
  rho := RealToComplexUnitaryRepresentation.complexifiedUnitaryRepresentation rho
  root := Q.vec
  root_commute := Q.vec_commute

noncomputable local instance relTPlaneCharacterMeasurableSpace (rho : G →* (E ≃ₗᵢ[ℝ] E)) :
    MeasurableSpace (characterSpace ℂ (Q.represented rho).algebra) :=
  borel _

local instance relTPlaneCharacterBorelSpace (rho : G →* (E ≃ₗᵢ[ℝ] E)) :
    BorelSpace (characterSpace ℂ (Q.represented rho).algebra) :=
  ⟨rfl⟩

/-- The spectral measure of the plane at a unit real vector. -/
def specMeasure (rho : G →* (E ≃ₗᵢ[ℝ] E)) (z : E) (hz : ‖z‖ = 1) :
    Measure (characterSpace ℂ (Q.represented rho).algebra) :=
  CommutativeStateSpectralMeasure.stateSpectralMeasure
    ((Q.represented rho).vectorState (Complexification.mk z 0)
      (IntegralColumnPlaneSpectralMeasure.norm_mk_zero_eq_one hz))

noncomputable local instance relTPlaneSpecMeasureIsFinite (rho : G →* (E ≃ₗᵢ[ℝ] E))
    (z : E) (hz : ‖z‖ = 1) : IsFiniteMeasure (Q.specMeasure rho z hz) := by
  unfold RelTPlane.specMeasure
  infer_instance

variable (rho : G →* (E ≃ₗᵢ[ℝ] E))

/-! ### Coordinates and characters -/

theorem coordinate_add (x y : V) :
    (Q.represented rho).coordinate (x + y) =
      (Q.represented rho).coordinate x * (Q.represented rho).coordinate y := by
  apply Subtype.ext
  have hu : (Q.represented rho).rho (Q.vec (x + y)) =
      (Q.represented rho).rho (Q.vec x) * (Q.represented rho).rho (Q.vec y) := by
    rw [Q.vec_add, map_mul]
  exact congrArg (fun u : unitary (Complexification E →L[ℂ] Complexification E) ↦
    (u : Complexification E →L[ℂ] Complexification E)) hu

theorem coordinate_zero : (Q.represented rho).coordinate 0 = 1 := by
  apply Subtype.ext
  have hu : (Q.represented rho).rho (Q.vec 0) = 1 := by
    rw [Q.vec_zero, map_one]
  exact congrArg (fun u : unitary (Complexification E →L[ℂ] Complexification E) ↦
    (u : Complexification E →L[ℂ] Complexification E)) hu

theorem chi_coordinate_add (chi : characterSpace ℂ (Q.represented rho).algebra) (x y : V) :
    chi ((Q.represented rho).coordinate (x + y)) =
      chi ((Q.represented rho).coordinate x) * chi ((Q.represented rho).coordinate y) := by
  rw [Q.coordinate_add rho, map_mul]

theorem chi_coordinate_zero (chi : characterSpace ℂ (Q.represented rho).algebra) :
    chi ((Q.represented rho).coordinate 0) = 1 := by
  rw [Q.coordinate_zero rho, map_one]

theorem norm_chi_coordinate (chi : characterSpace ℂ (Q.represented rho).algebra) (x : V) :
    ‖chi ((Q.represented rho).coordinate x)‖ = 1 := by
  have hunit : star ((Q.represented rho).coordinate x) * (Q.represented rho).coordinate x = 1 := by
    apply Subtype.ext
    change star (((Q.represented rho).rho (Q.vec x) :
        unitary (Complexification E →L[ℂ] Complexification E)) :
          Complexification E →L[ℂ] Complexification E) *
        ((Q.represented rho).rho (Q.vec x) :
          unitary (Complexification E →L[ℂ] Complexification E)) = 1
    exact ((Q.represented rho).rho (Q.vec x)).property.1
  have hmapped := congrArg (fun a : (Q.represented rho).algebra ↦ chi a) hunit
  rw [map_mul, map_star, map_one] at hmapped
  have hnorm := congrArg norm hmapped
  rw [norm_mul, norm_star, norm_one] at hnorm
  nlinarith [norm_nonneg (chi ((Q.represented rho).coordinate x))]

theorem continuous_chi_coordinate (x : V) :
    Continuous (fun chi : characterSpace ℂ (Q.represented rho).algebra ↦
      chi ((Q.represented rho).coordinate x)) :=
  ((gelfandStarTransform (Q.represented rho).algebra)
    ((Q.represented rho).coordinate x)).continuous

theorem measurableSet_chi_coordinate_eq_one (x : V) :
    MeasurableSet {chi : characterSpace ℂ (Q.represented rho).algebra |
      chi ((Q.represented rho).coordinate x) = 1} :=
  (isClosed_eq (Q.continuous_chi_coordinate rho x) continuous_const).measurableSet

theorem measurableSet_chi_coordinate_ne_one (x : V) :
    MeasurableSet {chi : characterSpace ℂ (Q.represented rho).algebra |
      chi ((Q.represented rho).coordinate x) ≠ 1} :=
  (isOpen_ne_fun (Q.continuous_chi_coordinate rho x) continuous_const).measurableSet

/-! ### The dual action of a normalizing element -/

theorem forward (g : G) (hg : Q.Normalizes g) :
    ∀ x : (Q.represented rho).algebra,
      Unitary.conjStarAlgAut ℂ (Complexification E →L[ℂ] Complexification E)
        ((Q.represented rho).rho g) x.1 ∈ (Q.represented rho).algebra := by
  apply IntegralColumnPlaneSpectralShear.conj_mem_algebra_of_generators_mem
  intro i
  obtain ⟨j, hj⟩ := hg i
  change Unitary.conjStarAlgAut ℂ (Complexification E →L[ℂ] Complexification E)
      ((Q.represented rho).rho g)
      ((Q.represented rho).rho (Q.vec i) :
        Complexification E →L[ℂ] Complexification E) ∈ (Q.represented rho).algebra
  rw [CommutativeCStarCovariance.conjStarAlgAut_representation_apply, hj]
  exact ((Q.represented rho).coordinate j).property

theorem star_rho (g : G) :
    star ((Q.represented rho).rho g) = (Q.represented rho).rho g⁻¹ := by
  rw [Unitary.star_eq_inv, ← map_inv]

theorem backward (g : G) (hg : Q.Normalizes g⁻¹) :
    ∀ x : (Q.represented rho).algebra,
      (Unitary.conjStarAlgAut ℂ (Complexification E →L[ℂ] Complexification E)
        ((Q.represented rho).rho g)).symm x.1 ∈ (Q.represented rho).algebra := by
  rw [Unitary.conjStarAlgAut_symm, Q.star_rho rho g]
  exact Q.forward rho g⁻¹ hg

/-- The dual action of a normalizing element on the characters of the plane algebra. -/
def dual (g : G) (hg : Q.Normalizes g) (hg' : Q.Normalizes g⁻¹) :
    characterSpace ℂ (Q.represented rho).algebra ≃ᵐ
      characterSpace ℂ (Q.represented rho).algebra :=
  (CommutativeCStarCovariance.characterHomeomorph (Q.represented rho).algebra
    ((Q.represented rho).rho g) (Q.forward rho g hg) (Q.backward rho g hg')).toMeasurableEquiv

/-- If `g · vec x · g⁻¹ = vec y`, the dual action evaluates at `vec x` as the original character
evaluates at `vec y`. -/
theorem dual_coordinate (g : G) (hg : Q.Normalizes g) (hg' : Q.Normalizes g⁻¹) (x y : V)
    (hxy : g * Q.vec x * g⁻¹ = Q.vec y)
    (chi : characterSpace ℂ (Q.represented rho).algebra) :
    Q.dual rho g hg hg' chi ((Q.represented rho).coordinate x) =
      chi ((Q.represented rho).coordinate y) := by
  show chi (CommutativeCStarCovariance.restrictConjStarAlgEquiv (Q.represented rho).algebra
      ((Q.represented rho).rho g) (Q.forward rho g hg) (Q.backward rho g hg')
      ((Q.represented rho).coordinate x)) = chi ((Q.represented rho).coordinate y)
  refine congrArg (fun t : (Q.represented rho).algebra ↦ chi t) ?_
  apply Subtype.ext
  rw [CommutativeCStarCovariance.restrictConjStarAlgEquiv_coe]
  change Unitary.conjStarAlgAut ℂ (Complexification E →L[ℂ] Complexification E)
      ((Q.represented rho).rho g)
      ((Q.represented rho).rho (Q.vec x) : Complexification E →L[ℂ] Complexification E) =
    ((Q.represented rho).rho (Q.vec y) : Complexification E →L[ℂ] Complexification E)
  rw [CommutativeCStarCovariance.conjStarAlgAut_representation_apply, hxy]

/-- The inverse of the dual action of `g` is the dual action of `g⁻¹`. -/
theorem dual_symm_apply (g : G) (hg : Q.Normalizes g) (hg' : Q.Normalizes g⁻¹)
    (hg'' : Q.Normalizes g⁻¹⁻¹) (chi : characterSpace ℂ (Q.represented rho).algebra) :
    (Q.dual rho g hg hg').symm chi = Q.dual rho g⁻¹ hg' hg'' chi := by
  have hstar := Q.star_rho rho g
  apply CharacterSpace.ext
  intro y
  show chi ((CommutativeCStarCovariance.restrictConjStarAlgEquiv (Q.represented rho).algebra
      ((Q.represented rho).rho g) (Q.forward rho g hg) (Q.backward rho g hg')).symm y) =
    chi (CommutativeCStarCovariance.restrictConjStarAlgEquiv (Q.represented rho).algebra
      ((Q.represented rho).rho g⁻¹) (Q.forward rho g⁻¹ hg') (Q.backward rho g⁻¹ hg'') y)
  refine congrArg (fun t : (Q.represented rho).algebra ↦ chi t) ?_
  apply Subtype.ext
  rw [CommutativeCStarCovariance.restrictConjStarAlgEquiv_symm_coe,
    CommutativeCStarCovariance.restrictConjStarAlgEquiv_coe,
    Unitary.conjStarAlgAut_symm, hstar]

/-- Kassabov's quadratic quasi-invariance of the spectral measure under the dual action. -/
theorem dual_quasiInvariant (z : E) (hz : ‖z‖ = 1) (g : G) (hg : Q.Normalizes g)
    (hg' : Q.Normalizes g⁻¹) {delta : ℝ} (hdelta : 0 ≤ delta)
    (hmove : ‖rho g z - z‖ ≤ delta) :
    KassabovBorelMeasureInequalities.MeasurableQuasiInvariantAtScale
      (Q.specMeasure rho z hz) delta (Q.dual rho g hg hg') := by
  apply RepresentedRootPlaneSpectralQuasiInvariant.measurableQuasiInvariantAtScale_characterHomeomorph
    (Q.represented rho) (Complexification.mk z 0)
    (IntegralColumnPlaneSpectralMeasure.norm_mk_zero_eq_one hz)
    ((Q.represented rho).rho g) (Q.forward rho g hg) (Q.backward rho g hg') hdelta
  change ‖RealToComplexUnitaryRepresentation.complexifiedOperatorRepresentation
      rho g (Complexification.mk z 0) - Complexification.mk z 0‖ ≤ delta
  rw [RealToComplexUnitaryRepresentation.norm_complexified_displacement_mk_zero]
  exact hmove

/-- **Transport inequality.**  If the dual action of a normalizing element maps `S` into `T` and
the element moves the unit vector by at most `delta`, then `√μ S ≤ √μ T + delta`. -/
theorem sqrt_measureReal_le_of_mapsTo (z : E) (hz : ‖z‖ = 1) (g : G) (hg : Q.Normalizes g)
    (hg' : Q.Normalizes g⁻¹) {delta : ℝ} (hdelta : 0 ≤ delta)
    (hmove : ‖rho g z - z‖ ≤ delta)
    {S T : Set (characterSpace ℂ (Q.represented rho).algebra)} (hS : MeasurableSet S)
    (hmaps : Set.MapsTo (Q.dual rho g hg hg') S T) :
    Real.sqrt ((Q.specMeasure rho z hz).real S) ≤
      Real.sqrt ((Q.specMeasure rho z hz).real T) + delta := by
  have hg'' : Q.Normalizes g⁻¹⁻¹ := by
    rw [inv_inv]
    exact hg
  have hq := Q.dual_quasiInvariant rho z hz g hg hg' hdelta hmove
  have hmove' : ‖rho g⁻¹ z - z‖ ≤ delta := by
    rw [IntegralCharacterMass.norm_inv_displacement]
    exact hmove
  have hqinv := Q.dual_quasiInvariant rho z hz g⁻¹ hg' hg'' hdelta hmove'
  have hginv : KassabovBorelMeasureInequalities.MeasurableQuasiInvariantAtScale
      (Q.specMeasure rho z hz) delta (Q.dual rho g hg hg').toEquiv.symm := by
    intro A hA himage
    have hfun : ∀ chi, (Q.dual rho g hg hg').toEquiv.symm chi =
        Q.dual rho g⁻¹ hg' hg'' chi :=
      fun chi ↦ Q.dual_symm_apply rho g hg hg' hg'' chi
    have hset : (Q.dual rho g hg hg').toEquiv.symm '' A = (Q.dual rho g⁻¹ hg' hg'') '' A :=
      Set.image_congr' hfun
    rw [hset]
    rw [hset] at himage
    exact hqinv A hA himage
  have himage : MeasurableSet ((Q.dual rho g hg hg').toEquiv '' S) :=
    (MeasurableEquiv.measurableSet_image (Q.dual rho g hg hg')).mpr hS
  have hkey := KassabovBorelMeasureInequalities.abs_sqrt_measureReal_image_sub_le
    (Q.specMeasure rho z hz) hdelta (Q.dual rho g hg hg').toEquiv hq hginv S hS himage
  have hsubset : (Q.dual rho g hg hg').toEquiv '' S ⊆ T := by
    rintro y ⟨x, hx, rfl⟩
    exact hmaps hx
  have hmono : (Q.specMeasure rho z hz).real ((Q.dual rho g hg hg').toEquiv '' S) ≤
      (Q.specMeasure rho z hz).real T :=
    measureReal_mono hsubset
  have hsqrt := Real.sqrt_le_sqrt hmono
  have hlower := neg_le_of_abs_le hkey
  linarith

/-! ### Displacement and mass -/

/-- The spectral identity: squared character displacement integrates to squared displacement. -/
theorem integral_displacement_sq (z : E) (hz : ‖z‖ = 1) (x : V) :
    ∫ chi, ‖chi ((Q.represented rho).coordinate x) - 1‖ ^ 2 ∂(Q.specMeasure rho z hz) =
      ‖rho (Q.vec x) z - z‖ ^ 2 := by
  have hspectral :=
    RepresentedRootPlaneSpectralMeasure.integral_coordinate_displacement_sq
      (Q.represented rho) (Complexification.mk z 0)
      (IntegralColumnPlaneSpectralMeasure.norm_mk_zero_eq_one hz) x
  unfold RelTPlane.specMeasure
  rw [hspectral]
  exact congrArg (fun t : ℝ ↦ t ^ 2)
    (RealToComplexUnitaryRepresentation.norm_complexified_displacement_mk_zero rho (Q.vec x) z)

/-- The squared displacement by `vec x` is at most four times the mass of a measurable set
containing every character that is nontrivial at `vec x`. -/
theorem displacement_sq_le (z : E) (hz : ‖z‖ = 1) (x : V)
    (S : Set (characterSpace ℂ (Q.represented rho).algebra)) (hS : MeasurableSet S)
    (hsub : ∀ chi : characterSpace ℂ (Q.represented rho).algebra,
      chi ((Q.represented rho).coordinate x) ≠ 1 → chi ∈ S) :
    ‖rho (Q.vec x) z - z‖ ^ 2 ≤ 4 * (Q.specMeasure rho z hz).real S := by
  have hcont : Continuous (fun chi : characterSpace ℂ (Q.represented rho).algebra ↦
      ‖chi ((Q.represented rho).coordinate x) - 1‖ ^ 2) :=
    (((Q.continuous_chi_coordinate rho x).sub continuous_const).norm).pow 2
  have hint1 : Integrable (fun chi : characterSpace ℂ (Q.represented rho).algebra ↦
      ‖chi ((Q.represented rho).coordinate x) - 1‖ ^ 2) (Q.specMeasure rho z hz) :=
    hcont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hint2 : Integrable (S.indicator fun _ ↦ (4 : ℝ)) (Q.specMeasure rho z hz) :=
    (integrable_const (4 : ℝ)).indicator hS
  have hpoint : ∀ chi : characterSpace ℂ (Q.represented rho).algebra,
      ‖chi ((Q.represented rho).coordinate x) - 1‖ ^ 2 ≤ S.indicator (fun _ ↦ (4 : ℝ)) chi := by
    intro chi
    by_cases hchi : chi ∈ S
    · rw [Set.indicator_of_mem hchi]
      have hnorm := Q.norm_chi_coordinate rho chi x
      have hle : ‖chi ((Q.represented rho).coordinate x) - 1‖ ≤ 2 := by
        calc ‖chi ((Q.represented rho).coordinate x) - 1‖ ≤
            ‖chi ((Q.represented rho).coordinate x)‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
          _ = 2 := by rw [hnorm, norm_one]; norm_num
      nlinarith [norm_nonneg (chi ((Q.represented rho).coordinate x) - 1)]
    · rw [Set.indicator_of_notMem hchi]
      have hone : chi ((Q.represented rho).coordinate x) = 1 := by
        by_contra hne
        exact hchi (hsub chi hne)
      rw [hone, sub_self, norm_zero]
      norm_num
  have hmono := integral_mono hint1 hint2 hpoint
  rw [integral_indicator_const (4 : ℝ) hS, smul_eq_mul, mul_comm] at hmono
  rw [← Q.integral_displacement_sq rho z hz x]
  exact hmono

end RelTPlane

end

end GroupApproximation.Full.A2ThomT
