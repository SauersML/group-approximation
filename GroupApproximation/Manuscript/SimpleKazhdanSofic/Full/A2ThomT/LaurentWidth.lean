import Mathlib.Algebra.Polynomial.Laurent
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.Order.Lattice.Nat
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.A2ThomT.SL3Euclid

/-!
# A Euclidean size function on Laurent polynomials over a field

`simple_kazhdan_sofic_group.tex`, Introduction, tex l.57–59 (table row A2): Thom's group
`G_0(F_p[t,t⁻¹])` (A. Thom, Groups Geom. Dyn. 4 (2010), §2.1, Lemma 2.1). Its property (T) uses
`SL_3(F_p[t,t⁻¹]) = E_3`. Mathlib has no `EuclideanDomain` instance on `LaurentPolynomial`, so
this file builds the size function used by `SL3Euclid`.

* `laurentWidth f`: the least `natDegree p + 1` over polynomials `p ≠ 0` with `p = f·T^m`.
* `eq_zero_of_laurentWidth_eq_zero`, `laurentWidth_exists_quot`: the two Euclidean axioms.
* `laurentEuclidSize K : EuclidSize (LaurentPolynomial K)`.
* `mem_slElementary_three_laurent`: `SL_3(K[t,t⁻¹])` is generated by transvections.
-/

namespace GroupApproximation.Full.A2ThomT

variable {K : Type*} [Field K]

/-- The possible widths of `f`: `natDegree p + 1` for nonzero polynomials `p = f·T^m`. -/
def laurentWidthSet (f : LaurentPolynomial K) : Set ℕ :=
  {d | ∃ (p : Polynomial K) (m : ℤ), p ≠ 0 ∧ p.natDegree + 1 = d ∧
    Polynomial.toLaurent p = f * LaurentPolynomial.T m}

/-- The width of a Laurent polynomial: the least `natDegree p + 1` over nonzero polynomials `p`
with `p = f·T^m` (and `0` for `f = 0`). -/
noncomputable def laurentWidth (f : LaurentPolynomial K) : ℕ :=
  sInf (laurentWidthSet f)

theorem T_mul_T_neg (n : ℤ) :
    (LaurentPolynomial.T n : LaurentPolynomial K) * LaurentPolynomial.T (-n) = 1 := by
  rw [← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero]

/-- If `f·T^n = 0` then `f = 0`. -/
theorem eq_zero_of_mul_T_eq_zero {f : LaurentPolynomial K} {n : ℤ}
    (h : f * LaurentPolynomial.T n = 0) : f = 0 := by
  calc f = f * (LaurentPolynomial.T n * LaurentPolynomial.T (-n)) := by
        rw [T_mul_T_neg, mul_one]
    _ = f * LaurentPolynomial.T n * LaurentPolynomial.T (-n) := by rw [mul_assoc]
    _ = 0 := by rw [h, zero_mul]

theorem laurentWidthSet_nonempty {f : LaurentPolynomial K} (hf : f ≠ 0) :
    (laurentWidthSet f).Nonempty := by
  obtain ⟨n, f', hf'⟩ := LaurentPolynomial.exists_T_pow f
  refine ⟨f'.natDegree + 1, f', n, ?_, rfl, hf'⟩
  intro h0
  apply hf
  rw [h0, map_zero] at hf'
  exact eq_zero_of_mul_T_eq_zero hf'.symm

theorem laurentWidth_zero : laurentWidth (0 : LaurentPolynomial K) = 0 := by
  have hempty : laurentWidthSet (0 : LaurentPolynomial K) = ∅ := by
    refine Set.eq_empty_of_forall_notMem fun _ hd ↦ ?_
    obtain ⟨p, _, hp, _, hpeq⟩ := hd
    rw [zero_mul] at hpeq
    exact hp (Polynomial.toLaurent_eq_zero.mp hpeq)
  show sInf (laurentWidthSet (0 : LaurentPolynomial K)) = 0
  rw [hempty]
  exact Nat.sInf_empty

theorem eq_zero_of_laurentWidth_eq_zero (f : LaurentPolynomial K) (h : laurentWidth f = 0) :
    f = 0 := by
  by_contra hf
  obtain ⟨_, _, _, hdeg, _⟩ := Nat.sInf_mem (laurentWidthSet_nonempty hf)
  have h' : sInf (laurentWidthSet f) = 0 := h
  omega

/-- **Division with smaller remainder for `laurentWidth`.** -/
theorem laurentWidth_exists_quot (a b : LaurentPolynomial K) (hb : b ≠ 0) :
    ∃ q : LaurentPolynomial K, laurentWidth (a - q * b) < laurentWidth b := by
  obtain ⟨pb, mb, hpb, hdeg, hpbeq⟩ := Nat.sInf_mem (laurentWidthSet_nonempty hb)
  have hw : laurentWidth b = pb.natDegree + 1 := hdeg.symm
  by_cases hd0 : pb.natDegree = 0
  · obtain ⟨c, hc_eq⟩ : ∃ c : K, pb.coeff 0 = c := ⟨_, rfl⟩
    have hpbC : pb = Polynomial.C c := by
      rw [← hc_eq]; exact Polynomial.eq_C_of_natDegree_eq_zero hd0
    have hc : c ≠ 0 := by
      intro h0
      apply hpb
      rw [hpbC, h0, map_zero]
    have hbT : b * LaurentPolynomial.T mb = LaurentPolynomial.C c := by
      rw [← hpbeq, hpbC]
      exact Polynomial.toLaurent_C c
    have hcc : LaurentPolynomial.C c * LaurentPolynomial.C c⁻¹ = (1 : LaurentPolynomial K) := by
      rw [← map_mul, mul_inv_cancel₀ hc, map_one]
    refine ⟨a * LaurentPolynomial.T mb * LaurentPolynomial.C c⁻¹, ?_⟩
    have hzero : a - a * LaurentPolynomial.T mb * LaurentPolynomial.C c⁻¹ * b = 0 := by
      calc a - a * LaurentPolynomial.T mb * LaurentPolynomial.C c⁻¹ * b
          = a - a * ((b * LaurentPolynomial.T mb) * LaurentPolynomial.C c⁻¹) := by ring
        _ = 0 := by rw [hbT, hcc, mul_one, sub_self]
    rw [hzero, laurentWidth_zero, hw]
    exact Nat.succ_pos _
  · obtain ⟨n, pa, hpa⟩ := LaurentPolynomial.exists_T_pow a
    obtain ⟨q, hq⟩ : ∃ q : LaurentPolynomial K,
        q = LaurentPolynomial.T mb * Polynomial.toLaurent (pa / pb) *
          LaurentPolynomial.T (-(n : ℤ)) := ⟨_, rfl⟩
    refine ⟨q, ?_⟩
    have e2 : Polynomial.toLaurent pa =
        Polynomial.toLaurent pb * Polynomial.toLaurent (pa / pb) +
          Polynomial.toLaurent (pa % pb) := by
      rw [← map_mul, ← map_add, EuclideanDomain.div_add_mod]
    have hTT : (LaurentPolynomial.T (-(n : ℤ)) : LaurentPolynomial K) *
        LaurentPolynomial.T (n : ℤ) = 1 := by
      rw [← LaurentPolynomial.T_add, neg_add_cancel, LaurentPolynomial.T_zero]
    have e3 : (a - q * b) * LaurentPolynomial.T (n : ℤ) =
        a * LaurentPolynomial.T (n : ℤ) - (b * LaurentPolynomial.T mb) *
          Polynomial.toLaurent (pa / pb) *
            (LaurentPolynomial.T (-(n : ℤ)) * LaurentPolynomial.T (n : ℤ)) := by
      rw [hq]; ring
    have hr : Polynomial.toLaurent (pa % pb) = (a - q * b) * LaurentPolynomial.T (n : ℤ) := by
      rw [e3, hTT, mul_one, ← hpa, ← hpbeq, e2]
      ring
    by_cases hr0 : pa % pb = 0
    · rw [hr0, map_zero] at hr
      have hz : a - q * b = 0 := eq_zero_of_mul_T_eq_zero hr.symm
      rw [hz, laurentWidth_zero, hw]
      exact Nat.succ_pos _
    · have hle : laurentWidth (a - q * b) ≤ (pa % pb).natDegree + 1 :=
        Nat.sInf_le ⟨pa % pb, (n : ℤ), hr0, rfl, hr⟩
      have hlt : (pa % pb).natDegree < pb.natDegree := Polynomial.natDegree_mod_lt pa hd0
      rw [hw]
      omega

variable (K) in
/-- `laurentWidth` is a Euclidean size function on `K[t,t⁻¹]`. -/
noncomputable def laurentEuclidSize : EuclidSize (LaurentPolynomial K) where
  size := laurentWidth
  eq_zero_of_size_eq_zero := eq_zero_of_laurentWidth_eq_zero
  exists_quot := laurentWidth_exists_quot

/-- **`SL_3(K[t,t⁻¹]) = E_3`**: over a field `K`, every element of `SL(3, K[t,t⁻¹])` is a
product of transvections (Thom, GGD 4 (2010), §2.1, Lemma 2.1, for `K = F_p`;
`simple_kazhdan_sofic_group.tex` l.57–59). -/
theorem mem_slElementary_three_laurent
    (g : Matrix.SpecialLinearGroup (Fin 3) (LaurentPolynomial K)) :
    g ∈ slElementary (Fin 3) (LaurentPolynomial K) :=
  mem_slElementary_three (laurentEuclidSize K) g

#audit_axioms mem_slElementary_three_laurent

end GroupApproximation.Full.A2ThomT
