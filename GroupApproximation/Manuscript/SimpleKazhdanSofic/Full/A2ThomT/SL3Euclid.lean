import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.LinearAlgebra.Matrix.Transvection
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring
import GroupApproximation.Meta.AxiomGuard

/-!
# `SL_3` over a ring with a Euclidean size function is generated by transvections

`simple_kazhdan_sofic_group.tex`, Introduction, tex l.57–59 (table row A2): "Thom constructed a
finitely generated Kazhdan group ...". Thom's argument (A. Thom, Groups Geom. Dyn. 4 (2010), §2.1,
Lemma 2.1) uses property (T) of `SL_3(F_p[t,t⁻¹])`, which needs `SL_3(F_p[t,t⁻¹]) = E_3`. This
file proves the Euclidean-reduction part over an arbitrary commutative ring with a size function
(`EuclidSize`), so no `EuclideanDomain` instance is needed.

* `slTrans i k h c`: the transvection `1 + c·E_{ik}` as an element of `SL(n, R)`.
* `slElementary n R`: the subgroup of `SL(n, R)` generated by all `slTrans`.
* `EuclidSize R`: a size `R → ℕ` with `size b = 0 → b = 0` and division with smaller
  remainder.
* `pair_reduce`, `unit_normalize`: row reduction of one column along a pair of rows.
* `mem_slElementary_three`: every element of `SL(3, R)` is a product of transvections.
-/

namespace GroupApproximation.Full.A2ThomT

section General

variable {n : Type*} [Fintype n] [DecidableEq n] {R : Type*} [CommRing R]

/-- The transvection `1 + c·E_{ik}` (for `i ≠ k`) as an element of `SL(n, R)`. -/
def slTrans (i k : n) (h : i ≠ k) (c : R) : Matrix.SpecialLinearGroup n R :=
  ⟨Matrix.transvection i k c, Matrix.det_transvection_of_ne i k h c⟩

variable (n R) in
/-- The elementary subgroup of `SL(n, R)`: the subgroup generated by all transvections. -/
def slElementary : Subgroup (Matrix.SpecialLinearGroup n R) :=
  Subgroup.closure {g | ∃ (i k : n) (h : i ≠ k) (c : R), slTrans i k h c = g}

theorem slTrans_mem (i k : n) (h : i ≠ k) (c : R) : slTrans i k h c ∈ slElementary n R :=
  Subgroup.subset_closure ⟨i, k, h, c, rfl⟩

theorem slTrans_mul_mem_iff (i k : n) (h : i ≠ k) (c : R) (g : Matrix.SpecialLinearGroup n R) :
    slTrans i k h c * g ∈ slElementary n R ↔ g ∈ slElementary n R :=
  (slElementary n R).mul_mem_cancel_left (slTrans_mem i k h c)

theorem mul_slTrans_mem_iff (i k : n) (h : i ≠ k) (c : R) (g : Matrix.SpecialLinearGroup n R) :
    g * slTrans i k h c ∈ slElementary n R ↔ g ∈ slElementary n R :=
  (slElementary n R).mul_mem_cancel_right (slTrans_mem i k h c)

/-- Left multiplication by `slTrans i k h c` adds `c` times row `k` to row `i`. -/
theorem slTrans_mul_apply_same (i k : n) (h : i ≠ k) (c : R) (g : Matrix.SpecialLinearGroup n R)
    (b : n) : (slTrans i k h c * g).1 i b = g.1 i b + c * g.1 k b :=
  Matrix.transvection_mul_apply_same i k b c g.1

/-- Left multiplication by `slTrans i k h c` leaves the rows other than `i` unchanged. -/
theorem slTrans_mul_apply_of_ne (i k : n) (h : i ≠ k) (c : R) (g : Matrix.SpecialLinearGroup n R)
    (a b : n) (ha : a ≠ i) : (slTrans i k h c * g).1 a b = g.1 a b :=
  Matrix.transvection_mul_apply_of_ne i k a b ha c g.1

/-- Right multiplication by `slTrans i k h c` adds `c` times column `i` to column `k`. -/
theorem mul_slTrans_apply_same (i k : n) (h : i ≠ k) (c : R) (g : Matrix.SpecialLinearGroup n R)
    (a : n) : (g * slTrans i k h c).1 a k = g.1 a k + c * g.1 a i :=
  Matrix.mul_transvection_apply_same i k a c g.1

/-- Right multiplication by `slTrans i k h c` leaves the columns other than `k` unchanged. -/
theorem mul_slTrans_apply_of_ne (i k : n) (h : i ≠ k) (c : R) (g : Matrix.SpecialLinearGroup n R)
    (a b : n) (hb : b ≠ k) : (g * slTrans i k h c).1 a b = g.1 a b :=
  Matrix.mul_transvection_apply_of_ne i k a b hb c g.1

end General

/-- A Euclidean size function on a commutative ring: only `0` has size `0`, and every `a` can be
divided by a nonzero `b` with a remainder of smaller size. -/
structure EuclidSize (R : Type*) [CommRing R] where
  /-- The size of an element. -/
  size : R → ℕ
  eq_zero_of_size_eq_zero : ∀ b : R, size b = 0 → b = 0
  exists_quot : ∀ a b : R, b ≠ 0 → ∃ q : R, size (a - q * b) < size b

section Reduction

variable {n : Type*} [Fintype n] [DecidableEq n] {R : Type*} [CommRing R]

/-- **Euclidean reduction along a pair of rows.** If a predicate `P` is stable under the
transvections between rows `i` and `k`, and every `P`-element with vanishing `(k, j)` entry is
elementary, then every `P`-element is elementary. -/
theorem pair_reduce (E : EuclidSize R) {i k : n} (hik : i ≠ k) (j : n)
    (P : Matrix.SpecialLinearGroup n R → Prop)
    (hP1 : ∀ (c : R) (g : Matrix.SpecialLinearGroup n R),
      P g → P (slTrans i k hik c * g))
    (hP2 : ∀ (c : R) (g : Matrix.SpecialLinearGroup n R),
      P g → P (slTrans k i hik.symm c * g))
    (hbase : ∀ g : Matrix.SpecialLinearGroup n R,
      P g → g.1 k j = 0 → g ∈ slElementary n R) :
    ∀ g : Matrix.SpecialLinearGroup n R, P g → g ∈ slElementary n R := by
  suffices H : ∀ N : ℕ, ∀ g : Matrix.SpecialLinearGroup n R, P g → E.size (g.1 k j) ≤ N →
      g ∈ slElementary n R from fun g hg ↦ H _ g hg le_rfl
  intro N
  induction N with
  | zero =>
    intro g hg hs
    exact hbase g hg (E.eq_zero_of_size_eq_zero _ (Nat.le_zero.mp hs))
  | succ N ih =>
    intro g hg hs
    by_cases hb : g.1 k j = 0
    · exact hbase g hg hb
    · obtain ⟨q, hq⟩ := E.exists_quot (g.1 i j) (g.1 k j) hb
      obtain ⟨g1, hg1⟩ : ∃ g1, g1 = slTrans i k hik (-q) * g := ⟨_, rfl⟩
      obtain ⟨g2, hg2⟩ : ∃ g2, g2 = slTrans k i hik.symm 1 * g1 := ⟨_, rfl⟩
      obtain ⟨g3, hg3⟩ : ∃ g3, g3 = slTrans i k hik (-1) * g2 := ⟨_, rfl⟩
      obtain ⟨g4, hg4⟩ : ∃ g4, g4 = slTrans k i hik.symm 1 * g3 := ⟨_, rfl⟩
      have e1i : g1.1 i j = g.1 i j + -q * g.1 k j := by
        rw [hg1]; exact slTrans_mul_apply_same i k hik (-q) g j
      have e1k : g1.1 k j = g.1 k j := by
        rw [hg1]; exact slTrans_mul_apply_of_ne i k hik (-q) g k j hik.symm
      have e2k : g2.1 k j = g1.1 k j + 1 * g1.1 i j := by
        rw [hg2]; exact slTrans_mul_apply_same k i hik.symm 1 g1 j
      have e2i : g2.1 i j = g1.1 i j := by
        rw [hg2]; exact slTrans_mul_apply_of_ne k i hik.symm 1 g1 i j hik
      have e3i : g3.1 i j = g2.1 i j + -1 * g2.1 k j := by
        rw [hg3]; exact slTrans_mul_apply_same i k hik (-1) g2 j
      have e3k : g3.1 k j = g2.1 k j := by
        rw [hg3]; exact slTrans_mul_apply_of_ne i k hik (-1) g2 k j hik.symm
      have e4k : g4.1 k j = g3.1 k j + 1 * g3.1 i j := by
        rw [hg4]; exact slTrans_mul_apply_same k i hik.symm 1 g3 j
      have hfin : g4.1 k j = g.1 i j - q * g.1 k j := by
        rw [e4k, e3k, e3i, e2k, e2i, e1i, e1k]; ring
      have hP4 : P g4 := by
        rw [hg4, hg3, hg2, hg1]
        exact hP2 _ _ (hP1 _ _ (hP2 _ _ (hP1 _ _ hg)))
      have hs4 : E.size (g4.1 k j) ≤ N := by
        rw [hfin]; omega
      have hmem : g4 ∈ slElementary n R := ih g4 hP4 hs4
      rw [hg4, hg3, hg2, hg1, slTrans_mul_mem_iff, slTrans_mul_mem_iff, slTrans_mul_mem_iff,
        slTrans_mul_mem_iff] at hmem
      exact hmem

/-- **Unit normalization along a pair of rows.** If the `(i, j)` entry is a unit and the `(k, j)`
entry vanishes, three transvections make them `1` and `0`. -/
theorem unit_normalize {i k : n} (hik : i ≠ k) (j : n)
    (P : Matrix.SpecialLinearGroup n R → Prop)
    (hP1 : ∀ (c : R) (g : Matrix.SpecialLinearGroup n R), P g → P (slTrans i k hik c * g))
    (hP2 : ∀ (c : R) (g : Matrix.SpecialLinearGroup n R), P g → P (slTrans k i hik.symm c * g))
    (hbase : ∀ g : Matrix.SpecialLinearGroup n R, P g → g.1 i j = 1 → g.1 k j = 0 →
      g ∈ slElementary n R)
    (g : Matrix.SpecialLinearGroup n R) (hg : P g) (v : R) (hv : v * g.1 i j = 1)
    (hk : g.1 k j = 0) : g ∈ slElementary n R := by
  obtain ⟨g1, hg1⟩ : ∃ g1, g1 = slTrans k i hik.symm v * g := ⟨_, rfl⟩
  obtain ⟨g2, hg2⟩ : ∃ g2, g2 = slTrans i k hik (1 - g.1 i j) * g1 := ⟨_, rfl⟩
  obtain ⟨g3, hg3⟩ : ∃ g3, g3 = slTrans k i hik.symm (-1) * g2 := ⟨_, rfl⟩
  have e1k : g1.1 k j = g.1 k j + v * g.1 i j := by
    rw [hg1]; exact slTrans_mul_apply_same k i hik.symm v g j
  have e1i : g1.1 i j = g.1 i j := by
    rw [hg1]; exact slTrans_mul_apply_of_ne k i hik.symm v g i j hik
  have e2i : g2.1 i j = g1.1 i j + (1 - g.1 i j) * g1.1 k j := by
    rw [hg2]; exact slTrans_mul_apply_same i k hik (1 - g.1 i j) g1 j
  have e2k : g2.1 k j = g1.1 k j := by
    rw [hg2]; exact slTrans_mul_apply_of_ne i k hik (1 - g.1 i j) g1 k j hik.symm
  have e3k : g3.1 k j = g2.1 k j + -1 * g2.1 i j := by
    rw [hg3]; exact slTrans_mul_apply_same k i hik.symm (-1) g2 j
  have e3i : g3.1 i j = g2.1 i j := by
    rw [hg3]; exact slTrans_mul_apply_of_ne k i hik.symm (-1) g2 i j hik
  have h3i : g3.1 i j = 1 := by
    rw [e3i, e2i, e1i, e1k, hk]
    linear_combination (1 - g.1 i j) * hv
  have h3k : g3.1 k j = 0 := by
    rw [e3k, e2k, e2i, e1k, e1i, hk]
    linear_combination (g.1 i j) * hv
  have hP3 : P g3 := by
    rw [hg3, hg2, hg1]
    exact hP2 _ _ (hP1 _ _ (hP2 _ _ hg))
  have hmem : g3 ∈ slElementary n R := hbase g3 hP3 h3i h3k
  rw [hg3, hg2, hg1, slTrans_mul_mem_iff, slTrans_mul_mem_iff, slTrans_mul_mem_iff] at hmem
  exact hmem

end Reduction

section Three

variable {R : Type*} [CommRing R]

theorem fin3_01 : (0 : Fin 3) ≠ 1 := by decide
theorem fin3_02 : (0 : Fin 3) ≠ 2 := by decide
theorem fin3_12 : (1 : Fin 3) ≠ 2 := by decide
theorem fin3_10 : (1 : Fin 3) ≠ 0 := by decide
theorem fin3_20 : (2 : Fin 3) ≠ 0 := by decide
theorem fin3_21 : (2 : Fin 3) ≠ 1 := by decide

theorem fin3_cases : ∀ a : Fin 3, a = 0 ∨ a = 1 ∨ a = 2 := by decide

theorem fin3_cases_ne_zero : ∀ a : Fin 3, a ≠ 0 → a = 1 ∨ a = 2 := by decide

/-- An element of `SL(3, R)` with the entries of the identity matrix is the identity. -/
theorem sl3_eq_one (g : Matrix.SpecialLinearGroup (Fin 3) R)
    (h00 : g.1 0 0 = 1) (h01 : g.1 0 1 = 0) (h02 : g.1 0 2 = 0)
    (h10 : g.1 1 0 = 0) (h11 : g.1 1 1 = 1) (h12 : g.1 1 2 = 0)
    (h20 : g.1 2 0 = 0) (h21 : g.1 2 1 = 0) (h22 : g.1 2 2 = 1) : g = 1 := by
  refine Subtype.ext (Matrix.ext fun a b ↦ ?_)
  rcases fin3_cases a with rfl | rfl | rfl <;> rcases fin3_cases b with rfl | rfl | rfl
  · rw [h00]; exact (Matrix.one_apply_eq (0 : Fin 3)).symm
  · rw [h01]; exact (Matrix.one_apply_ne fin3_01).symm
  · rw [h02]; exact (Matrix.one_apply_ne fin3_02).symm
  · rw [h10]; exact (Matrix.one_apply_ne fin3_10).symm
  · rw [h11]; exact (Matrix.one_apply_eq (1 : Fin 3)).symm
  · rw [h12]; exact (Matrix.one_apply_ne fin3_12).symm
  · rw [h20]; exact (Matrix.one_apply_ne fin3_20).symm
  · rw [h21]; exact (Matrix.one_apply_ne fin3_21).symm
  · rw [h22]; exact (Matrix.one_apply_eq (2 : Fin 3)).symm

/-- The first row and column of `g` are those of the identity matrix. -/
structure FirstHook (g : Matrix.SpecialLinearGroup (Fin 3) R) : Prop where
  e00 : g.1 0 0 = 1
  e10 : g.1 1 0 = 0
  e20 : g.1 2 0 = 0
  e01 : g.1 0 1 = 0
  e02 : g.1 0 2 = 0

theorem firstHook_slTrans_mul {i k : Fin 3} (h : i ≠ k) (hi : i ≠ 0) (hk : k ≠ 0) (c : R)
    (g : Matrix.SpecialLinearGroup (Fin 3) R) (hg : FirstHook g) :
    FirstHook (slTrans i k h c * g) := by
  have hz : ∀ a : Fin 3, a ≠ 0 → g.1 a 0 = 0 := by
    intro a ha
    rcases fin3_cases_ne_zero a ha with rfl | rfl
    · exact hg.e10
    · exact hg.e20
  have hcol : ∀ a : Fin 3, a ≠ 0 → (slTrans i k h c * g).1 a 0 = 0 := by
    intro a ha
    by_cases hai : a = i
    · rw [hai, slTrans_mul_apply_same, hz i hi, hz k hk, mul_zero, add_zero]
    · rw [slTrans_mul_apply_of_ne i k h c g a 0 hai]
      exact hz a ha
  have hrow : ∀ b : Fin 3, (slTrans i k h c * g).1 0 b = g.1 0 b := fun b ↦
    slTrans_mul_apply_of_ne i k h c g 0 b hi.symm
  exact ⟨(hrow 0).trans hg.e00, hcol 1 fin3_10, hcol 2 fin3_20, (hrow 1).trans hg.e01,
    (hrow 2).trans hg.e02⟩

theorem sl3_stage6 (g : Matrix.SpecialLinearGroup (Fin 3) R) (hg : FirstHook g)
    (h11 : g.1 1 1 = 1) (h21 : g.1 2 1 = 0) : g ∈ slElementary (Fin 3) R := by
  have hd : Matrix.det g.1 = 1 := g.2
  rw [Matrix.det_fin_three, hg.e00, hg.e10, hg.e20, hg.e01, hg.e02, h11, h21] at hd
  have h22 : g.1 2 2 = 1 := by linear_combination hd
  have hM : g * slTrans 1 2 fin3_12 (-(g.1 1 2)) = 1 := by
    refine sl3_eq_one _ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    · rw [mul_slTrans_apply_of_ne 1 2 fin3_12 _ g 0 0 fin3_02]; exact hg.e00
    · rw [mul_slTrans_apply_of_ne 1 2 fin3_12 _ g 0 1 fin3_12]; exact hg.e01
    · rw [mul_slTrans_apply_same 1 2 fin3_12 _ g 0, hg.e02, hg.e01]; ring
    · rw [mul_slTrans_apply_of_ne 1 2 fin3_12 _ g 1 0 fin3_02]; exact hg.e10
    · rw [mul_slTrans_apply_of_ne 1 2 fin3_12 _ g 1 1 fin3_12]; exact h11
    · rw [mul_slTrans_apply_same 1 2 fin3_12 _ g 1, h11]; ring
    · rw [mul_slTrans_apply_of_ne 1 2 fin3_12 _ g 2 0 fin3_02]; exact hg.e20
    · rw [mul_slTrans_apply_of_ne 1 2 fin3_12 _ g 2 1 fin3_12]; exact h21
    · rw [mul_slTrans_apply_same 1 2 fin3_12 _ g 2, h22, h21]; ring
  rw [← mul_slTrans_mem_iff 1 2 fin3_12 (-(g.1 1 2)) g, hM]
  exact (slElementary (Fin 3) R).one_mem

theorem sl3_stage5 (g : Matrix.SpecialLinearGroup (Fin 3) R) (hg : FirstHook g)
    (h21 : g.1 2 1 = 0) : g ∈ slElementary (Fin 3) R := by
  have hd : Matrix.det g.1 = 1 := g.2
  rw [Matrix.det_fin_three, hg.e00, hg.e10, hg.e20, hg.e01, hg.e02, h21] at hd
  have hv : g.1 2 2 * g.1 1 1 = 1 := by linear_combination hd
  exact unit_normalize fin3_12 1 FirstHook
    (fun c g' hg' ↦ firstHook_slTrans_mul fin3_12 fin3_10 fin3_20 c g' hg')
    (fun c g' hg' ↦ firstHook_slTrans_mul fin3_12.symm fin3_20 fin3_10 c g' hg')
    (fun g' hg' h11' h21' ↦ sl3_stage6 g' hg' h11' h21') g hg (g.1 2 2) hv h21

theorem sl3_stage4 (E : EuclidSize R) (g : Matrix.SpecialLinearGroup (Fin 3) R)
    (hg : FirstHook g) : g ∈ slElementary (Fin 3) R :=
  pair_reduce E fin3_12 1 FirstHook
    (fun c g' hg' ↦ firstHook_slTrans_mul fin3_12 fin3_10 fin3_20 c g' hg')
    (fun c g' hg' ↦ firstHook_slTrans_mul fin3_12.symm fin3_20 fin3_10 c g' hg')
    (fun g' hg' h21' ↦ sl3_stage5 g' hg' h21') g hg

theorem sl3_stage3 (E : EuclidSize R) (g : Matrix.SpecialLinearGroup (Fin 3) R)
    (h00 : g.1 0 0 = 1) (h10 : g.1 1 0 = 0) (h20 : g.1 2 0 = 0) :
    g ∈ slElementary (Fin 3) R := by
  obtain ⟨g1, hg1⟩ : ∃ g1, g1 = g * slTrans 0 1 fin3_01 (-(g.1 0 1)) := ⟨_, rfl⟩
  obtain ⟨g2, hg2⟩ : ∃ g2, g2 = g1 * slTrans 0 2 fin3_02 (-(g1.1 0 2)) := ⟨_, rfl⟩
  have f00 : g1.1 0 0 = 1 := by
    rw [hg1, mul_slTrans_apply_of_ne 0 1 fin3_01 _ g 0 0 fin3_01]; exact h00
  have f10 : g1.1 1 0 = 0 := by
    rw [hg1, mul_slTrans_apply_of_ne 0 1 fin3_01 _ g 1 0 fin3_01]; exact h10
  have f20 : g1.1 2 0 = 0 := by
    rw [hg1, mul_slTrans_apply_of_ne 0 1 fin3_01 _ g 2 0 fin3_01]; exact h20
  have f01 : g1.1 0 1 = 0 := by
    rw [hg1, mul_slTrans_apply_same 0 1 fin3_01 _ g 0, h00]; ring
  have hook : FirstHook g2 := by
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · rw [hg2, mul_slTrans_apply_of_ne 0 2 fin3_02 _ g1 0 0 fin3_02]; exact f00
    · rw [hg2, mul_slTrans_apply_of_ne 0 2 fin3_02 _ g1 1 0 fin3_02]; exact f10
    · rw [hg2, mul_slTrans_apply_of_ne 0 2 fin3_02 _ g1 2 0 fin3_02]; exact f20
    · rw [hg2, mul_slTrans_apply_of_ne 0 2 fin3_02 _ g1 0 1 fin3_12]; exact f01
    · rw [hg2, mul_slTrans_apply_same 0 2 fin3_02 _ g1 0, f00]; ring
  have hmem : g2 ∈ slElementary (Fin 3) R := sl3_stage4 E g2 hook
  rw [hg2, mul_slTrans_mem_iff, hg1, mul_slTrans_mem_iff] at hmem
  exact hmem

theorem sl3_stage2 (E : EuclidSize R) (g : Matrix.SpecialLinearGroup (Fin 3) R)
    (h10 : g.1 1 0 = 0) (h20 : g.1 2 0 = 0) : g ∈ slElementary (Fin 3) R := by
  have hd : Matrix.det g.1 = 1 := g.2
  rw [Matrix.det_fin_three, h10, h20] at hd
  have hv : (g.1 1 1 * g.1 2 2 - g.1 1 2 * g.1 2 1) * g.1 0 0 = 1 := by
    linear_combination hd
  have hP1 : ∀ (c : R) (g' : Matrix.SpecialLinearGroup (Fin 3) R), g'.1 2 0 = 0 →
      (slTrans 0 1 fin3_01 c * g').1 2 0 = 0 := by
    intro c g' hg'
    rw [slTrans_mul_apply_of_ne 0 1 fin3_01 c g' 2 0 fin3_20]; exact hg'
  have hP2 : ∀ (c : R) (g' : Matrix.SpecialLinearGroup (Fin 3) R), g'.1 2 0 = 0 →
      (slTrans 1 0 fin3_01.symm c * g').1 2 0 = 0 := by
    intro c g' hg'
    rw [slTrans_mul_apply_of_ne 1 0 fin3_01.symm c g' 2 0 fin3_21]; exact hg'
  exact unit_normalize fin3_01 0 (fun g' ↦ g'.1 2 0 = 0) hP1 hP2
    (fun g' hg' h00' h10' ↦ sl3_stage3 E g' h00' h10' hg') g h20 _ hv h10

theorem sl3_stage1 (E : EuclidSize R) (g : Matrix.SpecialLinearGroup (Fin 3) R)
    (h20 : g.1 2 0 = 0) : g ∈ slElementary (Fin 3) R := by
  have hP1 : ∀ (c : R) (g' : Matrix.SpecialLinearGroup (Fin 3) R), g'.1 2 0 = 0 →
      (slTrans 0 1 fin3_01 c * g').1 2 0 = 0 := by
    intro c g' hg'
    rw [slTrans_mul_apply_of_ne 0 1 fin3_01 c g' 2 0 fin3_20]; exact hg'
  have hP2 : ∀ (c : R) (g' : Matrix.SpecialLinearGroup (Fin 3) R), g'.1 2 0 = 0 →
      (slTrans 1 0 fin3_01.symm c * g').1 2 0 = 0 := by
    intro c g' hg'
    rw [slTrans_mul_apply_of_ne 1 0 fin3_01.symm c g' 2 0 fin3_21]; exact hg'
  exact pair_reduce E fin3_01 0 (fun g' ↦ g'.1 2 0 = 0) hP1 hP2
    (fun g' hg' h10' ↦ sl3_stage2 E g' h10' hg') g h20

/-- **`SL_3 = E_3` over a ring with a Euclidean size function**: every element of `SL(3, R)` is a
product of transvections (Thom, GGD 4 (2010), §2.1, Lemma 2.1, input `SL_3(F_p[t,t⁻¹]) = E_3`;
`simple_kazhdan_sofic_group.tex` l.57–59). -/
theorem mem_slElementary_three (E : EuclidSize R) (g : Matrix.SpecialLinearGroup (Fin 3) R) :
    g ∈ slElementary (Fin 3) R :=
  pair_reduce E fin3_02 0 (fun _ ↦ True) (fun _ _ _ ↦ trivial) (fun _ _ _ ↦ trivial)
    (fun g' _ h20' ↦ sl3_stage1 E g' h20') g trivial

/-- `slElementary (Fin 3) R` is all of `SL(3, R)` when `R` has a Euclidean size function. -/
theorem slElementary_three_eq_top (E : EuclidSize R) :
    slElementary (Fin 3) R = ⊤ :=
  eq_top_iff.2 fun g _ ↦ mem_slElementary_three E g

end Three

#audit_axioms mem_slElementary_three

end GroupApproximation.Full.A2ThomT
