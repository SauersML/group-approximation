import GroupApproximation.Leavitt.ElementaryGroup
import GroupApproximation.Pestov91.Kazhdan
import GroupApproximation.Meta.AxiomGuard
import Mathlib.GroupTheory.Finiteness
import Mathlib.Data.Finite.Prod

/-!
# eq:elementary, generation, finite generation, property (T) and infiniteness of `EL_n(R)`

`simple_kazhdan_sofic_group.tex`, Section `sec:proof`, "The ring and property (T)", in the proof
of `thm:general`(a):

> We write the proof for `n=3`; for `n≥3` replace `3` by `n` throughout.  [...]  Let `G=EL_3(R)` be
> the subgroup of `GL_3(R)` generated by the `e_ij(r)` with `i≠j` and `r∈R`.  With
> `[g,h]=ghg⁻¹h⁻¹` and `i,j,l` distinct,
>   `e_ij(r+r')=e_ij(r)e_ij(r')`,  `[e_il(r),e_lj(r')]=e_ij(rr')`.        (eq:elementary)
> So the `e_ij(s)` with `s∈S` generate `G`.  By Ershov and Jaikin-Zapirain, `EL_n` of every finitely
> generated associative unital ring has property (T) for `n≥3`, so `G` has property (T).  It is
> infinite because `e_12(LC(C,F_2))` is infinite.

and the row "finitely generated: by the `e_ij(s)` with `s ∈ S`" of `tab:props`.

Everything here is stated for an arbitrary ring `R` and every rank `n ≥ 3`, as the first printed
sentence asks; `Endpoints.lean` specialises to `R = LC(C,F_2) ⋊ Λ`.

* `printedGeneralElementaryIdentities`: eq:elementary in every rank.
* `elementaryGeneration`: for a ring generating set `S ∋ 1`, the `e_ij(s)`, `s ∈ S`, generate
  `EL_n(R)`, by the printed route: the coefficients whose elementary matrices lie in the generated
  subgroup form a subring (eq:elementary) containing `S`.
* `closure_elementaryGenerators_eq_top`: the same, inside the group `EL_n(R)` itself.
* `elementaryGroup_fg`: `EL_n(R)` is finitely generated, by these finitely many generators.
* `elementaryGroup_hasKazhdanPropertyT`: property (T), by Ershov--Jaikin-Zapirain as proved in
  this repository (`Pestov91.elementary_hasKazhdanPropertyT`).
* `infinite_elementaryGroup_of_injective`: `EL_n(R)` is infinite when an infinite ring embeds in `R`.
-/

namespace GroupApproximation.Full.SK03

open scoped commutatorElement

/-! ## eq:elementary -/

/-- **eq:elementary** (`simple_kazhdan_sofic_group.tex`, `sec:proof`), in every rank:
`e_ij(r+r') = e_ij(r) e_ij(r')` for `i ≠ j`, and `[e_il(r), e_lj(r')] = e_ij(rr')` for distinct
`i, j, l`, with `[g,h] = g h g⁻¹ h⁻¹` (Mathlib's `⁅g, h⁆`, see `commutatorElement_def`). -/
def PrintedGeneralElementaryIdentities : Prop :=
  ∀ (R : Type) [Ring R] (n : ℕ) (i j l : Fin n) (hij : i ≠ j) (hil : i ≠ l) (hlj : l ≠ j)
    (r r' : R),
    elementaryUnit i j hij (r + r') = elementaryUnit i j hij r * elementaryUnit i j hij r' ∧
      ⁅elementaryUnit i l hil r, elementaryUnit l j hlj r'⁆ = elementaryUnit i j hij (r * r')

theorem printedGeneralElementaryIdentities : PrintedGeneralElementaryIdentities := by
  intro R _ n i j l hij hil hlj r r'
  exact ⟨(elementaryUnit_mul i j hij r r').symm, elementaryUnit_commutator i l j hil hlj hij r r'⟩

#audit_closed_axioms GroupApproximation.Full.SK03.printedGeneralElementaryIdentities

/-! ## Generation -/

/-- In rank `n ≥ 3`, two indices leave a third one. -/
theorem exists_third_index {n : ℕ} (hn : 3 ≤ n) (i j : Fin n) :
    ∃ l : Fin n, l ≠ i ∧ l ≠ j := by
  by_cases h0 : i.val = 0 ∨ j.val = 0
  · by_cases h1 : i.val = 1 ∨ j.val = 1
    · refine ⟨⟨2, by omega⟩, fun h => ?_, fun h => ?_⟩
      · have h' : (2 : ℕ) = i.val := congrArg Fin.val h
        omega
      · have h' : (2 : ℕ) = j.val := congrArg Fin.val h
        omega
    · refine ⟨⟨1, by omega⟩, fun h => h1 (Or.inl ?_), fun h => h1 (Or.inr ?_)⟩
      · have h' : (1 : ℕ) = i.val := congrArg Fin.val h
        exact h'.symm
      · have h' : (1 : ℕ) = j.val := congrArg Fin.val h
        exact h'.symm
  · refine ⟨⟨0, by omega⟩, fun h => h0 (Or.inl ?_), fun h => h0 (Or.inr ?_)⟩
    · have h' : (0 : ℕ) = i.val := congrArg Fin.val h
      exact h'.symm
    · have h' : (0 : ℕ) = j.val := congrArg Fin.val h
      exact h'.symm

/-- **The coefficient subring** in rank `n ≥ 3`: if a subgroup `H` contains every `e_ij(1)`, the
coefficients `a` with `e_ij(a) ∈ H` for all `i ≠ j` form a subring, by eq:elementary (sums from
the first identity, products from a commutator through a third index). -/
def coefficientSubring {R : Type*} [Ring R] {n : ℕ} (hn : 3 ≤ n)
    (H : Subgroup (Matrix (Fin n) (Fin n) R)ˣ)
    (hone : ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h (1 : R) ∈ H) : Subring R where
  carrier := {a | ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h a ∈ H}
  mul_mem' := by
    intro a b ha hb
    show ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h (a * b) ∈ H
    intro i j h
    obtain ⟨l, hli, hlj⟩ := exists_third_index hn i j
    rw [← elementaryUnit_commutator i l j (Ne.symm hli) hlj h a b, commutatorElement_def]
    exact H.mul_mem (H.mul_mem (H.mul_mem (ha i l (Ne.symm hli)) (hb l j hlj))
      (H.inv_mem (ha i l (Ne.symm hli)))) (H.inv_mem (hb l j hlj))
  one_mem' := hone
  add_mem' := by
    intro a b ha hb
    show ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h (a + b) ∈ H
    intro i j h
    rw [← elementaryUnit_mul]
    exact H.mul_mem (ha i j h) (hb i j h)
  zero_mem' := by
    show ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h (0 : R) ∈ H
    intro i j h
    rw [elementaryUnit_zero]
    exact H.one_mem
  neg_mem' := by
    intro a ha
    show ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h (-a) ∈ H
    intro i j h
    have hinv : elementaryUnit i j h (-a) = (elementaryUnit i j h a)⁻¹ := by
      rw [eq_inv_iff_mul_eq_one, elementaryUnit_mul, neg_add_cancel, elementaryUnit_zero]
    rw [hinv]
    exact H.inv_mem (ha i j h)

/-- **"So the `e_ij(s)` with `s ∈ S` generate `G`"** (`sec:proof`), in every rank `n ≥ 3`: if
`S ∋ 1` generates `R` as a ring, then `EL_n(R)` is generated by the `e_ij(s)` with `s ∈ S`. -/
theorem elementaryGeneration {R : Type*} [Ring R] (S : Set R) (hS1 : (1 : R) ∈ S)
    (hS : Subring.closure S = ⊤) {n : ℕ} (hn : 3 ≤ n) :
    elementaryGroup (Fin n) R =
      Subgroup.closure {z | ∃ (i j : Fin n) (h : i ≠ j) (s : R), s ∈ S ∧
        elementaryUnit i j h s = z} := by
  set H : Subgroup (Matrix (Fin n) (Fin n) R)ˣ :=
    Subgroup.closure {z | ∃ (i j : Fin n) (h : i ≠ j) (s : R), s ∈ S ∧
      elementaryUnit i j h s = z} with hH
  have hgen : ∀ (i j : Fin n) (h : i ≠ j) (s : R), s ∈ S → elementaryUnit i j h s ∈ H :=
    fun i j h s hs => Subgroup.subset_closure ⟨i, j, h, s, hs, rfl⟩
  have hC : Subring.closure S ≤ coefficientSubring hn H fun i j h => hgen i j h 1 hS1 :=
    Subring.closure_le.mpr fun s hs i j h => hgen i j h s hs
  refine le_antisymm ?_ ?_
  · show Subgroup.closure {z | ∃ (i j : Fin n) (h : i ≠ j) (a : R), elementaryUnit i j h a = z} ≤ H
    refine (Subgroup.closure_le H).mpr ?_
    rintro _ ⟨i, j, h, a, rfl⟩
    have ha : a ∈ Subring.closure S := by
      rw [hS]
      exact Subring.mem_top a
    exact hC ha i j h
  · refine (Subgroup.closure_le _).mpr ?_
    rintro _ ⟨i, j, h, s, -, rfl⟩
    exact elementaryUnit_mem i j h s

/-- The closed form of `elementaryGeneration`, for every ring, generating set `S ∋ 1` and
`n ≥ 3`. -/
def PrintedGeneralElementaryGeneration : Prop :=
  ∀ (R : Type) [Ring R] (S : Set R), (1 : R) ∈ S → Subring.closure S = ⊤ →
    ∀ n : ℕ, 3 ≤ n →
      elementaryGroup (Fin n) R =
        Subgroup.closure {z | ∃ (i j : Fin n) (h : i ≠ j) (s : R), s ∈ S ∧
          elementaryUnit i j h s = z}

theorem printedGeneralElementaryGeneration : PrintedGeneralElementaryGeneration :=
  fun _ _ S hS1 hS _ hn => elementaryGeneration S hS1 hS hn

#audit_closed_axioms GroupApproximation.Full.SK03.printedGeneralElementaryGeneration

/-- The marked generators `e_ij(s)`, `s ∈ S`, as elements of the group `EL_n(R)`. -/
def elementaryGenerators {R : Type*} [Ring R] (S : Set R) (n : ℕ) :
    Set ↥(elementaryGroup (Fin n) R) :=
  {z | ∃ (i j : Fin n) (h : i ≠ j) (s : R), s ∈ S ∧
    (z : (Matrix (Fin n) (Fin n) R)ˣ) = elementaryUnit i j h s}

/-- **Generation inside `EL_n(R)`**: the `e_ij(s)`, `s ∈ S`, generate the whole group `EL_n(R)`. -/
theorem closure_elementaryGenerators_eq_top {R : Type*} [Ring R] (S : Set R) (hS1 : (1 : R) ∈ S)
    (hS : Subring.closure S = ⊤) {n : ℕ} (hn : 3 ≤ n) :
    Subgroup.closure (elementaryGenerators S n) = ⊤ := by
  have himage : (elementaryGroup (Fin n) R).subtype '' elementaryGenerators S n =
      {z | ∃ (i j : Fin n) (h : i ≠ j) (s : R), s ∈ S ∧ elementaryUnit i j h s = z} := by
    ext z
    constructor
    · rintro ⟨w, ⟨i, j, h, s, hs, hw⟩, rfl⟩
      exact ⟨i, j, h, s, hs, hw.symm⟩
    · rintro ⟨i, j, h, s, hs, rfl⟩
      exact ⟨⟨elementaryUnit i j h s, elementaryUnit_mem i j h s⟩, ⟨i, j, h, s, hs, rfl⟩, rfl⟩
  have hmap : (Subgroup.closure (elementaryGenerators S n)).map
      (elementaryGroup (Fin n) R).subtype = elementaryGroup (Fin n) R := by
    rw [Subgroup.map_closure, himage]
    exact (elementaryGeneration S hS1 hS hn).symm
  refine eq_top_iff.mpr fun g _ => ?_
  have hg : (g : (Matrix (Fin n) (Fin n) R)ˣ) ∈
      (Subgroup.closure (elementaryGenerators S n)).map (elementaryGroup (Fin n) R).subtype := by
    rw [hmap]
    exact g.2
  obtain ⟨x, hx, hxg⟩ := Subgroup.mem_map.mp hg
  have hxg' : x = g := Subtype.ext hxg
  rw [← hxg']
  exact hx

/-- For a finite `S` there are finitely many marked generators `e_ij(s)`. -/
theorem elementaryGenerators_finite {R : Type*} [Ring R] (S : Finset R) (n : ℕ) :
    (elementaryGenerators (S : Set R) n).Finite := by
  refine (Set.finite_range (fun p : {q : Fin n × Fin n // q.1 ≠ q.2} × S =>
    (⟨elementaryUnit p.1.1.1 p.1.1.2 p.1.2 p.2.1,
      elementaryUnit_mem p.1.1.1 p.1.1.2 p.1.2 p.2.1⟩ : ↥(elementaryGroup (Fin n) R)))).subset ?_
  rintro z ⟨i, j, h, s, hs, hz⟩
  exact ⟨(⟨(i, j), h⟩, ⟨s, hs⟩), Subtype.ext hz.symm⟩

/-- **Finitely generated** (`tab:props`, "by the `e_ij(s)` with `s ∈ S`"): for a finite ring
generating set `S ∋ 1` and `n ≥ 3`, `EL_n(R)` is generated by the finitely many `e_ij(s)`. -/
theorem elementaryGroup_fg {R : Type*} [Ring R] (S : Finset R) (hS1 : (1 : R) ∈ S)
    (hS : Subring.closure (S : Set R) = ⊤) {n : ℕ} (hn : 3 ≤ n) :
    Group.FG ↥(elementaryGroup (Fin n) R) :=
  Group.fg_iff.mpr ⟨elementaryGenerators (S : Set R) n,
    closure_elementaryGenerators_eq_top (S : Set R) hS1 hS hn, elementaryGenerators_finite S n⟩

/-! ## Property (T) and infiniteness -/

/-- **Property (T)** (`sec:proof`): a finite ring generating set makes `R` a finitely generated
ring, so `EL_n(R)` has property (T) for `n ≥ 3` by Ershov--Jaikin-Zapirain, proved in this
repository. -/
theorem elementaryGroup_hasKazhdanPropertyT {R : Type} [Ring R] (S : Finset R)
    (hS : Subring.closure (S : Set R) = ⊤) {n : ℕ} (hn : 3 ≤ n) :
    HasKazhdanPropertyT.{0, 0} ↥(elementaryGroup (Fin n) R) :=
  Pestov91.elementary_hasKazhdanPropertyT ⟨S, hS⟩ hn

/-- **"By Ershov and Jaikin-Zapirain, `EL_n` of every finitely generated associative unital ring has
property (T) for `n ≥ 3`"** (`sec:proof`), as a closed statement. -/
def PrintedEJZ : Prop :=
  ∀ (R : Type) [Ring R], IsFinitelyGeneratedRing R → ∀ n : ℕ, 3 ≤ n →
    HasKazhdanPropertyT.{0, 0} ↥(elementaryGroup (Fin n) R)

theorem printedEJZ : PrintedEJZ :=
  fun _ _ hR _ hn => Pestov91.elementary_hasKazhdanPropertyT hR hn

#audit_closed_axioms GroupApproximation.Full.SK03.printedEJZ

/-- **Infiniteness** (`sec:proof`, "infinite because `e_12(LC(C,F_2))` is infinite"): if an infinite
ring `K` embeds in `R`, then `a ↦ e_12(φ a)` is injective, so `EL_n(R)` is infinite for `n ≥ 2`. -/
theorem infinite_elementaryGroup_of_injective {K R : Type*} [Ring K] [Infinite K] [Ring R]
    (φ : K →+* R) (hφ : Function.Injective φ) {n : ℕ} (hn : 2 ≤ n) :
    Infinite ↥(elementaryGroup (Fin n) R) := by
  have h01 : (⟨0, by omega⟩ : Fin n) ≠ ⟨1, by omega⟩ := Fin.ne_of_val_ne Nat.zero_ne_one
  refine Infinite.of_injective
    (fun a : K => (⟨elementaryUnit _ _ h01 (φ a), elementaryUnit_mem _ _ h01 (φ a)⟩ :
      ↥(elementaryGroup (Fin n) R))) ?_
  intro a b hab
  exact hφ (elementaryUnit_injective _ _ h01 (congrArg Subtype.val hab))

end GroupApproximation.Full.SK03

#audit_axioms GroupApproximation.Full.SK03.exists_third_index
#audit_axioms GroupApproximation.Full.SK03.closure_elementaryGenerators_eq_top
#audit_axioms GroupApproximation.Full.SK03.elementaryGroup_fg
#audit_axioms GroupApproximation.Full.SK03.elementaryGroup_hasKazhdanPropertyT
#audit_axioms GroupApproximation.Full.SK03.infinite_elementaryGroup_of_injective
