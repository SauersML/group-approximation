import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.GeneralRingT.Ring
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.GeneralRingT.Elementary
import GroupApproximation.Manuscript.SimpleKazhdanSofic.ElementaryGroupFacts
import GroupApproximation.Dynamics.ClopenGroupCrossedProduct
import GroupApproximation.Meta.AxiomGuard
import Mathlib.Topology.Perfect
import Mathlib.Topology.Separation.Profinite
import Mathlib.Topology.Metrizable.Basic
import Mathlib.Dynamics.Minimal

/-!
# `thm:general`(a): infinite, finitely generated and Kazhdan

`simple_kazhdan_sofic_group.tex`, `thm:general`:

> Let a finitely generated group `Λ` act minimally and topologically freely on a Cantor set `C`,
> and let the ring `R = LC(C,F_2) ⋊ Λ` be generated by a finite set `S ∋ 1`.
> (a) For every `n ≥ 3`, the group `EL_n(R)` is an infinite, finitely generated, simple Kazhdan
> group.

and its proof, `sec:proof`, "The ring and property (T)".  This file proves the three properties
other than simplicity, specialising `Elementary.lean` to `R = ClopenGroupCrossedProduct Λ C (ZMod 2)`.
Simplicity is `Full.SK02.generalSimple_printed`, and `PartA.lean` puts the four together.

A Cantor set is a nonempty compact metrizable totally disconnected space without isolated points
(`PerfectSpace`); `C` is only used through these properties.  Topological freeness is spelt as in
the manuscript's definition: no `ξ ≠ 1` fixes a nonempty open set pointwise.

* `infinite_of_perfectSpace`: a nonempty `T₁` space without isolated points is infinite.
* `printedE12Infinite`: `e_12(LC(C,F_2))` is infinite.
* `printedGeneralPartAWithoutSimplicity`: `EL_n(R)` is infinite, finitely generated and Kazhdan.
-/

namespace GroupApproximation.Full.SK03

/-- A nonempty `T₁` space without isolated points is infinite: a finite `T₁` space is discrete, so
its singletons would be open. -/
theorem infinite_of_perfectSpace (C : Type*) [TopologicalSpace C] [T1Space C] [PerfectSpace C]
    [Nonempty C] : Infinite C := by
  by_contra h
  haveI : Finite C := not_infinite_iff_finite.1 h
  haveI : DiscreteTopology C := Finite.instDiscreteTopology
  obtain ⟨x⟩ := ‹Nonempty C›
  exact not_isOpen_singleton x (isOpen_discrete {x})

/-- **"`e_12(LC(C,F_2))` is infinite"** (`sec:proof`), for every Cantor set `C`, every group `Λ`
acting by homeomorphisms and every `n ≥ 2`: the elementary matrices `e_12(f)`, `f ∈ LC(C,F_2)`,
form an infinite subset of `EL_n(R)`. -/
def PrintedE12Infinite : Prop :=
  ∀ (Λ : Type) [Group Λ] (C : Type) [TopologicalSpace C] [CompactSpace C]
    [TopologicalSpace.MetrizableSpace C] [TotallyDisconnectedSpace C] [PerfectSpace C]
    [Nonempty C] [MulAction Λ C] [ContinuousConstSMul Λ C] (n : ℕ) (hn : 2 ≤ n),
    Set.Infinite (Set.range fun f : LocallyConstant C (ZMod 2) =>
      elementaryUnit (⟨0, by omega⟩ : Fin n) ⟨1, by omega⟩
        (fun h => absurd (Fin.mk.inj h) (by decide))
        (ClopenGroupCrossedProduct.coeff Λ C (ZMod 2) f))

theorem printedE12Infinite : PrintedE12Infinite := by
  intro Λ _ C _ _ _ _ _ _ _ _ n _
  haveI : Infinite C := infinite_of_perfectSpace C
  haveI : Infinite (LocallyConstant C (ZMod 2)) :=
    SimpleKazhdanSofic.infinite_locallyConstant_zmodTwo C
  refine Set.infinite_range_of_injective fun f g hfg => ?_
  exact ClopenGroupCrossedProduct.coeff_injective Λ C (ZMod 2)
    (elementaryUnit_injective _ _ _ hfg)

#audit_closed_axioms GroupApproximation.Full.SK03.printedE12Infinite

/-- **`thm:general`(a) without simplicity**, in the printed hypotheses: `EL_n(R)` is infinite,
finitely generated and Kazhdan.  Minimality and topological freeness are not needed for these three
properties (they enter the simplicity proof), and neither is finite generation of `Λ`. -/
theorem generalInfiniteFGKazhdan (Λ : Type) [Group Λ] (C : Type) [TopologicalSpace C]
    [CompactSpace C] [TopologicalSpace.MetrizableSpace C] [TotallyDisconnectedSpace C]
    [PerfectSpace C] [Nonempty C] [MulAction Λ C] [ContinuousConstSMul Λ C]
    (S : Finset (ClopenGroupCrossedProduct Λ C (ZMod 2)))
    (hS1 : (1 : ClopenGroupCrossedProduct Λ C (ZMod 2)) ∈ S)
    (hS : Subring.closure (S : Set (ClopenGroupCrossedProduct Λ C (ZMod 2))) = ⊤)
    {n : ℕ} (hn : 3 ≤ n) :
    Infinite ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
      Group.FG ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
      HasKazhdanPropertyT.{0, 0}
        ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) := by
  haveI : Infinite C := infinite_of_perfectSpace C
  haveI : Infinite (LocallyConstant C (ZMod 2)) :=
    SimpleKazhdanSofic.infinite_locallyConstant_zmodTwo C
  refine ⟨?_, elementaryGroup_fg S hS1 hS hn, elementaryGroup_hasKazhdanPropertyT S hS hn⟩
  exact infinite_elementaryGroup_of_injective (ClopenGroupCrossedProduct.coeff Λ C (ZMod 2))
    (ClopenGroupCrossedProduct.coeff_injective Λ C (ZMod 2)) (by omega)

/-- **`thm:general`(a), the infinite, finitely generated and Kazhdan parts**, in the printed
hypotheses of `thm:general`: `Λ` finitely generated, acting minimally and topologically freely on
a Cantor set `C`, `R = LC(C,F_2) ⋊ Λ` generated by a finite `S ∋ 1`, and `n ≥ 3`. -/
def PrintedGeneralPartAWithoutSimplicity : Prop :=
  ∀ (Λ : Type) [Group Λ] [Group.FG Λ] (C : Type) [TopologicalSpace C] [CompactSpace C]
    [TopologicalSpace.MetrizableSpace C] [TotallyDisconnectedSpace C] [PerfectSpace C]
    [Nonempty C] [MulAction Λ C] [ContinuousConstSMul Λ C],
    MulAction.IsMinimal Λ C →
    (∀ ξ : Λ, ξ ≠ 1 → ∀ U : Set C, IsOpen U → U.Nonempty → ∃ z ∈ U, ξ • z ≠ z) →
    ∀ S : Finset (ClopenGroupCrossedProduct Λ C (ZMod 2)),
      (1 : ClopenGroupCrossedProduct Λ C (ZMod 2)) ∈ S →
      Subring.closure (S : Set (ClopenGroupCrossedProduct Λ C (ZMod 2))) = ⊤ →
      ∀ n : ℕ, 3 ≤ n →
        Infinite ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          Group.FG ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          HasKazhdanPropertyT.{0, 0}
            ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2)))

theorem printedGeneralPartAWithoutSimplicity : PrintedGeneralPartAWithoutSimplicity := by
  intro Λ _ _ C _ _ _ _ _ _ _ _ _ _ S hS1 hS n hn
  exact generalInfiniteFGKazhdan Λ C S hS1 hS hn

#audit_closed_axioms GroupApproximation.Full.SK03.printedGeneralPartAWithoutSimplicity

end GroupApproximation.Full.SK03

#audit_axioms GroupApproximation.Full.SK03.infinite_of_perfectSpace
#audit_axioms GroupApproximation.Full.SK03.generalInfiniteFGKazhdan
