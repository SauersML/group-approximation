import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.GeneralRingT.Endpoints
import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.GeneralSimplicity.Endpoints
import GroupApproximation.Meta.AxiomGuard

/-!
# `thm:general`(a)

`simple_kazhdan_sofic_group.tex`, `thm:general`:

> Let a finitely generated group `Λ` act minimally and topologically freely on a Cantor set `C`,
> and let the ring `R = LC(C,F_2) ⋊ Λ` be generated by a finite set `S ∋ 1`.
> (a) For every `n ≥ 3`, the group `EL_n(R)` is an infinite, finitely generated, simple Kazhdan
> group.

`printedGeneralPartA` states and proves (a) as one closed proposition.  Infinite, finitely generated
and Kazhdan come from `generalInfiniteFGKazhdan` (`Endpoints.lean`, this lane); simplicity is
`Full.SK02.generalSimple_printed` (`Full/GeneralSimplicity/Endpoints.lean`).
-/

namespace GroupApproximation.Full.SK03

/-- **`thm:general`(a)** (`simple_kazhdan_sofic_group.tex`): for a finitely generated group `Λ`
acting minimally and topologically freely (no `ξ ≠ 1` fixes a nonempty open set pointwise) on a
Cantor set `C`, with `R = LC(C,F_2) ⋊ Λ` generated by a finite set `S ∋ 1`, and every `n ≥ 3`,
`EL_n(R)` is infinite, finitely generated, simple and Kazhdan. -/
def PrintedGeneralPartA : Prop :=
  ∀ (Λ : Type) [Group Λ] [Group.FG Λ] (C : Type) [TopologicalSpace C] [CompactSpace C]
    [TopologicalSpace.MetrizableSpace C] [TotallyDisconnectedSpace C] [PerfectSpace C]
    [Nonempty C] [MulAction Λ C] [ContinuousConstSMul Λ C],
    MulAction.IsMinimal Λ C →
    (∀ ξ : Λ, ξ ≠ 1 → ∀ U : Set C, IsOpen U → U.Nonempty → ∃ z ∈ U, ξ • z ≠ z) →
    ∀ S : Finset (ClopenGroupCrossedProduct Λ C (ZMod 2)),
      (1 : ClopenGroupCrossedProduct Λ C (ZMod 2)) ∈ S →
      Subring.closure (S : Set (ClopenGroupCrossedProduct Λ C (ZMod 2))) = ⊤ →
      ∀ n : ℕ, 3 ≤ n →
        Infinite ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          Group.FG ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          IsSimpleGroup ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          HasKazhdanPropertyT.{0, 0}
            ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2)))

theorem printedGeneralPartA : PrintedGeneralPartA := by
  intro Λ _ _ C _ _ _ _ _ _ _ _ hmin hfree S hS1 hS n hn
  obtain ⟨hinf, hfg, hT⟩ := generalInfiniteFGKazhdan Λ C S hS1 hS hn
  exact ⟨hinf, hfg, Full.SK02.generalSimple_printed hmin hfree hn, hT⟩

#audit_closed_axioms GroupApproximation.Full.SK03.printedGeneralPartA

end GroupApproximation.Full.SK03
