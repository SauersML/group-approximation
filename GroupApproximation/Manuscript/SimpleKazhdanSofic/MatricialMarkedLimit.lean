/-!
# `simple_kazhdan_sofic_group.tex`, "Finite simple models": the core of the marked limit

`simple_kazhdan_sofic_group.tex` at 696c4b602, "Finite simple models", tex 214–233:

> Let $F$ be the free algebra over $\F_2$ on letters $\tau_s$, $s\in S$, and let $\pi\colon F\to R$
> and $\rho_k\colon F\to M_{N_k}(\F_2)$ be the ring homomorphisms with $\pi(\tau_s)=s$ and
> $\rho_k(\tau_s)=\varphi_k(s)$. Both are onto, so $G$ and $\EL_3(M_{N_k}(\F_2))$ are quotients of
> $\EL_3(F)$. [...] The group $\EL_3(F)$ is generated by the $e_{ij}(1)$ and $e_{ij}(\tau_s)$ [...]
> A word of length $\lambda$ or less in the $e_{ij}(\tau_s)$ has entries of degree at most $\lambda$
> in $F$, and $\varphi_k\circ\pi=\rho_k$ on the finitely many such entries for large $k$. So a word
> that is trivial in $G$ is trivial in $\SL_{3N_k}(\F_2)$ for large $k$. Conversely, for a
> nonprincipal ultrafilter $\omega$ on $\mathbb N$ the $\varphi_k$ define a unital ring homomorphism
> from $R$ to the algebraic ultraproduct $\prod_\omega M_{N_k}(\F_2)$. It maps $G$ to
> $\prod_\omega\SL_{3N_k}(\F_2)$, and its kernel on $G$ is a normal subgroup that does not contain
> $e_{12}(1)$, so it is trivial.

The maps `φ k : R → M k` are taken with the hypotheses of the printed definition of a matricial
ring (tex l.113–117): `φ k 1 = 1`, and for fixed `r, s` additivity and multiplicativity for large
`k`.  This module proves the printed steps at that generality:

* `closure_range_rootMarking_eq_top`: `EL_n` over a ring generated by the values of a family
  containing `1` is generated by the root matrices `e_ij(m s)` (tex 217–222, for both quotients);
* `eventually_map_zero`, `eventually_map_comp_eq`: `φ_k ∘ π = ρ_k` on every element of the free
  algebra for large `k`, by induction from the letters;
* `eventually_mapMatrix_eq_one`: a matrix over `F` sent to `1` by `π` is sent to `1` by `ρ_k` for large
  `k` (tex 223–226, "a word that is trivial in $G$ is trivial in $\SL_{3N_k}(\F_2)$ for large $k$");
* `ultraCon`, `ultraMap`: the algebraic ultraproduct as a quotient of the product ring, and the
  unital ring homomorphism defined by the `φ_k` (tex 226–229);
* `ultraMap_one_ne_zero`, `eq_one_of_ultraMap_eq_one`: the ultraproduct is nontrivial when the `M k`
  eventually are, and the kernel of `EL_n(R) → EL_n(∏_ω M_k)` is trivial when `EL_n(R)` is simple
  (tex 229–231).
-/

namespace GroupApproximation

namespace SimpleKazhdanSofic

open Filter

section Generation

variable {R : Type*} [Ring R] {ι : Type*}

/-- `EL_n(R)` marked by the root matrices `e_ij(m s)`, indexed by pairs `i ≠ j` and `s`. -/
def rootMarking (n : ℕ) (m : ι → R) :
    {p : Fin n × Fin n // p.1 ≠ p.2} × ι → ↥(elementaryGroup (Fin n) R) :=
  fun p => ⟨elementaryUnit p.1.1.1 p.1.1.2 p.1.2 (m p.2), elementaryUnit_mem _ _ _ _⟩

/-- tex 217–222: if the values of `m` include `1` and generate `R` as a ring, then the root matrices
`e_ij(m s)` generate `EL_n(R)` for `n ≥ 3`. -/
theorem closure_range_rootMarking_eq_top {n : ℕ} (hn : 3 ≤ n) (m : ι → R)
    (h1 : (1 : R) ∈ Set.range m) (hgen : Subring.closure (Set.range m) = ⊤) :
    Subgroup.closure (Set.range (rootMarking n m)) = ⊤ := by
  set H : Subgroup (Matrix (Fin n) (Fin n) R)ˣ :=
    (Subgroup.closure (Set.range (rootMarking n m))).map (elementaryGroup (Fin n) R).subtype
  have hroot : ∀ (i j : Fin n) (h : i ≠ j) (c : ι), elementaryUnit i j h (m c) ∈ H :=
    fun i j h c => ⟨rootMarking n m (⟨(i, j), h⟩, c), Subgroup.subset_closure ⟨_, rfl⟩, rfl⟩
  have hunit : ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h (1 : R) ∈ H := by
    intro i j h
    obtain ⟨c, hc⟩ := h1
    exact hc ▸ hroot i j h c
  have hC : Subring.closure (Set.range m) ≤ elementaryCoefficientSubring n (by omega) H hunit := by
    rw [Subring.closure_le]
    rintro _ ⟨c, rfl⟩
    exact (show ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h (m c) ∈ H from
      fun i j h => hroot i j h c)
  have hle : elementaryGroup (Fin n) R ≤ H := by
    change Subgroup.closure _ ≤ H
    rw [Subgroup.closure_le]
    rintro _ ⟨i, j, h, a, rfl⟩
    have ha : a ∈ elementaryCoefficientSubring n (by omega) H hunit :=
      hC (by rw [hgen]; exact Subring.mem_top a)
    exact (show ∀ (i j : Fin n) (h : i ≠ j), elementaryUnit i j h a ∈ H from ha) i j h
  apply Subgroup.map_injective (f := (elementaryGroup (Fin n) R).subtype) Subtype.val_injective
  refine le_antisymm (Subgroup.map_mono le_top) ?_
  rintro _ ⟨g, -, rfl⟩
  exact hle g.2

end Generation

section FreeAlgebraModels

variable {R : Type*} [Ring R] {M : ℕ → Type*} [∀ k, Ring (M k)] (φ : ∀ k, R → M k)

/-- Eventual additivity gives `φ_k(0) = 0` for large `k`. -/
theorem eventually_map_zero (hadd : ∀ r s : R, ∀ᶠ k in atTop, φ k (r + s) = φ k r + φ k s) :
    ∀ᶠ k in atTop, φ k 0 = 0 := by
  filter_upwards [hadd 0 0] with k hk
  rw [add_zero] at hk
  have h := congrArg (fun x => x - φ k 0) hk
  simp only [sub_self, add_sub_cancel_right] at h
  exact h.symm

variable {β : Type*} (π : FreeAlgebra (ZMod 2) β →+* R) (ρ : ∀ k, FreeAlgebra (ZMod 2) β →+* M k)

/-- tex 223–225, "$\varphi_k\circ\pi=\rho_k$ on the finitely many such entries for large $k$": if
`φ_k ∘ π` and `ρ_k` eventually agree on the letters, they eventually agree on every element. -/
theorem eventually_map_comp_eq (h1 : ∀ k, φ k 1 = 1)
    (hadd : ∀ r s : R, ∀ᶠ k in atTop, φ k (r + s) = φ k r + φ k s)
    (hmul : ∀ r s : R, ∀ᶠ k in atTop, φ k (r * s) = φ k r * φ k s)
    (hletter : ∀ b : β, ∀ᶠ k in atTop,
      φ k (π (FreeAlgebra.ι (ZMod 2) b)) = ρ k (FreeAlgebra.ι (ZMod 2) b))
    (m : FreeAlgebra (ZMod 2) β) : ∀ᶠ k in atTop, φ k (π m) = ρ k m := by
  induction m using FreeAlgebra.induction with
  | grade0 r =>
      have hr : ∀ r : ZMod 2, r = 0 ∨ r = 1 := by decide
      rcases hr r with rfl | rfl
      · filter_upwards [eventually_map_zero φ hadd] with k hk
        simp only [map_zero, hk]
      · exact Eventually.of_forall fun k => by simp only [map_one, h1]
  | grade1 b => exact hletter b
  | mul a b ha hb =>
      filter_upwards [ha, hb, hmul (π a) (π b)] with k ha hb hab
      rw [map_mul π, hab, ha, hb, map_mul (ρ k)]
  | add a b ha hb =>
      filter_upwards [ha, hb, hadd (π a) (π b)] with k ha hb hab
      rw [map_add π, hab, ha, hb, map_add (ρ k)]

/-- tex 223–226, "So a word that is trivial in $G$ is trivial in $\SL_{3N_k}(\F_2)$ for large $k$":
a matrix over the free algebra sent to `1` by `π` is sent to `1` by `ρ_k` for large `k`. -/
theorem eventually_mapMatrix_eq_one {n : ℕ} (h1 : ∀ k, φ k 1 = 1)
    (hadd : ∀ r s : R, ∀ᶠ k in atTop, φ k (r + s) = φ k r + φ k s)
    (hmul : ∀ r s : R, ∀ᶠ k in atTop, φ k (r * s) = φ k r * φ k s)
    (hletter : ∀ b : β, ∀ᶠ k in atTop,
      φ k (π (FreeAlgebra.ι (ZMod 2) b)) = ρ k (FreeAlgebra.ι (ZMod 2) b))
    (A : Matrix (Fin n) (Fin n) (FreeAlgebra (ZMod 2) β)) (hA : π.mapMatrix A = 1) :
    ∀ᶠ k in atTop, (ρ k).mapMatrix A = 1 := by
  have hent : ∀ᶠ k in atTop, ∀ i j, φ k (π (A i j)) = ρ k (A i j) :=
    eventually_all.2 fun i => eventually_all.2 fun j =>
      eventually_map_comp_eq φ π ρ h1 hadd hmul hletter (A i j)
  filter_upwards [hent, eventually_map_zero φ hadd] with k hk h0
  refine Matrix.ext fun i j => ?_
  have hij := congrFun (congrFun hA i) j
  simp only [RingHom.mapMatrix_apply, Matrix.map_apply] at hij ⊢
  rw [← hk i j, hij, Matrix.one_apply, Matrix.one_apply]
  split_ifs
  · exact h1 k
  · exact h0

end FreeAlgebraModels

section Ultraproduct

variable (ω : Filter ℕ) (M : ℕ → Type*) [∀ k, Ring (M k)]

/-- **The algebraic ultraproduct** `∏_ω M_k` (tex 227–228): the product ring modulo eventual equality
along `ω`. -/
def ultraCon : RingCon (∀ k, M k) where
  r x y := ∀ᶠ k in ω, x k = y k
  iseqv := ⟨fun _ => Eventually.of_forall fun _ => rfl, fun h => h.mono fun _ h => h.symm,
    fun h g => (h.and g).mono fun _ h => h.1.trans h.2⟩
  mul' := fun {w x y z} h g => (h.and g).mono fun k hk => by
    show w k * y k = x k * z k
    rw [hk.1, hk.2]
  add' := fun {w x y z} h g => (h.and g).mono fun k hk => by
    show w k + y k = x k + z k
    rw [hk.1, hk.2]

variable {ω M} {R : Type*} [Ring R] (φ : ∀ k, R → M k)

/-- tex 226–229: "for a nonprincipal ultrafilter $\omega$ on $\mathbb N$ the $\varphi_k$ define a
unital ring homomorphism from $R$ to the algebraic ultraproduct". -/
noncomputable def ultraMap (hω : ω ≤ atTop) (h1 : ∀ k, φ k 1 = 1)
    (hadd : ∀ r s : R, ∀ᶠ k in atTop, φ k (r + s) = φ k r + φ k s)
    (hmul : ∀ r s : R, ∀ᶠ k in atTop, φ k (r * s) = φ k r * φ k s) :
    R →+* (ultraCon ω M).Quotient where
  toFun r := ((fun k => φ k r : ∀ k, M k) : (ultraCon ω M).Quotient)
  map_one' := congrArg (fun x : ∀ k, M k => (x : (ultraCon ω M).Quotient)) (funext h1)
  map_mul' r s := by
    show ((fun k => φ k (r * s) : ∀ k, M k) : (ultraCon ω M).Quotient) =
      ((fun k => φ k r * φ k s : ∀ k, M k) : (ultraCon ω M).Quotient)
    exact (RingCon.eq (c := ultraCon ω M)).2 ((hmul r s).filter_mono hω)
  map_zero' := by
    show ((fun k => φ k 0 : ∀ k, M k) : (ultraCon ω M).Quotient) =
      ((fun _ => 0 : ∀ k, M k) : (ultraCon ω M).Quotient)
    exact (RingCon.eq (c := ultraCon ω M)).2 ((eventually_map_zero φ hadd).filter_mono hω)
  map_add' r s := by
    show ((fun k => φ k (r + s) : ∀ k, M k) : (ultraCon ω M).Quotient) =
      ((fun k => φ k r + φ k s : ∀ k, M k) : (ultraCon ω M).Quotient)
    exact (RingCon.eq (c := ultraCon ω M)).2 ((hadd r s).filter_mono hω)

/-- The ultraproduct is nontrivial when the factors eventually are. -/
theorem ultraMap_one_ne_zero [NeBot ω] (hω : ω ≤ atTop) (hnt : ∀ᶠ k in atTop, Nontrivial (M k)) :
    (1 : (ultraCon ω M).Quotient) ≠ 0 := by
  intro h
  have h' : ∀ᶠ k in ω, (1 : M k) = 0 :=
    (RingCon.eq (c := ultraCon ω M) (a := 1) (b := 0)).1 h
  obtain ⟨k, hk1, hk2⟩ := (h'.and (hnt.filter_mono hω)).exists
  haveI := hk2
  exact one_ne_zero hk1

/-- tex 229–231, "It maps $G$ to $\prod_\omega\SL_{3N_k}(\F_2)$, and its kernel on $G$ is a normal
subgroup that does not contain $e_{12}(1)$, so it is trivial": for simple `EL_n(R)`, `n ≥ 2`, an
element sent to `1` in `EL_n(∏_ω M_k)` is `1`. -/
theorem eq_one_of_ultraMap_eq_one [NeBot ω] (hω : ω ≤ atTop) (h1 : ∀ k, φ k 1 = 1)
    (hadd : ∀ r s : R, ∀ᶠ k in atTop, φ k (r + s) = φ k r + φ k s)
    (hmul : ∀ r s : R, ∀ᶠ k in atTop, φ k (r * s) = φ k r * φ k s)
    (hnt : ∀ᶠ k in atTop, Nontrivial (M k)) {n : ℕ} (hn : 2 ≤ n)
    [IsSimpleGroup ↥(elementaryGroup (Fin n) R)] (g : ↥(elementaryGroup (Fin n) R))
    (hg : elementaryGroupMap (ι := Fin n) (ultraMap φ hω h1 hadd hmul) g = 1) : g = 1 := by
  set Φ := ultraMap φ hω h1 hadd hmul
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (elementaryGroupMap (ι := Fin n) Φ).ker
      inferInstance with hK | hK
  · have hmem : g ∈ (elementaryGroupMap (ι := Fin n) Φ).ker := MonoidHom.mem_ker.2 hg
    rw [hK] at hmem
    exact Subgroup.mem_bot.1 hmem
  · exfalso
    have hi : (⟨0, by omega⟩ : Fin n) ≠ ⟨1, by omega⟩ := by simp [Fin.ext_iff]
    have hmem : (⟨elementaryUnit _ _ hi (1 : R), elementaryUnit_mem _ _ _ _⟩ :
        ↥(elementaryGroup (Fin n) R)) ∈ (elementaryGroupMap (ι := Fin n) Φ).ker := by
      rw [hK]
      exact Subgroup.mem_top _
    have h3 : elementaryMatrixUnitMap Φ (elementaryUnit _ _ hi (1 : R)) = 1 :=
      congrArg Subtype.val (MonoidHom.mem_ker.1 hmem)
    rw [elementaryMatrixUnitMap_elementaryUnit, map_one] at h3
    have h4 := congrArg
      (fun z : (Matrix (Fin n) (Fin n) (ultraCon ω M).Quotient)ˣ =>
        (z : Matrix (Fin n) (Fin n) (ultraCon ω M).Quotient) ⟨0, by omega⟩ ⟨1, by omega⟩) h3
    simp [elementaryUnit, hi] at h4
    exact ultraMap_one_ne_zero hω hnt h4

end Ultraproduct

end SimpleKazhdanSofic

end GroupApproximation

