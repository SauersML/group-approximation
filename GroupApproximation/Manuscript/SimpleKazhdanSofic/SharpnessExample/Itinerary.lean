import GroupApproximation.Manuscript.SimpleKazhdanSofic.Setting
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Topology.Homeomorph.Lemmas
import Mathlib.Topology.Instances.ZMod
import Mathlib.Topology.Separation.Profinite
import GroupApproximation.Meta.AxiomGuard

/-!
# Sharpness over `ℤ`: the itinerary conjugacy

`simple_kazhdan_sofic_group.tex`, subsection "Sharpness over $\Z$", l.400–401:

> So the ring is generated by finitely many $\sum_jf_ju^j$, the translates of these $f_j$
> generate the clopen sets, and the itinerary map to the atoms they generate is a conjugacy
> onto a subshift.

## Proof route

* `translates T F` is the set of `f ∘ T^n` for `f ∈ F` and `n ∈ ℤ`; the subring it generates is
  invariant under every `h ↦ h ∘ T^m` (`comap_mem_closure_translates`).
* For a subring `L ⊆ LC(X,k)` invariant under all `T^m`, the elements of `LC(X,k) ⋊_T ℤ` whose
  Laurent coefficients all lie in `L` form a subring `coeffSubring`: a product of monomials is
  `f u^a · g u^b = (f · (g ∘ T^{-a})) u^{a+b}`.
* If a finite set `s` generates the crossed product and `F` is the finite set of Laurent
  coefficients of its elements, then `s ⊆ coeffSubring (closure (translates T F))`, hence this
  subring is everything, and reading off the coefficient of `u^0` of `f = f u^0` shows that the
  translates of `F` generate `LC(X,k)` (`exists_finset_translates_generate`).
* The itinerary `x ↦ (n ↦ (f ↦ f(T^n x)))` into `(F → 𝔽₂)^ℤ` is continuous and intertwines `T`
  with the shift. It is injective: if `x ≠ x'`, a clopen `U ∋ x` misses `x'`, and `1_U` lies in
  the subring generated by the translates, on which the points agree. A continuous bijection from
  a compact space onto a Hausdorff space is a homeomorphism.
-/

namespace GroupApproximation.SimpleKazhdanSofic.SharpnessExample

open Multiplicative (ofAdd toAdd)
open SymbolicDynamics.FullShift

section Translates

variable {X : Type} [TopologicalSpace X] (T : X ≃ₜ X) {k : Type} [Ring k]

/-- The translates `f ∘ T^n` (`f ∈ F`, `n ∈ ℤ`) of a set of locally constant functions. -/
def translates (F : Set (LocallyConstant X k)) : Set (LocallyConstant X k) :=
  {h | ∃ f ∈ F, ∃ n : ℤ, LocallyConstant.comap ⟨⇑(T ^ n), (T ^ n).continuous⟩ f = h}

omit [Ring k] in
theorem comap_zpow_zero (f : LocallyConstant X k) :
    LocallyConstant.comap ⟨⇑(T ^ (0 : ℤ)), (T ^ (0 : ℤ)).continuous⟩ f = f := by
  ext x
  show f ((T ^ (0 : ℤ)) x) = f x
  rw [zpow_zero, Homeomorph.one_apply]

theorem comap_mem_translates {F : Set (LocallyConstant X k)} {h : LocallyConstant X k}
    (hh : h ∈ translates T F) (m : ℤ) :
    LocallyConstant.comap ⟨⇑(T ^ m), (T ^ m).continuous⟩ h ∈ translates T F := by
  obtain ⟨f, hf, n, rfl⟩ := hh
  refine ⟨f, hf, n + m, ?_⟩
  ext x
  show f ((T ^ (n + m)) x) = f ((T ^ n) ((T ^ m) x))
  rw [zpow_add, Homeomorph.mul_apply]

/-- The subring generated by the translates is invariant under all `h ↦ h ∘ T^m`. -/
theorem comap_mem_closure_translates {F : Set (LocallyConstant X k)} {h : LocallyConstant X k}
    (hh : h ∈ Subring.closure (translates T F)) (m : ℤ) :
    LocallyConstant.comap ⟨⇑(T ^ m), (T ^ m).continuous⟩ h ∈ Subring.closure (translates T F) := by
  have hle : Subring.closure (translates T F) ≤
      (Subring.closure (translates T F)).comap
        (LocallyConstant.comapRingHom ⟨⇑(T ^ m), (T ^ m).continuous⟩) := by
    rw [Subring.closure_le]
    intro g hg
    exact Subring.subset_closure (comap_mem_translates T hg m)
  exact hle hh

end Translates

section Coefficients

variable {X : Type} [TopologicalSpace X] (T : X ≃ₜ X) (k : Type) [Ring k]

/-- Laurent expansion `r = ∑_{a ∈ supp r} r_a u^a` as a sum of monomials. -/
theorem eq_sum_single (r : ClopenCrossedProduct T k) :
    r = ∑ a ∈ SkewMonoidAlgebra.support r,
      SkewMonoidAlgebra.single a (SkewMonoidAlgebra.coeff r a) :=
  (SkewMonoidAlgebra.sum_single r).symm.trans
    (SkewMonoidAlgebra.sum_def' r SkewMonoidAlgebra.single)

/-- The elements of `LC(X,k) ⋊_T ℤ` all of whose Laurent coefficients lie in `L`. -/
def coeffAddSubgroup (L : Subring (LocallyConstant X k)) :
    AddSubgroup (ClopenCrossedProduct T k) where
  carrier := {r | ∀ g, (ClopenCoeff.of T k).symm (SkewMonoidAlgebra.coeff r g) ∈ L}
  add_mem' := by
    intro a b ha hb g
    rw [SkewMonoidAlgebra.coeff_add, Finsupp.add_apply, map_add]
    exact L.add_mem (ha g) (hb g)
  zero_mem' := by
    intro g
    rw [SkewMonoidAlgebra.coeff_zero, Finsupp.zero_apply, map_zero]
    exact L.zero_mem
  neg_mem' := by
    intro a ha g
    rw [SkewMonoidAlgebra.coeff_neg, Finsupp.neg_apply, map_neg]
    exact L.neg_mem (ha g)

theorem single_mem_coeffAddSubgroup {L : Subring (LocallyConstant X k)} (g : Multiplicative ℤ)
    {c : ClopenCoeff T k} (hc : (ClopenCoeff.of T k).symm c ∈ L) :
    SkewMonoidAlgebra.single g c ∈ coeffAddSubgroup T k L := by
  classical
  intro g'
  rw [SkewMonoidAlgebra.coeff_single, Finsupp.single_apply]
  split_ifs
  · exact hc
  · rw [map_zero]
    exact L.zero_mem

theorem mul_mem_coeffAddSubgroup {L : Subring (LocallyConstant X k)}
    (hL : ∀ m : ℤ, ∀ h ∈ L, LocallyConstant.comap ⟨⇑(T ^ m), (T ^ m).continuous⟩ h ∈ L)
    {a b : ClopenCrossedProduct T k} (ha : a ∈ coeffAddSubgroup T k L)
    (hb : b ∈ coeffAddSubgroup T k L) : a * b ∈ coeffAddSubgroup T k L := by
  rw [eq_sum_single T k a, eq_sum_single T k b, Finset.sum_mul_sum]
  refine sum_mem fun g _ => sum_mem fun g' _ => ?_
  rw [SkewMonoidAlgebra.single_mul_single]
  refine single_mem_coeffAddSubgroup T k _ ?_
  rw [map_mul]
  exact L.mul_mem (ha g) (hL (-toAdd g) _ (hb g'))

/-- For a `T`-invariant subring `L`, the elements with all coefficients in `L` form a subring. -/
def coeffSubring (L : Subring (LocallyConstant X k))
    (hL : ∀ m : ℤ, ∀ h ∈ L, LocallyConstant.comap ⟨⇑(T ^ m), (T ^ m).continuous⟩ h ∈ L) :
    Subring (ClopenCrossedProduct T k) :=
  { coeffAddSubgroup T k L with
    mul_mem' := fun ha hb => mul_mem_coeffAddSubgroup T k hL ha hb
    one_mem' := by
      rw [SkewMonoidAlgebra.one_def]
      exact single_mem_coeffAddSubgroup T k 1 (by rw [map_one]; exact L.one_mem) }

/-- **The translates of the Laurent coefficients of a finite generating set generate `LC(X,k)`.**
-/
theorem exists_finset_translates_generate {s : Finset (ClopenCrossedProduct T k)}
    (hs : Subring.closure (s : Set (ClopenCrossedProduct T k)) = ⊤) :
    ∃ F : Finset (LocallyConstant X k),
      (∀ f ∈ F, ∃ r ∈ s, ∃ g : Multiplicative ℤ, g ∈ SkewMonoidAlgebra.support r ∧
        (ClopenCoeff.of T k).symm (SkewMonoidAlgebra.coeff r g) = f) ∧
      Subring.closure (translates T (F : Set (LocallyConstant X k))) = ⊤ := by
  classical
  let F : Finset (LocallyConstant X k) :=
    s.biUnion fun r => (SkewMonoidAlgebra.support r).image fun g =>
      (ClopenCoeff.of T k).symm (SkewMonoidAlgebra.coeff r g)
  have hF : ∀ f ∈ F, ∃ r ∈ s, ∃ g : Multiplicative ℤ, g ∈ SkewMonoidAlgebra.support r ∧
      (ClopenCoeff.of T k).symm (SkewMonoidAlgebra.coeff r g) = f := by
    intro f hf
    obtain ⟨r, hr, hfr⟩ := Finset.mem_biUnion.mp hf
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hfr
    exact ⟨r, hr, g, hg, rfl⟩
  refine ⟨F, hF, ?_⟩
  have hL : ∀ m : ℤ, ∀ h ∈ Subring.closure (translates T (F : Set (LocallyConstant X k))),
      LocallyConstant.comap ⟨⇑(T ^ m), (T ^ m).continuous⟩ h ∈
        Subring.closure (translates T (F : Set (LocallyConstant X k))) :=
    fun m _ hh => comap_mem_closure_translates T hh m
  have hsub : (s : Set (ClopenCrossedProduct T k)) ⊆
      (coeffSubring T k (Subring.closure (translates T (F : Set (LocallyConstant X k)))) hL :
        Set (ClopenCrossedProduct T k)) := by
    intro r hr g
    by_cases hg : g ∈ SkewMonoidAlgebra.support r
    · refine Subring.subset_closure
        ⟨(ClopenCoeff.of T k).symm (SkewMonoidAlgebra.coeff r g), ?_, 0, comap_zpow_zero T _⟩
      exact Finset.mem_coe.mpr
        (Finset.mem_biUnion.mpr ⟨r, Finset.mem_coe.mp hr, Finset.mem_image.mpr ⟨g, hg, rfl⟩⟩)
    · rw [SkewMonoidAlgebra.notMem_support_iff.mp hg, map_zero]
      exact Subring.zero_mem _
  have htop : coeffSubring T k
      (Subring.closure (translates T (F : Set (LocallyConstant X k)))) hL = ⊤ := by
    rw [eq_top_iff, ← hs, Subring.closure_le]
    exact hsub
  rw [Subring.eq_top_iff']
  intro f
  have hf : ClopenCrossedProduct.coeff T k f ∈ coeffSubring T k
      (Subring.closure (translates T (F : Set (LocallyConstant X k)))) hL := by
    rw [htop]
    exact Subring.mem_top _
  have h1 := hf 1
  rw [ClopenCrossedProduct.coeff_apply, Pestov91.CrossedProduct.C_apply,
    SkewMonoidAlgebra.coeff_single, Finsupp.single_eq_same, RingEquiv.symm_apply_apply] at h1
  exact h1

end Coefficients

section Itinerary

variable {X : Type} [TopologicalSpace X] (T : X ≃ₜ X) (F : Finset (LocallyConstant X (ZMod 2)))

/-- The itinerary of `x`: at time `n`, the atom of the functions of `F` containing `T^n x`,
recorded as the vector of values `f(T^n x)`. -/
def atomItinerary (x : X) : ℤ → (↥F → ZMod 2) :=
  fun n f => f.1 ((T ^ n) x)

theorem continuous_atomItinerary : Continuous (atomItinerary T F) :=
  continuous_pi fun n => continuous_pi fun f => f.1.continuous.comp (T ^ n).continuous

/-- The itinerary intertwines `T^g` with the shift by `g`. -/
theorem shift_atomItinerary (g : ℤ) (x : X) :
    shift g (atomItinerary T F x) = atomItinerary T F ((T ^ g) x) := by
  funext n f
  show f.1 ((T ^ (g + n)) x) = f.1 ((T ^ n) ((T ^ g) x))
  rw [← Homeomorph.mul_apply, ← zpow_add, add_comm]

variable [CompactSpace X]

/-- The image of the itinerary map, a subshift over the finite alphabet `F → 𝔽₂`. -/
def atomSubshift : Subshift (↥F → ZMod 2) ℤ where
  carrier := Set.range (atomItinerary T F)
  isClosed := (isCompact_range (continuous_atomItinerary T F)).isClosed
  mapsTo g := by
    rintro _ ⟨x, rfl⟩
    exact ⟨(T ^ g) x, (shift_atomItinerary T F g x).symm⟩

variable [T2Space X] [TotallyDisconnectedSpace X]

/-- If the translates of `F` generate `LC(X, 𝔽₂)`, the itinerary map is injective. -/
theorem atomItinerary_injective
    (hgen : Subring.closure (translates T (F : Set (LocallyConstant X (ZMod 2)))) = ⊤) :
    Function.Injective (atomItinerary T F) := by
  intro x x' hxx'
  by_contra hne
  obtain ⟨U, hU, hxU, hUx'⟩ := compact_exists_isClopen_in_isOpen
    (isOpen_compl_singleton (x := x')) (Set.mem_compl_singleton_iff.mpr hne)
  have hle : Subring.closure (translates T (F : Set (LocallyConstant X (ZMod 2)))) ≤
      (LocallyConstant.evalRingHom (Y := ZMod 2) x).eqLocus
        (LocallyConstant.evalRingHom (Y := ZMod 2) x') := by
    rw [Subring.closure_le]
    rintro _ ⟨f, hf, n, rfl⟩
    exact congrFun (congrFun hxx' n) ⟨f, Finset.mem_coe.mp hf⟩
  have hmem : LocallyConstant.charFn (ZMod 2) hU ∈
      Subring.closure (translates T (F : Set (LocallyConstant X (ZMod 2)))) := by
    rw [hgen]
    exact Subring.mem_top _
  have h : LocallyConstant.charFn (ZMod 2) hU x = LocallyConstant.charFn (ZMod 2) hU x' :=
    hle hmem
  have h1 : LocallyConstant.charFn (ZMod 2) hU x' = 1 :=
    h.symm.trans ((LocallyConstant.charFn_eq_one (Y := ZMod 2) x hU).mpr hxU)
  exact hUx' ((LocallyConstant.charFn_eq_one (Y := ZMod 2) x' hU).mp h1) (Set.mem_singleton x')

/-- The itinerary map as a homeomorphism onto its subshift. -/
noncomputable def atomItineraryHomeo
    (hgen : Subring.closure (translates T (F : Set (LocallyConstant X (ZMod 2)))) = ⊤) :
    X ≃ₜ (atomSubshift T F).carrier :=
  Continuous.homeoOfEquivCompactToT2
    (f := Equiv.ofInjective (atomItinerary T F) (atomItinerary_injective T F hgen))
    (continuous_induced_rng.2 (continuous_atomItinerary T F))

/-- The itinerary homeomorphism is a conjugacy from `T` to the shift. -/
theorem atomItineraryHomeo_conj
    (hgen : Subring.closure (translates T (F : Set (LocallyConstant X (ZMod 2)))) = ⊤) (x : X) :
    atomItineraryHomeo T F hgen (T x) =
      subshiftHomeo (atomSubshift T F) (atomItineraryHomeo T F hgen x) := by
  apply Subtype.ext
  show atomItinerary T F (T x) = shift 1 (atomItinerary T F x)
  rw [shift_atomItinerary, zpow_one]

end Itinerary

/-- **Sentence l.400 (tex l.400–401).** Let `X` be a compact Hausdorff totally disconnected space
with a homeomorphism `T`, and suppose finitely many elements `s` generate
`LC(X, 𝔽₂) ⋊_T ℤ`. Then there is a finite set `F` of Laurent coefficients `f_j` of elements of `s`
whose translates `f_j ∘ T^n` generate `LC(X, 𝔽₂)` (in particular every clopen indicator), and the
itinerary map to the atoms of `F` is a conjugacy of `(X, T)` onto a subshift over the finite
alphabet `F → 𝔽₂`. -/
theorem manuscriptSentence_itineraryConjugacy {X : Type} [TopologicalSpace X] [CompactSpace X]
    [T2Space X] [TotallyDisconnectedSpace X] (T : X ≃ₜ X)
    (s : Finset (ClopenCrossedProduct T (ZMod 2)))
    (hs : Subring.closure (s : Set (ClopenCrossedProduct T (ZMod 2))) = ⊤) :
    ∃ F : Finset (LocallyConstant X (ZMod 2)),
      (∀ f ∈ F, ∃ r ∈ s, ∃ g : Multiplicative ℤ, g ∈ SkewMonoidAlgebra.support r ∧
        (ClopenCoeff.of T (ZMod 2)).symm (SkewMonoidAlgebra.coeff r g) = f) ∧
      Subring.closure (translates T (F : Set (LocallyConstant X (ZMod 2)))) = ⊤ ∧
      (∀ U : Set X, ∀ hU : IsClopen U, LocallyConstant.charFn (ZMod 2) hU ∈
        Subring.closure (translates T (F : Set (LocallyConstant X (ZMod 2))))) ∧
      ∃ φ : X ≃ₜ (atomSubshift T F).carrier,
        (∀ x, ((φ x : (atomSubshift T F).carrier) : ℤ → (↥F → ZMod 2)) = atomItinerary T F x) ∧
        ∀ x, φ (T x) = subshiftHomeo (atomSubshift T F) (φ x) := by
  obtain ⟨F, hF, hgen⟩ := exists_finset_translates_generate T (ZMod 2) hs
  refine ⟨F, hF, hgen, fun _ _ => ?_, atomItineraryHomeo T F hgen, fun _ => rfl,
    atomItineraryHomeo_conj T F hgen⟩
  rw [hgen]
  exact Subring.mem_top _

#audit_axioms manuscriptSentence_itineraryConjugacy

/-- A compact Hausdorff totally disconnected system whose crossed product `LC(X, 𝔽₂) ⋊_T ℤ` is a
finitely generated ring is conjugate to a subshift over a finite discrete alphabet. -/
theorem exists_subshift_conj_of_fg {X : Type} [TopologicalSpace X] [CompactSpace X]
    [T2Space X] [TotallyDisconnectedSpace X] (T : X ≃ₜ X)
    (hfg : ∃ s : Finset (ClopenCrossedProduct T (ZMod 2)),
      Subring.closure (s : Set (ClopenCrossedProduct T (ZMod 2))) = ⊤) :
    ∃ (A : Type) (_ : TopologicalSpace A) (_ : DiscreteTopology A) (_ : Finite A)
      (S : Subshift A ℤ) (φ : X ≃ₜ S.carrier), ∀ x, φ (T x) = subshiftHomeo S (φ x) := by
  obtain ⟨s, hs⟩ := hfg
  obtain ⟨F, _, hgen⟩ := exists_finset_translates_generate T (ZMod 2) hs
  exact ⟨↥F → ZMod 2, inferInstance, inferInstance, inferInstance, atomSubshift T F,
    atomItineraryHomeo T F hgen, atomItineraryHomeo_conj T F hgen⟩

end GroupApproximation.SimpleKazhdanSofic.SharpnessExample
