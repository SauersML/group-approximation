import GroupApproximation.Manuscript.SimpleKazhdanSofic.LEFHostInstances
import GroupApproximation.Manuscript.SimpleKazhdanSofic.RingGeneration
import GroupApproximation.Manuscript.SimpleKazhdanSofic.ElementaryGroupFacts
import GroupApproximation.Meta.AxiomGuard

/-!
# Pieces of the instances in the last statement of `cor:host`

`simple_kazhdan_sofic_group.tex` at origin/main f34e9c0b1, `cor:host`:

> So one such group contains every recursively presented finitely generated LEF group, for instance
> every finitely presented residually finite group and every $G_Y$ with $L(Y)$ recursive
> (Corollary~\ref{cor:wp}).

The assemblies are in `LEFHostInstances` (adopted from sk-lef-assembly). This module proves its pieces.

* `sum_letterIndicator`: `∑_a e_a = 1`, since `x_0` is exactly one letter;
* `genValueGeneratesStatement : GenValueGeneratesStatement`: `G_X` is generated by the `e_ij(s)` with
  `s ∈ {u, u⁻¹} ∪ {e_a}` ("So the matrices $e_{ij}(s)$ [...] generate $G$, as $1=\sum_ae_a$"), from
  ms-compress-4's `printedElementaryGenerationSumOne` and the generation of `R` (`subring_closure_eq_top`).
-/

namespace GroupApproximation

namespace SimpleKazhdanSofic

open ClopenCrossedProduct SymbolicDynamics.FullShift

variable {A : Type} [TopologicalSpace A] [DiscreteTopology A] [DecidableEq A]

/-- **`∑_a e_a = 1`**: the letter indicators partition `X` by the letter `x_0`. -/
theorem sum_letterIndicator [Fintype A] (S : Subshift A ℤ) : ∑ a : A, letterIndicator S a = 1 := by
  ext x
  change LocallyConstant.evalRingHom x (∑ a : A, letterIndicator S a) =
    LocallyConstant.evalRingHom x 1
  rw [map_sum, map_one]
  show ∑ a : A, (if x.1 0 = a then (1 : ZMod 2) else 0) = 1
  rw [Finset.sum_ite_eq, if_pos (Finset.mem_univ _)]

/-- **`G_X` is generated by the `e_ij(s)`** with `s ∈ {u, u⁻¹} ∪ {e_a : a ∈ A}` (tex l.97–99 and
eq:elementary, at 696c4b602). -/
theorem genValueGeneratesStatement : GenValueGeneratesStatement := by
  intro A _ _ _ _ S
  classical
  have hone : (1 : R S) ∈ AddSubmonoid.closure (ringGenerators S) := by
    rw [← map_one (coeff (subshiftHomeo S) (ZMod 2)), ← sum_letterIndicator S, map_sum]
    exact AddSubmonoid.sum_mem _ fun a _ => AddSubmonoid.subset_closure (Or.inr ⟨a, rfl⟩)
  have hEL := printedElementaryGenerationSumOne (R S) (ringGenerators S) (subring_closure_eq_top S)
    hone
  have hle : elementaryGroup (Fin 3) (R S) ≤
      (Subgroup.closure (Set.range (genValue S))).map (elementaryGroup (Fin 3) (R S)).subtype := by
    calc elementaryGroup (Fin 3) (R S)
        = Subgroup.closure {z | ∃ (i j : Fin 3) (h : i ≠ j) (s : R S), s ∈ ringGenerators S ∧
            elementaryUnit i j h s = z} := hEL
      _ ≤ (Subgroup.closure (Set.range (genValue S))).map (elementaryGroup (Fin 3) (R S)).subtype := by
        refine (Subgroup.closure_le _).2 ?_
        rintro _ ⟨i, j, h, s, hs, rfl⟩
        obtain ⟨c, rfl⟩ : ∃ c : Coeff A, coeffValue S c = s := by
          rcases hs with (rfl | rfl) | ⟨a, rfl⟩
          · exact ⟨.u, rfl⟩
          · exact ⟨.uInv, rfl⟩
          · exact ⟨.letter a, rfl⟩
        exact ⟨genValue S (⟨(i, j), h⟩, c), Subgroup.subset_closure ⟨_, rfl⟩, rfl⟩
  refine eq_top_iff.2 fun g _ => ?_
  obtain ⟨k, hk, hkg⟩ := hle g.2
  have hkeq : k = g := Subtype.ext hkg
  rw [← hkeq]
  exact hk

end SimpleKazhdanSofic

end GroupApproximation

#audit_axioms GroupApproximation.SimpleKazhdanSofic.sum_letterIndicator
#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.genValueGeneratesStatement
