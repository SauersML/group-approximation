import GroupApproximation.Analysis.McDuffTensorHyperfinite
import GroupApproximation.Manuscript.SimpleKazhdanSofic.InfiniteSimpleICC
import GroupApproximation.Meta.AxiomGuard

/-!
# Brown's formulation: the factors of an infinite simple group

`simple_kazhdan_sofic_group.tex` at origin/main 8b36733d7, "Brown's formulation", tex 281–284 (census
9cb80166d, row `97438886a277`), for `G` as in Theorem `thm:general`:

> So `L(G)` is a `II₁` factor, and `L(G) ⊗̄ 𝓡` is a McDuff factor [McDuff] that embeds in `𝓡^ω` and
> whose unitary group contains `G`, as in Brown's question.

`printedBrownFormulationFactors` carries every clause of the sentence except "embeds in `𝓡^ω`", which
the ultraproduct modules prove.  It is stated for every infinite simple group, which covers the groups
of `thm:general`.

* `L(G)` is a II₁ factor: `IIOneFactor.isIIOneFactor_groupVonNeumannAlgebra`, through the infinite
  conjugacy classes of `isICC_of_isSimpleGroup_of_infinite`.
* `L(G) ⊗̄ 𝓡` is a McDuff factor: `McDuff.isMcDuffFactor_tensorHyperfinite`, with `𝓡` the Pauli model
  of lane oa-hyperfinite and `M ⊗̄ 𝓡` the von Neumann algebra on `ℓ²(Γ; H)` generated by `M ⊗ 1` and
  `1 ⊗ 𝓡`.  A McDuff factor is a II₁ factor `M` with `M ≅ M ⊗̄ 𝓡`.
* The unitary group of `L(G) ⊗̄ 𝓡` contains `G`: `McDuff.groupUnitaryHom_injective`, `g ↦ λ(g) ⊗ 1`.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic

universe u

/-- **tex 281–284** (census `97438886a277`), all clauses but "embeds in `𝓡^ω`": for an infinite simple
group `G`, `L(G)` is a II₁ factor, `L(G) ⊗̄ 𝓡` is a McDuff factor, and `G` is a subgroup of the unitary
group of `L(G) ⊗̄ 𝓡`. -/
def PrintedBrownFormulationFactors : Prop :=
  ∀ (G : Type u) [Group G], IsSimpleGroup G → Infinite G →
    IIOneFactor.IsIIOneFactor (GroupVonNeumann.groupVonNeumannAlgebra G) ∧
      McDuff.IsMcDuffFactor (McDuff.tensorHyperfinite (GroupVonNeumann.groupVonNeumannAlgebra G)) ∧
        ∃ φ : G →* unitary
            ↥(McDuff.tensorHyperfinite (GroupVonNeumann.groupVonNeumannAlgebra G)).toStarSubalgebra,
          Function.Injective φ

theorem printedBrownFormulationFactors : PrintedBrownFormulationFactors.{u} := by
  intro G _ _ _
  have hICC := isICC_of_isSimpleGroup_of_infinite G
  exact ⟨IIOneFactor.isIIOneFactor_groupVonNeumannAlgebra G hICC,
    McDuff.isMcDuffFactor_tensorHyperfinite G hICC,
    McDuff.groupUnitaryHom G, McDuff.groupUnitaryHom_injective G⟩

end SimpleKazhdanSofic
end GroupApproximation

#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedBrownFormulationFactors
