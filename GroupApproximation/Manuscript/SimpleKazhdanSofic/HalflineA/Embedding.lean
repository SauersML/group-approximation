import GroupApproximation.Manuscript.SimpleKazhdanSofic.HalflineA.WordProblemReduction
import GroupApproximation.Manuscript.SimpleKazhdanSofic.WordProblemDegreeInvariant
import GroupApproximation.GroupTheory.LevelShiftDeltaModels
import GroupApproximation.Meta.AxiomGuard

/-!
# `lem:halfline` (a), and the normal form of the elements of `Δ`

`simple_kazhdan_sofic_group.tex`, `lem:halfline`:

* tex l.606–608, sentence 210e288644f3:
  > (a) Every finitely generated LEF group Γ is a subgroup of [Δ,Δ] for an infinite finitely generated LEF group Δ
  > whose word problem is Turing reducible to that of Γ.
* tex l.622–625, sentence 81e60da3ab32:
  > An element of Δ of length at most λ is fβ^ℓ with |ℓ| ≤ λ, where f multiplies the level m from the left by an
  > element f(m) of length at most λ, with f(m) = 1 for m < −λ and f(m) = f(λ) for m > λ.

## Proof route

* The group is `Δ = ⟨β, h_γ : γ ∈ E⟩ ≤ Perm (Γ × ℤ)` (`LevelShiftDelta.levelDelta`), for `E` the finite range of a
  generating family `s : ι → Γ`. It equals `closure (range (levelGen s))` (`levelDelta_eq_closure_range`).
* It is infinite and finitely generated (`infinite_levelDelta`, `fg_levelDelta`). Its commutator subgroup contains a
  copy of `Γ` (`exists_levelZeroEmbedding`, from `[β, h_γ] = level-0 multiplication by γ⁻¹`). It is LEF
  (`isTextbookLEF_levelDelta` together with `isLEF_iff_textbook`).
* Word problem. The generators `levelGen s` of `Δ` reduce to `s` (`HalflineA.turingReducible_wordProblemOracle_levelGen`).
  Any finite family of `Δ` reduces to a generating family
  (`turingReducible_wordProblemOracle_of_generates`). So the word problem of every finite family of elements of `Δ`,
  in particular of every finite generating family, is Turing reducible to that of `s`.
* The normal form is `LevelShiftDelta.exists_levelForm_of_mem_wordBall`, with its definitions unfolded.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace HalflineA

open LevelShiftDelta LevelShiftDeltaWordProblem

/-- **`lem:halfline` (a)** (tex l.606–608). Let `Γ` be a finitely generated LEF group, generated by the finite family
`s`. Then there is an infinite finitely generated LEF group `Δ` with an injective homomorphism of `Γ` into `[Δ, Δ]`.
`Δ` has a finite generating family, and the word problem of every finite family of elements of `Δ` is Turing
reducible to the word problem of `Γ` in `s`. -/
theorem manuscriptSentence_halflineEmbedding (Γ : Type) [Group Γ] (ι : Type) [Primcodable ι] [Finite ι]
    (s : ι → Γ) (hs : Subgroup.closure (Set.range s) = ⊤) (hLEF : IsLEF Γ) :
    ∃ (Δ : Type) (_ : Group Δ), Infinite Δ ∧ Group.FG Δ ∧ IsLEF Δ ∧
      (∃ f : Γ →* Δ, Function.Injective f ∧ ∀ γ, f γ ∈ commutator Δ) ∧
      (∃ (κ : Type) (_ : Primcodable κ) (_ : Finite κ) (t : κ → Δ), Subgroup.closure (Set.range t) = ⊤) ∧
      ∀ (κ : Type) [Primcodable κ] [Finite κ] (t : κ → Δ),
        TuringReducible (wordProblemOracle t) (wordProblemOracle s) := by
  have hfinr : (Set.range s).Finite := Set.finite_range s
  have ht : Set.range s = ((hfinr.toFinset : Finset Γ) : Set Γ) := by
    rw [Set.Finite.coe_toFinset]
  have hE : Subgroup.closure ((hfinr.toFinset : Finset Γ) : Set Γ) = ⊤ := by
    rw [← ht]
    exact hs
  have hΔ : levelDelta Γ hfinr.toFinset = Subgroup.closure (Set.range (levelGen s)) :=
    levelDelta_eq_closure_range hfinr.toFinset s ht
  have hinf : Infinite ↥(levelDelta Γ hfinr.toFinset) := infinite_levelDelta hfinr.toFinset
  have hfg : Group.FG ↥(levelDelta Γ hfinr.toFinset) := fg_levelDelta hfinr.toFinset
  have hlef : IsLEF ↥(levelDelta Γ hfinr.toFinset) :=
    (isLEF_iff_textbook _).2 (isTextbookLEF_levelDelta ((isLEF_iff_textbook Γ).1 hLEF) hfinr.toFinset)
  have hemb : ∃ f : Γ →* ↥(levelDelta Γ hfinr.toFinset), Function.Injective f ∧
      ∀ γ, f γ ∈ commutator ↥(levelDelta Γ hfinr.toFinset) :=
    exists_levelZeroEmbedding hfinr.toFinset hE
  rw [hΔ] at hinf hfg hlef hemb
  let H := Subgroup.closure (Set.range (levelGen s))
  let t0 : Option ι → H := fun o => ⟨levelGen s o, Subgroup.subset_closure ⟨o, rfl⟩⟩
  have hgen : Subgroup.closure (Set.range t0) = ⊤ := by
    have hpre : Set.range t0 = ((↑) : H → Equiv.Perm (Γ × ℤ)) ⁻¹' Set.range (levelGen s) := by
      ext x
      constructor
      · rintro ⟨o, rfl⟩
        exact ⟨o, rfl⟩
      · rintro ⟨o, ho⟩
        exact ⟨o, Subtype.ext ho⟩
    rw [hpre]
    exact Subgroup.closure_closure_coe_preimage
  have hred0 : TuringReducible (wordProblemOracle t0) (wordProblemOracle s) := by
    have hcomp : (H.subtype ∘ t0) = levelGen s := funext fun _ => rfl
    rw [← wordProblemOracle_comp_injective t0 H.subtype Subtype.val_injective, hcomp]
    exact turingReducible_wordProblemOracle_levelGen s
  exact ⟨↥H, inferInstance, hinf, hfg, hlef, hemb, ⟨Option ι, inferInstance, inferInstance, t0, hgen⟩,
    fun κ _ _ t => TuringReducible.trans (turingReducible_wordProblemOracle_of_generates hgen t) hred0⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.HalflineA.manuscriptSentence_halflineEmbedding

/-- **The normal form of the elements of `Δ` of length at most `λ`** (tex l.622–625). Let `g` be a product of at most
`λ` letters `β^{±1}` and `h_γ^{±1}` (`γ ∈ E`). Then `g = fβ^ℓ`: it maps `(x, m)` to `(f(m + ℓ) x, m + ℓ)`, with
`|ℓ| ≤ λ`, each `f(m)` of length at most `λ` in `E`, `f(m) = 1` for `m < −λ` and `f(m) = f(λ)` for `m > λ`. The
statement holds for every `λ`, in particular for `λ ≥ 1`. -/
theorem manuscriptSentence_halflineLevelNormalForm {Γ : Type*} [Group Γ] (E : Set Γ) (lam : ℕ)
    {g : Equiv.Perm (Γ × ℤ)} (hg : g ∈ wordBall (insert (levelShift Γ) (levelMul '' E)) lam) :
    ∃ (f : ℤ → Γ) (ℓ : ℤ), (∀ x m, g (x, m) = (f (m + ℓ) * x, m + ℓ)) ∧ |ℓ| ≤ (lam : ℤ) ∧
      (∀ m, f m ∈ wordBall E lam) ∧ (∀ m, m < -(lam : ℤ) → f m = 1) ∧ ∀ m, (lam : ℤ) < m → f m = f lam :=
  exists_levelForm_of_mem_wordBall hg

#audit_axioms GroupApproximation.SimpleKazhdanSofic.HalflineA.manuscriptSentence_halflineLevelNormalForm

end HalflineA
end SimpleKazhdanSofic
end GroupApproximation
