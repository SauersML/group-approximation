import Mathlib.Logic.Relation
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownPresentation
import GroupApproximation.Meta.AxiomGuard

/-!
# Brown presentation I: edge-path encoding and surjectivity of `p : Π → G`

Khanh (arXiv:2609.08428v1), proof of Theorem 5.1 (`thm:raw-criterion`):

> The action of `G` on ordered `k`-frames is transitive [...] In particular, there is one orbit
> in each of dimensions zero, one, and two. [...]
> Every edge traversal is a translate of `E` or its reverse. Starting at a vertex represented by
> a transporter `g`, it is encoded by a word `jT` or `jT⁻¹`, with `j ∈ J`. [...]
> At the endpoint, the difference from a prescribed transporter is again in `J`.

## Setting

`G` acts on a vertex set `V` with a `G`-invariant ordered edge relation `edge`, base vertex
`v₀` and `v₁` with `edge v₀ v₁`. The group acts transitively on ordered edges (`htrans`), `J` is
the stabilizer of `v₀`, and `τ` swaps `v₀` and `v₁`. Only the 1-skeleton of the ordered frame
complex (carto lane 06) enters here, as the relation `edge`, so the results apply to any
`OrderedTwoComplex` through its edge relation and no interface statement from lane 06 is needed.

## Content

* `BrownWalk`: edge walks from `v₀`, each step along an edge or against it.
* `BrownEncodes φ jOf t`: an inductive description of the words `j₁ T^{±1} j₂ T^{±1} ⋯` that
  encode a walk. It is stated for any homomorphism `φ : P →* G` with generators `jOf`, `t`, and
  then specialized to `Π` (`brownJ`, `brownT`, `brownMap`).
* `BrownEncodes.map_smul`: an encoding word transports `v₀` to the endpoint of the walk.
* `BrownEncodes.exists_of_walk`: every walk has an encoding (the transitivity step of the tex).
* `surjective_of_brownEncodes`, `brownMap_surjective`: `p` is onto when the complex is
  connected (tex: "`G` generated by `J` and `τ`").
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

/-- Edge walks from `v₀`, recorded as the list of vertices visited after `v₀` together with
the endpoint. Each step goes along an ordered edge or against it. -/
inductive BrownWalk {V : Type*} (edge : V → V → Prop) (v₀ : V) : List V → V → Prop
  | nil : BrownWalk edge v₀ [] v₀
  | snoc {p : List V} {u b : V} : BrownWalk edge v₀ p u → (edge u b ∨ edge b u) →
      BrownWalk edge v₀ (p ++ [b]) b

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownWalk

/-- Connectivity in the `ReflTransGen` form produces a walk. -/
theorem BrownWalk.exists_of_reflTransGen {V : Type*} {edge : V → V → Prop} {v₀ u : V}
    (hr : Relation.ReflTransGen (fun a b => edge a b ∨ edge b a) v₀ u) :
    ∃ p, BrownWalk edge v₀ p u := by
  induction hr with
  | refl => exact ⟨[], BrownWalk.nil⟩
  | tail _ hbc ih =>
    obtain ⟨p, hp⟩ := ih
    exact ⟨_, BrownWalk.snoc hp hbc⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownWalk.exists_of_reflTransGen

/-- `BrownEncodes φ jOf t edge v₀ v₁ p u w`: the word `w = j₁ T^{±1} j₂ T^{±1} ⋯` encodes the
walk `p` from `v₀` to `u`. A step along the edge `(u, b)` appends `j T`, a step against the
edge `(b, u)` appends `j T⁻¹`. In both cases the transporter `φ (w j)` carries the base edge
`(v₀, v₁)` to the traversed edge, and in particular sends `v₁` to the new vertex `b`. -/
inductive BrownEncodes {G V P ι : Type*} [Group G] [MulAction G V] [Group P] (φ : P →* G)
    (jOf : ι → P) (t : P) (edge : V → V → Prop) (v₀ v₁ : V) : List V → V → P → Prop
  | nil (j : ι) : BrownEncodes φ jOf t edge v₀ v₁ [] v₀ (jOf j)
  | fwd {p : List V} {u b : V} {w : P} (j : ι) : BrownEncodes φ jOf t edge v₀ v₁ p u w →
      edge u b → φ (w * jOf j) • v₁ = b →
      BrownEncodes φ jOf t edge v₀ v₁ (p ++ [b]) b (w * jOf j * t)
  | bwd {p : List V} {u b : V} {w : P} (j : ι) : BrownEncodes φ jOf t edge v₀ v₁ p u w →
      edge b u → φ (w * jOf j) • v₁ = b →
      BrownEncodes φ jOf t edge v₀ v₁ (p ++ [b]) b (w * jOf j * t⁻¹)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownEncodes

section Encoding

variable {G V P ι : Type*} [Group G] [MulAction G V] [Group P] {φ : P →* G} {jOf : ι → P}
  {t : P} {edge : V → V → Prop} {v₀ v₁ : V}

/-- An encoding word transports the base vertex to the endpoint of the walk. -/
theorem BrownEncodes.map_smul (hj : ∀ j, φ (jOf j) • v₀ = v₀) (ht₀ : φ t • v₀ = v₁)
    (ht₁ : φ t • v₁ = v₀) {p : List V} {u : V} {w : P}
    (hw : BrownEncodes φ jOf t edge v₀ v₁ p u w) : φ w • v₀ = u := by
  cases hw with
  | nil j => exact hj j
  | fwd _ _ _ hb =>
    rw [map_mul, mul_smul, ht₀]
    exact hb
  | bwd _ _ _ hb =>
    have hinv : (φ t)⁻¹ • v₀ = v₁ := by
      rw [inv_smul_eq_iff, ht₁]
    rw [map_mul, map_inv, mul_smul, hinv]
    exact hb

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownEncodes.map_smul

/-- Every walk from `v₀` has an encoding word, provided the edge relation is `G`-invariant,
`jOf` hits exactly the stabilizer of `v₀` (at least up to `φ`), `G` is transitive on ordered
edges, and `t` swaps `v₀` and `v₁`. -/
theorem BrownEncodes.exists_of_walk
    (hinv : ∀ (g : G) (a b : V), edge a b → edge (g • a) (g • b))
    (hj : ∀ j, φ (jOf j) • v₀ = v₀) (hstab : ∀ g : G, g • v₀ = v₀ → ∃ j, φ (jOf j) = g)
    (htrans : ∀ a b, edge a b → ∃ g : G, g • v₀ = a ∧ g • v₁ = b)
    (ht₀ : φ t • v₀ = v₁) (ht₁ : φ t • v₁ = v₀) {p : List V} {u : V}
    (hp : BrownWalk edge v₀ p u) : ∃ w, BrownEncodes φ jOf t edge v₀ v₁ p u w := by
  induction hp with
  | nil =>
    obtain ⟨j, -⟩ := hstab 1 (one_smul G v₀)
    exact ⟨_, BrownEncodes.nil j⟩
  | @snoc _ u b _ hstep ih =>
    obtain ⟨w, hw⟩ := ih
    have hwu : φ w • v₀ = u := hw.map_smul hj ht₀ ht₁
    have hu₀ : (φ w)⁻¹ • u = v₀ := by
      rw [inv_smul_eq_iff, hwu]
    rcases hstep with hub | hbu
    · have he := hinv (φ w)⁻¹ u b hub
      rw [hu₀] at he
      obtain ⟨c, hc₀, hc₁⟩ := htrans _ _ he
      obtain ⟨j, hjc⟩ := hstab c hc₀
      refine ⟨_, BrownEncodes.fwd j hw hub ?_⟩
      rw [map_mul, hjc, mul_smul, hc₁, smul_inv_smul]
    · have he := hinv (φ w)⁻¹ b u hbu
      rw [hu₀] at he
      obtain ⟨c, hc₀, hc₁⟩ := htrans _ _ he
      obtain ⟨j, hjc⟩ := hstab (c * φ t) (by rw [mul_smul, ht₀, hc₁])
      refine ⟨_, BrownEncodes.bwd j hw hbu ?_⟩
      rw [map_mul, hjc, mul_smul, mul_smul, ht₁, hc₀, smul_inv_smul]

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownEncodes.exists_of_walk

/-- If the complex is connected, `φ` is surjective: `G` is generated by the images of `jOf`
and `t`. -/
theorem surjective_of_brownEncodes
    (hinv : ∀ (g : G) (a b : V), edge a b → edge (g • a) (g • b))
    (hj : ∀ j, φ (jOf j) • v₀ = v₀) (hstab : ∀ g : G, g • v₀ = v₀ → ∃ j, φ (jOf j) = g)
    (htrans : ∀ a b, edge a b → ∃ g : G, g • v₀ = a ∧ g • v₁ = b)
    (ht₀ : φ t • v₀ = v₁) (ht₁ : φ t • v₁ = v₀)
    (hconn : ∀ u, Relation.ReflTransGen (fun a b => edge a b ∨ edge b a) v₀ u) :
    Function.Surjective φ := by
  intro g
  obtain ⟨p, hp⟩ := BrownWalk.exists_of_reflTransGen (hconn (g • v₀))
  obtain ⟨w, hw⟩ := BrownEncodes.exists_of_walk hinv hj hstab htrans ht₀ ht₁ hp
  have hwg : φ w • v₀ = g • v₀ := hw.map_smul hj ht₀ ht₁
  obtain ⟨j, hjg⟩ := hstab ((φ w)⁻¹ * g) (by rw [mul_smul, ← hwg, inv_smul_smul])
  exact ⟨w * jOf j, by rw [map_mul, hjg, mul_inv_cancel_left]⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.surjective_of_brownEncodes

end Encoding

section Brown

variable {G V : Type*} [Group G] [MulAction G V]

/-- **Surjectivity of Brown's projection** `p : Π →* G`, `p(j) = j`, `p(T) = τ`.

`G` acts on the vertices `V` of a connected complex with a `G`-invariant ordered edge relation,
transitively on ordered edges; `J` is the stabilizer of `v₀`, and `τ` swaps `v₀` and `v₁`.
Then `G` is generated by `J` and `τ`, so `p` is onto. -/
theorem brownMap_surjective (J K : Subgroup G) (hKJ : K ≤ J) (η : K →* K) (h : J) (τ : G)
    (hη : ∀ k : K, ((η k : K) : G) = τ * k * τ⁻¹) (hτh : τ * h * τ = h * τ * h)
    (edge : V → V → Prop) (v₀ v₁ : V)
    (hinv : ∀ (g : G) (a b : V), edge a b → edge (g • a) (g • b))
    (hJ : ∀ g : G, g ∈ J ↔ g • v₀ = v₀)
    (htrans : ∀ a b, edge a b → ∃ g : G, g • v₀ = a ∧ g • v₁ = b)
    (hτ₀ : τ • v₀ = v₁) (hτ₁ : τ • v₁ = v₀)
    (hconn : ∀ u, Relation.ReflTransGen (fun a b => edge a b ∨ edge b a) v₀ u) :
    Function.Surjective (brownMap J K hKJ η h τ hη hτh) :=
  surjective_of_brownEncodes (jOf := brownJ J K hKJ η h) (t := brownT J K hKJ η h) hinv
    (fun j => by
      rw [brownMap_J]
      exact (hJ j).1 j.2)
    (fun g hg => ⟨⟨g, (hJ g).2 hg⟩, brownMap_J J K hKJ η h τ hη hτh _⟩)
    htrans
    (by
      rw [brownMap_T]
      exact hτ₀)
    (by
      rw [brownMap_T]
      exact hτ₁)
    hconn

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.brownMap_surjective

end Brown

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
