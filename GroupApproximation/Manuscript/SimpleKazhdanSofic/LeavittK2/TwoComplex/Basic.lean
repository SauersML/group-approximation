import Mathlib.Logic.Relation
import GroupApproximation.Meta.AxiomGuard

/-!
# Abstract ordered 2-complexes and their edge paths

Lane `sk-leavitt-06`.  Purely combinatorial groundwork for Brown's presentation in
Khanh (arXiv:2609.08428v1), proof of Theorem 5.1 (`thm:raw-criterion`).

Khanh, tex l.424: "In defining the ordered semisimplicial set $X_n(B)$ ... A $(k-1)$-simplex
... is an ordered tuple $(v_1,\ldots,v_k)$ ... Faces delete a vector."

Khanh, tex l.460: "Every edge traversal is a translate of $E$ or its reverse. ... Homotopies of
edge paths are generated by backtracking and passages across individual triangles. ... In
particular, the two ordered edge cells $(u,v)$ and $(v,u)$ remain distinct."

## Design

* `OrderedTwoComplex V`: a relation `edge u v` (ordered edges) and a relation `tri a b c`
  (ordered triangles) whose three faces `(a,b)`, `(b,c)`, `(a,c)` are edges.  Only the
  2-skeleton is recorded; that is all the fundamental group sees.
* `EdgePath X a b`: a finite sequence of steps from `a` to `b`.  A step either traverses an
  ordered edge `(u,v)` forwards (`fwd`, from `u` to `v`) or backwards (`bwd`, from `v` to `u`).
  A backward traversal of `(u,v)` is a different constructor from a forward traversal of
  `(v,u)`, so the two ordered edge cells stay distinct, as l.460 demands.
* API here: `append`, `reverse`, their associativity/involution laws, `Connected`.
  Homotopy (`EdgePath.Homotopic`) is in `TwoComplex.Homotopy`; translation by a group
  action in `TwoComplex.Action`.

No topology is used.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

universe u

/-- An abstract ordered 2-complex on the vertex type `V`: ordered edges `edge u v` and ordered
triangles `tri a b c`, each triangle having its three ordered faces `(a,b)`, `(b,c)`, `(a,c)`
among the edges (Khanh, tex l.424: faces delete a vector). -/
structure OrderedTwoComplex (V : Type u) where
  /-- The ordered edges (1-simplices). -/
  edge : V → V → Prop
  /-- The ordered triangles (2-simplices). -/
  tri : V → V → V → Prop
  /-- Deleting the last vertex of a triangle gives an edge. -/
  tri_edge01 : ∀ {a b c : V}, tri a b c → edge a b
  /-- Deleting the first vertex of a triangle gives an edge. -/
  tri_edge12 : ∀ {a b c : V}, tri a b c → edge b c
  /-- Deleting the middle vertex of a triangle gives an edge. -/
  tri_edge02 : ∀ {a b c : V}, tri a b c → edge a c

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex

namespace OrderedTwoComplex

variable {V : Type u} (X : OrderedTwoComplex V)

/-- Edge paths from `a` to `c`.  `fwd e p` first traverses the ordered edge `e : edge a b`
forwards and then follows `p`; `bwd e p` first traverses the ordered edge `e : edge b a`
backwards (from `a` to `b`) and then follows `p`. -/
inductive EdgePath : V → V → Type u
  | nil (v : V) : EdgePath v v
  | fwd {a b c : V} (e : X.edge a b) (p : EdgePath b c) : EdgePath a c
  | bwd {a b c : V} (e : X.edge b a) (p : EdgePath b c) : EdgePath a c

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath

/-- Any two vertices are joined by an edge path. -/
def Connected : Prop := ∀ a b : V, Nonempty (X.EdgePath a b)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.Connected

namespace EdgePath

variable {X}

/-- Concatenation of edge paths. -/
def append : {a b c : V} → X.EdgePath a b → X.EdgePath b c → X.EdgePath a c
  | _, _, _, nil _, q => q
  | _, _, _, fwd e p, q => fwd e (append p q)
  | _, _, _, bwd e p, q => bwd e (append p q)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.append

@[simp] theorem nil_append {a b : V} (p : X.EdgePath a b) : (nil a).append p = p := rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.nil_append

@[simp] theorem fwd_append {a b c d : V} (e : X.edge a b) (p : X.EdgePath b c)
    (q : X.EdgePath c d) : (fwd e p).append q = fwd e (p.append q) := rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.fwd_append

@[simp] theorem bwd_append {a b c d : V} (e : X.edge b a) (p : X.EdgePath b c)
    (q : X.EdgePath c d) : (bwd e p).append q = bwd e (p.append q) := rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.bwd_append

@[simp] theorem append_nil : ∀ {a b : V} (p : X.EdgePath a b), p.append (nil b) = p
  | _, _, nil _ => rfl
  | _, _, fwd e p => congrArg (fwd e) (append_nil p)
  | _, _, bwd e p => congrArg (bwd e) (append_nil p)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.append_nil

theorem append_assoc : ∀ {a b c d : V} (p : X.EdgePath a b) (q : X.EdgePath b c)
    (r : X.EdgePath c d), (p.append q).append r = p.append (q.append r)
  | _, _, _, _, nil _, _, _ => rfl
  | _, _, _, _, fwd e p, q, r => congrArg (fwd e) (append_assoc p q r)
  | _, _, _, _, bwd e p, q, r => congrArg (bwd e) (append_assoc p q r)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.append_assoc

/-- The reverse path: every forward traversal of an ordered edge becomes a backward traversal
of the same ordered edge, and conversely. -/
def reverse : {a b : V} → X.EdgePath a b → X.EdgePath b a
  | _, _, nil v => nil v
  | _, _, fwd e p => (reverse p).append (bwd e (nil _))
  | _, _, bwd e p => (reverse p).append (fwd e (nil _))

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.reverse

@[simp] theorem reverse_nil (v : V) : (nil v : X.EdgePath v v).reverse = nil v := rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.reverse_nil

@[simp] theorem reverse_fwd {a b c : V} (e : X.edge a b) (p : X.EdgePath b c) :
    (fwd e p).reverse = p.reverse.append (bwd e (nil a)) := rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.reverse_fwd

@[simp] theorem reverse_bwd {a b c : V} (e : X.edge b a) (p : X.EdgePath b c) :
    (bwd e p).reverse = p.reverse.append (fwd e (nil a)) := rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.reverse_bwd

theorem reverse_append : ∀ {a b c : V} (p : X.EdgePath a b) (q : X.EdgePath b c),
    (p.append q).reverse = q.reverse.append p.reverse
  | _, _, _, nil _, q => (append_nil q.reverse).symm
  | _, _, _, fwd e p, q => by
      rw [fwd_append, reverse_fwd, reverse_fwd, reverse_append p q, append_assoc]
  | _, _, _, bwd e p, q => by
      rw [bwd_append, reverse_bwd, reverse_bwd, reverse_append p q, append_assoc]

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.reverse_append

@[simp] theorem reverse_reverse : ∀ {a b : V} (p : X.EdgePath a b), p.reverse.reverse = p
  | _, _, nil _ => rfl
  | _, _, fwd e p =>
      (reverse_append p.reverse (bwd e (nil _))).trans
        (congrArg (fun r => EdgePath.append (bwd e (nil _)).reverse r) (reverse_reverse p))
  | _, _, bwd e p =>
      (reverse_append p.reverse (fwd e (nil _))).trans
        (congrArg (fun r => EdgePath.append (fwd e (nil _)).reverse r) (reverse_reverse p))

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.reverse_reverse

end EdgePath

end OrderedTwoComplex

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
