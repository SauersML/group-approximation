import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.TwoComplex.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# Combinatorial homotopy of edge paths

Lane `sk-leavitt-06`.  Khanh (arXiv:2609.08428v1), tex l.460: "Homotopies of edge paths are
generated by backtracking and passages across individual triangles."

An elementary move (`EdgePath.Move`) replaces, inside an arbitrary context `p · _ · q`,
* a forward traversal of an ordered edge followed by its backward traversal by nothing
  (`backtrackFwd`),
* a backward traversal followed by the forward traversal of the same ordered edge by nothing
  (`backtrackBwd`),
* the two faces `(a,b)·(b,c)` of one ordered triangle `(a,b,c)` by the third face `(a,c)`
  (`triangle`).

`EdgePath.Homotopic` is the equivalence closure (`Relation.EqvGen`) of these moves.  The other
passages across a triangle are derived (see `homotopic_triangle_fwd02_bwd12` here and
`homotopic_triangle_bwd` in `TwoComplex.Reverse`).  `OrderedTwoComplex.SimplyConnected` is
connectedness plus null-homotopy of every loop.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

universe u

namespace OrderedTwoComplex

variable {V : Type u} {X : OrderedTwoComplex V}

namespace EdgePath

/-- Elementary homotopy moves of edge paths, applied inside an arbitrary context. -/
inductive Move {a d : V} : X.EdgePath a d → X.EdgePath a d → Prop
  | backtrackFwd {b c : V} (p : X.EdgePath a b) (e : X.edge b c) (q : X.EdgePath b d) :
      Move (p.append (fwd e (bwd e q))) (p.append q)
  | backtrackBwd {b c : V} (p : X.EdgePath a b) (e : X.edge c b) (q : X.EdgePath b d) :
      Move (p.append (bwd e (fwd e q))) (p.append q)
  | triangle {b₀ b₁ b₂ : V} (p : X.EdgePath a b₀) (t : X.tri b₀ b₁ b₂) (q : X.EdgePath b₂ d) :
      Move (p.append (fwd (X.tri_edge01 t) (fwd (X.tri_edge12 t) q)))
        (p.append (fwd (X.tri_edge02 t) q))

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Move

/-- Combinatorial homotopy rel endpoints: the equivalence relation generated by backtracking
and passages across individual ordered triangles. -/
def Homotopic {a b : V} (p q : X.EdgePath a b) : Prop := Relation.EqvGen Move p q

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic

theorem Move.homotopic {a b : V} {p q : X.EdgePath a b} (h : Move p q) : Homotopic p q :=
  Relation.EqvGen.rel _ _ h

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Move.homotopic

theorem Homotopic.refl {a b : V} (p : X.EdgePath a b) : Homotopic p p :=
  Relation.EqvGen.refl _

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.refl

theorem Homotopic.symm {a b : V} {p q : X.EdgePath a b} (h : Homotopic p q) : Homotopic q p :=
  Relation.EqvGen.symm _ _ h

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.symm

theorem Homotopic.trans {a b : V} {p q r : X.EdgePath a b} (h₁ : Homotopic p q)
    (h₂ : Homotopic q r) : Homotopic p r :=
  Relation.EqvGen.trans _ _ _ h₁ h₂

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.trans

theorem Homotopic.of_eq {a b : V} {p q : X.EdgePath a b} (h : p = q) : Homotopic p q := by
  subst h
  exact Homotopic.refl p

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.of_eq

theorem homotopic_equivalence (a b : V) : Equivalence (@Homotopic V X a b) :=
  ⟨Homotopic.refl, Homotopic.symm, Homotopic.trans⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.homotopic_equivalence

theorem Move.append_right {a b c : V} {p p' : X.EdgePath a b} (h : Move p p')
    (r : X.EdgePath b c) : Move (p.append r) (p'.append r) := by
  cases h with
  | backtrackFwd s e q =>
      simp only [append_assoc]
      exact Move.backtrackFwd s e (q.append r)
  | backtrackBwd s e q =>
      simp only [append_assoc]
      exact Move.backtrackBwd s e (q.append r)
  | triangle s t q =>
      simp only [append_assoc]
      exact Move.triangle s t (q.append r)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Move.append_right

theorem Move.append_left {a b c : V} {q q' : X.EdgePath b c} (h : Move q q')
    (s : X.EdgePath a b) : Move (s.append q) (s.append q') := by
  cases h with
  | backtrackFwd p e r =>
      simp only [← append_assoc]
      exact Move.backtrackFwd (s.append p) e r
  | backtrackBwd p e r =>
      simp only [← append_assoc]
      exact Move.backtrackBwd (s.append p) e r
  | triangle p t r =>
      simp only [← append_assoc]
      exact Move.triangle (s.append p) t r

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Move.append_left

theorem Homotopic.append_right {a b c : V} {p p' : X.EdgePath a b} (h : Homotopic p p')
    (r : X.EdgePath b c) : Homotopic (p.append r) (p'.append r) := by
  have h' : Relation.EqvGen Move p p' := h
  clear h
  induction h' with
  | rel _ _ hm => exact Relation.EqvGen.rel _ _ (hm.append_right r)
  | refl _ => exact Relation.EqvGen.refl _
  | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.append_right

theorem Homotopic.append_left {a b c : V} {q q' : X.EdgePath b c} (h : Homotopic q q')
    (s : X.EdgePath a b) : Homotopic (s.append q) (s.append q') := by
  have h' : Relation.EqvGen Move q q' := h
  clear h
  induction h' with
  | rel _ _ hm => exact Relation.EqvGen.rel _ _ (hm.append_left s)
  | refl _ => exact Relation.EqvGen.refl _
  | symm _ _ _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.append_left

/-- Homotopy is a congruence for concatenation. -/
theorem Homotopic.congr_append {a b c : V} {p p' : X.EdgePath a b} {q q' : X.EdgePath b c}
    (hp : Homotopic p p') (hq : Homotopic q q') : Homotopic (p.append q) (p'.append q') :=
  (hp.append_right q).trans (hq.append_left p')

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.congr_append

theorem Homotopic.congr_fwd {a b d : V} (e : X.edge a b) {q q' : X.EdgePath b d}
    (h : Homotopic q q') : Homotopic (fwd e q) (fwd e q') :=
  h.append_left (fwd e (nil b))

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.congr_fwd

theorem Homotopic.congr_bwd {a b d : V} (e : X.edge b a) {q q' : X.EdgePath b d}
    (h : Homotopic q q') : Homotopic (bwd e q) (bwd e q') :=
  h.append_left (bwd e (nil b))

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.Homotopic.congr_bwd

/-- Backtracking along a forward-then-backward traversal. -/
theorem homotopic_backtrackFwd {a b d : V} (e : X.edge a b) (q : X.EdgePath a d) :
    Homotopic (fwd e (bwd e q)) q :=
  (Move.backtrackFwd (nil a) e q).homotopic

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.homotopic_backtrackFwd

/-- Backtracking along a backward-then-forward traversal. -/
theorem homotopic_backtrackBwd {a b d : V} (e : X.edge b a) (q : X.EdgePath a d) :
    Homotopic (bwd e (fwd e q)) q :=
  (Move.backtrackBwd (nil a) e q).homotopic

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.homotopic_backtrackBwd

/-- Passage across one ordered triangle `(a,b,c)`: `(a,b)·(b,c) ≃ (a,c)`. -/
theorem homotopic_triangle {a b c d : V} (t : X.tri a b c) (q : X.EdgePath c d) :
    Homotopic (fwd (X.tri_edge01 t) (fwd (X.tri_edge12 t) q)) (fwd (X.tri_edge02 t) q) :=
  (Move.triangle (nil a) t q).homotopic

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.homotopic_triangle

/-- Passage across one ordered triangle `(a,b,c)`: `(a,c)·(b,c)⁻¹ ≃ (a,b)`.  This is the move
used by a fan over a backward traversal (Khanh, tex l.539). -/
theorem homotopic_triangle_fwd02_bwd12 {a b c d : V} (t : X.tri a b c) (q : X.EdgePath b d) :
    Homotopic (fwd (X.tri_edge02 t) (bwd (X.tri_edge12 t) q)) (fwd (X.tri_edge01 t) q) :=
  (homotopic_triangle t (bwd (X.tri_edge12 t) q)).symm.trans
    ((homotopic_backtrackFwd (X.tri_edge12 t) q).congr_fwd (X.tri_edge01 t))

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.EdgePath.homotopic_triangle_fwd02_bwd12

end EdgePath

/-- A combinatorial ordered 2-complex is simply connected when it is connected and every edge
loop is homotopic, by backtracking and triangle passages, to the constant path. -/
def SimplyConnected (X : OrderedTwoComplex V) : Prop :=
  X.Connected ∧ ∀ (v : V) (loop : X.EdgePath v v), EdgePath.Homotopic loop (EdgePath.nil v)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.OrderedTwoComplex.SimplyConnected

end OrderedTwoComplex

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
