import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CriterionSetup
import Mathlib.Tactic.Group
import GroupApproximation.Meta.AxiomGuard

/-!
# The Steinberg comparison criterion III: generation (lane sk-leavitt-14)

`St_4(R)` is generated by the roots `x_{ij}(a)` with `j ≠ 3`, together with `w_{32}`.  The
coefficient ring is `L` here, but the argument works over any ring.

* `x₂₃(1) = x₃₂(1)⁻¹ · w₃₂ · x₃₂(1)⁻¹`.
* `x_{i3}(a) = ⁅x_{i2}(a), x₂₃(1)⁆` for `i ∉ {2, 3}`.
* `x₂₃(a) = ⁅x₂₀(a), x₀₃(1)⁆`.
* `PresentedGroup.generated_by` then gives every generator.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion

open GroupApproximation.BooneHigman.SteinbergBasic
open scoped commutatorElement

noncomputable section

/-- A subgroup is closed under commutators. -/
theorem commutatorElement_mem {G : Type*} [Group G] (S : Subgroup G) {g h : G} (hg : g ∈ S)
    (hh : h ∈ S) : ⁅g, h⁆ ∈ S := by
  rw [commutatorElement_def]
  exact S.mul_mem (S.mul_mem (S.mul_mem hg hh) (S.inv_mem hg)) (S.inv_mem hh)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.commutatorElement_mem

/-- **Generation of `St_4(L)`** by the roots `x_{ij}(a)` with `j ≠ 3`, together with `w_{32}`. -/
theorem steinberg_eq_top_of_mem (S : Subgroup (St 4 BinL))
    (hroot : ∀ (i j : Fin 4) (hij : i ≠ j), j ≠ 3 → ∀ a : BinL,
      GroupApproximation.SteinbergGroup.x i j hij a ∈ S)
    (hw : weylLast ∈ S) : S = ⊤ := by
  have hx32 : GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL) ∈ S :=
    hroot 3 2 lastIdx_ne (by decide) 1
  have h23 : GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm (1 : BinL) ∈ S := by
    have heq : GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm (1 : BinL) =
        (GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL))⁻¹ * weylLast *
          (GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL))⁻¹ := by
      rw [weylLast_eq]
      group
    rw [heq]
    exact S.mul_mem (S.mul_mem (S.inv_mem hx32) hw) (S.inv_mem hx32)
  have hi3 : ∀ (i : Fin 4) (hi2 : i ≠ 2) (hi3 : i ≠ 3) (a : BinL),
      GroupApproximation.SteinbergGroup.x i 3 hi3 a ∈ S := by
    intro i hi2 hi3 a
    have hc := GroupApproximation.SteinbergGroup.x_commutator i 2 3 hi2 lastIdx_ne.symm hi3 a
      (1 : BinL)
    rw [mul_one] at hc
    rw [← hc]
    exact commutatorElement_mem S (hroot i 2 hi2 (by decide) a) h23
  have h23a : ∀ a : BinL,
      GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm a ∈ S := by
    intro a
    have h20 : (2 : Fin 4) ≠ 0 := by decide
    have h03 : (0 : Fin 4) ≠ 3 := by decide
    have hc := GroupApproximation.SteinbergGroup.x_commutator (2 : Fin 4) 0 3 h20 h03
      lastIdx_ne.symm a (1 : BinL)
    rw [mul_one] at hc
    rw [← hc]
    exact commutatorElement_mem S (hroot 2 0 h20 (by decide) a) (hi3 0 (by decide) h03 1)
  refine top_unique fun g _ => PresentedGroup.generated_by _ S ?_ g
  rintro ⟨i, j, hij, a⟩
  show GroupApproximation.SteinbergGroup.x i j hij a ∈ S
  by_cases hj : j = 3
  · subst hj
    by_cases hi : i = 2
    · subst hi
      exact h23a a
    · exact hi3 i hi hij a
  · exact hroot i j hij hj a

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.steinberg_eq_top_of_mem

end

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion
