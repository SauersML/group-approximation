import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.LiftPath
import GroupApproximation.Meta.AxiomGuard

/-!
# Brown presentation II: the lift coset is a homotopy invariant (lane sk-leavitt-12)

Khanh, tex l.460: "Homotopies of edge paths are generated by backtracking and passages across
individual triangles. Backtracking cancels inverse words, and a passage across a triangle is a
translate of the relation just computed. Thus no additional path relation is required."

`LiftEnd.move`: an elementary move does not change the coset of the lift endpoint
(`step_back`, `step_tri`).  `homotopic_lift`: by induction on the `EqvGen` homotopy, homotopic
paths are edge paths simultaneously and their lifts from a transporter over the base vertex
end in the same right `J`-coset.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective

universe u v

variable {G : Type u} {V : Type v} [Group G] [MulAction G V]

namespace BrownSetting

variable (S : BrownSetting G V)

/-- An elementary move preserves the lift coset. -/
theorem LiftEnd.move {a : V} {l l' : List V} (hm : S.Move a l l') {x z z' : S.PiGroup}
    (hx : S.p x • S.v0 = a) (h : S.LiftEnd x l z) (h' : S.LiftEnd x l' z') :
    S.SameCoset z z' := by
  cases hm with
  | back l₁ _ _ _ =>
    obtain ⟨y, h1, h2⟩ := LiftEnd.split S l₁ h
    obtain ⟨y', h1', h2'⟩ := LiftEnd.split S l₁ h'
    have hyy' := LiftEnd.unique S h1 h1' (S.sameCoset_refl x)
    cases h2 with
    | cons hs1 _ hl1 =>
      cases hl1 with
      | cons hs2 hw2 hl2 =>
        have hback := S.step_back hs1 hs2 (by rw [hw2, LiftEnd.target S h1, hx])
        exact LiftEnd.unique S hl2 h2' (S.sameCoset_trans (S.sameCoset_symm hback) hyy')
  | tri l₁ _ _ _ _ ht =>
    obtain ⟨y, h1, h2⟩ := LiftEnd.split S l₁ h
    obtain ⟨y', h1', h2'⟩ := LiftEnd.split S l₁ h'
    have hyy' := LiftEnd.unique S h1 h1' (S.sameCoset_refl x)
    cases h2 with
    | cons hs1 hw1 hl1 =>
      cases hl1 with
      | cons hs2 hw2 hl2 =>
        cases h2' with
        | cons hs3 hw3 hl3 =>
          have h3 := S.step_tri hs1 hs2 hs3 hyy'
            (by rw [hw1, hw2, LiftEnd.target S h1, hx]; exact ht) (by rw [hw2, hw3])
          exact LiftEnd.unique S hl2 hl3 h3

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.LiftEnd.move

/-- Homotopic edge paths have lifts ending in the same right `J`-coset. -/
theorem homotopic_lift {a : V} {l l' : List V} (hh : Relation.EqvGen (S.Move a) l l') :
    (S.IsPath a l ↔ S.IsPath a l') ∧
      ∀ x z z' : S.PiGroup, S.p x • S.v0 = a → S.LiftEnd x l z → S.LiftEnd x l' z' →
        S.SameCoset z z' := by
  induction hh with
  | rel _ _ hm =>
    exact ⟨⟨fun _ => (S.move_isPath hm).2, fun _ => (S.move_isPath hm).1⟩,
      fun _ _ _ hx h h' => LiftEnd.move S hm hx h h'⟩
  | refl _ =>
    exact ⟨Iff.rfl, fun x _ _ _ h h' => LiftEnd.unique S h h' (S.sameCoset_refl x)⟩
  | symm _ _ _ ih =>
    exact ⟨ih.1.symm, fun x z z' hx h h' => S.sameCoset_symm (ih.2 x z' z hx h' h)⟩
  | trans _ l₂ _ _ _ ih1 ih2 =>
    refine ⟨ih1.1.trans ih2.1, fun x _ _ hx h h' => ?_⟩
    have hp1 := LiftEnd.isPath S h
    rw [hx] at hp1
    obtain ⟨y, hy⟩ := LiftEnd.exists_of_isPath S l₂ x (by rw [hx]; exact ih1.1.mp hp1)
    exact S.sameCoset_trans (ih1.2 x _ y hx h hy) (ih2.2 x y _ hx hy h')

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.homotopic_lift

end BrownSetting

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective
