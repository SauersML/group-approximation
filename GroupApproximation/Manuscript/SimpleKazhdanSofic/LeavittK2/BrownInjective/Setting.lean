/-!
# Brown presentation II, the combinatorial setting (lane sk-leavitt-12)

Khanh, *General linear groups over L(1,2)*, proof of the Steinberg comparison criterion
(scratchpad `khanh/hvkhanh_general_linear_L_1,2_.tex`, l.452–460):

> "Every edge traversal is a translate of $E$ or its reverse. Starting at a vertex represented
> by a transporter $g$, it is encoded by a word $jT$ or $jT^{-1}$, with $j\in J$. Two choices
> describing the same ordered edge differ by its stabilizer $K$, and the first relations in
> (eq:borel-presentation) identify them. At the endpoint, the difference from a prescribed
> transporter is again in $J$. Homotopies of edge paths are generated by backtracking and
> passages across individual triangles. Backtracking cancels inverse words, and a passage
> across a triangle is a translate of the relation just computed. Thus no additional path
> relation is required. [...] The relation $T^2=1$ follows from the displayed presentation:
> since $h^2=1$, the braid relation implies $(hT)h(hT)^{-1}=T$."
> "[...] the projection $p:\Pi\to G$, given by $p(j)=j$ and $p(T)=\tau$, is an isomorphism."

This lane proves injectivity of `p` purely combinatorially (no topology).

## Interface note

Lanes sk-leavitt-06 (`OrderedTwoComplex`, edge-path homotopy) and sk-leavitt-11
(`brownPresentation`, `brownMap`) were not on disk when this lane was authored.  Instead of
assuming their interfaces through a `...Statement` hypothesis, this lane works with its own
concrete, self-contained definitions under the sub-namespace `BrownInjective`:

* `BrownSetting G V`: a group `G` acting on vertices `V`, with `G`-invariant ordered edges,
  ordered triangles `tri u v w` (whose "long" side `u → w` is an edge), a base edge
  `(v₀, v₁)`, `τ` swapping `v₀ ↔ v₁`, `h ∈ Stab(v₀)` with `h² = 1` and `τhτ = hτh` in `G`,
  and transitivity of `G` on ordered edges and on ordered triangles
  `(g v₀, g v₁, g h v₁)`.  In Khanh's instance: `τ = (12)`, `h = (23)`.
* Edge paths from `u` are lists of the successive vertices; the ordered edges `(u,v)` and
  `(v,u)` stay distinct.
* `Homotopic u` is the `EqvGen` of the two moves: removing a backtrack `c → w → c` and
  replacing `c → v → w` by `c → w` across a triangle `tri c v w`.
* `SimplyConnected`: every closed edge path is homotopic to the empty path.

Lane sk-leavitt-14 needs only to instantiate `BrownSetting` with the frame complex.

## Route (proved in `Presentation`, `Lift`, `Triangle`, `LiftPath`, `Homotopy`, `Injective`)

Put `J = Stab(v₀)`, `Π = ⟨J, T | J-multiplication, T a T⁻¹ = τ a τ⁻¹ (a ∈ K), ThT = hTh⟩`.
A "transporter" `x ∈ Π` sits at vertex `p(x) v₀`; one step along an edge from it is
`x ↦ x·j·T·j'` with `j, j' ∈ J`.  Steps are well defined up to right `J`-cosets (the `K`
ambiguity is absorbed by `T k T⁻¹ = τkτ⁻¹`), backtracking returns to the same coset (using
`T² = 1`), and a triangle passage lands in the same coset (the braid relation).  Hence the
coset of the lift endpoint is a homotopy invariant.  Every `x ∈ Π` is (up to `J`) the lift
endpoint of some path from `v₀` (induction over free-group words).  If `p x = 1`, that path
is a loop, it is null-homotopic, so `x ∈ J`, and `p|_J` is the inclusion, so `x = 1`.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective

universe u v

/-- The data of Brown's setting: a group acting on an ordered two-complex, transitively on
ordered edges and ordered triangles, with the chosen swap `tau` and the element `h`. -/
structure BrownSetting (G : Type u) (V : Type v) [Group G] [MulAction G V] where
  edge : V → V → Prop
  tri : V → V → V → Prop
  edge_smul : ∀ (g : G) (a b : V), edge a b → edge (g • a) (g • b)
  tri_edge : ∀ a b c : V, tri a b c → edge a c
  v0 : V
  v1 : V
  edge_base : edge v0 v1
  edge_transitive : ∀ a b : V, edge a b → ∃ g : G, g • v0 = a ∧ g • v1 = b
  tau : G
  tau_v0 : tau • v0 = v1
  tau_v1 : tau • v1 = v0
  h : G
  h_v0 : h • v0 = v0
  h_mul_h : h * h = 1
  braid : tau * h * tau = h * tau * h
  tri_transitive : ∀ a b c : V, tri a b c →
    ∃ g : G, g • v0 = a ∧ g • v1 = b ∧ g • (h • v1) = c

variable {G : Type u} {V : Type v} [Group G] [MulAction G V]

namespace BrownSetting

variable (S : BrownSetting G V)

/-- `IsPath a l`: the list `l` of successive vertices is an edge path starting at `a`. -/
def IsPath : V → List V → Prop
  | _, [] => True
  | a, b :: l => S.edge a b ∧ IsPath b l

/-- The terminal vertex of the edge path `l` started at `a`. -/
def endpoint : V → List V → V
  | a, [] => a
  | _, b :: l => endpoint b l

theorem isPath_append (a : V) (l₁ l₂ : List V) :
    S.IsPath a (l₁ ++ l₂) ↔ S.IsPath a l₁ ∧ S.IsPath (S.endpoint a l₁) l₂ := by
  induction l₁ generalizing a with
  | nil => simp [IsPath, endpoint]
  | cons b l ih => simp only [List.cons_append, IsPath, endpoint, ih, and_assoc]

/-- The elementary homotopy moves on edge paths from `a`, oriented from the longer path. -/
inductive Move (a : V) : List V → List V → Prop
  | back (l₁ l₂ : List V) (w : V) :
      S.IsPath a (l₁ ++ w :: S.endpoint a l₁ :: l₂) →
      Move a (l₁ ++ w :: S.endpoint a l₁ :: l₂) (l₁ ++ l₂)
  | tri (l₁ l₂ : List V) (b c : V) :
      S.IsPath a (l₁ ++ b :: c :: l₂) → S.tri (S.endpoint a l₁) b c →
      Move a (l₁ ++ b :: c :: l₂) (l₁ ++ c :: l₂)

/-- Combinatorial homotopy of edge paths from `a` (rel endpoints). -/
def Homotopic (a : V) : List V → List V → Prop :=
  Relation.EqvGen (S.Move a)

/-- Combinatorial simple connectivity: every closed edge path is null-homotopic. -/
def SimplyConnected : Prop :=
  ∀ (a : V) (l : List V), S.IsPath a l → S.endpoint a l = a → S.Homotopic a l []

theorem move_isPath {a : V} {l l' : List V} (hm : S.Move a l l') :
    S.IsPath a l ∧ S.IsPath a l' := by
  cases hm with
  | back l₁ l₂ w hp =>
    refine ⟨hp, ?_⟩
    rw [isPath_append] at hp ⊢
    simp only [IsPath] at hp
    exact ⟨hp.1, hp.2.2.2⟩
  | tri l₁ l₂ b c hp ht =>
    refine ⟨hp, ?_⟩
    rw [isPath_append] at hp ⊢
    simp only [IsPath] at hp ⊢
    exact ⟨hp.1, S.tri_edge _ _ _ ht, hp.2.2.2⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.IsPath
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.endpoint
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.isPath_append
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.Move
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.Homotopic
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.SimplyConnected
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.move_isPath

end BrownSetting

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective
