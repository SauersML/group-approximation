import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.Lift
import GroupApproximation.Meta.AxiomGuard

/-!
# Brown presentation II: backtracking and triangle passages (lane sk-leavitt-12)

Khanh, tex l.460: "Homotopies of edge paths are generated by backtracking and passages across
individual triangles. Backtracking cancels inverse words, and a passage across a triangle is a
translate of the relation just computed. Thus no additional path relation is required."

* `step_back`: two steps `x → y → z` with `p(z) v₀ = p(x) v₀` return to the coset `x J`.
  The word is `x·g·T·(j g')·T·j'`, and `j g' ∈ K`, so `T (j g') T ∈ J` (`T_conj_T`).
* `step_tri`: two steps `x → y → z` across an ordered triangle agree, up to `J`, with the
  direct step `x' → z'` (`x' ∈ x J`).  Translating the triangle to the base triangle
  `(v₀, v₁, h v₁)`, the two routes are the words `g₀·T·h·T` and `g₀·h·T·h`, equal by the
  braid relation.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective

universe u v

variable {G : Type u} {V : Type v} [Group G] [MulAction G V]

namespace BrownSetting

variable (S : BrownSetting G V)

/-- Backtracking returns to the starting coset. -/
theorem step_back {x y z : S.PiGroup} (h1 : S.Step x y) (h2 : S.Step y z)
    (hv : S.p z • S.v0 = S.p x • S.v0) : S.SameCoset x z := by
  obtain ⟨g, j, rfl⟩ := h1
  obtain ⟨g', j', rfl⟩ := h2
  simp only [map_mul, S.p_incl, S.p_T, mul_smul, S.J_smul_v0, S.tau_v0] at hv
  have key : S.p x • (g : G) • S.tau • ((j : G) • (g' : G) • S.v1) =
      S.p x • (g : G) • S.tau • S.v1 := by
    rw [S.tau_v1, S.J_smul_v0]
    exact hv
  rw [smul_left_cancel_iff, smul_left_cancel_iff, smul_left_cancel_iff] at key
  have hk : ((j * g' : S.J) : G) • S.v1 = S.v1 := by
    rw [Subgroup.coe_mul, mul_smul]
    exact key
  obtain ⟨k', hk'⟩ := S.T_conj_T (j * g') hk
  refine ⟨g * k' * j', ?_⟩
  simp only [map_mul]
  rw [← hk']
  simp only [map_mul, mul_assoc]

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.step_back

/-- A passage across an ordered triangle lands in the same coset. -/
theorem step_tri {x x' y z z' : S.PiGroup} (hs1 : S.Step x y) (hs2 : S.Step y z)
    (hs3 : S.Step x' z') (hx : S.SameCoset x x')
    (ht : S.tri (S.p x • S.v0) (S.p y • S.v0) (S.p z • S.v0))
    (hz : S.p z' • S.v0 = S.p z • S.v0) : S.SameCoset z z' := by
  obtain ⟨g, hg0, hg1, hg2⟩ := S.tri_transitive _ _ _ ht
  obtain ⟨g0, hpg⟩ : ∃ g0 : S.J, S.p x * (g0 : G) = g :=
    ⟨⟨(S.p x)⁻¹ * g, MulAction.mem_stabilizer_iff.mpr (by rw [mul_smul, hg0, inv_smul_smul])⟩,
      show S.p x * ((S.p x)⁻¹ * g) = g from mul_inv_cancel_left _ _⟩
  have hy0 : S.Step x (x * S.incl g0 * S.T * S.incl 1) := ⟨g0, 1, rfl⟩
  have hvy0 : S.p (x * S.incl g0 * S.T * S.incl 1) • S.v0 = S.p y • S.v0 := by
    rw [S.p_step_v0, ← mul_smul (S.p x) (g0 : G), hpg, hg1]
  have hyy0 := S.step_unique hs1 hy0 (S.sameCoset_refl x) hvy0.symm
  have hz0 : S.Step (x * S.incl g0 * S.T * S.incl 1)
      (x * S.incl g0 * S.T * S.incl 1 * S.incl S.hJ * S.T * S.incl 1) := ⟨S.hJ, 1, rfl⟩
  have hz'0 : S.Step x (x * S.incl (g0 * S.hJ) * S.T * S.incl S.hJ) := ⟨g0 * S.hJ, S.hJ, rfl⟩
  have hbr : S.T * (S.incl S.hJ * S.T) = S.incl S.hJ * (S.T * S.incl S.hJ) := by
    simpa only [mul_assoc] using S.rel_braid
  have heq : x * S.incl g0 * S.T * S.incl 1 * S.incl S.hJ * S.T * S.incl 1 =
      x * S.incl (g0 * S.hJ) * S.T * S.incl S.hJ := by
    simp only [map_one, mul_one, map_mul, mul_assoc, hbr]
  have hvz'0 : S.p (x * S.incl (g0 * S.hJ) * S.T * S.incl S.hJ) • S.v0 = S.p z • S.v0 := by
    rw [S.p_step_v0, Subgroup.coe_mul, mul_smul (g0 : G), ← mul_smul (S.p x) (g0 : G), hpg,
      S.coe_hJ, hg2]
  have hzz0 := S.step_unique hs2 hz0 hyy0 (by rw [heq, hvz'0])
  have hz'z'0 := S.step_unique hs3 hz'0 (S.sameCoset_symm hx) (by rw [hz, hvz'0])
  rw [heq] at hzz0
  exact S.sameCoset_trans hzz0 (S.sameCoset_symm hz'z'0)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective.BrownSetting.step_tri

end BrownSetting

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.BrownInjective
