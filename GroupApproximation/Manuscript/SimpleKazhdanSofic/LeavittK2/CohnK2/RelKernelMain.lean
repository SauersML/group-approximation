import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnK2.CycleBreakSplit
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnK2.RelKernelConj
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnK2.RelKernelPsi
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwoInduction
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnTwo.Relative
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnTwo.RelativeKOne
import GroupApproximation.Steinberg.QuotientExactness
import GroupApproximation.BooneHigman.SteinbergBasic.Naturality
import Mathlib.Data.Fintype.EquivFin
import GroupApproximation.Meta.AxiomGuard

/-!
# Relative `K₂(C_2(𝔽₂), (p))` dies stably (lane `sk-cohn-02`, module 6)

This module proves `CycleBreakRelativeKernelStatement`, with no hypotheses
(`relKer_cycleBreakRelativeKernel`).

Route.  Let `k ∈ K₂(n, C)` with `π k = 1`, and pad `k` to rank `N = n + 3`.
1. By Steinberg quotient exactness, `k` lies in the normal closure of the roots `x_ij(a)` with
   `a ∈ ker π ⊆ (p)`.  That closure lies in `U`, the subgroup generated by the matrix-unit roots
   `x_ij(u(α, β))` (`relKer_U_normal`, which uses `N ≥ 3`).  So `k` is a word in the roots
   `x_ij(u(α, β))` with `α, β` in one finite set `S`.
2. Enumerate `S` injectively by `ω : Fin |S| → S` and pad again to `M = N + N |S|`.  One element
   `G` conjugates every `x_{ij}(u(ω s, ω t))` to `x_{hi i s, hi j t}(p)`
   (`relKer_G_conj_all`).  So `G k G⁻¹ = ψ z` for the corner map
   `ψ : St_M(𝔽₂) → St_M(C)`, `x(λ) ↦ x(λ p)` (`relKer_conj_range`).
3. `ψ z ∈ K₂`, so `ψ z` acts trivially on `C`-vectors.  By intertwining
   (`relKer_act_psi`) and injectivity of `ι` (`p ≠ 0`), `z` acts trivially on `𝔽₂`-vectors.
   Faithfulness of that action at rank `≥ 3` (`FieldTwo.inj_of_three_le`) gives `z = 1`.
   Hence `G k G⁻¹ = 1`, and `k = 1` in `St_M(C)`.

No literature input is used.  All steps are explicit Steinberg-group computations.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

open GroupApproximation.SteinbergGroup GroupApproximation.BooneHigman.SteinbergBasic

local notation "C₂" => CohnTwo (ZMod 2)
local notation "D₂" => CohnTwo.data (ZMod 2)

/-- An injective enumeration of a finite set of words. -/
noncomputable def relKer_enum (S : Finset (List (Fin 2))) (s : Fin S.card) : List (Fin 2) :=
  (S.equivFin.symm s).val

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.relKer_enum

theorem relKer_enum_injective (S : Finset (List (Fin 2))) :
    Function.Injective (relKer_enum S) :=
  fun _ _ h => S.equivFin.symm.injective (Subtype.ext h)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.relKer_enum_injective

theorem relKer_enum_surj (S : Finset (List (Fin 2))) {u : List (Fin 2)} (hu : u ∈ S) :
    ∃ s : Fin S.card, relKer_enum S s = u :=
  ⟨S.equivFin ⟨u, hu⟩, by
    show (S.equivFin.symm (S.equivFin ⟨u, hu⟩)).val = u
    rw [Equiv.symm_apply_apply]⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.relKer_enum_surj

/-- **Step 2.**  After padding, one conjugation moves the subgroup generated by the
matrix-unit roots over `S` into the image of the corner map `ψ`. -/
theorem relKer_conj_range {N : ℕ} (S : Finset (List (Fin 2))) (g : SteinbergGroup (Fin N) C₂)
    (hg : g ∈ Subgroup.closure (relKer_gens N S)) :
    relKer_G D₂ (relKer_enum S) (Finset.univ : Finset (Fin N × Fin S.card)).toList *
        indexMap (Fin.castLEEmb (Nat.le_add_right N (N * S.card))) g *
        (relKer_G D₂ (relKer_enum S) (Finset.univ : Finset (Fin N × Fin S.card)).toList)⁻¹ ∈
      (relKer_psi (J := Fin (N + N * S.card)) (ZMod 2) (D₂).p (D₂).p_mul_p).range := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
      obtain ⟨i, j, hij, u, v, hu, hv, rfl⟩ := hg
      obtain ⟨s, rfl⟩ := relKer_enum_surj S hu
      obtain ⟨t, rfl⟩ := relKer_enum_surj S hv
      rw [indexMap_x]
      refine MonoidHom.mem_range.mpr
        ⟨x (relKer_hi N S.card i s) (relKer_hi N S.card j t) (relKer_hi_ne hij s t) 1, ?_⟩
      rw [relKer_psi_x, map_one, one_mul]
      exact (relKer_G_conj_all D₂ (relKer_enum S) (relKer_enum_injective S) i j hij s t).symm
  | one =>
      rw [map_one, mul_one, mul_inv_cancel]
      exact Subgroup.one_mem _
  | mul a b _ _ ha hb =>
      rw [map_mul, relKer_grp_conj_mul]
      exact Subgroup.mul_mem _ ha hb
  | inv a _ ha =>
      rw [map_inv, relKer_grp_conj_inv]
      exact Subgroup.inv_mem _ ha

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.relKer_conj_range

/-- **Target (lane `sk-cohn-02`): relative stable `K₂(C_2(𝔽₂), (p))` vanishes in
`K₂(C_2(𝔽₂))`.**  Proved outright, with no hypotheses and no literature input. -/
theorem relKer_cycleBreakRelativeKernel : CycleBreakRelativeKernelStatement := by
  intro n k hk hπ
  have h3 : n ≤ n + 3 := Nat.le_add_right n 3
  -- Step 1: `k` padded to rank `n + 3` lies in `U`.
  have hker : indexMap (Fin.castLEEmb h3) k ∈
      (ringMap (I := Fin (n + 3)) (CohnTwo.toLeavitt (ZMod 2)).toRingHom).ker := by
    rw [MonoidHom.mem_ker, ← CohnTwo.indexMap_castLE_ringMap, hπ, map_one]
  rw [ringMap_ker_eq_kernelRootClosure (I := Fin (n + 3))
    (CohnTwo.toLeavitt (ZMod 2)).toRingHom (CohnTwo.toLeavitt_surjective (ZMod 2))] at hker
  haveI : (relKer_U (n + 3)).Normal := relKer_U_normal (by omega)
  have hle : kernelRootClosure (I := Fin (n + 3)) (CohnTwo.toLeavitt (ZMod 2)).toRingHom ≤
      relKer_U (n + 3) := by
    apply Subgroup.normalClosure_le_normal
    rintro g ⟨i, j, hij, a, ha, rfl⟩
    exact relKer_x_mem_U (n + 3) i j hij a (CohnTwo.mem_pIdeal_of_toLeavitt_eq_zero (ZMod 2) ha)
  obtain ⟨S, hS⟩ := (relKer_mem_U_iff (n + 3) _).mp (hle hker)
  -- Step 2: conjugate into the image of `ψ`.
  obtain ⟨z, hz⟩ := MonoidHom.mem_range.mp (relKer_conj_range S _ hS)
  -- Step 3: `z = 1`.
  have hk' := indexMap_mem_K2 (Fin.castLEEmb (Nat.le_add_right (n + 3) ((n + 3) * S.card)))
    (indexMap_mem_K2 (Fin.castLEEmb h3) hk)
  have hK2 : relKer_psi (J := Fin (n + 3 + (n + 3) * S.card)) (ZMod 2) (D₂).p (D₂).p_mul_p z ∈
      K2 (Fin (n + 3 + (n + 3) * S.card)) C₂ := by
    rw [hz]
    exact (K2_normal _ _).conj_mem _ hk' _
  have hproj := (mem_K2_iff _).mp hK2
  have hM3 : 3 ≤ n + 3 + (n + 3) * S.card :=
    le_trans (by omega : 3 ≤ n + 3) (Nat.le_add_right _ _)
  have hz1 : z = 1 := FieldTwo.inj_of_three_le hM3 z (fun v => by
    have hv := FieldTwo.act_of_projection_eq_one hproj (relKer_iota (D₂).p v)
    rw [relKer_act_psi] at hv
    exact relKer_iota_injective (D₂).p (CohnTwo.data_p_ne_zero (ZMod 2)) hv)
  rw [hz1, map_one] at hz
  refine ⟨n + 3 + (n + 3) * S.card, h3.trans (Nat.le_add_right _ _), ?_⟩
  rw [← CohnTwo.indexMap_castLE_castLE h3 (Nat.le_add_right (n + 3) ((n + 3) * S.card))]
  exact conj_eq_one_iff.mp hz.symm

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.relKer_cycleBreakRelativeKernel

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
