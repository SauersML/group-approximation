import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnTwo.RelativeKOne
import GroupApproximation.Meta.AxiomGuard

/-!
# Stable `K₂(C_2(𝔽₂))`: splitting off the base field

Lane `sk-leavitt-21`.  Write `C = C_2(𝔽₂)` and `ι = algebraMap 𝔽₂ C`.  The target
`BinaryCohnStableK2TrivialStatement` says that every `k ∈ K₂(n, C)` dies in some `St_N(C)`.

**Not closed in Lean.**  Every known proof combines two independent inputs:

* (field) stable `K₂(𝔽₂) = 0`: Bruhat decomposition of `St_N(𝔽₂)` plus Steinberg symbols
  (the only unit of `𝔽₂` is `1`);
* (heart) stable surjectivity of `K₂(𝔽₂) → K₂(C)`, the degree-two part of the
  Ara–Brustenga–Cortiñas `K`-equivalence `𝔽₂ → C_2(𝔽₂)`.

The repository has neither.  The direct routes checked on paper all fail:
* free-algebra gluing: the relative `K₁` of the kernel is as hard as the target;
* retraction gluing: `C` has no ring map to `𝔽₂` and no finite-dimensional module;
* Fock or flasque swindles: blocked by `K₀(C) = ℤ` with `[p] = -[1]`;
* the `(p)`-exact sequence: circular with `K₂(L)`.

This file separates the two inputs.

* `CohnBaseChangeK2Statement` (**the isolated gap**): after stabilisation, every
  `k ∈ K₂(n, C)` is `ι y` for some `y ∈ K₂(N, 𝔽₂)`.
* `FieldTwoStableK2Statement`: stable `K₂(𝔽₂) = 0`.  This is a classical interface
  about a finite field, with nothing to do with Cohn algebras.  There is no such
  interface in the repository yet, so it is stated here, following the brief's rule 6.

Endpoints:
* `cohnStableK2_of_baseChange`: the target follows from the two statements;
* `baseChange_of_cohnStableK2`: the target implies the gap, so the gap is not
  logically stronger than the target;
* `leavittK2_of_baseChange`: stable `K₂(L_{𝔽₂}(1,2)) = 0` follows from the two
  statements, via lane 18.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

/-- **Stable surjectivity of `K₂(𝔽₂) → K₂(C_2(𝔽₂))`** in finite-stage form.  Every
`k ∈ K₂(n, C_2)` becomes, in some `St_N(C_2)` with `n ≤ N`, the coefficientwise image under
`ι = algebraMap 𝔽₂ C_2` of an element `y ∈ K₂(N, 𝔽₂)`.

*Why it is true.*  Ara–Brustenga–Cortiñas (2009) show that `ι` induces an isomorphism
`K_*(𝔽₂) ≅ K_*(C_2(𝔽₂))`.  In particular `K₂(ι)` is onto.  Stable `K₂` is the filtered
colimit of the `K₂(N, -)`, and `ι` commutes with padding.  So the class of `k` is the class of
some `ι y₀`, with `y₀ ∈ K₂(M, 𝔽₂)`.  Two elements with the same class agree at a finite stage.
Pad `y₀` to that stage to get `y`.

*Why it is strictly smaller than the target.*  `baseChange_of_cohnStableK2` derives it from
the target with `y = 1`.  `cohnStableK2_of_baseChange` recovers the target from this
statement together with `K₂(𝔽₂) = 0`.  So this statement is the target minus the entire
field computation: the Bruhat and symbol analysis of `St_N(𝔽₂)` drops out.  What remains is
the ring-theoretic transfer from `C_2` down to its base field.  That transfer is where the
quasi-free structure of `C_2` is used: the weak algorithm, the corner isomorphism
`(1-p)C_2(1-p) ≅ M₂(C_2)` and `pC_2p = 𝔽₂ p`. -/
def CohnBaseChangeK2Statement : Prop :=
  ∀ (n : ℕ) (k : GroupApproximation.SteinbergGroup (Fin n) (CohnTwo (ZMod 2))),
    k ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin n) (CohnTwo (ZMod 2)) →
    ∃ (N : ℕ) (h : n ≤ N) (y : GroupApproximation.SteinbergGroup (Fin N) (ZMod 2)),
      y ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin N) (ZMod 2) ∧
      GroupApproximation.SteinbergGroup.ringMap (algebraMap (ZMod 2) (CohnTwo (ZMod 2))) y =
        GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb h) k

/-- **Stable `K₂(𝔽₂) = 0`** in finite-stage form: every `y ∈ K₂(n, 𝔽₂)` dies in some
`St_M(𝔽₂)`, `n ≤ M`.

*Why it is true.*  For a field `F`, stable `K₂(F)` is generated by Steinberg symbols `{u, v}`
with `u, v ∈ Fˣ` (Bruhat decomposition; Steinberg 1962, Milnor, *Introduction to algebraic
K-theory*, §9–§11).  Over `𝔽₂` the only symbol is `{1, 1} = 1`.  Finite stages detect the
stable group.  This is a classical fact about one finite field and involves no Cohn algebra.
It is an interface, not part of this lane's gap. -/
def FieldTwoStableK2Statement : Prop :=
  ∀ (n : ℕ) (y : GroupApproximation.SteinbergGroup (Fin n) (ZMod 2)),
    y ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin n) (ZMod 2) →
    ∃ (M : ℕ) (h : n ≤ M), GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb h) y = 1

/-- **Lane endpoint.**  Stable surjectivity `K₂(𝔽₂) → K₂(C_2)` together with `K₂(𝔽₂) = 0`
gives stable `K₂(C_2(𝔽₂)) = 0`.  Pad `k` to `ι y`, kill `y` over `𝔽₂`, and push the relation
through `ι`, which commutes with padding. -/
theorem cohnStableK2_of_baseChange (hB : CohnBaseChangeK2Statement)
    (hF : FieldTwoStableK2Statement) : BinaryCohnStableK2TrivialStatement := by
  intro n k hk
  obtain ⟨N, hN, y, hyK, hy⟩ := hB n k hk
  obtain ⟨M, hM, hyM⟩ := hF N y hyK
  refine ⟨M, hN.trans hM, ?_⟩
  rw [← CohnTwo.indexMap_castLE_castLE hN hM, ← hy, CohnTwo.indexMap_castLE_ringMap, hyM,
    map_one]

/-- The isolated gap is implied by the target (take `y = 1`), so it is not logically stronger
than the target. -/
theorem baseChange_of_cohnStableK2 (hS : BinaryCohnStableK2TrivialStatement) :
    CohnBaseChangeK2Statement := by
  intro n k hk
  obtain ⟨N, hN, hNk⟩ := hS n k hk
  refine ⟨N, hN, 1, Subgroup.one_mem _, ?_⟩
  rw [map_one, hNk]

/-- **Downstream endpoint.**  The two statements give stable `K₂(L_{𝔽₂}(1,2)) = 0` through
lane 18's `binaryLeavittStableK2Trivial_of_cohnStableK2`. -/
theorem leavittK2_of_baseChange (hB : CohnBaseChangeK2Statement)
    (hF : FieldTwoStableK2Statement) : BinaryLeavittStableK2TrivialStatement :=
  binaryLeavittStableK2Trivial_of_cohnStableK2 (cohnStableK2_of_baseChange hB hF)

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnBaseChangeK2Statement
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.FieldTwoStableK2Statement
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.cohnStableK2_of_baseChange
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.baseChange_of_cohnStableK2
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.leavittK2_of_baseChange
