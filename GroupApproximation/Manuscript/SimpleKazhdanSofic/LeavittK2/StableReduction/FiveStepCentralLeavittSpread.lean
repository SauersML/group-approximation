import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.StableReduction.FiveStepCentralRoot
import GroupApproximation.Leavitt.Leavitt
import GroupApproximation.Meta.AxiomGuard

/-!
# From the corner root `x_{ij}(s₀t₀)` to the root `x_{ij}(1)` (lane sk-leavitt-35, part 1)

Let `R` be a ring with a Leavitt family `t₀ s₀ = t₁ s₁ = 1`, `t₀ s₁ = t₁ s₀ = 0`,
`s₀ t₀ + s₁ t₁ = 1`.  Write `p₀ = s₀ t₀` and `p₁ = s₁ t₁`, two complementary idempotents.

This module proves, over any such ring and for `n ≥ 3`, that a normal subgroup of `St_n(R)`
containing the *corner root* `x_{ij}(p₀)` contains `x_{ij}(1)`
(`fiveStepCentralLeavitt_mem_of_corner_mem`).

## Route

* Two-sided spreading (`fiveStepCentralLeavitt_map_x_mul_mul`, any ring): if a homomorphism kills
  `x_{ij}(c)`, it kills `x_{ij}(a c b)`, through a third index `m`:
  `x_{mj}(ac) = ⁅x_{mi}(a), x_{ij}(c)⁆`, `x_{ij}(ac) = ⁅x_{im}(1), x_{mj}(ac)⁆`,
  `x_{im}(acb) = ⁅x_{ij}(ac), x_{jm}(b)⁆`, `x_{ij}(acb) = ⁅x_{im}(acb), x_{mj}(1)⁆`.
* The Leavitt identity `p₁ = (s₁ t₀) · p₀ · (s₀ t₁)` (`fiveStepCentralLeavitt_corner_identity`),
  so `x_{ij}(p₁)` is killed too, and `x_{ij}(1) = x_{ij}(p₀) x_{ij}(p₁)`.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

open scoped commutatorElement
open GroupApproximation.SteinbergGroup

/-- **Two-sided spreading of a killed root coefficient**, over any ring: if `φ` kills
`x_{ij}(c)` and `m ∉ {i, j}`, then `φ` kills `x_{ij}(a c b)`. -/
theorem fiveStepCentralLeavitt_map_x_mul_mul {R : Type*} [Ring R] {Q : Type*} [Group Q] {n : ℕ}
    (φ : SteinbergGroup (Fin n) R →* Q) {i j m : Fin n} (hij : i ≠ j) (him : i ≠ m)
    (hjm : j ≠ m) {c : R} (hc : φ (x i j hij c) = 1) (a b : R) :
    φ (x i j hij (a * c * b)) = 1 := by
  have hmi : m ≠ i := Ne.symm him
  have hmj : m ≠ j := Ne.symm hjm
  -- `x_{mj}(a c) = ⁅x_{mi}(a), x_{ij}(c)⁆`.
  have h1 : φ (x m j hmj (a * c)) = 1 := by
    rw [← x_commutator m i j hmi hij hmj a c, map_commutatorElement, hc,
      commutatorElement_one_right]
  -- `x_{ij}(a c) = ⁅x_{im}(1), x_{mj}(a c)⁆`.
  have h2 : φ (x i j hij (a * c)) = 1 := by
    have e := x_commutator i m j him hmj hij (1 : R) (a * c)
    rw [one_mul] at e
    rw [← e, map_commutatorElement, h1, commutatorElement_one_right]
  -- `x_{im}(a c b) = ⁅x_{ij}(a c), x_{jm}(b)⁆`.
  have h3 : φ (x i m him (a * c * b)) = 1 := by
    rw [← x_commutator i j m hij hjm him (a * c) b, map_commutatorElement, h2,
      commutatorElement_one_left]
  -- `x_{ij}(a c b) = ⁅x_{im}(a c b), x_{mj}(1)⁆`.
  have e := x_commutator i m j him hmj hij (a * c * b) (1 : R)
  rw [mul_one] at e
  rw [← e, map_commutatorElement, h3, commutatorElement_one_left]

#audit_axioms
  GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.fiveStepCentralLeavitt_map_x_mul_mul

/-- **The Leavitt corner identity** `p₁ = (s₁ t₀) · p₀ · (s₀ t₁)`: the idempotent `p₁ = s₁ t₁`
lies in the two-sided ideal generated by `p₀ = s₀ t₀`. -/
theorem fiveStepCentralLeavitt_corner_identity {R : Type*} [Ring R] (L : LeavittFamily R) :
    L.s1 * L.t0 * (L.s0 * L.t0) * (L.s0 * L.t1) = L.s1 * L.t1 := by
  calc L.s1 * L.t0 * (L.s0 * L.t0) * (L.s0 * L.t1)
      = L.s1 * ((L.t0 * L.s0) * ((L.t0 * L.s0) * L.t1)) := by simp only [mul_assoc]
    _ = L.s1 * L.t1 := by rw [L.t0_s0, one_mul, one_mul]

#audit_axioms
  GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.fiveStepCentralLeavitt_corner_identity

/-- **Killing the corner root kills the unit root**, for `n ≥ 3`: if `φ` kills `x_{ij}(s₀ t₀)`,
then `φ` kills `x_{ij}(1)`. -/
theorem fiveStepCentralLeavitt_map_x_one_of_corner {R : Type*} [Ring R] (L : LeavittFamily R)
    {Q : Type*} [Group Q] {n : ℕ} (hn : 3 ≤ n) (φ : SteinbergGroup (Fin n) R →* Q)
    {i j : Fin n} (hij : i ≠ j) (h0 : φ (x i j hij (L.s0 * L.t0)) = 1) :
    φ (x i j hij (1 : R)) = 1 := by
  obtain ⟨m, him, hjm⟩ := fiveStepCentral_exists_third hn i j
  have h1 : φ (x i j hij (L.s1 * L.t1)) = 1 := by
    rw [← fiveStepCentralLeavitt_corner_identity L]
    exact fiveStepCentralLeavitt_map_x_mul_mul φ hij him hjm h0 (L.s1 * L.t0) (L.s0 * L.t1)
  rw [← L.sum_range, ← x_mul i j hij (L.s0 * L.t0) (L.s1 * L.t1), map_mul, h0, h1, mul_one]

#audit_axioms
  GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.fiveStepCentralLeavitt_map_x_one_of_corner

/-- **A normal subgroup of `St_n(R)` containing `x_{ij}(s₀ t₀)` contains `x_{ij}(1)`**, for
`n ≥ 3` and any ring `R` with a Leavitt family. -/
theorem fiveStepCentralLeavitt_mem_of_corner_mem {R : Type*} [Ring R] (L : LeavittFamily R)
    {n : ℕ} (hn : 3 ≤ n) (N : Subgroup (SteinbergGroup (Fin n) R)) [N.Normal] {i j : Fin n}
    (hij : i ≠ j) (h0 : x i j hij (L.s0 * L.t0) ∈ N) : x i j hij (1 : R) ∈ N := by
  have hk0 : x i j hij (L.s0 * L.t0) ∈ (QuotientGroup.mk' N).ker := by
    rw [QuotientGroup.ker_mk']
    exact h0
  have hk : x i j hij (1 : R) ∈ (QuotientGroup.mk' N).ker :=
    MonoidHom.mem_ker.mpr
      (fiveStepCentralLeavitt_map_x_one_of_corner L hn (QuotientGroup.mk' N) hij
        (MonoidHom.mem_ker.mp hk0))
  rw [QuotientGroup.ker_mk'] at hk
  exact hk

#audit_axioms
  GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.fiveStepCentralLeavitt_mem_of_corner_mem

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
