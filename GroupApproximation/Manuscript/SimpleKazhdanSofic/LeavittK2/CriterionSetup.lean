import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EndpointInterfaces
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Weyl.Basic
import GroupApproximation.Meta.AxiomGuard

/-!
# The Steinberg comparison criterion I: the vertex setting (lane sk-leavitt-14)

Khanh (arXiv:2609.08428), proof of Theorem 5.1, specialized to rank four over
`L = L_{𝔽₂}(1,2)`.  The corpus pads along `Fin.castSucc`, so Khanh's special index is `3` here.

* `vertexStab = J`: the stabilizer `{g ∈ GL_4(L) | g e₃ = e₃}` of the base vertex `e₃`.
* `elementaryUnit_mem_vertexStab`: `1 + E_{ij}(a) ∈ J` when `j ≠ 3`.
* `weylLast = w_{32} = x₃₂(1) x₂₃(1) x₃₂(1)` in `St_4(L)` (lane 01's `weyl`), and
  `swapLast = τ`, its image in `GL_4(L)`.  This is the swap of the base edge `(e₃, e₂)`.
* `swapMid = h`, the image of `w_{21}`.  This is the element `h ∈ J` of Brown's triangle relation.

## Route (whole criterion)

`CriterionInterfaces` states the two inputs: Brown's universal property of `GL_4(L)`
(lanes 06–12) and the lift `σ : J → St_4(L)` (lanes 05, 13).  `CriterionGeneration` shows that
`St_4(L)` is generated by `x_{ij}(a)` with `j ≠ 3`, together with `w_{32}`.  `Criterion` extends
`σ` to `F : GL_4(L) → St_4(L)`.  `F ∘ projection` fixes every generator, so it is the identity,
hence `projection` is injective and `K₂(4, L) = ⊥`.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion

open GroupApproximation.BooneHigman.SteinbergBasic
open scoped Matrix

noncomputable section

/-- The binary Leavitt algebra `L = L_{𝔽₂}(1,2)`. -/
abbrev BinL := GroupApproximation.BinaryLeavitt.BinaryLeavittAlgebra (ZMod 2)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.BinL

/-- `GL_4(L)`. -/
abbrev GLFour := (Matrix (Fin 4) (Fin 4) BinL)ˣ

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.GLFour

/-- The base vertex `e₃`. -/
def lastCol : Fin 4 → BinL := Pi.single 3 1

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.lastCol

/-- The second vertex `e₂` of the base edge. -/
def prevCol : Fin 4 → BinL := Pi.single 2 1

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.prevCol

/-- **The vertex stabilizer `J = {g | g e₃ = e₃}`.** -/
def vertexStab : Subgroup GLFour where
  carrier := {g | (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol}
  mul_mem' {g g'} hg hg' := by
    have h₁ : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol := hg
    have h₂ : (g' : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol := hg'
    show ((g * g' : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, h₂, h₁]
  one_mem' := by
    show ((1 : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol
    rw [Units.val_one, Matrix.one_mulVec]
  inv_mem' {g} hg := by
    have h₁ : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol := hg
    show ((g⁻¹ : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol = lastCol
    calc ((g⁻¹ : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol
        = ((g⁻¹ : GLFour) : Matrix (Fin 4) (Fin 4) BinL) *ᵥ
            ((g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ lastCol) := by rw [h₁]
      _ = lastCol := by
        rw [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
          Matrix.one_mulVec]

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.vertexStab

/-- The elementary matrices `1 + E_{ij}(a)` with `j ≠ 3` fix `e₃`. -/
theorem elementaryUnit_mem_vertexStab (i j : Fin 4) (hij : i ≠ j) (hj : j ≠ 3) (a : BinL) :
    GroupApproximation.elementaryUnit i j hij a ∈ vertexStab := by
  show (1 + Matrix.single i j a) *ᵥ lastCol = lastCol
  have hj0 : lastCol j = 0 := by
    show Pi.single (3 : Fin 4) (1 : BinL) j = 0
    exact Pi.single_eq_of_ne hj 1
  rw [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.single_mulVec_eq, hj0, mul_zero, zero_smul,
    add_zero]

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.elementaryUnit_mem_vertexStab

/-- The base-edge indices are distinct. -/
theorem lastIdx_ne : (3 : Fin 4) ≠ 2 := by decide

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.lastIdx_ne

/-- The indices of `h` are distinct. -/
theorem midIdx_ne : (2 : Fin 4) ≠ 1 := by decide

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.midIdx_ne

/-- **The Weyl element `w_{32}` of the base edge** (lane 01's `weyl 3 2`). -/
def weylLast : St 4 BinL :=
  GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.weyl (R := BinL) (3 : Fin 4) 2
    lastIdx_ne

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.weylLast

/-- `w_{32}` unfolded. -/
theorem weylLast_eq :
    weylLast = GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL) *
      GroupApproximation.SteinbergGroup.x (2 : Fin 4) 3 lastIdx_ne.symm (1 : BinL) *
      GroupApproximation.SteinbergGroup.x (3 : Fin 4) 2 lastIdx_ne (1 : BinL) :=
  rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.weylLast_eq

/-- **The swap `τ` of the base edge `(e₃, e₂)`**: the image of `w_{32}` in `GL_4(L)`. -/
def swapLast : GLFour :=
  ((GroupApproximation.SteinbergGroup.projection weylLast :
      GroupApproximation.elementaryGroup (Fin 4) BinL) : GLFour)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.swapLast

/-- **Brown's element `h`**: the image of `w_{21}` in `GL_4(L)`.  It lies in `J`. -/
def swapMid : GLFour :=
  ((GroupApproximation.SteinbergGroup.projection
      (GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.weyl (R := BinL) (2 : Fin 4) 1
        midIdx_ne) :
      GroupApproximation.elementaryGroup (Fin 4) BinL) : GLFour)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion.swapMid

end

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion
