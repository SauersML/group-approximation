import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.UsedRankFourStatement
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.StableReduction.StableKTwo
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CohnTwo.Relative
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.K2RankFourRefinement
import GroupApproximation.BooneHigman.SteinbergBasic.Naturality
import GroupApproximation.Meta.AxiomGuard

/-!
# The rank-four used statement is all of stable `K₂(L_{𝔽₂}(1,2)) = 0` (lane sk-leavitt-26, I)

Let `L = L_{𝔽₂}(1,2)`.  `LeavittK2UsedRankFourStatement` (lane sk-leavitt-25) says that every
`k ∈ K₂(4, L)` dies in some `St_N(L)`.  This module proves that it is *equivalent* to the
finite-stage stable statement `BinaryLeavittStableK2TrivialStatement` (every `k ∈ K₂(n, L)`, for
every `n`, dies in some `St_N(L)`).

## Route (over any ring with a Leavitt family, lemma by lemma)

* `usedRankFourClose_of_le` (downwards): if every element of `K₂(m, R)` dies stably and `n ≤ m`,
  so does every element of `K₂(n, R)`.  Pad `k` to rank `m` (`indexMap_mem_K2`), kill it there,
  compose the two relabellings (`CohnTwo.indexMap_castLE_castLE`).
* `usedRankFourClose_succ` (upwards): if every element of `K₂(m + 2, R)` dies stably, so does every
  element of `K₂(m + 3, R)`.  `K₂(m + 3) = D(K₂(m + 2))` for the refinement `D` splitting
  `last (m + 1)` (`LeavittFP.K2_map_refineHom`, spare index `castSucc 0`), and death transfers
  along `D` (`usedRankFour_pad_refine_eq_one`, lane sk-leavitt-25).
* Induction from rank four gives every rank `≥ 4`; padding gives every rank `≤ 4`.

## Truth check (LOUD)

The target is **true** (Ara–Brustenga–Cortiñas 2009: `K_*(L_k(1,2)) = 0`), but by
`binaryLeavittStableK2Trivial_of_leavittK2UsedRankFour` it carries the **whole** stable
vanishing `K₂(L) = 0`.  The refinement self-similarity cannot supply it: `D` is induced by the
Morita isomorphism `M_n(L) ≅ M_{n+1}(L)` coming from `L ≅ L²`, so on stable `K₂` it acts as the
identity, and `θ(a) = s₀ a t₀ + s₁ a t₁` acts as multiplication by `2`.  Neither relation forces
an element to vanish; `K₀(L) = 0` follows from `[L] = 2[L]`, but `K₂` is not generated by `[L]`.
The vanishing comes from the localisation sequence of the Cohn algebra `C_2 → L`, which the repo
has reduced to stable `K₂(C_2(𝔽₂)) = 0` (see `UsedRankFourCloseCohn.lean`).
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2

section Generic

variable {R : Type*} [Ring R]

/-- **Downwards.**  Stable death of all of `K₂(m, R)` gives stable death of all of `K₂(n, R)`
for `n ≤ m`. -/
theorem usedRankFourClose_of_le {n m : ℕ} (hnm : n ≤ m)
    (hP : ∀ k ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin m) R,
      ∃ (N : ℕ) (h : m ≤ N), GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb h) k = 1) :
    ∀ k ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin n) R,
      ∃ (N : ℕ) (h : n ≤ N), GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb h) k = 1 := by
  intro k hk
  obtain ⟨N, hN, e⟩ := hP (GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb hnm) k)
    (GroupApproximation.BooneHigman.SteinbergBasic.indexMap_mem_K2 (Fin.castLEEmb hnm) hk)
  refine ⟨N, hnm.trans hN, ?_⟩
  rw [← CohnTwo.indexMap_castLE_castLE hnm hN]
  exact e

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.usedRankFourClose_of_le

/-- **Upwards, one rank.**  Over a ring with a Leavitt family, stable death of all of
`K₂(m + 2, R)` gives stable death of all of `K₂(m + 3, R)`. -/
theorem usedRankFourClose_succ (L : LeavittFamily R) (m : ℕ)
    (hP : ∀ k ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin (m + 1 + 1)) R,
      ∃ (N : ℕ) (h : m + 1 + 1 ≤ N),
        GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb h) k = 1) :
    ∀ k ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin (m + 1 + 1 + 1)) R,
      ∃ (N : ℕ) (h : m + 1 + 1 + 1 ≤ N),
        GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb h) k = 1 := by
  intro k hk
  have hmap := LeavittFP.K2_map_refineHom L (Fin.last (m + 1))
    (Fin.castSucc (0 : Fin (m + 1))) (Fin.castSucc_ne_last _)
  obtain ⟨w, hw, rfl⟩ := Subgroup.mem_map.mp (hmap.ge hk)
  obtain ⟨N, hN, hwN⟩ := hP w hw
  exact ⟨N + 1, Nat.add_le_add_right hN 1,
    usedRankFour_pad_refine_eq_one L (Fin.last (m + 1)) hN hwN⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.usedRankFourClose_succ

end Generic

/-- **Every rank `≥ 4`.**  The rank-four used statement gives stable death of all of
`K₂(j + 4, L_{𝔽₂}(1,2))`. -/
theorem usedRankFourClose_add_four (h4 : LeavittK2UsedRankFourStatement) (j : ℕ) :
    ∀ k ∈ GroupApproximation.BooneHigman.SteinbergBasic.K2 (Fin (j + 4))
        (GroupApproximation.BinaryLeavitt.BinaryLeavittAlgebra (ZMod 2)),
      ∃ (N : ℕ) (h : j + 4 ≤ N),
        GroupApproximation.SteinbergGroup.indexMap (Fin.castLEEmb h) k = 1 := by
  induction j with
  | zero => exact h4
  | succ j ih =>
    exact usedRankFourClose_succ (GroupApproximation.BinaryLeavitt.family (ZMod 2)) (j + 2) ih

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.usedRankFourClose_add_four

/-- **The converse of the truth check.**  The rank-four used statement implies the finite-stage
stable statement at every rank. -/
theorem binaryLeavittStableK2Trivial_of_leavittK2UsedRankFour
    (h4 : LeavittK2UsedRankFourStatement) : BinaryLeavittStableK2TrivialStatement := by
  intro n k hk
  by_cases hn : n ≤ 4
  · exact usedRankFourClose_of_le hn h4 k hk
  · obtain ⟨j, rfl⟩ : ∃ j, n = j + 4 := ⟨n - 4, by omega⟩
    exact usedRankFourClose_add_four h4 j k hk

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.binaryLeavittStableK2Trivial_of_leavittK2UsedRankFour

/-- **Truth check.**  The finite-stage stable statement gives the rank-four used statement. -/
theorem leavittK2UsedRankFour_of_binaryLeavittStableK2Trivial
    (hS : BinaryLeavittStableK2TrivialStatement) : LeavittK2UsedRankFourStatement :=
  fun k hk => hS 4 k hk

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.leavittK2UsedRankFour_of_binaryLeavittStableK2Trivial

/-- The rank-four used statement and the finite-stage stable statement are equivalent. -/
theorem leavittK2UsedRankFour_iff_binaryLeavittStableK2Trivial :
    LeavittK2UsedRankFourStatement ↔ BinaryLeavittStableK2TrivialStatement :=
  ⟨binaryLeavittStableK2Trivial_of_leavittK2UsedRankFour,
    leavittK2UsedRankFour_of_binaryLeavittStableK2Trivial⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.leavittK2UsedRankFour_iff_binaryLeavittStableK2Trivial

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2
