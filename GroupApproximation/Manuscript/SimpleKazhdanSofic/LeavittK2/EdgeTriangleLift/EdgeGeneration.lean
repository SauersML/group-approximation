import Mathlib.Tactic.NoncommRing
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.Stabilizers
import GroupApproximation.Algebra.ElementaryPaddingInjective
import GroupApproximation.Meta.AxiomGuard

/-!
# Edge and triangle lifts II: generation of the edge group (lane sk-leavitt-13)

Let `R` be a ring with `GL_2(R) = E_2(R)`.  Then `K = edgeStab R` is generated by the elementary
matrices `1 + E_{pq}(c)` with `q < 2` (`edgeStab_le_closure`).

An element of `K` has the block form `[[A, 0], [C, I]]`.

* `blkHom`: `k ↦ A` is multiplicative on `K` (`blk_mul`), so `edgeBlock : K → GL_2(R)`.
* `padBlock A = [[A, 0], [0, I]]` lies in the closure of the generators, because `A ∈ E_2(R)` and
  padding along `Fin.castLE` sends `1 + E_{ij}(a)` to a generator (`pad_mem_closure`).
* `m = k · padBlock(A)⁻¹` has block `1`.  So `m = [[I, 0], [C', I]]`, which is the product of the
  four generators `1 + E_{2,0}`, `1 + E_{2,1}`, `1 + E_{3,0}`, `1 + E_{3,1}` (`unipotent_eq`).
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift

variable {R : Type*} [Ring R]

/-- The upper-left `2 × 2` block. -/
def blk (M : Matrix (Fin 4) (Fin 4) R) : Matrix (Fin 2) (Fin 2) R :=
  M.submatrix (Fin.castLE two_le_four) (Fin.castLE two_le_four)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.blk

/-- The block is multiplicative when the left factor has identity columns `2` and `3`. -/
theorem blk_mul {M N : Matrix (Fin 4) (Fin 4) R}
    (hM2 : ∀ p : Fin 4, M p 2 = (1 : Matrix (Fin 4) (Fin 4) R) p 2)
    (hM3 : ∀ p : Fin 4, M p 3 = (1 : Matrix (Fin 4) (Fin 4) R) p 3) :
    blk (M * N) = blk M * blk N := by
  ext a b
  have ha2 : Fin.castLE two_le_four a ≠ 2 := by revert a; decide
  have ha3 : Fin.castLE two_le_four a ≠ 3 := by revert a; decide
  have he0 : Fin.castLE two_le_four (0 : Fin 2) = 0 := rfl
  have he1 : Fin.castLE two_le_four (1 : Fin 2) = 1 := rfl
  simp only [blk, Matrix.submatrix_apply, Matrix.mul_apply, Fin.sum_univ_four, Fin.sum_univ_two,
    hM2, hM3, Matrix.one_apply_ne ha2, Matrix.one_apply_ne ha3, zero_mul, add_zero, he0, he1]

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.blk_mul

/-- **The block homomorphism `K → M_2(R)`.** -/
def blkHom (R : Type*) [Ring R] : edgeStab R →* Matrix (Fin 2) (Fin 2) R where
  toFun g := blk ((g : (Matrix (Fin 4) (Fin 4) R)ˣ) : Matrix (Fin 4) (Fin 4) R)
  map_one' := by
    ext a b
    show (1 : Matrix (Fin 4) (Fin 4) R) (Fin.castLE two_le_four a) (Fin.castLE two_le_four b) =
      (1 : Matrix (Fin 2) (Fin 2) R) a b
    simp only [Matrix.one_apply, Fin.castLE_inj]
  map_mul' g h :=
    blk_mul (N := ((h : (Matrix (Fin 4) (Fin 4) R)ˣ) : Matrix (Fin 4) (Fin 4) R))
      (mem_columnFixer.mp (mem_edgeStab.mp g.2).2) (mem_columnFixer.mp (mem_edgeStab.mp g.2).1)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.blkHom

/-- **The block homomorphism `K → GL_2(R)`.** -/
def edgeBlock (R : Type*) [Ring R] : edgeStab R →* (Matrix (Fin 2) (Fin 2) R)ˣ :=
  (blkHom R).toHomUnits

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.edgeBlock

/-- `[[A, 0], [0, I]]`, padding along `Fin.castLE`. -/
def padBlock (R : Type*) [Ring R] (u : (Matrix (Fin 2) (Fin 2) R)ˣ) : (Matrix (Fin 4) (Fin 4) R)ˣ :=
  ElementaryPadding.padUnitHom (Fin.castLEEmb two_le_four) u

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.padBlock

/-- If `GL_2(R) = E_2(R)`, every padded block is a product of generators. -/
theorem pad_mem_closure (hE2 : elementaryGroup (Fin 2) R = ⊤) (u : (Matrix (Fin 2) (Fin 2) R)ˣ) :
    padBlock R u ∈ Subgroup.closure (edgeGens R) := by
  have hu : u ∈ elementaryGroup (Fin 2) R := by
    rw [hE2]
    exact Subgroup.mem_top u
  have hle : elementaryGroup (Fin 2) R ≤ (Subgroup.closure (edgeGens R)).comap
      (ElementaryPadding.padUnitHom (Fin.castLEEmb two_le_four)) := by
    rw [elementaryGroup, Subgroup.closure_le]
    rintro z ⟨i, j, hij, a, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, ElementaryPadding.padUnitHom_elementaryUnit]
    exact Subgroup.subset_closure ⟨Fin.castLEEmb two_le_four i, Fin.castLEEmb two_le_four j,
      (Fin.castLEEmb two_le_four).injective.ne hij, a, j.isLt, rfl⟩
  exact hle hu

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.pad_mem_closure

/-- The block of `padBlock u` is `u`. -/
theorem edgeBlock_pad (u : (Matrix (Fin 2) (Fin 2) R)ˣ) (hu : padBlock R u ∈ edgeStab R) :
    edgeBlock R ⟨padBlock R u, hu⟩ = u := by
  apply Units.ext
  rw [edgeBlock, MonoidHom.coe_toHomUnits]
  ext a b
  exact ElementaryPadding.padHom_apply_embed (Fin.castLEEmb two_le_four)
    (u : Matrix (Fin 2) (Fin 2) R) a b

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.edgeBlock_pad

/-- The four elements of `Fin 4`. -/
theorem fin4_cases : ∀ p : Fin 4, p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 := by decide

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.fin4_cases

/-- **A matrix of `K` with block `1` is `[[I, 0], [C, I]]`**, a product of four generators. -/
theorem unipotent_eq {M : Matrix (Fin 4) (Fin 4) R}
    (h2 : ∀ p : Fin 4, M p 2 = (1 : Matrix (Fin 4) (Fin 4) R) p 2)
    (h3 : ∀ p : Fin 4, M p 3 = (1 : Matrix (Fin 4) (Fin 4) R) p 3) (hb : blk M = 1) :
    M = (1 + Matrix.single 2 0 (M 2 0)) * (1 + Matrix.single 2 1 (M 2 1)) *
      (1 + Matrix.single 3 0 (M 3 0)) * (1 + Matrix.single 3 1 (M 3 1)) := by
  have h00 : M 0 0 = 1 := (congrFun (congrFun hb 0) 0).trans (Matrix.one_apply_eq 0)
  have h11 : M 1 1 = 1 := (congrFun (congrFun hb 1) 1).trans (Matrix.one_apply_eq 1)
  have h01 : M 0 1 = 0 := (congrFun (congrFun hb 0) 1).trans (Matrix.one_apply_ne (by decide))
  have h10 : M 1 0 = 0 := (congrFun (congrFun hb 1) 0).trans (Matrix.one_apply_ne (by decide))
  have hAB : Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) * Matrix.single 2 1 (M 2 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ (by decide) _
  have hAC : Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) * Matrix.single 3 0 (M 3 0) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ (by decide) _
  have hAD : Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0) * Matrix.single 3 1 (M 3 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ (by decide) _
  have hBC : Matrix.single (2 : Fin 4) (1 : Fin 4) (M 2 1) * Matrix.single 3 0 (M 3 0) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ (by decide) _
  have hBD : Matrix.single (2 : Fin 4) (1 : Fin 4) (M 2 1) * Matrix.single 3 1 (M 3 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ (by decide) _
  have hCD : Matrix.single (3 : Fin 4) (0 : Fin 4) (M 3 0) * Matrix.single 3 1 (M 3 1) = 0 :=
    Matrix.single_mul_single_of_ne _ _ _ (by decide) _
  have e : (1 + Matrix.single (2 : Fin 4) (0 : Fin 4) (M 2 0)) * (1 + Matrix.single 2 1 (M 2 1)) *
      (1 + Matrix.single 3 0 (M 3 0)) * (1 + Matrix.single 3 1 (M 3 1)) =
      1 + Matrix.single 2 0 (M 2 0) + Matrix.single 2 1 (M 2 1) + Matrix.single 3 0 (M 3 0) +
        Matrix.single 3 1 (M 3 1) := by
    noncomm_ring [hAB, hAC, hAD, hBC, hBD, hCD]
  rw [e]
  ext p q
  rcases fin4_cases p with rfl | rfl | rfl | rfl <;>
    rcases fin4_cases q with rfl | rfl | rfl | rfl <;>
    simp [Matrix.single_apply, Matrix.one_apply, h00, h01, h10, h11, h2, h3]

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.unipotent_eq

/-- **Generation of the edge group.**  If `GL_2(R) = E_2(R)`, then `K` is generated by the
elementary matrices `1 + E_{pq}(c)` with `q < 2`. -/
theorem edgeStab_le_closure (hE2 : elementaryGroup (Fin 2) R = ⊤) :
    edgeStab R ≤ Subgroup.closure (edgeGens R) := by
  intro k hk
  generalize hu : edgeBlock R ⟨k, hk⟩ = u
  have hcl : padBlock R u ∈ Subgroup.closure (edgeGens R) := pad_mem_closure hE2 u
  have hhK : padBlock R u ∈ edgeStab R := closure_edgeGens_le hcl
  have hmK : k * (padBlock R u)⁻¹ ∈ edgeStab R := mul_mem hk (inv_mem hhK)
  have hblk : edgeBlock R ⟨k * (padBlock R u)⁻¹, hmK⟩ = 1 := by
    have e1 : (⟨k * (padBlock R u)⁻¹, hmK⟩ : edgeStab R) =
        ⟨k, hk⟩ * (⟨padBlock R u, hhK⟩ : edgeStab R)⁻¹ := rfl
    rw [e1, map_mul, map_inv, edgeBlock_pad u hhK, hu, mul_inv_cancel]
  have hb : blk (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) :
      Matrix (Fin 4) (Fin 4) R) = 1 := congrArg Units.val hblk
  have hprod : k * (padBlock R u)⁻¹ =
      elementaryUnit (2 : Fin 4) 0 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 2 0) *
        elementaryUnit (2 : Fin 4) 1 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 2 1) *
        elementaryUnit (3 : Fin 4) 0 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 3 0) *
        elementaryUnit (3 : Fin 4) 1 (by decide)
          (((k * (padBlock R u)⁻¹ : (Matrix (Fin 4) (Fin 4) R)ˣ)) : Matrix (Fin 4) (Fin 4) R) 3 1) :=
    Units.ext (unipotent_eq (mem_columnFixer.mp (mem_edgeStab.mp hmK).2)
      (mem_columnFixer.mp (mem_edgeStab.mp hmK).1) hb)
  have hgen : ∀ (p q : Fin 4) (hpq : p ≠ q) (c : R), q.val < 2 →
      elementaryUnit p q hpq c ∈ Subgroup.closure (edgeGens R) :=
    fun p q hpq c hq => Subgroup.subset_closure ⟨p, q, hpq, c, hq, rfl⟩
  have hm : k * (padBlock R u)⁻¹ ∈ Subgroup.closure (edgeGens R) := by
    rw [hprod]
    exact mul_mem (mul_mem (mul_mem (hgen _ _ _ _ (by decide)) (hgen _ _ _ _ (by decide)))
      (hgen _ _ _ _ (by decide))) (hgen _ _ _ _ (by decide))
  have hk' := mul_mem hm hcl
  rwa [inv_mul_cancel_right] at hk'

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.edgeStab_le_closure

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift
