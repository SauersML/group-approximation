import Mathlib.Tactic.Group
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.EdgeGeneration
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.CriterionInterfaces
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Weyl.Corner
import GroupApproximation.KOne.AllRanksElementaryCore
import GroupApproximation.Meta.AxiomGuard

/-!
# Edge and triangle lifts III: the edge relation (lane sk-leavitt-13)

Khanh (arXiv:2609.08428), proof of Theorem 5.1, over `L = L_{𝔽₂}(1,2)`.  Let
`σ : J → St_4(L)` send `1 + E_{ij}(a)` (`j ≠ 3`) to `x_{ij}(a)` (`Criterion.LiftsRoots`).  Then `σ`
satisfies Brown's edge relation `w₃₂ σ(k) w₃₂⁻¹ = σ(τ k τ⁻¹)` for `k ∈ K`
(`edgeRelation_of_liftsRoots`).

* `K` is generated by `1 + E_{pq}(c)` with `q < 2` (`EdgeGeneration`, using `GL_2(L) = E_2(L)`).
* Conjugation by `τ` sends a generator to a generator (`swapLast_conj_elementaryUnit`).  It is
  the image of Weyl conjugation `w₃₂ x_{pq}(c) w₃₂⁻¹ = x_{(32)p,(32)q}(c)` (lane 01,
  `weyl_conj_x`, characteristic two).
* Both sides of the edge relation are multiplicative in `k`, so induction over the closure
  reduces it to generators, where it is `weyl_conj_x` again (`edge_aux`).
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift

open GroupApproximation.SteinbergGroup
open GroupApproximation.BooneHigman.SteinbergBasic
open GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.Criterion
open scoped Matrix

/-- `L` has characteristic two. -/
theorem two_eq_zero_binL : (2 : BinL) = 0 := by
  have h : ((2 : ℕ) : BinL) = 0 := by
    rw [← map_natCast (algebraMap (ZMod 2) BinL) 2, ZMod.natCast_self, map_zero]
  exact_mod_cast h

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.two_eq_zero_binL

/-- `GL_2(L) = E_2(L)`. -/
theorem hE2L : elementaryGroup (Fin 2) BinL = ⊤ :=
  GroupApproximation.BinaryLeavitt.elementaryGroup_eq_top (ZMod 2) 2 le_rfl

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.hE2L

/-- Weyl conjugation by `w₃₂` in `St_4(L)`. -/
theorem weylLast_conj_x (p q : Fin 4) (hpq : p ≠ q) (c : BinL) :
    weylLast * x p q hpq c * weylLast⁻¹ =
      x (Equiv.swap (3 : Fin 4) 2 p) (Equiv.swap (3 : Fin 4) 2 q)
        ((Equiv.swap (3 : Fin 4) 2).injective.ne hpq) c :=
  weyl_conj_x (n := 4) two_eq_zero_binL (by decide) lastIdx_ne p q hpq c

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.weylLast_conj_x

/-- Conjugation by `τ` permutes the elementary matrices. -/
theorem swapLast_conj_elementaryUnit (p q : Fin 4) (hpq : p ≠ q) (c : BinL) :
    swapLast * elementaryUnit p q hpq c * swapLast⁻¹ =
      elementaryUnit (Equiv.swap (3 : Fin 4) 2 p) (Equiv.swap (3 : Fin 4) 2 q)
        ((Equiv.swap (3 : Fin 4) 2).injective.ne hpq) c := by
  have hc := congrArg (fun g => ((projection g : elementaryGroup (Fin 4) BinL) : GLFour))
    (weylLast_conj_x p q hpq c)
  simp only [map_mul, map_inv, Subgroup.coe_mul, Subgroup.coe_inv, projection_x,
    elementaryRoot_val] at hc
  exact hc

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.swapLast_conj_elementaryUnit

/-- Conjugation by `τ` preserves the closure of the edge generators. -/
theorem conj_mem_closure {g : GLFour} (hg : g ∈ Subgroup.closure (edgeGens BinL)) :
    swapLast * g * swapLast⁻¹ ∈ Subgroup.closure (edgeGens BinL) := by
  induction hg using Subgroup.closure_induction with
  | mem z hz =>
    obtain ⟨p, q, hpq, c, hq, rfl⟩ := hz
    have hsq : Equiv.swap (3 : Fin 4) 2 q = q :=
      Equiv.swap_apply_of_ne_of_ne (ne_three_of_lt_two hq) (ne_two_of_lt_two hq)
    have hq' : (Equiv.swap (3 : Fin 4) 2 q).val < 2 := by rw [hsq]; exact hq
    rw [swapLast_conj_elementaryUnit]
    exact Subgroup.subset_closure ⟨Equiv.swap (3 : Fin 4) 2 p, Equiv.swap (3 : Fin 4) 2 q,
      (Equiv.swap (3 : Fin 4) 2).injective.ne hpq, c, hq', rfl⟩
  | one =>
    rw [mul_one, mul_inv_cancel]
    exact one_mem _
  | mul x y _ _ ihx ihy =>
    have e : swapLast * (x * y) * swapLast⁻¹ =
        swapLast * x * swapLast⁻¹ * (swapLast * y * swapLast⁻¹) := by group
    rw [e]
    exact mul_mem ihx ihy
  | inv x _ ih =>
    have e : swapLast * x⁻¹ * swapLast⁻¹ = (swapLast * x * swapLast⁻¹)⁻¹ := by group
    rw [e]
    exact inv_mem ih

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.conj_mem_closure

/-- The edge generators fix `e₃`. -/
theorem closure_le_vertexStab : Subgroup.closure (edgeGens BinL) ≤ vertexStab := by
  intro g hg
  show (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ Pi.single 3 1 = Pi.single 3 1
  exact (mulVec_single_iff _ 3).mpr (mem_columnFixer.mp (mem_edgeStab.mp (closure_edgeGens_le hg)).1)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.closure_le_vertexStab

/-- On a generator, the edge relation is Weyl conjugation. -/
theorem edge_gen (σ : vertexStab →* St 4 BinL) (hσ : LiftsRoots σ) (p q : Fin 4) (hpq : p ≠ q)
    (c : BinL) (hq : q.val < 2) (h1 : elementaryUnit p q hpq c ∈ vertexStab)
    (h2 : swapLast * elementaryUnit p q hpq c * swapLast⁻¹ ∈ vertexStab) :
    weylLast * σ ⟨elementaryUnit p q hpq c, h1⟩ * weylLast⁻¹ =
      σ ⟨swapLast * elementaryUnit p q hpq c * swapLast⁻¹, h2⟩ := by
  have hq3 : q ≠ 3 := ne_three_of_lt_two hq
  have hsq : Equiv.swap (3 : Fin 4) 2 q = q :=
    Equiv.swap_apply_of_ne_of_ne hq3 (ne_two_of_lt_two hq)
  have hq3' : Equiv.swap (3 : Fin 4) 2 q ≠ 3 := by rw [hsq]; exact hq3
  have e2 : (⟨swapLast * elementaryUnit p q hpq c * swapLast⁻¹, h2⟩ : vertexStab) =
      ⟨elementaryUnit (Equiv.swap (3 : Fin 4) 2 p) (Equiv.swap (3 : Fin 4) 2 q)
        ((Equiv.swap (3 : Fin 4) 2).injective.ne hpq) c,
        elementaryUnit_mem_vertexStab _ _ _ hq3' c⟩ :=
    Subtype.ext (swapLast_conj_elementaryUnit p q hpq c)
  rw [e2, hσ p q hpq hq3 c, hσ _ _ _ hq3' c]
  exact weylLast_conj_x p q hpq c

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.edge_gen

/-- **The edge relation on the closure of the generators.** -/
theorem edge_aux (σ : vertexStab →* St 4 BinL) (hσ : LiftsRoots σ) {g : GLFour}
    (hg : g ∈ Subgroup.closure (edgeGens BinL)) :
    ∀ (h1 : g ∈ vertexStab) (h2 : swapLast * g * swapLast⁻¹ ∈ vertexStab),
      weylLast * σ ⟨g, h1⟩ * weylLast⁻¹ = σ ⟨swapLast * g * swapLast⁻¹, h2⟩ := by
  induction hg using Subgroup.closure_induction with
  | mem z hz =>
    obtain ⟨p, q, hpq, c, hq, rfl⟩ := hz
    exact edge_gen σ hσ p q hpq c hq
  | one =>
    intro h1 h2
    have e0 : (⟨1, h1⟩ : vertexStab) = 1 := rfl
    have e1 : (⟨swapLast * 1 * swapLast⁻¹, h2⟩ : vertexStab) = 1 :=
      Subtype.ext (show swapLast * 1 * swapLast⁻¹ = 1 by rw [mul_one, mul_inv_cancel])
    rw [e0, e1, map_one, mul_one, mul_inv_cancel]
  | mul x y hx hy ihx ihy =>
    intro h1 h2
    have hxJ := closure_le_vertexStab hx
    have hyJ := closure_le_vertexStab hy
    have hx' := closure_le_vertexStab (conj_mem_closure hx)
    have hy' := closure_le_vertexStab (conj_mem_closure hy)
    have e1 : (⟨x * y, h1⟩ : vertexStab) = ⟨x, hxJ⟩ * ⟨y, hyJ⟩ := rfl
    have e2 : (⟨swapLast * (x * y) * swapLast⁻¹, h2⟩ : vertexStab) =
        ⟨swapLast * x * swapLast⁻¹, hx'⟩ * ⟨swapLast * y * swapLast⁻¹, hy'⟩ :=
      Subtype.ext (show swapLast * (x * y) * swapLast⁻¹ =
        swapLast * x * swapLast⁻¹ * (swapLast * y * swapLast⁻¹) by group)
    rw [e1, e2, map_mul, map_mul, ← ihx hxJ hx', ← ihy hyJ hy']
    group
  | inv x hx ih =>
    intro h1 h2
    have hxJ := closure_le_vertexStab hx
    have hx' := closure_le_vertexStab (conj_mem_closure hx)
    have e1 : (⟨x⁻¹, h1⟩ : vertexStab) = (⟨x, hxJ⟩ : vertexStab)⁻¹ := rfl
    have e2 : (⟨swapLast * x⁻¹ * swapLast⁻¹, h2⟩ : vertexStab) =
        (⟨swapLast * x * swapLast⁻¹, hx'⟩ : vertexStab)⁻¹ :=
      Subtype.ext (show swapLast * x⁻¹ * swapLast⁻¹ = (swapLast * x * swapLast⁻¹)⁻¹ by group)
    rw [e1, e2, map_inv, map_inv, ← ih hxJ hx']
    group

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.edge_aux

/-- **Brown's edge relation for a root lift** (`T = w₃₂`). -/
theorem edgeRelation_of_liftsRoots (σ : vertexStab →* St 4 BinL) (hσ : LiftsRoots σ) :
    EdgeRelation σ weylLast := by
  rintro ⟨g, hg⟩ ⟨g', hg'⟩ hk hk'
  have hg3 : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ Pi.single 3 1 = Pi.single 3 1 := hg
  have hg2 : (g : Matrix (Fin 4) (Fin 4) BinL) *ᵥ Pi.single 2 1 = Pi.single 2 1 := hk
  have hK : g ∈ edgeStab BinL :=
    mem_edgeStab.mpr ⟨mem_columnFixer.mpr ((mulVec_single_iff _ 3).mp hg3),
      mem_columnFixer.mpr ((mulVec_single_iff _ 2).mp hg2)⟩
  have hcl : g ∈ Subgroup.closure (edgeGens BinL) := edgeStab_le_closure hE2L hK
  have hk'' : g' = swapLast * g * swapLast⁻¹ := hk'
  subst hk''
  exact edge_aux σ hσ hcl hg hg'

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift.edgeRelation_of_liftsRoots

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittK2.EdgeTriangleLift
