import GroupApproximation.Manuscript.SimpleKazhdanSofic.LamplighterModelGeneration
import GroupApproximation.Meta.AxiomGuard

/-!
# `lem:host`: the finite models and the matrices `φ_n`

`simple_kazhdan_sofic_group.tex`, proof of `lem:host`.

> (l.555–559) To `ξ : x ↦ δx + c` in `Λ` assign the permutation `p_ξ` of `Y_n = F_2^{Q'_n}` given by
> `y ↦ σ_n(δ)y + ∑_{η ∈ supp c} 1_{σ_n(η)}`, where `(qy)(q') = y(q⁻¹q')`, and attach to `y` the
> point `y ∘ σ_n` of `Ω`.
>
> (l.559–563) For fixed `ξ, ξ' ∈ Λ` and large `n` we have `p_ξ p_{ξ'} = p_{ξξ'}`, and for every
> finite `W ⊆ Δ` and large `n` the attached points satisfy `(p_ξ y) ∘ σ_n = ξ(y ∘ σ_n)` on `W` for
> all `y`, since `σ_n` respects the finitely many products and inequalities involved.
>
> (l.564–567) Let `D_n(f)` be the diagonal matrix on `F_2^{Y_n}` with entry `f(y ∘ σ_n)` at `y`,
> let `P_ξ` be the permutation matrix of `p_ξ`, and put `φ_n(∑_ξ f_ξ u_ξ) = ∑_ξ D_n(f_ξ) P_ξ`.
>
> (l.567–573) For fixed `f` and `ξ` and large `n`, `P_ξ D_n(f) P_ξ⁻¹ = D_n(f ∘ ξ⁻¹)`, so for fixed
> `r, r' ∈ R_Δ` and large `n`, `φ_n` is additive and multiplicative on `r, r'`, and `φ_n(1) = I`.
>
> (l.573–577) The conjugates of `D_n(e_U)` by products of the `P_ξ` with `ξ` in the generating set
> are the coordinate functions of `Y_n`, and the conjugates of `P_z` are the translations by the
> `1_q`, so the images of the generators generate `M_{2^{|Q'_n|}}(F_2)`.

Route.  `M : BallModelSequence Δ T` is a sequence of finite models `σ_n : Δ → Q'_n` as in l.552–555
(injective on the ball of radius `n`, preserving the products that stay in it, `σ_n(e) = e`, and
`Q'_n` generated by `σ_n(T)`).  The corpus objects are `Lamplighter.modelAct M n ξ = p_ξ`,
`Lamplighter.qSmul`, `Lamplighter.attach`, `Lamplighter.modelDiag = D_n`,
`Lamplighter.modelPerm = P_ξ`, `Lamplighter.modelMap = φ_n`; the statements below are the printed
formulas, proved by the corpus lemmas `Lamplighter.eventually_modelAct_mul`,
`Lamplighter.eventually_attach_modelAct`, `Lamplighter.eventually_modelPerm_mul_modelDiag_mul_inv`,
`Lamplighter.eventually_modelMap_mul`, `Lamplighter.conj_modelMap_eU`,
`Lamplighter.conj_modelPerm_lampAdd` and `Lamplighter.closure_modelMap_lampGenerators_eq_top`.
The products of the `P_ξ` with `ξ = δ ∈ T` are the permutation matrices of the elements of the
subgroup generated by the `p_δ`, which contains every `p_q : y ↦ qy` (`q ∈ Q'_n`).
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace Host

open Lamplighter

variable {Δ : Type} [Group Δ] {T : Set Δ}

/-- **`p_ξ`, `qy` and the attached point** (tex l.555–559). -/
theorem manuscriptSentence_modelPermutations (M : BallModelSequence Δ T) (n : ℕ) :
    (∀ (ξ : LampAffine Δ) (y : ModelSpace M n),
      Lamplighter.modelAct M n ξ y =
        Lamplighter.qSmul M n (M.σ n ξ.right) y +
          ∑ η ∈ (Multiplicative.toAdd ξ.left).support, Pi.single (M.σ n η) (1 : ZMod 2)) ∧
    (∀ (q : M.Q n) (y : ModelSpace M n) (q' : M.Q n),
      Lamplighter.qSmul M n q y q' = y (q⁻¹ * q')) ∧
    ∀ (y : ModelSpace M n) (η : Δ), Lamplighter.attach M n y η = y (M.σ n η) :=
  ⟨fun ξ y => by rw [Lamplighter.modelAct_apply, Lamplighter.lampImage_eq_sum_support],
    fun _ _ _ => rfl, fun _ _ => rfl⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_modelPermutations

/-- **`p_ξ p_{ξ'} = p_{ξξ'}` for large `n`, and the attached points move as in `Ω`**
(tex l.559–563). -/
theorem manuscriptSentence_modelActionAsymptotics (hT : Subgroup.closure T = ⊤)
    (M : BallModelSequence Δ T) :
    (∀ ξ ξ' : LampAffine Δ, ∀ᶠ n in Filter.atTop,
      Lamplighter.modelAct M n ξ * Lamplighter.modelAct M n ξ' =
        Lamplighter.modelAct M n (ξ * ξ')) ∧
    ∀ (ξ : LampAffine Δ) (W : Finset Δ), ∀ᶠ n in Filter.atTop,
      ∀ (y : ModelSpace M n), ∀ η ∈ W,
        Lamplighter.attach M n (Lamplighter.modelAct M n ξ y) η =
          (ξ • Lamplighter.attach M n y) η :=
  ⟨fun ξ ξ' => (Lamplighter.eventually_modelAct_mul M hT ξ ξ').mono fun _ hn => hn.symm,
    fun ξ W => Lamplighter.eventually_attach_modelAct M hT ξ W⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_modelActionAsymptotics

/-- **`D_n(f)`, `P_ξ` and `φ_n(∑_ξ f_ξ u_ξ) = ∑_ξ D_n(f_ξ) P_ξ`** (tex l.564–567); every element of
`R_Δ` is such a finite sum. -/
theorem manuscriptSentence_modelMatrices (M : BallModelSequence Δ T) (n : ℕ) :
    (∀ f : LocallyConstant (LampSpace Δ) (ZMod 2),
      Lamplighter.modelDiag M n f = Matrix.diagonal fun y => f (Lamplighter.attach M n y)) ∧
    (∀ (ξ : LampAffine Δ) (i j : ModelSpace M n),
      Lamplighter.modelPerm M n ξ i j = if i = Lamplighter.modelAct M n ξ j then 1 else 0) ∧
    (∀ (S : Finset (LampAffine Δ)) (f : LampAffine Δ → LocallyConstant (LampSpace Δ) (ZMod 2)),
      Lamplighter.modelMap M n (∑ ξ ∈ S,
          ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2) (f ξ) *
            (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ :
              LampRing Δ)) =
        ∑ ξ ∈ S, Lamplighter.modelDiag M n (f ξ) * Lamplighter.modelPerm M n ξ) ∧
    ∀ r : LampRing Δ, ∃ (S : Finset (LampAffine Δ))
      (f : LampAffine Δ → LocallyConstant (LampSpace Δ) (ZMod 2)),
      r = ∑ ξ ∈ S, ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2) (f ξ) *
        (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ : LampRing Δ) :=
  ⟨fun f => Lamplighter.modelDiag_apply M n f, fun ξ i j => Lamplighter.modelPerm_apply M n ξ i j,
    fun S f => Lamplighter.modelMap_sum_coeff_mul_unit M n S f,
    fun r => ClopenGroupCrossedProduct.exists_sum_coeff_mul_unit (LampAffine Δ) (LampSpace Δ)
      (ZMod 2) r⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_modelMatrices

/-- **`P_ξ D_n(f) P_ξ⁻¹ = D_n(f ∘ ξ⁻¹)`, so `φ_n` is asymptotically additive and multiplicative,
and `φ_n(1) = I`** (tex l.567–573). -/
theorem manuscriptSentence_modelMapAsymptoticHom (hT : Subgroup.closure T = ⊤)
    (M : BallModelSequence Δ T) :
    (∀ (ξ : LampAffine Δ) (f : LocallyConstant (LampSpace Δ) (ZMod 2)), ∀ᶠ n in Filter.atTop,
      Lamplighter.modelPerm M n ξ * Lamplighter.modelDiag M n f *
          Matrix.permMatrixHom (R := ZMod 2) (Lamplighter.modelAct M n ξ)⁻¹ =
        Lamplighter.modelDiag M n
          (LocallyConstant.comap (ClopenGroupCoeff.smulMap (LampAffine Δ) (LampSpace Δ) ξ⁻¹) f)) ∧
    (∀ r r' : LampRing Δ, ∀ᶠ n in Filter.atTop,
      Lamplighter.modelMap M n (r + r') = Lamplighter.modelMap M n r + Lamplighter.modelMap M n r' ∧
        Lamplighter.modelMap M n (r * r') =
          Lamplighter.modelMap M n r * Lamplighter.modelMap M n r') ∧
    ∀ n : ℕ, Lamplighter.modelMap M n 1 = 1 :=
  ⟨fun ξ f => Lamplighter.eventually_modelPerm_mul_modelDiag_mul_inv M hT ξ f,
    fun r r' => (Lamplighter.eventually_modelMap_mul M hT r r').mono fun n hn =>
      ⟨map_add (Lamplighter.modelMap M n) r r', hn⟩,
    fun n => Lamplighter.modelMap_one M n⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_modelMapAsymptoticHom

/-- `φ_n(f u_e) = D_n(f)`. -/
theorem modelMap_coeff_eq_modelDiag (M : BallModelSequence Δ T) (n : ℕ)
    (f : LocallyConstant (LampSpace Δ) (ZMod 2)) :
    Lamplighter.modelMap M n (ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2) f) =
      Lamplighter.modelDiag M n f := by
  rw [ClopenGroupCrossedProduct.coeff_apply, Lamplighter.modelMap_single, RingEquiv.symm_apply_apply,
    Lamplighter.modelPerm_one, mul_one]

/-- **The images of the generators generate `M_{2^{|Q'_n|}}(F_2)`** (tex l.573–577): every
`p_q : y ↦ qy` is a product of the `p_δ` with `δ ∈ T` and their inverses; conjugating `D_n(e_U)`
by its permutation matrix gives the coordinate function `y ↦ y(q)`, and conjugating `P_z` gives
the translation by `1_q`; the images of the generators generate the full matrix ring, of size
`2^{|Q'_n|}`. -/
theorem manuscriptSentence_modelGeneratorsGenerate (M : BallModelSequence Δ T) (n : ℕ) :
    (∀ q : M.Q n, Lamplighter.qPermHom M n q ∈
      Subgroup.closure
        (Lamplighter.modelAct M n '' ((SemidirectProduct.inr : Δ →* LampAffine Δ) '' T))) ∧
    (∀ q : M.Q n,
      Matrix.permMatrixHom (R := ZMod 2) (Lamplighter.qPermHom M n q) *
          Lamplighter.modelDiag M n
            (LocallyConstant.charFn (ZMod 2) (Lamplighter.isClopen_coordOne Δ)) *
          Matrix.permMatrixHom (R := ZMod 2) (Lamplighter.qPermHom M n q)⁻¹ =
        Matrix.diagonal fun y : ModelSpace M n => y q) ∧
    (∀ q : M.Q n,
      Matrix.permMatrixHom (R := ZMod 2) (Lamplighter.qPermHom M n q) *
          Lamplighter.modelPerm M n (lampAdd Δ) *
          Matrix.permMatrixHom (R := ZMod 2) (Lamplighter.qPermHom M n q)⁻¹ =
        Matrix.permMatrixHom (R := ZMod 2)
          (Lamplighter.addPermHom M n (Multiplicative.ofAdd (Pi.single q (1 : ZMod 2))))) ∧
    (∀ (q : M.Q n) (y : ModelSpace M n),
      Lamplighter.addPermHom M n (Multiplicative.ofAdd (Pi.single q (1 : ZMod 2))) y =
        y + Pi.single q (1 : ZMod 2)) ∧
    Subring.closure (Lamplighter.modelMap M n '' Lamplighter.lampGenerators T) = ⊤ ∧
    Subring.closure (Lamplighter.modelMapFin M n '' Lamplighter.lampGenerators T) = ⊤ ∧
    Lamplighter.modelDim M n = 2 ^ Fintype.card (M.Q n) := by
  refine ⟨fun q => ?_, fun q => ?_, fun q => Lamplighter.conj_modelPerm_lampAdd M n q,
    fun _ _ => rfl, Lamplighter.closure_modelMap_lampGenerators_eq_top M n,
    Lamplighter.closure_modelMapFin_lampGenerators_eq_top M n, Lamplighter.modelDim_eq M n⟩
  · have hq : q ∈ Subgroup.closure (M.σ n '' T) := by
      rw [(M.isBallModel n).closure_image]
      exact Subgroup.mem_top q
    have h1 := Subgroup.mem_map_of_mem (Lamplighter.qPermHom M n) hq
    rw [MonoidHom.map_closure] at h1
    have hsub : Lamplighter.qPermHom M n '' (M.σ n '' T) ⊆
        Lamplighter.modelAct M n '' ((SemidirectProduct.inr : Δ →* LampAffine Δ) '' T) := by
      rintro _ ⟨_, ⟨t, ht, rfl⟩, rfl⟩
      exact ⟨SemidirectProduct.inr t, ⟨t, ht, rfl⟩, Lamplighter.modelAct_inr_eq M n t⟩
    exact Subgroup.closure_mono hsub h1
  · have h := Lamplighter.conj_modelMap_eU M n q
    rwa [modelMap_coeff_eq_modelDiag M n] at h

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_modelGeneratorsGenerate

end Host
end SimpleKazhdanSofic
end GroupApproximation
