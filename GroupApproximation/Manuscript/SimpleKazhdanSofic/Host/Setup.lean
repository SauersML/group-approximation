import GroupApproximation.Manuscript.SimpleKazhdanSofic.LamplighterRing
import GroupApproximation.Meta.AxiomGuard

/-!
# `lem:host`: the objects, and the first paragraph of the proof

`simple_kazhdan_sofic_group.tex`, `lem:host` and its proof.

> (l.528–532) For a finitely generated group `Δ`, let `Δ` act on `Ω = F_2^Δ` by
> `(δx)(η) = x(δ⁻¹η)`, let `Λ` be the group of maps `x ↦ δx + c` with `δ ∈ Δ` and `c` finitely
> supported, and put `R_Δ = LC(Ω, F_2) ⋊ Λ` and `G_Δ = EL_3(R_Δ)`.
>
> (l.541–542) The group `Λ` is generated by `Δ` and the map `z` adding `1` at `e`, and its orbits
> contain the dense sets `x + ⊕_Δ F_2`.
>
> (l.548–550) The ring `R_Δ` is generated by `1`, the units `u_ξ^{±1}` for `ξ` in a finite
> generating set of `Λ`, and the indicator `e_U` of `U = {x : x(e) = 1}`.
>
> (l.585–586) As `Δ ≤ Λ`, the group `[Λ,Λ]` contains `[Δ,Δ]`.

Route.  The objects are the corpus ones: `LampSpace Δ = Δ → ZMod 2`, the group
`LampAffine Δ = Multiplicative (Δ →₀ ZMod 2) ⋊ Δ` acting by `(c, δ) • x = δx + c`, and
`LampRing Δ = ClopenGroupCrossedProduct (LampAffine Δ) (LampSpace Δ) (ZMod 2)`.

* `manuscriptSentence_hostDefinitions`: `inr δ` acts by `(δx)(η) = x(δ⁻¹η)`; every `x ↦ δx + c`
  is an element of `Λ`, every element of `Λ` acts by such a map, and distinct elements act by
  distinct maps (`Lamplighter.smul_left_injective`), so `Λ` is the printed group of maps; and
  `R_Δ` is the crossed product.
* `manuscriptSentence_lambdaGenerationDenseOrbits`: `Lamplighter.closure_insert_lampAdd_range_inr`,
  `Lamplighter.lampAdd_smul_apply`, `Lamplighter.dense_add_finsupp`, `Lamplighter.mem_orbit_add`.
* `manuscriptSentence_ringGenerators`: `Λ` has a finite generating set (`Lamplighter.fg_lampAffine`)
  and for every generating set the printed elements generate `R_Δ`
  (`Lamplighter.closure_generators_eq_top`).
* `manuscriptSentence_commutatorContainment`: `Δ → Λ` is injective and maps `[Δ,Δ]` into `[Λ,Λ]`.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace Host

open Lamplighter

/-- **The objects of `lem:host`** (tex l.528–532). -/
theorem manuscriptSentence_hostDefinitions (Δ : Type) [Group Δ] :
    (∀ (δ : Δ) (x : LampSpace Δ) (η : Δ),
      ((SemidirectProduct.inr : Δ →* LampAffine Δ) δ • x) η = x (δ⁻¹ * η)) ∧
    (∀ (δ : Δ) (c : Δ →₀ ZMod 2), ∃ ξ : LampAffine Δ,
      ∀ (x : LampSpace Δ) (η : Δ), (ξ • x) η = x (δ⁻¹ * η) + c η) ∧
    (∀ (ξ : LampAffine Δ) (x : LampSpace Δ) (η : Δ),
      (ξ • x) η = x (ξ.right⁻¹ * η) + Multiplicative.toAdd ξ.left η) ∧
    Function.Injective (fun (ξ : LampAffine Δ) (x : LampSpace Δ) => ξ • x) ∧
    LampRing Δ = ClopenGroupCrossedProduct (LampAffine Δ) (LampSpace Δ) (ZMod 2) := by
  refine ⟨fun δ x η => ?_, fun δ c => ⟨⟨Multiplicative.ofAdd c, δ⟩, fun _ _ => rfl⟩,
    Lamplighter.smul_apply Δ, Lamplighter.smul_left_injective Δ, rfl⟩
  rw [Lamplighter.smul_apply, SemidirectProduct.right_inr, SemidirectProduct.left_inr, toAdd_one,
    Finsupp.coe_zero, Pi.zero_apply, add_zero]

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_hostDefinitions

/-- **`Λ` is generated by `Δ` and `z`, and its orbits contain the dense sets `x + ⊕_Δ F_2`**
(tex l.541–542). -/
theorem manuscriptSentence_lambdaGenerationDenseOrbits (Δ : Type) [Group Δ] :
    Subgroup.closure
        (insert (lampAdd Δ) (Set.range (SemidirectProduct.inr : Δ →* LampAffine Δ))) = ⊤ ∧
    (∀ (x : LampSpace Δ) (η : Δ),
      (lampAdd Δ • x) η = x η + Finsupp.single (1 : Δ) (1 : ZMod 2) η) ∧
    ∀ x : LampSpace Δ,
      Dense {y : LampSpace Δ | ∃ f : Δ →₀ ZMod 2, ∀ η, y η = x η + f η} ∧
        {y : LampSpace Δ | ∃ f : Δ →₀ ZMod 2, ∀ η, y η = x η + f η} ⊆
          MulAction.orbit (LampAffine Δ) x := by
  refine ⟨Lamplighter.closure_insert_lampAdd_range_inr Δ, Lamplighter.lampAdd_smul_apply Δ,
    fun x => ⟨Lamplighter.dense_add_finsupp Δ x, ?_⟩⟩
  rintro y ⟨f, hf⟩
  have hy : y = fun η => x η + f η := funext hf
  rw [hy]
  exact Lamplighter.mem_orbit_add Δ x f

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_lambdaGenerationDenseOrbits

/-- **The generators of `R_Δ`** (tex l.548–550): `Λ` has a finite generating set, and for every
generating set `T` of `Λ` the ring `R_Δ` is generated by `1`, the `u_ξ^{±1}` with `ξ ∈ T`, and
`e_U`. -/
theorem manuscriptSentence_ringGenerators (Δ : Type) [Group Δ] (hΔ : Group.FG Δ) :
    (∃ T : Set (LampAffine Δ), T.Finite ∧ Subgroup.closure T = ⊤) ∧
    ∀ T : Set (LampAffine Δ), Subgroup.closure T = ⊤ →
      Subring.closure
        (insert (1 : LampRing Δ)
          ((fun s => (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s :
              LampRing Δ)) '' T ∪
            (fun s => (((ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s)⁻¹ :
              (LampRing Δ)ˣ) : LampRing Δ)) '' T ∪
            {ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
              (LocallyConstant.charFn (ZMod 2) (Lamplighter.isClopen_coordOne Δ))})) = ⊤ := by
  obtain ⟨T, hT, hTfin⟩ := Group.fg_iff.1 (Lamplighter.fg_lampAffine Δ hΔ)
  exact ⟨⟨T, hTfin, hT⟩, fun _ hT' => Lamplighter.closure_generators_eq_top Δ hT'⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_ringGenerators

/-- **`Δ ≤ Λ`, and `[Λ,Λ]` contains `[Δ,Δ]`** (tex l.585–586). -/
theorem manuscriptSentence_commutatorContainment (Δ : Type) [Group Δ] :
    Function.Injective (SemidirectProduct.inr : Δ →* LampAffine Δ) ∧
      (commutator Δ).map (SemidirectProduct.inr : Δ →* LampAffine Δ) ≤
        commutator (LampAffine Δ) := by
  refine ⟨SemidirectProduct.inr_injective, ?_⟩
  rw [commutator_def, commutator_def, Subgroup.map_commutator]
  exact Subgroup.commutator_mono le_top le_top

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Host.manuscriptSentence_commutatorContainment

end Host
end SimpleKazhdanSofic
end GroupApproximation
