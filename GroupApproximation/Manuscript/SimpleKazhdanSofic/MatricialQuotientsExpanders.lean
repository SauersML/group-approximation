import GroupApproximation.Manuscript.SimpleKazhdanSofic.KazhdanQuotientExpanders
import GroupApproximation.Manuscript.SimpleKazhdanSofic.FreeAlgebraKazhdan
import GroupApproximation.Meta.AxiomGuard

/-!
# The finite simple models of `thm:general` form expanders

`simple_kazhdan_sofic_group.tex` at origin/main 37551fd93, `thm:general` (tex l.109–127):

> Marked by the $e_{ij}(s)$ with $s\in S$, it is the limit of the finite simple groups
> $\SL_{nN_k}(\F_2)$ marked by the $e_{ij}(\varphi_k(s))$, whose Cayley graphs form a family of
> expanders.

and section "Finite simple models" (tex l.211–236):

> Let $F$ be the free algebra over $\F_2$ on letters $\tau_s$, $s\in S$, and let
> $\pi\colon F\to R$ and $\rho_k\colon F\to M_{N_k}(\F_2)$ be the ring homomorphisms with
> $\pi(\tau_s)=s$ and $\rho_k(\tau_s)=\varphi_k(s)$. Both are onto, so $G$ and
> $\EL_3(M_{N_k}(\F_2))$ are quotients of $\EL_3(F)$. [...] The group $\EL_3(F)$ is generated by the
> $e_{ij}(1)$ and $e_{ij}(\tau_s)$, and in both quotients $e_{ij}(1)$ and $e_{ij}(\tau_1)$ have the
> same image. [...] Since $\EL_3(F)$ has property~\textup{(T)}~\cite[Theorem~1.1]{EJZ}, its finite
> quotients form a family of expanders~\cite{Margulis,Kassabov}.

The route is the printed one, with no literature input:

* `isExpanderFamily_of_hasKazhdanPropertyT_images`: let `Γ` have property (T) and be generated by a
  finite family `t`, let `π ℓ` map `Γ` onto finite groups of unbounded order, and let every
  `π ℓ (t j)` be the marking generator `σ ℓ (f j)`.  Then the Cayley graphs with respect to `σ ℓ` form
  a family of expanders.  The estimate is `Analysis/KazhdanQuotientCheeger`.
* `closure_range_elementaryLetterMarking`: for `n ≥ 3`, `EL_n(F₂⟨τ_x⟩)` is generated by the `e_ij(1)`
  and the `e_ij(τ_x)`.  The coefficients whose elementary matrices lie in the subgroup they generate
  form an `F₂`-subalgebra (`elementaryCoefficientSubalgebra`), and it contains the letters.
* `lift_surjective_of_closure`: `ρ_k` is onto when `φ_k(S)` generates `M_{N_k}(F₂)` as a ring.
* `isExpanderFamily_matricialMarking`: `EL_n(M_{N_k}(F₂))` marked by the `e_ij(φ_k(s))`, `s ∈ S`, is an
  expander family.  The quotient maps are `EL_n(ρ_k)`.  A generator `e_ij(τ_s)` maps to
  `e_ij(φ_k(s))`, and `e_ij(1)` maps to `e_ij(φ_k(1))` because `1 ∈ S` and `φ_k(1) = 1`.  Property (T)
  of `EL_n(F)` is `hasKazhdanPropertyT_elementaryGroup_freeAlgebra`, through the proved EJZ theorem.
* `PrintedMatricialQuotientsExpanders`: the closed endpoint.  The marking is spelled exactly as the
  marking `matricialMarking n S N φ` of `thm:general`.  The hypotheses are the two clauses of "`R` is
  matricial via `φ_k`" that this step uses: `φ_k(1) = 1`, and `φ_k(S)` generates `M_{N_k}(F₂)`.  The
  printed "$N_k\to\infty$" (tex l.234–235, from the marked limit) enters as the orders tending to
  infinity.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic

open Filter

universe u v w w'

/-! ## Kazhdan quotients with a marking -/

/-- **Finite quotients of a Kazhdan group form expanders, with respect to a marking of the
quotients.**  Let `Γ` have property (T) and be generated by the finite family `t`, let `π ℓ` map `Γ`
onto finite groups whose orders tend to infinity, and let every generator `t j` map to the marking
generator `σ ℓ (f j)`.  Then the Cayley graphs with respect to `σ ℓ` form a family of expanders. -/
theorem isExpanderFamily_of_hasKazhdanPropertyT_images {Γ : Type u} [Group Γ]
    (hT : HasKazhdanPropertyT.{u, v} Γ) {κ : Type w} [Finite κ] (t : κ → Γ)
    (ht : Subgroup.closure (Set.range t) = ⊤) {ι : Type w'} [Finite ι] {H : ℕ → Type v}
    [∀ ℓ, Group (H ℓ)] [∀ ℓ, Finite (H ℓ)] (π : ∀ ℓ, Γ →* H ℓ)
    (hπ : ∀ ℓ, Function.Surjective (π ℓ))
    (hcard : Tendsto (fun ℓ ↦ Nat.card (H ℓ)) atTop atTop) (σ : ∀ ℓ, ι → H ℓ) (f : κ → ι)
    (hf : ∀ ℓ j, π ℓ (t j) = σ ℓ (f j)) :
    IsExpanderFamily σ := by
  classical
  haveI : Fintype κ := Fintype.ofFinite κ
  obtain ⟨Q₀, ε, hQ₀⟩ := hT
  have hgen : Subgroup.closure ((Finset.univ.image t : Finset Γ) : Set Γ) = ⊤ := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, ht]
  obtain ⟨δ, hδ⟩ := KazhdanQuotientCheeger.exists_isKazhdanPair_of_closure_eq_top hQ₀ _ hgen
  refine ⟨inferInstance, fun ℓ ↦ inferInstance, hcard, δ ^ 2 / 4,
    div_pos (pow_pos hδ.1 2) (by norm_num), ?_⟩
  intro ℓ S hS
  haveI : Fintype (H ℓ) := Fintype.ofFinite (H ℓ)
  set A : Finset (H ℓ) := S.toFinset with hAdef
  have hSA : S.ncard = A.card := Set.ncard_eq_toFinset_card' S
  rcases A.eq_empty_or_nonempty with hA0 | hne
  · rw [hSA, hA0]
    simp
  have hA : 2 * A.card ≤ Fintype.card (H ℓ) := by
    rw [← hSA, ← Nat.card_eq_fintype_card]
    exact hS
  obtain ⟨s, hs, hbound⟩ :=
    KazhdanQuotientCheeger.kazhdanPair_quotient_boundary hδ (π ℓ) (hπ ℓ) A hne hA
  obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hs
  rw [hf ℓ j] at hbound
  have hinj : Function.Injective fun a : H ℓ ↦ (a, f j) := fun a b h ↦ (Prod.mk.inj h).1
  have hsub : (fun a : H ℓ ↦ (a, f j)) ''
        ((A.filter fun a ↦ σ ℓ (f j) * a ∉ A : Finset (H ℓ)) : Set (H ℓ)) ⊆
      {p : H ℓ × ι | p.1 ∈ S ∧ σ ℓ p.2 * p.1 ∉ S} := by
    rintro _ ⟨a, ha, rfl⟩
    simpa [hAdef] using ha
  have hcardle : ((A.filter fun a ↦ σ ℓ (f j) * a ∉ A).card : ℝ) ≤
      (({p : H ℓ × ι | p.1 ∈ S ∧ σ ℓ p.2 * p.1 ∉ S} : Set (H ℓ × ι)).ncard : ℝ) := by
    have hle := Set.ncard_le_ncard hsub
    rw [Set.ncard_image_of_injective _ hinj, Set.ncard_coe_finset] at hle
    exact_mod_cast hle
  rw [hSA]
  exact hbound.trans hcardle

/-! ## The free algebra and its elementary generators -/

/-- The coefficients `1` and `τ_x` of the generators of `EL_n(F₂⟨τ_x : x ∈ X⟩)`. -/
noncomputable def letterCoeff (X : Type*) : Option X → FreeAlgebra (ZMod 2) X
  | none => 1
  | some x => FreeAlgebra.ι (ZMod 2) x

/-- `EL_n(F₂⟨τ_x : x ∈ X⟩)` marked by the `e_ij(1)` and the `e_ij(τ_x)` (tex l.225–226). -/
noncomputable def elementaryLetterMarking (n : ℕ) (X : Type*) :
    {p : Fin n × Fin n // p.1 ≠ p.2} × Option X →
      ↥(elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) X)) :=
  fun q ↦ ⟨elementaryUnit q.1.1.1 q.1.1.2 q.1.2 (letterCoeff X q.2), elementaryUnit_mem _ _ _ _⟩

/-- **Tex l.225–226**: "The group $\EL_3(F)$ is generated by the $e_{ij}(1)$ and
$e_{ij}(\tau_s)$", for every `n ≥ 3`. -/
theorem closure_range_elementaryLetterMarking (n : ℕ) (hn : 3 ≤ n) (X : Type*) :
    Subgroup.closure (Set.range (elementaryLetterMarking n X)) = ⊤ := by
  classical
  let H' : Subgroup (Matrix (Fin n) (Fin n) (FreeAlgebra (ZMod 2) X))ˣ :=
    (Subgroup.closure (Set.range (elementaryLetterMarking n X))).map
      (elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) X)).subtype
  have hmem : ∀ (i j : Fin n) (h : i ≠ j) (o : Option X),
      elementaryUnit i j h (letterCoeff X o) ∈ H' := by
    intro i j h o
    exact ⟨elementaryLetterMarking n X (⟨(i, j), h⟩, o), Subgroup.subset_closure ⟨_, rfl⟩, rfl⟩
  let C : Subalgebra (ZMod 2) (FreeAlgebra (ZMod 2) X) :=
    elementaryCoefficientSubalgebra n (by omega) H' fun i j h ↦ hmem i j h none
  have hgen : Set.range (FreeAlgebra.ι (ZMod 2) : X → FreeAlgebra (ZMod 2) X) ⊆
      (C : Set (FreeAlgebra (ZMod 2) X)) := by
    rintro _ ⟨x, rfl⟩ i j h
    exact hmem i j h (some x)
  have hC : C = ⊤ := by
    apply top_unique
    rw [← FreeAlgebra.adjoin_range_ι]
    exact Algebra.adjoin_le hgen
  have hle : elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) X) ≤ H' := by
    rw [elementaryGroup, Subgroup.closure_le]
    rintro _ ⟨i, j, h, a, rfl⟩
    have ha : a ∈ C := by simp [hC]
    exact ha i j h
  rw [eq_top_iff]
  intro g _
  obtain ⟨x, hx, hxg⟩ := hle g.2
  have hxg' : x = g := Subtype.ext hxg
  exact hxg' ▸ hx

/-- **Tex l.214–216**, "$\rho_k\colon F\to M_{N_k}(\F_2)$ [...] with $\rho_k(\tau_s)=\varphi_k(s)$
[...] is onto" when `φ_k(S)` generates `M_{N_k}(F₂)` as a ring. -/
theorem lift_surjective_of_closure {R : Type*} (S : Finset R) {N : ℕ}
    (ψ : R → Matrix (Fin N) (Fin N) (ZMod 2))
    (hgen : Subring.closure (ψ '' (S : Set R)) = ⊤) :
    Function.Surjective (FreeAlgebra.lift (ZMod 2) fun s : ↥S ↦ ψ s) := by
  have hle : Subring.closure (ψ '' (S : Set R)) ≤
      (FreeAlgebra.lift (ZMod 2) fun s : ↥S ↦ ψ s).toRingHom.range := by
    rw [Subring.closure_le]
    rintro _ ⟨x, hx, rfl⟩
    exact RingHom.mem_range.mpr
      ⟨FreeAlgebra.ι (ZMod 2) ⟨x, Finset.mem_coe.mp hx⟩, FreeAlgebra.lift_ι_apply _ _⟩
  intro y
  obtain ⟨x, hx⟩ := RingHom.mem_range.mp (hle (by rw [hgen]; exact Subring.mem_top y))
  exact ⟨x, hx⟩

/-! ## The printed step -/

/-- **Tex l.235–236**, "Since $\EL_3(F)$ has property (T), its finite quotients form a family of
expanders", for every `n ≥ 3`: `EL_n(M_{N_k}(F₂))` marked by the `e_ij(φ_k(s))`, `s ∈ S`, is an expander
family when `1 ∈ S`, `φ_k(1) = 1`, `φ_k(S)` generates `M_{N_k}(F₂)`, and the orders tend to infinity. -/
theorem isExpanderFamily_matricialMarking {R : Type} [Ring R] (S : Finset R) (hS1 : (1 : R) ∈ S)
    (N : ℕ → ℕ) (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))
    (hone : ∀ k, φ k 1 = 1) (hgen : ∀ k, Subring.closure (φ k '' (S : Set R)) = ⊤)
    (n : ℕ) (hn : 3 ≤ n)
    (hcard : Tendsto (fun k ↦
      Nat.card ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)))) atTop atTop) :
    IsExpanderFamily
      (H := fun k ↦ ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))))
      fun k (p : {p : Fin n × Fin n // p.1 ≠ p.2} × ↥S) ↦
        (⟨elementaryUnit p.1.1.1 p.1.1.2 p.1.2 (φ k (p.2 : R)), elementaryUnit_mem _ _ _ _⟩ :
          ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)))) := by
  classical
  haveI hfin : ∀ k, Finite ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))) := by
    intro k
    haveI : Finite (Matrix (Fin n) (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))) :=
      inferInstanceAs (Finite (Fin n → Fin n → Fin (N k) → Fin (N k) → ZMod 2))
    exact Subtype.finite
  let ρ : ∀ k, FreeAlgebra (ZMod 2) ↥S →+* Matrix (Fin (N k)) (Fin (N k)) (ZMod 2) :=
    fun k ↦ (FreeAlgebra.lift (ZMod 2) fun s : ↥S ↦ φ k s).toRingHom
  refine isExpanderFamily_of_hasKazhdanPropertyT_images
    (hasKazhdanPropertyT_elementaryGroup_freeAlgebra ↥S n hn) (elementaryLetterMarking n ↥S)
    (closure_range_elementaryLetterMarking n hn ↥S) (fun k ↦ elementaryGroupMap (ρ k))
    (fun k ↦ elementaryGroupMap_surjective_of_surjective (ρ k)
      (lift_surjective_of_closure S (φ k) (hgen k)))
    hcard _ (fun q ↦ (q.1, q.2.elim ⟨1, hS1⟩ id)) ?_
  rintro k ⟨p, o⟩
  apply Subtype.ext
  change elementaryMatrixUnitMap (ρ k) (elementaryUnit p.1.1 p.1.2 p.2 (letterCoeff ↥S o)) =
    elementaryUnit p.1.1 p.1.2 p.2 (φ k ((o.elim ⟨1, hS1⟩ id : ↥S) : R))
  rw [elementaryMatrixUnitMap_elementaryUnit]
  congr 1
  cases o with
  | none => exact (map_one (ρ k)).trans (hone k).symm
  | some s => exact FreeAlgebra.lift_ι_apply _ _

/-- **Tex l.235–236 and the expander clause of `thm:general` (tex l.119–121)**, along the printed
route: for every unital ring `R`, finite `S ∋ 1`, maps `φ_k : R → M_{N_k}(F₂)` with `φ_k(1) = 1` whose
values on `S` generate `M_{N_k}(F₂)`, and every `n ≥ 3`, if the orders of `EL_n(M_{N_k}(F₂))` tend to
infinity, then these groups marked by the `e_ij(φ_k(s))`, `s ∈ S`, form a family of expanders. -/
def PrintedMatricialQuotientsExpanders : Prop :=
  ∀ (R : Type) [Ring R] (S : Finset R), (1 : R) ∈ S →
    ∀ (N : ℕ → ℕ) (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)),
      (∀ k, φ k 1 = 1) → (∀ k, Subring.closure (φ k '' (S : Set R)) = ⊤) →
      ∀ n : ℕ, 3 ≤ n →
        Tendsto (fun k ↦
          Nat.card ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))))
          atTop atTop →
        IsExpanderFamily
          (H := fun k ↦ ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))))
          fun k (p : {p : Fin n × Fin n // p.1 ≠ p.2} × ↥S) ↦
            (⟨elementaryUnit p.1.1.1 p.1.1.2 p.1.2 (φ k (p.2 : R)), elementaryUnit_mem _ _ _ _⟩ :
              ↥(elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))))

theorem printedMatricialQuotientsExpanders : PrintedMatricialQuotientsExpanders := by
  intro R _ S hS1 N φ hone hgen n hn hcard
  exact isExpanderFamily_matricialMarking S hS1 N φ hone hgen n hn hcard

#audit_axioms isExpanderFamily_of_hasKazhdanPropertyT_images
#audit_axioms closure_range_elementaryLetterMarking
#audit_axioms isExpanderFamily_matricialMarking
#audit_closed_axioms printedMatricialQuotientsExpanders

end SimpleKazhdanSofic
end GroupApproximation
