import GroupApproximation.Manuscript.SimpleKazhdanSofic.LevelShiftDeltaWordProblem
import GroupApproximation.GroupTheory.LevelShiftDeltaModels
import GroupApproximation.Meta.AxiomGuard

/-!
# The second choice of `Δ`: the piece `LEFSolvableWordProblemEmbeddingStatement`

`simple_kazhdan_sofic_group.tex` at origin/main 8b36733d7, section "LEF groups", tex l.412–444:

> Now let Γ be generated by a finite set E, LEF and with solvable word problem. […] On Γ × ℤ, whose second coordinate is
> the level, let β raise the level by 1, and let h_γ multiply the first coordinate from the left by γ on the levels m ≥ 0.
> Then [β,h_γ] multiplies the level 0 by γ⁻¹, so Δ = ⟨β,h_γ : γ ∈ E⟩ is infinite and Γ ≤ [Δ,Δ]. […] So Δ is LEF, and
> the argument above applies to it.
>
> From a word in the β^{±1} and h_γ^{±1} one computes […] so Δ has solvable word problem.

* `printedSecondDeltaCommutator` (l.417–420), `printedSecondDeltaLEF` (l.438) and
  `printedSecondDeltaSolvableWordProblem` (l.440–444): closed named endpoints;
* `lefSolvableWordProblemEmbeddingStatement`: sk-lef-assembly's piece. `E` is the finite range of a generating family,
  and `Δ = levelDelta Γ E`.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic

open LevelShiftDelta LevelShiftDeltaWordProblem
open scoped commutatorElement

/-- tex l.417–420: `[β,h_γ]` multiplies the level `0` by `γ⁻¹`, so `Δ = ⟨β,h_γ : γ ∈ E⟩` is infinite and `Γ ≤ [Δ,Δ]`. -/
def PrintedSecondDeltaCommutator : Prop :=
  ∀ (Γ : Type) [Group Γ] (E : Finset Γ), Subgroup.closure (E : Set Γ) = ⊤ →
    (∀ γ : Γ, ⁅levelShift Γ, levelMul γ⁆ = levelZeroMul γ⁻¹) ∧ Infinite ↥(levelDelta Γ E) ∧
      ∃ f : Γ →* ↥(levelDelta Γ E), Function.Injective f ∧ ∀ γ, f γ ∈ commutator ↥(levelDelta Γ E)

theorem printedSecondDeltaCommutator : PrintedSecondDeltaCommutator :=
  fun _ _ E hE => ⟨commutator_levelShift_levelMul, infinite_levelDelta E, exists_levelZeroEmbedding E hE⟩

/-- tex l.438: "So Δ is LEF". -/
def PrintedSecondDeltaLEF : Prop :=
  ∀ (Γ : Type) [Group Γ] (E : Finset Γ), IsTextbookLEF Γ → IsTextbookLEF ↥(levelDelta Γ E)

theorem printedSecondDeltaLEF : PrintedSecondDeltaLEF :=
  fun _ _ E h => isTextbookLEF_levelDelta h E

/-- tex l.440–444: the generators `β` and `h_{s i}` of `Δ` have solvable word problem when the generators `s` of `Γ` do. -/
def PrintedSecondDeltaSolvableWordProblem : Prop :=
  ∀ (Γ : Type) [Group Γ] (ι : Type) [Primcodable ι] [Finite ι] (s : ι → Γ), Partrec (wordProblemOracle s) →
    HasSolvableWordProblem ↥(Subgroup.closure (Set.range (levelGen s)))

theorem printedSecondDeltaSolvableWordProblem : PrintedSecondDeltaSolvableWordProblem :=
  fun _ _ _ _ _ s hs => hasSolvableWordProblem_closure_levelGen s hs

/-- **The piece `LEFSolvableWordProblemEmbeddingStatement`** (sk-lef-assembly, `LEFSolvableWordProblem`), proved along
tex l.412–444: a finitely generated LEF group with solvable word problem embeds in the commutator subgroup of the second
choice of `Δ`, which is infinite, finitely generated, LEF and with solvable word problem. -/
theorem lefSolvableWordProblemEmbeddingStatement : LEFSolvableWordProblemEmbeddingStatement := by
  intro Γ _ _ hLEF hSWP
  obtain ⟨ι, hp, hfin, s, hgen, hpar⟩ := hSWP
  classical
  have hfinr : (Set.range s).Finite := Set.finite_range s
  have ht : Set.range s = ((hfinr.toFinset : Finset Γ) : Set Γ) := by
    rw [Set.Finite.coe_toFinset]
  have hE : Subgroup.closure ((hfinr.toFinset : Finset Γ) : Set Γ) = ⊤ := by
    rw [← ht]
    exact hgen
  have hΔ : levelDelta Γ hfinr.toFinset = Subgroup.closure (Set.range (levelGen s)) :=
    levelDelta_eq_closure_range hfinr.toFinset s ht
  obtain ⟨f, hf, hfc⟩ := exists_levelZeroEmbedding hfinr.toFinset hE
  have hswp := hasSolvableWordProblem_closure_levelGen s hpar
  rw [← hΔ] at hswp
  exact ⟨↥(levelDelta Γ hfinr.toFinset), inferInstance, infinite_levelDelta hfinr.toFinset,
    fg_levelDelta hfinr.toFinset,
    (isLEF_iff_textbook _).2 (isTextbookLEF_levelDelta ((isLEF_iff_textbook Γ).1 hLEF) hfinr.toFinset),
    hswp, f, hf, hfc⟩

#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedSecondDeltaCommutator
#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedSecondDeltaLEF
#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedSecondDeltaSolvableWordProblem
#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.lefSolvableWordProblemEmbeddingStatement

end SimpleKazhdanSofic
end GroupApproximation
