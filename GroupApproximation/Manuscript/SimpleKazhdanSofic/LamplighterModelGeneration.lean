import GroupApproximation.Manuscript.SimpleKazhdanSofic.LamplighterModelMatrices
import GroupApproximation.Meta.AxiomGuard
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Data.Matrix.Basis
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.LinearAlgebra.Matrix.Reindex

/-!
# The images of the generators generate `M_{2^{|Q'_n|}}(F_2)`

`simple_kazhdan_sofic_group.tex` at origin/main 696c4b602 (md5 0648e5f8…), tex 416–419, in the
proof of `cor:lef` and `cor:host`:

> The conjugates of `D_n(e_U)` by products of the `P_s` are the coordinate functions of `Y_n`, and the
> conjugates of `P_z` are the translations by the `1_q`, so the images of the generators generate
> `M_{2^{|Q'_n|}}(F_2)`.

The generators of `R_Δ` are `lampGenerators T`: `1`, the `u_s^{±1}` for `s ∈ T ∪ {z}` with `T` a
generating set of `Δ` (`inr`), and `e_U` (tex 393–396).

* `qPermHom M n q`: `y ↦ q y`; `modelAct_inr_eq`: `P_{inr δ}` is the permutation matrix of `σ_n(δ)`;
  `permMatrixHom_qPerm_mem_closure`: products of the `P_s` give every `q ∈ Q'_n` (`Q'_n` is generated by
  the images of the generators);
* `conj_modelMap_eU`: `P_q D_n(e_U) P_q⁻¹ = diag(y ↦ y(q))`, the coordinate functions;
* `addPermHom M n v`: `y ↦ y + v`; `conj_modelPerm_lampAdd`: `P_q P_z P_q⁻¹` is the translation by `1_q`;
* `closure_modelMap_lampGenerators_eq_top`: the images generate `M_{Y_n}(F_2)`, through diagonal point
  indicators, all translations and the matrix units `E_{y,y'} = diag(1_y) · (translation by y - y')`;
* `modelDim_eq`: `|Y_n| = 2^{|Q'_n|}`; `modelMapFin M n`: `φ_n` reindexed to `M_{|Y_n|}(F_2)`, and the
  clauses of "`R_Δ` is matricial" for it.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace Lamplighter

open Filter
open SkewMonoidAlgebra (single)

/-! ## Permutation matrices -/

theorem permMatrixHom_apply_eq {ι : Type*} [Fintype ι] [DecidableEq ι] (τ : Equiv.Perm ι)
    (i j : ι) : (Matrix.permMatrixHom (R := ZMod 2) τ) i j = if i = τ j then 1 else 0 := by
  rw [Matrix.permMatrixHom_apply]
  show (τ⁻¹.toPEquiv.toMatrix : Matrix ι ι (ZMod 2)) i j = _
  rw [PEquiv.toMatrix_apply, Equiv.toPEquiv_apply]
  by_cases h : i = τ j
  · rw [if_pos (Option.mem_some_iff.2 (by rw [h]; simp)), if_pos h]
  · rw [if_neg (fun hm => h (by rw [← Option.mem_some_iff.1 hm]; simp)), if_neg h]

theorem permMatrixHom_mul_diagonal {ι : Type*} [Fintype ι] [DecidableEq ι] (τ : Equiv.Perm ι)
    (d : ι → ZMod 2) :
    Matrix.permMatrixHom (R := ZMod 2) τ * Matrix.diagonal d =
      Matrix.diagonal (d ∘ ⇑τ⁻¹) * Matrix.permMatrixHom (R := ZMod 2) τ := by
  ext i j
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul, permMatrixHom_apply_eq]
  by_cases h : i = τ j
  · rw [if_pos h, one_mul, mul_one, h]
    simp
  · rw [if_neg h, zero_mul, mul_zero]

theorem permMatrixHom_conj_diagonal {ι : Type*} [Fintype ι] [DecidableEq ι] (τ : Equiv.Perm ι)
    (d : ι → ZMod 2) :
    Matrix.permMatrixHom (R := ZMod 2) τ * Matrix.diagonal d * Matrix.permMatrixHom (R := ZMod 2) τ⁻¹ =
      Matrix.diagonal (d ∘ ⇑τ⁻¹) := by
  rw [permMatrixHom_mul_diagonal, mul_assoc, ← map_mul, mul_inv_cancel, map_one, mul_one]

variable {Δ : Type*} [Group Δ] {T : Set Δ} (M : BallModelSequence Δ T) (n : ℕ)

/-! ## The permutations of `Y_n` -/

/-- `q ↦ (y ↦ q y)`. -/
def qPermHom : M.Q n →* Equiv.Perm (ModelSpace M n) where
  toFun q :=
    { toFun := qSmul M n q
      invFun := qSmul M n q⁻¹
      left_inv := fun y => by rw [qSmul_qSmul, inv_mul_cancel, qSmul_one]
      right_inv := fun y => by rw [qSmul_qSmul, mul_inv_cancel, qSmul_one] }
  map_one' := Equiv.ext fun y => qSmul_one M n y
  map_mul' a b := Equiv.ext fun y => (qSmul_qSmul M n a b y).symm

/-- `v ↦ (y ↦ y + v)`. -/
def addPermHom : Multiplicative (ModelSpace M n) →* Equiv.Perm (ModelSpace M n) where
  toFun v := Equiv.addRight (Multiplicative.toAdd v)
  map_one' := Equiv.ext fun y => add_zero y
  map_mul' a b := Equiv.ext fun y => by
    show y + (Multiplicative.toAdd a + Multiplicative.toAdd b) =
      (y + Multiplicative.toAdd b) + Multiplicative.toAdd a
    abel

theorem modelAct_inr_eq (δ : Δ) :
    modelAct M n (SemidirectProduct.inr δ) = qPermHom M n (M.σ n δ) :=
  Equiv.ext fun y => modelAct_inr M n δ y

theorem modelAct_lampAdd_eq :
    modelAct M n (lampAdd Δ) =
      addPermHom M n (Multiplicative.ofAdd (Pi.single (1 : M.Q n) (1 : ZMod 2))) :=
  Equiv.ext fun y => modelAct_lampAdd M n y

/-! ## The generators and their images -/

/-- **The generators of `R_Δ`** (tex 393–396): `1`, the `u_s^{±1}` for `s ∈ T ∪ {z}`, and `e_U`. -/
abbrev lampGenerators (T : Set Δ) : Set (LampRing Δ) :=
  lampRingGenerators Δ (insert (lampAdd Δ) ((SemidirectProduct.inr : Δ →* LampAffine Δ) '' T))

theorem lampGenerators_finite (hT : T.Finite) : (lampGenerators T).Finite :=
  ((((hT.image _).insert _).image _).union (((hT.image _).insert _).image _)).union
    (Set.finite_singleton _) |>.insert _

theorem closure_lampGenerators (hT : Subgroup.closure T = ⊤) :
    Subring.closure (lampGenerators T) = ⊤ :=
  closure_generators_eq_top Δ (closure_insert_lampAdd_image_inr Δ hT)

theorem mem_lampGenerators_unit {ξ : LampAffine Δ}
    (hξ : ξ ∈ insert (lampAdd Δ) ((SemidirectProduct.inr : Δ →* LampAffine Δ) '' T)) :
    (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ : LampRing Δ) ∈
      lampGenerators T :=
  Set.mem_insert_of_mem _ (Set.mem_union_left _ (Set.mem_union_left _ ⟨ξ, hξ, rfl⟩))

theorem mem_lampGenerators_eU :
    ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
        (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ)) ∈ lampGenerators T :=
  Set.mem_insert_of_mem _ (Set.mem_union_right _ (Set.mem_singleton _))

theorem one_mem_lampGenerators : (1 : LampRing Δ) ∈ lampGenerators T :=
  Set.mem_insert _ _

/-- `φ_n(u_ξ) = P_ξ`. -/
theorem modelMap_unit (ξ : LampAffine Δ) :
    modelMap M n (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ :
      LampRing Δ) = modelPerm M n ξ := by
  rw [ClopenGroupCrossedProduct.val_unit, modelMap_single, map_one, map_one, one_mul]

/-- `φ_n(e_U) = D_n(e_U) = diag(y ↦ y(e))`. -/
theorem modelMap_eU :
    modelMap M n (ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
        (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ))) =
      Matrix.diagonal fun y : ModelSpace M n => y 1 := by
  rw [ClopenGroupCrossedProduct.coeff_apply, modelMap_single, RingEquiv.symm_apply_apply,
    modelPerm_one, mul_one, charFn_coordOne, modelDiag_apply]
  congr 1
  funext y
  show y (M.σ n 1) = y 1
  rw [(M.isBallModel n).map_one]

/-- **Products of the `P_s`** give the permutation matrix of every `q ∈ Q'_n`, since `Q'_n` is
generated by the images of the generators and is finite. -/
theorem permMatrixHom_qPerm_mem_closure (q : M.Q n) :
    Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q) ∈
      Subring.closure (modelMap M n '' lampGenerators T) := by
  have hunit : ∀ δ ∈ T, modelPerm M n (SemidirectProduct.inr δ) ∈
      Subring.closure (modelMap M n '' lampGenerators T) := fun δ hδ => by
    rw [← modelMap_unit]
    exact Subring.subset_closure ⟨_, mem_lampGenerators_unit (Set.mem_insert_of_mem _ ⟨δ, hδ, rfl⟩), rfl⟩
  have hqc : q ∈ Subgroup.closure (M.σ n '' T) := by
    rw [(M.isBallModel n).closure_image]
    exact Subgroup.mem_top q
  induction hqc using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨δ, hδ, rfl⟩ := hx
    rw [← modelAct_inr_eq]
    exact hunit δ hδ
  | one =>
    rw [map_one, map_one]
    exact Subring.one_mem _
  | mul x y _ _ hx hy =>
    rw [map_mul, map_mul]
    exact Subring.mul_mem _ hx hy
  | inv x _ hx =>
    have hinv : x⁻¹ = x ^ (orderOf x - 1) := by
      refine (eq_inv_of_mul_eq_one_left ?_).symm
      rw [← pow_succ, Nat.sub_add_cancel (orderOf_pos x), pow_orderOf_eq_one]
    rw [hinv, map_pow, map_pow]
    exact Subring.pow_mem _ hx _

/-- **The conjugates of `D_n(e_U)` by products of the `P_s` are the coordinate functions of `Y_n`**
(tex 416–417): `P_q D_n(e_U) P_q⁻¹ = diag(y ↦ y(q))`. -/
theorem conj_modelMap_eU (q : M.Q n) :
    Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q) *
        modelMap M n (ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
          (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ))) *
        Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q)⁻¹ =
      Matrix.diagonal fun y : ModelSpace M n => y q := by
  rw [modelMap_eU, permMatrixHom_conj_diagonal]
  congr 1
  funext y
  show qSmul M n q⁻¹ y 1 = y q
  rw [qSmul_apply, inv_inv, mul_one]

/-- **The conjugates of `P_z` are the translations by the `1_q`** (tex 417–418). -/
theorem conj_modelPerm_lampAdd (q : M.Q n) :
    Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q) * modelPerm M n (lampAdd Δ) *
        Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q)⁻¹ =
      Matrix.permMatrixHom (R := ZMod 2)
        (addPermHom M n (Multiplicative.ofAdd (Pi.single q (1 : ZMod 2)))) := by
  have hconj : qPermHom M n q *
      addPermHom M n (Multiplicative.ofAdd (Pi.single (1 : M.Q n) (1 : ZMod 2))) *
        (qPermHom M n q)⁻¹ =
      addPermHom M n (Multiplicative.ofAdd (Pi.single q (1 : ZMod 2))) := by
    refine Equiv.ext fun y => ?_
    show qSmul M n q (qSmul M n q⁻¹ y + Pi.single (1 : M.Q n) (1 : ZMod 2)) =
      y + Pi.single q (1 : ZMod 2)
    rw [qSmul_add, qSmul_qSmul, mul_inv_cancel, qSmul_one, qSmul_single, mul_one]
  rw [← hconj, modelPerm, modelAct_lampAdd_eq, map_mul, map_mul]

/-- **The images of the generators generate `M_{Y_n}(F_2)`** (tex 418–419). -/
theorem closure_modelMap_lampGenerators_eq_top :
    Subring.closure (modelMap M n '' lampGenerators T) = ⊤ := by
  classical
  set A := Subring.closure (modelMap M n '' lampGenerators T) with hA
  have hq : ∀ q : M.Q n, Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q) ∈ A :=
    permMatrixHom_qPerm_mem_closure M n
  have heU : modelMap M n (ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
      (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ))) ∈ A :=
    Subring.subset_closure ⟨_, mem_lampGenerators_eU, rfl⟩
  have hz : modelPerm M n (lampAdd Δ) ∈ A := by
    rw [← modelMap_unit]
    exact Subring.subset_closure ⟨_, mem_lampGenerators_unit (Set.mem_insert _ _), rfl⟩
  have hcoord : ∀ q : M.Q n, Matrix.diagonal (fun y : ModelSpace M n => y q) ∈ A := fun q => by
    rw [← conj_modelMap_eU, ← map_inv]
    exact A.mul_mem (A.mul_mem (hq q) heU) (hq q⁻¹)
  have hdiag : ∀ y₀ : ModelSpace M n, Matrix.diagonal (Pi.single y₀ (1 : ZMod 2)) ∈ A := by
    intro y₀
    let B : Subring (ModelSpace M n → ZMod 2) := A.comap (Matrix.diagonalRingHom _ _)
    have hB : ∀ q : M.Q n,
        (fun y : ModelSpace M n => if y₀ q = 1 then y q else 1 - y q) ∈ B := by
      intro q
      by_cases h1 : y₀ q = 1
      · have hf : (fun y : ModelSpace M n => if y₀ q = 1 then y q else 1 - y q) = fun y => y q :=
          funext fun y => if_pos h1
        rw [hf]
        exact hcoord q
      · have hf : (fun y : ModelSpace M n => if y₀ q = 1 then y q else 1 - y q) =
            1 - fun y => y q :=
          funext fun y => if_neg h1
        rw [hf]
        exact B.sub_mem B.one_mem (hcoord q)
    have hprod : (∏ q : M.Q n, fun y : ModelSpace M n => if y₀ q = 1 then y q else 1 - y q) =
        Pi.single y₀ (1 : ZMod 2) := by
      funext y
      rw [Finset.prod_apply, Pi.single_apply]
      by_cases hy : y = y₀
      · rw [if_pos hy]
        refine Finset.prod_eq_one fun q _ => ?_
        rw [hy]
        rcases zmod_two_eq_zero_or_one (y₀ q) with h0 | h1
        · rw [if_neg (by rw [h0]; decide), h0, sub_zero]
        · rw [if_pos h1, h1]
      · rw [if_neg hy]
        obtain ⟨q, hq'⟩ : ∃ q, y q ≠ y₀ q := by
          by_contra hne
          push Not at hne
          exact hy (funext hne)
        refine Finset.prod_eq_zero (Finset.mem_univ q) ?_
        rcases zmod_two_eq_zero_or_one (y₀ q) with h0 | h1
        · rcases zmod_two_eq_zero_or_one (y q) with h0' | h1'
          · exact absurd (h0'.trans h0.symm) hq'
          · rw [if_neg (by rw [h0]; decide), h1']
            decide
        · rcases zmod_two_eq_zero_or_one (y q) with h0' | h1'
          · rw [if_pos h1, h0']
          · exact absurd (h1'.trans h1.symm) hq'
    have hmem : Pi.single y₀ (1 : ZMod 2) ∈ B := by
      rw [← hprod]
      exact Subring.prod_mem _ fun q _ => hB q
    exact hmem
  have htrans1 : ∀ q : M.Q n, Matrix.permMatrixHom (R := ZMod 2)
      (addPermHom M n (Multiplicative.ofAdd (Pi.single q (1 : ZMod 2)))) ∈ A := fun q => by
    rw [← conj_modelPerm_lampAdd, ← map_inv]
    exact A.mul_mem (A.mul_mem (hq q) hz) (hq q⁻¹)
  have htrans : ∀ v : ModelSpace M n, Matrix.permMatrixHom (R := ZMod 2)
      (addPermHom M n (Multiplicative.ofAdd v)) ∈ A := by
    intro v
    let C : Submonoid (Multiplicative (ModelSpace M n)) :=
      A.toSubmonoid.comap ((Matrix.permMatrixHom (R := ZMod 2)).comp (addPermHom M n))
    have hv : Multiplicative.ofAdd v =
        ∏ q : M.Q n, Multiplicative.ofAdd (Pi.single q (v q)) := by
      rw [← ofAdd_sum, Finset.univ_sum_single]
    have hmem : Multiplicative.ofAdd v ∈ C := by
      rw [hv]
      refine Submonoid.prod_mem _ fun q _ => ?_
      rcases zmod_two_eq_zero_or_one (v q) with h0 | h1
      · rw [h0, Pi.single_zero, ofAdd_zero]
        exact C.one_mem
      · rw [h1]
        exact htrans1 q
    exact hmem
  have hsingle : ∀ i j : ModelSpace M n, Matrix.single i j (1 : ZMod 2) ∈ A := by
    intro i j
    have h : Matrix.single i j (1 : ZMod 2) =
        Matrix.diagonal (Pi.single i (1 : ZMod 2)) *
          Matrix.permMatrixHom (R := ZMod 2) (addPermHom M n (Multiplicative.ofAdd (i - j))) := by
      ext a b
      have hact : (addPermHom M n (Multiplicative.ofAdd (i - j))) b = b + (i - j) := rfl
      rw [Matrix.diagonal_mul, permMatrixHom_apply_eq, hact, Pi.single_apply]
      by_cases ha : a = i
      · by_cases hb : b = j
        · rw [ha, hb, Matrix.single_apply_same, if_pos rfl, if_pos (by abel), one_mul]
        · have hne : ¬(a = b + (i - j)) := fun h' => hb (by
            rw [ha] at h'
            rw [eq_sub_of_add_eq h'.symm, sub_sub_cancel])
          rw [Matrix.single_apply_of_ne (fun h' : i = a ∧ j = b => hb h'.2.symm), if_pos ha,
            if_neg hne, mul_zero]
      · rw [Matrix.single_apply_of_ne (fun h' : i = a ∧ j = b => ha h'.1.symm), if_neg ha,
          zero_mul]
    rw [h]
    exact A.mul_mem (hdiag i) (htrans _)
  refine (Subring.eq_top_iff' A).2 fun x => ?_
  rw [Matrix.matrix_eq_sum_single x]
  refine Subring.sum_mem _ fun i _ => Subring.sum_mem _ fun j _ => ?_
  rcases zmod_two_eq_zero_or_one (x i j) with h0 | h1
  · rw [h0, Matrix.single_zero]
    exact A.zero_mem
  · rw [h1]
    exact hsingle i j

/-! ## Reindexing to `M_{2^{|Q'_n|}}(F_2)` -/

/-- `N_n = |Y_n|`. -/
abbrev modelDim : ℕ :=
  Fintype.card (ModelSpace M n)

/-- `|Y_n| = 2^{|Q'_n|}` (tex 419). -/
theorem modelDim_eq : modelDim M n = 2 ^ Fintype.card (M.Q n) := by
  rw [modelDim, Fintype.card_fun, ZMod.card]

theorem modelDim_pos : 0 < modelDim M n :=
  Fintype.card_pos

/-- `φ_n`, reindexed to `M_{N_n}(F_2)`. -/
noncomputable def modelMapFin (r : LampRing Δ) :
    Matrix (Fin (modelDim M n)) (Fin (modelDim M n)) (ZMod 2) :=
  Matrix.reindexRingEquiv (ZMod 2) (Fintype.equivFin (ModelSpace M n)) (modelMap M n r)

theorem modelMapFin_one : modelMapFin M n 1 = 1 := by
  rw [modelMapFin, modelMap_one, map_one]

theorem modelMapFin_add (r s : LampRing Δ) :
    modelMapFin M n (r + s) = modelMapFin M n r + modelMapFin M n s := by
  rw [modelMapFin, modelMapFin, modelMapFin, map_add, map_add]

theorem closure_modelMapFin_lampGenerators_eq_top :
    Subring.closure (modelMapFin M n '' lampGenerators T) = ⊤ := by
  have himg : modelMapFin M n '' lampGenerators T =
      (Matrix.reindexRingEquiv (ZMod 2) (Fintype.equivFin (ModelSpace M n))).toRingHom ''
        (modelMap M n '' lampGenerators T) := by
    rw [Set.image_image]
    rfl
  rw [himg, ← RingHom.map_closure, closure_modelMap_lampGenerators_eq_top]
  refine eq_top_iff.2 fun x _ =>
    ⟨(Matrix.reindexRingEquiv (ZMod 2) (Fintype.equivFin (ModelSpace M n))).symm x,
      Subring.mem_top _, by simp⟩

theorem eventually_modelMapFin_mul (hT : Subgroup.closure T = ⊤) (r s : LampRing Δ) :
    ∀ᶠ n in atTop, modelMapFin M n (r * s) = modelMapFin M n r * modelMapFin M n s :=
  (eventually_modelMap_mul M hT r s).mono fun n hn => by
    rw [modelMapFin, modelMapFin, modelMapFin, hn, map_mul]

end Lamplighter

open Lamplighter

/-- **The images of the generators generate `M_{2^{|Q'_n|}}(F_2)`** (tex 416–419), together with the
clauses of "`R_Δ` is matricial" for the reindexed `φ_n`: the sizes are positive, `φ_n(1) = I`, the images
of the generators generate the matrix ring for every `n`, and for fixed `r, s` and large `n`, `φ_n` is
additive and multiplicative on `r, s`. -/
def PrintedLamplighterMatricial : Prop :=
  ∀ (Δ : Type) [Group Δ] (T : Set Δ), Subgroup.closure T = ⊤ → ∀ M : BallModelSequence Δ T,
    (∀ (n : ℕ) (q : M.Q n),
      Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q) *
          modelMap M n (ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
            (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ))) *
          Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q)⁻¹ =
        Matrix.diagonal fun y : ModelSpace M n => y q) ∧
    (∀ (n : ℕ) (q : M.Q n),
      Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q) * modelPerm M n (lampAdd Δ) *
          Matrix.permMatrixHom (R := ZMod 2) (qPermHom M n q)⁻¹ =
        Matrix.permMatrixHom (R := ZMod 2)
          (addPermHom M n (Multiplicative.ofAdd (Pi.single q (1 : ZMod 2))))) ∧
    (∀ n : ℕ, Subring.closure (modelMap M n '' lampGenerators T) = ⊤) ∧
    (∀ n : ℕ, modelDim M n = 2 ^ Fintype.card (M.Q n)) ∧
    (∀ k : ℕ, 0 < modelDim M k) ∧ (∀ k : ℕ, modelMapFin M k 1 = 1) ∧
    (∀ k : ℕ, Subring.closure (modelMapFin M k '' lampGenerators T) = ⊤) ∧
    ∀ r s : LampRing Δ, ∀ᶠ k in Filter.atTop,
      modelMapFin M k (r + s) = modelMapFin M k r + modelMapFin M k s ∧
        modelMapFin M k (r * s) = modelMapFin M k r * modelMapFin M k s

theorem printedLamplighterMatricial : PrintedLamplighterMatricial := fun _ _ _ hT M =>
  ⟨fun n q => conj_modelMap_eU M n q, fun n q => conj_modelPerm_lampAdd M n q,
    fun n => closure_modelMap_lampGenerators_eq_top M n, fun n => modelDim_eq M n,
    fun k => modelDim_pos M k, fun k => modelMapFin_one M k,
    fun k => closure_modelMapFin_lampGenerators_eq_top M k,
    fun r s => (eventually_modelMapFin_mul M hT r s).mono fun k hk => ⟨modelMapFin_add M k r s, hk⟩⟩

#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedLamplighterMatricial

end SimpleKazhdanSofic
end GroupApproximation

#audit_axioms GroupApproximation.SimpleKazhdanSofic.Lamplighter.closure_modelMap_lampGenerators_eq_top
#audit_axioms GroupApproximation.SimpleKazhdanSofic.Lamplighter.lampGenerators_finite
