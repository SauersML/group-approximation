section CrossedProduct

variable {Λ Z : Type*} [Group Λ] [TopologicalSpace Z] [MulAction Λ Z] [ContinuousConstSMul Λ Z]

/-- The crossed product `LC(Z, F_2) ⋊ Λ` with its coefficients and units is a covariant pair. -/
theorem isCovariantPair_clopen :
    IsCovariantPair (ClopenGroupCrossedProduct.coeff Λ Z (ZMod 2))
      (ClopenGroupCrossedProduct.unitHom Λ Z (ZMod 2)) :=
  ⟨ClopenGroupCrossedProduct.coeff_injective Λ Z (ZMod 2), fun ξ {U} hU => by
    rw [ClopenGroupCrossedProduct.unitHom_apply, ClopenGroupCrossedProduct.unit_mul_coeff,
      ClopenGroupCrossedProduct.comap_smulMap_inv_charFn]⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SimplicitySteps.isCovariantPair_clopen

/-- **tex l.241–242**: for `1 ≠ K ⊴ G = EL_n(LC(Z, F_2) ⋊ Λ)`, `n ≥ 3`, with `Λ` acting minimally
and topologically freely on a compact totally separated space, `K = G`. -/
theorem manuscriptSentence_normalSubgroupEqTop [CompactSpace Z] [TotallySeparatedSpace Z]
    [Nonempty Z] [MulAction.IsMinimal Λ Z]
    (hfree : ∀ ξ : Λ, ξ ≠ 1 → interior {z : Z | ξ • z = z} = ∅) {n : ℕ} (hn : 3 ≤ n)
    (K : Subgroup (elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ Z (ZMod 2))))
    (hK : K.Normal) (hne : K ≠ ⊥) : K = ⊤ := by
  haveI := General.isSimpleGroup_clopenGroupCrossedProduct hfree hn
  exact hK.eq_bot_or_eq_top.resolve_left hne

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SimplicitySteps.manuscriptSentence_normalSubgroupEqTop

/-- **tex l.303–305**: if `e_{pq}(e_V) ∈ K` for all `p ≠ q`, with `V` clopen and nonempty, then by
minimality and compactness finitely many translates `ξ_i V` cover `Z`, `1 = 1 - ∏_i (1 - e_{ξ_i V})`,
and `1 ∈ J`: `e_{pq}(1) ∈ K` for all `p ≠ q`. -/
theorem manuscriptSentence_finiteCoverGivesOne [CompactSpace Z] [MulAction.IsMinimal Λ Z]
    {n : ℕ} (hn : 3 ≤ n)
    (K : Subgroup (elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ Z (ZMod 2)))) [K.Normal]
    {V : Set Z} (hV : IsClopen V) (hne : V.Nonempty)
    (hVK : ∀ (p q : Fin n) (hpq : p ≠ q),
      elGen p q hpq
        (ClopenGroupCrossedProduct.coeff Λ Z (ZMod 2) (LocallyConstant.charFn (ZMod 2) hV)) ∈ K) :
    ∃ s : Finset Λ, (∀ z : Z, ∃ ξ ∈ s, z ∈ ξ • V) ∧
      (1 : LocallyConstant Z (ZMod 2)) =
          1 - ∏ ξ ∈ s, (1 - LocallyConstant.charFn (ZMod 2) (isClopen_smul ξ hV)) ∧
        ∀ (p q : Fin n) (hpq : p ≠ q),
          elGen p q hpq (1 : ClopenGroupCrossedProduct Λ Z (ZMod 2)) ∈ K := by
  have hcard : 3 ≤ Fintype.card (Fin n) := by
    rw [Fintype.card_fin]
    exact hn
  obtain ⟨s, hs⟩ := General.exists_finset_smul_cover hV.isOpen hne
  refine ⟨s, hs, by rw [General.prod_one_sub_charFn_smul_eq_zero hV s hs, sub_zero], ?_⟩
  have hmem := (Pestov91.SimpleModCentre.mem_levelIdeal hcard K _).mpr hVK
  exact (Pestov91.SimpleModCentre.mem_levelIdeal hcard K 1).mp
    (General.one_mem_levelIdeal_of_smul_cover (isCovariantPair_clopen (Λ := Λ) (Z := Z)) hcard hV s
      hs K hmem)

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SimplicitySteps.manuscriptSentence_finiteCoverGivesOne

end CrossedProduct

section LevelIdeal

variable {R' : Type*} [Ring R']

/-- **tex l.299–302**: for `K ⊴ EL_n(R)`, `n ≥ 3`, the set `J = {r : e_{pq}(r) ∈ K for all p ≠ q}`
is a two-sided ideal, since `e_{pq}(r'r) = [e_{pl}(r'), e_{lq}(r)]` and
`e_{pq}(rr') = [e_{pl}(r), e_{lq}(r')]` for `l ∉ {p, q}`. -/
theorem manuscriptSentence_levelSetIsTwoSidedIdeal {n : ℕ} (hn : 3 ≤ n)
    (K : Subgroup (elementaryGroup (Fin n) R')) [K.Normal] :
    (∃ J : TwoSidedIdeal R', ∀ r : R', r ∈ J ↔ ∀ (p q : Fin n) (hpq : p ≠ q), elGen p q hpq r ∈ K) ∧
      ∀ (p q l : Fin n) (hpq : p ≠ q) (hpl : p ≠ l) (hlq : l ≠ q) (r r' : R'),
        elGen p q hpq (r' * r) = ⁅elGen p l hpl r', elGen l q hlq r⁆ ∧
          elGen p q hpq (r * r') = ⁅elGen p l hpl r, elGen l q hlq r'⁆ := by
  have hcard : 3 ≤ Fintype.card (Fin n) := by
    rw [Fintype.card_fin]
    exact hn
  exact ⟨⟨Pestov91.SimpleModCentre.levelIdeal hcard K, Pestov91.SimpleModCentre.mem_levelIdeal hcard K⟩,
    fun p q l hpq hpl hlq r r' =>
      ⟨by rw [commutatorElement_def, elGen_commutator p l q hpl hlq hpq r' r],
        by rw [commutatorElement_def, elGen_commutator p l q hpl hlq hpq r r']⟩⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SimplicitySteps.manuscriptSentence_levelSetIsTwoSidedIdeal

/-- **tex l.305**: if `1 ∈ J`, i.e. `e_{pq}(1) ∈ K` for all `p ≠ q`, then `J = R` and `K = G`. -/
theorem manuscriptSentence_levelIdealTopAndKTop {n : ℕ} (hn : 3 ≤ n)
    (K : Subgroup (elementaryGroup (Fin n) R')) [K.Normal]
    (h1 : ∀ (p q : Fin n) (hpq : p ≠ q), elGen p q hpq (1 : R') ∈ K) :
    (∀ (r : R') (p q : Fin n) (hpq : p ≠ q), elGen p q hpq r ∈ K) ∧ K = ⊤ := by
  have hcard : 3 ≤ Fintype.card (Fin n) := by
    rw [Fintype.card_fin]
    exact hn
  have hJ : ∀ r : R', r ∈ Pestov91.SimpleModCentre.levelIdeal hcard K := fun r => by
    have hr := TwoSidedIdeal.mul_mem_left _ r 1
      ((Pestov91.SimpleModCentre.mem_levelIdeal hcard K 1).mpr h1)
    rwa [mul_one] at hr
  refine ⟨fun r => (Pestov91.SimpleModCentre.mem_levelIdeal hcard K r).mp (hJ r), ?_⟩
  rw [Subgroup.eq_top_iff']
  intro y
  have hy := elementaryGroup_hom_eq_one_of_gens (QuotientGroup.mk' K)
    (fun l k hlk d => by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact (Pestov91.SimpleModCentre.mem_levelIdeal hcard K d).mp (hJ d) l k hlk) y
  rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at hy

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SimplicitySteps.manuscriptSentence_levelIdealTopAndKTop

end LevelIdeal

section PartA

/-- **tex l.305, "This proves (a)"** (`thm:general` (a), tex l.172–178): for a finitely generated
group `Λ` acting minimally and topologically freely on a Cantor set `Z` (compact, metrizable,
totally disconnected, perfect, nonempty), with `R = LC(Z, F_2) ⋊ Λ` generated by a finite set
`S ∋ 1`, for every `n ≥ 3` the group `EL_n(R)` is infinite, finitely generated, simple, and has
property (T). -/
theorem manuscriptSentence_thisProvesPartA (Λ : Type) [Group Λ] [Group.FG Λ] (Z : Type)
    [TopologicalSpace Z] [CompactSpace Z] [TopologicalSpace.MetrizableSpace Z]
    [TotallyDisconnectedSpace Z] [PerfectSpace Z] [Nonempty Z] [MulAction Λ Z]
    [ContinuousConstSMul Λ Z] (hmin : MulAction.IsMinimal Λ Z)
    (hfree : ∀ ξ : Λ, ξ ≠ 1 → ∀ U : Set Z, IsOpen U → U.Nonempty → ∃ z ∈ U, ξ • z ≠ z)
    (S : Finset (ClopenGroupCrossedProduct Λ Z (ZMod 2))) (_hS1 : 1 ∈ S)
    (hS : Subring.closure (S : Set (ClopenGroupCrossedProduct Λ Z (ZMod 2))) = ⊤) {n : ℕ}
    (hn : 3 ≤ n) :
    Infinite ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ Z (ZMod 2))) ∧
      Group.FG ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ Z (ZMod 2))) ∧
        IsSimpleGroup ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ Z (ZMod 2))) ∧
          HasKazhdanPropertyT.{0, 0}
            ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ Z (ZMod 2))) := by
  haveI : Infinite Z := infinite_of_perfectSpace Z
  obtain ⟨hT, hInf⟩ := printedGroupCrossedProductPropertyTInfinite Λ Z S hS n hn
  exact ⟨hInf, KazhdanFiniteGeneration.fg_of_hasKazhdanPropertyT _ hT,
    General.isSimpleGroup_clopenGroupCrossedProduct_of_isOpen hmin hfree hn, hT⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SimplicitySteps.manuscriptSentence_thisProvesPartA

end PartA

section Stepanov

variable {A : Type} [TopologicalSpace A] [DiscreteTopology A] [Finite A]

/-- **tex l.309–315**: for the ring `R = LC(X, F_2) ⋊_T ℤ` of `thm:main` (`X` an infinite minimal
subshift), simplicity of `EL_n(R)`, `n ≥ 3`, follows from Stepanov's theorem: the ring is simple;
for any `p, q ∈ R` there are `r, r'`, not both `0`, with `pr + qr' = 0`; this gives Stepanov's
condition (b), hence the sandwich `E(n, R, I) ≤ H ≤ C(n, R, I)` for every subgroup `H` normalized by
`E(n, R)`, and `EL_n(R)` is simple. -/
theorem manuscriptSentence_stepanovRouteSimplicity (S : Subshift A ℤ) (hinf : Infinite S.carrier)
    (hmin : IsMinimal S) {n : ℕ} (hn : 3 ≤ n) :
    IsSimpleRing (R S) ∧
      (∀ p q : R S, ∃ r r' : R S, (r, r') ≠ 0 ∧ p * r + q * r' = 0) ∧
        StepanovNormalStructure.StepanovConditionB (Fin n) (R S) ∧
          (∀ H : Subgroup (Matrix (Fin n) (Fin n) (R S))ˣ,
            PreusserNormalizedBy.NormalizedBy H (elementaryGroup (Fin n) (R S)) →
              ∃! I : TwoSidedIdeal (R S),
                (relativeElementary (Fin n) I).map (elementaryGroup (Fin n) (R S)).subtype ≤ H ∧
                  H ≤ congruenceSubgroup (Fin n) I) ∧
            IsSimpleGroup ↥(elementaryGroup (Fin n) (R S)) := by
  have hcard : 3 ≤ Fintype.card (Fin n) := by
    rw [Fintype.card_fin]
    exact hn
  haveI := isSimpleRing_R S hinf hmin
  have hb := stepanovConditionB_of_pairDependence hcard (pairDependence_R S hinf)
  exact ⟨isSimpleRing_R S hinf hmin, pairDependence_R S hinf, hb,
    fun H hH => StepanovNormalStructure.sandwich_of_conditionB hcard hb H hH,
    isSimpleGroup_elementaryGroup_stepanov S hinf hmin hn⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SimplicitySteps.manuscriptSentence_stepanovRouteSimplicity

end Stepanov

