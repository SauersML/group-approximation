import GroupApproximation.Dynamics.ClopenGroupCrossedProduct
import GroupApproximation.Manuscript.SimpleKazhdanSofic.LamplighterAction
import GroupApproximation.PropertyT.FinitelyGeneratedRing
import GroupApproximation.Meta.AxiomGuard

/-!
# The ring `R_Δ = LC(Ω, F_2) ⋊ Λ` and its generators

`simple_kazhdan_sofic_group.tex` at origin/main 37551fd93 (md5 b55c0d23…), tex 365–368, in the proof
of `cor:lef` and `cor:host`:

> The ring `R_Δ = LC(Ω, F_2) ⋊ Λ` is generated by `1`, the units `u_s^{±1}` for the generators `s` of
> `Λ`, and the indicator `e_U` of `U = {x : x(e) = 1}`.

* `LampRing Δ`: the ring `ClopenGroupCrossedProduct (LampAffine Δ) (LampSpace Δ) (ZMod 2)`.
* `coord Δ h`: the coordinate function `x ↦ x(h)`, which is the indicator of `{x : x(h) = 1}`;
  `charFn_coordOne`: `e_U = coord Δ 1`.
* `closure_range_coord`: the coordinate functions generate `LC(Ω, F_2)`: by compactness a locally
  constant function depends on finitely many coordinates, and it is split one coordinate at a time.
* `comap_smulMap_inr_inv_coord`: `u_h e_U u_h⁻¹ = coord h` for `h ∈ Δ`.
* `closure_generators_eq_top`, `PrintedLamplighterRingGeneration`: the printed generation, for every
  generating set of `Λ`; `isFinitelyGeneratedRing_lampRing`: `R_Δ` is a finitely generated ring when
  `Δ` is a finitely generated group.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace Lamplighter

variable (Δ : Type*)

/-- The coordinate function `x ↦ x(h)` on `Ω`. -/
def coord (h : Δ) : LocallyConstant (LampSpace Δ) (ZMod 2) :=
  ⟨fun x => x h, (IsLocallyConstant.iff_continuous _).2 (continuous_apply h)⟩

theorem coord_apply (h : Δ) (x : LampSpace Δ) : coord Δ h x = x h :=
  rfl

/-- **Finitely many coordinates.**  A locally constant function on the compact space `Ω` depends only
on the coordinates in a finite set. -/
theorem exists_finset_dependsOn {Y : Type*} (f : LocallyConstant (LampSpace Δ) Y) :
    ∃ I : Finset Δ, ∀ x y : LampSpace Δ, (∀ i ∈ I, x i = y i) → f x = f y := by
  classical
  have hloc : ∀ x : LampSpace Δ, ∃ I : Finset Δ,
      ∀ y : LampSpace Δ, (∀ i ∈ I, y i = x i) → f y = f x := by
    intro x
    obtain ⟨I, U, hU, hIU⟩ :=
      isOpen_pi_iff.mp (f.isLocallyConstant.isOpen_fiber (f x)) x rfl
    refine ⟨I, fun y hy => hIU (Set.mem_pi.mpr fun i hi => ?_)⟩
    rw [hy i hi]
    exact (hU i hi).2
  choose J hJ using hloc
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun z : LampSpace Δ => (J z : Set Δ).pi fun i => {z i})
    (fun z => isOpen_set_pi (J z).finite_toSet fun i _ => isOpen_discrete _)
    (fun z _ => Set.mem_iUnion.mpr ⟨z, Set.mem_pi.mpr fun _ _ => Set.mem_singleton _⟩)
  refine ⟨t.biUnion J, fun x y hxy => ?_⟩
  obtain ⟨z, hz, hxz⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
  have hxz' : ∀ i ∈ J z, x i = z i := hxz
  have hyz : ∀ i ∈ J z, y i = z i := fun i hi =>
    (hxy i (Finset.mem_biUnion.mpr ⟨z, hz, hi⟩)).symm.trans (hxz' i hi)
  exact (hJ z x hxz').trans (hJ z y hyz).symm

/-- A function of the coordinates in `I` is in the subring generated by the coordinate functions.
The induction splits it along one coordinate at a time. -/
theorem exists_mem_closure_coord (I : Finset Δ) :
    ∀ g : LampSpace Δ → ZMod 2,
      (∀ y z : LampSpace Δ, (∀ i ∈ I, y i = z i) → g y = g z) →
      ∃ c ∈ Subring.closure (Set.range (coord Δ)), ∀ x, c x = g x := by
  classical
  induction I using Finset.induction_on with
  | empty =>
    intro g hg
    refine ⟨((g 0).val : LocallyConstant (LampSpace Δ) (ZMod 2)), natCast_mem _ _, fun x => ?_⟩
    rw [hg x 0 fun i hi => absurd hi (Finset.notMem_empty i)]
    exact ZMod.natCast_zmod_val (n := 2) (g 0)
  | insert i J hi ih =>
    intro g hg
    have hsplit : ∀ (b : ZMod 2) (y z : LampSpace Δ), (∀ j ∈ J, y j = z j) →
        g (Function.update y i b) = g (Function.update z i b) := by
      intro b y z hyz
      refine hg _ _ fun j hj => ?_
      rcases Finset.mem_insert.mp hj with rfl | hj
      · simp only [Function.update_self]
      · have hji : j ≠ i := fun h => hi (h ▸ hj)
        rw [Function.update_of_ne hji, Function.update_of_ne hji]
        exact hyz j hj
    obtain ⟨c₀, hc₀, hc₀x⟩ := ih (fun y => g (Function.update y i 0)) (hsplit 0)
    obtain ⟨c₁, hc₁, hc₁x⟩ := ih (fun y => g (Function.update y i 1)) (hsplit 1)
    refine ⟨(1 - coord Δ i) * c₀ + coord Δ i * c₁,
      Subring.add_mem _
        (Subring.mul_mem _
          (Subring.sub_mem _ (Subring.one_mem _) (Subring.subset_closure ⟨i, rfl⟩)) hc₀)
        (Subring.mul_mem _ (Subring.subset_closure ⟨i, rfl⟩) hc₁),
      fun x => ?_⟩
    have hx : ∀ b : ZMod 2, x i = b → Function.update x i b = x := fun b hb => by
      rw [← hb]
      exact Function.update_eq_self i x
    rw [LocallyConstant.add_apply, LocallyConstant.mul_apply, LocallyConstant.mul_apply,
      LocallyConstant.sub_apply, LocallyConstant.one_apply, hc₀x x, hc₁x x, coord_apply]
    rcases zmod_two_eq_zero_or_one (x i) with h0 | h1
    · rw [h0, hx 0 h0]
      ring
    · rw [h1, hx 1 h1]
      ring

/-- **The coordinate functions generate `LC(Ω, F_2)`.** -/
theorem closure_range_coord : Subring.closure (Set.range (coord Δ)) = ⊤ := by
  refine (Subring.eq_top_iff' _).mpr fun f => ?_
  obtain ⟨I, hI⟩ := exists_finset_dependsOn Δ f
  obtain ⟨c, hc, hcx⟩ := exists_mem_closure_coord Δ I f hI
  have hcf : c = f := LocallyConstant.ext fun x => hcx x
  exact hcf ▸ hc

/-- The cylinder `U = {x : x(e) = 1}` is clopen. -/
theorem isClopen_coordOne [One Δ] : IsClopen {x : LampSpace Δ | x 1 = 1} :=
  (isClopen_discrete ({1} : Set (ZMod 2))).preimage (continuous_apply (1 : Δ))

/-- **`e_U` is the coordinate function at `e`.** -/
theorem charFn_coordOne [One Δ] :
    LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ) = coord Δ 1 := by
  ext x
  rw [LocallyConstant.coe_charFn, coord_apply]
  rcases zmod_two_eq_zero_or_one (x 1) with h0 | h1
  · rw [Set.indicator_of_notMem (by simp [h0]), h0]
  · rw [Set.indicator_of_mem (by simpa using h1), h1, Pi.one_apply]

variable [Group Δ]

/-- **The ring** `R_Δ = LC(Ω, F_2) ⋊ Λ` (tex 366). -/
abbrev LampRing : Type _ :=
  ClopenGroupCrossedProduct (LampAffine Δ) (LampSpace Δ) (ZMod 2)

/-- **Translates of `e_U` are the coordinate functions**: `e_U ∘ h⁻¹ = coord h`, so
`u_h e_U u_h⁻¹ = coord h` for `h ∈ Δ`. -/
theorem comap_smulMap_inr_inv_coord (h : Δ) :
    LocallyConstant.comap
        (ClopenGroupCoeff.smulMap (LampAffine Δ) (LampSpace Δ) (SemidirectProduct.inr h)⁻¹)
        (coord Δ 1) =
      coord Δ h := by
  ext x
  rw [LocallyConstant.coe_comap_apply, ClopenGroupCoeff.smulMap_apply, coord_apply, coord_apply,
    ← map_inv, smul_apply, SemidirectProduct.right_inr, SemidirectProduct.left_inr, inv_inv, mul_one,
    toAdd_one, Finsupp.coe_zero, Pi.zero_apply, add_zero]

/-- The printed generators of `R_Δ` for a generating set `T` of `Λ`: `1`, the `u_s^{±1}` with
`s ∈ T`, and `e_U`. -/
def lampRingGenerators (T : Set (LampAffine Δ)) : Set (LampRing Δ) :=
  insert 1
    ((fun s => (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s :
        LampRing Δ)) '' T ∪
      (fun s => (((ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s)⁻¹ :
        (LampRing Δ)ˣ) : LampRing Δ)) '' T ∪
      {ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
        (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ))})

/-- **Generation of `R_Δ`** (tex 365–368), for every generating set `T` of `Λ`. -/
theorem closure_generators_eq_top {T : Set (LampAffine Δ)} (hT : Subgroup.closure T = ⊤) :
    Subring.closure (lampRingGenerators Δ T) = ⊤ := by
  classical
  set A := Subring.closure (lampRingGenerators Δ T) with hA
  have hu1 : ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) 1 = 1 :=
    (ClopenGroupCrossedProduct.unitHom (LampAffine Δ) (LampSpace Δ) (ZMod 2)).map_one
  let K : Subgroup (LampAffine Δ) :=
    { carrier := {ξ | (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ :
          LampRing Δ) ∈ A ∧
        (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ⁻¹ : LampRing Δ) ∈ A}
      mul_mem' := by
        intro a b ha hb
        refine ⟨?_, ?_⟩
        · rw [ClopenGroupCrossedProduct.unit_mul, Units.val_mul]
          exact A.mul_mem ha.1 hb.1
        · rw [mul_inv_rev, ClopenGroupCrossedProduct.unit_mul, Units.val_mul]
          exact A.mul_mem hb.2 ha.2
      one_mem' := by
        refine ⟨?_, ?_⟩
        · rw [hu1, Units.val_one]
          exact A.one_mem
        · rw [inv_one, hu1, Units.val_one]
          exact A.one_mem
      inv_mem' := by
        intro a ha
        refine ⟨ha.2, ?_⟩
        rw [inv_inv]
        exact ha.1 }
  have hK : T ⊆ K := by
    intro s hs
    show (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s :
        LampRing Δ) ∈ A ∧
      (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s⁻¹ : LampRing Δ) ∈ A
    refine ⟨Subring.subset_closure (Set.mem_insert_of_mem _
        (Set.mem_union_left _ (Set.mem_union_left _ ⟨s, hs, rfl⟩))), ?_⟩
    rw [← ClopenGroupCrossedProduct.unit_inv]
    exact Subring.subset_closure (Set.mem_insert_of_mem _
      (Set.mem_union_left _ (Set.mem_union_right _ ⟨s, hs, rfl⟩)))
  have hall : ∀ ξ : LampAffine Δ,
      (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ : LampRing Δ) ∈ A ∧
        (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) ξ⁻¹ :
          LampRing Δ) ∈ A := by
    intro ξ
    have hξ : ξ ∈ Subgroup.closure T := by
      rw [hT]
      exact Subgroup.mem_top ξ
    exact (Subgroup.closure_le K).2 hK hξ
  have hcoord : ∀ h : Δ,
      ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2) (coord Δ h) ∈ A := by
    intro h
    have heq := ClopenGroupCrossedProduct.unit_mul_coeff_mul_inv (LampAffine Δ) (LampSpace Δ)
      (ZMod 2) (SemidirectProduct.inr h) (coord Δ 1)
    rw [comap_smulMap_inr_inv_coord, ClopenGroupCrossedProduct.unit_inv] at heq
    rw [← heq]
    refine A.mul_mem (A.mul_mem (hall _).1 ?_) (hall _).2
    rw [← charFn_coordOne]
    exact Subring.subset_closure
      (Set.mem_insert_of_mem _ (Set.mem_union_right _ (Set.mem_singleton _)))
  have hcoeff : ∀ f : LocallyConstant (LampSpace Δ) (ZMod 2),
      ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2) f ∈ A := by
    intro f
    have hle : Subring.closure (Set.range (coord Δ)) ≤
        A.comap (ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)) :=
      Subring.closure_le.2 (by
        rintro _ ⟨h, rfl⟩
        exact hcoord h)
    rw [closure_range_coord] at hle
    exact hle (Subring.mem_top f)
  refine (Subring.eq_top_iff' A).2 fun r => ?_
  obtain ⟨S, f, rfl⟩ :=
    ClopenGroupCrossedProduct.exists_sum_coeff_mul_unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) r
  exact Subring.sum_mem _ fun ξ _ => A.mul_mem (hcoeff (f ξ)) (hall ξ).1

/-- `R_Δ` is a finitely generated ring when `Δ` is a finitely generated group. -/
theorem isFinitelyGeneratedRing_lampRing (hΔ : Group.FG Δ) : IsFinitelyGeneratedRing (LampRing Δ) := by
  classical
  obtain ⟨T, hT, hTfin⟩ := Group.fg_iff.1 (fg_lampAffine Δ hΔ)
  have hfin : (lampRingGenerators Δ T).Finite :=
    (((hTfin.image _).union (hTfin.image _)).union (Set.finite_singleton _)).insert _
  exact ⟨hfin.toFinset, by rw [Set.Finite.coe_toFinset]; exact closure_generators_eq_top Δ hT⟩

end Lamplighter

open Lamplighter

/-- **Generation of `R_Δ`** (tex 365–368): for every generating set `T` of `Λ`, the ring
`R_Δ = LC(Ω, F_2) ⋊ Λ` is generated by `1`, the units `u_s^{±1}` with `s ∈ T`, and the indicator `e_U`
of `U = {x : x(e) = 1}`. -/
def PrintedLamplighterRingGeneration : Prop :=
  ∀ (Δ : Type) [Group Δ] (T : Set (LampAffine Δ)), Subgroup.closure T = ⊤ →
    Subring.closure
        (insert (1 : LampRing Δ)
          ((fun s => (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s :
              LampRing Δ)) '' T ∪
            (fun s =>
              (((ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) s)⁻¹ :
                (LampRing Δ)ˣ) : LampRing Δ)) '' T ∪
            {ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
              (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ))})) = ⊤

theorem printedLamplighterRingGeneration : PrintedLamplighterRingGeneration :=
  fun Δ _ _ hT => closure_generators_eq_top Δ hT

#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedLamplighterRingGeneration

end SimpleKazhdanSofic
