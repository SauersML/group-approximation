import GroupApproximation.Manuscript.SimpleKazhdanSofic.MarkedLimitLEF
import GroupApproximation.Manuscript.SimpleKazhdanSofic.SkRows.LEFFaithful.LocalEmbedding
import GroupApproximation.Sofic.LEF
import GroupApproximation.Meta.AxiomGuard
import Mathlib.SetTheory.Cardinal.Free
import Mathlib.Order.Filter.AtTopBot.Basic
import Mathlib.Order.Filter.Finite

/-!
# LEF faithfulness: a finitely generated group is LEF iff it is a marked limit of finite groups

`simple_kazhdan_sofic_group.tex`, section `sec:intro` (tex l.102–105):

> A group is LEF~\cite{VershikGordon} if each finite subset $\Phi$ maps
> injectively into a finite group by a map that preserves every product $gh$
> with $g,h,gh\in\Phi$. Limits of finite groups in the space of marked groups
> are LEF.

The printed sentence is one direction (closed in the corpus as `isLEF_of_isMarkedLimit`,
`MarkedLimitLEF.lean`).  The Vershik–Gordon characterization is the equivalence for finitely
generated groups; this module proves the converse, which shows that the corpus `IsLEF` and
`IsMarkedLimit` describe the cited notions.

## Proof of the converse (`exists_isMarkedLimit_of_isLEF`)

Let `s : ι → G` generate `G`, with `ι` countable.  Then `FreeGroup ι` is countable and
`FreeGroup.lift s` is onto, so `G` is countable: fix a surjection `e : ℕ → G` and the finite test
sets `T ℓ = e '' {0, …, ℓ-1}`.  LEF gives `f ℓ : G → Perm (Fin (n ℓ))`, injective on `T ℓ`,
normalized at `1` and multiplicative on `T ℓ`.  Let `H ℓ` be the subgroup of `Perm (Fin (n ℓ))`
generated by the `f ℓ (s i)`, marked by `σ ℓ i = f ℓ (s i)`; it is finite and generated by the
marking.  Fix a word `w`.  The corpus lemma `exists_local_word_control` gives a finite set `S`
such that any map multiplicative on `S` evaluates `w` correctly.  For large `ℓ`, the finite set
`{1, s(w)} ∪ S` lies in `T ℓ`, hence `w(σ ℓ) = f ℓ (s(w))`, and by injectivity on `T ℓ` together
with `f ℓ 1 = 1`, `f ℓ (s(w)) = 1 ↔ s(w) = 1`.

* `lift_subgroup_eq_one_iff`, `closure_range_codRestrict`: words and generation in `H ℓ`;
* `exists_isMarkedLimit_of_isLEF`: every countable generating family of an LEF group is the limit
  of markings of finite groups;
* `isLEF_iff_exists_isMarkedLimit`, `manuscriptSentence_lefIffMarkedLimitOfFiniteGroups`: for
  finitely generated `G`, LEF iff some finite marking of `G` is a marked limit of finite groups.
-/

namespace GroupApproximation.SimpleKazhdanSofic.SkRows.LEFFaithful

open GroupApproximation GroupApproximation.SimpleKazhdanSofic Filter

universe u v

/-- A word in a marking by elements of a subgroup is trivial iff it is trivial in the ambient
group. -/
theorem lift_subgroup_eq_one_iff {ι K : Type*} [Group K] (P : Subgroup K) (t : ι → P)
    (w : FreeGroup ι) :
    FreeGroup.lift t w = 1 ↔ FreeGroup.lift (fun i => (t i : K)) w = 1 := by
  have hcomp : P.subtype (FreeGroup.lift t w) = FreeGroup.lift (fun i => (t i : K)) w :=
    FreeGroup.lift_unique (P.subtype.comp (FreeGroup.lift t)) (fun x => by simp)
  rw [← hcomp]
  exact (map_eq_one_iff P.subtype (Subgroup.subtype_injective P)).symm

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.LEFFaithful.lift_subgroup_eq_one_iff

/-- The subgroup generated by the values of `t` is generated by those values. -/
theorem closure_range_codRestrict {ι K : Type*} [Group K] (t : ι → K) :
    Subgroup.closure (Set.range fun i => (⟨t i, Subgroup.subset_closure ⟨i, rfl⟩⟩ :
      Subgroup.closure (Set.range t))) = ⊤ := by
  refine eq_top_iff.2 ?_
  rw [← Subgroup.closure_closure_coe_preimage (k := Set.range t)]
  refine Subgroup.closure_mono ?_
  rintro x ⟨i, hi⟩
  exact ⟨i, Subtype.ext hi⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.LEFFaithful.closure_range_codRestrict

/-- **An LEF group is a marked limit of finite groups**, for every countable generating family:
the converse of `isLEF_of_isMarkedLimit` (Vershik–Gordon). -/
theorem exists_isMarkedLimit_of_isLEF {ι : Type u} {G : Type v} [Group G] [Countable ι]
    (s : ι → G) (hs : Subgroup.closure (Set.range s) = ⊤) (hG : IsLEF G) :
    ∃ (H : ℕ → Type) (_ : ∀ ℓ, Group (H ℓ)) (σ : ∀ ℓ, ι → H ℓ),
      (∀ ℓ, Finite (H ℓ)) ∧ IsMarkedLimit s σ := by
  classical
  have hsurj : Function.Surjective (FreeGroup.lift s) := by
    intro g
    have hg : g ∈ (FreeGroup.lift s).range := by
      rw [FreeGroup.range_lift_eq_closure, hs]
      exact Subgroup.mem_top g
    exact MonoidHom.mem_range.mp hg
  haveI : Countable G := hsurj.countable
  haveI : Nonempty G := ⟨1⟩
  obtain ⟨e, he⟩ := exists_surjective_nat G
  choose n f hinj hmul using fun ℓ : ℕ => hG ((Finset.range ℓ).image e)
  let K : ∀ ℓ, Subgroup (Equiv.Perm (Fin (n ℓ))) := fun ℓ =>
    Subgroup.closure (Set.range fun i => f ℓ (s i))
  let σ : ∀ ℓ, ι → K ℓ := fun ℓ i => ⟨f ℓ (s i), Subgroup.subset_closure ⟨i, rfl⟩⟩
  refine ⟨fun ℓ => ↥(K ℓ), fun ℓ => (K ℓ).toGroup, σ, fun ℓ => inferInstance, ?_⟩
  refine ⟨hs, fun ℓ => closure_range_codRestrict (fun i => f ℓ (s i)), fun w => ?_⟩
  obtain ⟨S, hS⟩ := exists_local_word_control (FreeGroup.lift s) w
  let T : Finset G := insert 1 (insert (FreeGroup.lift s w) S)
  have hev : ∀ᶠ ℓ in atTop, ∀ x ∈ T, x ∈ (Finset.range ℓ).image e := by
    refine (eventually_all_finset T).2 fun x _ => ?_
    obtain ⟨k, rfl⟩ := he x
    exact eventually_atTop.2
      ⟨k + 1, fun ℓ hℓ => Finset.mem_image_of_mem e (Finset.mem_range.2 (by omega))⟩
  refine hev.mono fun ℓ hT => ?_
  refine (lift_subgroup_eq_one_iff (K ℓ) (σ ℓ) w).trans ?_
  have hloc : LocalMultiplicativeOn S (f ℓ) :=
    (hmul ℓ).mono fun x hx => hT x (by simp [T, hx])
  have hword : FreeGroup.lift (fun i => ((σ ℓ i : K ℓ) : Equiv.Perm (Fin (n ℓ)))) w =
      f ℓ (FreeGroup.lift s w) := by
    have h := hS (Equiv.Perm (Fin (n ℓ))) (f ℓ) hloc
    simp only [FreeGroup.lift_apply_of] at h
    exact h
  rw [hword]
  have h1 : (1 : G) ∈ (Finset.range ℓ).image e := hT 1 (by simp [T])
  have hw : FreeGroup.lift s w ∈ (Finset.range ℓ).image e := hT _ (by simp [T])
  constructor
  · intro hf
    refine hinj ℓ (Finset.mem_coe.2 hw) (Finset.mem_coe.2 h1) ?_
    rw [hf, (hmul ℓ).map_one]
  · intro hg
    rw [hg, (hmul ℓ).map_one]

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.LEFFaithful.exists_isMarkedLimit_of_isLEF

/-- **Vershik–Gordon characterization** (tex l.102–105): a finitely generated group is LEF if
and only if, for some finite generating family, it is a limit of finite groups in the space of
marked groups. -/
theorem isLEF_iff_exists_isMarkedLimit (G : Type u) [Group G] (hfg : Group.FG G) :
    IsLEF G ↔ ∃ (ι : Type u) (_ : Finite ι) (s : ι → G) (H : ℕ → Type)
      (_ : ∀ ℓ, Group (H ℓ)) (σ : ∀ ℓ, ι → H ℓ), (∀ ℓ, Finite (H ℓ)) ∧ IsMarkedLimit s σ := by
  constructor
  · intro hG
    obtain ⟨S, hS, hSfin⟩ := Group.fg_iff.1 hfg
    haveI : Finite ↥S := Set.finite_coe_iff.2 hSfin
    have hs : Subgroup.closure (Set.range (Subtype.val : ↥S → G)) = ⊤ := by
      rw [Subtype.range_coe]
      exact hS
    exact ⟨↥S, inferInstance, (Subtype.val : ↥S → G),
      exists_isMarkedLimit_of_isLEF (Subtype.val : ↥S → G) hs hG⟩
  · rintro ⟨ι, _, s, H, _, σ, hfin, hlim⟩
    exact isLEF_of_isMarkedLimit hfin hlim

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.LEFFaithful.isLEF_iff_exists_isMarkedLimit

/-- **Endpoint** (tex l.102–105): for a finitely generated group, the printed local
embeddability, the corpus `IsLEF`, and being a marked limit of finite groups coincide. -/
theorem manuscriptSentence_lefIffMarkedLimitOfFiniteGroups (G : Type u) [Group G]
    (hfg : Group.FG G) :
    (IsLEF G ↔ IsLocallyEmbeddable G) ∧
      (IsLEF G ↔ ∃ (ι : Type u) (_ : Finite ι) (s : ι → G) (H : ℕ → Type)
        (_ : ∀ ℓ, Group (H ℓ)) (σ : ∀ ℓ, ι → H ℓ), (∀ ℓ, Finite (H ℓ)) ∧ IsMarkedLimit s σ) :=
  ⟨isLEF_iff_localEmbedding G, isLEF_iff_exists_isMarkedLimit G hfg⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.LEFFaithful.manuscriptSentence_lefIffMarkedLimitOfFiniteGroups

end GroupApproximation.SimpleKazhdanSofic.SkRows.LEFFaithful
