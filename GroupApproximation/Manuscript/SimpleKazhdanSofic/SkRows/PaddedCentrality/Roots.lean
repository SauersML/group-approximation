import GroupApproximation.BooneHigman.SteinbergBasic.Naturality
import GroupApproximation.Meta.AxiomGuard

/-!
# Boundary roots generate `St_{m+1}(R)`

Lane `sk-rows-14` (ring-generic Steinberg infrastructure on Khanh's route, arXiv:2609.08428,
Lemma 5.6).  No single tex sentence is formalized here.

For an index `k : Fin m` the *last-column root* `x_{k, m+1}(a)` and the *last-row root*
`x_{m+1, k}(a)` of `St_{m+1}(R)` are the boundary roots.  For `i ≠ j` in `Fin m` the Steinberg
commutator relation gives

  `⁅x_{i, m+1}(a), x_{m+1, j}(1)⁆ = x_{i j}(a)`,

so the boundary roots generate `St_{m+1}(R)` (`closure_boundaryRoots_eq_top`).  An element
commuting with every boundary root is therefore central (`mem_center_of_commute_boundaryRoots`).
Neither statement needs `2 ≤ m`, and the ring `R` is arbitrary (noncommutative allowed).
-/

namespace GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality

open scoped commutatorElement
open GroupApproximation.BooneHigman.SteinbergBasic

variable (m : ℕ) (R : Type*) [Ring R]

/-- The last-column root `x_{k, m+1}(a)` of `St_{m+1}(R)`. -/
def colRoot (k : Fin m) (a : R) : St (m + 1) R :=
  SteinbergGroup.x k.castSucc (Fin.last m) (Fin.castSucc_ne_last k) a

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.colRoot

/-- The last-row root `x_{m+1, k}(a)` of `St_{m+1}(R)`. -/
def rowRoot (k : Fin m) (a : R) : St (m + 1) R :=
  SteinbergGroup.x (Fin.last m) k.castSucc (Fin.castSucc_ne_last k).symm a

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.rowRoot

/-- The set of all boundary roots of `St_{m+1}(R)`. -/
def boundaryRoots : Set (St (m + 1) R) :=
  {g | ∃ (k : Fin m) (a : R), colRoot m R k a = g} ∪
    {g | ∃ (k : Fin m) (a : R), rowRoot m R k a = g}

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.boundaryRoots

variable {m R}

@[simp] theorem colRoot_zero (k : Fin m) : colRoot m R k 0 = 1 :=
  SteinbergGroup.x_zero _ _ _

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.colRoot_zero

@[simp] theorem rowRoot_zero (k : Fin m) : rowRoot m R k 0 = 1 :=
  SteinbergGroup.x_zero _ _ _

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.rowRoot_zero

theorem colRoot_mem_boundaryRoots (k : Fin m) (a : R) :
    colRoot m R k a ∈ boundaryRoots m R :=
  Or.inl ⟨k, a, rfl⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.colRoot_mem_boundaryRoots

theorem rowRoot_mem_boundaryRoots (k : Fin m) (a : R) :
    rowRoot m R k a ∈ boundaryRoots m R :=
  Or.inr ⟨k, a, rfl⟩

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.rowRoot_mem_boundaryRoots

/-- Every Steinberg generator of `St_{m+1}(R)` lies in the subgroup generated by the boundary
roots.  Interior generators are commutators of a column root and a row root. -/
theorem x_mem_closure_boundaryRoots (i j : Fin (m + 1)) (hij : i ≠ j) (a : R) :
    SteinbergGroup.x i j hij a ∈ Subgroup.closure (boundaryRoots m R) := by
  obtain ⟨i', rfl⟩ | rfl := Fin.eq_castSucc_or_eq_last i
  · obtain ⟨j', rfl⟩ | rfl := Fin.eq_castSucc_or_eq_last j
    · have hcomm := SteinbergGroup.x_commutator (R := R) i'.castSucc (Fin.last m) j'.castSucc
        (Fin.castSucc_ne_last i') (Fin.castSucc_ne_last j').symm hij a 1
      rw [mul_one] at hcomm
      rw [← hcomm, commutatorElement_def]
      have hc : colRoot m R i' a ∈ Subgroup.closure (boundaryRoots m R) :=
        Subgroup.subset_closure (colRoot_mem_boundaryRoots i' a)
      have hr : rowRoot m R j' 1 ∈ Subgroup.closure (boundaryRoots m R) :=
        Subgroup.subset_closure (rowRoot_mem_boundaryRoots j' 1)
      exact mul_mem (mul_mem (mul_mem hc hr) (inv_mem hc)) (inv_mem hr)
    · exact Subgroup.subset_closure (colRoot_mem_boundaryRoots i' a)
  · obtain ⟨j', rfl⟩ | rfl := Fin.eq_castSucc_or_eq_last j
    · exact Subgroup.subset_closure (rowRoot_mem_boundaryRoots j' a)
    · exact absurd rfl hij

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.x_mem_closure_boundaryRoots

/-- The boundary roots generate `St_{m+1}(R)`. -/
theorem closure_boundaryRoots_eq_top :
    Subgroup.closure (boundaryRoots m R) = ⊤ := by
  apply top_unique
  have htop := PresentedGroup.closure_range_of
    (SteinbergGroup.relations (I := Fin (m + 1)) (R := R))
  rw [← htop, Subgroup.closure_le]
  rintro _ ⟨⟨i, j, hij, a⟩, rfl⟩
  exact x_mem_closure_boundaryRoots i j hij a

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.closure_boundaryRoots_eq_top

/-- An element of `St_{m+1}(R)` commuting with every boundary root is central. -/
theorem mem_center_of_commute_boundaryRoots (z : St (m + 1) R)
    (hz : ∀ s ∈ boundaryRoots m R, z * s = s * z) :
    z ∈ Subgroup.center (St (m + 1) R) := by
  rw [Subgroup.mem_center_iff]
  intro g
  have hS : boundaryRoots m R ⊆ Subgroup.centralizer ({z} : Set (St (m + 1) R)) := by
    intro s hs
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro h hh
    rw [Set.mem_singleton_iff] at hh
    rw [hh]
    exact hz s hs
  have hg : g ∈ Subgroup.closure (boundaryRoots m R) := by
    rw [closure_boundaryRoots_eq_top]
    exact Subgroup.mem_top g
  exact ((Subgroup.mem_centralizer_iff.mp (Subgroup.closure_le.mpr hS hg)) z
    (Set.mem_singleton z)).symm

#audit_axioms GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality.mem_center_of_commute_boundaryRoots

end GroupApproximation.SimpleKazhdanSofic.SkRows.PaddedCentrality
