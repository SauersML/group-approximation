/-!
# The lamplighter action of the LEF groups section

`simple_kazhdan_sofic_group.tex` at origin/main 37551fd93 (md5 b55c0d23…), tex 105–106 and 356–365,
in the proof of `cor:lef` and `cor:host`:

> An action on a Cantor set is topologically free if no nontrivial element fixes a nonempty open set.
> ...
> Let `Δ` act on `Ω = F_2^Δ` by `(δx)(h) = x(δ⁻¹h)`, and let `Λ` be the group of maps `x ↦ δx + f`
> with `δ ∈ Δ` and `f` finitely supported.  It is generated by `Δ` and the map `z` adding `1` at `e`,
> and its orbits contain the dense sets `x + ⊕_Δ F_2`.  If `(δ,f) ≠ (e,0)`, the fixed points of
> `x ↦ δx + f` satisfy `x(h) = x(δ⁻¹h) + f(h)` for all `h`.  In every cylinder over a finite set `W`
> this fails at some point, for `h ∈ supp f` if `δ = e` and for `h ∉ W ∪ δW ∪ supp f` if `δ ≠ e`.
> So the action is minimal and topologically free.

* `LampSpace Δ = Δ → ZMod 2`, with the product topology.
* `LampAffine Δ`: the pairs `(f, δ)`, as the semidirect product
  `Multiplicative (Δ →₀ ZMod 2) ⋊[lampAut Δ] Δ` with `(f, δ)(f', δ') = (f + δ f', δ δ')`, acting by
  `(f, δ) • x = δx + f` (`smul_apply`).  The action is faithful (`smul_left_injective`), so
  `LampAffine Δ` is the printed group of maps.
* `closure_insert_lampAdd_range_inr`: `Λ` is generated by `Δ` and `z = lampAdd Δ`.
* `mem_orbit_add`, `dense_add_finsupp`, `isMinimal`: minimality through the dense sets `x + ⊕_Δ F_2`.
* `smul_eq_self_iff`, `exists_moved_of_cylinder`, `isTopologicallyFree`: topological freeness, along
  the printed route.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic

/-- **Topological freeness** (tex 105–106): no nontrivial element fixes a nonempty open set. -/
def IsTopologicallyFreeAction (Λ Z : Type*) [Group Λ] [MulAction Λ Z] [TopologicalSpace Z] :
    Prop :=
  ∀ ξ : Λ, ξ ≠ 1 → ∀ U : Set Z, IsOpen U → U.Nonempty → ∃ x ∈ U, ξ • x ≠ x

namespace Lamplighter

/-- The configurations `Ω = F_2^Δ` (tex 356), with the product topology. -/
abbrev LampSpace (Δ : Type*) : Type _ :=
  Δ → ZMod 2

variable (Δ : Type*) [Group Δ]

/-- Left multiplication by `δ`, as an equivalence of `Δ`. -/
def leftMulEquiv (δ : Δ) : Δ ≃ Δ where
  toFun h := δ * h
  invFun h := δ⁻¹ * h
  left_inv h := inv_mul_cancel_left δ h
  right_inv h := mul_inv_cancel_left δ h

/-- `δ` translates finitely supported configurations: `(δ f)(h) = f(δ⁻¹ h)`. -/
def translate (δ : Δ) : (Δ →₀ ZMod 2) ≃+ (Δ →₀ ZMod 2) :=
  Finsupp.domCongr (leftMulEquiv Δ δ)

theorem translate_apply (δ : Δ) (f : Δ →₀ ZMod 2) (h : Δ) :
    translate Δ δ f h = f (δ⁻¹ * h) :=
  rfl

theorem translate_single (δ a : Δ) (b : ZMod 2) :
    translate Δ δ (Finsupp.single a b) = Finsupp.single (δ * a) b :=
  Finsupp.equivMapDomain_single (leftMulEquiv Δ δ) a b

/-- The translations as automorphisms of the multiplicative group of finitely supported
configurations. -/
def lampAut : Δ →* MulAut (Multiplicative (Δ →₀ ZMod 2)) where
  toFun δ := AddEquiv.toMultiplicative (translate Δ δ)
  map_one' := MulEquiv.ext fun f => by
    show Multiplicative.ofAdd (translate Δ 1 (Multiplicative.toAdd f)) =
      Multiplicative.ofAdd (Multiplicative.toAdd f)
    refine congrArg Multiplicative.ofAdd (Finsupp.ext fun h => ?_)
    rw [translate_apply, inv_one, one_mul]
  map_mul' δ₁ δ₂ := MulEquiv.ext fun f => by
    show Multiplicative.ofAdd (translate Δ (δ₁ * δ₂) (Multiplicative.toAdd f)) =
      Multiplicative.ofAdd (translate Δ δ₁ (translate Δ δ₂ (Multiplicative.toAdd f)))
    refine congrArg Multiplicative.ofAdd (Finsupp.ext fun h => ?_)
    rw [translate_apply, translate_apply, translate_apply, mul_inv_rev, mul_assoc]

theorem lampAut_single (δ a : Δ) :
    lampAut Δ δ (Multiplicative.ofAdd (Finsupp.single a (1 : ZMod 2))) =
      Multiplicative.ofAdd (Finsupp.single (δ * a) (1 : ZMod 2)) :=
  congrArg Multiplicative.ofAdd (translate_single Δ δ a 1)

/-- **The group** `Λ` (tex 357): the pairs `(f, δ)` with `f` finitely supported and `δ ∈ Δ`. -/
abbrev LampAffine : Type _ :=
  Multiplicative (Δ →₀ ZMod 2) ⋊[lampAut Δ] Δ

/-- `(f, δ)` acts on `Ω` by `x ↦ δx + f`, where `(δx)(h) = x(δ⁻¹ h)` (tex 356–357). -/
instance instMulActionLampAffine : MulAction (LampAffine Δ) (LampSpace Δ) where
  smul ξ x := fun h => x (ξ.right⁻¹ * h) + Multiplicative.toAdd ξ.left h
  one_smul x := funext fun h => by
    show x ((1 : Δ)⁻¹ * h) + Multiplicative.toAdd (1 : Multiplicative (Δ →₀ ZMod 2)) h = x h
    rw [inv_one, one_mul, toAdd_one, Finsupp.coe_zero, Pi.zero_apply, add_zero]
  mul_smul ξ η x := funext fun h => by
    show x ((ξ.right * η.right)⁻¹ * h) +
        Multiplicative.toAdd (ξ.left * lampAut Δ ξ.right η.left) h =
      (x (η.right⁻¹ * (ξ.right⁻¹ * h)) + Multiplicative.toAdd η.left (ξ.right⁻¹ * h)) +
        Multiplicative.toAdd ξ.left h
    rw [mul_inv_rev, mul_assoc, toAdd_mul, Finsupp.add_apply]
    show x (η.right⁻¹ * (ξ.right⁻¹ * h)) +
        (Multiplicative.toAdd ξ.left h + translate Δ ξ.right (Multiplicative.toAdd η.left) h) = _
    rw [translate_apply]
    ring

theorem smul_apply (ξ : LampAffine Δ) (x : LampSpace Δ) (h : Δ) :
    (ξ • x) h = x (ξ.right⁻¹ * h) + Multiplicative.toAdd ξ.left h :=
  rfl

/-- Every `x ↦ δx + f` is continuous. -/
instance instContinuousConstSMulLampAffine : ContinuousConstSMul (LampAffine Δ) (LampSpace Δ) where
  continuous_const_smul ξ := continuous_pi fun h =>
    (continuous_of_discreteTopology
        (f := fun c : ZMod 2 => c + Multiplicative.toAdd ξ.left h)).comp
      (continuous_apply (ξ.right⁻¹ * h))

/-- **`Λ` is the group of maps `x ↦ δx + f`**: distinct pairs act by distinct maps. -/
theorem smul_left_injective :
    Function.Injective fun (ξ : LampAffine Δ) (x : LampSpace Δ) => ξ • x := by
  classical
  intro ξ η hξη
  have hx : ∀ (x : LampSpace Δ) (h : Δ), (ξ • x) h = (η • x) h := fun x h =>
    congrFun (congrFun hξη x) h
  have hleft : ξ.left = η.left := by
    refine Multiplicative.toAdd.injective (Finsupp.ext fun h => ?_)
    have h0 := hx (fun _ => 0) h
    rw [smul_apply, smul_apply, zero_add, zero_add] at h0
    exact h0
  have hright : ξ.right = η.right := by
    by_contra hne
    have h1 := hx (fun g => if g = 1 then (1 : ZMod 2) else 0) ξ.right
    rw [smul_apply, smul_apply, inv_mul_cancel, hleft, if_pos rfl] at h1
    have hne' : η.right⁻¹ * ξ.right ≠ 1 := fun he => hne (inv_mul_eq_one.1 he).symm
    rw [if_neg hne'] at h1
    simp at h1
  exact SemidirectProduct.ext hleft hright

/-! ## Generation -/

/-- **The map `z`** (tex 359): adding `1` at the coordinate `e`. -/
def lampAdd : LampAffine Δ :=
  SemidirectProduct.inl (Multiplicative.ofAdd (Finsupp.single 1 (1 : ZMod 2)))

theorem lampAdd_smul_apply (x : LampSpace Δ) (h : Δ) :
    (lampAdd Δ • x) h = x h + Finsupp.single (1 : Δ) (1 : ZMod 2) h := by
  rw [smul_apply]
  show x ((1 : Δ)⁻¹ * h) + _ = _
  rw [inv_one, one_mul]
  rfl

/-- **Generation** (tex 358–359): `Λ` is generated by `Δ` and `z`. -/
theorem closure_insert_lampAdd_range_inr :
    Subgroup.closure
        (insert (lampAdd Δ) (Set.range (SemidirectProduct.inr : Δ →* LampAffine Δ))) = ⊤ := by
  classical
  set H := Subgroup.closure
    (insert (lampAdd Δ) (Set.range (SemidirectProduct.inr : Δ →* LampAffine Δ))) with hH
  have hinr : ∀ δ : Δ, (SemidirectProduct.inr δ : LampAffine Δ) ∈ H := fun δ =>
    Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨δ, rfl⟩)
  have hz : lampAdd Δ ∈ H := Subgroup.subset_closure (Set.mem_insert _ _)
  have hsingle : ∀ a : Δ,
      Multiplicative.ofAdd (Finsupp.single a (1 : ZMod 2)) ∈ H.comap SemidirectProduct.inl := by
    intro a
    rw [Subgroup.mem_comap]
    have h := SemidirectProduct.inl_aut (φ := lampAut Δ) a
      (Multiplicative.ofAdd (Finsupp.single 1 (1 : ZMod 2)))
    rw [lampAut_single, mul_one] at h
    rw [h]
    exact H.mul_mem (H.mul_mem (hinr a) hz) (hinr a⁻¹)
  have hleft : ∀ f : Δ →₀ ZMod 2,
      Multiplicative.ofAdd f ∈ H.comap SemidirectProduct.inl := by
    intro f
    have hf : Multiplicative.ofAdd f =
        ∏ a ∈ f.support, Multiplicative.ofAdd (Finsupp.single a (f a)) := by
      rw [← ofAdd_sum]
      exact congrArg Multiplicative.ofAdd (Finsupp.sum_single f).symm
    rw [hf]
    refine Subgroup.prod_mem _ fun a _ => ?_
    have hb : Finsupp.single a (f a) = (f a).val • Finsupp.single a (1 : ZMod 2) := by
      rw [Finsupp.smul_single, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
    rw [hb, ofAdd_nsmul]
    exact Subgroup.pow_mem _ (hsingle a) _
  refine eq_top_iff.2 fun ξ _ => ?_
  rw [← SemidirectProduct.inl_left_mul_inr_right ξ]
  exact H.mul_mem (hleft (Multiplicative.toAdd ξ.left)) (hinr ξ.right)

/-- For a generating set `T` of `Δ`, `Λ` is generated by `T` and `z`. -/
theorem closure_insert_lampAdd_image_inr {T : Set Δ} (hT : Subgroup.closure T = ⊤) :
    Subgroup.closure
        (insert (lampAdd Δ) ((SemidirectProduct.inr : Δ →* LampAffine Δ) '' T)) = ⊤ := by
  refine eq_top_iff.2 ((closure_insert_lampAdd_range_inr Δ).symm.le.trans
    ((Subgroup.closure_le _).2 ?_))
  rintro _ (rfl | ⟨δ, rfl⟩)
  · exact Subgroup.subset_closure (Set.mem_insert _ _)
  · have hmem : (SemidirectProduct.inr δ : LampAffine Δ) ∈
        Subgroup.closure ((SemidirectProduct.inr : Δ →* LampAffine Δ) '' T) := by
      rw [← MonoidHom.map_closure, hT]
      exact Subgroup.mem_map_of_mem _ (Subgroup.mem_top δ)
    exact Subgroup.closure_mono (Set.subset_insert _ _) hmem

/-- A finitely generated `Δ` gives a finitely generated `Λ`. -/
theorem fg_lampAffine (hΔ : Group.FG Δ) : Group.FG (LampAffine Δ) := by
  obtain ⟨T, hT, hTfin⟩ := Group.fg_iff.1 hΔ
  exact Group.fg_iff.2 ⟨_, closure_insert_lampAdd_image_inr Δ hT, (hTfin.image _).insert _⟩

/-! ## Minimality -/

/-- `x + f` lies in the orbit of `x`, through `x ↦ ex + f`. -/
theorem mem_orbit_add (x : LampSpace Δ) (f : Δ →₀ ZMod 2) :
    (fun h => x h + f h) ∈ MulAction.orbit (LampAffine Δ) x :=
  ⟨SemidirectProduct.inl (Multiplicative.ofAdd f), funext fun h => by
    show x ((1 : Δ)⁻¹ * h) + f h = x h + f h
    rw [inv_one, one_mul]⟩

omit [Group Δ] in
/-- **The dense sets** `x + ⊕_Δ F_2` (tex 359–360). -/
theorem dense_add_finsupp (x : LampSpace Δ) :
    Dense {y : LampSpace Δ | ∃ f : Δ →₀ ZMod 2, ∀ h, y h = x h + f h} := by
  classical
  refine dense_iff_inter_open.2 fun U hU ⟨y, hyU⟩ => ?_
  obtain ⟨I, u, hu, hIU⟩ := isOpen_pi_iff.1 hU y hyU
  refine ⟨fun h => x h + Finsupp.indicator I (fun g _ => y g - x g) h, hIU fun a ha => ?_,
    Finsupp.indicator I (fun g _ => y g - x g), fun _ => rfl⟩
  have ha' : a ∈ I := Finset.mem_coe.1 ha
  show x a + Finsupp.indicator I (fun g _ => y g - x g) a ∈ u a
  rw [Finsupp.indicator_of_mem ha']
  have hxy : x a + (y a - x a) = y a := by ring
  rw [hxy]
  exact (hu a ha').2

/-- **Minimality** (tex 364–365): every orbit contains a dense set. -/
instance isMinimal : MulAction.IsMinimal (LampAffine Δ) (LampSpace Δ) where
  dense_orbit x := (dense_add_finsupp Δ x).mono fun y ⟨f, hf⟩ => by
    rw [show y = fun h => x h + f h from funext hf]
    exact mem_orbit_add Δ x f

/-! ## Topological freeness -/

/-- **Fixed points** (tex 360–361): `x ↦ δx + f` fixes `x` exactly when
`x(h) = x(δ⁻¹h) + f(h)` for all `h`. -/
theorem smul_eq_self_iff (ξ : LampAffine Δ) (x : LampSpace Δ) :
    ξ • x = x ↔ ∀ h, x h = x (ξ.right⁻¹ * h) + Multiplicative.toAdd ξ.left h :=
  ⟨fun hx h => (congrFun hx h).symm, fun hx => funext fun h => (hx h).symm⟩

/-- **In every cylinder the fixed-point equation fails** (tex 361–364): for `(δ, f) ≠ (e, 0)`, every
cylinder over a finite set `W` contains a point that is moved, at a coordinate `h ∈ supp f` if
`δ = e` and at a coordinate `h ∉ W ∪ δW ∪ supp f` if `δ ≠ e`. -/
theorem exists_moved_of_cylinder [Infinite Δ] (ξ : LampAffine Δ) (hξ : ξ ≠ 1) (y : LampSpace Δ)
    (W : Finset Δ) : ∃ x : LampSpace Δ, (∀ a ∈ W, x a = y a) ∧ ξ • x ≠ x := by
  classical
  by_cases hδ : ξ.right = 1
  · have hn : Multiplicative.toAdd ξ.left ≠ 0 := fun h0 =>
      hξ (SemidirectProduct.ext (Multiplicative.ofAdd_eq_one.2 h0) hδ)
    obtain ⟨h, hh⟩ := DFunLike.ne_iff.1 hn
    refine ⟨y, fun _ _ => rfl, fun hfix => hh ?_⟩
    have hy := (smul_eq_self_iff Δ ξ y).1 hfix h
    rw [hδ, inv_one, one_mul] at hy
    simpa using hy
  · obtain ⟨h, hh⟩ := Infinite.exists_notMem_finset
      (W ∪ W.image (ξ.right * ·) ∪ (Multiplicative.toAdd ξ.left).support)
    have hhW : h ∉ W := fun hW => hh (Finset.mem_union_left _ (Finset.mem_union_left _ hW))
    have hf : Multiplicative.toAdd ξ.left h = 0 :=
      Finsupp.notMem_support_iff.1 fun hs => hh (Finset.mem_union_right _ hs)
    have hne : ξ.right⁻¹ * h ≠ h := fun he => hδ (inv_eq_one.1 (mul_eq_right.1 he))
    refine ⟨Function.update y h (y (ξ.right⁻¹ * h) + 1),
      fun a ha => Function.update_of_ne (fun hah => hhW (hah ▸ ha)) _ _, fun hfix => ?_⟩
    have hx := (smul_eq_self_iff Δ ξ _).1 hfix h
    rw [Function.update_self, Function.update_of_ne hne, hf, add_zero] at hx
    simp at hx

/-- **Topological freeness** (tex 364–365). -/
theorem isTopologicallyFree [Infinite Δ] :
    IsTopologicallyFreeAction (LampAffine Δ) (LampSpace Δ) := by
  intro ξ hξ U hU ⟨y, hyU⟩
  obtain ⟨I, u, hu, hIU⟩ := isOpen_pi_iff.1 hU y hyU
  obtain ⟨x, hxy, hx⟩ := exists_moved_of_cylinder Δ ξ hξ y I
  refine ⟨x, hIU fun a ha => ?_, hx⟩
  have ha' : a ∈ I := Finset.mem_coe.1 ha
  rw [hxy a ha']
  exact (hu a ha').2

end Lamplighter

open Lamplighter

/-! ## Printed endpoints -/

/-- **The action and the group** (tex 356–359): `(f, δ)` acts by `x ↦ δx + f`, distinct pairs act by
distinct maps (so `Λ` is the group of these maps), and `Λ` is generated by `Δ` and `z`. -/
def PrintedLamplighterAffineGroup : Prop :=
  ∀ (Δ : Type) [Group Δ],
    (∀ (ξ : LampAffine Δ) (x : LampSpace Δ) (h : Δ),
      (ξ • x) h = x (ξ.right⁻¹ * h) + Multiplicative.toAdd ξ.left h) ∧
    Function.Injective (fun (ξ : LampAffine Δ) (x : LampSpace Δ) => ξ • x) ∧
    Subgroup.closure
      (insert (lampAdd Δ) (Set.range (SemidirectProduct.inr : Δ →* LampAffine Δ))) = ⊤

theorem printedLamplighterAffineGroup : PrintedLamplighterAffineGroup := fun Δ _ =>
  ⟨smul_apply Δ, smul_left_injective Δ, closure_insert_lampAdd_range_inr Δ⟩

#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedLamplighterAffineGroup

/-- **Minimal and topologically free** (tex 359–365), for an infinite group `Δ`: the orbits contain
the dense sets `x + ⊕_Δ F_2`; the fixed points of `x ↦ δx + f` satisfy `x(h) = x(δ⁻¹h) + f(h)`; for
`(δ, f) ≠ (e, 0)` every cylinder over a finite set contains a moved point; so the action is minimal
and topologically free. -/
def PrintedLamplighterMinimalTopologicallyFree : Prop :=
  ∀ (Δ : Type) [Group Δ] [Infinite Δ],
    (∀ x : LampSpace Δ,
      (∀ f : Δ →₀ ZMod 2, (fun h => x h + f h) ∈ MulAction.orbit (LampAffine Δ) x) ∧
        Dense {y : LampSpace Δ | ∃ f : Δ →₀ ZMod 2, ∀ h, y h = x h + f h}) ∧
    (∀ (ξ : LampAffine Δ) (x : LampSpace Δ),
      ξ • x = x ↔ ∀ h, x h = x (ξ.right⁻¹ * h) + Multiplicative.toAdd ξ.left h) ∧
    (∀ ξ : LampAffine Δ, ξ ≠ 1 → ∀ (y : LampSpace Δ) (W : Finset Δ),
      ∃ x : LampSpace Δ, (∀ a ∈ W, x a = y a) ∧ ξ • x ≠ x) ∧
    MulAction.IsMinimal (LampAffine Δ) (LampSpace Δ) ∧
    IsTopologicallyFreeAction (LampAffine Δ) (LampSpace Δ)

theorem printedLamplighterMinimalTopologicallyFree :
    PrintedLamplighterMinimalTopologicallyFree := fun Δ _ _ =>
  ⟨fun x => ⟨mem_orbit_add Δ x, dense_add_finsupp Δ x⟩, smul_eq_self_iff Δ,
    fun ξ hξ y W => exists_moved_of_cylinder Δ ξ hξ y W, inferInstance, isTopologicallyFree Δ⟩

#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedLamplighterMinimalTopologicallyFree

end SimpleKazhdanSofic
