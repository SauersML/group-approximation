import GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.InvolSplitCoverBasic
import GroupApproximation.Meta.AxiomGuard

/-!
# Involutive split cover, part 2: splitting rigid stabilizers from involution disjointness

Census row `2e7c7d9ab149` (tex: "for topological full groups the converse holds"); lane
`sk-flip-09`.

`exists_split_of_involution_disjoint` has the conclusion of the corpus
`exists_split_of_disjoint` (`RigidSplitCover.lean`), with `hΦ`, `hΦs` weakened to pairs of
*involutions* with disjoint moved sets.  It is unconditional; the involutive witnesses come from
lane 08's `exists_involution_supportedIn_apply_ne` (`InvolSmall.lean`).

Route.  The corpus proof tests `hΦ` against an arbitrary `k ∈ F_{Uᶜ}`, which is not an
involution, so it cannot be copied verbatim (note N7: `F_{Uᶜ}` is not generated by involutions).
We use the covering argument on both sides instead:

1. `exists_involution_cover` gives involutions `f_i ∈ F_U` covering `U` and `g_j ∈ F_{Uᶜ}`
   covering `Uᶜ`.  Put `V = ⋃ movedSet (Φ f_i)` and `V' = ⋃ movedSet (Φ g_j)`.
2. `supportedIn_of_involution_cover`: `Φ F_U ⊆ F_V`.  For `f ∈ F_U` let
   `N = movedSet (Φ f) \ V`.  If `σ` is an involution of `[[S]]` supported in `N`, then `σ` and
   each `Φ f_i` are involutions with disjoint moved sets, so `hΦs` makes `Φ⁻¹ σ` disjoint from
   every `f_i`, hence supported in `Uᶜ`; it commutes with `f`, so `σ` commutes with `Φ f`.  By
   `supportedIn_compl_of_forall_involution_commute`, `Φ f` fixes `N`, so `N = ∅`.
   Likewise `Φ F_{Uᶜ} ⊆ F_{V'}`.
3. `V' ⊆ Vᶜ`: `f_i`, `g_j` are involutions with disjoint moved sets, so `hΦ` applies.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse

open Topology

variable {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]

/-- If finitely many involutions `f_i ∈ F_U` cover `U`, then `Φ F_U ⊆ F_V` with
`V = ⋃ movedSet (Φ f_i)`, provided `Φ⁻¹` preserves disjointness of involutions. -/
theorem supportedIn_of_involution_cover [CompactSpace Y] [T2Space Y]
    [TotallyDisconnectedSpace Y] [PerfectSpace Y] {T : X ≃ₜ X} {S : Y ≃ₜ Y}
    (hS : IsMinimalHomeo S) (hSa : IsAperiodic S)
    (Φ : topologicalFullGroup T ≃* topologicalFullGroup S)
    (hΦs : ∀ f k : topologicalFullGroup S, f * f = 1 → k * k = 1 →
      Disjoint (movedSet (f : Y ≃ₜ Y)) (movedSet (k : Y ≃ₜ Y)) →
        Disjoint (movedSet ((Φ.symm f : topologicalFullGroup T) : X ≃ₜ X))
          (movedSet ((Φ.symm k : topologicalFullGroup T) : X ≃ₜ X)))
    {U : Set X}
    (t : Finset {f : topologicalFullGroup T // f * f = 1 ∧ SupportedIn (f : X ≃ₜ X) U})
    (ht : U ⊆ ⋃ i ∈ t, movedSet ((i.1 : topologicalFullGroup T) : X ≃ₜ X))
    (f : topologicalFullGroup T) (hf : SupportedIn (f : X ≃ₜ X) U) :
    SupportedIn ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y)
      (⋃ i ∈ t, movedSet ((Φ i.1 : topologicalFullGroup S) : Y ≃ₜ Y)) := by
  have hV : IsClopen (⋃ i ∈ t, movedSet ((Φ i.1 : topologicalFullGroup S) : Y ≃ₜ Y)) :=
    isClopen_biUnion_finset fun i _ => isClopen_movedSet hSa (Φ i.1).2
  have hN : IsOpen (movedSet ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y) ∩
      (⋃ i ∈ t, movedSet ((Φ i.1 : topologicalFullGroup S) : Y ≃ₜ Y))ᶜ) :=
    (isClopen_movedSet hSa (Φ f).2).isOpen.inter hV.isClosed.isOpen_compl
  have hfix : SupportedIn ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y)
      (movedSet ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y) ∩
        (⋃ i ∈ t, movedSet ((Φ i.1 : topologicalFullGroup S) : Y ≃ₜ Y))ᶜ)ᶜ := by
    refine supportedIn_compl_of_forall_involution_commute
      (h := ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y)) hS hN fun σ hσ hσ2 hσN => ?_
    have hσ2' : (⟨σ, hσ⟩ : topologicalFullGroup S) * ⟨σ, hσ⟩ = 1 := Subtype.ext hσ2
    have hgU :
        SupportedIn ((Φ.symm ⟨σ, hσ⟩ : topologicalFullGroup T) : X ≃ₜ X) Uᶜ := by
      refine supportedIn_iff_movedSet_subset.2 fun x hx =>
        (Set.mem_compl_iff _ _).2 fun hxU => ?_
      obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.1 (ht hxU)
      have hd : Disjoint (movedSet ((Φ i.1 : topologicalFullGroup S) : Y ≃ₜ Y))
          (movedSet σ) := by
        refine Set.disjoint_left.2 fun y hy1 hy2 => ?_
        have hy3 := supportedIn_iff_movedSet_subset.1 hσN hy2
        exact (Set.mem_compl_iff _ _).1 hy3.2 (Set.mem_iUnion₂.2 ⟨i, hi, hy1⟩)
      have hi2 : Φ i.1 * Φ i.1 = 1 := by
        rw [← map_mul Φ, i.2.1, map_one]
      have hd' := hΦs (Φ i.1) ⟨σ, hσ⟩ hi2 hσ2' hd
      rw [MulEquiv.symm_apply_apply] at hd'
      exact Set.disjoint_left.1 hd' hxi hx
    have hsub : f * Φ.symm ⟨σ, hσ⟩ = Φ.symm ⟨σ, hσ⟩ * f :=
      Subtype.ext (hf.commute_of_compl hgU)
    have hcomm' : Φ (f * Φ.symm ⟨σ, hσ⟩) = Φ (Φ.symm ⟨σ, hσ⟩ * f) := by
      rw [hsub]
    rw [map_mul, map_mul, MulEquiv.apply_symm_apply] at hcomm'
    exact congrArg Subtype.val hcomm'
  refine supportedIn_iff_movedSet_subset.2 fun y hy => ?_
  by_contra hyV
  have hy' : ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y) y ≠ y := hy
  exact hy' (hfix y (Set.notMem_compl_iff.2 ⟨hy, hyV⟩))

/-- Lane `sk-flip-09`: the split of rigid stabilizers from transport of disjointness of
*involutions* only. -/
theorem exists_split_of_involution_disjoint [CompactSpace X] [T2Space X]
    [TotallyDisconnectedSpace X] [PerfectSpace X] [CompactSpace Y] [T2Space Y]
    [TotallyDisconnectedSpace Y] [PerfectSpace Y]
    {T : X ≃ₜ X} {S : Y ≃ₜ Y} (hT : IsMinimalHomeo T) (hS : IsMinimalHomeo S)
    (hTa : IsAperiodic T) (hSa : IsAperiodic S)
    (Φ : topologicalFullGroup T ≃* topologicalFullGroup S)
    (hΦ : ∀ f k : topologicalFullGroup T, f * f = 1 → k * k = 1 →
      Disjoint (movedSet (f : X ≃ₜ X)) (movedSet (k : X ≃ₜ X)) →
        Disjoint (movedSet ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y))
          (movedSet ((Φ k : topologicalFullGroup S) : Y ≃ₜ Y)))
    (hΦs : ∀ f k : topologicalFullGroup S, f * f = 1 → k * k = 1 →
      Disjoint (movedSet (f : Y ≃ₜ Y)) (movedSet (k : Y ≃ₜ Y)) →
        Disjoint (movedSet ((Φ.symm f : topologicalFullGroup T) : X ≃ₜ X))
          (movedSet ((Φ.symm k : topologicalFullGroup T) : X ≃ₜ X)))
    {U : Set X} (hU : IsClopen U) :
    ∃ V : Set Y, IsClopen V ∧
      (∀ g : topologicalFullGroup T, SupportedIn (g : X ≃ₜ X) U →
        SupportedIn ((Φ g : topologicalFullGroup S) : Y ≃ₜ Y) V) ∧
      ∀ g : topologicalFullGroup T, SupportedIn (g : X ≃ₜ X) Uᶜ →
        SupportedIn ((Φ g : topologicalFullGroup S) : Y ≃ₜ Y) Vᶜ := by
  obtain ⟨t, ht⟩ := exists_involution_cover hT hTa hU
  obtain ⟨t', ht'⟩ := exists_involution_cover hT hTa hU.compl
  have hV : IsClopen (⋃ i ∈ t, movedSet ((Φ i.1 : topologicalFullGroup S) : Y ≃ₜ Y)) :=
    isClopen_biUnion_finset fun i _ => isClopen_movedSet hSa (Φ i.1).2
  refine ⟨⋃ i ∈ t, movedSet ((Φ i.1 : topologicalFullGroup S) : Y ≃ₜ Y), hV,
    supportedIn_of_involution_cover hS hSa Φ hΦs t ht, fun k hk => ?_⟩
  refine (supportedIn_of_involution_cover hS hSa Φ hΦs t' ht' k hk).mono ?_
  intro y hy
  obtain ⟨j, -, hyj⟩ := Set.mem_iUnion₂.1 hy
  refine (Set.mem_compl_iff _ _).2 fun hyV => ?_
  obtain ⟨i, -, hyi⟩ := Set.mem_iUnion₂.1 hyV
  have hd : Disjoint (movedSet ((i.1 : topologicalFullGroup T) : X ≃ₜ X))
      (movedSet ((j.1 : topologicalFullGroup T) : X ≃ₜ X)) := by
    refine Set.disjoint_left.2 fun x hx1 hx2 => ?_
    exact (Set.mem_compl_iff _ _).1 (supportedIn_iff_movedSet_subset.1 j.2.2 hx2)
      (supportedIn_iff_movedSet_subset.1 i.2.2 hx1)
  exact Set.disjoint_left.1 (hΦ i.1 j.1 i.2.1 j.2.1 hd) hyi hyj

end GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.supportedIn_of_involution_cover
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.exists_split_of_involution_disjoint
