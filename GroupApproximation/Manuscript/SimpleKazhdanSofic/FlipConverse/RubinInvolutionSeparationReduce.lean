/-!
# Rubin transport, part 5: the involution separation gap

Lane `sk-flip-22`.  Census row `2e7c7d9ab149` (tex: "for topological full groups the converse
holds"; the row names no sentence of the current tex, so there is no tex line).

The gap `RubinInvolutionBasisSeparationStatement`: on a clopen neighbourhood basis, `Φ` maps
involutions supported in `V` and involutions supported in `Vᶜ` to elements with disjoint moved
sets.  Compared with `RubinBasisGeneratorSeparationStatement` there are no generating sets to
choose.  The test family is fixed (involutions only), and so is the complementary pair `V`, `Vᶜ`.

* `rigidPolarBasisOpenTransport_of_rubinInvolutionBasisSeparation`: the reduction (double
  centraliser plus involution forcing, `rubinTransport_rigid_eq_of_involutionSeparation`).
* `rubinInvolutionBasisSeparation_of_rigidPolarBasisOpenTransport`: truth check.  The gap follows
  from the known-true basis open transport.
* `rubinInvolution_conj_commute_collapse`: why the lane's suggested first-order test degenerates.
  "`f` commutes with `g k g⁻¹` for all `g ∈ C(f)`" is already implied by `[f, k] = 1`.  So it cannot
  detect disjoint supports: it holds for `k = f`.

**Loud truth check.**
* `F_V` is not generated by involutions (index map; see `RubinInvolutionSeparation`).
* The finite-model checks (scratchpad `sk-flip-22/check.py`, `S_n` embedded in `[[T]]` via
  Kakutani–Rokhlin towers) refute the tested commutator characterisations of disjoint supports:
  the `C(f)`-conjugate test (collapse above), the all-`G` conjugate test (fails on `(01)`, `(23)`
  in `S_4`) and the `C(k)`-conjugate test.
* No first-order characterisation was verified, so the remaining gap is stated about `Φ` directly.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse

open Topology

/-- Involution separation on a clopen neighbourhood basis.  TRUE
(`rubinInvolutionBasisSeparation_of_rigidPolarBasisOpenTransport`). -/
def RubinInvolutionBasisSeparationStatement : Prop :=
  ∀ (X Y : Type) [TopologicalSpace X] [TopologicalSpace Y] [CompactSpace X] [T2Space X]
    [TotallyDisconnectedSpace X] [PerfectSpace X] [Nonempty X]
    [TopologicalSpace.MetrizableSpace X] [CompactSpace Y] [T2Space Y]
    [TotallyDisconnectedSpace Y] [PerfectSpace Y] [Nonempty Y]
    [TopologicalSpace.MetrizableSpace Y] (T : X ≃ₜ X) (S : Y ≃ₜ Y),
    IsMinimalHomeo T → IsMinimalHomeo S →
      ∀ Φ : topologicalFullGroup T ≃* topologicalFullGroup S, ∀ (x : X) (W : Set X),
        IsOpen W → x ∈ W →
          ∃ V : Set X, IsClopen V ∧ x ∈ V ∧ V ⊆ W ∧
            ∀ f k : topologicalFullGroup T, f * f = 1 → k * k = 1 →
              SupportedIn (f : X ≃ₜ X) V → SupportedIn (k : X ≃ₜ X) Vᶜ →
                Disjoint (movedSet ((Φ f : topologicalFullGroup S) : Y ≃ₜ Y))
                  (movedSet ((Φ k : topologicalFullGroup S) : Y ≃ₜ Y))

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.RubinInvolutionBasisSeparationStatement

/-- The reduction: involution separation on a clopen basis gives basis open transport, with
`O = interior (closure (rubinInvolutionImageSupport Φ V))`. -/
theorem rigidPolarBasisOpenTransport_of_rubinInvolutionBasisSeparation
    (h : RubinInvolutionBasisSeparationStatement) : RigidPolarBasisOpenTransportStatement :=
  fun X Y _ _ _ _ _ _ _ _ _ _ _ _ _ _ T S hT hS Φ x W hW hxW => by
    obtain ⟨V, hVc, hxV, hVW, hsep⟩ := h X Y T S hT hS Φ x W hW hxW
    exact ⟨V, hVc, hxV, hVW, _, isOpen_interior,
      rubinTransport_rigid_eq_of_involutionSeparation hT hS Φ hVc hsep⟩

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.rigidPolarBasisOpenTransport_of_rubinInvolutionBasisSeparation

/-- The lane target from involution separation. -/
theorem rubinBasisGeneratorSeparation_of_rubinInvolutionBasisSeparation
    (h : RubinInvolutionBasisSeparationStatement) : RubinBasisGeneratorSeparationStatement :=
  rubinBasisGeneratorSeparation_of_rigidPolarBasisOpenTransport
    (rigidPolarBasisOpenTransport_of_rubinInvolutionBasisSeparation h)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.rubinBasisGeneratorSeparation_of_rubinInvolutionBasisSeparation

/-- Truth check: basis open transport gives involution separation.  If `Φ F_V = F_O`, then
`Φ F_{Vᶜ} = Φ C(F_V) = C(F_O) = F_{Oᶜ}`. -/
theorem rubinInvolutionBasisSeparation_of_rigidPolarBasisOpenTransport
    (h : RigidPolarBasisOpenTransportStatement) : RubinInvolutionBasisSeparationStatement :=
  fun X Y _ _ _ _ _ _ _ _ _ _ _ _ _ _ T S hT hS Φ x W hW hxW => by
    obtain ⟨V, hVc, hxV, hVW, O, hO, hPO⟩ := h X Y T S hT hS Φ x W hW hxW
    refine ⟨V, hVc, hxV, hVW, fun f k _ _ hf hk => ?_⟩
    have hΦf : Φ f ∈ rubinRigidSubgroup S O := by
      rw [← hPO, mem_rubinTransport, MulEquiv.symm_apply_apply]
      exact mem_rubinRigidSubgroup.2 hf
    have hΦk : Φ k ∈ rubinRigidSubgroup S Oᶜ := by
      rw [← centralizer_rubinRigidSubgroup hS hO, ← hPO, rubinTransport_centralizer,
        mem_rubinTransport, MulEquiv.symm_apply_apply, centralizer_rubinRigidSubgroup hT hVc.isOpen]
      exact mem_rubinRigidSubgroup.2 hk
    refine Set.disjoint_left.2 fun y hy1 hy2 => ?_
    exact (Set.mem_compl_iff _ _).1
      (supportedIn_iff_movedSet_subset.1 (mem_rubinRigidSubgroup.1 hΦk) hy2)
      (supportedIn_iff_movedSet_subset.1 (mem_rubinRigidSubgroup.1 hΦf) hy1)

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.rubinInvolutionBasisSeparation_of_rigidPolarBasisOpenTransport

/-- Negative truth check: the test "`f` commutes with every `C(f)`-conjugate of `k`" follows from
`[f, k] = 1`, so it cannot separate supports. -/
theorem rubinInvolution_conj_commute_collapse {G : Type*} [Group G] {f k g : G}
    (hfk : f * k = k * f) (hg : g * f = f * g) :
    f * (g * k * g⁻¹) = (g * k * g⁻¹) * f := by
  have hfg : Commute f g := (show Commute g f from hg).symm
  exact (hfg.mul_right (show Commute f k from hfk)).mul_right hfg.inv_right

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.rubinInvolution_conj_commute_collapse

/-- The printed converse for topological full groups, reduced to involution separation. -/
theorem manuscriptSentence_flipConjugateConverse_of_rubinInvolutionBasisSeparation
    (h : RubinInvolutionBasisSeparationStatement) {X Y : Type} [TopologicalSpace X]
    [TopologicalSpace Y] [CompactSpace X] [T2Space X] [TotallyDisconnectedSpace X]
    [PerfectSpace X] [Nonempty X] [TopologicalSpace.MetrizableSpace X] [CompactSpace Y]
    [T2Space Y] [TotallyDisconnectedSpace Y] [PerfectSpace Y] [Nonempty Y]
    [TopologicalSpace.MetrizableSpace Y] {T : X ≃ₜ X} {S : Y ≃ₜ Y}
    (hT : IsMinimalHomeo T) (hS : IsMinimalHomeo S) :
    Nonempty (topologicalFullGroup T ≃* topologicalFullGroup S) ↔ FlipConjugate T S :=
  manuscriptSentence_flipConjugateConverse_of_rigidPolarBasisOpenTransport
    (rigidPolarBasisOpenTransport_of_rubinInvolutionBasisSeparation h) hT hS

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse.manuscriptSentence_flipConjugateConverse_of_rubinInvolutionBasisSeparation

end GroupApproximation.Manuscript.SimpleKazhdanSofic.FlipConverse
