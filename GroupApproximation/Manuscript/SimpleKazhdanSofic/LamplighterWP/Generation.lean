import GroupApproximation.Manuscript.SimpleKazhdanSofic.HalflineB.Represent
import GroupApproximation.Manuscript.SimpleKazhdanSofic.ElementaryGroupFacts
import GroupApproximation.Manuscript.SimpleKazhdanSofic.WordProblemDegreeStatements
import GroupApproximation.Meta.AxiomGuard

/-!
# Finite generators of `G_Δ = EL_3(R_Δ)`

`simple_kazhdan_sofic_group.tex`, proof of `lem:halfline` (b), l.657–658:

> A word in the generators of $G_\Delta$ multiplies out to a matrix with entries $\sum_\xi p_\xi u_\xi$ …

and the generation of the ring and of `EL_3`, l.87 and l.94–95 and l.365–368:

> the matrices $e_{ij}(s)$, for $s ∈ \{1, u, u^{-1}\} ∪ \{e_a\}$, generate $G$.

## Proof route

For a finite generating family `t` of `Δ`, the letters of `Λ` are `lampGen t : Option ι → Λ`, and they
generate `Λ` (`HalflineB.closure_range_lampGen`). The ring `R_Δ` is generated by `1`, the `u_ξ^{±1}` for
`ξ` a letter of `Λ`, and `e_U` (`Lamplighter.closure_generators_eq_top`). So the matrices `e_ij(s)` with
`s ∈ {1} ∪ {u_ξ^{±1}} ∪ {e_U}` generate `G_Δ` (`printedElementaryGeneration`). Of these, the `e_ij(1)` are
not in our family `hostGen t` of generators, but `e_ij(1) = [e_ik(u_z), e_kj(u_z⁻¹)]` for the third index
`k`, so they lie in the subgroup generated by `hostGen t` (`closure_range_hostGen`).
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace LamplighterWP

open Lamplighter
open scoped commutatorElement

variable {Δ : Type} [Group Δ] {ι : Type}

/-- The letters of `G_Δ`: an off-diagonal position `(i, j)` and a coefficient code. -/
abbrev HGen (ι : Type) : Type := OffDiag × Option (Option ι × Bool)

/-- The coefficients: `none ↦ e_U`, `some (o, true) ↦ u_{lampGen t o}`, `some (o, false) ↦ u_{lampGen t o}⁻¹`. -/
noncomputable def coeffVal (t : ι → Δ) : Option (Option ι × Bool) → LampRing Δ
  | none => ClopenGroupCrossedProduct.coeff (LampAffine Δ) (LampSpace Δ) (ZMod 2)
      (LocallyConstant.charFn (ZMod 2) (isClopen_coordOne Δ))
  | some (o, true) =>
      (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) (lampGen t o) : LampRing Δ)
  | some (o, false) =>
      (((ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) (lampGen t o))⁻¹ :
        (LampRing Δ)ˣ) : LampRing Δ)

/-- The generators `e_ij(s)` of `G_Δ`. -/
noncomputable def hostGen (t : ι → Δ) (g : HGen ι) : ↥(elementaryGroup (Fin 3) (LampRing Δ)) :=
  ⟨elementaryUnit g.1.1.1 g.1.1.2 g.1.2 (coeffVal t g.2), elementaryUnit_mem _ _ _ _⟩

theorem hostGen_val (t : ι → Δ) (g : HGen ι) :
    ((hostGen t g : ↥(elementaryGroup (Fin 3) (LampRing Δ))) : (Matrix (Fin 3) (Fin 3) (LampRing Δ))ˣ) =
      elementaryUnit g.1.1.1 g.1.1.2 g.1.2 (coeffVal t g.2) :=
  rfl

theorem third_index : ∀ i j : Fin 3, i ≠ j → ∃ k : Fin 3, i ≠ k ∧ k ≠ j := by decide

/-- `e_ij(1)` lies in any subgroup containing all `e_ij(u_z)` and `e_ij(u_z⁻¹)`. -/
theorem elementaryUnit_one_mem (t : ι → Δ) (H : Subgroup (Matrix (Fin 3) (Fin 3) (LampRing Δ))ˣ)
    (hgen : ∀ (i j : Fin 3) (h : i ≠ j) (c : Option (Option ι × Bool)),
      elementaryUnit i j h (coeffVal t c) ∈ H) (i j : Fin 3) (h : i ≠ j) :
    elementaryUnit i j h 1 ∈ H := by
  obtain ⟨k, hik, hkj⟩ := third_index i j h
  have e := elementaryUnit_commutator i k j hik hkj h
    (coeffVal t (some (none, true))) (coeffVal t (some (none, false)))
  have hu : coeffVal t (some (none, true)) * coeffVal t (some (none, false)) = 1 :=
    Units.mul_inv (ClopenGroupCrossedProduct.unit (LampAffine Δ) (LampSpace Δ) (ZMod 2) (lampGen t none))
  rw [hu, commutatorElement_def] at e
  rw [← e]
  exact H.mul_mem (H.mul_mem (H.mul_mem (hgen i k hik _) (hgen k j hkj _))
    (H.inv_mem (hgen i k hik _))) (H.inv_mem (hgen k j hkj _))

/-- **The generators `hostGen t` generate `G_Δ`.** -/
theorem closure_range_hostGen (t : ι → Δ) (ht : Subgroup.closure (Set.range t) = ⊤) :
    Subgroup.closure (Set.range (hostGen t)) = ⊤ := by
  set K : Subgroup ↥(elementaryGroup (Fin 3) (LampRing Δ)) := Subgroup.closure (Set.range (hostGen t))
    with hK
  set H : Subgroup (Matrix (Fin 3) (Fin 3) (LampRing Δ))ˣ :=
    K.map (elementaryGroup (Fin 3) (LampRing Δ)).subtype with hH
  have hgen : ∀ (i j : Fin 3) (h : i ≠ j) (c : Option (Option ι × Bool)),
      elementaryUnit i j h (coeffVal t c) ∈ H :=
    fun i j h c => ⟨hostGen t (⟨(i, j), h⟩, c), Subgroup.subset_closure ⟨_, rfl⟩, rfl⟩
  have hle : elementaryGroup (Fin 3) (LampRing Δ) ≤ H := by
    rw [printedElementaryGeneration (LampRing Δ) (lampRingGenerators Δ (Set.range (lampGen t)))
      (closure_generators_eq_top Δ (Manuscript.SimpleKazhdanSofic.HalflineB.closure_range_lampGen t ht)),
      Subgroup.closure_le]
    rintro _ ⟨i, j, h, s, hs, rfl⟩
    rcases hs with rfl | hs
    · exact elementaryUnit_one_mem t H hgen i j h
    · unfold lampRingGenerators at hs
      rcases hs with rfl | ((⟨_, ⟨o, rfl⟩, rfl⟩ | ⟨_, ⟨o, rfl⟩, rfl⟩) | rfl)
      · exact elementaryUnit_one_mem t H hgen i j h
      · exact hgen i j h (some (o, true))
      · exact hgen i j h (some (o, false))
      · exact hgen i j h none
  rw [eq_top_iff]
  rintro x -
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.1 (hle x.2)
  have hxy : y = x := Subtype.ext hyx
  exact hxy ▸ hy

#audit_axioms GroupApproximation.SimpleKazhdanSofic.LamplighterWP.closure_range_hostGen

end LamplighterWP
end SimpleKazhdanSofic
end GroupApproximation
