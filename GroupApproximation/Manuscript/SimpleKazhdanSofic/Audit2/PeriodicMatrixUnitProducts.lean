#audit_axioms GroupApproximation.SimpleKazhdanSofic.Audit2.shiftMatrix_mul_single_self
#audit_axioms GroupApproximation.SimpleKazhdanSofic.Audit2.manuscriptSentence_distinctShiftsGiveMatrixUnits
