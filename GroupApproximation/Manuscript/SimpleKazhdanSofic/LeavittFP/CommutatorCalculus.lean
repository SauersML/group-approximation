import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.Tactic.Group
import GroupApproximation.Meta.AxiomGuard

/-!
# Commutator identities for the Steinberg presentation of `St_5(ℤ⟨X⟩)`

This module collects group-theoretic identities used in the finite presentation of the Steinberg
group `St_5(ℤ⟨X⟩)` over a free algebra on a finite alphabet.  That presentation, together with the
exactness of Steinberg groups under surjective coefficient maps with finitely generated kernel, is
the route to finite presentability of `St_5(L_{𝔽₂}(1,2))`.  See
`LeavittFP.Endpoints` for the route and the reason it was chosen.

* `comm_mul_left`, `comm_mul_right`: expansion of a commutator with a product entry.
* `comm_assoc`: the Hall–Witt style identity `⁅x, ⁅b, c⁆⁆ = ⁅⁅x, b⁆, c⁆` under three commutation
  hypotheses.
* `commute_commutatorElement_right`, `commute_commutatorElement_left`,
  `commute_of_mem_closure`: commutation passes to commutators and to generated subgroups.
-/

namespace GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP

open scoped commutatorElement

variable {G : Type*} [Group G]

/-- A commutator with a product as left entry. -/
theorem comm_mul_left (d b c : G) : ⁅d * b, c⁆ = d * ⁅b, c⁆ * d⁻¹ * ⁅d, c⁆ := by
  simp only [commutatorElement_def]
  group

/-- A commutator with a product as right entry. -/
theorem comm_mul_right (g h h' : G) : ⁅g, h * h'⁆ = ⁅g, h⁆ * h * ⁅g, h'⁆ * h⁻¹ := by
  simp only [commutatorElement_def]
  group

/-- If `x` commutes with `c`, and `⁅b, c⁆` commutes with both `⁅x, b⁆` and `⁅⁅x, b⁆, c⁆`, then
`⁅x, ⁅b, c⁆⁆ = ⁅⁅x, b⁆, c⁆`. -/
theorem comm_assoc (x b c : G) (hxc : Commute x c) (hde : Commute ⁅x, b⁆ ⁅b, c⁆)
    (heh : Commute ⁅b, c⁆ ⁅⁅x, b⁆, c⁆) : ⁅x, ⁅b, c⁆⁆ = ⁅⁅x, b⁆, c⁆ := by
  have hxb : x * b * x⁻¹ = ⁅x, b⁆ * b := by
    rw [commutatorElement_def]
    group
  have hxc' : x * c * x⁻¹ = c := by
    rw [hxc.eq, mul_inv_cancel_right]
  have h1 : x * ⁅b, c⁆ * x⁻¹ = ⁅b, c⁆ * ⁅⁅x, b⁆, c⁆ := by
    rw [conjugate_commutatorElement, hxb, hxc', comm_mul_left ⁅x, b⁆ b c, hde.eq,
      mul_inv_cancel_right]
  rw [commutatorElement_def x ⁅b, c⁆, h1, heh.eq, mul_inv_cancel_right]

/-- An element commuting with `b` and `c` commutes with `⁅b, c⁆`. -/
theorem commute_commutatorElement_right {a b c : G} (hb : Commute a b) (hc : Commute a c) :
    Commute a ⁅b, c⁆ := by
  rw [commutatorElement_def]
  exact ((hb.mul_right hc).mul_right hb.inv_right).mul_right hc.inv_right

/-- An element commuting with `a` and `b` commutes with `⁅a, b⁆`. -/
theorem commute_commutatorElement_left {a b c : G} (ha : Commute a c) (hb : Commute b c) :
    Commute ⁅a, b⁆ c :=
  (commute_commutatorElement_right ha.symm hb.symm).symm

/-- If every element of `s` commutes with every element of `t`, then every element of the
subgroup generated by `s` commutes with every element of the subgroup generated by `t`. -/
theorem commute_of_mem_closure {s t : Set G} (h : ∀ x ∈ s, ∀ y ∈ t, Commute x y) {g k : G}
    (hg : g ∈ Subgroup.closure s) (hk : k ∈ Subgroup.closure t) : Commute g k := by
  have ht : Subgroup.closure t ≤ Subgroup.centralizer s := by
    rw [Subgroup.closure_le]
    intro y hy
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro x hx
    exact (h x hx y hy).eq
  have hs : Subgroup.closure s ≤ Subgroup.centralizer (Subgroup.closure t : Set G) := by
    rw [Subgroup.closure_le]
    intro x hx
    rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro y hy
    exact ((Subgroup.mem_centralizer_iff.mp (ht hy)) x hx).symm
  exact ((Subgroup.mem_centralizer_iff.mp (hs hg)) k hk).symm

end GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP

#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.comm_mul_left
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.comm_mul_right
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.comm_assoc
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.commute_commutatorElement_right
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.commute_commutatorElement_left
#audit_axioms GroupApproximation.Manuscript.SimpleKazhdanSofic.LeavittFP.commute_of_mem_closure
