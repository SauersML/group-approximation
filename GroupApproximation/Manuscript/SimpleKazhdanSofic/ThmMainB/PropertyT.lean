import GroupApproximation.Manuscript.SimpleKazhdanSofic.Setting
import GroupApproximation.Manuscript.SimpleKazhdanSofic.RingLaurent
import GroupApproximation.Manuscript.SimpleKazhdanSofic.MainAssemblyPieces
import GroupApproximation.Pestov91.Kazhdan
import GroupApproximation.Meta.AxiomGuard

/-!
# `thm:main`, proof sketch: the property `(T)` ingredient

`simple_kazhdan_sofic_group.tex`, l.115–119:

> \emph{Property~(T).} The ring $\LC(X,\F_2)\rtimes_T\Z$ consists of the finite sums
> $\sum_jf_ju^j$ with $f_j\in\LC(X,\F_2)$, multiplied using $ufu^{-1}=f\circ T^{-1}$.
> It is finitely generated, so $G_X$ has Kazhdan's property~(T)~\cite{Kazhdan} by the theorem
> of Ershov and Jaikin-Zapirain~\cite{EJZ}.

The ring is `R S = ClopenCrossedProduct (subshiftHomeo S) (ZMod 2)` and `G S = EL_3(R S)`.

* `manuscriptSentence_ringFiniteSumsCovariance` (l.115–117): every element is a finite sum
  `∑ j ∈ J, f_j u^j`; the coefficients over a fixed exponent set are unique; `u f u⁻¹ = f ∘ T⁻¹`;
  and the resulting product rule `(f u^i)(f' u^j) = f (f' ∘ T^{-i}) u^{i+j}`.
* `manuscriptSentence_finitelyGeneratedSoPropertyT` (l.117–119): for a finite discrete alphabet,
  `R S` is finitely generated (`printedSubshiftRingFGStatement`, a closed theorem generated by
  `u^{±1}` and the letter indicators), hence `EL_3(R S)` has property `(T)` by the in-repo proof
  of the Ershov--Jaikin-Zapirain theorem `Pestov91.elementary_hasKazhdanPropertyT` (no literature
  hypothesis).
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace ThmMainB

open SymbolicDynamics.FullShift

/-- **tex l.115–117.** `LC(X, F₂) ⋊_T ℤ` consists of the finite sums `∑_j f_j u^j`
(with unique coefficients), multiplied using `u f u⁻¹ = f ∘ T⁻¹`. -/
theorem manuscriptSentence_ringFiniteSumsCovariance {A : Type} [TopologicalSpace A]
    (S : Subshift A ℤ) :
    (∀ x : ClopenCrossedProduct (subshiftHomeo S) (ZMod 2),
      ∃ (J : Finset ℤ) (f : ℤ → LocallyConstant S.carrier (ZMod 2)),
        x = ∑ j ∈ J, ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2) (f j) *
          ((ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2) ^ j :
            (ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))ˣ) :
              ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))) ∧
    (∀ (J : Finset ℤ) (f g : ℤ → LocallyConstant S.carrier (ZMod 2)),
      ∑ i ∈ J, ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2) (f i) *
          ((ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2) ^ i :
            (ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))ˣ) :
              ClopenCrossedProduct (subshiftHomeo S) (ZMod 2)) =
        ∑ i ∈ J, ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2) (g i) *
          ((ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2) ^ i :
            (ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))ˣ) :
              ClopenCrossedProduct (subshiftHomeo S) (ZMod 2)) →
      ∀ j ∈ J, f j = g j) ∧
    (∀ f : LocallyConstant S.carrier (ZMod 2),
      (ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2) :
          ClopenCrossedProduct (subshiftHomeo S) (ZMod 2)) *
          ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2) f *
          ↑(ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2))⁻¹ =
        ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2)
          (LocallyConstant.comap ⟨⇑(subshiftHomeo S).symm, (subshiftHomeo S).symm.continuous⟩ f)) ∧
    (∀ (f f' : LocallyConstant S.carrier (ZMod 2)) (i j : ℤ),
      ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2) f *
          ((ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2) ^ i :
            (ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))ˣ) :
              ClopenCrossedProduct (subshiftHomeo S) (ZMod 2)) *
        (ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2) f' *
          ((ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2) ^ j :
            (ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))ˣ) :
              ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))) =
      ClopenCrossedProduct.coeff (subshiftHomeo S) (ZMod 2)
          (f * LocallyConstant.comap
            ⟨⇑(subshiftHomeo S ^ (-i)), (subshiftHomeo S ^ (-i)).continuous⟩ f') *
        ((ClopenCrossedProduct.unit (subshiftHomeo S) (ZMod 2) ^ (i + j) :
          (ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))ˣ) :
            ClopenCrossedProduct (subshiftHomeo S) (ZMod 2))) :=
  ⟨ClopenCrossedProduct.exists_sum_coeff_mul_unit_zpow (subshiftHomeo S) (ZMod 2),
    SimpleKazhdanSofic.eq_of_sum_coeff_mul_unit_zpow_eq (subshiftHomeo S) (ZMod 2),
    ClopenCrossedProduct.unit_mul_coeff_mul_inv (subshiftHomeo S) (ZMod 2),
    SimpleKazhdanSofic.coeff_mul_unit_zpow_mul_coeff_mul_unit_zpow (subshiftHomeo S) (ZMod 2)⟩

/-- **tex l.117–119.** The ring `R S` is finitely generated, so `G_X = EL_3(R S)` has Kazhdan's
property `(T)` (Ershov--Jaikin-Zapirain, proved in this repository). -/
theorem manuscriptSentence_finitelyGeneratedSoPropertyT (A : Type) [TopologicalSpace A]
    [DiscreteTopology A] [Finite A] (S : Subshift A ℤ) :
    IsFinitelyGeneratedRing (R S) ∧ HasKazhdanPropertyT.{0, 0} (G S) :=
  ⟨printedSubshiftRingFGStatement A S,
    Pestov91.elementary_hasKazhdanPropertyT (printedSubshiftRingFGStatement A S) le_rfl⟩

end ThmMainB
end SimpleKazhdanSofic
end GroupApproximation

