import GroupApproximation.Manuscript.NonMFNotes.Full.TWWUCT.HKTCliffordSystem
import Mathlib.Analysis.CStarAlgebra.ContinuousMap
import Mathlib.Topology.Algebra.NonUnitalStarAlgebra
import Mathlib.Analysis.SpecialFunctions.Exp

/-!
# The Higson--Kasparov--Trout algebra `A(H)`

Lane TWWUCT-C (WO-TWWUCT-C).  Higson--Kasparov--Trout (Adv. Math. 135 (1998), §3--§4) define
`A(H)` as the direct limit over finite-dimensional affine subspaces `E = a + V ⊆ H` of
`𝒮 ⊗̂ C₀(E, Cliff(V))` along the Bott maps.  We realise the whole system inside one C⋆-algebra of
bounded continuous functions `ℝ × H →ᵇ C`, where `C` carries a covariant Clifford variable
(`CliffordSystem H C`).  The direct limit then becomes a closed union and needs no inductive
limit.

`𝒮` is generated by `e^{-x²}` and `x e^{-x²}`.  Their images in stage `E` are the functions of
the unbounded multiplier `X ⊗̂ 1 + 1 ⊗̂ C_{E⊥}`, multiplied by `1 ⊗̂ k` for
`k ∈ C₀(V, Cliff(V))` (HKT 1998, Def. 3.1 and 4.1, Bott map (3.3)).

* `FinDimAffine.evenGen E k (t, h) = e^{-(t² + ‖perp h‖²)} · k(foot h)`
* `FinDimAffine.oddGen E k (t, h) = e^{-(t² + ‖perp h‖²)} · c(t, perp h) · k(foot h)`

Both have sup norm at most `‖k‖`.  Restricted to `ℝ × E'` for `E ⊆ E'`, these are exactly the
Bott images of `e^{-x²} ⊗̂ k` and `x e^{-x²} ⊗̂ k` in stage `E'`.

* `hktStage E`: the ⋆-subalgebra generated by the stage-`E` generators.
* `hktSubalgebra H C`: the closure of the ⋆-subalgebra generated by all stages.
* `HKTAlgebraOf H C`: its carrier, a `NonUnitalCStarAlgebra`.
-/

namespace GroupApproximation.Full.TWWUCT

noncomputable section

universe v w

open Filter Topology

namespace FinDimAffine

variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable {C : Type w} [CStarAlgebra C] [CliffordSystem H C] (E : FinDimAffine H)

/-- The Gaussian profile `e^{-(t² + ‖perp h‖²)}` as a complex scalar. -/
def gaussian (x : ℝ × H) : ℂ :=
  ((Real.exp (-(E.radiusSq x)) : ℝ) : ℂ)

theorem radiusSq_nonneg (x : ℝ × H) : 0 ≤ E.radiusSq x :=
  add_nonneg (sq_nonneg _) (sq_nonneg _)

theorem continuous_gaussian : Continuous E.gaussian :=
  Complex.continuous_ofReal.comp (Real.continuous_exp.comp E.continuous_radiusSq.neg)

theorem norm_gaussian (x : ℝ × H) : ‖E.gaussian x‖ = Real.exp (-(E.radiusSq x)) :=
  Complex.norm_of_nonneg (Real.exp_pos _).le

/-- Values of `k` along the foot map. -/
theorem continuous_comp_foot (k : E.dir →ᵇ C) : Continuous fun x : ℝ × H => k (E.foot x.2) :=
  k.continuous.comp (E.continuous_foot.comp continuous_snd)

/-- The Clifford variable of the perpendicular part, `(t, h) ↦ c(t, perp h)`. -/
theorem continuous_clifford_perp :
    Continuous fun x : ℝ × H => (CliffordSystem.clifford (x.1, E.perp x.2) : C) :=
  (CliffordSystem.continuous_clifford (H := H) (C := C)).comp
    (continuous_fst.prodMk (E.continuous_perp.comp continuous_snd))

/-- The **even generator** `e^{-(t² + ‖perp h‖²)} k(foot h)`: the image of `e^{-x²} ⊗̂ k`. -/
def evenGen (k : E.dir →ᵇ C) : ℝ × H →ᵇ C :=
  BoundedContinuousFunction.ofNormedAddCommGroup
    (fun x : ℝ × H => E.gaussian x • k (E.foot x.2))
    (continuous_smul.comp (E.continuous_gaussian.prodMk (E.continuous_comp_foot k))) ‖k‖
    (fun x => by
      show ‖E.gaussian x • k (E.foot x.2)‖ ≤ ‖k‖
      rw [norm_smul, E.norm_gaussian]
      have he : Real.exp (-(E.radiusSq x)) ≤ 1 := exp_neg_le_one (E.radiusSq_nonneg x)
      exact (mul_le_of_le_one_left (norm_nonneg _) he).trans (k.norm_coe_le_norm _))

/-- The **odd generator** `e^{-(t² + ‖perp h‖²)} c(t, perp h) k(foot h)`: the image of
`x e^{-x²} ⊗̂ k`. -/
def oddGen (k : E.dir →ᵇ C) : ℝ × H →ᵇ C :=
  BoundedContinuousFunction.ofNormedAddCommGroup
    (fun x : ℝ × H =>
      E.gaussian x • ((CliffordSystem.clifford (x.1, E.perp x.2) : C) * k (E.foot x.2)))
    (continuous_smul.comp (E.continuous_gaussian.prodMk
      (continuous_mul.comp ((E.continuous_clifford_perp (C := C)).prodMk
        (E.continuous_comp_foot k))))) ‖k‖
    (fun x => by
      show ‖E.gaussian x • ((CliffordSystem.clifford (x.1, E.perp x.2) : C) *
        k (E.foot x.2))‖ ≤ ‖k‖
      rw [norm_smul, E.norm_gaussian]
      have hc : ‖(CliffordSystem.clifford (x.1, E.perp x.2) : C)‖ ≤ |x.1| + ‖E.perp x.2‖ :=
        CliffordSystem.norm_clifford_le (H := H) (C := C) (x.1, E.perp x.2)
      have hprod : ‖(CliffordSystem.clifford (x.1, E.perp x.2) : C) * k (E.foot x.2)‖ ≤
          (|x.1| + ‖E.perp x.2‖) * ‖k‖ :=
        (norm_mul_le _ _).trans
          ((mul_le_mul_of_nonneg_right hc (norm_nonneg _)).trans
            (mul_le_mul_of_nonneg_left (k.norm_coe_le_norm _)
              (add_nonneg (abs_nonneg _) (norm_nonneg _))))
      calc Real.exp (-(E.radiusSq x)) *
            ‖(CliffordSystem.clifford (x.1, E.perp x.2) : C) * k (E.foot x.2)‖
          ≤ Real.exp (-(E.radiusSq x)) * ((|x.1| + ‖E.perp x.2‖) * ‖k‖) :=
            mul_le_mul_of_nonneg_left hprod (Real.exp_pos _).le
        _ = (Real.exp (-(E.radiusSq x)) * (|x.1| + ‖E.perp x.2‖)) * ‖k‖ :=
            (mul_assoc _ _ _).symm
        _ ≤ 1 * ‖k‖ :=
            mul_le_mul_of_nonneg_right (exp_neg_mul_le_one x.1 ‖E.perp x.2‖) (norm_nonneg _)
        _ = ‖k‖ := one_mul _)

theorem evenGen_apply (k : E.dir →ᵇ C) (x : ℝ × H) :
    E.evenGen k x = E.gaussian x • k (E.foot x.2) :=
  rfl

theorem oddGen_apply (k : E.dir →ᵇ C) (x : ℝ × H) :
    E.oddGen k x =
      E.gaussian x • ((CliffordSystem.clifford (x.1, E.perp x.2) : C) * k (E.foot x.2)) :=
  rfl

theorem norm_evenGen_le (k : E.dir →ᵇ C) : ‖E.evenGen k‖ ≤ ‖k‖ :=
  BoundedContinuousFunction.norm_ofNormedAddCommGroup_le _ (norm_nonneg k) _

theorem norm_oddGen_le (k : E.dir →ᵇ C) : ‖E.oddGen k‖ ≤ ‖k‖ :=
  BoundedContinuousFunction.norm_ofNormedAddCommGroup_le _ (norm_nonneg k) _

/-- The admissible coefficients of stage `E`: `k ∈ C₀(V, Cliff(V))`. -/
def IsStageCoeff (k : E.dir →ᵇ C) : Prop :=
  Tendsto (fun v : E.dir => k v) (cocompact E.dir) (𝓝 0) ∧
    ∀ v : E.dir, k v ∈ CliffordSystem.cliffordSub (C := C) H E.dir

variable (C) in
/-- The generators of stage `E`: even and odd generators with coefficients in
`C₀(V, Cliff(V))`. -/
def stageGenerators : Set (ℝ × H →ᵇ C) :=
  {F | ∃ k : E.dir →ᵇ C, E.IsStageCoeff k ∧ (F = E.evenGen k ∨ F = E.oddGen k)}

theorem evenGen_mem_stageGenerators {k : E.dir →ᵇ C} (hk : E.IsStageCoeff k) :
    E.evenGen k ∈ E.stageGenerators C :=
  ⟨k, hk, Or.inl rfl⟩

theorem oddGen_mem_stageGenerators {k : E.dir →ᵇ C} (hk : E.IsStageCoeff k) :
    E.oddGen k ∈ E.stageGenerators C :=
  ⟨k, hk, Or.inr rfl⟩

end FinDimAffine

variable {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable {C : Type w} [CStarAlgebra C] [CliffordSystem H C]

variable (C) in
/-- The stage algebra of `E`, the image of `𝒮 ⊗̂ C₀(E, Cliff(V))`: the ⋆-subalgebra generated by the
stage generators (HKT 1998, Def. 3.1 and 4.1). -/
def hktStage (E : FinDimAffine H) : NonUnitalStarSubalgebra ℂ (ℝ × H →ᵇ C) :=
  NonUnitalStarAlgebra.adjoin ℂ (E.stageGenerators C)

theorem stageGenerators_subset_hktStage (E : FinDimAffine H) :
    E.stageGenerators C ⊆ hktStage C E :=
  NonUnitalStarAlgebra.subset_adjoin ℂ _

variable (H C) in
/-- **The Higson--Kasparov--Trout algebra** as a closed ⋆-subalgebra of `ℝ × H →ᵇ C`: the closure
of the union of all stages (HKT 1998, Def. 4.1). -/
def hktSubalgebra : NonUnitalStarSubalgebra ℂ (ℝ × H →ᵇ C) :=
  (NonUnitalStarAlgebra.adjoin ℂ (⋃ E : FinDimAffine H, E.stageGenerators C)).topologicalClosure

theorem stageGenerators_subset_hktSubalgebra (E : FinDimAffine H) :
    E.stageGenerators C ⊆ hktSubalgebra H C :=
  fun _ hF => NonUnitalStarSubalgebra.le_topologicalClosure _
    (NonUnitalStarAlgebra.subset_adjoin ℂ _ (Set.mem_iUnion.2 ⟨E, hF⟩))

theorem hktStage_le_hktSubalgebra (E : FinDimAffine H) : hktStage C E ≤ hktSubalgebra H C :=
  NonUnitalStarAlgebra.adjoin_le (stageGenerators_subset_hktSubalgebra E)

instance isClosed_hktSubalgebra : IsClosed (hktSubalgebra H C : Set (ℝ × H →ᵇ C)) :=
  NonUnitalStarSubalgebra.isClosed_topologicalClosure _

variable (H C) in
/-- The carrier of the Higson--Kasparov--Trout algebra `A(H)` built from the Clifford system
`C`. -/
abbrev HKTAlgebraOf :=
  ↥(hktSubalgebra H C)

noncomputable instance : NonUnitalCStarAlgebra (HKTAlgebraOf H C) :=
  NonUnitalStarSubalgebra.nonUnitalCStarAlgebra (hktSubalgebra H C)

end

end GroupApproximation.Full.TWWUCT
