import GroupApproximation.Manuscript.NonMFNotes.Full.TWWKK.Qalg
import GroupApproximation.Manuscript.NonMFNotes.Full.TWWKK.Stab
import GroupApproximation.Manuscript.NonMFNotes.Full.TWWKK.NonUnitalHomotopy
import Mathlib.SetTheory.Cardinal.Free
import Mathlib.Topology.Algebra.Module.Basic
import Mathlib.Topology.Algebra.NonUnitalStarAlgebra
import Mathlib.Topology.Metrizable.Basic

/-!
# Separability of `qA` and of `𝒦 ⊗ B`

Cuntz's picture of Kasparov theory (J. Cuntz, *A new look at KK-theory*, K-Theory 1 (1987)
31--51; Blackadar, *K-Theory for Operator Algebras*, 17.8) is formulated for *separable*
C⋆-algebras, and the stabilized algebras `𝒦 ⊗ qA` must again be separable in order to be
arguments of the `Ext` and `KKn` constructions.  This file proves:

* `isSeparable_nonUnitalStarAlgebra_adjoin`: in a C⋆-algebra, the non-unital `⋆`-subalgebra
  generated by a separable set is separable;
* `FreeProd.instSeparableSpaceFreeUnital`: the full free product `A * A` of a separable algebra
  is separable (it is the closure of the `⋆`-algebra generated by `1` and both copies of `A`);
* `Qalg.instSeparableSpace`: `qA ⊆ A * A` is separable;
* `Stab.instSeparableSpace`: `𝒦 ⊗ B` is separable when `B` is (it is the closure of the
  `⋆`-algebra generated by the countably many separable sets `e_{ij} ⊗ π(B)`).

Manuscript: `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`
(Tikuisis--White--Winter); lane TWWKK-StabQn, work order WO-3d3-3A-E3.
-/

namespace GroupApproximation.Full.TWWKK

open TopologicalSpace
open scoped Pointwise

universe u

noncomputable section

/-- **The non-unital `⋆`-subalgebra generated by a separable set is separable.** -/
theorem isSeparable_nonUnitalStarAlgebra_adjoin {D : Type*} [CStarAlgebra D] {s : Set D}
    (hs : IsSeparable s) :
    IsSeparable (NonUnitalStarAlgebra.adjoin ℂ s : Set D) := by
  obtain ⟨c, hc, hsc⟩ := hs
  let t : Set D := c ∪ star c
  have ht : t.Countable := by
    have hstar : (star c : Set D).Countable := by
      rw [← Set.image_star]
      exact hc.image _
    exact hc.union hstar
  have hmon : ((Submonoid.closure t : Submonoid D) : Set D).Countable := by
    letI : Countable ↑t := ht.to_subtype
    rw [Submonoid.closure_eq_mrange, MonoidHom.coe_mrange]
    exact Set.countable_range _
  have hle : Subsemigroup.closure t ≤ (Submonoid.closure t).toSubsemigroup :=
    Subsemigroup.closure_le.2 fun x hx => Submonoid.subset_closure hx
  have hsemi : ((Subsemigroup.closure t : Subsemigroup D) : Set D).Countable :=
    hmon.mono fun x hx => hle hx
  have hspan : IsSeparable
      ((Submodule.span ℂ ((Subsemigroup.closure t : Subsemigroup D) : Set D) :
        Submodule ℂ D) : Set D) :=
    hsemi.isSeparable.span
  have heq : (((NonUnitalStarAlgebra.adjoin ℂ c).toSubmodule : Submodule ℂ D) : Set D) =
      ((Submodule.span ℂ ((Subsemigroup.closure t : Subsemigroup D) : Set D) :
        Submodule ℂ D) : Set D) :=
    congrArg (fun M : Submodule ℂ D => (M : Set D))
      (NonUnitalStarAlgebra.adjoin_eq_span (R := ℂ) c)
  have hT : IsSeparable (NonUnitalStarAlgebra.adjoin ℂ c : Set D) := by
    have h := hspan
    rw [← heq] at h
    exact h
  have hsub : (NonUnitalStarAlgebra.adjoin ℂ s : Set D) ⊆
      closure (NonUnitalStarAlgebra.adjoin ℂ c : Set D) := by
    have hle' : NonUnitalStarAlgebra.adjoin ℂ s ≤
        (NonUnitalStarAlgebra.adjoin ℂ c).topologicalClosure :=
      NonUnitalStarAlgebra.adjoin_le
        (hsc.trans (closure_mono (NonUnitalStarAlgebra.subset_adjoin ℂ c)))
    exact fun x hx => hle' hx
  exact (isSeparable_closure.2 hT).mono hsub

/-! ## The free product and `qA` -/

namespace FreeProd

variable {A : Type u} [NonUnitalCStarAlgebra A]

/-- The generating set `{1} ∪ ι(A) ∪ ῑ(A)` of `A * A`. -/
def genSet (A : Type u) [NonUnitalCStarAlgebra A] : Set (FreeUnital A) :=
  ({1} ∪ Set.range (ι₁ A)) ∪ Set.range (ι₂ A)

/-- Every element of `A * A` lies in the closure of the `⋆`-algebra generated by `genSet A`. -/
theorem mem_topologicalClosure_adjoin_genSet (x : FreeUnital A) :
    x ∈ (NonUnitalStarAlgebra.adjoin ℂ (genSet A)).topologicalClosure := by
  refine FreeProd.induction
    (p := fun y => y ∈ (NonUnitalStarAlgebra.adjoin ℂ (genSet A)).topologicalClosure)
    ((NonUnitalStarAlgebra.adjoin ℂ (genSet A)).isClosed_topologicalClosure)
    ?_ ?_ ?_ ?_ ?_ ?_ ?_ x
  · exact (NonUnitalStarAlgebra.adjoin ℂ (genSet A)).le_topologicalClosure
      (NonUnitalStarAlgebra.subset_adjoin ℂ (genSet A)
        (Set.mem_union_left _ (Set.mem_union_left _ (Set.mem_singleton 1))))
  · intro a
    exact (NonUnitalStarAlgebra.adjoin ℂ (genSet A)).le_topologicalClosure
      (NonUnitalStarAlgebra.subset_adjoin ℂ (genSet A)
        (Set.mem_union_left _ (Set.mem_union_right _ (Set.mem_range_self a))))
  · intro a
    exact (NonUnitalStarAlgebra.adjoin ℂ (genSet A)).le_topologicalClosure
      (NonUnitalStarAlgebra.subset_adjoin ℂ (genSet A)
        (Set.mem_union_right _ (Set.mem_range_self a)))
  · intro y z hy hz
    exact add_mem hy hz
  · intro y z hy hz
    exact mul_mem hy hz
  · intro c y hy
    exact SMulMemClass.smul_mem c hy
  · intro y hy
    exact star_mem hy

/-- **`A * A` is separable when `A` is.** -/
instance instSeparableSpaceFreeUnital [SeparableSpace A] : SeparableSpace (FreeUnital A) := by
  have hgen : IsSeparable (genSet A) :=
    ((Set.countable_singleton (1 : FreeUnital A)).isSeparable.union
      (isSeparable_range (continuous_nonUnitalStarAlgHom (ι₁ A)))).union
      (isSeparable_range (continuous_nonUnitalStarAlgHom (ι₂ A)))
  have hcl : IsSeparable
      (closure (NonUnitalStarAlgebra.adjoin ℂ (genSet A) : Set (FreeUnital A))) :=
    isSeparable_closure.2 (isSeparable_nonUnitalStarAlgebra_adjoin hgen)
  have huniv : IsSeparable (Set.univ : Set (FreeUnital A)) :=
    hcl.mono fun x _ => mem_topologicalClosure_adjoin_genSet x
  exact isSeparable_univ_iff.1 huniv

end FreeProd

namespace Qalg

variable {A : Type u} [NonUnitalCStarAlgebra A]

/-- **`qA` is separable when `A` is.** -/
instance instSeparableSpace [SeparableSpace A] : SeparableSpace (Qalg A) := by
  have hcl : IsSeparable (Qalg.ideal A : Set (FreeProd.FreeUnital A)) :=
    IsSeparable.of_separableSpace _
  exact hcl.separableSpace

end Qalg

/-! ## The stabilization -/

namespace Stab

variable {B : Type u} [NonUnitalCStarAlgebra B]

/-- `b ↦ e_{ij} ⊗ π(b)` is continuous. -/
theorem continuous_matUnit_rep (i j : ℕ) :
    Continuous fun b : B => matUnit B i j (rep B b) := by
  show Continuous fun b : B => (inj B i).comp ((rep B b).comp (proj B j))
  exact continuous_const.clm_comp
    ((continuous_nonUnitalStarAlgHom (rep B)).clm_comp continuous_const)

/-- The generators `e_{ij} ⊗ π(b)` of `𝒦 ⊗ B` form a separable set. -/
theorem isSeparable_generators [SeparableSpace B] : IsSeparable (generators B) := by
  have hU : IsSeparable
      (⋃ i : ℕ, ⋃ j : ℕ, Set.range fun b : B => matUnit B i j (rep B b)) :=
    IsSeparable.iUnion fun i => IsSeparable.iUnion fun j =>
      isSeparable_range (continuous_matUnit_rep i j)
  refine hU.mono ?_
  rintro x ⟨i, j, b, hx⟩
  exact Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨j, Set.mem_range.2 ⟨b, hx.symm⟩⟩⟩

/-- The closed subalgebra `𝒦 ⊗ B ⊆ B(ℓ²(ℕ, H_B))` is a separable set. -/
theorem isSeparable_closedSubalgebra [SeparableSpace B] :
    IsSeparable (closedSubalgebra B : Set (Ambient B)) := by
  have h : IsSeparable (closure (finiteMatrices B : Set (Ambient B))) :=
    isSeparable_closure.2 (isSeparable_nonUnitalStarAlgebra_adjoin isSeparable_generators)
  exact h

/-- **`𝒦 ⊗ B` is separable when `B` is.** -/
instance instSeparableSpace [SeparableSpace B] : SeparableSpace (Stab B) :=
  (isSeparable_closedSubalgebra (B := B)).separableSpace

end Stab

end

end GroupApproximation.Full.TWWKK
