import Mathlib.Algebra.Star.StarProjection
import Mathlib.Algebra.Star.SelfAdjoint
import Mathlib.Algebra.Ring.Commute
import Mathlib.Tactic.NoncommRing

/-!
# Ring identities behind the index of `qℂ`

The ring-level half of the computation `KK(ℂ, ℂ) = ℤ` in Cuntz's picture of Kasparov theory
(J. Cuntz, *A new look at KK-theory*, K-Theory 1 (1987), Prop. 1.6 and §2; Blackadar,
*K-Theory for Operator Algebras*, 17.3).  The algebra `qℂ` is generated by two projections
`p`, `q` (the two copies of `1`) with `p - q` in the ideal.  Writing `d = p - q`, `x = d²` and
`Y = x (2p - 1) - d`, one has the classical two-projection relations

* `x` commutes with `p` and `q`, `p d + d p = x + d`;
* `p Y + Y p = Y` and `Y² = x - x²`.

These are the relations used to rotate `q` onto `p` along a reparametrisation of the spectrum of
`x`: if `y`, `k` commute with `p`, `Y` and with each other and `k² Y² = y - y²`, then
`p - (y (2p - 1) - k Y)` is again a projection (`qIdx_proj_mul_self`,
`qIdx_isStarProjection`).  With `y = 1`, `k = 0` on the spectrum this is the element `q` itself;
the index of `qℂ` is read off after such a rotation.

All proofs are explicit combinations of the hypotheses, checked by `noncomm_ring`.

Manuscript: `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`
(lane TWWKK-C234, work order WO-TWWKK-C3: the index `HomotopyClass (Qalg ℂ) (Stab ℂ) ≃ ℤ`).
-/

namespace GroupApproximation.Full.TWWKK

section RingIdentities

variable {R : Type*} [Ring R]

/-- The abstract square identity: if `s² = 1`, `x` commutes with `s` and `d`, `s d + d s = 2x`
and `d² = x`, then `(x s - d)² = x - x²`.  (Cuntz 1987 §2, the rotation of `qℂ`;
`non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_sq_of_rel {x s d : R} (hs : s * s = 1) (hxs : s * x = x * s)
    (hdx : d * x = x * d) (hsd : s * d + d * s = x + x) (hdd : d * d = x) :
    (x * s - d) * (x * s - d) = x - x * x := by
  have e : (x * s - d) * (x * s - d) - (x - x * x) =
      x * (s * x - x * s) * s - (d * x - x * d) * s + (d * d - x) + x * x * (s * s - 1)
        - x * (s * d + d * s - (x + x)) := by noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr hs, sub_eq_zero.mpr hxs, sub_eq_zero.mpr hdx, sub_eq_zero.mpr hsd,
    sub_eq_zero.mpr hdd]
  noncomm_ring

/-- **Rotated projection.**  If `p` is idempotent, `p Y + Y p = Y`, the elements `y`, `k` commute
with `p`, `Y` and with each other, and `k² Y² = y - y²`, then `p - (y (2p - 1) - k Y)` is
idempotent.  (Cuntz 1987 §2, the reparametrisation of `qℂ`; `non_mf_group_notes.tex`, UCT
hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_proj_mul_self {p Y y k : R} (h1 : p * p = p) (h2 : p * Y + Y * p = Y)
    (h3 : y * p = p * y) (h4 : y * Y = Y * y) (h5 : k * p = p * k) (h6 : k * Y = Y * k)
    (h7 : k * y = y * k) (h8 : k * k * (Y * Y) = y - y * y) :
    (p - (y * (p + p - 1) - k * Y)) * (p - (y * (p + p - 1) - k * Y)) =
      p - (y * (p + p - 1) - k * Y) := by
  have e : (p - (y * (p + p - 1) - k * Y)) * (p - (y * (p + p - 1) - k * Y)) -
      (p - (y * (p + p - 1) - k * Y)) =
      (p * p - p) + 2 * ((y * p - p * y) * p) - (y * p - p * y) - (k * p - p * k) * Y
        - 4 * (y * (p * p - p)) - 4 * (y * (y * p - p * y) * p) + 2 * (y * (y * p - p * y))
        + 2 * (y * (k * p - p * k) * Y) + k * (p * Y + Y * p - Y)
        + 2 * (k * (y * Y - Y * y) * p) - k * (y * Y - Y * y) - k * (k * Y - Y * k) * Y
        + 4 * (y * y * (p * p - p)) - 2 * (k * y * (p * Y + Y * p - Y)) - (k * y - y * k) * Y
        + (k * k * (Y * Y) - (y - y * y)) + 2 * ((k * y - y * k) * p * Y) := by
    noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr h1, sub_eq_zero.mpr h2, sub_eq_zero.mpr h3, sub_eq_zero.mpr h4,
    sub_eq_zero.mpr h5, sub_eq_zero.mpr h6, sub_eq_zero.mpr h7, sub_eq_zero.mpr h8]
  noncomm_ring

variable {p q : R}

/-- For idempotents `p`, `q`, the element `(p - q)²` commutes with `p`.
(Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_sq_mul_left (hp : p * p = p) (hq : q * q = q) :
    (p - q) * (p - q) * p = p * ((p - q) * (p - q)) := by
  have e : (p - q) * (p - q) * p - p * ((p - q) * (p - q)) =
      -q * (p * p - p) + (q * q - q) * p + (p * p - p) * q - p * (q * q - q) := by
    noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr hp, sub_eq_zero.mpr hq]
  noncomm_ring

/-- For idempotents `p`, `q`, the element `(p - q)²` commutes with `q`.
(Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_sq_mul_right (hp : p * p = p) (hq : q * q = q) :
    (p - q) * (p - q) * q = q * ((p - q) * (p - q)) := by
  have e : (p - q) * (p - q) * q - q * ((p - q) * (p - q)) =
      (p * p - p) * q - p * (q * q - q) - q * (p * p - p) + (q * q - q) * p := by
    noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr hp, sub_eq_zero.mpr hq]
  noncomm_ring

/-- For idempotents `p`, `q` and `d = p - q`: `p d + d p = d² + d`.
(Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_anticomm (hp : p * p = p) (hq : q * q = q) :
    p * (p - q) + (p - q) * p = (p - q) * (p - q) + (p - q) := by
  have e : p * (p - q) + (p - q) * p - ((p - q) * (p - q) + (p - q)) =
      (p * p - p) - (q * q - q) := by
    noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr hp, sub_eq_zero.mpr hq, sub_zero]

/-- For an idempotent `p`, the symmetry `2p - 1` squares to `1`.
(Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_symm_mul_self (hp : p * p = p) : (p + p - 1) * (p + p - 1) = 1 := by
  have e : (p + p - 1) * (p + p - 1) - 1 = 4 * (p * p - p) := by noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr hp, mul_zero]

/-- For idempotents `p`, `q`, the symmetry `2p - 1` commutes with `(p - q)²`.
(Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_symm_comm (hp : p * p = p) (hq : q * q = q) :
    (p + p - 1) * ((p - q) * (p - q)) = (p - q) * (p - q) * (p + p - 1) := by
  have e : (p + p - 1) * ((p - q) * (p - q)) - (p - q) * (p - q) * (p + p - 1) =
      -2 * ((p - q) * (p - q) * p - p * ((p - q) * (p - q))) := by
    noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr (qIdx_sq_mul_left hp hq), mul_zero]

/-- For idempotents `p`, `q`: `(2p - 1) d + d (2p - 1) = 2 d²` with `d = p - q`.
(Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_symm_anticomm (hp : p * p = p) (hq : q * q = q) :
    (p + p - 1) * (p - q) + (p - q) * (p + p - 1) =
      (p - q) * (p - q) + (p - q) * (p - q) := by
  have e : (p + p - 1) * (p - q) + (p - q) * (p + p - 1) -
      ((p - q) * (p - q) + (p - q) * (p - q)) = 2 * ((p * p - p) - (q * q - q)) := by
    noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr hp, sub_eq_zero.mpr hq, sub_zero, mul_zero]

/-- For idempotents `p`, `q` and `Y = (p - q)² (2p - 1) - (p - q)`: `p Y + Y p = Y`.
(Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_Y_anticomm (hp : p * p = p) (hq : q * q = q) :
    p * ((p - q) * (p - q) * (p + p - 1) - (p - q)) +
        ((p - q) * (p - q) * (p + p - 1) - (p - q)) * p =
      (p - q) * (p - q) * (p + p - 1) - (p - q) := by
  have e : p * ((p - q) * (p - q) * (p + p - 1) - (p - q)) +
        ((p - q) * (p - q) * (p + p - 1) - (p - q)) * p -
      ((p - q) * (p - q) * (p + p - 1) - (p - q)) =
      4 * ((p * p - p) * p * p) - 2 * ((p * p - p) * q * p) + (p * p - p) * q
        - 4 * (p * q * (p * p - p)) + 2 * (p * (q * q - q) * p) - p * (q * q - q)
        - (p * p - p) - 2 * (q * (p * p - p) * p) + q * (p * p - p)
        + 2 * (q * q * (p * p - p)) - (q * q - q) * p + (q * q - q) := by
    noncomm_ring
  refine sub_eq_zero.mp (e.trans ?_)
  rw [sub_eq_zero.mpr hp, sub_eq_zero.mpr hq]
  noncomm_ring

/-- For idempotents `p`, `q` and `Y = (p - q)² (2p - 1) - (p - q)`: `Y² = x - x²` with
`x = (p - q)²`.  (Cuntz 1987 §2; `non_mf_group_notes.tex`, UCT hypothesis of
`thm:fixed-radical-membership`.) -/
theorem qIdx_Y_mul_self (hp : p * p = p) (hq : q * q = q) :
    ((p - q) * (p - q) * (p + p - 1) - (p - q)) *
        ((p - q) * (p - q) * (p + p - 1) - (p - q)) =
      (p - q) * (p - q) - (p - q) * (p - q) * ((p - q) * (p - q)) :=
  qIdx_sq_of_rel (x := (p - q) * (p - q)) (s := p + p - 1) (d := p - q)
    (qIdx_symm_mul_self hp) (qIdx_symm_comm hp hq) (mul_assoc (p - q) (p - q) (p - q)).symm
    (qIdx_symm_anticomm hp hq) rfl

end RingIdentities

section StarIdentities

variable {R : Type*} [Ring R] [StarRing R]

/-- **Rotated star projection.**  The self-adjoint version of `qIdx_proj_mul_self`: for a star
projection `p` and self-adjoint `Y`, `y`, `k` satisfying the relations there,
`p - (y (2p - 1) - k Y)` is a star projection.  (Cuntz 1987 §2; Blackadar 17.3;
`non_mf_group_notes.tex`, UCT hypothesis of `thm:fixed-radical-membership`.) -/
theorem qIdx_isStarProjection {p Y y k : R} (hp : IsStarProjection p) (hY : IsSelfAdjoint Y)
    (hy : IsSelfAdjoint y) (hk : IsSelfAdjoint k) (h2 : p * Y + Y * p = Y)
    (h3 : Commute y p) (h4 : Commute y Y) (h5 : Commute k p) (h6 : Commute k Y)
    (h7 : Commute k y) (h8 : k * k * (Y * Y) = y - y * y) :
    IsStarProjection (p - (y * (p + p - 1) - k * Y)) where
  isIdempotentElem :=
    qIdx_proj_mul_self hp.isIdempotentElem h2 h3.eq h4.eq h5.eq h6.eq h7.eq h8
  isSelfAdjoint := by
    have hs : IsSelfAdjoint (p + p - 1) :=
      (hp.isSelfAdjoint.add hp.isSelfAdjoint).sub (IsSelfAdjoint.one R)
    have hys : Commute y (p + p - 1) := (h3.add_right h3).sub_right (Commute.one_right y)
    exact hp.isSelfAdjoint.sub (((hy.commute_iff hs).mp hys).sub ((hk.commute_iff hY).mp h6))

end StarIdentities

end GroupApproximation.Full.TWWKK
