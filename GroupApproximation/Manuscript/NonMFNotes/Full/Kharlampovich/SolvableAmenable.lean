import GroupApproximation.Algebra.AmenableConstructions
import Mathlib.GroupTheory.Solvable

/-!
# Solvable groups are amenable

Input for `thm:fixed-radical-membership` of `non_mf_group_notes.tex`: the printed
route uses Kharlampovich's finitely presented solvable group with undecidable word
problem, and needs that group to be amenable.  This file proves, unconditionally,
that every solvable group carries an invariant mean.

* commutative groups: each finitely generated subgroup is an image of an iterated
  semidirect product of cyclic groups, and the group is their directed union;
* solvable groups: induction along the derived series, using the extension theorem
  `Amenability.hasInvariantMean_of_extension`.
-/

namespace GroupApproximation.Full.Kharlampovich

open scoped commutatorElement

/-- The multiplication map `closure S ⋊ ⟨g⟩ → A` in a commutative group, with the
trivial action. -/
def closureZpowersHom {A : Type} [Group A] (hcomm : ∀ a b : A, a * b = b * a)
    (N : Subgroup A) (g : A) : ↥N ⋊[1] ↥(Subgroup.zpowers g) →* A :=
  SemidirectProduct.lift N.subtype (Subgroup.zpowers g).subtype fun h ↦ by
    ext n
    show (n : A) = (h : A) * (n : A) * (h : A)⁻¹
    rw [hcomm (h : A) (n : A), mul_inv_cancel_right]

theorem closureZpowersHom_apply {A : Type} [Group A] (hcomm : ∀ a b : A, a * b = b * a)
    (N : Subgroup A) (g : A) (x : ↥N ⋊[1] ↥(Subgroup.zpowers g)) :
    closureZpowersHom hcomm N g x = (x.left : A) * (x.right : A) :=
  rfl

/-- In a commutative group, the subgroup generated by a finite set carries an
invariant mean. -/
theorem hasInvariantMean_closure_finset {A : Type} [Group A]
    (hcomm : ∀ a b : A, a * b = b * a) (S : Finset A) :
    Amenability.HasInvariantMean (Subgroup.closure (S : Set A)) := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    refine Amenability.hasInvariantMean_of_surjective
      (1 : Multiplicative ℤ →* Subgroup.closure ((∅ : Finset A) : Set A)) ?_
      Amenability.hasInvariantMean_int
    rintro ⟨x, hx⟩
    have hx1 : x = 1 := by
      rw [Finset.coe_empty, Subgroup.closure_empty, Subgroup.mem_bot] at hx
      exact hx
    refine ⟨1, Subtype.ext ?_⟩
    show (1 : A) = x
    exact hx1.symm
  | insert g S _ ih =>
    have hmean : Amenability.HasInvariantMean
        (↥(Subgroup.closure (S : Set A)) ⋊[1] ↥(Subgroup.zpowers g)) :=
      Amenability.hasInvariantMean_semidirectProduct ih
        (Amenability.hasInvariantMean_zpowers g)
    have hrange : Amenability.HasInvariantMean
        (closureZpowersHom hcomm (Subgroup.closure (S : Set A)) g).range :=
      Amenability.hasInvariantMean_of_surjective
        (closureZpowersHom hcomm (Subgroup.closure (S : Set A)) g).rangeRestrict
        (MonoidHom.rangeRestrict_surjective _) hmean
    have hSsub : Subgroup.closure (S : Set A) ≤
        Subgroup.closure ((insert g S : Finset A) : Set A) :=
      Subgroup.closure_mono (Finset.coe_subset.mpr (Finset.subset_insert g S))
    have hgmem : g ∈ Subgroup.closure ((insert g S : Finset A) : Set A) :=
      Subgroup.subset_closure (Finset.mem_coe.mpr (Finset.mem_insert_self g S))
    have hZsub : Subgroup.zpowers g ≤
        Subgroup.closure ((insert g S : Finset A) : Set A) :=
      Subgroup.zpowers_le.mpr hgmem
    have heq : Subgroup.closure ((insert g S : Finset A) : Set A) =
        (closureZpowersHom hcomm (Subgroup.closure (S : Set A)) g).range := by
      refine le_antisymm ?_ ?_
      · rw [Subgroup.closure_le]
        intro y hy
        rcases Finset.mem_insert.mp (Finset.mem_coe.mp hy) with hyg | hyS
        · refine MonoidHom.mem_range.mpr ⟨⟨1, ⟨g, Subgroup.mem_zpowers g⟩⟩, ?_⟩
          rw [closureZpowersHom_apply, hyg]
          exact one_mul g
        · refine MonoidHom.mem_range.mpr
            ⟨⟨⟨y, Subgroup.subset_closure (Finset.mem_coe.mpr hyS)⟩, 1⟩, ?_⟩
          rw [closureZpowersHom_apply]
          exact mul_one y
      · intro y hy
        obtain ⟨x, rfl⟩ := MonoidHom.mem_range.mp hy
        rw [closureZpowersHom_apply]
        exact Subgroup.mul_mem _ (hSsub x.left.2) (hZsub x.right.2)
    exact Amenability.hasInvariantMean_congr (MulEquiv.subgroupCongr heq) hrange

/-- **Commutative groups are amenable** (mean formulation). -/
theorem hasInvariantMean_of_comm {A : Type} [Group A]
    (hcomm : ∀ a b : A, a * b = b * a) : Amenability.HasInvariantMean A := by
  classical
  exact Amenability.hasInvariantMean_of_directed
    (K := fun S : Finset A ↦ Subgroup.closure (S : Set A))
    (fun S ↦ (hasInvariantMean_closure_finset hcomm S).some) ⟨∅⟩
    (fun S T hST ↦ Subgroup.closure_mono (Finset.coe_subset.mpr hST))
    (fun g ↦ ⟨{g}, Subgroup.subset_closure (by simp)⟩)

/-- A group whose `n`-th derived subgroup is trivial carries an invariant mean. -/
theorem hasInvariantMean_of_derivedSeries_eq_bot (n : ℕ) :
    ∀ (G : Type) [Group G], derivedSeries G n = ⊥ → Amenability.HasInvariantMean G := by
  induction n with
  | zero =>
    intro G _ h
    refine Amenability.hasInvariantMean_of_surjective (1 : Multiplicative ℤ →* G) ?_
      Amenability.hasInvariantMean_int
    intro x
    have hx : x ∈ (⊥ : Subgroup G) := by
      rw [← h, derivedSeries_zero]
      exact Subgroup.mem_top x
    exact ⟨1, (MonoidHom.one_apply (M := Multiplicative ℤ) (N := G) 1).trans
      (Subgroup.mem_bot.mp hx).symm⟩
  | succ n ih =>
    intro G _ h
    haveI : (derivedSeries G n).Normal := derivedSeries_normal G n
    refine Amenability.hasInvariantMean_of_extension (derivedSeries G n) ?_ ?_
    · refine hasInvariantMean_of_comm ?_
      intro a b
      have hab : ⁅(a : G), (b : G)⁆ ∈ ⁅derivedSeries G n, derivedSeries G n⁆ :=
        Subgroup.commutator_mem_commutator a.2 b.2
      rw [← derivedSeries_succ, h, Subgroup.mem_bot,
        commutatorElement_eq_one_iff_mul_comm] at hab
      exact Subtype.ext hab
    · refine ih (G ⧸ derivedSeries G n) ?_
      rw [← map_derivedSeries_eq (QuotientGroup.mk'_surjective (derivedSeries G n)) n]
      exact (Subgroup.map_eq_bot_iff _).mpr (QuotientGroup.ker_mk' (derivedSeries G n)).ge

/-- **Solvable groups carry invariant means.** -/
theorem hasInvariantMean_of_isSolvable (G : Type) [Group G] [IsSolvable G] :
    Amenability.HasInvariantMean G := by
  obtain ⟨n, hn⟩ := IsSolvable.solvable (G := G)
  exact hasInvariantMean_of_derivedSeries_eq_bot n G hn

/-- **Solvable groups are amenable.** -/
theorem isAmenable_of_isSolvable (G : Type) [Group G] [IsSolvable G] :
    Amenability.IsAmenable G :=
  Amenability.isAmenable_of_hasInvariantMean (hasInvariantMean_of_isSolvable G)

end GroupApproximation.Full.Kharlampovich
