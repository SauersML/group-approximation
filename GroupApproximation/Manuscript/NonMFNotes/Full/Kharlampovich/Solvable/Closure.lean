import GroupApproximation.Manuscript.NonMFNotes.Full.Kharlampovich.Solvable.BRFamily

/-!
# Generic subgroup-closure lemmas for the solvability of `G(M)`

Input for `thm:fixed-radical-membership` of `non_mf_group_notes.tex` (Kharlampovich--Myasnikov--
Sapir, arXiv:1204.6506, Sec. 4).  Three facts about a group `G`:

* `exists_mul_of_mem_closure_union`: if `s` and `t` commute elementwise, every element of
  `⟨s ∪ t⟩` is `y * z` with `y ∈ ⟨s⟩`, `z ∈ ⟨t⟩`;
* `conj_mem_closure`: if conjugation by the letters of `s` (both ways) maps `u` into `⟨u⟩`, then
  conjugation by `⟨s⟩` preserves `⟨u⟩`;
* `exists_dec` / `conj_eq_of_dec`: in the abelian group generated by commuting letters `s`, if each
  letter splits as `c * h` with `c` commuting with `X` and `h ∈ Z`, then so does every element, and
  hence `X^g = X^h` for some `h ∈ ⟨s⟩ ∩ Z`.
-/

namespace GroupApproximation.Full.Kharlampovich

namespace KMS

namespace Sol

variable {G : Type*} [Group G]

theorem conj_eq_self_of_commute {c X : G} (h : Commute c X) : c⁻¹ * X * c = X := by
  rw [mul_assoc, ← h.eq, inv_mul_cancel_left]

/-- `[X^u, Y^v] = 1` follows from `[X^{u v⁻¹}, Y] = 1`. -/
theorem commute_conj_of_commute {a b u v : G}
    (h : Commute ((u * v⁻¹)⁻¹ * a * (u * v⁻¹)) b) :
    Commute (u⁻¹ * a * u) (v⁻¹ * b * v) := by
  have h' := BR.commute_conj h v
  have e : v⁻¹ * ((u * v⁻¹)⁻¹ * a * (u * v⁻¹)) * v = u⁻¹ * a * u := by group
  rwa [e] at h'

/-- Elements of `⟨s ∪ t⟩` split as `y * z` when `s` and `t` commute elementwise. -/
theorem exists_mul_of_mem_closure_union {s t : Set G}
    (h : ∀ x ∈ s, ∀ y ∈ t, Commute x y) {x : G} (hx : x ∈ Subgroup.closure (s ∪ t)) :
    ∃ y z : G, y ∈ Subgroup.closure s ∧ z ∈ Subgroup.closure t ∧ x = y * z := by
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with hx | hx
    · exact ⟨x, 1, Subgroup.subset_closure hx, one_mem _, (mul_one x).symm⟩
    · exact ⟨1, x, one_mem _, Subgroup.subset_closure hx, (one_mul x).symm⟩
  | one => exact ⟨1, 1, one_mem _, one_mem _, (mul_one 1).symm⟩
  | mul x x' _ _ ih ih' =>
    obtain ⟨y, z, hy, hz, rfl⟩ := ih
    obtain ⟨y', z', hy', hz', rfl⟩ := ih'
    have hc : Commute y' z := BR.commute_of_mem_closure h hy' hz
    refine ⟨y * y', z * z', mul_mem hy hy', mul_mem hz hz', ?_⟩
    calc y * z * (y' * z') = y * (z * y') * z' := by group
      _ = y * (y' * z) * z' := by rw [← hc.eq]
      _ = y * y' * (z * z') := by group
  | inv x _ ih =>
    obtain ⟨y, z, hy, hz, rfl⟩ := ih
    have hc : Commute y z := BR.commute_of_mem_closure h hy hz
    refine ⟨y⁻¹, z⁻¹, inv_mem hy, inv_mem hz, ?_⟩
    rw [mul_inv_rev, hc.inv_inv.eq]

/-- Conjugation by a single element mapping `u` into `⟨u⟩` preserves `⟨u⟩`. -/
theorem conj_mem_closure_of_forall {u : Set G} {x : G}
    (h : ∀ y ∈ u, x⁻¹ * y * x ∈ Subgroup.closure u) {y : G} (hy : y ∈ Subgroup.closure u) :
    x⁻¹ * y * x ∈ Subgroup.closure u := by
  induction hy using Subgroup.closure_induction with
  | mem y hy => exact h y hy
  | one =>
    rw [mul_one, inv_mul_cancel]
    exact one_mem _
  | mul y y' _ _ h₁ h₂ =>
    have e : x⁻¹ * (y * y') * x = x⁻¹ * y * x * (x⁻¹ * y' * x) := by group
    rw [e]
    exact mul_mem h₁ h₂
  | inv y _ h₁ =>
    have e : x⁻¹ * y⁻¹ * x = (x⁻¹ * y * x)⁻¹ := by group
    rw [e]
    exact inv_mem h₁

theorem conj_mem_closure_aux {s u : Set G}
    (h : ∀ x ∈ s, ∀ y ∈ u,
      x⁻¹ * y * x ∈ Subgroup.closure u ∧ x * y * x⁻¹ ∈ Subgroup.closure u)
    {z : G} (hz : z ∈ Subgroup.closure s) :
    ∀ y ∈ Subgroup.closure u,
      z⁻¹ * y * z ∈ Subgroup.closure u ∧ z * y * z⁻¹ ∈ Subgroup.closure u := by
  induction hz using Subgroup.closure_induction with
  | mem x hx =>
    intro y hy
    refine ⟨conj_mem_closure_of_forall (fun y hy => (h x hx y hy).1) hy, ?_⟩
    have h' := conj_mem_closure_of_forall (x := x⁻¹)
      (fun y hy => by rw [inv_inv]; exact (h x hx y hy).2) hy
    rwa [inv_inv] at h'
  | one =>
    intro y hy
    exact ⟨by simpa using hy, by simpa using hy⟩
  | mul z z' _ _ ih ih' =>
    intro y hy
    have e₁ : (z * z')⁻¹ * y * (z * z') = z'⁻¹ * (z⁻¹ * y * z) * z' := by group
    have e₂ : z * z' * y * (z * z')⁻¹ = z * (z' * y * z'⁻¹) * z⁻¹ := by group
    rw [e₁, e₂]
    exact ⟨(ih' _ (ih y hy).1).1, (ih _ (ih' y hy).2).2⟩
  | inv z _ ih =>
    intro y hy
    rw [inv_inv]
    exact ⟨(ih y hy).2, (ih y hy).1⟩

/-- Conjugation by `⟨s⟩` preserves `⟨u⟩` when conjugation by the letters of `s` does. -/
theorem conj_mem_closure {s u : Set G}
    (h : ∀ x ∈ s, ∀ y ∈ u,
      x⁻¹ * y * x ∈ Subgroup.closure u ∧ x * y * x⁻¹ ∈ Subgroup.closure u)
    {z : G} (hz : z ∈ Subgroup.closure s) {y : G} (hy : y ∈ Subgroup.closure u) :
    z⁻¹ * y * z ∈ Subgroup.closure u :=
  (conj_mem_closure_aux h hz y hy).1

/-- The splitting `g = c * h` (`[c, X] = 1`, `h ∈ Z`) extends from commuting letters to `⟨s⟩`. -/
theorem exists_dec {s : Set G} (hs : ∀ x ∈ s, ∀ y ∈ s, Commute x y) (X : G) (Z : Subgroup G)
    (hdec : ∀ x ∈ s, ∃ c h : G, c ∈ Subgroup.closure s ∧ h ∈ Subgroup.closure s ∧
      Commute c X ∧ h ∈ Z ∧ x = c * h)
    {g : G} (hg : g ∈ Subgroup.closure s) :
    ∃ c h : G, c ∈ Subgroup.closure s ∧ h ∈ Subgroup.closure s ∧
      Commute c X ∧ h ∈ Z ∧ g = c * h := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact hdec x hx
  | one => exact ⟨1, 1, one_mem _, one_mem _, Commute.one_left X, one_mem _, (mul_one 1).symm⟩
  | mul g g' _ _ ih ih' =>
    obtain ⟨c, h, hc, hh, hcX, hZ, rfl⟩ := ih
    obtain ⟨c', h', hc', hh', hcX', hZ', rfl⟩ := ih'
    have hk : Commute c' h := BR.commute_of_mem_closure hs hc' hh
    refine ⟨c * c', h * h', mul_mem hc hc', mul_mem hh hh', hcX.mul_left hcX',
      mul_mem hZ hZ', ?_⟩
    calc c * h * (c' * h') = c * (h * c') * h' := by group
      _ = c * (c' * h) * h' := by rw [← hk.eq]
      _ = c * c' * (h * h') := by group
  | inv g _ ih =>
    obtain ⟨c, h, hc, hh, hcX, hZ, rfl⟩ := ih
    have hk : Commute c h := BR.commute_of_mem_closure hs hc hh
    refine ⟨c⁻¹, h⁻¹, inv_mem hc, inv_mem hh, hcX.inv_left, inv_mem hZ, ?_⟩
    rw [mul_inv_rev, hk.inv_inv.eq]

/-- `X^g = X^h` for some `h ∈ ⟨s⟩ ∩ Z`. -/
theorem conj_eq_of_dec {s : Set G} (hs : ∀ x ∈ s, ∀ y ∈ s, Commute x y) (X : G)
    (Z : Subgroup G)
    (hdec : ∀ x ∈ s, ∃ c h : G, c ∈ Subgroup.closure s ∧ h ∈ Subgroup.closure s ∧
      Commute c X ∧ h ∈ Z ∧ x = c * h)
    {g : G} (hg : g ∈ Subgroup.closure s) :
    ∃ h : G, h ∈ Subgroup.closure s ∧ h ∈ Z ∧ g⁻¹ * X * g = h⁻¹ * X * h := by
  obtain ⟨c, h, _, hh, hcX, hZ, rfl⟩ := exists_dec hs X Z hdec hg
  refine ⟨h, hh, hZ, ?_⟩
  have e : (c * h)⁻¹ * X * (c * h) = h⁻¹ * (c⁻¹ * X * c) * h := by group
  rw [e, conj_eq_self_of_commute hcX]

end Sol

end KMS

end GroupApproximation.Full.Kharlampovich
