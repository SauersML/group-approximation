import GroupApproximation.Manuscript.NonMFNotes.Full.Kharlampovich.Solvable.QuotientRels
import GroupApproximation.Manuscript.NonMFNotes.Full.Kharlampovich.Solvable.BRMulti

/-!
# The conjugates `A_i^c` pairwise commute

Input for `thm:fixed-radical-membership` of `non_mf_group_notes.tex`
(Kharlampovich--Myasnikov--Sapir, arXiv:1204.6506, Sec. 4, Lemma `lH`, `p = 2`).

For a block `M_i` let `wSet M i` be the set of conjugates `c⁻¹ A_i c` with `c` in the subgroup
generated by the small letters of `M_i`.  All elements of `wAll M = ⋃_i wSet M i` pairwise
commute (`wAll_commute`):
* for different blocks by G2 (letters of different blocks commute);
* for the block `M_{n+1} = {a_n, a'_n, A_{n+1}}` by Lemma `lBRG` (`BR.conj_commute`) and G3;
* for the block `M_0 = {ã_i, ã'_i, A_0}` by the multi-variable Lemma `lBRG`
  (`BR.multi_commute`) and G4.
-/

namespace GroupApproximation.Full.Kharlampovich
namespace KMS
namespace QS

open Forward

variable {K N : ℕ} (M : Minsky.Machine K N)

/-- The small letters of the block `M_i`. -/
def smallSet (i : Fin (K + 1)) : Set (KhGroup M) :=
  {g | ∃ s : KhGen K N, s.IsSmall ∧ s.block = some i ∧ g = kLet M s}

/-- All letters of the block `M_i`. -/
def blockSet (i : Fin (K + 1)) : Set (KhGroup M) :=
  {g | ∃ s : KhGen K N, s.block = some i ∧ g = kLet M s}

/-- The conjugates `A_i^c`, `c` generated by the small letters of `M_i`. -/
def wSet (i : Fin (K + 1)) : Set (KhGroup M) :=
  {w | ∃ c ∈ Subgroup.closure (smallSet M i), w = c⁻¹ * kLet M (.bigA i) * c}

/-- The union of the `wSet M i`. -/
def wAll : Set (KhGroup M) := {w | ∃ i, w ∈ wSet M i}

/-- Every small letter lies in some block. -/
theorem exists_block_of_isSmall {s : KhGen K N} (hs : s.IsSmall) : ∃ i, s.block = some i := by
  cases s with
  | x _ _ => exact False.elim hs
  | bigA _ => exact False.elim hs
  | a n => exact ⟨n.succ, rfl⟩
  | a' n => exact ⟨n.succ, rfl⟩
  | ta _ => exact ⟨0, rfl⟩
  | ta' _ => exact ⟨0, rfl⟩

theorem bigA_mem_wSet (i : Fin (K + 1)) : kLet M (.bigA i) ∈ wSet M i :=
  ⟨1, one_mem _, by rw [inv_one, one_mul, mul_one]⟩

theorem smallSet_subset_blockSet (i : Fin (K + 1)) : smallSet M i ⊆ blockSet M i := by
  rintro _ ⟨s, _, hb, rfl⟩
  exact ⟨s, hb, rfl⟩

/-- The small letters of `M_{n+1}` are `a_n` and `a'_n`. -/
theorem smallSet_succ (n : Fin K) :
    ∀ g ∈ smallSet M n.succ, g = kLet M (.a n) ∨ g = kLet M (.a' n) := by
  rintro _ ⟨s, hs, hb, rfl⟩
  cases s with
  | x _ _ => exact False.elim hs
  | bigA _ => exact False.elim hs
  | a m =>
    have h1 : some m.succ = some n.succ := hb
    obtain rfl := Fin.succ_inj.mp (Option.some_inj.mp h1)
    exact Or.inl rfl
  | a' m =>
    have h1 : some m.succ = some n.succ := hb
    obtain rfl := Fin.succ_inj.mp (Option.some_inj.mp h1)
    exact Or.inr rfl
  | ta _ =>
    have h1 : some (0 : Fin (K + 1)) = some n.succ := hb
    exact absurd (Option.some_inj.mp h1).symm (Fin.succ_ne_zero n)
  | ta' _ =>
    have h1 : some (0 : Fin (K + 1)) = some n.succ := hb
    exact absurd (Option.some_inj.mp h1).symm (Fin.succ_ne_zero n)

/-- The small letters of `M_0` are the `ã_n` and `ã'_n`. -/
theorem smallSet_zero :
    smallSet M 0 ⊆ Set.range (fun n => kLet M (.ta n)) ∪ Set.range (fun n => kLet M (.ta' n)) := by
  rintro _ ⟨s, hs, hb, rfl⟩
  cases s with
  | x _ _ => exact False.elim hs
  | bigA _ => exact False.elim hs
  | a m =>
    have h1 : some m.succ = some (0 : Fin (K + 1)) := hb
    exact absurd (Option.some_inj.mp h1) (Fin.succ_ne_zero m)
  | a' m =>
    have h1 : some m.succ = some (0 : Fin (K + 1)) := hb
    exact absurd (Option.some_inj.mp h1) (Fin.succ_ne_zero m)
  | ta m => exact Set.mem_union_left _ ⟨m, rfl⟩
  | ta' m => exact Set.mem_union_right _ ⟨m, rfl⟩

/-- An element of `wSet M i` is generated by the letters of `M_i`. -/
theorem mem_closure_blockSet_of_mem_wSet {i : Fin (K + 1)} {w : KhGroup M}
    (hw : w ∈ wSet M i) : w ∈ Subgroup.closure (blockSet M i) := by
  obtain ⟨c, hc, rfl⟩ := hw
  have hc' : c ∈ Subgroup.closure (blockSet M i) :=
    Subgroup.closure_mono (smallSet_subset_blockSet M i) hc
  have hA : kLet M (.bigA i) ∈ Subgroup.closure (blockSet M i) :=
    Subgroup.subset_closure ⟨.bigA i, rfl, rfl⟩
  exact mul_mem (mul_mem (inv_mem hc') hA) hc'

/-- Elements of `wSet`s of different blocks commute (G2). -/
theorem wSet_commute_of_ne {i k : Fin (K + 1)} (hik : i ≠ k) {w w' : KhGroup M}
    (hw : w ∈ wSet M i) (hw' : w' ∈ wSet M k) : Commute w w' := by
  refine BR.commute_of_mem_closure ?_ (mem_closure_blockSet_of_mem_wSet M hw)
    (mem_closure_blockSet_of_mem_wSet M hw')
  rintro _ ⟨s, hs, rfl⟩ _ ⟨t, ht, rfl⟩
  exact commute_kLet_of_mem M (block_mem_relators M hs ht hik)

/-- Elements of `wSet M n.succ` commute (Lemma `lBRG` with G3). -/
theorem wSet_succ_commute (n : Fin K) {w w' : KhGroup M} (hw : w ∈ wSet M n.succ)
    (hw' : w' ∈ wSet M n.succ) : Commute w w' := by
  obtain ⟨c, hc, rfl⟩ := hw
  obtain ⟨c', hc', rfl⟩ := hw'
  obtain ⟨p, q, rfl⟩ := exists_zpow_of_mem_closure (commute_a_a' M n n) (smallSet_succ M n) hc
  obtain ⟨p', q', rfl⟩ :=
    exists_zpow_of_mem_closure (commute_a_a' M n n) (smallSet_succ M n) hc'
  exact BR.conj_commute (fun _ : Unit => kLet M (.bigA n.succ)) (kLet M (.a n))
    (kLet M (.a' n)) (fun _ _ => Commute.refl _) (fun _ _ => g3_comm M n)
    (commute_a_a' M n n) (fun _ => g3_conj M n) () () p q p' q'

/-- Elements of `wSet M 0` commute (multi-variable Lemma `lBRG` with G4). -/
theorem wSet_zero_commute {w w' : KhGroup M} (hw : w ∈ wSet M 0) (hw' : w' ∈ wSet M 0) :
    Commute w w' := by
  obtain ⟨c, hc, rfl⟩ := hw
  obtain ⟨c', hc', rfl⟩ := hw'
  obtain ⟨β, γ, rfl⟩ := BR.exists_pw_of_mem_closure (fun n => kLet M (.ta n))
    (fun n => kLet M (.ta' n)) (commute_t M) (Subgroup.closure_mono (smallSet_zero M) hc)
  obtain ⟨β', γ', rfl⟩ := BR.exists_pw_of_mem_closure (fun n => kLet M (.ta n))
    (fun n => kLet M (.ta' n)) (commute_t M) (Subgroup.closure_mono (smallSet_zero M) hc')
  exact BR.multi_commute (fun n => kLet M (.ta n)) (fun n => kLet M (.ta' n))
    (fun _ : Unit => kLet M (.bigA 0)) (commute_t M) (fun _ n => Or.inl (g4_conj M n))
    (fun _ _ b hb => g4_base M b hb) () () β γ β' γ'

/-- **The conjugates `A_i^c` pairwise commute.** -/
theorem wAll_commute {w w' : KhGroup M} (hw : w ∈ wAll M) (hw' : w' ∈ wAll M) :
    Commute w w' := by
  obtain ⟨i, hi⟩ := hw
  obtain ⟨k, hk⟩ := hw'
  by_cases hik : i = k
  · rw [← hik] at hk
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨n, rfl⟩
    · exact wSet_zero_commute M hi hk
    · exact wSet_succ_commute M n hi hk
  · exact wSet_commute_of_ne M hik hi hk

end QS
end KMS
end GroupApproximation.Full.Kharlampovich
