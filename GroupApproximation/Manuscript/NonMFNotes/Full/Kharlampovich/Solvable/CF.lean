import GroupApproximation.Manuscript.NonMFNotes.Full.Kharlampovich.Solvable.Swap

/-!
# The subgroups `C` and `F` of `G(M)`

Input for `thm:fixed-radical-membership` of `non_mf_group_notes.tex` (Kharlampovich--Myasnikov--
Sapir, arXiv:1204.6506, Sec. 4, proof of Lemma `lT`).  With `H_s` the group of small letters:

* `C` is generated by the `x_{j,S}^g`, `g ∈ H_s`, `S` without letters `A_{n+1}`.  It is invariant
  under conjugation by the block-`0` letters `ã_n, ã'_n, A_0` (`conj_mem_C`).
* `F` is generated by the `x_{j,S}^g`, `g ∈ H_s`, `0 ∉ S`.  It is invariant under conjugation by
  the letters `a_n, a'_n, A_{m+1}` of the positive blocks (`conj_mem_F`).
* `C` and `F` commute elementwise (`commute_C_F`): by `conj_C` and `commute_conj_aSub`.
-/

namespace GroupApproximation.Full.Kharlampovich

namespace KMS

namespace Sol

open Forward

variable {K N : ℕ} (M : Minsky.Machine K N)

/-- The conjugates `x_{j,S}^g`, `g ∈ H_s`, `S` subject to `P`. -/
def xGen (P : Finset (Fin (K + 1)) → Prop) : Set (KhGroup M) :=
  {y | ∃ (j : Fin (N + 1)) (S : Finset (Fin (K + 1))) (g : KhGroup M), P S ∧
    g ∈ Subgroup.closure (smallSet M) ∧ y = g⁻¹ * kLet M (.x j S) * g}

/-- The condition "no letter `A_{n+1}`" defining `C`. -/
def PC (S : Finset (Fin (K + 1))) : Prop := ∀ n : Fin K, n.succ ∉ S

/-- The condition "`A_0 ∉ S`" defining `F`. -/
def PF (S : Finset (Fin (K + 1))) : Prop := (0 : Fin (K + 1)) ∉ S

/-- Block-`0` letters `ã_n, ã'_n, A_0`. -/
def s0 : Set (KhGroup M) := {g | ∃ s : KhGen K N, s.block = some 0 ∧ g = kLet M s}

/-- Letters `a_n, a'_n, A_{m+1}` of positive blocks. -/
def sPlus : Set (KhGroup M) :=
  {g | ∃ (s : KhGen K N) (m : Fin K), s.block = some m.succ ∧ g = kLet M s}

theorem xGen_mem (P : Finset (Fin (K + 1)) → Prop) (j : Fin (N + 1))
    {S : Finset (Fin (K + 1))} (hS : P S) {g : KhGroup M}
    (hg : g ∈ Subgroup.closure (smallSet M)) :
    g⁻¹ * kLet M (.x j S) * g ∈ Subgroup.closure (xGen M P) :=
  Subgroup.subset_closure ⟨j, S, g, hS, hg, rfl⟩

theorem x_mem_xGen (P : Finset (Fin (K + 1)) → Prop) (j : Fin (N + 1))
    {S : Finset (Fin (K + 1))} (hS : P S) :
    kLet M (.x j S) ∈ Subgroup.closure (xGen M P) := by
  have h := xGen_mem M P j hS (one_mem _)
  rwa [inv_one, one_mul, mul_one] at h

/-- Conjugation by an element of `H_s` preserves the generators. -/
theorem xGen_conj_small (P : Finset (Fin (K + 1)) → Prop) {x : KhGroup M}
    (hx : x ∈ Subgroup.closure (smallSet M)) {y : KhGroup M} (hy : y ∈ xGen M P) :
    x⁻¹ * y * x ∈ Subgroup.closure (xGen M P) ∧
      x * y * x⁻¹ ∈ Subgroup.closure (xGen M P) := by
  obtain ⟨j, S, g, hS, hg, rfl⟩ := hy
  have e₁ : x⁻¹ * (g⁻¹ * kLet M (.x j S) * g) * x = (g * x)⁻¹ * kLet M (.x j S) * (g * x) := by
    group
  have e₂ : x * (g⁻¹ * kLet M (.x j S) * g) * x⁻¹ =
      (g * x⁻¹)⁻¹ * kLet M (.x j S) * (g * x⁻¹) := by
    group
  rw [e₁, e₂]
  exact ⟨xGen_mem M P j hS (mul_mem hg hx), xGen_mem M P j hS (mul_mem hg (inv_mem hx))⟩

/-- `A_i x_{j,S} A_i = x_{j,S}` for `i ∈ S` (G5 c), G1). -/
theorem bigA_x_bigA_of_mem (j : Fin (N + 1)) {S : Finset (Fin (K + 1))} {i : Fin (K + 1)}
    (hi : i ∈ S) : kLet M (.bigA i) * kLet M (.x j S) * kLet M (.bigA i) = kLet M (.x j S) := by
  rw [← (commute_x_block M j (s := .bigA i) hi rfl).eq, mul_assoc, bigA_mul_self, mul_one]

/-- `A_i x_{j,S} A_i = x_{j,S} x_{j,S ∪ {i}}` for `i ∉ S` (G5 a), G1). -/
theorem bigA_x_bigA_of_not_mem (j : Fin (N + 1)) {S : Finset (Fin (K + 1))} {i : Fin (K + 1)}
    (hi : i ∉ S) : kLet M (.bigA i) * kLet M (.x j S) * kLet M (.bigA i) =
      kLet M (.x j S) * kLet M (.x j (insert i S)) := by
  rw [x_insert M j S hi, bigA_inv]
  group

theorem conj_comm_eq {A p X : KhGroup M} (hc : Commute A p) :
    A * (p⁻¹ * X * p) * A = p⁻¹ * (A * X * A) * p := by
  have h1 : A * p⁻¹ = p⁻¹ * A := hc.inv_right.eq
  have h2 : p * A = A * p := hc.eq.symm
  calc A * (p⁻¹ * X * p) * A = A * p⁻¹ * X * (p * A) := by group
    _ = p⁻¹ * A * X * (A * p) := by rw [h1, h2]
    _ = p⁻¹ * (A * X * A) * p := by group

/-- `A_i` is an involution, so conjugating by it either way is `A_i * y * A_i`. -/
theorem bigA_conj_both {Q : Subgroup (KhGroup M)} (i : Fin (K + 1)) {y : KhGroup M}
    (h : kLet M (.bigA i) * y * kLet M (.bigA i) ∈ Q) :
    (kLet M (.bigA i))⁻¹ * y * kLet M (.bigA i) ∈ Q ∧
      kLet M (.bigA i) * y * (kLet M (.bigA i))⁻¹ ∈ Q := by
  rw [bigA_inv]
  exact ⟨h, h⟩

/-- The `A_i`-conjugate of a generator `p⁻¹ x_{j,S} p` with `[A_i, p] = 1`. -/
theorem bigA_conj_gen (P : Finset (Fin (K + 1)) → Prop) (j : Fin (N + 1))
    {S : Finset (Fin (K + 1))} (hS : P S) {i : Fin (K + 1)} (hiS : i ∉ S → P (insert i S))
    {p : KhGroup M} (hp : p ∈ Subgroup.closure (smallSet M)) (hc : Commute (kLet M (.bigA i)) p) :
    kLet M (.bigA i) * (p⁻¹ * kLet M (.x j S) * p) * kLet M (.bigA i) ∈
      Subgroup.closure (xGen M P) := by
  rw [conj_comm_eq M hc]
  by_cases hi : i ∈ S
  · rw [bigA_x_bigA_of_mem M j hi]
    exact xGen_mem M P j hS hp
  · rw [bigA_x_bigA_of_not_mem M j hi]
    have e : p⁻¹ * (kLet M (.x j S) * kLet M (.x j (insert i S))) * p =
        p⁻¹ * kLet M (.x j S) * p * (p⁻¹ * kLet M (.x j (insert i S)) * p) := by group
    rw [e]
    exact mul_mem (xGen_mem M P j hS hp) (xGen_mem M P j (hiS hi) hp)

theorem commute_bigA0_of_mem_aSub {p : KhGroup M} (hp : p ∈ aSub M) :
    Commute (kLet M (.bigA 0)) p := by
  refine BR.commute_of_mem_closure (k₁ := {kLet M (.bigA 0)}) ?_
    (Subgroup.subset_closure (Set.mem_singleton _)) hp
  intro x hx y hy
  rw [Set.mem_singleton_iff.mp hx]
  rcases hy with ⟨n, rfl⟩ | ⟨n, rfl⟩
  · exact commute_block M (s := .bigA 0) (t := .a n) rfl rfl (Fin.succ_ne_zero n).symm
  · exact commute_block M (s := .bigA 0) (t := .a' n) rfl rfl (Fin.succ_ne_zero n).symm

theorem pc_insert_zero {S : Finset (Fin (K + 1))} (hS : PC S) : PC (insert 0 S) := by
  intro n hn
  rcases Finset.mem_insert.mp hn with h | h
  · exact Fin.succ_ne_zero n h
  · exact hS n h

theorem pf_insert_succ {S : Finset (Fin (K + 1))} (hS : PF S) (m : Fin K) :
    PF (insert m.succ S) := by
  intro h
  rcases Finset.mem_insert.mp h with h | h
  · exact Fin.succ_ne_zero m h.symm
  · exact hS h

/-- Conjugating a generator of `C` by a block-`0` letter stays in `C` (G5 a), G5 c)). -/
theorem s0_conj {x : KhGroup M} (hx : x ∈ s0 M) {y : KhGroup M} (hy : y ∈ xGen M PC) :
    x⁻¹ * y * x ∈ Subgroup.closure (xGen M PC) ∧
      x * y * x⁻¹ ∈ Subgroup.closure (xGen M PC) := by
  obtain ⟨s, hs, rfl⟩ := hx
  cases s with
  | x _ _ => simp [KhGen.block] at hs
  | bigA i =>
    have hi : i = 0 := Option.some.inj hs
    subst hi
    obtain ⟨j, S, g, hS, hg, rfl⟩ := hy
    obtain ⟨p, hp, hpa, e⟩ := conj_C M j hS hg
    rw [e]
    exact bigA_conj_both M 0 (bigA_conj_gen M PC j hS (fun _ => pc_insert_zero hS) hp
      (commute_bigA0_of_mem_aSub M hpa))
  | a n => exact absurd (Option.some.inj hs) (Fin.succ_ne_zero n)
  | a' n => exact absurd (Option.some.inj hs) (Fin.succ_ne_zero n)
  | ta n => exact xGen_conj_small M PC (small_mem M (s := .ta n) trivial) hy
  | ta' n => exact xGen_conj_small M PC (small_mem M (s := .ta' n) trivial) hy

/-- Conjugating a generator of `F` by a positive-block letter stays in `F`. -/
theorem sPlus_conj {x : KhGroup M} (hx : x ∈ sPlus M) {y : KhGroup M} (hy : y ∈ xGen M PF) :
    x⁻¹ * y * x ∈ Subgroup.closure (xGen M PF) ∧
      x * y * x⁻¹ ∈ Subgroup.closure (xGen M PF) := by
  obtain ⟨s, m, hs, rfl⟩ := hx
  cases s with
  | x _ _ => simp [KhGen.block] at hs
  | bigA i =>
    have hi : i = m.succ := Option.some.inj hs
    subst hi
    obtain ⟨j, S, g, hS, hg, rfl⟩ := hy
    obtain ⟨h, hh, hhc, e⟩ := conj_F M j hS hg
    rw [e]
    exact bigA_conj_both M m.succ (bigA_conj_gen M PF j hS (fun _ => pf_insert_succ hS m) hh
      (commute_of_mem_centA M hhc m))
  | a n => exact xGen_conj_small M PF (small_mem M (s := .a n) trivial) hy
  | a' n => exact xGen_conj_small M PF (small_mem M (s := .a' n) trivial) hy
  | ta _ => exact absurd (Option.some.inj hs) (Fin.succ_ne_zero m).symm
  | ta' _ => exact absurd (Option.some.inj hs) (Fin.succ_ne_zero m).symm

theorem conj_mem_C {z : KhGroup M} (hz : z ∈ Subgroup.closure (s0 M)) {y : KhGroup M}
    (hy : y ∈ Subgroup.closure (xGen M PC)) : z⁻¹ * y * z ∈ Subgroup.closure (xGen M PC) :=
  conj_mem_closure (fun _ hx _ hy => s0_conj M hx hy) hz hy

theorem conj_mem_F {z : KhGroup M} (hz : z ∈ Subgroup.closure (sPlus M)) {y : KhGroup M}
    (hy : y ∈ Subgroup.closure (xGen M PF)) : z⁻¹ * y * z ∈ Subgroup.closure (xGen M PF) :=
  conj_mem_closure (fun _ hx _ hy => sPlus_conj M hx hy) hz hy

/-- Generators of `C` and `F` commute: `conj_C` reduces to `commute_conj_aSub`. -/
theorem commute_xGen {y y' : KhGroup M} (hy : y ∈ xGen M PC) (hy' : y' ∈ xGen M PF) :
    Commute y y' := by
  obtain ⟨j, S, g, hS, hg, rfl⟩ := hy
  obtain ⟨j', S', g', -, hg', rfl⟩ := hy'
  refine commute_conj_of_commute ?_
  obtain ⟨p, -, hpa, e⟩ := conj_C M j hS (mul_mem hg (inv_mem hg'))
  rw [e]
  have h := commute_conj_aSub M hpa (one_mem (aSub M)) j j' S S'
  rwa [inv_one, one_mul, mul_one] at h

theorem commute_C_F {c f : KhGroup M} (hc : c ∈ Subgroup.closure (xGen M PC))
    (hf : f ∈ Subgroup.closure (xGen M PF)) : Commute c f :=
  BR.commute_of_mem_closure (fun _ hy _ hy' => commute_xGen M hy hy') hc hf

end Sol

end KMS

end GroupApproximation.Full.Kharlampovich
