import Mathlib.Algebra.Group.Commute.Basic
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Logic.Function.Basic

/-!
# Products `a_1^{β_1} a_1'^{γ_1} ⋯ a_K^{β_K} a_K'^{γ_K}` of commuting letters

Bookkeeping for the multi-variable Baumslag--Remeslennikov lemma (KMS, arXiv:1204.6506,
Sec. 4, Lemma lBRG): `BR.pw a a' β γ` is the ordered product of the `a n ^ β n * a' n ^ γ n`.
When all the letters commute, these products form a group under pointwise addition of
exponents, and every element of the subgroup generated by the letters is such a product.
-/

namespace GroupApproximation.Full.Kharlampovich
namespace KMS
namespace BR

variable {G : Type*} [Group G] {K : ℕ}

/-- The ordered product `∏_{n ∈ L} c n`, as a left fold. -/
def lprod (c : Fin K → G) (L : List (Fin K)) : G :=
  List.foldl (fun h n => h * c n) 1 L

theorem foldl_mul_eq (c : Fin K → G) (L : List (Fin K)) (g : G) :
    List.foldl (fun h n => h * c n) g L = g * lprod c L := by
  induction L generalizing g with
  | nil => simp only [lprod, List.foldl_nil, mul_one]
  | cons n L ih =>
    simp only [lprod, List.foldl_cons]
    rw [ih (g * c n), ih (1 * c n), one_mul, mul_assoc]

theorem lprod_nil (c : Fin K → G) : lprod c [] = 1 := rfl

theorem lprod_cons (c : Fin K → G) (n : Fin K) (L : List (Fin K)) :
    lprod c (n :: L) = c n * lprod c L := by
  simp only [lprod, List.foldl_cons]
  rw [foldl_mul_eq, one_mul]

theorem lprod_congr {c d : Fin K → G} (h : ∀ n, c n = d n) (L : List (Fin K)) :
    lprod c L = lprod d L := by
  rw [show c = d from funext h]

theorem commute_lprod {x : G} {c : Fin K → G} (L : List (Fin K))
    (h : ∀ n ∈ L, Commute x (c n)) : Commute x (lprod c L) := by
  induction L with
  | nil => exact Commute.one_right x
  | cons n L ih =>
    rw [lprod_cons]
    exact (h n List.mem_cons_self).mul_right
      (ih fun m hm => h m (List.mem_cons_of_mem n hm))

theorem lprod_eq_one {c : Fin K → G} (L : List (Fin K)) (h : ∀ n ∈ L, c n = 1) :
    lprod c L = 1 := by
  induction L with
  | nil => rfl
  | cons n L ih =>
    rw [lprod_cons, h n List.mem_cons_self, one_mul]
    exact ih fun m hm => h m (List.mem_cons_of_mem n hm)

theorem lprod_single {c : Fin K → G} (m : Fin K) (L : List (Fin K)) (hL : L.Nodup)
    (hm : m ∈ L) (h : ∀ n, n ≠ m → c n = 1) : lprod c L = c m := by
  induction L with
  | nil => exact absurd hm List.not_mem_nil
  | cons n L ih =>
    rw [lprod_cons]
    obtain ⟨hn, hL'⟩ := List.nodup_cons.mp hL
    by_cases hnm : n = m
    · subst hnm
      rw [lprod_eq_one L fun k hk => h k fun hk' => hn (hk' ▸ hk), mul_one]
    · rw [h n hnm, one_mul]
      exact ih hL' ((List.mem_cons.mp hm).resolve_left fun e => hnm e.symm)

theorem lprod_mul {c d : Fin K → G} (hcd : ∀ n m, Commute (d n) (c m)) (L : List (Fin K)) :
    lprod c L * lprod d L = lprod (fun n => c n * d n) L := by
  induction L with
  | nil => simp only [lprod_nil, mul_one]
  | cons n L ih =>
    rw [lprod_cons, lprod_cons, lprod_cons, ← ih]
    have hP : Commute (lprod c L) (d n) :=
      (commute_lprod L fun m _ => hcd n m).symm
    calc c n * lprod c L * (d n * lprod d L) = c n * (lprod c L * d n) * lprod d L := by
          simp only [mul_assoc]
      _ = c n * (d n * lprod c L) * lprod d L := by rw [hP.eq]
      _ = c n * d n * (lprod c L * lprod d L) := by simp only [mul_assoc]

theorem lprod_inv {c : Fin K → G} (hc : ∀ n m, Commute (c n) (c m)) (L : List (Fin K)) :
    (lprod c L)⁻¹ = lprod (fun n => (c n)⁻¹) L := by
  induction L with
  | nil => simp only [lprod_nil, inv_one]
  | cons n L ih =>
    rw [lprod_cons, lprod_cons, mul_inv_rev, ← ih]
    exact ((commute_lprod L fun m _ => hc n m).symm).inv_inv.eq

variable (a a' : Fin K → G)

/-- The factor `a n ^ β n * a' n ^ γ n`. -/
def fac (β γ : Fin K → ℤ) (n : Fin K) : G := a n ^ β n * a' n ^ γ n

/-- `a_1^{β_1} a_1'^{γ_1} ⋯ a_K^{β_K} a_K'^{γ_K}`. -/
def pw (β γ : Fin K → ℤ) : G := lprod (fac a a' β γ) (List.finRange K)

theorem pw_eq_foldl (β γ : Fin K → ℤ) :
    pw a a' β γ = List.foldl (fun h n => h * (a n ^ β n * a' n ^ γ n)) 1 (List.finRange K) :=
  rfl

theorem fac_commute (hl : ∀ n m,
      Commute (a n) (a m) ∧ Commute (a n) (a' m) ∧ Commute (a' n) (a' m))
    (β γ β' γ' : Fin K → ℤ) (n m : Fin K) :
    Commute (fac a a' β γ n) (fac a a' β' γ' m) :=
  (((hl n m).1.zpow_zpow _ _).mul_right ((hl n m).2.1.zpow_zpow _ _)).mul_left
    (((hl m n).2.1.symm.zpow_zpow _ _).mul_right ((hl n m).2.2.zpow_zpow _ _))

theorem pw_zero : pw a a' 0 0 = 1 :=
  lprod_eq_one _ fun n _ => by simp only [fac, Pi.zero_apply, zpow_zero, mul_one]

theorem pw_mul (hl : ∀ n m,
      Commute (a n) (a m) ∧ Commute (a n) (a' m) ∧ Commute (a' n) (a' m))
    (β γ β' γ' : Fin K → ℤ) :
    pw a a' β γ * pw a a' β' γ' = pw a a' (β + β') (γ + γ') := by
  rw [pw, pw, pw, lprod_mul (fun n m => fac_commute a a' hl β' γ' β γ n m)]
  refine lprod_congr (fun n => ?_) _
  have h : Commute (a' n ^ γ n) (a n ^ β' n) := (hl n n).2.1.symm.zpow_zpow _ _
  simp only [fac, Pi.add_apply, zpow_add]
  calc a n ^ β n * a' n ^ γ n * (a n ^ β' n * a' n ^ γ' n)
        = a n ^ β n * (a' n ^ γ n * a n ^ β' n) * a' n ^ γ' n := by simp only [mul_assoc]
    _ = a n ^ β n * (a n ^ β' n * a' n ^ γ n) * a' n ^ γ' n := by rw [h.eq]
    _ = a n ^ β n * a n ^ β' n * (a' n ^ γ n * a' n ^ γ' n) := by simp only [mul_assoc]

theorem pw_inv (hl : ∀ n m,
      Commute (a n) (a m) ∧ Commute (a n) (a' m) ∧ Commute (a' n) (a' m))
    (β γ : Fin K → ℤ) : (pw a a' β γ)⁻¹ = pw a a' (-β) (-γ) := by
  rw [pw, pw, lprod_inv (fun n m => fac_commute a a' hl β γ β γ n m)]
  refine lprod_congr (fun n => ?_) _
  simp only [fac, Pi.neg_apply, zpow_neg, mul_inv_rev]
  exact ((hl n n).2.1.zpow_zpow (β n) (γ n)).inv_inv.symm.eq

theorem commute_pw {x : G} (hx : ∀ n, Commute x (a n) ∧ Commute x (a' n))
    (β γ : Fin K → ℤ) :
    Commute x (pw a a' β γ) :=
  commute_lprod _ fun n _ => ((hx n).1.zpow_right _).mul_right ((hx n).2.zpow_right _)

theorem pw_single (m : Fin K) (p q : ℤ) :
    pw a a' (Function.update (0 : Fin K → ℤ) m p) (Function.update (0 : Fin K → ℤ) m q)
      = a m ^ p * a' m ^ q := by
  rw [pw, lprod_single m _ (List.nodup_finRange K) (List.mem_finRange m)]
  · simp only [fac, Function.update_self]
  · intro n hn
    simp only [fac, Function.update_of_ne hn, Pi.zero_apply, zpow_zero, mul_one]

/-- Splitting off coordinate `m`. -/
theorem pw_update (hl : ∀ n m,
      Commute (a n) (a m) ∧ Commute (a n) (a' m) ∧ Commute (a' n) (a' m))
    (β γ : Fin K → ℤ) (m : Fin K) (p q : ℤ) :
    pw a a' (Function.update β m p) (Function.update γ m q)
      = pw a a' (Function.update β m 0) (Function.update γ m 0) * (a m ^ p * a' m ^ q) := by
  rw [← pw_single a a' m p q, pw_mul a a' hl]
  congr 1
  · funext n
    by_cases hn : n = m
    · subst hn
      simp only [Pi.add_apply, Function.update_self, zero_add]
    · simp only [Pi.add_apply, Function.update_of_ne hn, Pi.zero_apply, add_zero]
  · funext n
    by_cases hn : n = m
    · subst hn
      simp only [Pi.add_apply, Function.update_self, zero_add]
    · simp only [Pi.add_apply, Function.update_of_ne hn, Pi.zero_apply, add_zero]

/-- Every element of the subgroup generated by commuting letters is some `pw a a' β γ`. -/
theorem exists_pw_of_mem_closure
    (hl : ∀ n m,
      Commute (a n) (a m) ∧ Commute (a n) (a' m) ∧ Commute (a' n) (a' m))
    {g : G} (hg : g ∈ Subgroup.closure (Set.range a ∪ Set.range a')) :
    ∃ β γ : Fin K → ℤ, g = pw a a' β γ := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with ⟨n, rfl⟩ | ⟨n, rfl⟩
    · exact ⟨Function.update 0 n 1, Function.update 0 n 0, by
        rw [pw_single, zpow_one, zpow_zero, mul_one]⟩
    · exact ⟨Function.update 0 n 0, Function.update 0 n 1, by
        rw [pw_single, zpow_zero, zpow_one, one_mul]⟩
  | one => exact ⟨0, 0, (pw_zero a a').symm⟩
  | mul x y _ _ hx hy =>
    obtain ⟨β, γ, rfl⟩ := hx
    obtain ⟨β', γ', rfl⟩ := hy
    exact ⟨β + β', γ + γ', (pw_mul a a' hl β γ β' γ').symm⟩
  | inv x _ hx =>
    obtain ⟨β, γ, rfl⟩ := hx
    exact ⟨-β, -γ, pw_inv a a' hl β γ⟩

end BR
end KMS
end GroupApproximation.Full.Kharlampovich
