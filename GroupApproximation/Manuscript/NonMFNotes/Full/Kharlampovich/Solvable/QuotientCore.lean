import Mathlib.GroupTheory.Solvable
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Algebra.Group.Subgroup.Map
import GroupApproximation.Manuscript.NonMFNotes.Full.Kharlampovich.Solvable.BRFamily

/-!
# Commutators of generated subgroups

Generic group theory for the solvability of the Kharlampovich group `G(M)` (input for
`thm:fixed-radical-membership` of `non_mf_group_notes.tex`; Kharlampovich--Myasnikov--Sapir,
arXiv:1204.6506, Sec. 4, Lemma `lH`, `p = 2`).

* `commutator_closure_le`: if all commutators of elements of `s` lie in the normal subgroup
  `N`, then `⁅⟨s⟩, ⟨s⟩⁆ ≤ N`, because the images of `s` in `G ⧸ N` commute.
* `commutator_closure_le_bot`: the same with `N = ⊥` and pairwise commuting generators.
* `exists_zpow_of_mem_closure`: an element generated by two commuting elements
  `α, α'` is `α ^ p * α' ^ q`.
* `map_foldl_zpow`: homomorphisms commute with ordered products of powers.
-/

namespace GroupApproximation.Full.Kharlampovich
namespace KMS
namespace QS

open scoped commutatorElement

variable {G : Type*} [Group G]

/-- If the commutators of elements of `s` lie in the normal subgroup `N`, then so do all
commutators of elements of the subgroup generated by `s`. -/
theorem commutator_closure_le {s : Set G} {N : Subgroup G} [N.Normal]
    (h : ∀ x ∈ s, ∀ y ∈ s, ⁅x, y⁆ ∈ N) :
    ⁅Subgroup.closure s, Subgroup.closure s⁆ ≤ N := by
  rw [Subgroup.commutator_le]
  intro g₁ hg₁ g₂ hg₂
  have hgen : ∀ x ∈ (QuotientGroup.mk' N) '' s, ∀ y ∈ (QuotientGroup.mk' N) '' s,
      Commute x y := by
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    have e : (QuotientGroup.mk' N) ⁅x, y⁆ = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact h x hx y hy
    rw [map_commutatorElement] at e
    exact commutatorElement_eq_one_iff_commute.mp e
  have hmem : ∀ g ∈ Subgroup.closure s,
      QuotientGroup.mk' N g ∈ Subgroup.closure ((QuotientGroup.mk' N) '' s) := by
    intro g hg
    rw [← MonoidHom.map_closure]
    exact Subgroup.mem_map_of_mem _ hg
  have hc := BR.commute_of_mem_closure hgen (hmem g₁ hg₁) (hmem g₂ hg₂)
  have e : (QuotientGroup.mk' N) ⁅g₁, g₂⁆ = 1 := by
    rw [map_commutatorElement]
    exact commutatorElement_eq_one_iff_commute.mpr hc
  rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at e

/-- A subgroup generated by pairwise commuting elements is abelian. -/
theorem commutator_closure_le_bot {s : Set G} (h : ∀ x ∈ s, ∀ y ∈ s, Commute x y) :
    ⁅Subgroup.closure s, Subgroup.closure s⁆ ≤ ⊥ := by
  rw [Subgroup.commutator_le]
  intro g₁ hg₁ g₂ hg₂
  rw [Subgroup.mem_bot]
  exact commutatorElement_eq_one_iff_commute.mpr (BR.commute_of_mem_closure h hg₁ hg₂)

/-- A commutator with an element of a normal subgroup lies in it (left slot). -/
theorem commutatorElement_mem_left {N : Subgroup G} [hN : N.Normal] {x : G} (y : G)
    (hx : x ∈ N) : ⁅x, y⁆ ∈ N := by
  rw [commutatorElement_def, mul_assoc x y, mul_assoc x]
  exact N.mul_mem hx (hN.conj_mem x⁻¹ (N.inv_mem hx) y)

/-- A commutator with an element of a normal subgroup lies in it (right slot). -/
theorem commutatorElement_mem_right {N : Subgroup G} [hN : N.Normal] (x : G) {y : G}
    (hy : y ∈ N) : ⁅x, y⁆ ∈ N := by
  rw [commutatorElement_def]
  exact N.mul_mem (hN.conj_mem y hy x) (N.inv_mem hy)

/-- Conjugating by a commuting element does nothing. -/
theorem inv_mul_mul_eq_of_commute {s w : G} (h : Commute s w) : s⁻¹ * w * s = w := by
  rw [mul_assoc, ← h.eq, inv_mul_cancel_left]

/-- Conjugating by the inverse of a commuting element does nothing. -/
theorem inv_inv_mul_mul_eq_of_commute {s w : G} (h : Commute s w) : s⁻¹⁻¹ * w * s⁻¹ = w := by
  rw [inv_inv]
  exact h.mul_inv_cancel

/-- An element generated by two commuting elements `α, α'` is `α ^ p * α' ^ q`. -/
theorem exists_zpow_of_mem_closure {α α' : G} (hc : Commute α α') {s : Set G}
    (hs : ∀ x ∈ s, x = α ∨ x = α') {g : G} (hg : g ∈ Subgroup.closure s) :
    ∃ p q : ℤ, g = α ^ p * α' ^ q := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    rcases hs x hx with h | h
    · exact ⟨1, 0, by rw [h, zpow_one, zpow_zero, mul_one]⟩
    · exact ⟨0, 1, by rw [h, zpow_zero, zpow_one, one_mul]⟩
  | one => exact ⟨0, 0, by rw [zpow_zero, zpow_zero, mul_one]⟩
  | mul _ _ _ _ hx hy =>
    obtain ⟨p, q, hpq⟩ := hx
    obtain ⟨p', q', hpq'⟩ := hy
    refine ⟨p + p', q + q', ?_⟩
    rw [hpq, hpq', zpow_add, zpow_add]
    have e : α' ^ q * α ^ p' = α ^ p' * α' ^ q := ((hc.zpow_zpow p' q).eq).symm
    calc α ^ p * α' ^ q * (α ^ p' * α' ^ q')
        = α ^ p * (α' ^ q * α ^ p') * α' ^ q' := by simp only [mul_assoc]
      _ = α ^ p * (α ^ p' * α' ^ q) * α' ^ q' := by rw [e]
      _ = α ^ p * α ^ p' * (α' ^ q * α' ^ q') := by simp only [mul_assoc]
  | inv _ _ hx =>
    obtain ⟨p, q, hpq⟩ := hx
    refine ⟨-p, -q, ?_⟩
    rw [hpq, mul_inv_rev, zpow_neg, zpow_neg]
    exact ((hc.zpow_zpow p q).inv_inv).eq.symm

/-- Homomorphisms commute with ordered products of powers. -/
theorem map_foldl_zpow {F H : Type*} [Group F] [Group H] (φ : F →* H) {K : ℕ}
    (t : Fin K → F) (e : Fin K → ℤ) (L : List (Fin K)) (g : F) :
    φ (List.foldl (fun h n => h * t n ^ e n) g L)
      = List.foldl (fun h n => h * φ (t n) ^ e n) (φ g) L := by
  induction L generalizing g with
  | nil => rfl
  | cons n L ih =>
    simp only [List.foldl_cons]
    rw [ih, map_mul, map_zpow]

end QS
end KMS
end GroupApproximation.Full.Kharlampovich
