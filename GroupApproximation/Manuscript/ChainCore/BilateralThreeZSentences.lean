/-!
# `prop:bilateral-three`: the central defect `z` and its kill

`non_mf_groups_exist.tex`, proof of Proposition `prop:bilateral-three` (tex 1583–1588):

> Hence $z\in\mathfrak D_B(L)$.  It commutes with $L$, since both its
> supports lie outside $P$; with $W$, since its two levels are fixed;
> and with $c,y$, by the displayed matrix-unit products.  So
> $\langle z\rangle$ is a nontrivial finite central subgroup of $B$, of
> order $\operatorname{char}(k)$.  Theorem~\ref{thm:compression-criterion}
> kills $z$ under every MF homomorphism from $B$, hence from $\GL_3(R_X)$.

Standing data (tex 1550–1575): a clopen `P` with `T(P) ⊆ P`, a finite field `k`, the cell
`bilateralCell T k hP hTP` in `GL_3(R_X)`, the printed coefficient set `S` (the unital subalgebra of
`p R_X p` generated by `s`, `t` and `kp`, `cellRing`), `L = EL_3(S)` embedded as `coreGroup S`, and
`B = ⟨L, W, c, y⟩` (`Cell.B S`).

* `cell_z_mem_printedDefect`: for any cell and any corner coefficient set stable under conjugation by
  `u` and containing `p`, `z` lies in the printed defect `𝔇_B(L)` of `L` inside `B`.
* `printedBilateralThreeZInDefect_closed`, "Hence $z\in\mathfrak D_B(L)$", at `R_X`.
* `printedBilateralThreeCompressionKillsZ_closed`, "Theorem~\ref{thm:compression-criterion} kills $z$
  under every MF homomorphism from $B$, hence from $\GL_3(R_X)$", at `R_X`.  Inside the countable group
  `B`, `⟨z⟩` is finite (hence Kazhdan), central (hence normal) and inside `𝔇_B(L)`, and `L` has property
  `(T)`, so `manuscriptOneSidedCompressionCriterion` puts `z` in the corona MF residual of `B`.
-/

namespace GroupApproximation.Manuscript.ChainCore.BilateralThree

open GroupApproximation.BilateralThreeCell GroupApproximation.ClopenCrossedProduct
open GroupApproximation.Manuscript.OneSidedMFRadical
open scoped commutatorElement

/-! ## `z ∈ 𝔇_B(L)` for any cell -/

/-- For a cell and a corner coefficient set `S ∋ p` stable under conjugation by `u`, `z` lies in the
printed defect of `L = coreGroup S` inside `B = ⟨L, W, c, y⟩`. -/
theorem cell_z_mem_printedDefect {R : Type*} [Ring R] (C : Cell R) {S : Set R}
    (hS : ∀ a ∈ S, C.p * a * C.p = a) (hu : ∀ a ∈ S, ↑C.u * a * ↑C.u⁻¹ ∈ S) (hp : C.p ∈ S) :
    (⟨C.z, C.z_mem_B hp⟩ : ↥(C.B S)) ∈ printedDefect ((coreGroup S).subgroupOf (C.B S)) := by
  have hW := C.W_conj_mem_coreGroup hS hu
  have hc := C.c_commute_coreGroup hS
  have hℓ := C.ell_mem_coreGroup hp
  have hyz : ⁅C.y, ⁅C.W * C.c * C.W⁻¹, C.ell⁆⁆ = C.z⁻¹ := by
    rw [C.delta_eq]
    exact C.commutator_y_delta
  let W' : ↥(C.B S) := ⟨C.W, C.W_mem_B S⟩
  let c' : ↥(C.B S) := ⟨C.c, C.c_mem_B S⟩
  let y' : ↥(C.B S) := ⟨C.y, C.y_mem_B S⟩
  let l' : ↥(C.B S) := ⟨C.ell, C.coreGroup_le_B S hℓ⟩
  have hWcomp : ∀ δ ∈ (coreGroup S).subgroupOf (C.B S),
      W' * δ * W'⁻¹ ∈ (coreGroup S).subgroupOf (C.B S) := by
    intro δ hδ
    rw [Subgroup.mem_subgroupOf] at hδ ⊢
    exact hW _ hδ
  have hccomm : ∀ δ ∈ (coreGroup S).subgroupOf (C.B S), Commute c' δ := by
    intro δ hδ
    rw [Subgroup.mem_subgroupOf] at hδ
    exact Subtype.ext (hc _ hδ)
  have hlmem : l' ∈ (coreGroup S).subgroupOf (C.B S) := by
    rw [Subgroup.mem_subgroupOf]
    exact hℓ
  have hd : ⁅W' * c' * W'⁻¹, l'⁆ ∈ printedDefect ((coreGroup S).subgroupOf (C.B S)) :=
    printedDefect_generator_mem _ hWcomp hccomm hlmem
  have hyd : y' * ⁅W' * c' * W'⁻¹, l'⁆ * y'⁻¹ * (⁅W' * c' * W'⁻¹, l'⁆)⁻¹ ∈
      printedDefect ((coreGroup S).subgroupOf (C.B S)) :=
    TorsionComplementaryIdempotents.commutatorRight_mem y' hd
  have hval : y' * ⁅W' * c' * W'⁻¹, l'⁆ * y'⁻¹ * (⁅W' * c' * W'⁻¹, l'⁆)⁻¹ =
      (⟨C.z, C.z_mem_B hp⟩ : ↥(C.B S))⁻¹ := by
    refine Subtype.ext ?_
    show C.y * ⁅C.W * C.c * C.W⁻¹, C.ell⁆ * C.y⁻¹ * (⁅C.W * C.c * C.W⁻¹, C.ell⁆)⁻¹ = C.z⁻¹
    rw [← commutatorElement_def, hyz]
  rw [hval] at hyd
  simpa using (printedDefect ((coreGroup S).subgroupOf (C.B S))).inv_mem hyd

/-! ## The printed objects at `R_X` -/

section Clopen

variable {X : Type} [TopologicalSpace X] (T : X ≃ₜ X) (k : Type) [Field k] [Finite k] {P : Set X}
  (hP : IsClopen P) (hTP : T '' P ⊆ P)

/-- The printed coefficient set `S ⊆ p R_X p`: the unital subalgebra generated by `s`, `t` and `kp`. -/
abbrev bilateralCellSet : Set (ClopenCrossedProduct T k) :=
  Set.range fun a : ↥(cellRing T k hP hTP) => (a : (bilateralCell T k hP hTP).Corner).1

theorem bilateralCell_z_mem_B :
    (bilateralCell T k hP hTP).z ∈ (bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP) :=
  (bilateralCell T k hP hTP).z_mem_B ⟨1, rfl⟩

/-- `L = EL_3(S)`, embedded in `GL_3(R_X)`, has property `(T)` (tex 1556–1558). -/
theorem hasKazhdanPropertyT_bilateralCoreGroup :
    HasKazhdanPropertyT.{0, 0} ↥(coreGroup (bilateralCellSet T k hP hTP)) := by
  show HasKazhdanPropertyT.{0, 0} ↥(coreGroup (Set.range fun a : ↥(cellRing T k hP hTP) =>
    (a : (bilateralCell T k hP hTP).Corner).1))
  rw [← (bilateralCell T k hP hTP).range_cornerEmbed (cellRing T k hP hTP)]
  exact hasKazhdanPropertyT_range_of_injective (isFinitelyGeneratedRing_cellRing T k hP hTP) _
    ((bilateralCell T k hP hTP).cornerEmbed_injective _)

theorem bilateralCell_z_mem_printedDefect :
    (⟨(bilateralCell T k hP hTP).z, bilateralCell_z_mem_B T k hP hTP⟩ :
        ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP))) ∈
      printedDefect ((coreGroup (bilateralCellSet T k hP hTP)).subgroupOf
        ((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP))) :=
  cell_z_mem_printedDefect (bilateralCell T k hP hTP)
    ((bilateralCell T k hP hTP).corner_of_mem_range (S := cellRing T k hP hTP))
    ((bilateralCell T k hP hTP).unit_conj_mem_range (sCorner_mem_cellRing T k hP hTP)
      (tCorner_mem_cellRing T k hP hTP)) ⟨1, rfl⟩

end Clopen

/-! ## tex 1583: `z ∈ 𝔇_B(L)` -/

/-- **tex 1583**, "Hence $z\in\mathfrak D_B(L)$": for every clopen `P` with `T(P) ⊆ P` over a finite
field, the central defect `z` of the cell lies in `B` and in the printed defect `𝔇_B(L)` of `L = EL_3(S)`
inside `B = ⟨L, W, c, y⟩`. -/
def PrintedBilateralThreeZInDefect : Prop :=
  ∀ (X : Type) [TopologicalSpace X] (T : X ≃ₜ X) (k : Type) [Field k] [Finite k]
    (P : Set X) (hP : IsClopen P) (hTP : T '' P ⊆ P),
    ∃ hz : (bilateralCell T k hP hTP).z ∈ (bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP),
      (⟨(bilateralCell T k hP hTP).z, hz⟩ :
          ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP))) ∈
        printedDefect ((coreGroup (bilateralCellSet T k hP hTP)).subgroupOf
          ((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP)))

theorem printedBilateralThreeZInDefect_closed : PrintedBilateralThreeZInDefect := by
  intro X _ T k _ _ P hP hTP
  exact ⟨bilateralCell_z_mem_B T k hP hTP, bilateralCell_z_mem_printedDefect T k hP hTP⟩

/-! ## tex 1587–1588: the compression criterion kills `z` -/

/-- **tex 1587–1588**, "Theorem~\ref{thm:compression-criterion} kills $z$ under every MF homomorphism
from $B$, hence from $\GL_3(R_X)$": for a compact metrizable `X`, every clopen `P` with `T(P) ⊆ P`
and every finite field, every homomorphism from `B` to an MF group kills `z`, and so does every
homomorphism from `GL_3(R_X)`. -/
def PrintedBilateralThreeCompressionKillsZ : Prop :=
  ∀ (X : Type) [TopologicalSpace X] [CompactSpace X] [TopologicalSpace.MetrizableSpace X]
    (T : X ≃ₜ X) (k : Type) [Field k] [Finite k] (P : Set X) (hP : IsClopen P) (hTP : T '' P ⊆ P),
    (∀ (M : Type) [Group M], IsOperatorMF M →
        ∀ f : ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP)) →* M,
          f ⟨(bilateralCell T k hP hTP).z, bilateralCell_z_mem_B T k hP hTP⟩ = 1) ∧
      ∀ (M : Type) [Group M], IsOperatorMF M →
        ∀ f : (Matrix (Fin 3) (Fin 3) (ClopenCrossedProduct T k))ˣ →* M,
          f (bilateralCell T k hP hTP).z = 1

theorem printedBilateralThreeCompressionKillsZ_closed : PrintedBilateralThreeCompressionKillsZ := by
  intro X _ _ _ T k _ _ P hP hTP
  have hB : ∀ (M : Type) [Group M], IsOperatorMF M →
      ∀ f : ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP)) →* M,
        f ⟨(bilateralCell T k hP hTP).z, bilateralCell_z_mem_B T k hP hTP⟩ = 1 := by
    intro M _ hM f
    haveI : Countable (ClopenCrossedProduct T k) := ClopenCrossedProduct.countable T k
    haveI : Countable (Matrix (Fin 3) (Fin 3) (ClopenCrossedProduct T k))ˣ := countable_units_matrix 3
    haveI : Countable ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP)) :=
      Subtype.countable
    have hcorner := (bilateralCell T k hP hTP).corner_of_mem_range (S := cellRing T k hP hTP)
    let zB : ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP)) :=
      ⟨(bilateralCell T k hP hTP).z, bilateralCell_z_mem_B T k hP hTP⟩
    have hcentral : ∀ b : ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP)),
        Commute zB b := fun b =>
      Subtype.ext ((bilateralCell T k hP hTP).z_commute_B hcorner b b.2)
    haveI : (Subgroup.zpowers zB).Normal := by
      constructor
      intro x hx g
      obtain ⟨j, rfl⟩ := hx
      have hck : zB ^ j * g = g * zB ^ j := (hcentral g).zpow_left j
      have hconj : g * zB ^ j * g⁻¹ = zB ^ j := by
        rw [← hck, mul_assoc, mul_inv_cancel, mul_one]
      rw [hconj]
      exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) j
    have hn : ((ringChar k : ℕ) : ClopenCrossedProduct T k) * (bilateralCell T k hP hTP).d = 0 := by
      rw [natCast_ringChar_eq_zero, zero_mul]
    haveI : Finite ↥(Subgroup.zpowers zB) := by
      have hfin := (bilateralCell T k hP hTP).isOfFinOrder_z
        (Nat.pos_of_ne_zero (CharP.char_ne_zero_of_finite (R := k) (ringChar k))) hn
      obtain ⟨m, hm, hpow⟩ := isOfFinOrder_iff_pow_eq_one.mp hfin
      have hpowB : zB ^ m = 1 := Subtype.ext (show (bilateralCell T k hP hTP).z ^ m = 1 from hpow)
      exact Set.Finite.to_subtype (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, hpowB⟩).finite_zpowers
    have hKT : HasKazhdanPropertyT.{0, 0} ↥(Subgroup.zpowers zB) := hasKazhdanPropertyT_of_finite _
    have hLBT : HasKazhdanPropertyT.{0, 0} ↥((coreGroup (bilateralCellSet T k hP hTP)).subgroupOf
        ((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP))) :=
      HasKazhdanPropertyT.of_mulEquiv
        (Subgroup.subgroupOfEquivOfLe
          ((bilateralCell T k hP hTP).coreGroup_le_B (bilateralCellSet T k hP hTP)))
        (hasKazhdanPropertyT_bilateralCoreGroup T k hP hTP)
    have hres := (manuscriptOneSidedCompressionCriterion
      ↥((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP))
      ((coreGroup (bilateralCellSet T k hP hTP)).subgroupOf
        ((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP))) hLBT).1
      (Subgroup.zpowers zB) hKT
      (Subgroup.zpowers_le.mpr (bilateralCell_z_mem_printedDefect T k hP hTP))
    exact TorsionComplementaryIdempotents.killed_of_mem_manuscriptCoronaMFResidual hM f
      (hres (Subgroup.mem_zpowers _))
  exact ⟨hB, fun M _ hM f => hB M hM
    (f.comp ((bilateralCell T k hP hTP).B (bilateralCellSet T k hP hTP)).subtype)⟩

end GroupApproximation.Manuscript.ChainCore.BilateralThree

