import GroupApproximation.Dynamics.TransientIdealDefectSpan
import GroupApproximation.Manuscript.ChainCore.BilateralThreeStatement
import GroupApproximation.Meta.AxiomGuard

/-!
# The defect ideal is the transient ideal

`non_mf_groups_exist.tex`, `lem:transient-matrices`, tex 1476–1477: "The ideal $I$ is [...]
generated by the indicators $1_{P\setminus T(P)}$ of the defects".

`Manuscript.ChainCore.BilateralThree.defectIdeal T k` is the two-sided ideal generated by the
compressed-clopen defects.  `defectIdeal_eq_transientIdeal_chainRecurrentSet` identifies it with the
kernel of restriction to `CR(T)`, through `ClopenCrossedProduct.transientIdeal_chainRecurrentSet_eq_span`.

`chainRecurrentSet_eq_univ_of_isDedekindFiniteMonoid`: if `R_X` is directly finite, every defect
vanishes (`map_defectD_eq_zero`), so every point is chain recurrent.

This module only wraps `Dynamics/TransientIdealDefectSpan.lean`, so the light producer module can
be imported by the consumers without an import cycle.
-/

namespace GroupApproximation

open ClopenCrossedProduct

/-- **The defect ideal is the transient ideal** (tex 1476–1477). -/
theorem defectIdeal_eq_transientIdeal_chainRecurrentSet {X : Type} [UniformSpace X]
    [CompactSpace X] [T2Space X] [TotallyDisconnectedSpace X] (T : X ≃ₜ X) (k : Type) [Field k] :
    Manuscript.ChainCore.BilateralThree.defectIdeal T k =
      transientIdeal T k (Dynamics.image_chainRecurrentSet T) :=
  (transientIdeal_chainRecurrentSet_eq_span T k).symm

/-- If `R_X` is directly finite, every point of `X` is chain recurrent. -/
theorem chainRecurrentSet_eq_univ_of_isDedekindFiniteMonoid {X : Type*} [UniformSpace X]
    [CompactSpace X] [T2Space X] [TotallyDisconnectedSpace X] (T : X ≃ₜ X) (k : Type*) [Ring k]
    [Nontrivial k] [IsDedekindFiniteMonoid (ClopenCrossedProduct T k)] :
    Dynamics.chainRecurrentSet T = Set.univ :=
  chainRecurrentSet_eq_univ_of_forall_defectD_eq_zero T k fun _ hP hTP ↦
    map_defectD_eq_zero T k (RingHom.id _) hP hTP

end GroupApproximation

open GroupApproximation

#audit_axioms GroupApproximation.defectIdeal_eq_transientIdeal_chainRecurrentSet
#audit_axioms GroupApproximation.chainRecurrentSet_eq_univ_of_isDedekindFiniteMonoid
