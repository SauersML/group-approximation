import GroupApproximation.Leavitt.ElementaryGroup
import GroupApproximation.PropertyT.FinitelyGeneratedRing

/-!
# `thm:full-defect-ring`: descent to a finitely generated subring

`non_mf_groups_exist.tex`, last paragraph of the proof of
Theorem `thm:full-defect-ring`:

> For general countable `R`, every element of `EL_n(R)` is a product of
> finitely many elementary matrices, so it lies in `EL_n(S)` for some finitely
> generated unital subring `S` of `R` containing `s`, `t`, and the `a_j, b_j`.
> The hypotheses hold in `S`, so a homomorphism from `EL_n(R)` to an MF group
> is trivial on each such `EL_n(S)`, and these subgroups cover `EL_n(R)`.

This module proves the covering statement, and nothing else: the property-`(T)`
input and the MF conclusion are downstream.  The argument is pure group theory
over an arbitrary ring, with no countability and no rank hypothesis.

## How the descent is organised

The obvious route — induct on the closure defining `EL_ι(R)` and, at the
multiplication step, merge the two subrings — needs the elementary group of a
subring to be *monotone* in that subring, and that is a statement about the
functorial map `EL_ι(S) → EL_ι(S')`, which has to be built and shown
compatible with the two inclusions into `EL_ι(R)`.

`subringElementary` avoids all of it.  It is the subgroup of `EL_ι(R)` — not
of `EL_ι(S)` — generated by the elementary matrices whose single coefficient
lies in `S`, so monotonicity is `Subgroup.closure_mono` and nothing more.  The
comparison with the functorial image is then made once,
in `subringElementary_le_map`, and only in the direction the proof uses.

## Main results

* `subringElementary` — the subgroup of `EL_ι(R)` generated by the elementary
  matrices with coefficients in a subring `S`, and its monotonicity.
* `subringElementary_le_map` — that subgroup lies in the image of `EL_ι(S)`.
* `exists_finset_elementaryGroup_le_map` — every element of `EL_ι(R)` lies in
  the image of `EL_ι(Subring.closure F)` for a finite `F` which may be
  prescribed to contain any given finite set of coefficients.
* `isFinitelyGeneratedRing_subringClosure` — a subring generated by a finite
  subset is a finitely generated ring in its own right, which is what the
  Ershov--Jaikin-Zapirain hypothesis asks for.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace FullDefectRing

/-! ## Elementary matrices with coefficients in a subring -/

section Subring

variable {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R]

/-- The subgroup of `EL_ι(R)` generated by the elementary matrices `x_{ij}(a)`
with `a ∈ S`.  This is the printed `EL_n(S)`, but realised inside `EL_ι(R)`
rather than as an abstract group over `S`. -/
def subringElementary (S : Subring R) : Subgroup (Matrix ι ι R)ˣ :=
  Subgroup.closure
    {z | ∃ (i j : ι) (h : i ≠ j) (a : R), a ∈ S ∧ elementaryUnit i j h a = z}

theorem subringElementary_mono {S T : Subring R} (hST : S ≤ T) :
    subringElementary (ι := ι) S ≤ subringElementary (ι := ι) T := by
  apply Subgroup.closure_mono
  rintro z ⟨i, j, hij, a, haS, rfl⟩
  exact ⟨i, j, hij, a, hST haS, rfl⟩

theorem elementaryUnit_mem_subringElementary {S : Subring R} (i j : ι)
    (hij : i ≠ j) {a : R} (ha : a ∈ S) :
    elementaryUnit i j hij a ∈ subringElementary (ι := ι) S :=
  Subgroup.subset_closure ⟨i, j, hij, a, ha, rfl⟩

/-- **The subring-coefficient subgroup is the image of the elementary group of
the subring.**  Only the inclusion used by the printed proof is stated: an
element with all coefficients in `S` comes from `EL_ι(S)`. -/
theorem subringElementary_le_map (S : Subring R) :
    subringElementary (ι := ι) S ≤
      (elementaryGroup ι S).map (elementaryMatrixUnitMap S.subtype) := by
  rw [subringElementary, Subgroup.closure_le]
  rintro z ⟨i, j, hij, a, haS, rfl⟩
  refine ⟨elementaryUnit i j hij (⟨a, haS⟩ : S),
    elementaryUnit_mem i j hij _, ?_⟩
  simpa using
    elementaryMatrixUnitMap_elementaryUnit (ι := ι) S.subtype i j hij ⟨a, haS⟩

/-! ## Every element has a finitely generated subring of coefficients -/

/-- The elements of `EL_ι(R)` whose coefficients can be confined to a finitely
generated subring.  The printed sentence "every element of `EL_n(R)` is a
product of finitely many elementary matrices" is exactly the statement that
this subgroup contains `EL_ι(R)`. -/
def finiteCoefficientSubgroup : Subgroup (Matrix ι ι R)ˣ where
  carrier :=
    {x | ∃ F : Finset R,
      x ∈ subringElementary (ι := ι) (Subring.closure (F : Set R))}
  one_mem' := ⟨∅, one_mem _⟩
  mul_mem' := by
    classical
    rintro x y ⟨F, hF⟩ ⟨G, hG⟩
    refine ⟨F ∪ G, mul_mem ?_ ?_⟩
    · exact subringElementary_mono
        (Subring.closure_mono (by
          intro a ha
          exact Finset.mem_coe.mpr (Finset.mem_union_left G (Finset.mem_coe.mp ha)))) hF
    · exact subringElementary_mono
        (Subring.closure_mono (by
          intro a ha
          exact Finset.mem_coe.mpr (Finset.mem_union_right F (Finset.mem_coe.mp ha)))) hG
  inv_mem' := by
    rintro x ⟨F, hF⟩
    exact ⟨F, inv_mem hF⟩

theorem elementaryGroup_le_finiteCoefficientSubgroup :
    elementaryGroup ι R ≤ finiteCoefficientSubgroup (ι := ι) (R := R) := by
  rw [elementaryGroup, Subgroup.closure_le]
  rintro _ ⟨i, j, hij, a, rfl⟩
  exact ⟨{a}, elementaryUnit_mem_subringElementary i j hij
    (Subring.subset_closure (by simp))⟩

/-- **The printed descent.**  Every element of `EL_ι(R)`, together with any
prescribed finite set `T` of coefficients — in `thm:full-defect-ring` the
elements `s`, `t` and the `a_j, b_j` — is captured by one subring generated by
a finite set containing `T`: the element lies in the image of the elementary
group of that subring. -/
theorem exists_finset_elementaryGroup_le_map (T : Finset R) {x : (Matrix ι ι R)ˣ}
    (hx : x ∈ elementaryGroup ι R) :
    ∃ F : Finset R, T ⊆ F ∧
      x ∈ (elementaryGroup ι (Subring.closure (F : Set R))).map
        (elementaryMatrixUnitMap (Subring.closure (F : Set R)).subtype) := by
  classical
  obtain ⟨F, hF⟩ := elementaryGroup_le_finiteCoefficientSubgroup hx
  refine ⟨F ∪ T, Finset.subset_union_right, ?_⟩
  refine subringElementary_le_map _ ?_
  exact subringElementary_mono
    (Subring.closure_mono (by
      intro a ha
      exact Finset.mem_coe.mpr (Finset.mem_union_left T (Finset.mem_coe.mp ha)))) hF

end Subring

/-! ## The subring generated by a finite set is a finitely generated ring -/

section FiniteGeneration

variable {R : Type*} [Ring R]

/-- **`Subring.closure F` is a finitely generated ring for finite `F`.**

`IsFinitelyGeneratedRing` is a statement about the subring *as a ring*, so the
finite generating set has to be produced inside the subtype: it is the
preimage of `F` under the injective inclusion.  The proof shows that the image
of the subring generated by that preimage already contains `F`, hence contains
`Subring.closure F` itself, and then cancels the injective inclusion.

This is the hypothesis the Ershov--Jaikin-Zapirain theorem asks of its
coefficient ring, and it is the reason the printed proof passes to `S` at
all. -/
theorem isFinitelyGeneratedRing_subringClosure (F : Finset R) :
    IsFinitelyGeneratedRing ↥(Subring.closure (F : Set R)) := by
  classical
  have hInjOn : Set.InjOn (Subring.closure (F : Set R)).subtype
      ((Subring.closure (F : Set R)).subtype ⁻¹' (F : Set R)) :=
    fun _ _ _ _ h ↦ Subtype.ext h
  refine ⟨F.preimage (Subring.closure (F : Set R)).subtype hInjOn, ?_⟩
  have hle : Subring.closure (F : Set R) ≤
      Subring.map (Subring.closure (F : Set R)).subtype
        (Subring.closure
          ((F.preimage (Subring.closure (F : Set R)).subtype hInjOn :
            Finset ↥(Subring.closure (F : Set R))) : Set _)) := by
    rw [Subring.closure_le]
    intro a ha
    have haS : a ∈ Subring.closure (F : Set R) := Subring.subset_closure ha
    refine ⟨⟨a, haS⟩, Subring.subset_closure ?_, rfl⟩
    rw [Finset.coe_preimage]
    exact ha
  rw [Subring.eq_top_iff']
  intro x
  obtain ⟨y, hy, hxy⟩ := Subring.mem_map.mp (hle x.2)
  have hyx : y = x := Subtype.ext hxy
  exact hyx ▸ hy

end FiniteGeneration

