import GroupApproximation.Leavitt.CongruenceSubgroups
import GroupApproximation.Leavitt.ElementaryNoFiniteQuotients
import GroupApproximation.Meta.AxiomGuard
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# From one killed elementary matrix to the whole relative elementary group

`non_mf_groups_exist.tex`, Proposition `prop:torsion-defect-ring`, the end of
its proof:

> are killed, hence every `e_{ij}(aeb)` by the Steinberg relations and signed
> permutations, hence `EL_n(R,ReR)`.

This module is that sentence, and nothing else in it is about the torsion
hypothesis, the compressor, or MF groups.  The input is a *normal* subgroup `N`
of `EL_ι(R)` containing a single elementary matrix `e_{pq}(a)`; the output is
`EL_ι(R, ⟨a⟩) ≤ N`, where `⟨a⟩ = RaR` is the two-sided ideal generated by `a`.

## Why no sum representation of `RaR` is needed

The printed proof reaches `e_{ij}(aeb)` for arbitrary `a, b` and then appeals to
the fact that `ReR` consists of the finite sums of such products.  The Lean
proof does the same work in the opposite order and never mentions a sum: the
set

  `{x : R | ∀ i ≠ j, e_{ij}(x) ∈ N}`

is itself a two-sided ideal — additivity is `e_{ij}(x)e_{ij}(y) = e_{ij}(x+y)`,
and the two absorption laws are the Steinberg relations
`[e_{ik}(r), e_{kj}(x)] = e_{ij}(rx)` and `[e_{ik}(x), e_{kj}(r)] = e_{ij}(xr)`
together with the normality of `N`.  So it contains `⟨a⟩` as soon as it
contains `a`, and the relative elementary group, being the *normal* closure of
the roots with coefficients in `⟨a⟩`, is then inside `N`.

## Where the rank enters

Both absorption laws pick a third index `k ∉ {i,j}`, so the argument needs
three coordinates; `exists_third_index` supplies one for `Fin n` with `n ≥ 3`.
That is weaker than the printed `n ≥ 4`, which is spent elsewhere — on the
rank-four compressor cell.

The propagation from the single printed position `e_{21}(e)` to every position
is `elGen_mem_of_one_position`: two Steinberg moves and one three-step swap.
It replaces the printed "and signed permutations", which is the same statement
with a different proof.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace TorsionComplementaryIdempotents

universe u

/-! ## Two normality facts about commutators -/

section Commutators

variable {G : Type*} [Group G] {N : Subgroup G} [N.Normal]

/-- `n y n⁻¹ y⁻¹ ∈ N` for `n ∈ N`. -/
theorem commutatorLeft_mem {n : G} (hn : n ∈ N) (y : G) :
    n * y * n⁻¹ * y⁻¹ ∈ N := by
  have h : n * (y * n⁻¹ * y⁻¹) ∈ N :=
    N.mul_mem hn (‹N.Normal›.conj_mem _ (N.inv_mem hn) y)
  have hassoc : n * y * n⁻¹ * y⁻¹ = n * (y * n⁻¹ * y⁻¹) := by group
  rwa [hassoc]

/-- `x n x⁻¹ n⁻¹ ∈ N` for `n ∈ N`. -/
theorem commutatorRight_mem (x : G) {n : G} (hn : n ∈ N) :
    x * n * x⁻¹ * n⁻¹ ∈ N :=
  N.mul_mem (‹N.Normal›.conj_mem _ hn x) (N.inv_mem hn)

end Commutators

/-! ## A third index -/

/-- In `Fin n` with `n ≥ 3` there is always an index distinct from two given
ones.  This is the rank input of the Steinberg absorption laws. -/
theorem exists_third_index {n : ℕ} (hn : 3 ≤ n) (i j : Fin n) :
    ∃ k : Fin n, k ≠ i ∧ k ≠ j := by
  by_contra hc
  have hsub : (Finset.univ : Finset (Fin n)) ⊆ {i, j} := by
    intro k _
    rcases eq_or_ne k i with rfl | hki
    · exact Finset.mem_insert_self _ _
    · rcases eq_or_ne k j with rfl | hkj
      · exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
      · exact absurd ⟨hki, hkj⟩ (not_exists.mp hc k)
  have hcard := Finset.card_le_card hsub
  have h2 : ({i, j} : Finset (Fin n)).card ≤ 2 :=
    (Finset.card_insert_le _ _).trans (by simp)
  simp only [Finset.card_univ, Fintype.card_fin] at hcard
  omega

/-! ## The coefficients of a normal subgroup -/

section Coefficients

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {R : Type u} [Ring R]
variable (N : Subgroup (elementaryGroup ι R))

/-- The coefficients whose elementary matrices all lie in `N`. -/
def normalCoefficientSet : Set R :=
  {x | ∀ (i j : ι) (hij : i ≠ j), elGen i j hij x ∈ N}

theorem mem_normalCoefficientSet_iff (x : R) :
    x ∈ normalCoefficientSet N ↔
      ∀ (i j : ι) (hij : i ≠ j), elGen i j hij x ∈ N := Iff.rfl

variable [N.Normal]
variable (hthree : ∀ i j : ι, ∃ k : ι, k ≠ i ∧ k ≠ j)

include hthree

/-- **The printed absorption on the left**, `[e_{ik}(r), e_{kj}(x)] = e_{ij}(rx)`
with `e_{kj}(x) ∈ N`. -/
theorem normalCoefficientSet_mul_left {x : R} (hx : x ∈ normalCoefficientSet N)
    (r : R) : r * x ∈ normalCoefficientSet N := by
  intro i j hij
  obtain ⟨k, hki, hkj⟩ := hthree i j
  have hik : i ≠ k := Ne.symm hki
  have hkj' : k ≠ j := hkj
  have hmem : elGen k j hkj' x ∈ N := hx k j hkj'
  have := commutatorRight_mem (N := N) (elGen i k hik r) hmem
  rwa [elGen_commutator i k j hik hkj' hij r x] at this

/-- **The printed absorption on the right**, `[e_{ik}(x), e_{kj}(r)] = e_{ij}(xr)`
with `e_{ik}(x) ∈ N`. -/
theorem normalCoefficientSet_mul_right {x : R} (hx : x ∈ normalCoefficientSet N)
    (r : R) : x * r ∈ normalCoefficientSet N := by
  intro i j hij
  obtain ⟨k, hki, hkj⟩ := hthree i j
  have hik : i ≠ k := Ne.symm hki
  have hkj' : k ≠ j := hkj
  have hmem : elGen i k hik x ∈ N := hx i k hik
  have := commutatorLeft_mem (N := N) hmem (elGen k j hkj' r)
  rwa [elGen_commutator i k j hik hkj' hij x r] at this

/-- **The coefficients of a normal subgroup form a two-sided ideal.** -/
def normalCoefficientIdeal : TwoSidedIdeal R :=
  TwoSidedIdeal.mk' (normalCoefficientSet N)
    (by intro i j hij; simp)
    (by
      intro x y hx hy i j hij
      rw [← elGen_mul i j hij x y]
      exact N.mul_mem (hx i j hij) (hy i j hij))
    (by
      intro x hx i j hij
      have h : elGen i j hij (-x) * elGen i j hij x = 1 := by
        rw [elGen_mul i j hij (-x) x, neg_add_cancel, elGen_zero]
      have : elGen i j hij (-x) = (elGen i j hij x)⁻¹ :=
        eq_inv_of_mul_eq_one_left h
      rw [this]
      exact N.inv_mem (hx i j hij))
    (fun {x y} hy ↦ normalCoefficientSet_mul_left N hthree hy x)
    (fun {x y} hx ↦ normalCoefficientSet_mul_right N hthree hx y)

@[simp] theorem mem_normalCoefficientIdeal (x : R) :
    x ∈ normalCoefficientIdeal N hthree ↔ x ∈ normalCoefficientSet N :=
  TwoSidedIdeal.mem_mk' _ _ _ _ _ _ x

end Coefficients

/-! ## Propagation from one printed position -/

section Propagation

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {R : Type u} [Ring R]
variable {N : Subgroup (elementaryGroup ι R)} [N.Normal] {a : R}

/-- One Steinberg move to the left: from `e_{pq}(a)` to `e_{rq}(a)`. -/
theorem elGen_move_left {p q r : ι} (hpq : p ≠ q) (hrp : r ≠ p) (hrq : r ≠ q)
    (h : elGen p q hpq a ∈ N) : elGen r q hrq a ∈ N := by
  have := commutatorRight_mem (N := N) (elGen r p hrp 1) h
  rwa [elGen_commutator r p q hrp hpq hrq 1 a, one_mul] at this

/-- One Steinberg move to the right: from `e_{pq}(a)` to `e_{pr}(a)`. -/
theorem elGen_move_right {p q r : ι} (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r)
    (h : elGen p q hpq a ∈ N) : elGen p r hpr a ∈ N := by
  have := commutatorLeft_mem (N := N) h (elGen q r hqr 1)
  rwa [elGen_commutator p q r hpq hqr hpr a 1, mul_one] at this

/-- With the first index fixed, every second index is reachable. -/
theorem elGen_fix_first {p q : ι} (hpq : p ≠ q) (h : elGen p q hpq a ∈ N)
    (j : ι) (hpj : p ≠ j) : elGen p j hpj a ∈ N := by
  rcases eq_or_ne j q with rfl | hjq
  · exact h
  · exact elGen_move_right hpq (Ne.symm hjq) hpj h

/-- With the second index fixed, every first index is reachable. -/
theorem elGen_fix_second {p q : ι} (hpq : p ≠ q) (h : elGen p q hpq a ∈ N)
    (i : ι) (hiq : i ≠ q) : elGen i q hiq a ∈ N := by
  rcases eq_or_ne i p with rfl | hip
  · exact h
  · exact elGen_move_left hpq hip hiq h

/-- The printed "signed permutation" step, in its only needed instance: the
transposed position. -/
theorem elGen_swap (hthree : ∀ i j : ι, ∃ k : ι, k ≠ i ∧ k ≠ j)
    {p q : ι} (hpq : p ≠ q) (h : elGen p q hpq a ∈ N) :
    elGen q p (Ne.symm hpq) a ∈ N := by
  obtain ⟨k, hkp, hkq⟩ := hthree p q
  have h1 : elGen k q hkq a ∈ N := elGen_move_left hpq hkp hkq h
  have h2 : elGen k p hkp a ∈ N :=
    elGen_move_right hkq (Ne.symm hpq) hkp h1
  exact elGen_move_left hkp (Ne.symm hkq) (Ne.symm hpq) h2

/-- **Every position is reachable from one.**  This is the printed "hence every
`e_{ij}(aeb)` … and signed permutations", with the Steinberg moves made
explicit. -/
theorem elGen_mem_of_one_position
    (hthree : ∀ i j : ι, ∃ k : ι, k ≠ i ∧ k ≠ j)
    {p q : ι} (hpq : p ≠ q) (h : elGen p q hpq a ∈ N) :
    a ∈ normalCoefficientSet N := by
  intro i j hij
  rcases eq_or_ne i q with rfl | hiq
  · exact elGen_fix_first (Ne.symm hpq) (elGen_swap hthree hpq h) j hij
  · exact elGen_fix_first hiq (elGen_fix_second hpq h i hiq) j hij

end Propagation

/-! ## The printed conclusion -/

section Conclusion

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {R : Type u} [Ring R]

/-- **The printed last step of `prop:torsion-defect-ring`.**

If a normal subgroup `N ≤ EL_ι(R)` contains one elementary matrix `e_{pq}(a)`,
and `ι` has at least three coordinates, then `N` contains the whole relative
elementary group `EL_ι(R, RaR)`. -/
theorem relativeElementary_span_le
    (N : Subgroup (elementaryGroup ι R)) [N.Normal]
    (hthree : ∀ i j : ι, ∃ k : ι, k ≠ i ∧ k ≠ j)
    {p q : ι} (hpq : p ≠ q) {a : R} (h : elGen p q hpq a ∈ N) :
    relativeElementary ι (TwoSidedIdeal.span {a}) ≤ N := by
  have hmem : a ∈ normalCoefficientIdeal N hthree := by
    rw [mem_normalCoefficientIdeal]
    exact elGen_mem_of_one_position hthree hpq h
  have hspan : TwoSidedIdeal.span {a} ≤ normalCoefficientIdeal N hthree :=
    TwoSidedIdeal.span_le.mpr (Set.singleton_subset_iff.mpr hmem)
  refine Subgroup.normalClosure_le_normal ?_
  rintro g ⟨i, j, hij, b, hb, rfl⟩
  have hb' : b ∈ normalCoefficientSet N := by
    have := hspan hb
    rwa [mem_normalCoefficientIdeal] at this
  exact hb' i j hij

/-- The same at `ι = Fin n` with the printed rank restriction, where the third
index is supplied by `exists_third_index`. -/
theorem relativeElementary_span_le_fin {n : ℕ} (hn : 3 ≤ n)
    (N : Subgroup (elementaryGroup (Fin n) R)) [N.Normal]
    {p q : Fin n} (hpq : p ≠ q) {a : R} (h : elGen p q hpq a ∈ N) :
    relativeElementary (Fin n) (TwoSidedIdeal.span {a}) ≤ N :=
  relativeElementary_span_le N (exists_third_index hn) hpq h

end Conclusion

end TorsionComplementaryIdempotents
