import GroupApproximation.Manuscript.OneSidedMFRadical.TorsionComplementaryIdempotentsIdeal
import GroupApproximation.Leavitt.ElementaryWeylMonomial
import GroupApproximation.Meta.AxiomGuard
import Mathlib.RingTheory.TwoSidedIdeal.Operations

/-!
# "hence every `e_{ij}(aeb)` by the Steinberg relations and signed permutations"

`non_mf_groups_exist.tex`, Proposition `prop:torsion-defect-ring`, the end of
its proof (tex lines 1112--1117):

> Then `[z, e_{41}(f_{20})] = e_{41}(f_{10})`, `[e_{24}(t), e_{41}(f_{10})] = e_{21}(e)`
> are killed, hence every `e_{ij}(aeb)` by the Steinberg relations and signed
> permutations, hence `EL_n(R,ReR)`.

and its first sentence (tex line 1084):

> If `e = 0`, then `ReR = 0` and `EL_n(R,ReR) = 1`, so assume `e ≠ 0`.

This module follows the printed route step by step, for an arbitrary normal
subgroup `N` of `EL_ι(R)` (the kernel of a homomorphism to an MF group, in the
application):

* **the Steinberg relations.**  From `e_{pq}(e) ∈ N` and a third index `k`,
  `[e_{kp}(a), e_{pq}(e)] = e_{kq}(ae)` and then
  `[e_{kq}(ae), e_{qp}(b)] = e_{kp}(aeb)` lie in `N`
  (`steinberg_sandwich_mem`);
* **signed permutations.**  Conjugation by the signed permutation matrix
  `w_{uv} = e_{uv}(1)e_{vu}(-1)e_{uv}(1)` (`ElementaryWeyl.weyl`) carries
  `e_{pq}(x)` to `e_{σp,σq}(±x)` with `σ` the transposition of `u` and `v`; two
  of them carry any position to any other, and the sign is an inverse
  (`elGen_mem_of_ne_signedPermutation`);
* **hence `EL_n(R,ReR)`.**  `ReR` is the additive subgroup generated by the
  products `aeb` (Mathlib's `TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure`),
  the coefficients `x` with `e_{ij}(x) ∈ N` form an additive subgroup because
  `e_{ij}(x)e_{ij}(y) = e_{ij}(x+y)`, and `EL_n(R,ReR)` is the normal closure of
  the roots with coefficients in `ReR` (`relativeElementary_span_le_of_elGen_mem`).

`TorsionComplementaryIdempotentsIdeal` proves the same conclusion by another
route (a coefficient ideal and a propagation by Steinberg moves only); the
printed proof uses signed permutations, and so does this module.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace TorsionComplementaryIdempotents

open scoped Pointwise

universe u

section SignedPermutations

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {R : Type u} [Ring R]
variable {N : Subgroup (elementaryGroup ι R)} [N.Normal]

/-! ## The Steinberg relations -/

/-- **Printed: "by the Steinberg relations".**  If `N ⊴ EL_ι(R)` contains
`e_{pq}(x)` and `k ∉ {p,q}`, then `N` contains `e_{kp}(axb)` for all `a, b`:
`[e_{kp}(a), e_{pq}(x)] = e_{kq}(ax)` and `[e_{kq}(ax), e_{qp}(b)] = e_{kp}(axb)`. -/
theorem steinberg_sandwich_mem {p q k : ι} (hpq : p ≠ q) (hkp : k ≠ p) (hkq : k ≠ q)
    {x : R} (hx : elGen p q hpq x ∈ N) (a b : R) :
    elGen k p hkp (a * x * b) ∈ N := by
  have h1 : elGen k q hkq (a * x) ∈ N := by
    rw [← elGen_commutator k p q hkp hpq hkq a x]
    exact commutatorRight_mem (elGen k p hkp a) hx
  rw [← elGen_commutator k q p hkq (Ne.symm hpq) hkp (a * x) b]
  exact commutatorLeft_mem h1 (elGen q p (Ne.symm hpq) b)

/-! ## Signed permutations -/

/-- **One signed permutation matrix.**  Conjugation by `w_{uv}` carries
`e_{pq}(x) ∈ N` to `e_{σp,σq}(x) ∈ N`, where `σ` is the transposition of `u` and
`v`; when the conjugate is `e_{σp,σq}(-x)`, its inverse is `e_{σp,σq}(x)`. -/
theorem elGen_mem_weyl_swap {u v : ι} (huv : u ≠ v) {p q : ι} (hpq : p ≠ q)
    {p' q' : ι} (hp : Equiv.swap u v p = p') (hq : Equiv.swap u v q = q')
    (hp'q' : p' ≠ q') {x : R} (hmem : elGen p q hpq x ∈ N) :
    elGen p' q' hp'q' x ∈ N := by
  have hconj : ElementaryWeyl.weyl (S := R) u v huv * elGen p q hpq x
      * (ElementaryWeyl.weyl (S := R) u v huv)⁻¹ ∈ N :=
    ‹N.Normal›.conj_mem _ hmem _
  rcases ElementaryWeyl.weyl_conj_elGen u v huv hpq hp hq hp'q' x with h | h
  · rwa [h] at hconj
  · rw [h] at hconj
    have hinv := N.inv_mem hconj
    rwa [← ElementaryWeyl.elGen_neg_eq_inv, neg_neg] at hinv

/-- Moving the second index with one signed permutation: from `e_{uk}(x) ∈ N` to
`e_{uv}(x) ∈ N`, by `w_{kv}`, which fixes `u` and carries `k` to `v`. -/
theorem elGen_mem_of_source {u k : ι} (huk : u ≠ k) {x : R}
    (hmem : elGen u k huk x ∈ N) {v : ι} (huv : u ≠ v) : elGen u v huv x ∈ N := by
  by_cases hkv : k = v
  · subst hkv
    exact hmem
  · exact elGen_mem_weyl_swap hkv huk (Equiv.swap_apply_of_ne_of_ne huk huv)
      (Equiv.swap_apply_left k v) huv hmem

/-- **Printed: "signed permutations".**  If `N ⊴ EL_ι(R)` contains `e_{jk}(x)`,
then it contains `e_{uv}(x)` for every `u ≠ v`: at most two signed permutation
matrices carry the position `(j,k)` to `(u,v)`. -/
theorem elGen_mem_of_ne_signedPermutation {j k : ι} (hjk : j ≠ k) {x : R}
    (hmem : elGen j k hjk x ∈ N) {u v : ι} (huv : u ≠ v) : elGen u v huv x ∈ N := by
  by_cases hju : j = u
  · subst hju
    exact elGen_mem_of_source hjk hmem huv
  · by_cases hku : k = u
    · subst hku
      exact elGen_mem_of_source (Ne.symm hjk)
        (elGen_mem_weyl_swap hju hjk (Equiv.swap_apply_left j k)
          (Equiv.swap_apply_right j k) (Ne.symm hjk) hmem) huv
    · exact elGen_mem_of_source (Ne.symm hku)
        (elGen_mem_weyl_swap hju hjk (Equiv.swap_apply_left j u)
          (Equiv.swap_apply_of_ne_of_ne (Ne.symm hjk) hku) (Ne.symm hku) hmem) huv

/-- **Printed: "hence every `e_{ij}(aeb)` by the Steinberg relations and signed
permutations".**  With three indices available, one root `e_{pq}(e) ∈ N` puts
`e_{ij}(aeb)` in `N` for every position `i ≠ j` and all `a, b ∈ R`. -/
theorem elGen_sandwich_mem_of_elGen_mem
    (hthree : ∀ i j : ι, ∃ k : ι, k ≠ i ∧ k ≠ j) {p q : ι} (hpq : p ≠ q) {e : R}
    (hmem : elGen p q hpq e ∈ N) (i j : ι) (hij : i ≠ j) (a b : R) :
    elGen i j hij (a * e * b) ∈ N := by
  obtain ⟨k, hkp, hkq⟩ := hthree p q
  exact elGen_mem_of_ne_signedPermutation hkp (steinberg_sandwich_mem hpq hkp hkq hmem a b) hij

/-! ## Hence `EL_n(R, ReR)` -/

variable (N) in
/-- The coefficients `x` with `e_{ij}(x) ∈ N` at one position form an additive
subgroup: `e_{ij}(x)e_{ij}(y) = e_{ij}(x+y)` and `e_{ij}(-x) = e_{ij}(x)^{-1}`. -/
def positionCoefficients {i j : ι} (hij : i ≠ j) : AddSubgroup R where
  carrier := {x | elGen i j hij x ∈ N}
  zero_mem' := by
    show elGen i j hij 0 ∈ N
    rw [elGen_zero]
    exact N.one_mem
  add_mem' := fun {a b} ha hb ↦ by
    show elGen i j hij (a + b) ∈ N
    rw [← elGen_mul]
    exact N.mul_mem ha hb
  neg_mem' := fun {a} ha ↦ by
    show elGen i j hij (-a) ∈ N
    rw [ElementaryWeyl.elGen_neg_eq_inv]
    exact N.inv_mem ha

/-- **Printed: "hence `EL_n(R,ReR)`".**  If `N ⊴ EL_ι(R)` contains one root
`e_{pq}(e)`, it contains the relative elementary group `EL_ι(R, ReR)`: every
element of `ReR` is a finite sum of products `aeb`, and `e_{ij}` of a sum is the
product of the `e_{ij}` of the terms. -/
theorem relativeElementary_span_le_of_elGen_mem
    (hthree : ∀ i j : ι, ∃ k : ι, k ≠ i ∧ k ≠ j) {p q : ι} (hpq : p ≠ q) {e : R}
    (hmem : elGen p q hpq e ∈ N) :
    relativeElementary ι (TwoSidedIdeal.span ({e} : Set R)) ≤ N := by
  have hideal : ∀ (i j : ι) (hij : i ≠ j) (x : R),
      x ∈ TwoSidedIdeal.span ({e} : Set R) → elGen i j hij x ∈ N := by
    intro i j hij x hx
    rw [TwoSidedIdeal.mem_span_iff_mem_addSubgroup_closure] at hx
    have hle : AddSubgroup.closure (Set.univ * ({e} : Set R) * Set.univ) ≤
        positionCoefficients N hij := by
      rw [AddSubgroup.closure_le]
      rintro _ ⟨_, ⟨a, -, e', he', rfl⟩, b, -, rfl⟩
      rw [Set.mem_singleton_iff] at he'
      rw [he']
      exact elGen_sandwich_mem_of_elGen_mem hthree hpq hmem i j hij a b
    exact hle hx
  show Subgroup.normalClosure (relativeElementarySet ι (TwoSidedIdeal.span ({e} : Set R))) ≤ N
  refine Subgroup.normalClosure_le_normal ?_
  rintro g ⟨i, j, hij, a, ha, rfl⟩
  exact hideal i j hij a ha

end SignedPermutations

/-! ## The rank-`n` reading, and the case `e = 0` -/

section Fin

variable {R : Type u} [Ring R]

/-- **Printed:** "hence every `e_{ij}(aeb)` by the Steinberg relations and signed
permutations, hence `EL_n(R,ReR)`", at rank `n ≥ 3`. -/
theorem relativeElementary_span_le_of_elGen_mem_fin {n : ℕ} (hn : 3 ≤ n)
    (N : Subgroup (elementaryGroup (Fin n) R)) [N.Normal] {p q : Fin n} (hpq : p ≠ q)
    {e : R} (hmem : elGen p q hpq e ∈ N) :
    relativeElementary (Fin n) (TwoSidedIdeal.span ({e} : Set R)) ≤ N :=
  relativeElementary_span_le_of_elGen_mem
    (TorsionComplementaryIdempotents.exists_third_index hn) hpq hmem

/-- **Printed: "`ReR = 0`".**  The two-sided ideal generated by `0` is `0`. -/
theorem twoSidedIdeal_span_zero : TwoSidedIdeal.span ({0} : Set R) = ⊥ := by
  refine le_antisymm ?_ bot_le
  rw [TwoSidedIdeal.span_le]
  intro x hx
  exact TwoSidedIdeal.mem_bot.mpr hx

/-- **Printed: "`EL_n(R,ReR) = 1`".**  The relative elementary group of the zero
ideal is trivial. -/
theorem relativeElementary_bot {ι : Type*} [Fintype ι] [DecidableEq ι] :
    relativeElementary ι (⊥ : TwoSidedIdeal R) = ⊥ := by
  rw [eq_bot_iff]
  show Subgroup.normalClosure (relativeElementarySet ι (⊥ : TwoSidedIdeal R)) ≤ ⊥
  refine Subgroup.normalClosure_le_normal ?_
  rintro g ⟨i, j, hij, a, ha, rfl⟩
  rw [TwoSidedIdeal.mem_bot.mp ha, elGen_zero]
  exact (⊥ : Subgroup (elementaryGroup ι R)).one_mem

/-- **Printed:** "If `e = 0`, then `ReR = 0` and `EL_n(R,ReR) = 1`." -/
theorem relativeElementary_span_zero {ι : Type*} [Fintype ι] [DecidableEq ι] :
    relativeElementary ι (TwoSidedIdeal.span ({0} : Set R)) = ⊥ := by
  rw [twoSidedIdeal_span_zero, relativeElementary_bot]

end Fin

end TorsionComplementaryIdempotents
