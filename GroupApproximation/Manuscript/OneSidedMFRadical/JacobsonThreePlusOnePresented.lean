import GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonPresented
import GroupApproximation.Manuscript.NonMFSentences.EJZCitationSentences
import GroupApproximation.PropertyT.FinitelyGeneratedRingPermanence

/-!
# Three coordinates carry `(T)`, the fourth compresses, for the presented algebra

`non_mf_groups_exist.tex`, the remark after `prop:torsion-defect-ring`
(tex lines 1155--1157), about `J = F_2⟨s,t | ts=1⟩` and `G = EL_4(J)`:

> Three coordinates carry property (T) [EJZ, Theorem 1.1], and the fourth makes the
> compression by `s` invertible.

`JacobsonRankFour` proves both halves as theorems whose type is a `∀`, and
`EJZCitationSentences` closes only the first half, for the operator model `jacobsonAlgebra`.
This module packages the whole sentence in named Props with closed audits.

* `PrintedThreePlusOneGeneral`: for every finitely generated unital ring `A`, the core
  `EL_3(A)` in coordinates `0,1,2` of `EL_4(A)` has property (T); for every pair `t s = 1`
  in every ring, `EL_3(A)` embeds onto the core, the fourth coordinate is outside it, and the
  compressor `u ∈ EL_4(A)` conjugates `e_{ij}(a)` to `e_{ij}(s a t)`, so `u L u⁻¹ ≤ L`.
  The theorem of Ershov--Jaikin-Zapirain is proved in the repository
  (`IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT`).
* `PrintedThreePlusOnePresented`: the same at the presented `J`, with `s, t` the printed
  generators. `J` is finitely generated, being isomorphic to `jacobsonAlgebra`. The matrix of
  `u` is invertible with the printed inverse.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace JacobsonPresented

open OneSidedCompressor

/-- The printed pair `t s = 1` of the presented algebra. -/
def presPair : OneSidedInverse ToeplitzJacobson := ⟨presS, presT, presT_mul_presS⟩

/-- The presented `J` is a finitely generated ring: it is isomorphic to the subring of
`End(F_2[X])` generated by the two shifts. -/
theorem isFinitelyGeneratedRing_toeplitzJacobson : IsFinitelyGeneratedRing ToeplitzJacobson :=
  NonMFSentences.EJZCitationSentences.isFinitelyGeneratedRing_jacobsonAlgebra.of_surjective
    jacobsonEquiv.symm.toRingHom jacobsonEquiv.symm.surjective

/-- **Printed (tex 1155--1157), for every ring.**  Three coordinates carry property (T), and
the fourth makes the compression by `s` invertible. -/
def PrintedThreePlusOneGeneral : Prop :=
  (∀ (A : Type) [Ring A], IsFinitelyGeneratedRing A → HasKazhdanPropertyT.{0, 0} (core A)) ∧
    ∀ (A : Type) [Ring A] (P : OneSidedInverse A),
      Function.Injective (coreEmbedding (R := A)) ∧ (coreEmbedding (R := A)).range = core A ∧
        (∀ i : Fin 3, coreIdx i ≠ lastIdx) ∧
        (∀ (i j : Fin 3) (hij : i ≠ j) (a : A),
          compressor P * elementaryRoot (coreIdx i) (coreIdx j) (coreIdx_injective.ne hij) a *
              (compressor P)⁻¹ =
            elementaryRoot (coreIdx i) (coreIdx j) (coreIdx_injective.ne hij) (P.s * a * P.t)) ∧
        ∀ g ∈ core A, compressor P * g * (compressor P)⁻¹ ∈ core A

theorem manuscriptSentence_threePlusOneGeneral : PrintedThreePlusOneGeneral :=
  ⟨JacobsonRankFour.manuscriptSentence_threeCoordinatesCarryPropertyT,
    JacobsonRankFour.manuscriptSentence_fourthCoordinateMakesCompressionInvertible⟩

/-- **Printed (tex 1155--1157), at the presented `J`.**  `J` is finitely generated and the
core `L = EL_3(J)` on the first three coordinates of `EL_4(J)` has property (T); `EL_3(J)`
embeds onto `L`, the fourth coordinate is outside it, and the compressor `u ∈ EL_4(J)` of
`t s = 1` conjugates `e_{ij}(a)` to `e_{ij}(s a t)` on `L`, so `u L u⁻¹ ≤ L`; the matrix of `u`
is invertible with the printed inverse. -/
def PrintedThreePlusOnePresented : Prop :=
  IsFinitelyGeneratedRing ToeplitzJacobson ∧
    HasKazhdanPropertyT.{0, 0} (core ToeplitzJacobson) ∧
    Function.Injective (coreEmbedding (R := ToeplitzJacobson)) ∧
    (coreEmbedding (R := ToeplitzJacobson)).range = core ToeplitzJacobson ∧
    (∀ i : Fin 3, coreIdx i ≠ lastIdx) ∧
    (∀ (i j : Fin 3) (hij : i ≠ j) (a : ToeplitzJacobson),
      compressor presPair *
          elementaryRoot (coreIdx i) (coreIdx j) (coreIdx_injective.ne hij) a *
          (compressor presPair)⁻¹ =
        elementaryRoot (coreIdx i) (coreIdx j) (coreIdx_injective.ne hij)
          (presS * a * presT)) ∧
    (∀ g ∈ core ToeplitzJacobson,
      compressor presPair * g * (compressor presPair)⁻¹ ∈ core ToeplitzJacobson) ∧
    compressorMatrix presPair * compressorInvMatrix presPair = 1 ∧
    compressorInvMatrix presPair * compressorMatrix presPair = 1

theorem manuscriptSentence_threePlusOnePresented : PrintedThreePlusOnePresented :=
  ⟨isFinitelyGeneratedRing_toeplitzJacobson,
    JacobsonRankFour.manuscriptSentence_threeCoordinatesCarryPropertyT ToeplitzJacobson
      isFinitelyGeneratedRing_toeplitzJacobson,
    coreEmbedding_injective, coreEmbedding_range, coreIdx_ne_last,
    compressor_conj_root presPair, compressor_compresses_core presPair,
    compressorMatrix_mul_inv presPair, compressorInvMatrix_mul presPair⟩

end JacobsonPresented
end OneSidedMFRadical
end Manuscript
end GroupApproximation

#audit_closed_axioms GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonPresented.isFinitelyGeneratedRing_toeplitzJacobson
#audit_closed_axioms GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonPresented.manuscriptSentence_threePlusOneGeneral
#audit_closed_axioms GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonPresented.manuscriptSentence_threePlusOnePresented
