import GroupApproximation.Manuscript.OneSidedMFRadical.FullDefectRingRankTwo
import GroupApproximation.Algebra.PurelyInfiniteSimpleRing

/-!
# The intersection of the kernels of all homomorphisms to MF groups

`non_mf_groups_exist.tex`, Theorem `thm:mf-quotient-units`:

> let `N_n` be the intersection of the kernels of all homomorphisms from
> `GL_n(R)` to MF groups.

This module names that subgroup, `mfHomKernel`, and proves the one general fact
the printed proof uses about it, together with the printed display
`eq:corner-units`.

## What `eq:corner-units` actually asserts

> if `e` and `P` are nonzero idempotents and `θ : M_m(eRe) → PRP` is a ring
> isomorphism, then `1 - P + θ(A) ∈ N` for `A ∈ EL_m(eRe)`, since these units
> form the image of `EL_m(eRe)` under a homomorphism to `H`.

The printed justification is the whole content: the units in question are the
image of a *group homomorphism* whose source has no nontrivial homomorphism to
an MF group, and the image of such a group lands in the intersection of all
those kernels for a reason that has nothing to do with rings.  That reason is
`range_le_mfHomKernel`.

So the corner ring `eRe` never has to be constructed.  What enters is
`cornerUnitSubgroup`: the subgroup of `Rˣ` generated by the images of the
elementary groups `EL_m(S)`, `m ≥ 2`, over *any* countable ring `S` carrying a
one-sided inverse pair with full complementary idempotent.  Ara--Goodearl--Pardo
Proposition 1.5 says the corners `eRe` of a purely infinite simple ring are
such rings; taking the subgroup over all of them rather than over the corners
only makes the target larger, which is the safe direction, since the printed
proof uses membership in it as a hypothesis and containment in `N` as a
conclusion.

`cornerUnitSubgroup_le_mfHomKernel` is `eq:corner-units`, and it is where
Theorem `thm:full-defect-ring` enters this proof: through its rank-two form
`FullDefectRankTwo.PrintedFullComplementaryIdempotentsRankTwo`, which is
exactly the printed sentence "every homomorphism from `EL_m(eRe)`, `m ≥ 2`, to
an MF group is trivial".

## Relation to the corona radicals

`Sofic.actualCoronaMFResidual` and `Sofic.manuscriptCoronaMFResidual` are the
intersections of the kernels of all norm-matrix *corona representations*, which
is a different quantification: over representations into corona unitary groups
rather than over homomorphisms to MF groups.  The two are related by
`manuscriptFullRadicalKillsMFTargets`, but neither is defined in terms of the
other and no bridge is used here.
-/

namespace GroupApproximation
namespace MFQuotientUnits

open Manuscript.OneSidedMFRadical

/-! ### The printed subgroup `N` -/

/-- **Printed:** the intersection of the kernels of all homomorphisms from `G`
to MF groups. -/
def mfHomKernel (G : Type) [Group G] : Subgroup G :=
  ⨅ (M : Type) (_ : Group M) (_ : IsOperatorMF M) (f : G →* M), f.ker

theorem mem_mfHomKernel_iff {G : Type} [Group G] (x : G) :
    x ∈ mfHomKernel G ↔
      ∀ (M : Type) [Group M], IsOperatorMF M → ∀ f : G →* M, f x = 1 := by
  constructor
  · intro hx M _ hM f
    have h1 := Subgroup.mem_iInf.mp hx M
    have h2 := Subgroup.mem_iInf.mp h1 ‹Group M›
    have h3 := Subgroup.mem_iInf.mp h2 hM
    exact Subgroup.mem_iInf.mp h3 f
  · intro hx
    refine Subgroup.mem_iInf.mpr fun M ↦ Subgroup.mem_iInf.mpr fun _ ↦
      Subgroup.mem_iInf.mpr fun hM ↦ Subgroup.mem_iInf.mpr fun f ↦ ?_
    exact hx M hM f

instance mfHomKernel_normal (G : Type) [Group G] : (mfHomKernel G).Normal := by
  constructor
  intro x hx g
  refine (mem_mfHomKernel_iff _).mpr fun M _ hM f ↦ ?_
  have hxf : f x = 1 := (mem_mfHomKernel_iff x).mp hx M hM f
  rw [map_mul, map_mul, hxf, mul_one, map_inv, mul_inv_cancel]

/-- The printed `N` is trivial on nothing more than what every MF-target
homomorphism kills, so a group whose MF-target homomorphisms are all trivial
has `N = ⊤`. -/
theorem mfHomKernel_eq_top_iff {G : Type} [Group G] :
    mfHomKernel G = ⊤ ↔
      ∀ (M : Type) [Group M], IsOperatorMF M → ∀ (f : G →* M) (x : G), f x = 1 := by
  constructor
  · intro htop M _ hM f x
    have hx : x ∈ mfHomKernel G := by rw [htop]; exact Subgroup.mem_top x
    exact (mem_mfHomKernel_iff x).mp hx M hM f
  · intro h
    rw [Subgroup.eq_top_iff']
    intro x
    exact (mem_mfHomKernel_iff x).mpr fun M _ hM f ↦ h M hM f x

/-! ### The reason `eq:corner-units` holds -/

/-- **The printed justification of `eq:corner-units`, in general form.**  The
image of a group with no nontrivial homomorphism to an MF group lies in the
intersection of the kernels of all homomorphisms to MF groups.  Nothing about
rings is involved. -/
theorem range_le_mfHomKernel {G H : Type} [Group G] [Group H] (φ : G →* H)
    (hG : ∀ (M : Type) [Group M], IsOperatorMF M →
      ∀ (f : G →* M) (x : G), f x = 1) :
    φ.range ≤ mfHomKernel H := by
  rintro _ ⟨x, rfl⟩
  refine (mem_mfHomKernel_iff _).mpr fun M _ hM f ↦ ?_
  exact hG M hM (f.comp φ) x

/-! ### The corner units -/

/-- **The printed display `eq:corner-units`, as a subgroup.**  Generated by the
images of the elementary groups `EL_m(S)`, `m ≥ 2`, over countable rings `S`
carrying a one-sided inverse pair whose complementary idempotent is full.

The corners `eRe` of a countable purely infinite simple ring are such rings, by
Ara--Goodearl--Pardo Proposition 1.5 together with simplicity of `eRe`; that is
the only way this subgroup is populated in the printed proof, and it is
supplied as a named input rather than constructed here. -/
def cornerUnitSubgroup (R : Type) [Ring R] : Subgroup Rˣ :=
  ⨆ (S : Type) (_ : Ring S) (_ : Countable S) (s : S) (t : S) (_ : t * s = 1)
    (_ : ∃ (m : ℕ) (a b : Fin m → S), ∑ k, a k * (1 - s * t) * b k = 1)
    (n : ℕ) (_ : 2 ≤ n) (φ : elementaryGroup (Fin n) S →* Rˣ), φ.range

/-- A single corner-unit family sits inside the corner-unit subgroup. -/
theorem le_cornerUnitSubgroup {R : Type} [Ring R] (S : Type) [Ring S]
    [Countable S] (s t : S) (hts : t * s = 1)
    (hfull : ∃ (m : ℕ) (a b : Fin m → S), ∑ k, a k * (1 - s * t) * b k = 1)
    (n : ℕ) (hn : 2 ≤ n) (φ : elementaryGroup (Fin n) S →* Rˣ) :
    φ.range ≤ cornerUnitSubgroup R := by
  refine le_iSup_of_le S ?_
  refine le_iSup_of_le ‹Ring S› ?_
  refine le_iSup_of_le ‹Countable S› ?_
  refine le_iSup_of_le s ?_
  refine le_iSup_of_le t ?_
  refine le_iSup_of_le hts ?_
  refine le_iSup_of_le hfull ?_
  refine le_iSup_of_le n ?_
  refine le_iSup_of_le hn ?_
  exact le_iSup_of_le φ le_rfl

/-- **`eq:corner-units`.**  Every corner unit lies in the intersection of the
kernels of all homomorphisms to MF groups.

This is where Theorem `thm:full-defect-ring` enters the proof of
`thm:mf-quotient-units`, in its rank-two form: the printed sentence "every
homomorphism from `EL_m(eRe)`, `m ≥ 2`, to an MF group is trivial". -/
theorem cornerUnitSubgroup_le_mfHomKernel
    (hB : FullDefectRankTwo.PrintedFullComplementaryIdempotentsRankTwo)
    (R : Type) [Ring R] : cornerUnitSubgroup R ≤ mfHomKernel Rˣ := by
  refine iSup_le fun S ↦ iSup_le fun _ ↦ iSup_le fun _ ↦ iSup_le fun s ↦
    iSup_le fun t ↦ iSup_le fun hts ↦ iSup_le fun hfull ↦ iSup_le fun n ↦
      iSup_le fun hn ↦ iSup_le fun φ ↦ ?_
  refine range_le_mfHomKernel φ ?_
  intro M _ hM f x
  exact hB S s t hts hfull n hn M hM f x

end MFQuotientUnits
end GroupApproximation
