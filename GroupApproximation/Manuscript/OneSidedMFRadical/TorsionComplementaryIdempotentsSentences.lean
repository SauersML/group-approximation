/-- **Printed:** `d = [vcv^{-1}, ℓ]` lies in `𝔇_B(L)`. -/
theorem printedDefectElt_mem_printedDefect :
    (⟨printedDefectElt P, printedDefectElt_mem_printedB P⟩ : ↥(printedB P)) ∈
      printedDefect (coreOfB P) := by
  set v' : ↥(printedB P) := ⟨printedV P, printedV_mem_printedB P⟩
  set c' : ↥(printedB P) := ⟨printedC P, printedC_mem_printedB P⟩
  set l' : ↥(printedB P) := ⟨printedEllTwoOne R, printedEllTwoOne_mem_printedB P⟩
  have hvcomp : ∀ δ ∈ coreOfB P, v' * δ * v'⁻¹ ∈ coreOfB P := by
    intro δ hδ
    rw [coreOfB, Subgroup.mem_subgroupOf] at hδ ⊢
    exact printedV_compresses_core P _ hδ
  have hccomm : ∀ δ ∈ coreOfB P, Commute c' δ := by
    intro δ hδ
    rw [coreOfB, Subgroup.mem_subgroupOf] at hδ
    exact Subtype.ext (printedC_commute_core P _ hδ)
  have hlmem : l' ∈ coreOfB P := by
    rw [coreOfB, Subgroup.mem_subgroupOf]
    exact printedEllTwoOne_mem_core
  have hd : ⁅v' * c' * v'⁻¹, l'⁆ ∈ printedDefect (coreOfB P) :=
    printedDefect_generator_mem (coreOfB P) hvcomp hccomm hlmem
  have hval : ⁅v' * c' * v'⁻¹, l'⁆ =
      (⟨printedDefectElt P, printedDefectElt_mem_printedB P⟩ : ↥(printedB P)) := by
    refine Subtype.ext ?_
    show ⁅printedV P * printedC P * (printedV P)⁻¹, printedEllTwoOne R⁆ = printedDefectElt P
    rw [printedV_conj_printedC P, printedDefectElt_eq P]
  rwa [hval] at hd

/-- **Printed:** "Theorem `thm:compression-criterion` applied to `B` kills `z` under
every homomorphism from `B` … to an MF group." -/
theorem printedBZ_killed [Countable R]
    (hT : HasKazhdanPropertyT.{0, 0} (elementaryGroup (Fin 3) R))
    {m : ℕ} (hm : 0 < m) (hme : m • P.e = 0)
    {M : Type} [Group M] (hM : IsOperatorMF M) (f : ↥(printedB P) →* M) :
    f (printedBZ P) = 1 := by
  haveI : Countable (elementaryGroup (Fin 4) R) :=
    FullDefectRing.countable_elementaryGroup
  haveI : Countable ↥(printedB P) := Subtype.countable
  haveI : Finite ↥(Subgroup.zpowers (printedBZ P)) :=
    printedBZ_zpowers_finite P hm hme
  have hKT : HasKazhdanPropertyT.{0, 0} ↥(Subgroup.zpowers (printedBZ P)) :=
    hasKazhdanPropertyT_of_finite _
  have hKD : Subgroup.zpowers (printedBZ P) ≤ printedDefect (coreOfB P) :=
    Subgroup.zpowers_le.mpr (printedBZ_mem_printedDefect P)
  have hres := (manuscriptOneSidedCompressionCriterion ↥(printedB P) (coreOfB P)
      (coreOfB_hasKazhdanPropertyT P hT)).1 (Subgroup.zpowers (printedBZ P)) hKT hKD
  exact killed_of_mem_manuscriptCoronaMFResidual hM f (hres (Subgroup.mem_zpowers _))

end FixedRing

