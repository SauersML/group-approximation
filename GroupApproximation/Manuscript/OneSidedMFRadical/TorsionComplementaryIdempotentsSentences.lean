theorem manuscriptSentence_rootNeOne :
    ∀ (R : Type) [Ring R] (n : ℕ) (hn : 4 ≤ n) (e : R), e ≠ 0 →
      elementaryRoot (bigIdx hn (coreIdx 1)) (bigIdx hn (coreIdx 0)) (torsionIndexNe hn) e
        ≠ 1 := by
  intro R _ n hn e he h
  apply he
  have hval : elementaryUnit (bigIdx hn (coreIdx 1)) (bigIdx hn (coreIdx 0))
      (torsionIndexNe hn) e
      = elementaryUnit (bigIdx hn (coreIdx 1)) (bigIdx hn (coreIdx 0))
        (torsionIndexNe hn) 0 := by
    rw [elementaryUnit_zero]
    exact congrArg
      (fun g : elementaryGroup (Fin n) R ↦ (g : (Matrix (Fin n) (Fin n) R)ˣ)) h
  exact elementaryUnit_injective _ _ (torsionIndexNe hn) hval

