theorem manuscriptSentence_criterionKillsCentralElement :
    ∀ (R : Type) [Ring R] [Countable R] (s t : R) (hts : t * s = 1) (m : ℕ), 0 < m →
      m • (1 - s * t) = 0 →
        (Subgroup.zpowers (printedBZ (pairSubringInverse s t hts))).Normal ∧
        Finite ↥(Subgroup.zpowers (printedBZ (pairSubringInverse s t hts))) ∧
        ((1 : R) - s * t ≠ 0 →
          Subgroup.zpowers (printedBZ (pairSubringInverse s t hts)) ≠ ⊥) ∧
        Subgroup.zpowers (printedBZ (pairSubringInverse s t hts)) ≤
          printedDefect (coreOfB (pairSubringInverse s t hts)) ∧
        (∀ (M : Type) [Group M], IsOperatorMF M →
          ∀ f : ↥(printedB (pairSubringInverse s t hts)) →* M,
            f (printedBZ (pairSubringInverse s t hts)) = 1) ∧
        ∀ (n : ℕ) (hn : 4 ≤ n) (M : Type) [Group M], IsOperatorMF M →
          ∀ f : elementaryGroup (Fin n) R →* M,
            f (pairToRank s t hn (printedZ (pairSubringInverse s t hts))) = 1 := by
  intro R _ _ s t hts m hm hme
  haveI : Countable ↥(Subring.closure ({s, t} : Set R)) := Subtype.countable
  have hT :=
    (NonMFSentences.HeadlineCitationSentences.manuscriptSentence_pairSubringElementaryPropertyT
      R s t).2
  have hmeS := pairSubringInverse_nsmul_e s t hts hme
  refine ⟨printedBZ_zpowers_normal _, printedBZ_zpowers_finite _ hm hmeS, ?_,
    Subgroup.zpowers_le.mpr (printedBZ_mem_printedDefect _),
    fun M _ hM f ↦ printedBZ_killed _ hT hm hmeS hM f,
    fun n hn M _ hM f ↦ printedZ_killed _ hT hm hmeS hM (f.comp (pairToRank s t hn))⟩
  intro he hbot
  have heS : (pairSubringInverse s t hts).e ≠ 0 := by
    intro h0
    apply he
    rw [← pairSubringInverse_e_coe s t hts, h0]
    simp
  rw [Subgroup.zpowers_eq_bot] at hbot
  exact printedZ_ne_one _ heS (congrArg Subtype.val hbot)

/-- > Then `[z,e_{41}(f_{20})]=e_{41}(f_{10})`, `[e_{24}(t),e_{41}(f_{10})]=e_{21}(e)`
> are killed,

(tex lines 1112--1117)  The two identities over every one-sided inverse pair, and the
killing at the printed `S`, in `EL_n(R)`. -/
theorem manuscriptSentence_twoCommutatorsKilled :
    (∀ (R : Type) [Ring R] (P : OneSidedInverse R),
      ⁅printedZ P, elementaryRoot lastIdx (coreIdx 0) (last_ne_coreIdx 0) (fUnit P 2 0)⁆ =
          elementaryRoot lastIdx (coreIdx 0) (last_ne_coreIdx 0) (fUnit P 1 0) ∧
        ⁅elementaryRoot (coreIdx 1) lastIdx (coreIdx_ne_last 1) P.t,
          elementaryRoot lastIdx (coreIdx 0) (last_ne_coreIdx 0) (fUnit P 1 0)⁆ =
          elementaryRoot (coreIdx 1) (coreIdx 0) (coreIdx_injective.ne oneNeZeroFin) P.e) ∧
    ∀ (R : Type) [Ring R] [Countable R] (s t : R) (hts : t * s = 1) (m : ℕ), 0 < m →
      m • (1 - s * t) = 0 → ∀ (n : ℕ) (hn : 4 ≤ n) (M : Type) [Group M], IsOperatorMF M →
        ∀ f : elementaryGroup (Fin n) R →* M,
          f (pairToRank s t hn (elementaryRoot lastIdx (coreIdx 0) (last_ne_coreIdx 0)
              (fUnit (pairSubringInverse s t hts) 1 0))) = 1 ∧
          f (pairToRank s t hn (elementaryRoot (coreIdx 1) (coreIdx 0)
              (coreIdx_injective.ne oneNeZeroFin) (pairSubringInverse s t hts).e)) = 1 := by
  refine ⟨fun _ _ P ↦ ⟨printedZ_commutator_root P, printedT_commutator_root P⟩, ?_⟩
  intro R _ _ s t hts m hm hme n hn M _ hM f
  haveI : Countable ↥(Subring.closure ({s, t} : Set R)) := Subtype.countable
  have hT :=
    (NonMFSentences.HeadlineCitationSentences.manuscriptSentence_pairSubringElementaryPropertyT
      R s t).2
  have hmeS := pairSubringInverse_nsmul_e s t hts hme
  have hz : printedZ (pairSubringInverse s t hts) ∈ (f.comp (pairToRank s t hn)).ker :=
    MonoidHom.mem_ker.mpr
      (printedZ_killed _ hT hm hmeS hM (f.comp (pairToRank s t hn)))
  have h41 : elementaryRoot lastIdx (coreIdx 0) (last_ne_coreIdx 0)
      (fUnit (pairSubringInverse s t hts) 1 0) ∈ (f.comp (pairToRank s t hn)).ker := by
    have := commutatorLeft_mem (N := (f.comp (pairToRank s t hn)).ker) hz
      (elementaryRoot lastIdx (coreIdx 0) (last_ne_coreIdx 0)
        (fUnit (pairSubringInverse s t hts) 2 0))
    rwa [← commutatorElement_def, printedZ_commutator_root] at this
  have h21 := commutatorRight_mem (N := (f.comp (pairToRank s t hn)).ker)
    (elementaryRoot (coreIdx 1) lastIdx (coreIdx_ne_last 1) (pairSubringInverse s t hts).t) h41
  rw [← commutatorElement_def, printedT_commutator_root] at h21
  exact ⟨MonoidHom.mem_ker.mp h41, MonoidHom.mem_ker.mp h21⟩

/-- > hence every `e_{ij}(aeb)` by the Steinberg relations and signed permutations,
> hence `EL_n(R,ReR)`.

(tex lines 1116--1117)  Along the printed route (`TorsionComplementaryIdempotentsSignedPermutations`):
two Steinberg commutators and at most two signed permutation matrices put every
`e_{ij}(aeb)` in the kernel, and `ReR` is the additive span of the `aeb`. -/
theorem manuscriptSentence_sandwichesAndRelativeElementaryKilled :
    ∀ (R : Type) [Ring R] [Countable R] (s t : R), t * s = 1 → ∀ m : ℕ, 0 < m →
      m • (1 - s * t) = 0 → ∀ n : ℕ, 4 ≤ n → ∀ (M : Type) [Group M], IsOperatorMF M →
        ∀ f : elementaryGroup (Fin n) R →* M,
          (∀ (i j : Fin n) (hij : i ≠ j) (a b : R),
            f (elGen i j hij (a * (1 - s * t) * b)) = 1) ∧
          relativeElementary (Fin n) (TwoSidedIdeal.span ({1 - s * t} : Set R)) ≤ f.ker := by
  intro R _ _ s t hts m hm hme n hn M _ hM f
  have hroot : elGen (bigIdx hn (coreIdx 1)) (bigIdx hn (coreIdx 0)) (torsionIndexNe hn)
      (1 - s * t) ∈ f.ker :=
    MonoidHom.mem_ker.mpr (printedRoot_killed s t hts hm hme hn hM f)
  have hthree := TorsionComplementaryIdempotents.exists_third_index (by omega : 3 ≤ n)
  exact ⟨fun i j hij a b ↦ MonoidHom.mem_ker.mp
      (elGen_sandwich_mem_of_elGen_mem hthree (torsionIndexNe hn) hroot i j hij a b),
    relativeElementary_span_le_of_elGen_mem hthree (torsionIndexNe hn) hroot⟩

