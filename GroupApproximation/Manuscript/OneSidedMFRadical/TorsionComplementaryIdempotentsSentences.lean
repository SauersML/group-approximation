/-! ## The printed `S`, the pair inside it, and the passage to `EL_n(R)` -/

/-- **Printed:** "let `S` be the unital subring generated by `s,t`"; the printed pair
`s, t` with `ts = 1`, read inside `S`. -/
def pairSubringInverse {R : Type} [Ring R] (s t : R) (hts : t * s = 1) :
    OneSidedInverse ↥(Subring.closure ({s, t} : Set R)) :=
  ⟨⟨s, Subring.subset_closure (by simp)⟩, ⟨t, Subring.subset_closure (by simp)⟩,
    Subtype.ext hts⟩

theorem pairSubringInverse_e_coe {R : Type} [Ring R] (s t : R) (hts : t * s = 1) :
    (((pairSubringInverse s t hts).e : ↥(Subring.closure ({s, t} : Set R))) : R)
      = 1 - s * t := by
  rw [OneSidedInverse.e_eq]
  push_cast
  rfl

theorem pairSubringInverse_nsmul_e {R : Type} [Ring R] (s t : R) (hts : t * s = 1)
    {m : ℕ} (hme : m • (1 - s * t) = 0) : m • (pairSubringInverse s t hts).e = 0 := by
  refine Subtype.ext ?_
  have hcoe : ((m • (pairSubringInverse s t hts).e : ↥(Subring.closure ({s, t} : Set R))) : R)
      = m • (((pairSubringInverse s t hts).e : ↥(Subring.closure ({s, t} : Set R))) : R) := by
    simp
  rw [hcoe, pairSubringInverse_e_coe, hme]
  simp

/-- The printed passage from `EL₄(S)` to `EL_n(R)`: "extended by `I_{n-4}`", then the
coefficient inclusion `S → R`. -/
noncomputable def pairToRank {R : Type} [Ring R] (s t : R) {n : ℕ} (hn : 4 ≤ n) :
    elementaryGroup (Fin 4) ↥(Subring.closure ({s, t} : Set R)) →*
      elementaryGroup (Fin n) R :=
  (elementaryGroupMap (ι := Fin n) (Subring.closure ({s, t} : Set R)).subtype).comp
    (blockEmbedding (R := ↥(Subring.closure ({s, t} : Set R))) hn)

