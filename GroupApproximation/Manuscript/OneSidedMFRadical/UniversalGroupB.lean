import GroupApproximation.Leavitt.UniversalOneSidedPairRing
import GroupApproximation.Manuscript.OneSidedMFRadical.FullDefectRingRankTwo
import GroupApproximation.Manuscript.OneSidedMFRadical.FullDefectRingEJZUnconditional
import GroupApproximation.Meta.AxiomGuard

/-!
# The universal group `B = EL₄(𝒞)`

`non_mf_groups_exist.tex`, `thm:full-defect-ring`:

> Every homomorphism from `B` to an MF group is trivial; the group `B` is
> finitely generated, has property~(T), and is normally generated by an element
> of order four; and there is a homomorphism from `B` to `EL_n(R)` whose image
> normally generates `EL_n(R)`.

This module carries three of those four clauses:

* property `(T)`, from the unconditional Ershov--Jaikin-Zapirain closure at the
  finitely generated ring `𝒞`;
* triviality of every homomorphism to an MF group, from the printed rank-four
  theorem at `𝒞` with `s = s₀`, `t = t₀` and the single fullness witness
  `t₁ e s₁ = 1`; and
* the homomorphism into `EL_n(R)` with normally generating image, for every
  `n ≥ 2`.

Finite generation and the order-four element `σ` are in the companion module.

## The homomorphism into `EL_n(R)`

The printed route is `B → EL₄(S) → EL₂(R)`, with `S` the subring generated by
the four elements.  Here it is `B → EL₄(R) → EL₂(R)`: the universal property of
`𝒞` gives a ring map `𝒞 → R` directly, so the subring never has to be named,
and the composite with the descent homomorphism `Ψ` of
`Leavitt.RankDescentEmbedding` has the same image.

For `n ≥ 3` the printed proof passes to the `(1,2)` copy.  The argument here is
that the *pullback* of the normal closure `N` of the image is a normal subgroup
of `EL₂(R)` containing `Ψ(e₁₂(1))`, hence all of `EL₂(R)` by the rank-two
lemma; so `N` contains the whole block copy of `EL₂(R)`, in particular the root
`e₁₂(v₀)`, whose coefficient is unit-sandwiched — and a sandwiched root
normally generates as soon as there are three indices.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace UniversalGroupB

open RankDescent
open UniversalPair

/-- **The printed group `B = EL₄(𝒞)`.** -/
noncomputable abbrev B : Type := elementaryGroup (Fin 4) UniversalPairRing

/-! ## The printed data at `𝒞` -/

/-- The printed `ts = 1` at `s = s₀`, `t = t₀`. -/
theorem printedPair : unit.w 0 * unit.v 0 = 1 := unit.w_mul_v_self 0

/-- **The printed fullness of `e = 1 - s₀t₀`**, with the single witness
`t₁ e s₁ = 1`. -/
theorem printedFullness :
    ∃ (m : ℕ) (a b : Fin m → UniversalPairRing),
      ∑ i, a i * (1 - unit.v 0 * unit.w 0) * b i = 1 :=
  unit.toOneSidedInverse_isFull

/-! ## Property `(T)` -/

/-- **`B` has property `(T)`.**  The ring `𝒞` is finitely generated, so the
Ershov--Jaikin-Zapirain theorem applies; the repository proves that theorem for
every finitely generated ring, so no citation and no hypothesis remain. -/
theorem hasKazhdanPropertyT : HasKazhdanPropertyT.{0, 0} B :=
  FullDefectRingEJZUnconditional.ejz UniversalPairRing
    UniversalPair.isFinitelyGeneratedRing 4 (by norm_num)

/-- **The printed `L = EL₃(𝒞)` has property `(T)`**, by the same theorem at
rank three. -/
theorem corner_hasKazhdanPropertyT :
    HasKazhdanPropertyT.{0, 0} (elementaryGroup (Fin 3) UniversalPairRing) :=
  FullDefectRingEJZUnconditional.ejz UniversalPairRing
    UniversalPair.isFinitelyGeneratedRing 3 (by norm_num)

/-! ## The MF radical of `B` -/

/-- **Every homomorphism from `B` to an MF group is trivial.**  This is the
printed rank-four theorem at the ring `𝒞`, which satisfies the printed
hypothesis by `printedPair` and `printedFullness`. -/
theorem hom_eq_one (M : Type) [Group M] (hM : IsOperatorMF M)
    (f : B →* M) (x : B) : f x = 1 :=
  FullDefectRingEJZUnconditional.manuscriptFullComplementaryIdempotentsAllCharacteristics
    UniversalPairRing (unit.v 0) (unit.w 0) printedPair printedFullness 4
    (by norm_num) M hM f x

/-! ## The homomorphism into every `EL_n(R)` -/

section Target

variable {R : Type} [Ring R] (Q : ProperlyInfiniteUnit R)

include Q

/-- The ring map `𝒞 → R` of the universal property, on elementary groups. -/
noncomputable def toElementaryFour : B →* elementaryGroup (Fin 4) R :=
  elementaryGroupMap (UniversalPair.lift Q).toRingHom

theorem toElementaryFour_root (i j : Fin 4) (hij : i ≠ j)
    (a : UniversalPairRing) :
    toElementaryFour Q (elementaryRoot i j hij a)
      = elementaryRoot i j hij (UniversalPair.lift Q a) := by
  apply Subtype.ext
  exact elementaryMatrixUnitMap_elementaryUnit _ i j hij a

/-- **The printed homomorphism `B → EL₂(R)`.** -/
noncomputable def toRankTwo : B →* elementaryGroup (Fin 2) R :=
  (descent Q).comp (toElementaryFour Q)

theorem toRankTwo_root_one :
    toRankTwo Q (elementaryRoot 0 1 (by decide) 1)
      = descent Q (elementaryRoot 0 1 (by decide) 1) := by
  show descent Q (toElementaryFour Q (elementaryRoot 0 1 (by decide) 1)) = _
  rw [toElementaryFour_root, map_one]

/-- **The image of `B` normally generates `EL₂(R)`.** -/
theorem normalClosure_toRankTwo_range :
    Subgroup.normalClosure
      ((toRankTwo Q).range : Set (elementaryGroup (Fin 2) R)) = ⊤ := by
  apply top_unique
  rw [← normalClosure_descent_root_eq_top Q]
  apply Subgroup.normalClosure_mono
  rintro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact ⟨elementaryRoot 0 1 (by decide) 1, toRankTwo_root_one Q⟩

/-- **The printed clause: for every `n ≥ 2` there is a homomorphism from `B` to
`EL_n(R)` whose image normally generates `EL_n(R)`.** -/
theorem exists_hom_normallyGenerating (n : ℕ) (hn : 2 ≤ n) :
    ∃ φ : B →* elementaryGroup (Fin n) R,
      Subgroup.normalClosure (φ.range : Set (elementaryGroup (Fin n) R)) = ⊤ := by
  rcases Nat.lt_or_ge n 3 with hlt | hge
  · have hn2 : n = 2 := by omega
    subst hn2
    exact ⟨toRankTwo Q, normalClosure_toRankTwo_range Q⟩
  · obtain ⟨k, rfl⟩ : ∃ k, n = 2 + k := ⟨n - 2, by omega⟩
    have hk : 1 ≤ k := by omega
    refine ⟨(FullDefectRankTwo.blockEmbed R k).comp (toRankTwo Q), ?_⟩
    set N := Subgroup.normalClosure
      (((FullDefectRankTwo.blockEmbed R k).comp (toRankTwo Q)).range :
        Set (elementaryGroup (Fin (2 + k)) R)) with hN
    haveI hNnormal : N.Normal := Subgroup.normalClosure_normal
    haveI : (N.comap (FullDefectRankTwo.blockEmbed R k)).Normal :=
      hNnormal.comap _
    have hpull : Subgroup.normalClosure
        ({descent Q (elementaryRoot 0 1 (by decide) 1)} :
          Set (elementaryGroup (Fin 2) R))
        ≤ N.comap (FullDefectRankTwo.blockEmbed R k) := by
      apply Subgroup.normalClosure_le_normal
      rintro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      refine Subgroup.mem_comap.mpr (Subgroup.subset_normalClosure ?_)
      exact ⟨elementaryRoot 0 1 (by decide) 1, by
        rw [MonoidHom.comp_apply, toRankTwo_root_one]⟩
    rw [normalClosure_descent_root_eq_top Q] at hpull
    have hroot : FullDefectRankTwo.blockEmbed R k (upperRoot (Q.v 0)) ∈ N :=
      Subgroup.mem_comap.mp (hpull (Subgroup.mem_top _))
    rw [FullDefectRankTwo.blockEmbed_upperRoot R k (Q.v 0)] at hroot
    have hcard : 3 ≤ Fintype.card (Fin (2 + k)) := by
      rw [Fintype.card_fin]
      omega
    have hsand : ∃ c d : R, c * Q.v 0 * d = 1 :=
      ⟨Q.w 0, 1, by rw [mul_one]; exact Q.w_mul_v_self 0⟩
    exact elementaryGroup_normal_eq_top_of_elementaryRoot_mem hcard N
      (FullDefectRankTwo.blockEmbed_ne k) hroot hsand

end Target

/-! ## The three clauses, as one proposition -/

/-- **Three of the four printed clauses about `B`**, as one closed
proposition: `B` has property `(T)`, every homomorphism from `B` to an MF group
is trivial, and for every ring with a properly infinite unit and every
`n ≥ 2` there is a homomorphism `B → EL_n(R)` with normally generating image.

Finite generation and the order-four normal generator are proved in the
companion module and joined there. -/
def PrintedUniversalGroupCore : Prop :=
  HasKazhdanPropertyT.{0, 0} B ∧
    (∀ (M : Type) [Group M], IsOperatorMF M →
      ∀ (f : B →* M) (x : B), f x = 1) ∧
    (∀ (R : Type) [Ring R], Nonempty (ProperlyInfiniteUnit R) →
      ∀ (n : ℕ), 2 ≤ n →
        ∃ φ : B →* elementaryGroup (Fin n) R,
          Subgroup.normalClosure (φ.range : Set (elementaryGroup (Fin n) R)) = ⊤)

theorem manuscriptUniversalGroupCore : PrintedUniversalGroupCore :=
  ⟨hasKazhdanPropertyT, hom_eq_one,
    fun _ _ hQ n hn ↦ exists_hom_normallyGenerating hQ.some n hn⟩

end UniversalGroupB
end OneSidedMFRadical
end Manuscript
end GroupApproximation

open GroupApproximation
open GroupApproximation.Manuscript.OneSidedMFRadical

#audit_closed_axioms UniversalGroupB.manuscriptUniversalGroupCore
