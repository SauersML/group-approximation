local instance sentenceHeadlineCountable : Countable H := countable

/-- **Sentence 53.**  The four canonical generators of the concrete binary
Leavitt algebra satisfy exactly its five displayed defining relations. -/
theorem manuscriptSentence53_binaryLeavittRelations :
    leavittFamily.t0 * leavittFamily.s0 = 1 ∧
      leavittFamily.t0 * leavittFamily.s1 = 0 ∧
      leavittFamily.t1 * leavittFamily.s0 = 0 ∧
      leavittFamily.t1 * leavittFamily.s1 = 1 ∧
      leavittFamily.s0 * leavittFamily.t0 +
        leavittFamily.s1 * leavittFamily.t1 = 1 :=
  ⟨leavittFamily.t0_s0, leavittFamily.t0_s1,
    leavittFamily.t1_s0, leavittFamily.t1_s1,
    leavittFamily.sum_range⟩

/-- **Sentence 54.**  `e_ij(a)` is the bundled elementary unit and
`EL_n(A)` is precisely the subgroup generated by all such units. -/
theorem manuscriptSentence54_elementaryRoot_and_elementaryGroup
    (n : ℕ) (A : Type*) [Ring A] :
    (∀ (i j : Fin n) (hij : i ≠ j) (a : A),
      (elementaryRoot i j hij a : (Matrix (Fin n) (Fin n) A)ˣ) =
        elementaryUnit i j hij a) ∧
      elementaryGroup (Fin n) A = Subgroup.closure
        {z | ∃ (i j : Fin n) (hij : i ≠ j) (a : A),
          elementaryUnit i j hij a = z} :=
  ⟨fun i j hij a ↦ elementaryRoot_val i j hij a, rfl⟩

/-- **Sentences 55--60.**  The complete six-clause headline for
`H = EL₁₂(L_{𝔽₂}(1,2))`. -/
theorem manuscriptSentences55_60_binaryLeavittHeadline :
