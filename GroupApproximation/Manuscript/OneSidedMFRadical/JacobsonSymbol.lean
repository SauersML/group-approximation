import GroupApproximation.Manuscript.OneSidedMFRadical.TorsionComplementaryIdempotentsJacobson
import GroupApproximation.Algebra.LaurentBinaryLinearMF
import Mathlib.Algebra.Polynomial.Laurent

/-!
# The symbol of the Toeplitz--Jacobson algebra

`non_mf_groups_exist.tex`, the remark after `prop:torsion-defect-ring`
(tex lines 1122--1124):

> The Toeplitz--Jacobson algebra `J = F_2⟨s,t | ts=1⟩` has `1-st ≠ 0` of order two,
> while `J/J(1-st)J ≅ F_2[z,z^{-1}] ≠ 0` …

`J` is the unital subring of `End(F_2[X])` generated by the shifts `s = X·` and
`t = divX` (`TorsionComplementaryIdempotents.jacobsonAlgebra`).  This module builds
the quotient map `J → F_2[z,z^{-1}]` as the *symbol*: an endomorphism `T` is banded
with symbol `p` when, on all high monomials, `T` acts as multiplication by `p`:

`toLaurent (T (X^N)) = p · T^N`   for all `N ≥ N₀`.

Banded endomorphisms with their symbols are closed under sums, negatives and
products, `1` has symbol `1`, `s` has symbol `z` and `t` has symbol `z^{-1}`.  So
every element of `J` is banded, its symbol is unique, and
`symbol : J →+* F_2[z,z^{-1}]` is a surjective ring homomorphism with
`symbol s = z`, `symbol t = z^{-1}` and `symbol (1 - st) = 0`.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace JacobsonSymbol

open TorsionComplementaryIdempotents LaurentPolynomial
open JacobsonLaurent (BinaryLaurent)

/-- `T` acts on high monomials as multiplication by the Laurent polynomial `p`. -/
def IsBandedWith (T : Module.End (ZMod 2) JacobsonSpace) (p : BinaryLaurent) : Prop :=
  ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
    Polynomial.toLaurent (T (Polynomial.X ^ N)) = p * LaurentPolynomial.T (N : ℤ)

namespace IsBandedWith

variable {T T₁ T₂ : Module.End (ZMod 2) JacobsonSpace} {p q p₁ p₂ : BinaryLaurent}

/-- The symbol is unique. -/
theorem unique (hp : IsBandedWith T p) (hq : IsBandedWith T q) : p = q := by
  obtain ⟨N₁, h₁⟩ := hp
  obtain ⟨N₂, h₂⟩ := hq
  have e := (h₁ (max N₁ N₂) (le_max_left _ _)).symm.trans (h₂ (max N₁ N₂) (le_max_right _ _))
  exact (isUnit_T _).mul_right_cancel e

theorem add (h₁ : IsBandedWith T₁ p₁) (h₂ : IsBandedWith T₂ p₂) :
    IsBandedWith (T₁ + T₂) (p₁ + p₂) := by
  obtain ⟨N₁, h₁⟩ := h₁
  obtain ⟨N₂, h₂⟩ := h₂
  refine ⟨max N₁ N₂, fun N hN ↦ ?_⟩
  rw [LinearMap.add_apply, map_add, h₁ N (le_of_max_le_left hN), h₂ N (le_of_max_le_right hN),
    add_mul]

theorem neg (h : IsBandedWith T p) : IsBandedWith (-T) (-p) := by
  obtain ⟨N₀, h⟩ := h
  refine ⟨N₀, fun N hN ↦ ?_⟩
  rw [LinearMap.neg_apply, map_neg, h N hN, neg_mul]

/-- A banded endomorphism maps high monomials to polynomial multiples of a fixed
shift. -/
theorem exists_eq_mul_X_pow (h : IsBandedWith T p) :
    ∃ (n N₀ : ℕ) (f : Polynomial (ZMod 2)), ∀ N : ℕ, N₀ + n ≤ N →
      T (Polynomial.X ^ N) = f * Polynomial.X ^ (N - n) ∧
        Polynomial.toLaurent f = p * LaurentPolynomial.T (n : ℤ) := by
  obtain ⟨N₀, hN₀⟩ := h
  obtain ⟨n, f, hf⟩ := exists_T_pow p
  refine ⟨n, N₀, f, fun N hN ↦ ⟨?_, hf⟩⟩
  apply Polynomial.toLaurent_injective
  rw [hN₀ N (by omega), map_mul, hf, Polynomial.toLaurent_X_pow, mul_assoc, ← T_add]
  congr 2
  omega

theorem mul (h₁ : IsBandedWith T₁ p₁) (h₂ : IsBandedWith T₂ p₂) :
    IsBandedWith (T₁ * T₂) (p₁ * p₂) := by
  classical
  obtain ⟨N₁, hN₁⟩ := h₁
  obtain ⟨n, N₂, f, hf⟩ := exists_eq_mul_X_pow h₂
  refine ⟨N₂ + n + N₁, fun N hN ↦ ?_⟩
  obtain ⟨hT₂, hfp⟩ := hf N (by omega)
  set m : ℕ := N - n with hm
  have hsum : f * Polynomial.X ^ m =
      ∑ i ∈ f.support, (f.coeff i) • Polynomial.X ^ (i + m) := by
    conv_lhs => rw [Polynomial.as_sum_support_C_mul_X_pow f]
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Polynomial.smul_eq_C_mul, pow_add, mul_assoc]
  rw [Module.End.mul_apply, hT₂, hsum, map_sum]
  simp only [map_smul]
  rw [map_sum]
  have hterm : ∀ i ∈ f.support,
      Polynomial.toLaurent ((f.coeff i) • T₁ (Polynomial.X ^ (i + m))) =
        p₁ * Polynomial.toLaurent ((f.coeff i) • Polynomial.X ^ (i + m)) := by
    intro i _
    rw [Polynomial.smul_eq_C_mul, Polynomial.smul_eq_C_mul, map_mul, map_mul,
      hN₁ (i + m) (by omega), Polynomial.toLaurent_X_pow, Polynomial.toLaurent_C]
    push_cast
    ring
  rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, ← map_sum, ← hsum, map_mul, hfp,
    Polynomial.toLaurent_X_pow, mul_assoc, mul_assoc, ← T_add]
  congr 3
  omega

end IsBandedWith

theorem isBandedWith_zero : IsBandedWith 0 0 :=
  ⟨0, fun N _ ↦ by rw [LinearMap.zero_apply, map_zero, zero_mul]⟩

theorem isBandedWith_one : IsBandedWith 1 1 :=
  ⟨0, fun N _ ↦ by rw [Module.End.one_apply, Polynomial.toLaurent_X_pow, one_mul]⟩

/-- `s` acts as multiplication by `z`. -/
theorem isBandedWith_shiftUp : IsBandedWith shiftUp (T 1) :=
  ⟨0, fun N _ ↦ by
    rw [shiftUp_apply, ← pow_succ', Polynomial.toLaurent_X_pow, ← T_add]
    congr 1
    push_cast
    ring⟩

/-- `t` acts on high monomials as multiplication by `z^{-1}`. -/
theorem isBandedWith_shiftDown : IsBandedWith shiftDown (T (-1)) :=
  ⟨1, fun N hN ↦ by
    rw [shiftDown_apply, Polynomial.divX_X_pow, if_neg (by omega), Polynomial.toLaurent_X_pow,
      ← T_add]
    congr 1
    omega⟩

/-- **Every element of `J` is banded.** -/
theorem exists_isBandedWith {x : Module.End (ZMod 2) JacobsonSpace} (hx : x ∈ jacobsonAlgebra) :
    ∃ p : BinaryLaurent, IsBandedWith x p := by
  induction hx using Subring.closure_induction with
  | mem y hy =>
      rcases hy with rfl | rfl
      · exact ⟨_, isBandedWith_shiftUp⟩
      · exact ⟨_, isBandedWith_shiftDown⟩
  | zero => exact ⟨0, isBandedWith_zero⟩
  | one => exact ⟨1, isBandedWith_one⟩
  | add x y _ _ hx hy =>
      obtain ⟨p, hp⟩ := hx
      obtain ⟨q, hq⟩ := hy
      exact ⟨p + q, hp.add hq⟩
  | neg x _ hx =>
      obtain ⟨p, hp⟩ := hx
      exact ⟨-p, hp.neg⟩
  | mul x y _ _ hx hy =>
      obtain ⟨p, hp⟩ := hx
      obtain ⟨q, hq⟩ := hy
      exact ⟨p * q, hp.mul hq⟩

/-- The symbol of an element of `J`. -/
noncomputable def symbolFun (x : ↥jacobsonAlgebra) : BinaryLaurent :=
  Classical.choose (exists_isBandedWith x.2)

theorem symbolFun_spec (x : ↥jacobsonAlgebra) :
    IsBandedWith (x : Module.End (ZMod 2) JacobsonSpace) (symbolFun x) :=
  Classical.choose_spec (exists_isBandedWith x.2)

theorem symbolFun_eq {x : ↥jacobsonAlgebra} {p : BinaryLaurent}
    (h : IsBandedWith (x : Module.End (ZMod 2) JacobsonSpace) p) : symbolFun x = p :=
  (symbolFun_spec x).unique h

/-- **The symbol `J → F_2[z,z^{-1}]`.** -/
noncomputable def symbol : ↥jacobsonAlgebra →+* BinaryLaurent where
  toFun := symbolFun
  map_one' := symbolFun_eq isBandedWith_one
  map_mul' x y := symbolFun_eq ((symbolFun_spec x).mul (symbolFun_spec y))
  map_zero' := symbolFun_eq isBandedWith_zero
  map_add' x y := symbolFun_eq ((symbolFun_spec x).add (symbolFun_spec y))

theorem symbol_spec (x : ↥jacobsonAlgebra) :
    IsBandedWith (x : Module.End (ZMod 2) JacobsonSpace) (symbol x) :=
  symbolFun_spec x

theorem symbol_eq {x : ↥jacobsonAlgebra} {p : BinaryLaurent}
    (h : IsBandedWith (x : Module.End (ZMod 2) JacobsonSpace) p) : symbol x = p :=
  symbolFun_eq h

/-- `symbol s = z`. -/
theorem symbol_jacobsonS : symbol jacobsonS = T 1 := symbol_eq isBandedWith_shiftUp

/-- `symbol t = z^{-1}`. -/
theorem symbol_jacobsonT : symbol jacobsonT = T (-1) := symbol_eq isBandedWith_shiftDown

/-- **`symbol (1 - st) = 0`.** -/
theorem symbol_one_sub : symbol ((1 : ↥jacobsonAlgebra) - jacobsonS * jacobsonT) = 0 := by
  rw [map_sub, map_one, map_mul, symbol_jacobsonS, symbol_jacobsonT, ← T_add]
  norm_num [T_zero]

/-- **The symbol is surjective.** -/
theorem symbol_surjective : Function.Surjective symbol := by
  intro p
  have hT : ∀ n : ℤ, T n ∈ symbol.range := by
    intro n
    rcases le_total 0 n with hn | hn
    · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
      refine ⟨jacobsonS ^ k, ?_⟩
      rw [map_pow, symbol_jacobsonS, T_pow, mul_one]
    · obtain ⟨k, hk⟩ := Int.exists_eq_neg_ofNat hn
      refine ⟨jacobsonT ^ k, ?_⟩
      rw [map_pow, symbol_jacobsonT, T_pow, hk]
      congr 1
      ring
  have hmem : p ∈ symbol.range := by
    induction p using LaurentPolynomial.induction_on' with
    | add p q hp hq => exact symbol.range.add_mem hp hq
    | C_mul_T n a =>
        have ha : a = 0 ∨ a = 1 := by
          have : ∀ x : ZMod 2, x = 0 ∨ x = 1 := by decide
          exact this a
        rcases ha with rfl | rfl
        · rw [map_zero, zero_mul]
          exact symbol.range.zero_mem
        · rw [map_one, one_mul]
          exact hT n
  exact hmem

end JacobsonSymbol
end OneSidedMFRadical
end Manuscript
end GroupApproximation

#audit_axioms GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonSymbol.symbol_one_sub
#audit_axioms GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonSymbol.symbol_surjective
