import GroupApproximation.Leavitt.OneSidedCompressorStabilized
import GroupApproximation.Manuscript.OneSidedMFRadical.FullDefectRingProperIsometry
import GroupApproximation.Manuscript.OneSidedMFRadical.FullDefectRingDescent
import GroupApproximation.Meta.AxiomGuard

/-!
# `cor:one-sided-ring-maximal`: the compression is strict

`non_mf_groups_exist.tex`, Corollary `cor:one-sided-ring-maximal`, first
sentence, and the header of Proposition `prop:max-infinite`:

> Let `G` contain a property-`(T)` subgroup `Γ` and an element `t` with
> `tΓt⁻¹ ⊊ Γ`.

The containment `uLu⁻¹ ≤ L` is `OneSidedCompressor.compressorOf_compresses_coreOf`.
This module supplies the *strictness*, which is the printed reason the
corollary assumes `st ≠ 1` and the only thing
`OneSidedCompressorStrictContainment` was still waiting for.

## The subgroup, and why it is `EL₃(S)` and not `EL₃(R)`

The printed hypothesis is only that `R` is countable, so `EL₃(R)` has no
property `(T)` to offer.  What the printed proof uses is a finitely generated
subring: `S = ℤ⟨s,t⟩` is finitely generated by construction, `EL₃(S)` has
property `(T)` by Ershov--Jaikin-Zapirain, and its image `Γ` in `EL_n(R)`
inherits property `(T)` because it is a quotient of it — `MonoidHom.range` and
`MonoidHom.rangeRestrict_surjective`, with no computation of the range.

`s` and `t` lie in `S`, so `a ∈ S` implies `sat ∈ S`, and the printed
conjugation `u e_{ij}(a) u⁻¹ = e_{ij}(sat)` keeps `Γ` inside itself.

## The strictness, and where `st ≠ 1` is spent

Write `e = 1 - st` and `p` for the first compressor coordinate.  The single
matrix `E = e·E_{pp}` separates `Γ` from `uΓu⁻¹`:

* `E · x_{qr}(c) = x` unchanged whenever `q ≠ p`, and `E · x_{pr}(c)` changes
  `E` by `E_{pr}(ec)`.  So `{g : E g = E}` is a subgroup —
  `leftFixSubgroup` — because `Eg = E` and `Eh = E` give `E(gh) = E`, and
  `Eg = E` gives `E = Eg⁻¹`.
* Every generator of `uΓu⁻¹` is `x_{ij}(sat)`, and `e·s = 0`, so all of
  `uΓu⁻¹` lies in that subgroup.
* `x_{p,·}(1) ∈ Γ` does not, because `E · x_{p,·}(1) - E = E_{p,·}(e)`, which
  vanishes exactly when `e = 0`, i.e. exactly when `st = 1`.

That is the printed sentence "every off-diagonal entry of an element of
`uΓu⁻¹` has the form `sat`, and `e·sat = 0` while `e·1 = e ≠ 0`", carried out
with one matrix instead of an entry-by-entry description of `uΓu⁻¹`.

The whole compression argument is a single induction over `EL₃(S)`, proved
once into the intersection `Γ ⊓ leftFixSubgroup E`, so the containment and its
strictness come out of the same induction.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace FullDefectRing

open scoped BigOperators
open OneSidedCompressor

/-! ## Matrices that fix a left multiplier -/

section LeftFix

variable {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R]

/-- The elementary matrices `g` with `E g = E`, for a fixed matrix `E`.

This is a subgroup for a reason that has nothing to do with elementary
matrices: `E g = E` and `E h = E` give `E (g h) = E h = E`, and `E g = E` gives
`E = E g g⁻¹ = E g⁻¹`. -/
def leftFixSubgroup (E : Matrix ι ι R) : Subgroup (elementaryGroup ι R) where
  carrier := {g | E * ((g : (Matrix ι ι R)ˣ) : Matrix ι ι R) = E}
  one_mem' := by
    show E * ((1 : (Matrix ι ι R)ˣ) : Matrix ι ι R) = E
    rw [Units.val_one, mul_one]
  mul_mem' := by
    intro a b ha hb
    show E * ((a * b : elementaryGroup ι R) : (Matrix ι ι R)ˣ).val = E
    have hval : (((a * b : elementaryGroup ι R) : (Matrix ι ι R)ˣ) :
        Matrix ι ι R) =
        ((a : (Matrix ι ι R)ˣ) : Matrix ι ι R) *
          ((b : (Matrix ι ι R)ˣ) : Matrix ι ι R) := rfl
    rw [hval, ← mul_assoc, ha, hb]
  inv_mem' := by
    intro a ha
    show E * ((a⁻¹ : elementaryGroup ι R) : (Matrix ι ι R)ˣ).val = E
    have hcancel : ((a : (Matrix ι ι R)ˣ) : Matrix ι ι R) *
        ((a⁻¹ : elementaryGroup ι R) : (Matrix ι ι R)ˣ).val = 1 := by
      have h : ((a : (Matrix ι ι R)ˣ) * ((a⁻¹ : elementaryGroup ι R) :
          (Matrix ι ι R)ˣ) : (Matrix ι ι R)ˣ) = 1 := by
        rw [show ((a⁻¹ : elementaryGroup ι R) : (Matrix ι ι R)ˣ) =
          (a : (Matrix ι ι R)ˣ)⁻¹ from rfl, mul_inv_cancel]
      exact congrArg Units.val h
    calc E * ((a⁻¹ : elementaryGroup ι R) : (Matrix ι ι R)ˣ).val
        = (E * ((a : (Matrix ι ι R)ˣ) : Matrix ι ι R)) *
            ((a⁻¹ : elementaryGroup ι R) : (Matrix ι ι R)ˣ).val := by
          rw [ha]
      _ = E * (((a : (Matrix ι ι R)ˣ) : Matrix ι ι R) *
            ((a⁻¹ : elementaryGroup ι R) : (Matrix ι ι R)ˣ).val) := by
          rw [mul_assoc]
      _ = E := by rw [hcancel, mul_one]

theorem elementaryRoot_mem_leftFixSubgroup {E : Matrix ι ι R} {i j : ι}
    (hij : i ≠ j) (a : R) (h : E * Matrix.single i j a = 0) :
    elementaryRoot i j hij a ∈ leftFixSubgroup E := by
  show E * ((1 : Matrix ι ι R) + Matrix.single i j a) = E
  rw [mul_add, mul_one, h, add_zero]

theorem elementaryRoot_not_mem_leftFixSubgroup {E : Matrix ι ι R} {i j : ι}
    (hij : i ≠ j) (a : R) (h : E * Matrix.single i j a ≠ 0) :
    elementaryRoot i j hij a ∉ leftFixSubgroup E := by
  intro hmem
  refine h ?_
  have hE : E * ((1 : Matrix ι ι R) + Matrix.single i j a) = E := hmem
  rw [mul_add, mul_one] at hE
  have : E + E * Matrix.single i j a = E + 0 := by rw [hE, add_zero]
  exact add_left_cancel this

end LeftFix

/-! ## The core over a subring, inside `EL_n(R)` -/

section CoreOver

variable {R : Type} [Ring R] {n : ℕ}

/-- The printed `L = EL₃(S)`, mapped into coordinates `1,2,3` of `EL_n(R)`. -/
noncomputable def coreOverHom (S : Subring R) (hn : 4 ≤ n) :
    elementaryGroup (Fin 3) ↥S →* elementaryGroup (Fin n) R :=
  (coreEmbeddingOf (R := R) hn).comp (elementaryGroupMap (ι := Fin 3) S.subtype)

theorem coreOverHom_elementaryRoot (S : Subring R) (hn : 4 ≤ n)
    (i j : Fin 3) (hij : i ≠ j) (α : ↥S) :
    coreOverHom S hn (elementaryRoot i j hij α) =
      elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
        ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) (α : R) := by
  have h1 : elementaryGroupMap (ι := Fin 3) S.subtype (elementaryRoot i j hij α)
      = elementaryRoot i j hij (α : R) := by
    apply Subtype.ext
    show elementaryMatrixUnitMap S.subtype (elementaryUnit i j hij α) =
      elementaryUnit i j hij (α : R)
    exact elementaryMatrixUnitMap_elementaryUnit S.subtype i j hij α
  show coreEmbeddingOf (R := R) hn
      (elementaryGroupMap (ι := Fin 3) S.subtype (elementaryRoot i j hij α)) = _
  rw [h1]
  show blockEmbedding (R := R) hn
      (coreEmbedding (elementaryRoot i j hij (α : R))) = _
  rw [coreEmbedding_elementaryRoot, blockEmbedding_elementaryRoot]

/-- The printed conjugation `u e_{ij}(a) u⁻¹ = e_{ij}(sat)` at rank `n`. -/
theorem compressorOf_conj_root (P : OneSidedInverse R) (hn : 4 ≤ n)
    (i j : Fin 3) (hij : i ≠ j) (a : R) :
    compressorOf P hn *
        elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
          ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) a *
        (compressorOf P hn)⁻¹ =
      elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
        ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) (P.s * a * P.t) := by
  have hb : elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
      ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) a =
      blockEmbedding (R := R) hn
        (elementaryRoot (coreIdx i) (coreIdx j)
          (coreIdx_injective.ne hij) a) := by
    rw [blockEmbedding_elementaryRoot]
  rw [hb, compressorOf, ← map_inv, ← map_mul, ← map_mul,
    compressor_conj_root P i j hij a, blockEmbedding_elementaryRoot]

end CoreOver

/-! ## The separating matrix -/

section Separator

variable {R : Type} [Ring R] {n : ℕ}

/-- The single matrix `E = e·E_{pp}` at the first compressor coordinate `p`,
which separates the core from its compression. -/
noncomputable def defectCorner (P : OneSidedInverse R) (hn : 4 ≤ n) :
    Matrix (Fin n) (Fin n) R :=
  Matrix.single (bigIdx hn (coreIdx 0)) (bigIdx hn (coreIdx 0)) P.e

theorem defectCorner_mul_single (P : OneSidedInverse R) (hn : 4 ≤ n)
    (i j : Fin 3) (a : R) :
    defectCorner P hn *
        Matrix.single (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
          (P.s * a * P.t) = 0 := by
  rcases eq_or_ne (0 : Fin 3) i with rfl | hi
  · rw [defectCorner, Matrix.single_mul_single_same
      (c := P.e) (bigIdx hn (coreIdx 0)) (bigIdx hn (coreIdx 0))
      (bigIdx hn (coreIdx j)) (P.s * a * P.t)]
    have hzero : P.e * (P.s * a * P.t) = 0 := by
      rw [← mul_assoc, ← mul_assoc, P.e_mul_s, zero_mul, zero_mul]
    rw [hzero, Matrix.single_zero]
  · have hne : bigIdx hn (coreIdx 0) ≠ bigIdx hn (coreIdx i) :=
      (bigIdx_injective hn).ne (coreIdx_injective.ne hi)
    exact Matrix.single_mul_single_of_ne (c := P.e) (bigIdx hn (coreIdx 0))
      (bigIdx hn (coreIdx 0)) (bigIdx hn (coreIdx i)) hne (P.s * a * P.t)

/-- The printed witness `e_{01}(1)` is not fixed by `E`, and this is exactly
where `st ≠ 1` is spent. -/
theorem defectCorner_mul_witness_ne_zero (P : OneSidedInverse R) (hn : 4 ≤ n)
    (he : P.e ≠ 0) :
    defectCorner P hn *
        Matrix.single (bigIdx hn (coreIdx 0)) (bigIdx hn (coreIdx 1))
          (1 : R) ≠ 0 := by
  rw [defectCorner, Matrix.single_mul_single_same
    (c := P.e) (bigIdx hn (coreIdx 0)) (bigIdx hn (coreIdx 0))
    (bigIdx hn (coreIdx 1)) (1 : R), mul_one]
  intro hzero
  refine he ?_
  have h := congrFun (congrFun hzero (bigIdx hn (coreIdx 0)))
    (bigIdx hn (coreIdx 1))
  simpa using h

end Separator

/-! ## The compression, and its strictness -/

section Strict

variable {R : Type} [Ring R] {n : ℕ}

/-- **The whole compression argument, as one induction.**  Conjugating the
image of `EL₃(S)` by the compressor lands back in that image *and* in the
subgroup fixed by `E`.  The two conclusions are what give the containment and
its strictness, and proving them together is what makes one induction
enough. -/
theorem conj_mem_range_inf (P : OneSidedInverse R) (hn : 4 ≤ n) (S : Subring R)
    (hs : P.s ∈ S) (ht : P.t ∈ S) (g : elementaryGroup (Fin 3) ↥S) :
    compressorOf P hn * coreOverHom S hn g * (compressorOf P hn)⁻¹ ∈
      (coreOverHom S hn).range ⊓ leftFixSubgroup (defectCorner P hn) := by
  obtain ⟨g, hg⟩ := g
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨i, j, hij, α, rfl⟩ := hx
      have hstep : compressorOf P hn *
          coreOverHom S hn (elementaryRoot i j hij α) *
          (compressorOf P hn)⁻¹ =
          elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
            ((bigIdx_injective hn).ne (coreIdx_injective.ne hij))
            (P.s * (α : R) * P.t) := by
        rw [coreOverHom_elementaryRoot S hn i j hij α,
          compressorOf_conj_root P hn i j hij (α : R)]
      show compressorOf P hn *
          coreOverHom S hn (elementaryRoot i j hij α) *
          (compressorOf P hn)⁻¹ ∈ _
      rw [hstep]
      refine ⟨⟨elementaryRoot i j hij
        (⟨P.s * (α : R) * P.t, S.mul_mem (S.mul_mem hs α.2) ht⟩ : ↥S), ?_⟩, ?_⟩
      · exact coreOverHom_elementaryRoot S hn i j hij _
      · exact elementaryRoot_mem_leftFixSubgroup _ _
          (defectCorner_mul_single P hn i j (α : R))
  | one =>
      rw [show (⟨1, Subgroup.one_mem _⟩ : elementaryGroup (Fin 3) ↥S) = 1 from rfl,
        map_one, mul_one, mul_inv_cancel]
      exact Subgroup.one_mem _
  | mul x y hx hy ihx ihy =>
      rw [show (⟨x * y, Subgroup.mul_mem _ hx hy⟩ : elementaryGroup (Fin 3) ↥S)
          = ⟨x, hx⟩ * ⟨y, hy⟩ from rfl, map_mul]
      have hsplit : compressorOf P hn *
          (coreOverHom S hn ⟨x, hx⟩ * coreOverHom S hn ⟨y, hy⟩) *
            (compressorOf P hn)⁻¹ =
          (compressorOf P hn * coreOverHom S hn ⟨x, hx⟩ *
              (compressorOf P hn)⁻¹) *
            (compressorOf P hn * coreOverHom S hn ⟨y, hy⟩ *
              (compressorOf P hn)⁻¹) := by
        group
      rw [hsplit]
      exact Subgroup.mul_mem _ ihx ihy
  | inv x hx ihx =>
      rw [show (⟨x⁻¹, Subgroup.inv_mem _ hx⟩ : elementaryGroup (Fin 3) ↥S)
          = (⟨x, hx⟩ : elementaryGroup (Fin 3) ↥S)⁻¹ from rfl, map_inv]
      have hsplit : compressorOf P hn * (coreOverHom S hn ⟨x, hx⟩)⁻¹ *
          (compressorOf P hn)⁻¹ =
          (compressorOf P hn * coreOverHom S hn ⟨x, hx⟩ *
            (compressorOf P hn)⁻¹)⁻¹ := by
        group
      rw [hsplit]
      exact Subgroup.inv_mem _ ihx

/-- **The printed strict compression, at one ring and one rank.**  The image of
`EL₃(S)` in `EL_n(R)` is carried strictly inside itself by the compressor, as
soon as the complementary idempotent is nonzero. -/
theorem compressorOf_strict (P : OneSidedInverse R) (hn : 4 ≤ n) (S : Subring R)
    (hs : P.s ∈ S) (ht : P.t ∈ S) (he : P.e ≠ 0) :
    ((coreOverHom S hn).range).map
        (MulAut.conj (compressorOf P hn)).toMonoidHom <
      (coreOverHom S hn).range := by
  have hboth : ((coreOverHom S hn).range).map
      (MulAut.conj (compressorOf P hn)).toMonoidHom ≤
      (coreOverHom S hn).range ⊓ leftFixSubgroup (defectCorner P hn) := by
    rintro _ ⟨_, ⟨g, rfl⟩, rfl⟩
    exact conj_mem_range_inf P hn S hs ht g
  have hwitness : elementaryRoot (bigIdx hn (coreIdx 0)) (bigIdx hn (coreIdx 1))
      ((bigIdx_injective hn).ne (coreIdx_injective.ne (by decide : (0 : Fin 3) ≠ 1)))
      (1 : R) ∈ (coreOverHom S hn).range := by
    have hne : (0 : Fin 3) ≠ 1 := by decide
    refine ⟨elementaryRoot 0 1 hne (1 : ↥S), ?_⟩
    rw [coreOverHom_elementaryRoot S hn 0 1 hne (1 : ↥S)]
    rfl
  refine lt_of_le_of_ne (hboth.trans inf_le_left) ?_
  intro heq
  have hmem : elementaryRoot (bigIdx hn (coreIdx 0)) (bigIdx hn (coreIdx 1))
      ((bigIdx_injective hn).ne (coreIdx_injective.ne (by decide : (0 : Fin 3) ≠ 1)))
      (1 : R) ∈ ((coreOverHom S hn).range).map
        (MulAut.conj (compressorOf P hn)).toMonoidHom := by
    rw [heq]; exact hwitness
  exact elementaryRoot_not_mem_leftFixSubgroup _ (1 : R)
    (defectCorner_mul_witness_ne_zero P hn he) (hboth hmem).2

end Strict

/-! ## The printed input, discharged -/

/-- **The compressor calculation of `cor:one-sided-ring-maximal`, proved.**

`S` is the subring generated by `s` and `t`, finitely generated by
construction, so `EL₃(S)` has property `(T)` by the hypothesis and its image
`Γ` in `EL_n(R)` inherits it as a quotient.  The compressor carries `Γ` into
itself because `s, t ∈ S`, and strictly because `e = 1 - st` is nonzero. -/
theorem manuscriptOneSidedCompressorStrictContainment :
    OneSidedCompressorStrictContainment := by
  classical
  intro R _ _ s t hts hst hT n hn
  set F : Finset R := {s, t} with hF
  set S : Subring R := Subring.closure ((F : Finset R) : Set R) with hS
  have hs : s ∈ S := Subring.subset_closure (by simp [hF])
  have ht : t ∈ S := Subring.subset_closure (by simp [hF])
  have hfg : IsFinitelyGeneratedRing ↥S := isFinitelyGeneratedRing_subringClosure F
  have hT3 : HasKazhdanPropertyT.{0, 0} (elementaryGroup (Fin 3) ↥S) :=
    hT S hfg 3 le_rfl
  refine ⟨(coreOverHom S hn).range, compressorOf ⟨s, t, hts⟩ hn, ?_, ?_⟩
  · exact HasKazhdanPropertyT.of_surjective (coreOverHom S hn).rangeRestrict
      (MonoidHom.rangeRestrict_surjective _) hT3
  · refine compressorOf_strict ⟨s, t, hts⟩ hn S hs ht ?_
    exact sub_ne_zero_of_ne fun h ↦ hst h.symm

/-! ## `cor:one-sided-ring-maximal`, first sentence, with nothing left over -/

/-- **The printed first sentence over a coefficient ring of prime
characteristic, with no hypothesis.**

> If a countable unital ring `R` is not directly finite, then
> `C*_max(EL_n(R))` contains a proper isometry for every `n ≥ 4`.  In
> particular, `C*_max(G)` is not stably finite, admits no faithful tracial
> state, and is neither residually finite-dimensional nor MF. -/
theorem manuscriptOneSidedRingMaximalIsometryPrimeCharUnconditional :
    PrintedOneSidedRingMaximalIsometryPrimeChar :=
  manuscriptOneSidedRingMaximalIsometryPrimeChar
    manuscriptOneSidedCompressorStrictContainment

/-- **The printed first sentence as printed**, with the
Ershov--Jaikin-Zapirain theorem as its only hypothesis. -/
theorem manuscriptOneSidedRingMaximalIsometryFromEJZ
    (hEJZ : FinitelyGeneratedRingGeneralRankElementaryPropertyT) :
    PrintedOneSidedRingMaximalIsometry :=
  manuscriptOneSidedRingMaximalIsometry
    manuscriptOneSidedCompressorStrictContainment hEJZ

