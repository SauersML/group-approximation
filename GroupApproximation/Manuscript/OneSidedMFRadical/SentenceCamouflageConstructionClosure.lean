import GroupApproximation.Sofic.MFCamouflage

/-!
# Sentence closure for the camouflage construction

Exact-route wrappers for census rows 269--277, stopping before the restriction
calculation already named in `SentenceMFCamouflageClosure`.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical

variable {B : Type} [Group B]

/-- **Sentence 269.**  The amalgamated subgroup is the cyclic subgroup
generated by the distinguished normal generator. -/
theorem manuscriptSentence269_cyclicEdge (d : B) :
    IsCyclic (MFCamouflage.Edge d) ∧
      ((MFCamouflage.edgeGenerator d : MFCamouflage.Edge d) : B) = d :=
  ⟨MFCamouflage.edgeIsCyclic d, rfl⟩

/-- **Sentence 270.**  `W_Q` is definitionally the pushout
`B *_{⟨d⟩} (Q × ⟨d⟩)` with the two printed edge embeddings. -/
theorem manuscriptSentence270_camouflage_is_amalgam
    (d : B) (Q : Type) [Group Q] :
    MFCamouflage.Camouflage d Q =
      Higman.Amalgam.Push (MFCamouflage.leftEdge d)
        (MFCamouflage.rightEdge d Q) :=
  rfl

/-- **Sentence 271.**  The trivial map on the black-hole vertex and projection
of the product vertex to `Q` agree on the amalgamated edge. -/
theorem manuscriptSentence271_projectionFamily_agreesOnEdge
    (d : B) (Q : Type) [Group Q] (z : MFCamouflage.Edge d) :
    (1 : B →* Q) (MFCamouflage.leftEdge d z) =
      MonoidHom.fst Q (MFCamouflage.Edge d)
        (MFCamouflage.rightEdge d Q z) := by
  simp

/-- **Sentence 272.**  The induced projection kills `B`, is product projection
on the other vertex, and is surjective. -/
theorem manuscriptSentence272_projection_epimorphism
    (d : B) (Q : Type) [Group Q] :
    (∀ b : B, MFCamouflage.projection d Q
        (MFCamouflage.blackHole d Q b) = 1) ∧
      (∀ x : Q × MFCamouflage.Edge d,
        MFCamouflage.projection d Q
          (MFCamouflage.productVertex d Q x) = x.1) ∧
      Function.Surjective (MFCamouflage.projection d Q) :=
  ⟨MFCamouflage.projection_blackHole d Q,
    MFCamouflage.projection_productVertex d Q,
    MFCamouflage.projection_surjective d Q⟩

/-- **Sentence 273.**  The visible copy of `Q` is a section of the projection. -/
theorem manuscriptSentence273_projection_split
    (d : B) (Q : Type) [Group Q] :
    (MFCamouflage.projection d Q).comp (MFCamouflage.visible d Q) =
      MonoidHom.id Q :=
  MFCamouflage.projection_comp_visible d Q

/-- **Sentence 274.**  Both vertex maps into the amalgam are injective. -/
theorem manuscriptSentence274_vertexMaps_injective
    (d : B) (Q : Type) [Group Q] :
    Function.Injective (MFCamouflage.blackHole d Q) ∧
      Function.Injective (MFCamouflage.productVertex d Q) :=
  ⟨MFCamouflage.blackHole_injective d Q,
    MFCamouflage.productVertex_injective d Q⟩

/-- **Sentence 275.**  A nonidentity distinguished element remains
nonidentity in the amalgam. -/
theorem manuscriptSentence275_defect_survives
    (d : B) (hd : d ≠ 1) (Q : Type) [Group Q] :
    MFCamouflage.defect d Q ≠ 1 :=
  MFCamouflage.defect_ne_one d Q hd

/-- **Sentence 276.**  If every map from `B` to the target is trivial,
precomposition with the projection is a bijection on homomorphisms. -/
theorem manuscriptSentence276_universalFactorization
    (d : B) (Q : Type) [Group Q]
    (T : Type) [Group T] (hT : ∀ f : B →* T, f = 1) :
    Function.Bijective
      (fun f : Q →* T ↦ f.comp (MFCamouflage.projection d Q)) :=
  MFCamouflage.precomp_bijective d Q hT

/-- **Sentence 277.**  If `d` normally generates `B`, the projection kernel
is exactly the normal closure of its image in the amalgam. -/
theorem manuscriptSentence277_projectionKernel
    (d : B) (Q : Type) [Group Q]
    (hgen : Subgroup.normalClosure ({d} : Set B) = ⊤) :
    (MFCamouflage.projection d Q).ker =
      Subgroup.normalClosure
        ({MFCamouflage.defect d Q} : Set (MFCamouflage.Camouflage d Q)) :=
  MFCamouflage.projection_ker_eq_normalClosure d Q hgen

end OneSidedMFRadical
end Manuscript
end GroupApproximation
