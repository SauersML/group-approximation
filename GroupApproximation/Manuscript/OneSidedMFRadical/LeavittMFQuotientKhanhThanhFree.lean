import GroupApproximation.KOne.UnstableKOneAbelian
import GroupApproximation.Manuscript.OneSidedMFRadical.LeavittMFQuotientGeneral
import GroupApproximation.Leavitt.AryPurelyInfinite
import GroupApproximation.Meta.AxiomGuard

/-!
# `cor:leavitt-mf-quotient` without the Khanh--Thanh citation

`LeavittMFQuotientGeneral.lean` proves the group-theoretic content of
`cor:leavitt-mf-quotient` at every `d ≥ 2` from a single named literature
input, `PrintedKhanhThanhCommutatorInElementary k d`, which is the printed
"Khanh--Thanh show that `GL_d(R) = EL_d(R)D_d(k)`" reduced to the one
consequence the printed chain uses:

    `[GL_d(R), GL_d(R)] ≤ EL_d(R)`.

That input is **discharged here**, so the corollary's group-theoretic content
is unconditional at every `d ≥ 2`.

## Why the citation is not needed

The inclusion is a consequence of the ring being purely infinite simple, with
no reference to the Leavitt presentation at all:

* a purely infinite simple ring has single-sandwich division --- for
  `L_k(1,d)` this is `AryLeavitt.hasSingleSandwichDivision`, already on the
  tree;
* over a strongly divisible ring, Gaussian elimination works at every rank, so
  every invertible matrix is `E · diagAt l u · F` with `E`, `F` elementary
  (`RankNElimination.eq_elementary_mul_diagAt`).  Hence `EL_ι(R)` is normal and
  `GL_ι(R)/EL_ι(R)` is generated by the image of `u ↦ diagAt l u`;
* Whitehead's identity in a two-index block kills the commutators of that image
  (`RankNElimination.diagAt_commutatorElement_mem`), so the quotient is
  abelian.

`RankNElimination.commutator_le_elementaryGroup` packages the last two steps.

## What the citation is still needed for

The printed corollary also asserts `K₁(R) ≅ k^×/(k^×)^{d-1}`.  That is the
other half of the same Khanh--Thanh sentence, and it is not proved here or
anywhere on the tree; `PrintedLeavittMFQuotientGeneral` never asserted it.
Nothing below weakens that: the identification of the quotient group remains
open, and only the inclusion `[H,H] ≤ EL_d(R)` changes status from cited to
proved.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace LeavittMFQuotientGeneral

open AryLeavitt

/-- Two distinct indices exist at every rank `d ≥ 2`. -/
theorem exists_ne_fin (d : ℕ) (hd : 2 ≤ d) :
    (⟨0, by omega⟩ : Fin d) ≠ ⟨1, by omega⟩ := by
  simp only [ne_eq, Fin.mk.injEq]
  omega

/-- **The Khanh--Thanh input, discharged.**  The commutator subgroup of
`GL_d(L_k(1,d))` lies in `EL_d(L_k(1,d))`, for every field `k` and every
`d ≥ 2`, with no literature input: single-sandwich division for `L_k(1,d)`
plus rank-`d` Gaussian elimination plus Whitehead's identity. -/
theorem printedKhanhThanhCommutatorInElementary (k : Type) [Field k] (d : ℕ)
    (hd : 2 ≤ d) : PrintedKhanhThanhCommutatorInElementary k d := by
  haveI : NeZero d := ⟨by omega⟩
  exact RankNElimination.commutator_le_elementaryGroup
    (AryLeavitt.hasSingleSandwichDivision k d hd) (exists_ne_fin d hd)

/-- **`cor:leavitt-mf-quotient`, group-theoretic content, unconditional.**

Same three conjuncts as `PrintedLeavittMFQuotientGeneral`, with the
Khanh--Thanh hypothesis removed.  As there, the identification of the quotient
with `K₁(R)` and with `k^×/(k^×)^{d-1}` is not asserted. -/
def PrintedLeavittMFQuotientGeneralUnconditional : Prop :=
  ∀ (k : Type) [Field k] [Countable k] (d : ℕ), 2 ≤ d →
    Nonempty ((AryLeavittAlgebra k d)ˣ ≃*
        (Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d))ˣ) ∧
      commutator (Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d))ˣ
          = elementaryGroup (Fin d) (AryLeavittAlgebra k d) ∧
      (∀ x : (Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d))ˣ,
        x ∈ elementaryGroup (Fin d) (AryLeavittAlgebra k d) ↔
          ∀ (M : Type) [Group M], IsOperatorMF M →
            ∀ (f : (Matrix (Fin d) (Fin d) (AryLeavittAlgebra k d))ˣ →* M),
              f x = 1)

theorem manuscriptLeavittMFQuotientGeneralUnconditional :
    PrintedLeavittMFQuotientGeneralUnconditional := by
  intro k _ _ d hd
  exact manuscriptLeavittMFQuotientGeneral k d hd
    (printedKhanhThanhCommutatorInElementary k d hd)

end LeavittMFQuotientGeneral
end OneSidedMFRadical
end Manuscript
end GroupApproximation

