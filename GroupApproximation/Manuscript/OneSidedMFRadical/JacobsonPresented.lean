import GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonFiniteMatrices
import Mathlib.Algebra.FreeAlgebra
import Mathlib.Algebra.RingQuot

/-!
# The presented Toeplitz--Jacobson algebra `J = F_2⟨s,t | ts=1⟩`

`non_mf_groups_exist.tex`, the remark after `prop:torsion-defect-ring`
(tex lines 1122--1131):

> The Toeplitz--Jacobson algebra `J = F_2⟨s,t | ts=1⟩` has `1-st ≠ 0` of order two, …
> The algebra `J` acts faithfully on `V = F_2^{(ℕ)}` by the shift, `e = 1-st` is the
> projection onto the first vector `b_0` of the standard basis `(b_j)`, and `JeJ` is the
> ring of matrices with finitely many nonzero entries in this basis.

The earlier carriers work in the operator model `jacobsonAlgebra`, the subring of
`End_{F_2}(F_2[X])` generated by the two shifts.  Here `J` is the printed algebra, the
quotient of the free `F_2`-algebra on `s, t` by the single relation `ts = 1`, and the
shift action `J → End(V)` is proved faithful with image `jacobsonAlgebra`:

* the words `s^i t^j` span `J` (`mem_span_word`), since `ts = 1` turns every product of
  two words into a word (`word_mul`);
* `s^i t^j` sends `X^N` to `X^{i+N-j}` for `N ≥ j` and to `0` below, so in a relation
  among the operators the coefficient of a word with `j` minimal is read off at the
  monomial `X^i` of the image of `X^j` (`shiftRep_sum_eq_zero`);
* so the shift representation is injective (`shiftRep_injective`), and
  `jacobsonEquiv : J ≃+* jacobsonAlgebra` sends `s, t` to the two shifts.
-/

namespace GroupApproximation
namespace Manuscript
namespace OneSidedMFRadical
namespace JacobsonPresented

open TorsionComplementaryIdempotents JacobsonSymbol

noncomputable section

/-! ## Words in a monoid with `ts = 1` -/

section Words

variable {A : Type*} [Monoid A] {s t : A}

theorem pow_mul_pow_self_of_mul_eq_one (h : t * s = 1) (i : ℕ) : t ^ i * s ^ i = 1 := by
  induction i with
  | zero => rw [pow_zero, pow_zero, one_mul]
  | succ i ih =>
      rw [pow_succ, pow_succ', mul_assoc, ← mul_assoc t s, h, one_mul, ih]

theorem pow_mul_pow_of_mul_eq_one (h : t * s = 1) (j k : ℕ) :
    t ^ j * s ^ k = if j ≤ k then s ^ (k - j) else t ^ (j - k) := by
  by_cases hjk : j ≤ k
  · rw [if_pos hjk]
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hjk
    rw [pow_add, ← mul_assoc, pow_mul_pow_self_of_mul_eq_one h j, one_mul]
    congr 1
    omega
  · rw [if_neg hjk]
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le (by omega : k ≤ j)
    rw [add_comm k d, pow_add, mul_assoc, pow_mul_pow_self_of_mul_eq_one h k, mul_one]
    congr 1
    omega

theorem word_mul_of_mul_eq_one (h : t * s = 1) (a b : ℕ × ℕ) :
    s ^ a.1 * t ^ a.2 * (s ^ b.1 * t ^ b.2) =
      s ^ (jacobsonMulIdx a b).1 * t ^ (jacobsonMulIdx a b).2 := by
  have hassoc : s ^ a.1 * t ^ a.2 * (s ^ b.1 * t ^ b.2)
      = s ^ a.1 * (t ^ a.2 * s ^ b.1) * t ^ b.2 := by
    rw [mul_assoc, mul_assoc, mul_assoc]
  rw [hassoc, pow_mul_pow_of_mul_eq_one h a.2 b.1, jacobsonMulIdx]
  by_cases hab : a.2 ≤ b.1
  · rw [if_pos hab, if_pos hab, pow_add]
  · rw [if_neg hab, if_neg hab, pow_add, mul_assoc]

theorem pow_one_mul_pow_zero (s t : A) : s ^ 1 * t ^ 0 = s := by
  rw [pow_one, pow_zero, mul_one]

theorem pow_zero_mul_pow_one (s t : A) : s ^ 0 * t ^ 1 = t := by
  rw [pow_zero, pow_one, one_mul]

theorem pow_zero_mul_pow_zero (s t : A) : s ^ 0 * t ^ 0 = 1 := by
  rw [pow_zero, pow_zero, mul_one]

theorem map_pow_mul_pow {B F : Type*} [Monoid B] [FunLike F A B] [MonoidHomClass F A B]
    (f : F) (s t : A) (i j : ℕ) : f (s ^ i * t ^ j) = f s ^ i * f t ^ j := by
  rw [map_mul, map_pow, map_pow]

end Words

/-! ## The presentation -/

/-- Noncommutative polynomials over `F_2` in the generators `s = ι 0` and `t = ι 1`. -/
abbrev FreeJ : Type := FreeAlgebra (ZMod 2) (Fin 2)

/-- The single relation `ts = 1`, and no other. -/
inductive TSRelation : FreeJ → FreeJ → Prop
  | ts : TSRelation (FreeAlgebra.ι (ZMod 2) (1 : Fin 2) * FreeAlgebra.ι (ZMod 2) (0 : Fin 2)) 1

/-- **The Toeplitz--Jacobson algebra `J = F_2⟨s,t | ts=1⟩`.** -/
abbrev ToeplitzJacobson : Type := RingQuot TSRelation

/-- The quotient map from noncommutative polynomials. -/
def quotientMap : FreeJ →ₐ[ZMod 2] ToeplitzJacobson := RingQuot.mkAlgHom (ZMod 2) TSRelation

/-- The generator `s`. -/
def presS : ToeplitzJacobson := quotientMap (FreeAlgebra.ι (ZMod 2) (0 : Fin 2))

/-- The generator `t`. -/
def presT : ToeplitzJacobson := quotientMap (FreeAlgebra.ι (ZMod 2) (1 : Fin 2))

/-- **The printed relation `ts = 1`.** -/
theorem presT_mul_presS : presT * presS = 1 := by
  have h := RingQuot.mkAlgHom_rel (ZMod 2) TSRelation.ts
  rw [map_mul, map_one] at h
  exact h

/-! ## The shift representation -/

/-- Evaluation of the free algebra at the shifts, `s ↦` shift up, `t ↦` shift down. -/
def shiftEval : FreeJ →ₐ[ZMod 2] Module.End (ZMod 2) JacobsonSpace :=
  FreeAlgebra.lift (ZMod 2) ![shiftUp, shiftDown]

theorem shiftEval_ι_zero : shiftEval (FreeAlgebra.ι (ZMod 2) (0 : Fin 2)) = shiftUp :=
  FreeAlgebra.lift_ι_apply ![shiftUp, shiftDown] 0

theorem shiftEval_ι_one : shiftEval (FreeAlgebra.ι (ZMod 2) (1 : Fin 2)) = shiftDown :=
  FreeAlgebra.lift_ι_apply ![shiftUp, shiftDown] 1

theorem shiftEval_respects : ∀ ⦃x y : FreeJ⦄, TSRelation x y → shiftEval x = shiftEval y := by
  intro x y h
  cases h
  rw [map_mul, map_one, shiftEval_ι_one, shiftEval_ι_zero, shiftDown_mul_shiftUp]

/-- **The shift action of `J` on `V = F_2[X]`**: `s` shifts up and `t` shifts down. -/
def shiftRep : ToeplitzJacobson →ₐ[ZMod 2] Module.End (ZMod 2) JacobsonSpace :=
  RingQuot.liftAlgHom (ZMod 2) ⟨shiftEval, shiftEval_respects⟩

theorem shiftRep_quotientMap (x : FreeJ) : shiftRep (quotientMap x) = shiftEval x :=
  RingQuot.liftAlgHom_mkAlgHom_apply (ZMod 2) shiftEval shiftEval_respects x

theorem shiftRep_presS : shiftRep presS = shiftUp :=
  (shiftRep_quotientMap (FreeAlgebra.ι (ZMod 2) (0 : Fin 2))).trans shiftEval_ι_zero

theorem shiftRep_presT : shiftRep presT = shiftDown :=
  (shiftRep_quotientMap (FreeAlgebra.ι (ZMod 2) (1 : Fin 2))).trans shiftEval_ι_one

/-! ## The words `s^i t^j` span `J` -/

/-- The word `s^i t^j`. -/
def word (ij : ℕ × ℕ) : ToeplitzJacobson := presS ^ ij.1 * presT ^ ij.2

theorem word_mul (a b : ℕ × ℕ) : word a * word b = word (jacobsonMulIdx a b) :=
  word_mul_of_mul_eq_one presT_mul_presS a b

theorem word_one_zero : word (1, 0) = presS := pow_one_mul_pow_zero presS presT

theorem word_zero_one : word (0, 1) = presT := pow_zero_mul_pow_one presS presT

theorem word_zero_zero : word (0, 0) = 1 := pow_zero_mul_pow_zero presS presT

theorem word_mem_span (ij : ℕ × ℕ) : word ij ∈ Submodule.span (ZMod 2) (Set.range word) :=
  Submodule.subset_span (Set.mem_range_self ij)

theorem mul_mem_span {x y : ToeplitzJacobson}
    (hx : x ∈ Submodule.span (ZMod 2) (Set.range word))
    (hy : y ∈ Submodule.span (ZMod 2) (Set.range word)) :
    x * y ∈ Submodule.span (ZMod 2) (Set.range word) := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      induction hy using Submodule.span_induction with
      | mem y hy =>
          obtain ⟨b, rfl⟩ := hy
          rw [word_mul]
          exact word_mem_span _
      | zero =>
          rw [mul_zero]
          exact Submodule.zero_mem _
      | add y z _ _ hy hz =>
          rw [mul_add]
          exact Submodule.add_mem _ hy hz
      | smul r y _ hy =>
          rw [mul_smul_comm]
          exact Submodule.smul_mem _ r hy
  | zero =>
      rw [zero_mul]
      exact Submodule.zero_mem _
  | add x z _ _ hx hz =>
      rw [add_mul]
      exact Submodule.add_mem _ hx hz
  | smul r x _ hx =>
      rw [smul_mul_assoc]
      exact Submodule.smul_mem _ r hx

theorem quotientMap_mem_span (y : FreeJ) :
    quotientMap y ∈ Submodule.span (ZMod 2) (Set.range word) := by
  have hS : presS ∈ Submodule.span (ZMod 2) (Set.range word) := by
    have h := word_mem_span (1, 0)
    rwa [word_one_zero] at h
  have hT : presT ∈ Submodule.span (ZMod 2) (Set.range word) := by
    have h := word_mem_span (0, 1)
    rwa [word_zero_one] at h
  have h1 : (1 : ToeplitzJacobson) ∈ Submodule.span (ZMod 2) (Set.range word) := by
    have h := word_mem_span (0, 0)
    rwa [word_zero_zero] at h
  induction y using FreeAlgebra.induction with
  | grade0 r =>
      rw [AlgHom.commutes, Algebra.algebraMap_eq_smul_one]
      exact Submodule.smul_mem _ r h1
  | grade1 i =>
      fin_cases i
      · exact hS
      · exact hT
  | mul a b ha hb =>
      rw [map_mul]
      exact mul_mem_span ha hb
  | add a b ha hb =>
      rw [map_add]
      exact Submodule.add_mem _ ha hb

theorem mem_span_word (x : ToeplitzJacobson) :
    x ∈ Submodule.span (ZMod 2) (Set.range word) := by
  obtain ⟨y, rfl⟩ := RingQuot.mkAlgHom_surjective (ZMod 2) TSRelation x
  exact quotientMap_mem_span y

/-! ## The shift action is faithful -/

theorem shiftRep_word (ij : ℕ × ℕ) :
    shiftRep (word ij) = shiftUp ^ ij.1 * shiftDown ^ ij.2 :=
  (map_pow_mul_pow shiftRep presS presT ij.1 ij.2).trans
    (by rw [shiftRep_presS, shiftRep_presT])

/-- `s^i t^j` sends `X^N` to `X^{i+N-j}` for `N ≥ j` and to `0` below. -/
theorem shiftRep_word_X_pow (ij : ℕ × ℕ) (N : ℕ) :
    shiftRep (word ij) (Polynomial.X ^ N) =
      if ij.2 ≤ N then Polynomial.X ^ (ij.1 + (N - ij.2)) else 0 := by
  rw [shiftRep_word, Module.End.mul_apply, shiftDown_pow_X_pow]
  by_cases h : ij.2 ≤ N
  · rw [if_pos h, if_pos h, shiftUp_pow_apply, ← pow_add]
  · rw [if_neg h, if_neg h, map_zero]

/-- The operators `s^i t^j` are linearly independent: evaluate at `X^j` with `j` minimal
and read the coefficient of `X^i`. -/
theorem shiftRep_sum_eq_zero {c : ℕ × ℕ →₀ ZMod 2}
    (hc : (c.sum fun ij a ↦ a • shiftRep (word ij)) = 0) : c = 0 := by
  by_contra hne
  obtain ⟨p, hp, hmin⟩ :=
    Finset.exists_min_image c.support Prod.snd (Finsupp.support_nonempty_iff.mpr hne)
  have happ :
      ((c.sum fun ij a ↦ a • shiftRep (word ij)) (Polynomial.X ^ p.2)).coeff p.1 = 0 := by
    rw [hc, LinearMap.zero_apply, Polynomial.coeff_zero]
  simp only [Finsupp.sum, LinearMap.sum_apply, LinearMap.smul_apply,
    Polynomial.finsetSum_coeff, Polynomial.coeff_smul, shiftRep_word_X_pow] at happ
  rw [Finset.sum_eq_single p] at happ
  · rw [if_pos (le_refl p.2), Nat.sub_self, add_zero, Polynomial.coeff_X_pow, if_pos rfl,
      smul_eq_mul, mul_one] at happ
    exact Finsupp.mem_support_iff.mp hp happ
  · intro q hq hqp
    by_cases hle : q.2 ≤ p.2
    · have heq : q.2 = p.2 := le_antisymm hle (hmin q hq)
      have hne' : ¬ (p.1 = q.1 + (p.2 - q.2)) := fun h1 ↦ hqp (Prod.ext (by omega) heq)
      rw [if_pos hle, Polynomial.coeff_X_pow, if_neg hne', smul_zero]
    · rw [if_neg hle, Polynomial.coeff_zero, smul_zero]
  · intro hp'
    exact absurd hp hp'

theorem eq_zero_of_shiftRep_eq_zero {x : ToeplitzJacobson} (hx : shiftRep x = 0) : x = 0 := by
  obtain ⟨c, rfl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp (mem_span_word x)
  simp only [map_finsuppSum, map_smul] at hx
  rw [shiftRep_sum_eq_zero hx, Finsupp.sum_zero_index]

/-- **The algebra `J` acts faithfully on `V` by the shift.** -/
theorem shiftRep_injective : Function.Injective shiftRep :=
  (injective_iff_map_eq_zero shiftRep).mpr fun _ hx ↦ eq_zero_of_shiftRep_eq_zero hx

/-! ## The image is the operator model -/

theorem shiftEval_mem (y : FreeJ) : shiftEval y ∈ jacobsonAlgebra := by
  have hS : shiftEval (FreeAlgebra.ι (ZMod 2) (0 : Fin 2)) ∈ jacobsonAlgebra := by
    rw [shiftEval_ι_zero]
    exact shiftUp_mem_jacobsonAlgebra
  have hT : shiftEval (FreeAlgebra.ι (ZMod 2) (1 : Fin 2)) ∈ jacobsonAlgebra := by
    rw [shiftEval_ι_one]
    exact shiftDown_mem_jacobsonAlgebra
  induction y using FreeAlgebra.induction with
  | grade0 r =>
      rw [AlgHom.commutes, ← ZMod.natCast_zmod_val r, map_natCast]
      exact natCast_mem jacobsonAlgebra _
  | grade1 i =>
      fin_cases i
      · exact hS
      · exact hT
  | mul a b ha hb =>
      rw [map_mul]
      exact _root_.mul_mem ha hb
  | add a b ha hb =>
      rw [map_add]
      exact _root_.add_mem ha hb

theorem shiftRep_mem (x : ToeplitzJacobson) : shiftRep x ∈ jacobsonAlgebra := by
  obtain ⟨y, rfl⟩ := RingQuot.mkAlgHom_surjective (ZMod 2) TSRelation x
  have h := shiftEval_mem y
  rw [← shiftRep_quotientMap] at h
  exact h

theorem jacobsonAlgebra_le_range : jacobsonAlgebra ≤ shiftRep.toRingHom.range := by
  rw [jacobsonAlgebra, Subring.closure_le]
  rintro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact RingHom.mem_range.mpr ⟨presS, shiftRep_presS⟩
  · exact RingHom.mem_range.mpr ⟨presT, shiftRep_presT⟩

/-- The shift action, as a ring map onto the operator model. -/
def shiftRingHom : ToeplitzJacobson →+* ↥jacobsonAlgebra :=
  shiftRep.toRingHom.codRestrict jacobsonAlgebra shiftRep_mem

theorem coe_shiftRingHom (x : ToeplitzJacobson) :
    (shiftRingHom x : Module.End (ZMod 2) JacobsonSpace) = shiftRep x := rfl

theorem shiftRingHom_injective : Function.Injective shiftRingHom := by
  intro a b h
  have h' := congrArg Subtype.val h
  rw [coe_shiftRingHom, coe_shiftRingHom] at h'
  exact shiftRep_injective h'

theorem shiftRingHom_surjective : Function.Surjective shiftRingHom := by
  intro y
  obtain ⟨x, hx⟩ := RingHom.mem_range.mp (jacobsonAlgebra_le_range y.2)
  exact ⟨x, Subtype.ext ((coe_shiftRingHom x).trans hx)⟩

/-- **`J` is the operator model**: the shift action identifies the presented algebra
`F_2⟨s,t | ts=1⟩` with the subring of `End(V)` generated by the two shifts. -/
def jacobsonEquiv : ToeplitzJacobson ≃+* ↥jacobsonAlgebra :=
  RingEquiv.ofBijective shiftRingHom ⟨shiftRingHom_injective, shiftRingHom_surjective⟩

theorem coe_jacobsonEquiv (x : ToeplitzJacobson) :
    (jacobsonEquiv x : Module.End (ZMod 2) JacobsonSpace) = shiftRep x := rfl

theorem jacobsonEquiv_presS : jacobsonEquiv presS = jacobsonS :=
  Subtype.ext ((coe_jacobsonEquiv presS).trans shiftRep_presS)

theorem jacobsonEquiv_presT : jacobsonEquiv presT = jacobsonT :=
  Subtype.ext ((coe_jacobsonEquiv presT).trans shiftRep_presT)

instance : Countable ToeplitzJacobson := jacobsonEquiv.injective.countable

end

