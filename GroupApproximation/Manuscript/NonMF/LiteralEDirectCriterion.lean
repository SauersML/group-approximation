import GroupApproximation.Manuscript.OneSidedMFRadical.PrintedCriterion
import GroupApproximation.Meta.AxiomGuard
import GroupApproximation.Sofic.LiteralNonMFEndpoint

/-!
# A direct one-sided criterion and its literal-E application

This module exposes the one-sided normal-Kazhdan obstruction without asking a
reader to introduce an MF radical.  Its first endpoint says directly that the
normal Kazhdan subgroup is killed by every genuine norm-matrix-corona
representation and that a nontrivial such subgroup obstructs operator MF.

The second endpoint instantiates that statement for the literal group `E`.  It
also records, in one proposition, the exact bridge between the commutator
printed in the paper, the intrinsic printed defect, and the older
compression-datum defect normal closure.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF

open scoped commutatorElement

noncomputable section

/-! ## The reader-facing criterion -/

/-- The direct content of the one-sided normal-Kazhdan criterion: every
genuine norm-matrix-corona representation kills `K`, and a nontrivial `K`
therefore prevents an operator-MF embedding. -/
def DirectNormalKazhdanCriterion : Prop :=
  ∀ (G : Type) [Group G] [Countable G] (L : Subgroup G),
    HasKazhdanPropertyT.{0, 0} ↥L →
      ∀ (K : Subgroup G) [K.Normal], HasKazhdanPropertyT.{0, 0} ↥K →
        K ≤ OneSidedMFRadical.printedDefect L →
          ((∀ (X : ℕ → FiniteModel)
              (hX : ∀ n, 0 < Fintype.card (X n)),
              letI : ∀ n, Nonempty (X n) :=
                fun n ↦ Fintype.card_pos_iff.mp (hX n)
              ∀ rho : G →* unitary (NormMatrixCStarCorona (fun n ↦ X n)),
                K ≤ rho.ker) ∧
            (K ≠ ⊥ → ¬ IsOperatorMF G))

/-- The direct criterion, obtained from the exact printed-defect shadow and
normal-Kazhdan theorems.  The statement itself contains no radical object. -/
theorem manuscriptDirectNormalKazhdanCriterion :
    DirectNormalKazhdanCriterion := by
  intro G _ _ L hL K _ hK hKD
  have hres : K ≤ actualCoronaMFResidual G :=
    OneSidedMFRadical.normalKazhdan_le_actualCoronaMFResidual_of_le_printedDefect
      L hL K hK hKD
  constructor
  · intro X hX
    letI : ∀ n, Nonempty (X n) :=
      fun n ↦ Fintype.card_pos_iff.mp (hX n)
    intro rho k hk
    apply MonoidHom.mem_ker.mpr
    exact (mem_actualCoronaMFResidual_iff.mp (hres hk)) X hX rho
  · intro hne hMF
    have hCDE : IsCDEOperatorMF G :=
      (isCDEOperatorMF_iff_isOperatorMF G).mpr hMF
    have hbot : actualCoronaMFResidual G = ⊥ :=
      isCDEOperatorMF_iff_actualCoronaMFResidual_eq_bot.mp hCDE
    exact hne (le_bot_iff.mp (hbot ▸ hres))

/-! ## The literal group `E` -/

namespace LiteralE

open LiteralNonMFPresentation LiteralNonMFEndpoint

/-- The copy of the literal Kazhdan base inside `E`. -/
abbrev baseSubgroup : Subgroup MarkedGroup := baseMap.range

/-- The paper's distinguished commutator `[tct⁻¹, v₁]`. -/
abbrev defect : MarkedGroup :=
  ⁅stable * lamp * stable⁻¹, baseMap (PresentedGroup.of v1Index)⁆

/-- The stable letter compresses the image of the literal base. -/
theorem stable_mem_compressionSet : stable ∈ compressionSet baseSubgroup := by
  intro delta hdelta
  obtain ⟨g, rfl⟩ := hdelta
  exact stable_conjugates_base_into_base g

/-- The lamp centralizes the image of the literal base. -/
theorem lamp_mem_centralizer :
    ∀ delta ∈ baseSubgroup, Commute lamp delta := by
  rintro _ ⟨g, rfl⟩
  exact lamp_commutes_base g

/-- The displayed commutator is one of the generators of the paper's exact
intrinsic defect. -/
theorem defect_mem_printedDefect :
    defect ∈ OneSidedMFRadical.printedDefect baseSubgroup := by
  exact OneSidedMFRadical.printedDefect_generator_mem baseSubgroup
    stable_mem_compressionSet lamp_mem_centralizer
    ⟨PresentedGroup.of v1Index, rfl⟩

/-- The two-point subgroup generated by the central mark lies in the paper's
exact intrinsic defect. -/
theorem literalInvolutionSubgroup_le_printedDefect :
    literalInvolutionSubgroup ≤
      OneSidedMFRadical.printedDefect baseSubgroup := by
  rw [literalInvolutionSubgroup,
    centralInvolutionSubgroup_le_iff_mem mark mark_sq]
  rw [mark_eq_rootCommutator_sq]
  exact (OneSidedMFRadical.printedDefect baseSubgroup).pow_mem
    defect_mem_printedDefect 2

/-- Property `(T)` for the image of the literal base. -/
theorem baseSubgroup_hasKazhdanPropertyT :
    HasKazhdanPropertyT.{0, 0} ↥baseSubgroup :=
  HasKazhdanPropertyT.of_surjective baseMap.rangeRestrict
    baseMap.rangeRestrict_surjective
    LiteralBaseP13PropertyTBridge.manuscriptBaseHasKazhdanPropertyT.{0}.1

/-- Property `(T)` for the finite two-point subgroup. -/
theorem literalInvolutionSubgroup_hasKazhdanPropertyT :
    HasKazhdanPropertyT.{0, 0} ↥literalInvolutionSubgroup :=
  hasKazhdanPropertyT_of_finite literalInvolutionSubgroup

/-- The literal two-point subgroup is nontrivial. -/
theorem literalInvolutionSubgroup_ne_bot : literalInvolutionSubgroup ≠ ⊥ :=
  (Subgroup.nontrivial_iff_ne_bot literalInvolutionSubgroup).mp inferInstance

/-- **The complete direct application at the literal group `E`.**

The conjunction follows the intended manuscript proof in order: the image
base is Kazhdan; the paper's commutator generates the exact printed defect;
the central mark is its nontrivial involutive square; its two-point subgroup
lies in both defect formulations; every norm-corona representation kills that
subgroup; and `E` is not operator MF. -/
theorem manuscriptLiteralEOneSidedApplication :
    HasKazhdanPropertyT.{0, 0} ↥baseSubgroup ∧
      defect ∈ OneSidedMFRadical.printedDefect baseSubgroup ∧
      mark = defect ^ 2 ∧
      mark ≠ 1 ∧ mark ^ 2 = 1 ∧
      (∀ g : MarkedGroup, Commute mark g) ∧
      literalInvolutionSubgroup ≤
        OneSidedMFRadical.printedDefect baseSubgroup ∧
      literalInvolutionSubgroup ≤
        inclusionData.toKazhdanCompressionCore.defectNormal ∧
      (∀ (X : ℕ → FiniteModel)
          (hX : ∀ n, 0 < Fintype.card (X n)),
        letI : ∀ n, Nonempty (X n) :=
          fun n ↦ Fintype.card_pos_iff.mp (hX n)
        ∀ rho : MarkedGroup →*
          unitary (NormMatrixCStarCorona (fun n ↦ X n)),
            literalInvolutionSubgroup ≤ rho.ker) ∧
      ¬ IsOperatorMF MarkedGroup := by
  have happ := manuscriptDirectNormalKazhdanCriterion
    MarkedGroup baseSubgroup baseSubgroup_hasKazhdanPropertyT
    literalInvolutionSubgroup literalInvolutionSubgroup_hasKazhdanPropertyT
    literalInvolutionSubgroup_le_printedDefect
  exact ⟨baseSubgroup_hasKazhdanPropertyT, defect_mem_printedDefect,
    mark_eq_rootCommutator_sq,
    LiteralNonMFLinearWitness.literal_mark_ne_one, mark_sq, mark_central,
    literalInvolutionSubgroup_le_printedDefect,
    literalInvolutionSubgroup_le_defectNormal, happ.1,
    happ.2 literalInvolutionSubgroup_ne_bot⟩

end LiteralE
end
end NonMF
end Manuscript
end GroupApproximation

#audit_closed_axioms GroupApproximation.Manuscript.NonMF.manuscriptDirectNormalKazhdanCriterion
#audit_closed_axioms GroupApproximation.Manuscript.NonMF.LiteralE.manuscriptLiteralEOneSidedApplication
