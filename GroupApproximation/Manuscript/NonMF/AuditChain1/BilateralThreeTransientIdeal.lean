import GroupApproximation.Manuscript.NonMFSentences.ChainCoreClosures
import GroupApproximation.Manuscript.NonMFSentences.CoreModelsLEFClosed
import GroupApproximation.Manuscript.ChainCore.TransientIdealDefectSpanConsumers
import GroupApproximation.Dynamics.ClopenDefectRestriction
import GroupApproximation.Algebra.LEFRingStablyFinite
import GroupApproximation.Meta.AxiomGuard

/-!
# Audit repairs for `sec:chain-core`: defects avoid `CR(T)`, and `prop:bilateral-three` over `I`

`non_mf_groups_exist.tex`, Section `sec:chain-core`.

## Defects avoid `Y` (tex 1455–1462, proof of `lem:chain-core-models`)

> They avoid $Y$: for any compressed clopen $P$, set $p=1_P$, $d=1_{P\setminus T(P)}$ and calculate
> $s=up+1-p,\ t=pu^{-1}+1-p,\ ts=1,\ st=1-d.$
> Restriction to the directly finite ring $R_Y$ forces $d|_Y=0$.

The corpus states these steps for an arbitrary invariant `Y` *over the premise* that `R_Y` is directly
finite (`ClopenCrossedProduct.printedDefectsAvoidY`, `ClopenCrossedProduct.printedRestrictionKillsDefect`).
`manuscriptSentence_defectsAvoidChainRecurrentSet` is the closed statement for the section's
`Y = CR(T)`: the premise is discharged by "`R_Y` is LEF" (`ChainCore.coreModelsLEFStatement`) and
"LEF rings are directly finite" (`Pestov91.IsLEFRing.isDedekindFiniteMonoid`).

## `prop:bilateral-three` (tex 1541–1547)

> For every finite field $k$ and $n\ge3$, the group $\GL_n(R_X)$ is MF
> if and only if it is LEF, if and only if $R_X$ is directly finite.
> Every homomorphism from $\GL_n(R_X)$ to an MF group kills $\EL_n(R_X,I)$.

The corpus endpoint `ChainCore.ChainCoreClosures.printedBilateralThree_closed` states the kill clause
with `I` spelled as the ideal generated by the defects (`BilateralThree.defectIdeal`), and only for MF
targets in `Type`.  In the manuscript `I` is the transient ideal `ker (R_X → R_Y)` of
`lem:transient-matrices` (tex 1468–1477), and "an MF group" is arbitrary.  The repairs:

* `manuscriptSentence_bilateralThreeMFTargetsKillTransientElementary`: for every MF group `M` in any
  universe and every homomorphism `f : GL_n(R_X) → M`, `f` kills `EL_n(R_X, I)` with
  `I = ClopenCrossedProduct.transientIdeal T k (image_chainRecurrentSet T)`.  Route: rewrite `I` as the
  defect ideal (`defectIdeal_eq_transientIdeal_chainRecurrentSet`), compose `f` with the faithful
  corona representation `ρ : M → U` of `M` (the corona `U` lives in `Type` and is MF through the
  identity), apply the closed corpus kill to `ρ ∘ f`, and cancel `ρ` by injectivity.
* `manuscriptSentence_bilateralThree`: the whole proposition, with both equivalences from
  `printedBilateralThree_closed` and the repaired kill clause.

Standing hypotheses of `sec:chain-core` (tex 1345): `X` is a nonempty compact metrizable
zero-dimensional space, spelled with a chosen metric, and `T` a homeomorphism.
-/

universe u

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace AuditChain1

/-- **"They avoid $Y$ ... $ts=1$, $st=1-d$. Restriction to the directly finite ring $R_Y$ forces
$d|_Y=0$"** (tex 1455–1462), for `Y = CR(T)`: for every compressed clopen `P`,
`t s = 1`, `s t = 1 - d`, the restriction of `d = 1_{P∖T(P)}` to `R_Y` vanishes, and
`P ∖ T(P)` does not meet `Y`. -/
theorem manuscriptSentence_defectsAvoidChainRecurrentSet
    (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] [Nonempty X]
    (T : X ≃ₜ X) (k : Type) [Field k] [Finite k] (P : Set X) (hP : IsClopen P)
    (hTP : T '' P ⊆ P) :
    ClopenCrossedProduct.defectT T k hP * ClopenCrossedProduct.defectS T k hP = 1 ∧
      ClopenCrossedProduct.defectS T k hP * ClopenCrossedProduct.defectT T k hP =
        1 - ClopenCrossedProduct.defectD T k hP ∧
      ClopenCrossedProduct.restrict T k (GroupApproximation.Dynamics.image_chainRecurrentSet T)
          (ClopenCrossedProduct.defectD T k hP) = 0 ∧
      (P \ T '' P) ∩ GroupApproximation.Dynamics.chainRecurrentSet T = ∅ := by
  have hDF : IsDedekindFiniteMonoid (ClopenCrossedProduct
      (ClopenCrossedProduct.restrictHomeo T
        (GroupApproximation.Dynamics.image_chainRecurrentSet T)) k) :=
    (GroupApproximation.ChainCore.coreModelsLEFStatement X T k).isDedekindFiniteMonoid
  obtain ⟨hts, hst, havoid⟩ := ClopenCrossedProduct.printedDefectsAvoidY X T k
    (GroupApproximation.Dynamics.chainRecurrentSet T)
    (GroupApproximation.Dynamics.image_chainRecurrentSet T) hDF P hP hTP
  exact ⟨hts, hst, (ClopenCrossedProduct.printedRestrictionKillsDefect X T k
    (GroupApproximation.Dynamics.chainRecurrentSet T)
    (GroupApproximation.Dynamics.image_chainRecurrentSet T) hDF P hP hTP).1, havoid⟩

/-- **"Every homomorphism from $\GL_n(R_X)$ to an MF group kills $\EL_n(R_X,I)$"** (tex 1545–1546),
with `I = ker (R_X → R_Y)` the transient ideal and MF targets in every universe. -/
theorem manuscriptSentence_bilateralThreeMFTargetsKillTransientElementary
    (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] [Nonempty X]
    (T : X ≃ₜ X) (k : Type) [Field k] [Finite k] (n : ℕ) (hn : 3 ≤ n) :
    ∀ (M : Type u) [Group M], IsOperatorMF M →
      ∀ f : (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ →* M,
        ∀ g ∈ relativeElementary (Fin n)
            (ClopenCrossedProduct.transientIdeal T k
              (GroupApproximation.Dynamics.image_chainRecurrentSet T)),
          f (g : (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ) = 1 := by
  intro M _ hM f g hg
  obtain ⟨Z, hZ, ρ, hρ⟩ := hM
  have hg' : g ∈ relativeElementary (Fin n)
      (GroupApproximation.Manuscript.ChainCore.BilateralThree.defectIdeal T k) := by
    rwa [GroupApproximation.defectIdeal_eq_transientIdeal_chainRecurrentSet T k]
  have hkill : (ρ.comp f) (g : (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ) = 1 :=
    (GroupApproximation.ChainCore.ChainCoreClosures.printedBilateralThree_closed X T k n hn).2.2
      (NormMatrixCoronaUnitary Z) ⟨Z, hZ, MonoidHom.id _, Function.injective_id⟩ (ρ.comp f) g hg'
  exact hρ (by rw [map_one]; exact hkill)

/-- **`prop:bilateral-three`, as printed** (tex 1541–1547): for every finite field `k` and `n ≥ 3`,
`GL_n(R_X)` is MF iff it is LEF iff `R_X` is directly finite, and every homomorphism from
`GL_n(R_X)` to an MF group kills `EL_n(R_X, I)`, `I = ker (R_X → R_Y)`. -/
theorem manuscriptSentence_bilateralThree
    (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] [Nonempty X]
    (T : X ≃ₜ X) (k : Type) [Field k] [Finite k] (n : ℕ) (hn : 3 ≤ n) :
    (IsOperatorMF (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ ↔
        IsLEF (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ) ∧
      (IsLEF (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ ↔
        IsDedekindFiniteMonoid (ClopenCrossedProduct T k)) ∧
      ∀ (M : Type u) [Group M], IsOperatorMF M →
        ∀ f : (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ →* M,
          ∀ g ∈ relativeElementary (Fin n)
              (ClopenCrossedProduct.transientIdeal T k
                (GroupApproximation.Dynamics.image_chainRecurrentSet T)),
            f (g : (Matrix (Fin n) (Fin n) (ClopenCrossedProduct T k))ˣ) = 1 := by
  obtain ⟨hMF, hLEF, -⟩ :=
    GroupApproximation.ChainCore.ChainCoreClosures.printedBilateralThree_closed X T k n hn
  exact ⟨hMF, hLEF, manuscriptSentence_bilateralThreeMFTargetsKillTransientElementary X T k n hn⟩

end AuditChain1
end NonMF
end Manuscript
end GroupApproximation

#audit_axioms GroupApproximation.Manuscript.NonMF.AuditChain1.manuscriptSentence_defectsAvoidChainRecurrentSet
#audit_axioms GroupApproximation.Manuscript.NonMF.AuditChain1.manuscriptSentence_bilateralThreeMFTargetsKillTransientElementary
#audit_axioms GroupApproximation.Manuscript.NonMF.AuditChain1.manuscriptSentence_bilateralThree
