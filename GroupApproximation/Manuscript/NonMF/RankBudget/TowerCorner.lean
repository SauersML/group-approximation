import GroupApproximation.Algebra.ReturnTowerUnits
import GroupApproximation.Dynamics.ReturnTowerCrossedProduct
import GroupApproximation.Dynamics.ReturnRingUnit
import GroupApproximation.Meta.AxiomGuard

/-!
# `cor:dynamic-rank-budget`: the return tower, the corner and the unitization

`non_mf_groups_exist.tex`, proof of Corollary `cor:dynamic-rank-budget`, tex 1727–1741:

> For $0\le i<2r-1$ put
> $D_i=\bigcup_{h>i}C_h,\ a_i=u^i1_{D_i},\ b_i=1_{D_i}u^{-i}.$
> The tower partition gives $b_i a_j=0$ for $i\ne j$, $b_i a_i=1_{D_i}$ and $\sum_i a_i b_i=1$.
> Thus $R_X$ is a unital corner of $M_{2r-1}(P_C)$, via $x\mapsto(b_i x a_j)_{ij}$.   (tex 1731–1732)
> For $i<r$ we have $D_i=C$, so the first $r$ levels give the injection
> $\Phi\colon M_r(P_C)\to R_X$, $\Phi(A)=\sum_{i,j<r}a_i A_{ij}b_j$.
> Unitization embeds $\GL_{nr}(P_C)$ into $\GL_n(R_X)$.                               (tex 1739)
> For $n\ge2$, block elementary flattening puts the image of
> $\EL_{nr}(P_C)$ inside $\EL_n(R_X)$.                                                   (tex 1740–1741)

Objects, all concrete: `R_X = ClopenCrossedProduct T k`, the return section `C`
(`IsReturnSection T r C`), `P_C = ReturnCorner k hC = p_C R_X p_C` with `p_C = 1_C`,
`a_i = towerA k hC i = u^i 1_{D_i}` and `b_i = towerB k hC i = 1_{D_i} u^{-i}`.
Matrices of size `nr` are indexed by `Fin n × Fin r` (the block decomposition used by the flattening),
and `EL` is `GroupApproximation.elementaryGroup`, the subgroup generated by elementary transvections.

Proof route.  The corpus instance `returnTowerUnits k hC hr` of `ReturnTowerUnits` (closed:
the tower-partition identities are proved in `Dynamics/ReturnTowerCrossedProduct`) carries

* `cornerEquiv : R_X ≃+* E M_{2r-1}(P_C) E` with `E = toMatrix 1`, whose entries are `b_i x a_j` by
  definition (`toMatrix_apply`);
* `flatUnitizeGL n = unitizeGL n ∘ (block flattening)⁻¹`, injective (`flatUnitizeGL_injective`),
  sending `g` to `(1 - Φ(1)) I_n + Φ_n(g)`, with `Φ(1) = ∑_{i<r} a_i b_i` (`phi_one`);
* `map_flat_elementaryGroup_le`: for nontrivial `n` the image of `EL_{nr}(P_C)` lies in `EL_n(R_X)`.

The endpoints below state the three printed sentences with those concrete formulas and are proved
from these closed declarations.
-/

namespace GroupApproximation.Manuscript.NonMF.RankBudget

/-- The flattened unitization, entrywise: `ψ(g)_{ij} = δ_{ij}(1 - Φ(1)) + Φ((g_{(i,a),(j,b)})_{ab})`. -/
theorem flatUnitizeGL_apply {R : Type*} [Ring R] {N r : ℕ}
    (τ : GroupApproximation.ChainCore.ReturnTowerUnits R N r)
    (n : Type*) [Fintype n] [DecidableEq n]
    (g : (Matrix (n × Fin r) (n × Fin r) τ.Base)ˣ) (i j : n) :
    ((τ.flatUnitizeGL n g : (Matrix n n R)ˣ) : Matrix n n R) i j =
      (if i = j then 1 - τ.phi 1 else 0) +
        ∑ a : Fin r, ∑ b : Fin r,
          τ.a (τ.lo a) * ((g : Matrix (n × Fin r) (n × Fin r) τ.Base) (i, a) (j, b) : R) *
            τ.b (τ.lo b) :=
  rfl

/-- The flattened unitization, entrywise, with `Φ(1) = ∑_{l<r} a_l b_l`. -/
theorem flatUnitizeGL_apply_sum {R : Type*} [Ring R] {N r : ℕ}
    (τ : GroupApproximation.ChainCore.ReturnTowerUnits R N r)
    (n : Type*) [Fintype n] [DecidableEq n]
    (g : (Matrix (n × Fin r) (n × Fin r) τ.Base)ˣ) (i j : n) :
    ((τ.flatUnitizeGL n g : (Matrix n n R)ˣ) : Matrix n n R) i j =
      (if i = j then 1 - ∑ l : Fin r, τ.a (τ.lo l) * τ.b (τ.lo l) else 0) +
        ∑ a : Fin r, ∑ b : Fin r,
          τ.a (τ.lo a) * ((g : Matrix (n × Fin r) (n × Fin r) τ.Base) (i, a) (j, b) : R) *
            τ.b (τ.lo b) :=
  (flatUnitizeGL_apply τ n g i j).trans (by rw [τ.phi_one])

/-- **tex 1731–1732**, "Thus $R_X$ is a unital corner of $M_{2r-1}(P_C)$, via
$x\mapsto(b_i x a_j)_{ij}$": there are an idempotent `E ∈ M_{2r-1}(P_C)` and a ring isomorphism
`R_X ≃+* E M_{2r-1}(P_C) E` (unital: `E` is the unit of the corner) whose `(i,j)` entry at `x` is
`b_i x a_j`. -/
theorem manuscriptSentence_returnRingUnitalCornerOfTowerMatrices
    {X : Type*} [TopologicalSpace X] (T : X ≃ₜ X) {r : ℕ} {C : Set X}
    (k : Type*) [Ring k] (hC : GroupApproximation.ChainCore.IsReturnSection T r C) (hr : 1 ≤ r) :
    ∃ (E : Matrix (Fin (2 * r - 1)) (Fin (2 * r - 1)) (GroupApproximation.ChainCore.ReturnCorner k hC))
      (hE : IsIdempotentElem E)
      (e : GroupApproximation.ClopenCrossedProduct T k ≃+*
        GroupApproximation.MFQuotientUnits.Corner
          (Matrix (Fin (2 * r - 1)) (Fin (2 * r - 1)) (GroupApproximation.ChainCore.ReturnCorner k hC))
          E hE),
      ∀ (x : GroupApproximation.ClopenCrossedProduct T k) (i j : Fin (2 * r - 1)),
        (((e x : Matrix (Fin (2 * r - 1)) (Fin (2 * r - 1))
              (GroupApproximation.ChainCore.ReturnCorner k hC)) i j :
            GroupApproximation.ChainCore.ReturnCorner k hC) : GroupApproximation.ClopenCrossedProduct T k) =
          GroupApproximation.ChainCore.towerB k hC i * x * GroupApproximation.ChainCore.towerA k hC j :=
  ⟨(GroupApproximation.ChainCore.returnTowerUnits k hC hr).toMatrix 1,
    (GroupApproximation.ChainCore.returnTowerUnits k hC hr).isIdempotentElem_toMatrix_one,
    (GroupApproximation.ChainCore.returnTowerUnits k hC hr).cornerEquiv, fun _ _ _ => rfl⟩

#audit_axioms manuscriptSentence_returnRingUnitalCornerOfTowerMatrices

/-- **tex 1739**, "Unitization embeds $\GL_{nr}(P_C)$ into $\GL_n(R_X)$": there is an injective group
homomorphism `ψ : GL_{nr}(P_C) → GL_n(R_X)` (sizes `nr = |Fin n × Fin r|`), the unitization
`ψ(g) = (1 - Φ(1)) I_n + Φ_n(g)` of the first-`r`-levels injection `Φ`, i.e.
`ψ(g)_{ij} = δ_{ij}(1 - ∑_{l<r} a_l b_l) + ∑_{a,b<r} a_a g_{(i,a),(j,b)} b_b`. -/
theorem manuscriptSentence_unitizationEmbedsGL
    {X : Type*} [TopologicalSpace X] (T : X ≃ₜ X) {r : ℕ} {C : Set X}
    (k : Type*) [Ring k] (hC : GroupApproximation.ChainCore.IsReturnSection T r C) (hr : 1 ≤ r)
    (n : ℕ) :
    ∃ ψ : (Matrix (Fin n × Fin r) (Fin n × Fin r) (GroupApproximation.ChainCore.ReturnCorner k hC))ˣ →*
        (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T k))ˣ,
      Function.Injective ψ ∧
        ∀ (g : (Matrix (Fin n × Fin r) (Fin n × Fin r) (GroupApproximation.ChainCore.ReturnCorner k hC))ˣ)
          (i j : Fin n),
          ((ψ g : (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T k))ˣ) :
              Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T k)) i j =
            (if i = j then
                1 - ∑ l : Fin r,
                  GroupApproximation.ChainCore.towerA k hC l * GroupApproximation.ChainCore.towerB k hC l
              else 0) +
              ∑ a : Fin r, ∑ b : Fin r,
                GroupApproximation.ChainCore.towerA k hC a *
                  ((g : Matrix (Fin n × Fin r) (Fin n × Fin r)
                      (GroupApproximation.ChainCore.ReturnCorner k hC)) (i, a) (j, b) :
                    GroupApproximation.ClopenCrossedProduct T k) *
                  GroupApproximation.ChainCore.towerB k hC b :=
  ⟨(GroupApproximation.ChainCore.returnTowerUnits k hC hr).flatUnitizeGL (Fin n),
    (GroupApproximation.ChainCore.returnTowerUnits k hC hr).flatUnitizeGL_injective (Fin n),
    fun g i j => flatUnitizeGL_apply_sum (GroupApproximation.ChainCore.returnTowerUnits k hC hr)
      (Fin n) g i j⟩

#audit_axioms manuscriptSentence_unitizationEmbedsGL

/-- **tex 1740–1741**, "For $n\ge2$, block elementary flattening puts the image of $\EL_{nr}(P_C)$
inside $\EL_n(R_X)$": for `n ≥ 2` the unitization `ψ` of tex 1739 (injective, with the printed
formula) maps the elementary subgroup `EL_{nr}(P_C)` into `EL_n(R_X)`. -/
theorem manuscriptSentence_blockElementaryFlatteningMapsEL
    {X : Type*} [TopologicalSpace X] (T : X ≃ₜ X) {r : ℕ} {C : Set X}
    (k : Type*) [Ring k] (hC : GroupApproximation.ChainCore.IsReturnSection T r C) (hr : 1 ≤ r)
    (n : ℕ) (hn : 2 ≤ n) :
    ∃ ψ : (Matrix (Fin n × Fin r) (Fin n × Fin r) (GroupApproximation.ChainCore.ReturnCorner k hC))ˣ →*
        (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T k))ˣ,
      Function.Injective ψ ∧
        (∀ (g : (Matrix (Fin n × Fin r) (Fin n × Fin r) (GroupApproximation.ChainCore.ReturnCorner k hC))ˣ)
          (i j : Fin n),
          ((ψ g : (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T k))ˣ) :
              Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T k)) i j =
            (if i = j then
                1 - ∑ l : Fin r,
                  GroupApproximation.ChainCore.towerA k hC l * GroupApproximation.ChainCore.towerB k hC l
              else 0) +
              ∑ a : Fin r, ∑ b : Fin r,
                GroupApproximation.ChainCore.towerA k hC a *
                  ((g : Matrix (Fin n × Fin r) (Fin n × Fin r)
                      (GroupApproximation.ChainCore.ReturnCorner k hC)) (i, a) (j, b) :
                    GroupApproximation.ClopenCrossedProduct T k) *
                  GroupApproximation.ChainCore.towerB k hC b) ∧
        (GroupApproximation.elementaryGroup (Fin n × Fin r)
            (GroupApproximation.ChainCore.ReturnCorner k hC)).map ψ ≤
          GroupApproximation.elementaryGroup (Fin n) (GroupApproximation.ClopenCrossedProduct T k) := by
  haveI : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.2 hn
  exact ⟨(GroupApproximation.ChainCore.returnTowerUnits k hC hr).flatUnitizeGL (Fin n),
    (GroupApproximation.ChainCore.returnTowerUnits k hC hr).flatUnitizeGL_injective (Fin n),
    fun g i j => flatUnitizeGL_apply_sum (GroupApproximation.ChainCore.returnTowerUnits k hC hr)
      (Fin n) g i j,
    (GroupApproximation.ChainCore.returnTowerUnits k hC hr).map_flat_elementaryGroup_le (Fin n)⟩

#audit_axioms manuscriptSentence_blockElementaryFlatteningMapsEL

end GroupApproximation.Manuscript.NonMF.RankBudget
