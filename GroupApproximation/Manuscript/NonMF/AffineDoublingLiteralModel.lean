import GroupApproximation.Sofic.AffineHNNBaseRealization
import GroupApproximation.Sofic.LiteralAffineRangeIndexEight
import GroupApproximation.Monsters.ExplicitIntegralLinearModel
import GroupApproximation.Meta.AxiomGuard

/-!
# The concrete instance of `prop:clifford-locally-rf` on the literal matrix model

`non_mf_groups_exist.tex`, the concrete instance in Section `sec:amenable-nonqd`
(tex lines 1589–1610):

> For a concrete instance, take
> `Γ̄ = ℤ³ ⋊ SL₃(ℤ) = { [[A, v], [0, 1]] : A ∈ SL₃(ℤ), v ∈ ℤ³ } ≤ GL₄(ℤ)`.
> ...
> Let `D = diag(2,2,2,1)`, `α(g) = DgD⁻¹`, so that `α(v,A) = (2v,A)`.  This is injective,
> and its image consists of the affine matrices whose translation coordinates are all even,
> so `[Γ̄ : α(Γ̄)] = 8`.

The development takes `ExplicitLinearModel.gammaBar ≤ GL₄(ℚ)`, the subgroup generated by six
affine matrices, for `Γ̄`, and `ExplicitLinearModel.conjD`, conjugation by
`ExplicitLinearModel.dU`, for `α`.  The census carriers of `α(v,A) = (2v,A)` and of the
description of the image were proved on `Monsters/AffineSL3Doubling.lean`, a separate
semidirect product whose `alpha` is defined by doubling the lattice coordinate, so they say
nothing about `gammaBar` and `conjD`.  This module states the printed claims on `gammaBar`
and `conjD` and proves them there.

* `printedGammaBarAffine`: `gammaBar` is exactly the set of affine matrices `[[A, v], [0, 1]]`
  with `A ∈ SL₃(ℤ)` and `v ∈ ℤ³` (`AffineHNNBase.gammaBar_affUnit_form` and
  `AffineHNNBase.affUnit_mem_gammaBar`), and it lies in the image of `GL₄(ℤ)`
  (`ExplicitIntegralLinearModel.map_gammaInt`).
* `printedConjDDefinition`: `D = diag(2,2,2,1)` and `α(g) = DgD⁻¹`.
* `printedConjDDoublesTranslation`: `α` sends `[[A, v], [0, 1]]` to `[[A, 2v], [0, 1]]`,
  which is `AffineHNNBase.dU_zpow_conj'` at exponent `-1`.
* `printedConjDRangeEvenTranslations`: `α` is injective, its image is the set of affine
  matrices whose translation coordinates are all even, and `[Γ̄ : α(Γ̄)] = 8`
  (`LiteralAffineRangeIndexEight.conjD_range_index_eq_eight`).
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace AffineDoublingLiteralModel

open ExplicitLinearModel AffineHNNBase LiteralP13MatrixModel

/-- Conjugation by `D` doubles the translation column of an affine matrix. -/
theorem dU_mul_affUnit_mul_inv (A : SL3) (q : Fin 3 → ℚ) :
    dU * affUnit A q * dU⁻¹ = affUnit A (fun i => 2 * q i) := by
  have h := dU_zpow_conj' (-1) A q (fun i => 2 * q i) (fun i => by norm_num)
  rwa [zpow_neg_one, inv_inv] at h

/-- **The display of `Γ̄`** (tex 1589–1597, the concrete instance after
`prop:clifford-locally-rf`).

> For a concrete instance, take
> `Γ̄ = ℤ³ ⋊ SL₃(ℤ) = { [[A, v], [0, 1]] : A ∈ SL₃(ℤ), v ∈ ℤ³ } ≤ GL₄(ℤ)`.

`AffineHNNBase.affUnit A v` is the matrix `[[A, v], [0, 1]]` (`AffineHNNBase.affUnit_val`),
and `ExplicitIntegralLinearModel.castGL` is the inclusion `GL₄(ℤ) → GL₄(ℚ)`. -/
def PrintedGammaBarAffine : Prop :=
  (∀ u : Matˣ, u ∈ gammaBar ↔
      ∃ (A : SL3) (v : Fin 3 → ℤ), u = affUnit A (fun i => (v i : ℚ))) ∧
    gammaBar ≤ ExplicitIntegralLinearModel.castGL.range

theorem printedGammaBarAffine : PrintedGammaBarAffine := by
  refine ⟨fun u => ⟨fun hu => ?_, ?_⟩, fun u hu => ?_⟩
  · obtain ⟨w, A, hw⟩ := gammaBar_affUnit_form hu
    exact ⟨A, w, hw⟩
  · rintro ⟨A, v, rfl⟩
    exact affUnit_mem_gammaBar v A
  · rw [← ExplicitIntegralLinearModel.map_gammaInt] at hu
    obtain ⟨x, -, rfl⟩ := Subgroup.mem_map.mp hu
    exact MonoidHom.mem_range.mpr ⟨x, rfl⟩

/-- **The definition of `D` and `α`** (tex 1603–1607).

> Let `D = diag(2,2,2,1)`, `α(g) = DgD⁻¹`,

`ExplicitLinearModel.dU` is `D`, and `ExplicitLinearModel.conjD : Γ̄ →* Γ̄` is `α`. -/
def PrintedConjDDefinition : Prop :=
  ((dU : Matˣ) : Mat) = Matrix.diagonal ![2, 2, 2, 1] ∧
    ∀ g : gammaBar, ((conjD g : gammaBar) : Matˣ) = dU * (g : Matˣ) * dU⁻¹

theorem printedConjDDefinition : PrintedConjDDefinition := by
  refine ⟨?_, fun _ => rfl⟩
  change dM = _
  rw [dM_eq_dScale]
  congr 1
  funext i
  fin_cases i <;> simp [dScale]

/-- **Printed sentence** (tex 1608).

> so that `α(v,A) = (2v,A)`.

`(v, A)` is the affine matrix `[[A, v], [0, 1]]` of the display of `Γ̄`. -/
def PrintedConjDDoublesTranslation : Prop :=
  ∀ (A : SL3) (v : Fin 3 → ℤ),
    ((conjD ⟨affUnit A (fun i => (v i : ℚ)), affUnit_mem_gammaBar v A⟩ : gammaBar) : Matˣ) =
      affUnit A (fun i => ((2 * v i : ℤ) : ℚ))

theorem printedConjDDoublesTranslation : PrintedConjDDoublesTranslation := by
  intro A v
  change dU * affUnit A (fun i => (v i : ℚ)) * dU⁻¹ = _
  rw [dU_mul_affUnit_mul_inv]
  congr 1
  funext i
  simp

/-- **Printed sentence** (tex 1608–1610).

> This is injective, and its image consists of the affine matrices whose translation
> coordinates are all even, so `[Γ̄ : α(Γ̄)] = 8`. -/
def PrintedConjDRangeEvenTranslations : Prop :=
  Function.Injective conjD ∧
    (∀ u : gammaBar, u ∈ conjD.range ↔
      ∃ (A : SL3) (v : Fin 3 → ℤ),
        (u : Matˣ) = affUnit A (fun i => (v i : ℚ)) ∧ ∀ i, Even (v i)) ∧
    conjD.range.index = 8

theorem printedConjDRangeEvenTranslations : PrintedConjDRangeEvenTranslations := by
  refine ⟨conjD_injective, fun u => ⟨fun hu => ?_, fun hu => ?_⟩,
    LiteralAffineRangeIndexEight.conjD_range_index_eq_eight⟩
  · obtain ⟨g, rfl⟩ := MonoidHom.mem_range.mp hu
    obtain ⟨w, A, hw⟩ := gammaBar_affUnit_form g.2
    refine ⟨A, fun i => 2 * w i, ?_, fun i => ⟨w i, two_mul (w i)⟩⟩
    change dU * (g : Matˣ) * dU⁻¹ = _
    rw [hw, dU_mul_affUnit_mul_inv]
    congr 1
    funext i
    simp
  · obtain ⟨A, v, hu, hv⟩ := hu
    refine MonoidHom.mem_range.mpr
      ⟨⟨affUnit A (fun i => ((v i / 2 : ℤ) : ℚ)), affUnit_mem_gammaBar (fun i => v i / 2) A⟩, ?_⟩
    apply Subtype.ext
    change dU * affUnit A (fun i => ((v i / 2 : ℤ) : ℚ)) * dU⁻¹ = (u : Matˣ)
    rw [dU_mul_affUnit_mul_inv, hu]
    congr 1
    funext i
    show (2 : ℚ) * ((v i / 2 : ℤ) : ℚ) = (v i : ℚ)
    exact_mod_cast Int.mul_ediv_cancel' (even_iff_two_dvd.mp (hv i))

end AffineDoublingLiteralModel
end NonMF
end Manuscript
end GroupApproximation

#audit_axioms GroupApproximation.Manuscript.NonMF.AffineDoublingLiteralModel.dU_mul_affUnit_mul_inv
#audit_closed_axioms GroupApproximation.Manuscript.NonMF.AffineDoublingLiteralModel.printedGammaBarAffine
#audit_closed_axioms GroupApproximation.Manuscript.NonMF.AffineDoublingLiteralModel.printedConjDDefinition
#audit_closed_axioms GroupApproximation.Manuscript.NonMF.AffineDoublingLiteralModel.printedConjDDoublesTranslation
#audit_closed_axioms GroupApproximation.Manuscript.NonMF.AffineDoublingLiteralModel.printedConjDRangeEvenTranslations
