import GroupApproximation.Manuscript.ChainCore.BilateralThreeCellDischarge
import GroupApproximation.Meta.AxiomGuard

/-!
# `prop:bilateral-three`, first paragraph of the proof: the corner subalgebra and `EL₃(S)`

`non_mf_groups_exist.tex`, proof of Proposition `prop:bilateral-three`, tex 1554–1558:

> (1554–1555) The unital subalgebra $S\subseteq pR_Xp$ generated by
> $s=up$, $t=pu^{-1}$ and $kp$ satisfies $ts=p$, $st=p-d$.
> (1556–1557) It is finitely generated, so $L=\EL_3(S)$ has
> property~\textup{(T)}~\cite[Theorem~1.1]{EJZ}.
> (1557–1558) Embed it in $\GL_3(R_X)$ by adjoining identity on $1-p$.

The corner `pR_Xp` is Mathlib's `IsIdempotentElem.Corner` of `p = 1_P`, a ring with identity `p`
(`BilateralThreeCell.Cell.Corner`), and `S` is `ChainCore.BilateralThree.cellRing T k hP hTP`,
the subring closure of `{s, t} ∪ {p (a·1) p | a ∈ k}` (`cellGeneratorSet`). Since `k` is central
in `LC(X,k)`, a subring of the corner containing `kp` is the unital `k`-subalgebra it generates.

## Proof route

* `S = Subring.closure {s, t, kp}` unfolds the `Finset` form of the finite generating set;
  `1_S = p`; the generators lie in `S` with values `up`, `pu⁻¹`, `a·p`; `ts = p` and
  `st = p - d` are `Cell.t_mul_s`, `Cell.s_mul_t` together with `d = 1_D` (`bilateralCell_d`).
* Finite generation: `S` is the closure of a finite set (`isFinitelyGeneratedRing_cellRing`).
  Property (T) of `EL₃(S)` is the repository's unconditional Ershov–Jaikin-Zapirain theorem
  `OneSidedMFRadical.FullDefectRingEJZUnconditional.ejz` (proved from the integral free case,
  no hypothesis argument), applied with `n = 3`.
* The embedding `g ↦ diag(1-p) + g` (`Cell.cornerEmbed`) is an injective homomorphism
  `EL₃(S) → GL₃(R_X)` whose image is the root subgroup `coreGroup` over the values of `S`, and
  that image has (T) as an isomorphic copy of `EL₃(S)`.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace BilateralA

variable {X : Type} [TopologicalSpace X] (T : X ≃ₜ X) (k : Type) [Field k] {P : Set X}

/-- The generator `kp` of `S` at `a ∈ k`: the corner element `p (a·1) p`. -/
noncomputable def kpCorner (hP : IsClopen P) (hTP : T '' P ⊆ P) (a : k) :
    (ClopenCrossedProduct.bilateralCell T k hP hTP).Corner :=
  ⟨(ClopenCrossedProduct.bilateralCell T k hP hTP).p *
      ClopenCrossedProduct.coeff T k (LocallyConstant.const X a) *
      (ClopenCrossedProduct.bilateralCell T k hP hTP).p,
    ClopenCrossedProduct.coeff T k (LocallyConstant.const X a), rfl⟩

/-- The value of the generator `kp` at `a` is `a·p`. -/
theorem kpCorner_val (hP : IsClopen P) (hTP : T '' P ⊆ P) (a : k) :
    (kpCorner T k hP hTP a).1 =
      ClopenCrossedProduct.coeff T k (LocallyConstant.const X a) *
        ClopenCrossedProduct.defectP T k hP := by
  have hc : ClopenCrossedProduct.defectP T k hP *
        ClopenCrossedProduct.coeff T k (LocallyConstant.const X a) =
      ClopenCrossedProduct.coeff T k (LocallyConstant.const X a) *
        ClopenCrossedProduct.defectP T k hP := by
    rw [ClopenCrossedProduct.defectP, ← map_mul, ← map_mul,
      mul_comm (LocallyConstant.charFn k hP)]
  show ClopenCrossedProduct.defectP T k hP *
      ClopenCrossedProduct.coeff T k (LocallyConstant.const X a) *
      ClopenCrossedProduct.defectP T k hP = _
  rw [hc, mul_assoc, ClopenCrossedProduct.defectP_mul_defectP T k hP]

theorem kpCorner_mem_cellRing [Finite k] (hP : IsClopen P) (hTP : T '' P ⊆ P) (a : k) :
    kpCorner T k hP hTP a ∈ ChainCore.BilateralThree.cellRing T k hP hTP := by
  have hgen : kpCorner T k hP hTP a ∈ ChainCore.BilateralThree.cellGeneratorSet T k hP hTP := by
    unfold ChainCore.BilateralThree.cellGeneratorSet
    exact Set.mem_union_right _ ⟨a, rfl⟩
  exact Subring.subset_closure (Finset.mem_coe.2
    ((Set.Finite.mem_toFinset (ChainCore.BilateralThree.cellGeneratorSet_finite T k hP hTP)).2
      hgen))

/-- **"The unital subalgebra $S\subseteq pR_Xp$ generated by $s=up$, $t=pu^{-1}$ and $kp$
satisfies $ts=p$, $st=p-d$."** (tex 1554–1555).

`S` is the subring of the corner `pR_Xp` generated by `s`, `t` and `kp`; its identity is `p`;
`s = up`, `t = pu⁻¹`, `kp` lie in `S`; and `ts = p`, `st = p - d` with `d = 1_D`. -/
theorem manuscriptSentence_cornerSubalgebraIdentities [Finite k] (hP : IsClopen P)
    (hTP : T '' P ⊆ P) :
    ChainCore.BilateralThree.cellRing T k hP hTP =
        Subring.closure (ChainCore.BilateralThree.cellGeneratorSet T k hP hTP) ∧
      (1 : (ClopenCrossedProduct.bilateralCell T k hP hTP).Corner) ∈
        ChainCore.BilateralThree.cellRing T k hP hTP ∧
      (1 : (ClopenCrossedProduct.bilateralCell T k hP hTP).Corner).1 =
        ClopenCrossedProduct.defectP T k hP ∧
      ((ClopenCrossedProduct.bilateralCell T k hP hTP).sCorner ∈
          ChainCore.BilateralThree.cellRing T k hP hTP ∧
        (ClopenCrossedProduct.bilateralCell T k hP hTP).sCorner.1 =
          (ClopenCrossedProduct.unit T k : ClopenCrossedProduct T k) *
            ClopenCrossedProduct.defectP T k hP) ∧
      ((ClopenCrossedProduct.bilateralCell T k hP hTP).tCorner ∈
          ChainCore.BilateralThree.cellRing T k hP hTP ∧
        (ClopenCrossedProduct.bilateralCell T k hP hTP).tCorner.1 =
          ClopenCrossedProduct.defectP T k hP *
            (((ClopenCrossedProduct.unit T k)⁻¹ : (ClopenCrossedProduct T k)ˣ) :
              ClopenCrossedProduct T k)) ∧
      (∀ a : k, kpCorner T k hP hTP a ∈ ChainCore.BilateralThree.cellRing T k hP hTP ∧
        (kpCorner T k hP hTP a).1 =
          ClopenCrossedProduct.coeff T k (LocallyConstant.const X a) *
            ClopenCrossedProduct.defectP T k hP) ∧
      (ClopenCrossedProduct.bilateralCell T k hP hTP).t *
          (ClopenCrossedProduct.bilateralCell T k hP hTP).s =
        ClopenCrossedProduct.defectP T k hP ∧
      (ClopenCrossedProduct.bilateralCell T k hP hTP).s *
          (ClopenCrossedProduct.bilateralCell T k hP hTP).t =
        ClopenCrossedProduct.defectP T k hP - ClopenCrossedProduct.defectD T k hP := by
  refine ⟨congrArg Subring.closure
      (Set.Finite.coe_toFinset (ChainCore.BilateralThree.cellGeneratorSet_finite T k hP hTP)),
    Subring.one_mem _, rfl,
    ⟨ChainCore.BilateralThree.sCorner_mem_cellRing T k hP hTP, rfl⟩,
    ⟨ChainCore.BilateralThree.tCorner_mem_cellRing T k hP hTP, rfl⟩,
    fun a => ⟨kpCorner_mem_cellRing T k hP hTP a, kpCorner_val T k hP hTP a⟩,
    (ClopenCrossedProduct.bilateralCell T k hP hTP).t_mul_s, ?_⟩
  rw [(ClopenCrossedProduct.bilateralCell T k hP hTP).s_mul_t,
    ClopenCrossedProduct.bilateralCell_p T k hP hTP,
    ClopenCrossedProduct.bilateralCell_d T k hP hTP]

/-- **"It is finitely generated, so $L=\EL_3(S)$ has property (T) [EJZ, Theorem 1.1]."**
(tex 1556–1557).

`S` is a finitely generated ring and `EL₃(S)` has Kazhdan's property (T); the cited theorem is
the repository's proved `FullDefectRingEJZUnconditional.ejz`. -/
theorem manuscriptSentence_finitelyGeneratedPropertyT [Finite k] (hP : IsClopen P)
    (hTP : T '' P ⊆ P) :
    IsFinitelyGeneratedRing ↥(ChainCore.BilateralThree.cellRing T k hP hTP) ∧
      HasKazhdanPropertyT.{0, 0}
        ↥(elementaryGroup (Fin 3) ↥(ChainCore.BilateralThree.cellRing T k hP hTP)) :=
  ⟨ChainCore.BilateralThree.isFinitelyGeneratedRing_cellRing T k hP hTP,
    OneSidedMFRadical.FullDefectRingEJZUnconditional.ejz
      ↥(ChainCore.BilateralThree.cellRing T k hP hTP)
      (ChainCore.BilateralThree.isFinitelyGeneratedRing_cellRing T k hP hTP) 3 le_rfl⟩

/-- **"Embed it in $\GL_3(R_X)$ by adjoining identity on $1-p$."** (tex 1557–1558).

The map `g ↦ diag(1 - p) + g` is an injective homomorphism `EL₃(S) → GL₃(R_X)`; its image is the
root subgroup generated by the `e_{ij}(x)`, `x ∈ S`, and this copy of `L` has property (T). -/
theorem manuscriptSentence_embedByIdentityOnComplement [Finite k] (hP : IsClopen P)
    (hTP : T '' P ⊆ P) :
    Function.Injective ((ClopenCrossedProduct.bilateralCell T k hP hTP).cornerEmbed
        (ChainCore.BilateralThree.cellRing T k hP hTP)) ∧
      (∀ g : ↥(elementaryGroup (Fin 3) ↥(ChainCore.BilateralThree.cellRing T k hP hTP)),
        (((ClopenCrossedProduct.bilateralCell T k hP hTP).cornerEmbed
            (ChainCore.BilateralThree.cellRing T k hP hTP) g :
              (Matrix (Fin 3) (Fin 3) (ClopenCrossedProduct T k))ˣ) :
            Matrix (Fin 3) (Fin 3) (ClopenCrossedProduct T k)) =
          Matrix.diagonal (fun _ => 1 - ClopenCrossedProduct.defectP T k hP) +
            (((g : (Matrix (Fin 3) (Fin 3)
                ↥(ChainCore.BilateralThree.cellRing T k hP hTP))ˣ)) :
              Matrix (Fin 3) (Fin 3) ↥(ChainCore.BilateralThree.cellRing T k hP hTP)).map
              (fun x => (x : (ClopenCrossedProduct.bilateralCell T k hP hTP).Corner).1)) ∧
      ((ClopenCrossedProduct.bilateralCell T k hP hTP).cornerEmbed
          (ChainCore.BilateralThree.cellRing T k hP hTP)).range =
        BilateralThreeCell.coreGroup
          (Set.range fun x : ↥(ChainCore.BilateralThree.cellRing T k hP hTP) =>
            (x : (ClopenCrossedProduct.bilateralCell T k hP hTP).Corner).1) ∧
      HasKazhdanPropertyT.{0, 0}
        ↥((ClopenCrossedProduct.bilateralCell T k hP hTP).cornerEmbed
          (ChainCore.BilateralThree.cellRing T k hP hTP)).range :=
  ⟨(ClopenCrossedProduct.bilateralCell T k hP hTP).cornerEmbed_injective _,
    fun _ => rfl,
    (ClopenCrossedProduct.bilateralCell T k hP hTP).range_cornerEmbed _,
    ChainCore.BilateralThree.hasKazhdanPropertyT_range_of_injective
      (ChainCore.BilateralThree.isFinitelyGeneratedRing_cellRing T k hP hTP) _
      ((ClopenCrossedProduct.bilateralCell T k hP hTP).cornerEmbed_injective _)⟩

end BilateralA
end NonMF
end Manuscript
end GroupApproximation

