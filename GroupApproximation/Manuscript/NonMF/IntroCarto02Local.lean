import Mathlib.GroupTheory.Finiteness
import GroupApproximation.Sofic.OperatorMFLocalNormalization
import GroupApproximation.Sofic.NormApproximableDirectLimit
import GroupApproximation.Meta.AxiomGuard

/-!
# MF is a local property: a countable group is MF iff its finitely generated subgroups are

`non_mf_groups_exist.tex`, Theorem `thm:amenable-trace`, remark after the proof (tex 284–286):

> Since $W_0$ is a direct limit of residually finite groups, it is MF~\cite[Corollary~10 and
> Proposition~13]{Korchagin}.

Korchagin's Proposition 13 (MF passes to direct limits), in its local form: for a countable group
`G`,

  `G` is MF  ⟺  every finitely generated subgroup of `G` is MF.

The printed MF definition (tex 87) is for countable groups, so `[Countable G]` is kept; it is
needed only for the backward direction, through
`OperatorMFLocalNormalization.isOperatorMF_iff_isNormApproximable_one`.

## Truth check

* Forward: a faithful homomorphism `G →* ∏ Mₙ / ⊕ Mₙ` restricts along the inclusion
  `H.subtype`, which is injective, so every subgroup (finitely generated or not) is MF.
* Backward: a finite test set `F ⊆ G` lies in `⟨F⟩ = Subgroup.closure F`, which is finitely
  generated by definition (`Subgroup.FG` is `∃ S : Finset G, closure S = H`), hence MF.  Being
  countable, `⟨F⟩` then has operator-norm local models at separation `1` on every finite set, in
  particular on `F`; extending such a model by the identity matrix off `⟨F⟩` gives a local model
  of `G` on `F` (`isNormApproximable_of_forall_finset_subgroup`).  So `G` has local models at
  separation `1` and, being countable, is MF.

## Route

* `isOperatorMF_subgroup`: restriction along `H.subtype`.
* `isOperatorMF_of_forall_fg`: `isOperatorMF_iff_isNormApproximable_one` twice, with
  `GroupApproximation.isNormApproximable_of_forall_finset_subgroup` (Sofic/NormApproximableDirectLimit).
* `manuscriptSentence_isOperatorMF_iff_forall_fg`: the equivalence.
* `manuscriptSentence_isOperatorMF_iff_forall_finset_closure`: the same, indexed by finite subsets.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace IntroCarto02Local

/-- **MF passes to subgroups**: restrict a faithful corona representation along the inclusion. -/
theorem isOperatorMF_subgroup {G : Type} [Group G] (hG : IsOperatorMF G) (H : Subgroup G) :
    IsOperatorMF H := by
  obtain ⟨X, hX, rho, hrho⟩ := hG
  exact ⟨X, hX, rho.comp H.subtype, hrho.comp H.subtype_injective⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.IntroCarto02Local.isOperatorMF_subgroup

/-- **Korchagin, Proposition 13, local form**: a countable group all of whose finitely generated
subgroups are MF is MF. -/
theorem isOperatorMF_of_forall_fg {G : Type} [Group G] [Countable G]
    (h : ∀ H : Subgroup G, H.FG → IsOperatorMF H) : IsOperatorMF G := by
  refine GroupApproximation.OperatorMFLocalNormalization.isOperatorMF_iff_isNormApproximable_one.mpr
    (GroupApproximation.isNormApproximable_of_forall_finset_subgroup fun F => ?_)
  refine ⟨Subgroup.closure (F : Set G),
    fun g hg => Subgroup.mem_closure_of_mem (Finset.mem_coe.mpr hg), ?_⟩
  exact GroupApproximation.OperatorMFLocalNormalization.isOperatorMF_iff_isNormApproximable_one.mp
    (h (Subgroup.closure (F : Set G)) ⟨F, rfl⟩)

#audit_axioms GroupApproximation.Manuscript.NonMF.IntroCarto02Local.isOperatorMF_of_forall_fg

/-- **MF is a local property** (Korchagin, Proposition 13): a countable group is MF if and only if
every finitely generated subgroup of it is MF. -/
theorem manuscriptSentence_isOperatorMF_iff_forall_fg {G : Type} [Group G] [Countable G] :
    IsOperatorMF G ↔ ∀ H : Subgroup G, H.FG → IsOperatorMF H :=
  ⟨fun hG H _ => isOperatorMF_subgroup hG H, isOperatorMF_of_forall_fg⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.IntroCarto02Local.manuscriptSentence_isOperatorMF_iff_forall_fg

/-- **MF is a local property**, indexed by finite subsets: a countable group is MF if and only if
the subgroup generated by each finite subset is MF. -/
theorem manuscriptSentence_isOperatorMF_iff_forall_finset_closure {G : Type} [Group G]
    [Countable G] :
    IsOperatorMF G ↔ ∀ F : Finset G, IsOperatorMF (Subgroup.closure (F : Set G)) := by
  constructor
  · intro hG F
    exact isOperatorMF_subgroup hG (Subgroup.closure (F : Set G))
  · intro h
    refine isOperatorMF_of_forall_fg fun H hH => ?_
    obtain ⟨S, rfl⟩ := hH
    exact h S

#audit_axioms GroupApproximation.Manuscript.NonMF.IntroCarto02Local.manuscriptSentence_isOperatorMF_iff_forall_finset_closure

end IntroCarto02Local
end NonMF
end Manuscript
end GroupApproximation
