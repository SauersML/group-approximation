import GroupApproximation.Manuscript.NonMF.HullFillCorrectedInputs
import GroupApproximation.Manuscript.NonMF.HullInputsProved
import GroupApproximation.Manuscript.NonMF.HullSmallCancellation
import GroupApproximation.Algebra.GroupTorsionFree
import Mathlib.GroupTheory.FinitelyPresentedGroup

/-!
# `lem:saturation`

This module states and proves the saturation lemma of
`non_mf_groups_exist.tex`:

> **Lemma (saturation).**  Let `G` be finitely presented, torsion-free, and
> acylindrically hyperbolic, let `N ⊴ G` be nontrivial, and let `F ⊆ G` be
> finite.  Then there is a surjective homomorphism `q : G → Q` such that `Q` is
> two-generated, finitely presented, torsion-free, and acylindrically
> hyperbolic, `q|_F` is injective, and `q(N) = Q`.

The proof follows the printed proof sentence by sentence.  Each printed sentence
is a named lemma or a commented step of `saturation`:

| printed sentence | Lean |
| --- | --- |
| "Because `N ⊴ G`, one has `N ∩ gNg⁻¹ = N` for every `g ∈ G`" | `twistedInter_eq_of_normal` |
| "this group is infinite because `G` is torsion-free and `N ≠ 1`" | `infinite_coe_of_torsionFree_of_ne_bot` |
| "Thus `N` acts non-elementarily on `Γ(G,A)` by Osin, Lemma 7.1" | `isSNormal_of_torsionFree` feeding `HullInputsCorrected.osinNonElementary` |
| "Torsion-freeness makes `N` suitable" | `suitable_of_torsionFree` |
| "By Hull, Corollary 5.7 and Lemma 5.8, `N` contains `h₁,h₂` with `N₀ = ⟨h₁,h₂⟩` suitable" | `HullInputsProved.exists_pair_suitable_of_torsionFree`, no longer a citation |
| "Apply Theorem `thm:hull` to `N₀` with `t₁,…,t_m` a finite generating set of `G` and with the set `F`" | `exists_finite_generating_family`, `HullInputsCorrected.smallCancellation` |
| the display `Q = ⟨q(t₁),…,q(t_m)⟩ ≤ q(N₀) ≤ q(N) ≤ Q` | `map_eq_top_of_generators_mem`, `map_eq_top_of_le` |
| "so `Q = q(N₀) = ⟨q(h₁),q(h₂)⟩`" | `closure_pair_map` |
| "The quotient is torsion-free by Theorem `thm:hull`" | `torsionFree_of_finiteOrder_lift` |
| "and finitely presented because `ker q` is normally generated by `m` elements" | `HullQuotientNG.kerNormallyGenerated` feeding `Group.IsFinitelyPresented.of_surjective` |

Torsion-freeness is the repository's `IsPowerTorsionFree` — *a positive power can
equal the identity only for the identity element* — which is the ordinary
group-theoretic notion the manuscript means, rather than Mathlib's stronger
`IsMulTorsionFree` (injectivity of every power map).  Finite presentation is
Mathlib's `Group.IsFinitelyPresented`, as everywhere else in this repository.

`saturation` has no open leaves of its own: what the manuscript cites and this
development does not prove — Hull's Theorem 7.1, with the remark on the kernel
of its quotient map as a field of that quotient, and Osin's Lemma 7.1 — is
collected as the two fields of
`HullCorrectedInputs.HullInputsCorrected`, which `saturation` takes as its
leading hypothesis.  So the citations are visible in the statement of
`lem:saturation` itself rather than hidden inside its proof.

Hull's Corollary 5.7 with Lemma 5.8 was a third citation and is not one any
more: over a torsion-free ambient group it is
`HullInputsProved.exists_pair_suitable_of_torsionFree`, and this proof applies
it there.  The kernel remark was a fourth, in a form that quantified over every
`HullQuotient`; `Manuscript.NonMF.HullFillKernelRefutation` refutes that form,
which is why the datum now travels with the quotient.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace TorsionFree

open GroupApproximation.HullGeometry

universe u

/-! ## "Because `N ⊴ G`, one has `N ∩ gNg⁻¹ = N` for every `g ∈ G`" -/

/-- **The first printed sentence of the proof of `lem:saturation`.**

> Because `N ⊴ G`, one has `N ∩ gNg⁻¹ = N` for every `g ∈ G`.

The intersection is written with the conjugation on the element rather than on
the subgroup, following `HullSuitable.IsSNormal`; the two readings agree because
`g` ranges over all of `G`. -/
theorem twistedInter_eq_of_normal {G : Type u} [Group G] (N : Subgroup G)
    [N.Normal] (g : G) :
    {x : G | x ∈ N ∧ g * x * g⁻¹ ∈ N} = (N : Set G) := by
  ext x
  simp only [Set.mem_setOf_eq, SetLike.mem_coe]
  constructor
  · rintro ⟨hx, -⟩
    exact hx
  · intro hx
    exact ⟨hx, (inferInstance : N.Normal).conj_mem x hx g⟩

/-- **The second printed sentence of the proof of `lem:saturation`.**

> …this group is infinite because `G` is torsion-free and `N ≠ 1`.

A nontrivial subgroup of a torsion-free group contains an element of infinite
order, and its integer powers are pairwise distinct. -/
theorem infinite_coe_of_torsionFree_of_ne_bot {G : Type u} [Group G]
    (hG : IsPowerTorsionFree G) {N : Subgroup G} (hN : N ≠ ⊥) :
    (N : Set G).Infinite := by
  obtain hbot | ⟨h, hmem, hne⟩ := N.bot_or_exists_ne_one
  · exact absurd hbot hN
  · refine Set.infinite_of_injective_forall_mem
      (f := fun n : ℤ => h ^ n)
      (injective_zpow_iff_not_isOfFinOrder.mpr
        (IsPowerTorsionFree.not_isOfFinOrder hG hne)) ?_
    intro n
    exact Subgroup.zpow_mem N hmem n

/-- **The two sentences together**: a nontrivial normal subgroup of a
torsion-free group is `s`-normal, which is the hypothesis of Osin's Lemma 7.1
that the proof of `lem:saturation` invokes next. -/
theorem isSNormal_of_torsionFree {G : Type u} [Group G]
    (hG : IsPowerTorsionFree G) (N : Subgroup G) [N.Normal] (hN : N ≠ ⊥) :
    HullSuitable.IsSNormal N := by
  intro g
  rw [twistedInter_eq_of_normal N g]
  exact infinite_coe_of_torsionFree_of_ne_bot hG hN

/-! ## "Torsion-freeness makes `N` suitable" -/

/-- **The fourth printed sentence of the proof of `lem:saturation`.**

> Torsion-freeness makes `N` suitable.

The first clause of Hull's Definition 1.4 has just been supplied by Osin's
Lemma 7.1; the third is free over a torsion-free ambient group, because there is
no nontrivial finite subgroup to normalize
(`HullSuitable.normalizesNoNontrivialFinite_of_torsionFree`). -/
theorem suitable_of_torsionFree {G : Type u} [Group G]
    (hG : IsPowerTorsionFree G) {A : Alphabet G} {N : Subgroup G}
    (hne : ActsNonElementarily N (Cayley.base A)) : Suitable A N :=
  ⟨hne, HullSuitable.normalizesNoNontrivialFinite_of_torsionFree hG N⟩

/-! ## "…with `t₁,…,t_m` a finite generating set of `G`" -/

/-- A finitely presented group carries a finite generating family
`t₁, …, t_m`, which is what `thm:hull` is applied to.  The relators of the
presentation play no role: only the surjection from a free group of finite rank
is used. -/
theorem exists_finite_generating_family (G : Type u) [Group G]
    [hG : Group.IsFinitelyPresented G] :
    ∃ (m : ℕ) (t : Fin m → G), Subgroup.closure (Set.range t) = ⊤ := by
  obtain ⟨n, φ, hφ, -⟩ := hG.out
  refine ⟨n, fun i => φ (FreeGroup.of i), ?_⟩
  have hrange : Set.range (fun i : Fin n => φ (FreeGroup.of i))
      = (φ : FreeGroup (Fin n) → G) ''
        Set.range (FreeGroup.of : Fin n → FreeGroup (Fin n)) :=
    Set.range_comp (fun x : FreeGroup (Fin n) => φ x)
      (FreeGroup.of : Fin n → FreeGroup (Fin n))
  rw [hrange, ← MonoidHom.map_closure, FreeGroup.closure_range_of]
  exact Subgroup.map_top_of_surjective φ hφ

/-! ## The display `Q = ⟨q(t₁),…,q(t_m)⟩ ≤ q(N₀) ≤ q(N) ≤ Q` -/

/-- **The left half of the printed display.**  If `t₁, …, t_m` generate `G`, if
`q` is onto, and if every `q(tᵢ)` lies in `q(N₀)`, then

`Q = ⟨q(t₁), …, q(t_m)⟩ ≤ q(N₀) ≤ Q`,

so `q(N₀) = Q`. -/
theorem map_eq_top_of_generators_mem {G : Type u} {Q : Type u} [Group G]
    [Group Q] (q : G →* Q) (hq : Function.Surjective q) {m : ℕ} {t : Fin m → G}
    (htop : Subgroup.closure (Set.range t) = ⊤) {N₀ : Subgroup G}
    (hmem : ∀ i : Fin m, q (t i) ∈ N₀.map q) : N₀.map q = ⊤ := by
  have himg : (q : G → Q) '' Set.range t = Set.range fun i => q (t i) :=
    (Set.range_comp (fun x : G => q x) t).symm
  have hQtop : Subgroup.closure (Set.range fun i => q (t i)) = ⊤ := by
    rw [← himg, ← MonoidHom.map_closure, htop]
    exact Subgroup.map_top_of_surjective q hq
  rw [eq_top_iff, ← hQtop, Subgroup.closure_le]
  rintro _ ⟨i, rfl⟩
  exact hmem i

/-- **The right half of the printed display.**  `q(N₀) ≤ q(N) ≤ Q` with
`q(N₀) = Q` forces `q(N) = Q`. -/
theorem map_eq_top_of_le {G : Type u} {Q : Type u} [Group G] [Group Q]
    (q : G →* Q) {N₀ N : Subgroup G} (hle : N₀ ≤ N) (h : N₀.map q = ⊤) :
    N.map q = ⊤ :=
  top_le_iff.mp (h.symm.trans_le (Subgroup.map_mono hle))

/-- **"so `Q = q(N₀) = ⟨q(h₁), q(h₂)⟩`."**  The image of a two-generated
subgroup is generated by the images of the two generators. -/
theorem closure_pair_map {G : Type u} {Q : Type u} [Group G] [Group Q]
    (q : G →* Q) (a b : G) :
    (Subgroup.closure ({a, b} : Set G)).map q
      = Subgroup.closure ({q a, q b} : Set Q) := by
  rw [MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]

/-! ## "The quotient is torsion-free by Theorem `thm:hull`" -/

/-- **The eighth printed sentence of the proof of `lem:saturation`.**

> The quotient is torsion-free by Theorem `thm:hull`.

The clause of `thm:hull` that is used is the last one: every element of finite
order in `Q` is the image of an element of the *same* order in `G`.  Over a
torsion-free `G` that source element has infinite order unless it is trivial, so
the only element of finite order in `Q` is the identity. -/
theorem torsionFree_of_finiteOrder_lift {G : Type u} {Q : Type u} [Group G]
    [Group Q] (hG : IsPowerTorsionFree G) (q : G →* Q)
    (hlift : ∀ y : Q, IsOfFinOrder y → ∃ g : G, q g = y ∧ orderOf g = orderOf y) :
    IsPowerTorsionFree Q := by
  intro y n hn hpow
  have hfin : IsOfFinOrder y := isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, hpow⟩
  obtain ⟨g, hgq, hord⟩ := hlift y hfin
  have hgfin : IsOfFinOrder g := by
    refine isOfFinOrder_iff_pow_eq_one.mpr ⟨orderOf g, ?_, pow_orderOf_eq_one g⟩
    rw [hord]
    exact hfin.orderOf_pos
  have hg1 : g = 1 := by
    by_contra hne1
    exact IsPowerTorsionFree.not_isOfFinOrder hG hne1 hgfin
  rw [← hgq, hg1, map_one]

/-! ## The lemma -/

/-- **The output of `lem:saturation`.**  Its fields are the printed conclusion,
one clause at a time:

> Then there is a surjective homomorphism `q : G → Q` such that `Q` is
> two-generated, finitely presented, torsion-free, and acylindrically
> hyperbolic, `q|_F` is injective, and `q(N) = Q`.

"Two-generated" is carried as the two elements together with the statement that
their closure is everything, because the proof produces them: they are the
images of Hull's `h₁, h₂`. -/
structure SaturationQuotient {G : Type u} [Group G] (N : Subgroup G)
    (F : Set G) where
  /-- The target group `Q`. -/
  Q : Type u
  /-- Its group structure. -/
  [group : Group Q]
  /-- The surjection `q : G → Q`. -/
  q : G →* Q
  /-- `q` is surjective. -/
  surjective : Function.Surjective q
  /-- The first of the two generators of `Q`. -/
  generatorOne : Q
  /-- The second of the two generators of `Q`. -/
  generatorTwo : Q
  /-- `Q` is two-generated. -/
  twoGenerated : Subgroup.closure ({generatorOne, generatorTwo} : Set Q) = ⊤
  /-- `Q` is finitely presented. -/
  [finitelyPresented : Group.IsFinitelyPresented Q]
  /-- `Q` is torsion-free. -/
  torsionFree : IsPowerTorsionFree Q
  /-- `Q` is acylindrically hyperbolic. -/
  [acylindricallyHyperbolic : IsAcylindricallyHyperbolic Q]
  /-- `q|_F` is injective. -/
  injOn : Set.InjOn q F
  /-- `q(N) = Q`. -/
  map_eq_top : N.map q = ⊤

namespace SaturationQuotient

variable {G : Type u} [Group G] {N : Subgroup G} {F : Set G}

instance instGroup (S : SaturationQuotient N F) : Group S.Q := S.group

instance instIsFinitelyPresented (S : SaturationQuotient N F) :
    Group.IsFinitelyPresented S.Q :=
  S.finitelyPresented

instance instIsAcylindricallyHyperbolic (S : SaturationQuotient N F) :
    IsAcylindricallyHyperbolic S.Q :=
  S.acylindricallyHyperbolic

end SaturationQuotient

/-- **`lem:saturation`.**

> Let `G` be finitely presented, torsion-free, and acylindrically hyperbolic,
> let `N ⊴ G` be nontrivial, and let `F ⊆ G` be finite.  Then there is a
> surjective homomorphism `q : G → Q` such that `Q` is two-generated, finitely
> presented, torsion-free, and acylindrically hyperbolic, `q|_F` is injective,
> and `q(N) = Q`.

The proof is the printed proof, in the printed order.  `hHull` carries the two
results the manuscript cites and this development does not prove; see
`HullCorrectedInputs.HullInputsCorrected`.  Hull's Corollary 5.7 with Lemma 5.8
is not among them — over a torsion-free ambient group it is
`HullInputsProved.exists_pair_suitable_of_torsionFree` — and the remark on the
kernel of `q` is a field of the quotient Hull's theorem produces rather than a
citation of its own, `Manuscript.NonMF.HullFillKernelRefutation` having refuted
the reading that makes it one. -/
theorem saturation {G : Type u} [Group G] [Group.IsFinitelyPresented G]
    [IsAcylindricallyHyperbolic G]
    (hHull : HullCorrectedInputs.HullInputsCorrected.{u})
    (hG : IsPowerTorsionFree G) (N : Subgroup G)
    [N.Normal] (hN : N ≠ ⊥) {F : Set G} (hF : F.Finite) :
    Nonempty (SaturationQuotient N F) := by
  classical
  -- The generating set `A` of the section preamble, "provided by Hull,
  -- Theorem 3.12".
  obtain ⟨A⟩ := exists_hullGeneratingSet G
  -- "Because `N ⊴ G`, one has `N ∩ gNg⁻¹ = N` for every `g ∈ G`; this group is
  -- infinite because `G` is torsion-free and `N ≠ 1`."
  have hsn : HullSuitable.IsSNormal N := isSNormal_of_torsionFree hG N hN
  -- "Thus `N` acts non-elementarily on `Γ(G,A)` by Osin, Lemma 7.1."
  have hnonelem : ActsNonElementarily N (Cayley.base A.alphabet) :=
    hHull.osinNonElementary A hG N hsn
  -- "Torsion-freeness makes `N` suitable."
  have hsuit : Suitable A.alphabet N := suitable_of_torsionFree hG hnonelem
  -- "By Hull, Corollary 5.7 and Lemma 5.8, `N` contains two elements `h₁, h₂`
  -- such that `N₀ = ⟨h₁, h₂⟩` is again suitable."
  obtain ⟨h₁, hh₁, h₂, hh₂, hsuit₀⟩ :=
    exists_pair_suitable_of_torsionFree hG hsuit
  have hN₀le : Subgroup.closure ({h₁, h₂} : Set G) ≤ N := by
    rw [Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact hh₁
    · exact hh₂
  -- "Apply Theorem `thm:hull` to `N₀` with `t₁, …, t_m` a finite generating set
  -- of `G` and with the set `F`."
  obtain ⟨m, t, htop⟩ := exists_finite_generating_family G
  obtain ⟨⟨H, hkerNG⟩⟩ := hHull.smallCancellation A hsuit₀ t hF
  -- The display `Q = ⟨q(t₁), …, q(t_m)⟩ ≤ q(N₀) ≤ q(N) ≤ Q`.
  have hN₀top : (Subgroup.closure ({h₁, h₂} : Set G)).map H.q = ⊤ :=
    map_eq_top_of_generators_mem H.q H.surjective htop H.mem_map
  -- "so `Q = q(N₀)` and `q(N) = Q`."
  have hNtop : N.map H.q = ⊤ := map_eq_top_of_le H.q hN₀le hN₀top
  -- "…`= ⟨q(h₁), q(h₂)⟩`."
  have hgen : Subgroup.closure ({H.q h₁, H.q h₂} : Set H.Q) = ⊤ := by
    rw [← closure_pair_map H.q h₁ h₂]
    exact hN₀top
  -- "The quotient is torsion-free by Theorem `thm:hull`."
  have htf : IsPowerTorsionFree H.Q :=
    torsionFree_of_finiteOrder_lift hG H.q H.finiteOrder_lift
  -- "…and finitely presented because `ker q` is normally generated by `m`
  -- elements."
  obtain ⟨S, -, hker⟩ := hkerNG
  have hfp : Group.IsFinitelyPresented H.Q :=
    Group.IsFinitelyPresented.of_surjective H.q H.surjective
      ⟨(S : Set G), S.finite_toSet, hker.symm⟩
  exact ⟨{ Q := H.Q
           group := H.group
           q := H.q
           surjective := H.surjective
           generatorOne := H.q h₁
           generatorTwo := H.q h₂
           twoGenerated := hgen
           finitelyPresented := hfp
           torsionFree := htf
           acylindricallyHyperbolic := H.acylindricallyHyperbolic
           injOn := H.injOn
           map_eq_top := hNtop }⟩

end TorsionFree
end NonMF
end Manuscript
end GroupApproximation
