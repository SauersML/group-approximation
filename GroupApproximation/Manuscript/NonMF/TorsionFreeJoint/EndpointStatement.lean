import GroupApproximation.Manuscript.NonMF.TorsionFreeCStar.RegularAlgebra
import GroupApproximation.Meta.AxiomGuard

/-!
# `thm:torsion-free` and `cor:regular-nonmf-algebra` for the same `Q`

`non_mf_groups_exist.tex`, `thm:torsion-free` (tex lines 295-301):

> There is a two-generated, finitely presented, torsion-free, acylindrically
> hyperbolic group `Q` with property (T) such that every homomorphism from `Q`
> to an MF group is trivial.  In particular, no nontrivial quotient of `Q` is
> MF.

and `cor:regular-nonmf-algebra` (tex lines 2203-2207), about THE group `Q` of
that theorem:

> The algebra `C*_r(Q)` is separable, unital, simple, and generated by two
> unitaries.  It has a unique tracial state and stable rank one, and it is
> stably finite but not MF.

`TorsionFreePrinted.PrintedTorsionFreeTheorem` and
`TorsionFreePrinted.PrintedRegularNonMFAlgebra` each quantify over their own `Q`.
This module states the two together, with one existential `Q`
(`PrintedTorsionFreeTheoremWithRegularAlgebra`).

The theorem clauses are copied from `PrintedTorsionFreeTheorem`.
`IsTwoGenerated Q` is unpacked into two named generators `g₁ g₂`, so that
"generated by two unitaries" names the canonical unitaries `λ(g₁), λ(g₂)`, in the
same form as `AuditTorsionFree.AlgebraSentence` (the closed star-subalgebra of
`B(ℓ²Q)` they generate is `C*_r(Q)`).  "Unital" is carried by the `CStarAlgebra`
instance, and the conjunct `(1 : C*_r(Q)) ≠ 0` records that the unit is nonzero.

## Proof route (this module)

`regularAlgebraClauses` proves every C⋆ clause, unconditionally, for any group
with the printed properties of `thm:torsion-free`:
* simple, unique trace, stable rank one, not MF:
  `TorsionFreeCStar.manuscriptSentence_reducedAlgebraSimpleUniqueTraceStableRankNotMF`
  (Dahmani-Guirardel-Osin 2.35 and Gerasimova-Osin 1.1, both proved in the corpus);
* separable and generated by `λ(g₁), λ(g₂)`:
  `TorsionFreePrintedSentences.manuscriptSentence_algebraSeparableGenerated`;
* stably finite: `TorsionFreePrintedSentences.manuscriptSentence_algebraStablyFinite`;
* the unit is nonzero: `C*_r(Q)` is nontrivial (`reducedGroupCStarNontrivial`).
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace TorsionFreeJoint

open GroupApproximation.Manuscript.NonMF.TorsionFree
open GroupApproximation.Manuscript.NonMF.TorsionFreePrinted
open GroupApproximation.ReducedGroupCStarTrace

/-- **`thm:torsion-free` together with `cor:regular-nonmf-algebra`, for the same `Q`.**

The seven clauses of `thm:torsion-free` (two-generated, written with two named
generators, finitely presented, torsion-free, acylindrically hyperbolic, property
(T), every homomorphism to an MF group trivial, no nontrivial quotient MF),
followed by the clauses of the corollary for `C*_r(Q)`: separable, unit nonzero,
`λ(g₁)` and `λ(g₂)` unitary and generating `C*_r(Q)` as a closed star-subalgebra,
simple, unique tracial state, stable rank one, stably finite, not MF. -/
def PrintedTorsionFreeTheoremWithRegularAlgebra : Prop :=
  ∃ (Q : Type) (_ : Group Q) (g₁ g₂ : Q),
    Subgroup.closure ({g₁, g₂} : Set Q) = ⊤ ∧
    Group.IsFinitelyPresented Q ∧ IsPowerTorsionFree Q ∧
    IsAcylindricallyHyperbolic Q ∧ HasKazhdanPropertyT.{0, 0} Q ∧
    (∀ (M : Type) (_ : Group M), IsOperatorMF M →
      ∀ (f : Q →* M) (x : Q), f x = 1) ∧
    (∀ (L : Type) (_ : Group L) (r : Q →* L), Function.Surjective r →
      Nontrivial L → ¬ IsOperatorMF L) ∧
    TopologicalSpace.SeparableSpace (ReducedGroupCStar Q) ∧
    (1 : ReducedGroupCStar Q) ≠ 0 ∧
    leftRegularOperator Q g₁ ∈ unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
    leftRegularOperator Q g₂ ∈ unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
    (StarAlgebra.adjoin ℂ
      ({leftRegularOperator Q g₁, leftRegularOperator Q g₂} :
        Set (GroupHilbert Q →L[ℂ] GroupHilbert Q))).topologicalClosure
      = reducedGroupCStarSubalgebra Q ∧
    IsSimpleCStar (ReducedGroupCStar Q) ∧
    HasUniqueTracialState (ReducedGroupCStar Q) ∧
    IsStableRankOne (ReducedGroupCStar Q) ∧
    IsStablyFiniteCStarAlgebra (ReducedGroupCStar Q) ∧
    ¬ IsMFAlgebra (ReducedGroupCStar Q)

/-- **The C⋆ clauses of `cor:regular-nonmf-algebra`**, for every finitely
presented, torsion-free, acylindrically hyperbolic group all of whose
homomorphisms to MF groups are trivial, at any two generators `g₁ g₂`. -/
theorem regularAlgebraClauses (Q : Type) [Group Q]
    [Group.IsFinitelyPresented Q] [IsAcylindricallyHyperbolic Q]
    (htf : IsPowerTorsionFree Q)
    (hkill : ∀ (M : Type) (_ : Group M), IsOperatorMF M →
      ∀ (f : Q →* M) (x : Q), f x = 1)
    {g₁ g₂ : Q} (hgen : Subgroup.closure ({g₁, g₂} : Set Q) = ⊤) :
    TopologicalSpace.SeparableSpace (ReducedGroupCStar Q) ∧
    (1 : ReducedGroupCStar Q) ≠ 0 ∧
    leftRegularOperator Q g₁ ∈ unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
    leftRegularOperator Q g₂ ∈ unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
    (StarAlgebra.adjoin ℂ
      ({leftRegularOperator Q g₁, leftRegularOperator Q g₂} :
        Set (GroupHilbert Q →L[ℂ] GroupHilbert Q))).topologicalClosure
      = reducedGroupCStarSubalgebra Q ∧
    IsSimpleCStar (ReducedGroupCStar Q) ∧
    HasUniqueTracialState (ReducedGroupCStar Q) ∧
    IsStableRankOne (ReducedGroupCStar Q) ∧
    IsStablyFiniteCStarAlgebra (ReducedGroupCStar Q) ∧
    ¬ IsMFAlgebra (ReducedGroupCStar Q) := by
  haveI : Countable Q := ChiodoBelegradek.countable_of_isFinitelyPresented Q
  obtain ⟨hsimple, huniq, hsr, hnotMF⟩ :=
    TorsionFreeCStar.manuscriptSentence_reducedAlgebraSimpleUniqueTraceStableRankNotMF
      Q htf hkill
  obtain ⟨hsep, hu₁, hu₂, hclosure⟩ :=
    TorsionFreePrintedSentences.manuscriptSentence_algebraSeparableGenerated Q hgen
  refine ⟨hsep, ?_, hu₁, hu₂, hclosure, hsimple, huniq, hsr,
    TorsionFreePrintedSentences.manuscriptSentence_algebraStablyFinite Q, hnotMF⟩
  -- "unital": the unit of the algebra is not zero.
  intro hone
  obtain ⟨a, b, hab⟩ := exists_pair_ne (ReducedGroupCStar Q)
  apply hab
  have hzero : ∀ x : ReducedGroupCStar Q, x = 0 := by
    intro x
    calc x = x * 1 := (mul_one x).symm
      _ = x * 0 := by rw [hone]
      _ = 0 := mul_zero x
  rw [hzero a, hzero b]

#audit_axioms GroupApproximation.Manuscript.NonMF.TorsionFreeJoint.regularAlgebraClauses

end TorsionFreeJoint
end NonMF
end Manuscript
end GroupApproximation
