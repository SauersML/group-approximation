import GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonPresentedKazhdanFinite
import GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonPresentedSentences
import GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonBlockAction
import GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonRankTwoInert
import GroupApproximation.Algebra.FinitaryLinearTransvections
import GroupApproximation.Meta.AxiomGuard

/-!
# Audit repairs in the remark after `prop:torsion-defect-ring` (the printed `J`)

## Transvections as relative roots

`non_mf_groups_exist.tex`, lines 1148--1152:

> Over $\F_2$ every element of $\GL_{\mathrm{fs}}(V^n)$ is a product of transvections, and each
> transvection is a relative root $e_{ij}(f_{uv})$ or, inside one coordinate, the commutator
> $[e_{ik}(f_{uw}),e_{ki}(f_{wv})]$ of two.

The census declarations state these facts for the operator model `jacobsonAlgebra`, whose
matrix units are `matUnitJ u v`.  The sentence is about the printed ring
`J = F_2⟨s,t | ts = 1⟩` (`ToeplitzJacobson`), acting on `V^n` through
`presBlockAct n = blockAct n ∘ EL_n(jacobsonEquiv)`.  Here:

* `presMatUnit u v = s^u (1 - st) t^v` is the printed `f_uv` in `J`, and
  `jacobsonEquiv (presMatUnit u v) = matUnitJ u v`;
* `presBlockAct n (e_ij(f_uv))` is the basis transvection `x ↦ x + x_(j,v) b_(i,u)`, for
  `i ≠ j`;
* `presBlockAct n [e_ik(f_uv), e_ki(f_vv)]` is the transvection with `(i,u) ≠ (i,v)`;
* `manuscriptSentence_presentedTransvectionsRelativeRoots`: for every `n`, `GL_fs(V^n)` is the
  subgroup generated by the basis transvections (every basis transvection an involution), and
  for `n ≥ 2` each basis transvection `τ_(i,u),(j,v)` is `presBlockAct n (e_ij(f_uv))` when
  `i ≠ j`, or, when `i = j`, `presBlockAct n [e_ik(f_uw), e_ki(f_wv)]` for some `k ≠ i` and `w`.

Route: transport along `jacobsonEquiv` (`elementaryCoefficientEquiv_elGen`,
`jacobsonEquiv_one_sub`), then `JacobsonSymbol.blockAct_elGen_matUnit` and
`JacobsonSymbol.blockAct_commutator_matUnit`.

## No compression obstruction at rank two

`non_mf_groups_exist.tex`, lines 1165--1168:

> A finite subgroup $L$ of a group $G$ admits no proper compression, since $uLu^{-1}\le L$
> forces $uLu^{-1}=L$; then $uC_G(L)u^{-1}=C_G(L)$ and $\mathfrak D_G(L)=1$, so
> Theorem~\ref{thm:compression-criterion} gives no obstruction at rank two.

The general statement is `JacobsonRankTwo.manuscriptSentence_finiteSubgroupAdmitsNoProperCompression`.
`manuscriptSentence_jacobsonRankTwoNoCompressionObstruction` states the rank-two conclusion:
every Kazhdan subgroup `L ≤ GL_2(J)` is finite, every `u ∈ Comp(L)` satisfies `uLu⁻¹ = L` and
`uC(L)u⁻¹ = C(L)`, and `𝔇(L) = 1`.  Finiteness is the closed endpoint
`JacobsonPresented.printedPresentedJacobsonRankTwoKazhdanFiniteField`.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace AuditOneSided2

open GroupApproximation.Manuscript.OneSidedMFRadical.TorsionComplementaryIdempotents
open GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonSymbol
open GroupApproximation.Manuscript.OneSidedMFRadical.JacobsonPresented
open GroupApproximation.FinitaryLinear
open scoped commutatorElement

/-! ## The printed matrix units `f_uv` of `J` -/

/-- The printed `f_uv = s^u (1 - st) t^v` in `J = F_2⟨s,t | ts = 1⟩`. -/
noncomputable def presMatUnit (u v : ℕ) : ToeplitzJacobson :=
  presS ^ u * ((1 : ToeplitzJacobson) - presS * presT) * presT ^ v

theorem jacobsonEquiv_presMatUnit (u v : ℕ) :
    jacobsonEquiv (presMatUnit u v) = matUnitJ u v := by
  rw [presMatUnit, matUnitJ, map_mul, map_mul, map_pow, map_pow, jacobsonEquiv_one_sub,
    jacobsonEquiv_presS, jacobsonEquiv_presT]

#audit_axioms jacobsonEquiv_presMatUnit

/-- `e_ij(f_uv)` acts on `V^n` as the basis transvection `τ_(i,u),(j,v)`. -/
theorem presBlockAct_elGen_presMatUnit (n : ℕ) {i j : Fin n} (hij : i ≠ j) (u v : ℕ) :
    presBlockAct n (elGen i j hij (presMatUnit u v)) =
      basisTransvection (binaryPowerBasis n)
        (show (⟨i, u⟩ : Σ _ : Fin n, ℕ) ≠ ⟨j, v⟩ from fun h ↦ hij (congrArg Sigma.fst h)) := by
  show blockAct n (elementaryCoefficientEquiv jacobsonEquiv
    (elGen i j hij (presMatUnit u v))) = _
  rw [elementaryCoefficientEquiv_elGen, jacobsonEquiv_presMatUnit]
  exact blockAct_elGen_matUnit n hij u v

#audit_axioms presBlockAct_elGen_presMatUnit

/-- `[e_ik(f_uv), e_ki(f_vv)]` acts on `V^n` as the basis transvection `τ_(i,u),(i,v)`. -/
theorem presBlockAct_commutator_presMatUnit (n : ℕ) {i k : Fin n} (hik : i ≠ k) {u v : ℕ}
    (huv : u ≠ v) :
    presBlockAct n ⁅elGen i k hik (presMatUnit u v), elGen k i (Ne.symm hik) (presMatUnit v v)⁆ =
      basisTransvection (binaryPowerBasis n)
        (show (⟨i, u⟩ : Σ _ : Fin n, ℕ) ≠ ⟨i, v⟩ from fun h ↦ huv (by simpa using h)) := by
  have h : elementaryCoefficientEquiv jacobsonEquiv
      ⁅elGen i k hik (presMatUnit u v), elGen k i (Ne.symm hik) (presMatUnit v v)⁆ =
        elGen i k hik (matUnitJ u v) * elGen k i (Ne.symm hik) (matUnitJ v v) *
          (elGen i k hik (matUnitJ u v))⁻¹ * (elGen k i (Ne.symm hik) (matUnitJ v v))⁻¹ := by
    rw [commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv,
      elementaryCoefficientEquiv_elGen, elementaryCoefficientEquiv_elGen,
      jacobsonEquiv_presMatUnit, jacobsonEquiv_presMatUnit]
  show blockAct n (elementaryCoefficientEquiv jacobsonEquiv
    ⁅elGen i k hik (presMatUnit u v), elGen k i (Ne.symm hik) (presMatUnit v v)⁆) = _
  rw [h]
  exact blockAct_commutator_matUnit n hik huv

#audit_axioms presBlockAct_commutator_presMatUnit

/-! ## The sentence -/

/-- **Printed (tex 1148--1152).**  Over `F_2`, `GL_fs(V^n)` is generated by the basis
transvections (each an involution, so every element is a product of transvections), and for
`n ≥ 2` each basis transvection `τ_(i,u),(j,v)` is the action of the relative root
`e_ij(f_uv)` of the printed `J` when `i ≠ j`, or, inside one coordinate `i = j`, of the
commutator `[e_ik(f_uw), e_kj(f_wv)]` for some `k ≠ i` and `w`. -/
theorem manuscriptSentence_presentedTransvectionsRelativeRoots :
    ∀ n : ℕ, binaryGLfs n = Subgroup.closure (basisTransvections (binaryPowerBasis n)) ∧
      (∀ (a b : Σ _ : Fin n, ℕ) (h : a ≠ b),
        basisTransvection (binaryPowerBasis n) h * basisTransvection (binaryPowerBasis n) h = 1) ∧
      (2 ≤ n → ∀ (i j : Fin n) (u v : ℕ) (h : (⟨i, u⟩ : Σ _ : Fin n, ℕ) ≠ ⟨j, v⟩),
        (∃ hij : i ≠ j,
          presBlockAct n (elGen i j hij (presMatUnit u v)) =
            basisTransvection (binaryPowerBasis n) h) ∨
        (i = j ∧ ∃ (k : Fin n) (hik : i ≠ k) (hkj : k ≠ j) (w : ℕ),
          presBlockAct n ⁅elGen i k hik (presMatUnit u w), elGen k j hkj (presMatUnit w v)⁆ =
            basisTransvection (binaryPowerBasis n) h)) := by
  intro n
  refine ⟨(manuscriptSentence_binaryGLfsProductOfTransvections n).1,
    (manuscriptSentence_binaryGLfsProductOfTransvections n).2, ?_⟩
  intro hn i j u v h
  rcases eq_or_ne i j with hij | hij
  · subst hij
    have huv : u ≠ v := by
      rintro rfl
      exact h rfl
    haveI : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr hn
    obtain ⟨k, hk⟩ := exists_ne ‹Fin n›
    right
    exact ⟨rfl, k, Ne.symm hk, hk, v, presBlockAct_commutator_presMatUnit n (Ne.symm hk) huv⟩
  · left
    exact ⟨hij, presBlockAct_elGen_presMatUnit n hij u v⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.AuditOneSided2.manuscriptSentence_presentedTransvectionsRelativeRoots

/-! ## No compression obstruction at rank two -/

/-- **Printed (tex 1165--1168), at rank two over the printed `J`.**  Every Kazhdan subgroup
`L ≤ GL_2(J)` is finite, every compressor `u ∈ Comp(L)` satisfies `uLu⁻¹ = L` and
`uC(L)u⁻¹ = C(L)`, and `𝔇(L) = 1`: the compression criterion gives no obstruction. -/
theorem manuscriptSentence_jacobsonRankTwoNoCompressionObstruction :
    ∀ L : Subgroup (GL (Fin 2) ToeplitzJacobson), HasKazhdanPropertyT.{0, 0} L →
      Finite L ∧
        (∀ u ∈ compressionSet L,
          (fun x ↦ u * x * u⁻¹) '' (L : Set (GL (Fin 2) ToeplitzJacobson)) =
              (L : Set (GL (Fin 2) ToeplitzJacobson)) ∧
            (fun x ↦ u * x * u⁻¹) ''
                (Subgroup.centralizer (L : Set (GL (Fin 2) ToeplitzJacobson)) :
                  Set (GL (Fin 2) ToeplitzJacobson)) =
              (Subgroup.centralizer (L : Set (GL (Fin 2) ToeplitzJacobson)) :
                Set (GL (Fin 2) ToeplitzJacobson))) ∧
        Manuscript.OneSidedMFRadical.printedDefect L = ⊥ := by
  intro L hL
  obtain ⟨-, -, -, -, hK⟩ := printedPresentedJacobsonRankTwoKazhdanFiniteField
  haveI hfin : Finite L := (hK L hL).2.2.2
  exact ⟨hfin,
    Manuscript.OneSidedMFRadical.JacobsonRankTwo.manuscriptSentence_finiteSubgroupAdmitsNoProperCompression
      _ L⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.AuditOneSided2.manuscriptSentence_jacobsonRankTwoNoCompressionObstruction

end AuditOneSided2
end NonMF
end Manuscript
end GroupApproximation
