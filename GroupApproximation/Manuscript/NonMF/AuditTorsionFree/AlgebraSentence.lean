import GroupApproximation.Manuscript.NonMF.TorsionFreePrintedSentences
import GroupApproximation.Analysis.ReducedGroupCStarTraceFaithful
import GroupApproximation.Meta.AxiomGuard

/-!
# `cor:regular-nonmf-algebra`: the whole algebra sentence

`non_mf_groups_exist.tex`, proof of `cor:regular-nonmf-algebra`, lines 2216–2220:

> The algebra is separable and generated by the canonical unitaries of the two
> generators; its canonical trace is faithful, so it is stably finite; and it is
> not MF by Lemma `prop:mf-residual-calculus`, since `Q` is not MF
> (Theorem `thm:torsion-free`).

The existing sentence-level declarations in
`GroupApproximation.Manuscript.NonMF.TorsionFreePrintedSentences` state the
separability/generation clause, stable finiteness, and the not-MF clause, but no
listed declaration states the middle clause "its canonical trace is faithful".
This module states the whole sentence as one conjunction, including that clause.

Proof route.
* Separability, unitarity of the two canonical unitaries, and the equality of the
  closed star-subalgebra they generate with `C*_r(Q)`:
  `manuscriptSentence_algebraSeparableGenerated`.
* The canonical trace `T ↦ ⟨T δ₁, δ₁⟩` (`canonicalCoefficientAtOne`) is the
  underlying functional of the faithful tracial state
  `ReducedGroupCStarTrace.canonicalFaithfulTracialState`; in particular
  `τ(T⋆T) = 0` forces `T = 0`.
* Stable finiteness: `manuscriptSentence_algebraStablyFinite`.
* `Q` is not MF: the printed input of `thm:torsion-free` is that the full MF
  radical of the nontrivial group `Q` is everything
  (`manuscriptSentence_algebraNotCDEOperatorMF`); then the last assertion of
  `prop:mf-residual-calculus` gives that `C*_r(Q)` is not MF
  (`manuscriptSentence_algebraNotMF`).

The only hypotheses are the sentence's context: `Q` is a countable group
generated by two elements, nontrivial, with full MF radical (the conclusion of
`thm:torsion-free` for `Q`).
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace AuditTorsionFree

open GroupApproximation.ReducedGroupCStarTrace
open GroupApproximation.Manuscript.NonMF.TorsionFreePrintedSentences

/-- **`cor:regular-nonmf-algebra`, proof, the whole sentence at lines 2216–2220.**

> The algebra is separable and generated by the canonical unitaries of the two
> generators; its canonical trace is faithful, so it is stably finite; and it is
> not MF by Lemma `prop:mf-residual-calculus`, since `Q` is not MF
> (Theorem `thm:torsion-free`). -/
theorem manuscriptSentence_algebraSeparableGeneratedFaithfulStablyFiniteNotMF
    (Q : Type) [Group Q] [Countable Q] [Nontrivial Q] {g₁ g₂ : Q}
    (hgen : Subgroup.closure ({g₁, g₂} : Set Q) = ⊤)
    (htop : manuscriptCoronaMFResidual Q = ⊤) :
    -- separable and generated by the canonical unitaries of the two generators
    (TopologicalSpace.SeparableSpace (ReducedGroupCStar Q) ∧
      leftRegularOperator Q g₁ ∈
          unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
        leftRegularOperator Q g₂ ∈
            unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
          (StarAlgebra.adjoin ℂ
            ({leftRegularOperator Q g₁, leftRegularOperator Q g₂} :
              Set (GroupHilbert Q →L[ℂ] GroupHilbert Q))).topologicalClosure
            = reducedGroupCStarSubalgebra Q) ∧
    -- its canonical trace is a faithful tracial state
    (∃ τ : FaithfulTracialState (ReducedGroupCStar Q),
        ∀ T : ReducedGroupCStar Q, τ T = canonicalCoefficientAtOne Q T) ∧
    (∀ T : ReducedGroupCStar Q,
        canonicalCoefficientAtOne Q (star T * T) = 0 → T = 0) ∧
    -- so it is stably finite
    IsStablyFiniteCStarAlgebra (ReducedGroupCStar Q) ∧
    -- `Q` is not MF
    ¬ IsCDEOperatorMF Q ∧
    -- and the algebra is not MF
    ¬ IsMFAlgebra (ReducedGroupCStar Q) := by
  have hnotMF : ¬ IsCDEOperatorMF Q :=
    manuscriptSentence_algebraNotCDEOperatorMF htop
  refine ⟨manuscriptSentence_algebraSeparableGenerated Q hgen,
    ⟨canonicalFaithfulTracialState Q, fun T => rfl⟩, ?_,
    manuscriptSentence_algebraStablyFinite Q, hnotMF,
    manuscriptSentence_algebraNotMF Q hnotMF⟩
  intro T hT
  apply (canonicalFaithfulTracialState Q).eq_zero_of_map_star_mul_self_eq_zero
  change canonicalCoefficientAtOne Q (star T * T) = 0
  exact hT

#audit_axioms
  GroupApproximation.Manuscript.NonMF.AuditTorsionFree.manuscriptSentence_algebraSeparableGeneratedFaithfulStablyFiniteNotMF

end AuditTorsionFree
end NonMF
end Manuscript
end GroupApproximation
