import GroupApproximation.Manuscript.NonMF.TorsionFreePrintedTheorem

/-!
# `cor:relative-quotient`

`non_mf_groups_exist.tex`, the first corollary after the proof of
`thm:torsion-free`.

> **Corollary.**  Let `G` be finitely presented, torsion-free, and
> acylindrically hyperbolic, and let `Ω ⊆ G` be finite.  Then `G` has a
> two-generated, finitely presented, torsion-free, acylindrically hyperbolic
> quotient `P` with property (T) such that the quotient map is injective on `Ω`
> and every homomorphism from `P` to an MF group is trivial.

and its proof:

> Hull's common quotient theorem [Hull, Corollary 7.4], applied to `G` and to
> the group `Q` of Theorem `thm:torsion-free`, gives a common quotient `P` that
> is acylindrically hyperbolic, with the map from `G` injective on a prescribed
> finite subset, since a torsion-free acylindrically hyperbolic group has no
> nontrivial finite normal subgroup.  For finitely generated inputs, the proof
> of that corollary consists of two applications of Theorem `thm:hull` to the
> free product `G * Q`, so `P` is torsion-free and finitely presented, as in the
> remark after Theorem `thm:hull`.  As a quotient of `Q`, the group `P` is
> two-generated and has property (T), and every homomorphism from `P` to an MF
> group pulls back to one from `Q`, so it is trivial.

## The one new citation

`HullCommonQuotientPrinted` is Hull's Corollary 7.4 in the form this proof uses
it.  Hull's printed statement is

> Let `G₁, G₂ ∈ AH` with `G₁` finitely generated, `G₂` countable.  Then there
> exists a non-virtually-cyclic group `Q` and surjective homomorphisms
> `αᵢ : Gᵢ → Q`.  In addition, if `G₂` is finitely generated, then we can choose
> `Q ∈ AH₀`, and if `K(Gᵢ) = 1`, then for any finite subset `Fᵢ ⊆ Gᵢ` we can
> choose `αᵢ` to be injective on `Fᵢ`,

which says nothing about torsion or finite presentability.  Those two
conclusions are what the manuscript reads off the *proof* of the corollary —
*"two applications of Theorem `thm:hull` to the free product `G * Q`"*, whose
quotients are torsion-free by clause (e) of Hull's Theorem 7.1 and finitely
presented because each kernel is normally generated by finitely many elements.
So the Prop below carries the printed conclusions of the corollary **together
with** what the manuscript takes from its proof, and its docstring says which is
which.  Deriving it instead from `HullSmallCancellationPrinted` applied twice to
`G * Q` would need acylindrical hyperbolicity of a free product of two
acylindrically hyperbolic groups, and the suitability of the two factors in it;
this repository has none of that, so the honest carrier is the citation.

The hypothesis `K(Gᵢ) = 1` is **not** a further assumption:
`hasTrivialFiniteRadical_of_torsionFree` proves it from torsion-freeness, which
is the printed sentence *"since a torsion-free acylindrically hyperbolic group
has no nontrivial finite normal subgroup"*.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace TorsionFreePrinted

open GroupApproximation.Manuscript.NonMF.TorsionFree

universe u

/-! ## `K(G) = 1` -/

/-- **Hull's `K(G)`, trivial.**  *"`G` has no nontrivial finite normal
subgroup."*  This is the hypothesis of the last clause of Hull's
Corollary 7.4. -/
def HasTrivialFiniteRadical (G : Type u) [Group G] : Prop :=
  ∀ N : Subgroup G, N.Normal → Finite N → N = ⊥

/-- **"since a torsion-free acylindrically hyperbolic group has no nontrivial
finite normal subgroup"**.  Torsion-freeness alone does it, and normality is not
used: a *finite subgroup* of a torsion-free group is already trivial, because
each of its elements has finite order. -/
theorem hasTrivialFiniteRadical_of_torsionFree {G : Type u} [Group G]
    (hG : IsPowerTorsionFree G) : HasTrivialFiniteRadical G :=
  fun N _ hN => HullSuitable.eq_bot_of_finite hG N hN

/-! ## Hull's Corollary 7.4 -/

/-- **Hull, Corollary 7.4, in the form the printed proof of
`cor:relative-quotient` uses it.**

The printed clauses of the corollary are the surjections onto a common
acylindrically hyperbolic quotient and, under `K(Gᵢ) = 1`, injectivity on a
prescribed finite subset.  `Group.IsFinitelyPresented P` and
`IsPowerTorsionFree P` are what the manuscript reads off the corollary's proof
— *"two applications of Theorem `thm:hull` to the free product `G * Q`"* — and
they are carried here rather than in a separate Prop because they are
conclusions about the same object.

Only `Ω ⊆ G₁` is protected, because only the map out of `G₁` is required to be
injective on a prescribed set in `cor:relative-quotient`. -/
def HullCommonQuotientPrinted : Prop :=
  ∀ (G₁ G₂ : Type) [Group G₁] [Group G₂]
      [Group.IsFinitelyPresented G₁] [Group.IsFinitelyPresented G₂]
      [IsAcylindricallyHyperbolic G₁] [IsAcylindricallyHyperbolic G₂],
    IsPowerTorsionFree G₁ → IsPowerTorsionFree G₂ →
      HasTrivialFiniteRadical G₁ → HasTrivialFiniteRadical G₂ →
        ∀ {Ω : Set G₁}, Ω.Finite →
          ∃ (P : Type) (_ : Group P) (a₁ : G₁ →* P) (a₂ : G₂ →* P),
            Function.Surjective a₁ ∧ Function.Surjective a₂ ∧
              Group.IsFinitelyPresented P ∧ IsPowerTorsionFree P ∧
                IsAcylindricallyHyperbolic P ∧ Set.InjOn a₁ Ω

/-! ## The corollary -/

/-- **`cor:relative-quotient`, as printed.**

> Let `G` be finitely presented, torsion-free, and acylindrically hyperbolic,
> and let `Ω ⊆ G` be finite.  Then `G` has a two-generated, finitely presented,
> torsion-free, acylindrically hyperbolic quotient `P` with property (T) such
> that the quotient map is injective on `Ω` and every homomorphism from `P` to
> an MF group is trivial. -/
def PrintedRelativeQuotient : Prop :=
  ∀ (G : Type) [Group G] [Group.IsFinitelyPresented G]
      [IsAcylindricallyHyperbolic G], IsPowerTorsionFree G →
    ∀ {Ω : Set G}, Ω.Finite →
      ∃ (P : Type) (_ : Group P) (p : G →* P), Function.Surjective p ∧
        IsTwoGenerated P ∧ Group.IsFinitelyPresented P ∧
          IsPowerTorsionFree P ∧ IsAcylindricallyHyperbolic P ∧
            HasKazhdanPropertyT.{0, 0} P ∧ Set.InjOn p Ω ∧
              ∀ (M : Type) (_ : Group M), IsOperatorMF M →
                ∀ (f : P →* M) (x : P), f x = 1

/-- **`cor:relative-quotient`, proved along the printed proof.**

Three hypotheses: the two of `thm:torsion-free`, which produce the group `Q`,
and Hull's Corollary 7.4 in the form the printed proof applies it. -/
theorem manuscriptRelativeQuotient (hFFF : FournierFacioParagraph)
    (hHull : HullPrintedInputs.{0}) (hCQ : HullCommonQuotientPrinted) :
    PrintedRelativeQuotient := by
  -- "the group `Q` of Theorem `thm:torsion-free`"
  obtain ⟨Q, instQ, hgen, hfpQ, htfQ, hacylQ, hQT, hcountQ, hmain⟩ :=
    exists_saturatedQuotient hFFF hHull
  letI := instQ
  haveI := hcountQ
  haveI := hfpQ
  haveI := hacylQ
  intro G _ _ _ hG Ω hΩ
  -- "Hull's common quotient theorem, applied to `G` and to the group `Q` …
  -- since a torsion-free acylindrically hyperbolic group has no nontrivial
  -- finite normal subgroup."
  obtain ⟨P, instP, a₁, a₂, ha₁, ha₂, hfpP, htfP, hacylP, hinj⟩ :=
    hCQ G Q hG htfQ (hasTrivialFiniteRadical_of_torsionFree hG)
      (hasTrivialFiniteRadical_of_torsionFree htfQ) hΩ
  letI := instP
  haveI := hfpP
  haveI := hacylP
  haveI : Countable P := ha₂.countable
  -- "As a quotient of `Q`, the group `P` is two-generated…"
  obtain ⟨x, y, hxy⟩ := hgen
  have htwo : IsTwoGenerated P := by
    refine ⟨a₂ x, a₂ y, ?_⟩
    rw [← closure_pair_map a₂ x y, hxy]
    exact Subgroup.map_top_of_surjective a₂ ha₂
  -- "…and has property (T)."
  have hPT : HasKazhdanPropertyT.{0, 0} P :=
    HasKazhdanPropertyT.of_surjective a₂ ha₂ hQT
  -- "and every homomorphism from `P` to an MF group pulls back to one from `Q`,
  -- so it is trivial."
  have hPtop : manuscriptCoronaMFResidual P = ⊤ := hmain P instP a₂ ha₂
  refine ⟨P, instP, a₁, ha₁, htwo, hfpP, htfP, hacylP, hPT, hinj, ?_⟩
  intro M instM hM f z
  letI := instM
  exact OneSidedMFRadical.manuscriptFullRadicalKillsMFTargets P M hPtop hM f z

end TorsionFreePrinted
end NonMF
end Manuscript
end GroupApproximation
