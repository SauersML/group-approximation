import GroupApproximation.Manuscript.NonMF.TorsionFreeRelativeQuotient
import GroupApproximation.Analysis.ReducedGroupCStarMFAlgebra
import GroupApproximation.Analysis.ReducedGroupCStarMFObstruction
import GroupApproximation.Analysis.ReducedGroupCStarSpan
import GroupApproximation.Analysis.GroupVonNeumannAlgebra
import GroupApproximation.Analysis.CStarSimple
import GroupApproximation.Analysis.ShulmanTraceClasses

/-!
# `cor:regular-nonmf-algebra`

`non_mf_groups_exist.tex`, the second corollary after `thm:torsion-free`.

> **Corollary.**  The algebra `C*_r(Q)` is separable, unital, generated by two
> unitaries, simple, has a unique tracial state, has stable rank one, is stably
> finite, and is not MF.

and its proof:

> The group `Q` is countable, torsion-free, and acylindrically hyperbolic, so it
> contains a non-degenerate hyperbolically embedded subgroup [Osin, Theorem 1.2]
> and has no nontrivial finite normal subgroup.  Dahmani, Guirardel, and Osin
> give simplicity and uniqueness of the trace [DGO, Theorem 2.35], and Gerasimova
> and Osin give density of the invertible elements, which is stable rank one
> [GO, Theorem 1.1].  The algebra is separable and generated by the canonical
> unitaries of the two generators; its canonical trace is faithful, so it is
> stably finite; and an embedding into a norm matrix corona would embed `Q` into
> the corona's unitary group, against Theorem `thm:torsion-free`.

## What is proved and what is assumed

**Proved here, with no citation.**

* *separable* and *stably finite* — `reducedGroupCStar_separable_stablyFinite`,
  the second through the canonical faithful trace, exactly as the printed proof
  says;
* *not MF* — `not_isMFAlgebra_reducedGroupCStar`, whose argument is the printed
  one: an embedding into a norm matrix corona embeds `Q` into the corona's
  unitary group, and `thm:torsion-free` forbids it.  The group input is
  `¬ IsCDEOperatorMF Q`, which comes from the full MF radical of `Q` together
  with `Nontrivial Q`, and `Nontrivial Q` is `nontrivial_of_acylHyperbolic`;
* *unital* — Mathlib's `CStarAlgebra` class is unital, so the adjective is
  carried by the instance `reducedGroupCStarCStarAlgebra`; the conjunct below
  records what is left, that the unit is not zero;
* *generated by two unitaries* — `unitary_leftRegularOperator` and
  `topologicalClosure_adjoin_pair`.  The second is pure algebra: the elements of
  `Q` whose left translations lie in a star-subalgebra form a *subgroup*
  (`leftRegularPreimage`), because `λ` is multiplicative and
  `λ(g⁻¹) = λ(g)*`, so two generators of `Q` already adjoin the whole regular
  representation and the two closures agree before any topology is used;
* *the group has no nontrivial finite normal subgroup* —
  `hasTrivialFiniteRadical_of_torsionFree`, from `TorsionFreeRelativeQuotient`.

**Assumed, as two named literature propositions.**

* `DGOTheorem235Printed` — Dahmani--Guirardel--Osin, Theorem 2.35: C⋆-simplicity
  and a unique tracial state.
* `GerasimovaOsinTheorem11Printed` — Gerasimova--Osin, Theorem 1.1: the
  invertibles are dense, which is stable rank one.

Both are stated at the hypotheses the printed proof supplies — countable,
acylindrically hyperbolic, trivial finite radical.  Osin's Theorem 1.2 is the
step that licenses that form: it turns those hypotheses into DGO's own, the
existence of a non-degenerate hyperbolically embedded subgroup.  It is not a
separate Prop here because this module has no vocabulary for *hyperbolically
embedded*, and inventing one would state a citation the corollary never uses on
its own.  The docstrings of the two Props record that Osin's theorem is folded
into their hypotheses.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace TorsionFreePrinted

open GroupApproximation.Manuscript.NonMF.TorsionFree
open GroupApproximation.ReducedGroupCStarTrace
open GroupApproximation.GroupVonNeumann

universe u

/-! ## `Q` is infinite -/

/-- **"The group `Q` is infinite because it is acylindrically hyperbolic."**

The non-elementarity clause hands out a loxodromic element, a loxodromic element
has infinite order (`HullGeometry.not_isOfFinOrder_of_isLoxodromic`), and its
integer powers are then pairwise distinct. -/
theorem infinite_of_acylHyperbolic (G : Type u) [Group G]
    [h : IsAcylindricallyHyperbolic G] : Infinite G := by
  obtain ⟨A, δ, -, -, g, -, -, -, hlox, -, -⟩ := h.out
  exact Infinite.of_injective (fun n : ℤ => g ^ n)
    (injective_zpow_iff_not_isOfFinOrder.mpr
      (HullGeometry.not_isOfFinOrder_of_isLoxodromic hlox))

/-- An acylindrically hyperbolic group is nontrivial. -/
theorem nontrivial_of_acylHyperbolic (G : Type u) [Group G]
    [IsAcylindricallyHyperbolic G] : Nontrivial G :=
  haveI := infinite_of_acylHyperbolic G
  inferInstance

/-! ## The C⋆-side vocabulary the corollary needs -/

/-- **Stable rank one**: the invertible elements are dense.  This is the form
Gerasimova and Osin prove and the manuscript quotes — *"density of the
invertible elements, which is stable rank one"*. -/
def IsStableRankOne (A : Type u) [CStarAlgebra A] : Prop :=
  Dense {x : A | IsUnit x}

/-- **A unique tracial state**: there is a tracial state, and every tracial
state is that one.  `TracialState` is the repository's structure
(`Analysis.ShulmanTraceClasses`); uniqueness is stated pointwise so that no
extensionality lemma for the structure is needed. -/
def HasUniqueTracialState (A : Type u) [CStarAlgebra A] : Prop :=
  ∃ τ : TracialState A, ∀ σ : TracialState A, ∀ x : A, σ x = τ x

/-! ## "generated by the canonical unitaries of the two generators" -/

/-- The left translations are unitary operators on `ℓ²(G)`. -/
theorem unitary_leftRegularOperator (G : Type u) [Group G] (g : G) :
    leftRegularOperator G g ∈ unitary (GroupHilbert G →L[ℂ] GroupHilbert G) := by
  refine Unitary.mem_iff.mpr ⟨?_, ?_⟩
  · rw [star_leftRegularOperator, leftRegularOperator_mul, inv_mul_cancel,
      leftRegularOperator_one]
  · rw [star_leftRegularOperator, leftRegularOperator_mul, mul_inv_cancel,
      leftRegularOperator_one]

/-- **The elements whose left translation lies in a star-subalgebra form a
subgroup.**  Multiplicativity of `λ` gives closure under products, `λ(1) = 1`
gives the identity, and `λ(g⁻¹) = λ(g)*` gives closure under inverses — the last
being the only place where star-closedness of the subalgebra is used.

This is what makes *"generated by two unitaries"* an algebraic statement: no
topology enters it. -/
def leftRegularPreimage {G : Type u} [Group G]
    (S : StarSubalgebra ℂ (GroupHilbert G →L[ℂ] GroupHilbert G)) : Subgroup G where
  carrier := {g : G | leftRegularOperator G g ∈ S}
  one_mem' := by
    show leftRegularOperator G (1 : G) ∈ S
    rw [leftRegularOperator_one]
    exact one_mem S
  mul_mem' := by
    intro a b ha hb
    show leftRegularOperator G (a * b) ∈ S
    rw [← leftRegularOperator_mul]
    exact mul_mem ha hb
  inv_mem' := by
    intro a ha
    show leftRegularOperator G a⁻¹ ∈ S
    rw [← star_leftRegularOperator]
    exact star_mem ha

/-- **Two generators of the group adjoin the whole regular representation.**

`{g₁, g₂}` generates `G`, so `leftRegularPreimage` at the star-subalgebra
generated by `λ(g₁), λ(g₂)` is all of `G`, and the two star-subalgebras of
`B(ℓ²G)` coincide. -/
theorem adjoin_pair_eq_adjoin_range {G : Type u} [Group G] {g₁ g₂ : G}
    (hgen : Subgroup.closure ({g₁, g₂} : Set G) = ⊤) :
    StarAlgebra.adjoin ℂ ({leftRegularOperator G g₁, leftRegularOperator G g₂} :
        Set (GroupHilbert G →L[ℂ] GroupHilbert G))
      = StarAlgebra.adjoin ℂ (Set.range (leftRegularOperator G)) := by
  refine le_antisymm (StarAlgebra.adjoin_le ?_) (StarAlgebra.adjoin_le ?_)
  · intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact StarAlgebra.subset_adjoin ℂ _ ⟨g₁, rfl⟩
    · exact StarAlgebra.subset_adjoin ℂ _ ⟨g₂, rfl⟩
  · rintro _ ⟨g, rfl⟩
    have hle : Subgroup.closure ({g₁, g₂} : Set G) ≤
        leftRegularPreimage (StarAlgebra.adjoin ℂ
          ({leftRegularOperator G g₁, leftRegularOperator G g₂} :
            Set (GroupHilbert G →L[ℂ] GroupHilbert G))) := by
      rw [Subgroup.closure_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact StarAlgebra.subset_adjoin ℂ _ (Set.mem_insert _ _)
      · exact StarAlgebra.subset_adjoin ℂ _ (Set.mem_insert_of_mem _ rfl)
    rw [hgen, top_le_iff] at hle
    have hg : g ∈ leftRegularPreimage (StarAlgebra.adjoin ℂ
        ({leftRegularOperator G g₁, leftRegularOperator G g₂} :
          Set (GroupHilbert G →L[ℂ] GroupHilbert G))) := by
      rw [hle]
      exact Subgroup.mem_top g
    exact hg

/-- **"generated by the canonical unitaries of the two generators"**: the closed
star-subalgebra of `B(ℓ²G)` generated by `λ(g₁)` and `λ(g₂)` is `C*_r(G)`. -/
theorem topologicalClosure_adjoin_pair {G : Type u} [Group G] {g₁ g₂ : G}
    (hgen : Subgroup.closure ({g₁, g₂} : Set G) = ⊤) :
    (StarAlgebra.adjoin ℂ ({leftRegularOperator G g₁, leftRegularOperator G g₂} :
        Set (GroupHilbert G →L[ℂ] GroupHilbert G))).topologicalClosure
      = reducedGroupCStarSubalgebra G := by
  rw [adjoin_pair_eq_adjoin_range hgen]
  rfl

/-! ## The two literature propositions -/

/-- **Dahmani--Guirardel--Osin, Theorem 2.35**, in the form the printed proof
uses it: for a countable acylindrically hyperbolic group with no nontrivial
finite normal subgroup, the reduced group C⋆-algebra is simple with a unique
tracial state.

DGO state the theorem for a group with a non-degenerate hyperbolically embedded
subgroup.  Osin's Theorem 1.2 is what turns the hypotheses above into that one,
and the printed proof cites it for exactly that step; it is folded into this
Prop's hypotheses rather than stated separately, because this module has no
vocabulary for *hyperbolically embedded*. -/
def DGOTheorem235Printed : Prop :=
  ∀ (G : Type) [Group G] [Countable G] [IsAcylindricallyHyperbolic G],
    HasTrivialFiniteRadical G →
      IsSimpleCStar (ReducedGroupCStar G) ∧ HasUniqueTracialState (ReducedGroupCStar G)

/-- **Gerasimova--Osin, Theorem 1.1**, in the form the printed proof uses it:
for a countable acylindrically hyperbolic group with no nontrivial finite normal
subgroup, the invertible elements of the reduced group C⋆-algebra are dense.

As with `DGOTheorem235Printed`, Osin's Theorem 1.2 is folded into the
hypotheses. -/
def GerasimovaOsinTheorem11Printed : Prop :=
  ∀ (G : Type) [Group G] [Countable G] [IsAcylindricallyHyperbolic G],
    HasTrivialFiniteRadical G → IsStableRankOne (ReducedGroupCStar G)

/-! ## The corollary -/

/-- **`cor:regular-nonmf-algebra`, as printed.**

> The algebra `C*_r(Q)` is separable, unital, generated by two unitaries,
> simple, has a unique tracial state, has stable rank one, is stably finite, and
> is not MF.

The group is existentially quantified together with the properties that
identify it as the group of `thm:torsion-free` and that the printed proof of the
corollary uses — *"The group `Q` is countable, torsion-free, and acylindrically
hyperbolic"* — and two-generated, which is what *"generated by two unitaries"*
rests on.

*Unital* is carried by the `CStarAlgebra` instance, which is unital by
definition; the conjunct `(1 : ReducedGroupCStar Q) ≠ 0` records that the unit
is not zero.  *Generated by two unitaries* is stated in `B(ℓ²Q)`, where
`C*_r(Q)` lives as a star-subalgebra, so that the two unitaries are named as the
canonical `λ(g₁), λ(g₂)` the printed proof names. -/
def PrintedRegularNonMFAlgebra : Prop :=
  ∃ (Q : Type) (_ : Group Q),
    Countable Q ∧ IsPowerTorsionFree Q ∧ IsAcylindricallyHyperbolic Q ∧
      IsTwoGenerated Q ∧
        TopologicalSpace.SeparableSpace (ReducedGroupCStar Q) ∧
          (1 : ReducedGroupCStar Q) ≠ 0 ∧
            (∃ g₁ g₂ : Q, Subgroup.closure ({g₁, g₂} : Set Q) = ⊤ ∧
              leftRegularOperator Q g₁ ∈
                  unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
                leftRegularOperator Q g₂ ∈
                  unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
                  (StarAlgebra.adjoin ℂ
                    ({leftRegularOperator Q g₁, leftRegularOperator Q g₂} :
                      Set (GroupHilbert Q →L[ℂ] GroupHilbert Q))).topologicalClosure
                    = reducedGroupCStarSubalgebra Q) ∧
              IsSimpleCStar (ReducedGroupCStar Q) ∧
                HasUniqueTracialState (ReducedGroupCStar Q) ∧
                  IsStableRankOne (ReducedGroupCStar Q) ∧
                    IsStablyFiniteCStarAlgebra (ReducedGroupCStar Q) ∧
                      ¬ IsMFAlgebra (ReducedGroupCStar Q)

/-- **`cor:regular-nonmf-algebra`, proved along the printed proof.**

Four hypotheses: the two of `thm:torsion-free`, which produce `Q`, and the two
C⋆-algebraic citations. -/
theorem manuscriptRegularNonMFAlgebra (hFFF : FournierFacioParagraph)
    (hHull : HullPrintedInputs.{0}) (hDGO : DGOTheorem235Printed)
    (hGO : GerasimovaOsinTheorem11Printed) : PrintedRegularNonMFAlgebra := by
  obtain ⟨Q, instQ, hgen, hfpQ, htfQ, hacylQ, -, hcountQ, hmain⟩ :=
    exists_saturatedQuotient hFFF hHull
  letI := instQ
  haveI := hcountQ
  haveI := hacylQ
  haveI : Nontrivial Q := nontrivial_of_acylHyperbolic Q
  -- "…and has no nontrivial finite normal subgroup."
  have hrad : HasTrivialFiniteRadical Q :=
    hasTrivialFiniteRadical_of_torsionFree htfQ
  -- "…against Theorem `thm:torsion-free`."
  have hQtop : manuscriptCoronaMFResidual Q = ⊤ :=
    hmain Q instQ (MonoidHom.id Q) Function.surjective_id
  have hnotMF : ¬ IsCDEOperatorMF Q := by
    intro hMF
    have hbot : manuscriptCoronaMFResidual Q = ⊥ :=
      isCDEOperatorMF_iff_manuscriptCoronaMFResidual_eq_bot.mp hMF
    obtain ⟨x, hx⟩ := exists_ne (1 : Q)
    apply hx
    have hmem : x ∈ manuscriptCoronaMFResidual Q := by
      rw [hQtop]
      exact Subgroup.mem_top x
    rw [hbot] at hmem
    simpa using hmem
  -- "The algebra is separable…; its canonical trace is faithful, so it is
  -- stably finite; and an embedding into a norm matrix corona would…"
  obtain ⟨hsep, hsf, hnotMFalg⟩ :=
    reducedGroupCStar_separable_stablyFinite_not_isMFAlgebra Q hnotMF
  -- "Dahmani, Guirardel, and Osin give simplicity and uniqueness of the trace."
  obtain ⟨hsimple, huniq⟩ := hDGO Q hrad
  -- "and Gerasimova and Osin give density of the invertible elements."
  have hsr : IsStableRankOne (ReducedGroupCStar Q) := hGO Q hrad
  obtain ⟨g₁, g₂, hg₁₂⟩ := hgen
  refine ⟨Q, instQ, hcountQ, htfQ, hacylQ, ⟨g₁, g₂, hg₁₂⟩, hsep, ?_,
    ⟨g₁, g₂, hg₁₂, unitary_leftRegularOperator Q g₁,
      unitary_leftRegularOperator Q g₂, topologicalClosure_adjoin_pair hg₁₂⟩,
    hsimple, huniq, hsr, hsf, hnotMFalg⟩
  -- "unital": the unit of the algebra is not zero.
  intro hone
  obtain ⟨a, b, hab⟩ := exists_pair_ne (ReducedGroupCStar Q)
  apply hab
  have hzero : ∀ x : ReducedGroupCStar Q, x = 0 := by
    intro x
    calc x = x * 1 := (mul_one x).symm
      _ = x * 0 := by rw [hone]
      _ = 0 := mul_zero x
  rw [hzero a, hzero b]

end TorsionFreePrinted
end NonMF
end Manuscript
end GroupApproximation
