import GroupApproximation.Manuscript.NonMF.HullBallForm
import GroupApproximation.Manuscript.NonMF.HullInputsProved

/-!
# Hull's inputs, restated so that they are not false

`Manuscript.NonMF.HullFillKernelRefutation` refutes
`TorsionFree.HullInputs.kerNormallyGenerated`: the field quantifies over every
term of `HullQuotient N t F`, and at `m = 0` that asserts that the four printed
clauses of `thm:hull` force `q` to be injective, which the first projection
`Q × Q → Q` of an acylindrically hyperbolic `Q` refutes.  The manuscript's remark

> Separately, inspection of Hull's construction, applied successively to
> `t₁, …, t_m`, shows that `ker q` is normally generated by `m` elements.

is about the quotient Hull's construction produces, so it is a property of that
quotient and belongs with it.  `HullQuotientNG` is the pair — Hull's quotient
together with the normal generation of its kernel — and `HullInputsCorrected` is
the citation bundle stated with it.

## Two fields, not four

* `HullInputsCorrected.smallCancellation` — **Hull, Theorem 7.1** with the
  construction's kernel datum.  `smallCancellation_of_ballFormNG` reduces it to
  Hull's published injectivity-radius formulation exactly as
  `HullBallForm.smallCancellation_of_ballForm` does for the weaker form, and
  `smallCancellation_of_corrected` recovers `HullInputs.smallCancellation`
  from it, so nothing is lost.
* `HullInputsCorrected.osinNonElementary` — **Osin, Lemma 7.1**, restricted to
  a normal subgroup of a torsion-free group, which is the case
  `lem:saturation` applies it in and the case the repository's partial
  machinery is stated for.  `osinNonElementary_of_osinLemma71` derives it from
  the general lemma, so the restriction removes hypotheses to prove rather than
  changing what is cited.

`HullInputs.twoGeneratedSuitable` is not a field here.  Over a torsion-free
ambient group it is a theorem of this repository
(`HullInputsProved.exists_pair_suitable_of_torsionFree`), and `lem:saturation`
applies it only there, with `hG : IsPowerTorsionFree G` in scope.

`Saturation.saturation` takes this bundle: the repair costs the printed proof of
`lem:saturation` three lines — the kernel datum comes off the quotient rather
than out of a separate citation, and Hull's Corollary 5.7 with Lemma 5.8 is
supplied by `HullInputsProved.exists_pair_suitable_of_torsionFree`.  The
`S.card ≤ m` bound is carried but unused there: only the finiteness of `S`
enters the finite presentation of the quotient.

This module is imported by `Manuscript.NonMF.Saturation`, so it holds only what
is stated ahead of the saturation lemma.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace HullCorrectedInputs

open GroupApproximation.HullGeometry
open GroupApproximation.Manuscript.NonMF.TorsionFree

universe u

/-! ## The quotient of `thm:hull`, with the datum of its construction -/

/-- **The output of Hull's Theorem 7.1, as his construction produces it.**  The
printed clauses are `quotient`; the manuscript's separate remark on `ker q` is
`kerNormallyGenerated`.  Recording the remark here rather than as a statement
about arbitrary Hull quotients is what
`HullFillKernelRefutation.not_kerNormallyGeneratedStatement` forces. -/
structure HullQuotientNG {G : Type u} [Group G] (N : Subgroup G) {m : ℕ}
    (t : Fin m → G) (F : Set G) where
  /-- The quotient, with the four printed clauses of `thm:hull`. -/
  quotient : HullQuotient N t F
  /-- "`ker q` is normally generated by `m` elements." -/
  kerNormallyGenerated : ∃ S : Finset G, S.card ≤ m ∧
    quotient.q.ker = Subgroup.normalClosure (S : Set G)

/-- A Hull quotient with its kernel datum, restricted to a subset, keeps the
datum: `HullQuotient.mono` leaves `q` unchanged. -/
def HullQuotientNG.mono {G : Type u} [Group G] {N : Subgroup G} {m : ℕ}
    {t : Fin m → G} {F F' : Set G} (H : HullQuotientNG N t F') (hFF' : F ⊆ F') :
    HullQuotientNG N t F where
  quotient := H.quotient.mono hFF'
  kerNormallyGenerated := H.kerNormallyGenerated

/-! ## The two citations -/

/-- **The group-theoretic literature the manuscript cites**, in the two
statements that survive the refutation of `TorsionFree.HullInputs`: Hull's
Theorem 7.1 with the kernel datum of its construction, and Osin's Lemma 7.1.

Hull's Corollary 5.7 with Lemma 5.8 is not among them: over a torsion-free
ambient group it is `HullInputsProved.exists_pair_suitable_of_torsionFree`, and
that is the only case `lem:saturation` uses. -/
structure HullInputsCorrected : Type where
  /-- **`thm:hull`, Hull's small cancellation theorem** — Hull, Theorem 7.1, in
  the finite-set formulation the manuscript records, with the kernel of the
  quotient map normally generated by `m` elements. -/
  smallCancellation : ∀ {G : Type u} [Group G] [IsAcylindricallyHyperbolic G]
    (A : HullGeneratingSet G) {N : Subgroup G}, Suitable A.alphabet N →
      ∀ {m : ℕ} (t : Fin m → G) {F : Set G}, F.Finite →
        Nonempty (HullQuotientNG N t F)
  /-- **Osin, Lemma 7.1**: an `s`-normal subgroup acts non-elementarily on
  `Γ(G,A)`, in the case `lem:saturation` uses it — a normal subgroup of a
  torsion-free group.

  That is also the case the repository's partial machinery is stated for:
  `HullGeometry.exists_escaping_or_noncommuting_of_isSNormal` carries
  `IsPowerTorsionFree G` as a hypothesis and
  `HullGeometry.actsNonElementarily_of_normal_conjugate` carries `[S.Normal]`,
  so narrowing the citation to those two hypotheses costs the saturation lemma
  nothing and lines the debt up with what is already proved.
  `osinNonElementary_of_osinLemma71` checks that this is a special case of
  Osin's lemma as `HullInputs` states it. -/
  osinNonElementary : ∀ {G : Type u} [Group G] (A : HullGeneratingSet G),
    IsPowerTorsionFree G → ∀ (N : Subgroup G) [N.Normal],
      HullSuitable.IsSNormal N →
        ActsNonElementarily N (Cayley.base A.alphabet)

/-- The corrected bundle proves the first field of `TorsionFree.HullInputs`:
forgetting the kernel datum gives back the plain Hull quotient. -/
theorem smallCancellation_of_corrected (h : HullInputsCorrected.{u}) :
    ∀ {G : Type u} [Group G] [IsAcylindricallyHyperbolic G]
      (A : HullGeneratingSet G) {N : Subgroup G}, Suitable A.alphabet N →
        ∀ {m : ℕ} (t : Fin m → G) {F : Set G}, F.Finite →
          Nonempty (HullQuotient N t F) := by
  intro G _ _ A N hN m t F hF
  obtain ⟨H⟩ := h.smallCancellation A hN t hF
  exact ⟨H.quotient⟩

/-! ## Osin's Lemma 7.1, and the case that is cited -/

/-- **Osin, Lemma 7.1**, in the general form `HullInputs.osinNonElementary`
records: every `s`-normal subgroup of an acylindrically hyperbolic group acts
non-elementarily on `Γ(G,A)`. -/
def OsinLemma71 : Prop :=
  ∀ {G : Type u} [Group G] (A : HullGeneratingSet G) (N : Subgroup G),
    HullSuitable.IsSNormal N → ActsNonElementarily N (Cayley.base A.alphabet)

/-- The field of `HullInputsCorrected` is a special case of Osin's lemma:
nothing has been substituted for it, only the hypotheses `lem:saturation`
supplies have been added. -/
theorem osinNonElementary_of_osinLemma71 (h : OsinLemma71.{u}) :
    ∀ {G : Type u} [Group G] (A : HullGeneratingSet G), IsPowerTorsionFree G →
      ∀ (N : Subgroup G) [N.Normal], HullSuitable.IsSNormal N →
        ActsNonElementarily N (Cayley.base A.alphabet) := by
  intro G _ A _ N _ hsn
  exact h A N hsn

/-! ## Hull's published form -/

/-- **Hull's Theorem 7.1 in its published form**, with the kernel datum:
injectivity on the ball of a given radius. -/
def HullBallFormStatementNG : Prop :=
  ∀ {G : Type u} [Group G] [IsAcylindricallyHyperbolic G]
    (A : HullGeneratingSet G) {N : Subgroup G}, Suitable A.alphabet N →
      ∀ {m : ℕ} (t : Fin m → G) (R : ℕ),
        Nonempty (HullQuotientNG N t (cayleyBall A.alphabet R))

/-- **"a ball containing a given finite set gives the following form"**, with
the kernel datum carried along: a finite subset of `G` lies in a ball, and
restricting to a subset leaves `q` — so its kernel — unchanged. -/
theorem smallCancellation_of_ballFormNG (hball : HullBallFormStatementNG.{u}) :
    ∀ {G : Type u} [Group G] [IsAcylindricallyHyperbolic G]
      (A : HullGeneratingSet G) {N : Subgroup G}, Suitable A.alphabet N →
        ∀ {m : ℕ} (t : Fin m → G) {F : Set G}, F.Finite →
          Nonempty (HullQuotientNG N t F) := by
  intro G _ _ A N hN m t F hF
  obtain ⟨R, hR⟩ := exists_subset_cayleyBall A.alphabet hF
  obtain ⟨H⟩ := hball A hN t R
  exact ⟨H.mono hR⟩

end HullCorrectedInputs
end NonMF
end Manuscript
end GroupApproximation
