import GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoid.KKRelation
import GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoid.ZeroCycle
import GroupApproximation.Meta.AxiomGuard

/-!
# The KK monoid of Kasparov bimodules

`KKMonoid A B` is the quotient of the Kasparov `A`-`B`-bimodules by the KK relation `KKEquiv`,
which is generated by unitary equivalence, operator homotopy and addition of degenerate cycles.
The direct sum descends to it, and the quotient is a commutative monoid.  Its zero is the class
of the zero bimodule, and every degenerate bimodule represents zero.

## The proof route

* `instAddKKMonoid`: `Quotient.map₂ KasparovBimodule.add`, which is well defined by
  `kkEquiv_add`.
* associativity and commutativity: `unitaryEquiv_add_assoc` and `unitaryEquiv_add_comm`, each one
  unitary step;
* `M ⊞ 0 ~ M`: one degenerate step (`zeroCycle_isDegenerate`).  `0 ⊞ M ~ M`: the flip, then the
  degenerate step;
* a degenerate `D` is zero: `D ~ D ⊞ 0 ≅ 0 ⊞ D ~ 0`, using two degenerate steps and the flip.

## Scope

The inverse (which makes `KK(A, B)` a group) and the Kasparov product are not in this lane.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace TWWLanes
namespace KKMonoidLane

open HilbertModule

universe u v w

variable (A : Type u) [NonUnitalCStarAlgebra A]
variable (B : Type v) [NonUnitalCStarAlgebra B] [PartialOrder B] [StarOrderedRing B]

/-- The KK relation as a setoid. -/
def kkSetoid : Setoid (KasparovBimodule.{u, v, w} A B) :=
  ⟨KKEquiv, ⟨KKEquiv.refl, KKEquiv.symm, KKEquiv.trans⟩⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkSetoid

/-- **The KK monoid**: Kasparov bimodules modulo the KK relation. -/
def KKMonoid := Quotient (kkSetoid.{u, v, w} A B)

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKMonoid

variable {A B}

/-- The KK class of a Kasparov bimodule. -/
def kkClass (M : KasparovBimodule.{u, v, w} A B) : KKMonoid.{u, v, w} A B :=
  Quotient.mk _ M

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkClass

theorem kkClass_eq_of_kkEquiv {M N : KasparovBimodule.{u, v, w} A B} (h : KKEquiv M N) :
    kkClass M = kkClass N :=
  Quotient.sound h

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkClass_eq_of_kkEquiv

instance instAddKKMonoid : Add (KKMonoid.{u, v, w} A B) :=
  ⟨Quotient.map₂ KasparovBimodule.add fun _ _ h _ _ h' => kkEquiv_add h h'⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.instAddKKMonoid

instance instZeroKKMonoid : Zero (KKMonoid.{u, v, w} A B) :=
  ⟨kkClass (zeroCycle.{u, v, w} A B)⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.instZeroKKMonoid

/-- **The direct sum descends**: the class of `M ⊞ N` is the sum of the classes. -/
theorem kkClass_add (M N : KasparovBimodule.{u, v, w} A B) :
    kkClass (M.add N) = kkClass M + kkClass N :=
  rfl

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkClass_add

theorem kkClass_zeroCycle : kkClass (zeroCycle.{u, v, w} A B) = 0 :=
  rfl

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkClass_zeroCycle

theorem kkMonoid_add_assoc (a b c : KKMonoid.{u, v, w} A B) : a + b + c = a + (b + c) :=
  Quotient.inductionOn₃ a b c fun M N P =>
    kkClass_eq_of_kkEquiv (KKEquiv.of_unitaryEquiv (unitaryEquiv_add_assoc M N P))

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkMonoid_add_assoc

theorem kkMonoid_add_comm (a b : KKMonoid.{u, v, w} A B) : a + b = b + a :=
  Quotient.inductionOn₂ a b fun M N =>
    kkClass_eq_of_kkEquiv (KKEquiv.of_unitaryEquiv (unitaryEquiv_add_comm M N))

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkMonoid_add_comm

theorem kkMonoid_add_zero (a : KKMonoid.{u, v, w} A B) : a + 0 = a :=
  Quotient.inductionOn a fun M =>
    kkClass_eq_of_kkEquiv (KKEquiv.add_degenerate M (zeroCycle_isDegenerate.{u, v, w} A B))

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkMonoid_add_zero

theorem kkMonoid_zero_add (a : KKMonoid.{u, v, w} A B) : 0 + a = a :=
  Quotient.inductionOn a fun M =>
    kkClass_eq_of_kkEquiv
      ((KKEquiv.of_unitaryEquiv (unitaryEquiv_add_comm (zeroCycle.{u, v, w} A B) M)).trans
        (KKEquiv.add_degenerate M (zeroCycle_isDegenerate.{u, v, w} A B)))

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkMonoid_zero_add

/-- **The KK monoid is a commutative monoid.** -/
instance instAddCommMonoidKKMonoid : AddCommMonoid (KKMonoid.{u, v, w} A B) where
  add_assoc := kkMonoid_add_assoc
  zero_add := kkMonoid_zero_add
  add_zero := kkMonoid_add_zero
  add_comm := kkMonoid_add_comm
  nsmul := nsmulRec

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.instAddCommMonoidKKMonoid

theorem kkClass_eq_of_unitaryEquiv {M N : KasparovBimodule.{u, v, w} A B}
    (h : UnitaryEquiv M N) : kkClass M = kkClass N :=
  kkClass_eq_of_kkEquiv (KKEquiv.of_unitaryEquiv h)

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkClass_eq_of_unitaryEquiv

theorem kkClass_eq_of_operatorHomotopic {M N : KasparovBimodule.{u, v, w} A B}
    (h : OperatorHomotopic M N) : kkClass M = kkClass N :=
  kkClass_eq_of_kkEquiv (KKEquiv.of_operatorHomotopic h)

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkClass_eq_of_operatorHomotopic

/-- **Degenerate cycles are zero.** -/
theorem kkClass_eq_zero_of_isDegenerate {D : KasparovBimodule.{u, v, w} A B}
    (hD : IsDegenerate D) : kkClass D = 0 := by
  have hZ := zeroCycle_isDegenerate.{u, v, w} A B
  have h₁ : KKEquiv D (D.add (zeroCycle.{u, v, w} A B)) := (KKEquiv.add_degenerate D hZ).symm
  have h₂ : KKEquiv (D.add (zeroCycle.{u, v, w} A B)) ((zeroCycle.{u, v, w} A B).add D) :=
    KKEquiv.of_unitaryEquiv (unitaryEquiv_add_comm D _)
  exact kkClass_eq_of_kkEquiv (h₁.trans (h₂.trans (KKEquiv.add_degenerate _ hD)))

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkClass_eq_zero_of_isDegenerate

variable (A B) in
/-- **The KK monoid of Kasparov bimodules.**  Operator homotopy is an equivalence relation.  The
direct sum descends to the quotient by the KK relation, and it is commutative and associative
there.  Degenerate cycles are zero, and operator-homotopic cycles have the same class. -/
theorem manuscriptSentence_kkMonoidOfKasparovBimodules :
    Equivalence (fun M N : KasparovBimodule.{u, v, w} A B => OperatorHomotopic M N)
      ∧ (∀ M N : KasparovBimodule.{u, v, w} A B, kkClass (M.add N) = kkClass M + kkClass N)
      ∧ (∀ a b : KKMonoid.{u, v, w} A B, a + b = b + a)
      ∧ (∀ a b c : KKMonoid.{u, v, w} A B, a + b + c = a + (b + c))
      ∧ (∀ a : KKMonoid.{u, v, w} A B, a + 0 = a)
      ∧ (∀ D : KasparovBimodule.{u, v, w} A B, IsDegenerate D → kkClass D = 0)
      ∧ (∀ M N : KasparovBimodule.{u, v, w} A B, OperatorHomotopic M N → kkClass M = kkClass N) :=
  ⟨operatorHomotopic_equivalence, kkClass_add, kkMonoid_add_comm, kkMonoid_add_assoc,
    kkMonoid_add_zero, fun _ hD => kkClass_eq_zero_of_isDegenerate hD,
    fun _ _ h => kkClass_eq_of_operatorHomotopic h⟩

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.manuscriptSentence_kkMonoidOfKasparovBimodules

end KKMonoidLane
end TWWLanes
end NonMF
end Manuscript
end GroupApproximation
