import Mathlib.Logic.Relation
import GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoid.OperatorHomotopy
import GroupApproximation.Meta.AxiomGuard

/-!
# The KK relation on Kasparov bimodules

`KKEquiv` is the equivalence relation generated by three steps (`KKStep`):

* `unitary`: unitary equivalence (`HilbertModule.UnitaryEquiv`);
* `homotopy`: operator homotopy (`OperatorHomotopic`);
* `degenerate`: `M ⊞ D ~ M` for a degenerate `D`.

This is the operator-homotopy form of `KK`: unitary equivalence, operator homotopy and addition
of degenerate cycles.

## The proof route

`KKEquiv` is an equivalence relation because it is `Relation.EqvGen KKStep`.  The direct sum
respects it:

* on the right, by induction on `EqvGen`, so it is enough to treat one step.  A unitary step uses
  `UnitaryEquiv.add` with `UnitaryEquiv.refl`.  A homotopy step uses
  `operatorHomotopic_add_right`.  A degenerate step `(M ⊞ D) ⊞ N ~ M ⊞ N` goes
  `(M ⊞ D) ⊞ N ≅ M ⊞ (D ⊞ N) ≅ M ⊞ (N ⊞ D) ≅ (M ⊞ N) ⊞ D ~ M ⊞ N`, using the associator, the
  flip, the associator again, and one degenerate step;
* on the left, by conjugating with the flip `unitaryEquiv_add_comm`.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace TWWLanes
namespace KKMonoidLane

open HilbertModule

universe u v w

variable {A : Type u} [NonUnitalCStarAlgebra A]
variable {B : Type v} [NonUnitalCStarAlgebra B] [PartialOrder B] [StarOrderedRing B]

/-- **The generating steps of the KK relation.** -/
inductive KKStep : KasparovBimodule.{u, v, w} A B → KasparovBimodule.{u, v, w} A B → Prop
  /-- Unitarily equivalent bimodules are related. -/
  | unitary {M N : KasparovBimodule.{u, v, w} A B} : UnitaryEquiv M N → KKStep M N
  /-- Operator-homotopic bimodules are related. -/
  | homotopy {M N : KasparovBimodule.{u, v, w} A B} : OperatorHomotopic M N → KKStep M N
  /-- Adding a degenerate bimodule does not change the class. -/
  | degenerate (M D : KasparovBimodule.{u, v, w} A B) : IsDegenerate D → KKStep (M.add D) M

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKStep

/-- **The KK relation**: the equivalence relation generated by `KKStep`. -/
def KKEquiv (M N : KasparovBimodule.{u, v, w} A B) : Prop :=
  Relation.EqvGen KKStep M N

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKEquiv

theorem KKEquiv.refl (M : KasparovBimodule.{u, v, w} A B) : KKEquiv M M :=
  Relation.EqvGen.refl M

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKEquiv.refl

theorem KKEquiv.symm {M N : KasparovBimodule.{u, v, w} A B} (h : KKEquiv M N) : KKEquiv N M :=
  Relation.EqvGen.symm M N h

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKEquiv.symm

theorem KKEquiv.trans {M N P : KasparovBimodule.{u, v, w} A B} (h : KKEquiv M N)
    (h' : KKEquiv N P) : KKEquiv M P :=
  Relation.EqvGen.trans M N P h h'

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKEquiv.trans

theorem KKEquiv.of_unitaryEquiv {M N : KasparovBimodule.{u, v, w} A B}
    (h : UnitaryEquiv M N) : KKEquiv M N :=
  Relation.EqvGen.rel M N (KKStep.unitary h)

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKEquiv.of_unitaryEquiv

theorem KKEquiv.of_operatorHomotopic {M N : KasparovBimodule.{u, v, w} A B}
    (h : OperatorHomotopic M N) : KKEquiv M N :=
  Relation.EqvGen.rel M N (KKStep.homotopy h)

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKEquiv.of_operatorHomotopic

theorem KKEquiv.add_degenerate (M : KasparovBimodule.{u, v, w} A B)
    {D : KasparovBimodule.{u, v, w} A B} (hD : IsDegenerate D) : KKEquiv (M.add D) M :=
  Relation.EqvGen.rel (M.add D) M (KKStep.degenerate M D hD)

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.KKEquiv.add_degenerate

/-- One generating step, with a fixed summand added on the right. -/
theorem kkEquiv_add_right_of_step {M M' : KasparovBimodule.{u, v, w} A B} (h : KKStep M M')
    (N : KasparovBimodule.{u, v, w} A B) : KKEquiv (M.add N) (M'.add N) := by
  cases h with
  | unitary hU => exact KKEquiv.of_unitaryEquiv (UnitaryEquiv.add hU (UnitaryEquiv.refl N))
  | homotopy hH => exact KKEquiv.of_operatorHomotopic (operatorHomotopic_add_right hH N)
  | degenerate M₀ D hD =>
    have h₁ : KKEquiv ((M₀.add D).add N) (M₀.add (D.add N)) :=
      KKEquiv.of_unitaryEquiv (unitaryEquiv_add_assoc M₀ D N)
    have h₂ : KKEquiv (M₀.add (D.add N)) (M₀.add (N.add D)) :=
      KKEquiv.of_unitaryEquiv (UnitaryEquiv.add (UnitaryEquiv.refl M₀) (unitaryEquiv_add_comm D N))
    have h₃ : KKEquiv (M₀.add (N.add D)) ((M₀.add N).add D) :=
      KKEquiv.of_unitaryEquiv (unitaryEquiv_add_assoc M₀ N D).symm
    exact h₁.trans (h₂.trans (h₃.trans (KKEquiv.add_degenerate (M₀.add N) hD)))

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkEquiv_add_right_of_step

/-- **The direct sum respects the KK relation on the right.** -/
theorem kkEquiv_add_right {M M' : KasparovBimodule.{u, v, w} A B}
    (h : Relation.EqvGen KKStep M M') (N : KasparovBimodule.{u, v, w} A B) :
    KKEquiv (M.add N) (M'.add N) := by
  induction h with
  | rel _ _ hs => exact kkEquiv_add_right_of_step hs N
  | refl _ => exact KKEquiv.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkEquiv_add_right

/-- **The direct sum respects the KK relation on the left.** -/
theorem kkEquiv_add_left (M : KasparovBimodule.{u, v, w} A B)
    {N N' : KasparovBimodule.{u, v, w} A B} (h : KKEquiv N N') :
    KKEquiv (M.add N) (M.add N') :=
  (KKEquiv.of_unitaryEquiv (unitaryEquiv_add_comm M N)).trans
    ((kkEquiv_add_right h M).trans (KKEquiv.of_unitaryEquiv (unitaryEquiv_add_comm N' M)))

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkEquiv_add_left

/-- **The direct sum respects the KK relation.** -/
theorem kkEquiv_add {M M' N N' : KasparovBimodule.{u, v, w} A B} (h : KKEquiv M M')
    (h' : KKEquiv N N') : KKEquiv (M.add N) (M'.add N') :=
  (kkEquiv_add_right h N).trans (kkEquiv_add_left M' h')

#audit_axioms GroupApproximation.Manuscript.NonMF.TWWLanes.KKMonoidLane.kkEquiv_add

end KKMonoidLane
end TWWLanes
end NonMF
end Manuscript
end GroupApproximation
