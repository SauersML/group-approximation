import GroupApproximation.PropertyT.IntegralColumnPlaneClosure
import GroupApproximation.Kazhdan.KazhdanComplex
import GroupApproximation.Meta.AxiomGuard

/-!
# nm-chain-13: the EJZ theorem in complex-unitary form (carto re-audit)

`non_mf_groups_exist.tex`, proof of `prop:bilateral-three` (tex 1554–1556):

> The unital subalgebra $S\subseteq pR_Xp$ generated by $s=up$, $t=pu^{-1}$ and $kp$
> satisfies $ts=p$, $st=p-d$.  It is finitely generated, so $L=\EL_3(S)$ has
> property~\textup{(T)}.

The citation is Ershov--Jaikin-Zapirain, *Property (T) for noncommutative universal
lattices*, Theorem 1.1: `EL_n(R)` has (T) for every finitely generated associative ring
`R` with `1` and every `n ≥ 3`.

## Audit (carto re-audit OK)

* `IsFinitelyGeneratedRing A` (`PropertyT/FinitelyGeneratedRing.lean:66`) is
  `∃ s : Finset A, Subring.closure s = ⊤`, i.e. generated as a ring with `1` by a finite
  set, which is EJZ's hypothesis (no commutativity assumed).
* `elementaryGroup (Fin n) A` (`Leavitt/ElementaryGroup.lean:69`) is the subgroup of
  `GL_n(A)` generated by the elementary units `e_ij(a)`, `i ≠ j`, i.e. `EL_n(A)`.
* `HasKazhdanPropertyT.{0,0}` quantifies over real Hilbert spaces with orthogonal
  representations.  EJZ's (T) is stated for complex unitary representations.  The two
  agree with the same `(Q, ε)` (`isKazhdanPair_iff_complex`, `Kazhdan/KazhdanComplex.lean`);
  the endpoint below records the complex form explicitly.  Hilbert spaces in `Type 0`
  already have every Hilbert dimension, so the universe choice is not a restriction.
* The closed theorem is
  `IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT`
  (`PropertyT/IntegralColumnPlaneClosure.lean:486`), audited there with
  `#audit_closed_axioms`.
-/

namespace GroupApproximation.Manuscript.NonMF.ChainCarto13

/-- EJZ Theorem 1.1 as printed, with property (T) in the complex-unitary form. -/
def FinitelyGeneratedRingGeneralRankElementaryPropertyTComplex : Prop :=
  ∀ (A : Type) [Ring A], GroupApproximation.IsFinitelyGeneratedRing A →
    ∀ (n : ℕ), 3 ≤ n →
      GroupApproximation.HasKazhdanPropertyTComplex.{0, 0}
        (GroupApproximation.elementaryGroup (Fin n) A)

#audit_axioms FinitelyGeneratedRingGeneralRankElementaryPropertyTComplex

/-- **EJZ Theorem 1.1, complex-unitary form** (tex 1556): `EL_n(A)` has property (T) for
every finitely generated ring `A` and every `n ≥ 3`. -/
theorem finitelyGeneratedRingGeneralRankElementaryPropertyTComplex :
    FinitelyGeneratedRingGeneralRankElementaryPropertyTComplex := by
  intro A _ hA n hn
  exact GroupApproximation.hasKazhdanPropertyT_iff_complex.mp
    (GroupApproximation.IntegralColumnPlaneClosure.finitelyGeneratedRingGeneralRankElementaryPropertyT
      A hA n hn)

#audit_axioms finitelyGeneratedRingGeneralRankElementaryPropertyTComplex

end GroupApproximation.Manuscript.NonMF.ChainCarto13
