/-!
# Audit repairs for the proof of `thm:core-mf-radical` (tex 1625–1636)

`non_mf_groups_exist.tex`, Section `sec:chain-core`, proof of Theorem `thm:core-mf-radical`
(`k = F_2`, `K_n = ker (GL_n(R_X) → GL_n(R_Y))`, `I = ker (R_X → R_Y)`):

> If $g\in\GL_n(R_X)$ restricts to the identity, put all entries of $g-1$ and $g^{-1}-1$
> inside one finite matrix-product algebra $B=\prod_a M_{h_a}(\F_2)\subset I$, with local
> identity $p$.  Then $g=(1-p)I_n+h$ with $h\in\GL_n(B)$.
> [...]
> Thus $g$ is generated by roots with coefficients in $I$.

The corpus proves these steps for an abstract ring surjection `f : R →+* S` over the premise that
`ker f` is locally matricial (`ChainRadical.exists_cornerUnitHom_eq_of_finset`,
`ChainRadical.ker_elementaryMatrixUnitMap_le_closure_rootsIn`), and the finite-set version drops the
injectivity of `B ↪ R_X`.  The endpoints below are the printed statements for `R_X` itself, with
the premise discharged by the closed Lemma `lem:transient-matrices`
(`ClopenCrossedProduct.isLocallyMatricialIn_coreTransientIdeal
transientIdealLocallyMatricialFTwoStatement_holds`).

* `manuscriptSentence_coreKernelCornerUnit` (tex 1626–1629): for `g ∈ K_n` there are a finite
  matrix-product algebra `B = ∏_a M_{h_a}(F_2)` and an injective non-unital ring map
  `φ : B → R_X` with image in `I` whose image contains every entry of `g - 1` and `g⁻¹ - 1`; with
  `p = φ 1` there is `h ∈ GL_n(B)` with `g = (1 - p) I_n + φ(h)`.
  Route: apply local matriciality to the finite set of those entries
  (`IsLocallyMatricialIn.exists_nonUnitalRingHom`), then `ChainRadical.exists_cornerUnitHom_eq`.
* `manuscriptSentence_coreKernelGeneratedByRoots` (tex 1634): for `n ≥ 2`, `K_n` lies in the
  subgroup generated by the roots `x_{ij}(a)`, `a ∈ I`.
  Route: `ChainRadical.ker_elementaryMatrixUnitMap_le_closure_rootsIn` for the core restriction.

Standing hypotheses of `sec:chain-core` (tex 1345): `X` nonempty compact metrizable zero-dimensional
(spelled with a chosen metric), `T` a homeomorphism.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace AuditChain2

/-- **"If $g\in\GL_n(R_X)$ restricts to the identity, put all entries of $g-1$ and $g^{-1}-1$
inside one finite matrix-product algebra $B=\prod_a M_{h_a}(\F_2)\subset I$, with local identity
$p$. Then $g=(1-p)I_n+h$ with $h\in\GL_n(B)$"** (tex 1626–1629). -/
theorem manuscriptSentence_coreKernelCornerUnit
    (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] [Nonempty X]
    (T : X ≃ₜ X) (n : ℕ)
    (g : (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2)))ˣ)
    (hg : g ∈ GroupApproximation.ChainCore.DynamicRankBudget.glCoreKernel T (ZMod 2) n) :
    ∃ (m : ℕ) (h : Fin m → ℕ)
      (φ : GroupApproximation.ChainRadical.MatrixProductFTwo m h →ₙ+*
        GroupApproximation.ClopenCrossedProduct T (ZMod 2)),
      Function.Injective φ ∧
      (∀ y, φ y ∈ GroupApproximation.ClopenCrossedProduct.coreTransientIdeal T (ZMod 2)) ∧
      (∀ i j : Fin n, ∃ x, φ x =
        ((g : Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2))) - 1)
          i j) ∧
      (∀ i j : Fin n, ∃ x, φ x =
        (((g⁻¹ : (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2)))ˣ) :
          Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2))) - 1) i j) ∧
      ∃ u : (Matrix (Fin n) (Fin n) (GroupApproximation.ChainRadical.MatrixProductFTwo m h))ˣ,
        (g : Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2))) =
          Matrix.scalar (Fin n) (1 - φ 1) +
            (u : Matrix (Fin n) (Fin n) (GroupApproximation.ChainRadical.MatrixProductFTwo m h)).map φ := by
  classical
  letI := GroupApproximation.ClopenCrossedProduct.zmodTwoAlgebra T
  have hI := GroupApproximation.ClopenCrossedProduct.isLocallyMatricialIn_coreTransientIdeal
    GroupApproximation.ClopenCrossedProduct.transientIdealLocallyMatricialFTwoStatement_holds T
  have hsub := GroupApproximation.ChainRadical.sub_one_apply_mem_ker (ι := Fin n)
    (GroupApproximation.ChainCore.DynamicRankBudget.coreRestrict T (ZMod 2)) hg
  have hsub' := GroupApproximation.ChainRadical.sub_one_apply_mem_ker (ι := Fin n)
    (GroupApproximation.ChainCore.DynamicRankBudget.coreRestrict T (ZMod 2)) (inv_mem hg)
  obtain ⟨m, h, φ, hφ, hφI, hcov⟩ := hI.exists_nonUnitalRingHom
    ((Finset.univ : Finset (Fin n × Fin n)).image
        (fun q ↦ ((g : Matrix (Fin n) (Fin n)
          (GroupApproximation.ClopenCrossedProduct T (ZMod 2))) - 1) q.1 q.2) ∪
      (Finset.univ : Finset (Fin n × Fin n)).image
        (fun q ↦ (((g⁻¹ : (Matrix (Fin n) (Fin n)
          (GroupApproximation.ClopenCrossedProduct T (ZMod 2)))ˣ) :
            Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2))) - 1)
              q.1 q.2))
    (by
      intro x hx
      rcases Finset.mem_union.1 hx with hx | hx <;>
        obtain ⟨⟨i, j⟩, -, rfl⟩ := Finset.mem_image.1 hx
      · exact hsub i j
      · exact hsub' i j)
  have hg1 : ∀ i j : Fin n, ∃ x, φ x =
      ((g : Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2))) - 1)
        i j := fun i j ↦
    hcov _ (Finset.mem_union_left _
      (Finset.mem_image.2 ⟨(i, j), Finset.mem_univ _, rfl⟩))
  have hg2 : ∀ i j : Fin n, ∃ x, φ x =
      (((g⁻¹ : (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2)))ˣ) :
        Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2))) - 1) i j :=
    fun i j ↦ hcov _ (Finset.mem_union_right _
      (Finset.mem_image.2 ⟨(i, j), Finset.mem_univ _, rfl⟩))
  obtain ⟨u, hu⟩ := GroupApproximation.ChainRadical.exists_cornerUnitHom_eq φ hφ g hg1 hg2
  refine ⟨m, h, φ, hφ, hφI, hg1, hg2, u, ?_⟩
  rw [← hu]
  exact GroupApproximation.ChainRadical.cornerMatrixHom_apply φ
    (u : Matrix (Fin n) (Fin n) (GroupApproximation.ChainRadical.MatrixProductFTwo m h))

/-- **"Thus $g$ is generated by roots with coefficients in $I$"** (tex 1634): for `n ≥ 2`,
`K_n = ker (GL_n(R_X) → GL_n(R_Y))` over `F_2` lies in the subgroup generated by the roots
`x_{ij}(a)` with `a ∈ I`. -/
theorem manuscriptSentence_coreKernelGeneratedByRoots
    (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] [Nonempty X]
    (T : X ≃ₜ X) (n : ℕ) (hn : 2 ≤ n) :
    GroupApproximation.ChainCore.DynamicRankBudget.glCoreKernel T (ZMod 2) n ≤
      Subgroup.closure
        {g : (Matrix (Fin n) (Fin n) (GroupApproximation.ClopenCrossedProduct T (ZMod 2)))ˣ |
          ∃ (i j : Fin n) (hij : i ≠ j) (a : GroupApproximation.ClopenCrossedProduct T (ZMod 2)),
            a ∈ GroupApproximation.ClopenCrossedProduct.coreTransientIdeal T (ZMod 2) ∧
              g = GroupApproximation.elementaryUnit i j hij a} := by
  letI := GroupApproximation.ClopenCrossedProduct.zmodTwoAlgebra T
  haveI : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.2 hn
  exact GroupApproximation.ChainRadical.ker_elementaryMatrixUnitMap_le_closure_rootsIn (ι := Fin n)
    (GroupApproximation.ChainCore.DynamicRankBudget.coreRestrict T (ZMod 2))
    (GroupApproximation.ClopenCrossedProduct.isLocallyMatricialIn_coreTransientIdeal
      GroupApproximation.ClopenCrossedProduct.transientIdealLocallyMatricialFTwoStatement_holds T)

end AuditChain2
end NonMF
end Manuscript
end GroupApproximation

#audit_axioms GroupApproximation.Manuscript.NonMF.AuditChain2.manuscriptSentence_coreKernelCornerUnit
#audit_axioms GroupApproximation.Manuscript.NonMF.AuditChain2.manuscriptSentence_coreKernelGeneratedByRoots
