/-!
# `lem:saturation` along the printed route, `A' ⊇ A`

`non_mf_groups_exist.tex`, lines 2136–2156:

> **Lemma (saturation).** Let `G` be finitely presented, torsion-free, and
> acylindrically hyperbolic, and let `N ⊴ G` be nontrivial. Then there is a
> surjective homomorphism `φ : G → Q` such that `Q` is two-generated, finitely
> presented, torsion-free, and acylindrically hyperbolic, and `φ(N) = Q`.

> *Proof.* … By Hull [Corollary 5.7 and Lemma 5.8], `N` contains two elements
> `h₁,h₂` such that `N₀ = ⟨h₁,h₂⟩` is suitable with respect to a generating set
> `A' ⊇ A` to which Hull's small cancellation theorem again applies. Apply
> Theorem `thm:hull` to `N₀`, with respect to `A'`, with `g₁,…,g_m` a finite
> generating set of `G`. Then `Q = ⟨φ(g₁),…,φ(g_m)⟩ ≤ φ(N₀) ≤ φ(N) ≤ Q`, … The
> quotient is torsion-free by Theorem `thm:hull` and finitely presented because
> `ker φ` is normally generated by `m` elements.

## Route

* `saturationQuotient_of_hullQuotientNG` (unconditional): the rest of the proof
  after `thm:hull` has been applied to `N₀` at a finite generating family. It
  covers the display `Q = … ≤ φ(N₀) ≤ φ(N) ≤ Q`, torsion-freeness from the
  finite-order lift, and finite presentation from the kernel datum.
* `manuscriptSentence_saturationApplyHullPrintedRoute_of_greendlinger`: the pair
  from `HullPairPrintedRoute.manuscriptSentence_saturationHullPair` (closed), a
  finite generating family, then `thm:hull` at `N₀` with respect to `A'`.
* `manuscriptSentence_saturationPrintedRoute_of_greendlinger`: `lem:saturation`.

## What is not closed

`thm:hull` itself. It rests on Hull's Theorem 7.1, which the corpus reaches over the
single least-area leaf
`GGT.VanKampen.RelativeGreendlingerQuasiGeodesicLeastAreaStatement.{0,0,0}` (Osin,
Lemma 4.4 at least-area van Kampen diagrams). The leaf is taken as the binder
`hgreendlinger`, so the two `_of_greendlinger` endpoints are **partial**. Everything
else is closed: Osin's Lemma 7.1, Hull's Corollary 5.7 and Lemma 5.8, the embedding
bridge, and the group theory after `thm:hull`.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace Saturation

open GroupApproximation.HullGeometry
open GroupApproximation.WordMetric
open GroupApproximation.Manuscript.NonMF.TorsionFree

universe u

/-- **The proof of `lem:saturation` after `thm:hull`** (tex lines 2150–2155),
unconditionally. `thm:hull` has been applied to `N₀ = ⟨h₁,h₂⟩ ≤ N` at a finite
generating family `t` of `G`, and its output with the kernel datum is `H`. Then
`Q = ⟨q(t)⟩ ≤ q(N₀) ≤ q(N) ≤ Q`, `Q = ⟨q h₁, q h₂⟩`, `Q` is torsion-free by the
finite-order lift, and `Q` is finitely presented because `ker q` is the normal
closure of finitely many elements. -/
theorem saturationQuotient_of_hullQuotientNG {G : Type u} [Group G]
    [Group.IsFinitelyPresented G] (hG : IsPowerTorsionFree G) {N : Subgroup G}
    {h₁ h₂ : G} (hN₀le : Subgroup.closure ({h₁, h₂} : Set G) ≤ N) {m : ℕ}
    {t : Fin m → G} (htop : Subgroup.closure (Set.range t) = ⊤)
    (H : HullCorrectedInputs.HullQuotientNG (Subgroup.closure ({h₁, h₂} : Set G)) t
      (∅ : Set G)) :
    Nonempty (SaturationQuotient N (∅ : Set G)) := by
  obtain ⟨H₀, hkerNG⟩ := H
  have hN₀top : (Subgroup.closure ({h₁, h₂} : Set G)).map H₀.q = ⊤ :=
    map_eq_top_of_generators_mem H₀.q H₀.surjective htop H₀.mem_map
  have hNtop : N.map H₀.q = ⊤ := map_eq_top_of_le H₀.q hN₀le hN₀top
  have hgen : Subgroup.closure ({H₀.q h₁, H₀.q h₂} : Set H₀.Q) = ⊤ := by
    rw [← closure_pair_map H₀.q h₁ h₂]
    exact hN₀top
  have htf : IsPowerTorsionFree H₀.Q :=
    torsionFree_of_finiteOrder_lift hG H₀.q H₀.finiteOrder_lift
  obtain ⟨S, -, hker⟩ := hkerNG
  have hfp : Group.IsFinitelyPresented H₀.Q :=
    Group.IsFinitelyPresented.of_surjective H₀.q H₀.surjective
      ⟨(S : Set G), S.finite_toSet, hker.symm⟩
  exact ⟨{ Q := H₀.Q
           group := H₀.group
           q := H₀.q
           surjective := H₀.surjective
           generatorOne := H₀.q h₁
           generatorTwo := H₀.q h₂
           twoGenerated := hgen
           finitelyPresented := hfp
           torsionFree := htf
           acylindricallyHyperbolic := H₀.acylindricallyHyperbolic
           injOn := H₀.injOn
           map_eq_top := hNtop }⟩

#audit_axioms saturationQuotient_of_hullQuotientNG

/-- **"Apply Theorem `thm:hull` to `N₀`, with respect to `A'`, with `g₁,…,g_m` a
finite generating set of `G`."** (tex line 2144).

Over a finitely presented, torsion-free, acylindrically hyperbolic `G` with `N`
suitable with respect to `A`: the pair sentence (closed) gives `A' ⊇ A` and
`N₀ = ⟨h₁,h₂⟩ ≤ N` suitable with respect to `A'`. `G` has a finite generating
family `t`, and `thm:hull` at `(N₀, A', t)` returns the quotient with its kernel
datum. **Partial:** the application of `thm:hull` is over the least-area
Greendlinger leaf `hgreendlinger`. -/
theorem manuscriptSentence_saturationApplyHullPrintedRoute_of_greendlinger
    (hgreendlinger :
      GGT.VanKampen.RelativeGreendlingerQuasiGeodesicLeastAreaStatement.{0, 0, 0})
    {G : Type} [Group G] [Group.IsFinitelyPresented G] [IsAcylindricallyHyperbolic G]
    (hG : IsPowerTorsionFree G) (A : HullGeneratingSet G) {N : Subgroup G}
    (hN : Suitable A.alphabet N) :
    ∃ A' : HullGeneratingSet G, A.alphabet.carrier ⊆ A'.alphabet.carrier ∧
      ∃ h₁ ∈ N, ∃ h₂ ∈ N, Subgroup.closure ({h₁, h₂} : Set G) ≤ N ∧
        Suitable A'.alphabet (Subgroup.closure ({h₁, h₂} : Set G)) ∧
          ∃ (m : ℕ) (t : Fin m → G), Subgroup.closure (Set.range t) = ⊤ ∧
            Nonempty (HullCorrectedInputs.HullQuotientNG
              (Subgroup.closure ({h₁, h₂} : Set G)) t (∅ : Set G)) := by
  obtain ⟨A', hAA', h₁, hh₁, h₂, hh₂, hle, hsuit⟩ :=
    manuscriptSentence_saturationHullPair A hN
  obtain ⟨m, t, htop⟩ := exists_finite_generating_family G
  exact ⟨A', hAA', h₁, hh₁, h₂, hh₂, hle, hsuit, m, t, htop,
    TorsionFreeGreendlingerLeaf.hullSmallCancellationTorsionFreePrinted_of_greendlinger
      hgreendlinger hG A' hsuit t⟩

#audit_axioms manuscriptSentence_saturationApplyHullPrintedRoute_of_greendlinger

/-- **`lem:saturation`** (tex lines 2136–2141) along the printed proof, with the
pair taken at `A' ⊇ A` from Hull's Corollary 5.7 and Lemma 5.8. `N` is suitable
by Osin's Lemma 7.1 (closed) together with torsion-freeness. **Partial:** the
proof applies `thm:hull`, which is over the least-area Greendlinger leaf
`hgreendlinger`. -/
theorem manuscriptSentence_saturationPrintedRoute_of_greendlinger
    (hgreendlinger :
      GGT.VanKampen.RelativeGreendlingerQuasiGeodesicLeastAreaStatement.{0, 0, 0}) :
    TorsionFreePrinted.PrintedSaturationNoOmega.{0} := by
  intro G _ _ _ hG N _ hN
  obtain ⟨A⟩ := exists_hullGeneratingSet G
  have hsn : HullSuitable.IsSNormal N := isSNormal_of_torsionFree hG N hN
  have hnonelem : ActsNonElementarily N (Cayley.base A.alphabet) :=
    TorsionFreePrinted.osinNonElementary_of_printed GGT.OsinPrinted.osinLemma71Printed
      A hG N hsn
  have hsuit : Suitable A.alphabet N := suitable_of_torsionFree hG hnonelem
  obtain ⟨_, _, _, _, _, _, hle, _, _, _, htop, ⟨H⟩⟩ :=
    manuscriptSentence_saturationApplyHullPrintedRoute_of_greendlinger hgreendlinger hG A
      hsuit
  exact saturationQuotient_of_hullQuotientNG hG hle htop H

#audit_axioms manuscriptSentence_saturationPrintedRoute_of_greendlinger

end Saturation
