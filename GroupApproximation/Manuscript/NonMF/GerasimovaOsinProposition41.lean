universe u

section Closure

variable {G : Type u} [Group G]

theorem exists_list_of_mem_closure {T : Set G} {s : G} (hs : s ∈ Subsemigroup.closure T) :
    ∃ l : List G, l ≠ [] ∧ (∀ x ∈ l, x ∈ T) ∧ l.prod = s := by
  induction hs using Subsemigroup.closure_induction with
  | mem x hx => exact ⟨[x], by simp, by simpa using hx, by simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨l₁, hl₁, hT₁, hp₁⟩ := hx
    obtain ⟨l₂, _, hT₂, hp₂⟩ := hy
    refine ⟨l₁ ++ l₂, by simp [hl₁], fun z hz => ?_, by rw [List.prod_append, hp₁, hp₂]⟩
    rcases List.mem_append.mp hz with hz | hz
    · exact hT₁ z hz
    · exact hT₂ z hz

/-- An element of the subsemigroup generated by `tF` is `(t f₁) ⋯ (t fₙ)` with `n ≥ 1`. -/
theorem exists_altWord_of_mem_closure {t : G} {F : Set G} {s : G}
    (hs : s ∈ Subsemigroup.closure ((fun x => t * x) '' F)) :
    ∃ fs : List G, fs ≠ [] ∧ (∀ f ∈ fs, f ∈ F) ∧ RelLetter.listVal (altWord t fs) = s := by
  obtain ⟨l, hl, hT, hp⟩ := exists_list_of_mem_closure hs
  refine ⟨l.map fun x => t⁻¹ * x, by simpa using hl, ?_, ?_⟩
  · intro f hf
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hf
    obtain ⟨f', hf', rfl⟩ := hT x hx
    simpa using hf'
  · rw [listVal_altWord, ← hp]
    simp [List.map_map, Function.comp_def]

end Closure

/-- **Proposition 4.1 under (12)**: the construction of §4 for a finite set not containing
`1`. -/
theorem go_prop41_core (h42 : GerasimovaOsinLemma42Statement) (G : Type) [Group G]
    [Countable G] [IsAcylindricallyHyperbolic G] (hrad : HasTrivialFiniteRadical G)
    (F : Finset G) (h1 : (1 : G) ∉ F) :
    ∃ (ℓ : G → ℝ) (t : G) (C : G → G → Set G) (κ : ℕ),
      (∀ g : G, ℓ g⁻¹ = ℓ g) ∧ (∀ g h : G, ℓ (g * h) ≤ ℓ g + ℓ h) ∧
      (∀ g : G, ℓ g = 0 ↔ g = 1) ∧
      (∀ x y : G, C x y = C y x) ∧
      (∀ g x y : G, C (g * x) (g * y) = (fun z => g * z) '' C x y) ∧
      FreelyGeneratesFreeSubsemigroup ((fun x => t * x) '' (F : Set G)) ∧
      (∀ g : G, ∀ s ∈ (Subsemigroup.closure ((fun x => t * x) '' (F : Set G)) : Set G) ∪ {1},
        (C 1 s ∩ C s g ∩ C 1 g).Nonempty) ∧
      (∀ (n : ℕ) (g : G), (C 1 g ∩ {x | ℓ x ≤ n}).Finite ∧
        (C 1 g ∩ {x | ℓ x ≤ n}).ncard ≤ κ * (n + 1)) ∧
      (∀ (n : ℕ) (g : G), ℓ g ≤ n → ∀ x ∈ C 1 g, ℓ x ≤ κ * (n + 1)) := by
  obtain ⟨y, D, hy, hfam, hFX, hsymm, hD, h13y⟩ := h42 G hrad F h1
  obtain ⟨C, hC, hsum, hproj⟩ :=
    dgoProposition414Uniform G Unit D hD.hyperbolic hsymm 1 1 le_rfl zero_le_one
  have hinf : (D.fam () : Set G).Infinite := by
    rw [hfam]
    exact infinite_zpowers.mpr hy
  obtain ⟨t, ht, htdeep⟩ := exists_deep_letter hD hinf (50 * C)
  have h13 : GOCondition13 D (F : Set G) := by
    intro f hf g hg h hh hmem
    rw [hfam] at hh hmem
    exact h13y f hf g hg h hh hmem
  have hFH : ∀ f ∈ (F : Set G), f ∉ D.fam () := by
    intro f hf hfH
    have e := h13 f hf f hf f hfH (by simpa using hfH)
    simp only [mul_inv_cancel_right] at e
    rw [e] at hf
    exact h1 hf
  have hS : GOSetting D (F : Set G) t C :=
    ⟨hsymm, hC, hsum, hproj, ht, htdeep, fun f hf => hFX hf, hFH⟩
  have hfin : (D.relBall () (5 * C)).Finite := hD.locallyFinite () (5 * C)
  have hSG := D.alphabet.symmetricGenerating
  refine ⟨fun g => (wordNorm D.alphabet.carrier g : ℝ), t, goComb D F t C hfin,
    2 * (goOmegaM D F t C hfin + 1) * (goOmega D F t C hfin).card ^ 2 +
      goOmegaM D F t C hfin + 1, ?_, ?_, ?_, goComb_symm, goComb_equivariant,
    gerasimovaOsinLemma45 hS h13, ?_, ?_, ?_⟩
  · intro g
    simp only [wordNorm_inv hSG]
  · intro g h
    dsimp only
    exact_mod_cast wordNorm_mul_le hSG g h
  · intro g
    simp only [Nat.cast_eq_zero]
    exact wordNorm_eq_zero_iff hSG g
  · intro g s hs
    rw [goComb_one, goComb_one]
    rcases hs with hs | hs
    · exact gerasimovaOsinLemma48 hS (exists_altWord_of_mem_closure hs)
    · rw [Set.mem_singleton_iff] at hs
      subst hs
      exact gerasimovaOsinLemma48_one hS g
  · intro n g
    simp only [goComb_one, Nat.cast_le]
    obtain ⟨hfinite, hcard⟩ := goCone_inter_ball_finite_ncard (hfin := hfin) hS g n
    refine ⟨hfinite, hcard.trans ?_⟩
    have h1 : n + goOmegaM D F t C hfin + 1 ≤ (goOmegaM D F t C hfin + 1) * (n + 1) := by
      nlinarith [Nat.zero_le (goOmegaM D F t C hfin * n)]
    calc 2 * (n + goOmegaM D F t C hfin + 1) * (goOmega D F t C hfin).card ^ 2
        ≤ 2 * ((goOmegaM D F t C hfin + 1) * (n + 1)) * (goOmega D F t C hfin).card ^ 2 := by
          gcongr
      _ = (2 * (goOmegaM D F t C hfin + 1) * (goOmega D F t C hfin).card ^ 2) * (n + 1) := by
          ring
      _ ≤ (2 * (goOmegaM D F t C hfin + 1) * (goOmega D F t C hfin).card ^ 2 +
            goOmegaM D F t C hfin + 1) * (n + 1) := by
          gcongr
          omega
  · intro n g hg x hx
    rw [goComb_one] at hx
    have hxg := wordNorm_le_of_mem_goCone (hfin := hfin) hS hx
    dsimp only at hg
    have hg' : wordNorm D.alphabet.carrier g ≤ n := by exact_mod_cast hg
    have h1 : n + goOmegaM D F t C hfin ≤ (goOmegaM D F t C hfin + 1) * (n + 1) := by
      nlinarith [Nat.zero_le (goOmegaM D F t C hfin * n)]
    have h2 : (goOmegaM D F t C hfin + 1) * (n + 1)
        ≤ (2 * (goOmegaM D F t C hfin + 1) * (goOmega D F t C hfin).card ^ 2 +
          goOmegaM D F t C hfin + 1) * (n + 1) := by
      gcongr
      omega
    have hbound : wordNorm D.alphabet.carrier x
        ≤ (2 * (goOmegaM D F t C hfin + 1) * (goOmega D F t C hfin).card ^ 2 +
          goOmegaM D F t C hfin + 1) * (n + 1) :=
      le_trans (le_trans hxg (Nat.add_le_add_right hg' _)) (le_trans h1 h2)
    dsimp only
    exact_mod_cast hbound

/-- **Gerasimova–Osin, Proposition 4.1**, from the two-sided Lemma 4.2. -/
theorem gerasimovaOsinProposition41_of_lemma42 (h42 : GerasimovaOsinLemma42Statement) :
    GerasimovaOsinProposition41Statement := by
  intro G _ _ _ hrad F _
  classical
  obtain ⟨y, D, hy, -⟩ := h42 G hrad ∅ (by simp)
  have hGinf : (Set.univ : Set G).Infinite :=
    (infinite_zpowers.mpr hy).mono (Set.subset_univ _)
  obtain ⟨g₀, hg₀⟩ : ∃ g₀ : G, g₀ ∉ F.image fun f => f⁻¹ := by
    by_contra hcon
    push Not at hcon
    exact hGinf ((F.image fun f => f⁻¹).finite_toSet.subset fun x _ => hcon x)
  have h1 : (1 : G) ∉ F.image fun f => g₀ * f := by
    intro h
    obtain ⟨f, hf, e⟩ := Finset.mem_image.mp h
    exact hg₀ (Finset.mem_image.mpr ⟨f, hf, (eq_inv_of_mul_eq_one_left e).symm⟩)
  obtain ⟨ℓ, t₀, C, κ, hinv, hmul, hzero, hsymm, hequiv, hfree, htri, hgrowth, hradius⟩ :=
    go_prop41_core h42 G hrad (F.image fun f => g₀ * f) h1
  have himage : (fun x => t₀ * g₀ * x) '' (F : Set G)
      = (fun x => t₀ * x) '' ((F.image fun f => g₀ * f : Finset G) : Set G) := by
    rw [Finset.coe_image, Set.image_image]
    congr 1
    funext x
    simp only [mul_assoc]
  refine ⟨ℓ, t₀ * g₀, C, κ, hinv, hmul, hzero, hsymm, hequiv, ?_, ?_, hgrowth, hradius⟩
  · rw [himage]
    exact hfree
  · rw [himage]
    exact htri

end GerasimovaOsinWords

