import GroupApproximation.Manuscript.NonMF.RegularNonMFAlgebra
import GroupApproximation.Manuscript.NonMF.TorsionFreePrintedTheorem
import GroupApproximation.Manuscript.NonMF.DGOTheorem235Proof
import GroupApproximation.Manuscript.NonMF.GerasimovaOsinTheorem11Closed
import GroupApproximation.Analysis.ReducedGroupCStarMFAlgebra
import GroupApproximation.Sofic.CDEOperatorMF
import GroupApproximation.Sofic.ContinuumMultiplicityCore
import GroupApproximation.Meta.AxiomGuard

/-!
# `cor:regular-nonmf-algebra`: the proof, for the group of `thm:torsion-free`

`non_mf_groups_exist.tex`, line 2204, `\label{cor:regular-nonmf-algebra}`:

> The algebra $C^*_{\mathrm r}(Q)$ is separable, unital, simple, and
> generated by two unitaries.  It has a unique tracial state and stable rank
> one, and it is stably finite but not MF.

Proof (lines 2209-2221):

> The group $Q$ is countable, torsion-free, and acylindrically hyperbolic, so it
> contains a non-degenerate hyperbolically embedded subgroup [Osin, Thm 1.2] and
> has no nontrivial finite normal subgroup.  Dahmani, Guirardel, and Osin give
> simplicity and uniqueness of the trace [DGO, Thm 2.35], and Gerasimova and
> Osin give density of the invertible elements, which is stable rank one
> [GO, Thm 1.1].  The algebra is separable and generated by the canonical
> unitaries of the two generators; its canonical trace is faithful, so it is
> stably finite; and it is not MF by Lemma `prop:mf-residual-calculus`, since
> $Q$ is not MF (Theorem `thm:torsion-free`).

Here `Q` is the group of `thm:torsion-free` (line 284): two-generated, finitely
presented, torsion-free, acylindrically hyperbolic, with property (T), and every
homomorphism from `Q` to an MF group is trivial.

## What is proved here, with nothing assumed

Every step of the printed proof, for every group with the properties of `Q`
that the proof uses:

* *countable*: two-generated, hence finitely generated, hence countable
  (`countable_of_isTwoGenerated`);
* *no nontrivial finite normal subgroup*: torsion-free
  (`TorsionFreePrinted.hasTrivialFiniteRadical_of_torsionFree`);
* *[Osin 1.2] + [DGO 2.35]*: `TorsionFreePrinted.dgoTheorem235Printed`, a closed
  theorem of the corpus (`#audit_closed_axioms` in `DGOTheorem235Proof`);
* *[GO 1.1]*: `TorsionFreePrinted.gerasimovaOsinTheorem11Printed`, a closed
  theorem of the corpus (`#audit_closed_axioms` in
  `GerasimovaOsinTheorem11Closed`);
* *separable, stably finite, not MF by `prop:mf-residual-calculus`*:
  `reducedGroupCStar_separable_stablyFinite` and
  `reducedGroupCStar_separable_stablyFinite_not_isMFAlgebra`;
* *generated by the canonical unitaries of the two generators*:
  `TorsionFreePrinted.unitary_leftRegularOperator` and
  `TorsionFreePrinted.topologicalClosure_adjoin_pair`;
* *unital*: the `CStarAlgebra` structure is unital, and its unit is nonzero
  because `C*_r(Q)` is nontrivial;
* *since `Q` is not MF (`thm:torsion-free`)*: a nontrivial group that kills every
  MF target is not MF (`not_isOperatorMF_of_killsMFTargets`).

The whole corollary, in the corpus's printed form
`TorsionFreePrinted.PrintedRegularNonMFAlgebra`, then follows from the printed
form of `thm:torsion-free` (`printedRegularNonMFAlgebra_of_printedTorsionFreeTheorem`).
The existence of `Q` itself is `thm:torsion-free`, whose remaining open leaf is
recorded in `RegularAlgebraOfGreendlinger`.
-/

namespace GroupApproximation
namespace Manuscript
namespace NonMF
namespace OneSidedRegular

open GroupApproximation.Manuscript.NonMF.TorsionFree
open GroupApproximation.ReducedGroupCStarTrace

/-- *"The group `Q` is countable"*: a two-generated group is countable. -/
theorem countable_of_isTwoGenerated {Q : Type} [Group Q] (hgen : IsTwoGenerated Q) :
    Countable Q := by
  obtain ⟨g₁, g₂, hg⟩ := hgen
  haveI : Group.FG Q :=
    Group.fg_iff.mpr ⟨{g₁, g₂}, hg, (Set.finite_singleton g₂).insert g₁⟩
  exact ContinuumMultiplicity.countable_of_fg Q

/-- *"since `Q` is not MF (Theorem `thm:torsion-free`)"*: a nontrivial group all
of whose homomorphisms to MF groups are trivial is not MF, since otherwise its
identity would be one of them. -/
theorem not_isOperatorMF_of_killsMFTargets (Q : Type) [Group Q] [Nontrivial Q]
    (hkill : ∀ (M : Type) (_ : Group M), IsOperatorMF M →
      ∀ (f : Q →* M) (x : Q), f x = 1) :
    ¬ IsOperatorMF Q := by
  intro hMF
  obtain ⟨x, hx⟩ := exists_ne (1 : Q)
  exact hx (hkill Q inferInstance hMF (MonoidHom.id Q) x)

/-- **`cor:regular-nonmf-algebra`, first sentence** (line 2204), for every
torsion-free, two-generated, acylindrically hyperbolic group `Q`:
`C*_r(Q)` is separable, unital (its unit is nonzero), simple, and generated as a
C⋆-algebra by the two canonical unitaries `λ(g₁), λ(g₂)` of two generators. -/
theorem manuscriptSentence_regularAlgebraSeparableUnitalSimpleTwoUnitaries
    (Q : Type) [Group Q] [IsAcylindricallyHyperbolic Q]
    (htf : IsPowerTorsionFree Q) (hgen : IsTwoGenerated Q) :
    TopologicalSpace.SeparableSpace (ReducedGroupCStar Q) ∧
      (1 : ReducedGroupCStar Q) ≠ 0 ∧
        IsSimpleCStar (ReducedGroupCStar Q) ∧
          ∃ g₁ g₂ : Q, Subgroup.closure ({g₁, g₂} : Set Q) = ⊤ ∧
            leftRegularOperator Q g₁ ∈
                unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
              leftRegularOperator Q g₂ ∈
                unitary (GroupHilbert Q →L[ℂ] GroupHilbert Q) ∧
                (StarAlgebra.adjoin ℂ
                  ({leftRegularOperator Q g₁, leftRegularOperator Q g₂} :
                    Set (GroupHilbert Q →L[ℂ] GroupHilbert Q))).topologicalClosure
                  = reducedGroupCStarSubalgebra Q := by
  haveI : Countable Q := countable_of_isTwoGenerated hgen
  -- "…and has no nontrivial finite normal subgroup."
  have hrad : TorsionFreePrinted.HasTrivialFiniteRadical Q :=
    TorsionFreePrinted.hasTrivialFiniteRadical_of_torsionFree htf
  -- "Dahmani, Guirardel, and Osin give simplicity…"
  obtain ⟨hsimple, -⟩ := TorsionFreePrinted.dgoTheorem235Printed Q hrad
  -- "The algebra is separable and generated by the canonical unitaries of the
  -- two generators."
  obtain ⟨g₁, g₂, hg⟩ := hgen
  refine ⟨(reducedGroupCStar_separable_stablyFinite Q).1, ?_, hsimple, g₁, g₂, hg,
    TorsionFreePrinted.unitary_leftRegularOperator Q g₁,
    TorsionFreePrinted.unitary_leftRegularOperator Q g₂,
    TorsionFreePrinted.topologicalClosure_adjoin_pair hg⟩
  -- "unital": the unit of the algebra is not zero.
  intro hone
  obtain ⟨a, b, hab⟩ := exists_pair_ne (ReducedGroupCStar Q)
  apply hab
  have hzero : ∀ x : ReducedGroupCStar Q, x = 0 := by
    intro x
    calc x = x * 1 := (mul_one x).symm
      _ = x * 0 := by rw [hone]
      _ = 0 := mul_zero x
  rw [hzero a, hzero b]

/-- **`cor:regular-nonmf-algebra`, second sentence** (line 2204), for every
torsion-free, two-generated, acylindrically hyperbolic group `Q` that is not
MF: `C*_r(Q)` has a unique tracial state and stable rank one, and it is stably
finite but not MF. -/
theorem manuscriptSentence_regularAlgebraUniqueTraceStableRankOneStablyFiniteNotMF
    (Q : Type) [Group Q] [IsAcylindricallyHyperbolic Q]
    (htf : IsPowerTorsionFree Q) (hgen : IsTwoGenerated Q)
    (hnotMF : ¬ IsOperatorMF Q) :
    TorsionFreePrinted.HasUniqueTracialState (ReducedGroupCStar Q) ∧
      TorsionFreePrinted.IsStableRankOne (ReducedGroupCStar Q) ∧
        IsStablyFiniteCStarAlgebra (ReducedGroupCStar Q) ∧
          ¬ IsMFAlgebra (ReducedGroupCStar Q) := by
  haveI : Countable Q := countable_of_isTwoGenerated hgen
  have hrad : TorsionFreePrinted.HasTrivialFiniteRadical Q :=
    TorsionFreePrinted.hasTrivialFiniteRadical_of_torsionFree htf
  -- "…and uniqueness of the trace."
  obtain ⟨-, huniq⟩ := TorsionFreePrinted.dgoTheorem235Printed Q hrad
  have hnotCDE : ¬ IsCDEOperatorMF Q := fun hMF ↦
    hnotMF ((isCDEOperatorMF_iff_isOperatorMF Q).mp hMF)
  -- "its canonical trace is faithful, so it is stably finite; and it is not MF
  -- by Lemma `prop:mf-residual-calculus`."
  obtain ⟨-, hsf, hnotMFalg⟩ :=
    reducedGroupCStar_separable_stablyFinite_not_isMFAlgebra Q hnotCDE
  -- "Gerasimova and Osin give density of the invertible elements."
  exact ⟨huniq, TorsionFreePrinted.gerasimovaOsinTheorem11Printed Q hrad, hsf, hnotMFalg⟩

/-- **`cor:regular-nonmf-algebra`, both sentences, from `thm:torsion-free` as
printed.**  The group of `TorsionFreePrinted.PrintedTorsionFreeTheorem`
(two-generated, torsion-free, acylindrically hyperbolic, killing every MF
target) satisfies every clause of `TorsionFreePrinted.PrintedRegularNonMFAlgebra`.
This is the printed proof of the corollary; no citation is assumed. -/
theorem printedRegularNonMFAlgebra_of_printedTorsionFreeTheorem
    (hthm : TorsionFreePrinted.PrintedTorsionFreeTheorem) :
    TorsionFreePrinted.PrintedRegularNonMFAlgebra := by
  obtain ⟨Q, instQ, hgen, -, htf, hacyl, -, hkill, -⟩ := hthm
  letI := instQ
  haveI := hacyl
  haveI : Nontrivial Q := TorsionFreePrinted.nontrivial_of_acylHyperbolic Q
  obtain ⟨hsep, hone, hsimple, hgens⟩ :=
    manuscriptSentence_regularAlgebraSeparableUnitalSimpleTwoUnitaries Q htf hgen
  obtain ⟨huniq, hsr, hsf, hnotMFalg⟩ :=
    manuscriptSentence_regularAlgebraUniqueTraceStableRankOneStablyFiniteNotMF Q htf hgen
      (not_isOperatorMF_of_killsMFTargets Q hkill)
  exact ⟨Q, instQ, countable_of_isTwoGenerated hgen, htf, hacyl, hgen, hsep, hone,
    hgens, hsimple, huniq, hsr, hsf, hnotMFalg⟩

