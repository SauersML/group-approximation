import GroupApproximation.Manuscript.MFRecognition.RopeObjects
import GroupApproximation.Higman.AmalgamPushout
import GroupApproximation.Higman.MikhailovaRopeCode
import GroupApproximation.Sofic.FreeGroupResiduallyFinite

/-!
# `mf_recognition_complexity.tex`, `lem:central-rope`: core constructions

The printed statement is

> **Lemma (the first HNN extension).**
> 1. `K_e` is a direct product of free groups of finite rank, so finitely
>    presented and residually finite; `L_e` is finitely generated; `i` is
>    injective; and `i(F) ∩ L_e = i(N_e)`.
> 2. `Γ_e` is finitely presented, and a finite presentation is computable
>    from `e`.  The natural map from the amalgamated free product
>    `F *_{N_e} F`, in which `n ∈ N_e` in the first copy is identified with
>    `n` in the second copy, onto `S_e`, sending the first copy to `i(F)` and
>    the second to `v i(F) v⁻¹`, is an isomorphism.
> 3. There is a homomorphism `α_e : S_e → Q_e` with `α_e(i(f)) = q_e(f)` and
>    `α_e(v i(f) v⁻¹) = 1` for `f ∈ F`.

Clause (1) is `central_rope_one`, clause (2) is
`centralRope_isFinitelyPresented`, `computable_centralRopeCode` and
`amalgamEquiv`, and clause (3) is `exists_alpha`.

## Open leaf

The only step not carried out here is the Britton step inside the amalgam
identification, `amalgamToGamma_injective`.  The repository already holds
that step in block-word form, `Higman.Pinch.eq_nil_of_clean`: "a clean block
word lies in the base only if it has no blocks at all", proved from Mathlib's
`HNNExtension.ReducedWord.toList_eq_nil_of_mem_of_range`.  What is missing is
the translation of a reduced `Monoid.PushoutI` word into a clean block list.
Nothing else in the manuscript depends on the amalgam identification: `α_e`
is built by the repository's pinch machinery, which does not use it.
-/

namespace GroupApproximation
namespace Manuscript
namespace MFRecognition
namespace Rope
namespace RopeInput

variable (inp : RopeInput)

/-! ## 1.  `lem:central-rope`(1) -/

/-- Reading an intersection off a pullback: for any homomorphism `e` and any
`L`, the elements of `e(G)` that lie in `L` are exactly the images of the
elements of `e⁻¹(L)`.  This is the bookkeeping behind the printed sentence
"an element `i(f)` lies in `L_e` if and only if ...". -/
theorem range_inf_eq_map_comap {G K : Type} [Group G] [Group K] (e : G →* K)
    (L : Subgroup K) : e.range ⊓ L = (L.comap e).map e := by
  ext z
  constructor
  · intro hz
    obtain ⟨hrange, hL⟩ := Subgroup.mem_inf.mp hz
    obtain ⟨g, hg⟩ := hrange
    refine Subgroup.mem_map.mpr ⟨g, ?_, hg⟩
    refine Subgroup.mem_comap.mpr ?_
    rw [hg]
    exact hL
  · intro hz
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hz
    exact Subgroup.mem_inf.mpr ⟨⟨g, rfl⟩, Subgroup.mem_comap.mp hg⟩

/-- **`lem:central-rope`(1), the printed intersection.**  `i(F) ∩ L_e =
i(N_e)`. -/
theorem range_inf_Le : (iEmb inp).range ⊓ Le inp = inp.N.map (iEmb inp) := by
  rw [range_inf_eq_map_comap, comap_Le_eq_N]

/-- **`lem:central-rope`(1).**

"`K_e = F × F(X_e) × F(X_e) × F × P` is a product of six free groups of
finite rank, so it is finitely presented, and residually finite because free
groups are.  The subgroup `L_e` is generated by the basis of the first
factor, the generators of `M_e` from `lem:mikhailova`, and the elements
`(a, j q₊(a))` for `a ∈ {x,y,t}`, so it is finitely generated.  Injectivity
of `i` is clear from the first coordinate.  [...] the intersection is
`i(N_e)`."

The three generating families of `L_e` are `L0`, whose two factors are the
top subgroup of the first free factor and `Higman.Mikhailova.freeSubgroup`
(a closure of the printed pairs), and `Lg`, whose printed generating set is
`Lg_eq_closure`. -/
theorem central_rope_one :
    Group.IsFinitelyPresented (Ke inp) ∧
      Group.ResiduallyFinite (Ke inp) ∧
      (Le inp).FG ∧
      Function.Injective (iEmb inp) ∧
      (iEmb inp).range ⊓ Le inp = inp.N.map (iEmb inp) :=
  ⟨inferInstance, inferInstance, Le_fg inp, iEmb_injective inp, range_inf_Le inp⟩

/-! ## 2.  `lem:central-rope`(2): finite presentation and its code -/

/-- **`lem:central-rope`(2), first clause.**  "`Γ_e` is finitely presented."
"The presentation `eq:central-rope` is finite once `[v, ℓ] = 1` is imposed
only for the finitely many generators `ℓ` of `L_e`." -/
theorem centralRope_isFinitelyPresented :
    Group.IsFinitelyPresented (CentralRope inp) :=
  Higman.Rope.isFinitelyPresented_gamma (witness inp)

/-- **`lem:central-rope`(2), second clause.**  "a finite presentation is
computable from `e` [...] because `K_e`, `L_e` and `i` are."

The raw transformation is the repository's `firstStageCode`: adjoin one
stable letter centralizing the displayed cutting words.  The two computable
inputs are the code of `K_e` and the list of words generating `L_e`, which is
what `lem:mikhailova` computes from `e` (WIRING: higman-compiler supplies
`ambient` and `cutting`); the transformation itself is primitive recursive,
which is the content proved here. -/
theorem computable_centralRopeCode
    (ambient : ℕ → PresentationCodes.PresentationCode)
    (cutting : ℕ → List Higman.MikhailovaRopeCode.Raw)
    (hambient : Computable ambient) (hcutting : Computable cutting) :
    Computable fun e : ℕ =>
      Higman.MikhailovaRopeCode.firstStageCode (ambient e) (cutting e) :=
  Higman.MikhailovaRopeCode.primrec_firstStageCode.to_comp.comp
    (hambient.pair hcutting)

/-! ## 3.  `lem:central-rope`(2): the amalgam is `S_e` -/

/-- The printed two-element diagram `F ← N_e → F` in which "`n ∈ N_e` in the
first copy is identified with `n` in the second copy". -/
abbrev amalgamDiagram : ∀ b : Bool, ↥inp.N →* Higman.Amalgam.fam Fxyt Fxyt b :=
  Higman.Amalgam.famHom inp.N.subtype inp.N.subtype

/-- **The printed amalgamated free product `F *_{N_e} F`.** -/
abbrev Amalgam : Type := Higman.Amalgam.Push inp.N.subtype inp.N.subtype

/-- "`i(n) ∈ L_e` commutes with `v` for `n ∈ N_e`": the stable letter fixes
`i(n)`, so the two copies of `F` agree on `N_e`. -/
theorem vConjHom_eq_iGammaHom_of_mem {n : Fxyt} (hn : n ∈ inp.N) :
    vConjHom inp n = iGammaHom inp n := by
  have hmem : (witness inp).emb n ∈ (witness inp).L := by
    have h : n ∈ (witness inp).L.comap (witness inp).emb := by
      rw [(witness inp).comap_eq]
      exact hn
    exact Subgroup.mem_comap.mp h
  rw [vConjHom_eq_gammaConj, iGammaHom_eq_gammaOf]
  show (HNNExtension.t : CentralRope inp)⁻¹ *
      HNNExtension.of ((witness inp).emb n) * (HNNExtension.t : CentralRope inp)
      = HNNExtension.of ((witness inp).emb n)
  exact Higman.conj_eq_self_of_mem (witness inp).L hmem

/-- **The printed natural map `F *_{N_e} F → Γ_e`.**  "The map from
`F *_{N_e} F` to `S_e` is well defined because `i(n) ∈ L_e` commutes with `v`
for `n ∈ N_e`": that is exactly the compatibility condition the universal
property of the amalgam asks for. -/
noncomputable def amalgamToGamma : Amalgam inp →* CentralRope inp :=
  Monoid.PushoutI.lift
    (fun b => match b with
      | false => iGammaHom inp
      | true => vConjHom inp)
    ((iGammaHom inp).comp inp.N.subtype)
    (by
      intro b
      cases b with
      | false => rfl
      | true =>
          refine MonoidHom.ext fun n => ?_
          exact vConjHom_eq_iGammaHom_of_mem inp n.2)

@[simp] theorem amalgamToGamma_of_false (g : Fxyt) :
    amalgamToGamma inp
        (Monoid.PushoutI.of (φ := amalgamDiagram inp) false g)
      = iGammaHom inp g := by
  unfold amalgamToGamma
  rw [Monoid.PushoutI.lift_of]
  rfl

@[simp] theorem amalgamToGamma_of_true (g : Fxyt) :
    amalgamToGamma inp
        (Monoid.PushoutI.of (φ := amalgamDiagram inp) true g)
      = vConjHom inp g := by
  unfold amalgamToGamma
  rw [Monoid.PushoutI.lift_of]
  rfl

/-- The image of the amalgam lands in `S_e`: the two copies of `F` go to
`i(F)` and to `v i(F) v⁻¹`, which are the two printed generating families of
`S_e`. -/
theorem amalgamToGamma_mem (a : Amalgam inp) :
    amalgamToGamma inp a ∈ RopeS inp := by
  induction a using Monoid.PushoutI.induction_on with
  | of b g =>
      cases b with
      | false =>
          rw [amalgamToGamma_of_false]
          exact iGammaHom_mem_RopeS inp g
      | true =>
          rw [amalgamToGamma_of_true]
          exact vConjHom_mem_RopeS inp g
  | base h =>
      have hb : Monoid.PushoutI.base (amalgamDiagram inp) h
          = Monoid.PushoutI.of (φ := amalgamDiagram inp) false (h : Fxyt) :=
        (Monoid.PushoutI.of_apply_eq_base (amalgamDiagram inp) false h).symm
      rw [hb, amalgamToGamma_of_false]
      exact iGammaHom_mem_RopeS inp _
  | mul p q hp hq =>
      rw [map_mul]
      exact mul_mem hp hq

/-- **The printed "onto `S_e`".**  The image of `F *_{N_e} F` is exactly
`S_e = ⟨i(F), v i(F) v⁻¹⟩`. -/
theorem amalgamToGamma_range : (amalgamToGamma inp).range = RopeS inp := by
  refine le_antisymm ?_ ?_
  · rintro z ⟨a, rfl⟩
    exact amalgamToGamma_mem inp a
  · refine (Subgroup.closure_le _).mpr ?_
    rintro z (⟨u, hu, rfl⟩ | ⟨u, hu, rfl⟩)
    · obtain ⟨g, -, rfl⟩ := hu
      exact ⟨Monoid.PushoutI.of (φ := amalgamDiagram inp) false g,
        amalgamToGamma_of_false inp g⟩
    · obtain ⟨v, hv, rfl⟩ := hu
      obtain ⟨g, -, rfl⟩ := hv
      refine ⟨Monoid.PushoutI.of (φ := amalgamDiagram inp) true g, ?_⟩
      rw [amalgamToGamma_of_true, vConjHom_eq_gammaConj]
      exact (Higman.Rope.conjT_of_emb (witness inp) g).symm

/-! ## 4.  `lem:central-rope`(3) -/

/-- **`lem:central-rope`(3).**  `α_e(i(f)) = q_e(f)`. -/
theorem alpha_iGamma (f : Fxyt) :
    alpha inp ⟨iGammaHom inp f, iGammaHom_mem_RopeS inp f⟩ = qe inp f :=
  Higman.Rope.tau_gammaOf (witness inp) f

/-- **`lem:central-rope`(3).**  `α_e(v i(f) v⁻¹) = 1`. -/
theorem alpha_vConj (f : Fxyt) :
    alpha inp ⟨vConjHom inp f, vConjHom_mem_RopeS inp f⟩ = 1 := by
  have h : (⟨vConjHom inp f, vConjHom_mem_RopeS inp f⟩ : ↥(RopeS inp))
      = ⟨Higman.Rope.gammaConj (witness inp) f,
          Higman.Rope.gammaConj_mem_sub (witness inp) f⟩ :=
    Subtype.ext (vConjHom_eq_gammaConj inp f)
  rw [alpha_eq_tau, h]
  exact Higman.Rope.tau_gammaConj (witness inp) f

/-- **`lem:central-rope`(3), as printed.**  "There is a homomorphism
`α_e : S_e → Q_e` with `α_e(i(f)) = q_e(f)` and `α_e(v i(f) v⁻¹) = 1` for
`f ∈ F`."

The printed proof defines `α_e` on `F *_{N_e} F` by `q_e` on the first copy
and by the trivial map on the second, both of which kill `N_e`, and then
transports along (2).  The repository's `Higman.Rope.tau` is that same
homomorphism, obtained from the pinch machinery without passing through the
amalgam identification. -/
theorem exists_alpha :
    ∃ α : ↥(RopeS inp) →* Qe inp,
      (∀ f : Fxyt, α ⟨iGammaHom inp f, iGammaHom_mem_RopeS inp f⟩ = qe inp f) ∧
        (∀ f : Fxyt, α ⟨vConjHom inp f, vConjHom_mem_RopeS inp f⟩ = 1) :=
  ⟨alpha inp, alpha_iGamma inp, alpha_vConj inp⟩

