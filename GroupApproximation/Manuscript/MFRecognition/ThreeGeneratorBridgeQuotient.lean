import GroupApproximation.Manuscript.MFRecognition.ThreeGeneratorBridge

/-!
# The three-generator bridge, part 3: `Q_+` and clause (2) of `lem:bridge`

This file formalizes the second half of the setup paragraph of
`mf_recognition_complexity.tex`,

> Let `Q_+ = B(1) = ⟨x,y,t | [t,y_i] = 1 (i ∈ ℤ)⟩`, let `q_+ : F → Q_+` be the
> quotient map, and let `N_+ = ker q_+`,

and clause (2) of `lem:bridge` with its printed proof:

> (2) Killing `C` induces a surjection `B(C) → Q_+`; so `N_C ≤ N_+`, with
> equality when `C` is trivial.

> (2) The relators of `eq:bridge` map to the relators `[t, y_i]` of `Q_+` when
> every `c_i` is sent to `1`, and the map is the identity on `x, y, t`.

`Q_+` is `B(1)` by definition, so the printed presentation
`⟨x,y,t | [t,y_i]=1⟩` appears here as the statement `qplus_commute`: in `B(1)`
the stable letter commutes with every element of the associated subgroup,
because the printed twisting `y_i ↦ c_i y_i` is the identity when `C` is
trivial (`cyBaseHom_triv`).
-/

namespace GroupApproximation
namespace Manuscript
namespace MFRecognition
namespace Bridge

open GroupApproximation.Higman.HNNEmb
open GroupApproximation.Higman

/-! ## 1.  The trivial group, and `Q_+ = B(1)` -/

/-- The printed trivial group `1`. -/
abbrev Triv : Type := PUnit

/-- The printed generating sequence of the trivial group: every `c_i` is `1`. -/
def trivSeq : ℤ → Triv := fun _ => 1

/-- **`Q_+ = B(1)`.** -/
abbrev Qplus : Type := BGroup trivSeq

/-- **`q_+ : F → Q_+`**, the printed quotient map. -/
noncomputable def qPlus : FreeXYT →* Qplus := qC trivSeq

/-- **`N_+ = ker q_+`.** -/
noncomputable abbrev Nplus : Subgroup FreeXYT := NC trivSeq

/-- Killing `C` makes the printed twisting trivial: `c_i y_i = y_i`. -/
theorem cyBase_triv (i : ℤ) : cyBase trivSeq i = yBase Triv i := by
  show iA (1 : Triv) * yBase Triv i = yBase Triv i
  rw [map_one, one_mul]

theorem cyBaseHom_triv : cyBaseHom trivSeq = yBaseHom Triv := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  rw [cyBaseHom_of, yBaseHom_of, cyBase_triv]

theorem CYsub_triv : CYsub trivSeq = Ysub Triv := by
  show (cyBaseHom trivSeq).range = (yBaseHom Triv).range
  rw [cyBaseHom_triv]

/-- The printed twisting is the identity on `B(1)`'s associated subgroup. -/
theorem bridgePsi_triv (a : ↥(Ysub Triv)) :
    ((bridgePsi trivSeq a : ↥(CYsub trivSeq)) : Higman.HNNEmb.P Triv)
      = (a : Higman.HNNEmb.P Triv) := by
  obtain ⟨W, hW⟩ := exists_yBaseHom a
  have hmem : yBaseHom Triv W ∈ Ysub Triv := ⟨W, rfl⟩
  have haa : a = ⟨yBaseHom Triv W, hmem⟩ := Subtype.ext hW
  rw [haa, bridgePsi_apply, cyBaseHom_triv]

/-- **The printed presentation `Q_+ = ⟨x,y,t | [t,y_i] = 1⟩`**, in the form the
proof uses it: in `Q_+` the stable letter commutes with every element of the
subgroup generated by the `y_i`. -/
theorem qplus_commute (W : FreeGroup ℤ) :
    (HNNExtension.t : Qplus) * HNNExtension.of (yBaseHom Triv W)
      = HNNExtension.of (yBaseHom Triv W) * (HNNExtension.t : Qplus) := by
  have h := conj_yBaseHom trivSeq W ⟨W, rfl⟩
  rw [cyBaseHom_triv] at h
  calc (HNNExtension.t : Qplus) * HNNExtension.of (yBaseHom Triv W)
      = ((HNNExtension.t : Qplus) * HNNExtension.of (yBaseHom Triv W)
          * (HNNExtension.t : Qplus)⁻¹) * (HNNExtension.t : Qplus) := by group
    _ = HNNExtension.of (yBaseHom Triv W) * (HNNExtension.t : Qplus) := by rw [h]

/-! ## 2.  The three generators of `Q_+` -/

theorem trivSeq_spans : Subgroup.closure (Set.range trivSeq) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro u
  have hu : u = 1 := Subsingleton.elim u 1
  rw [hu]
  exact Subgroup.one_mem _

/-- The image of `x` in `Q_+`. -/
noncomputable def qx : Qplus := qPlus xLetter

/-- The image of `y` in `Q_+`. -/
noncomputable def qy : Qplus := qPlus yLetter

/-- The image of `t` in `Q_+`. -/
noncomputable def qt : Qplus := qPlus tLetter

theorem qx_eq : qx = HNNExtension.of (xg : Higman.HNNEmb.P Triv) := qC_x trivSeq

theorem qy_eq : qy = HNNExtension.of (yg : Higman.HNNEmb.P Triv) := qC_y trivSeq

theorem qt_eq : qt = (HNNExtension.t : Qplus) := qC_t trivSeq

theorem qgens_eq : ({qx, qy, qt} : Set Qplus) = bridgeGens trivSeq := by
  show ({qx, qy, qt} : Set Qplus)
    = {HNNExtension.of (xg : Higman.HNNEmb.P Triv), HNNExtension.of (yg : Higman.HNNEmb.P Triv),
        (HNNExtension.t : Qplus)}
  rw [qx_eq, qy_eq, qt_eq]

/-- `Q_+` is generated by the images of `x`, `y` and `t`. -/
theorem closure_qgens : Subgroup.closure ({qx, qy, qt} : Set Qplus) = ⊤ := by
  rw [qgens_eq]
  exact closure_gens_eq_top_of_spans trivSeq trivSeq_spans

theorem qPlus_surjective : Function.Surjective qPlus :=
  qC_surjective trivSeq trivSeq_spans

/-! ## 3.  Killing `C` -/

/-- The base map that kills `C`: `C * F(x,y) → 1 * F(x,y)`. -/
def killC (C : Type) [Group C] : Higman.HNNEmb.P C →* Higman.HNNEmb.P Triv :=
  Monoid.Coprod.lift 1 (iF : FreeXY →* Higman.HNNEmb.P Triv)

theorem killC_iA {C : Type} [Group C] (α : C) : killC C (iA α) = 1 := by
  show (Monoid.Coprod.lift (1 : C →* Higman.HNNEmb.P Triv) (iF : FreeXY →* Higman.HNNEmb.P Triv))
      (Monoid.Coprod.inl α) = (1 : C →* Higman.HNNEmb.P Triv) α
  rw [Monoid.Coprod.lift_apply_inl]

theorem killC_iF {C : Type} [Group C] (v : FreeXY) :
    killC C (iF v : Higman.HNNEmb.P C) = (iF v : Higman.HNNEmb.P Triv) := by
  show (Monoid.Coprod.lift (1 : C →* Higman.HNNEmb.P Triv) (iF : FreeXY →* Higman.HNNEmb.P Triv))
      (Monoid.Coprod.inr v) = (iF : FreeXY →* Higman.HNNEmb.P Triv) v
  rw [Monoid.Coprod.lift_apply_inr]

theorem killC_xg {C : Type} [Group C] :
    killC C (xg : Higman.HNNEmb.P C) = (xg : Higman.HNNEmb.P Triv) :=
  killC_iF (C := C) xTwo

theorem killC_yg {C : Type} [Group C] :
    killC C (yg : Higman.HNNEmb.P C) = (yg : Higman.HNNEmb.P Triv) :=
  killC_iF (C := C) yTwo

theorem killC_yBase {C : Type} [Group C] (i : ℤ) :
    killC C (yBase C i) = yBase Triv i := by
  show killC C ((xg : Higman.HNNEmb.P C) ^ i * yg * (xg : Higman.HNNEmb.P C) ^ (-i))
    = (xg : Higman.HNNEmb.P Triv) ^ i * yg * (xg : Higman.HNNEmb.P Triv) ^ (-i)
  rw [map_mul, map_mul, map_zpow, map_zpow, killC_xg, killC_yg]

theorem killC_cyBase {C : Type} [Group C] (c : ℤ → C) (i : ℤ) :
    killC C (cyBase c i) = yBase Triv i := by
  show killC C (iA (c i) * yBase C i) = yBase Triv i
  rw [map_mul, killC_iA, one_mul, killC_yBase]

theorem killC_yBaseHom {C : Type} [Group C] (W : FreeGroup ℤ) :
    killC C (yBaseHom C W) = yBaseHom Triv W := by
  refine FreeGroup.induction_on W ?_ ?_ ?_ ?_
  · simp only [map_one]
  · intro i
    simp only [yBaseHom_of]
    exact killC_yBase i
  · intro i h
    simp only [map_inv, h]
  · intro u v hu hv
    simp only [map_mul, hu, hv]

theorem killC_cyBaseHom {C : Type} [Group C] (c : ℤ → C) (W : FreeGroup ℤ) :
    killC C (cyBaseHom c W) = yBaseHom Triv W := by
  refine FreeGroup.induction_on W ?_ ?_ ?_ ?_
  · simp only [map_one]
  · intro i
    simp only [cyBaseHom_of, yBaseHom_of]
    exact killC_cyBase c i
  · intro i h
    simp only [map_inv, h]
  · intro u v hu hv
    simp only [map_mul, hu, hv]

/-- **`lem:bridge` (2), the printed map.**  "Killing `C` induces a surjection
`B(C) → Q_+`": the relators of `eq:bridge` map to the relators `[t,y_i]` of
`Q_+` when every `c_i` is sent to `1`, and the map is the identity on
`x, y, t`. -/
noncomputable def killHom {C : Type} [Group C] (c : ℤ → C) : BGroup c →* Qplus :=
  HNNExtension.lift ((HNNExtension.of : Higman.HNNEmb.P Triv →* Qplus).comp (killC C))
    (HNNExtension.t : Qplus) (fun a => by
      obtain ⟨W, hW⟩ := exists_yBaseHom a
      have hmem : yBaseHom C W ∈ Ysub C := ⟨W, rfl⟩
      have haa : a = ⟨yBaseHom C W, hmem⟩ := Subtype.ext hW
      rw [haa, bridgePsi_apply]
      show (HNNExtension.t : Qplus) * HNNExtension.of (killC C (yBaseHom C W))
        = HNNExtension.of (killC C (cyBaseHom c W)) * (HNNExtension.t : Qplus)
      rw [killC_yBaseHom, killC_cyBaseHom]
      exact qplus_commute W)

theorem killHom_of {C : Type} [Group C] (c : ℤ → C) (u : Higman.HNNEmb.P C) :
    killHom c (HNNExtension.of u) = HNNExtension.of (killC C u) :=
  HNNExtension.lift_of _ _ _ _

theorem killHom_t {C : Type} [Group C] (c : ℤ → C) :
    killHom c (HNNExtension.t : BGroup c) = (HNNExtension.t : Qplus) :=
  HNNExtension.lift_t _ _ _

/-- The printed map "is the identity on `x, y, t`". -/
theorem killHom_comp_qC {C : Type} [Group C] (c : ℤ → C) :
    (killHom c).comp (qC c) = qPlus := by
  refine FreeGroup.ext_hom _ _ fun j => ?_
  fin_cases j
  · show killHom c (qC c xLetter) = qC trivSeq xLetter
    rw [qC_x, qC_x, killHom_of, killC_xg]
  · show killHom c (qC c yLetter) = qC trivSeq yLetter
    rw [qC_y, qC_y, killHom_of, killC_yg]
  · show killHom c (qC c tLetter) = qC trivSeq tLetter
    rw [qC_t, qC_t, killHom_t]

theorem killHom_surjective {C : Type} [Group C] (c : ℤ → C) :
    Function.Surjective (killHom c) := by
  intro z
  obtain ⟨f, hf⟩ := qPlus_surjective z
  refine ⟨qC c f, ?_⟩
  have h : ((killHom c).comp (qC c)) f = qPlus f := by rw [killHom_comp_qC]
  have h2 : killHom c (qC c f) = qPlus f := h
  show killHom c (qC c f) = z
  rw [h2, hf]

/-- **`lem:bridge` (2), first consequence.**  `N_C ≤ N_+`. -/
theorem NC_le_Nplus {C : Type} [Group C] (c : ℤ → C) : NC c ≤ Nplus := by
  intro f hf
  have hf' : qC c f = 1 := hf
  have h : ((killHom c).comp (qC c)) f = 1 := by
    show killHom c (qC c f) = 1
    rw [hf', map_one]
  rw [killHom_comp_qC] at h
  exact h

/-! ## 4.  Equality when `C` is trivial -/

theorem cyBaseHom_eq_of_subsingleton {C : Type} [Group C] [Subsingleton C] (c : ℤ → C) :
    cyBaseHom c = yBaseHom C := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  rw [cyBaseHom_of, yBaseHom_of]
  show iA (c i) * yBase C i = yBase C i
  rw [Subsingleton.elim (c i) (1 : C), map_one, one_mul]

/-- The base map back, used only when `C` is trivial. -/
def unkillC (C : Type) [Group C] : Higman.HNNEmb.P Triv →* Higman.HNNEmb.P C :=
  Monoid.Coprod.lift 1 (iF : FreeXY →* Higman.HNNEmb.P C)

theorem unkillC_iF {C : Type} [Group C] (v : FreeXY) :
    unkillC C (iF v : Higman.HNNEmb.P Triv) = (iF v : Higman.HNNEmb.P C) := by
  show (Monoid.Coprod.lift (1 : Triv →* Higman.HNNEmb.P C) (iF : FreeXY →* Higman.HNNEmb.P C))
      (Monoid.Coprod.inr v) = (iF : FreeXY →* Higman.HNNEmb.P C) v
  rw [Monoid.Coprod.lift_apply_inr]

theorem unkillC_xg {C : Type} [Group C] :
    unkillC C (xg : Higman.HNNEmb.P Triv) = (xg : Higman.HNNEmb.P C) :=
  unkillC_iF (C := C) xTwo

theorem unkillC_yg {C : Type} [Group C] :
    unkillC C (yg : Higman.HNNEmb.P Triv) = (yg : Higman.HNNEmb.P C) :=
  unkillC_iF (C := C) yTwo

theorem unkillC_yBase {C : Type} [Group C] (i : ℤ) :
    unkillC C (yBase Triv i) = yBase C i := by
  show unkillC C ((xg : Higman.HNNEmb.P Triv) ^ i * yg * (xg : Higman.HNNEmb.P Triv) ^ (-i))
    = (xg : Higman.HNNEmb.P C) ^ i * yg * (xg : Higman.HNNEmb.P C) ^ (-i)
  rw [map_mul, map_mul, map_zpow, map_zpow, unkillC_xg, unkillC_yg]

theorem unkillC_yBaseHom {C : Type} [Group C] (W : FreeGroup ℤ) :
    unkillC C (yBaseHom Triv W) = yBaseHom C W := by
  refine FreeGroup.induction_on W ?_ ?_ ?_ ?_
  · simp only [map_one]
  · intro i
    simp only [yBaseHom_of]
    exact unkillC_yBase i
  · intro i h
    simp only [map_inv, h]
  · intro u v hu hv
    simp only [map_mul, hu, hv]

/-- When `C` is trivial the printed surjection has an inverse on the nose. -/
noncomputable def unkillHom {C : Type} [Group C] [Subsingleton C] (c : ℤ → C) :
    Qplus →* BGroup c :=
  HNNExtension.lift ((HNNExtension.of : Higman.HNNEmb.P C →* BGroup c).comp (unkillC C))
    (HNNExtension.t : BGroup c) (fun a => by
      obtain ⟨W, hW⟩ := exists_yBaseHom a
      have hmem : yBaseHom Triv W ∈ Ysub Triv := ⟨W, rfl⟩
      have haa : a = ⟨yBaseHom Triv W, hmem⟩ := Subtype.ext hW
      have hcomm := conj_yBaseHom c W ⟨W, rfl⟩
      rw [cyBaseHom_eq_of_subsingleton] at hcomm
      rw [haa, bridgePsi_apply, cyBaseHom_triv]
      show (HNNExtension.t : BGroup c) * HNNExtension.of (unkillC C (yBaseHom Triv W))
        = HNNExtension.of (unkillC C (yBaseHom Triv W)) * (HNNExtension.t : BGroup c)
      rw [unkillC_yBaseHom]
      calc (HNNExtension.t : BGroup c) * HNNExtension.of (yBaseHom C W)
          = ((HNNExtension.t : BGroup c) * HNNExtension.of (yBaseHom C W)
              * (HNNExtension.t : BGroup c)⁻¹) * (HNNExtension.t : BGroup c) := by group
        _ = HNNExtension.of (yBaseHom C W) * (HNNExtension.t : BGroup c) := by
              rw [hcomm])

theorem unkillHom_of {C : Type} [Group C] [Subsingleton C] (c : ℤ → C)
    (u : Higman.HNNEmb.P Triv) :
    unkillHom c (HNNExtension.of u) = HNNExtension.of (unkillC C u) :=
  HNNExtension.lift_of _ _ _ _

theorem unkillHom_t {C : Type} [Group C] [Subsingleton C] (c : ℤ → C) :
    unkillHom c (HNNExtension.t : Qplus) = (HNNExtension.t : BGroup c) :=
  HNNExtension.lift_t _ _ _

theorem unkillHom_comp_qPlus {C : Type} [Group C] [Subsingleton C] (c : ℤ → C) :
    (unkillHom c).comp qPlus = qC c := by
  refine FreeGroup.ext_hom _ _ fun j => ?_
  fin_cases j
  · show unkillHom c (qC trivSeq xLetter) = qC c xLetter
    rw [qC_x, qC_x, unkillHom_of, unkillC_xg]
  · show unkillHom c (qC trivSeq yLetter) = qC c yLetter
    rw [qC_y, qC_y, unkillHom_of, unkillC_yg]
  · show unkillHom c (qC trivSeq tLetter) = qC c tLetter
    rw [qC_t, qC_t, unkillHom_t]

theorem Nplus_le_NC {C : Type} [Group C] [Subsingleton C] (c : ℤ → C) :
    Nplus ≤ NC c := by
  intro f hf
  have hf' : qPlus f = 1 := hf
  have h : ((unkillHom c).comp qPlus) f = 1 := by
    show unkillHom c (qPlus f) = 1
    rw [hf', map_one]
  rw [unkillHom_comp_qPlus] at h
  exact h

/-- **`lem:bridge` (2).**  "Killing `C` induces a surjection `B(C) → Q_+`; so
`N_C ≤ N_+`, with equality when `C` is trivial." -/
theorem manuscriptBridge_two {C : Type} [Group C] (c : ℤ → C) :
    Function.Surjective (killHom c) ∧
      (killHom c).comp (qC c) = qPlus ∧
      NC c ≤ Nplus :=
  ⟨killHom_surjective c, killHom_comp_qC c, NC_le_Nplus c⟩

/-- **`lem:bridge` (2), the equality clause.**  "...with equality when `C` is
trivial." -/
theorem manuscriptBridge_two_trivial {C : Type} [Group C] [Subsingleton C]
    (c : ℤ → C) : NC c = Nplus :=
  le_antisymm (NC_le_Nplus c) (Nplus_le_NC c)

end Bridge
end MFRecognition
end Manuscript
end GroupApproximation
