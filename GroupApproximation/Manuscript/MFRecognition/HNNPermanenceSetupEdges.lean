import GroupApproximation.Manuscript.MFRecognition.HNNPermanenceSetupPrelude

/-!
# The edge C-star algebras in the HNN permanence proof
-/

namespace GroupApproximation
namespace Manuscript
namespace MFRecognition
namespace HNNPermanence

open GroupApproximation.Manuscript.OneSidedMFRadical.HNNCoronaConjugatorSentenceAudit

noncomputable section

variable {G : Type} [Group G] {S T : Subgroup G} {phi : S ≃* T}
variable {A : Type} [CStarAlgebra A]
variable {X : ℕ → FiniteModel} [∀ n, Nonempty (X n)]

/-! ## `B₀ = C*(ιρ(S))` and `B₁ = C*(ιρ(θ(S)))` -/

/-- Printed: *"let `B₀ = C*(ιρ(S))`"*. -/
def sourceEdgeAlgebra (data : CoronaConjugator G S T phi A X) :
    StarSubalgebra ℂ (baseAlgebra data) :=
  groupGeneratedCStar ((baseUnitaryHom data).comp S.subtype)

/-- Printed: *"and `B₁ = C*(ιρ(θ(S)))`"*. -/
def targetEdgeAlgebra (data : CoronaConjugator G S T phi A X) :
    StarSubalgebra ℂ (baseAlgebra data) :=
  groupGeneratedCStar ((baseUnitaryHom data).comp (edgeHom phi))

instance sourceEdgeAlgebra_isClosed (data : CoronaConjugator G S T phi A X) :
    IsClosed ((sourceEdgeAlgebra data : StarSubalgebra ℂ (baseAlgebra data)) :
      Set (baseAlgebra data)) :=
  groupGeneratedCStar_isClosed _

instance targetEdgeAlgebra_isClosed (data : CoronaConjugator G S T phi A X) :
    IsClosed ((targetEdgeAlgebra data : StarSubalgebra ℂ (baseAlgebra data)) :
      Set (baseAlgebra data)) :=
  groupGeneratedCStar_isClosed _

noncomputable instance sourceEdgeAlgebraCStarAlgebra
    (data : CoronaConjugator G S T phi A X) :
    CStarAlgebra (sourceEdgeAlgebra data) :=
  groupGeneratedCStar_cStarAlgebra ((baseUnitaryHom data).comp S.subtype)

noncomputable instance targetEdgeAlgebraCStarAlgebra
    (data : CoronaConjugator G S T phi A X) :
    CStarAlgebra (targetEdgeAlgebra data) :=
  groupGeneratedCStar_cStarAlgebra ((baseUnitaryHom data).comp (edgeHom phi))

/-- The printed generator `ιρ(s)` of `B₀`. -/
def sourceGenerator (data : CoronaConjugator G S T phi A X) (s : S) :
    unitary (sourceEdgeAlgebra data) :=
  groupGeneratedUnitaryHom ((baseUnitaryHom data).comp S.subtype) s

/-- The printed generator `ιρ(θ(s))` of `B₁`. -/
def targetGenerator (data : CoronaConjugator G S T phi A X) (s : S) :
    unitary (targetEdgeAlgebra data) :=
  groupGeneratedUnitaryHom ((baseUnitaryHom data).comp (edgeHom phi)) s

@[simp] theorem coe_sourceGenerator (data : CoronaConjugator G S T phi A X)
    (s : S) :
    (((sourceGenerator data s : unitary (sourceEdgeAlgebra data)) :
        sourceEdgeAlgebra data) : baseAlgebra data) =
      ((baseUnitaryHom data (s : G) : unitary (baseAlgebra data)) :
        baseAlgebra data) :=
  rfl

@[simp] theorem coe_targetGenerator (data : CoronaConjugator G S T phi A X)
    (s : S) :
    (((targetGenerator data s : unitary (targetEdgeAlgebra data)) :
        targetEdgeAlgebra data) : baseAlgebra data) =
      ((baseUnitaryHom data (edgeHom phi s) : unitary (baseAlgebra data)) :
        baseAlgebra data) :=
  rfl

/-! ## `Θ = Ad(W)|B₀` -/

/-- Membership in `groupGeneratedCStar rho` is membership in the closure of the
star algebra generated by the represented group.

This is stated over a *variable* C-star algebra rather than inline at
`↥(baseAlgebra data)`: writing `StarSubalgebra.topologicalClosure` directly at
a subalgebra of a subalgebra makes Lean re-synthesize `ContinuousStar` and
`TopologicalSemiring` for the subtype, where the subtype topology and the
norm topology are two different instance paths.  Instantiating this lemma
instead only requires the `CStarAlgebra` instance. -/
theorem mem_closure_of_mem_groupGeneratedCStar {H : Type*} [Group H]
    {B : Type*} [CStarAlgebra B] (rho : H →* unitary B) {x : B}
    (hx : x ∈ groupGeneratedCStar rho) :
    x ∈ closure ((StarAlgebra.adjoin ℂ
      (Set.range fun h : H ↦ ((rho h : unitary B) : B)) :
        StarSubalgebra ℂ B) : Set B) := by
  rw [← StarSubalgebra.topologicalClosure_coe]
  exact hx
end

end HNNPermanence
end MFRecognition
end Manuscript
end GroupApproximation
