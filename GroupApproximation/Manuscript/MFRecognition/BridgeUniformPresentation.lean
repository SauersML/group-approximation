import GroupApproximation.Manuscript.MFRecognition.TwoSidedConcreteQCodeFamily

/-!
# `lem:bridge`(1), the uniform clause

> *"`B(C)` is an HNN extension of `C * F(x,y)`, so `C` embeds in `B(C)`; it is
> generated by `x, y, t`; and a recursive presentation of `B(C)` on `x, y, t`
> is computable from a recursive presentation of `C`."*

`ThreeGeneratorBridge.bridge_one_of_spans` covers the embedding and the
generation clauses for an arbitrary generating family, and
`ThreeGeneratorBridgeRecursive.manuscriptBridge_one` adds that `B(C)` has
*some* recursive presentation on three generators.  The printed clause is
stronger: the presentation is *computable from* the presentation of `C`,
uniformly.  That uniform map is
`TwoSidedBridgeRelatorCode.rankThreeCode`, a computable transformation of
standard enumerated presentation codes, and
`TwoSidedBridgeRelatorCode.rankThreePresentedEquiv` says what it presents.
What was missing is the semantic reading of the *code* `rankThreeCode c` as a
rank-three presentation code in the sense of `MarkedHigmanOutput.PresentedQ`;
`TwoSidedConcreteQCodeFamily.rank3Relators_qcode_eq` proves that reading only
along the switch family.  This module proves it for an arbitrary input code and
states `lem:bridge`(1) with all three clauses, uniformly.
-/

namespace GroupApproximation
namespace Manuscript
namespace MFRecognition
namespace HigmanCompiler
namespace BridgeUniform

noncomputable section

namespace TS
export TwoSidedBridgeRelatorCode
  (rankThreeCode computable_rankThreeCode rankThreeRelatorSet
    eval_rankThreeCode rankThreeRawRelator bridgeMap sourceGen sourceGen_spans
    normalClosure_rankThreeRelatorSet rankThreePresentedEquiv)
end TS

/-- Adjoining the identity relator changes no normal closure. -/
theorem normalClosure_union_one (S : Set Source) :
    Subgroup.normalClosure (S ∪ {1}) = Subgroup.normalClosure S := by
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    rintro x (hx | hx)
    · exact Subgroup.subset_normalClosure hx
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact Subgroup.one_mem _
  · exact Subgroup.normalClosure_mono Set.subset_union_left

/-- Decoding the numerical bridge program at an arbitrary input code gives
precisely its kernel range, together with the harmless identity emitted by
bounded-evaluator failures. -/
theorem rank3Relators_rankThreeCode_eq
    (c : EnumeratedPresentationCodes.PresentationCode) :
    rank3Relators (TS.rankThreeCode c) = TS.rankThreeRelatorSet c ∪ {1} := by
  ext x
  constructor
  · rintro ⟨encodedAddress, rfl⟩
    let p := Nat.unpair encodedAddress
    cases heval : Nat.Partrec.Code.evaln p.2 (TS.rankThreeCode c) p.1 with
    | none =>
        apply Or.inr
        simp [rank3Word,
          EnumeratedPresentationCodes.rawRelator, p, heval,
          Higman.Transport.rawToFree_nil]
    | some y =>
        have hsound : y ∈ Nat.Partrec.Code.eval (TS.rankThreeCode c) p.1 :=
          Nat.Partrec.Code.evaln_sound heval
        rw [TS.eval_rankThreeCode] at hsound
        have hy : y = Encodable.encode (TS.rankThreeRawRelator c p.1) := by
          simpa using hsound
        apply Or.inl
        refine ⟨p.1, ?_⟩
        simp [rank3Word,
          EnumeratedPresentationCodes.rawRelator,
          EnumeratedPresentationCodes.decodeRawWord, p, heval, hy]
  · rintro (hx | hx)
    · obtain ⟨address, rfl⟩ := hx
      have hmem : Encodable.encode (TS.rankThreeRawRelator c address) ∈
          Nat.Partrec.Code.eval (TS.rankThreeCode c) address := by
        rw [TS.eval_rankThreeCode]
        exact Part.mem_some _
      obtain ⟨stage, hstage⟩ := Nat.Partrec.Code.evaln_complete.mp hmem
      have hstage' : Nat.Partrec.Code.evaln stage (TS.rankThreeCode c) address =
          some (Encodable.encode (TS.rankThreeRawRelator c address)) := hstage
      refine ⟨Nat.pair address stage, ?_⟩
      simp [rank3Word,
        EnumeratedPresentationCodes.rawRelator,
        EnumeratedPresentationCodes.decodeRawWord, hstage']
    · have hxone : x = 1 := by simpa using hx
      subst x
      refine ⟨Nat.pair 0 0, ?_⟩
      change Higman.rawToFree 2
        ((Nat.Partrec.Code.evaln 0 (TS.rankThreeCode c) 0).map
          EnumeratedPresentationCodes.decodeRawWord |>.getD []) = 1
      have hnone : Nat.Partrec.Code.evaln 0 (TS.rankThreeCode c) 0 = Option.none := by
        cases h : Nat.Partrec.Code.evaln 0 (TS.rankThreeCode c) 0 with
        | none => rfl
        | some y =>
            have hlt : 0 < 0 := Nat.Partrec.Code.evaln_bound h
            omega
      rw [hnone]
      exact Higman.Transport.rawToFree_nil 2

/-- The kernel `N_C` of the presentation on `x, y, t` computed from `c` is the
kernel of the literal bridge map `q_C`. -/
theorem kernelN_rankThreeCode_eq
    (c : EnumeratedPresentationCodes.PresentationCode) :
    kernelN (TS.rankThreeCode c) = MonoidHom.ker (TS.bridgeMap c) := by
  rw [kernelN, rank3Relators_rankThreeCode_eq, normalClosure_union_one,
    TS.normalClosure_rankThreeRelatorSet]

/-- **The uniform presentation presents `B(C)`.**  For every input code `c`,
the rank-three code computed from `c` presents the printed two-sided bridge
`B(C)` over the canonical generators of the group `c` presents. -/
noncomputable def presentedRankThreeEquiv
    (c : EnumeratedPresentationCodes.PresentationCode) :
    PresentedQ (TS.rankThreeCode c) ≃*
      Bridge.BGroup (Bridge.seq (TS.sourceGen c)) :=
  (QuotientGroup.quotientMulEquivOfEq
      (by rw [rank3Relators_rankThreeCode_eq, normalClosure_union_one])).trans
    (TS.rankThreePresentedEquiv c)

/-- **`lem:bridge`(1), all three clauses, uniformly in the presentation of
`C`.**

"`B(C)` is an HNN extension of `C * F(x,y)`, so `C` embeds in `B(C)`; it is
generated by `x, y, t`; and a recursive presentation of `B(C)` on `x, y, t` is
computable from a recursive presentation of `C`."

The recursive presentation of `C` is a standard enumerated presentation code
`c`; the presentation of `B(C)` on `x, y, t` is the code `rankThreeCode c`;
the map `c ↦ rankThreeCode c` is computable; and the code presents `B(C)`. -/
theorem manuscriptBridge_one_uniform :
    Computable TS.rankThreeCode ∧
      ∀ c : EnumeratedPresentationCodes.PresentationCode,
        Function.Injective (Bridge.embC (Bridge.seq (TS.sourceGen c))) ∧
        Subgroup.closure (Bridge.bridgeGens (Bridge.seq (TS.sourceGen c))) = ⊤ ∧
        Nonempty (PresentedQ (TS.rankThreeCode c) ≃*
          Bridge.BGroup (Bridge.seq (TS.sourceGen c))) :=
  ⟨TS.computable_rankThreeCode, fun c =>
    ⟨Bridge.embC_injective _,
      Bridge.closure_gens_eq_top_of_spans _
        (Bridge.closure_range_seq _ (TS.sourceGen_spans c)),
      ⟨presentedRankThreeEquiv c⟩⟩⟩

end

end BridgeUniform
end HigmanCompiler
end MFRecognition
end Manuscript
end GroupApproximation
