import GroupApproximation.Manuscript.OneSidedMFRadical.HNNCoronaConjugatorSentenceAudit

/-!
# `thm:hnn-permanence`, the objects of the proof

This module builds the objects named in the first paragraph of the proof of
`thm:hnn-permanence` in `mf_recognition_complexity.tex`, section `sec:hnn`:

> Write `D = C*(ιρ(G)) ⊆ 𝒬`, a separable `C*`-algebra with unit `p = ι(1)`, and
> let `B₀ = C*(ιρ(S))` and `B₁ = C*(ιρ(θ(S)))`, both containing `p`.
> Conjugation by `W` restricts to a `*`-isomorphism `Θ : B₀ → B₁` carrying
> `ιρ(s)` to `ιρ(θ(s))`.  Let `U` be the quotient of the full unital free
> product `D * C(𝕋)` by the closed ideal generated by the elements
> `u b u* - Θ(b)`, `b ∈ B₀`, ... By construction, `U` has the following
> universal property: whenever `π : D → E` is a unital `*`-homomorphism into a
> unital `C*`-algebra and `v ∈ U(E)` satisfies `v π(b) v* = π(Θ(b))` for
> `b ∈ B₀`, there is a unique `*`-homomorphism `U → E` extending `π` and
> sending `u` to `v`.

Nothing new is defined here that the repository already provides.  The printed
notion of a tracial MF realization is
`OneSidedMFRadical.HNNCoronaConjugatorSentenceAudit.RegularRealizationData`;
the printed remark that an arbitrary norm matrix corona embeds in
`∏ₖMₖ(ℂ)/⊕ₖMₖ(ℂ)` is `normMatrixCorona_hasMFEmbedding_of_positive`;
`lem:rf-regular` is `residuallyFinite_isRegularlyRealized`; the containment of
`G` in the HNN extension `eq:hnn` is `hnnExtension_base_injective`; and the
universal object `U` together with its printed universal property is
`UniversalCStarHNN` and `universalCStarHNN_mappingProperty`.

The edge isomorphism `Θ` is the only printed sentence of this paragraph whose
proof is not already in the repository; it is isolated below as
`exists_edgeIsomorphism`.
-/

namespace GroupApproximation
namespace Manuscript
namespace MFRecognition
namespace HNNPermanence

open GroupApproximation.Manuscript.OneSidedMFRadical.HNNCoronaConjugatorSentenceAudit

noncomputable section

/-! ## The ambient norm matrix corona -/

/-- The norm matrix corona `𝒬` of a dimension sequence.  This is the printed
ambient algebra of `thm:hnn-permanence`; the printed remark preceding
`lem:rf-regular` identifies it, up to an isometric `*`-homomorphism, with a
subalgebra of `∏ₖMₖ(ℂ)/⊕ₖMₖ(ℂ)`. -/
abbrev Corona (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)] : Type :=
  NormMatrixCStarCorona (fun n ↦ X n)

/-! ## The printed hypotheses of `thm:hnn-permanence` -/

/-- The hypotheses of `thm:hnn-permanence`, bundled.

Printed: *"suppose that `G` admits a tracial MF realization `(A, ρ, τ)`, and
that for some norm matrix corona `𝒬` there are an injective
`*`-homomorphism `ι : A → 𝒬` and a unitary `W ∈ 𝒬` with
`W ιρ(s) W* = ιρ(θ(s))` for `s ∈ S`."*

The printed injective homomorphism `θ : S → G` is carried here by the pair
`(T, phi)`: `T = θ(S)` and `phi : S ≃* T` is `θ` with its range as codomain,
which is exactly the datum `HNNExtension G S T phi` of `eq:hnn` consumes. -/
structure CoronaConjugator (G : Type) [Group G] (S T : Subgroup G)
    (phi : S ≃* T) (A : Type) [CStarAlgebra A]
    (X : ℕ → FiniteModel) [∀ n, Nonempty (X n)] where
  /-- the tracial MF realization `(A, ρ, τ)` of `G` -/
  realization : RegularRealizationData G A
  /-- the injective `*`-homomorphism `ι : A → 𝒬` -/
  iota : A →⋆ₐ[ℂ] Corona X
  /-- `ι` is injective -/
  iota_injective : Function.Injective iota
  /-- the corona unitary `W` -/
  W : unitary (Corona X)
  /-- `W ιρ(s) W* = ιρ(θ(s))` for `s ∈ S` -/
  conjugates : ∀ s : S,
    (W : Corona X) * iota ((realization.rho (s : G) : unitary A) : A) *
        star (W : Corona X) =
      iota ((realization.rho ((phi s : T) : G) : unitary A) : A)

variable {G : Type} [Group G] {S T : Subgroup G} {phi : S ≃* T}
variable {A : Type} [CStarAlgebra A]
variable {X : ℕ → FiniteModel} [∀ n, Nonempty (X n)]

/-! ## The edge homomorphism `θ` -/

/-- The printed injective homomorphism `θ : S → G` of `eq:hnn`, recovered from
the Mathlib edge datum `phi : S ≃* T`. -/
def edgeHom (phi : S ≃* T) : S →* G :=
  T.subtype.comp phi.toMonoidHom

@[simp] theorem edgeHom_apply (phi : S ≃* T) (s : S) :
    edgeHom phi s = ((phi s : T) : G) :=
  rfl

/-! ## `D = C*(ιρ(G))` -/

/-- The corona representation `ιρ : G → 𝒰(𝒬)` of the printed proof. -/
def coronaRepresentation (data : CoronaConjugator G S T phi A X) :
    G →* unitary (Corona X) :=
  (unitaryMapOfStarAlgHom data.iota).comp data.realization.rho

@[simp] theorem coe_coronaRepresentation
    (data : CoronaConjugator G S T phi A X) (g : G) :
    ((coronaRepresentation data g : unitary (Corona X)) : Corona X) =
      data.iota ((data.realization.rho g : unitary A) : A) :=
  rfl

/-- Printed: *"Write `D = C*(ιρ(G)) ⊆ 𝒬`."* -/
def baseAlgebra (data : CoronaConjugator G S T phi A X) :
    StarSubalgebra ℂ (Corona X) :=
  groupGeneratedCStar (coronaRepresentation data)

instance baseAlgebra_isClosed (data : CoronaConjugator G S T phi A X) :
    IsClosed ((baseAlgebra data : StarSubalgebra ℂ (Corona X)) :
      Set (Corona X)) :=
  groupGeneratedCStar_isClosed (coronaRepresentation data)

noncomputable instance baseAlgebraCStarAlgebra
    (data : CoronaConjugator G S T phi A X) :
    CStarAlgebra (baseAlgebra data) :=
  groupGeneratedCStar_cStarAlgebra (coronaRepresentation data)

/-- Printed: *"a separable `C*`-algebra"*; `G` is countable, so the algebra
generated by `ιρ(G)` and the unit of the corona is separable. -/
theorem baseAlgebra_separableSpace [Countable G]
    (data : CoronaConjugator G S T phi A X) :
    TopologicalSpace.SeparableSpace (baseAlgebra data) :=
  groupGeneratedCStar_separableSpace (coronaRepresentation data)

/-- Printed: *"with unit `p = ι(1)`"*.  The corona embedding `ι` is unital, so
the unit of `D` is the unit of `𝒬`. -/
theorem baseAlgebra_unit (data : CoronaConjugator G S T phi A X) :
    ((1 : baseAlgebra data) : Corona X) = data.iota (1 : A) := by
  rw [map_one]
  exact OneMemClass.coe_one _

/-- The corona representation, with codomain restricted to `D`. -/
def baseUnitaryHom (data : CoronaConjugator G S T phi A X) :
    G →* unitary (baseAlgebra data) :=
  groupGeneratedUnitaryHom (coronaRepresentation data)

@[simp] theorem coe_baseUnitaryHom (data : CoronaConjugator G S T phi A X)
    (g : G) :
    (((baseUnitaryHom data g : unitary (baseAlgebra data)) :
        baseAlgebra data) : Corona X) =
      data.iota ((data.realization.rho g : unitary A) : A) :=
  rfl
end

end HNNPermanence
end MFRecognition
end Manuscript
end GroupApproximation
