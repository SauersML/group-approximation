import GroupApproximation.Manuscript.MFRecognition.RopeObjects

/-!
# `lem:central-rope`(1), the generating set of `L_e` and the first coordinate

> *"The subgroup `L_e` is generated by the basis of the first factor, the
> generators of `M_e` from `lem:mikhailova`, and the elements `(a, jq₊(a))`
> for `a ∈ {x,y,t}`.  Injectivity of `i` comes from the first coordinate."*

`RopeObjects` proves `L_e` finitely generated (`Le_fg`) and `i` injective
(`iEmb_injective`) but neither along the printed sentence.  Here the three
printed families are named inside `K_e`, `L_e` is shown to be their closure,
and injectivity of `i` is derived from the identity `(i(f)).1.1 = f`.
-/

namespace GroupApproximation
namespace Manuscript
namespace MFRecognition
namespace Rope
namespace RopeInput

variable (inp : RopeInput)

/-! ## The three printed families -/

/-- The first factor `F` of `K⁰_e`, read in `K_e`. -/
def firstFactorHom : Fxyt →* Ke inp :=
  (MonoidHom.inl (K0 inp) Kg).comp
    (MonoidHom.inl Fxyt (FreeGroup inp.X × FreeGroup inp.X))

/-- The factor `F(X_e) × F(X_e)` of `K⁰_e`, read in `K_e`. -/
def mihailovaFactorHom : FreeGroup inp.X × FreeGroup inp.X →* Ke inp :=
  (MonoidHom.inl (K0 inp) Kg).comp
    (MonoidHom.inr Fxyt (FreeGroup inp.X × FreeGroup inp.X))

/-- The graph `f ↦ (f, jq₊(f))` of `K^g`, read in `K_e`. -/
def graphFactorHom : Fxyt →* Ke inp :=
  (MonoidHom.inr (K0 inp) Kg).comp
    (Higman.MikhailovaGraphProduct.graphHom (jq inp))

/-- "the basis of the first factor". -/
def firstFactorGens : Set (Ke inp) := firstFactorHom inp '' basisXYT

/-- "the generators of `M_e` from `lem:mikhailova`". -/
def mihailovaGens : Set (Ke inp) :=
  mihailovaFactorHom inp '' Higman.Mikhailova.freeGenerators inp.R

/-- "the elements `(a, jq₊(a))` for `a ∈ {x,y,t}`". -/
def graphGens : Set (Ke inp) := graphFactorHom inp '' basisXYT

@[simp] theorem firstFactorHom_apply (a : Fxyt) :
    firstFactorHom inp a = ((a, 1), 1) := rfl

@[simp] theorem mihailovaFactorHom_apply (m : FreeGroup inp.X × FreeGroup inp.X) :
    mihailovaFactorHom inp m = ((1, m), 1) := rfl

@[simp] theorem graphFactorHom_apply (a : Fxyt) :
    graphFactorHom inp a = (1, (a, jq inp a)) := rfl

/-! ## `L_e` is their closure -/

/-- **`lem:central-rope`(1), the generating set.**  "The subgroup `L_e` is
generated by the basis of the first factor, the generators of `M_e` from
`lem:mikhailova`, and the elements `(a, jq₊(a))` for `a ∈ {x,y,t}`." -/
theorem Le_eq_closure_gens :
    Le inp =
      Subgroup.closure (firstFactorGens inp ∪ mihailovaGens inp ∪ graphGens inp) := by
  apply le_antisymm
  · refine Subgroup.prod_le_iff.2 ⟨?_, ?_⟩
    · rw [Subgroup.map_le_iff_le_comap]
      show (⊤ : Subgroup Fxyt).prod (Higman.Mikhailova.freeSubgroup inp.R) ≤ _
      refine Subgroup.prod_le_iff.2 ⟨?_, ?_⟩
      · rw [Subgroup.map_le_iff_le_comap, ← closure_basisXYT, Subgroup.closure_le]
        intro a ha
        exact Subgroup.subset_closure (Or.inl (Or.inl ⟨a, ha, rfl⟩))
      · rw [Subgroup.map_le_iff_le_comap]
        show Subgroup.closure (Higman.Mikhailova.freeGenerators inp.R) ≤ _
        rw [Subgroup.closure_le]
        intro m hm
        exact Subgroup.subset_closure (Or.inl (Or.inr ⟨m, hm, rfl⟩))
    · rw [Subgroup.map_le_iff_le_comap, Lg_eq_closure, Subgroup.closure_le]
      rintro p ⟨a, ha, rfl⟩
      exact Subgroup.subset_closure (Or.inr ⟨a, ha, rfl⟩)
  · rw [Subgroup.closure_le]
    rintro x ((⟨a, _, rfl⟩ | ⟨m, hm, rfl⟩) | ⟨a, _, rfl⟩)
    · refine Subgroup.mem_prod.2 ⟨?_, Subgroup.one_mem _⟩
      show ((a, (1 : FreeGroup inp.X × FreeGroup inp.X)) : K0 inp) ∈
        (⊤ : Subgroup Fxyt).prod (Higman.Mikhailova.freeSubgroup inp.R)
      exact Subgroup.mem_prod.2 ⟨Subgroup.mem_top _, Subgroup.one_mem _⟩
    · refine Subgroup.mem_prod.2 ⟨?_, Subgroup.one_mem _⟩
      show (((1 : Fxyt), m) : K0 inp) ∈
        (⊤ : Subgroup Fxyt).prod (Higman.Mikhailova.freeSubgroup inp.R)
      exact Subgroup.mem_prod.2 ⟨Subgroup.mem_top _, Subgroup.subset_closure hm⟩
    · refine Subgroup.mem_prod.2 ⟨Subgroup.one_mem _, ?_⟩
      exact (mem_Lg_iff inp _).2 ⟨a, rfl⟩

/-! ## The first coordinate -/

/-- The first coordinate of `i(f) = ((f, w_f, 1), (f, 1))` is `f` itself. -/
theorem iEmb_fst_fst (f : Fxyt) : (iEmb inp f).1.1 = f := rfl

/-- **"Injectivity of `i` comes from the first coordinate."** -/
theorem iEmb_injective_of_firstCoordinate : Function.Injective (iEmb inp) := by
  intro a b h
  have := congrArg (fun z : Ke inp => z.1.1) h
  simpa only [iEmb_fst_fst] using this

end RopeInput
end Rope
end MFRecognition
end Manuscript
end GroupApproximation
