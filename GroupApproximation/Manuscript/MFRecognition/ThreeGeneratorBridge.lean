import GroupApproximation.Higman.EmbeddingTheorem
import GroupApproximation.Manuscript.MFRecognition.ThreeGeneratorBridgeFreeBasis

/-!
# The three-generator bridge, part 2: `B(C)` and clause (1) of `lem:bridge`

This file formalizes the displayed definition `eq:bridge` of
`mf_recognition_complexity.tex`,

> For a countable group `C` with a generating sequence `(c_i)_{i≥1}`, put
> `c_i = 1` for `i ≤ 0` and
> `B(C) = ⟨ C * F(x,y), t | t y_i t⁻¹ = c_i y_i  (i ∈ ℤ) ⟩`,

and clause (1) of `lem:bridge` with its printed proof:

> (1) `B(C)` is an HNN extension of `C * F(x,y)`, so `C` embeds in `B(C)`; it is
> generated by `x, y, t`; and a recursive presentation of `B(C)` on `x, y, t` is
> computable from a recursive presentation of `C`.  We write `B(C) = F/N_C` and
> `q_C : F → B(C)` for the quotient map.

> The elements `y_i`, `i ∈ ℤ`, freely generate the normal closure of `y` in
> `F(x,y)`.  The retraction `C * F(x,y) → F(x,y)` killing `C` sends `c_i y_i` to
> `y_i`, so a nontrivial reduced word in the `c_i y_i` maps to a nontrivial word
> in the `y_i`; so the `c_i y_i` freely generate a free subgroup, and
> `y_i ↦ c_i y_i` is an isomorphism between two free subgroups of the base.
> Thus `eq:bridge` is an HNN extension, and the base, and with it `C`, embeds by
> Britton's lemma.  The relation `c_i = t y_i t⁻¹ y_i⁻¹` shows that `x, y, t`
> generate `B(C)`, and substituting this expression for `c_i` into the relators
> of `C` and into `eq:bridge` produces a recursive presentation on `x, y, t`,
> uniformly in the presentation of `C`.

The base `C * F(x,y)` is the repository's `Higman.HNNEmb.P`, and the printed
retraction, the two free families, the isomorphism between them and the HNN
extension are built on top of it.  The printed index set is `ℤ`, so the
associated subgroup is the whole normal closure of `y`; the repository's
`Higman.HNNEmbedding` runs the same construction over `ℕ`, which is a different
group, so the families are rebuilt here rather than reused.

The printed freeness of the twisted family is proved exactly as printed: by the
retraction, from `range_yFreeHom_eq_normalClosure` / `yFreeHom_injective`.  No
second ping-pong argument is used.
-/

namespace GroupApproximation
namespace Manuscript
namespace MFRecognition
namespace Bridge

open GroupApproximation.Higman.HNNEmb
open GroupApproximation.Higman

/-! ## 1.  The printed normalization of the generating sequence -/

/-- The printed convention "`(c_i)_{i≥1}` is a generating sequence of `C`, and
`c_i = 1` for `i ≤ 0`", as a family indexed by `ℤ`. -/
def seq {C : Type} [Group C] (c : ℕ → C) : ℤ → C :=
  fun i => if 0 < i then c (i.toNat - 1) else 1

theorem seq_nonpos {C : Type} [Group C] (c : ℕ → C) {i : ℤ} (hi : i ≤ 0) :
    seq c i = 1 := by
  unfold seq
  rw [if_neg (by omega)]

theorem seq_pos {C : Type} [Group C] (c : ℕ → C) (n : ℕ) :
    seq c (n + 1 : ℕ) = c n := by
  unfold seq
  rw [if_pos (by omega)]
  congr 1

theorem range_subset_range_seq {C : Type} [Group C] (c : ℕ → C) :
    Set.range c ⊆ Set.range (seq c) := by
  rintro _ ⟨n, rfl⟩
  exact ⟨((n + 1 : ℕ) : ℤ), seq_pos c n⟩

/-- The printed generating sequence still generates after the normalization. -/
theorem closure_range_seq {C : Type} [Group C] (c : ℕ → C)
    (h : Subgroup.closure (Set.range c) = ⊤) :
    Subgroup.closure (Set.range (seq c)) = ⊤ := by
  refine top_le_iff.mp ?_
  rw [← h]
  exact Subgroup.closure_mono (range_subset_range_seq c)

/-! ## 2.  The base `C * F(x,y)` and the retraction that kills `C` -/

/-- **The printed retraction `C * F(x,y) → F(x,y)` killing `C`.** -/
def retractF (C : Type) [Group C] : Higman.HNNEmb.P C →* FreeXY :=
  Monoid.Coprod.lift 1 (MonoidHom.id FreeXY)

theorem retractF_iA {C : Type} [Group C] (α : C) :
    retractF C (iA α) = 1 := by
  show (Monoid.Coprod.lift (1 : C →* FreeXY) (MonoidHom.id FreeXY))
      (Monoid.Coprod.inl α) = (1 : C →* FreeXY) α
  rw [Monoid.Coprod.lift_apply_inl]

theorem retractF_iF {C : Type} [Group C] (v : FreeXY) :
    retractF C (iF v : Higman.HNNEmb.P C) = v := by
  show (Monoid.Coprod.lift (1 : C →* FreeXY) (MonoidHom.id FreeXY))
      (Monoid.Coprod.inr v) = (MonoidHom.id FreeXY) v
  rw [Monoid.Coprod.lift_apply_inr]

theorem retractF_xg {C : Type} [Group C] :
    retractF C (xg : Higman.HNNEmb.P C) = xTwo :=
  retractF_iF (C := C) xTwo

theorem retractF_yg {C : Type} [Group C] :
    retractF C (yg : Higman.HNNEmb.P C) = yTwo :=
  retractF_iF (C := C) yTwo

/-! ## 3.  The two printed families in the base -/

/-- `y_i = x^i y x^{-i}`, in the base `C * F(x,y)`. -/
def yBase (C : Type) [Group C] (i : ℤ) : Higman.HNNEmb.P C :=
  (xg : Higman.HNNEmb.P C) ^ i * yg * (xg : Higman.HNNEmb.P C) ^ (-i)

/-- `c_i y_i`, the printed twisted family. -/
def cyBase {C : Type} [Group C] (c : ℤ → C) (i : ℤ) : Higman.HNNEmb.P C :=
  iA (c i) * yBase C i

theorem retractF_yBase {C : Type} [Group C] (i : ℤ) :
    retractF C (yBase C i) = yFree i := by
  show retractF C ((xg : Higman.HNNEmb.P C) ^ i * yg * (xg : Higman.HNNEmb.P C) ^ (-i))
    = xTwo ^ i * yTwo * xTwo ^ (-i)
  rw [map_mul, map_mul, map_zpow, map_zpow, retractF_xg, retractF_yg]

/-- **The printed sentence "the retraction sends `c_i y_i` to `y_i`".** -/
theorem retractF_cyBase {C : Type} [Group C] (c : ℤ → C) (i : ℤ) :
    retractF C (cyBase c i) = yFree i := by
  show retractF C (iA (c i) * yBase C i) = yFree i
  rw [map_mul, retractF_iA, one_mul, retractF_yBase]

/-- The homomorphism from the free group on `ℤ` onto the untwisted family. -/
def yBaseHom (C : Type) [Group C] : FreeGroup ℤ →* Higman.HNNEmb.P C :=
  FreeGroup.lift (yBase C)

/-- The homomorphism from the free group on `ℤ` onto the twisted family. -/
def cyBaseHom {C : Type} [Group C] (c : ℤ → C) : FreeGroup ℤ →* Higman.HNNEmb.P C :=
  FreeGroup.lift (cyBase c)

theorem yBaseHom_of {C : Type} [Group C] (i : ℤ) :
    yBaseHom C (FreeGroup.of i) = yBase C i := by
  simp [yBaseHom]

theorem cyBaseHom_of {C : Type} [Group C] (c : ℤ → C) (i : ℤ) :
    cyBaseHom c (FreeGroup.of i) = cyBase c i := by
  simp [cyBaseHom]

theorem retractF_comp_yBaseHom (C : Type) [Group C] :
    (retractF C).comp (yBaseHom C) = yFreeHom := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  show retractF C (yBaseHom C (FreeGroup.of i)) = yFreeHom (FreeGroup.of i)
  rw [yBaseHom_of, yFreeHom_of, retractF_yBase]

theorem retractF_comp_cyBaseHom {C : Type} [Group C] (c : ℤ → C) :
    (retractF C).comp (cyBaseHom c) = yFreeHom := by
  refine FreeGroup.ext_hom _ _ fun i => ?_
  show retractF C (cyBaseHom c (FreeGroup.of i)) = yFreeHom (FreeGroup.of i)
  rw [cyBaseHom_of, yFreeHom_of, retractF_cyBase]

/-- The untwisted family is a free basis in the base. -/
theorem yBaseHom_injective (C : Type) [Group C] :
    Function.Injective (yBaseHom C) := by
  intro u v huv
  have h : ((retractF C).comp (yBaseHom C)) u = ((retractF C).comp (yBaseHom C)) v := by
    show retractF C (yBaseHom C u) = retractF C (yBaseHom C v)
    rw [huv]
  rw [retractF_comp_yBaseHom] at h
  exact yFreeHom_injective h

/-- **`lem:bridge` (1), second sentence.**  "A nontrivial reduced word in the
`c_i y_i` maps to a nontrivial word in the `y_i`; so the `c_i y_i` freely
generate a free subgroup." -/
theorem cyBaseHom_injective {C : Type} [Group C] (c : ℤ → C) :
    Function.Injective (cyBaseHom c) := by
  intro u v huv
  have h : ((retractF C).comp (cyBaseHom c)) u = ((retractF C).comp (cyBaseHom c)) v := by
    show retractF C (cyBaseHom c u) = retractF C (cyBaseHom c v)
    rw [huv]
  rw [retractF_comp_cyBaseHom] at h
  exact yFreeHom_injective h

/-! ## 4.  The two associated subgroups and the printed isomorphism -/

/-- The subgroup of the base generated by the `y_i`. -/
def Ysub (C : Type) [Group C] : Subgroup (Higman.HNNEmb.P C) := (yBaseHom C).range

/-- The subgroup of the base generated by the `c_i y_i`. -/
def CYsub {C : Type} [Group C] (c : ℤ → C) : Subgroup (Higman.HNNEmb.P C) :=
  (cyBaseHom c).range

theorem yBase_mem_Ysub {C : Type} [Group C] (i : ℤ) : yBase C i ∈ Ysub C :=
  ⟨FreeGroup.of i, yBaseHom_of i⟩

theorem cyBase_mem_CYsub {C : Type} [Group C] (c : ℤ → C) (i : ℤ) :
    cyBase c i ∈ CYsub c :=
  ⟨FreeGroup.of i, cyBaseHom_of c i⟩

theorem exists_yBaseHom {C : Type} [Group C] (a : ↥(Ysub C)) :
    ∃ W : FreeGroup ℤ, (a : Higman.HNNEmb.P C) = yBaseHom C W := by
  obtain ⟨W, hW⟩ := a.2
  exact ⟨W, hW.symm⟩

/-- The untwisted family, as a basis of the subgroup it generates. -/
noncomputable def yEquiv (C : Type) [Group C] : FreeGroup ℤ ≃* ↥(Ysub C) :=
  MulEquiv.ofBijective (yBaseHom C).rangeRestrict
    ⟨fun _ _ hxy => yBaseHom_injective C (congrArg Subtype.val hxy),
      (yBaseHom C).rangeRestrict_surjective⟩

/-- The twisted family, likewise. -/
noncomputable def cyEquiv {C : Type} [Group C] (c : ℤ → C) :
    FreeGroup ℤ ≃* ↥(CYsub c) :=
  MulEquiv.ofBijective (cyBaseHom c).rangeRestrict
    ⟨fun _ _ hxy => cyBaseHom_injective c (congrArg Subtype.val hxy),
      (cyBaseHom c).rangeRestrict_surjective⟩

/-- **`lem:bridge` (1), third sentence.**  "`y_i ↦ c_i y_i` is an isomorphism
between two free subgroups of the base." -/
noncomputable def bridgePsi {C : Type} [Group C] (c : ℤ → C) :
    ↥(Ysub C) ≃* ↥(CYsub c) :=
  (yEquiv C).symm.trans (cyEquiv c)

theorem bridgePsi_apply {C : Type} [Group C] (c : ℤ → C) (W : FreeGroup ℤ)
    (hW : yBaseHom C W ∈ Ysub C) :
    ((bridgePsi c ⟨yBaseHom C W, hW⟩ : ↥(CYsub c)) : Higman.HNNEmb.P C) = cyBaseHom c W := by
  have ha : (yEquiv C) W = ⟨yBaseHom C W, hW⟩ := Subtype.ext rfl
  have hasymm : (yEquiv C).symm ⟨yBaseHom C W, hW⟩ = W := by
    rw [MulEquiv.symm_apply_eq]
    exact ha.symm
  calc ((bridgePsi c ⟨yBaseHom C W, hW⟩ : ↥(CYsub c)) : Higman.HNNEmb.P C)
      = (((cyEquiv c) ((yEquiv C).symm ⟨yBaseHom C W, hW⟩) : ↥(CYsub c))
          : Higman.HNNEmb.P C) := rfl
    _ = (((cyEquiv c) W : ↥(CYsub c)) : Higman.HNNEmb.P C) := by rw [hasymm]
    _ = cyBaseHom c W := rfl

/-! ## 5.  The printed group `B(C)` -/

/-- **The printed group `eq:bridge`**, as an HNN extension of the base
`C * F(x,y)` along `y_i ↦ c_i y_i`. -/
abbrev BGroup {C : Type} [Group C] (c : ℤ → C) : Type :=
  HNNExtension (Higman.HNNEmb.P C) (Ysub C) (CYsub c) (bridgePsi c)

/-- The printed embedding of `C` in `B(C)`. -/
noncomputable def embC {C : Type} [Group C] (c : ℤ → C) : C →* BGroup c :=
  (HNNExtension.of).comp (iA : C →* Higman.HNNEmb.P C)

/-- **`lem:bridge` (1), fourth sentence.**  "The base, and with it `C`, embeds
by Britton's lemma." -/
theorem embC_injective {C : Type} [Group C] (c : ℤ → C) :
    Function.Injective (embC c) :=
  (HNNExtension.of_injective (φ := bridgePsi c)).comp iA_injective

/-- **The defining relation of `eq:bridge`**, on a whole word. -/
theorem conj_yBaseHom {C : Type} [Group C] (c : ℤ → C) (W : FreeGroup ℤ)
    (hW : yBaseHom C W ∈ Ysub C) :
    (HNNExtension.t : BGroup c) * HNNExtension.of (yBaseHom C W)
        * (HNNExtension.t : BGroup c)⁻¹
      = HNNExtension.of (cyBaseHom c W) := by
  have h := HNNExtension.equiv_eq_conj (φ := bridgePsi c) ⟨yBaseHom C W, hW⟩
  rw [bridgePsi_apply c W hW] at h
  exact h.symm

/-- **The defining relation of `eq:bridge`**: `t y_i t⁻¹ = c_i y_i`. -/
theorem conj_yBase {C : Type} [Group C] (c : ℤ → C) (i : ℤ) :
    (HNNExtension.t : BGroup c) * HNNExtension.of (yBase C i)
        * (HNNExtension.t : BGroup c)⁻¹
      = HNNExtension.of (cyBase c i) := by
  have h := conj_yBaseHom c (FreeGroup.of i) ⟨FreeGroup.of i, rfl⟩
  rwa [yBaseHom_of, cyBaseHom_of] at h

/-! ## 6.  `x`, `y`, `t` generate `B(C)` -/

/-- The three printed generators of `B(C)`, as a set. -/
def bridgeGens {C : Type} [Group C] (c : ℤ → C) : Set (BGroup c) :=
  {HNNExtension.of (xg : Higman.HNNEmb.P C), HNNExtension.of (yg : Higman.HNNEmb.P C),
    (HNNExtension.t : BGroup c)}

theorem bridge_of_iF_mem {C : Type} [Group C] (c : ℤ → C) (v : FreeXY) :
    HNNExtension.of (iF v : Higman.HNNEmb.P C) ∈ Subgroup.closure (bridgeGens c) := by
  refine FreeGroup.induction_on v ?_ ?_ ?_ ?_
  · rw [map_one, map_one]
    exact Subgroup.one_mem _
  · intro i
    fin_cases i
    · exact Subgroup.subset_closure (Set.mem_insert _ _)
    · exact Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
  · intro i hmem
    rw [map_inv, map_inv]
    exact Subgroup.inv_mem _ hmem
  · intro u w hu hw
    rw [map_mul, map_mul]
    exact Subgroup.mul_mem _ hu hw

theorem of_yBase_mem {C : Type} [Group C] (c : ℤ → C) (i : ℤ) :
    HNNExtension.of (yBase C i) ∈ Subgroup.closure (bridgeGens c) := by
  have hx : HNNExtension.of (xg : Higman.HNNEmb.P C) ∈ Subgroup.closure (bridgeGens c) :=
    Subgroup.subset_closure (Set.mem_insert _ _)
  have hy : HNNExtension.of (yg : Higman.HNNEmb.P C) ∈ Subgroup.closure (bridgeGens c) :=
    Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
  show HNNExtension.of ((xg : Higman.HNNEmb.P C) ^ i * yg * (xg : Higman.HNNEmb.P C) ^ (-i))
    ∈ Subgroup.closure (bridgeGens c)
  rw [map_mul, map_mul, map_zpow, map_zpow]
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (Subgroup.zpow_mem _ hx _) hy)
    (Subgroup.zpow_mem _ hx _)

/-- **`lem:bridge` (1), fifth sentence.**  "The relation `c_i = t y_i t⁻¹ y_i⁻¹`
shows that `x, y, t` generate `B(C)`": every element of the base factor `C` is
a word in the three generators. -/
theorem of_iA_mem_of_spans {C : Type} [Group C] (c : ℤ → C)
    (hspan : Subgroup.closure (Set.range c) = ⊤) (α : C) :
    HNNExtension.of (iA α : Higman.HNNEmb.P C) ∈ Subgroup.closure (bridgeGens c) := by
  have hmem : α ∈ Subgroup.closure (Set.range c) := by
    rw [hspan]
    exact Subgroup.mem_top α
  refine Subgroup.closure_induction
    (p := fun z _ => HNNExtension.of (iA z : Higman.HNNEmb.P C) ∈ Subgroup.closure (bridgeGens c))
    ?_ ?_ ?_ ?_ hmem
  · rintro _ ⟨i, rfl⟩
    have hsplit : (iA (c i) : Higman.HNNEmb.P C) = cyBase c i * (yBase C i)⁻¹ := by
      show (iA (c i) : Higman.HNNEmb.P C) = iA (c i) * yBase C i * (yBase C i)⁻¹
      group
    rw [hsplit, map_mul, map_inv, ← conj_yBase c i]
    have ht : (HNNExtension.t : BGroup c) ∈ Subgroup.closure (bridgeGens c) :=
      Subgroup.subset_closure
        (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
    refine Subgroup.mul_mem _ ?_ (Subgroup.inv_mem _ (of_yBase_mem c i))
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ ht (of_yBase_mem c i))
      (Subgroup.inv_mem _ ht)
  · rw [map_one, map_one]
    exact Subgroup.one_mem _
  · intro u v _ _ hu hv
    rw [map_mul, map_mul]
    exact Subgroup.mul_mem _ hu hv
  · intro u _ hu
    rw [map_inv, map_inv]
    exact Subgroup.inv_mem _ hu

/-- **`lem:bridge` (1): `B(C)` is generated by `x`, `y`, `t`.** -/
theorem closure_gens_eq_top_of_spans {C : Type} [Group C] (c : ℤ → C)
    (hspan : Subgroup.closure (Set.range c) = ⊤) :
    Subgroup.closure (bridgeGens c) = ⊤ := by
  refine top_le_iff.mp ?_
  intro z _hz
  clear _hz
  induction z using HNNExtension.induction_on with
  | of q =>
      have hmem : q ∈ Subgroup.closure ((Set.range (iA : C →* Higman.HNNEmb.P C)) ∪
          (Set.range (iF : FreeXY →* Higman.HNNEmb.P C))) := by
        rw [coprod_closure_top]
        exact Subgroup.mem_top q
      refine Subgroup.closure_induction
        (p := fun u _ => HNNExtension.of (u : Higman.HNNEmb.P C) ∈ Subgroup.closure (bridgeGens c))
        ?_ ?_ ?_ ?_ hmem
      · rintro _ (⟨α, rfl⟩ | ⟨v, rfl⟩)
        · exact of_iA_mem_of_spans c hspan α
        · exact bridge_of_iF_mem c v
      · rw [map_one]
        exact Subgroup.one_mem _
      · intro u v _ _ hu hv
        rw [map_mul]
        exact Subgroup.mul_mem _ hu hv
      · intro u _ hu
        rw [map_inv]
        exact Subgroup.inv_mem _ hu
  | t =>
      exact Subgroup.subset_closure
        (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
  | mul u v hu hv => exact Subgroup.mul_mem _ hu hv
  | inv u hu => exact Subgroup.inv_mem _ hu

/-! ## 7.  `B(C) = F/N_C` -/

/-- The three printed generators of `B(C)`, indexed by `Fin 3` as `x, y, t`. -/
noncomputable def gen3 {C : Type} [Group C] (c : ℤ → C) : Fin 3 → BGroup c := fun j =>
  if j = 0 then HNNExtension.of (xg : Higman.HNNEmb.P C)
  else if j = 1 then HNNExtension.of (yg : Higman.HNNEmb.P C)
  else (HNNExtension.t : BGroup c)

theorem gen3_zero {C : Type} [Group C] (c : ℤ → C) :
    gen3 c 0 = HNNExtension.of (xg : Higman.HNNEmb.P C) := by
  unfold gen3
  simp

theorem gen3_one {C : Type} [Group C] (c : ℤ → C) :
    gen3 c 1 = HNNExtension.of (yg : Higman.HNNEmb.P C) := by
  unfold gen3
  simp

theorem gen3_two {C : Type} [Group C] (c : ℤ → C) :
    gen3 c 2 = (HNNExtension.t : BGroup c) := by
  unfold gen3
  simp

/-- **`q_C : F → B(C)`**, the printed quotient map on the three generators. -/
noncomputable def qC {C : Type} [Group C] (c : ℤ → C) : FreeXYT →* BGroup c :=
  FreeGroup.lift (gen3 c)

theorem qC_x {C : Type} [Group C] (c : ℤ → C) :
    qC c xLetter = HNNExtension.of (xg : Higman.HNNEmb.P C) := by
  unfold qC xLetter
  rw [FreeGroup.lift_apply_of, gen3_zero]

theorem qC_y {C : Type} [Group C] (c : ℤ → C) :
    qC c yLetter = HNNExtension.of (yg : Higman.HNNEmb.P C) := by
  unfold qC yLetter
  rw [FreeGroup.lift_apply_of, gen3_one]

theorem qC_t {C : Type} [Group C] (c : ℤ → C) :
    qC c tLetter = (HNNExtension.t : BGroup c) := by
  unfold qC tLetter
  rw [FreeGroup.lift_apply_of, gen3_two]

theorem qC_surjective {C : Type} [Group C] (c : ℤ → C)
    (hspan : Subgroup.closure (Set.range c) = ⊤) : Function.Surjective (qC c) := by
  have hle : Subgroup.closure (bridgeGens c) ≤ (qC c).range := by
    rw [Subgroup.closure_le]
    intro z hz
    have hz' : z = HNNExtension.of (xg : Higman.HNNEmb.P C) ∨
        z = HNNExtension.of (yg : Higman.HNNEmb.P C) ∨
        z = (HNNExtension.t : BGroup c) := hz
    rcases hz' with rfl | rfl | rfl
    · exact ⟨xLetter, qC_x c⟩
    · exact ⟨yLetter, qC_y c⟩
    · exact ⟨tLetter, qC_t c⟩
  intro z
  have hz : z ∈ (qC c).range := by
    refine hle ?_
    rw [closure_gens_eq_top_of_spans c hspan]
    exact Subgroup.mem_top z
  exact hz

/-- **`N_C`**: the printed kernel, so that `B(C) = F/N_C`. -/
noncomputable abbrev NC {C : Type} [Group C] (c : ℤ → C) : Subgroup FreeXYT :=
  (qC c).ker

/-- **`lem:bridge` (1), last sentence.**  "We write `B(C) = F/N_C` and
`q_C : F → B(C)` for the quotient map." -/
noncomputable def bridgeQuotientEquiv {C : Type} [Group C] (c : ℤ → C)
    (hspan : Subgroup.closure (Set.range c) = ⊤) :
    FreeXYT ⧸ NC c ≃* BGroup c :=
  QuotientGroup.quotientKerEquivOfSurjective (qC c) (qC_surjective c hspan)

/-! ## 8.  The structural part of clause (1) -/

/-- **`lem:bridge` (1), for an arbitrary generating family.**  `C` embeds in
`B(C)`; the three printed generators generate; and the printed map
`q_C : F → B(C)` is onto, so `B(C) = F/N_C`. -/
theorem bridge_one_of_spans {C : Type} [Group C] (c : ℤ → C)
    (hspan : Subgroup.closure (Set.range c) = ⊤) :
    Function.Injective (embC c) ∧
      Subgroup.closure (bridgeGens c) = ⊤ ∧
      Function.Surjective (qC c) :=
  ⟨embC_injective c, closure_gens_eq_top_of_spans c hspan, qC_surjective c hspan⟩

end Bridge
