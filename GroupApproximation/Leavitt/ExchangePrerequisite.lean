import GroupApproximation.PropertyTT.RingHypotheses

/-!
# The ring-side exchange prerequisite

Preusser's reduction over an exchange ring uses a finite orthogonal
idempotent refinement of a decomposition of `1`.  This file isolates that
property and formalizes Ara's constructive bridge from the single-sandwich
division property already proved for the binary Leavitt algebra.

There are two useful unconditional pieces.

* A single-sandwich witness `a * x * b = 1` puts a nonzero idempotent in the
  principal right ideal `xR`: namely `x * b * a`.  In fact this idempotent is
  Murray--von Neumann equivalent to `1`.
* Ara's construction promotes single-sandwich division to the one-element
  exchange property, in both left- and right-ideal orientations.
* A one-element exchange witness immediately gives the required orthogonal
  refinement for a two-term decomposition `x + y = 1`.

These statements are specialized to `L_k(1,2)` below.  The remaining standard
exchange-ring step is finite refinement: promoting the two-term witness to a
simultaneous orthogonal refinement of an arbitrary finite decomposition.
-/

namespace GroupApproximation

namespace ExchangePrerequisite

variable {R : Type*} [Ring R]

/-- The one-element, right-ideal form of the exchange property at `x`.
The two idempotents are `e` and `1 - e`; the latter is automatically
idempotent and orthogonal to the former. -/
def RightExchangeAt (x : R) : Prop :=
  ∃ e r s : R,
    IsIdempotentElem e ∧ e = x * r ∧ 1 - e = (1 - x) * s

/-- The one-element right exchange property for every ring element. -/
def HasRightExchange (R : Type*) [Ring R] : Prop :=
  ∀ x : R, RightExchangeAt x

/-- Nicholson's equivalent one-element criterion in the orientation used by
Ara's proof: `e ∈ R x` and the principal left ideals generated by `e` and
`1 - x` contain `1` together.  Unlike `RightExchangeAt`, this formulation is
obtained directly from single-sandwich division below. -/
def LeftNicholsonExchangeAt (x : R) : Prop :=
  ∃ e r u v : R,
    IsIdempotentElem e ∧ e = r * x ∧ u * e + v * (1 - x) = 1

/-- Nicholson's one-element criterion at every ring element. -/
def HasLeftNicholsonExchange (R : Type*) [Ring R] : Prop :=
  ∀ x : R, LeftNicholsonExchangeAt x

/-- The right-handed Nicholson criterion, used to reach the right-ideal
exchange convention occurring in Preusser's partition lemma. -/
def RightNicholsonExchangeAt (x : R) : Prop :=
  ∃ e r u v : R,
    IsIdempotentElem e ∧ e = x * r ∧ e * u + (1 - x) * v = 1

/-- The right-handed Nicholson criterion at every element. -/
def HasRightNicholsonExchange (R : Type*) [Ring R] : Prop :=
  ∀ x : R, RightNicholsonExchangeAt x

/-- The exact finite orthogonal-partition property used in exchange-ring
arguments: a right-unimodular finite row can be refined by idempotents in its
component principal right ideals. -/
def HasFiniteRightExchangePartitions (R : Type*) [Ring R] : Prop :=
  ∀ (n : ℕ) (x : Fin n → R), (∑ i, x i) = 1 →
    ∃ e r : Fin n → R,
      (∀ i, IsIdempotentElem (e i)) ∧
      (∀ i j, i ≠ j → e i * e j = 0) ∧
      (∀ i, e i = x i * r i) ∧
      (∑ i, e i) = 1

/-- Every idempotent has the tautological exchange witness. -/
theorem rightExchangeAt_of_isIdempotent {e : R} (he : IsIdempotentElem e) :
    RightExchangeAt e := by
  refine ⟨e, 1, 1, he, ?_, ?_⟩ <;> simp

/-- A right-invertible element has the exchange witness `e = 1`. -/
theorem rightExchangeAt_of_mul_eq_one {x r : R} (hxr : x * r = 1) :
    RightExchangeAt x := by
  refine ⟨1, r, 0, IsIdempotentElem.one, hxr.symm, ?_⟩
  simp

/-- If the complement is right-invertible, `e = 0` is an exchange witness. -/
theorem rightExchangeAt_of_one_sub_mul_eq_one {x r : R}
    (hxr : (1 - x) * r = 1) : RightExchangeAt x := by
  refine ⟨0, 0, r, (by simp [IsIdempotentElem]), by simp, ?_⟩
  simpa using hxr.symm

/-- The idempotent canonically cut out by a sandwich `a * x * b = 1`.
Writing it as a definition keeps all later associativity calculations on one
normal form. -/
def sandwichIdempotent (x b a : R) : R := x * b * a

/-- A sandwich idempotent is idempotent. -/
theorem sandwichIdempotent_isIdempotent {x a b : R}
    (h : a * x * b = 1) :
    IsIdempotentElem (sandwichIdempotent x b a) := by
  show (x * b * a) * (x * b * a) = x * b * a
  calc
    (x * b * a) * (x * b * a) = x * b * (a * x * b) * a := by
      simp only [mul_assoc]
    _ = x * b * a := by rw [h]; simp

/-- The sandwich idempotent lies in the principal right ideal generated by
the sandwiched element. -/
theorem sandwichIdempotent_eq_right_mul (x b a : R) :
    sandwichIdempotent x b a = x * (b * a) := by
  simp only [sandwichIdempotent, mul_assoc]

/-- The sandwich idempotent is equivalent to the identity: if
`u = x * b` and `v = a`, then `u * v` is the idempotent and `v * u = 1`.
This is the strongest immediate idempotent consequence of single-sandwich
division. -/
theorem sandwichIdempotent_equivalent_one {x a b : R}
    (h : a * x * b = 1) :
    (x * b) * a = sandwichIdempotent x b a ∧ a * (x * b) = 1 := by
  constructor
  · rfl
  · simpa only [mul_assoc] using h

/-- In a nontrivial ring the sandwich idempotent is nonzero. -/
theorem sandwichIdempotent_ne_zero [Nontrivial R] {x a b : R}
    (h : a * x * b = 1) :
    sandwichIdempotent x b a ≠ 0 := by
  intro he
  have hzero : a * (sandwichIdempotent x b a) * x * b = 0 := by
    rw [he]
    simp
  have hone : a * (sandwichIdempotent x b a) * x * b = 1 := by
    unfold sandwichIdempotent
    calc
      a * (x * b * a) * x * b = (a * x * b) * (a * x * b) := by
        simp only [mul_assoc]
      _ = 1 := by rw [h]; simp
  exact one_ne_zero (hone.symm.trans hzero)

/-- Single-sandwich division puts a nonzero full idempotent in every nonzero
principal right ideal.  The witnesses also retain its equivalence to `1`,
which is the datum needed by later corner manipulations. -/
theorem exists_full_idempotent_right_multiple [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) {x : R} (hx : x ≠ 0) :
    ∃ e r u v : R,
      e ≠ 0 ∧ IsIdempotentElem e ∧ e = x * r ∧
      u * v = e ∧ v * u = 1 := by
  obtain ⟨a, b, hab⟩ := hdiv x hx
  refine ⟨sandwichIdempotent x b a, b * a, x * b, a,
    sandwichIdempotent_ne_zero hab, sandwichIdempotent_isIdempotent hab,
    sandwichIdempotent_eq_right_mul x b a, rfl, ?_⟩
  simpa only [mul_assoc] using hab

open Classical in
/-- Single-sandwich division does give a finite orthogonal partition in the
*two-sided* ideals generated by a right-unimodular row.  One nonzero entry
already generates `1`, so the partition may be concentrated at that entry.

This theorem makes the orientation gap completely explicit: Preusser needs
`e i = x i * r i`, while the consequence here is only
`e i = l i * x i * r i`. -/
theorem exists_finite_twoSidedIdeal_partition [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R)
    (n : ℕ) (x : Fin n → R) (hsum : (∑ i, x i) = 1) :
    ∃ e l r : Fin n → R,
      (∀ i, IsIdempotentElem (e i)) ∧
      (∀ i j, i ≠ j → e i * e j = 0) ∧
      (∀ i, e i = l i * x i * r i) ∧
      (∑ i, e i) = 1 := by
  have hex : ∃ i : Fin n, x i ≠ 0 := by
    by_contra hall
    push Not at hall
    have hz : (∑ i, x i) = 0 := Finset.sum_eq_zero fun i _ ↦ hall i
    exact one_ne_zero (hsum.symm.trans hz)
  obtain ⟨i, hi⟩ := hex
  obtain ⟨a, b, hab⟩ := hdiv (x i) hi
  let e : Fin n → R := fun j ↦ if j = i then 1 else 0
  let l : Fin n → R := fun j ↦ if j = i then a else 0
  let r : Fin n → R := fun j ↦ if j = i then b else 0
  refine ⟨e, l, r, ?_, ?_, ?_, ?_⟩
  · intro j
    by_cases hji : j = i
    · simp [e, hji, IsIdempotentElem]
    · simp [e, hji, IsIdempotentElem]
  · intro p q hpq
    by_cases hpi : p = i <;> by_cases hqi : q = i
    · exact (hpq (hpi.trans hqi.symm)).elim
    · simp [e, hpi, hqi]
    · simp [e, hpi, hqi]
    · simp [e, hpi, hqi]
  · intro j
    by_cases hji : j = i
    · subst j
      simp [e, l, r, hab]
    · simp [e, l, r, hji]
  · simp [e]

/-- Ara's constructive core: single-sandwich division implies Nicholson's
one-element exchange criterion.  For `b = 1 - x`, the non-idempotent case
uses the nonzero element `x*b = b*x`, cuts an idempotent `g` out of the
intersection `R*x ∩ R*b`, and sets

`e = g + g*y*x*(1-g)`,

where `z*g*y = 1`.  The displayed witnesses below also prove
`1 ∈ R*e + R*b` without any ideal API. -/
theorem hasLeftNicholsonExchange_of_singleSandwich [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) : HasLeftNicholsonExchange R := by
  intro x
  by_cases hxidem : IsIdempotentElem x
  · refine ⟨x, 1, 1, 1, hxidem, by simp, ?_⟩
    noncomm_ring
  · let b : R := 1 - x
    have hxb : x * b ≠ 0 := by
      intro hzero
      apply hxidem
      show x * x = x
      have hzero' : x * (1 - x) = 0 := by simpa [b] using hzero
      calc
        x * x = x - x * (1 - x) := by noncomm_ring
        _ = x := by rw [hzero', sub_zero]
    obtain ⟨p, q, hpq⟩ := hdiv (x * b) hxb
    let g : R := q * p * (x * b)
    have hgidem : IsIdempotentElem g := by
      show g * g = g
      dsimp only [g]
      calc
        (q * p * (x * b)) * (q * p * (x * b)) =
            q * (p * (x * b) * q) * p * (x * b) := by
          simp only [mul_assoc]
        _ = q * p * (x * b) := by rw [hpq]; simp
    have hgne : g ≠ 0 := by
      intro hgzero
      have hzero : p * (x * b) * g * q = 0 := by rw [hgzero]; simp
      have hone : p * (x * b) * g * q = 1 := by
        dsimp only [g]
        calc
          p * (x * b) * (q * p * (x * b)) * q =
              (p * (x * b) * q) * (p * (x * b) * q) := by
            simp only [mul_assoc]
          _ = 1 := by rw [hpq]; simp
      exact one_ne_zero (hone.symm.trans hzero)
    let gc : R := q * p * b
    let gb : R := q * p * x
    have hgc : g = gc * x := by
      dsimp only [g, gc, b]
      noncomm_ring
    have hgb : g = gb * b := by
      dsimp only [g, gb]
      simp only [mul_assoc]
    obtain ⟨z, y, hzy⟩ := hdiv g hgne
    let e : R := g + g * y * x * (1 - g)
    have heidem : IsIdempotentElem e := by
      have hg' : g * g = g := hgidem
      let h : R := g * y * x * (1 - g)
      have hgh : g * h = h := by
        calc
          g * h = (g * g) * y * x * (1 - g) := by
            dsimp only [h]
            simp only [mul_assoc]
          _ = h := by rw [hg']
      have hhg : h * g = 0 := by
        have hc : (1 - g) * g = 0 := by noncomm_ring [hg']
        calc
          h * g = g * y * x * ((1 - g) * g) := by
            dsimp only [h]
            simp only [mul_assoc]
          _ = 0 := by rw [hc]; simp
      have hhsq : h * h = 0 := by
        calc
          h * h = g * y * x * ((1 - g) * g) * y * x * (1 - g) := by
            dsimp only [h]
            simp only [mul_assoc]
          _ = 0 := by
            have hc : (1 - g) * g = 0 := by noncomm_ring [hg']
            rw [hc]
            simp
      show e * e = e
      change (g + h) * (g + h) = g + h
      calc
        (g + h) * (g + h) = g * g + g * h + h * g + h * h := by
          noncomm_ring
        _ = g + h := by rw [hg', hgh, hhg, hhsq]; simp
    let er : R := gc + g * y - g * y * x * gc
    have her : e = er * x := by
      dsimp only [e, er]
      rw [hgc]
      noncomm_ring
    have hzx : z * e = z * g + x - x * g := by
      dsimp only [e]
      calc
        z * (g + g * y * x * (1 - g)) =
            z * g + (z * g * y) * x * (1 - g) := by
          simp only [mul_add, mul_assoc]
        _ = z * g + x - x * g := by rw [hzy]; noncomm_ring
    have hxsum : x = z * e + ((x - z) * gb) * b := by
      rw [hzx, hgb]
      noncomm_ring
    refine ⟨e, er, z, (x - z) * gb + 1, heidem, her, ?_⟩
    change z * e + (((x - z) * gb + 1) * b) = 1
    calc
      z * e + (((x - z) * gb + 1) * b) =
          (z * e + ((x - z) * gb) * b) + b := by noncomm_ring
      _ = x + b := by rw [← hxsum]
      _ = 1 := by dsimp only [b]; noncomm_ring

/-- The right-handed mirror of Ara's construction. -/
theorem hasRightNicholsonExchange_of_singleSandwich [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) : HasRightNicholsonExchange R := by
  intro x
  by_cases hxidem : IsIdempotentElem x
  · refine ⟨x, 1, 1, 1, hxidem, by simp, ?_⟩
    noncomm_ring
  · let b : R := 1 - x
    have hxb : x * b ≠ 0 := by
      intro hzero
      apply hxidem
      show x * x = x
      have hzero' : x * (1 - x) = 0 := by simpa [b] using hzero
      calc
        x * x = x - x * (1 - x) := by noncomm_ring
        _ = x := by rw [hzero', sub_zero]
    obtain ⟨p, q, hpq⟩ := hdiv (x * b) hxb
    let g : R := (x * b) * q * p
    have hgidem : IsIdempotentElem g := by
      show g * g = g
      dsimp only [g]
      calc
        ((x * b) * q * p) * ((x * b) * q * p) =
            (x * b) * q * (p * (x * b) * q) * p := by
          simp only [mul_assoc]
        _ = (x * b) * q * p := by rw [hpq]; simp
    have hgne : g ≠ 0 := by
      intro hgzero
      have hzero : p * g * (x * b) * q = 0 := by rw [hgzero]; simp
      have hone : p * g * (x * b) * q = 1 := by
        dsimp only [g]
        calc
          p * ((x * b) * q * p) * (x * b) * q =
              (p * (x * b) * q) * (p * (x * b) * q) := by
            simp only [mul_assoc]
          _ = 1 := by rw [hpq]; simp
      exact one_ne_zero (hone.symm.trans hzero)
    let gc : R := b * q * p
    let gb : R := x * q * p
    have hgc : g = x * gc := by
      dsimp only [g, gc]
      simp only [mul_assoc]
    have hgb : g = b * gb := by
      dsimp only [g, gb, b]
      noncomm_ring
    obtain ⟨z, y, hzy⟩ := hdiv g hgne
    let e : R := g + (1 - g) * x * z * g
    have heidem : IsIdempotentElem e := by
      have hg' : g * g = g := hgidem
      let h : R := (1 - g) * x * z * g
      have hgh : g * h = 0 := by
        have hc : g * (1 - g) = 0 := by noncomm_ring [hg']
        calc
          g * h = (g * (1 - g)) * x * z * g := by
            dsimp only [h]
            simp only [mul_assoc]
          _ = 0 := by rw [hc]; simp
      have hhg : h * g = h := by
        calc
          h * g = (1 - g) * x * z * (g * g) := by
            dsimp only [h]
            simp only [mul_assoc]
          _ = h := by rw [hg']
      have hhsq : h * h = 0 := by
        calc
          h * h = (1 - g) * x * z * (g * (1 - g)) * x * z * g := by
            dsimp only [h]
            simp only [mul_assoc]
          _ = 0 := by
            have hc : g * (1 - g) = 0 := by noncomm_ring [hg']
            rw [hc]
            simp
      show e * e = e
      change (g + h) * (g + h) = g + h
      calc
        (g + h) * (g + h) = g * g + g * h + h * g + h * h := by
          noncomm_ring
        _ = g + h := by rw [hg', hgh, hhg, hhsq]; simp
    let er : R := gc + z * g - gc * x * z * g
    have her : e = x * er := by
      dsimp only [e, er]
      rw [hgc]
      noncomm_ring
    have hey : e * y = g * y + x - g * x := by
      dsimp only [e]
      calc
        (g + (1 - g) * x * z * g) * y =
            g * y + (1 - g) * x * (z * g * y) := by
          simp only [add_mul, mul_assoc]
        _ = g * y + x - g * x := by rw [hzy]; noncomm_ring
    have hxsum : x = e * y + b * (gb * (x - y)) := by
      rw [hey, hgb]
      noncomm_ring
    refine ⟨e, er, y, gb * (x - y) + 1, heidem, her, ?_⟩
    change e * y + b * (gb * (x - y) + 1) = 1
    calc
      e * y + b * (gb * (x - y) + 1) =
          (e * y + b * (gb * (x - y))) + b := by noncomm_ring
      _ = x + b := by rw [← hxsum]
      _ = 1 := by dsimp only [b]; noncomm_ring

/-- Nicholson's right-handed criterion produces the usual complementary
idempotent witness explicitly. -/
theorem rightExchangeAt_of_rightNicholson {x : R}
    (hN : RightNicholsonExchangeAt x) : RightExchangeAt x := by
  obtain ⟨e, r, u, v, he, her, hsum⟩ := hN
  let f : R := e + e * u * (1 - e)
  have hfidem : IsIdempotentElem f := by
    have he' : e * e = e := he
    let h : R := e * u * (1 - e)
    have heh : e * h = h := by
      calc
        e * h = (e * e) * u * (1 - e) := by
          dsimp only [h]
          simp only [mul_assoc]
        _ = h := by rw [he']
    have hhe : h * e = 0 := by
      have hc : (1 - e) * e = 0 := by noncomm_ring [he']
      calc
        h * e = e * u * ((1 - e) * e) := by
          dsimp only [h]
          simp only [mul_assoc]
        _ = 0 := by rw [hc]; simp
    have hhsq : h * h = 0 := by
      calc
        h * h = e * u * ((1 - e) * e) * u * (1 - e) := by
          dsimp only [h]
          simp only [mul_assoc]
        _ = 0 := by
          have hc : (1 - e) * e = 0 := by noncomm_ring [he']
          rw [hc]
          simp
    show f * f = f
    change (e + h) * (e + h) = e + h
    calc
      (e + h) * (e + h) = e * e + e * h + h * e + h * h := by
        noncomm_ring
      _ = e + h := by rw [he', heh, hhe, hhsq]; simp
  let fr : R := r + r * u * (1 - e)
  have hfr : f = x * fr := by
    dsimp only [f, fr]
    rw [her]
    noncomm_ring
  refine ⟨f, fr, v * (1 - e), hfidem, hfr, ?_⟩
  have hcomp : 1 - f = (1 - e * u) * (1 - e) := by
    dsimp only [f]
    have he' : e * e = e := he
    noncomm_ring [he']
  rw [hcomp]
  have hq : 1 - e * u = (1 - x) * v := by
    calc
      1 - e * u = (e * u + (1 - x) * v) - e * u := by rw [hsum]
      _ = (1 - x) * v := by noncomm_ring
  rw [hq]
  simp only [mul_assoc]

/-- Single-sandwich division therefore implies the one-element right exchange
property outright. -/
theorem hasRightExchange_of_singleSandwich [Nontrivial R]
    (hdiv : HasSingleSandwichDivision R) : HasRightExchange R := by
  intro x
  exact rightExchangeAt_of_rightNicholson
    (hasRightNicholsonExchange_of_singleSandwich hdiv x)

/-- The complement of an idempotent is idempotent. -/
theorem one_sub_isIdempotent {e : R} (he : IsIdempotentElem e) :
    IsIdempotentElem (1 - e) := by
  show (1 - e) * (1 - e) = 1 - e
  have he' : e * e = e := he
  noncomm_ring [he']

/-- An idempotent annihilates its complement on the right. -/
theorem mul_one_sub_eq_zero {e : R} (he : IsIdempotentElem e) :
    e * (1 - e) = 0 := by
  have he' : e * e = e := he
  noncomm_ring [he']

/-- An idempotent annihilates its complement on the left. -/
theorem one_sub_mul_eq_zero {e : R} (he : IsIdempotentElem e) :
    (1 - e) * e = 0 := by
  have he' : e * e = e := he
  noncomm_ring [he']

/-- A one-element exchange witness is exactly a two-term orthogonal
right-ideal refinement. -/
theorem exists_two_term_partition_of_rightExchangeAt
    {x y : R} (hxy : x + y = 1) (hx : RightExchangeAt x) :
    ∃ e₀ e₁ r₀ r₁ : R,
      IsIdempotentElem e₀ ∧ IsIdempotentElem e₁ ∧
      e₀ * e₁ = 0 ∧ e₁ * e₀ = 0 ∧
      e₀ = x * r₀ ∧ e₁ = y * r₁ ∧ e₀ + e₁ = 1 := by
  obtain ⟨e, r, s, he, her, hcomp⟩ := hx
  refine ⟨e, 1 - e, r, s, he, one_sub_isIdempotent he,
    mul_one_sub_eq_zero he, one_sub_mul_eq_zero he, her, ?_, ?_⟩
  · rw [hcomp]
    congr 1
    rw [← hxy]
    noncomm_ring
  · noncomm_ring

/-- The finite partition property contains the one-element exchange property.
This direction is elementary and records that the finite predicate above has
the intended strength. -/
theorem hasRightExchange_of_finitePartitions
    (hfin : HasFiniteRightExchangePartitions R) : HasRightExchange R := by
  intro x
  let row : Fin 2 → R := ![x, 1 - x]
  have hsum : (∑ i, row i) = 1 := by
    rw [Fin.sum_univ_two]
    simp [row]
  obtain ⟨e, r, he, _horth, her, hsumE⟩ := hfin 2 row hsum
  refine ⟨e 0, r 0, r 1, he 0, ?_, ?_⟩
  · simpa [row] using her 0
  · have hsum01 : e 0 + e 1 = 1 := by
      simpa [Fin.sum_univ_two] using hsumE
    have hcomp : 1 - e 0 = e 1 := by
      rw [← hsum01]
      noncomm_ring
    rw [hcomp]
    simpa [row] using her 1

end ExchangePrerequisite

namespace BinaryLeavitt

variable (k : Type) [Field k]

/-- The binary Leavitt algebra satisfies Nicholson's constructive
one-element exchange criterion. -/
theorem hasLeftNicholsonExchange :
    ExchangePrerequisite.HasLeftNicholsonExchange (BinaryLeavittAlgebra k) :=
  ExchangePrerequisite.hasLeftNicholsonExchange_of_singleSandwich
    (hasSingleSandwichDivision k)

/-- The binary Leavitt algebra satisfies the one-element right exchange
property, proved constructively from its formalized sandwich division. -/
theorem hasRightExchange :
    ExchangePrerequisite.HasRightExchange (BinaryLeavittAlgebra k) :=
  ExchangePrerequisite.hasRightExchange_of_singleSandwich
    (hasSingleSandwichDivision k)

/-- Every nonzero element of the binary Leavitt algebra has a nonzero full
idempotent in its principal right ideal. -/
theorem exists_full_idempotent_right_multiple
    {x : BinaryLeavittAlgebra k} (hx : x ≠ 0) :
    ∃ e r u v : BinaryLeavittAlgebra k,
      e ≠ 0 ∧ IsIdempotentElem e ∧ e = x * r ∧
      u * v = e ∧ v * u = 1 :=
  ExchangePrerequisite.exists_full_idempotent_right_multiple
    (hasSingleSandwichDivision k) hx

/-- Every finite decomposition of `1` in the binary Leavitt algebra also
admits the weaker refinement in generated two-sided ideals. -/
theorem exists_finite_twoSidedIdeal_partition
    (n : ℕ) (x : Fin n → BinaryLeavittAlgebra k)
    (hsum : (∑ i, x i) = 1) :
    ∃ e l r : Fin n → BinaryLeavittAlgebra k,
      (∀ i, IsIdempotentElem (e i)) ∧
      (∀ i j, i ≠ j → e i * e j = 0) ∧
      (∀ i, e i = l i * x i * r i) ∧
      (∑ i, e i) = 1 :=
  ExchangePrerequisite.exists_finite_twoSidedIdeal_partition
    (hasSingleSandwichDivision k) n x hsum

end BinaryLeavitt

end GroupApproximation
