import GroupApproximation.Leavitt.ProperlyInfiniteUnit
import GroupApproximation.Leavitt.RankTwoNormalGeneration

/-!
# Higher rank inside rank two

`notes/rank-two-descent-note-2026-09-07.md`, §3.

Under a properly infinite unit choose `S₁,…,S_m` and `T₁,…,T_m` with
`TᵢSⱼ = δᵢⱼ` — distinct words of a common length in the `v`'s and the reversed
words in the `w`'s.  Here `m = 4` and the words have length two.  With
`p = ∑ᵢ SᵢTᵢ`,

`j(A) = 1 - p + ∑_{ij} Sᵢ AᵢⱼTⱼ`

is an injective *multiplicative* map `M₄(R) → R`: it is not additive, and the
proof that it is multiplicative and unital uses only `Tᵢ(1-p) = 0`,
`(1-p)Sⱼ = 0` and `TᵢSⱼ = δᵢⱼ`.  Composed with `x ↦ diag(x,1)` it gives a
group homomorphism

`Ψ : EL₄(R) →* EL₂(R)`,  `Ψ(e_ij(r)) = [e₁₂(Sᵢr), e₂₁(Tⱼ)]`,

whose value on a single root already normally generates `EL₂(R)`, by §2 at
`v = S₁`, `w = T₁`, `a = S₂`, `b = T₂`.

**The rank-descent principle.**  `EL₂(R)` is normally generated by an embedded
copy of `EL₄(R)`.  So triviality of every homomorphism out of `EL₄(R)` into a
class of groups gives it for `EL₂(R)`, and the printed rank hypothesis `n ≥ 4`
drops to `n ≥ 2`.

Only `T_iS_j = δ_ij` is used below; the reproducing identity
`Tᵢ j(A) Sⱼ = Aᵢⱼ` is what makes `j` injective, and `Tⱼ Sᵢ = 0` for `i ≠ j` is
what puts each `Ψ(e_ij(r))` in `EL₂(R)`.
-/

namespace GroupApproximation
namespace RankDescent

open scoped commutatorElement

variable {R : Type*} [Ring R]

/-! ## The four length-two words -/

/-- The four length-two words in the two sections. -/
def wordS (Q : ProperlyInfiniteUnit R) : Fin 4 → R :=
  ![Q.v 0 * Q.v 0, Q.v 0 * Q.v 1, Q.v 1 * Q.v 0, Q.v 1 * Q.v 1]

/-- The four reversed length-two words in the two retractions. -/
def wordT (Q : ProperlyInfiniteUnit R) : Fin 4 → R :=
  ![Q.w 0 * Q.w 0, Q.w 1 * Q.w 0, Q.w 0 * Q.w 1, Q.w 1 * Q.w 1]

/-- **The orthogonality of the length-two words**: `TᵢSⱼ = δᵢⱼ`. -/
theorem wordT_mul_wordS (Q : ProperlyInfiniteUnit R) (i j : Fin 4) :
    wordT Q i * wordS Q j = if i = j then 1 else 0 := by
  have h00 : Q.w 0 * Q.v 0 = 1 := Q.w_mul_v_self 0
  have h11 : Q.w 1 * Q.v 1 = 1 := Q.w_mul_v_self 1
  have h01 : Q.w 0 * Q.v 1 = 0 := Q.w_mul_v_of_ne (by decide)
  have h10 : Q.w 1 * Q.v 0 = 0 := Q.w_mul_v_of_ne (by decide)
  have h00' : ∀ x : R, Q.w 0 * (Q.v 0 * x) = x := by
    intro x; rw [← mul_assoc, h00, one_mul]
  have h11' : ∀ x : R, Q.w 1 * (Q.v 1 * x) = x := by
    intro x; rw [← mul_assoc, h11, one_mul]
  have h01' : ∀ x : R, Q.w 0 * (Q.v 1 * x) = 0 := by
    intro x; rw [← mul_assoc, h01, zero_mul]
  have h10' : ∀ x : R, Q.w 1 * (Q.v 0 * x) = 0 := by
    intro x; rw [← mul_assoc, h10, zero_mul]
  fin_cases i <;> fin_cases j <;>
    simp [wordS, wordT, mul_assoc, h00, h11, h01, h10, h00', h11', h01', h10']

/-! ## The multiplicative embedding of the matrix ring -/

section Words

variable (S T : Fin 4 → R)

/-- The idempotent `p = ∑ᵢ SᵢTᵢ`. -/
def pIdem : R := ∑ i, S i * T i

/-- The body of the printed map, `∑_{ij} Sᵢ AᵢⱼTⱼ`. -/
def jBody (A : Matrix (Fin 4) (Fin 4) R) : R := ∑ i, ∑ j, S i * A i j * T j

/-- **The printed multiplicative map** `j(A) = 1 - p + ∑ Sᵢ AᵢⱼTⱼ`. -/
def jMap (A : Matrix (Fin 4) (Fin 4) R) : R := 1 - pIdem S T + jBody S T A

variable (hTS : ∀ i j, T i * S j = if i = j then 1 else 0)

include hTS

/-- `Tⱼ` reproduces the `j`-th row of `A` out of the body. -/
theorem wordT_mul_jBody (j : Fin 4) (A : Matrix (Fin 4) (Fin 4) R) :
    T j * jBody S T A = ∑ l, A j l * T l := by
  rw [jBody, Finset.mul_sum]
  have h : ∀ k, T j * (∑ l, S k * A k l * T l)
      = if j = k then ∑ l, A k l * T l else 0 := by
    intro k
    rw [Finset.mul_sum]
    by_cases hb : j = k
    · rw [if_pos hb]
      refine Finset.sum_congr rfl fun l _ ↦ ?_
      calc T j * (S k * A k l * T l) = T j * S k * (A k l * T l) := by
            noncomm_ring
        _ = A k l * T l := by rw [hTS j k, if_pos hb, one_mul]
    · rw [if_neg hb]
      refine Finset.sum_eq_zero fun l _ ↦ ?_
      calc T j * (S k * A k l * T l) = T j * S k * (A k l * T l) := by
            noncomm_ring
        _ = 0 := by rw [hTS j k, if_neg hb, zero_mul]
  simp [h]

theorem wordT_mul_pIdem (i : Fin 4) : T i * pIdem S T = T i := by
  rw [pIdem, Finset.mul_sum]
  have h : ∀ k, T i * (S k * T k) = if i = k then T k else 0 := by
    intro k
    rw [← mul_assoc, hTS i k]
    by_cases hb : i = k
    · rw [if_pos hb, if_pos hb, one_mul]
    · rw [if_neg hb, if_neg hb, zero_mul]
  simp [h]

theorem pIdem_mul_wordS (j : Fin 4) : pIdem S T * S j = S j := by
  rw [pIdem, Finset.sum_mul]
  have h : ∀ k, S k * T k * S j = if k = j then S k else 0 := by
    intro k
    rw [mul_assoc, hTS k j]
    by_cases hb : k = j
    · rw [if_pos hb, if_pos hb, mul_one]
    · rw [if_neg hb, if_neg hb, mul_zero]
  simp [h]

theorem pIdem_mul_pIdem : pIdem S T * pIdem S T = pIdem S T := by
  have h : ∀ k, S k * T k * pIdem S T = S k * T k := by
    intro k
    calc S k * T k * pIdem S T = S k * (T k * pIdem S T) := by noncomm_ring
      _ = S k * T k := by rw [wordT_mul_pIdem S T hTS k]
  calc pIdem S T * pIdem S T = (∑ i, S i * T i) * pIdem S T := rfl
    _ = ∑ i, S i * T i * pIdem S T := Finset.sum_mul _ _ _
    _ = ∑ i, S i * T i := by simp only [h]
    _ = pIdem S T := rfl

theorem one_sub_pIdem_mul_wordS (j : Fin 4) : (1 - pIdem S T) * S j = 0 := by
  rw [sub_mul, one_mul, pIdem_mul_wordS S T hTS j, sub_self]

theorem wordT_mul_one_sub_pIdem (i : Fin 4) : T i * (1 - pIdem S T) = 0 := by
  rw [mul_sub, mul_one, wordT_mul_pIdem S T hTS i, sub_self]

theorem one_sub_pIdem_mul_jBody (A : Matrix (Fin 4) (Fin 4) R) :
    (1 - pIdem S T) * jBody S T A = 0 := by
  rw [jBody, Finset.mul_sum]
  refine Finset.sum_eq_zero fun i _ ↦ ?_
  rw [Finset.mul_sum]
  refine Finset.sum_eq_zero fun j _ ↦ ?_
  calc (1 - pIdem S T) * (S i * A i j * T j)
      = (1 - pIdem S T) * S i * (A i j * T j) := by noncomm_ring
    _ = 0 := by rw [one_sub_pIdem_mul_wordS S T hTS i, zero_mul]

theorem jBody_mul_one_sub_pIdem (A : Matrix (Fin 4) (Fin 4) R) :
    jBody S T A * (1 - pIdem S T) = 0 := by
  rw [jBody, Finset.sum_mul]
  refine Finset.sum_eq_zero fun i _ ↦ ?_
  rw [Finset.sum_mul]
  refine Finset.sum_eq_zero fun j _ ↦ ?_
  calc S i * A i j * T j * (1 - pIdem S T)
      = S i * A i j * (T j * (1 - pIdem S T)) := by noncomm_ring
    _ = 0 := by rw [wordT_mul_one_sub_pIdem S T hTS j, mul_zero]

theorem jBody_mul_jBody (A B : Matrix (Fin 4) (Fin 4) R) :
    jBody S T A * jBody S T B = jBody S T (A * B) := by
  have hstep : jBody S T A * jBody S T B
      = ∑ i, ∑ j, S i * A i j * (T j * jBody S T B) := by
    rw [jBody]
    simp only [Finset.sum_mul, mul_assoc]
  rw [hstep]
  have hrow : ∀ j, T j * jBody S T B = ∑ l, B j l * T l :=
    fun j ↦ wordT_mul_jBody S T hTS j B
  simp only [hrow]
  rw [jBody]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  calc ∑ j, S i * A i j * (∑ l, B j l * T l)
      = ∑ j, ∑ l, S i * (A i j * B j l) * T l := by
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun l _ ↦ ?_
        noncomm_ring
    _ = ∑ l, ∑ j, S i * (A i j * B j l) * T l := Finset.sum_comm
    _ = ∑ l, S i * (A * B) i l * T l := by
        refine Finset.sum_congr rfl fun l _ ↦ ?_
        rw [Matrix.mul_apply, Finset.mul_sum, Finset.sum_mul]

omit hTS in
theorem jBody_one : jBody S T (1 : Matrix (Fin 4) (Fin 4) R) = pIdem S T := by
  rw [jBody, pIdem]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  have h : ∀ j, S i * (1 : Matrix (Fin 4) (Fin 4) R) i j * T j
      = if i = j then S i * T j else 0 := by
    intro j
    rw [Matrix.one_apply]
    by_cases hb : i = j
    · rw [if_pos hb, if_pos hb, mul_one]
    · rw [if_neg hb, if_neg hb, mul_zero, zero_mul]
  simp [h]

omit hTS in
theorem jBody_add (A B : Matrix (Fin 4) (Fin 4) R) :
    jBody S T (A + B) = jBody S T A + jBody S T B := by
  rw [jBody, jBody, jBody, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Matrix.add_apply]
  noncomm_ring

omit hTS in
theorem jBody_single (i j : Fin 4) (r : R) :
    jBody S T (Matrix.single i j r) = S i * r * T j := by
  rw [jBody]
  have h : ∀ k, (∑ l, S k * Matrix.single i j r k l * T l)
      = if k = i then S i * r * T j else 0 := by
    intro k
    have hterm : ∀ l, S k * Matrix.single i j r k l * T l
        = if i = k ∧ j = l then S i * r * T j else 0 := by
      intro l
      rw [Matrix.single_apply]
      by_cases h1 : i = k ∧ j = l
      · obtain ⟨rfl, rfl⟩ := h1
        simp
      · rw [if_neg h1, if_neg h1, mul_zero, zero_mul]
    simp only [hterm]
    by_cases hk : k = i
    · subst hk
      simp
    · rw [if_neg hk]
      refine Finset.sum_eq_zero fun l _ ↦ ?_
      refine if_neg ?_
      rintro ⟨h1, -⟩
      exact hk h1.symm
  simp [h]

omit hTS in
theorem jMap_one : jMap S T (1 : Matrix (Fin 4) (Fin 4) R) = 1 := by
  rw [jMap, jBody_one S T]
  abel

theorem jMap_mul (A B : Matrix (Fin 4) (Fin 4) R) :
    jMap S T (A * B) = jMap S T A * jMap S T B := by
  have hpp := pIdem_mul_pIdem S T hTS
  have hpX := one_sub_pIdem_mul_jBody S T hTS B
  have hXp := jBody_mul_one_sub_pIdem S T hTS A
  have hXX := jBody_mul_jBody S T hTS A B
  have hone : (1 - pIdem S T) * (1 - pIdem S T) = 1 - pIdem S T := by
    calc (1 - pIdem S T) * (1 - pIdem S T)
        = 1 - pIdem S T - pIdem S T + pIdem S T * pIdem S T := by noncomm_ring
      _ = 1 - pIdem S T := by rw [hpp]; abel
  calc jMap S T (A * B) = 1 - pIdem S T + jBody S T (A * B) := rfl
    _ = (1 - pIdem S T) * (1 - pIdem S T) + (1 - pIdem S T) * jBody S T B
        + jBody S T A * (1 - pIdem S T) + jBody S T A * jBody S T B := by
        rw [hone, hpX, hXp, hXX]
        abel
    _ = jMap S T A * jMap S T B := by rw [jMap, jMap]; noncomm_ring

/-- **The reproducing identity** `Tᵢ j(A) Sⱼ = Aᵢⱼ`; it is what makes `j`
injective. -/
theorem wordT_mul_jMap_mul_wordS (i j : Fin 4)
    (A : Matrix (Fin 4) (Fin 4) R) :
    T i * jMap S T A * S j = A i j := by
  have hrow := wordT_mul_jBody S T hTS i A
  calc T i * jMap S T A * S j
      = T i * (1 - pIdem S T) * S j + T i * jBody S T A * S j := by
        rw [jMap]; noncomm_ring
    _ = 0 * S j + (∑ l, A i l * T l) * S j := by
        rw [wordT_mul_one_sub_pIdem S T hTS i, hrow]
    _ = ∑ l, A i l * (T l * S j) := by
        rw [zero_mul, zero_add, Finset.sum_mul]
        refine Finset.sum_congr rfl fun l _ ↦ ?_
        noncomm_ring
    _ = A i j := by
        have h : ∀ l, A i l * (T l * S j) = if l = j then A i j else 0 := by
          intro l
          rw [hTS l j]
          by_cases hb : l = j
          · subst hb; rw [if_pos rfl, if_pos rfl, mul_one]
          · rw [if_neg hb, if_neg hb, mul_zero]
        simp [h]

theorem jMap_injective : Function.Injective (jMap S T) := by
  intro A B hAB
  ext i j
  rw [← wordT_mul_jMap_mul_wordS S T hTS i j A,
    ← wordT_mul_jMap_mul_wordS S T hTS i j B, hAB]

/-- The printed map as a monoid homomorphism of the multiplicative monoid of
`M₄(R)`.  It is **not** additive. -/
def jHom : Matrix (Fin 4) (Fin 4) R →* R where
  toFun := jMap S T
  map_one' := jMap_one S T
  map_mul' := jMap_mul S T hTS

@[simp] theorem jHom_apply (A : Matrix (Fin 4) (Fin 4) R) :
    jHom S T hTS A = jMap S T A := rfl

omit hTS in
/-- The value of `j` on an elementary matrix. -/
theorem jMap_one_add_single (i j : Fin 4) (r : R) :
    jMap S T (1 + Matrix.single i j r) = 1 + S i * r * T j := by
  rw [jMap, jBody_add S T, jBody_one S T, jBody_single S T]
  abel

end Words

/-! ## The group homomorphism `Ψ : EL₄(R) →* EL₂(R)` -/

/-- `x ↦ diag(x, 1)`, a homomorphism of multiplicative monoids. -/
def blockDiagHom (R : Type*) [Ring R] : R →* Matrix (Fin 2) (Fin 2) R where
  toFun x := 1 + Matrix.single 0 0 (x - 1)
  map_one' := by simp
  map_mul' x y := by
    ext p q
    fin_cases p <;> fin_cases q <;>
      simp [Matrix.mul_apply, Matrix.one_apply, Fin.sum_univ_succ,
        Matrix.single_apply, mul_sub]

section Psi

variable (S T : Fin 4 → R) (hTS : ∀ i j, T i * S j = if i = j then 1 else 0)

include hTS

/-- The underlying map of units, `A ↦ diag(j(A), 1)`. -/
noncomputable def psiUnits : (Matrix (Fin 4) (Fin 4) R)ˣ →* (Matrix (Fin 2) (Fin 2) R)ˣ :=
  Units.map ((blockDiagHom R).comp (jHom S T hTS))

theorem psiUnits_elementaryUnit (i j : Fin 4) (hij : i ≠ j) (r : R) :
    psiUnits S T hTS (elementaryUnit i j hij r)
      = (gen (S i * r) (T j) : (Matrix (Fin 2) (Fin 2) R)ˣ) := by
  have hbv : T j * (S i * r) = 0 := by
    rw [← mul_assoc, hTS j i, if_neg (Ne.symm hij), zero_mul]
  apply Units.ext
  have hj : jMap S T (1 + Matrix.single i j r) = 1 + S i * r * T j :=
    jMap_one_add_single S T i j r
  have hg := gen_val (S i * r) (T j) hbv
  show 1 + Matrix.single (0 : Fin 2) 0
      (jMap S T ((elementaryUnit i j hij r : (Matrix (Fin 4) (Fin 4) R)ˣ) :
        Matrix (Fin 4) (Fin 4) R) - 1) = _
  rw [hg]
  show 1 + Matrix.single (0 : Fin 2) 0
      (jMap S T (1 + Matrix.single i j r) - 1) = _
  rw [hj]
  congr 1
  congr 1
  abel

theorem psiUnits_mem (g : elementaryGroup (Fin 4) R) :
    psiUnits S T hTS (g : (Matrix (Fin 4) (Fin 4) R)ˣ)
      ∈ elementaryGroup (Fin 2) R := by
  obtain ⟨g, hg⟩ := g
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨i, j, hij, r, rfl⟩ := hx
      rw [psiUnits_elementaryUnit S T hTS i j hij r]
      exact (gen (S i * r) (T j)).property
  | one => simp
  | mul x y _ _ hx hy => simpa using (elementaryGroup (Fin 2) R).mul_mem hx hy
  | inv x _ hx => simpa using (elementaryGroup (Fin 2) R).inv_mem hx

/-- **The printed descent homomorphism** `Ψ : EL₄(R) →* EL₂(R)`. -/
noncomputable def psi : elementaryGroup (Fin 4) R →* elementaryGroup (Fin 2) R :=
  ((psiUnits S T hTS).comp (elementaryGroup (Fin 4) R).subtype).codRestrict
    (elementaryGroup (Fin 2) R) (psiUnits_mem S T hTS)

/-- **`Ψ(e_ij(r)) = [e₁₂(Sᵢr), e₂₁(Tⱼ)]`.** -/
theorem psi_elementaryRoot (i j : Fin 4) (hij : i ≠ j) (r : R) :
    psi S T hTS (elementaryRoot i j hij r) = gen (S i * r) (T j) :=
  Subtype.ext (psiUnits_elementaryUnit S T hTS i j hij r)

end Psi

/-! ## The rank-descent principle -/

section Descent

variable (Q : ProperlyInfiniteUnit R)

theorem wordT_mul_wordS' (i j : Fin 4) :
    wordT Q i * wordS Q j = if i = j then 1 else 0 :=
  wordT_mul_wordS Q i j

/-- The descent homomorphism attached to a properly infinite unit. -/
noncomputable def descent :
    elementaryGroup (Fin 4) R →* elementaryGroup (Fin 2) R :=
  psi (wordS Q) (wordT Q) (wordT_mul_wordS Q)

theorem descent_elementaryRoot (i j : Fin 4) (hij : i ≠ j) (r : R) :
    descent Q (elementaryRoot i j hij r)
      = gen (wordS Q i * r) (wordT Q j) :=
  psi_elementaryRoot _ _ _ i j hij r

/-- **The rank-descent principle.**  The image of the single root `e₁₂(1)` of
`EL₄(R)` normally generates `EL₂(R)`.

The four hypotheses of §2 are read off the length-two words:
`T₁S₁ = 1`, `T₂S₂ = 1` and `T₂S₁ = 0`. -/
theorem normalClosure_descent_root_eq_top :
    Subgroup.normalClosure
        ({descent Q (elementaryRoot 0 1 (by decide) 1)} :
          Set (elementaryGroup (Fin 2) R)) = ⊤ := by
  have hval : descent Q (elementaryRoot 0 1 (by decide) 1)
      = gen (wordS Q 0 * 1) (wordT Q 1) :=
    descent_elementaryRoot Q 0 1 (by decide) 1
  have hS0 : wordS Q 0 * 1 = wordS Q 0 := mul_one _
  rw [hval, hS0]
  refine normalClosure_gen_eq_top (wordS Q 0) (wordT Q 0) (wordS Q 1)
    (wordT Q 1) ?_ ?_ ?_
  · simpa using wordT_mul_wordS Q 0 0
  · simpa using wordT_mul_wordS Q 1 1
  · simpa using wordT_mul_wordS Q 1 0

end Descent

end RankDescent
end GroupApproximation
