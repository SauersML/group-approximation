import GroupApproximation.Covers.PresentedEnlargement
import GroupApproximation.Leavitt.ConjProductClosure
import GroupApproximation.Leavitt.HilbertHotelCoverDischarges
import GroupApproximation.Leavitt.HilbertHotelModelNonMF

/-!
# The two-block Hilbert-hotel cover

`HilbertHotelCover` builds a finitely presented Kazhdan group `CoverGroup`
over the *single* alphabet of the Shalom cover `Δ ↠ Model`, and then has to
carry the compression datum `KazhdanCompressionCore Gamma (CoverGroup C)` as a
residual field.  That field is unreachable, for a structural reason rather
than a technical one:

* the Kazhdan source `Gamma = E₄(R)` maps into the *model*, not into the
  cover -- there is no homomorphism `Gamma →* CoverGroup` to be had, since
  `CoverGroup ↠ Model` runs the wrong way;
* and no identity of the model pulls back along that surjection, for exactly
  the reason the one-block file already records about normal closures.

This file applies that file's own philosophy a second time: **impose, do not
pull back**.  The alphabet is widened by a second block of letters, one per
generator of a *second* Shalom cover

`Δ₄ ↠ Gamma`,

and the corner is then present *inside the presentation*, as the subgroup
generated by that block.  The compression datum is carried by `Δ₄`, whose
property `(T)` is Shalom's, and whose map into the cover is the tautological
assignment on the second block.

## The eight imposed families

Write `Letter = Fin generatorCount ⊕ Fin gammaGeneratorCount`, `x_i` for the
first (model) block, `y_j` for the second (corner) block, and `τ̃`, `c̃`, `d̃`
for the first-block transports of the chosen words above the model's stable
letter `τ`, mark `c` and defect `d`.

1. the first-block transport of the relators of `Δ`;
2. the second-block transport of the relators of `Δ₄`;
3. the compression family on the first block, verbatim `compressionRelator`;
4. the compression family on the second block, `τ̃ y_j τ̃⁻¹ = w_j`, where `w_j`
   is a second-block word for a chosen `Δ₄`-preimage of the compressed corner
   element -- the choice is what the model-level compression clause supplies;
5. the mark family `⁅c̃, y_j⁆`;
6. the generator-identification family `y_j = (first-block word for ι(γ_j))`,
   whose point is that it makes the **first block alone generate**, so the
   cover group is a quotient of `Δ` and inherits `(T)` by surjection;
7. the saturation family, verbatim `saturationRelator`, on the first block;
8. one defect-identification relator, tying `⁅τ̃ c̃ τ̃⁻¹, (corner word)⁆` to `d̃`.

Every family vanishes in the model -- that is the design invariant, and it is
what makes the factoring homomorphism `CoverGroup₂ →* Model` exist and the
defect survive into the cover.

## What is proved here

Every *group-level* clause that `Cover.CoverResiduals` had to assume is a
theorem in this file: the factorisation through the model, the compression
datum itself, the saturation of the defect, property `(T)`, nontriviality, and
`⊤ ≤ defectNormal`.

The construction is parameterised by two records, and both are discharged.
`CoverBlockResiduals` collects the four model-level facts -- the two
compression clauses of `Cover.CoverResiduals`, plus the corner generator
`e₁₂(1)` and its defect computation -- and `coverBlockResiduals` builds it
from `HilbertHotelModelNonMF`.  `Cover.CoverInputs`, the word form of model
saturation shared with the one-block file, is built by
`Cover.coverInputs_nonempty` in `ConjProductClosure`.  So `HotelGroup` and
`hotelGroup_endpoint` at the end of the file carry no hypothesis at all.

## Open leaves

None.
-/

namespace GroupApproximation
namespace HilbertHotel
namespace CoverBlock

open scoped commutatorElement
open Cover

/-! ## The second Shalom cover, of the Kazhdan corner -/

/-- A finitely presented Kazhdan cover of the rank-four corner `Gamma`,
packaged as data so that the choice is made once.  This mirrors
`Cover.CoverData`, one level down. -/
structure GammaCoverData where
  /-- The number of generators of the corner cover. -/
  m : ℕ
  /-- The finite relator set. -/
  rels : Finset (FreeGroup (Fin m))
  /-- The covering map onto the corner. -/
  quotient :
    PresentedGroup ((rels : Finset (FreeGroup (Fin m))) :
      Set (FreeGroup (Fin m))) →* Gamma
  /-- The covering map is onto. -/
  quotient_surjective : Function.Surjective quotient
  /-- The corner cover is Kazhdan. -/
  kazhdan : HasKazhdanPropertyT.{0, 1}
    (PresentedGroup ((rels : Finset (FreeGroup (Fin m))) :
      Set (FreeGroup (Fin m))))

/-- Shalom's presentation theorem, applied to the corner. -/
theorem gammaCoverData_nonempty : Nonempty GammaCoverData := by
  obtain ⟨S, -, -, hS⟩ :=
    KazhdanFiniteGeneration.exists_symmetric_generating_finset Gamma
      gamma_hasKazhdanPropertyT
  obtain ⟨m, rels, φ, hsurj, hT⟩ :=
    Shalom.exists_presented_kazhdan_cover S hS gamma_hasKazhdanPropertyT
  exact ⟨⟨m, rels, φ, hsurj, hT⟩⟩

/-- The chosen corner cover. -/
noncomputable def gammaCoverData : GammaCoverData :=
  Classical.choice gammaCoverData_nonempty

/-- The generator count of the chosen corner cover. -/
noncomputable abbrev gammaGeneratorCount : ℕ := gammaCoverData.m

/-- The relators of the chosen corner cover. -/
noncomputable abbrev gammaRelators :
    Finset (FreeGroup (Fin gammaGeneratorCount)) := gammaCoverData.rels

/-- The corner cover `Δ₄`. -/
noncomputable abbrev Delta4 : Type :=
  PresentedGroup ((gammaRelators : Finset (FreeGroup (Fin gammaGeneratorCount))) :
    Set (FreeGroup (Fin gammaGeneratorCount)))

/-- The covering map `Δ₄ ↠ Gamma`. -/
noncomputable abbrev gammaQuotient : Delta4 →* Gamma := gammaCoverData.quotient

theorem gammaQuotient_surjective : Function.Surjective gammaQuotient :=
  gammaCoverData.quotient_surjective

theorem delta4_hasKazhdanPropertyT : HasKazhdanPropertyT.{0, 0} Delta4 :=
  HasKazhdanPropertyT.of_max.{0, 1, 0} gammaCoverData.kazhdan

instance delta4_finitelyPresented : Group.IsFinitelyPresented Delta4 :=
  inferInstance

/-! ## Words above the corner -/

/-- The composite from free words to the corner. -/
noncomputable def freeToGamma : FreeGroup (Fin gammaGeneratorCount) →* Gamma :=
  gammaQuotient.comp (PresentedGroup.mk _)

theorem freeToGamma_surjective : Function.Surjective freeToGamma :=
  gammaQuotient_surjective.comp (PresentedGroup.mk_surjective _)

/-- A chosen word representing a corner element. -/
noncomputable def liftGammaWord (g : Gamma) :
    FreeGroup (Fin gammaGeneratorCount) :=
  Function.surjInv freeToGamma_surjective g

@[simp] theorem freeToGamma_liftGammaWord (g : Gamma) :
    freeToGamma (liftGammaWord g) = g :=
  Function.surjInv_eq freeToGamma_surjective g

/-- The chosen generators of the corner: the images of the generators of the
corner cover. -/
noncomputable def gammaGen (j : Fin gammaGeneratorCount) : Gamma :=
  gammaQuotient (PresentedGroup.of j)

theorem freeToGamma_of (j : Fin gammaGeneratorCount) :
    freeToGamma (FreeGroup.of j) = gammaGen j := rfl

/-! ## The widened alphabet -/

/-- The alphabet of the two-block presentation: one letter per generator of
the model cover `Δ`, and one per generator of the corner cover `Δ₄`. -/
noncomputable abbrev Letter : Type :=
  Fin generatorCount ⊕ Fin gammaGeneratorCount

/-- A first-block (model) letter. -/
noncomputable abbrev modelLetter (i : Fin generatorCount) : FreeGroup Letter :=
  FreeGroup.of (Sum.inl i)

/-- A second-block (corner) letter. -/
noncomputable abbrev cornerLetter (j : Fin gammaGeneratorCount) :
    FreeGroup Letter := FreeGroup.of (Sum.inr j)

/-- Transport a word in the model-cover generators into the wide alphabet. -/
noncomputable def embedModelWord :
    FreeGroup (Fin generatorCount) →* FreeGroup Letter :=
  FreeGroup.lift fun i ↦ FreeGroup.of (Sum.inl i : Letter)

/-- Transport a word in the corner-cover generators into the wide alphabet. -/
noncomputable def embedCornerWord :
    FreeGroup (Fin gammaGeneratorCount) →* FreeGroup Letter :=
  FreeGroup.lift fun j ↦ FreeGroup.of (Sum.inr j : Letter)

@[simp] theorem embedModelWord_of (i : Fin generatorCount) :
    embedModelWord (FreeGroup.of i) = modelLetter i :=
  FreeGroup.lift_apply_of

@[simp] theorem embedCornerWord_of (j : Fin gammaGeneratorCount) :
    embedCornerWord (FreeGroup.of j) = cornerLetter j :=
  FreeGroup.lift_apply_of

/-! ## Evaluation of the wide alphabet in the model

The first block evaluates exactly as in the one-block file; the second block
evaluates through the corner embedding.  This is the map that certifies the
imposed relators. -/

/-- The evaluation of the wide alphabet in the model. -/
noncomputable def letterToModel : Letter → Model :=
  Sum.elim (fun i ↦ freeToModel (FreeGroup.of i)) fun j ↦ iota (gammaGen j)

/-- Free evaluation of wide words in the model. -/
noncomputable def freeToModel₂ : FreeGroup Letter →* Model :=
  FreeGroup.lift letterToModel

@[simp] theorem freeToModel₂_modelLetter (i : Fin generatorCount) :
    freeToModel₂ (modelLetter i) = freeToModel (FreeGroup.of i) :=
  FreeGroup.lift_apply_of

@[simp] theorem freeToModel₂_cornerLetter (j : Fin gammaGeneratorCount) :
    freeToModel₂ (cornerLetter j) = iota (gammaGen j) :=
  FreeGroup.lift_apply_of

theorem freeToModel₂_embedModelWord (w : FreeGroup (Fin generatorCount)) :
    freeToModel₂ (embedModelWord w) = freeToModel w := by
  change (freeToModel₂.comp embedModelWord) w = freeToModel w
  apply freeGroup_hom_eq_on
  intro i
  change freeToModel₂ (embedModelWord (FreeGroup.of i)) =
    freeToModel (FreeGroup.of i)
  rw [embedModelWord_of, freeToModel₂_modelLetter]

theorem freeToModel₂_embedCornerWord (w : FreeGroup (Fin gammaGeneratorCount)) :
    freeToModel₂ (embedCornerWord w) = iota (freeToGamma w) := by
  change (freeToModel₂.comp embedCornerWord) w = (iota.comp freeToGamma) w
  apply freeGroup_hom_eq_on
  intro j
  change freeToModel₂ (embedCornerWord (FreeGroup.of j)) =
    iota (freeToGamma (FreeGroup.of j))
  rw [embedCornerWord_of, freeToModel₂_cornerLetter, freeToGamma_of]

/-! ## The transported distinguished words -/

/-- The stable letter, as a wide word. -/
noncomputable def tauWord : FreeGroup Letter := embedModelWord (liftWord tauModel)

/-- The mark, as a wide word. -/
noncomputable def markWord : FreeGroup Letter :=
  embedModelWord (liftWord markModel)

/-- The defect, as a wide word. -/
noncomputable def defectBlockWord : FreeGroup Letter :=
  embedModelWord defectWord

@[simp] theorem freeToModel₂_tauWord : freeToModel₂ tauWord = tauModel := by
  rw [tauWord, freeToModel₂_embedModelWord, freeToModel_liftWord]

@[simp] theorem freeToModel₂_markWord : freeToModel₂ markWord = markModel := by
  rw [markWord, freeToModel₂_embedModelWord, freeToModel_liftWord]

@[simp] theorem freeToModel₂_defectBlockWord :
    freeToModel₂ defectBlockWord = defectModel := by
  rw [defectBlockWord, freeToModel₂_embedModelWord]
  exact freeToModel_liftWord defectModel

/-! ## The residual model facts

Exactly four statements, all about the model `E₁₆(R)` and the corner
embedding.  They are the two compression clauses of `Cover.CoverResiduals`
together with the defect computation of the block layer, grouped so that every
theorem below takes a single argument.  `coverBlockResiduals`, at the end of
the file, discharges all four. -/

/-- The model-level inputs of the two-block construction, all discharged by
`coverBlockResiduals`. -/
structure CoverBlockResiduals where
  /-- Conjugation by the stable letter carries the corner image into itself.
  Discharged by `Cover.tau_compresses`, whose witness is
  `LeavittFamily.elementaryCompressionEnd` and whose engine is
  `Tunit_conj_cornerUnits`.  The clause is deliberately *existential*: the
  coefficient map of that conjugation is `matrixCompression a = q + s₀ a t₀`,
  not `a ↦ s₀ a t₀`, and nothing below ever names it -- the compressed element
  is reached only through `alphaGamma`, a choice from this field. -/
  tau_compresses : ∀ γ : Gamma, ∃ δ : Gamma,
    tauModel * iota γ * tauModel⁻¹ = iota δ
  /-- The mark centralises the corner image.  Discharged by
  `Cover.mark_commutes`, which is `cornerUnits_commute_mark` read through
  `elementaryRoot_val` and `cornerEmbedding_apply`. -/
  mark_commutes : ∀ γ : Gamma, Commute markModel (iota γ)
  /-- The corner element against which the moved mark is commuted: the corner
  generator `e₁₂(1)`, discharged by `Cover.cornerGenerator`. -/
  witness : Gamma
  /-- The defect computation: commuting the moved mark against the witness
  produces the defect.  Discharged by
  `Cover.transported_commutator_eq_defect`, which is
  `HilbertHotelSaturation.defect_from_conjugated_mark` transported through
  `cornerEmbedding` into the subtype `Model`. -/
  defect_from_mark :
    ⁅tauModel * markModel * tauModel⁻¹, iota witness⁆ = defectModel

/-- The chosen compressed corner element. -/
noncomputable def alphaGamma (B : CoverBlockResiduals) (γ : Gamma) : Gamma :=
  Classical.choose (B.tau_compresses γ)

theorem alphaGamma_spec (B : CoverBlockResiduals) (γ : Gamma) :
    tauModel * iota γ * tauModel⁻¹ = iota (alphaGamma B γ) :=
  Classical.choose_spec (B.tau_compresses γ)

/-! ## The eight relator families -/

/-- Family 1: the transported relators of the model cover `Δ`. -/
noncomputable def transportedCoverRelators : Finset (FreeGroup Letter) :=
  coverRelators.image embedModelWord

/-- Family 2: the transported relators of the corner cover `Δ₄`. -/
noncomputable def transportedGammaRelators : Finset (FreeGroup Letter) :=
  gammaRelators.image embedCornerWord

/-- Family 3: the compression family on the first block. -/
noncomputable def modelCompressionRelators : Finset (FreeGroup Letter) :=
  Finset.univ.image fun i ↦ embedModelWord (compressionRelator i)

/-- Family 4: the compression relator for the `j`th corner letter.  The
right-hand word is a second-block word for a chosen `Δ₄`-preimage of the
compressed corner element. -/
noncomputable def cornerCompressionRelator (B : CoverBlockResiduals)
    (j : Fin gammaGeneratorCount) : FreeGroup Letter :=
  tauWord * cornerLetter j * tauWord⁻¹ *
    (embedCornerWord (liftGammaWord (alphaGamma B (gammaGen j))))⁻¹

/-- Family 4, as a finite set. -/
noncomputable def cornerCompressionRelators (B : CoverBlockResiduals) :
    Finset (FreeGroup Letter) :=
  Finset.univ.image (cornerCompressionRelator B)

/-- Family 5: the mark commutes with the `j`th corner letter. -/
noncomputable def cornerMarkRelator (j : Fin gammaGeneratorCount) :
    FreeGroup Letter := ⁅markWord, cornerLetter j⁆

/-- Family 5, as a finite set. -/
noncomputable def cornerMarkRelators : Finset (FreeGroup Letter) :=
  Finset.univ.image cornerMarkRelator

/-- Family 6: the `j`th corner letter is identified with a first-block word.
This is what makes the first block generate the whole cover group. -/
noncomputable def cornerGeneratorRelator (j : Fin gammaGeneratorCount) :
    FreeGroup Letter :=
  cornerLetter j * (embedModelWord (liftWord (iota (gammaGen j))))⁻¹

/-- Family 6, as a finite set. -/
noncomputable def cornerGeneratorRelators : Finset (FreeGroup Letter) :=
  Finset.univ.image cornerGeneratorRelator

/-- Family 7: the saturation family, on the first block. -/
noncomputable def transportedSaturationRelators (C : CoverInputs) :
    Finset (FreeGroup Letter) :=
  Finset.univ.image fun i ↦ embedModelWord (saturationRelator C i)

/-- Family 8: the single defect-identification relator. -/
noncomputable def defectIdentificationRelator (B : CoverBlockResiduals) :
    FreeGroup Letter :=
  ⁅tauWord * markWord * tauWord⁻¹,
    embedCornerWord (liftGammaWord B.witness)⁆ * defectBlockWord⁻¹

/-- All imposed relators of the two-block presentation. -/
noncomputable def blockRelators (C : CoverInputs) (B : CoverBlockResiduals) :
    Finset (FreeGroup Letter) :=
  transportedCoverRelators ∪ transportedGammaRelators ∪
    modelCompressionRelators ∪ cornerCompressionRelators B ∪
    cornerMarkRelators ∪ cornerGeneratorRelators ∪
    transportedSaturationRelators C ∪ {defectIdentificationRelator B}

/-! ### Membership of each family -/

theorem mem_blockRelators_cover (C : CoverInputs) (B : CoverBlockResiduals)
    {r : FreeGroup (Fin generatorCount)} (hr : r ∈ coverRelators) :
    embedModelWord r ∈ blockRelators C B :=
  Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_union_left _ (Finset.mem_image.mpr ⟨r, hr, rfl⟩)))))))

theorem mem_blockRelators_gamma (C : CoverInputs) (B : CoverBlockResiduals)
    {r : FreeGroup (Fin gammaGeneratorCount)} (hr : r ∈ gammaRelators) :
    embedCornerWord r ∈ blockRelators C B :=
  Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_union_right _ (Finset.mem_image.mpr ⟨r, hr, rfl⟩)))))))

theorem mem_blockRelators_modelCompression (C : CoverInputs)
    (B : CoverBlockResiduals) (i : Fin generatorCount) :
    embedModelWord (compressionRelator i) ∈ blockRelators C B :=
  Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_union_left _
      (Finset.mem_union_right _
        (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩))))))

theorem mem_blockRelators_cornerCompression (C : CoverInputs)
    (B : CoverBlockResiduals) (j : Fin gammaGeneratorCount) :
    cornerCompressionRelator B j ∈ blockRelators C B :=
  Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_left _ (Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨j, Finset.mem_univ j, rfl⟩)))))

theorem mem_blockRelators_cornerMark (C : CoverInputs)
    (B : CoverBlockResiduals) (j : Fin gammaGeneratorCount) :
    cornerMarkRelator j ∈ blockRelators C B :=
  Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨j, Finset.mem_univ j, rfl⟩))))

theorem mem_blockRelators_cornerGenerator (C : CoverInputs)
    (B : CoverBlockResiduals) (j : Fin gammaGeneratorCount) :
    cornerGeneratorRelator j ∈ blockRelators C B :=
  Finset.mem_union_left _ (Finset.mem_union_left _
    (Finset.mem_union_right _
      (Finset.mem_image.mpr ⟨j, Finset.mem_univ j, rfl⟩)))

theorem mem_blockRelators_saturation (C : CoverInputs)
    (B : CoverBlockResiduals) (i : Fin generatorCount) :
    embedModelWord (saturationRelator C i) ∈ blockRelators C B :=
  Finset.mem_union_left _ (Finset.mem_union_right _
    (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩))

theorem mem_blockRelators_defectIdentification (C : CoverInputs)
    (B : CoverBlockResiduals) :
    defectIdentificationRelator B ∈ blockRelators C B :=
  Finset.mem_union_right _ (Finset.mem_singleton_self _)

/-! ## The two-block cover group -/

/-- The two-block Hilbert-hotel cover group. -/
noncomputable abbrev CoverGroup₂ (C : CoverInputs) (B : CoverBlockResiduals) :
    Type :=
  PresentedGroup ((blockRelators C B : Finset (FreeGroup Letter)) :
    Set (FreeGroup Letter))

instance coverGroup₂_finitelyPresented (C : CoverInputs)
    (B : CoverBlockResiduals) : Group.IsFinitelyPresented (CoverGroup₂ C B) :=
  inferInstance

instance coverGroup₂_countable (C : CoverInputs) (B : CoverBlockResiduals) :
    Countable (CoverGroup₂ C B) :=
  Quotient.mk''_surjective.countable

/-- The word map into the two-block cover group. -/
noncomputable abbrev wordInCoverGroup₂ (C : CoverInputs)
    (B : CoverBlockResiduals) : FreeGroup Letter →* CoverGroup₂ C B :=
  PresentedGroup.mk _

theorem of_inl_eq (C : CoverInputs) (B : CoverBlockResiduals)
    (i : Fin generatorCount) :
    (PresentedGroup.of (Sum.inl i) : CoverGroup₂ C B) =
      wordInCoverGroup₂ C B (modelLetter i) := rfl

theorem of_inr_eq (C : CoverInputs) (B : CoverBlockResiduals)
    (j : Fin gammaGeneratorCount) :
    (PresentedGroup.of (Sum.inr j) : CoverGroup₂ C B) =
      wordInCoverGroup₂ C B (cornerLetter j) := rfl

/-- The stable letter, in the two-block cover group. -/
noncomputable abbrev blockTau (C : CoverInputs) (B : CoverBlockResiduals) :
    CoverGroup₂ C B := wordInCoverGroup₂ C B tauWord

/-- The mark, in the two-block cover group. -/
noncomputable abbrev blockMark (C : CoverInputs) (B : CoverBlockResiduals) :
    CoverGroup₂ C B := wordInCoverGroup₂ C B markWord

/-- The defect, in the two-block cover group. -/
noncomputable abbrev blockDefect (C : CoverInputs) (B : CoverBlockResiduals) :
    CoverGroup₂ C B := wordInCoverGroup₂ C B defectBlockWord

/-! ## The corner map

The second block is tautologically a copy of the corner cover: family 2 makes
the assignment `y_j ↦ (the jth corner letter)` well defined on `Δ₄`.  This is
the homomorphism into the cover that the one-block file could not have. -/

/-- Family 2 makes the second-block assignment kill every relator of the
corner cover. -/
theorem cornerBlock_kills_gammaRelators (C : CoverInputs)
    (B : CoverBlockResiduals) :
    ∀ r ∈ ((gammaRelators : Finset (FreeGroup (Fin gammaGeneratorCount))) :
      Set (FreeGroup (Fin gammaGeneratorCount))),
      ((wordInCoverGroup₂ C B).comp embedCornerWord) r = 1 := fun _ hr ↦
  PresentedGroup.one_of_mem
    (Finset.mem_coe.mpr (mem_blockRelators_gamma C B (Finset.mem_coe.mp hr)))

/-- The corner cover maps into the two-block cover group. -/
noncomputable def iotaCover (C : CoverInputs) (B : CoverBlockResiduals) :
    Delta4 →* CoverGroup₂ C B :=
  PresentedEnlargement.factor ((wordInCoverGroup₂ C B).comp embedCornerWord)
    (cornerBlock_kills_gammaRelators C B)

theorem iotaCover_mk (C : CoverInputs) (B : CoverBlockResiduals)
    (w : FreeGroup (Fin gammaGeneratorCount)) :
    iotaCover C B (PresentedGroup.mk _ w) =
      wordInCoverGroup₂ C B (embedCornerWord w) :=
  PresentedEnlargement.factor_mk
    ((wordInCoverGroup₂ C B).comp embedCornerWord)
    (cornerBlock_kills_gammaRelators C B) w

theorem iotaCover_of (C : CoverInputs) (B : CoverBlockResiduals)
    (j : Fin gammaGeneratorCount) :
    iotaCover C B (PresentedGroup.of j) =
      wordInCoverGroup₂ C B (cornerLetter j) := by
  have h := iotaCover_mk C B (FreeGroup.of j)
  rw [embedCornerWord_of] at h
  exact h

/-! ## The compression datum carried by the corner cover -/

/-- Family 4 at a generator: conjugation by the stable letter moves the `j`th
corner generator to the image of a named element of `Δ₄`. -/
theorem cornerCompression_at_generator (C : CoverInputs)
    (B : CoverBlockResiduals) (j : Fin gammaGeneratorCount) :
    blockTau C B * iotaCover C B (PresentedGroup.of j) * (blockTau C B)⁻¹ =
      iotaCover C B
        (PresentedGroup.mk _ (liftGammaWord (alphaGamma B (gammaGen j)))) := by
  rw [iotaCover_of, iotaCover_mk]
  have hrel : wordInCoverGroup₂ C B (cornerCompressionRelator B j) = 1 :=
    PresentedGroup.one_of_mem
      (Finset.mem_coe.mpr (mem_blockRelators_cornerCompression C B j))
  rw [cornerCompressionRelator] at hrel
  simp only [map_mul, map_inv] at hrel
  exact mul_inv_eq_one.mp hrel

/-- Family 5 at a generator: the mark commutes with the `j`th corner
generator. -/
theorem cornerMark_at_generator (C : CoverInputs) (B : CoverBlockResiduals)
    (j : Fin gammaGeneratorCount) :
    Commute (blockMark C B) (iotaCover C B (PresentedGroup.of j)) := by
  rw [iotaCover_of]
  have hrel : wordInCoverGroup₂ C B (cornerMarkRelator j) = 1 :=
    PresentedGroup.one_of_mem
      (Finset.mem_coe.mpr (mem_blockRelators_cornerMark C B j))
  rw [cornerMarkRelator] at hrel
  simp only [map_commutatorElement] at hrel
  exact commutatorElement_eq_one_iff_commute.mp hrel

/-- The elements of the corner cover whose image is compressed back into the
corner image.  It is a subgroup because `iotaCover` is a homomorphism, which
is why imposing family 4 on generators suffices. -/
noncomputable def compressibleSubgroup (C : CoverInputs)
    (B : CoverBlockResiduals) : Subgroup Delta4 where
  carrier := {x : Delta4 | ∃ δ : Delta4,
    blockTau C B * iotaCover C B x * (blockTau C B)⁻¹ = iotaCover C B δ}
  one_mem' := by
    refine ⟨1, ?_⟩
    rw [map_one (iotaCover C B)]
    group
  mul_mem' := by
    intro a b ha hb
    obtain ⟨da, hda⟩ := ha
    obtain ⟨db, hdb⟩ := hb
    refine ⟨da * db, ?_⟩
    rw [map_mul (iotaCover C B) a b, map_mul (iotaCover C B) da db, ← hda,
      ← hdb]
    group
  inv_mem' := by
    intro a ha
    obtain ⟨da, hda⟩ := ha
    refine ⟨da⁻¹, ?_⟩
    rw [map_inv (iotaCover C B) a, map_inv (iotaCover C B) da, ← hda]
    group

theorem mem_compressibleSubgroup (C : CoverInputs) (B : CoverBlockResiduals)
    (x : Delta4) : x ∈ compressibleSubgroup C B := by
  refine PresentedGroup.generated_by _ _ ?_ x
  intro j
  exact ⟨PresentedGroup.mk _ (liftGammaWord (alphaGamma B (gammaGen j))),
    cornerCompression_at_generator C B j⟩

/-- **The compression clause.**  Conjugation by the stable letter carries the
whole corner-cover image back into itself. -/
theorem coverCompresses (C : CoverInputs) (B : CoverBlockResiduals)
    (x : Delta4) :
    ∃ δ : Delta4,
      blockTau C B * iotaCover C B x * (blockTau C B)⁻¹ = iotaCover C B δ :=
  mem_compressibleSubgroup C B x

/-- The elements of the corner cover whose image commutes with the mark. -/
noncomputable def markCentralizer (C : CoverInputs) (B : CoverBlockResiduals) :
    Subgroup Delta4 where
  carrier := {x : Delta4 | Commute (blockMark C B) (iotaCover C B x)}
  one_mem' := by
    have h : Commute (blockMark C B) (iotaCover C B (1 : Delta4)) := by
      rw [map_one (iotaCover C B)]
      exact Commute.one_right _
    exact h
  mul_mem' := by
    intro a b ha hb
    have ha' : Commute (blockMark C B) (iotaCover C B a) := ha
    have hb' : Commute (blockMark C B) (iotaCover C B b) := hb
    have h : Commute (blockMark C B) (iotaCover C B (a * b)) := by
      rw [map_mul (iotaCover C B) a b]
      exact ha'.mul_right hb'
    exact h
  inv_mem' := by
    intro a ha
    have ha' : Commute (blockMark C B) (iotaCover C B a) := ha
    have h : Commute (blockMark C B) (iotaCover C B a⁻¹) := by
      rw [map_inv (iotaCover C B) a]
      exact ha'.inv_right
    exact h

theorem mem_markCentralizer (C : CoverInputs) (B : CoverBlockResiduals)
    (x : Delta4) : x ∈ markCentralizer C B := by
  refine PresentedGroup.generated_by _ _ ?_ x
  intro j
  exact cornerMark_at_generator C B j

/-- **The centralisation clause.**  The mark commutes with the whole
corner-cover image. -/
theorem coverCommMark (C : CoverInputs) (B : CoverBlockResiduals)
    (x : Delta4) : Commute (blockMark C B) (iotaCover C B x) :=
  mem_markCentralizer C B x

/-- **The compression datum**, carried by the two-block cover group with the
corner cover as its Kazhdan source.  This is the clause the one-block file had
to assume. -/
noncomputable def coverCore (C : CoverInputs) (B : CoverBlockResiduals) :
    KazhdanCompressionCore Delta4 (CoverGroup₂ C B) where
  iota := iotaCover C B
  t := blockTau C B
  c := blockMark C B
  kazhdan := delta4_hasKazhdanPropertyT
  compresses := coverCompresses C B
  comm_c := coverCommMark C B

theorem coverCore_transported (C : CoverInputs) (B : CoverBlockResiduals) :
    (coverCore C B).transported =
      wordInCoverGroup₂ C B tauWord * wordInCoverGroup₂ C B markWord *
        (wordInCoverGroup₂ C B tauWord)⁻¹ := rfl

/-! ## The defect is identified, and it saturates -/

/-- The normal closure of the identified defect. -/
noncomputable abbrev defectClosure (C : CoverInputs)
    (B : CoverBlockResiduals) : Subgroup (CoverGroup₂ C B) :=
  Subgroup.normalClosure ({blockDefect C B} : Set (CoverGroup₂ C B))

/-- Family 8: the defect of the presentation is a pointwise compression
defect of the datum. -/
theorem blockDefect_eq_commutator (C : CoverInputs) (B : CoverBlockResiduals) :
    blockDefect C B =
      ⁅(coverCore C B).transported,
        iotaCover C B (PresentedGroup.mk _ (liftGammaWord B.witness))⁆ := by
  have hrel : wordInCoverGroup₂ C B (defectIdentificationRelator B) = 1 :=
    PresentedGroup.one_of_mem
      (Finset.mem_coe.mpr (mem_blockRelators_defectIdentification C B))
  rw [defectIdentificationRelator] at hrel
  simp only [map_mul, map_inv, map_commutatorElement] at hrel
  rw [iotaCover_mk, coverCore_transported]
  exact (mul_inv_eq_one.mp hrel).symm

theorem blockDefect_mem_defectNormal (C : CoverInputs)
    (B : CoverBlockResiduals) :
    blockDefect C B ∈ (coverCore C B).defectNormal := by
  rw [blockDefect_eq_commutator]
  exact (coverCore C B).defect_mem_defectNormal
    (PresentedGroup.mk _ (liftGammaWord B.witness))

theorem defectClosure_le_defectNormal (C : CoverInputs)
    (B : CoverBlockResiduals) :
    defectClosure C B ≤ (coverCore C B).defectNormal :=
  Subgroup.normalClosure_le_normal
    (Set.singleton_subset_iff.mpr (blockDefect_mem_defectNormal C B))

/-- A formal product of conjugates of the defect word, transported into the
wide alphabet, lands in the normal closure of the identified defect.  This is
the generic `ConjWord` membership lemma at the composite
`wordInCoverGroup₂ ∘ embedModelWord`; `conjProduct` and `ConjWord.conjWord` at
`defectWord` have the same body, and that composite sends `defectWord` to
`blockDefect`. -/
theorem conjProduct_mem_defectClosure (C : CoverInputs)
    (B : CoverBlockResiduals)
    (l : List (FreeGroup (Fin generatorCount) × Bool)) :
    wordInCoverGroup₂ C B (embedModelWord (conjProduct l)) ∈
      defectClosure C B :=
  ConjWord.map_conjWord_mem_normalClosure
    ((wordInCoverGroup₂ C B).comp embedModelWord) defectWord l

/-- Family 7: every first-block word lies in the normal closure of the
identified defect.  The generators are handled by the imposed saturation
relators, and the rest is closure under the group operations. -/
theorem mem_defectClosure_of_embedModelWord (C : CoverInputs)
    (B : CoverBlockResiduals) (w : FreeGroup (Fin generatorCount)) :
    wordInCoverGroup₂ C B (embedModelWord w) ∈ defectClosure C B := by
  induction w using FreeGroup.induction_on with
  | C1 =>
      simp only [map_one]
      exact (defectClosure C B).one_mem
  | of i =>
      have hrel : wordInCoverGroup₂ C B
          (embedModelWord (saturationRelator C i)) = 1 :=
        PresentedGroup.one_of_mem
          (Finset.mem_coe.mpr (mem_blockRelators_saturation C B i))
      rw [saturationRelator] at hrel
      simp only [map_mul, map_inv] at hrel
      rw [mul_inv_eq_one.mp hrel]
      exact conjProduct_mem_defectClosure C B
        (Classical.choose (C.exists_conjProduct (freeToModel (FreeGroup.of i))))
  | inv_of i hi =>
      simp only [map_inv]
      exact (defectClosure C B).inv_mem hi
  | mul a b ha hb =>
      simp only [map_mul]
      exact (defectClosure C B).mul_mem ha hb

/-- Family 6: each corner letter is a first-block word. -/
theorem cornerLetter_eq_modelWord (C : CoverInputs) (B : CoverBlockResiduals)
    (j : Fin gammaGeneratorCount) :
    wordInCoverGroup₂ C B (cornerLetter j) =
      wordInCoverGroup₂ C B
        (embedModelWord (liftWord (iota (gammaGen j)))) := by
  have hrel : wordInCoverGroup₂ C B (cornerGeneratorRelator j) = 1 :=
    PresentedGroup.one_of_mem
      (Finset.mem_coe.mpr (mem_blockRelators_cornerGenerator C B j))
  rw [cornerGeneratorRelator] at hrel
  simp only [map_mul, map_inv] at hrel
  exact mul_inv_eq_one.mp hrel

/-- **Saturation in the two-block cover group.**  Every element lies in the
normal closure of the identified defect.  This is a statement about the cover,
imposed by families 6 and 7, and *not* inherited from the model. -/
theorem mem_defectClosure (C : CoverInputs) (B : CoverBlockResiduals)
    (x : CoverGroup₂ C B) : x ∈ defectClosure C B := by
  refine PresentedGroup.generated_by _ _ ?_ x
  rintro (i | j)
  · rw [of_inl_eq]
    have h := mem_defectClosure_of_embedModelWord C B (FreeGroup.of i)
    rw [embedModelWord_of] at h
    exact h
  · rw [of_inr_eq, cornerLetter_eq_modelWord]
    exact mem_defectClosure_of_embedModelWord C B _

theorem defectClosure_eq_top (C : CoverInputs) (B : CoverBlockResiduals) :
    Subgroup.normalClosure ({blockDefect C B} : Set (CoverGroup₂ C B)) = ⊤ :=
  (Subgroup.eq_top_iff' _).mpr (mem_defectClosure C B)

/-- **The defect is everything.**  This is the hypothesis the normal-Kazhdan
criterion consumes at `K = ⊤`. -/
theorem top_le_defectNormal (C : CoverInputs) (B : CoverBlockResiduals) :
    (⊤ : Subgroup (CoverGroup₂ C B)) ≤ (coverCore C B).defectNormal := by
  rw [← defectClosure_eq_top C B]
  exact defectClosure_le_defectNormal C B

/-! ## The factorisation through the model, and nontriviality

Every imposed relator dies in the model.  Families 1, 2, 3, 6 and 7 are
formal; families 4, 5 and 8 are exactly the residual model facts.  The
resulting homomorphism sends the identified defect to `defectModel`, which the
block layer proves nontrivial. -/

theorem freeToModel_compressionRelator (i : Fin generatorCount) :
    freeToModel (compressionRelator i) = 1 := by
  simp only [compressionRelator, map_mul, map_inv, freeToModel_liftWord,
    alphaModel]
  group

theorem freeToModel_saturationRelator (C : CoverInputs)
    (i : Fin generatorCount) : freeToModel (saturationRelator C i) = 1 := by
  simp only [saturationRelator, map_mul, map_inv, freeToModel_defectExpansion]
  group

theorem freeToModel₂_cornerCompressionRelator (B : CoverBlockResiduals)
    (j : Fin gammaGeneratorCount) :
    freeToModel₂ (cornerCompressionRelator B j) = 1 := by
  simp only [cornerCompressionRelator, map_mul, map_inv, freeToModel₂_tauWord,
    freeToModel₂_cornerLetter, freeToModel₂_embedCornerWord,
    freeToGamma_liftGammaWord]
  rw [← alphaGamma_spec B (gammaGen j)]
  group

theorem freeToModel₂_cornerMarkRelator (B : CoverBlockResiduals)
    (j : Fin gammaGeneratorCount) :
    freeToModel₂ (cornerMarkRelator j) = 1 := by
  rw [cornerMarkRelator]
  simp only [map_commutatorElement, freeToModel₂_markWord,
    freeToModel₂_cornerLetter]
  exact (B.mark_commutes (gammaGen j)).commutator_eq

theorem freeToModel₂_cornerGeneratorRelator (j : Fin gammaGeneratorCount) :
    freeToModel₂ (cornerGeneratorRelator j) = 1 := by
  simp only [cornerGeneratorRelator, map_mul, map_inv,
    freeToModel₂_cornerLetter, freeToModel₂_embedModelWord,
    freeToModel_liftWord]
  group

theorem freeToModel₂_defectIdentificationRelator (B : CoverBlockResiduals) :
    freeToModel₂ (defectIdentificationRelator B) = 1 := by
  simp only [defectIdentificationRelator, map_mul, map_inv,
    map_commutatorElement, freeToModel₂_tauWord, freeToModel₂_markWord,
    freeToModel₂_embedCornerWord, freeToGamma_liftGammaWord,
    freeToModel₂_defectBlockWord]
  rw [B.defect_from_mark]
  group

/-- **The design invariant.**  Every imposed relator vanishes in the model. -/
theorem freeToModel₂_relator_eq_one (C : CoverInputs)
    (B : CoverBlockResiduals) :
    ∀ r ∈ ((blockRelators C B : Finset (FreeGroup Letter)) :
      Set (FreeGroup Letter)), freeToModel₂ r = 1 := by
  intro r hr
  have hr' : r ∈ blockRelators C B := Finset.mem_coe.mp hr
  simp only [blockRelators, Finset.mem_union, Finset.mem_singleton] at hr'
  rcases hr' with ((((((h | h) | h) | h) | h) | h) | h) | h
  · obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp h
    rw [freeToModel₂_embedModelWord]
    change deltaQuotient (PresentedGroup.mk _ s) = 1
    rw [PresentedGroup.one_of_mem (Finset.mem_coe.mpr hs), map_one]
  · obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp h
    rw [freeToModel₂_embedCornerWord]
    change iota (gammaQuotient (PresentedGroup.mk _ s)) = 1
    rw [PresentedGroup.one_of_mem (Finset.mem_coe.mpr hs), map_one, map_one]
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp h
    rw [freeToModel₂_embedModelWord]
    exact freeToModel_compressionRelator i
  · obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp h
    exact freeToModel₂_cornerCompressionRelator B j
  · obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp h
    exact freeToModel₂_cornerMarkRelator B j
  · obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp h
    exact freeToModel₂_cornerGeneratorRelator j
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp h
    rw [freeToModel₂_embedModelWord]
    exact freeToModel_saturationRelator C i
  · subst h
    exact freeToModel₂_defectIdentificationRelator B

/-- The covering map of the two-block presentation onto the model. -/
noncomputable def blockToModel (C : CoverInputs) (B : CoverBlockResiduals) :
    CoverGroup₂ C B →* Model :=
  PresentedEnlargement.factor freeToModel₂ (freeToModel₂_relator_eq_one C B)

theorem blockToModel_mk (C : CoverInputs) (B : CoverBlockResiduals)
    (w : FreeGroup Letter) :
    blockToModel C B (wordInCoverGroup₂ C B w) = freeToModel₂ w :=
  PresentedEnlargement.factor_mk freeToModel₂
    (freeToModel₂_relator_eq_one C B) w

theorem blockToModel_blockDefect (C : CoverInputs) (B : CoverBlockResiduals) :
    blockToModel C B (blockDefect C B) = defectModel := by
  change blockToModel C B (wordInCoverGroup₂ C B defectBlockWord) = defectModel
  rw [blockToModel_mk, freeToModel₂_defectBlockWord]

/-- The identified defect survives into the two-block cover group. -/
theorem blockDefect_ne_one (C : CoverInputs) (B : CoverBlockResiduals) :
    blockDefect C B ≠ 1 := by
  intro h
  refine defectModel_ne_one ?_
  have hval : blockToModel C B (blockDefect C B) = 1 := by
    rw [h, map_one]
  rwa [blockToModel_blockDefect] at hval

theorem coverGroup₂_nontrivial (C : CoverInputs) (B : CoverBlockResiduals) :
    Nontrivial (CoverGroup₂ C B) :=
  ⟨⟨blockDefect C B, 1, blockDefect_ne_one C B⟩⟩

/-! ## Property `(T)`

Family 6 identifies each corner letter with a first-block word, so the first
block alone generates.  The assignment of the first block is well defined on
`Δ` by family 1, giving a surjection `Δ ↠ CoverGroup₂`; property `(T)` then
passes along it. -/

/-- Family 1 makes the first-block assignment kill every relator of the model
cover. -/
theorem modelBlock_kills_coverRelators (C : CoverInputs)
    (B : CoverBlockResiduals) :
    ∀ r ∈ ((coverRelators : Finset (FreeGroup (Fin generatorCount))) :
      Set (FreeGroup (Fin generatorCount))),
      ((wordInCoverGroup₂ C B).comp embedModelWord) r = 1 := fun _ hr ↦
  PresentedGroup.one_of_mem
    (Finset.mem_coe.mpr (mem_blockRelators_cover C B (Finset.mem_coe.mp hr)))

/-- The model cover maps onto the two-block cover group. -/
noncomputable def deltaToBlock (C : CoverInputs) (B : CoverBlockResiduals) :
    Delta →* CoverGroup₂ C B :=
  PresentedEnlargement.factor ((wordInCoverGroup₂ C B).comp embedModelWord)
    (modelBlock_kills_coverRelators C B)

theorem deltaToBlock_mk (C : CoverInputs) (B : CoverBlockResiduals)
    (w : FreeGroup (Fin generatorCount)) :
    deltaToBlock C B (PresentedGroup.mk _ w) =
      wordInCoverGroup₂ C B (embedModelWord w) :=
  PresentedEnlargement.factor_mk
    ((wordInCoverGroup₂ C B).comp embedModelWord)
    (modelBlock_kills_coverRelators C B) w

theorem deltaToBlock_of (C : CoverInputs) (B : CoverBlockResiduals)
    (i : Fin generatorCount) :
    deltaToBlock C B (PresentedGroup.of i) =
      wordInCoverGroup₂ C B (modelLetter i) := by
  have h := deltaToBlock_mk C B (FreeGroup.of i)
  rw [embedModelWord_of] at h
  exact h

theorem deltaToBlock_surjective (C : CoverInputs) (B : CoverBlockResiduals) :
    Function.Surjective (deltaToBlock C B) := by
  intro x
  refine MonoidHom.mem_range.mp ?_
  refine PresentedGroup.generated_by _ _ ?_ x
  rintro (i | j)
  · refine ⟨PresentedGroup.of i, ?_⟩
    rw [deltaToBlock_of, of_inl_eq]
  · refine ⟨PresentedGroup.mk _ (liftWord (iota (gammaGen j))), ?_⟩
    rw [deltaToBlock_mk, of_inr_eq, cornerLetter_eq_modelWord]

/-- **Property `(T)` for the two-block cover group**, inherited from the model
cover along the surjection that family 6 makes possible. -/
theorem coverGroup₂_hasKazhdanPropertyT (C : CoverInputs)
    (B : CoverBlockResiduals) : HasKazhdanPropertyT.{0, 0} (CoverGroup₂ C B) :=
  HasKazhdanPropertyT.of_surjective (deltaToBlock C B)
    (deltaToBlock_surjective C B) delta_hasKazhdanPropertyT

theorem top_hasKazhdanPropertyT (C : CoverInputs) (B : CoverBlockResiduals) :
    HasKazhdanPropertyT.{0, 0} ↥(⊤ : Subgroup (CoverGroup₂ C B)) :=
  HasKazhdanPropertyT.of_mulEquiv Subgroup.topEquiv
    (coverGroup₂_hasKazhdanPropertyT C B)

/-! ## The endpoint -/

/-- **The Hilbert-hotel headline.**  The two-block cover group is a finitely
presented Kazhdan group which is not operator MF. -/
theorem not_isOperatorMF_coverGroup₂ (C : CoverInputs)
    (B : CoverBlockResiduals) : ¬ IsOperatorMF (CoverGroup₂ C B) := by
  haveI : Nontrivial (CoverGroup₂ C B) := coverGroup₂_nontrivial C B
  exact QuestionTwoReduction.not_isOperatorMF_of_nontrivial_normal_kazhdan_defect
    (coverCore C B) ⊤ (top_hasKazhdanPropertyT C B) (top_le_defectNormal C B)
    top_ne_bot

/-- **Full MF radical.**  Every element of the two-block cover group is
invisible to every corona representation: the group is equal to its own MF
radical. -/
theorem coverGroup₂_full_mf_radical (C : CoverInputs)
    (B : CoverBlockResiduals) (x : CoverGroup₂ C B) : CoronaMFInvisible x :=
  QuestionTwoReduction.coronaMFInvisible_of_mem_normal_kazhdan_defect
    (coverCore C B) ⊤ (top_hasKazhdanPropertyT C B) (top_le_defectNormal C B)
    (Subgroup.mem_top x)

/-- **The package.**  A finitely presented, countable, nontrivial Kazhdan
group whose compression defect is all of it, which is equal to its own MF
radical, and which is therefore not operator MF. -/
theorem hilbertHotel_finitelyPresented_endpoint (C : CoverInputs)
    (B : CoverBlockResiduals) :
    Group.IsFinitelyPresented (CoverGroup₂ C B) ∧
      Countable (CoverGroup₂ C B) ∧
      Nontrivial (CoverGroup₂ C B) ∧
      HasKazhdanPropertyT.{0, 0} (CoverGroup₂ C B) ∧
      Subgroup.normalClosure ({blockDefect C B} : Set (CoverGroup₂ C B)) = ⊤ ∧
      (∀ x : CoverGroup₂ C B, CoronaMFInvisible x) ∧
      ¬ IsOperatorMF (CoverGroup₂ C B) :=
  ⟨inferInstance, inferInstance, coverGroup₂_nontrivial C B,
    coverGroup₂_hasKazhdanPropertyT C B, defectClosure_eq_top C B,
    coverGroup₂_full_mf_radical C B, not_isOperatorMF_coverGroup₂ C B⟩

/-! ## Both records are discharged

`CoverBlockResiduals` is built from the model file, and `Cover.CoverInputs`
from the conjugate-word file, so the construction carries no hypothesis at
all. -/

/-- **The residual record, discharged.**  All four model-level leaves are
theorems of `HilbertHotelModelNonMF`: the two compression clauses verbatim,
and the witness together with its defect computation from the corner
generator `e₁₂(1)`. -/
noncomputable def coverBlockResiduals : CoverBlockResiduals where
  tau_compresses := Cover.tau_compresses
  mark_commutes := Cover.mark_commutes
  witness := Cover.cornerGenerator
  defect_from_mark := by
    have h := Cover.transported_commutator_eq_defect
    rw [Cover.modelCore_transported_eq] at h
    exact h

/-- The chosen cover inputs; discharged in `ConjProductClosure`. -/
theorem blockCoverInputs : CoverInputs :=
  Classical.choice Cover.coverInputs_nonempty

/-- **The finitely presented Hilbert-hotel group.**  The two-block cover at
the discharged records: a group with no hypotheses attached. -/
noncomputable abbrev HotelGroup : Type :=
  CoverGroup₂ blockCoverInputs coverBlockResiduals

/-- **The Hilbert-hotel endpoint, unconditional.**  A finitely presented,
countable, nontrivial Kazhdan group equal to its own MF radical, and therefore
not operator MF. -/
theorem hotelGroup_endpoint :
    Group.IsFinitelyPresented HotelGroup ∧
      Countable HotelGroup ∧
      Nontrivial HotelGroup ∧
      HasKazhdanPropertyT.{0, 0} HotelGroup ∧
      (∀ x : HotelGroup, CoronaMFInvisible x) ∧
      ¬ IsOperatorMF HotelGroup := by
  obtain ⟨hfp, hcount, hne, hT, -, hmf, hnot⟩ :=
    hilbertHotel_finitelyPresented_endpoint blockCoverInputs coverBlockResiduals
  exact ⟨hfp, hcount, hne, hT, hmf, hnot⟩

/-- **Existence form.**  There is a finitely presented Kazhdan group which is
not operator MF, and which is in fact equal to its own MF radical. -/
theorem exists_finitelyPresented_kazhdan_full_mf_radical :
    ∃ (G : Type) (_ : Group G),
      Group.IsFinitelyPresented G ∧ Countable G ∧ Nontrivial G ∧
        HasKazhdanPropertyT.{0, 0} G ∧
        (∀ x : G, CoronaMFInvisible x) ∧ ¬ IsOperatorMF G :=
  ⟨HotelGroup, inferInstance, hotelGroup_endpoint⟩

end CoverBlock
end HilbertHotel
