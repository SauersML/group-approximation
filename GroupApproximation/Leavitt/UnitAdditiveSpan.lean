import GroupApproximation.Leavitt.Leavitt

/-!
# Units additively span every binary Leavitt ring

Off-diagonal Leavitt corners are square-zero, hence differences of units.
Each diagonal corner is a product of two such off-diagonal corners and is
again an additive combination of units.  The four corners sum to every ring
element.  No characteristic assumption is needed.
-/

namespace GroupApproximation
namespace LeavittFamily

variable {A : Type*} [Ring A]

/-- The additive subgroup generated by the values of all units. -/
def unitAdditiveSpan (A : Type*) [Ring A] : AddSubgroup A :=
  AddSubgroup.closure (Set.range fun u : Aˣ ↦ (u : A))

theorem unit_val_mem_unitAdditiveSpan (u : Aˣ) :
    (u : A) ∈ unitAdditiveSpan A :=
  AddSubgroup.subset_closure (Set.mem_range_self u)

/-- `1 + x` is a unit whenever `x² = 0`. -/
def squareZeroUnit (x : A) (hx : x * x = 0) : Aˣ where
  val := 1 + x
  inv := 1 - x
  val_inv := by noncomm_ring [hx]
  inv_val := by noncomm_ring [hx]

theorem squareZero_mem_unitAdditiveSpan {x : A} (hx : x * x = 0) :
    x ∈ unitAdditiveSpan A := by
  have hu := unit_val_mem_unitAdditiveSpan (squareZeroUnit x hx)
  have h1 := unit_val_mem_unitAdditiveSpan (1 : Aˣ)
  have hsub := (unitAdditiveSpan A).sub_mem hu h1
  simpa [squareZeroUnit] using hsub

/-- The product of two square-zero elements is an additive combination of
units: subtract `1`, the two linear terms, from `(1+x)(1+y)`. -/
theorem squareZero_mul_mem_unitAdditiveSpan {x y : A}
    (hx : x * x = 0) (hy : y * y = 0) :
    x * y ∈ unitAdditiveSpan A := by
  let ux := squareZeroUnit x hx
  let uy := squareZeroUnit y hy
  have hprod := unit_val_mem_unitAdditiveSpan (ux * uy)
  have h1 := unit_val_mem_unitAdditiveSpan (1 : Aˣ)
  have hxmem := squareZero_mem_unitAdditiveSpan hx
  have hymem := squareZero_mem_unitAdditiveSpan hy
  have hsub := (unitAdditiveSpan A).sub_mem
    ((unitAdditiveSpan A).sub_mem
      ((unitAdditiveSpan A).sub_mem hprod h1) hxmem) hymem
  change ((1 + x) * (1 + y) - 1 - x - y) ∈ unitAdditiveSpan A at hsub
  have heq : (1 + x) * (1 + y) - 1 - x - y = x * y := by
    noncomm_ring
  rwa [heq] at hsub

theorem offDiagonal01_mem_unitAdditiveSpan (L : LeavittFamily A) (a : A) :
    L.s0 * a * L.t1 ∈ unitAdditiveSpan A := by
  apply squareZero_mem_unitAdditiveSpan
  calc
    (L.s0 * a * L.t1) * (L.s0 * a * L.t1) =
        L.s0 * a * (L.t1 * L.s0) * a * L.t1 := by noncomm_ring
    _ = 0 := by rw [L.t1_s0]; simp

theorem offDiagonal10_mem_unitAdditiveSpan (L : LeavittFamily A) (a : A) :
    L.s1 * a * L.t0 ∈ unitAdditiveSpan A := by
  apply squareZero_mem_unitAdditiveSpan
  calc
    (L.s1 * a * L.t0) * (L.s1 * a * L.t0) =
        L.s1 * a * (L.t0 * L.s1) * a * L.t0 := by noncomm_ring
    _ = 0 := by rw [L.t0_s1]; simp

theorem diagonal0_mem_unitAdditiveSpan (L : LeavittFamily A) (a : A) :
    L.s0 * a * L.t0 ∈ unitAdditiveSpan A := by
  have hx : (L.s0 * a * L.t1) * (L.s0 * a * L.t1) = 0 := by
    calc
      (L.s0 * a * L.t1) * (L.s0 * a * L.t1) =
          L.s0 * a * (L.t1 * L.s0) * a * L.t1 := by noncomm_ring
      _ = 0 := by rw [L.t1_s0]; simp
  have hy : (L.s1 * L.t0) * (L.s1 * L.t0) = 0 := L.s1t0_sq
  have hmul := squareZero_mul_mem_unitAdditiveSpan hx hy
  have heq : (L.s0 * a * L.t1) * (L.s1 * L.t0) = L.s0 * a * L.t0 := by
    calc
      (L.s0 * a * L.t1) * (L.s1 * L.t0) =
          L.s0 * a * (L.t1 * L.s1) * L.t0 := by noncomm_ring
      _ = L.s0 * a * L.t0 := by rw [L.t1_s1]; simp
  rwa [heq] at hmul

theorem diagonal1_mem_unitAdditiveSpan (L : LeavittFamily A) (a : A) :
    L.s1 * a * L.t1 ∈ unitAdditiveSpan A := by
  have hx : (L.s1 * a * L.t0) * (L.s1 * a * L.t0) = 0 := by
    calc
      (L.s1 * a * L.t0) * (L.s1 * a * L.t0) =
          L.s1 * a * (L.t0 * L.s1) * a * L.t0 := by noncomm_ring
      _ = 0 := by rw [L.t0_s1]; simp
  have hy : (L.s0 * L.t1) * (L.s0 * L.t1) = 0 := L.s0t1_sq
  have hmul := squareZero_mul_mem_unitAdditiveSpan hx hy
  have heq : (L.s1 * a * L.t0) * (L.s0 * L.t1) = L.s1 * a * L.t1 := by
    calc
      (L.s1 * a * L.t0) * (L.s0 * L.t1) =
          L.s1 * a * (L.t0 * L.s0) * L.t1 := by noncomm_ring
      _ = L.s1 * a * L.t1 := by rw [L.t0_s0]; simp
  rwa [heq] at hmul

/-- **Unit-span theorem.**  In every ring carrying a binary Leavitt family,
the additive subgroup generated by unit values is the whole ring. -/
theorem unitAdditiveSpan_eq_top (L : LeavittFamily A) :
    unitAdditiveSpan A = ⊤ := by
  apply top_unique
  intro a _
  have h00 := diagonal0_mem_unitAdditiveSpan L (L.t0 * a * L.s0)
  have h01 := offDiagonal01_mem_unitAdditiveSpan L (L.t0 * a * L.s1)
  have h10 := offDiagonal10_mem_unitAdditiveSpan L (L.t1 * a * L.s0)
  have h11 := diagonal1_mem_unitAdditiveSpan L (L.t1 * a * L.s1)
  have hsum := (unitAdditiveSpan A).add_mem
    ((unitAdditiveSpan A).add_mem
      ((unitAdditiveSpan A).add_mem h00 h01) h10) h11
  have hdecomp : a =
      L.s0 * (L.t0 * a * L.s0) * L.t0 +
      L.s0 * (L.t0 * a * L.s1) * L.t1 +
      L.s1 * (L.t1 * a * L.s0) * L.t0 +
      L.s1 * (L.t1 * a * L.s1) * L.t1 := by
    calc
      a = 1 * a * 1 := by simp
      _ = (L.s0 * L.t0 + L.s1 * L.t1) * a *
          (L.s0 * L.t0 + L.s1 * L.t1) := by rw [L.sum_range]
      _ = L.s0 * (L.t0 * a * L.s0) * L.t0 +
            L.s0 * (L.t0 * a * L.s1) * L.t1 +
            L.s1 * (L.t1 * a * L.s0) * L.t0 +
            L.s1 * (L.t1 * a * L.s1) * L.t1 := by noncomm_ring
  rw [hdecomp]
  exact hsum

end LeavittFamily
end GroupApproximation
