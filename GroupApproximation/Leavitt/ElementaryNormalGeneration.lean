import GroupApproximation.Leavitt.ElementaryNoFiniteQuotients
import GroupApproximation.Leavitt.ElementaryRoots
import GroupApproximation.Leavitt.HilbertHotelBlocks

/-!
# One elementary root normally generates the elementary group

The manuscript closes Proposition `prop:defect` by quoting simplicity: "`d` is
nontrivial and `H` is simple by Proposition `prop:simple`, so its normal closure
is all of `H`".  Proposition `prop:simple` is expensive — it runs on Preusser's
normal-subgroup theorem, pure infiniteness and the exchange property of
`L_{𝔽₂}(1,2)`, and the computation of the centre — and it is only ever used to
promote *one* nontrivial element to a normal generator.

This file proves the normal-generation statement outright, with no simplicity
input, no purely-infinite or exchange-ring input, and no computation of a
centre.  What replaces all of it is a **unit sandwich**: an element `x` of a
ring `R` for which there are `a b : R` with `a * x * b = 1`.  For the Leavitt
defect `x = q = s₁t₁` the sandwich is free, because
`t₁ * (s₁ * t₁) * s₁ = (t₁s₁)(t₁s₁) = 1` (`HilbertHotel.r1_mul_q_mul_s1`).

**The statement.**  For a unital ring `R`, a fintype index `ι` with
`3 ≤ Fintype.card ι`, indices `i ≠ j`, and `x` admitting a unit sandwich,

  `Subgroup.normalClosure {elGen i j hij x} = ⊤`   in `EL_ι(R)`,

and, in the form the manuscript needs it, *every* normal subgroup of `EL_ι(R)`
containing `e_{ij}(x)` is already everything
(`elementaryGroup_normal_eq_top_of_elGen_mem`).

**The proof is a short chain of commutators and a case split on indices.**  It runs
on the Steinberg relation `⁅e_{ij}(a), e_{jk}(b)⁆ = e_{ik}(ab)` and the remark
that a commutator dies as soon as *one* of its two entries does.

* Choose `m ∉ {i, j}`.  Then `⁅e_{ij}(x), e_{jm}(b)⁆ = e_{im}(xb)` dies, and
  `⁅e_{ji}(a), e_{im}(xb)⁆ = e_{jm}(a(xb)) = e_{jm}(1)` dies: the sandwich has
  converted the defect into a *unit* root at the pair `(j, m)`.
* From a dead `e_{uv}(1)` two moves are available for every `w ∉ {u, v}`:
  `⁅e_{wu}(c), e_{uv}(1)⁆ = e_{wv}(c)` moves the source, and
  `⁅e_{uv}(1), e_{vw}(c)⁆ = e_{uw}(c)` moves the target — both with an
  *arbitrary* coefficient.
* At most four such moves connect any ordered pair of distinct indices to any
  other, which is where `3 ≤ Fintype.card ι` is spent (through
  `exists_third_index`).
* `EL_ι(R)` is generated by the roots, so nothing survives in the quotient.

Nontriviality of the defect comes from the same hypothesis: a unit sandwich
forces `x ≠ 0` in a nontrivial ring, hence `e_{ij}(x) ≠ 1`
(`elGen_ne_one_of_unit_sandwich`), so no separate `q ≠ 0` argument is needed
either.

Compare `SteinbergGroup.normalClosure_x_eq_top`, which proves the analogous
statement upstairs in the Steinberg group: it assumes strong two-sided division
for *every* nonzero element of `R` and needs a spare index outside four
prescribed ones (so rank `≥ 5`).  Here a single sandwiched element and rank `≥ 3`
suffice, and the conclusion is about the elementary group itself.
-/

namespace GroupApproximation

variable {ι R Q : Type*} [Fintype ι] [DecidableEq ι] [Ring R] [Group Q]

/-! ### Killing rules from the Steinberg relation -/

/-- A commutator dies when its **left** entry does:
`⁅e_{ij}(a), e_{jk}(b)⁆ = e_{ik}(ab)`. -/
theorem elGen_map_eq_one_of_left (φ : elementaryGroup ι R →* Q) (i j k : ι)
    (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : R)
    (ha : φ (elGen i j hij a) = 1) :
    φ (elGen i k hik (a * b)) = 1 := by
  rw [← elGen_commutator i j k hij hjk hik a b, map_mul, map_mul, map_mul,
    map_inv, map_inv, ha]
  simp

/-- A commutator dies when its **right** entry does. -/
theorem elGen_map_eq_one_of_right (φ : elementaryGroup ι R →* Q) (i j k : ι)
    (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : R)
    (hb : φ (elGen j k hjk b) = 1) :
    φ (elGen i k hik (a * b)) = 1 := by
  rw [← elGen_commutator i j k hij hjk hik a b, map_mul, map_mul, map_mul,
    map_inv, map_inv, hb]
  simp

/-- **Source move.**  A dead unit root at `(u, v)` kills every coefficient at
`(w, v)`, for every third index `w`: `⁅e_{wu}(c), e_{uv}(1)⁆ = e_{wv}(c)`. -/
theorem elGen_map_eq_one_source_step (φ : elementaryGroup ι R →* Q) {u v w : ι}
    (huv : u ≠ v) (hwu : w ≠ u) (hwv : w ≠ v)
    (h : φ (elGen u v huv 1) = 1) (c : R) :
    φ (elGen w v hwv c) = 1 := by
  have hkey : φ (elGen w v hwv (c * 1)) = 1 :=
    elGen_map_eq_one_of_right φ w u v hwu huv hwv c 1 h
  rw [mul_one] at hkey
  exact hkey

/-- **Target move.**  A dead unit root at `(u, v)` kills every coefficient at
`(u, w)`, for every third index `w`: `⁅e_{uv}(1), e_{vw}(c)⁆ = e_{uw}(c)`. -/
theorem elGen_map_eq_one_target_step (φ : elementaryGroup ι R →* Q) {u v w : ι}
    (huv : u ≠ v) (hvw : v ≠ w) (huw : u ≠ w)
    (h : φ (elGen u v huv 1) = 1) (c : R) :
    φ (elGen u w huw c) = 1 := by
  have hkey : φ (elGen u w huw (1 * c)) = 1 :=
    elGen_map_eq_one_of_left φ u v w huv hvw huw 1 c h
  rw [one_mul] at hkey
  exact hkey

/-! ### Spreading a single dead unit root over all pairs -/

/-- **One dead unit root kills every unit root.**  With three indices available,
the two moves above connect any ordered pair of distinct indices to any other in
at most three steps. -/
theorem elGen_map_one_eq_one_all_pairs (hcard : 3 ≤ Fintype.card ι)
    (φ : elementaryGroup ι R →* Q) {p q : ι} (hpq : p ≠ q)
    (hbase : φ (elGen p q hpq 1) = 1) :
    ∀ (l k : ι) (hlk : l ≠ k), φ (elGen l k hlk 1) = 1 := by
  -- Fixed source `p`, arbitrary target.
  have hT : ∀ (v : ι) (hv : p ≠ v), φ (elGen p v hv 1) = 1 := by
    intro v hv
    by_cases hvq : v = q
    · subst hvq
      exact hbase
    · exact elGen_map_eq_one_target_step φ hpq (Ne.symm hvq) hv hbase 1
  -- Arbitrary source, arbitrary target away from `p`.
  have hS : ∀ (u k : ι) (hup : u ≠ p) (hkp : k ≠ p) (huk : u ≠ k),
      φ (elGen u k huk 1) = 1 := by
    intro u k hup hkp huk
    exact elGen_map_eq_one_source_step φ (Ne.symm hkp) hup huk
      (hT k (Ne.symm hkp)) 1
  intro l k hlk
  by_cases hlp : l = p
  · subst hlp
    exact hT k hlk
  · by_cases hkp : k = p
    · -- The one remaining pattern: the target is `p` itself.  Detour through a
      -- third index.
      obtain ⟨w, hwl, hwk⟩ := exists_third_index hcard l k
      have hwp : w ≠ p := by
        rw [← hkp]
        exact hwk
      have hlw : l ≠ w := Ne.symm hwl
      have h1 : φ (elGen l w hlw 1) = 1 := hS l w hlp hwp hlw
      exact elGen_map_eq_one_target_step φ hlw hwk hlk h1 1
    · exact hS l k hlp hkp hlk

/-- **One dead unit root kills every root.**  Coefficients are arbitrary: the
last source move carries them. -/
theorem elGen_map_eq_one_all (hcard : 3 ≤ Fintype.card ι)
    (φ : elementaryGroup ι R →* Q) {p q : ι} (hpq : p ≠ q)
    (hbase : φ (elGen p q hpq 1) = 1) :
    ∀ (l k : ι) (hlk : l ≠ k) (c : R), φ (elGen l k hlk c) = 1 := by
  intro l k hlk c
  obtain ⟨w, hwl, hwk⟩ := exists_third_index hcard l k
  have h1 : φ (elGen w k hwk 1) = 1 :=
    elGen_map_one_eq_one_all_pairs hcard φ hpq hbase w k hwk
  exact elGen_map_eq_one_source_step φ hwk (Ne.symm hwl) hlk h1 c

/-- **The sandwich enters here.**  If `a * x * b = 1` and the root `e_{ij}(x)`
dies, then two commutators produce a dead *unit* root, and everything dies. -/
theorem elGen_map_eq_one_of_unit_sandwich (hcard : 3 ≤ Fintype.card ι)
    (φ : elementaryGroup ι R →* Q) {i j : ι} (hij : i ≠ j) {x a b : R}
    (hab : a * x * b = 1) (hx : φ (elGen i j hij x) = 1) :
    ∀ (l k : ι) (hlk : l ≠ k) (c : R), φ (elGen l k hlk c) = 1 := by
  obtain ⟨m, hmi, hmj⟩ := exists_third_index hcard i j
  have him : i ≠ m := Ne.symm hmi
  have hjm : j ≠ m := Ne.symm hmj
  have hji : j ≠ i := Ne.symm hij
  have h1 : φ (elGen i m him (x * b)) = 1 :=
    elGen_map_eq_one_of_left φ i j m hij hjm him x b hx
  have h2 : φ (elGen j m hjm (a * (x * b))) = 1 :=
    elGen_map_eq_one_of_right φ j i m hji him hjm a (x * b) h1
  have hcoef : a * (x * b) = 1 := by
    rw [← mul_assoc]
    exact hab
  rw [hcoef] at h2
  exact elGen_map_eq_one_all hcard φ hjm h2

/-! ### From the roots to the whole group -/

/-- The elementary group is generated by its roots, so a homomorphism killing
every root is trivial. -/
theorem elementaryGroup_hom_eq_one_of_gens (φ : elementaryGroup ι R →* Q)
    (hgen : ∀ (l k : ι) (h : l ≠ k) (d : R), φ (elGen l k h d) = 1)
    (g : elementaryGroup ι R) : φ g = 1 := by
  obtain ⟨g, hg⟩ := g
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨l, k, hlk, d, rfl⟩ := hx
      exact hgen l k hlk d
  | one => exact map_one φ
  | mul x y hx hy ihx ihy =>
      have h : (⟨x * y, Subgroup.mul_mem _ hx hy⟩ : elementaryGroup ι R)
          = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
      rw [h, map_mul, ihx, ihy, one_mul]
  | inv x hx ihx =>
      have h : (⟨x⁻¹, Subgroup.inv_mem _ hx⟩ : elementaryGroup ι R)
          = (⟨x, hx⟩)⁻¹ := rfl
      rw [h, map_inv, ihx, inv_one]

/-- **Every quotient in which a sandwiched root dies is trivial.** -/
theorem elementaryGroup_hom_eq_one_of_unit_sandwich (hcard : 3 ≤ Fintype.card ι)
    (φ : elementaryGroup ι R →* Q) {i j : ι} (hij : i ≠ j) {x : R}
    (hsand : ∃ a b : R, a * x * b = 1) (hx : φ (elGen i j hij x) = 1)
    (g : elementaryGroup ι R) : φ g = 1 := by
  obtain ⟨a, b, hab⟩ := hsand
  exact elementaryGroup_hom_eq_one_of_gens φ
    (elGen_map_eq_one_of_unit_sandwich hcard φ hij hab hx) g

/-! ### Normal generation -/

/-- **The crux, in the form Proposition `prop:defect` uses it.**  A normal
subgroup of `EL_ι(R)` containing one elementary root `e_{ij}(x)` whose
coefficient admits a unit sandwich `a * x * b = 1` is the whole group, as soon as
there are three indices.  No simplicity of `EL_ι(R)` and no structure theory of
`R` is used. -/
theorem elementaryGroup_normal_eq_top_of_elGen_mem (hcard : 3 ≤ Fintype.card ι)
    (N : Subgroup (elementaryGroup ι R)) [N.Normal]
    {i j : ι} (hij : i ≠ j) {x : R} (hmem : elGen i j hij x ∈ N)
    (hsand : ∃ a b : R, a * x * b = 1) :
    N = ⊤ := by
  have hx : (QuotientGroup.mk' N) (elGen i j hij x) = 1 :=
    (QuotientGroup.eq_one_iff _).mpr hmem
  have hall := elementaryGroup_hom_eq_one_of_unit_sandwich hcard
    (QuotientGroup.mk' N) hij hsand hx
  rw [Subgroup.eq_top_iff']
  intro g
  exact (QuotientGroup.eq_one_iff g).mp (hall g)

/-- **Normal generation.**  The normal closure of a single sandwiched elementary
root is all of `EL_ι(R)`. -/
theorem normalClosure_elGen_eq_top (hcard : 3 ≤ Fintype.card ι)
    {i j : ι} (hij : i ≠ j) {x : R} (hsand : ∃ a b : R, a * x * b = 1) :
    Subgroup.normalClosure ({elGen i j hij x} : Set (elementaryGroup ι R)) = ⊤ :=
  elementaryGroup_normal_eq_top_of_elGen_mem hcard
    (Subgroup.normalClosure ({elGen i j hij x} : Set (elementaryGroup ι R))) hij
    (Subgroup.subset_normalClosure (Set.mem_singleton _)) hsand

/-! ### The same statement under the repository's other name for the generator

`elGen` (`ElementaryNoFiniteQuotients`) and `elementaryRoot` (`ElementaryRoots`)
are the same bundled elementary matrix; the downstream Hilbert-hotel files use
the second name, so both readings are recorded here. -/

/-- The two names for the bundled elementary matrix agree definitionally. -/
theorem elGen_eq_elementaryRoot (i j : ι) (hij : i ≠ j) (a : R) :
    elGen i j hij a = elementaryRoot i j hij a := rfl

/-- **Normal generation, stated for `elementaryRoot`.**  Compare
`HilbertHotel.normalClosure_elementaryRoot_eq_top`, which reaches the same
conclusion for the specific ring `L_{𝔽₂}(1,2)` in rank `≥ 5` by transporting the
Steinberg statement along the projection; this one is direct, needs only rank
`≥ 3`, and holds over every ring. -/
theorem normalClosure_elementaryRoot_eq_top_of_unit_sandwich
    (hcard : 3 ≤ Fintype.card ι) {i j : ι} (hij : i ≠ j) {x : R}
    (hsand : ∃ a b : R, a * x * b = 1) :
    Subgroup.normalClosure
        ({elementaryRoot i j hij x} : Set (elementaryGroup ι R)) = ⊤ :=
  normalClosure_elGen_eq_top hcard hij hsand

/-- The normal-subgroup form under the second name. -/
theorem elementaryGroup_normal_eq_top_of_elementaryRoot_mem
    (hcard : 3 ≤ Fintype.card ι) (N : Subgroup (elementaryGroup ι R)) [N.Normal]
    {i j : ι} (hij : i ≠ j) {x : R} (hmem : elementaryRoot i j hij x ∈ N)
    (hsand : ∃ a b : R, a * x * b = 1) :
    N = ⊤ :=
  elementaryGroup_normal_eq_top_of_elGen_mem hcard N hij hmem hsand

/-! ### Nontriviality of the root -/

/-- An elementary generator is trivial exactly when its coefficient vanishes. -/
theorem elGen_eq_one_iff (i j : ι) (h : i ≠ j) (a : R) :
    elGen i j h a = 1 ↔ a = 0 := by
  constructor
  · intro ha
    have h1 : elementaryUnit i j h a = elementaryUnit (R := R) i j h 0 := by
      rw [elementaryUnit_zero]
      exact congrArg Subtype.val ha
    exact elementaryUnit_injective i j h h1
  · intro ha
    rw [ha, elGen_zero]

/-- A unit sandwich already forbids `x = 0`: no separate nonvanishing argument is
needed for the defect. -/
theorem ne_zero_of_unit_sandwich [Nontrivial R] {x : R}
    (hsand : ∃ a b : R, a * x * b = 1) : x ≠ 0 := by
  obtain ⟨a, b, hab⟩ := hsand
  intro hx
  have h1 : (1 : R) = 0 := by
    rw [← hab, hx, mul_zero, zero_mul]
  exact one_ne_zero h1

/-- **The sandwiched root is a nontrivial normal generator.**  Both halves of
Proposition `prop:defect`'s last sentence come from the single hypothesis
`a * x * b = 1`. -/
theorem elGen_ne_one_of_unit_sandwich [Nontrivial R] {i j : ι} (hij : i ≠ j)
    {x : R} (hsand : ∃ a b : R, a * x * b = 1) :
    elGen i j hij x ≠ 1 := by
  intro h
  exact ne_zero_of_unit_sandwich hsand ((elGen_eq_one_iff i j hij x).mp h)

/-! ### The Leavitt defect

For a binary Leavitt family the sandwich is one relation:
`t₁ * (s₁t₁) * s₁ = (t₁s₁)(t₁s₁) = 1`, recorded as
`HilbertHotel.r1_mul_q_mul_s1`.  So the defect coefficient `q = s₁t₁` needs no
simplicity, no pure infiniteness and no exchange property to normally generate.
-/

section Leavitt

variable (L : LeavittFamily R)

/-- The Leavitt defect coefficient carries a unit sandwich. -/
theorem leavitt_p1_unit_sandwich : ∃ a b : R, a * L.p1 * b = 1 :=
  ⟨L.t1, L.s1, HilbertHotel.r1_mul_q_mul_s1 L⟩

/-- **Proposition `prop:defect`, last clause, without Proposition
`prop:simple`.**  The normal closure of `e_{ij}(q)` is all of `EL_ι(R)` for every
ring carrying a binary Leavitt family and every index type with at least three
indices. -/
theorem normalClosure_elGen_p1_eq_top (hcard : 3 ≤ Fintype.card ι)
    {i j : ι} (hij : i ≠ j) :
    Subgroup.normalClosure ({elGen i j hij L.p1} : Set (elementaryGroup ι R))
      = ⊤ :=
  normalClosure_elGen_eq_top hcard hij (leavitt_p1_unit_sandwich L)

/-- Any normal subgroup of `EL_ι(R)` containing the defect is everything. -/
theorem elementaryGroup_normal_eq_top_of_elGen_p1_mem
    (hcard : 3 ≤ Fintype.card ι) (N : Subgroup (elementaryGroup ι R)) [N.Normal]
    {i j : ι} (hij : i ≠ j) (hmem : elGen i j hij L.p1 ∈ N) :
    N = ⊤ :=
  elementaryGroup_normal_eq_top_of_elGen_mem hcard N hij hmem
    (leavitt_p1_unit_sandwich L)

/-- The Leavitt defect under the second name for the generator. -/
theorem normalClosure_elementaryRoot_p1_eq_top (hcard : 3 ≤ Fintype.card ι)
    {i j : ι} (hij : i ≠ j) :
    Subgroup.normalClosure
        ({elementaryRoot i j hij L.p1} : Set (elementaryGroup ι R)) = ⊤ :=
  normalClosure_elGen_p1_eq_top L hcard hij

/-- The defect is nontrivial: `d = e_{ij}(q) ≠ 1`. -/
theorem elGen_p1_ne_one [Nontrivial R] {i j : ι} (hij : i ≠ j) :
    elGen i j hij L.p1 ≠ 1 :=
  elGen_ne_one_of_unit_sandwich hij (leavitt_p1_unit_sandwich L)

/-- The defect is nontrivial, under the second name for the generator. -/
theorem elementaryRoot_p1_ne_one [Nontrivial R] {i j : ι} (hij : i ≠ j) :
    elementaryRoot i j hij L.p1 ≠ 1 :=
  elGen_p1_ne_one L hij

end Leavitt

end GroupApproximation
