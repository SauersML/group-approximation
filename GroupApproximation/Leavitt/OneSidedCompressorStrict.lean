/-!
# The compression is strict

`non_mf_groups_exist.tex`, Corollary `cor:one-sided-ring-maximal`, first
sentence.  That sentence is not a consequence of Theorem
`thm:full-defect-ring`: it needs no ideal condition on `1 - st` and no
saturation of the printed defect, only a property-`(T)` subgroup and one
element compressing it **strictly**.  Strictness is where `st ≠ 1` is spent:

> every off-diagonal entry of an element of `uΓu⁻¹` has the form `sat`, and
> `(1-st)·sat = 0` because `(1-st)s = s - s(ts) = 0`, whereas `(1-st)·1 = 1-st`
> is nonzero.  So `e₀₁(1) ∈ Γ \ uΓu⁻¹`.

The separating device is a **left probe**: for a coefficient `x` and an index
`I`, the units `v` with `x E_{II} · v = x E_{II}` form a subgroup
(`probeStabilizerUnits`).  A root `e_{IJ}(a)` lies in it exactly when
`x a = 0`, and every root off row `I` lies in it for free.  Taking `x = e` and
`I` the middle core coordinate, the conjugated core roots `e_{IJ}(sat)` all lie
in it because `e s = 0`, and the printed witness `e_{IJ}(1)` does not, because
`e ≠ 0`.

The subgroup `Γ` is the copy of `EL₃(S)` for the subring `S` generated by `s`
and `t`, embedded along the core coordinates of `Fin n`.  It is `EL₃(S)` rather
than `EL₃(R)` because the property-`(T)` hypothesis of
`OneSidedCompressorStrictContainment` is asked only of the finitely generated
subrings of `R`, and `S` is finitely generated by construction while `R` is not
assumed to be.
-/

namespace GroupApproximation
namespace OneSidedCompressorStrict

open OneSidedCompressor

/-! ### A left probe separating a compressed root from a bare one -/

section Probe

variable {ι R : Type*} [Fintype ι] [DecidableEq ι] [Ring R]

/-- The units fixing the probe matrix `x E_{II}` under left multiplication. -/
def probeStabilizerUnits (x : R) (I : ι) : Subgroup (Matrix ι ι R)ˣ where
  carrier := {v | Matrix.single I I x * ((v : (Matrix ι ι R)ˣ) : Matrix ι ι R)
    = Matrix.single I I x}
  one_mem' := by
    show Matrix.single I I x * ((1 : (Matrix ι ι R)ˣ) : Matrix ι ι R)
      = Matrix.single I I x
    simp
  mul_mem' := by
    intro a b ha hb
    have ha' : Matrix.single I I x * ((a : (Matrix ι ι R)ˣ) : Matrix ι ι R)
      = Matrix.single I I x := ha
    have hb' : Matrix.single I I x * ((b : (Matrix ι ι R)ˣ) : Matrix ι ι R)
      = Matrix.single I I x := hb
    show Matrix.single I I x * ((a * b : (Matrix ι ι R)ˣ) : Matrix ι ι R)
      = Matrix.single I I x
    rw [Units.val_mul, ← mul_assoc, ha', hb']
  inv_mem' := by
    intro a ha
    have ha' : Matrix.single I I x * ((a : (Matrix ι ι R)ˣ) : Matrix ι ι R)
      = Matrix.single I I x := ha
    show Matrix.single I I x * ((a⁻¹ : (Matrix ι ι R)ˣ) : Matrix ι ι R)
      = Matrix.single I I x
    conv_lhs => rw [← ha']
    rw [mul_assoc, a.mul_inv, mul_one]

/-- The same subgroup, inside the elementary group. -/
def probeStabilizer (x : R) (I : ι) : Subgroup (elementaryGroup ι R) :=
  (probeStabilizerUnits x I).comap (elementaryGroup ι R).subtype

theorem mem_probeStabilizer_iff (x : R) (I : ι) (g : elementaryGroup ι R) :
    g ∈ probeStabilizer x I ↔
      Matrix.single I I x * ((g : (Matrix ι ι R)ˣ) : Matrix ι ι R)
        = Matrix.single I I x :=
  Iff.rfl

theorem elementaryRoot_mem_probeStabilizer (x : R) (I i j : ι) (hij : i ≠ j) (a : R)
    (h : Matrix.single I I x * Matrix.single i j a = 0) :
    elementaryRoot i j hij a ∈ probeStabilizer x I := by
  rw [mem_probeStabilizer_iff]
  show Matrix.single I I x * (1 + Matrix.single i j a) = Matrix.single I I x
  rw [mul_add, mul_one, h, add_zero]

/-- A root off the probed row is fixed for free. -/
theorem elementaryRoot_mem_probeStabilizer_of_row_ne (x : R) (I i j : ι)
    (hij : i ≠ j) (a : R) (hIi : I ≠ i) :
    elementaryRoot i j hij a ∈ probeStabilizer x I :=
  elementaryRoot_mem_probeStabilizer x I i j hij a
    (Matrix.single_mul_single_of_ne (c := x) I I i hIi a)

/-- A root on the probed row is fixed exactly when the probe annihilates its
coefficient. -/
theorem elementaryRoot_mem_probeStabilizer_of_mul_eq_zero (x : R) (I j : ι)
    (hIj : I ≠ j) (a : R) (ha : x * a = 0) :
    elementaryRoot I j hIj a ∈ probeStabilizer x I :=
  elementaryRoot_mem_probeStabilizer x I I j hIj a
    (by rw [Matrix.single_mul_single_same, ha]; simp)

/-- The unit root on the probed row escapes, as soon as the probe coefficient
is nonzero.  This is the whole of the printed strictness. -/
theorem elementaryRoot_one_not_mem_probeStabilizer (x : R) (I j : ι)
    (hIj : I ≠ j) (hx : x ≠ 0) :
    elementaryRoot I j hIj (1 : R) ∉ probeStabilizer x I := by
  intro hmem
  rw [mem_probeStabilizer_iff] at hmem
  have h' : Matrix.single I I x * (1 + Matrix.single I j (1 : R))
      = Matrix.single I I x := hmem
  rw [mul_add, mul_one, Matrix.single_mul_single_same] at h'
  have h2 := congrFun (congrFun h' I) j
  have h3 : x = 0 := by
    simpa [Matrix.add_apply, Matrix.single_apply, hIj] using h2
  exact hx h3

end Probe

/-! ### Roots under a coefficient map and under the block embedding -/

section Transport

variable {ι R S : Type*} [Fintype ι] [DecidableEq ι] [Ring R] [Ring S]

theorem elementaryGroupMap_elementaryRoot (f : R →+* S) (i j : ι) (hij : i ≠ j)
    (a : R) :
    elementaryGroupMap (ι := ι) f (elementaryRoot i j hij a) =
      elementaryRoot i j hij (f a) := by
  apply Subtype.ext
  change elementaryMatrixUnitMap f (elementaryUnit i j hij a) =
    elementaryUnit i j hij (f a)
  exact elementaryMatrixUnitMap_elementaryUnit f i j hij a

end Transport

section Block

variable {A : Type*} [Ring A] {n : ℕ}

theorem coreEmbeddingOf_elementaryRoot (hn : 4 ≤ n) (i j : Fin 3) (hij : i ≠ j)
    (a : A) :
    coreEmbeddingOf (R := A) hn (elementaryRoot i j hij a) =
      elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
        ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) a := by
  rw [coreEmbeddingOf, MonoidHom.comp_apply, coreEmbedding_elementaryRoot,
    blockEmbedding_elementaryRoot]

/-- The printed `u e_{ij}(a) u⁻¹ = e_{ij}(sat)` at rank `n`, obtained from the
rank-four identity by applying the block embedding. -/
theorem compressorOf_conj_root (P : OneSidedInverse A) (hn : 4 ≤ n)
    (i j : Fin 3) (hij : i ≠ j) (a : A) :
    compressorOf P hn *
        elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
          ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) a *
        (compressorOf P hn)⁻¹ =
      elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
        ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) (P.s * a * P.t) := by
  have h := congrArg (blockEmbedding (R := A) hn) (compressor_conj_root P i j hij a)
  simpa [compressorOf, map_mul, map_inv] using h

end Block

/-! ### The copy of `EL₃(S)` inside `EL_n(R)`, and its compressor -/

section Subring

variable {R : Type*} [Ring R] {n : ℕ}

/-- `EL₃(S) → EL_n(R)`: the core coordinates, with coefficients included. -/
noncomputable def subringCoreEmbedding (S : Subring R) (hn : 4 ≤ n) :
    elementaryGroup (Fin 3) ↥S →* elementaryGroup (Fin n) R :=
  (elementaryGroupMap S.subtype).comp (coreEmbeddingOf hn)

theorem subringCoreEmbedding_elementaryRoot (S : Subring R) (hn : 4 ≤ n)
    (i j : Fin 3) (hij : i ≠ j) (a : ↥S) :
    subringCoreEmbedding S hn (elementaryRoot i j hij a) =
      elementaryRoot (bigIdx hn (coreIdx i)) (bigIdx hn (coreIdx j))
        ((bigIdx_injective hn).ne (coreIdx_injective.ne hij)) (a : R) := by
  rw [subringCoreEmbedding, MonoidHom.comp_apply, coreEmbeddingOf_elementaryRoot,
    elementaryGroupMap_elementaryRoot]
  rfl

/-- The compressor of the subring pair, as an element of `EL_n(R)`. -/
noncomputable def subringCompressor (S : Subring R) (P : OneSidedInverse ↥S)
    (hn : 4 ≤ n) : elementaryGroup (Fin n) R :=
  elementaryGroupMap S.subtype (compressorOf P hn)

theorem subringCompressor_conj_root (S : Subring R) (P : OneSidedInverse ↥S)
    (hn : 4 ≤ n) (i j : Fin 3) (hij : i ≠ j) (a : ↥S) :
    subringCompressor S P hn *
        subringCoreEmbedding S hn (elementaryRoot i j hij a) *
        (subringCompressor S P hn)⁻¹ =
      subringCoreEmbedding S hn (elementaryRoot i j hij (P.s * a * P.t)) := by
  have h := congrArg (elementaryGroupMap (ι := Fin n) S.subtype)
    (compressorOf_conj_root P hn i j hij a)
  rw [map_mul, map_mul, map_inv, elementaryGroupMap_elementaryRoot,
    elementaryGroupMap_elementaryRoot] at h
  rw [subringCompressor, subringCoreEmbedding_elementaryRoot,
    subringCoreEmbedding_elementaryRoot]
  exact h

/-- Whatever holds of every conjugated core root holds of every conjugated
element of the embedded `EL₃(S)`. -/
theorem conj_subringCoreEmbedding_mem (S : Subring R) (P : OneSidedInverse ↥S)
    (hn : 4 ≤ n) (H : Subgroup (elementaryGroup (Fin n) R))
    (hgen : ∀ (i j : Fin 3) (hij : i ≠ j) (a : ↥S),
      subringCompressor S P hn *
        subringCoreEmbedding S hn (elementaryRoot i j hij a) *
        (subringCompressor S P hn)⁻¹ ∈ H)
    (x : elementaryGroup (Fin 3) ↥S) :
    subringCompressor S P hn * subringCoreEmbedding S hn x *
      (subringCompressor S P hn)⁻¹ ∈ H := by
  obtain ⟨x, hx⟩ := x
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
      obtain ⟨i, j, hij, a, rfl⟩ := hy
      exact hgen i j hij a
  | one =>
      rw [show (⟨1, Subgroup.one_mem _⟩ : elementaryGroup (Fin 3) ↥S) = 1 from rfl,
        map_one, mul_one, mul_inv_cancel]
      exact H.one_mem
  | mul y z hy hz ihy ihz =>
      rw [show (⟨y * z, Subgroup.mul_mem _ hy hz⟩ : elementaryGroup (Fin 3) ↥S)
          = ⟨y, hy⟩ * ⟨z, hz⟩ from rfl, map_mul]
      have h : subringCompressor S P hn *
            (subringCoreEmbedding S hn ⟨y, hy⟩ * subringCoreEmbedding S hn ⟨z, hz⟩) *
            (subringCompressor S P hn)⁻¹ =
          (subringCompressor S P hn * subringCoreEmbedding S hn ⟨y, hy⟩ *
              (subringCompressor S P hn)⁻¹) *
            (subringCompressor S P hn * subringCoreEmbedding S hn ⟨z, hz⟩ *
              (subringCompressor S P hn)⁻¹) := by group
      rw [h]
      exact H.mul_mem ihy ihz
  | inv y hy ihy =>
      rw [show (⟨y⁻¹, Subgroup.inv_mem _ hy⟩ : elementaryGroup (Fin 3) ↥S)
          = (⟨y, hy⟩ : elementaryGroup (Fin 3) ↥S)⁻¹ from rfl, map_inv]
      have h : subringCompressor S P hn * (subringCoreEmbedding S hn ⟨y, hy⟩)⁻¹ *
            (subringCompressor S P hn)⁻¹ =
          (subringCompressor S P hn * subringCoreEmbedding S hn ⟨y, hy⟩ *
            (subringCompressor S P hn)⁻¹)⁻¹ := by group
      rw [h]
      exact H.inv_mem ihy

end Subring

end OneSidedCompressorStrict

namespace Manuscript
namespace OneSidedMFRadical
namespace FullDefectRing

open OneSidedCompressor OneSidedCompressorStrict

/-- **The compressor calculation of `cor:one-sided-ring-maximal`.**  For a
countable ring with a one-sided inverse pair `ts = 1 ≠ st`, every rank `n ≥ 4`
carries a property-`(T)` subgroup of `EL_n(R)` strictly compressed by a single
element: the copy of `EL₃(S)` on the core coordinates, for `S` the subring
generated by `s` and `t`, compressed by the printed compressor `u`.

Containment is `compressorOf_conj_root`, the printed `u e_{ij}(a) u⁻¹ =
e_{ij}(sat)`, which stays inside `S` because `s, t ∈ S`.  Strictness is the
left probe by `e = 1 - st` on the middle core row: it annihilates every `sat`
because `es = 0`, and it does not annihilate `1` because `st ≠ 1`. -/
theorem oneSidedCompressorStrictContainment : OneSidedCompressorStrictContainment := by
  classical
  intro R _ _ s t hts hst hT n hn
  -- The finitely generated subring the printed proof passes to.
  obtain ⟨S, hsS, htS, hfg⟩ :
      ∃ S : Subring R, s ∈ S ∧ t ∈ S ∧ IsFinitelyGeneratedRing ↥S := by
    refine ⟨Subring.closure ((({s, t} : Finset R) : Finset R) : Set R), ?_, ?_,
      isFinitelyGeneratedRing_subringClosure _⟩
    · exact Subring.subset_closure (by simp)
    · exact Subring.subset_closure (by simp)
  have hT3 : HasKazhdanPropertyT.{0, 0} (elementaryGroup (Fin 3) ↥S) :=
    hT S hfg 3 le_rfl
  -- The one-sided inverse pair, inside `S`.
  have hts' : (⟨t, htS⟩ : ↥S) * ⟨s, hsS⟩ = 1 := Subtype.ext hts
  let P : OneSidedInverse ↥S := ⟨⟨s, hsS⟩, ⟨t, htS⟩, hts'⟩
  have hPcoe : ((P.e : ↥S) : R) = 1 - s * t := by
    show ((1 - (⟨s, hsS⟩ : ↥S) * ⟨t, htS⟩ : ↥S) : R) = 1 - s * t
    push_cast
    rfl
  have hPne : ((P.e : ↥S) : R) ≠ 0 := by
    rw [hPcoe]
    intro h0
    apply hst
    have h1 : s * t = 1 - (1 - s * t) := by abel
    rw [h1, h0, sub_zero]
  -- The two printed indices on the middle core row.
  have hI12 : bigIdx hn (coreIdx 1) ≠ bigIdx hn (coreIdx (2 : Fin 3)) :=
    (bigIdx_injective hn).ne (coreIdx_injective.ne oneNeTwo)
  refine ⟨(subringCoreEmbedding S hn).range, subringCompressor S P hn, ?_, ?_⟩
  · exact HasKazhdanPropertyT.of_surjective
      (subringCoreEmbedding S hn).rangeRestrict
      (MonoidHom.rangeRestrict_surjective _) hT3
  -- Containment, then strictness.
  have hcompress : ∀ x : elementaryGroup (Fin 3) ↥S,
      subringCompressor S P hn * subringCoreEmbedding S hn x *
        (subringCompressor S P hn)⁻¹ ∈ (subringCoreEmbedding S hn).range := by
    refine conj_subringCoreEmbedding_mem S P hn _ ?_
    intro i j hij a
    rw [subringCompressor_conj_root]
    exact ⟨_, rfl⟩
  have hprobe : ∀ x : elementaryGroup (Fin 3) ↥S,
      subringCompressor S P hn * subringCoreEmbedding S hn x *
        (subringCompressor S P hn)⁻¹ ∈
          probeStabilizer ((P.e : ↥S) : R) (bigIdx hn (coreIdx 1)) := by
    refine conj_subringCoreEmbedding_mem S P hn _ ?_
    intro i j hij a
    rw [subringCompressor_conj_root, subringCoreEmbedding_elementaryRoot]
    by_cases hi : i = 1
    · subst hi
      refine elementaryRoot_mem_probeStabilizer_of_mul_eq_zero _ _ _ _ _ ?_
      have h : P.e * (P.s * a * P.t) = 0 := by
        rw [← mul_assoc, ← mul_assoc, P.e_mul_s, zero_mul, zero_mul]
      show ((P.e : ↥S) : R) * ((P.s * a * P.t : ↥S) : R) = 0
      rw [show ((P.e : ↥S) : R) * ((P.s * a * P.t : ↥S) : R)
          = ((P.e * (P.s * a * P.t) : ↥S) : R) from rfl, h]
      rfl
    · refine elementaryRoot_mem_probeStabilizer_of_row_ne _ _ _ _ _ _ ?_
      exact fun hcon ↦ hi
        (coreIdx_injective ((bigIdx_injective hn) hcon)).symm
  have hwitness : subringCoreEmbedding S hn
      (elementaryRoot (1 : Fin 3) 2 oneNeTwo (1 : ↥S)) =
        elementaryRoot (bigIdx hn (coreIdx 1)) (bigIdx hn (coreIdx (2 : Fin 3)))
          hI12 (1 : R) := by
    rw [subringCoreEmbedding_elementaryRoot]
    simp
  refine lt_of_le_of_ne ?_ ?_
  · rintro g ⟨y, ⟨x, rfl⟩, rfl⟩
    have h := hcompress x
    simpa [MulAut.conj_apply] using h
  · intro heq
    have hmem : subringCoreEmbedding S hn
        (elementaryRoot (1 : Fin 3) 2 oneNeTwo (1 : ↥S)) ∈
          (subringCoreEmbedding S hn).range := ⟨_, rfl⟩
    rw [← heq] at hmem
    obtain ⟨y, hy, hyeq⟩ := hmem
    obtain ⟨x, rfl⟩ := hy
    have hx := hprobe x
    have hconj : (MulAut.conj (subringCompressor S P hn)).toMonoidHom
        (subringCoreEmbedding S hn x)
        = subringCompressor S P hn * subringCoreEmbedding S hn x *
          (subringCompressor S P hn)⁻¹ := by
      simp [MulAut.conj_apply]
    rw [hconj] at hyeq
    rw [hyeq, hwitness] at hx
    exact elementaryRoot_one_not_mem_probeStabilizer _ _ _ hI12 hPne hx

end FullDefectRing
end OneSidedMFRadical
end Manuscript
