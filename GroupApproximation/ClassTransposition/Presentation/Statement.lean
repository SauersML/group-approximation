import Mathlib

/-!
# Kourovka Notebook Problem 17.61: definitions

Kohl's group `CT_P(ℤ)` for a set `P` of primes, and the statement of Kourovka 17.61. The three
definitions are copied verbatim (v3, `P : Set ℕ`) from the Boone–Higman challenge file
`Palomar/BooneHigmanChallenge.lean`, so the challenge theorem `kourovka_17_61` can be proved from
`kourovka1761Statement` by `exact`.
-/

namespace GroupApproximation.ClassTransposition.Presentation

/-- `m` has no prime factor outside `P ∪ {2}`. -/
def IsSmoothModulus (P : Set ℕ) (m : ℤ) : Prop :=
  ∀ p : ℕ, p.Prime → (p : ℤ) ∣ m → p = 2 ∨ p ∈ P

/-- `g` is a class transposition (as in `IsClassTransposition`) of two residue classes whose
moduli have only prime factors in `P ∪ {2}`. -/
def IsClassTranspositionOver (P : Set ℕ) (g : Equiv.Perm ℤ) : Prop :=
  ∃ r₁ m₁ r₂ m₂ : ℤ, IsSmoothModulus P m₁ ∧ IsSmoothModulus P m₂ ∧
    0 ≤ r₁ ∧ r₁ < m₁ ∧ 0 ≤ r₂ ∧ r₂ < m₂ ∧
    (∀ t₁ t₂ : ℤ, r₁ + t₁ * m₁ ≠ r₂ + t₂ * m₂) ∧
    (∀ t : ℤ, g (r₁ + t * m₁) = r₂ + t * m₂ ∧
      g (r₂ + t * m₂) = r₁ + t * m₁) ∧
    ∀ n : ℤ, (∀ t : ℤ, n ≠ r₁ + t * m₁) → (∀ t : ℤ, n ≠ r₂ + t * m₂) →
      g n = n

/-- Kohl's group `CT_P(ℤ)`, generated by the class transpositions over `P`. -/
def classTranspositionGroupOver (P : Set ℕ) : Subgroup (Equiv.Perm ℤ) :=
  Subgroup.closure {g | IsClassTranspositionOver P g}

/-- **Kourovka 17.61** (S. Kohl), exactly as in the challenge file: for every finite set `P` of
odd primes, `CT_P(ℤ)` is finitely presented. -/
def kourovka1761Statement : Prop :=
  ∀ P : Set ℕ, P.Finite → (∀ p ∈ P, p.Prime ∧ p ≠ 2) →
    Group.IsFinitelyPresented (classTranspositionGroupOver P)

end GroupApproximation.ClassTransposition.Presentation
