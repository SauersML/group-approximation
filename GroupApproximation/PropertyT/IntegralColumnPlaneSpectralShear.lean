import GroupApproximation.Analysis.RepresentedRootPlaneSpectralQuasiInvariant
import GroupApproximation.PropertyT.IntegralColumnPlaneRootReduction
import GroupApproximation.PropertyT.IntegralColumnPlaneSpectralMeasure

/-!
# Elementary-shear covariance of the integral column-plane measure

The unit and generator shears in roots `(0,1)` and `(1,0)` normalize the
common-terminal column plane.  They therefore preserve its represented
commutative C-star algebra, and near invariance under the integral control set
gives measurable quadratic quasi-invariance of its scalar spectral measure.

The remaining analytic step is the uniform finite-degree torus/valuation mass
estimate; no version of that estimate is assumed here.
-/

namespace GroupApproximation
namespace IntegralColumnPlaneSpectralShear

open WeakDual MeasureTheory
open IntegralCharacterMass IntegralColumnPlaneRootReduction
open IntegralColumnPlaneSpectralMeasure
open RepresentedRootPlaneSpectralMeasure
open RepresentedRootPlaneSpectralQuasiInvariant

noncomputable section

universe u v

def upperShear {R : Type u} [Ring R] (r : R) :
    elementaryGroup (Fin 3) R :=
  elementaryRoot 0 1 (by decide) r

def lowerShear {R : Type u} [Ring R] (r : R) :
    elementaryGroup (Fin 3) R :=
  elementaryRoot 1 0 (by decide) r

@[simp] theorem upperShear_inv {R : Type u} [Ring R] (r : R) :
    (upperShear r)⁻¹ = upperShear (-r) := by
  simp [upperShear]

@[simp] theorem lowerShear_inv {R : Type u} [Ring R] (r : R) :
    (lowerShear r)⁻¹ = lowerShear (-r) := by
  simp [lowerShear]

/-- Exact upper-shear action on either coordinate root. -/
theorem upperShear_conjugate_columnRoot {R : Type u} [Ring R]
    (r : R) (q : Fin 2 × R) :
    upperShear r * columnRoot q * (upperShear r)⁻¹ =
      if q.1 = 0 then columnRoot q
      else columnRoot (0, r * q.2) * columnRoot q := by
  rcases q with ⟨b, a⟩
  fin_cases b
  · simp only [Fin.isValue, Fin.zero_eta]
    have hcomm := elementaryRoot_commute_of_ne
      (0 : Fin 3) 1 0 2 (by decide) (by decide)
      (by decide) (by decide) r a
    simp [upperShear, columnRoot, columnSource, hcomm.eq]
  · simp only [Fin.isValue, Fin.mk_one]
    simpa [upperShear, columnRoot, columnSource] using
      elementaryRoot_conjugate (R := R) (0 : Fin 3) 1 2
        (by decide) (by decide) (by decide) r a

/-- Exact lower-shear action on either coordinate root. -/
theorem lowerShear_conjugate_columnRoot {R : Type u} [Ring R]
    (r : R) (q : Fin 2 × R) :
    lowerShear r * columnRoot q * (lowerShear r)⁻¹ =
      if q.1 = 1 then columnRoot q
      else columnRoot (1, r * q.2) * columnRoot q := by
  rcases q with ⟨b, a⟩
  fin_cases b
  · simp only [Fin.isValue, Fin.zero_eta]
    simpa [lowerShear, columnRoot, columnSource] using
      elementaryRoot_conjugate (R := R) (1 : Fin 3) 0 2
        (by decide) (by decide) (by decide) r a
  · simp only [Fin.isValue, Fin.mk_one]
    have hcomm := elementaryRoot_commute_of_ne
      (1 : Fin 3) 0 1 2 (by decide) (by decide)
      (by decide) (by decide) r a
    simp [lowerShear, columnRoot, columnSource, hcomm.eq]

/-- Generator preservation under unitary conjugation extends to the closed
represented algebra generated by those operators. -/
theorem conj_mem_algebra_of_generators_mem
    {G : Type u} [Group G] {I : Type*}
    {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H]
    (P : RepresentedAbelianPlane G I H) (u : unitary (H →L[ℂ] H))
    (hgenerator : ∀ i,
      Unitary.conjStarAlgAut ℂ (H →L[ℂ] H) u
        (P.representedOperator i) ∈ P.algebra) :
    ∀ x : P.algebra,
      Unitary.conjStarAlgAut ℂ (H →L[ℂ] H) u x.1 ∈ P.algebra := by
  let T : StarSubalgebra ℂ (H →L[ℂ] H) :=
    StarSubalgebra.comap
      (Unitary.conjStarAlgAut ℂ (H →L[ℂ] H) u).toStarAlgHom P.algebra
  have hgen : StarAlgebra.adjoin ℂ P.generatorSet ≤ T := by
    apply StarAlgebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    exact hgenerator i
  have hclosed : IsClosed (T : Set (H →L[ℂ] H)) := by
    change IsClosed
      ((fun x : H →L[ℂ] H ↦
        Unitary.conjStarAlgAut ℂ (H →L[ℂ] H) u x) ⁻¹'
          (P.algebra : Set (H →L[ℂ] H)))
    apply (StarSubalgebra.isClosed_topologicalClosure _).preimage
    change Continuous (fun x : H →L[ℂ] H ↦
      (u : H →L[ℂ] H) * x * star (u : H →L[ℂ] H))
    have hleft : Continuous (fun x : H →L[ℂ] H ↦
        (u : H →L[ℂ] H) * x) :=
      continuous_const.mul continuous_id
    exact hleft.mul continuous_const
  intro x
  exact StarSubalgebra.topologicalClosure_minimal hgen hclosed x.property

variable {R : Type u} [Ring R]
variable {E : Type v} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [CompleteSpace E]

variable (rho : elementaryGroup (Fin 3) R →* (E ≃ₗᵢ[ℝ] E))

private abbrev P := representedColumnPlane rho

noncomputable local instance representedColumnPlaneCharacterMeasurableSpace :
    MeasurableSpace (characterSpace ℂ (P rho).algebra) :=
  borel _

local instance representedColumnPlaneCharacterBorelSpace :
    BorelSpace (characterSpace ℂ (P rho).algebra) :=
  ⟨rfl⟩

theorem upperShear_forward (r : R) :
    ∀ x : (P rho).algebra,
      Unitary.conjStarAlgAut ℂ (Complexification E →L[ℂ] Complexification E)
        ((P rho).rho (upperShear r)) x.1 ∈ (P rho).algebra := by
  apply conj_mem_algebra_of_generators_mem
  intro q
  change Unitary.conjStarAlgAut ℂ
      (Complexification E →L[ℂ] Complexification E)
      ((P rho).rho (upperShear r))
      ((P rho).rho (columnRoot q) :
        Complexification E →L[ℂ] Complexification E) ∈ (P rho).algebra
  rw [CommutativeCStarCovariance.conjStarAlgAut_representation_apply,
    upperShear_conjugate_columnRoot]
  split_ifs
  · exact ((P rho).coordinate q).property
  · rw [map_mul]
    exact (P rho).algebra.mul_mem
      ((P rho).coordinate (0, r * q.2)).property
      ((P rho).coordinate q).property

theorem upperShear_backward (r : R) :
    ∀ x : (P rho).algebra,
      (Unitary.conjStarAlgAut ℂ
        (Complexification E →L[ℂ] Complexification E)
        ((P rho).rho (upperShear r))).symm x.1 ∈ (P rho).algebra := by
  rw [Unitary.conjStarAlgAut_symm]
  have hu : star ((P rho).rho (upperShear r)) =
      (P rho).rho (upperShear (-r)) := by
    rw [Unitary.star_eq_inv, ← map_inv, upperShear_inv]
  rw [hu]
  exact upperShear_forward rho (-r)

theorem lowerShear_forward (r : R) :
    ∀ x : (P rho).algebra,
      Unitary.conjStarAlgAut ℂ (Complexification E →L[ℂ] Complexification E)
        ((P rho).rho (lowerShear r)) x.1 ∈ (P rho).algebra := by
  apply conj_mem_algebra_of_generators_mem
  intro q
  change Unitary.conjStarAlgAut ℂ
      (Complexification E →L[ℂ] Complexification E)
      ((P rho).rho (lowerShear r))
      ((P rho).rho (columnRoot q) :
        Complexification E →L[ℂ] Complexification E) ∈ (P rho).algebra
  rw [CommutativeCStarCovariance.conjStarAlgAut_representation_apply,
    lowerShear_conjugate_columnRoot]
  split_ifs
  · exact ((P rho).coordinate q).property
  · rw [map_mul]
    exact (P rho).algebra.mul_mem
      ((P rho).coordinate (1, r * q.2)).property
      ((P rho).coordinate q).property

theorem lowerShear_backward (r : R) :
    ∀ x : (P rho).algebra,
      (Unitary.conjStarAlgAut ℂ
        (Complexification E →L[ℂ] Complexification E)
        ((P rho).rho (lowerShear r))).symm x.1 ∈ (P rho).algebra := by
  rw [Unitary.conjStarAlgAut_symm]
  have hu : star ((P rho).rho (lowerShear r)) =
      (P rho).rho (lowerShear (-r)) := by
    rw [Unitary.star_eq_inv, ← map_inv, lowerShear_inv]
  rw [hu]
  exact lowerShear_forward rho (-r)

variable (X : Type u) [Fintype X]

/-- Quasi-invariance under every upper unit/generator shear in the integral
control set. -/
theorem upperShear_measurableQuasiInvariantAtScale
    (rho : elementaryGroup (Fin 3) (FreeAlgebra ℤ X) →* (E ≃ₗᵢ[ℝ] E))
    (z : E) (hz : ‖z‖ = 1) (delta : ℝ) (hdelta : 0 < delta)
    (hnear : ∀ s ∈ integralControlSet X, ‖rho s z - z‖ < delta)
    (q : Option X) :
    KassabovBorelMeasureInequalities.MeasurableQuasiInvariantAtScale
      (CommutativeStateSpectralMeasure.stateSpectralMeasure
        ((P rho).vectorState (Complexification.mk z 0)
          (norm_mk_zero_eq_one hz))) delta
      (CommutativeCStarCovariance.characterHomeomorph (P rho).algebra
        ((P rho).rho (upperShear (integralControlCoefficient X q)))
        (upperShear_forward rho _) (upperShear_backward rho _)) := by
  apply measurableQuasiInvariantAtScale_characterHomeomorph
    (P rho) (Complexification.mk z 0) (norm_mk_zero_eq_one hz)
      ((P rho).rho (upperShear (integralControlCoefficient X q)))
      (upperShear_forward rho _) (upperShear_backward rho _) hdelta.le
  change ‖RealToComplexUnitaryRepresentation.complexifiedOperatorRepresentation rho
      (upperShear (integralControlCoefficient X q))
        (Complexification.mk z 0) - Complexification.mk z 0‖ ≤ delta
  rw [RealToComplexUnitaryRepresentation.norm_complexified_displacement_mk_zero]
  have hmem : upperShear (integralControlCoefficient X q) ∈
      integralControlSet X := by
    let a : A2Root := ⟨((0 : Fin 3), (1 : Fin 3)), by decide⟩
    simpa [upperShear, integralControlElement, a] using
      integralControlElement_mem X (a, q)
  exact (hnear _ hmem).le

/-- Quasi-invariance under every lower unit/generator shear in the integral
control set. -/
theorem lowerShear_measurableQuasiInvariantAtScale
    (rho : elementaryGroup (Fin 3) (FreeAlgebra ℤ X) →* (E ≃ₗᵢ[ℝ] E))
    (z : E) (hz : ‖z‖ = 1) (delta : ℝ) (hdelta : 0 < delta)
    (hnear : ∀ s ∈ integralControlSet X, ‖rho s z - z‖ < delta)
    (q : Option X) :
    KassabovBorelMeasureInequalities.MeasurableQuasiInvariantAtScale
      (CommutativeStateSpectralMeasure.stateSpectralMeasure
        ((P rho).vectorState (Complexification.mk z 0)
          (norm_mk_zero_eq_one hz))) delta
      (CommutativeCStarCovariance.characterHomeomorph (P rho).algebra
        ((P rho).rho (lowerShear (integralControlCoefficient X q)))
        (lowerShear_forward rho _) (lowerShear_backward rho _)) := by
  apply measurableQuasiInvariantAtScale_characterHomeomorph
    (P rho) (Complexification.mk z 0) (norm_mk_zero_eq_one hz)
      ((P rho).rho (lowerShear (integralControlCoefficient X q)))
      (lowerShear_forward rho _) (lowerShear_backward rho _) hdelta.le
  change ‖RealToComplexUnitaryRepresentation.complexifiedOperatorRepresentation rho
      (lowerShear (integralControlCoefficient X q))
        (Complexification.mk z 0) - Complexification.mk z 0‖ ≤ delta
  rw [RealToComplexUnitaryRepresentation.norm_complexified_displacement_mk_zero]
  have hmem : lowerShear (integralControlCoefficient X q) ∈
      integralControlSet X := by
    let a : A2Root := ⟨((1 : Fin 3), (0 : Fin 3)), by decide⟩
    simpa [lowerShear, integralControlElement, a] using
      integralControlElement_mem X (a, q)
  exact (hnear _ hmem).le

/-- Quasi-invariance under the inverse upper unit shear follows from the
same control element, since an orthogonal operator and its inverse have the
same displacement. -/
theorem upperShear_neg_one_measurableQuasiInvariantAtScale
    (rho : elementaryGroup (Fin 3) (FreeAlgebra ℤ X) →* (E ≃ₗᵢ[ℝ] E))
    (z : E) (hz : ‖z‖ = 1) (delta : ℝ) (hdelta : 0 < delta)
    (hnear : ∀ s ∈ integralControlSet X, ‖rho s z - z‖ < delta) :
    KassabovBorelMeasureInequalities.MeasurableQuasiInvariantAtScale
      (CommutativeStateSpectralMeasure.stateSpectralMeasure
        ((P rho).vectorState (Complexification.mk z 0)
          (norm_mk_zero_eq_one hz))) delta
      (CommutativeCStarCovariance.characterHomeomorph (P rho).algebra
        ((P rho).rho (upperShear (-1)))
        (upperShear_forward rho (-1)) (upperShear_backward rho (-1))) := by
  apply measurableQuasiInvariantAtScale_characterHomeomorph
    (P rho) (Complexification.mk z 0) (norm_mk_zero_eq_one hz)
      ((P rho).rho (upperShear (-1)))
      (upperShear_forward rho (-1)) (upperShear_backward rho (-1)) hdelta.le
  change ‖RealToComplexUnitaryRepresentation.complexifiedOperatorRepresentation rho
      (upperShear (-1))
        (Complexification.mk z 0) - Complexification.mk z 0‖ ≤ delta
  rw [RealToComplexUnitaryRepresentation.norm_complexified_displacement_mk_zero]
  rw [← upperShear_inv (1 : FreeAlgebra ℤ X),
    IntegralCharacterMass.norm_inv_displacement]
  have hmem : upperShear (1 : FreeAlgebra ℤ X) ∈ integralControlSet X := by
    let a : A2Root := ⟨((0 : Fin 3), (1 : Fin 3)), by decide⟩
    simpa [upperShear, integralControlElement, integralControlCoefficient, a]
      using integralControlElement_mem X (a, none)
  exact (hnear _ hmem).le

/-- Quasi-invariance under the inverse lower unit shear follows from the
same control element, since an orthogonal operator and its inverse have the
same displacement. -/
theorem lowerShear_neg_one_measurableQuasiInvariantAtScale
    (rho : elementaryGroup (Fin 3) (FreeAlgebra ℤ X) →* (E ≃ₗᵢ[ℝ] E))
    (z : E) (hz : ‖z‖ = 1) (delta : ℝ) (hdelta : 0 < delta)
    (hnear : ∀ s ∈ integralControlSet X, ‖rho s z - z‖ < delta) :
    KassabovBorelMeasureInequalities.MeasurableQuasiInvariantAtScale
      (CommutativeStateSpectralMeasure.stateSpectralMeasure
        ((P rho).vectorState (Complexification.mk z 0)
          (norm_mk_zero_eq_one hz))) delta
      (CommutativeCStarCovariance.characterHomeomorph (P rho).algebra
        ((P rho).rho (lowerShear (-1)))
        (lowerShear_forward rho (-1)) (lowerShear_backward rho (-1))) := by
  apply measurableQuasiInvariantAtScale_characterHomeomorph
    (P rho) (Complexification.mk z 0) (norm_mk_zero_eq_one hz)
      ((P rho).rho (lowerShear (-1)))
      (lowerShear_forward rho (-1)) (lowerShear_backward rho (-1)) hdelta.le
  change ‖RealToComplexUnitaryRepresentation.complexifiedOperatorRepresentation rho
      (lowerShear (-1))
        (Complexification.mk z 0) - Complexification.mk z 0‖ ≤ delta
  rw [RealToComplexUnitaryRepresentation.norm_complexified_displacement_mk_zero]
  rw [← lowerShear_inv (1 : FreeAlgebra ℤ X),
    IntegralCharacterMass.norm_inv_displacement]
  have hmem : lowerShear (1 : FreeAlgebra ℤ X) ∈ integralControlSet X := by
    let a : A2Root := ⟨((1 : Fin 3), (0 : Fin 3)), by decide⟩
    simpa [lowerShear, integralControlElement, integralControlCoefficient, a]
      using integralControlElement_mem X (a, none)
  exact (hnear _ hmem).le

end
end IntegralColumnPlaneSpectralShear
