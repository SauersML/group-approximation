import GroupApproximation.PropertyT.IntegralCharacterMass
import GroupApproximation.Kazhdan.HilbertConvexFixedPoint

/-!
# Reducing the integral column-plane estimate to uniform displacement

`IntegralCharacterMass.ColumnPlaneMassBound` asks for a bound on the norm of
the orthogonal projection onto the moving subspace of a two-root subgroup.
The integral Fourier argument that should produce that bound is still absent.
This file makes the remaining target more elementary without assuming it:
the projection bound is equivalent, up to the universal factor two, to a
uniform displacement bound for every element of the two-root subgroup.

The nontrivial direction is Hilbert-space geometry.  If every point in the
orbit of `x` lies within `delta` of `x`, the point of least norm in the closed
convex hull of the orbit is subgroup-fixed and still lies within `delta` of
`x`.  Contractivity of orthogonal projection then bounds the moving component
of `x`.  This is precisely the closed-convex-hull argument already proved in
`Kazhdan/HilbertConvexFixedPoint.lean`.

Thus the missing integral input may be attacked without constructing or
estimating a projection: it is enough to prove a dimension-free displacement
bound for the additive two-root subgroup.  Conversely, the existing elementary
displacement inequality recovers such a bound from the projection estimate.
No characteristic, finiteness, or literature hypothesis occurs here.
-/

namespace GroupApproximation

universe u v

namespace IntegralColumnPlaneReduction

open IntegralCharacterMass

variable {G : Type u} [Group G]
variable {E : Type v} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Uniform displacement by a subgroup bounds the moving component of the
vector by the same constant.  The fixed vector supplied by the closed convex
hull of the orbit is used as a comparison point for the orthogonal
projection. -/
theorem norm_subgroupMovingProjection_le_of_displacement_le [CompleteSpace E]
    (rho : G →* (E ≃ₗᵢ[ℝ] E)) (H : Subgroup G) (x : E) {delta : ℝ}
    (hbound : ∀ h : H, ‖rho h.1 x - x‖ ≤ delta) :
    ‖KazhdanFixedSpace.subgroupMovingProjection rho H x‖ ≤ delta := by
  obtain ⟨y, hyfixed, hynear⟩ :=
    HilbertConvexFixedPoint.exists_near_fixedSubspace rho H x hbound
  have hyzero : KazhdanFixedSpace.subgroupMovingProjection rho H y = 0 :=
    KazhdanFixedSpace.subgroupMovingProjection_eq_zero_of_mem rho H hyfixed
  calc
    ‖KazhdanFixedSpace.subgroupMovingProjection rho H x‖ =
        ‖KazhdanFixedSpace.subgroupMovingProjection rho H (x - y)‖ := by
          rw [map_sub, hyzero, sub_zero]
    _ ≤ ‖x - y‖ :=
      KazhdanFixedSpace.norm_subgroupMovingProjection_le rho H (x - y)
    _ = ‖y - x‖ := norm_sub_rev x y
    _ ≤ delta := hynear

/-- A projection-free version of the column-plane estimate.  Near invariance
under `S` must uniformly control displacement by every element of each subgroup
generated by two roots with a common terminal index. -/
def ColumnPlaneDisplacementBound (R : Type u) [Ring R]
    (S : Finset (elementaryGroup (Fin 3) R)) (C : ℝ) : Prop :=
  ∀ (E : Type v) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E],
    ∀ (rho : elementaryGroup (Fin 3) R →* (E ≃ₗᵢ[ℝ] E)) (z : E) (delta : ℝ),
      0 < delta → (∀ s ∈ S, ‖rho s z - z‖ < delta) →
        ∀ (i j k : Fin 3) (_hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k),
          ∀ h : elementaryGroup (Fin 3) R,
            h ∈ (elementaryRootSubgroup i k hik ⊔
              elementaryRootSubgroup j k hjk) →
                ‖rho h z - z‖ ≤ C * delta

/-- A uniform displacement estimate for the two-root subgroups implies the
column-plane moving-projection estimate with no loss in the constant. -/
theorem columnPlaneMassBound_of_displacementBound
    {R : Type u} [Ring R] {S : Finset (elementaryGroup (Fin 3) R)} {C : ℝ}
    (hbound : ColumnPlaneDisplacementBound.{u, v} R S C) :
    ColumnPlaneMassBound.{u, v} R S C := by
  intro E _ _ _ rho z delta hdelta hnear i j k hij hik hjk
  apply norm_subgroupMovingProjection_le_of_displacement_le
  intro h
  exact hbound E rho z delta hdelta hnear i j k hij hik hjk h.1 h.property

/-- The column-plane moving-projection estimate controls displacement by every
element of the two-root subgroup, with only the universal factor two. -/
theorem displacementBound_of_columnPlaneMassBound
    {R : Type u} [Ring R] {S : Finset (elementaryGroup (Fin 3) R)} {C : ℝ}
    (hplane : ColumnPlaneMassBound.{u, v} R S C) :
    ColumnPlaneDisplacementBound.{u, v} R S (2 * C) := by
  intro E _ _ _ rho z delta hdelta hnear i j k hij hik hjk h hh
  let H : Subgroup (elementaryGroup (Fin 3) R) :=
    elementaryRootSubgroup i k hik ⊔ elementaryRootSubgroup j k hjk
  have hprojection :
      ‖KazhdanFixedSpace.subgroupMovingProjection rho H z‖ ≤ C * delta :=
    hplane E rho z delta hdelta hnear i j k hij hik hjk
  calc
    ‖rho h z - z‖ ≤
        2 * ‖KazhdanFixedSpace.subgroupMovingProjection rho H z‖ :=
      KazhdanFixedSpace.norm_displacement_le_two_mul_norm_subgroupMovingProjection_of_mem
        rho H hh z
    _ ≤ 2 * (C * delta) := mul_le_mul_of_nonneg_left hprojection (by norm_num)
    _ = (2 * C) * delta := by ring

/-- Existence of a column-plane mass bound is equivalent to existence of a
uniform displacement bound for the same two-root subgroups.  The constants may
differ by the universal factor two. -/
theorem exists_columnPlaneMassBound_iff_exists_displacementBound
    (R : Type u) [Ring R] (S : Finset (elementaryGroup (Fin 3) R)) :
    (∃ C : ℝ, ColumnPlaneMassBound.{u, v} R S C) ↔
      ∃ C : ℝ, ColumnPlaneDisplacementBound.{u, v} R S C := by
  constructor
  · rintro ⟨C, hC⟩
    exact ⟨2 * C, displacementBound_of_columnPlaneMassBound hC⟩
  · rintro ⟨C, hC⟩
    exact ⟨C, columnPlaneMassBound_of_displacementBound hC⟩

/-- The exact remaining integral input, in projection-free form.  This is a
specialization of `exists_columnPlaneMassBound_iff_exists_displacementBound` to
the free integral algebra and its finite control set; it introduces no
hypothesis. -/
theorem integral_exists_columnPlaneMassBound_iff_exists_displacementBound
    (X : Type u) [Fintype X] :
    (∃ C : ℝ, ColumnPlaneMassBound.{u, v} (FreeAlgebra ℤ X)
        (integralControlSet X) C) ↔
      ∃ C : ℝ, ColumnPlaneDisplacementBound.{u, v} (FreeAlgebra ℤ X)
        (integralControlSet X) C :=
  exists_columnPlaneMassBound_iff_exists_displacementBound
    (FreeAlgebra ℤ X) (integralControlSet X)

end IntegralColumnPlaneReduction

end GroupApproximation
