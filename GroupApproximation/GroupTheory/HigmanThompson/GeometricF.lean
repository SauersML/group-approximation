import Mathlib.Tactic.LinearCombination
import GroupApproximation.GroupTheory.HigmanThompson.GridAffine
import GroupApproximation.GroupTheory.HigmanThompson.UniformWords
import GroupApproximation.Meta.AxiomGuard

/-!
# Geometric `F_{n,∞}` is generated by the `x_k`

`geoF m` is the geometric group of the half line: piecewise linear permutations of `ℚ`
over `(ℤ[1/n], n^ℤ)` (`n = m + 2`) that fix `(-∞, 0]` pointwise and are eventually an
integer translation.  This module proves `geoF m = brownF m`
(`geoF_eq_brownF`): the geometric group is the subgroup generated by Brown's
generators, hence finitely presented (`geoF_isFinitelyPresented`).

* `brownF_le_geoF`: each `x_k` is geometric (`xg_mem_geoF`).
* `geoF_le_brownF`: conjugate a geometric `f` by uniform subdivisions `U` (depth `N`, the
  grid level of `f`) and `V` (depth `N + B`, adding the value bound).  On each unit
  interval `[j, j+1]` the conjugate `V f U⁻¹` is affine with slope a nonnegative power of
  `n` and sends integers to integers, so it has the shape of a `wword`
  (`exists_wword_of_shape`), and `f = V⁻¹ · wword · U` is a product of generators.
-/

namespace GroupApproximation
namespace HigmanThompson

instance factOneLtAddTwo (m : ℕ) : Fact (1 < m + 2) := ⟨by omega⟩

variable (m : ℕ)

/-- The slopes `n^k`, `k ∈ ℤ`, `n = m + 2`. -/
def powSlopes : Submonoid ℚ where
  carrier := {q | ∃ k : ℤ, q = ((m : ℚ) + 2) ^ k}
  mul_mem' := by
    rintro a b ⟨i, rfl⟩ ⟨j, rfl⟩
    exact ⟨i + j, (zpow_add₀ mTwo_pos.ne' i j).symm⟩
  one_mem' := ⟨0, by simp⟩

/-- **Geometric `F_{m+2,∞}`.** -/
def geoF : Subgroup (Equiv.Perm ℚ) where
  carrier := {f | f ∈ PLGroup (m + 2) (powSlopes m) ∧ (∀ t : ℚ, t ≤ 0 → f t = t) ∧
    ∃ T : ℕ, ∃ c : ℤ, ∀ t : ℚ, (T : ℚ) ≤ t → f t = t + c}
  one_mem' := ⟨(PLGroup (m + 2) (powSlopes m)).one_mem, fun _ _ => rfl,
    ⟨0, 0, fun t _ => by simp⟩⟩
  mul_mem' := by
    rintro f g ⟨hf, hf0, Tf, cf, hfT⟩ ⟨hg, hg0, Tg, cg, hgT⟩
    refine ⟨(PLGroup (m + 2) (powSlopes m)).mul_mem hf hg, fun t ht => ?_,
      Tg + Tf + cg.natAbs, cf + cg, fun t ht => ?_⟩
    · show f (g t) = t
      rw [hg0 t ht, hf0 t ht]
    · show f (g t) = t + ((cf + cg : ℤ) : ℚ)
      have hab : (-(cg : ℚ)) ≤ (cg.natAbs : ℚ) := by
        have h : -cg ≤ (cg.natAbs : ℤ) := by
          have h1 := Int.le_natAbs (a := -cg)
          rwa [Int.natAbs_neg] at h1
        have h2 := (Int.cast_le (R := ℚ)).mpr h
        rw [Int.cast_neg, Int.cast_natCast] at h2
        exact h2
      push_cast at ht
      have h1 : (Tg : ℚ) ≤ t := by
        have h0 : (0 : ℚ) ≤ (Tf : ℚ) := Nat.cast_nonneg Tf
        linarith
      rw [hgT t h1]
      have h2 : (Tf : ℚ) ≤ t + cg := by linarith
      rw [hfT _ h2]
      push_cast
      ring
  inv_mem' := by
    rintro f ⟨hf, hf0, T, c, hfT⟩
    refine ⟨(PLGroup (m + 2) (powSlopes m)).inv_mem hf, fun t ht => ?_,
      T + c.natAbs, -c, fun t ht => ?_⟩
    · rw [Equiv.Perm.inv_eq_iff_eq, hf0 t ht]
    · rw [Equiv.Perm.inv_eq_iff_eq]
      have hab : ((c : ℚ)) ≤ (c.natAbs : ℚ) := by
        have h2 := (Int.cast_le (R := ℚ)).mpr (Int.le_natAbs (a := c))
        rw [Int.cast_natCast] at h2
        exact h2
      push_cast at ht
      have h1 : (T : ℚ) ≤ t + ((-c : ℤ) : ℚ) := by push_cast; linarith
      rw [hfT _ h1]
      push_cast
      ring

/-! ## The generators are geometric -/

theorem gridPt_zero_level (j : ℤ) : gridPt (m + 2) 0 j = j := by simp [gridPt]

theorem xg_gridAffine (k : ℕ) : GridAffine (m + 2) (powSlopes m) ⇑(xg m k) 0 1 := by
  have hm0 : (0 : ℚ) ≤ (m : ℚ) := Nat.cast_nonneg m
  refine ⟨fun j => ?_, fun j => ?_⟩
  · rw [gridPt_zero_level, gridPt_zero_level]
    push_cast
    rcases lt_trichotomy j (k : ℤ) with hjk | hjk | hjk
    · have h1 : (j : ℚ) + 1 ≤ k := by
        have h : j + 1 ≤ (k : ℤ) := hjk
        exact_mod_cast h
      refine ⟨1, (powSlopes m).one_mem, by simpa using int_mem_grid (m := m + 2) 1 1,
        fun x hx1 hx2 => ?_⟩
      rw [xg_apply, xg_apply, xfun_of_le (by linarith), xfun_of_le (by linarith)]
      ring
    · subst hjk
      refine ⟨(m : ℚ) + 2, ⟨1, by rw [zpow_one]⟩,
        ⟨((m : ℤ) + 2) * ((m : ℤ) + 2), by push_cast; ring⟩, fun x hx1 hx2 => ?_⟩
      have hx1' : (k : ℚ) ≤ x := by simpa using hx1
      have hx2' : x ≤ (k : ℚ) + 1 := by simpa using hx2
      rw [xg_apply, xg_apply, xfun_of_mem hx1' hx2', xfun_of_le (by simp)]
      push_cast
      ring
    · have h1 : (k : ℚ) + 1 ≤ j := by
        have h : (k : ℤ) + 1 ≤ j := hjk
        exact_mod_cast h
      refine ⟨1, (powSlopes m).one_mem, by simpa using int_mem_grid (m := m + 2) 1 1,
        fun x hx1 hx2 => ?_⟩
      rw [xg_apply, xg_apply, xfun_of_ge (by linarith), xfun_of_ge h1]
      ring
  · rw [gridPt_zero_level, xg_apply]
    rcases lt_trichotomy j (k : ℤ) with hjk | hjk | hjk
    · rw [xfun_of_le (by have h : j ≤ (k : ℤ) := hjk.le; exact_mod_cast h)]
      exact int_mem_grid 1 j
    · subst hjk
      rw [xfun_of_le (by simp)]
      exact int_mem_grid 1 _
    · rw [xfun_of_ge (by have h : (k : ℤ) + 1 ≤ j := hjk; exact_mod_cast h)]
      have e : ((j : ℚ) + ((m : ℚ) + 1)) = ((j + (m : ℤ) + 1 : ℤ) : ℚ) := by push_cast; ring
      rw [e]
      exact int_mem_grid 1 _

theorem xg_inv_of_le {k : ℕ} {y : ℚ} (h : y ≤ k) : (xg m k)⁻¹ y = y := by
  rw [Equiv.Perm.inv_eq_iff_eq, xg_apply, xfun_of_le h]

theorem xg_inv_of_mem {k : ℕ} {y : ℚ} (h1 : (k : ℚ) ≤ y) (h2 : y ≤ k + ((m : ℚ) + 2)) :
    (xg m k)⁻¹ y = k + (y - k) / ((m : ℚ) + 2) := by
  have hm : (0 : ℚ) < (m : ℚ) + 2 := mTwo_pos
  have hd0 : 0 ≤ (y - k) / ((m : ℚ) + 2) := div_nonneg (sub_nonneg.mpr h1) hm.le
  have hd1 : (y - k) / ((m : ℚ) + 2) ≤ 1 := by
    rw [div_le_one hm]
    linarith
  rw [Equiv.Perm.inv_eq_iff_eq, xg_apply, xfun_of_mem (by linarith) (by linarith)]
  have e1 : (k : ℚ) + (y - k) / ((m : ℚ) + 2) - k = (y - k) / ((m : ℚ) + 2) := by ring
  have e2 : ((m : ℚ) + 2) * ((y - k) / ((m : ℚ) + 2)) = y - k := by field_simp
  rw [e1, e2]
  ring

theorem xg_inv_of_ge {k : ℕ} {y : ℚ} (h : (k : ℚ) + ((m : ℚ) + 2) ≤ y) :
    (xg m k)⁻¹ y = y - ((m : ℚ) + 1) := by
  rw [Equiv.Perm.inv_eq_iff_eq, xg_apply, xfun_of_ge (by linarith)]
  ring

theorem xg_inv_gridAffine (k : ℕ) : GridAffine (m + 2) (powSlopes m) ⇑(xg m k)⁻¹ 0 1 := by
  have hm : (0 : ℚ) < (m : ℚ) + 2 := mTwo_pos
  have hm0 : (0 : ℚ) ≤ (m : ℚ) := Nat.cast_nonneg m
  refine ⟨fun j => ?_, fun j => ?_⟩
  · rw [gridPt_zero_level, gridPt_zero_level]
    push_cast
    by_cases hA : j + 1 ≤ (k : ℤ)
    · have h1 : (j : ℚ) + 1 ≤ k := by exact_mod_cast hA
      refine ⟨1, (powSlopes m).one_mem, by simpa using int_mem_grid (m := m + 2) 1 1,
        fun x hx1 hx2 => ?_⟩
      rw [xg_inv_of_le m (by linarith), xg_inv_of_le m (by linarith)]
      ring
    by_cases hB : j ≤ (k : ℤ) + m + 1
    · have h1 : (k : ℚ) ≤ j := by
        have h : (k : ℤ) ≤ j := by omega
        exact_mod_cast h
      have h2 : (j : ℚ) + 1 ≤ k + ((m : ℚ) + 2) := by
        have h := (Int.cast_le (R := ℚ)).mpr (show j + 1 ≤ (k : ℤ) + m + 2 by omega)
        push_cast at h
        linarith
      refine ⟨((m : ℚ) + 2)⁻¹, ⟨-1, by rw [zpow_neg_one]⟩, ⟨1, by push_cast; field_simp⟩,
        fun x hx1 hx2 => ?_⟩
      rw [xg_inv_of_mem m (by linarith) (by linarith), xg_inv_of_mem m h1 (by linarith)]
      ring
    · have h1 : (k : ℚ) + ((m : ℚ) + 2) ≤ j := by
        have h := (Int.cast_le (R := ℚ)).mpr (show (k : ℤ) + m + 2 ≤ j by omega)
        push_cast at h
        linarith
      refine ⟨1, (powSlopes m).one_mem, by simpa using int_mem_grid (m := m + 2) 1 1,
        fun x hx1 hx2 => ?_⟩
      rw [xg_inv_of_ge m (by linarith), xg_inv_of_ge m h1]
      ring
  · rw [gridPt_zero_level]
    by_cases hA : j ≤ (k : ℤ)
    · rw [xg_inv_of_le m (by exact_mod_cast hA)]
      exact int_mem_grid 1 j
    by_cases hB : j ≤ (k : ℤ) + m + 2
    · have h1 : (k : ℚ) ≤ j := by
        have h : (k : ℤ) ≤ j := by omega
        exact_mod_cast h
      have h2 : (j : ℚ) ≤ k + ((m : ℚ) + 2) := by
        have h := (Int.cast_le (R := ℚ)).mpr hB
        push_cast at h
        linarith
      rw [xg_inv_of_mem m h1 h2]
      refine ⟨(k : ℤ) * ((m : ℤ) + 2) + (j - k), ?_⟩
      have e : (((m + 2 : ℕ) : ℚ)) ^ 1 = (m : ℚ) + 2 := by push_cast; ring
      rw [e, add_mul, div_mul_cancel₀ _ hm.ne']
      push_cast
      ring
    · have h1 : (k : ℚ) + ((m : ℚ) + 2) ≤ j := by
        have h := (Int.cast_le (R := ℚ)).mpr (show (k : ℤ) + m + 2 ≤ j by omega)
        push_cast at h
        linarith
      rw [xg_inv_of_ge m h1]
      have e : (j : ℚ) - ((m : ℚ) + 1) = ((j - m - 1 : ℤ) : ℚ) := by push_cast; ring
      rw [e]
      exact int_mem_grid 1 _

theorem xg_mem_geoF (k : ℕ) : xg m k ∈ geoF m := by
  refine ⟨⟨xg_strictMono k, ⟨0, 1, xg_gridAffine m k⟩, ⟨0, 1, xg_inv_gridAffine m k⟩⟩,
    fun t ht => ?_, k + 1, (m : ℤ) + 1, fun t ht => ?_⟩
  · exact xg_fix (le_trans ht (Nat.cast_nonneg k))
  · rw [xg_apply, xfun_of_ge (by push_cast at ht; linarith)]
    push_cast
    ring

theorem brownF_le_geoF : brownF m ≤ geoF m := by
  rintro _ ⟨g, rfl⟩
  induction g using PresentedGroup.induction_on with
  | H w =>
    induction w using FreeGroup.induction_on with
    | C1 => simp
    | of x =>
        rw [brownX_of_fin, brownEval_X]
        exact xg_mem_geoF m x.val
    | inv_of x hx =>
        simp only [map_inv]
        exact (geoF m).inv_mem hx
    | mul x y hx hy =>
        simp only [map_mul]
        exact (geoF m).mul_mem hx hy

/-! ## Geometric elements are products of generators -/

theorem posMap_strictMono (l : List ℕ) : StrictMono (posMap m l) := by
  induction l with
  | nil =>
    intro a b h
    simpa [posMap, brownPos] using h
  | cons i l ih =>
    rw [posMap_cons]
    exact ih.comp (xg_strictMono i)

theorem replicate_apply (d T : ℕ) : ∀ (k : ℕ) (t : ℚ),
    (t ≤ k → posMap m (wword m k (List.replicate T d)) t = t) ∧
    ((k : ℚ) ≤ t → t ≤ k + T →
      posMap m (wword m k (List.replicate T d)) t = k + ((m : ℚ) + 2) ^ d * (t - k)) ∧
    ((k : ℚ) + T ≤ t →
      posMap m (wword m k (List.replicate T d)) t = t + T * (((m : ℚ) + 2) ^ d - 1)) := by
  have hm : (0 : ℚ) < (m : ℚ) + 2 := mTwo_pos
  have hpd : (0 : ℚ) < ((m : ℚ) + 2) ^ d := pow_pos hm d
  induction T with
  | zero =>
    intro k t
    have hnil : posMap m (wword m k (List.replicate 0 d)) t = t := by
      simp [wword, posMap, brownPos]
    refine ⟨fun _ => hnil, fun h1 h2 => ?_, fun _ => ?_⟩
    · have ht : t = k := le_antisymm (by simpa using h2) h1
      rw [hnil, ht]
      ring
    · rw [hnil]
      simp
  | succ T ih =>
    intro k t
    have hcast1 : ((k + 1 : ℕ) : ℚ) = (k : ℚ) + 1 := by push_cast; ring
    have hrep : wword m k (List.replicate (T + 1) d) =
        wword m (k + 1) (List.replicate T d) ++ uword m k d := by
      rw [List.replicate_succ, wword]
    refine ⟨fun h1 => ?_, fun h1 h2 => ?_, fun h3 => ?_⟩
    · rw [hrep, posMap_append, Equiv.Perm.mul_apply,
        (ih (k + 1) t).1 (by rw [hcast1]; linarith)]
      exact (uword_apply m k d t).1 h1
    · rw [hrep, posMap_append, Equiv.Perm.mul_apply]
      rcases le_or_gt t ((k : ℚ) + 1) with h4 | h4
      · rw [(ih (k + 1) t).1 (by rw [hcast1]; exact h4), (uword_apply m k d t).2.1 h1 h4]
      · have hw := (ih (k + 1) t).2.1 (by rw [hcast1]; exact h4.le)
          (by rw [hcast1]; push_cast at h2; linarith)
        have hge : (k : ℚ) + 1 ≤ posMap m (wword m (k + 1) (List.replicate T d)) t := by
          rw [hw, hcast1]
          nlinarith
        rw [(uword_apply m k d _).2.2 hge, hw, hcast1]
        ring
    · have hw := (ih (k + 1) t).2.2 (by rw [hcast1]; push_cast at h3; linarith)
      have hge : (k : ℚ) + 1 ≤ posMap m (wword m (k + 1) (List.replicate T d)) t := by
        rw [hw]
        push_cast at h3
        nlinarith [mul_nonneg (Nat.cast_nonneg T : (0 : ℚ) ≤ T) hpd.le]
      rw [hrep, posMap_append, Equiv.Perm.mul_apply, (uword_apply m k d _).2.2 hge, hw]
      push_cast
      ring

/-- **Shape lemma.**  A monotone map that is the identity up to `k`, affine with slope a
power of `n` on each of the unit intervals `[k+j, k+j+1]` (`j < M`), and a translation from
`k + M` on, is the evaluation of a `wword`. -/
theorem exists_wword_of_shape (M : ℕ) : ∀ (k : ℕ) (g : ℚ → ℚ), Monotone g →
    (∀ u : ℚ, u ≤ k → g u = u) →
    (∀ j : ℕ, j < M → ∃ d : ℕ, ∀ u : ℚ, (k : ℚ) + j ≤ u → u ≤ k + j + 1 →
      g u = g (k + j) + ((m : ℚ) + 2) ^ d * (u - (k + j))) →
    (∃ C : ℚ, ∀ u : ℚ, (k : ℚ) + M ≤ u → g u = u + C) →
    ∃ ds : List ℕ, ∀ u : ℚ, g u = posMap m (wword m k ds) u := by
  have hm : (0 : ℚ) < (m : ℚ) + 2 := mTwo_pos
  induction M with
  | zero =>
    intro k g _ h0 _ hC
    obtain ⟨C, hC⟩ := hC
    have hC0 : C = 0 := by
      have h1 := hC k (by simp)
      rw [h0 k le_rfl] at h1
      linarith
    refine ⟨[], fun u => ?_⟩
    have hnil : posMap m (wword m k []) u = u := by simp [wword, posMap, brownPos]
    rw [hnil]
    rcases le_or_gt u k with hu | hu
    · exact h0 u hu
    · rw [hC u (by simpa using hu.le), hC0, add_zero]
  | succ M ih =>
    intro k g hmono h0 hint hC
    obtain ⟨d₀, hd₀⟩ := hint 0 (Nat.succ_pos M)
    have hpd₀ : (0 : ℚ) < ((m : ℚ) + 2) ^ d₀ := pow_pos hm d₀
    have hgk : g k = k := h0 k le_rfl
    have hg1 : g ((k : ℚ) + 1) = k + ((m : ℚ) + 2) ^ d₀ := by
      have h := hd₀ ((k : ℚ) + 1) (by push_cast; linarith) (by push_cast; linarith)
      simpa [hgk] using h
    have hg_big : ∀ u : ℚ, (k : ℚ) + 1 ≤ u → (k : ℚ) + ((m : ℚ) + 2) ^ d₀ ≤ g u := by
      intro u hu
      rw [← hg1]
      exact hmono hu
    have hUinv_big : ∀ v : ℚ, (k : ℚ) + ((m : ℚ) + 2) ^ d₀ ≤ v →
        (posMap m (uword m k d₀))⁻¹ v = v - (((m : ℚ) + 2) ^ d₀ - 1) := by
      intro v hv
      rw [Equiv.Perm.inv_eq_iff_eq, (uword_apply m k d₀ _).2.2 (by linarith)]
      ring
    have hmono' : Monotone (fun u => (posMap m (uword m k d₀))⁻¹ (g u)) :=
      (strictMono_perm_inv (posMap_strictMono m _)).monotone.comp hmono
    have h0' : ∀ u : ℚ, u ≤ ((k + 1 : ℕ) : ℚ) → (posMap m (uword m k d₀))⁻¹ (g u) = u := by
      intro u hu
      push_cast at hu
      rcases le_or_gt u k with h1 | h1
      · rw [h0 u h1, Equiv.Perm.inv_eq_iff_eq, (uword_apply m k d₀ u).1 h1]
      · have hgu : g u = k + ((m : ℚ) + 2) ^ d₀ * (u - k) := by
          have h := hd₀ u (by push_cast; linarith) (by push_cast; linarith)
          simpa [hgk] using h
        rw [hgu, Equiv.Perm.inv_eq_iff_eq, (uword_apply m k d₀ u).2.1 h1.le hu]
    have hint' : ∀ j : ℕ, j < M → ∃ d : ℕ, ∀ u : ℚ, ((k + 1 : ℕ) : ℚ) + j ≤ u →
        u ≤ ((k + 1 : ℕ) : ℚ) + j + 1 →
        (posMap m (uword m k d₀))⁻¹ (g u) =
          (posMap m (uword m k d₀))⁻¹ (g (((k + 1 : ℕ) : ℚ) + j)) +
            ((m : ℚ) + 2) ^ d * (u - (((k + 1 : ℕ) : ℚ) + j)) := by
      intro j hj
      obtain ⟨d, hd⟩ := hint (j + 1) (by omega)
      refine ⟨d, fun u hu1 hu2 => ?_⟩
      have hc : (k : ℚ) + ((j + 1 : ℕ) : ℚ) = ((k + 1 : ℕ) : ℚ) + j := by push_cast; ring
      have hgu := hd u (by rw [hc]; exact hu1) (by rw [hc]; exact hu2)
      rw [hc] at hgu
      have hj0 : (0 : ℚ) ≤ j := Nat.cast_nonneg j
      have hbig1 := hg_big u (by push_cast at hu1; linarith)
      have hbig2 := hg_big (((k + 1 : ℕ) : ℚ) + j) (by push_cast; linarith)
      rw [hUinv_big _ hbig1, hUinv_big _ hbig2, hgu]
      ring
    have hC' : ∃ C : ℚ, ∀ u : ℚ, ((k + 1 : ℕ) : ℚ) + M ≤ u →
        (posMap m (uword m k d₀))⁻¹ (g u) = u + C := by
      obtain ⟨C, hC⟩ := hC
      refine ⟨C - (((m : ℚ) + 2) ^ d₀ - 1), fun u hu => ?_⟩
      push_cast at hu
      have hM0 : (0 : ℚ) ≤ M := Nat.cast_nonneg M
      rw [hUinv_big _ (hg_big u (by linarith)), hC u (by push_cast; linarith)]
      ring
    obtain ⟨ds, hds⟩ := ih (k + 1) (fun u => (posMap m (uword m k d₀))⁻¹ (g u)) hmono' h0'
      hint' hC'
    refine ⟨d₀ :: ds, fun u => ?_⟩
    rw [wword, posMap_append, Equiv.Perm.mul_apply, ← hds u]
    show g u = posMap m (uword m k d₀) ((posMap m (uword m k d₀))⁻¹ (g u))
    rw [perm_apply_inv_self]

theorem zpow_exponent_nonneg_of_mem_grid {kk : ℤ} {B : ℕ}
    (h : ((m : ℚ) + 2) ^ kk ∈ Grid (m + 2) B) : 0 ≤ kk + B := by
  by_contra hneg
  have hneg' : kk + B < 0 := not_le.mp hneg
  obtain ⟨z, hz⟩ := h
  have hm : (0 : ℚ) < (m : ℚ) + 2 := mTwo_pos
  have hn1 : (1 : ℚ) < (m : ℚ) + 2 := by
    have h0 : (0 : ℚ) ≤ m := Nat.cast_nonneg m
    linarith
  have hcastn : (((m + 2 : ℕ) : ℚ)) = (m : ℚ) + 2 := by push_cast; ring
  rw [hcastn, ← zpow_natCast, ← zpow_add₀ hm.ne'] at hz
  have hlt : ((m : ℚ) + 2) ^ (kk + B) < 1 := zpow_lt_one_of_neg₀ hn1 hneg'
  have hpos : 0 < ((m : ℚ) + 2) ^ (kk + B) := zpow_pos hm _
  rw [hz] at hlt hpos
  have h1 : (0 : ℤ) < z := by exact_mod_cast hpos
  have h2 : z < 1 := by exact_mod_cast hlt
  omega

/-- **Every geometric element is a product of generators.** -/
theorem geoF_le_brownF : geoF m ≤ brownF m := by
  rintro f ⟨⟨hmono, ⟨N, B, hf⟩, -⟩, hf0, T, c, hfT⟩
  have hm : (0 : ℚ) < (m : ℚ) + 2 := mTwo_pos
  have hcastn : (((m + 2 : ℕ) : ℚ)) = (m : ℚ) + 2 := by push_cast; ring
  have hpN : (0 : ℚ) < ((m : ℚ) + 2) ^ N := pow_pos hm N
  have hTc : (0 : ℚ) ≤ T + c := by
    have h2 : f 0 ≤ f T := hmono.monotone (Nat.cast_nonneg T)
    rw [hf0 0 le_rfl, hfT T le_rfl] at h2
    exact h2
  obtain ⟨T₂, hT₂⟩ : ∃ T₂ : ℕ, (T₂ : ℚ) = T + c := by
    refine ⟨(T + c).toNat, ?_⟩
    have h1 : (0 : ℤ) ≤ T + c := by exact_mod_cast hTc
    have h2 : (((T + c).toNat : ℕ) : ℤ) = T + c := Int.toNat_of_nonneg h1
    exact_mod_cast h2
  set U : Equiv.Perm ℚ := posMap m (wword m 0 (List.replicate T N)) with hU
  set V : Equiv.Perm ℚ := posMap m (wword m 0 (List.replicate T₂ (N + B))) with hV
  have hUinv_le : ∀ v : ℚ, v ≤ 0 → U⁻¹ v = v := by
    intro v hv
    rw [Equiv.Perm.inv_eq_iff_eq, hU, (replicate_apply m N T 0 v).1 (by simpa using hv)]
  have hUinv_mid : ∀ v : ℚ, 0 ≤ v → v ≤ T * ((m : ℚ) + 2) ^ N →
      U⁻¹ v = v / ((m : ℚ) + 2) ^ N := by
    intro v hv1 hv2
    rw [Equiv.Perm.inv_eq_iff_eq, hU, (replicate_apply m N T 0 _).2.1
      (by simpa using div_nonneg hv1 hpN.le) (by simpa [div_le_iff₀ hpN] using hv2)]
    have e : ((m : ℚ) + 2) ^ N * (v / ((m : ℚ) + 2) ^ N) = v := by field_simp
    simp only [Nat.cast_zero, zero_add, sub_zero]
    rw [e]
  have hUinv_big : ∀ v : ℚ, T * ((m : ℚ) + 2) ^ N ≤ v →
      U⁻¹ v = v - T * (((m : ℚ) + 2) ^ N - 1) := by
    intro v hv
    rw [Equiv.Perm.inv_eq_iff_eq, hU, (replicate_apply m N T 0 _).2.2 (by simp; linarith)]
    ring
  have hV_le : ∀ w : ℚ, w ≤ 0 → V w = w := fun w hw =>
    (replicate_apply m (N + B) T₂ 0 w).1 (by simpa using hw)
  have hV_mid : ∀ w : ℚ, 0 ≤ w → w ≤ T₂ → V w = ((m : ℚ) + 2) ^ (N + B) * w := by
    intro w h1 h2
    rw [hV, (replicate_apply m (N + B) T₂ 0 w).2.1 (by simpa using h1) (by simpa using h2)]
    simp
  have hV_big : ∀ w : ℚ, (T₂ : ℚ) ≤ w → V w = w + T₂ * (((m : ℚ) + 2) ^ (N + B) - 1) := by
    intro w hw
    rw [hV]
    exact (replicate_apply m (N + B) T₂ 0 w).2.2 (by simpa using hw)
  have hfr : ∀ x : ℚ, 0 ≤ x → x ≤ T → 0 ≤ f x ∧ f x ≤ T₂ := by
    intro x hx1 hx2
    constructor
    · have h := hmono.monotone hx1
      rwa [hf0 0 le_rfl] at h
    · have h := hmono.monotone hx2
      rwa [hfT T le_rfl, ← hT₂] at h
  have hgmono : Monotone (fun u => V (f (U⁻¹ u))) :=
    (posMap_strictMono m _).monotone.comp
      (hmono.monotone.comp (strictMono_perm_inv (posMap_strictMono m _)).monotone)
  have h0 : ∀ u : ℚ, u ≤ ((0 : ℕ) : ℚ) → V (f (U⁻¹ u)) = u := by
    intro u hu
    simp only [Nat.cast_zero] at hu
    rw [hUinv_le u hu, hf0 u hu, hV_le u hu]
  have hint : ∀ j : ℕ, j < T * (m + 2) ^ N → ∃ d : ℕ, ∀ u : ℚ, ((0 : ℕ) : ℚ) + j ≤ u →
      u ≤ ((0 : ℕ) : ℚ) + j + 1 →
      V (f (U⁻¹ u)) = V (f (U⁻¹ (((0 : ℕ) : ℚ) + j))) +
        ((m : ℚ) + 2) ^ d * (u - (((0 : ℕ) : ℚ) + j)) := by
    intro j hj
    obtain ⟨s, ⟨kk, rfl⟩, hsB, haff⟩ := hf.slope (j : ℤ)
    have hkB : 0 ≤ kk + B := zpow_exponent_nonneg_of_mem_grid m hsB
    refine ⟨(kk + B).toNat, fun u hu1 hu2 => ?_⟩
    simp only [Nat.cast_zero, zero_add] at hu1 hu2 ⊢
    have hjT : ((j : ℚ) + 1) ≤ T * ((m : ℚ) + 2) ^ N := by
      have h : j + 1 ≤ T * (m + 2) ^ N := hj
      exact_mod_cast h
    have hj0 : (0 : ℚ) ≤ j := Nat.cast_nonneg j
    have hu0 : (0 : ℚ) ≤ u := le_trans hj0 hu1
    rw [hUinv_mid u hu0 (by linarith), hUinv_mid (j : ℚ) hj0 (by linarith)]
    have hgpj : gridPt (m + 2) N (j : ℤ) = (j : ℚ) / ((m : ℚ) + 2) ^ N := by
      rw [gridPt, hcastn]
      push_cast
      ring
    have hgpj1 : gridPt (m + 2) N ((j : ℤ) + 1) = ((j : ℚ) + 1) / ((m : ℚ) + 2) ^ N := by
      rw [gridPt, hcastn]
      push_cast
      ring
    have hx1 : gridPt (m + 2) N (j : ℤ) ≤ u / ((m : ℚ) + 2) ^ N := by
      rw [hgpj]
      exact div_le_div_of_nonneg_right hu1 hpN.le
    have hx2 : u / ((m : ℚ) + 2) ^ N ≤ gridPt (m + 2) N ((j : ℤ) + 1) := by
      rw [hgpj1]
      exact div_le_div_of_nonneg_right hu2 hpN.le
    have hfu := haff _ hx1 hx2
    rw [hgpj] at hfu
    obtain ⟨hr1, hr2⟩ := hfr (u / ((m : ℚ) + 2) ^ N) (div_nonneg hu0 hpN.le)
      (by rw [div_le_iff₀ hpN]; linarith)
    obtain ⟨hr3, hr4⟩ := hfr ((j : ℚ) / ((m : ℚ) + 2) ^ N) (div_nonneg hj0 hpN.le)
      (by rw [div_le_iff₀ hpN]; linarith)
    rw [hV_mid _ hr1 hr2, hV_mid _ hr3 hr4, hfu]
    have hd_eq : ((m : ℚ) + 2) ^ ((kk + B).toNat) * ((m : ℚ) + 2) ^ N =
        ((m : ℚ) + 2) ^ (N + B) * ((m : ℚ) + 2) ^ kk := by
      rw [← zpow_natCast, ← zpow_natCast, ← zpow_natCast, ← zpow_add₀ hm.ne',
        ← zpow_add₀ hm.ne']
      congr 1
      rw [Int.toNat_of_nonneg hkB]
      push_cast
      ring
    have e : ((m : ℚ) + 2) ^ N * (u / ((m : ℚ) + 2) ^ N - (j : ℚ) / ((m : ℚ) + 2) ^ N) =
        u - j := by
      field_simp
    have key : ((m : ℚ) + 2) ^ (N + B) * ((m : ℚ) + 2) ^ kk *
        (u / ((m : ℚ) + 2) ^ N - (j : ℚ) / ((m : ℚ) + 2) ^ N) =
          ((m : ℚ) + 2) ^ ((kk + B).toNat) * (u - j) := by
      rw [← hd_eq, mul_assoc, e]
    linear_combination key
  have hbeyond : ∃ C : ℚ, ∀ u : ℚ, ((0 : ℕ) : ℚ) + ((T * (m + 2) ^ N : ℕ) : ℚ) ≤ u →
      V (f (U⁻¹ u)) = u + C := by
    refine ⟨-(T * (((m : ℚ) + 2) ^ N - 1)) + c + T₂ * (((m : ℚ) + 2) ^ (N + B) - 1),
      fun u hu => ?_⟩
    have hu' : (T : ℚ) * ((m : ℚ) + 2) ^ N ≤ u := by
      push_cast at hu
      linarith
    rw [hUinv_big u hu']
    have h1 : (T : ℚ) ≤ u - T * (((m : ℚ) + 2) ^ N - 1) := by linarith
    rw [hfT _ h1]
    have h2 : (T₂ : ℚ) ≤ u - T * (((m : ℚ) + 2) ^ N - 1) + c := by
      rw [hT₂]
      linarith
    rw [hV_big _ h2]
    ring
  obtain ⟨ds, hds⟩ := exists_wword_of_shape m (T * (m + 2) ^ N) 0
    (fun u => V (f (U⁻¹ u))) hgmono h0 hint hbeyond
  have hperm : V * f * U⁻¹ = posMap m (wword m 0 ds) := by
    ext u
    simp only [Equiv.Perm.mul_apply]
    exact hds u
  have hf_eq : f = V⁻¹ * posMap m (wword m 0 ds) * U := by
    rw [← hperm]
    group
  rw [hf_eq]
  exact (brownF m).mul_mem ((brownF m).mul_mem ((brownF m).inv_mem (posMap_mem_brownF m _))
    (posMap_mem_brownF m _)) (posMap_mem_brownF m _)

/-- **Geometric `F_{m+2,∞}` is Brown's group.** -/
theorem geoF_eq_brownF : geoF m = brownF m :=
  le_antisymm (geoF_le_brownF m) (brownF_le_geoF m)

/-- **Geometric `F_{m+2,∞}` is finitely presented.** -/
theorem geoF_isFinitelyPresented : Group.IsFinitelyPresented (geoF m) := by
  rw [geoF_eq_brownF]
  exact brownF_isFinitelyPresented m

#audit_axioms GroupApproximation.HigmanThompson.geoF_eq_brownF
#audit_axioms GroupApproximation.HigmanThompson.geoF_isFinitelyPresented

end HigmanThompson
end GroupApproximation
