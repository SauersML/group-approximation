import GroupApproximation.GroupTheory.HNNBrittonPinch
import Mathlib.Tactic.Group

/-!
# Reduced spellings, and the good-subgroup form of Britton's Lemma

Mathlib's normal-form machinery already gives *existence* of a reduced
spelling: for a transversal pair `d`, the action of `HNNExtension G A B φ`
on `NormalWord d` is simply transitive, so `x • empty` is a normal word —
in particular a `ReducedWord` — whose product is `x`.  The first section
just names that in the syllable-list interface of `HNNBrittonPinch`.

The substance of this module is the **good-subgroup** form of Britton's
Lemma, which Mathlib does not have and which is what a machine-to-group
construction (Aanderaa--Cohen, Boone) actually consumes when it must show
that a subgroup generated by part of the base together with stable
letters meets the base copy in no more than it should:

> If `A' ≤ G` is *good* for the associated pair — conjugation by the
> stable letter carries `A' ⊓ A` onto `A' ⊓ B` — then
> `closure (of '' A' ∪ {t}) ⊓ of.range = A'.map of`.

The proof is the standard rewriting argument, done here honestly:
`HasSpellingIn φ A' x` says `x` is spelled by a head and a pinch-free
syllable list *all of whose entries lie in `A'`*; this class contains `1`
and is closed under left multiplication by `of a'` (`a' ∈ A'`) and by
`t^{±1}`.  The stable-letter step is where goodness is used: when
prefixing `t` meets a pinch `t g t⁻¹` with `g ∈ A`, the absorbed element
is `φ g`, and goodness is exactly the statement that it is still in `A'`.
Britton's Lemma then forces the syllable list of an element of the base
copy to be empty, leaving the head, which lies in `A'`.

This supports the undecidability corollary retained in the companion notes.
-/

namespace GroupApproximation
namespace HNNBritton

universe u

variable {G : Type u} [Group G] {A B : Subgroup G}

/-! ## Existence of a pinch-free spelling -/

/-- **Every element is the product of a reduced word.**  Immediate from
Mathlib's normal form: the extension acts simply transitively on the
normal words over any transversal pair, and a normal word is in
particular reduced. -/
theorem exists_reducedWord (φ : A ≃* B) (x : HNNExtension G A B φ) :
    ∃ w : HNNExtension.NormalWord.ReducedWord G A B, w.prod φ = x := by
  obtain ⟨d⟩ := HNNExtension.NormalWord.TransversalPair.nonempty G A B
  refine ⟨(x • (HNNExtension.NormalWord.empty :
    HNNExtension.NormalWord d)).toReducedWord, ?_⟩
  have h := HNNExtension.NormalWord.prod_smul φ x
    (HNNExtension.NormalWord.empty : HNNExtension.NormalWord d)
  rw [HNNExtension.NormalWord.prod_empty, mul_one] at h
  exact h

/-- **Every element has a pinch-free spelling** in the syllable-list
interface. -/
theorem exists_hasSpelling (φ : A ≃* B) (x : HNNExtension G A B φ) :
    ∃ (g : G) (l : List (ℤˣ × G)), NoPinch A B l ∧ wordProd φ g l = x := by
  obtain ⟨w, hw⟩ := exists_reducedWord φ x
  exact ⟨w.head, w.toList, w.chain, hw⟩

/-- **Britton's Lemma, working form.**  An element lies in the base copy
exactly when its pinch-free spellings carry no stable letter.  The
forward direction is Britton's Lemma; the converse uses existence of a
spelling. -/
theorem mem_range_iff_forall_spelling_nil (φ : A ≃* B)
    (x : HNNExtension G A B φ) :
    x ∈ (HNNExtension.of : G →* HNNExtension G A B φ).range ↔
      ∀ (g : G) (l : List (ℤˣ × G)), NoPinch A B l →
        wordProd φ g l = x → l = [] := by
  constructor
  · intro hmem g l hl hprod
    by_contra hne
    refine wordProd_notMem_range (g := g) φ hne hl ?_
    rw [hprod]
    exact hmem
  · intro hall
    obtain ⟨g, l, hl, hprod⟩ := exists_hasSpelling φ x
    have hnil : l = [] := hall g l hl hprod
    subst hnil
    refine ⟨g, ?_⟩
    rw [← hprod]
    simp

/-- An element outside the base copy has a pinch-free spelling with at
least one stable letter. -/
theorem exists_hasSpelling_ne_nil (φ : A ≃* B) {x : HNNExtension G A B φ}
    (hx : x ∉ (HNNExtension.of : G →* HNNExtension G A B φ).range) :
    ∃ (g : G) (l : List (ℤˣ × G)),
      NoPinch A B l ∧ l ≠ [] ∧ wordProd φ g l = x := by
  obtain ⟨g, l, hl, hprod⟩ := exists_hasSpelling φ x
  refine ⟨g, l, hl, ?_, hprod⟩
  rintro rfl
  refine hx ⟨g, ?_⟩
  rw [← hprod]
  simp

/-! ## Good subgroups of the base -/

/-- `A'` is **good** for the associated pair `(A, B, φ)` when conjugation
by the stable letter matches `A' ⊓ A` with `A' ⊓ B`: the two conditions
below say `φ (A' ⊓ A) ≤ A'` and `φ⁻¹ (A' ⊓ B) ≤ A'`, which together with
`φ` being a bijection `A ≃* B` is exactly `φ (A' ⊓ A) = A' ⊓ B`. -/
structure IsGood (φ : A ≃* B) (A' : Subgroup G) : Prop where
  /-- The `φ`-image of `A' ⊓ A` stays inside `A'`. -/
  forward : ∀ a : A, (a : G) ∈ A' → ((φ a : B) : G) ∈ A'
  /-- The `φ⁻¹`-image of `A' ⊓ B` stays inside `A'`. -/
  backward : ∀ b : B, (b : G) ∈ A' → ((φ.symm b : A) : G) ∈ A'

/-- The whole base group is good for every associated pair. -/
theorem isGood_top (φ : A ≃* B) : IsGood φ (⊤ : Subgroup G) :=
  ⟨fun _ _ => Subgroup.mem_top _, fun _ _ => Subgroup.mem_top _⟩

/-- `x` has an **`A'`-spelling**: a head in `A'` followed by a pinch-free
syllable list all of whose group entries lie in `A'`. -/
def HasSpellingIn (φ : A ≃* B) (A' : Subgroup G)
    (x : HNNExtension G A B φ) : Prop :=
  ∃ (g : G) (l : List (ℤˣ × G)), g ∈ A' ∧ (∀ p ∈ l, p.2 ∈ A') ∧
    NoPinch A B l ∧ wordProd φ g l = x

theorem hasSpellingIn_one (φ : A ≃* B) (A' : Subgroup G) :
    HasSpellingIn φ A' (1 : HNNExtension G A B φ) :=
  ⟨1, [], A'.one_mem, by simp, noPinch_nil, by simp⟩

theorem hasSpellingIn_of (φ : A ≃* B) {A' : Subgroup G} {g : G}
    (hg : g ∈ A') :
    HasSpellingIn φ A' (HNNExtension.of g : HNNExtension G A B φ) :=
  ⟨g, [], hg, by simp, noPinch_nil, by simp⟩

/-- Prefixing a base element of `A'` only changes the head. -/
theorem HasSpellingIn.of_mul {φ : A ≃* B} {A' : Subgroup G}
    {x : HNNExtension G A B φ} (h : HasSpellingIn φ A' x) {g : G}
    (hg : g ∈ A') : HasSpellingIn φ A' (HNNExtension.of g * x) := by
  obtain ⟨g', l, hg', hlmem, hl, rfl⟩ := h
  refine ⟨g * g', l, A'.mul_mem hg hg', hlmem, hl, ?_⟩
  simp only [wordProd, map_mul, mul_assoc]

/-- **Prefixing the stable letter, relatively.**  Either the list grows,
or a pinch `t g t⁻¹` with `g ∈ A` fires; goodness of `A'` is exactly what
keeps the absorbed element `φ g` inside `A'`. -/
theorem HasSpellingIn.t_mul {φ : A ≃* B} {A' : Subgroup G}
    (hgood : IsGood φ A') {x : HNNExtension G A B φ}
    (h : HasSpellingIn φ A' x) :
    HasSpellingIn φ A' ((HNNExtension.t : HNNExtension G A B φ) * x) := by
  obtain ⟨g, l, hg, hlmem, hl, rfl⟩ := h
  rcases l with _ | ⟨⟨v, g₁⟩, l'⟩
  · refine ⟨1, [((1 : ℤˣ), g)], A'.one_mem, ?_, noPinch_singleton _, ?_⟩
    · intro p hp
      rcases List.mem_cons.1 hp with rfl | hp
      · exact hg
      · exact absurd hp List.not_mem_nil
    · simp [wordProd]
  · rcases Int.units_eq_one_or v with rfl | rfl
    · refine ⟨1, ((1 : ℤˣ), g) :: ((1 : ℤˣ), g₁) :: l', A'.one_mem, ?_,
        noPinch_cons_cons (fun _ => rfl) hl, ?_⟩
      · intro p hp
        rcases List.mem_cons.1 hp with rfl | hp
        · exact hg
        · exact hlmem p hp
      · simp only [wordProd, spell_cons_one, map_one, one_mul, mul_assoc]
    · by_cases hgA : g ∈ A
      · refine ⟨((φ ⟨g, hgA⟩ : B) : G) * g₁, l',
          A'.mul_mem (hgood.forward ⟨g, hgA⟩ hg)
            (hlmem ((-1 : ℤˣ), g₁) (by simp)), ?_, hl.tail, ?_⟩
        · intro p hp
          exact hlmem p (List.mem_cons_of_mem _ hp)
        · have hconj := t_conj_of_mem φ hgA
          simp only [wordProd, spell_cons_neg_one, map_mul]
          rw [← hconj]
          group
      · refine ⟨1, ((1 : ℤˣ), g) :: ((-1 : ℤˣ), g₁) :: l', A'.one_mem, ?_,
          noPinch_cons_cons (fun hmem => absurd hmem hgA) hl, ?_⟩
        · intro p hp
          rcases List.mem_cons.1 hp with rfl | hp
          · exact hg
          · exact hlmem p hp
        · simp only [wordProd, spell_cons_one, spell_cons_neg_one, map_one,
            one_mul, mul_assoc]

/-- **Prefixing the inverse stable letter, relatively.** -/
theorem HasSpellingIn.t_inv_mul {φ : A ≃* B} {A' : Subgroup G}
    (hgood : IsGood φ A') {x : HNNExtension G A B φ}
    (h : HasSpellingIn φ A' x) :
    HasSpellingIn φ A' ((HNNExtension.t : HNNExtension G A B φ)⁻¹ * x) := by
  obtain ⟨g, l, hg, hlmem, hl, rfl⟩ := h
  rcases l with _ | ⟨⟨v, g₁⟩, l'⟩
  · refine ⟨1, [((-1 : ℤˣ), g)], A'.one_mem, ?_, noPinch_singleton _, ?_⟩
    · intro p hp
      rcases List.mem_cons.1 hp with rfl | hp
      · exact hg
      · exact absurd hp List.not_mem_nil
    · simp [wordProd]
  · rcases Int.units_eq_one_or v with rfl | rfl
    · by_cases hgB : g ∈ B
      · refine ⟨((φ.symm ⟨g, hgB⟩ : A) : G) * g₁, l',
          A'.mul_mem (hgood.backward ⟨g, hgB⟩ hg)
            (hlmem ((1 : ℤˣ), g₁) (by simp)), ?_, hl.tail, ?_⟩
        · intro p hp
          exact hlmem p (List.mem_cons_of_mem _ hp)
        · have hconj := t_inv_conj_of_mem φ hgB
          simp only [wordProd, spell_cons_one, map_mul]
          rw [← hconj]
          group
      · refine ⟨1, ((-1 : ℤˣ), g) :: ((1 : ℤˣ), g₁) :: l', A'.one_mem, ?_,
          noPinch_cons_cons (fun hmem => absurd (by simpa using hmem) hgB) hl, ?_⟩
        · intro p hp
          rcases List.mem_cons.1 hp with rfl | hp
          · exact hg
          · exact hlmem p hp
        · simp only [wordProd, spell_cons_one, spell_cons_neg_one, map_one,
            one_mul, mul_assoc]
    · refine ⟨1, ((-1 : ℤˣ), g) :: ((-1 : ℤˣ), g₁) :: l', A'.one_mem, ?_,
        noPinch_cons_cons (fun _ => rfl) hl, ?_⟩
      · intro p hp
        rcases List.mem_cons.1 hp with rfl | hp
        · exact hg
        · exact hlmem p hp
      · simp only [wordProd, spell_cons_neg_one, map_one, one_mul, mul_assoc]

/-- Every element of the subgroup generated by `of '' A'` and the stable
letter has an `A'`-spelling. -/
theorem hasSpellingIn_of_mem_closure (φ : A ≃* B) {A' : Subgroup G}
    (hgood : IsGood φ A') {x : HNNExtension G A B φ}
    (hx : x ∈ Subgroup.closure
      (((HNNExtension.of : G →* HNNExtension G A B φ) '' (A' : Set G)) ∪
        {(HNNExtension.t : HNNExtension G A B φ)})) :
    HasSpellingIn φ A' x := by
  induction hx using Subgroup.closure_induction_left with
  | one => exact hasSpellingIn_one φ A'
  | mul_left s hs y hy ih =>
      rcases hs with ⟨g, hg, rfl⟩ | hs
      · exact ih.of_mul hg
      · rw [Set.mem_singleton_iff] at hs
        subst hs
        exact ih.t_mul hgood
  | inv_mul_cancel s hs y hy ih =>
      rcases hs with ⟨g, hg, rfl⟩ | hs
      · rw [← map_inv]
        exact ih.of_mul (A'.inv_mem hg)
      · rw [Set.mem_singleton_iff] at hs
        subst hs
        exact ih.t_inv_mul hgood

/-- **The good-subgroup form of Britton's Lemma.**  For a good subgroup
`A'` of the base, the subgroup generated by `of '' A'` and the stable
letter meets the base copy in exactly `of '' A'`. -/
theorem closure_image_inf_range (φ : A ≃* B) {A' : Subgroup G}
    (hgood : IsGood φ A') :
    Subgroup.closure
        (((HNNExtension.of : G →* HNNExtension G A B φ) '' (A' : Set G)) ∪
          {(HNNExtension.t : HNNExtension G A B φ)}) ⊓
        (HNNExtension.of : G →* HNNExtension G A B φ).range =
      A'.map (HNNExtension.of : G →* HNNExtension G A B φ) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨hxc, hxr⟩ := Subgroup.mem_inf.1 hx
    obtain ⟨g, l, hg, -, hl, rfl⟩ :=
      hasSpellingIn_of_mem_closure φ hgood hxc
    have hnil : l = [] := by
      by_contra hne
      exact wordProd_notMem_range φ hne hl hxr
    subst hnil
    refine Subgroup.mem_map.2 ⟨g, hg, ?_⟩
    simp
  · intro x hx
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.1 hx
    refine Subgroup.mem_inf.2 ⟨?_, ⟨g, rfl⟩⟩
    exact Subgroup.subset_closure (Or.inl ⟨g, hg, rfl⟩)

end HNNBritton
end GroupApproximation
