/-!
# `Q₂ = ⁅Γ₂, Γ₂⁆` is a torsion-free infinite simple group

Hyde–Lodha, Lemma 3.10 ("every proper quotient of `Γ` is abelian") and Proposition 3.11 ("the group
`Q_n` is simple"), for `n = 2`.

* `commutator_le_of_normal`, Lemma 3.10: for `Γ ≤ Γ₂` containing `F_6'` and an element `h` with
  `h 0 ∉ ℤ`, a nontrivial `N ≤ Γ` normalized by `Γ` contains `⁅Γ, Γ⁆`.  The printed route:
  `F_6' ≤ N` (Lemma 3.9(1)); `Γ` is generated by `Γ_{<1}` (Lemma 3.9(4)); every `s ∈ Γ_{<1}` is
  `a · N` with `a` in the stabilizer of `0` (Lemma 3.9(5)); the stabilizer of `0` is in the periodic
  `F_6` (Proposition 1.4(2)), whose derived subgroup is `F_6' ≤ N`; so `Γ / N` is abelian
  (`commutator_le_of_generators`).
* `qTwo_le_commutator`: `Q₂ = ⁅Q₂, Q₂⁆`, since `⁅Q₂, Q₂⁆ ⊇ ⁅F_6', F_6'⁆ ≠ 1` is normalized by `Γ₂`.
* `isSimpleGroup_qTwo`, Proposition 3.11; `qTwo_torsionFree`; `infinite_qTwo`.

The residue congruence of Lemma 3.8 at `x = 0` ("`θ(0) = θ(0·f)` for `f ∈ Γ_{<1}`") enters as the
hypothesis `hres` until its producer lands.
-/

namespace GroupApproximation
namespace HydeLodha

open scoped commutatorElement
open HigmanThompson

/-- The stabilizer of `0` in `Γ`. -/
def fixZero (Γ : Subgroup (Equiv.Perm ℚ)) : Subgroup (Equiv.Perm ℚ) where
  carrier := {g | g ∈ Γ ∧ g 0 = 0}
  one_mem' := ⟨Γ.one_mem, rfl⟩
  mul_mem' := by
    rintro f g ⟨hf, hf0⟩ ⟨hg, hg0⟩
    refine ⟨Γ.mul_mem hf hg, ?_⟩
    show f (g 0) = 0
    rw [hg0, hf0]
  inv_mem' := by
    rintro f ⟨hf, hf0⟩
    refine ⟨Γ.inv_mem hf, ?_⟩
    rw [Equiv.Perm.inv_eq_iff_eq, hf0]

section ProperQuotient

variable {Γ : Subgroup (Equiv.Perm ℚ)}

theorem mem_fixZero {g : Equiv.Perm ℚ} : g ∈ fixZero Γ ↔ g ∈ Γ ∧ g 0 = 0 := Iff.rfl

theorem commutator_fixZero_le (hΓ : Γ ≤ gammaTwo) :
    ⁅fixZero Γ, fixZero Γ⁆ ≤ ⁅perCore 4, perCore 4⁆ := by
  rw [Subgroup.commutator_le]
  intro f hf g hg
  obtain ⟨hfΓ, hf0⟩ := mem_fixZero.mp hf
  obtain ⟨hgΓ, hg0⟩ := mem_fixZero.mp hg
  obtain ⟨a, rfl⟩ := mem_range_perHom_of_fix_zero (hΓ hfΓ) hf0
  obtain ⟨b, rfl⟩ := mem_range_perHom_of_fix_zero (hΓ hgΓ) hg0
  rw [← map_commutatorElement]
  exact perHom_mem_commutator_perCore_of_compactF 4 (Subgroup.commutator_mem_commutator a.2 b.2)

/-- **Hyde–Lodha, Lemma 3.9(5).** -/
theorem exists_fixZero_inv_mul_mem (hΓ : Γ ≤ gammaTwo) (N : Subgroup (Equiv.Perm ℚ))
    (hNΓ : N ≤ Γ) (hN : ∀ n ∈ N, ∀ g ∈ Γ, g * n * g⁻¹ ∈ N) (hcoreN : ⁅perCore 4, perCore 4⁆ ≤ N)
    {g₁ : Equiv.Perm ℚ} (hg₁ : g₁ ∈ N) (hg₁0 : 0 < g₁ 0) (hg₁1 : g₁ 0 < 1)
    (hres : ∀ f ∈ gammaTwo, 0 ≤ f 0 → f 0 < 1 → ResEq 4 (f 0) 0) :
    ∀ s ∈ unitSet Γ, ∃ a ∈ fixZero Γ, a⁻¹ * s ∈ N := by
  rintro s ⟨hsΓ, hs0, hs1⟩
  have hkey : ∃ n ∈ N, n (s 0) = 0 := by
    rcases lt_or_eq_of_le hs0 with hpos | hzero
    · have hsres := hres s (hΓ hsΓ) hs0 hs1
      have hg₁res := hres g₁ (hΓ (hNΓ hg₁)) hg₁0.le hg₁1
      obtain ⟨a, haK, hax⟩ := exists_perCore_apply (gammaTwo_apply_grid (hΓ hsΓ) zero_mem_grid_six)
        (gammaTwo_apply_grid (hΓ (hNΓ hg₁)) zero_mem_grid_six) (hg₁res.trans hsres.symm) hpos hs1
        hg₁0 hg₁1
      refine ⟨g₁⁻¹ * perHom 4 a, N.mul_mem (N.inv_mem hg₁) (hcoreN haK), ?_⟩
      simp only [Equiv.Perm.mul_apply]
      rw [hax]
      exact perm_inv_apply_self g₁ 0
    · refine ⟨1, N.one_mem, ?_⟩
      simp only [Equiv.Perm.one_apply]
      exact hzero.symm
  obtain ⟨n, hn, hns⟩ := hkey
  refine ⟨n * s, mem_fixZero.mpr ⟨Γ.mul_mem (hNΓ hn) hsΓ, by exact hns⟩, ?_⟩
  have e : (n * s)⁻¹ * s = s⁻¹ * n⁻¹ * s⁻¹⁻¹ := by group
  rw [e]
  exact hN _ (N.inv_mem hn) _ (Γ.inv_mem hsΓ)

/-- **Hyde–Lodha, Lemma 3.10.** -/
theorem commutator_le_of_normal (hΓ : Γ ≤ gammaTwo) (hcore : ⁅perCore 4, perCore 4⁆ ≤ Γ)
    {h : Equiv.Perm ℚ} (hh : h ∈ Γ) (hnot : ∀ k : ℤ, h 0 ≠ k)
    (hres : ∀ f ∈ gammaTwo, 0 ≤ f 0 → f 0 < 1 → ResEq 4 (f 0) 0)
    (N : Subgroup (Equiv.Perm ℚ)) (hNΓ : N ≤ Γ) (hN : ∀ n ∈ N, ∀ g ∈ Γ, g * n * g⁻¹ ∈ N)
    (hne : N ≠ ⊥) : ⁅Γ, Γ⁆ ≤ N := by
  have hcoreN := commutator_perCore_le_of_ne_bot Γ N hΓ hcore hNΓ hN hne
  obtain ⟨u, huΓ, hu0, hu1⟩ := exists_mem_unit_of_not_int Γ (hΓ hh)
    (fun n hn => Γ.mul_mem (Γ.mul_mem hh hn) (Γ.inv_mem hh)) hcore hnot
  obtain ⟨g₁, hg₁, hg₁0, hg₁1⟩ :=
    exists_mem_unit_of_not_int N (hΓ hh) (fun n hn => hN n hn h hh) hcoreN hnot
  exact commutator_le_of_generators Γ N (fixZero Γ) (unitSet Γ) hN
    (fun g hg => (mem_fixZero.mp hg).1) ((commutator_fixZero_le hΓ).trans hcoreN)
    (le_closure_unitSet hΓ hcore huΓ hu0 hu1) (fun s hs => hs.1)
    (exists_fixZero_inv_mul_mem hΓ N hNΓ hN hcoreN hg₁ hg₁0 hg₁1 hres)

end ProperQuotient

/-! ## `Q₂` -/

/-- **Hyde–Lodha's `Q₂ = ⁅Γ₂, Γ₂⁆`.** -/
abbrev qTwo : Subgroup (Equiv.Perm ℚ) := ⁅gammaTwo, gammaTwo⁆

theorem commutator_normalized {G H K : Subgroup (Equiv.Perm ℚ)}
    (hH : ∀ x ∈ H, ∀ g ∈ G, g * x * g⁻¹ ∈ H) (hK : ∀ x ∈ K, ∀ g ∈ G, g * x * g⁻¹ ∈ K) :
    ∀ x ∈ ⁅H, K⁆, ∀ g ∈ G, g * x * g⁻¹ ∈ ⁅H, K⁆ := by
  intro x hx g hg
  have hle : ⁅H, K⁆ ≤ (⁅H, K⁆).comap (MulAut.conj g).toMonoidHom := by
    rw [Subgroup.commutator_le]
    intro a ha b hb
    rw [Subgroup.mem_comap]
    have e : (MulAut.conj g).toMonoidHom ⁅a, b⁆ = ⁅g * a * g⁻¹, g * b * g⁻¹⁆ := by
      rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
      simp only [commutatorElement_def]
      group
    rw [e]
    exact Subgroup.commutator_mem_commutator (hH a ha g hg) (hK b hb g hg)
  have h' := hle hx
  rwa [Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at h'

theorem gammaTwo_normalized : ∀ x ∈ gammaTwo, ∀ g ∈ gammaTwo, g * x * g⁻¹ ∈ gammaTwo :=
  fun _ hx _ hg => gammaTwo.mul_mem (gammaTwo.mul_mem hg hx) (gammaTwo.inv_mem hg)

theorem qTwo_normalized : ∀ x ∈ qTwo, ∀ g ∈ gammaTwo, g * x * g⁻¹ ∈ qTwo :=
  commutator_normalized gammaTwo_normalized gammaTwo_normalized

theorem qTwo_le_gammaTwo : qTwo ≤ gammaTwo := commutator_le_self _

theorem commutator_perCore_le_qTwo : ⁅perCore 4, perCore 4⁆ ≤ qTwo :=
  commutator_perCore_le_gammaTwo

theorem unit_mem_qTwo : ∃ u ∈ qTwo, 0 < u 0 ∧ u 0 < 1 :=
  exists_mem_unit_of_not_int qTwo lamPerm_mem_gammaTwo
    (fun n hn => qTwo_normalized n hn lamPerm lamPerm_mem_gammaTwo) commutator_perCore_le_qTwo
    lamPerm_zero_not_int

theorem not_int_of_mem_unit {u : Equiv.Perm ℚ} (hu0 : 0 < u 0) (hu1 : u 0 < 1) :
    ∀ k : ℤ, u 0 ≠ k := by
  intro k hk
  rw [hk] at hu0 hu1
  have h0 : (0 : ℤ) < k := by exact_mod_cast hu0
  have h1 : k < 1 := by exact_mod_cast hu1
  omega

theorem commutator_commutator_perCore_ne_bot :
    ⁅⁅perCore 4, perCore 4⁆, ⁅perCore 4, perCore 4⁆⁆ ≠ ⊥ := by
  haveI := isSimpleGroup_commutator_compactCore (m := 4)
  have htf : ∀ g ∈ ⁅compactCore 4, compactCore 4⁆, ∀ n : ℕ, 0 < n → g ^ n = 1 → g = 1 :=
    fun g hg n hn hgn =>
      eq_one_of_pow_eq_one (compactF_strictMono (compactCore_le (commutator_le_self _ hg))) hn hgn
  have hne := commutator_ne_bot_of_isSimpleGroup (⁅compactCore 4, compactCore 4⁆) htf
  have hle : ⁅⁅compactCore 4, compactCore 4⁆, ⁅compactCore 4, compactCore 4⁆⁆ ≤
      ((⁅⁅perCore 4, perCore 4⁆, ⁅perCore 4, perCore 4⁆⁆).comap (perHom 4)).map
        (compactF 4 1).subtype := by
    rw [Subgroup.commutator_le]
    intro a ha b hb
    have haF : a ∈ compactF 4 1 := compactCore_le (commutator_le_self _ ha)
    have hbF : b ∈ compactF 4 1 := compactCore_le (commutator_le_self _ hb)
    refine ⟨⁅(⟨a, haF⟩ : ↥(compactF 4 1)), ⟨b, hbF⟩⁆, ?_, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap, map_commutatorElement]
    exact Subgroup.commutator_mem_commutator (perHom_mem_commutator_perCore 4 (x := ⟨a, haF⟩) ha)
      (perHom_mem_commutator_perCore 4 (x := ⟨b, hbF⟩) hb)
  obtain ⟨⟨x, hx⟩, hx1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
  obtain ⟨y, hy, hyx⟩ := hle hx
  rw [SetLike.mem_coe, Subgroup.mem_comap] at hy
  intro hbot
  rw [hbot, Subgroup.mem_bot] at hy
  apply hx1
  apply Subtype.ext
  show x = 1
  rw [← hyx, (perHom_injective 4) (hy.trans (map_one _).symm), map_one]

theorem commutator_qTwo_ne_bot : ⁅qTwo, qTwo⁆ ≠ ⊥ := by
  intro hbot
  apply commutator_commutator_perCore_ne_bot
  rw [eq_bot_iff, ← hbot]
  exact Subgroup.commutator_mono commutator_perCore_le_qTwo commutator_perCore_le_qTwo

section Printed

variable (hres : ∀ f ∈ gammaTwo, 0 ≤ f 0 → f 0 < 1 → ResEq 4 (f 0) 0)
include hres

/-- **`Q₂ = ⁅Q₂, Q₂⁆`** (proof of Proposition 3.11, first sentence). -/
theorem qTwo_le_commutator : qTwo ≤ ⁅qTwo, qTwo⁆ :=
  commutator_le_of_normal le_rfl (commutator_perCore_le_qTwo.trans qTwo_le_gammaTwo)
    lamPerm_mem_gammaTwo lamPerm_zero_not_int hres ⁅qTwo, qTwo⁆
    ((commutator_le_self _).trans qTwo_le_gammaTwo) (commutator_normalized qTwo_normalized
      qTwo_normalized) commutator_qTwo_ne_bot

/-- **Hyde–Lodha, Proposition 3.11.** -/
theorem isSimpleGroup_qTwo : IsSimpleGroup ↥qTwo := by
  obtain ⟨u, huQ, hu0, hu1⟩ := unit_mem_qTwo
  have hQne : qTwo ≠ ⊥ := fun h => commutator_qTwo_ne_bot (by rw [h]; exact Subgroup.commutator_bot_left _)
  have hnt : Nontrivial ↥qTwo := (Subgroup.nontrivial_iff_ne_bot _).mpr hQne
  refine { toNontrivial := hnt, eq_bot_or_eq_top_of_normal := fun H hH => ?_ }
  by_cases hbot : H = ⊥
  · exact Or.inl hbot
  right
  have hNnorm : ∀ n ∈ H.map qTwo.subtype, ∀ g ∈ qTwo, g * n * g⁻¹ ∈ H.map qTwo.subtype := by
    rintro n ⟨x, hxH, rfl⟩ g hg
    exact ⟨⟨g, hg⟩ * x * ⟨g, hg⟩⁻¹, hH.conj_mem x hxH ⟨g, hg⟩, rfl⟩
  have hNne : H.map qTwo.subtype ≠ ⊥ := by
    intro h
    apply hbot
    rw [eq_bot_iff]
    intro x hx
    have hxm : (x : Equiv.Perm ℚ) ∈ H.map qTwo.subtype := ⟨x, hx, rfl⟩
    rw [h, Subgroup.mem_bot] at hxm
    exact Subgroup.mem_bot.mpr (Subtype.ext hxm)
  have hNQ : H.map qTwo.subtype ≤ qTwo := by
    rintro _ ⟨x, -, rfl⟩
    exact x.2
  have hle := commutator_le_of_normal qTwo_le_gammaTwo commutator_perCore_le_qTwo huQ
    (not_int_of_mem_unit hu0 hu1) hres (H.map qTwo.subtype) hNQ hNnorm hNne
  rw [Subgroup.eq_top_iff']
  intro x
  obtain ⟨y, hyH, hyx⟩ := ((qTwo_le_commutator hres).trans hle) x.2
  have hyx' : y = x := Subtype.ext hyx
  rw [← hyx']
  exact hyH

end Printed

theorem qTwo_torsionFree : IsPowerTorsionFree ↥qTwo :=
  isPowerTorsionFree_of_strictMono qTwo fun _ hf => gammaTwo_strictMono (qTwo_le_gammaTwo hf)

theorem infinite_qTwo : Infinite ↥qTwo := by
  obtain ⟨u, huQ, hu0, -⟩ := unit_mem_qTwo
  refine infinite_of_torsionFree qTwo_torsionFree (g := ⟨u, huQ⟩) ?_
  intro h
  have h' := congrArg (fun g : ↥qTwo => (g : Equiv.Perm ℚ) 0) h
  simp only [OneMemClass.coe_one, Equiv.Perm.one_apply] at h'
  linarith

#audit_axioms GroupApproximation.HydeLodha.commutator_le_of_normal
#audit_axioms GroupApproximation.HydeLodha.commutator_qTwo_ne_bot
#audit_axioms GroupApproximation.HydeLodha.isSimpleGroup_qTwo
#audit_axioms GroupApproximation.HydeLodha.qTwo_torsionFree
#audit_axioms GroupApproximation.HydeLodha.infinite_qTwo

end HydeLodha
