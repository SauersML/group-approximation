import GroupApproximation.GroupTheory.HydeLodha.QTwoFinitePresentationShort
import GroupApproximation.GroupTheory.HigmanThompson.RstabGerms
import GroupApproximation.Meta.AxiomGuard

/-!
# Lemma 4.6: the twisted generators `v_i = u_i s_i⁻¹ u_i⁻¹ s_i`

Hyde–Lodha, proof of Lemma 4.6: "Let `J_0 = J·f`. We choose `s_i ∈ Υ_{F_{η_n}'}(J) ≤ Υ_Γ(I)` such that
`{J_i = J_0·s_i | 1 ≤ i ≤ η_n}` are pairwise disjoint intervals in `J \ J_0`.  We know that
`Υ_{Γ_n}(J_0) ≅ Rstab_{F_{η_n}}(J_0) ≅ F_{η_n}` (the latter follows from Lemma [Fnproximal]).  Fix a
generating set `u_1, ..., u_{η_n}` for `Υ_{Γ_n}(J_0)` and set `v_i = u_i s_i^{-1} u_i^{-1} s_i`.  Since the set
of relators of `F_{η_n}` in the prescribed generating set `u_1, ..., u_{η_n}` are all products of commutators,
`H = ⟨v_1, ..., v_{η_n}⟩` also satisfies them and hence is isomorphic to `F_{η_n}`.  It follows that
`H' = Υ_{Γ_n}(J_0)'`."

Here `η₂ = 6`, `J₀ = [c, d]` with `0 < c < d < 1` in `ℤ[1/6]`, and `u` is the image of Brown's generators
under `F_6 ≅ Rstab_{F_6}([c, d]) ≅ Υ_{Γ₂}([c, d])`.  Permutations compose right to left, so the paper's
`u_i s_i⁻¹ u_i⁻¹ s_i` is `s i * (u i)⁻¹ * (s i)⁻¹ * u i = w_i * u_i` with `w_i = s i * (u i)⁻¹ * (s i)⁻¹`
supported in `J_i = s_i(J₀) + ℤ`.

* `brownRels_le_commutator`: Brown's relators are products of commutators.
* `exists_mulEquiv_closure_mul`: if `φ` embeds a presented group whose relators are products of
  commutators, and the twists `w_i` generate a group commuting with itself and with `φ`, meeting the
  range of `φ` trivially, then `x ↦ χ(x) φ(x)` (with `χ(of i) = w_i`) embeds it onto `⟨w_i u_i⟩`, and the
  commutator subgroups agree.
* `exists_twisted_generators`: the statement for `Υ_{Γ₂}(J₀)`.
-/

namespace GroupApproximation
namespace HydeLodha

open scoped commutatorElement
open HigmanThompson

/-! ## Groups generated by commuting twists -/

/-- Permutations supported in `U`. -/
def supportedInSubgroup {X : Type*} (U : Set X) : Subgroup (Equiv.Perm X) where
  carrier := {g | SupportedIn g U}
  one_mem' := supportedIn_one U
  mul_mem' := by
    intro f g hf hg
    have hf' : SupportedIn f U := hf
    have hg' : SupportedIn g U := hg
    exact (hf'.mul hg').mono (Set.union_subset subset_rfl subset_rfl)
  inv_mem' := by
    intro f hf
    have hf' : SupportedIn f U := hf
    exact hf'.inv

theorem mem_supportedInSubgroup {X : Type*} {U : Set X} {g : Equiv.Perm X} :
    g ∈ supportedInSubgroup U ↔ SupportedIn g U := Iff.rfl

theorem commutator_eq_bot_of_commute {G : Type*} [Group G] (W : Subgroup G)
    (h : ∀ g₁ ∈ W, ∀ g₂ ∈ W, Commute g₁ g₂) : ⁅W, W⁆ = ⊥ := by
  rw [eq_bot_iff, Subgroup.commutator_le]
  intro g₁ h₁ g₂ h₂
  exact Subgroup.mem_bot.mpr (commutatorElement_eq_one_iff_mul_comm.mpr (h g₁ h₁ g₂ h₂).eq)

theorem commute_closure_of_commute {G : Type*} [Group G] {s : Set G}
    (h : ∀ x ∈ s, ∀ y ∈ s, Commute x y) :
    ∀ g₁ ∈ Subgroup.closure s, ∀ g₂ ∈ Subgroup.closure s, Commute g₁ g₂ := by
  have h1 : Subgroup.closure s ≤ Subgroup.centralizer s := by
    rw [Subgroup.closure_le]
    intro x hx
    exact Subgroup.mem_centralizer_iff.mpr fun y hy => (h y hy x hx).eq
  have h2 : Subgroup.closure s ≤ Subgroup.centralizer (Subgroup.closure s : Set G) := by
    rw [Subgroup.closure_le]
    intro x hx
    exact Subgroup.mem_centralizer_iff.mpr fun y hy =>
      (Subgroup.mem_centralizer_iff.mp (h1 hy) x hx).symm
  intro g₁ hg₁ g₂ hg₂
  exact Subgroup.mem_centralizer_iff.mp (h2 hg₂) g₁ hg₁

theorem map_top_le_of_closure_eq_top {H G : Type*} [Group H] [Group G] {s : Set H}
    (hs : Subgroup.closure s = ⊤) (f : H →* G) (W : Subgroup G) (hf : ∀ x ∈ s, f x ∈ W) :
    (⊤ : Subgroup H).map f ≤ W := by
  rw [← hs, Subgroup.map_closure, Subgroup.closure_le]
  rintro _ ⟨x, hx, rfl⟩
  exact hf x hx

theorem map_eq_one_of_mem_commutator_top {H G : Type*} [Group H] [Group G] {s : Set H}
    (hs : Subgroup.closure s = ⊤) (f : H →* G) (W : Subgroup G) (hW : ⁅W, W⁆ = ⊥)
    (hf : ∀ x ∈ s, f x ∈ W) {y : H} (hy : y ∈ ⁅(⊤ : Subgroup H), ⊤⁆) : f y = 1 := by
  have hle := map_top_le_of_closure_eq_top hs f W hf
  have hmem : f y ∈ ⁅W, W⁆ := Subgroup.commutator_mono hle hle
    (by rw [← Subgroup.map_commutator]; exact Subgroup.mem_map_of_mem f hy)
  rw [hW] at hmem
  exact Subgroup.mem_bot.mp hmem

/-- "Since the set of relators ... are all products of commutators, `H` also satisfies them and hence is
isomorphic": twisting an embedding `φ` of the presented group by commuting `w_i` that commute with `φ`
and meet its range trivially. -/
theorem exists_mulEquiv_closure_mul {G α : Type*} [Group G] {rels : Set (FreeGroup α)}
    (hrels : ∀ r ∈ rels, r ∈ ⁅(⊤ : Subgroup (FreeGroup α)), ⊤⁆)
    (φ : PresentedGroup rels →* G) (hφ : Function.Injective φ) (w : α → G) (W : Subgroup G)
    (hwW : ∀ i, w i ∈ W) (hWcomm : ∀ g₁ ∈ W, ∀ g₂ ∈ W, Commute g₁ g₂)
    (hWφ : ∀ g ∈ W, ∀ x, Commute g (φ x)) (hdisj : ∀ x, φ x ∈ W → φ x = 1) :
    Nonempty (PresentedGroup rels ≃*
        ↥(Subgroup.closure (Set.range fun i => w i * φ (PresentedGroup.of i)))) ∧
      ⁅Subgroup.closure (Set.range fun i => w i * φ (PresentedGroup.of i)),
        Subgroup.closure (Set.range fun i => w i * φ (PresentedGroup.of i))⁆ =
        ⁅φ.range, φ.range⁆ := by
  have hWbot : ⁅W, W⁆ = ⊥ := commutator_eq_bot_of_commute W hWcomm
  have hlift : ∀ r ∈ rels, FreeGroup.lift w r = 1 := fun r hr =>
    map_eq_one_of_mem_commutator_top (FreeGroup.closure_range_of α) (FreeGroup.lift w) W hWbot
      (by rintro _ ⟨i, rfl⟩; rw [FreeGroup.lift_apply_of]; exact hwW i) (hrels r hr)
  let χ : PresentedGroup rels →* G := PresentedGroup.toGroup hlift
  have hχof : ∀ i, χ (PresentedGroup.of i) = w i := fun i => PresentedGroup.toGroup.of hlift
  have hχgen : ∀ x ∈ Set.range (PresentedGroup.of : α → PresentedGroup rels), χ x ∈ W := by
    rintro _ ⟨i, rfl⟩
    rw [hχof]
    exact hwW i
  have hχW : ∀ x, χ x ∈ W := fun x =>
    map_top_le_of_closure_eq_top (PresentedGroup.closure_range_of rels) χ W hχgen
      (Subgroup.mem_map_of_mem χ (Subgroup.mem_top x))
  have hχ1 : ∀ y ∈ ⁅(⊤ : Subgroup (PresentedGroup rels)), ⊤⁆, χ y = 1 := fun y hy =>
    map_eq_one_of_mem_commutator_top (PresentedGroup.closure_range_of rels) χ W hWbot hχgen hy
  have hχcomm : ∀ x y : PresentedGroup rels, Commute (χ x) (φ y) := fun x y => hWφ _ (hχW x) y
  let ψ : PresentedGroup rels →* G := MonoidHom.mk' (fun x => χ x * φ x) fun x y => by
    simp only [map_mul]
    exact (hχcomm y x).mul_mul_mul_comm (χ x) (φ y)
  have hψ : ∀ x, ψ x = χ x * φ x := fun x => rfl
  have hψinj : Function.Injective ψ := by
    rw [injective_iff_map_eq_one]
    intro x hx
    have hx' : χ x * φ x = 1 := (hψ x).symm.trans hx
    have hφW : φ x ∈ W := by
      rw [eq_inv_of_mul_eq_one_right hx']
      exact inv_mem (hχW x)
    apply hφ
    rw [map_one]
    exact hdisj x hφW
  have hψof : (⇑ψ ∘ PresentedGroup.of) = fun i => w i * φ (PresentedGroup.of i) :=
    funext fun i => by
      show ψ (PresentedGroup.of i) = w i * φ (PresentedGroup.of i)
      rw [hψ, hχof]
  have hrange : ψ.range = Subgroup.closure (Set.range fun i => w i * φ (PresentedGroup.of i)) := by
    rw [MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of rels, Subgroup.map_closure,
      ← Set.range_comp, hψof]
  have hcomm : ⁅ψ.range, ψ.range⁆ = ⁅φ.range, φ.range⁆ := by
    rw [MonoidHom.range_eq_map, MonoidHom.range_eq_map, ← Subgroup.map_commutator,
      ← Subgroup.map_commutator]
    ext g
    constructor
    · rintro ⟨x, hx, rfl⟩
      refine Subgroup.mem_map.mpr ⟨x, hx, ?_⟩
      rw [hψ, hχ1 x hx, one_mul]
    · rintro ⟨x, hx, rfl⟩
      refine Subgroup.mem_map.mpr ⟨x, hx, ?_⟩
      rw [hψ, hχ1 x hx, one_mul]
  refine ⟨⟨(MonoidHom.ofInjective hψinj).trans (MulEquiv.subgroupCongr hrange)⟩, ?_⟩
  rw [← hrange]
  exact hcomm

/-! ## Brown's relators -/

/-- Brown's relators `x_i x_j x_i⁻¹ x_{j+m+1}⁻¹` are products of commutators, since
`x_{j+m+1} = x_0 x_j x_0⁻¹`. -/
theorem brownRels_le_commutator (m : ℕ) :
    ∀ r ∈ brownRels m, r ∈ ⁅(⊤ : Subgroup (FreeGroup (Fin (m + 2)))), ⊤⁆ := by
  have key : ∀ a b c : FreeGroup (Fin (m + 2)),
      a * b * a⁻¹ * (c * b * c⁻¹)⁻¹ = ⁅a, b⁆ * ⁅b, c⁆ := by
    intro a b c
    simp only [commutatorElement_def, mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel_left]
  rintro r ⟨i, j, hi, -, hij, -, rfl⟩
  rw [brownWord_of_ge m (show m + 2 ≤ j + m + 1 by omega), show j + m + 1 - (m + 1) = j by omega,
    key]
  exact mul_mem (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _))
    (Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _))

/-! ## The generators of `H` -/

/-- **Hyde–Lodha, proof of Lemma 4.6**: "Fix a generating set `u_1, ..., u_{η_n}` for `Υ_{Γ_n}(J_0)` and set
`v_i = u_i s_i^{-1} u_i^{-1} s_i`. ... `H = ⟨v_1, ..., v_{η_n}⟩` also satisfies them and hence is isomorphic to
`F_{η_n}`.  It follows that `H' = Υ_{Γ_n}(J_0)'`."  For `J₀ = [c, d]`, any `s_i` moving `J₀ + ℤ` to pairwise
disjoint sets off `J₀ + ℤ` will do. -/
theorem exists_twisted_generators {c d : ℚ} (hc : ∃ M, c ∈ Grid 6 M) (hd : ∃ M, d ∈ Grid 6 M)
    (h0c : 0 < c) (hcd : c < d) (hd1 : d < 1) :
    ∃ u : Fin 6 → Equiv.Perm ℚ, Subgroup.closure (Set.range u) = upsilon gammaTwo c d ∧
      ∀ s : Fin 6 → Equiv.Perm ℚ,
        (∀ i, Disjoint (s i '' perIoo c d) (perIoo c d)) →
        (∀ i j, i ≠ j → Disjoint (s i '' perIoo c d) (s j '' perIoo c d)) →
        Nonempty (BrownGroup 4 ≃*
          ↥(Subgroup.closure (Set.range fun i => s i * (u i)⁻¹ * (s i)⁻¹ * u i))) ∧
        ⁅Subgroup.closure (Set.range fun i => s i * (u i)⁻¹ * (s i)⁻¹ * u i),
          Subgroup.closure (Set.range fun i => s i * (u i)⁻¹ * (s i)⁻¹ * u i)⁆ =
          ⁅upsilon gammaTwo c d, upsilon gammaTwo c d⁆ := by
  obtain ⟨e₂⟩ := rstab_equiv_compactF_one (m := 4) hc hd hcd
  let e : BrownGroup 4 ≃* ↥(upsilon gammaTwo c d) :=
    (MonoidHom.ofInjective (brownEval_injective 4)).trans
      ((MulEquiv.subgroupCongr (geoF_eq_brownF 4).symm).trans
        ((geoFEquivCompactF 4 1 le_rfl).trans (e₂.symm.trans (rstabEquivUpsilon h0c hcd hd1))))
  let φ : BrownGroup 4 →* Equiv.Perm ℚ := (upsilon gammaTwo c d).subtype.comp e.toMonoidHom
  have hφinj : Function.Injective φ := by
    intro x y h
    apply e.injective
    apply Subtype.ext
    exact h
  have hφmem : ∀ x, φ x ∈ upsilon gammaTwo c d := fun x => (e x).2
  have hφrange : φ.range = upsilon gammaTwo c d := by
    ext g
    constructor
    · intro hg
      obtain ⟨x, rfl⟩ := MonoidHom.mem_range.mp hg
      exact hφmem x
    · intro hg
      exact MonoidHom.mem_range.mpr
        ⟨e.symm ⟨g, hg⟩, congrArg Subtype.val (e.apply_symm_apply ⟨g, hg⟩)⟩
  have hu : ∀ x, SupportedIn (φ x) (perIoo c d) := fun x => (mem_upsilon.mp (hφmem x)).2
  refine ⟨⇑φ ∘ PresentedGroup.of, ?_, ?_⟩
  · rw [← hφrange, MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of (brownRels 4),
      Subgroup.map_closure, Set.range_comp]
  · intro s hs1 hs2
    let w : Fin 6 → Equiv.Perm ℚ := fun i => s i * (φ (PresentedGroup.of i))⁻¹ * (s i)⁻¹
    have hwV : ∀ i, SupportedIn (w i) (s i '' perIoo c d) := fun i =>
      (hu (PresentedGroup.of i)).inv.conj (s i)
    have hVdisj : Disjoint (⋃ i, s i '' perIoo c d) (perIoo c d) :=
      Set.disjoint_iUnion_left.mpr hs1
    have hTS : Subgroup.closure (Set.range w) ≤ supportedInSubgroup (⋃ i, s i '' perIoo c d) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact (hwV i).mono (Set.subset_iUnion (fun i => s i '' perIoo c d) i)
    have hwcomm : ∀ g₁ ∈ Subgroup.closure (Set.range w), ∀ g₂ ∈ Subgroup.closure (Set.range w),
        Commute g₁ g₂ := by
      apply commute_closure_of_commute
      rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
      by_cases hij : i = j
      · subst hij
        exact Commute.refl _
      · exact commute_of_supportedIn (hwV i) (hwV j) (hs2 i j hij)
    have hWφ : ∀ g ∈ Subgroup.closure (Set.range w), ∀ x, Commute g (φ x) := fun g hg x =>
      commute_of_supportedIn (mem_supportedInSubgroup.mp (hTS hg)) (hu x) hVdisj
    have hdisj : ∀ x, φ x ∈ Subgroup.closure (Set.range w) → φ x = 1 := by
      intro x hx
      have h2 := mem_supportedInSubgroup.mp (hTS hx)
      ext t
      by_cases ht : t ∈ ⋃ i, s i '' perIoo c d
      · exact hu x t (Set.disjoint_left.mp hVdisj ht)
      · exact h2 t ht
    have key := exists_mulEquiv_closure_mul (brownRels_le_commutator 4) φ hφinj w
      (Subgroup.closure (Set.range w)) (fun i => Subgroup.subset_closure ⟨i, rfl⟩) hwcomm hWφ hdisj
    rw [hφrange] at key
    exact key

#audit_axioms GroupApproximation.HydeLodha.brownRels_le_commutator
#audit_axioms GroupApproximation.HydeLodha.exists_mulEquiv_closure_mul
#audit_axioms GroupApproximation.HydeLodha.exists_twisted_generators

