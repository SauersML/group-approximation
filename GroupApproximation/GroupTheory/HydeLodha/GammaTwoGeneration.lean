import GroupApproximation.GroupTheory.HydeLodha.GammaTwoCoreMoves
import GroupApproximation.Meta.AxiomGuard

/-!
# Generation by `Γ_{<1}`

Hyde–Lodha, Lemma 3.9(4): "`Γ` is generated by `Γ_{<1} = {g ∈ Γ | 0 ≤ 0·g < 1}`", for a subgroup
`Γ ≤ Γ₂` containing the periodic copy of `F_6'`.  Their proof uses minimality; here the reduction is
explicit, given one `u ∈ Γ` with `0 < u 0 < 1` (Lemma 3.9(2), `exists_mem_unit_of_not_int`).

* `mem_closure_unitSet_of_step`: if `⌊h 0⌋ = k ≥ 1`, then `w = u⁻¹ P h` for a suitable `P ∈ F_6'`
  has `⌊w 0⌋ = k - 1`, and `h ∈ ⟨Γ_{<1}⟩` once `w ∈ ⟨Γ_{<1}⟩`.  `P` moves the fractional part
  `r` of `h 0` below `u 0` (or `P = 1` when `r = 0`), and `u⁻¹` maps `(0, u 0)` into `(-1, 0)`.
* `floor_inv_apply_zero`: `⌊h⁻¹ 0⌋ ∈ {-k, -k - 1}` when `⌊h 0⌋ = k`.
* `le_closure_unitSet`: induction on `|⌊h 0⌋|`.
-/

namespace GroupApproximation
namespace HydeLodha

open HigmanThompson

/-- `Γ_{<1}`. -/
def unitSet (Γ : Subgroup (Equiv.Perm ℚ)) : Set (Equiv.Perm ℚ) := {g | g ∈ Γ ∧ 0 ≤ g 0 ∧ g 0 < 1}

theorem inv_apply_zero_mem {u : Equiv.Perm ℚ} (hu : u ∈ gammaTwo) (hu0 : 0 < u 0) (hu1 : u 0 < 1) :
    -1 < u⁻¹ 0 ∧ u⁻¹ 0 < 0 := by
  have hmono := gammaTwo_strictMono hu
  have e := gammaTwo_add_int hu (-1) 1
  have e' : (-1 : ℚ) + ((1 : ℤ) : ℚ) = 0 := by norm_num
  rw [e'] at e
  push_cast at e
  refine ⟨?_, ?_⟩
  · by_contra hc
    have h' := hmono.monotone (not_lt.mp hc)
    rw [perm_apply_inv_self] at h'
    linarith
  · by_contra hc
    have h' := hmono.monotone (not_lt.mp hc)
    rw [perm_apply_inv_self] at h'
    linarith

section Generation

variable {Γ : Subgroup (Equiv.Perm ℚ)}

theorem mem_closure_unitSet_of_step (hΓ : Γ ≤ gammaTwo) (hcore : ⁅perCore 4, perCore 4⁆ ≤ Γ)
    {u : Equiv.Perm ℚ} (huΓ : u ∈ Γ) (hu0 : 0 < u 0) (hu1 : u 0 < 1) {h : Equiv.Perm ℚ}
    (hh : h ∈ Γ) (_hk : 1 ≤ ⌊h 0⌋) :
    ∃ w ∈ Γ, ⌊w 0⌋ = ⌊h 0⌋ - 1 ∧
      (w ∈ Subgroup.closure (unitSet Γ) → h ∈ Subgroup.closure (unitSet Γ)) := by
  obtain ⟨k, hkdef⟩ : ∃ k : ℤ, ⌊h 0⌋ = k := ⟨_, rfl⟩
  rw [hkdef]
  have hu := hΓ huΓ
  obtain ⟨hui1, hui0⟩ := inv_apply_zero_mem hu hu0 hu1
  have hui := gammaTwo.inv_mem hu
  have hmi := gammaTwo_strictMono hui
  have huT : u ∈ Subgroup.closure (unitSet Γ) := Subgroup.subset_closure ⟨huΓ, hu0.le, hu1⟩
  rcases lt_or_eq_of_le (Int.fract_nonneg (h 0)) with hr | hr
  · have hrg := fract_grid (gammaTwo_apply_grid (hΓ hh) zero_mem_grid_six)
    obtain ⟨y, hy0, hy1, hyres, hyg⟩ := exists_resEq_mem_Ioo (m := 4) hrg (lt_min hr hu0)
    have hyr : y < Int.fract (h 0) := lt_of_lt_of_le hy1 (min_le_left _ _)
    have hys : y < u 0 := lt_of_lt_of_le hy1 (min_le_right _ _)
    obtain ⟨a, haK, hax⟩ := exists_perCore_apply hrg hyg hyres hr (Int.fract_lt_one _) hy0
      (by linarith [Int.fract_lt_one (h 0)])
    have hPΓ : perHom 4 a ∈ Γ := hcore haK
    have hP0 : perHom 4 a 0 = 0 := by exact_mod_cast perHom_apply_intCast a 0
    have hPT : perHom 4 a ∈ Subgroup.closure (unitSet Γ) :=
      Subgroup.subset_closure ⟨hPΓ, le_of_eq hP0.symm, by rw [hP0]; norm_num⟩
    have hPh : perHom 4 a (h 0) = y + k := by
      have e := perHom_add_int 4 a (Int.fract (h 0)) ⌊h 0⌋
      rw [Int.fract_add_floor, hax, hkdef] at e
      exact e
    have hw0 : (u⁻¹ * perHom 4 a * h) 0 = u⁻¹ y + k := by
      simp only [Equiv.Perm.mul_apply]
      rw [hPh]
      exact gammaTwo_add_int hui y k
    have hyl : u⁻¹ 0 < u⁻¹ y := hmi hy0
    have hyh : u⁻¹ y < 0 := by
      have h' := hmi hys
      rwa [perm_inv_apply_self] at h'
    refine ⟨u⁻¹ * perHom 4 a * h, Γ.mul_mem (Γ.mul_mem (Γ.inv_mem huΓ) hPΓ) hh, ?_, fun hw => ?_⟩
    · rw [hw0]
      refine Int.floor_eq_iff.mpr ⟨?_, ?_⟩ <;> push_cast <;> linarith
    · have e : h = (perHom 4 a)⁻¹ * u * (u⁻¹ * perHom 4 a * h) := by group
      rw [e]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hPT) huT) hw
  · have hh0 : h 0 = k := by
      have e := Int.fract_add_floor (h 0)
      rw [← hr, zero_add, hkdef] at e
      exact e.symm
    have hw0 : (u⁻¹ * h) 0 = u⁻¹ 0 + k := by
      simp only [Equiv.Perm.mul_apply]
      rw [hh0]
      have e := gammaTwo_add_int hui 0 k
      rwa [zero_add] at e
    refine ⟨u⁻¹ * h, Γ.mul_mem (Γ.inv_mem huΓ) hh, ?_, fun hw => ?_⟩
    · rw [hw0]
      refine Int.floor_eq_iff.mpr ⟨?_, ?_⟩ <;> push_cast <;> linarith
    · have e : h = u * (u⁻¹ * h) := by group
      rw [e]
      exact Subgroup.mul_mem _ huT hw

theorem floor_inv_apply_zero {h : Equiv.Perm ℚ} (hh : h ∈ gammaTwo) {k : ℤ} (hk : ⌊h 0⌋ = k) :
    ⌊h⁻¹ 0⌋ = -k ∨ ⌊h⁻¹ 0⌋ = -k - 1 := by
  have hmono := gammaTwo_strictMono hh
  have hb := Int.floor_eq_iff.mp hk
  have e1 := gammaTwo_add_int hh 0 (-k)
  have e2 := gammaTwo_add_int hh 0 (-k - 1)
  rw [zero_add] at e1 e2
  have hx : h (h⁻¹ 0) = 0 := perm_apply_inv_self h 0
  have hup : h⁻¹ 0 ≤ ((-k : ℤ) : ℚ) := by
    by_contra hc
    have h' := hmono (not_le.mp hc)
    rw [e1, hx] at h'
    push_cast at h'
    linarith [hb.1]
  have hlow : ((-k - 1 : ℤ) : ℚ) < h⁻¹ 0 := by
    by_contra hc
    have h' := hmono.monotone (not_lt.mp hc)
    rw [e2, hx] at h'
    push_cast at h'
    linarith [hb.2]
  rcases lt_or_eq_of_le hup with hlt | heq
  · right
    refine Int.floor_eq_iff.mpr ⟨hlow.le, ?_⟩
    push_cast at hlt ⊢
    linarith
  · left
    rw [heq]
    exact Int.floor_intCast (-k)

theorem mem_closure_unitSet_of_natAbs_le (hΓ : Γ ≤ gammaTwo)
    (hcore : ⁅perCore 4, perCore 4⁆ ≤ Γ) {u : Equiv.Perm ℚ} (huΓ : u ∈ Γ) (hu0 : 0 < u 0)
    (hu1 : u 0 < 1) (n : ℕ) :
    ∀ h ∈ Γ, ⌊h 0⌋.natAbs ≤ n → h ∈ Subgroup.closure (unitSet Γ) := by
  induction n with
  | zero =>
    intro h hh hn
    have hz : ⌊h 0⌋ = 0 := by omega
    obtain ⟨h1, h2⟩ := Int.floor_eq_iff.mp hz
    push_cast at h1 h2
    exact Subgroup.subset_closure ⟨hh, h1, by linarith⟩
  | succ n ih =>
    intro h hh hn
    obtain ⟨k, hk⟩ : ∃ k : ℤ, ⌊h 0⌋ = k := ⟨_, rfl⟩
    rw [hk] at hn
    rcases (by omega : k = 0 ∨ 1 ≤ k ∨ k ≤ -1) with hk0 | hk1 | hkn
    · exact ih h hh (by rw [hk, hk0]; omega)
    · obtain ⟨w, hwΓ, hw0, hwh⟩ :=
        mem_closure_unitSet_of_step hΓ hcore huΓ hu0 hu1 hh (by rw [hk]; exact hk1)
      exact hwh (ih w hwΓ (by rw [hw0, hk]; omega))
    · have hhi : h⁻¹ ∈ Γ := Γ.inv_mem hh
      have hinv : h⁻¹ ∈ Subgroup.closure (unitSet Γ) := by
        rcases floor_inv_apply_zero (hΓ hh) hk with hf | hf
        · obtain ⟨w, hwΓ, hw0, hwh⟩ :=
            mem_closure_unitSet_of_step hΓ hcore huΓ hu0 hu1 hhi (by rw [hf]; omega)
          exact hwh (ih w hwΓ (by rw [hw0, hf]; omega))
        · exact ih h⁻¹ hhi (by rw [hf]; omega)
      simpa using Subgroup.inv_mem _ hinv

/-- **Hyde–Lodha, Lemma 3.9(4).** -/
theorem le_closure_unitSet (hΓ : Γ ≤ gammaTwo) (hcore : ⁅perCore 4, perCore 4⁆ ≤ Γ)
    {u : Equiv.Perm ℚ} (huΓ : u ∈ Γ) (hu0 : 0 < u 0) (hu1 : u 0 < 1) :
    Γ ≤ Subgroup.closure (unitSet Γ) :=
  fun h hh => mem_closure_unitSet_of_natAbs_le hΓ hcore huΓ hu0 hu1 _ h hh le_rfl

end Generation

#audit_axioms GroupApproximation.HydeLodha.inv_apply_zero_mem
#audit_axioms GroupApproximation.HydeLodha.mem_closure_unitSet_of_step
#audit_axioms GroupApproximation.HydeLodha.floor_inv_apply_zero
#audit_axioms GroupApproximation.HydeLodha.le_closure_unitSet

end HydeLodha
end GroupApproximation
