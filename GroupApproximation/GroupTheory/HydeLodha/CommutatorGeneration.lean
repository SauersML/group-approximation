import GroupApproximation.GroupTheory.HydeLodha.HigmanEpstein
import GroupApproximation.Meta.AxiomGuard

/-!
# Abelian quotients through generators, and torsion-free simple groups

Two group-theoretic steps of Hyde–Lodha's simplicity proof (their Lemma 3.12), in element form.

* `commutator_le_of_generators`: let `N` be normalized by `Γ`, `A ≤ Γ` with `⁅A, A⁆ ≤ N`, and let
  `Γ` be generated by a set `T ⊆ Γ` each of whose elements lies in `A · N`.  Then `⁅Γ, Γ⁆ ≤ N`
  ("`Γ/N` is generated by the image of `A`, which is abelian").
* `commutator_ne_bot_of_isSimpleGroup`: a torsion-free simple group is not abelian, so its derived
  subgroup is nontrivial.
* `infinite_of_torsionFree`: a nontrivial torsion-free group is infinite.
-/

namespace GroupApproximation
namespace HydeLodha

open scoped commutatorElement

variable {M : Type*} [Group M]

/-- **`Γ/N` is abelian** when it is generated by the image of a subgroup `A` with abelian image. -/
theorem commutator_le_of_generators (Γ N A : Subgroup M) (T : Set M)
    (hN : ∀ n ∈ N, ∀ g ∈ Γ, g * n * g⁻¹ ∈ N) (hAΓ : A ≤ Γ) (hA : ⁅A, A⁆ ≤ N)
    (hΓT : Γ ≤ Subgroup.closure T) (hTΓ : T ⊆ Γ) (hT : ∀ s ∈ T, ∃ a ∈ A, a⁻¹ * s ∈ N) :
    ⁅Γ, Γ⁆ ≤ N := by
  let R : Subgroup M :=
    { carrier := {x | x ∈ Γ ∧ ∃ a ∈ A, a⁻¹ * x ∈ N}
      one_mem' := ⟨Γ.one_mem, 1, A.one_mem, by rw [inv_one, one_mul]; exact N.one_mem⟩
      mul_mem' := by
        rintro x y ⟨hx, a, ha, hax⟩ ⟨hy, b, hb, hby⟩
        refine ⟨Γ.mul_mem hx hy, a * b, A.mul_mem ha hb, ?_⟩
        have e : (a * b)⁻¹ * (x * y) = (b⁻¹ * (a⁻¹ * x) * b⁻¹⁻¹) * (b⁻¹ * y) := by group
        rw [e]
        exact N.mul_mem (hN _ hax _ (Γ.inv_mem (hAΓ hb))) hby
      inv_mem' := by
        rintro x ⟨hx, a, ha, hax⟩
        refine ⟨Γ.inv_mem hx, a⁻¹, A.inv_mem ha, ?_⟩
        have e : a⁻¹⁻¹ * x⁻¹ = a * (a⁻¹ * x)⁻¹ * a⁻¹ := by group
        rw [e]
        exact hN _ (N.inv_mem hax) _ (hAΓ ha) }
  have hΓR : Γ ≤ R :=
    hΓT.trans ((Subgroup.closure_le R).mpr fun s hs => ⟨hTΓ hs, hT s hs⟩)
  rw [Subgroup.commutator_le]
  intro x hx y hy
  obtain ⟨-, a, ha, hax⟩ := hΓR hx
  obtain ⟨-, b, hb, hby⟩ := hΓR hy
  have e1 : ⁅x, y⁆ = (a * ⁅a⁻¹ * x, y⁆ * a⁻¹) * ⁅a, y⁆ := by
    simp only [commutatorElement_def]
    group
  have e2 : ⁅a, y⁆ = (b * ⁅b⁻¹ * y, a⁆ * b⁻¹ * ⁅b, a⁆)⁻¹ := by
    simp only [commutatorElement_def]
    group
  rw [e1, e2]
  refine N.mul_mem (hN _ (commutatorElement_mem_left hN hax hy) _ (hAΓ ha)) (N.inv_mem ?_)
  exact N.mul_mem (hN _ (commutatorElement_mem_left hN hby (hAΓ ha)) _ (hAΓ hb))
    (hA (Subgroup.commutator_mem_commutator hb ha))

/-- **A torsion-free simple group is not abelian.** -/
theorem commutator_ne_bot_of_isSimpleGroup (K : Subgroup M) [IsSimpleGroup ↥K]
    (htf : ∀ g ∈ K, ∀ n : ℕ, 0 < n → g ^ n = 1 → g = 1) : ⁅K, K⁆ ≠ ⊥ := by
  intro hbot
  have hcomm : ∀ a b : ↥K, a * b = b * a := by
    intro a b
    have h : ⁅(a : M), (b : M)⁆ ∈ ⁅K, K⁆ := Subgroup.commutator_mem_commutator a.2 b.2
    rw [hbot, Subgroup.mem_bot, commutatorElement_eq_one_iff_commute] at h
    exact Subtype.ext h.eq
  have htf' : ∀ g : ↥K, ∀ n : ℕ, 0 < n → g ^ n = 1 → g = 1 := fun g n hn h =>
    Subtype.ext (htf g g.2 n hn (by rw [← Subgroup.coe_pow, h, Subgroup.coe_one]))
  obtain ⟨g, hg1⟩ := exists_ne (1 : ↥K)
  have hHn : (Subgroup.zpowers (g ^ 2)).Normal :=
    ⟨fun n hn x => by rwa [hcomm x n, mul_inv_cancel_right]⟩
  rcases hHn.eq_bot_or_eq_top with hH | hH
  · apply hg1
    have h2 : g ^ 2 ∈ Subgroup.zpowers (g ^ 2) := Subgroup.mem_zpowers _
    rw [hH, Subgroup.mem_bot] at h2
    exact htf' g 2 (by norm_num) h2
  · have hgH : g ∈ Subgroup.zpowers (g ^ 2) := by
      rw [hH]
      exact Subgroup.mem_top g
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hgH
    have h2k : g ^ ((2 : ℤ) * k) = g := by
      rw [zpow_mul, zpow_two, ← pow_two]
      exact hk
    have h1 : g ^ (2 * k - 1) = 1 := by
      rw [zpow_sub_one, h2k, mul_inv_cancel]
    rcases lt_or_gt_of_ne (show (2 * k - 1 : ℤ) ≠ 0 by omega) with hneg | hpos
    · obtain ⟨n, hn⟩ := Int.exists_eq_neg_ofNat hneg.le
      have hn0 : 0 < n := by omega
      apply hg1
      apply htf' g n hn0
      have h3 : g ^ (-(n : ℤ)) = 1 := by
        rw [← hn]
        exact h1
      rw [zpow_neg, zpow_natCast, inv_eq_one] at h3
      exact h3
    · obtain ⟨n, hn⟩ := Int.eq_ofNat_of_zero_le hpos.le
      have hn0 : 0 < n := by omega
      apply hg1
      apply htf' g n hn0
      rw [← zpow_natCast, ← hn]
      exact h1

/-- **A nontrivial torsion-free group is infinite.** -/
theorem infinite_of_torsionFree (htf : ∀ g : M, ∀ n : ℕ, 0 < n → g ^ n = 1 → g = 1) {g : M}
    (hg : g ≠ 1) : Infinite M := by
  refine Infinite.of_injective (fun n : ℕ => g ^ n) fun a b hab => ?_
  by_contra hne
  have key : ∀ a b : ℕ, a < b → g ^ a = g ^ b → False := by
    intro a b h hab'
    apply hg
    apply htf g (b - a) (by omega)
    have e : g ^ b = g ^ a * g ^ (b - a) := by rw [← pow_add, Nat.add_sub_of_le h.le]
    rw [e] at hab'
    exact (mul_left_cancel (hab'.symm.trans (mul_one _).symm))
  rcases lt_or_gt_of_ne hne with h | h
  · exact key a b h hab
  · exact key b a h hab.symm

#audit_axioms GroupApproximation.HydeLodha.commutator_le_of_generators
#audit_axioms GroupApproximation.HydeLodha.commutator_ne_bot_of_isSimpleGroup
#audit_axioms GroupApproximation.HydeLodha.infinite_of_torsionFree

end HydeLodha
end GroupApproximation
