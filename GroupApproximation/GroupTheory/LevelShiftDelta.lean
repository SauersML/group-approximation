import GroupApproximation.Meta.AxiomGuard
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.Finiteness
import Mathlib.GroupTheory.Perm.Basic
import Mathlib.Data.Finite.Prod

/-!
# The second choice of `Δ`: level permutations of `Γ × ℤ`

`simple_kazhdan_sofic_group.tex` at origin/main 696c4b602, section "LEF groups", proof of `cor:lef` and
`cor:host`, tex l.358–366:

> If $\Gamma$ is generated by a finite set $E$, another choice of $\Delta$ keeps a solvable word
> problem. On $\Gamma\times\Z$, whose second coordinate is the level, let $\beta$ raise the level by
> $1$, and let $h_\gamma$ multiply the first coordinate by $\gamma$ on the levels $m\ge0$. Then
> $[\beta,h_\gamma]$ multiplies the level $0$ by $\gamma^{-1}$, so
> $\Delta=\langle\beta,h_\gamma:\gamma\in E\rangle$ is infinite and $\Gamma\le[\Delta,\Delta]$. An
> element of $\Delta$ of length at most $r$ is $f\beta^\ell$ with $|\ell|\le r$, where $f$ multiplies
> the level $m$ by an element $f(m)$ of length at most $r$, with $f(m)=1$ for $m<-r$ and $f(m)=f(r)$
> for $m>r$.

* `levelShift Γ` is `β`, `levelMul γ` is `h_γ`, and `levelZeroMul γ` multiplies the level `0` by `γ`;
* `commutator_levelShift_levelMul`: `⁅β, h_γ⁆ = levelZeroMul γ⁻¹`;
* `levelDelta Γ E = ⟨β, h_γ : γ ∈ E⟩`, with `infinite_levelDelta`, `fg_levelDelta` and
  `exists_levelZeroEmbedding` (`Γ` embeds in `[Δ, Δ]` when `E` generates `Γ`);
* `wordBall S r`: the elements of word length at most `r` in the letters of `S`;
* `IsLevelForm g f ℓ`: `g = fβ^ℓ`, that is `g (x, m) = (f (m + ℓ) * x, m + ℓ)`;
* `exists_levelForm_of_mem_wordBall`: the normal form with the printed bounds (`LevelBounds`).

Permutations compose right to left, `(σ * τ) z = σ (τ z)`, and `⁅σ, τ⁆ = σ τ σ⁻¹ τ⁻¹`.
-/

namespace GroupApproximation
namespace LevelShiftDelta

open Equiv

universe u

/-! ## Word balls -/

section Word

variable {G : Type*} [Group G]

/-- The elements of word length at most `r` in the letters `S` and their inverses. -/
def wordBall (S : Set G) : ℕ → Set G
  | 0 => {1}
  | r + 1 => wordBall S r ∪ {g | ∃ h ∈ wordBall S r, ∃ s, (s ∈ S ∨ s⁻¹ ∈ S) ∧ g = h * s}

theorem mem_wordBall_zero {S : Set G} {g : G} : g ∈ wordBall S 0 ↔ g = 1 := Iff.rfl

theorem wordBall_subset_succ (S : Set G) (r : ℕ) : wordBall S r ⊆ wordBall S (r + 1) :=
  Set.subset_union_left

theorem one_mem_wordBall (S : Set G) : ∀ r, (1 : G) ∈ wordBall S r
  | 0 => rfl
  | r + 1 => wordBall_subset_succ S r (one_mem_wordBall S r)

theorem wordBall_mono (S : Set G) {a b : ℕ} (h : a ≤ b) : wordBall S a ⊆ wordBall S b := by
  induction h with
  | refl => exact Set.Subset.rfl
  | step _ ih => exact ih.trans (wordBall_subset_succ S _)

theorem mul_mem_wordBall_succ {S : Set G} {r : ℕ} {h s : G} (hh : h ∈ wordBall S r)
    (hs : s ∈ S ∨ s⁻¹ ∈ S) : h * s ∈ wordBall S (r + 1) :=
  Or.inr ⟨h, hh, s, hs, rfl⟩

theorem mul_mem_wordBall {S : Set G} {a : ℕ} {g : G} (hg : g ∈ wordBall S a) :
    ∀ {b : ℕ} {h : G}, h ∈ wordBall S b → g * h ∈ wordBall S (a + b)
  | 0, h, hh => by
      rw [mem_wordBall_zero.mp hh, mul_one]
      exact hg
  | b + 1, h, hh => by
      rcases hh with hh | ⟨k, hk, s, hs, rfl⟩
      · exact wordBall_subset_succ S _ (mul_mem_wordBall hg hh)
      · rw [← mul_assoc]
        exact mul_mem_wordBall_succ (mul_mem_wordBall hg hk) hs

theorem inv_mem_wordBall {S : Set G} :
    ∀ {r : ℕ} {g : G}, g ∈ wordBall S r → g⁻¹ ∈ wordBall S r
  | 0, g, hg => by
      rw [mem_wordBall_zero.mp hg, inv_one]
      exact one_mem_wordBall S 0
  | r + 1, g, hg => by
      rcases hg with hg | ⟨k, hk, s, hs, rfl⟩
      · exact wordBall_subset_succ S r (inv_mem_wordBall hg)
      · rw [mul_inv_rev]
        have hs' : s⁻¹ ∈ wordBall S 1 := by
          have h1 := mul_mem_wordBall_succ (one_mem_wordBall S 0) (s := s⁻¹)
            (by rwa [inv_inv, or_comm])
          simpa using h1
        have h2 := mul_mem_wordBall hs' (inv_mem_wordBall hk)
        rwa [Nat.add_comm] at h2

theorem exists_mem_wordBall_of_mem_closure {S : Set G} {g : G} (hg : g ∈ Subgroup.closure S) :
    ∃ r, g ∈ wordBall S r := by
  induction hg using Subgroup.closure_induction with
  | mem s hs =>
      exact ⟨1, by simpa using mul_mem_wordBall_succ (one_mem_wordBall S 0) (Or.inl hs)⟩
  | one => exact ⟨0, one_mem_wordBall S 0⟩
  | mul a b _ _ iha ihb =>
      obtain ⟨m, hm⟩ := iha
      obtain ⟨n, hn⟩ := ihb
      exact ⟨m + n, mul_mem_wordBall hm hn⟩
  | inv a _ iha =>
      obtain ⟨m, hm⟩ := iha
      exact ⟨m, inv_mem_wordBall hm⟩

theorem mem_closure_of_mem_wordBall {S : Set G} :
    ∀ {r : ℕ} {g : G}, g ∈ wordBall S r → g ∈ Subgroup.closure S
  | 0, g, hg => by
      rw [mem_wordBall_zero.mp hg]
      exact Subgroup.one_mem _
  | r + 1, g, hg => by
      rcases hg with hg | ⟨k, hk, s, hs, rfl⟩
      · exact mem_closure_of_mem_wordBall hg
      · refine Subgroup.mul_mem _ (mem_closure_of_mem_wordBall hk) ?_
        rcases hs with hs | hs
        · exact Subgroup.subset_closure hs
        · simpa using Subgroup.inv_mem _ (Subgroup.subset_closure hs)

/-- A ball over finitely many letters is finite. -/
theorem wordBall_finite {S : Set G} (hS : S.Finite) : ∀ r, (wordBall S r).Finite
  | 0 => Set.finite_singleton 1
  | r + 1 => by
      refine (wordBall_finite hS r).union (Set.Finite.subset
        (((wordBall_finite hS r).prod (hS.union (hS.image fun s ↦ s⁻¹))).image
          fun p : G × G ↦ p.1 * p.2) ?_)
      rintro _ ⟨h, hh, s, hs, rfl⟩
      refine ⟨(h, s), ⟨hh, ?_⟩, rfl⟩
      rcases hs with hs | hs
      · exact Or.inl hs
      · exact Or.inr ⟨s⁻¹, hs, inv_inv s⟩

end Word

/-! ## Levels -/

section Levels

variable (Γ : Type u) [Group Γ]

/-- `β`: raise the level by `1` (tex l.360). -/
def levelShift : Perm (Γ × ℤ) where
  toFun p := (p.1, p.2 + 1)
  invFun p := (p.1, p.2 - 1)
  left_inv p := by simp
  right_inv p := by simp

variable {Γ}

@[simp] theorem levelShift_apply (p : Γ × ℤ) : levelShift Γ p = (p.1, p.2 + 1) := rfl

@[simp] theorem levelShift_inv_apply (p : Γ × ℤ) : (levelShift Γ)⁻¹ p = (p.1, p.2 - 1) := rfl

theorem levelShift_zpow_apply (n : ℤ) (p : Γ × ℤ) : (levelShift Γ ^ n) p = (p.1, p.2 + n) := by
  induction n using Int.induction_on generalizing p with
  | hz => simp
  | hp k ih =>
      rw [zpow_add_one, Perm.mul_apply, ih]
      exact Prod.ext rfl (by simp only [levelShift_apply]; ring)
  | hn k ih =>
      rw [zpow_sub_one, Perm.mul_apply, ih]
      exact Prod.ext rfl (by simp only [levelShift_inv_apply]; ring)

/-- `h_γ`: multiply the first coordinate by `γ` on the levels `m ≥ 0` (tex l.360–361). -/
def levelMul (γ : Γ) : Perm (Γ × ℤ) where
  toFun p := if 0 ≤ p.2 then (γ * p.1, p.2) else p
  invFun p := if 0 ≤ p.2 then (γ⁻¹ * p.1, p.2) else p
  left_inv p := by by_cases h : 0 ≤ p.2 <;> simp [h]
  right_inv p := by by_cases h : 0 ≤ p.2 <;> simp [h]

theorem levelMul_apply (γ x : Γ) (m : ℤ) :
    levelMul γ (x, m) = if 0 ≤ m then (γ * x, m) else (x, m) := rfl

theorem levelMul_inv_apply (γ x : Γ) (m : ℤ) :
    (levelMul γ)⁻¹ (x, m) = if 0 ≤ m then (γ⁻¹ * x, m) else (x, m) := rfl

theorem levelMul_inv (γ : Γ) : (levelMul γ)⁻¹ = levelMul γ⁻¹ := by
  refine Equiv.ext fun p ↦ ?_
  obtain ⟨x, m⟩ := p
  rw [levelMul_inv_apply, levelMul_apply]

/-- Multiply the first coordinate by `γ` on the level `0`. -/
def levelZeroMul : Γ →* Perm (Γ × ℤ) where
  toFun γ :=
    { toFun := fun p ↦ if p.2 = 0 then (γ * p.1, p.2) else p
      invFun := fun p ↦ if p.2 = 0 then (γ⁻¹ * p.1, p.2) else p
      left_inv := fun p ↦ by by_cases h : p.2 = 0 <;> simp [h]
      right_inv := fun p ↦ by by_cases h : p.2 = 0 <;> simp [h] }
  map_one' := by
    refine Equiv.ext fun p ↦ ?_
    by_cases h : p.2 = 0 <;> simp [h]
  map_mul' γ δ := by
    refine Equiv.ext fun p ↦ ?_
    by_cases h : p.2 = 0 <;> simp [h, mul_assoc]

theorem levelZeroMul_apply (γ x : Γ) (m : ℤ) :
    levelZeroMul γ (x, m) = if m = 0 then (γ * x, m) else (x, m) := rfl

theorem levelZeroMul_injective : Function.Injective (levelZeroMul : Γ →* Perm (Γ × ℤ)) := by
  intro a b hab
  have h := congrArg (fun g : Perm (Γ × ℤ) ↦ (g (1, 0)).1) hab
  simpa [levelZeroMul_apply] using h

/-- **Tex l.361–362**: "$[\beta,h_\gamma]$ multiplies the level $0$ by $\gamma^{-1}$". -/
theorem commutator_levelShift_levelMul (γ : Γ) :
    ⁅levelShift Γ, levelMul γ⁆ = levelZeroMul γ⁻¹ := by
  refine Equiv.ext fun p ↦ ?_
  obtain ⟨x, m⟩ := p
  rw [commutatorElement_def]
  simp only [Perm.mul_apply, levelMul_inv_apply, levelZeroMul_apply]
  rcases lt_trichotomy m 0 with hm | rfl | hm
  · have h1 : ¬ 0 ≤ m := not_le.mpr hm
    have h2 : ¬ 0 ≤ m - 1 := not_le.mpr (by linarith)
    have h3 : m ≠ 0 := ne_of_lt hm
    rw [if_neg h1, levelShift_inv_apply, levelMul_apply, if_neg h2, if_neg h3, levelShift_apply]
    simp
  · have h2 : ¬ 0 ≤ (0 : ℤ) - 1 := by norm_num
    rw [if_pos le_rfl, levelShift_inv_apply, levelMul_apply, if_neg h2, if_pos rfl,
      levelShift_apply]
    simp
  · have h1 : 0 ≤ m := le_of_lt hm
    have h2 : 0 ≤ m - 1 := by linarith
    have h3 : m ≠ 0 := ne_of_gt hm
    rw [if_pos h1, levelShift_inv_apply, levelMul_apply, if_pos h2, if_neg h3, levelShift_apply]
    simp

variable (Γ)

/-- **`Δ = ⟨β, h_γ : γ ∈ E⟩`** (tex l.362). -/
def levelDelta (E : Finset Γ) : Subgroup (Perm (Γ × ℤ)) :=
  Subgroup.closure (insert (levelShift Γ) (levelMul '' (E : Set Γ)))

variable {Γ}

/-- The generators of `Δ` for a family `t` of elements of `Γ`: `none ↦ β` and `some i ↦ h_{t i}`. -/
def levelGen {ι : Type*} (t : ι → Γ) : Option ι → Perm (Γ × ℤ)
  | none => levelShift Γ
  | some i => levelMul (t i)

/-- `Δ` is generated by the family `levelGen t` whenever `t` enumerates `E`. -/
theorem levelDelta_eq_closure_range {ι : Type*} (E : Finset Γ) (t : ι → Γ)
    (ht : Set.range t = (E : Set Γ)) :
    levelDelta Γ E = Subgroup.closure (Set.range (levelGen t)) := by
  unfold levelDelta
  congr 1
  ext g
  constructor
  · rintro (rfl | ⟨γ, hγ, rfl⟩)
    · exact ⟨none, rfl⟩
    · rw [← ht] at hγ
      obtain ⟨i, rfl⟩ := hγ
      exact ⟨some i, rfl⟩
  · rintro ⟨o, rfl⟩
    cases o with
    | none => exact Set.mem_insert _ _
    | some i =>
        refine Set.mem_insert_of_mem _ ⟨t i, ?_, rfl⟩
        rw [← ht]
        exact ⟨i, rfl⟩

theorem levelShift_mem_levelDelta (E : Finset Γ) : levelShift Γ ∈ levelDelta Γ E :=
  Subgroup.subset_closure (Set.mem_insert _ _)

theorem levelMul_mem_levelDelta {E : Finset Γ} {γ : Γ} (hγ : γ ∈ E) :
    levelMul γ ∈ levelDelta Γ E :=
  Subgroup.subset_closure (Set.mem_insert_of_mem _ ⟨γ, hγ, rfl⟩)

/-- **Tex l.362–363**: "$\Delta$ is infinite", as `β` has infinite order. -/
theorem infinite_levelDelta (E : Finset Γ) : Infinite ↥(levelDelta Γ E) := by
  refine Infinite.of_injective
    (fun n : ℤ ↦ (⟨levelShift Γ ^ n, Subgroup.zpow_mem _ (levelShift_mem_levelDelta E) n⟩ :
      ↥(levelDelta Γ E))) ?_
  intro a b hab
  have h := congrArg (fun g : ↥(levelDelta Γ E) ↦ ((g : Perm (Γ × ℤ)) (1, 0)).2) hab
  simpa [levelShift_zpow_apply] using h

/-- `Δ` is finitely generated, by `β` and the `h_γ`, `γ ∈ E`. -/
theorem fg_levelDelta (E : Finset Γ) : Group.FG ↥(levelDelta Γ E) := by
  classical
  refine (Group.fg_iff_subgroup_fg (levelDelta Γ E)).mpr
    ⟨insert (levelShift Γ) (E.image levelMul), ?_⟩
  rw [Finset.coe_insert, Finset.coe_image]
  rfl

theorem levelZeroMul_mem_commutator (E : Finset Γ) (hE : Subgroup.closure (E : Set Γ) = ⊤)
    (γ : Γ) :
    levelZeroMul γ ∈ (commutator ↥(levelDelta Γ E)).map (levelDelta Γ E).subtype := by
  have hle : Subgroup.closure (E : Set Γ) ≤
      ((commutator ↥(levelDelta Γ E)).map (levelDelta Γ E).subtype).comap levelZeroMul := by
    rw [Subgroup.closure_le]
    intro e he
    have hc : ⁅(⟨levelShift Γ, levelShift_mem_levelDelta E⟩ : ↥(levelDelta Γ E)),
        ⟨levelMul e, levelMul_mem_levelDelta he⟩⁆ ∈ commutator ↥(levelDelta Γ E) :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
    have hmap : levelZeroMul e⁻¹ ∈
        (commutator ↥(levelDelta Γ E)).map (levelDelta Γ E).subtype := by
      refine ⟨_, hc, ?_⟩
      rw [map_commutatorElement]
      exact commutator_levelShift_levelMul e
    have hinv := Subgroup.inv_mem _ hmap
    rw [← map_inv, inv_inv] at hinv
    exact hinv
  have hγ : γ ∈ Subgroup.closure (E : Set Γ) := by
    rw [hE]
    exact Subgroup.mem_top γ
  exact hle hγ

/-- **Tex l.361–363**, "$\Gamma\le[\Delta,\Delta]$": when `E` generates `Γ`, multiplying the level `0`
embeds `Γ` in the commutator subgroup of `Δ`. -/
theorem exists_levelZeroEmbedding (E : Finset Γ) (hE : Subgroup.closure (E : Set Γ) = ⊤) :
    ∃ f : Γ →* ↥(levelDelta Γ E), Function.Injective f ∧
      ∀ γ, f γ ∈ commutator ↥(levelDelta Γ E) := by
  have hmem : ∀ γ, levelZeroMul γ ∈ levelDelta Γ E := fun γ ↦ by
    obtain ⟨y, -, hy⟩ := levelZeroMul_mem_commutator E hE γ
    rw [← hy]
    exact y.2
  refine ⟨levelZeroMul.codRestrict (levelDelta Γ E) hmem, ?_, fun γ ↦ ?_⟩
  · intro a b hab
    exact levelZeroMul_injective (congrArg Subtype.val hab)
  · obtain ⟨y, hy, hyγ⟩ := levelZeroMul_mem_commutator E hE γ
    have hyeq : y = levelZeroMul.codRestrict (levelDelta Γ E) hmem γ := Subtype.ext hyγ
    rw [← hyeq]
    exact hy

end Levels

/-! ## The normal form -/

section NormalForm

variable {Γ : Type u} [Group Γ]

/-- `g = fβ^ℓ`: `g` maps `(x, m)` to `(f (m + ℓ) * x, m + ℓ)`, so after the shift `f` multiplies the
level `n` by `f n` (tex l.363–364). -/
def IsLevelForm (g : Perm (Γ × ℤ)) (f : ℤ → Γ) (ℓ : ℤ) : Prop :=
  ∀ x m, g (x, m) = (f (m + ℓ) * x, m + ℓ)

theorem isLevelForm_one : IsLevelForm (1 : Perm (Γ × ℤ)) (fun _ ↦ 1) 0 := by
  intro x m
  simp

theorem IsLevelForm.ext {g g' : Perm (Γ × ℤ)} {f : ℤ → Γ} {ℓ : ℤ} (h : IsLevelForm g f ℓ)
    (h' : IsLevelForm g' f ℓ) : g = g' :=
  Equiv.ext fun p ↦ by
    obtain ⟨x, m⟩ := p
    rw [h, h']

theorem IsLevelForm.mul {g g' : Perm (Γ × ℤ)} {f f' : ℤ → Γ} {ℓ ℓ' : ℤ} (h : IsLevelForm g f ℓ)
    (h' : IsLevelForm g' f' ℓ') :
    IsLevelForm (g * g') (fun n ↦ f n * f' (n - ℓ)) (ℓ + ℓ') := by
  intro x m
  rw [Perm.mul_apply, h', h]
  show (f (m + ℓ' + ℓ) * (f' (m + ℓ') * x), m + ℓ' + ℓ) =
    (f (m + (ℓ + ℓ')) * f' (m + (ℓ + ℓ') - ℓ) * x, m + (ℓ + ℓ'))
  rw [show m + ℓ' + ℓ = m + (ℓ + ℓ') by ring, show m + (ℓ + ℓ') - ℓ = m + ℓ' by ring, mul_assoc]

theorem IsLevelForm.mul_levelShift {g : Perm (Γ × ℤ)} {f : ℤ → Γ} {ℓ : ℤ}
    (h : IsLevelForm g f ℓ) : IsLevelForm (g * levelShift Γ) f (ℓ + 1) := by
  intro x m
  rw [Perm.mul_apply]
  show g (x, m + 1) = _
  rw [h, show m + 1 + ℓ = m + (ℓ + 1) by ring]

theorem IsLevelForm.mul_levelShift_inv {g : Perm (Γ × ℤ)} {f : ℤ → Γ} {ℓ : ℤ}
    (h : IsLevelForm g f ℓ) : IsLevelForm (g * (levelShift Γ)⁻¹) f (ℓ - 1) := by
  intro x m
  rw [Perm.mul_apply]
  show g (x, m - 1) = _
  rw [h, show m - 1 + ℓ = m + (ℓ - 1) by ring]

theorem IsLevelForm.mul_levelMul {g : Perm (Γ × ℤ)} {f : ℤ → Γ} {ℓ : ℤ}
    (h : IsLevelForm g f ℓ) (γ : Γ) :
    IsLevelForm (g * levelMul γ) (fun n ↦ f n * if 0 ≤ n - ℓ then γ else 1) ℓ := by
  intro x m
  rw [Perm.mul_apply, levelMul_apply]
  show g (if 0 ≤ m then (γ * x, m) else (x, m)) =
    (f (m + ℓ) * (if 0 ≤ m + ℓ - ℓ then γ else 1) * x, m + ℓ)
  rw [show m + ℓ - ℓ = m by ring]
  by_cases hm : 0 ≤ m
  · rw [if_pos hm, h, if_pos hm, mul_assoc]
  · rw [if_neg hm, h, if_neg hm, mul_one]

/-- The shift `ℓ` of a permutation of the levels, read off at `(1, 0)`. -/
def levelShiftOf (g : Perm (Γ × ℤ)) : ℤ := (g (1, 0)).2

/-- The multiplier `f` of a permutation of the levels, read off after the shift. -/
def levelFunOf (g : Perm (Γ × ℤ)) (n : ℤ) : Γ := (g (1, n - levelShiftOf g)).1

theorem IsLevelForm.levelShiftOf_eq {g : Perm (Γ × ℤ)} {f : ℤ → Γ} {ℓ : ℤ}
    (h : IsLevelForm g f ℓ) : levelShiftOf g = ℓ := by
  simp [levelShiftOf, h 1 0]

theorem IsLevelForm.levelFunOf_eq {g : Perm (Γ × ℤ)} {f : ℤ → Γ} {ℓ : ℤ}
    (h : IsLevelForm g f ℓ) : levelFunOf g = f := by
  funext n
  simp [levelFunOf, h.levelShiftOf_eq, h 1 (n - ℓ)]

/-- **The bounds of tex l.363–366** at radius `r`: `|ℓ| ≤ r`, `f(m)` of length at most `r`, `f(m) = 1`
for `m < −r` and `f(m) = f(r)` for `m > r`. -/
def LevelBounds (E : Set Γ) (r : ℕ) (f : ℤ → Γ) (ℓ : ℤ) : Prop :=
  |ℓ| ≤ r ∧ (∀ m, f m ∈ wordBall E r) ∧ (∀ m, m < -(r : ℤ) → f m = 1) ∧
    ∀ m, (r : ℤ) < m → f m = f r

theorem LevelBounds.succ {E : Set Γ} {r : ℕ} {f : ℤ → Γ} {ℓ : ℤ} (h : LevelBounds E r f ℓ) :
    LevelBounds E (r + 1) f ℓ := by
  obtain ⟨hℓ, hval, hlow, hhigh⟩ := h
  have hℓ' := abs_le.mp hℓ
  refine ⟨abs_le.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩,
    fun m ↦ wordBall_subset_succ E r (hval m), fun m hm ↦ hlow m (by push_cast at hm; linarith),
    fun m hm ↦ ?_⟩
  push_cast at hm ⊢
  rw [hhigh m (by linarith), hhigh ((r : ℤ) + 1) (by linarith)]

theorem LevelBounds.shift {E : Set Γ} {r : ℕ} {f : ℤ → Γ} {ℓ : ℤ} (h : LevelBounds E r f ℓ)
    {d : ℤ} (hd : |d| ≤ 1) : LevelBounds E (r + 1) f (ℓ + d) := by
  have hℓ := abs_le.mp h.1
  have hd' := abs_le.mp hd
  obtain ⟨-, hval, hlow, hhigh⟩ := h.succ
  exact ⟨abs_le.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩, hval, hlow, hhigh⟩

theorem LevelBounds.mul_letter {E : Set Γ} {r : ℕ} {f : ℤ → Γ} {ℓ : ℤ}
    (h : LevelBounds E r f ℓ) {γ : Γ} (hγ : γ ∈ E ∨ γ⁻¹ ∈ E) :
    LevelBounds E (r + 1) (fun n ↦ f n * if 0 ≤ n - ℓ then γ else 1) ℓ := by
  obtain ⟨hℓ, hval, hlow, hhigh⟩ := h
  have hℓ' := abs_le.mp hℓ
  refine ⟨abs_le.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩, fun m ↦ ?_,
    fun m hm ↦ ?_, fun m hm ↦ ?_⟩
  · by_cases h0 : 0 ≤ m - ℓ
    · simp only [if_pos h0]
      exact mul_mem_wordBall_succ (hval m) hγ
    · simp only [if_neg h0, mul_one]
      exact wordBall_subset_succ E r (hval m)
  · push_cast at hm
    have h0 : ¬ 0 ≤ m - ℓ := not_le.mpr (by linarith)
    simp only [if_neg h0, mul_one]
    exact hlow m (by linarith)
  · push_cast at hm ⊢
    have h0 : 0 ≤ m - ℓ := by linarith
    have h1 : 0 ≤ (r : ℤ) + 1 - ℓ := by linarith
    simp only [if_pos h0, if_pos h1]
    rw [hhigh m (by linarith), hhigh ((r : ℤ) + 1) (by linarith)]

/-- **Tex l.363–366**: "An element of $\Delta$ of length at most $r$ is $f\beta^\ell$ with
$|\ell|\le r$, where $f$ multiplies the level $m$ by an element $f(m)$ of length at most $r$, with
$f(m)=1$ for $m<-r$ and $f(m)=f(r)$ for $m>r$." -/
theorem exists_levelForm_of_mem_wordBall {E : Set Γ} :
    ∀ {r : ℕ} {g : Perm (Γ × ℤ)}, g ∈ wordBall (insert (levelShift Γ) (levelMul '' E)) r →
      ∃ (f : ℤ → Γ) (ℓ : ℤ), IsLevelForm g f ℓ ∧ LevelBounds E r f ℓ
  | 0, g, hg => by
      rw [mem_wordBall_zero.mp hg]
      exact ⟨fun _ ↦ 1, 0, isLevelForm_one, by simp, fun _ ↦ one_mem_wordBall E 0,
        fun _ _ ↦ rfl, fun _ _ ↦ rfl⟩
  | r + 1, g, hg => by
      rcases hg with hg | ⟨k, hk, s, hs, rfl⟩
      · obtain ⟨f, ℓ, hform, hb⟩ := exists_levelForm_of_mem_wordBall hg
        exact ⟨f, ℓ, hform, hb.succ⟩
      · obtain ⟨f, ℓ, hform, hb⟩ := exists_levelForm_of_mem_wordBall hk
        rcases hs with (rfl | ⟨γ, hγ, rfl⟩) | hs
        · exact ⟨f, ℓ + 1, hform.mul_levelShift, hb.shift (by norm_num)⟩
        · exact ⟨_, ℓ, hform.mul_levelMul γ, hb.mul_letter (Or.inl hγ)⟩
        · rcases hs with hs | ⟨γ, hγ, hs⟩
          · have hs' : s = (levelShift Γ)⁻¹ := by rw [← hs, inv_inv]
            subst hs'
            have hb' := hb.shift (d := -1) (by norm_num)
            rw [← sub_eq_add_neg] at hb'
            exact ⟨f, ℓ - 1, hform.mul_levelShift_inv, hb'⟩
          · have hs' : s = levelMul γ⁻¹ := by rw [← levelMul_inv, hs, inv_inv]
            subst hs'
            exact ⟨_, ℓ, hform.mul_levelMul γ⁻¹, hb.mul_letter (Or.inr (by rwa [inv_inv]))⟩

/-- Every element of `Δ` has some word length. -/
theorem exists_mem_wordBall_of_mem_levelDelta {E : Finset Γ} {g : Perm (Γ × ℤ)}
    (hg : g ∈ levelDelta Γ E) :
    ∃ r, g ∈ wordBall (insert (levelShift Γ) (levelMul '' (E : Set Γ))) r :=
  exists_mem_wordBall_of_mem_closure hg

