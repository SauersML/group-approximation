import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.GroupTheory.Coprod.Basic
import Mathlib.GroupTheory.FreeGroup.Basic
import Mathlib.GroupTheory.QuotientGroup.Defs
import Mathlib.Algebra.Group.Subgroup.Ker
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Tactic.Group
import GroupApproximation.Algebra.ProductFinitePresentation
import GroupApproximation.Meta.AxiomGuard

/-!
# Extensions of finitely presented groups

**`isFinitelyPresented_of_normal`** (P. Hall).  If `N ⊴ G` and both `N` and `G ⧸ N` are finitely
presented, then `G` is finitely presented.  Hyde–Lodha use it (their Proposition 2.2, for type
`F_∞`) through casing pairs.

`G` is presented as a quotient of the free product `N ∗ F_b`, which is finitely presented, where the
generators of `F_b` go to lifts `ℓ` of the generators of a finite presentation of `G ⧸ N`.  The kernel
is normally generated by finitely many relators:

* `y n y⁻¹ = ℓ(y) n ℓ(y)⁻¹` and `y⁻¹ n y = ℓ(y)⁻¹ n ℓ(y)`, for the generators `y` of `F_b` and a finite
  generating set of `N`;
* `r = ℓ(r)`, for a finite normal generating set of the relations `r` of `G ⧸ N`.

Modulo these relators the image of `N` is normal (`conj_mem_img`), every element is `n · w`
(`exists_nf`), and a relation word `w` lies in the image of `N` (`inr_mem_img_of_ker`), so an element
killed in `G` is already trivial (`ker_le`).
-/

namespace GroupApproximation
namespace FinitePresentationExtension

open Monoid

variable {G : Type*} [Group G] (N : Subgroup G) [hN : N.Normal]

/-- Conjugation by `g`, restricted to the normal subgroup `N`. -/
def conjN (g : G) : N →* N where
  toFun n := ⟨g * n * g⁻¹, hN.conj_mem n n.2 g⟩
  map_one' := by
    apply Subtype.ext
    show g * ((1 : N) : G) * g⁻¹ = ((1 : N) : G)
    simp
  map_mul' a c := by
    apply Subtype.ext
    show g * ((a * c : N) : G) * g⁻¹ = (g * (a : G) * g⁻¹) * (g * (c : G) * g⁻¹)
    rw [Subgroup.coe_mul]
    group

theorem coe_conjN (g : G) (n : N) : ((conjN N g n : N) : G) = g * n * g⁻¹ := rfl

section Presentation

variable {b : ℕ} (ℓ : Fin b → G)

/-- The source `N ∗ F_b`. -/
abbrev Src (b : ℕ) : Type _ := Monoid.Coprod ↥N (FreeGroup (Fin b))

/-- The map `N ∗ F_b → G`. -/
def phi : Src N b →* G := Coprod.lift N.subtype (FreeGroup.lift ℓ)

omit hN in
theorem phi_inl (n : N) : phi N ℓ (Coprod.inl n) = (n : G) := Coprod.lift_apply_inl _ _ n

omit hN in
theorem phi_inr (w : FreeGroup (Fin b)) : phi N ℓ (Coprod.inr w) = FreeGroup.lift ℓ w :=
  Coprod.lift_apply_inr _ _ w

/-- The composite `F_b → G ⧸ N`. -/
def psi : FreeGroup (Fin b) →* G ⧸ N := (QuotientGroup.mk' N).comp (FreeGroup.lift ℓ)

theorem lift_mem_of_mem_ker {r : FreeGroup (Fin b)} (hr : r ∈ (psi N ℓ).ker) :
    FreeGroup.lift ℓ r ∈ N :=
  (QuotientGroup.eq_one_iff _).mp hr

/-- The conjugation relators for a generator `y`. -/
def relA (j : Fin b) (n : N) : Src N b :=
  Coprod.inr (FreeGroup.of j) * Coprod.inl n * (Coprod.inr (FreeGroup.of j))⁻¹ *
    (Coprod.inl (conjN N (ℓ j) n))⁻¹

/-- The conjugation relators for `y⁻¹`. -/
def relA' (j : Fin b) (n : N) : Src N b :=
  (Coprod.inr (FreeGroup.of j))⁻¹ * Coprod.inl n * Coprod.inr (FreeGroup.of j) *
    (Coprod.inl (conjN N (ℓ j)⁻¹ n))⁻¹

/-- The lifted relators of `G ⧸ N`. -/
def relB (r : (psi N ℓ).ker) : Src N b :=
  Coprod.inr (r : FreeGroup (Fin b)) *
    (Coprod.inl (⟨FreeGroup.lift ℓ r, lift_mem_of_mem_ker N ℓ r.2⟩ : N))⁻¹

/-- The three finite families of relators. -/
def relators (gens : Set N) (S : Set (psi N ℓ).ker) : Set (Src N b) :=
  Set.range (fun p : Fin b × gens => relA N ℓ p.1 p.2) ∪
    Set.range (fun p : Fin b × gens => relA' N ℓ p.1 p.2) ∪
    Set.range (fun r : S => relB N ℓ r)

theorem relators_finite {gens : Set N} {S : Set (psi N ℓ).ker} (hgens : gens.Finite)
    (hS : S.Finite) : (relators N ℓ gens S).Finite := by
  haveI : Finite gens := Set.finite_coe_iff.mpr hgens
  haveI : Finite S := Set.finite_coe_iff.mpr hS
  exact ((Set.toFinite _).union (Set.toFinite _)).union (Set.toFinite _)

theorem relators_subset_ker (gens : Set N) (S : Set (psi N ℓ).ker) :
    relators N ℓ gens S ⊆ ((phi N ℓ).ker : Set (Src N b)) := by
  rintro x ((⟨⟨j, n⟩, rfl⟩ | ⟨⟨j, n⟩, rfl⟩) | ⟨r, rfl⟩)
  · show phi N ℓ (relA N ℓ j (n : N)) = 1
    simp only [relA, map_mul, map_inv, phi_inl, phi_inr, FreeGroup.lift_apply_of, coe_conjN]
    group
  · show phi N ℓ (relA' N ℓ j (n : N)) = 1
    simp only [relA', map_mul, map_inv, phi_inl, phi_inr, FreeGroup.lift_apply_of, coe_conjN]
    group
  · show phi N ℓ (relB N ℓ r) = 1
    simp only [relB, map_mul, map_inv, phi_inl, phi_inr]
    exact mul_inv_cancel _

/-! ### The quotient by the relators -/

variable (gens : Set N) (S : Set (psi N ℓ).ker)

/-- The normal closure of the relators. -/
abbrev K : Subgroup (Src N b) := Subgroup.normalClosure (relators N ℓ gens S)

/-- The quotient map. -/
abbrev q : Src N b →* Src N b ⧸ K N ℓ gens S := QuotientGroup.mk' (K N ℓ gens S)

/-- The image of `N` in the quotient. -/
def img : Subgroup (Src N b ⧸ K N ℓ gens S) := ((q N ℓ gens S).comp Coprod.inl).range

theorem q_rel {x : Src N b} (hx : x ∈ relators N ℓ gens S) : q N ℓ gens S x = 1 :=
  (QuotientGroup.eq_one_iff x).mpr (Subgroup.subset_normalClosure hx)

theorem q_inl_mem_img (n : N) : q N ℓ gens S (Coprod.inl n) ∈ img N ℓ gens S := ⟨n, rfl⟩

/-- The elements normalizing the image of `N`. -/
def normImg : Subgroup (Src N b ⧸ K N ℓ gens S) where
  carrier := {z | ∀ x ∈ img N ℓ gens S, z * x * z⁻¹ ∈ img N ℓ gens S ∧
    z⁻¹ * x * z ∈ img N ℓ gens S}
  one_mem' := fun x hx =>
    ⟨by rw [one_mul, inv_one, mul_one]; exact hx, by rw [inv_one, one_mul, mul_one]; exact hx⟩
  mul_mem' := by
    intro z₁ z₂ h₁ h₂ x hx
    refine ⟨?_, ?_⟩
    · have e : z₁ * z₂ * x * (z₁ * z₂)⁻¹ = z₁ * (z₂ * x * z₂⁻¹) * z₁⁻¹ := by group
      rw [e]
      exact (h₁ _ (h₂ x hx).1).1
    · have e : (z₁ * z₂)⁻¹ * x * (z₁ * z₂) = z₂⁻¹ * (z₁⁻¹ * x * z₁) * z₂ := by group
      rw [e]
      exact (h₂ _ (h₁ x hx).2).2
  inv_mem' := by
    intro z h x hx
    refine ⟨?_, ?_⟩
    · have e : z⁻¹ * x * z⁻¹⁻¹ = z⁻¹ * x * z := by group
      rw [e]
      exact (h x hx).2
    · have e : z⁻¹⁻¹ * x * z⁻¹ = z * x * z⁻¹ := by group
      rw [e]
      exact (h x hx).1

/-- The induced map from the quotient to `G`. -/
def phiBar : Src N b ⧸ K N ℓ gens S →* G :=
  QuotientGroup.lift (K N ℓ gens S) (phi N ℓ)
    (Subgroup.normalClosure_le_normal (relators_subset_ker N ℓ gens S))

theorem phiBar_q (x : Src N b) : phiBar N ℓ gens S (q N ℓ gens S x) = phi N ℓ x := rfl

variable {gens} (hgens : Subgroup.closure gens = ⊤)

include hgens in
theorem conj_gen (j : Fin b) (n : N) :
    q N ℓ gens S (Coprod.inr (FreeGroup.of j)) * q N ℓ gens S (Coprod.inl n) *
        (q N ℓ gens S (Coprod.inr (FreeGroup.of j)))⁻¹ =
      q N ℓ gens S (Coprod.inl (conjN N (ℓ j) n)) := by
  have hhom : (MulAut.conj (q N ℓ gens S (Coprod.inr (FreeGroup.of j)))).toMonoidHom.comp
      ((q N ℓ gens S).comp Coprod.inl) = ((q N ℓ gens S).comp Coprod.inl).comp (conjN N (ℓ j)) := by
    refine MonoidHom.eq_of_eqOn_dense hgens (fun m hm => ?_)
    have hrel := q_rel N ℓ gens S (Or.inl (Or.inl ⟨(j, ⟨m, hm⟩), rfl⟩))
    simp only [relA, map_mul, map_inv] at hrel
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply]
    exact mul_inv_eq_one.mp hrel
  have h := congrArg (fun f => f n) hhom
  simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply] using h

include hgens in
theorem conj_gen_inv (j : Fin b) (n : N) :
    (q N ℓ gens S (Coprod.inr (FreeGroup.of j)))⁻¹ * q N ℓ gens S (Coprod.inl n) *
        q N ℓ gens S (Coprod.inr (FreeGroup.of j)) =
      q N ℓ gens S (Coprod.inl (conjN N (ℓ j)⁻¹ n)) := by
  have hhom : (MulAut.conj (q N ℓ gens S (Coprod.inr (FreeGroup.of j)))⁻¹).toMonoidHom.comp
      ((q N ℓ gens S).comp Coprod.inl) =
        ((q N ℓ gens S).comp Coprod.inl).comp (conjN N (ℓ j)⁻¹) := by
    refine MonoidHom.eq_of_eqOn_dense hgens (fun m hm => ?_)
    have hrel := q_rel N ℓ gens S (Or.inl (Or.inr ⟨(j, ⟨m, hm⟩), rfl⟩))
    simp only [relA', map_mul, map_inv] at hrel
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv]
    exact mul_inv_eq_one.mp hrel
  have h := congrArg (fun f => f n) hhom
  simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, inv_inv] using h

include hgens in
/-- **The image of `N` is normal in the quotient.** -/
theorem mem_normImg (z : Src N b ⧸ K N ℓ gens S) : z ∈ normImg N ℓ gens S := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (K N ℓ gens S) z
  have hinr : ∀ w : FreeGroup (Fin b), q N ℓ gens S (Coprod.inr w) ∈ normImg N ℓ gens S := by
    have hle : Subgroup.closure (Set.range (FreeGroup.of : Fin b → FreeGroup (Fin b))) ≤
        (normImg N ℓ gens S).comap ((q N ℓ gens S).comp Coprod.inr) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨j, rfl⟩
      rintro x ⟨n, rfl⟩
      exact ⟨⟨conjN N (ℓ j) n, (conj_gen N ℓ S hgens j n).symm⟩,
        ⟨conjN N (ℓ j)⁻¹ n, (conj_gen_inv N ℓ S hgens j n).symm⟩⟩
    intro w
    have hw : w ∈ Subgroup.closure (Set.range (FreeGroup.of : Fin b → FreeGroup (Fin b))) := by
      rw [FreeGroup.closure_range_of]
      exact Subgroup.mem_top w
    exact hle hw
  show q N ℓ gens S x ∈ normImg N ℓ gens S
  induction x using Monoid.Coprod.induction_on with
  | inl m =>
    intro x hx
    refine ⟨(img N ℓ gens S).mul_mem ((img N ℓ gens S).mul_mem (q_inl_mem_img N ℓ gens S m) hx)
      ((img N ℓ gens S).inv_mem (q_inl_mem_img N ℓ gens S m)), ?_⟩
    exact (img N ℓ gens S).mul_mem ((img N ℓ gens S).mul_mem
      ((img N ℓ gens S).inv_mem (q_inl_mem_img N ℓ gens S m)) hx) (q_inl_mem_img N ℓ gens S m)
  | inr w => exact hinr w
  | mul x y hx hy =>
    rw [map_mul]
    exact (normImg N ℓ gens S).mul_mem hx hy

include hgens in
/-- **Normal form**: every element of the quotient is `n · w`. -/
theorem exists_nf (x : Src N b) :
    ∃ n : N, ∃ w : FreeGroup (Fin b),
      q N ℓ gens S x = q N ℓ gens S (Coprod.inl n) * q N ℓ gens S (Coprod.inr w) := by
  induction x using Monoid.Coprod.induction_on with
  | inl m => exact ⟨m, 1, by rw [map_one, map_one, mul_one]⟩
  | inr w => exact ⟨1, w, by rw [map_one, map_one, one_mul]⟩
  | mul x y hx hy =>
    obtain ⟨n₁, w₁, h₁⟩ := hx
    obtain ⟨n₂, w₂, h₂⟩ := hy
    obtain ⟨n₃, hn₃⟩ := (mem_normImg N ℓ S hgens (q N ℓ gens S (Coprod.inr w₁)) _
      (q_inl_mem_img N ℓ gens S n₂)).1
    have hn₃' : q N ℓ gens S (Coprod.inl n₃) = q N ℓ gens S (Coprod.inr w₁) *
        q N ℓ gens S (Coprod.inl n₂) * (q N ℓ gens S (Coprod.inr w₁))⁻¹ := hn₃
    refine ⟨n₁ * n₃, w₁ * w₂, ?_⟩
    rw [map_mul, h₁, h₂, map_mul Coprod.inl, map_mul (q N ℓ gens S), hn₃', map_mul Coprod.inr,
      map_mul (q N ℓ gens S)]
    group

include hgens in
/-- **Relation words lie in the image of `N`.** -/
theorem inr_mem_img_of_ker
    (hS : Subgroup.normalClosure (Subtype.val '' S) = (psi N ℓ).ker) {w : FreeGroup (Fin b)}
    (hw : w ∈ (psi N ℓ).ker) : q N ℓ gens S (Coprod.inr w) ∈ img N ℓ gens S := by
  haveI : ((img N ℓ gens S).comap ((q N ℓ gens S).comp Coprod.inr)).Normal := by
    refine ⟨fun n hn g => ?_⟩
    rw [Subgroup.mem_comap, map_mul, map_mul, map_inv]
    exact (mem_normImg N ℓ S hgens _ _ hn).1
  have hsub : Subtype.val '' S ⊆ ((img N ℓ gens S).comap ((q N ℓ gens S).comp Coprod.inr) :
      Set (FreeGroup (Fin b))) := by
    rintro _ ⟨r, hr, rfl⟩
    have hrel := q_rel N ℓ gens S (Or.inr ⟨⟨r, hr⟩, rfl⟩)
    simp only [relB, map_mul, map_inv] at hrel
    refine ⟨⟨FreeGroup.lift ℓ r, lift_mem_of_mem_ker N ℓ r.2⟩, ?_⟩
    exact (mul_inv_eq_one.mp hrel).symm
  have hle := Subgroup.normalClosure_le_normal hsub
  rw [hS] at hle
  exact hle hw

include hgens in
theorem ker_le (hS : Subgroup.normalClosure (Subtype.val '' S) = (psi N ℓ).ker) :
    (phi N ℓ).ker ≤ K N ℓ gens S := by
  intro x hx
  obtain ⟨n, w, hnw⟩ := exists_nf N ℓ S hgens x
  have hG : (n : G) * FreeGroup.lift ℓ w = 1 := by
    have h1 : phiBar N ℓ gens S (q N ℓ gens S x) = 1 := hx
    rw [hnw, map_mul, phiBar_q, phiBar_q, phi_inl, phi_inr] at h1
    exact h1
  have hw : w ∈ (psi N ℓ).ker := by
    show QuotientGroup.mk' N (FreeGroup.lift ℓ w) = 1
    have e : FreeGroup.lift ℓ w = (n : G)⁻¹ := eq_inv_of_mul_eq_one_right hG
    rw [e, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact N.inv_mem n.2
  obtain ⟨n', hn'⟩ := inr_mem_img_of_ker N ℓ S hgens hS hw
  have hn'' : q N ℓ gens S (Coprod.inl n') = q N ℓ gens S (Coprod.inr w) := hn'
  have hqx : q N ℓ gens S x = q N ℓ gens S (Coprod.inl (n * n')) := by
    rw [hnw, ← hn'', ← map_mul, ← map_mul]
  have hnn : n * n' = 1 := by
    apply Subtype.ext
    have h1 : phiBar N ℓ gens S (q N ℓ gens S x) = 1 := hx
    rw [hqx, phiBar_q, phi_inl] at h1
    exact h1
  have hq1 : q N ℓ gens S x = 1 := by rw [hqx, hnn, map_one, map_one]
  exact (QuotientGroup.eq_one_iff x).mp hq1

theorem phi_surjective (hψ : Function.Surjective (psi N ℓ)) : Function.Surjective (phi N ℓ) := by
  intro g
  obtain ⟨w, hw⟩ := hψ (g : G ⧸ N)
  have hmem : g * (FreeGroup.lift ℓ w)⁻¹ ∈ N := by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_mul, QuotientGroup.mk_inv]
    have h : ((FreeGroup.lift ℓ w : G) : G ⧸ N) = (g : G ⧸ N) := hw
    rw [h, mul_inv_cancel]
  refine ⟨Coprod.inl ⟨_, hmem⟩ * Coprod.inr w, ?_⟩
  rw [map_mul, phi_inl, phi_inr]
  show g * (FreeGroup.lift ℓ w)⁻¹ * FreeGroup.lift ℓ w = g
  group

end Presentation

/-- **P. Hall: extensions of finitely presented groups are finitely presented.** -/
theorem isFinitelyPresented_of_normal [Group.IsFinitelyPresented N]
    [hQ : Group.IsFinitelyPresented (G ⧸ N)] : Group.IsFinitelyPresented G := by
  obtain ⟨b, ψ₀, hψ₀surj, S₀, hS₀fin, hS₀⟩ := hQ.out
  obtain ⟨gens, hgens, hgensfin⟩ :=
    Group.fg_iff.mp (ProductFinitePresentation.fg_of_isFinitelyPresented N)
  choose ℓ hℓ using fun j : Fin b => QuotientGroup.mk'_surjective N (ψ₀ (FreeGroup.of j))
  have hpsi : psi N ℓ = ψ₀ := by
    refine FreeGroup.ext_hom _ _ (fun j => ?_)
    simp only [psi, MonoidHom.comp_apply, FreeGroup.lift_apply_of]
    exact hℓ j
  let S : Set (psi N ℓ).ker := {r | (r : FreeGroup (Fin b)) ∈ S₀}
  have hSfin : S.Finite := hS₀fin.preimage Subtype.val_injective.injOn
  have hSval : Subtype.val '' S = S₀ := by
    ext r
    constructor
    · rintro ⟨r', hr', rfl⟩
      exact hr'
    · intro hr
      have hker : r ∈ (psi N ℓ).ker := by
        rw [hpsi, ← hS₀]
        exact Subgroup.subset_normalClosure hr
      exact ⟨⟨r, hker⟩, hr, rfl⟩
  have hS : Subgroup.normalClosure (Subtype.val '' S) = (psi N ℓ).ker := by
    rw [hSval, hS₀, hpsi]
  have hker : Subgroup.normalClosure (relators N ℓ gens S) = (phi N ℓ).ker :=
    le_antisymm (Subgroup.normalClosure_le_normal (relators_subset_ker N ℓ gens S))
      (ker_le N ℓ S hgens hS)
  exact Group.IsFinitelyPresented.of_surjective (phi N ℓ)
    (phi_surjective N ℓ (by rw [hpsi]; exact hψ₀surj))
    ⟨relators N ℓ gens S, relators_finite N ℓ hgensfin hSfin, hker⟩

#audit_axioms GroupApproximation.FinitePresentationExtension.isFinitelyPresented_of_normal

end FinitePresentationExtension
end GroupApproximation
