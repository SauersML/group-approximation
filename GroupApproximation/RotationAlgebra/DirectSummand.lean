import Mathlib.Algebra.Group.Commute.Basic
import Mathlib.Algebra.Group.Int.TypeTags
import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# A retraction onto `ℤ²` splits off a direct summand

This is the algebraic half of research node `stw50-unit-retraction-splits-torus-loops`. The proof
is in `research/artifacts/stw50-rotation-loop-retraction-2026-09-04.md` and is re-derived in §3.6
of `research/artifacts/fz-stw-l-review-2026-09-13.md`.

Let `a, b` be commuting elements of a group `G`, and let `ρ : G →* ℤ²` be a homomorphism with
`ρ a = (1, 0)` and `ρ b = (0, 1)`. Then `(m, n) ↦ a^m b^n` is a section of `ρ`. So it is injective,
its range `⟨a, b⟩` meets `ker ρ` trivially, and `⟨a, b⟩ ⊔ ker ρ = G`. For commutative `G` this is
an isomorphism `G ≃* ℤ² × ker ρ`, so `⟨a, b⟩ ≅ ℤ²` is a direct summand.

Here `ℤ²` is written multiplicatively as `Multiplicative ℤ × Multiplicative ℤ`.

* `pairHom a b hab : ℤ² →* G`, `(m, n) ↦ a^m b^n`.
* `range_pairHom`: the range of `pairHom a b hab` is `Subgroup.closure {a, b}`.
* `retraction_pairHom`, `pairHom_injective`: `ρ` is a left inverse of `pairHom a b hab`.
* `isCompl_closure_pair_ker`: `Subgroup.closure {a, b}` and `ker ρ` are complements.
* `prodKerEquiv`: for commutative `G`, `G ≃* ℤ² × ker ρ`.
-/

namespace GroupApproximation
namespace RotationAlgebra

open Multiplicative

section Group

variable {G : Type*} [Group G]

/-- `(m, n) ↦ a^m b^n` for commuting `a, b`. -/
def pairHom (a b : G) (hab : Commute a b) : Multiplicative ℤ × Multiplicative ℤ →* G where
  toFun x := a ^ toAdd x.1 * b ^ toAdd x.2
  map_one' := by
    show a ^ (0 : ℤ) * b ^ (0 : ℤ) = 1
    rw [zpow_zero, zpow_zero, mul_one]
  map_mul' x y := by
    show a ^ (toAdd x.1 + toAdd y.1) * b ^ (toAdd x.2 + toAdd y.2) =
      a ^ toAdd x.1 * b ^ toAdd x.2 * (a ^ toAdd y.1 * b ^ toAdd y.2)
    rw [zpow_add, zpow_add, mul_assoc, mul_assoc,
      (hab.zpow_zpow (toAdd y.1) (toAdd x.2)).left_comm]

theorem pairHom_apply (a b : G) (hab : Commute a b) (x : Multiplicative ℤ × Multiplicative ℤ) :
    pairHom a b hab x = a ^ toAdd x.1 * b ^ toAdd x.2 :=
  rfl

theorem pairHom_ofAdd_one_one (a b : G) (hab : Commute a b) :
    pairHom a b hab (ofAdd (1 : ℤ), 1) = a := by
  show a ^ (1 : ℤ) * b ^ (0 : ℤ) = a
  rw [zpow_one, zpow_zero, mul_one]

theorem pairHom_one_ofAdd_one (a b : G) (hab : Commute a b) :
    pairHom a b hab (1, ofAdd (1 : ℤ)) = b := by
  show a ^ (0 : ℤ) * b ^ (1 : ℤ) = b
  rw [zpow_one, zpow_zero, one_mul]

/-- The range of `pairHom a b hab` is the subgroup generated by `a` and `b`. -/
theorem range_pairHom (a b : G) (hab : Commute a b) :
    (pairHom a b hab).range = Subgroup.closure {a, b} := by
  refine le_antisymm (fun y hy => ?_)
    ((Subgroup.closure_le (K := (pairHom a b hab).range)).mpr ?_)
  · obtain ⟨x, rfl⟩ := MonoidHom.mem_range.mp hy
    rw [pairHom_apply]
    exact mul_mem (zpow_mem (Subgroup.subset_closure (Set.mem_insert a {b})) _)
      (zpow_mem (Subgroup.subset_closure (Set.mem_insert_of_mem a (Set.mem_singleton b))) _)
  · rintro _ (rfl | rfl)
    · exact MonoidHom.mem_range.mpr ⟨_, pairHom_ofAdd_one_one _ _ hab⟩
    · exact MonoidHom.mem_range.mpr ⟨_, pairHom_one_ofAdd_one _ _ hab⟩

theorem ofAdd_one_zpow (n : ℤ) : ofAdd (1 : ℤ) ^ n = ofAdd n := by
  rw [← Int.ofAdd_mul, one_mul]

/-- A homomorphism `ρ` with `ρ a = (1, 0)` and `ρ b = (0, 1)` is a left inverse of
`pairHom a b hab`. -/
theorem retraction_pairHom (a b : G) (hab : Commute a b)
    (ρ : G →* Multiplicative ℤ × Multiplicative ℤ) (ha : ρ a = (ofAdd (1 : ℤ), 1))
    (hb : ρ b = (1, ofAdd (1 : ℤ))) (x : Multiplicative ℤ × Multiplicative ℤ) :
    ρ (pairHom a b hab x) = x := by
  rw [pairHom_apply, map_mul, map_zpow, map_zpow, ha, hb]
  refine Prod.ext ?_ ?_
  · show ofAdd (1 : ℤ) ^ toAdd x.1 * (1 : Multiplicative ℤ) ^ toAdd x.2 = x.1
    rw [one_zpow, mul_one, ofAdd_one_zpow, ofAdd_toAdd]
  · show (1 : Multiplicative ℤ) ^ toAdd x.1 * ofAdd (1 : ℤ) ^ toAdd x.2 = x.2
    rw [one_zpow, one_mul, ofAdd_one_zpow, ofAdd_toAdd]

theorem pairHom_injective (a b : G) (hab : Commute a b)
    (ρ : G →* Multiplicative ℤ × Multiplicative ℤ) (ha : ρ a = (ofAdd (1 : ℤ), 1))
    (hb : ρ b = (1, ofAdd (1 : ℤ))) : Function.Injective (pairHom a b hab) :=
  Function.LeftInverse.injective (retraction_pairHom a b hab ρ ha hb)

/-- **Direct summand.** The subgroup generated by `a, b` and the kernel of the retraction `ρ` are
complements in the subgroup lattice. -/
theorem isCompl_closure_pair_ker (a b : G) (hab : Commute a b)
    (ρ : G →* Multiplicative ℤ × Multiplicative ℤ) (ha : ρ a = (ofAdd (1 : ℤ), 1))
    (hb : ρ b = (1, ofAdd (1 : ℤ))) : IsCompl (Subgroup.closure {a, b}) ρ.ker := by
  rw [← range_pairHom a b hab]
  refine ⟨Subgroup.disjoint_def.mpr fun {y} hy hk => ?_, fun K hA hB => ?_⟩
  · obtain ⟨x, rfl⟩ := MonoidHom.mem_range.mp hy
    rw [MonoidHom.mem_ker, retraction_pairHom a b hab ρ ha hb] at hk
    rw [hk, map_one]
  · refine ((Subgroup.eq_top_iff' (H := K)).mpr fun g => ?_).ge
    have hk : (pairHom a b hab (ρ g))⁻¹ * g ∈ ρ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, retraction_pairHom a b hab ρ ha hb, inv_mul_cancel]
    have h := mul_mem (hA (MonoidHom.mem_range.mpr ⟨ρ g, rfl⟩)) (hB hk)
    rwa [mul_inv_cancel_left] at h

end Group

section CommGroup

variable {G : Type*} [CommGroup G]

/-- For commutative `G`, a retraction `ρ` onto `ℤ²` with `ρ a = (1, 0)` and `ρ b = (0, 1)` gives
`G ≃* ℤ² × ker ρ`, `g ↦ (ρ g, (a^m b^n)⁻¹ g)` with `(m, n) = ρ g`. -/
def prodKerEquiv (a b : G) (ρ : G →* Multiplicative ℤ × Multiplicative ℤ)
    (ha : ρ a = (ofAdd (1 : ℤ), 1)) (hb : ρ b = (1, ofAdd (1 : ℤ))) :
    G ≃* (Multiplicative ℤ × Multiplicative ℤ) × ρ.ker where
  toFun g := (ρ g, ⟨(pairHom a b (Commute.all a b) (ρ g))⁻¹ * g, by
    rw [MonoidHom.mem_ker, map_mul, map_inv, retraction_pairHom a b _ ρ ha hb, inv_mul_cancel]⟩)
  invFun x := pairHom a b (Commute.all a b) x.1 * x.2
  left_inv g := by
    show pairHom a b (Commute.all a b) (ρ g) * ((pairHom a b (Commute.all a b) (ρ g))⁻¹ * g) = g
    exact mul_inv_cancel_left _ g
  right_inv := by
    rintro ⟨y, k, hk⟩
    have hy : ρ (pairHom a b (Commute.all a b) y * k) = y := by
      rw [map_mul, retraction_pairHom a b _ ρ ha hb, MonoidHom.mem_ker.mp hk, mul_one]
    refine Prod.ext hy (Subtype.ext ?_)
    show (pairHom a b (Commute.all a b) (ρ (pairHom a b (Commute.all a b) y * k)))⁻¹ *
      (pairHom a b (Commute.all a b) y * k) = k
    rw [hy, inv_mul_cancel_left]
  map_mul' g h := by
    refine Prod.ext (map_mul ρ g h) (Subtype.ext ?_)
    show (pairHom a b (Commute.all a b) (ρ (g * h)))⁻¹ * (g * h) =
      (pairHom a b (Commute.all a b) (ρ g))⁻¹ * g * ((pairHom a b (Commute.all a b) (ρ h))⁻¹ * h)
    rw [map_mul ρ, map_mul (pairHom a b (Commute.all a b)), mul_inv, mul_mul_mul_comm]

end CommGroup

end RotationAlgebra
end GroupApproximation
