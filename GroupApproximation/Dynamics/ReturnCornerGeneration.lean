import GroupApproximation.Dynamics.ReturnRingUnit

/-!
# The return corner is generated by coefficients, `v` and `w`

`non_mf_groups_exist.tex`, proof of Corollary `cor:dynamic-rank-budget`
(`\label{cor:dynamic-rank-budget}`), tex 1724–1726:

> $P_C=\operatorname{LC}(C,k)\rtimes_{S_C}\mathbb Z$: split any
> partial shift with endpoints in $C$ according to its successive
> returns.  This is a finite splitting for each fixed shift exponent.

The surjective half of the printed isomorphism, for any homomorphism into `P_C`:

* `returnMonomial k hC n = p_C u^n p_C`; every element of `P_C` is `∑_j (1_C f_j) · p_C u^j p_C`;
* the splitting along successive returns: for `n > 0`,
  `p_C u^n p_C = ∑_{0<h≤n} 1_{C'_h} · v · p_C u^{n-h} p_C` (`returnMonomial_natCast_eq`), where `C'_h` is the
  backward return cell of time `h`, because `1_{C'_h} v = 1_{C'_h} u^h` and `1_{C'_h} u^n p_C = 0` for `n < h`;
  for `n < 0` the same holds with forward cells and `w` (`returnMonomial_neg_natCast_eq`);
* `mem_closure_returnCornerGenerators`: `P_C` is the subring generated by the extensions by zero of
  `LC(C, k)`, `v` and `w`;
* `surjective_of_generators`: a ring homomorphism into `P_C` that reaches these generators is surjective.
-/

namespace GroupApproximation.ChainCore

open Set MFQuotientUnits

variable {X : Type*} [TopologicalSpace X] {T : X ≃ₜ X} {r : ℕ} {C : Set X}

section Generation

variable (k : Type*) [Ring k] (hC : IsReturnSection T r C)

theorem charFn_mul_comm_locallyConstant {U : Set X} (hU : IsClopen U) (g : LocallyConstant X k) :
    LocallyConstant.charFn k hU * g = g * LocallyConstant.charFn k hU := by
  ext x
  rw [LocallyConstant.mul_apply, LocallyConstant.mul_apply, LocallyConstant.coe_charFn]
  by_cases hx : x ∈ U
  · rw [Set.indicator_of_mem hx, Pi.one_apply, one_mul, mul_one]
  · rw [Set.indicator_of_notMem hx, zero_mul, mul_zero]

theorem coe_returnCorner_sum {ι : Type*} (s : Finset ι) (F : ι → ReturnCorner k hC) :
    ((∑ i ∈ s, F i : ReturnCorner k hC) : ClopenCrossedProduct T k) =
      ∑ i ∈ s, (F i : ClopenCrossedProduct T k) :=
  map_sum (cornerInclusion (returnP k hC) (isIdempotentElem_returnP k hC)) F s

theorem returnP_mul_mul_returnP_mem (y : ClopenCrossedProduct T k) :
    returnP k hC * y * returnP k hC ∈
      cornerNonUnitalSubring (returnP k hC) (isIdempotentElem_returnP k hC) := by
  refine mem_cornerNonUnitalSubring_iff.2 ⟨?_, ?_⟩
  · rw [← mul_assoc, ← mul_assoc, (isIdempotentElem_returnP k hC).eq]
  · rw [mul_assoc, (isIdempotentElem_returnP k hC).eq]

theorem coeff_charFn_mul_mul_returnP (g : LocallyConstant X k) :
    ClopenCrossedProduct.coeff T k (LocallyConstant.charFn k hC.isClopen * g) * returnP k hC =
      ClopenCrossedProduct.coeff T k (LocallyConstant.charFn k hC.isClopen * g) := by
  rw [returnP, ← map_mul, mul_assoc, ← charFn_mul_comm_locallyConstant k hC.isClopen g, ← mul_assoc,
    ClopenCrossedProduct.charFn_mul_charFn_of_subset k _ _ subset_rfl]

theorem returnP_mul_coeff_mul (g : LocallyConstant X k) (y : ClopenCrossedProduct T k) :
    returnP k hC * (ClopenCrossedProduct.coeff T k g * y) =
      ClopenCrossedProduct.coeff T k (LocallyConstant.charFn k hC.isClopen * g) * y := by
  rw [← mul_assoc, returnP, ← map_mul]

theorem coeff_charFn_mul_mul_returnP_mul (g : LocallyConstant X k) (y : ClopenCrossedProduct T k) :
    ClopenCrossedProduct.coeff T k (LocallyConstant.charFn k hC.isClopen * g) * (returnP k hC * y) =
      ClopenCrossedProduct.coeff T k (LocallyConstant.charFn k hC.isClopen * g) * y := by
  rw [← mul_assoc, coeff_charFn_mul_mul_returnP]

/-! ### Corner elements -/

/-- `p_C u^n p_C`. -/
noncomputable def returnMonomial (n : ℤ) : ReturnCorner k hC :=
  ⟨returnP k hC * unitPow T k n * returnP k hC, returnP_mul_mul_returnP_mem k hC _⟩

theorem coe_returnMonomial (n : ℤ) :
    (returnMonomial k hC n : ClopenCrossedProduct T k) =
      returnP k hC * unitPow T k n * returnP k hC :=
  rfl

theorem returnMonomial_zero : returnMonomial k hC 0 = 1 := by
  apply corner_ext
  rw [coe_returnMonomial, unitPow_zero, mul_one, (isIdempotentElem_returnP k hC).eq, coe_cornerOne]

/-- `1_C g`, as an element of `P_C`. -/
noncomputable def coeffCorner (g : LocallyConstant X k) : ReturnCorner k hC :=
  ⟨ClopenCrossedProduct.coeff T k (LocallyConstant.charFn k hC.isClopen * g),
    by rw [returnP, ← map_mul, ← mul_assoc,
      ClopenCrossedProduct.charFn_mul_charFn_of_subset k _ _ subset_rfl],
    coeff_charFn_mul_mul_returnP k hC g⟩

theorem coe_coeffCorner (g : LocallyConstant X k) :
    (coeffCorner k hC g : ClopenCrossedProduct T k) =
      ClopenCrossedProduct.coeff T k (LocallyConstant.charFn k hC.isClopen * g) :=
  rfl

/-- `1_{C'_h}`, as an element of `P_C`. -/
noncomputable def backCellCorner (h : ℕ) : ReturnCorner k hC :=
  ⟨backCellCoeff k hC h, returnP_mul_backCellCoeff k hC h, backCellCoeff_mul_returnP k hC h⟩

theorem coe_backCellCorner (h : ℕ) :
    (backCellCorner k hC h : ClopenCrossedProduct T k) = backCellCoeff k hC h :=
  rfl

/-- `1_{C_h}`, as an element of `P_C`. -/
noncomputable def cellCorner (h : ℕ) : ReturnCorner k hC :=
  ⟨cellCoeff k hC h, returnP_mul_cellCoeff k hC h, cellCoeff_mul_returnP k hC h⟩

theorem coe_cellCorner (h : ℕ) : (cellCorner k hC h : ClopenCrossedProduct T k) = cellCoeff k hC h :=
  rfl

/-! ### The generators -/

/-- The extensions by zero of `LC(C, k)`, together with `v` and `w`. -/
noncomputable def returnCornerGenerators : Set (ReturnCorner k hC) :=
  {z | ∃ f : LocallyConstant C k, (z : ClopenCrossedProduct T k) =
      ClopenCrossedProduct.coeff T k (clopenExtendByZero k hC.isClopen f)} ∪
    {((returnUnit k hC : (ReturnCorner k hC)ˣ) : ReturnCorner k hC),
      (((returnUnit k hC)⁻¹ : (ReturnCorner k hC)ˣ) : ReturnCorner k hC)}

theorem coeffCorner_mem_closure (g : LocallyConstant X k) :
    coeffCorner k hC g ∈ Subring.closure (returnCornerGenerators k hC) :=
  Subring.subset_closure (Set.mem_union_left _
    ⟨clopenRestrict k g, by rw [coe_coeffCorner, clopenExtendByZero_restrict]⟩)

theorem backCellCorner_mem_closure (h : ℕ) :
    backCellCorner k hC h ∈ Subring.closure (returnCornerGenerators k hC) :=
  Subring.subset_closure (Set.mem_union_left _
    ⟨clopenRestrict k (LocallyConstant.charFn k (isClopen_returnCell hC.inv h)), by
      rw [coe_backCellCorner, backCellCoeff, clopenExtendByZero_restrict,
        ClopenCrossedProduct.charFn_mul_charFn_of_superset k _ _ returnCell_subset]⟩)

theorem cellCorner_mem_closure (h : ℕ) :
    cellCorner k hC h ∈ Subring.closure (returnCornerGenerators k hC) :=
  Subring.subset_closure (Set.mem_union_left _
    ⟨clopenRestrict k (LocallyConstant.charFn k (isClopen_returnCell hC h)), by
      rw [coe_cellCorner, cellCoeff, clopenExtendByZero_restrict,
        ClopenCrossedProduct.charFn_mul_charFn_of_superset k _ _ returnCell_subset]⟩)

theorem returnUnit_mem_closure :
    ((returnUnit k hC : (ReturnCorner k hC)ˣ) : ReturnCorner k hC) ∈
      Subring.closure (returnCornerGenerators k hC) :=
  Subring.subset_closure (Set.mem_union_right _ (Set.mem_insert _ _))

theorem returnUnit_inv_mem_closure :
    (((returnUnit k hC)⁻¹ : (ReturnCorner k hC)ˣ) : ReturnCorner k hC) ∈
      Subring.closure (returnCornerGenerators k hC) :=
  Subring.subset_closure (Set.mem_union_right _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))

/-! ### Cells against `v`, `w` and translates of `C` -/

theorem backCellCoeff_at_zero : backCellCoeff k hC 0 = 0 := by
  have h0 : LocallyConstant.charFn k (isClopen_returnCell hC.inv 0) = 0 := by
    ext x
    simp only [LocallyConstant.coe_charFn, returnCell_zero hC.inv, Set.indicator_empty,
      LocallyConstant.zero_apply]
  rw [backCellCoeff, h0, map_zero]

theorem cellCoeff_at_zero : cellCoeff k hC 0 = 0 := by
  have h0 : LocallyConstant.charFn k (isClopen_returnCell hC 0) = 0 := by
    ext x
    simp only [LocallyConstant.coe_charFn, returnCell_zero hC, Set.indicator_empty,
      LocallyConstant.zero_apply]
  rw [cellCoeff, h0, map_zero]

/-- `1_{C'_h} v = 1_{C'_h} u^h`. -/
theorem backCellCoeff_mul_returnV {h : ℕ} (hh : h < 2 * r) :
    backCellCoeff k hC h * returnV k hC = backCellCoeff k hC h * unitPow T k (h : ℤ) := by
  rw [returnV_eq_sum_back, Finset.mul_sum, Finset.sum_eq_single h]
  · rw [← mul_assoc, backCellCoeff_mul_self]
  · intro h' _ hne
    rw [← mul_assoc, backCellCoeff_mul_of_ne k hC (Ne.symm hne), zero_mul]
  · intro hn
    exact absurd (Finset.mem_range.2 hh) hn

/-- `1_{C_h} w = 1_{C_h} u^{-h}`. -/
theorem cellCoeff_mul_returnW {h : ℕ} (hh : h < 2 * r) :
    cellCoeff k hC h * returnW k hC = cellCoeff k hC h * unitPow T k (-(h : ℤ)) := by
  rw [returnW, Finset.mul_sum, Finset.sum_eq_single h]
  · rw [← mul_assoc, cellCoeff_mul_self]
  · intro h' _ hne
    rw [← mul_assoc, cellCoeff_mul_of_ne k hC (Ne.symm hne), zero_mul]
  · intro hn
    exact absurd (Finset.mem_range.2 hh) hn

/-- `1_{C'_h} u^n p_C = 0` for `0 < n < h`: a point of `C'_h` does not come back to `C` in `n` steps
backwards. -/
theorem backCellCoeff_mul_unitPow_mul_returnP_of_lt {n h : ℕ} (hn : 0 < n) (hnh : n < h) :
    backCellCoeff k hC h * unitPow T k (n : ℤ) * returnP k hC = 0 := by
  have hdisj : Disjoint (returnCell T⁻¹ C h) ((T ^ (n : ℤ)) '' C) := by
    refine disjoint_left.2 fun x hx hximg => ?_
    obtain ⟨y, hy, rfl⟩ := hximg
    exact returnTime_min hC.inv _ hn (by rw [hx.2]; exact hnh)
      (by rw [inv_zpow', zpow_neg_apply_zpow_apply_homeomorph]; exact hy)
  rw [mul_assoc, returnP, unitPow_mul_coeff, comap_zpow_neg_charFn, ← mul_assoc, backCellCoeff,
    ← map_mul, charFn_mul_charFn_of_disjoint k _ _ hdisj, map_zero, zero_mul]

/-- `1_{C_h} u^{-m} p_C = 0` for `0 < m < h`. -/
theorem cellCoeff_mul_unitPow_neg_mul_returnP_of_lt {m h : ℕ} (hm : 0 < m) (hmh : m < h) :
    cellCoeff k hC h * unitPow T k (-(m : ℤ)) * returnP k hC = 0 := by
  have hdisj : Disjoint (returnCell T C h) ((T ^ (-(m : ℤ))) '' C) := by
    refine disjoint_left.2 fun x hx hximg => ?_
    obtain ⟨y, hy, rfl⟩ := hximg
    exact returnTime_min hC _ hm (by rw [hx.2]; exact hmh)
      (by rw [zpow_apply_zpow_apply_homeomorph, add_neg_cancel, zpow_zero, Homeomorph.one_apply]
          exact hy)
  rw [mul_assoc, returnP, unitPow_mul_coeff, comap_zpow_neg_charFn, ← mul_assoc, cellCoeff,
    ← map_mul, charFn_mul_charFn_of_disjoint k _ _ hdisj, map_zero, zero_mul]

theorem coe_backCellCorner_mul_returnUnit_mul_returnMonomial {n h : ℕ} (hhn : h ≤ n)
    (hh : h < 2 * r) :
    ((backCellCorner k hC h * ((returnUnit k hC : (ReturnCorner k hC)ˣ) : ReturnCorner k hC) *
        returnMonomial k hC ((n - h : ℕ) : ℤ) : ReturnCorner k hC) : ClopenCrossedProduct T k) =
      backCellCoeff k hC h * unitPow T k (n : ℤ) * returnP k hC := by
  rw [coe_corner_mul, coe_corner_mul, coe_backCellCorner, coe_returnUnit, coe_returnMonomial]
  calc backCellCoeff k hC h * returnV k hC *
        (returnP k hC * unitPow T k ((n - h : ℕ) : ℤ) * returnP k hC)
      = backCellCoeff k hC h * (returnV k hC * returnP k hC) * unitPow T k ((n - h : ℕ) : ℤ) *
          returnP k hC := by simp only [mul_assoc]
    _ = backCellCoeff k hC h * unitPow T k (h : ℤ) * unitPow T k ((n - h : ℕ) : ℤ) *
          returnP k hC := by
        rw [returnV_mul_returnP, backCellCoeff_mul_returnV k hC hh]
    _ = backCellCoeff k hC h * unitPow T k (n : ℤ) * returnP k hC := by
        rw [mul_assoc (backCellCoeff k hC h), unitPow_mul,
          show (h : ℤ) + ((n - h : ℕ) : ℤ) = (n : ℤ) by rw [Nat.cast_sub hhn]; ring]

theorem coe_cellCorner_mul_returnUnit_inv_mul_returnMonomial {m h : ℕ} (hhm : h ≤ m)
    (hh : h < 2 * r) :
    ((cellCorner k hC h * (((returnUnit k hC)⁻¹ : (ReturnCorner k hC)ˣ) : ReturnCorner k hC) *
        returnMonomial k hC (-((m - h : ℕ) : ℤ)) : ReturnCorner k hC) : ClopenCrossedProduct T k) =
      cellCoeff k hC h * unitPow T k (-(m : ℤ)) * returnP k hC := by
  rw [coe_corner_mul, coe_corner_mul, coe_cellCorner, coe_returnUnit_inv, coe_returnMonomial]
  calc cellCoeff k hC h * returnW k hC *
        (returnP k hC * unitPow T k (-((m - h : ℕ) : ℤ)) * returnP k hC)
      = cellCoeff k hC h * (returnW k hC * returnP k hC) * unitPow T k (-((m - h : ℕ) : ℤ)) *
          returnP k hC := by simp only [mul_assoc]
    _ = cellCoeff k hC h * unitPow T k (-(h : ℤ)) * unitPow T k (-((m - h : ℕ) : ℤ)) *
          returnP k hC := by
        rw [returnW_mul_returnP, cellCoeff_mul_returnW k hC hh]
    _ = cellCoeff k hC h * unitPow T k (-(m : ℤ)) * returnP k hC := by
        rw [mul_assoc (cellCoeff k hC h), unitPow_mul,
          show -(h : ℤ) + -((m - h : ℕ) : ℤ) = -(m : ℤ) by rw [Nat.cast_sub hhm]; ring]

/-! ### Splitting along successive returns (tex 1725–1726) -/

/-- **Positive shifts split along backward returns.** -/
theorem returnMonomial_natCast_eq {n : ℕ} (hn : 0 < n) :
    returnMonomial k hC (n : ℤ) = ∑ h ∈ Finset.range (2 * r),
      if h = 0 ∨ n < h then 0 else
        backCellCorner k hC h * ((returnUnit k hC : (ReturnCorner k hC)ˣ) : ReturnCorner k hC) *
          returnMonomial k hC ((n - h : ℕ) : ℤ) := by
  apply corner_ext
  rw [coe_returnCorner_sum]
  calc (returnMonomial k hC (n : ℤ) : ClopenCrossedProduct T k)
      = (∑ h ∈ Finset.range (2 * r), backCellCoeff k hC h) * unitPow T k (n : ℤ) *
          returnP k hC := by
        rw [coe_returnMonomial, sum_backCellCoeff]
    _ = ∑ h ∈ Finset.range (2 * r), backCellCoeff k hC h * unitPow T k (n : ℤ) * returnP k hC := by
        rw [Finset.sum_mul, Finset.sum_mul]
    _ = _ := Finset.sum_congr rfl fun h hh => by
        split_ifs with hcase
        · rcases hcase with rfl | hlt
          · rw [backCellCoeff_at_zero, zero_mul, zero_mul, coe_corner_zero]
          · rw [backCellCoeff_mul_unitPow_mul_returnP_of_lt k hC hn hlt, coe_corner_zero]
        · push Not at hcase
          rw [coe_backCellCorner_mul_returnUnit_mul_returnMonomial k hC hcase.2
            (Finset.mem_range.1 hh)]

/-- **Negative shifts split along forward returns.** -/
theorem returnMonomial_neg_natCast_eq {m : ℕ} (hm : 0 < m) :
    returnMonomial k hC (-(m : ℤ)) = ∑ h ∈ Finset.range (2 * r),
      if h = 0 ∨ m < h then 0 else
        cellCorner k hC h * (((returnUnit k hC)⁻¹ : (ReturnCorner k hC)ˣ) : ReturnCorner k hC) *
          returnMonomial k hC (-((m - h : ℕ) : ℤ)) := by
  apply corner_ext
  rw [coe_returnCorner_sum]
  calc (returnMonomial k hC (-(m : ℤ)) : ClopenCrossedProduct T k)
      = (∑ h ∈ Finset.range (2 * r), cellCoeff k hC h) * unitPow T k (-(m : ℤ)) *
          returnP k hC := by
        rw [coe_returnMonomial, sum_cellCoeff]
    _ = ∑ h ∈ Finset.range (2 * r), cellCoeff k hC h * unitPow T k (-(m : ℤ)) * returnP k hC := by
        rw [Finset.sum_mul, Finset.sum_mul]
    _ = _ := Finset.sum_congr rfl fun h hh => by
        split_ifs with hcase
        · rcases hcase with rfl | hlt
          · rw [cellCoeff_at_zero, zero_mul, zero_mul, coe_corner_zero]
          · rw [cellCoeff_mul_unitPow_neg_mul_returnP_of_lt k hC hm hlt, coe_corner_zero]
        · push Not at hcase
          rw [coe_cellCorner_mul_returnUnit_inv_mul_returnMonomial k hC hcase.2
            (Finset.mem_range.1 hh)]

theorem returnMonomial_natCast_mem_closure (n : ℕ) :
    returnMonomial k hC (n : ℤ) ∈ Subring.closure (returnCornerGenerators k hC) := by
  refine Nat.strong_induction_on (p := fun n : ℕ =>
    returnMonomial k hC (n : ℤ) ∈ Subring.closure (returnCornerGenerators k hC)) n fun n ih => ?_
  show returnMonomial k hC (n : ℤ) ∈ Subring.closure (returnCornerGenerators k hC)
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [Nat.cast_zero, returnMonomial_zero]
    exact one_mem _
  · rw [returnMonomial_natCast_eq k hC hn]
    refine Subring.sum_mem _ fun h _ => ?_
    split_ifs with hcase
    · exact zero_mem _
    · push Not at hcase
      obtain ⟨h0, hle⟩ := hcase
      exact mul_mem (mul_mem (backCellCorner_mem_closure k hC h) (returnUnit_mem_closure k hC))
        (ih (n - h) (by omega))

theorem returnMonomial_neg_natCast_mem_closure (m : ℕ) :
    returnMonomial k hC (-(m : ℤ)) ∈ Subring.closure (returnCornerGenerators k hC) := by
  refine Nat.strong_induction_on (p := fun m : ℕ =>
    returnMonomial k hC (-(m : ℤ)) ∈ Subring.closure (returnCornerGenerators k hC)) m
    fun m ih => ?_
  show returnMonomial k hC (-(m : ℤ)) ∈ Subring.closure (returnCornerGenerators k hC)
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · rw [Nat.cast_zero, neg_zero, returnMonomial_zero]
    exact one_mem _
  · rw [returnMonomial_neg_natCast_eq k hC hm]
    refine Subring.sum_mem _ fun h _ => ?_
    split_ifs with hcase
    · exact zero_mem _
    · push Not at hcase
      obtain ⟨h0, hle⟩ := hcase
      exact mul_mem (mul_mem (cellCorner_mem_closure k hC h) (returnUnit_inv_mem_closure k hC))
        (ih (m - h) (by omega))

theorem returnMonomial_mem_closure (n : ℤ) :
    returnMonomial k hC n ∈ Subring.closure (returnCornerGenerators k hC) := by
  obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg n
  · exact returnMonomial_natCast_mem_closure k hC m
  · exact returnMonomial_neg_natCast_mem_closure k hC m

/-- **`P_C` is generated by the extended coefficients, `v` and `w`** (tex 1724–1726). -/
theorem mem_closure_returnCornerGenerators (z : ReturnCorner k hC) :
    z ∈ Subring.closure (returnCornerGenerators k hC) := by
  obtain ⟨S, f, hz⟩ := ClopenCrossedProduct.exists_sum_coeff_mul_unit_zpow T k
    (z : ClopenCrossedProduct T k)
  have hz' : (z : ClopenCrossedProduct T k) =
      ∑ j ∈ S, ClopenCrossedProduct.coeff T k (f j) * unitPow T k j := hz
  have hsum : z = ∑ j ∈ S, coeffCorner k hC (f j) * returnMonomial k hC j := by
    apply corner_ext
    rw [coe_returnCorner_sum]
    calc (z : ClopenCrossedProduct T k)
        = returnP k hC * (z : ClopenCrossedProduct T k) * returnP k hC := by
          rw [mul_assoc, z.2.2, z.2.1]
      _ = ∑ j ∈ S, returnP k hC * (ClopenCrossedProduct.coeff T k (f j) * unitPow T k j) *
            returnP k hC := by
          rw [hz', Finset.mul_sum, Finset.sum_mul]
      _ = _ := Finset.sum_congr rfl fun j _ => by
          rw [coe_corner_mul, coe_coeffCorner, coe_returnMonomial]
          simp only [mul_assoc]
          rw [returnP_mul_coeff_mul k hC, coeff_charFn_mul_mul_returnP_mul k hC]
  rw [hsum]
  exact Subring.sum_mem _ fun j _ =>
    mul_mem (coeffCorner_mem_closure k hC (f j)) (returnMonomial_mem_closure k hC j)

/-- **Surjectivity criterion**: a ring homomorphism into `P_C` that reaches every extended
coefficient, `v` and `w` is surjective. -/
theorem surjective_of_generators {R : Type*} [Ring R] (φ : R →+* ReturnCorner k hC)
    (hcoeff : ∀ f : LocallyConstant C k, ∃ a : R, (φ a : ClopenCrossedProduct T k) =
      ClopenCrossedProduct.coeff T k (clopenExtendByZero k hC.isClopen f))
    (hv : ∃ a : R, φ a = ((returnUnit k hC : (ReturnCorner k hC)ˣ) : ReturnCorner k hC))
    (hw : ∃ a : R, φ a = (((returnUnit k hC)⁻¹ : (ReturnCorner k hC)ˣ) : ReturnCorner k hC)) :
    Function.Surjective φ := by
  intro z
  have hle : Subring.closure (returnCornerGenerators k hC) ≤ φ.range := by
    rw [Subring.closure_le]
    rintro y (⟨f, hf⟩ | hy)
    · obtain ⟨a, ha⟩ := hcoeff f
      exact RingHom.mem_range.2 ⟨a, corner_ext (ha.trans hf.symm)⟩
    · rcases hy with rfl | hy
      · exact RingHom.mem_range.2 hv
      · rw [Set.mem_singleton_iff] at hy
        subst hy
        exact RingHom.mem_range.2 hw
