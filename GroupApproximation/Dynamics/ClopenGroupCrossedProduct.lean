import GroupApproximation.Meta.AxiomGuard
import Mathlib.Algebra.SkewMonoidAlgebra.Basic
import Mathlib.Algebra.Group.Action.Pointwise.Set.Basic
import Mathlib.Topology.Algebra.ConstMulAction
import Mathlib.Topology.LocallyConstant.Algebra

/-!
# The clopen crossed product `LC(Z, k) ⋊ Λ` of a group action

`simple_kazhdan_sofic_group.tex` at origin/main 37551fd93, `\label{thm:general}` and "The ring and
property (T)", tex 110–111 and 134–137:

> Let a finitely generated group `Λ` act minimally and topologically freely on a Cantor set `Z`, and
> let `R = LC(Z, F_2) ⋊ Λ` be generated by a finite set `S ∋ 1`. ...
> Write `e_U` for the indicator of a clopen set `U ⊆ Z`.  The ring
> `R = ⊕_{ξ ∈ Λ} LC(Z, F_2) u_ξ` has the multiplication `(f u_ξ)(f' u_η) = f (f' ∘ ξ⁻¹) u_{ξη}`, so
> `u_ξ e_U u_ξ⁻¹ = e_{ξU}`.

This module is the interface of `LC(Z, k) ⋊ Λ` for a group `Λ` acting on a topological space `Z` by
homeomorphisms (`ContinuousConstSMul Λ Z`).  It generalizes `ClopenCrossedProduct`, the case
`Λ = ℤ`.  Its definitions hold for every such action and every ring `k`; the printed hypotheses
(minimal, topologically free, Cantor set) belong to the theorems that use them.

* `ClopenGroupCoeff Λ Z k`: a type synonym for `LocallyConstant Z k` carrying the action
  `ξ • f = f ∘ ξ⁻¹`, with `ClopenGroupCoeff.of : LocallyConstant Z k ≃+* ClopenGroupCoeff Λ Z k`;
* `ClopenGroupCrossedProduct Λ Z k`: the ring, as `SkewMonoidAlgebra (ClopenGroupCoeff Λ Z k) Λ`.
  Its elements are the finitely supported functions `Λ → LC(Z, k)`, so expansions are unique and the
  `u_ξ` are formal;
* `ClopenGroupCrossedProduct.coeff : LocallyConstant Z k →+* R` (`coeff_injective`) and the units
  `ClopenGroupCrossedProduct.unit ξ = u_ξ`, with `unitHom : Λ →* Rˣ`;
* `coeff_mul_unit_mul_coeff_mul_unit`: `(f u_ξ)(f' u_η) = f (f' ∘ ξ⁻¹) u_{ξη}`;
* `unit_mul_coeff_mul_inv`: `u_ξ f u_ξ⁻¹ = f ∘ ξ⁻¹`, and `unit_mul_charFn_mul_inv`:
  `u_ξ e_U u_ξ⁻¹ = e_{ξU}`;
* `exists_sum_coeff_mul_unit`, `coeff_sum_coeff_mul_unit` and `eq_of_sum_coeff_mul_unit_eq`:
  `R = ⊕_{ξ ∈ Λ} LC(Z, k) u_ξ`.
-/

namespace GroupApproximation

open scoped Pointwise

/-- The coefficient ring `LC(Z, k)` of `LC(Z, k) ⋊ Λ` (tex 135), as a type synonym for
`LocallyConstant Z k` that carries the action of `Λ`. -/
def ClopenGroupCoeff (_Λ : Type*) (Z : Type*) [TopologicalSpace Z] (k : Type*) : Type _ :=
  LocallyConstant Z k

namespace ClopenGroupCoeff

variable (Λ : Type*) (Z : Type*) [TopologicalSpace Z] (k : Type*) [Ring k]

instance instRing : Ring (ClopenGroupCoeff Λ Z k) :=
  inferInstanceAs (Ring (LocallyConstant Z k))

/-- The identity map `LC(Z, k) ≃+* ClopenGroupCoeff Λ Z k`. -/
def of : LocallyConstant Z k ≃+* ClopenGroupCoeff Λ Z k where
  toFun f := f
  invFun f := f
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

variable [Group Λ] [MulAction Λ Z] [ContinuousConstSMul Λ Z]

/-- The homeomorphism `x ↦ ξ • x` of `Z`, as a continuous map. -/
def smulMap (ξ : Λ) : C(Z, Z) :=
  ⟨fun x => ξ • x, continuous_const_smul ξ⟩

@[simp]
theorem smulMap_apply (ξ : Λ) (x : Z) : smulMap Λ Z ξ x = ξ • x :=
  rfl

/-- `Λ` acts on `ClopenGroupCoeff Λ Z k` by `ξ • f = f ∘ ξ⁻¹`. -/
noncomputable instance instMulSemiringAction : MulSemiringAction Λ (ClopenGroupCoeff Λ Z k) where
  smul ξ f := of Λ Z k (LocallyConstant.comap (smulMap Λ Z ξ⁻¹) ((of Λ Z k).symm f))
  one_smul f := LocallyConstant.ext fun x => by
    show (of Λ Z k).symm f ((1 : Λ)⁻¹ • x) = (of Λ Z k).symm f x
    rw [inv_one, one_smul]
  mul_smul m n f := LocallyConstant.ext fun x => by
    show (of Λ Z k).symm f ((m * n)⁻¹ • x) = (of Λ Z k).symm f (n⁻¹ • m⁻¹ • x)
    rw [mul_inv_rev, mul_smul]
  smul_zero _ := LocallyConstant.ext fun _ => rfl
  smul_add _ _ _ := LocallyConstant.ext fun _ => rfl
  smul_one _ := LocallyConstant.ext fun _ => rfl
  smul_mul _ _ _ := LocallyConstant.ext fun _ => rfl

theorem smul_of (ξ : Λ) (f : LocallyConstant Z k) :
    ξ • of Λ Z k f = of Λ Z k (LocallyConstant.comap (smulMap Λ Z ξ⁻¹) f) :=
  rfl

end ClopenGroupCoeff

/-- **The ring** `LC(Z, k) ⋊ Λ` (tex 111 and 135): the algebraic crossed product
`SkewMonoidAlgebra (ClopenGroupCoeff Λ Z k) Λ`, with `single ξ f * single η f' =
single (ξ * η) (f * ξ • f')`. -/
abbrev ClopenGroupCrossedProduct (Λ : Type*) [Group Λ] (Z : Type*) [TopologicalSpace Z]
    [MulAction Λ Z] [ContinuousConstSMul Λ Z] (k : Type*) [Ring k] : Type _ :=
  SkewMonoidAlgebra (ClopenGroupCoeff Λ Z k) Λ

namespace ClopenGroupCrossedProduct

open SkewMonoidAlgebra (single)

variable (Λ : Type*) [Group Λ] (Z : Type*) [TopologicalSpace Z] [MulAction Λ Z]
  [ContinuousConstSMul Λ Z] (k : Type*) [Ring k]

/-- The coefficient embedding `LC(Z, k) →+* LC(Z, k) ⋊ Λ`, `f ↦ f u_e`. -/
noncomputable def coeff : LocallyConstant Z k →+* ClopenGroupCrossedProduct Λ Z k :=
  RingHom.comp SkewMonoidAlgebra.singleOneRingHom (ClopenGroupCoeff.of Λ Z k).toRingHom

theorem coeff_apply (f : LocallyConstant Z k) :
    coeff Λ Z k f = single (1 : Λ) (ClopenGroupCoeff.of Λ Z k f) :=
  rfl

theorem coeff_injective : Function.Injective (coeff Λ Z k) := by
  intro a b h
  rw [coeff_apply, coeff_apply] at h
  exact (ClopenGroupCoeff.of Λ Z k).injective (SkewMonoidAlgebra.single_injective _ h)

/-! ### The units `u_ξ` -/

/-- The unit `u_ξ = single ξ 1`, with inverse `single ξ⁻¹ 1`. -/
noncomputable def unit (ξ : Λ) : (ClopenGroupCrossedProduct Λ Z k)ˣ where
  val := single ξ 1
  inv := single ξ⁻¹ 1
  val_inv := by
    rw [SkewMonoidAlgebra.single_mul_single, smul_one, mul_one, mul_inv_cancel,
      SkewMonoidAlgebra.single_one_one]
  inv_val := by
    rw [SkewMonoidAlgebra.single_mul_single, smul_one, mul_one, inv_mul_cancel,
      SkewMonoidAlgebra.single_one_one]

@[simp]
theorem val_unit (ξ : Λ) :
    ((unit Λ Z k ξ : (ClopenGroupCrossedProduct Λ Z k)ˣ) : ClopenGroupCrossedProduct Λ Z k) =
      single ξ 1 :=
  rfl

theorem unit_inv (ξ : Λ) : (unit Λ Z k ξ)⁻¹ = unit Λ Z k ξ⁻¹ :=
  Units.ext rfl

theorem unit_mul (ξ η : Λ) : unit Λ Z k (ξ * η) = unit Λ Z k ξ * unit Λ Z k η :=
  Units.ext <| by
    simp only [Units.val_mul, val_unit, SkewMonoidAlgebra.single_mul_single, smul_one, mul_one]

/-- `ξ ↦ u_ξ`, a homomorphism `Λ →* Rˣ`. -/
noncomputable def unitHom : Λ →* (ClopenGroupCrossedProduct Λ Z k)ˣ where
  toFun := unit Λ Z k
  map_one' := Units.ext <| by
    simp only [val_unit, Units.val_one, SkewMonoidAlgebra.single_one_one]
  map_mul' := unit_mul Λ Z k

@[simp]
theorem unitHom_apply (ξ : Λ) : unitHom Λ Z k ξ = unit Λ Z k ξ :=
  rfl

/-! ### Multiplication and covariance -/

/-- Every monomial is a coefficient times a unit: `single ξ f = f u_ξ`. -/
theorem single_eq_coeff_mul_unit (ξ : Λ) (f : LocallyConstant Z k) :
    single ξ (ClopenGroupCoeff.of Λ Z k f) =
      coeff Λ Z k f * (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k) := by
  rw [coeff_apply, val_unit, SkewMonoidAlgebra.single_mul_single, one_mul, smul_one, mul_one]

/-- **The multiplication** (tex 136): `(f u_ξ)(f' u_η) = f (f' ∘ ξ⁻¹) u_{ξη}`. -/
theorem coeff_mul_unit_mul_coeff_mul_unit (ξ η : Λ) (f f' : LocallyConstant Z k) :
    (coeff Λ Z k f * (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k)) *
        (coeff Λ Z k f' * (unit Λ Z k η : ClopenGroupCrossedProduct Λ Z k)) =
      coeff Λ Z k (f * LocallyConstant.comap (ClopenGroupCoeff.smulMap Λ Z ξ⁻¹) f') *
        (unit Λ Z k (ξ * η) : ClopenGroupCrossedProduct Λ Z k) := by
  rw [← single_eq_coeff_mul_unit, ← single_eq_coeff_mul_unit, ← single_eq_coeff_mul_unit,
    SkewMonoidAlgebra.single_mul_single, ClopenGroupCoeff.smul_of, map_mul]

/-- `u_ξ f = (f ∘ ξ⁻¹) u_ξ`. -/
theorem unit_mul_coeff (ξ : Λ) (f : LocallyConstant Z k) :
    (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k) * coeff Λ Z k f =
      coeff Λ Z k (LocallyConstant.comap (ClopenGroupCoeff.smulMap Λ Z ξ⁻¹) f) *
        (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k) := by
  rw [← single_eq_coeff_mul_unit, val_unit, coeff_apply, SkewMonoidAlgebra.single_mul_single,
    mul_one, one_mul, ClopenGroupCoeff.smul_of]

/-- **Covariance**: `u_ξ f u_ξ⁻¹ = f ∘ ξ⁻¹`. -/
theorem unit_mul_coeff_mul_inv (ξ : Λ) (f : LocallyConstant Z k) :
    (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k) * coeff Λ Z k f *
        ((unit Λ Z k ξ)⁻¹ : (ClopenGroupCrossedProduct Λ Z k)ˣ) =
      coeff Λ Z k (LocallyConstant.comap (ClopenGroupCoeff.smulMap Λ Z ξ⁻¹) f) := by
  rw [unit_mul_coeff, mul_assoc, Units.mul_inv, mul_one]

/-! ### Indicators -/

/-- `ξ U` is clopen when `U` is. -/
theorem isClopen_smul_set (ξ : Λ) {U : Set Z} (hU : IsClopen U) : IsClopen (ξ • U) := by
  rw [← Set.preimage_smul_inv]
  exact hU.preimage (continuous_const_smul ξ⁻¹)

/-- `e_U ∘ ξ⁻¹ = e_{ξU}`. -/
theorem comap_smulMap_inv_charFn (ξ : Λ) {U : Set Z} (hU : IsClopen U) :
    LocallyConstant.comap (ClopenGroupCoeff.smulMap Λ Z ξ⁻¹) (LocallyConstant.charFn k hU) =
      LocallyConstant.charFn k (isClopen_smul_set Λ Z ξ hU) := by
  ext x
  rw [LocallyConstant.coe_comap_apply, ClopenGroupCoeff.smulMap_apply]
  simp only [LocallyConstant.coe_charFn]
  by_cases hx : ξ⁻¹ • x ∈ U
  · simp only [Set.indicator_of_mem hx,
      Set.indicator_of_mem (Set.mem_smul_set_iff_inv_smul_mem.2 hx), Pi.one_apply]
  · simp only [Set.indicator_of_notMem hx,
      Set.indicator_of_notMem (mt Set.mem_smul_set_iff_inv_smul_mem.1 hx)]

/-- **Covariance on indicators** (tex 137): `u_ξ e_U u_ξ⁻¹ = e_{ξU}`. -/
theorem unit_mul_charFn_mul_inv (ξ : Λ) {U : Set Z} (hU : IsClopen U) :
    (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k) *
        coeff Λ Z k (LocallyConstant.charFn k hU) *
        ((unit Λ Z k ξ)⁻¹ : (ClopenGroupCrossedProduct Λ Z k)ˣ) =
      coeff Λ Z k (LocallyConstant.charFn k (isClopen_smul_set Λ Z ξ hU)) := by
  rw [unit_mul_coeff_mul_inv, comap_smulMap_inv_charFn]

/-! ### The direct sum `R = ⊕_{ξ ∈ Λ} LC(Z, k) u_ξ` -/

/-- **Expansion** (tex 135): every element is `∑_{ξ ∈ S} f_ξ u_ξ` for a finite set `S`. -/
theorem exists_sum_coeff_mul_unit (r : ClopenGroupCrossedProduct Λ Z k) :
    ∃ (S : Finset Λ) (f : Λ → LocallyConstant Z k),
      r = ∑ ξ ∈ S, coeff Λ Z k (f ξ) * (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k) := by
  refine ⟨SkewMonoidAlgebra.support r,
    fun ξ => (ClopenGroupCoeff.of Λ Z k).symm (SkewMonoidAlgebra.coeff r ξ), ?_⟩
  calc r = SkewMonoidAlgebra.sum r single := (SkewMonoidAlgebra.sum_single r).symm
    _ = ∑ ξ ∈ SkewMonoidAlgebra.support r, single ξ (SkewMonoidAlgebra.coeff r ξ) :=
      SkewMonoidAlgebra.sum_def' _ _
    _ = _ := by
      refine Finset.sum_congr rfl fun ξ _ => ?_
      rw [← single_eq_coeff_mul_unit, RingEquiv.apply_symm_apply]

/-- The coefficient of a finite sum of monomials. -/
theorem coeff_sum_single [DecidableEq Λ] (S : Finset Λ) (a : Λ → ClopenGroupCoeff Λ Z k)
    (η : Λ) :
    SkewMonoidAlgebra.coeff (∑ ξ ∈ S, (single ξ (a ξ) : ClopenGroupCrossedProduct Λ Z k)) η =
      if η ∈ S then a η else 0 := by
  induction S using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty, SkewMonoidAlgebra.coeff_zero, Finsupp.zero_apply,
      if_neg (Finset.notMem_empty η)]
  | insert ξ S hξ ih =>
    rw [Finset.sum_insert hξ, SkewMonoidAlgebra.coeff_add, Finsupp.add_apply, ih,
      SkewMonoidAlgebra.coeff_single, Finsupp.single_apply]
    by_cases hηξ : η = ξ
    · subst hηξ
      rw [if_pos rfl, if_neg hξ, add_zero, if_pos (Finset.mem_insert_self _ _)]
    · rw [if_neg (Ne.symm hηξ), zero_add]
      by_cases hηS : η ∈ S
      · rw [if_pos hηS, if_pos (Finset.mem_insert_of_mem hηS)]
      · rw [if_neg hηS, if_neg (by simp [hηξ, hηS])]

/-- **Uniqueness of the expansion** (tex 135): the coefficient of `∑_{ξ ∈ S} f_ξ u_ξ` at `η` is
`f_η` for `η ∈ S` and `0` otherwise. -/
theorem coeff_sum_coeff_mul_unit [DecidableEq Λ] (S : Finset Λ) (f : Λ → LocallyConstant Z k)
    (η : Λ) :
    SkewMonoidAlgebra.coeff
        (∑ ξ ∈ S, coeff Λ Z k (f ξ) * (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k)) η =
      if η ∈ S then ClopenGroupCoeff.of Λ Z k (f η) else 0 := by
  simp only [← single_eq_coeff_mul_unit]
  exact coeff_sum_single Λ Z k S (fun ξ => ClopenGroupCoeff.of Λ Z k (f ξ)) η

/-- Two expansions over the same finite set agree coefficientwise. -/
theorem eq_of_sum_coeff_mul_unit_eq (S : Finset Λ) (f g : Λ → LocallyConstant Z k)
    (h : ∑ ξ ∈ S, coeff Λ Z k (f ξ) * (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k) =
      ∑ ξ ∈ S, coeff Λ Z k (g ξ) * (unit Λ Z k ξ : ClopenGroupCrossedProduct Λ Z k)) :
    ∀ ξ ∈ S, f ξ = g ξ := by
  classical
  intro ξ hξ
  have h' := congrArg (fun r : ClopenGroupCrossedProduct Λ Z k => SkewMonoidAlgebra.coeff r ξ) h
  simp only [coeff_sum_coeff_mul_unit, if_pos hξ] at h'
  exact (ClopenGroupCoeff.of Λ Z k).injective h'

end ClopenGroupCrossedProduct

end GroupApproximation

