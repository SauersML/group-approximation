#audit_axioms GroupApproximation.ClopenGroupCrossedProduct.unit_mul_charFn_mul_inv
#audit_axioms GroupApproximation.ClopenGroupCrossedProduct.exists_sum_coeff_mul_unit
#audit_axioms GroupApproximation.ClopenGroupCrossedProduct.eq_of_sum_coeff_mul_unit_eq
