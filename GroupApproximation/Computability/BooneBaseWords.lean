import GroupApproximation.Computability.BooneGroupPresentation

/-!
# The base group's elements, as words

`BooneGroupPresentation` proves that Simpson's base group `⟨t, x, y | xy = yx⟩`
*is* the split extension `BaseGroup` --- an isomorphism, not a numbering.  The
tower's associated subgroups are generated by explicit elements of `BaseGroup`,
namely `tw (a,b)` and `sh (M,0)`, `sh (0,N)`, and to carry a presentation up the
tower those generators have to be named by *words* in the three letters.

That is all this file does.  `sh (u,v)` is `x^u y^v`, and `tw (α,β)` is
Simpson's `t(α,β) = (x^α y^β)⁻¹ t (x^α y^β)`, so the words write themselves; the
content is that the presented group reads them as the elements they should be,
which is `fRight_ofAdd` and `fLeft_of` respectively.

The `ℤ` exponents are deliberate: the tower's identifications use `sh (M, 0)`
and `sh (0, N)` for machine-dependent `M, N`, and `tw` at arbitrary residue
pairs, so nothing here can be restricted to `ℕ`.
-/

namespace GroupApproximation
namespace BooneBaseWords

open BooneGroup SemidirectProduct Base

/-- `x^u y^v`, as a word in `t, x, y`. -/
def shWord (p : ℤ × ℤ) : FreeGroup Gen :=
  (FreeGroup.of 1) ^ p.1 * (FreeGroup.of 2) ^ p.2

/-- Simpson's `t(α,β) = (x^α y^β)⁻¹ t (x^α y^β)`, as a word. -/
def twWord (p : ℤ × ℤ) : FreeGroup Gen :=
  (shWord p)⁻¹ * FreeGroup.of 0 * shWord p

/-- The presented group reads `shWord` as the acting `ℤ²` element. -/
theorem mk_shWord (p : ℤ × ℤ) :
    PresentedGroup.mk rels (shWord p) = fRight (Multiplicative.ofAdd p) := by
  rw [shWord, map_mul, map_zpow, map_zpow, fRight_ofAdd]
  rfl

/-- The presented group reads `twWord` as the free-factor generator. -/
theorem mk_twWord (p : ℤ × ℤ) :
    PresentedGroup.mk rels (twWord p) = fLeft (FreeGroup.of p) := by
  rw [twWord, map_mul, map_mul, map_inv, mk_shWord, fLeft_of]
  rfl

/-! ## The same, against the base group itself -/

theorem ofBase_sh (p : ℤ × ℤ) : ofBase (sh p) = fRight (Multiplicative.ofAdd p) := by
  rw [sh, ofBase, SemidirectProduct.lift_inr]

theorem ofBase_tw (p : ℤ × ℤ) : ofBase (tw p) = fLeft (FreeGroup.of p) := by
  rw [tw, ofBase, SemidirectProduct.lift_inl]

/-- **`shWord` names `sh`.** -/
theorem mk_shWord_eq (p : ℤ × ℤ) :
    PresentedGroup.mk rels (shWord p) = ofBase (sh p) := by
  rw [mk_shWord, ofBase_sh]

/-- **`twWord` names `tw`.** -/
theorem mk_twWord_eq (p : ℤ × ℤ) :
    PresentedGroup.mk rels (twWord p) = ofBase (tw p) := by
  rw [mk_twWord, ofBase_tw]

/-- Read the other way, through the isomorphism: the base element `sh p` is the
word `shWord p`. -/
theorem presentedEquiv_shWord (p : ℤ × ℤ) :
    presentedEquiv (PresentedGroup.mk rels (shWord p)) = sh p := by
  rw [mk_shWord_eq]
  exact congrArg (fun f : BaseGroup →* BaseGroup => f (sh p)) toBase_ofBase

/-- The base element `tw p` is the word `twWord p`. -/
theorem presentedEquiv_twWord (p : ℤ × ℤ) :
    presentedEquiv (PresentedGroup.mk rels (twWord p)) = tw p := by
  rw [mk_twWord_eq]
  exact congrArg (fun f : BaseGroup →* BaseGroup => f (tw p)) toBase_ofBase

/-- The base's stable letter `t` is the word `of 0`. -/
theorem ofBase_tGen : ofBase tGen = T := by
  have h : toBase T = tGen := PresentedGroup.toGroup.of _
  rw [← h]
  exact congrArg (fun f : Pres →* Pres => f T) ofBase_toBase

end BooneBaseWords
end GroupApproximation
