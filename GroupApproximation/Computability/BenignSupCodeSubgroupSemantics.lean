import GroupApproximation.Computability.CodedProfiniteWitness
import GroupApproximation.Computability.BenignSupCodeSemantics

/-!
# Subgroup semantics of a coded central HNN layer

`BenignSupCodeSemantics` identifies the raw presentation with a word-level
central HNN extension.  This file adds the missing transport from the subgroup
generated by the displayed raw words to a specified semantic subgroup under a
specified ambient equivalence.  It is the common code-semantic step used by
both levels of the effective benign join.
-/

namespace GroupApproximation
namespace BenignSupCodeSubgroupSemantics

noncomputable section

open PresentationCodes FreeEdgeTowerCode FreeEdgeTowerSemantics
open BenignInfCodeSemantics BenignInfCodeSubgroupSemantics
open Higman MikhailovaRopeCodeSemantics

/-- The presentation source subgroup for a central edge list is exactly the
subgroup generated by evaluation of the underlying raw words. -/
theorem central_srcSub_eq_wordSubgroup (c : PresentationCode)
    (words : List BenignSupCode.Raw) :
    HNNPresentation.srcSub (codeRels c)
        (sourceWord c (centralEdges words)) =
      wordSubgroup c words := by
  unfold HNNPresentation.srcSub wordSubgroup
  congr 1
  ext g
  constructor
  · rintro ⟨i, rfl⟩
    let j : Fin words.length :=
      ⟨i, by simpa [centralEdges] using i.isLt⟩
    refine ⟨words.get j, List.get_mem words j, ?_⟩
    change evalWord c (words.get j) = PresentedGroup.mk (codeRels c)
      (sourceWord c (centralEdges words) i)
    simp [sourceWord, centralEdges, j, evalWord]
  · rintro ⟨w, hw, rfl⟩
    obtain ⟨j, hj⟩ := List.get_of_mem hw
    let i : Fin (centralEdges words).length :=
      ⟨j, by simp [centralEdges]⟩
    refine ⟨i, ?_⟩
    rw [← hj]
    simp [HNNPresentation.srcGen, sourceWord, centralEdges, i, evalWord]

/-- Membership in a subgroup transported by a multiplicative equivalence can
be read before transport. -/
theorem mem_map_equiv_iff {G K : Type} [Group G] [Group K]
    (e : G ≃* K) (S : Subgroup G) (g : G) :
    e g ∈ S.map e.toMonoidHom ↔ g ∈ S := by
  constructor
  · rintro ⟨x, hx, heq⟩
    have hxg : x = g := e.injective heq
    rwa [hxg] at hx
  · intro hg
    exact ⟨g, hg, rfl⟩

/-- The exact membership equivalence consumed by `HNNCongr`. -/
theorem central_mem_iff {K : Type} [Group K]
    (c : PresentationCode) (words : List BenignSupCode.Raw)
    (e : Carrier c ≃* K) (L : Subgroup K)
    (hL : (wordSubgroup c words).map e.toMonoidHom = L)
    (g : Carrier c) :
    g ∈ HNNPresentation.srcSub (codeRels c)
        (sourceWord c (centralEdges words)) ↔ e g ∈ L := by
  rw [central_srcSub_eq_wordSubgroup, ← hL, mem_map_equiv_iff]

/-- The identity central-edge equivalence intertwines the transported identity
on the named semantic subgroup. -/
theorem central_intertwines {K : Type} [Group K]
    (c : PresentationCode) (words : List BenignSupCode.Raw)
    (e : Carrier c ≃* K) (L : Subgroup K)
    (hL : (wordSubgroup c words).map e.toMonoidHom = L) :
    HNNCongr.Intertwines
      (centralSubgroupEquiv c words) (MulEquiv.refl L) e
      (central_mem_iff c words e L hL) := by
  intro a ha
  rfl

/-- A coded centralizing layer, transported to the semantic central HNN over
the subgroup named by its raw cutting words. -/
def centralStageEquiv {K : Type} [Group K]
    (c : PresentationCode) (words : List BenignSupCode.Raw)
    (e : Carrier c ≃* K) (L : Subgroup K)
    (hL : (wordSubgroup c words).map e.toMonoidHom = L) :
    Carrier (MikhailovaRopeCode.firstStageCode c words) ≃* CentHNN L :=
  (MikhailovaRopeCodeSemantics.firstStageCodeEquiv c words).trans
    (HNNCongr.congrEquiv
      (centralSubgroupEquiv c words) (MulEquiv.refl L) e
      (central_mem_iff c words e L hL)
      (central_intertwines c words e L hL))

/-- The transported layer sends an old raw word to the semantic base copy. -/
theorem centralStageEquiv_oldWord {K : Type} [Group K]
    (c : PresentationCode) (words : List BenignSupCode.Raw)
    (e : Carrier c ≃* K) (L : Subgroup K)
    (hL : (wordSubgroup c words).map e.toMonoidHom = L)
    (raw : BenignSupCode.Raw) :
    centralStageEquiv c words e L hL
        (evalWord (MikhailovaRopeCode.firstStageCode c words)
          (DirectProductCode.leftWord c raw)) =
      HNNExtension.of (e (evalWord c raw)) := by
  unfold centralStageEquiv
  change HNNCongr.congrEquiv
      (centralSubgroupEquiv c words) (MulEquiv.refl L) e
      (central_mem_iff c words e L hL)
      (central_intertwines c words e L hL)
      (MikhailovaRopeCodeSemantics.firstStageCodeEquiv c words
        (evalWord (MikhailovaRopeCode.firstStageCode c words)
          (DirectProductCode.leftWord c raw))) = _
  rw [BenignSupCodeSemantics.firstStageCodeEquiv_oldWord]
  exact HNNCongr.congrHom_of
    (centralSubgroupEquiv c words) (MulEquiv.refl L) e
      (central_mem_iff c words e L hL)
      (central_intertwines c words e L hL)
      (evalWord c raw)

/-- The transported code stable letter is the semantic stable letter. -/
theorem centralStageEquiv_stable {K : Type} [Group K]
    (c : PresentationCode) (words : List BenignSupCode.Raw)
    (e : Carrier c ≃* K) (L : Subgroup K)
    (hL : (wordSubgroup c words).map e.toMonoidHom = L) :
    centralStageEquiv c words e L hL
        (PresentedGroup.of
          (letterOf (MikhailovaRopeCode.firstStageCode c words)
            (stableIndex c))) =
      (HNNExtension.t : CentHNN L) := by
  unfold centralStageEquiv
  change HNNCongr.congrEquiv
      (centralSubgroupEquiv c words) (MulEquiv.refl L) e
      (central_mem_iff c words e L hL)
      (central_intertwines c words e L hL)
      (MikhailovaRopeCodeSemantics.firstStageCodeEquiv c words
        (PresentedGroup.of
          (letterOf (MikhailovaRopeCode.firstStageCode c words)
            (stableIndex c)))) = _
  rw [BenignSupCodeSemantics.firstStageCodeEquiv_stable]
  exact HNNCongr.congrHom_t
    (centralSubgroupEquiv c words) (MulEquiv.refl L) e
      (central_mem_iff c words e L hL)
      (central_intertwines c words e L hL)

/-- Under the transported central layer, the literal stable conjugate of an
old raw word is the corresponding semantic stable conjugate. -/
theorem centralStageEquiv_conjugate {K : Type} [Group K]
    (c : PresentationCode) (words : List BenignSupCode.Raw)
    (e : Carrier c ≃* K) (L : Subgroup K)
    (hL : (wordSubgroup c words).map e.toMonoidHom = L)
    (raw : BenignSupCode.Raw) :
    centralStageEquiv c words e L hL
        (evalWord (MikhailovaRopeCode.firstStageCode c words)
          (MikhailovaRopeCode.firstStableConjugate c raw)) =
      (HNNExtension.t : CentHNN L)⁻¹ *
        HNNExtension.of (e (evalWord c raw)) * HNNExtension.t := by
  have hs := centralStageEquiv_stable c words e L hL
  change centralStageEquiv c words e L hL
      (PresentedGroup.mk
        (codeRels (MikhailovaRopeCode.firstStageCode c words))
        (FreeGroup.of
          (letterOf (MikhailovaRopeCode.firstStageCode c words)
            (stableIndex c)))) = HNNExtension.t at hs
  have hw := centralStageEquiv_oldWord c words e L hL raw
  change centralStageEquiv c words e L hL
      (PresentedGroup.mk
        (codeRels (MikhailovaRopeCode.firstStageCode c words))
        (wordOf (MikhailovaRopeCode.firstStageCode c words)
          (DirectProductCode.leftWord c raw))) =
    HNNExtension.of (e (evalWord c raw)) at hw
  simp only [MikhailovaRopeCode.firstStableConjugate,
    RawWord.wordOf_cons_neg, RawWord.wordOf_append,
    RawWord.wordOf_cons_pos, RawWord.wordOf_nil, mul_one, map_mul, map_inv,
    evalWord]
  rw [hs, hw]
  rfl

end

end BenignSupCodeSubgroupSemantics
end GroupApproximation
