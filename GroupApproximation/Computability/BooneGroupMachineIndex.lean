import GroupApproximation.Computability.BooneGroupModularMachine
import GroupApproximation.Computability.BooneGroupBase
import Mathlib.Tactic.Abel
import Mathlib.Tactic.Group
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Module
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-!
# Where the machine meets the group: the halting set as a good index set

Fourth module of the Novikov--Boone chain.  See
`GroupApproximation.Computability.BooneGroupModularMachine` for the route
(Aanderaa--Cohen modular machines, in the form of Simpson's 2005 writeup), the
bibliography, and the statement of the one external debt; see
`GroupApproximation.Computability.BooneGroupBase` for the base group and the
stage-by-stage roadmap.

This module is the paragraph of Simpson that comes immediately after his
Definition 6:

> Note that if `φᵢ(t(α,β)) = t(α₁,β₁)` or `ψⱼ(t(α,β)) = t(α₁,β₁)`, then
> `(α,β) ⟶ (α₁,β₁)`, hence `t(α,β) ∈ T_M ⟺ (α,β) ∈ H_M ⟺ (α₁,β₁) ∈ H_M ⟺
> `t(α₁,β₁) ∈ T_M`.  From this it follows that `T_M` is again a good subgroup
> of `G` with respect to `G'`.

Everything in that paragraph except the words "good subgroup" is *index
combinatorics plus one machine fact*, and all of it is proved here, for an
arbitrary modular machine and with no HNN theory whatsoever.  What is left for
the tower (items **S3**--**S5** of the roadmap) is only the transport of these
statements through the HNN extension.

## The shape of the result

Simpson's associated isomorphism at a right-moving quadruple `(a,b,c,R)` is
`φ : G_{ab}^{MM} ≅ G_{c0}^{M²,1}`, and both groups are the ranges of the
canonical embeddings `emb a b M M` and `emb c 0 M² 1` of
`BooneGroupBase`.  So `φ` is `emb c 0 M² 1 ∘ (emb a b M M)⁻¹`, and the
good-subgroup condition `φ(T_M ⊓ G_{ab}^{MM}) = T_M ⊓ G_{c0}^{M²,1}` is
equivalent to saying that the two sides are the images of *one and the same
parameter set* under the two embeddings.

That parameter set is `haltParams`: the `(u,v)` for which the configuration
`(a + uM, b + vM)` halts.  The content is then two equations,

* `haltParams_eq_right` / `haltParams_eq_left` --- the parameter set does not
  change when read through the *target* embedding instead of the source one
  (this is the machine fact `ModularMachine.haltsZ_right_iff`, and it is the
  only place the machine enters);
* `image_haltParams_src`, `image_haltParams_right`, `image_haltParams_left` ---
  the images of the parameter set under the two embeddings are exactly
  `H_M ∩ (index class)` on either side.

`twSub_halting_inf_Gsub_src` and its two partners then read the same thing off
at the level of subgroups of the base group: `T_M ⊓ G_{ab}^{MM}` and
`T_M ⊓ G_{c0}^{M²,1}` are `twSub` of the two images of the *same* parameter
set.  That is exactly the good-subgroup condition, with the isomorphism left
implicit; supplying the isomorphism is the HNN step.

Nothing here is conditional, and no undecidability statement appears anywhere:
every declaration is universally quantified over `mm : ModularMachine`.
-/

namespace GroupApproximation
namespace BooneGroup
namespace MachineIndex

open Base FreeBasis

variable (mm : ModularMachine)

/-! ## The parameter set -/

/-- **Simpson's parameter set for the good-subgroup condition on `T_M`.**  The
subgroup `T_M ⊓ G_{ab}^{MM}` is generated by the `t(a + uM, b + vM)` for which
the configuration `(a + uM, b + vM)` halts; `haltParams mm a b` is the set of
those parameters `(u,v)`.  It is the preimage of the halting set under the
basis-index part of the canonical embedding `emb a b M M`. -/
def haltParams (a b : ℕ) : Set (ℤ × ℤ) :=
  (embIdx (a : ℤ) (b : ℤ) (mm.size : ℤ) (mm.size : ℤ)) ⁻¹' mm.haltingSetZ

/-- **The machine fact, in parameter form, `R` case.**  For a right-moving
quadruple `(a,b,c,R)`, the parameters whose source configuration halts are
exactly the parameters whose target configuration halts.  This is
`ModularMachine.haltsZ_right_iff`, and it is the *only* place the machine
enters the group construction. -/
theorem haltParams_eq_right {a b c : ℕ} (ha : a < mm.size) (hb : b < mm.size)
    (h : mm.quad a b = some (c, true)) :
    haltParams mm a b
      = (embIdx (c : ℤ) 0 ((mm.size : ℤ) ^ 2) 1) ⁻¹' mm.haltingSetZ := by
  ext q
  obtain ⟨u, v⟩ := q
  show mm.HaltsZ ((a : ℤ) + u * (mm.size : ℤ), (b : ℤ) + v * (mm.size : ℤ))
    ↔ mm.HaltsZ ((c : ℤ) + u * (mm.size : ℤ) ^ 2, (0 : ℤ) + v * 1)
  rw [mul_one, zero_add]
  exact mm.haltsZ_right_iff ha hb h u v

/-- **The machine fact, in parameter form, `L` case.** -/
theorem haltParams_eq_left {a b c : ℕ} (ha : a < mm.size) (hb : b < mm.size)
    (h : mm.quad a b = some (c, false)) :
    haltParams mm a b
      = (embIdx 0 (c : ℤ) 1 ((mm.size : ℤ) ^ 2)) ⁻¹' mm.haltingSetZ := by
  ext q
  obtain ⟨u, v⟩ := q
  show mm.HaltsZ ((a : ℤ) + u * (mm.size : ℤ), (b : ℤ) + v * (mm.size : ℤ))
    ↔ mm.HaltsZ ((0 : ℤ) + u * 1, (c : ℤ) + v * (mm.size : ℤ) ^ 2)
  rw [mul_one, zero_add]
  exact mm.haltsZ_left_iff ha hb h u v

/-! ## The two images of the parameter set -/

/-- The image of the parameter set under the *source* embedding is
`H_M ∩ (the index class of `G_{ab}^{MM}`)`. -/
theorem image_haltParams_src (a b : ℕ) :
    (embIdx (a : ℤ) (b : ℤ) (mm.size : ℤ) (mm.size : ℤ)) '' haltParams mm a b
      = mm.haltingSetZ
          ∩ residue (a : ℤ) (b : ℤ) (mm.size : ℤ) (mm.size : ℤ) := by
  rw [haltParams, Set.image_preimage_eq_inter_range, range_embIdx]

/-- The image of the parameter set under the *target* embedding of a
right-moving quadruple is `H_M ∩ (the index class of `G_{c0}^{M²,1}`)`. -/
theorem image_haltParams_right {a b c : ℕ} (ha : a < mm.size)
    (hb : b < mm.size) (h : mm.quad a b = some (c, true)) :
    (embIdx (c : ℤ) 0 ((mm.size : ℤ) ^ 2) 1) '' haltParams mm a b
      = mm.haltingSetZ ∩ residue (c : ℤ) 0 ((mm.size : ℤ) ^ 2) 1 := by
  rw [haltParams_eq_right mm ha hb h, Set.image_preimage_eq_inter_range,
    range_embIdx]

/-- The image of the parameter set under the *target* embedding of a
left-moving quadruple is `H_M ∩ (the index class of `G_{0c}^{1,M²}`)`. -/
theorem image_haltParams_left {a b c : ℕ} (ha : a < mm.size)
    (hb : b < mm.size) (h : mm.quad a b = some (c, false)) :
    (embIdx 0 (c : ℤ) 1 ((mm.size : ℤ) ^ 2)) '' haltParams mm a b
      = mm.haltingSetZ ∩ residue 0 (c : ℤ) 1 ((mm.size : ℤ) ^ 2) := by
  rw [haltParams_eq_left mm ha hb h, Set.image_preimage_eq_inter_range,
    range_embIdx]

/-! ## The same statements at the level of subgroups of the base group -/

/-- **`T_M ⊓ G_{ab}^{MN} = T_{H_M ∩ class}`.**  Combining Simpson's Lemma 5
(`Base.Tsub_inf_Gsub`) with the fact that sub-basis subgroups intersect as
their index sets do (`Base.twSub_inf`). -/
theorem twSub_halting_inf_Gsub (a b M N : ℤ) :
    twSub mm.haltingSetZ ⊓ Gsub a b M N
      = twSub (mm.haltingSetZ ∩ residue a b M N) := by
  have h1 : twSub mm.haltingSetZ ⊓ (Tsub ⊓ Gsub a b M N)
      = twSub mm.haltingSetZ ⊓ Gsub a b M N := by
    rw [← inf_assoc, inf_eq_left.2 (twSub_le_Tsub _)]
  rw [← h1, Tsub_inf_Gsub, twSub_inf]

/-- **The source side of Simpson's good-subgroup condition for `T_M`.** -/
theorem twSub_halting_inf_Gsub_src (a b : ℕ) :
    twSub mm.haltingSetZ ⊓ Gsub (a : ℤ) (b : ℤ) (mm.size : ℤ) (mm.size : ℤ)
      = twSub ((embIdx (a : ℤ) (b : ℤ) (mm.size : ℤ) (mm.size : ℤ))
          '' haltParams mm a b) := by
  rw [twSub_halting_inf_Gsub, ← image_haltParams_src]

/-- **The target side of Simpson's good-subgroup condition for `T_M`, `R`
case.**  Together with `twSub_halting_inf_Gsub_src` this says that
`T_M ⊓ G_{ab}^{MM}` and `T_M ⊓ G_{c0}^{M²,1}` are the sub-basis subgroups on
the two images of **one and the same** parameter set --- which is precisely
the good-subgroup condition for `T_M`, with the associated isomorphism
`emb c 0 M² 1 ∘ (emb a b M M)⁻¹` left implicit. -/
theorem twSub_halting_inf_Gsub_right {a b c : ℕ} (ha : a < mm.size)
    (hb : b < mm.size) (h : mm.quad a b = some (c, true)) :
    twSub mm.haltingSetZ ⊓ Gsub (c : ℤ) 0 ((mm.size : ℤ) ^ 2) 1
      = twSub ((embIdx (c : ℤ) 0 ((mm.size : ℤ) ^ 2) 1)
          '' haltParams mm a b) := by
  rw [twSub_halting_inf_Gsub, ← image_haltParams_right mm ha hb h]

/-- **The target side of Simpson's good-subgroup condition for `T_M`, `L`
case.** -/
theorem twSub_halting_inf_Gsub_left {a b c : ℕ} (ha : a < mm.size)
    (hb : b < mm.size) (h : mm.quad a b = some (c, false)) :
    twSub mm.haltingSetZ ⊓ Gsub 0 (c : ℤ) 1 ((mm.size : ℤ) ^ 2)
      = twSub ((embIdx 0 (c : ℤ) 1 ((mm.size : ℤ) ^ 2))
          '' haltParams mm a b) := by
  rw [twSub_halting_inf_Gsub, ← image_haltParams_left mm ha hb h]

/-! ## The same for `T` itself

Simpson needs *two* good subgroups: `T` (his Lemma 5) and `T_M`.  For `T` the
parameter set is everything, and the two sides are the full index classes. -/

/-- **The source side of Simpson's good-subgroup condition for `T`** --- his
Lemma 5, restated as an image of the universal parameter set. -/
theorem Tsub_inf_Gsub_image (a b M N : ℤ) :
    Tsub ⊓ Gsub a b M N
      = twSub ((embIdx a b M N) '' (Set.univ : Set (ℤ × ℤ))) := by
  rw [Tsub_inf_Gsub, Set.image_univ, range_embIdx]

end MachineIndex
end BooneGroup
end GroupApproximation
