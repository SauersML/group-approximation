import GroupApproximation.Computability.DirectProductCode

/-!
# Effective syntax for intersection of benign witnesses

The semantic intersection construction puts two witness ambients side by side.
Its cutter is generated by the left and right copies of the two old cutters,
while each source mark is sent diagonally.  The Transport construction uses six
canonical source marks, so this module emits those six diagonal words directly.
-/

namespace GroupApproximation
namespace BenignInfCode

open PresentationCodes DirectProductCode RawTransformPrimrec

abbrev Raw : Type := DirectProductCode.Raw
abbrev WitnessSyntax : Type := PresentationCode × (List Raw × List Raw)
abbrev Input : Type := WitnessSyntax × WitnessSyntax
abbrev Output : Type := WitnessSyntax

def leftCode (x : Input) : PresentationCode := x.1.1
def rightCode (x : Input) : PresentationCode := x.2.1
def leftCutter (x : Input) : List Raw := x.1.2.1
def rightCutter (x : Input) : List Raw := x.2.2.1
def leftMarks (x : Input) : List Raw := x.1.2.2
def rightMarks (x : Input) : List Raw := x.2.2.2

def leftCuttingWords (x : Input) : List Raw :=
  (leftCutter x).map (leftWord (leftCode x))

def rightCuttingWords (x : Input) : List Raw :=
  (rightCutter x).map (rightWord (leftCode x) (rightCode x))

def diagonalAt (x : Input) (i : ℕ) : Raw :=
  leftWord (leftCode x) ((leftMarks x).getD i []) ++
    rightWord (leftCode x) (rightCode x) ((rightMarks x).getD i [])

def diagonalMarks (x : Input) : List Raw :=
  [diagonalAt x 0, diagonalAt x 1, diagonalAt x 2,
    diagonalAt x 3, diagonalAt x 4, diagonalAt x 5]

/-- The complete six-mark intersection-witness syntax transform. -/
def transform (x : Input) : Output :=
  (productCode (leftCode x) (rightCode x),
    (leftCuttingWords x ++ rightCuttingWords x, diagonalMarks x))

@[simp] theorem transform_code (x : Input) :
    (transform x).1 = productCode (leftCode x) (rightCode x) := rfl

@[simp] theorem transform_cutting (x : Input) :
    (transform x).2.1 = leftCuttingWords x ++ rightCuttingWords x := rfl

@[simp] theorem transform_marks (x : Input) :
    (transform x).2.2 = diagonalMarks x := rfl

theorem primrec_leftCode : Primrec leftCode := Primrec.fst.comp Primrec.fst
theorem primrec_rightCode : Primrec rightCode := Primrec.fst.comp Primrec.snd
theorem primrec_leftCutter : Primrec leftCutter :=
  (Primrec.fst.comp Primrec.snd).comp Primrec.fst
theorem primrec_rightCutter : Primrec rightCutter :=
  (Primrec.fst.comp Primrec.snd).comp Primrec.snd
theorem primrec_leftMarks : Primrec leftMarks :=
  (Primrec.snd.comp Primrec.snd).comp Primrec.fst
theorem primrec_rightMarks : Primrec rightMarks :=
  (Primrec.snd.comp Primrec.snd).comp Primrec.snd

theorem primrec_leftCuttingWord : Primrec
    (fun a : Input × Raw => leftWord (leftCode a.1) a.2) :=
  Primrec₂.comp primrec_leftWord
    (primrec_leftCode.comp Primrec.fst) Primrec.snd

theorem primrec_leftCuttingWords : Primrec leftCuttingWords :=
  Primrec.list_map primrec_leftCutter primrec_leftCuttingWord

def rightWordInput (a : Input × Raw) :
    (PresentationCode × PresentationCode) × Raw :=
  ((leftCode a.1, rightCode a.1), a.2)

theorem primrec_rightWordInput : Primrec rightWordInput :=
  Primrec.pair
    (Primrec.pair (primrec_leftCode.comp Primrec.fst)
      (primrec_rightCode.comp Primrec.fst)) Primrec.snd

def shiftedRightWord (a : Input × Raw) : Raw :=
  rightWord (rightWordInput a).1.1 (rightWordInput a).1.2
    (rightWordInput a).2

theorem primrec_shiftedRightWord : Primrec shiftedRightWord :=
  primrec_rightWord.comp primrec_rightWordInput

theorem primrec_rightCuttingWords : Primrec rightCuttingWords :=
  Primrec.list_map primrec_rightCutter primrec_shiftedRightWord

theorem primrec_leftMarkAt (i : ℕ) :
    Primrec (fun x : Input => (leftMarks x).getD i []) :=
  (Primrec.list_getD []).comp primrec_leftMarks (Primrec.const i)

theorem primrec_rightMarkAt (i : ℕ) :
    Primrec (fun x : Input => (rightMarks x).getD i []) :=
  (Primrec.list_getD []).comp primrec_rightMarks (Primrec.const i)

theorem primrec_diagonalAt (i : ℕ) :
    Primrec (fun x : Input => diagonalAt x i) := by
  have hleft : Primrec (fun x : Input =>
      leftWord (leftCode x) ((leftMarks x).getD i [])) :=
    Primrec₂.comp primrec_leftWord primrec_leftCode (primrec_leftMarkAt i)
  have hrightInput : Primrec (fun x : Input =>
      ((leftCode x, rightCode x), (rightMarks x).getD i [])) :=
    Primrec.pair (Primrec.pair primrec_leftCode primrec_rightCode)
      (primrec_rightMarkAt i)
  have hright : Primrec (fun x : Input =>
      rightWord (leftCode x) (rightCode x) ((rightMarks x).getD i [])) :=
    primrec_rightWord.comp hrightInput
  exact Primrec.list_append.comp hleft hright

theorem primrec_diagonalMarks : Primrec diagonalMarks :=
  Primrec.list_cons.comp (primrec_diagonalAt 0)
    (Primrec.list_cons.comp (primrec_diagonalAt 1)
      (Primrec.list_cons.comp (primrec_diagonalAt 2)
        (Primrec.list_cons.comp (primrec_diagonalAt 3)
          (Primrec.list_cons.comp (primrec_diagonalAt 4)
            (Primrec.list_cons.comp (primrec_diagonalAt 5)
              (Primrec.const []))))))

theorem primrec_transform : Primrec transform := by
  have hcode : Primrec (fun x : Input =>
      productCode (leftCode x) (rightCode x)) :=
    primrec_productCode.comp (Primrec.pair primrec_leftCode primrec_rightCode)
  have hcutter : Primrec (fun x : Input =>
      leftCuttingWords x ++ rightCuttingWords x) :=
    Primrec.list_append.comp primrec_leftCuttingWords primrec_rightCuttingWords
  exact Primrec.pair hcode (Primrec.pair hcutter primrec_diagonalMarks)

theorem computable_transform : Computable transform :=
  primrec_transform.to_comp

end BenignInfCode
end GroupApproximation
