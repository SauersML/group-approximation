import GroupApproximation.Computability.SemigroupWordProblemSimulation
import Mathlib.Algebra.PresentedMonoid.Basic

/-!
# The machine monoid, as a genuinely presented monoid

`SemigroupWordProblemSimulation` proves the machine simulation in terms of the
Thue equivalence generated by the rewriting rules.  This file identifies that
equivalence with equality in Mathlib's `PresentedMonoid`, so that the
simulation theorem becomes a statement about the *word problem of a finitely
presented monoid*, which is the object Markov--Post is about.

The two facts proved here are:

* `thueEquiv_iff_conGen` --- the Thue equivalence of the rewriting system is
  exactly the congruence generated by the defining relations.  One inclusion is
  the minimality of `conGen` (the Thue equivalence *is* a congruence, which is
  `ThueEquiv.mul`); the other rebuilds each congruence step from a rewrite.
* `halts_iff_presentedMonoid_eq` --- the simulation theorem restated in
  `PresentedMonoid`.

`FreeMonoid α` is by definition `List α` (`Mathlib/Algebra/FreeMonoid/Basic.lean`),
its multiplication is `List.append`, and `FreeMonoid.ofList`/`toList` are
`Equiv.refl`.  Words are therefore passed between the two types without an
explicit coercion; nothing here depends on that beyond definitional unfolding.
-/

namespace GroupApproximation
namespace SemigroupWordProblem

open Relation

section Presentation

variable {Γ Λ : Type}

/-- The defining relations of the machine monoid, as a relation on the free
monoid on the alphabet.  Reducible on purpose: `FreeMonoid` is a plain `def`
for `List`, and every unification below has to see through both. -/
abbrev machRels (M : Machine Γ Λ) :
    FreeMonoid (Letter Γ Λ) → FreeMonoid (Letter Γ Λ) → Prop :=
  fun p q => Rules ruleSp rulePre rulePost (ruleRhs M) p q

/-- The monoid presented by the Thue system of `M`: finitely many generators
(`Letter Γ Λ`, finite when `Γ` and `Λ` are) and finitely many defining
relations (`machine_rules_finite`). -/
abbrev MachineMonoid (M : Machine Γ Λ) : Type := PresentedMonoid (machRels M)

/-- The Thue equivalence, packaged as a congruence on the free monoid. -/
def thueCon (M : Machine Γ Λ) : Con (FreeMonoid (Letter Γ Λ)) where
  r := fun p q => ThueEquiv ruleSp rulePre rulePost (ruleRhs M) p q
  iseqv :=
    ⟨fun p => ThueEquiv.refl ruleSp rulePre rulePost (ruleRhs M) p,
     fun h => ThueEquiv.symm h,
     fun h₁ h₂ => ThueEquiv.trans h₁ h₂⟩
  mul' := fun h₁ h₂ => ThueEquiv.mul h₁ h₂

/-- One rewrite step is a congruence step. -/
theorem conGenRel_of_step (M : Machine Γ Λ) {u v : List (Letter Γ Λ)}
    (h : Step ruleSp rulePre rulePost (ruleRhs M) u v) :
    ConGen.Rel (machRels M) u v := by
  obtain ⟨i, x, y, hu, hv⟩ := h
  have hrule : machRels M (lhsWord ruleSp rulePre rulePost i) (ruleRhs M i) :=
    ⟨i, rfl, rfl⟩
  have hbase : ConGen.Rel (machRels M)
      (lhsWord ruleSp rulePre rulePost i) (ruleRhs M i) :=
    ConGen.Rel.of _ _ hrule
  -- The multiplication has to be the one of `FreeMonoid`, and a type ascription
  -- does not supply it: ascribing `x : FreeMonoid _` leaves a term whose
  -- inferred type is still `List _`, so `*` looks for `Mul (List _)` and finds
  -- nothing.  `FreeMonoid.ofList` (the identity equivalence) names the type.
  have hfull : ConGen.Rel (machRels M)
      (FreeMonoid.ofList x * FreeMonoid.ofList (lhsWord ruleSp rulePre rulePost i) *
          FreeMonoid.ofList y)
      (FreeMonoid.ofList x * FreeMonoid.ofList (ruleRhs M i) * FreeMonoid.ofList y) :=
    ConGen.Rel.mul (ConGen.Rel.mul (ConGen.Rel.refl _) hbase) (ConGen.Rel.refl _)
  subst hu
  subst hv
  exact hfull

/-- **The Thue equivalence is the congruence generated by the rules.**  This is
what makes the rewriting system a *presentation*. -/
theorem thueEquiv_iff_conGen (M : Machine Γ Λ) (u v : List (Letter Γ Λ)) :
    ThueEquiv ruleSp rulePre rulePost (ruleRhs M) u v ↔ conGen (machRels M) u v := by
  have hle : conGen (machRels M) ≤ thueCon M :=
    Con.conGen_le.2 fun p q hpq => by
      have hpq' : Rules ruleSp rulePre rulePost (ruleRhs M) p q := hpq
      exact Derives.toThueEquiv (Derives.single (step_of_rules hpq'))
  have key : ThueEquiv ruleSp rulePre rulePost (ruleRhs M) u v
      ↔ ConGen.Rel (machRels M) u v := by
    constructor
    · intro h
      induction h with
      | refl => exact ConGen.Rel.refl (FreeMonoid.ofList u)
      | tail hd hstep ih =>
          refine ConGen.Rel.trans ih ?_
          rcases hstep with hstep | hstep
          · exact conGenRel_of_step M hstep
          · exact ConGen.Rel.symm (conGenRel_of_step M hstep)
    · intro h
      exact @hle u v h
  exact key

/-- **The simulation theorem in the presented monoid.**  The machine halts from
`c` if and only if the word encoding `c` and the one-letter word `done` are
equal in the monoid presented by the rules of `M`.

This is the Markov--Post reduction in its final form.  It is unconditional and
both directions are proved.  What it does *not* say --- and what this
repository cannot yet say --- is that some machine in this model has an
undecidable halting problem; see the module docstring of
`SemigroupWordProblem.lean`. -/
theorem halts_iff_presentedMonoid_eq (M : Machine Γ Λ) (c : Cfg Γ Λ) :
    M.Halts c ↔
      PresentedMonoid.mk (machRels M) (encCfg M c)
        = PresentedMonoid.mk (machRels M) [Letter.done] :=
  (halts_iff_thueEquiv M c).trans
    ((thueEquiv_iff_conGen M (encCfg M c) [Letter.done]).trans
      PresentedMonoid.mk_eq_mk_iff.symm)

end Presentation

end SemigroupWordProblem
end GroupApproximation
