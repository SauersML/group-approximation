import GroupApproximation.Computability.CodedMicrostate
import GroupApproximation.Analysis.NaturalMatrixCoordinateEquiv

/-!
# Reindexing presentation microstates onto natural matrix dimensions

Arithmetic certificates use matrices indexed by `Fin d`, whereas the analytic
microstate normal form permits an arbitrary finite coordinate type.  This file
is the exact bridge: reindex a microstate along a finite equivalence and
preserve every word displacement on the nose.
-/

namespace GroupApproximation
namespace MFMicrostate
namespace Microstate

open PresentationCodes

variable {c : PresentationCode}

/-- Reindex a microstate's matrix coordinates along an equivalence. -/
noncomputable def reindex (M : Microstate c) (Y : FiniteModel)
    (e : M.model ≃ Y) : Microstate c where
  model := Y
  card_pos := by
    rw [Fintype.card_congr e.symm]
    exact M.card_pos
  gen := fun i ↦ unitaryReindexEquiv e (M.gen i)

/-- Reindexing commutes with the exact free-group homomorphism generated by a
microstate. -/
theorem reindex_hom (M : Microstate c) (Y : FiniteModel)
    (e : M.model ≃ Y)
    (x : FreeGroup (Fin (genCount c))) :
    (M.reindex Y e).hom x = unitaryReindexEquiv e (M.hom x) := by
  unfold reindex Microstate.hom
  have hhom : FreeGroup.lift (fun i ↦ unitaryReindexEquiv e (M.gen i)) =
      (unitaryReindexEquiv e).toMonoidHom.comp (FreeGroup.lift M.gen) := by
    apply FreeGroup.ext_hom
    intro i
    simp
  exact DFunLike.congr_fun hhom x

/-- Every free-word operator-norm displacement is invariant under coordinate
reindexing. -/
theorem reindex_flen (M : Microstate c) (Y : FiniteModel)
    (e : M.model ≃ Y)
    (x : FreeGroup (Fin (genCount c))) :
    (M.reindex Y e).flen x = M.flen x := by
  rw [flen, flen, reindex_hom]
  exact opLength_unitaryReindexEquiv e (M.hom x)

/-- Raw-word displacement is invariant under coordinate reindexing. -/
theorem reindex_len (M : Microstate c) (Y : FiniteModel)
    (e : M.model ≃ Y)
    (w : List (ℕ × Bool)) :
    (M.reindex Y e).len w = M.len w :=
  reindex_flen M Y e (wordOf c w)

/-- Put a microstate on the literal natural basis of the same cardinality. -/
noncomputable def naturalize (M : Microstate c) : Microstate c :=
  M.reindex (naturalFiniteModel (Fintype.card M.model))
    (Fintype.equivFin M.model)

theorem naturalize_len (M : Microstate c) (w : List (ℕ × Bool)) :
    M.naturalize.len w = M.len w :=
  reindex_len M (naturalFiniteModel (Fintype.card M.model))
    (Fintype.equivFin M.model) w

end Microstate
end MFMicrostate
end GroupApproximation
