import GroupApproximation.Computability.BenignSupCodeSubgroupSemantics

/-!
# Coded models for the two central layers of benign join

This file identifies the actual finite-presentation code used by
`BenignSupCode` with the two semantic central HNN layers in `BenignJoin`.
It stops before profinite closedness of the final cutter: the construction
here is purely the exact code/ambient transport shared by the special
TransportStar join.
-/

namespace GroupApproximation
namespace CodedProfiniteWitness
namespace Model

noncomputable section

open PresentationCodes BenignInfCodeSemantics BenignInfCodeSubgroupSemantics
open BenignSupCode BenignSupCodeSubgroupSemantics
open Higman

variable {G : Type} [Group G] {mark : MarkCount → G}
variable {H₁ H₂ : Subgroup G}

abbrev supInput (C₁ : Model mark H₁) (C₂ : Model mark H₂) :
    BenignSupCode.Input :=
  (C₁.coded, C₂.coded)

/-- The literal direct-product presentation underlying a coded join. -/
def supBaseEquiv (C₁ : Model mark H₁) (C₂ : Model mark H₂) :
    Carrier (productBase (supInput C₁ C₂)) ≃*
      Higman.JoinBase C₁.data.witness C₂.data.witness :=
  (DirectProductCodeSemantics.productCodeEquiv C₁.coded.1 C₂.coded.1).trans
    (prodEquiv C₁.ambientEquiv C₂.ambientEquiv)

/-- The first emitted centralizer list names `L₁ × ⊤` exactly. -/
theorem sup_m1_cutter_eq (C₁ : Model mark H₁) (C₂ : Model mark H₂) :
    (wordSubgroup (productBase (supInput C₁ C₂))
        (m1Words (supInput C₁ C₂))).map
        (supBaseEquiv C₁ C₂).toMonoidHom =
      Higman.joinM₁ C₁.data.witness C₂.data.witness := by
  let y : BenignInfCode.Input :=
    (C₁.coded,
      (C₂.coded.1,
        (generatorWords C₂.coded.1, C₂.coded.2.2)))
  have h := map_wordSubgroup_transform_cutting y
  change
    (wordSubgroup (productBase (supInput C₁ C₂))
      (m1Words (supInput C₁ C₂))).map
        (DirectProductCodeSemantics.productCodeEquiv
          C₁.coded.1 C₂.coded.1).toMonoidHom =
      (wordSubgroup C₁.coded.1 C₁.coded.2.1).prod
        (wordSubgroup C₂.coded.1 (generatorWords C₂.coded.1)) at h
  change
    (wordSubgroup (productBase (supInput C₁ C₂))
      (m1Words (supInput C₁ C₂))).map
        ((prodEquiv C₁.ambientEquiv C₂.ambientEquiv).toMonoidHom.comp
          (DirectProductCodeSemantics.productCodeEquiv
            C₁.coded.1 C₂.coded.1).toMonoidHom) = _
  rw [← Subgroup.map_map, h, map_prodEquiv, C₁.cutter_eq,
    wordSubgroup_generatorWords_top,
    Subgroup.map_top_of_surjective _ C₂.ambientEquiv.surjective]
  rfl

/-- Before its old-base lift, the second emitted centralizer list names
`⊤ × L₂` exactly in the product base. -/
theorem sup_m2Base_cutter_eq
    (C₁ : Model mark H₁) (C₂ : Model mark H₂) :
    (wordSubgroup (productBase (supInput C₁ C₂))
        (m2BaseWords (supInput C₁ C₂))).map
        (supBaseEquiv C₁ C₂).toMonoidHom =
      Higman.joinM₂ C₁.data.witness C₂.data.witness := by
  let y : BenignInfCode.Input :=
    ((C₁.coded.1,
        (generatorWords C₁.coded.1, C₁.coded.2.2)),
      C₂.coded)
  have h := map_wordSubgroup_transform_cutting y
  change
    (wordSubgroup (productBase (supInput C₁ C₂))
      (m2BaseWords (supInput C₁ C₂))).map
        (DirectProductCodeSemantics.productCodeEquiv
          C₁.coded.1 C₂.coded.1).toMonoidHom =
      (wordSubgroup C₁.coded.1 (generatorWords C₁.coded.1)).prod
        (wordSubgroup C₂.coded.1 C₂.coded.2.1) at h
  change
    (wordSubgroup (productBase (supInput C₁ C₂))
      (m2BaseWords (supInput C₁ C₂))).map
        ((prodEquiv C₁.ambientEquiv C₂.ambientEquiv).toMonoidHom.comp
          (DirectProductCodeSemantics.productCodeEquiv
            C₁.coded.1 C₂.coded.1).toMonoidHom) = _
  rw [← Subgroup.map_map, h, map_prodEquiv,
    wordSubgroup_generatorWords_top,
    Subgroup.map_top_of_surjective _ C₁.ambientEquiv.surjective,
    C₂.cutter_eq]
  rfl

/-- Mapping a subgroup generated by explicitly lifted old words through a
transported central layer gives the old subgroup mapped through the semantic
base inclusion. -/
theorem map_wordSubgroup_centralLift {K : Type} [Group K]
    (c : PresentationCode) (centralWords baseWords : List BenignSupCode.Raw)
    (e : Carrier c ≃* K) (L : Subgroup K)
    (hL : (wordSubgroup c centralWords).map e.toMonoidHom = L) :
    (wordSubgroup (Higman.MikhailovaRopeCode.firstStageCode c centralWords)
        (baseWords.map (DirectProductCode.leftWord c))).map
        (centralStageEquiv c centralWords e L hL).toMonoidHom =
      (wordSubgroup c baseWords).map
        ((HNNExtension.of : K →* CentHNN L).comp e.toMonoidHom) := by
  apply le_antisymm
  · rintro z ⟨x, hx, rfl⟩
    refine Subgroup.closure_induction
      (p := fun y _ ↦
        centralStageEquiv c centralWords e L hL y ∈
          (wordSubgroup c baseWords).map
            ((HNNExtension.of : K →* CentHNN L).comp e.toMonoidHom))
      ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨u, hu, rfl⟩
      obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hu
      rw [centralStageEquiv_oldWord]
      exact ⟨evalWord c w, evalWord_mem_wordSubgroup c baseWords hw, rfl⟩
    · simp
    · intro a b _ _ ha hb
      simpa using Subgroup.mul_mem _ ha hb
    · intro a _ ha
      simpa using Subgroup.inv_mem _ ha
  · rintro z ⟨x, hx, rfl⟩
    refine Subgroup.closure_induction
      (p := fun y _ ↦
        ((HNNExtension.of : K →* CentHNN L).comp e.toMonoidHom) y ∈
          (wordSubgroup
            (Higman.MikhailovaRopeCode.firstStageCode c centralWords)
            (baseWords.map (DirectProductCode.leftWord c))).map
              (centralStageEquiv c centralWords e L hL).toMonoidHom)
      ?_ ?_ ?_ ?_ hx
    · rintro _ ⟨w, hw, rfl⟩
      refine ⟨evalWord
        (Higman.MikhailovaRopeCode.firstStageCode c centralWords)
        (DirectProductCode.leftWord c w), ?_, ?_⟩
      · exact evalWord_mem_wordSubgroup _ _
          (List.mem_map.mpr ⟨w, hw, rfl⟩)
      · exact centralStageEquiv_oldWord c centralWords e L hL w
    · simp
    · intro a b _ _ ha hb
      simpa using Subgroup.mul_mem _ ha hb
    · intro a _ ha
      simpa using Subgroup.inv_mem _ ha

/-- The first HNN code is exactly the semantic first join layer. -/
def supLevel1Equiv (C₁ : Model mark H₁) (C₂ : Model mark H₂) :
    Carrier (level1 (supInput C₁ C₂)) ≃*
      Higman.JoinLevel1 C₁.data.witness C₂.data.witness :=
  centralStageEquiv _ _ (supBaseEquiv C₁ C₂) _
    (sup_m1_cutter_eq C₁ C₂)

/-- The lifted second centralizer list names the semantic transported
subgroup `joinM₂'`. -/
theorem sup_m2_cutter_eq
    (C₁ : Model mark H₁) (C₂ : Model mark H₂) :
    (wordSubgroup (level1 (supInput C₁ C₂))
        (m2Words (supInput C₁ C₂))).map
        (supLevel1Equiv C₁ C₂).toMonoidHom =
      Higman.joinM₂' C₁.data.witness C₂.data.witness := by
  change
    (wordSubgroup
      (Higman.MikhailovaRopeCode.firstStageCode
        (productBase (supInput C₁ C₂)) (m1Words (supInput C₁ C₂)))
      ((m2BaseWords (supInput C₁ C₂)).map
        (DirectProductCode.leftWord (productBase (supInput C₁ C₂))))).map
        (centralStageEquiv
          (productBase (supInput C₁ C₂)) (m1Words (supInput C₁ C₂))
          (supBaseEquiv C₁ C₂)
          (Higman.joinM₁ C₁.data.witness C₂.data.witness)
          (sup_m1_cutter_eq C₁ C₂)).toMonoidHom = _
  rw [map_wordSubgroup_centralLift]
  change
    (wordSubgroup (productBase (supInput C₁ C₂))
      (m2BaseWords (supInput C₁ C₂))).map
        ((HNNExtension.of :
          Higman.JoinBase C₁.data.witness C₂.data.witness →*
            Higman.JoinLevel1 C₁.data.witness C₂.data.witness).comp
          (supBaseEquiv C₁ C₂).toMonoidHom) = _
  rw [← Subgroup.map_map, sup_m2Base_cutter_eq]
  rfl

/-- The second HNN code is exactly the semantic second join layer. -/
def supLevel2Equiv (C₁ : Model mark H₁) (C₂ : Model mark H₂) :
    Carrier (level2 (supInput C₁ C₂)) ≃*
      Higman.JoinLevel2 C₁.data.witness C₂.data.witness :=
  centralStageEquiv _ _ (supLevel1Equiv C₁ C₂) _
    (sup_m2_cutter_eq C₁ C₂)

end

end Model
end CodedProfiniteWitness
end GroupApproximation
