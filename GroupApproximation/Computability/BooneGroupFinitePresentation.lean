import GroupApproximation.Algebra.HNNFinitePresentation
import GroupApproximation.Computability.BooneGroupTower
import GroupApproximation.Computability.BooneGroupPresentation
import GroupApproximation.Computability.BooneGroupGoodness

/-!
# S8: the tower of a modular machine is finitely presented

Item **S8** of the roadmap in `Computability.BooneGroupBase`, and with
`Algebra.HNNFinitePresentation` in hand it is an induction along the fold
rather than the five-hundred-line item that entry estimated.

Three things are needed and all three are here.

* **The base is presented.**  `BooneGroupPresentation.presentedEquiv` identifies
  `BaseGroup` with `PresentedGroup rels` on three generators and one relator,
  and Mathlib makes such a group finitely presented.  This is the only place
  S2c is used, which is what that entry predicted.
* **The associated subgroups are finitely generated.**  `Gsub a b M N` is
  `⟨t(a,b), x^M, y^N⟩` by `Gsub_eq_closure`, so it is generated by three
  elements, and its image under any `ι` by their images.
* **The halting subgroup of the tower is finitely generated.**  This is the one
  that could have failed: `⟨t⟩'` is *not* finitely generated in the base group
  --- it is free of infinite rank there.  It becomes finitely generated in the
  tower because each stage adds exactly one generator, the stable letter:
  `liftedSubgroup φ A = ⟨of '' A, t⟩`, so a generating set of `A` together with
  `t` generates it, and a machine's identification list is finite.
-/

namespace GroupApproximation
namespace BooneGroup

open Base

/-! ## Images of finitely generated subgroups -/

theorem Subgroup_FG_map {G H : Type*} [Group G] [Group H] {A : Subgroup G}
    (hA : A.FG) (f : G →* H) : (A.map f).FG := by
  obtain ⟨X, hX, hXfinite⟩ := (Subgroup.fg_iff _).mp hA
  rw [Subgroup.fg_iff]
  exact ⟨f '' X, by rw [← hX, MonoidHom.map_closure], hXfinite.image _⟩

/-! ## The base group is finitely presented -/

instance : Finite rels :=
  Set.Finite.to_subtype (by rw [rels]; exact Set.finite_singleton _)

instance baseGroup_isFinitelyPresented : Group.IsFinitelyPresented BaseGroup :=
  Group.IsFinitelyPresented.equiv presentedEquiv

/-! ## The associated subgroups of the machine stages -/

theorem Gsub_fg (a b M N : ℤ) : (Gsub a b M N).FG := by
  rw [Subgroup.fg_iff]
  refine ⟨{tw (a, b), sh (M, 0), sh (0, N)}, (Gsub_eq_closure a b M N).symm, ?_⟩
  exact ((Set.finite_singleton _).insert _).insert _

/-! ## One stage adds one generator -/

section Lifted

variable {G : Type} [Group G] {Asub Bsub : Subgroup G} (φ : Asub ≃* Bsub)

/-- **The step that makes S8 possible.**  Simpson's `A'` is generated by a
generating set of `A` together with the stable letter, so it is finitely
generated whenever `A` is: each stage of the tower costs exactly one new
generator. -/
theorem liftedSubgroup_fg {A : Subgroup G} (hA : A.FG) :
    (liftedSubgroup φ A).FG := by
  obtain ⟨X, hXclosure, hXfinite⟩ := (Subgroup.fg_iff _).mp hA
  rw [Subgroup.fg_iff]
  refine ⟨(HNNExtension.of : G →* HNNExtension G Asub Bsub φ) '' X ∪ {HNNExtension.t},
    ?_, (hXfinite.image _).union (Set.finite_singleton _)⟩
  rw [liftedSubgroup, Subgroup.closure_union, Subgroup.closure_union]
  congr 1
  rw [show ((HNNExtension.of : G →* HNNExtension G Asub Bsub φ) '' (A : Set G))
      = ((A.map (HNNExtension.of : G →* HNNExtension G Asub Bsub φ)) : Set _) from rfl,
    Subgroup.closure_eq, ← hXclosure, MonoidHom.map_closure]

end Lifted

/-! ## The halting subgroup of the tower -/

/-- `⟨t⟩'` is finitely generated in the tower, though not in the base group. -/
theorem towerTSub_fg : ∀ l : List Identification, (towerTSub l).FG
  | [] => by
      rw [towerTSub, Subgroup.fg_iff]
      exact ⟨{tGen}, rfl, Set.finite_singleton _⟩
  | ⟨_, _, ψ⟩ :: l => by
      rw [towerTSub]
      exact liftedSubgroup_fg _ (towerTSub_fg l)

/-! ## Every stage is finitely presented -/

/-- Along a list whose identifications have finitely generated sources, every
stage of the tower is finitely presented: the base by S2c, and each step by the
HNN permanence theorem. -/
theorem tower_isFinitelyPresented :
    ∀ (l : List Identification), (∀ x ∈ l, (x.1).FG) →
      Group.IsFinitelyPresented (tower l).Carrier
  | [], _ => by
      rw [tower]
      exact baseGroup_isFinitelyPresented
  | ⟨A, B, ψ⟩ :: l, h => by
      haveI := tower_isFinitelyPresented l
        (fun x hx => h x (List.mem_cons_of_mem _ hx))
      haveI : Group.FG (A.map (tower l).ι) :=
        (Group.fg_iff_subgroup_fg _).mpr
          (Subgroup_FG_map (h ⟨A, B, ψ⟩ (List.mem_cons_self ..)) _)
      rw [tower]
      exact HNNFinitePresentation.isFinitelyPresented_hnnExtension _

/-! ## The machine's own tower, and its final group -/

/-- Every identification a machine contributes has a finitely generated source:
both directions of a quadruple start from `G_{ab}^{MM}`. -/
theorem machineIdentifications_fg (mm : ModularMachine) (hM : (mm.size : ℤ) ≠ 0) :
    ∀ x ∈ machineIdentifications mm hM, (x.1).FG := by
  intro x hx
  rw [machineIdentifications, List.mem_filterMap] at hx
  obtain ⟨p, -, hp⟩ := hx
  rcases hq : mm.quad p.1 p.2 with _ | q
  · rw [hq] at hp
    simp at hp
  · rw [hq] at hp
    simp only [Option.map_some] at hp
    have hx' := (Option.some.inj hp).symm
    cases hb : q.2 <;> rw [hb] at hx' <;> subst hx' <;>
      simp only [quadIdentification, quadIdentificationLeft, cond_true, cond_false] <;>
      exact Gsub_fg _ _ _ _

/-- **S8.**  The final group of a modular machine's tower --- Simpson's `G_M`,
the tower with `k` adjoined --- is finitely presented. -/
theorem finalGroup_isFinitelyPresented (mm : ModularMachine) (hM : (mm.size : ℤ) ≠ 0) :
    Group.IsFinitelyPresented (FinalGroup mm hM) := by
  haveI := tower_isFinitelyPresented _ (machineIdentifications_fg mm hM)
  haveI : Group.FG (towerTSub (machineIdentifications mm hM)) :=
    (Group.fg_iff_subgroup_fg _).mpr (towerTSub_fg _)
  exact HNNFinitePresentation.isFinitelyPresented_hnnExtension _

end BooneGroup
end GroupApproximation
