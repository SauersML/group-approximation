/-!
# Sub-basis subgroups of a free group

Second module of the Novikov--Boone chain; see
`GroupApproximation.Computability.BooneGroupModularMachine` for the route
(Aanderaa--Cohen modular machines, in Simpson's writeup) and for the manuscript
anchors.

The base group of the Aanderaa--Cohen construction is `G = ⟨t, x, y | xy = yx⟩`,
and the whole argument is carried by the normal closure `T = ⟨⟨t⟩⟩`, which is
**free on the family `t(α,β) = x^{-α} y^{-β} t x^{α} y^{β}`, indexed by
`ℤ × ℤ`** (Simpson, the sentence "Note that the subgroup `T = ⟨t(α,β) | α,β ∈ ℤ⟩`
is free on these generators").  Every subgroup of `T` that occurs in the
construction --- `T_{ab}^{MN}` (Simpson, before Lemma 5) and `T_M` (Simpson,
after Definition 6) --- is the subgroup generated by a **subset of that free
basis**.

This module isolates the three facts about such subgroups that the construction
uses, for an arbitrary free group and an arbitrary index set:

* `of_mem_basisSubgroup_iff` --- a basis element lies in the subgroup generated
  by a sub-basis exactly when it lies in the sub-basis.  This is what turns
  `t(α,β) ∈ T_M` back into `(α,β) ∈ H_M` in the last line of Simpson's
  Theorem 8.
* `basisSubgroup_inf` --- sub-basis subgroups intersect as their index sets do.
  This is what reduces the *good subgroup* verifications (Simpson's Definition 2
  applied to `T` and to `T_M`) to statements about index sets.
* `map_basisSubgroup` --- and how they transport along a relabelling of the
  index set, which is how the associated isomorphisms `φᵢ`, `ψⱼ` of Simpson's
  Definition 6 act.

All of it runs off one construction: the retraction `retract S` that fixes the
basis elements in `S` and kills the rest.  Nothing here is specific to
Novikov--Boone.
-/

namespace GroupApproximation
namespace BooneGroup
namespace FreeBasis

universe u v w

variable {ι : Type u} {κ : Type v} {μ : Type w}

/-! ## The subgroup generated by a sub-basis -/

/-- The subgroup of `FreeGroup ι` generated by the basis elements indexed by
`S`. -/
def basisSubgroup (S : Set ι) : Subgroup (FreeGroup ι) :=
  Subgroup.closure (FreeGroup.of '' S)

theorem of_mem_basisSubgroup {S : Set ι} {a : ι} (ha : a ∈ S) :
    FreeGroup.of a ∈ basisSubgroup S :=
  Subgroup.subset_closure ⟨a, ha, rfl⟩

theorem basisSubgroup_mono {S T : Set ι} (h : S ⊆ T) :
    basisSubgroup S ≤ basisSubgroup T :=
  Subgroup.closure_mono (Set.image_mono h)

/-- A free basis element is never trivial. -/
theorem of_ne_one (a : ι) : (FreeGroup.of a : FreeGroup ι) ≠ 1 := by
  intro h
  have hmap :
      (FreeGroup.lift fun _ : ι => Multiplicative.ofAdd (1 : ℤ))
          (FreeGroup.of a)
        = (FreeGroup.lift fun _ : ι => Multiplicative.ofAdd (1 : ℤ)) 1 :=
    congrArg _ h
  -- `rw [map_one]` would match `Multiplicative.ofAdd 1` first, and `ofAdd` is an
  -- `Equiv`, not a monoid hom; let `simp` handle both sides instead.
  rw [FreeGroup.lift_apply_of] at hmap
  simp at hmap

/-! ## The retraction onto a sub-basis -/

open Classical in
/-- The retraction of a free group onto the subgroup generated by a sub-basis:
it fixes the basis elements indexed by `S` and kills all the others. -/
noncomputable def retract (S : Set ι) : FreeGroup ι →* FreeGroup ι :=
  FreeGroup.lift fun a => if a ∈ S then FreeGroup.of a else 1

theorem retract_of_mem {S : Set ι} {a : ι} (ha : a ∈ S) :
    retract S (FreeGroup.of a) = FreeGroup.of a := by
  simp only [retract, FreeGroup.lift_apply_of]
  rw [if_pos ha]

theorem retract_of_not_mem {S : Set ι} {a : ι} (ha : a ∉ S) :
    retract S (FreeGroup.of a) = 1 := by
  simp only [retract, FreeGroup.lift_apply_of]
  rw [if_neg ha]

/-- The retraction is the identity on the subgroup it retracts onto. -/
theorem retract_eq_self {S : Set ι} {w : FreeGroup ι}
    (hw : w ∈ basisSubgroup S) : retract S w = w := by
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact retract_of_mem ha
  | one => exact map_one _
  | mul x y _ _ hx hy => rw [map_mul, hx, hy]
  | inv x _ hx => rw [map_inv, hx]

/-- The retraction along `S` carries the sub-basis subgroup of `T` into the
sub-basis subgroup of `S ∩ T`. -/
theorem retract_mem_inter {S T : Set ι} {w : FreeGroup ι}
    (hw : w ∈ basisSubgroup T) : retract S w ∈ basisSubgroup (S ∩ T) := by
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      by_cases hS : a ∈ S
      · rw [retract_of_mem hS]
        exact of_mem_basisSubgroup ⟨hS, ha⟩
      · rw [retract_of_not_mem hS]
        exact one_mem _
  | one => rw [map_one]; exact one_mem _
  | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  | inv x _ hx => rw [map_inv]; exact inv_mem hx

/-! ## The three consequences -/

/-- **A basis element lies in a sub-basis subgroup exactly when its index
does.**  This is the step "`t(α,β) ∈ T_M ⟺ (α,β) ∈ H_M`" of Simpson's
Theorem 8. -/
theorem of_mem_basisSubgroup_iff {S : Set ι} {a : ι} :
    FreeGroup.of a ∈ basisSubgroup S ↔ a ∈ S := by
  refine ⟨fun h => ?_, of_mem_basisSubgroup⟩
  by_contra ha
  have h1 : retract S (FreeGroup.of a) = 1 := retract_of_not_mem ha
  have h2 : retract S (FreeGroup.of a) = FreeGroup.of a := retract_eq_self h
  exact of_ne_one a (h2.symm.trans h1)

/-- **Sub-basis subgroups intersect as their index sets do.**  This is what
makes the *good subgroup* verifications of Simpson's Definition 2 purely
combinatorial. -/
theorem basisSubgroup_inf (S T : Set ι) :
    basisSubgroup S ⊓ basisSubgroup T = basisSubgroup (S ∩ T) := by
  refine le_antisymm ?_ ?_
  · intro w hw
    rw [Subgroup.mem_inf] at hw
    obtain ⟨hS, hT⟩ := hw
    have h1 : retract S w = w := retract_eq_self hS
    have h2 : retract S w ∈ basisSubgroup (S ∩ T) := retract_mem_inter hT
    rwa [h1] at h2
  · exact le_inf (basisSubgroup_mono Set.inter_subset_left)
      (basisSubgroup_mono Set.inter_subset_right)

/-! ## Relabelling the index set -/

/-- The homomorphism of free groups induced by a map of index sets. -/
def indexMap (f : ι → κ) : FreeGroup ι →* FreeGroup κ :=
  FreeGroup.lift (fun a => FreeGroup.of (f a))

@[simp] theorem indexMap_of (f : ι → κ) (a : ι) :
    indexMap f (FreeGroup.of a) = FreeGroup.of (f a) :=
  FreeGroup.lift_apply_of

theorem indexMap_congr {f g : ι → κ} (h : ∀ a, f a = g a) (w : FreeGroup ι) :
    indexMap f w = indexMap g w := by
  refine FreeGroup.induction_on w ?_ ?_ ?_ ?_
  · rw [map_one, map_one]
  · intro a
    rw [indexMap_of, indexMap_of, h a]
  · intro a _
    rw [map_inv, map_inv, indexMap_of, indexMap_of, h a]
  · intro a b ha hb
    rw [map_mul, map_mul, ha, hb]

theorem indexMap_id (w : FreeGroup ι) : indexMap (fun a : ι => a) w = w := by
  refine FreeGroup.induction_on w ?_ ?_ ?_ ?_
  · rw [map_one]
  · intro a
    rw [indexMap_of]
  · intro a _
    rw [map_inv, indexMap_of]
  · intro a b ha hb
    rw [map_mul, ha, hb]

theorem indexMap_indexMap (f : ι → κ) (g : κ → μ) (w : FreeGroup ι) :
    indexMap g (indexMap f w) = indexMap (fun a => g (f a)) w := by
  refine FreeGroup.induction_on w ?_ ?_ ?_ ?_
  · rw [map_one, map_one, map_one]
  · intro a
    rw [indexMap_of, indexMap_of, indexMap_of]
  · intro a _
    rw [map_inv, map_inv, map_inv, indexMap_of, indexMap_of, indexMap_of]
  · intro a b ha hb
    rw [map_mul, map_mul, map_mul, ha, hb]

/-- A left inverse of the index map induces a left inverse of the free-group
map. -/
theorem indexMap_leftInverse {f : ι → κ} {g : κ → ι}
    (h : Function.LeftInverse g f) (w : FreeGroup ι) :
    indexMap g (indexMap f w) = w := by
  have h1 : indexMap g (indexMap f w) = indexMap (fun a : ι => g (f a)) w :=
    indexMap_indexMap f g w
  have h2 : indexMap (fun a : ι => g (f a)) w = indexMap (fun a : ι => a) w :=
    indexMap_congr (f := fun a : ι => g (f a)) (g := fun a : ι => a)
      (fun a => h a) w
  rw [h1, h2, indexMap_id]

theorem indexMap_injective {f : ι → κ} {g : κ → ι}
    (h : Function.LeftInverse g f) : Function.Injective (indexMap f) := by
  intro w₁ w₂ hw
  have h1 : indexMap g (indexMap f w₁) = indexMap g (indexMap f w₂) :=
    congrArg _ hw
  rwa [indexMap_leftInverse h, indexMap_leftInverse h] at h1

/-- **Sub-basis subgroups transport along relabellings.**  This is how the
associated isomorphisms `φᵢ`, `ψⱼ` of Simpson's Definition 6 act on the free
part of the base group. -/
theorem map_basisSubgroup (f : ι → κ) (S : Set ι) :
    (basisSubgroup S).map (indexMap f) = basisSubgroup (f '' S) := by
  refine le_antisymm ?_ ?_
  · intro w hw
    rw [Subgroup.mem_map] at hw
    obtain ⟨v, hv, rfl⟩ := hw
    induction hv using Subgroup.closure_induction with
    | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        rw [indexMap_of]
        exact of_mem_basisSubgroup ⟨a, ha, rfl⟩
    | one => rw [map_one]; exact one_mem _
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
    | inv x _ hx => rw [map_inv]; exact inv_mem hx
  · refine (Subgroup.closure_le _).2 ?_
    rintro w ⟨b, ⟨a, ha, rfl⟩, rfl⟩
    exact Subgroup.mem_map.2
      ⟨FreeGroup.of a, of_mem_basisSubgroup ha, indexMap_of f a⟩

/-- Two composites of index maps that agree pointwise induce the same map. -/
theorem indexMap_comp_congr {f₁ f₂ g₁ g₂ : ι → ι}
    (h : ∀ p, f₁ (f₂ p) = g₁ (g₂ p)) (w : FreeGroup ι) :
    indexMap f₁ (indexMap f₂ w) = indexMap g₁ (indexMap g₂ w) := by
  rw [indexMap_indexMap, indexMap_indexMap]
  exact indexMap_congr h w

/-- The whole basis generates. -/
theorem basisSubgroup_univ : basisSubgroup (Set.univ : Set ι) = ⊤ := by
  refine eq_top_iff.2 fun w _ => ?_
  refine FreeGroup.induction_on w ?_ ?_ ?_ ?_
  · exact one_mem _
  · intro a
    exact of_mem_basisSubgroup (Set.mem_univ a)
  · intro a _
    exact inv_mem (of_mem_basisSubgroup (Set.mem_univ a))
  · intro x y hx hy
    exact mul_mem hx hy

/-- The range of a relabelling map is the sub-basis subgroup on the range of
the relabelling. -/
theorem range_indexMap (f : ι → κ) :
    (indexMap f).range = basisSubgroup (Set.range f) := by
  have h1 : (indexMap f).range = (⊤ : Subgroup (FreeGroup ι)).map (indexMap f) :=
    MonoidHom.range_eq_map _
  rw [h1, ← basisSubgroup_univ (ι := ι), map_basisSubgroup, Set.image_univ]

end FreeBasis
end BooneGroup
end GroupApproximation
