import GroupApproximation.Computability.BenignInfCodeSemantics

/-!
# Cutter-subgroup semantics of the effective benign intersection

The pointwise word formulas imply the exact subgroup statement: under the
concrete product-code equivalence, the subgroup generated by the transformed
left and right cutter lists is the product of the two original cutter
subgroups.
-/

namespace GroupApproximation
namespace BenignInfCodeSubgroupSemantics

open PresentationCodes
open BenignInfCode BenignInfCodeSemantics

/-- The subgroup generated by evaluation of a finite raw-word list. -/
def wordSubgroup (c : PresentationCode) (words : List Raw) : Subgroup (Carrier c) :=
  Subgroup.closure {g | ∃ w ∈ words, evalWord c w = g}

theorem evalWord_mem_wordSubgroup (c : PresentationCode) (words : List Raw)
    {w : Raw} (hw : w ∈ words) : evalWord c w ∈ wordSubgroup c words :=
  Subgroup.subset_closure ⟨w, hw, rfl⟩

/-- The entire computed cutter subgroup is exactly the product of the input
cutter subgroups. -/
theorem map_wordSubgroup_transform_cutting (x : Input) :
    (wordSubgroup
        (DirectProductCode.productCode (leftCode x) (rightCode x))
        (leftCuttingWords x ++ rightCuttingWords x)).map
        (DirectProductCodeSemantics.productCodeEquiv
          (leftCode x) (rightCode x)).toMonoidHom =
      (wordSubgroup (leftCode x) (leftCutter x)).prod
        (wordSubgroup (rightCode x) (rightCutter x)) := by
  let e := DirectProductCodeSemantics.productCodeEquiv
    (leftCode x) (rightCode x)
  apply le_antisymm
  · rintro z ⟨g, hg, rfl⟩
    refine Subgroup.closure_induction
      (p := fun g _ => e g ∈
        (wordSubgroup (leftCode x) (leftCutter x)).prod
          (wordSubgroup (rightCode x) (rightCutter x))) ?_ ?_ ?_ ?_ hg
    · rintro g ⟨u, hu, rfl⟩
      change u ∈ leftCuttingWords x ++ rightCuttingWords x at hu
      rcases List.mem_append.mp hu with hu | hu
      · obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hu
        change DirectProductCodeSemantics.productCodeEquiv
            (leftCode x) (rightCode x)
            (evalWord (DirectProductCode.productCode (leftCode x) (rightCode x))
              (DirectProductCode.leftWord (leftCode x) w)) ∈ _
        rw [productCodeEquiv_eval_leftWord]
        exact Subgroup.mem_prod.mpr
          ⟨evalWord_mem_wordSubgroup _ _ hw, Subgroup.one_mem _⟩
      · obtain ⟨w, hw, rfl⟩ := List.mem_map.mp hu
        change DirectProductCodeSemantics.productCodeEquiv
            (leftCode x) (rightCode x)
            (evalWord (DirectProductCode.productCode (leftCode x) (rightCode x))
              (DirectProductCode.rightWord (leftCode x) (rightCode x) w)) ∈ _
        rw [productCodeEquiv_eval_rightWord]
        exact Subgroup.mem_prod.mpr
          ⟨Subgroup.one_mem _, evalWord_mem_wordSubgroup _ _ hw⟩
    · rw [map_one]
      exact Subgroup.one_mem _
    · intro a b _ _ ha hb
      rw [map_mul]
      exact Subgroup.mul_mem _ ha hb
    · intro a _ ha
      rw [map_inv]
      exact Subgroup.inv_mem _ ha
  · intro z hz
    obtain ⟨hzl, hzr⟩ := Subgroup.mem_prod.mp hz
    have hleft : ∀ a ∈ wordSubgroup (leftCode x) (leftCutter x),
        (a, 1) ∈ (wordSubgroup
          (DirectProductCode.productCode (leftCode x) (rightCode x))
          (leftCuttingWords x ++ rightCuttingWords x)).map e.toMonoidHom := by
      intro a ha
      refine Subgroup.closure_induction
        (p := fun a _ => (a, 1) ∈
          (wordSubgroup
            (DirectProductCode.productCode (leftCode x) (rightCode x))
            (leftCuttingWords x ++ rightCuttingWords x)).map e.toMonoidHom)
        ?_ ?_ ?_ ?_ ha
      · rintro a ⟨w, hw, rfl⟩
        obtain ⟨u, hu, heval⟩ := exists_leftCuttingWord x hw
        refine Subgroup.mem_map.mpr ⟨evalWord
          (DirectProductCode.productCode (leftCode x) (rightCode x)) u, ?_, ?_⟩
        · exact evalWord_mem_wordSubgroup _ _
            (List.mem_append_left _ hu)
        · exact heval
      · exact Subgroup.one_mem _
      · intro a b _ _ ha hb
        simpa using Subgroup.mul_mem _ ha hb
      · intro a _ ha
        simpa using Subgroup.inv_mem _ ha
    have hright : ∀ b ∈ wordSubgroup (rightCode x) (rightCutter x),
        (1, b) ∈ (wordSubgroup
          (DirectProductCode.productCode (leftCode x) (rightCode x))
          (leftCuttingWords x ++ rightCuttingWords x)).map e.toMonoidHom := by
      intro b hb
      refine Subgroup.closure_induction
        (p := fun b _ => (1, b) ∈
          (wordSubgroup
            (DirectProductCode.productCode (leftCode x) (rightCode x))
            (leftCuttingWords x ++ rightCuttingWords x)).map e.toMonoidHom)
        ?_ ?_ ?_ ?_ hb
      · rintro b ⟨w, hw, rfl⟩
        obtain ⟨u, hu, heval⟩ := exists_rightCuttingWord x hw
        refine Subgroup.mem_map.mpr ⟨evalWord
          (DirectProductCode.productCode (leftCode x) (rightCode x)) u, ?_, ?_⟩
        · exact evalWord_mem_wordSubgroup _ _
            (List.mem_append_right _ hu)
        · exact heval
      · exact Subgroup.one_mem _
      · intro a b _ _ ha hb
        simpa using Subgroup.mul_mem _ ha hb
      · intro a _ ha
        simpa using Subgroup.inv_mem _ ha
    have hmul := Subgroup.mul_mem _ (hleft z.1 hzl) (hright z.2 hzr)
    simpa using hmul

end BenignInfCodeSubgroupSemantics
end GroupApproximation
