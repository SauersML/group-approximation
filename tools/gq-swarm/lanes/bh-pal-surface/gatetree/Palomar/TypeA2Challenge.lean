import Mathlib.Algebra.Group.Action.End
import Mathlib.Algebra.Group.Action.Prod
import Mathlib.GroupTheory.FinitelyPresentedGroup
import Mathlib.GroupTheory.Finiteness
import Mathlib.GroupTheory.GroupAction.Defs

/-!
# Fournier-Facio–Wu–Zaremsky Question 5.8: a type [A₂] action with a non-finitely-presented image

F. Fournier-Facio, X. Wu and M. C. B. Zaremsky, *Abstract twisted Brin–Thompson
groups* (arXiv:2603.24687v2), ask as Question 5.8 (p. 27):

> Does there exist an example of a group action G ↷ S that is of type [A₂]
> such that G/ker(G ↷ S) is not finitely presented?

The theorem below answers **yes**.

## Vocabulary

The two definitions in the shared block are the only notions not taken from Mathlib.

* A group action `G ↷ S` is a `MulAction G S`, a left action.
* `actionKernel G S` is `ker(G ↷ S)`, the kernel of the permutation representation
  `MulAction.toPermHom G S : G →* Equiv.Perm S`.  It consists of the elements of `G`
  that fix every point of `S`.
* Finite presentation is Mathlib's `Group.IsFinitelyPresented`: some surjection from a
  free group of finite rank has a finitely normally generated kernel.
* Finite generation of a stabilizer is Mathlib's `Subgroup.FG`: the stabilizer is
  generated by a finite set.
* `IsTypeA2 G S` is FFWZ Definition 1.3 with `n = 2` (pp. 2–3).  There `G` acts on a
  non-empty set `S`, and the action is of type [A₂] when:
  (i) `G` is of type `F₂`;
  (ii) `Stab_G(T)` is of type `F_{2-|T|}` for every finite `T ⊆ S`;
  (iii) the diagonal action of `G` on `S²` has finitely many orbits.
  FFWZ §1.2 records that every group is of type `F₀`, that type `F₁` is finite
  generation, and that type `F₂` is finite presentability.  So:
  * (i) says `G` is finitely presented;
  * in (ii), `T = ∅` repeats (i), a singleton `{s}` asks that `Stab_G(s)` be
    finitely generated, and `|T| ≥ 2` asks nothing, as FFWZ note on p. 3;
  * (iii) says the orbit space of `G` on `S × S` is finite.
  Faithfulness is not required.  FFWZ call a faithful action of type [A₂] an action
  of type (A₂).

All groups and sets are quantified over `Type`, where the example lives.

The prose of this module was written by Claude (Anthropic).
-/

namespace FFWZ

-- BEGIN SHARED BLOCK (kept byte-identical in `Palomar/TypeA2Challenge.lean` and `Palomar/TypeA2Solution.lean`)

/-- An action of `G` on `S` of **type [A₂]** (FFWZ Definition 1.3, `n = 2`): `S` is
non-empty, `G` is finitely presented, every point stabilizer is finitely generated,
and the diagonal action of `G` on `S × S` has finitely many orbits.  The action need
not be faithful. -/
def IsTypeA2 (G S : Type) [Group G] [MulAction G S] : Prop :=
  Nonempty S ∧ Group.IsFinitelyPresented G ∧ (∀ s : S, (MulAction.stabilizer G s).FG) ∧
    Finite (MulAction.orbitRel.Quotient G (S × S))

/-- The kernel `ker(G ↷ S)` of an action: the kernel of `G →* Equiv.Perm S`, that is,
the elements of `G` that fix every point of `S`. -/
abbrev actionKernel (G S : Type) [Group G] [MulAction G S] : Subgroup G :=
  (MulAction.toPermHom G S).ker

-- END SHARED BLOCK

/-- **Question 5.8 has a positive answer**: some group action `G ↷ S` of type [A₂]
has a quotient `G ⧸ ker(G ↷ S)` that is not finitely presented. -/
theorem exists_isTypeA2_quotient_not_isFinitelyPresented :
    ∃ (G : Type) (_ : Group G) (S : Type) (_ : MulAction G S),
      IsTypeA2 G S ∧ ¬ Group.IsFinitelyPresented (G ⧸ actionKernel G S) := by
  sorry

end FFWZ
