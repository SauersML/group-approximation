/-!
# Finite models of `Δ` on balls

`simple_kazhdan_sofic_group.tex` at origin/main 696c4b602 (md5 0648e5f8…), tex 398–400, in the
proof of `cor:lef` and `cor:host`:

> Let `σ_n : Δ → Q'_n` be finite models of `Δ` that are injective on the ball of radius `n` and
> preserve the products that stay in it, with `σ_n(e) = e` and `Q'_n` generated by the images of the
> generators.

* `symBall T n`: the ball of radius `n` for a generating set `T`, the products of at most `n`
  elements of `T ∪ T⁻¹`.  It is finite when `T` is (`symBall_finite`), and the balls exhaust `Δ`
  when `T` generates it (`exists_mem_symBall`).
* `IsBallModel T n σ`: the printed properties of `σ_n`.
* `exists_isBallModel`: an LEF group with a finite generating set has such models for every `n`.
  The model is `f_n` from local embeddability on the ball of radius `n + 1`, restricted to the
  subgroup generated by the images of the generators; a product of generators stays in that
  subgroup (`mem_closure_of_mem_symBall`).
* `BallModelSequence Δ T`, `exists_ballModelSequence`: one model for each radius.
* `BallModelSequence.eventually_map_mul`, `eventually_ne`, `eventually_map_inv`: for fixed elements
  and large `n`, the models multiply as in `Δ` and separate distinct elements.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace Lamplighter

open Filter
open scoped Pointwise

variable {Δ : Type*} [Group Δ]

/-! ## Balls -/

/-- **The ball of radius `n`** for a generating set `T`: the products of at most `n` elements of
`T ∪ T⁻¹`. -/
def symBall (T : Set Δ) (n : ℕ) : Set Δ :=
  {δ | ∃ l : List Δ, l.length ≤ n ∧ (∀ x ∈ l, x ∈ T ∨ x⁻¹ ∈ T) ∧ l.prod = δ}

theorem one_mem_symBall (T : Set Δ) (n : ℕ) : (1 : Δ) ∈ symBall T n :=
  ⟨[], Nat.zero_le n, fun _ hx => by simp at hx, List.prod_nil⟩

theorem symBall_mono (T : Set Δ) {m n : ℕ} (h : m ≤ n) : symBall T m ⊆ symBall T n :=
  fun _ ⟨l, hl, hlT, hp⟩ => ⟨l, hl.trans h, hlT, hp⟩

theorem mem_symBall_one_of {T : Set Δ} {x : Δ} (hx : x ∈ T ∨ x⁻¹ ∈ T) : x ∈ symBall T 1 :=
  ⟨[x], le_rfl, fun y hy => by rw [List.mem_singleton.1 hy]; exact hx, List.prod_singleton⟩

theorem mul_mem_symBall {T : Set Δ} {m n : ℕ} {a b : Δ} (ha : a ∈ symBall T m)
    (hb : b ∈ symBall T n) : a * b ∈ symBall T (m + n) := by
  obtain ⟨l, hl, hlT, rfl⟩ := ha
  obtain ⟨l', hl', hlT', rfl⟩ := hb
  refine ⟨l ++ l', ?_, fun x hx => ?_, List.prod_append⟩
  · rw [List.length_append]
    omega
  · rcases List.mem_append.1 hx with hx | hx
    · exact hlT x hx
    · exact hlT' x hx

theorem inv_mem_symBall {T : Set Δ} {n : ℕ} {a : Δ} (ha : a ∈ symBall T n) :
    a⁻¹ ∈ symBall T n := by
  obtain ⟨l, hl, hlT, rfl⟩ := ha
  refine ⟨(l.map fun x => x⁻¹).reverse, ?_, fun x hx => ?_, (List.prod_inv_reverse l).symm⟩
  · rw [List.length_reverse, List.length_map]
    exact hl
  · rw [List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rcases hlT y hy with h | h
    · exact Or.inr (by rw [inv_inv]; exact h)
    · exact Or.inl h

theorem symBall_succ_subset (T : Set Δ) (n : ℕ) :
    symBall T (n + 1) ⊆ symBall T n ∪ symBall T n * (T ∪ T⁻¹) := by
  rintro _ ⟨l, hl, hlT, rfl⟩
  by_cases hn : l.length ≤ n
  · exact Or.inl ⟨l, hn, hlT, rfl⟩
  · have hne : l ≠ [] := fun h => hn (by rw [h, List.length_nil]; exact Nat.zero_le n)
    refine Or.inr ⟨l.dropLast.prod,
      ⟨l.dropLast, ?_, fun x hx => hlT x (List.mem_of_mem_dropLast hx), rfl⟩,
      l.getLast hne, ?_, ?_⟩
    · rw [List.length_dropLast]
      omega
    · rcases hlT _ (List.getLast_mem hne) with h | h
      · exact Or.inl h
      · exact Or.inr h
    · conv_rhs => rw [← List.dropLast_append_getLast hne]
      rw [List.prod_append, List.prod_singleton]

/-- The balls of a finite generating set are finite. -/
theorem symBall_finite {T : Set Δ} (hT : T.Finite) (n : ℕ) : (symBall T n).Finite := by
  induction n with
  | zero =>
    refine (Set.finite_singleton (1 : Δ)).subset ?_
    rintro _ ⟨l, hl, -, rfl⟩
    rw [List.eq_nil_of_length_eq_zero (Nat.le_zero.1 hl), List.prod_nil]
    exact Set.mem_singleton 1
  | succ n ih => exact (ih.union (ih.mul (hT.union hT.inv))).subset (symBall_succ_subset T n)

/-- The balls of a generating set exhaust `Δ`. -/
theorem exists_mem_symBall {T : Set Δ} (hT : Subgroup.closure T = ⊤) (δ : Δ) :
    ∃ n, δ ∈ symBall T n := by
  have hδ : δ ∈ Subgroup.closure T := by
    rw [hT]
    exact Subgroup.mem_top δ
  induction hδ using Subgroup.closure_induction with
  | mem x hx => exact ⟨1, mem_symBall_one_of (Or.inl hx)⟩
  | one => exact ⟨0, one_mem_symBall T 0⟩
  | mul x y _ _ hx hy =>
    obtain ⟨m, hm⟩ := hx
    obtain ⟨n, hn⟩ := hy
    exact ⟨m + n, mul_mem_symBall hm hn⟩
  | inv x _ hx =>
    obtain ⟨n, hn⟩ := hx
    exact ⟨n, inv_mem_symBall hn⟩

theorem eventually_mem_symBall {T : Set Δ} (hT : Subgroup.closure T = ⊤) (δ : Δ) :
    ∀ᶠ n in atTop, δ ∈ symBall T n := by
  obtain ⟨m, hm⟩ := exists_mem_symBall hT δ
  exact eventually_atTop.2 ⟨m, fun n hn => symBall_mono T hn hm⟩

/-! ## Models on balls -/

/-- **Finite models of `Δ` on the ball of radius `n`** (tex 398–400): `σ(e) = e`, `σ` is injective
on the ball and preserves the products that stay in it, and the images of the generators generate
the finite group. -/
structure IsBallModel (T : Set Δ) (n : ℕ) {Q : Type*} [Group Q] (σ : Δ → Q) : Prop where
  map_one : σ 1 = 1
  injOn : Set.InjOn σ (symBall T n)
  map_mul : ∀ a ∈ symBall T n, ∀ b ∈ symBall T n, a * b ∈ symBall T n → σ (a * b) = σ a * σ b
  closure_image : Subgroup.closure (σ '' T) = ⊤

/-- A locally multiplicative map sends products of generators into the subgroup generated by the
images of the generators. -/
theorem mem_closure_of_mem_symBall {T : Set Δ} {s : Finset Δ} {Q : Type*} [Group Q] {f : Δ → Q}
    (hf : LocalMultiplicativeOn s f) {k : ℕ} (hs : symBall T k ⊆ s) :
    ∀ δ ∈ symBall T k, f δ ∈ Subgroup.closure (f '' T) := by
  rintro _ ⟨l, hl, hlT, rfl⟩
  induction l with
  | nil =>
    rw [List.prod_nil, hf.map_one]
    exact Subgroup.one_mem _
  | cons x l ih =>
    have hlen : l.length + 1 ≤ k := by simpa using hl
    have hxT : x ∈ T ∨ x⁻¹ ∈ T := hlT x (List.mem_cons.2 (Or.inl rfl))
    have hlT' : ∀ y ∈ l, y ∈ T ∨ y⁻¹ ∈ T := fun y hy => hlT y (List.mem_cons.2 (Or.inr hy))
    have hx : x ∈ symBall T k := symBall_mono T (by omega) (mem_symBall_one_of hxT)
    have hl' : l.prod ∈ symBall T k := ⟨l, by omega, hlT', rfl⟩
    rw [List.prod_cons, hf.map_mul x (hs hx) l.prod (hs hl')]
    refine Subgroup.mul_mem _ ?_ (ih (by omega) hlT')
    rcases hxT with h | h
    · exact Subgroup.subset_closure ⟨x, h, rfl⟩
    · have h1 := hf.map_inv_of_mem (x := x⁻¹) (hs (inv_mem_symBall hx))
        (by rw [inv_inv]; exact hs hx)
      rw [inv_inv] at h1
      rw [h1]
      exact Subgroup.inv_mem _ (Subgroup.subset_closure ⟨x⁻¹, h, rfl⟩)

/-- **Existence of the models** (tex 398–400): an LEF group with a finite generating set `T` has, for
every radius `n`, a finite model on the ball of radius `n`. -/
theorem exists_isBallModel (hLEF : IsLEF Δ) {T : Set Δ} (hTfin : T.Finite) (n : ℕ) :
    ∃ (Q : Type) (_ : Group Q) (_ : Fintype Q) (_ : DecidableEq Q) (σ : Δ → Q),
      IsBallModel T n σ := by
  classical
  obtain ⟨m, f, hinj, hmul⟩ := hLEF (symBall_finite hTfin (n + 1)).toFinset
  have hs : ∀ k ≤ n + 1, symBall T k ⊆ ((symBall_finite hTfin (n + 1)).toFinset : Set Δ) :=
    fun k hk => by
      rw [Set.Finite.coe_toFinset]
      exact symBall_mono T hk
  let K : Subgroup (Equiv.Perm (Fin m)) := Subgroup.closure (f '' T)
  have hmem : ∀ δ ∈ symBall T (n + 1), f δ ∈ K :=
    mem_closure_of_mem_symBall hmul (hs (n + 1) le_rfl)
  let σ : Δ → K := fun δ => if h : f δ ∈ K then ⟨f δ, h⟩ else 1
  have hσ : ∀ δ ∈ symBall T (n + 1), (σ δ : Equiv.Perm (Fin m)) = f δ := fun δ hδ => by
    show ((if h : f δ ∈ K then ⟨f δ, h⟩ else 1 : K) : Equiv.Perm (Fin m)) = f δ
    rw [dif_pos (hmem δ hδ)]
  have hsucc : ∀ {δ : Δ}, δ ∈ symBall T n → δ ∈ symBall T (n + 1) :=
    fun hδ => symBall_mono T (Nat.le_succ n) hδ
  refine ⟨K, inferInstance, inferInstance, inferInstance, σ, ⟨?_, ?_, ?_, ?_⟩⟩
  · apply Subtype.ext
    rw [hσ 1 (one_mem_symBall T _), hmul.map_one]
    rfl
  · intro a ha b hb hab
    apply hinj (hs (n + 1) le_rfl (hsucc ha)) (hs (n + 1) le_rfl (hsucc hb))
    have h := congrArg Subtype.val hab
    rwa [hσ a (hsucc ha), hσ b (hsucc hb)] at h
  · intro a ha b hb hab
    apply Subtype.ext
    rw [Subgroup.coe_mul, hσ _ (hsucc hab), hσ a (hsucc ha), hσ b (hsucc hb)]
    exact hmul.map_mul a (hs (n + 1) le_rfl (hsucc ha)) b (hs (n + 1) le_rfl (hsucc hb))
  · have hT1 : ∀ t ∈ T, t ∈ symBall T (n + 1) := fun t ht =>
      symBall_mono T (by omega) (mem_symBall_one_of (Or.inl ht))
    have himg : σ '' T = ((↑) : K → Equiv.Perm (Fin m)) ⁻¹' (f '' T) := by
      ext q
      constructor
      · rintro ⟨t, ht, rfl⟩
        show (σ t : Equiv.Perm (Fin m)) ∈ f '' T
        rw [hσ t (hT1 t ht)]
        exact ⟨t, ht, rfl⟩
      · rintro ⟨t, ht, htq⟩
        refine ⟨t, ht, Subtype.ext ?_⟩
        rw [hσ t (hT1 t ht), htq]
    rw [himg]
    exact Subgroup.closure_closure_coe_preimage

/-- **One model for each radius** (tex 398). -/
structure BallModelSequence (Δ : Type*) [Group Δ] (T : Set Δ) where
  Q : ℕ → Type
  instGroup : ∀ n, Group (Q n)
  instFintype : ∀ n, Fintype (Q n)
  instDecidableEq : ∀ n, DecidableEq (Q n)
  σ : ∀ n, Δ → Q n
  isBallModel : ∀ n, IsBallModel T n (σ n)

attribute [instance] BallModelSequence.instGroup BallModelSequence.instFintype
  BallModelSequence.instDecidableEq

theorem exists_ballModelSequence (hLEF : IsLEF Δ) {T : Set Δ} (hTfin : T.Finite) :
    Nonempty (BallModelSequence Δ T) := by
  choose Q hG hF hD σ hσ using exists_isBallModel hLEF hTfin
  exact ⟨⟨Q, hG, hF, hD, σ, hσ⟩⟩

namespace BallModelSequence

variable {T : Set Δ} (M : BallModelSequence Δ T) (hT : Subgroup.closure T = ⊤)
include hT

/-- For fixed `a, b` and large `n`, `σ_n(ab) = σ_n(a) σ_n(b)`. -/
theorem eventually_map_mul (a b : Δ) : ∀ᶠ n in atTop, M.σ n (a * b) = M.σ n a * M.σ n b :=
  ((eventually_mem_symBall hT a).and ((eventually_mem_symBall hT b).and
    (eventually_mem_symBall hT (a * b)))).mono fun n ⟨ha, hb, hab⟩ =>
      (M.isBallModel n).map_mul a ha b hb hab

/-- For fixed `a ≠ b` and large `n`, `σ_n(a) ≠ σ_n(b)`. -/
theorem eventually_ne {a b : Δ} (hab : a ≠ b) : ∀ᶠ n in atTop, M.σ n a ≠ M.σ n b :=
  ((eventually_mem_symBall hT a).and (eventually_mem_symBall hT b)).mono fun n ⟨ha, hb⟩ h =>
    hab ((M.isBallModel n).injOn ha hb h)

/-- For fixed `a` and large `n`, `σ_n(a⁻¹) = σ_n(a)⁻¹`. -/
theorem eventually_map_inv (a : Δ) : ∀ᶠ n in atTop, M.σ n a⁻¹ = (M.σ n a)⁻¹ :=
  (M.eventually_map_mul hT a a⁻¹).mono fun n h => by
    rw [mul_inv_cancel, (M.isBallModel n).map_one] at h
    exact eq_inv_of_mul_eq_one_right h.symm

end BallModelSequence

end Lamplighter

open Lamplighter

/-- **The finite models of `Δ`** (tex 398–400): for an LEF group `Δ` with a finite generating set
`T`, there are finite groups `Q'_n` and maps `σ_n : Δ → Q'_n` with `σ_n(e) = e`, injective on the ball
of radius `n`, preserving the products that stay in it, and with `Q'_n` generated by the images of
the generators. -/
def PrintedLamplighterBallModels : Prop :=
  ∀ (Δ : Type) [Group Δ] (T : Set Δ), T.Finite → Subgroup.closure T = ⊤ → IsLEF Δ →
    ∀ n : ℕ, ∃ (Q : Type) (_ : Group Q) (_ : Fintype Q) (_ : DecidableEq Q) (σ : Δ → Q),
      IsBallModel T n σ

theorem printedLamplighterBallModels : PrintedLamplighterBallModels :=
  fun _ _ _ hTfin _ hLEF n => exists_isBallModel hLEF hTfin n

#audit_closed_axioms GroupApproximation.SimpleKazhdanSofic.printedLamplighterBallModels

