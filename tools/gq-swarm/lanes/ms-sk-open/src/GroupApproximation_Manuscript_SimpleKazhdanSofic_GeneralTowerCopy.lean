import GroupApproximation.Manuscript.SimpleKazhdanSofic.GeneralTowerUnits
import GroupApproximation.Leavitt.CornerUnitHom
import GroupApproximation.Algebra.FinitaryLinearBinarySimple
import Mathlib.Data.Matrix.Composition

/-!
# The copy `H_V` of `GL_d(F_2)` for a group action

`simple_kazhdan_sofic_group.tex` at 37551fd93, subsection "Simplicity" (l.180–186):

> … the $\epsilon_{ab}$ span a ring $A_V\cong M_{|B_w|}(\F_2)$ with unit $e=\sum_a\epsilon_{aa}$, and
> $y\mapsto(1-e)I_3+y$ embeds $\GL_3(A_V)\cong\GL_d(\F_2)$ in $\GL_3(R)$. Its image $H_V$ lies in $G$,
> since the transvections $e_{pq}(\epsilon_{ab})$ with $p\ne q$ generate it: the other transvections
> of $\GL_d(\F_2)$ are commutators of these.

The index type `ι` of the outer matrices is arbitrary (printed `ι = {1,2,3}`, and `n` in general), and
`d = #ι · |B|`.

* `blockFlatEquiv ι κ : GL_{ι × κ}(F_2) ≃* GL_ι(M_κ(F_2))`, block flattening;
* `copyGL hcov ι hdisj hV`: `y ↦ (1 - e) I + y` on `GL_ι(A_V) ≅ GL_{ι × B}(F_2)`, the corner map of
  `epsilonHom`;
* `copyGL_transvection`: the transvection between `(p,a)` and `(q,b)`, `p ≠ q`, goes to `e_pq(ε_ab)`;
* `copyGL_mem_elementaryGroup`: `H_V ≤ EL_ι(R)`. The transvections with `p = q` are commutators of two
  with `p ≠ q`;
* `copyGL_injective` for nonempty `V`.
-/

namespace GroupApproximation
namespace SimpleKazhdanSofic
namespace General

open Pointwise ChainRadical

variable {Λ Z R : Type*} [Group Λ] [TopologicalSpace Z] [MulAction Λ Z] [ContinuousConstSMul Λ Z]
  [Ring R] {coeff : LocallyConstant Z (ZMod 2) →+* R} {u : Λ →* Rˣ} [DecidableEq Λ]
  {B : Finset Λ} {V : Set Z}

/-- Block flattening `GL_{ι × κ}(F_2) ≃* GL_ι(M_κ(F_2))`. -/
noncomputable def blockFlatEquiv (ι κ : Type*) [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] :
    (Matrix (ι × κ) (ι × κ) (ZMod 2))ˣ ≃* (Matrix ι ι (Matrix κ κ (ZMod 2)))ˣ :=
  Units.mapEquiv (Matrix.compRingEquiv ι κ (ZMod 2)).symm.toMulEquiv

theorem blockFlatEquiv_elementaryUnit {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] {p q : ι} (hpq : p ≠ q) (a b : κ) (c : ZMod 2) (h : (p, a) ≠ (q, b)) :
    blockFlatEquiv ι κ (elementaryUnit (p, a) (q, b) h c) =
      elementaryUnit p q hpq (Matrix.single a b c) := by
  apply Units.ext
  change (Matrix.compRingEquiv ι κ (ZMod 2)).symm (1 + Matrix.single (p, a) (q, b) c) =
    1 + Matrix.single p q (Matrix.single a b c)
  rw [map_add, map_one, ← Matrix.comp_single_single, Matrix.compRingEquiv_symm_apply,
    Equiv.symm_apply_apply]

variable (hcov : IsCovariantPair coeff u)
include hcov

/-- **The copy `H_V`**: `y ↦ (1 - e) I + y` on `GL_ι(A_V) ≅ GL_{ι × B}(F_2)`. -/
noncomputable def copyGL (ι : Type*) [Fintype ι] [DecidableEq ι] (hdisj : TranslatesDisjoint B V)
    (hV : IsClopen V) : (Matrix (ι × B) (ι × B) (ZMod 2))ˣ →* (Matrix ι ι R)ˣ :=
  (cornerUnitHom (ι := ι) (epsilonHom hcov hdisj hV)).comp (blockFlatEquiv ι B).toMonoidHom

theorem copyGL_elementaryUnit {ι : Type*} [Fintype ι] [DecidableEq ι]
    (hdisj : TranslatesDisjoint B V) (hV : IsClopen V) {p q : ι} (hpq : p ≠ q) (a b : B)
    (c : ZMod 2) (h : (p, a) ≠ (q, b)) :
    copyGL hcov ι hdisj hV (elementaryUnit (p, a) (q, b) h c) =
      elementaryUnit p q hpq (epsilonHom hcov hdisj hV (Matrix.single a b c)) := by
  rw [copyGL, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    blockFlatEquiv_elementaryUnit hpq a b c h, cornerUnitHom_elementaryUnit]

/-- **The transvection between `(p,a)` and `(q,b)` maps to `e_pq(ε_ab)`** if `p ≠ q`. -/
theorem copyGL_transvection {ι : Type*} [Fintype ι] [DecidableEq ι]
    (hdisj : TranslatesDisjoint B V) (hV : IsClopen V) {p q : ι} (hpq : p ≠ q) (a b : B)
    (h : (p, a) ≠ (q, b)) :
    copyGL hcov ι hdisj hV (elementaryUnit (p, a) (q, b) h 1) =
      elementaryUnit p q hpq (epsilon coeff u hV a b) := by
  rw [copyGL_elementaryUnit hcov hdisj hV hpq a b 1 h, epsilonHom_single]

/-- **`H_V` lies in `G`**: `GL_{ι × B}(F_2)` is generated by transvections; those with `p ≠ q` map to
roots, and those with `p = q` are commutators of two with `p ≠ q`. -/
theorem copyGL_mem_elementaryGroup {ι : Type*} [Fintype ι] [DecidableEq ι] [Nontrivial ι]
    (hdisj : TranslatesDisjoint B V) (hV : IsClopen V)
    (x : (Matrix (ι × B) (ι × B) (ZMod 2))ˣ) :
    copyGL hcov ι hdisj hV x ∈ elementaryGroup ι R := by
  have hx : x ∈ elementaryGroup (ι × B) (ZMod 2) := by
    rw [FinitaryLinear.elementaryGroup_zmodTwo_eq_top]
    exact Subgroup.mem_top x
  have hroot : ∀ {p q : ι} (hpq : p ≠ q) (a b : B) (c : ZMod 2) (h : (p, a) ≠ (q, b)),
      copyGL hcov ι hdisj hV (elementaryUnit (p, a) (q, b) h c) ∈ elementaryGroup ι R := by
    intro p q hpq a b c h
    rw [copyGL_elementaryUnit hcov hdisj hV hpq a b c h]
    exact elementaryUnit_mem _ _ _ _
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    obtain ⟨⟨p, a⟩, ⟨q, b⟩, hne, c, rfl⟩ := hy
    by_cases hpq : p = q
    · subst hpq
      obtain ⟨p', hp'⟩ := exists_ne p
      have h1 : ((p, a) : ι × B) ≠ (p', a) := by simp [hp'.symm]
      have h2 : ((p', a) : ι × B) ≠ (p, b) := by simp [hp']
      have hcomm := elementaryUnit_commutator (R := ZMod 2) ((p, a) : ι × B) (p', a) (p, b)
        h1 h2 hne c 1
      rw [mul_one] at hcomm
      rw [← hcomm, commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _
        (hroot hp'.symm a a c h1) (hroot hp' a b 1 h2))
        (Subgroup.inv_mem _ (hroot hp'.symm a a c h1))) (Subgroup.inv_mem _ (hroot hp' a b 1 h2))
    · exact hroot hpq a b c hne
  | one => rw [map_one]; exact Subgroup.one_mem _
  | mul y z _ _ hy hz => rw [map_mul]; exact Subgroup.mul_mem _ hy hz
  | inv y _ hy => rw [map_inv]; exact Subgroup.inv_mem _ hy

/-- **The copy is injective** for nonempty `V` (printed "embeds"). -/
theorem copyGL_injective {ι : Type*} [Fintype ι] [DecidableEq ι] (hdisj : TranslatesDisjoint B V)
    (hV : IsClopen V) (hne : V.Nonempty) : Function.Injective (copyGL hcov ι hdisj hV) := by
  intro x y h
  have h' : cornerUnitHom (ι := ι) (epsilonHom hcov hdisj hV) (blockFlatEquiv ι B x) =
      cornerUnitHom (ι := ι) (epsilonHom hcov hdisj hV) (blockFlatEquiv ι B y) := h
  exact (blockFlatEquiv ι B).injective
    (cornerUnitHom_injective _ (epsilonHom_injective hcov hdisj hV hne) h')

#audit_axioms GroupApproximation.SimpleKazhdanSofic.General.copyGL_transvection
#audit_axioms GroupApproximation.SimpleKazhdanSofic.General.copyGL_mem_elementaryGroup
#audit_axioms GroupApproximation.SimpleKazhdanSofic.General.copyGL_injective

end General
end SimpleKazhdanSofic
end GroupApproximation
