import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.GeneralExpanders.Models
import GroupApproximation.Meta.AxiomGuard

/-!
# `thm:general`, parts (a) and (b), as one closed proposition

Manuscript: `simple_kazhdan_sofic_group.tex`, Theorem `thm:general` (tex l.172–189), proofs in the
sections "Property (T)", "Simplicity" and "Finite simple models" (tex l.316–342):

> Let a finitely generated group `Λ` act minimally and topologically freely on a Cantor set `C`, and let
> the ring `R = LC(C, F₂) ⋊ Λ` be generated by a finite set `S ∋ 1`.
> (a) For every `n ≥ 3`, the group `EL_n(R)` is an infinite, finitely generated, simple Kazhdan group.
> (b) Suppose that there are maps `φ_k : R → M_{N_k}(F₂)` with `φ_k(1) = I` such that `φ_k(S)` generates
> the ring `M_{N_k}(F₂)`, and for all `r, r' ∈ R` and all large `k` we have `φ_k(r + r') = φ_k(r) + φ_k(r')`
> and `φ_k(r r') = φ_k(r) φ_k(r')`. Then for every `n ≥ 3`, `EL_n(R)`, marked by the `e_ij(s)` with
> `s ∈ S`, is an expander limit of the finite simple groups `SL_{nN_k}(F₂)` marked by the `e_ij(φ_k(s))`.

`PrintedGeneralTheorem` states both parts; `printedGeneralTheorem` proves it, from part (a)
(`Full.SK03.printedGeneralPartA`) and `thm_general_b_printed` (`Models.lean`, this lane).

In (b) the matrix sizes are required to be positive (`∀ k, 0 < N k`): for `N_k = 0` the zero map
satisfies every printed condition while `SL_0(F₂)` is trivial, so without it the conclusion fails
whenever `N_k = 0` for infinitely many `k`. "Expander limit" is spelled out as: the marked models
converge to the marking of `EL_n(R)` (`IsMarkedLimit`), their Cayley graphs form an expander family
(`IsExpanderFamily`), and `EL_n(R)` is an expander limit of the class of finite simple groups
`SL_{nN}(F₂)` in the vertex-boundary definition of tex l.92–100 (`ThmMainA.IsExpanderLimitOfClass`).
-/

namespace GroupApproximation.Full.SK04

open Filter

/-- **Theorem `thm:general`** (tex l.172–189), parts (a) and (b), as printed. -/
def PrintedGeneralTheorem : Prop :=
  ∀ (Λ : Type) [Group Λ] [Group.FG Λ] (C : Type) [TopologicalSpace C] [CompactSpace C]
    [TopologicalSpace.MetrizableSpace C] [TotallyDisconnectedSpace C] [PerfectSpace C]
    [Nonempty C] [MulAction Λ C] [ContinuousConstSMul Λ C],
    MulAction.IsMinimal Λ C →
    (∀ ξ : Λ, ξ ≠ 1 → ∀ U : Set C, IsOpen U → U.Nonempty → ∃ z ∈ U, ξ • z ≠ z) →
    ∀ S : Finset (ClopenGroupCrossedProduct Λ C (ZMod 2)),
      (1 : ClopenGroupCrossedProduct Λ C (ZMod 2)) ∈ S →
      Subring.closure (S : Set (ClopenGroupCrossedProduct Λ C (ZMod 2))) = ⊤ →
      ∀ (n : ℕ) (hn : 3 ≤ n),
        (Infinite ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          Group.FG ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          IsSimpleGroup ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2))) ∧
          HasKazhdanPropertyT.{0, 0}
            ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2)))) ∧
        ∀ (N : ℕ → ℕ)
          (φ : ∀ k, ClopenGroupCrossedProduct Λ C (ZMod 2) → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))
          (hN : ∀ k, 0 < N k), IsPrintedMatricial S N φ →
          SimpleKazhdanSofic.IsMarkedLimit (elementaryMarking n S) (slMarking n hn S N hN φ) ∧
            SimpleKazhdanSofic.IsExpanderFamily (slMarking n hn S N hN φ) ∧
            (∀ k, SK05.IsFiniteSimpleSLMultiple n
              (Matrix.SpecialLinearGroup (Fin n × Fin (N k)) (ZMod 2))) ∧
            Tendsto N atTop atTop ∧
            SimpleKazhdanSofic.ThmMainA.IsExpanderLimitOfClass (SK05.IsFiniteSimpleSLMultiple n)
              ↥(elementaryGroup (Fin n) (ClopenGroupCrossedProduct Λ C (ZMod 2)))

/-- **Theorem `thm:general`** (tex l.172–189, proofs l.316–342), parts (a) and (b), unconditionally. -/
theorem printedGeneralTheorem : PrintedGeneralTheorem := by
  intro Λ _ _ C _ _ _ _ _ _ _ _ hmin hfree S hS1 hS n hn
  exact ⟨SK03.printedGeneralPartA Λ C hmin hfree S hS1 hS n hn, fun N φ hN hφ =>
    thm_general_b_printed Λ C hmin hfree S hS1 hS n hn N hN φ hφ⟩

#audit_closed_axioms GroupApproximation.Full.SK04.printedGeneralTheorem

end GroupApproximation.Full.SK04
