import GroupApproximation.Manuscript.SimpleKazhdanSofic.Full.GeneralExpanders.MarkedLimit
import GroupApproximation.Manuscript.SimpleKazhdanSofic.KazhdanQuotientExpanders
import GroupApproximation.Manuscript.SimpleKazhdanSofic.FreeAlgebraKazhdan
import GroupApproximation.Meta.AxiomGuard

/-!
# The finite models of `thm:general` (b) form expanders

`simple_kazhdan_sofic_group.tex`, `thm:general` (b), tex l.178–189, and the section
"Finite simple models", tex l.317–342:

> Let `𝒜` be the free algebra over `𝔽₂` on letters `τ_s`, `s ∈ S`, and let `ρ_k : 𝒜 → M_{N_k}(𝔽₂)`
> be the ring homomorphism with `ρ_k(τ_s) = φ_k(s)`; it is onto. […] The group `EL_3(𝒜)` is
> generated by the `e_ij(1)` and `e_ij(τ_s)` […]. `N_k → ∞` as `G` is infinite. Since `EL_3(𝒜)` has
> property (T), its finite quotients form a family of expanders.

The route is the printed one, with no literature input.

* `isExpanderFamily_of_hasKazhdanPropertyT_images`: finite quotients of a Kazhdan group, marked by
  the images of a finite generating family, form expanders (`Analysis/KazhdanQuotientCheeger`).
* `closure_range_elementaryLetterMarking`: `EL_n(𝔽₂⟨τ_x⟩)` is generated by the `e_ij(1)` and the
  `e_ij(τ_x)`, for `n ≥ 3`.
* `lift_surjective_of_closure`: `ρ_k` is onto.
* `tendsto_card_of_isMarkedLimit`: the orders of the models of an infinite marked limit tend to
  infinity (the printed "`N_k → ∞` as `G` is infinite").
* `isExpanderFamily_matricial`: the models `EL_n(M_{N_k}(𝔽₂))` marked by the `e_ij(φ_k(s))` form a
  family of expanders under the hypotheses of `thm:general` (b).

The letters are indexed by `Fin #S` through `S.equivFin`, so that the ring `R` may live in any
universe while property (T) of `EL_n(𝒜)` is used in `Type`.
-/

namespace GroupApproximation.Full.SK04

open Filter

universe u v w w'

/-- **Finite quotients of a Kazhdan group form expanders, for a marking of the quotients.** Let `Γ`
have property (T) and be generated by the finite family `t`. Let `π ℓ` map `Γ` onto finite groups
whose orders tend to infinity, and let every `π ℓ (t j)` be the marking generator `σ ℓ (f j)`. Then
the Cayley graphs with respect to `σ ℓ` form a family of expanders (tex l.340–342). -/
theorem isExpanderFamily_of_hasKazhdanPropertyT_images {Γ : Type u} [Group Γ]
    (hT : HasKazhdanPropertyT.{u, v} Γ) {κ : Type w} [Finite κ] (t : κ → Γ)
    (ht : Subgroup.closure (Set.range t) = ⊤) {ι : Type w'} [Finite ι] {H : ℕ → Type v}
    [∀ ℓ, Group (H ℓ)] [∀ ℓ, Finite (H ℓ)] (π : ∀ ℓ, Γ →* H ℓ)
    (hπ : ∀ ℓ, Function.Surjective (π ℓ))
    (hcard : Tendsto (fun ℓ ↦ Nat.card (H ℓ)) atTop atTop) (σ : ∀ ℓ, ι → H ℓ) (f : κ → ι)
    (hf : ∀ ℓ j, π ℓ (t j) = σ ℓ (f j)) :
    SimpleKazhdanSofic.IsExpanderFamily σ := by
  classical
  haveI : Fintype κ := Fintype.ofFinite κ
  obtain ⟨Q₀, ε, hQ₀⟩ := hT
  have hgen : Subgroup.closure ((Finset.univ.image t : Finset Γ) : Set Γ) = ⊤ := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, ht]
  obtain ⟨δ, hδ⟩ := KazhdanQuotientCheeger.exists_isKazhdanPair_of_closure_eq_top hQ₀ _ hgen
  refine ⟨inferInstance, fun ℓ ↦ inferInstance, hcard, δ ^ 2 / 4,
    div_pos (pow_pos hδ.1 2) (by norm_num), ?_⟩
  intro ℓ S hS
  haveI : Fintype (H ℓ) := Fintype.ofFinite (H ℓ)
  set A : Finset (H ℓ) := S.toFinset with hAdef
  have hSA : S.ncard = A.card := Set.ncard_eq_toFinset_card' S
  rcases A.eq_empty_or_nonempty with hA0 | hne
  · rw [hSA, hA0]
    simp
  have hA : 2 * A.card ≤ Fintype.card (H ℓ) := by
    rw [← hSA, ← Nat.card_eq_fintype_card]
    exact hS
  obtain ⟨s, hs, hbound⟩ :=
    KazhdanQuotientCheeger.kazhdanPair_quotient_boundary hδ (π ℓ) (hπ ℓ) A hne hA
  obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hs
  rw [hf ℓ j] at hbound
  have hinj : Function.Injective fun a : H ℓ ↦ (a, f j) := fun a b h ↦ (Prod.mk.inj h).1
  have hsub : (fun a : H ℓ ↦ (a, f j)) ''
        ((A.filter fun a ↦ σ ℓ (f j) * a ∉ A : Finset (H ℓ)) : Set (H ℓ)) ⊆
      {p : H ℓ × ι | p.1 ∈ S ∧ σ ℓ p.2 * p.1 ∉ S} := by
    rintro _ ⟨a, ha, rfl⟩
    simpa [hAdef] using ha
  have hcardle : ((A.filter fun a ↦ σ ℓ (f j) * a ∉ A).card : ℝ) ≤
      (({p : H ℓ × ι | p.1 ∈ S ∧ σ ℓ p.2 * p.1 ∉ S} : Set (H ℓ × ι)).ncard : ℝ) := by
    have hle := Set.ncard_le_ncard hsub
    rw [Set.ncard_image_of_injective _ hinj, Set.ncard_coe_finset] at hle
    exact_mod_cast hle
  rw [hSA]
  exact hbound.trans hcardle

/-- The coefficients `1` and `τ_x` of the printed generators of `EL_n(𝔽₂⟨τ_x : x ∈ X⟩)`. -/
noncomputable def letterCoeff (X : Type*) : Option X → FreeAlgebra (ZMod 2) X
  | none => 1
  | some x => FreeAlgebra.ι (ZMod 2) x

/-- `EL_n(𝔽₂⟨τ_x : x ∈ X⟩)` marked by the `e_ij(1)` and the `e_ij(τ_x)` (tex l.336–337). -/
noncomputable def elementaryLetterMarking (n : ℕ) (X : Type*) :
    {p : Fin n × Fin n // p.1 ≠ p.2} × Option X →
      elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) X) :=
  fun q ↦ ⟨elementaryUnit q.1.1.1 q.1.1.2 q.1.2 (letterCoeff X q.2), elementaryUnit_mem _ _ _ _⟩

/-- **Tex l.336–337**: "The group `EL_3(𝒜)` is generated by the `e_ij(1)` and `e_ij(τ_s)`", for
every `n ≥ 3`. The admissible coefficients form an `𝔽₂`-subalgebra containing the letters. -/
theorem closure_range_elementaryLetterMarking (n : ℕ) (hn : 3 ≤ n) (X : Type*) :
    Subgroup.closure (Set.range (elementaryLetterMarking n X)) = ⊤ := by
  classical
  let H' : Subgroup (Matrix (Fin n) (Fin n) (FreeAlgebra (ZMod 2) X))ˣ :=
    (Subgroup.closure (Set.range (elementaryLetterMarking n X))).map
      (elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) X)).subtype
  have hmem : ∀ (i j : Fin n) (h : i ≠ j) (o : Option X),
      elementaryUnit i j h (letterCoeff X o) ∈ H' := by
    intro i j h o
    exact Subgroup.mem_map.mpr
      ⟨elementaryLetterMarking n X (⟨(i, j), h⟩, o),
        Subgroup.subset_closure (Set.mem_range_self _), rfl⟩
  set C : Subalgebra (ZMod 2) (FreeAlgebra (ZMod 2) X) :=
    elementaryCoefficientSubalgebra n (by omega) H' fun i j h ↦ hmem i j h none
  have hgen : Set.range (FreeAlgebra.ι (ZMod 2) : X → FreeAlgebra (ZMod 2) X) ⊆
      (C : Set (FreeAlgebra (ZMod 2) X)) := by
    rintro _ ⟨x, rfl⟩ i j h
    exact hmem i j h (some x)
  have hC : C = ⊤ := by
    apply top_unique
    rw [← FreeAlgebra.adjoin_range_ι (ZMod 2) X]
    exact Algebra.adjoin_le hgen
  have hle : elementaryGroup (Fin n) (FreeAlgebra (ZMod 2) X) ≤ H' := by
    rw [elementaryGroup, Subgroup.closure_le]
    rintro _ ⟨i, j, h, a, rfl⟩
    have ha : a ∈ C := by simp [hC]
    exact ha i j h
  rw [eq_top_iff]
  intro g _
  obtain ⟨x, hx, hxg⟩ := Subgroup.mem_map.mp (hle g.2)
  have hxg' : x = g := Subtype.ext hxg
  subst hxg'
  exact hx

/-- **Tex l.332–334**: `ρ_k : 𝒜 → M_{N_k}(𝔽₂)` with `ρ_k(τ_s) = φ_k(s)` is onto when `φ_k(S)`
generates `M_{N_k}(𝔽₂)` as a ring. The letters are indexed by `Fin #S`. -/
theorem lift_surjective_of_closure {R : Type*} (S : Finset R) {N : ℕ}
    (ψ : R → Matrix (Fin N) (Fin N) (ZMod 2))
    (hgen : Subring.closure (ψ '' (S : Set R)) = ⊤) :
    Function.Surjective
      (FreeAlgebra.lift (ZMod 2) fun j : Fin S.card ↦ ψ (S.equivFin.symm j : R)).toRingHom := by
  have hle : Subring.closure (ψ '' (S : Set R)) ≤
      (FreeAlgebra.lift (ZMod 2) fun j : Fin S.card ↦ ψ (S.equivFin.symm j : R)).toRingHom.range := by
    rw [Subring.closure_le]
    rintro _ ⟨x, hx, rfl⟩
    refine SetLike.mem_coe.mpr (RingHom.mem_range.mpr
      ⟨FreeAlgebra.ι (ZMod 2) (S.equivFin ⟨x, Finset.mem_coe.mp hx⟩), ?_⟩)
    show FreeAlgebra.lift (ZMod 2) (fun j : Fin S.card ↦ ψ (S.equivFin.symm j : R))
        (FreeAlgebra.ι (ZMod 2) (S.equivFin ⟨x, Finset.mem_coe.mp hx⟩)) = ψ x
    rw [FreeAlgebra.lift_ι_apply]
    exact congrArg (fun y : ↥S ↦ ψ (y : R))
      (Equiv.symm_apply_apply S.equivFin ⟨x, Finset.mem_coe.mp hx⟩)
  intro y
  have hy : y ∈ Subring.closure (ψ '' (S : Set R)) := by
    rw [hgen]
    exact Subring.mem_top y
  obtain ⟨x, hx⟩ := RingHom.mem_range.mp (hle hy)
  exact ⟨x, hx⟩

/-- The finite models `EL_n(M_N(𝔽₂))` are finite. -/
theorem finite_elementaryGroup_matrix (n N : ℕ) :
    Finite (elementaryGroup (Fin n) (Matrix (Fin N) (Fin N) (ZMod 2))) := by
  haveI : Finite (Matrix (Fin n) (Fin n) (Matrix (Fin N) (Fin N) (ZMod 2))) :=
    inferInstanceAs (Finite (Fin n → Fin n → Fin N → Fin N → ZMod 2))
  exact Finite.of_injective
    (fun g : elementaryGroup (Fin n) (Matrix (Fin N) (Fin N) (ZMod 2)) ↦
      ((g : (Matrix (Fin n) (Fin n) (Matrix (Fin N) (Fin N) (ZMod 2)))ˣ) :
        Matrix (Fin n) (Fin n) (Matrix (Fin N) (Fin N) (ZMod 2))))
    fun a b h ↦ Subtype.ext (Units.ext h)

/-- Every element of a marked limit is represented by a word in the marking. -/
theorem exists_word_of_isMarkedLimit {ι G : Type*} [Group G] {s : ι → G} {H : ℕ → Type*}
    [∀ ℓ, Group (H ℓ)] {σ : ∀ ℓ, ι → H ℓ} (hlim : SimpleKazhdanSofic.IsMarkedLimit s σ) (g : G) :
    ∃ w : FreeGroup ι, FreeGroup.lift s w = g := by
  obtain ⟨hs, -, -⟩ := hlim
  have hg : g ∈ (FreeGroup.lift s).range := by
    rw [FreeGroup.range_lift_eq_closure, hs]
    exact Subgroup.mem_top g
  exact MonoidHom.mem_range.mp hg

/-- **The orders tend to infinity** (tex l.338–339: "`N_k → ∞` as `G` is infinite"): the finite
models of an infinite marked limit have orders tending to infinity. Distinct elements of a finite
set `F ⊆ G` are separated by words, and eventually these words stay distinct in the models. -/
theorem tendsto_card_of_isMarkedLimit {ι G : Type*} [Group G] [Infinite G] {s : ι → G}
    {H : ℕ → Type*} [∀ ℓ, Group (H ℓ)] {σ : ∀ ℓ, ι → H ℓ}
    (hlim : SimpleKazhdanSofic.IsMarkedLimit s σ) (hfin : ∀ ℓ, Finite (H ℓ)) :
    Tendsto (fun ℓ => Nat.card (H ℓ)) atTop atTop := by
  classical
  choose word hword using exists_word_of_isMarkedLimit hlim
  obtain ⟨-, -, hw⟩ := hlim
  refine Filter.tendsto_atTop.2 fun B => ?_
  obtain ⟨F, hF⟩ := Infinite.exists_subset_card_eq G B
  have hsep : ∀ᶠ ℓ in atTop, ∀ x ∈ F, ∀ y ∈ F, x ≠ y →
      FreeGroup.lift (σ ℓ) (word x * (word y)⁻¹) ≠ 1 := by
    refine (eventually_all_finset F).2 fun x _ => (eventually_all_finset F).2 fun y _ => ?_
    by_cases hxy : x = y
    · exact Eventually.of_forall fun _ hne => absurd hxy hne
    · refine (hw (word x * (word y)⁻¹)).mono fun ℓ hℓ _ h1 => hxy ?_
      have h2 := hℓ.mp h1
      rw [map_mul, map_inv, hword, hword] at h2
      exact mul_inv_eq_one.mp h2
  refine hsep.mono fun ℓ hℓ => ?_
  letI : Fintype (H ℓ) := @Fintype.ofFinite (H ℓ) (hfin ℓ)
  have hinj : Function.Injective fun x : ↥F => FreeGroup.lift (σ ℓ) (word x.1) := by
    intro x y hxy
    by_contra hne
    have hxy' : FreeGroup.lift (σ ℓ) (word x.1) = FreeGroup.lift (σ ℓ) (word y.1) := hxy
    have h1 := hℓ x.1 x.2 y.1 y.2 fun h => hne (Subtype.ext h)
    rw [map_mul, map_inv] at h1
    exact h1 (mul_inv_eq_one.mpr hxy')
  calc B = Fintype.card ↥F := by rw [Fintype.card_coe, hF]
    _ ≤ Fintype.card (H ℓ) := Fintype.card_le_of_injective _ hinj
    _ = Nat.card (H ℓ) := Nat.card_eq_fintype_card.symm

/-- **Tex l.340–342**, "Since `EL_3(𝒜)` has property (T), its finite quotients form a family of
expanders", for every `n ≥ 3`. The models `EL_n(M_{N_k}(𝔽₂))`, marked by the `e_ij(φ_k(s))` with
`s ∈ S`, form an expander family when `1 ∈ S`, `φ_k(1) = I`, `φ_k(S)` generates `M_{N_k}(𝔽₂)`, and
the orders tend to infinity. The quotient maps are `EL_n(ρ_k)`. -/
theorem isExpanderFamily_matricialMarking {R : Type*} [Ring R] (n : ℕ) (hn : 3 ≤ n)
    (S : Finset R) (hS1 : (1 : R) ∈ S) (N : ℕ → ℕ)
    (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))
    (hone : ∀ k, φ k 1 = 1) (hgen : ∀ k, Subring.closure (φ k '' (S : Set R)) = ⊤)
    (hcard : Tendsto (fun k ↦
      Nat.card (elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)))) atTop atTop) :
    SimpleKazhdanSofic.IsExpanderFamily (matricialMarking n S N φ) := by
  classical
  haveI : ∀ k, Finite (elementaryGroup (Fin n) (Matrix (Fin (N k)) (Fin (N k)) (ZMod 2))) :=
    fun k ↦ finite_elementaryGroup_matrix n (N k)
  let ρ : ∀ k, FreeAlgebra (ZMod 2) (Fin S.card) →+* Matrix (Fin (N k)) (Fin (N k)) (ZMod 2) :=
    fun k ↦ (FreeAlgebra.lift (ZMod 2) fun j : Fin S.card ↦ φ k (S.equivFin.symm j : R)).toRingHom
  refine isExpanderFamily_of_hasKazhdanPropertyT_images
    (SimpleKazhdanSofic.hasKazhdanPropertyT_elementaryGroup_freeAlgebra (Fin S.card) n hn)
    (elementaryLetterMarking n (Fin S.card))
    (closure_range_elementaryLetterMarking n hn (Fin S.card))
    (fun k ↦ elementaryGroupMap (ρ k))
    (fun k ↦ elementaryGroupMap_surjective_of_surjective (ρ k)
      (lift_surjective_of_closure S (φ k) (hgen k)))
    hcard (matricialMarking n S N φ) (fun q ↦ (q.1, q.2.elim ⟨1, hS1⟩ S.equivFin.symm)) ?_
  rintro k ⟨p, o⟩
  apply Subtype.ext
  change elementaryMatrixUnitMap (ρ k)
      (elementaryUnit p.1.1 p.1.2 p.2 (letterCoeff (Fin S.card) o)) =
    elementaryUnit p.1.1 p.1.2 p.2 (φ k ((o.elim ⟨1, hS1⟩ S.equivFin.symm : ↥S) : R))
  rw [elementaryMatrixUnitMap_elementaryUnit]
  refine congrArg (elementaryUnit p.1.1 p.1.2 p.2) ?_
  cases o with
  | none => exact (map_one (ρ k)).trans (hone k).symm
  | some j =>
    show FreeAlgebra.lift (ZMod 2) (fun i : Fin S.card ↦ φ k (S.equivFin.symm i : R))
        (FreeAlgebra.ι (ZMod 2) j) = φ k (S.equivFin.symm j : R)
    exact FreeAlgebra.lift_ι_apply _ _

/-- **`thm:general` (b), expander part** (tex l.178–189 and l.317–342). Let `S ∋ 1` generate `R`,
let `n ≥ 3`, and let `EL_n(R)` be infinite and simple (`thm:general` (a)). Let the maps `φ_k`
satisfy the printed hypotheses, with `N_k ≥ 1`. Then the finite models `EL_n(M_{N_k}(𝔽₂))`, marked
by the `e_ij(φ_k(s))`, form a family of expanders. Their orders tend to infinity because
`EL_n(R)` is their infinite marked limit. -/
theorem isExpanderFamily_matricial {R : Type*} [Ring R] (n : ℕ) (hn : 3 ≤ n)
    [IsSimpleGroup (elementaryGroup (Fin n) R)] [Infinite (elementaryGroup (Fin n) R)]
    (S : Finset R) (hS1 : (1 : R) ∈ S) (hS : Subring.closure (S : Set R) = ⊤)
    (N : ℕ → ℕ) (hN : ∀ k, 0 < N k)
    (φ : ∀ k, R → Matrix (Fin (N k)) (Fin (N k)) (ZMod 2)) (hφ : IsPrintedMatricial S N φ) :
    SimpleKazhdanSofic.IsExpanderFamily (matricialMarking n S N φ) := by
  have hlim := isMarkedLimit_matricial n hn S hS1 hS N hN φ hφ
  obtain ⟨hone, hgen, -⟩ := hφ
  exact isExpanderFamily_matricialMarking n hn S hS1 N φ hone hgen
    (tendsto_card_of_isMarkedLimit hlim fun k ↦ finite_elementaryGroup_matrix n (N k))

#audit_axioms isExpanderFamily_of_hasKazhdanPropertyT_images
#audit_axioms closure_range_elementaryLetterMarking
#audit_axioms tendsto_card_of_isMarkedLimit
#audit_axioms isExpanderFamily_matricial

end GroupApproximation.Full.SK04
