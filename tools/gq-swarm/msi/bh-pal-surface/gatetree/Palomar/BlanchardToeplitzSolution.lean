/-- The Hilbert space `ℓ²(ℕ)`. -/
abbrev L2 : Type := lp (fun _ : ℕ => ℂ) 2

/-- The complex Hilbert cube `B_∞`, the closed unit ball of `ℓ²(ℕ)` (Blanchard, p. 6). -/
def HilbertCube : Type := {x : L2 // ‖x‖ ≤ 1}

/-- Blanchard's metric `d((x_p),(y_p)) = ∑_p 2^{-p-2} |x_p - y_p|` on `B_∞` (p. 6). -/
def cubeDist (x y : HilbertCube) : ℝ :=
  ∑' p : ℕ, (2 : ℝ)⁻¹ ^ (p + 2) * ‖(x.1 : ℕ → ℂ) p - (y.1 : ℕ → ℂ) p‖

/-- The topology of `cubeDist`, generated by its open balls. -/
instance instTopologicalSpaceHilbertCube : TopologicalSpace HilbertCube :=
  TopologicalSpace.generateFrom {U | ∃ x : HilbertCube, ∃ r : ℝ, U = {y | cubeDist x y < r}}

/-- The fibre `ℓ²(ℕ) ⊕ ℂ`, with the summand `ℂ` at the coordinate `none`. -/
abbrev K : Type := lp (fun _ : Option ℕ => ℂ) 2

/-- Bounded sections `B_∞ → V` with the supremum norm. -/
abbrev Sections (V : Type) [NormedAddCommGroup V] : Type := lp (fun _ : HilbertCube => V) ∞

/-- The coordinates of `η(x) = x ⊕ √(1 - ‖x‖²)` (Blanchard, p. 6). -/
def etaCoord (x : HilbertCube) : Option ℕ → ℂ
  | none => (Real.sqrt (1 - ‖x.1‖ ^ 2) : ℂ)
  | some p => (x.1 : ℕ → ℂ) p

/-- `C(B_∞, ℓ²(ℕ) ⊕ 0)`: continuous sections with no component in the summand `ℂ`. -/
def continuousSections : Set (Sections K) :=
  {ξ | Continuous (fun x => (ξ x : K)) ∧ ∀ x, (ξ x : Option ℕ → ℂ) none = 0}

/-- `C(B_∞)·η`. -/
def etaMultiples : Set (Sections K) :=
  {ξ | ∃ f : C(HilbertCube, ℂ), ∀ x i, (ξ x : Option ℕ → ℂ) i = f x * etaCoord x i}

/-- `F̈ = [C(B_∞, ℓ²(ℕ) ⊕ 0) + C(B_∞)·η]`, a closed linear span (Blanchard, p. 6). -/
def moduleF : Submodule ℂ (Sections K) :=
  (Submodule.span ℂ (continuousSections ∪ etaMultiples)).topologicalClosure

/-- `E_DD = (1 - θ_{η,η})·F̈`, where `θ_{η,η} ζ = η ⟨η, ζ⟩` (Blanchard, proof of Prop. 4.3, p. 6). -/
def ddModule : Set (Sections K) :=
  {ζ | ∃ ξ ∈ moduleF, ∀ x i, (ζ x : Option ℕ → ℂ) i =
    (ξ x : Option ℕ → ℂ) i - (∑' j, conj (etaCoord x j) * (ξ x : Option ℕ → ℂ) j) * etaCoord x i}

/-- The full Fock space `⊕_m K^{⊗m}` of the fibre, indexed by words in `Option ℕ`. -/
abbrev Fock : Type := lp (fun _ : List (Option ℕ) => ℂ) 2

/-- The coordinates of `ζ ⊗ ω` for `ζ ∈ K` and `ω` in the Fock space. -/
def tensorCoord (ζ : Option ℕ → ℂ) (ω : List (Option ℕ) → ℂ) : List (Option ℕ) → ℂ
  | [] => 0
  | i :: w => ζ i * ω w

/-- The sections `ζ₁ ⊗ ⋯ ⊗ ζ_m ⊗ f` of `E^{⊗m}`, `ζ_i ∈ E`, `f ∈ C(B_∞) = E^{⊗0}`. -/
def fockGenerators (E : Set (Sections K)) : ℕ → Set (Sections Fock)
  | 0 => {ω | ∃ f : C(HilbertCube, ℂ), ∀ x w,
      (ω x : List (Option ℕ) → ℂ) w = if w = [] then f x else 0}
  | m + 1 => {ω | ∃ ζ ∈ E, ∃ ω' ∈ fockGenerators E m, ∀ x w,
      (ω x : List (Option ℕ) → ℂ) w =
        tensorCoord (ζ x : Option ℕ → ℂ) (ω' x : List (Option ℕ) → ℂ) w}

/-- The Fock module `F(E) = ⊕_m E^{⊗m}` (Blanchard, Definition 5.1, p. 7). -/
def fockModule (E : Set (Sections K)) : Submodule ℂ (Sections Fock) :=
  (Submodule.span ℂ (⋃ m, fockGenerators E m)).topologicalClosure

/-- `S` is the adjoint of `T`: `⟨T ξ, η⟩ = ⟨ξ, S η⟩` at every point of `B_∞`. -/
def IsSectionAdjoint {M : Submodule ℂ (Sections Fock)} (T S : Module.End ℂ M) : Prop :=
  ∀ ξ η : M, ∀ x, ⟪((T ξ : M) : Sections Fock) x, (η : Sections Fock) x⟫_ℂ =
    ⟪(ξ : Sections Fock) x, ((S η : M) : Sections Fock) x⟫_ℂ

/-- The Toeplitz algebra `𝒯(E)`: the unital C*-algebra of operators on `F(E)` generated by the
creation operators `ℓ(ζ) ω = ζ ⊗ ω`, `ζ ∈ E` (Blanchard, Definition 5.1, p. 7). -/
def toeplitzAlgebra (E : Set (Sections K)) : Set (Module.End ℂ (fockModule E)) :=
  ⋂₀ {𝒯 | 1 ∈ 𝒯 ∧
    (∀ ζ ∈ E, ∀ T : Module.End ℂ (fockModule E), (∀ ω x w,
      (((T ω : fockModule E) : Sections Fock) x : List (Option ℕ) → ℂ) w =
        tensorCoord (ζ x : Option ℕ → ℂ) ((ω : Sections Fock) x : List (Option ℕ) → ℂ) w) →
      T ∈ 𝒯) ∧
    (∀ S ∈ 𝒯, ∀ T ∈ 𝒯, S + T ∈ 𝒯) ∧
    (∀ c : ℂ, ∀ T ∈ 𝒯, c • T ∈ 𝒯) ∧
    (∀ S ∈ 𝒯, ∀ T ∈ 𝒯, S * T ∈ 𝒯) ∧
    (∀ T ∈ 𝒯, ∀ S, IsSectionAdjoint T S → S ∈ 𝒯) ∧
    (∀ T : Module.End ℂ (fockModule E), (∀ ε > (0 : ℝ), ∃ S ∈ 𝒯, ∀ ω,
      ‖((T ω : fockModule E) : Sections Fock) - ((S ω : fockModule E) : Sections Fock)‖ ≤
        ε * ‖(ω : Sections Fock)‖) → T ∈ 𝒯)}

/-- A set of operators is properly infinite when it contains two isometries with mutually
orthogonal range projections (Blanchard, Remark 2.2(b), p. 2). -/
def IsProperlyInfiniteSet {M : Submodule ℂ (Sections Fock)} (𝒜 : Set (Module.End ℂ M)) : Prop :=
  ∃ s₁ ∈ 𝒜, ∃ s₂ ∈ 𝒜, ∃ t₁ t₂ : Module.End ℂ M, IsSectionAdjoint s₁ t₁ ∧
    IsSectionAdjoint s₂ t₂ ∧ t₁ * s₁ = 1 ∧ t₂ * s₂ = 1 ∧ (s₁ * t₁) * (s₂ * t₂) = 0

-- END SHARED BLOCK

