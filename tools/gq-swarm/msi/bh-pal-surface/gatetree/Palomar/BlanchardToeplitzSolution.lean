/-! ### The development's Fock vocabulary -/

theorem tensorCoord_eq (ζ : Option ℕ → ℂ) (ω : List (Option ℕ) → ℂ) (w : List (Option ℕ)) :
    tensorCoord ζ ω w = GroupApproximation.Toeplitz.tensorCoord ζ ω w := by
  cases w <;> rfl

theorem fockGenerators_eq (E : Set (Sections K)) :
    ∀ m, fockGenerators E m =
      GroupApproximation.Toeplitz.fockGenerators (X := HilbertCube) (ι := Option ℕ) E m
  | 0 => rfl
  | m + 1 => by
    ext ω
    rw [GroupApproximation.Toeplitz.mem_fockGenerators_succ, ← fockGenerators_eq E m]
    simp only [← tensorCoord_eq] <;> exact Iff.rfl

theorem fockModule_eq (E : Set (Sections K)) :
    fockModule E =
      GroupApproximation.Toeplitz.fockModule (X := HilbertCube) (ι := Option ℕ) E := by
  simp only [fockModule, GroupApproximation.Toeplitz.fockModule, fockGenerators_eq]

theorem isFockInvariant_fockModule (E : Set (Sections K)) :
    IsFockInvariant (X := HilbertCube) (ι := Option ℕ) E (fockModule E) := by
  rw [fockModule_eq]
  exact ⟨fun _ hζ => GroupApproximation.Toeplitz.creationSec_mem_fockModule hζ,
    fun _ hcont => GroupApproximation.Toeplitz.annihilationSec_mem_fockModule hcont⟩

/-! ### The topology of the Hilbert cube -/

theorem ennreal_two_ne_zero : (2 : ℝ≥0∞) ≠ 0 := by norm_num

theorem norm_coord_sub_le (x y : HilbertCube) (p : ℕ) :
    ‖(x.1 : ℕ → ℂ) p - (y.1 : ℕ → ℂ) p‖ ≤ 2 := by
  have hx := lp.norm_apply_le_norm ennreal_two_ne_zero x.1 p
  have hy := lp.norm_apply_le_norm ennreal_two_ne_zero y.1 p
  linarith [norm_sub_le ((x.1 : ℕ → ℂ) p) ((y.1 : ℕ → ℂ) p), x.2, y.2]

theorem summable_cubeDist (x y : HilbertCube) :
    Summable fun p : ℕ => (2 : ℝ)⁻¹ ^ (p + 2) * ‖(x.1 : ℕ → ℂ) p - (y.1 : ℕ → ℂ) p‖ := by
  refine Summable.of_nonneg_of_le (fun p => by positivity) (fun p => ?_)
    ((summable_geometric_of_lt_one (by norm_num : (0 : ℝ) ≤ 2⁻¹) (by norm_num)).mul_right 2⁻¹)
  calc (2 : ℝ)⁻¹ ^ (p + 2) * ‖(x.1 : ℕ → ℂ) p - (y.1 : ℕ → ℂ) p‖
      ≤ (2 : ℝ)⁻¹ ^ (p + 2) * 2 := by gcongr; exact norm_coord_sub_le x y p
    _ = (2 : ℝ)⁻¹ ^ p * 2⁻¹ := by ring

theorem coord_le_cubeDist (x y : HilbertCube) (p : ℕ) :
    (2 : ℝ)⁻¹ ^ (p + 2) * ‖(x.1 : ℕ → ℂ) p - (y.1 : ℕ → ℂ) p‖ ≤ cubeDist x y :=
  (summable_cubeDist x y).le_tsum p fun _ _ => mul_nonneg (by positivity) (norm_nonneg _)

theorem cubeDist_self (x : HilbertCube) : cubeDist x x = 0 := by
  simp [cubeDist]

theorem ball_mem_nhds (x : HilbertCube) {δ : ℝ} (hδ : 0 < δ) :
    {y | cubeDist x y < δ} ∈ 𝓝 x := by
  refine IsOpen.mem_nhds (TopologicalSpace.isOpen_generateFrom_of_mem ⟨x, δ, rfl⟩) ?_
  show cubeDist x x < δ
  rw [cubeDist_self]
  exact hδ

/-- Each coordinate `x ↦ xₚ` is continuous on `B_∞`, since `2^{-p-2} |xₚ - yₚ| ≤ d(x, y)`. -/
theorem continuous_coord (p : ℕ) : Continuous fun x : HilbertCube => (x.1 : ℕ → ℂ) p := by
  refine continuous_iff_continuousAt.2 fun x => Metric.tendsto_nhds.2 fun ε hε => ?_
  have hc : (0 : ℝ) < (2 : ℝ)⁻¹ ^ (p + 2) := by positivity
  filter_upwards [ball_mem_nhds x (mul_pos hc hε)] with y hy
  rw [dist_eq_norm, norm_sub_rev]
  exact lt_of_mul_lt_mul_left ((coord_le_cubeDist x y p).trans_lt hy) hc.le

theorem continuous_of_forall_dist_lt {f : HilbertCube → ℂ}
    (h : ∀ ε > 0, ∃ F : HilbertCube → ℂ, Continuous F ∧ ∀ x, dist (f x) (F x) < ε) :
    Continuous f := by
  refine continuous_of_uniform_approx_of_continuous fun u hu => ?_
  obtain ⟨ε, hε, hεu⟩ := Metric.mem_uniformity_dist.1 hu
  obtain ⟨F, hF, hfF⟩ := h ε hε
  exact ⟨F, hF, fun x => hεu (hfF x)⟩

/-! ### The vector `η(x) = x ⊕ √(1 - ‖x‖²)` -/

/-- The coordinates of `v ⊕ 0` in `K`. -/
def shiftCoord (v : L2) : Option ℕ → ℂ
  | none => 0
  | some p => (v : ℕ → ℂ) p

theorem memℓp_shiftCoord (v : L2) : Memℓp (shiftCoord v) 2 := by
  have hp : 0 < (2 : ℝ≥0∞).toReal := by norm_num
  refine memℓp_gen ?_
  have h0 : ∀ j ∉ Set.range (some : ℕ → Option ℕ),
      ‖shiftCoord v j‖ ^ (2 : ℝ≥0∞).toReal = 0 := by
    rintro (_ | p) hj
    · show ‖(0 : ℂ)‖ ^ _ = 0
      rw [norm_zero, Real.zero_rpow hp.ne']
    · exact (hj ⟨p, rfl⟩).elim
  exact ((Option.some_injective ℕ).summable_iff h0).1 ((memℓp_gen_iff hp).1 (lp.memℓp v))

/-- `v ⊕ 0 ∈ K`. -/
def shiftVec (v : L2) : K := ⟨shiftCoord v, memℓp_shiftCoord v⟩

theorem shiftVec_apply (v : L2) (j : Option ℕ) : shiftVec v j = shiftCoord v j := rfl

theorem inner_shiftVec (v w : L2) : ⟪shiftVec v, shiftVec w⟫_ℂ = ⟪v, w⟫_ℂ := by
  rw [lp.inner_eq_tsum, lp.inner_eq_tsum, ← (Option.some_injective ℕ).tsum_eq]
  · rfl
  · intro j hj
    cases j with
    | none =>
      exact (Function.mem_support.1 hj (by simp [shiftVec_apply, shiftCoord])).elim
    | some p => exact ⟨p, rfl⟩

theorem norm_shiftVec (v : L2) : ‖shiftVec v‖ = ‖v‖ := by
  have h : ((‖shiftVec v‖ : ℝ) : ℂ) ^ 2 = ((‖v‖ : ℝ) : ℂ) ^ 2 :=
    (inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (shiftVec v)).symm.trans
      ((inner_shiftVec v v).trans (inner_self_eq_norm_sq_to_K (𝕜 := ℂ) v))
  have h' : ‖shiftVec v‖ ^ 2 = ‖v‖ ^ 2 := by exact_mod_cast h
  exact (pow_left_inj₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).1 h'

theorem norm_shiftVec_le (x : HilbertCube) : ‖shiftVec x.1‖ ≤ 1 :=
  (norm_shiftVec x.1).trans_le x.2

/-- `η(x) ∈ K`. -/
def etaVec (x : HilbertCube) : K :=
  lp.single 2 none ((Real.sqrt (1 - ‖x.1‖ ^ 2) : ℝ) : ℂ) + shiftVec x.1

theorem etaVec_apply (x : HilbertCube) (j : Option ℕ) : etaVec x j = etaCoord x j := by
  cases j with
  | none =>
    rw [etaVec, lp.coeFn_add, Pi.add_apply, lp.single_apply, Pi.single_eq_same, shiftVec_apply]
    exact add_zero _
  | some p =>
    rw [etaVec, lp.coeFn_add, Pi.add_apply, lp.single_apply,
      Pi.single_eq_of_ne (Option.some_ne_none p), shiftVec_apply]
    exact zero_add _

theorem inner_etaVec_self (x : HilbertCube) : ⟪etaVec x, etaVec x⟫_ℂ = 1 := by
  have h1 : 0 ≤ 1 - ‖x.1‖ ^ 2 := by nlinarith [x.2, norm_nonneg x.1]
  have hee : ∀ a : ℂ, ⟪(lp.single 2 none a : K), lp.single 2 none a⟫_ℂ = conj a * a := fun a => by
    rw [lp.inner_single_left, lp.single_apply_self, RCLike.inner_apply']
  have hs : ∀ a : ℂ, ⟪(lp.single 2 none a : K), shiftVec x.1⟫_ℂ = 0 := fun a => by
    rw [lp.inner_single_left, shiftVec_apply]
    exact inner_zero_right _
  have hs' : ∀ a : ℂ, ⟪shiftVec x.1, (lp.single 2 none a : K)⟫_ℂ = 0 := fun a => by
    rw [lp.inner_single_right, shiftVec_apply]
    exact inner_zero_left _
  have hxx : ⟪shiftVec x.1, shiftVec x.1⟫_ℂ = ((‖x.1‖ : ℝ) : ℂ) ^ 2 :=
    (inner_shiftVec x.1 x.1).trans (inner_self_eq_norm_sq_to_K (𝕜 := ℂ) x.1)
  have hcc : conj ((Real.sqrt (1 - ‖x.1‖ ^ 2) : ℝ) : ℂ) * ((Real.sqrt (1 - ‖x.1‖ ^ 2) : ℝ) : ℂ) =
      ((1 - ‖x.1‖ ^ 2 : ℝ) : ℂ) := by
    rw [Complex.conj_ofReal, ← Complex.ofReal_mul, Real.mul_self_sqrt h1]
  rw [etaVec, inner_add_left, inner_add_right, inner_add_right, hee, hs, hs', hxx, hcc]
  push_cast
  ring

theorem norm_etaVec (x : HilbertCube) : ‖etaVec x‖ = 1 := by
  have h : ((‖etaVec x‖ : ℝ) : ℂ) ^ 2 = 1 :=
    (inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (etaVec x)).symm.trans (inner_etaVec_self x)
  have h' : ‖etaVec x‖ ^ 2 = 1 ^ 2 := by rw [one_pow]; exact_mod_cast h
  exact (pow_left_inj₀ (norm_nonneg _) zero_le_one two_ne_zero).1 h'

theorem tsum_etaCoord_eq_inner (x : HilbertCube) (v : K) :
    ∑' j, conj (etaCoord x j) * (v : Option ℕ → ℂ) j = ⟪etaVec x, v⟫_ℂ := by
  rw [lp.inner_eq_tsum]
  exact tsum_congr fun j => by rw [RCLike.inner_apply', etaVec_apply]

/-! ### Continuity of `x ↦ ⟪x ⊕ 0, ξ(x)⟫` -/

theorem continuous_shiftCoord (j : Option ℕ) :
    Continuous fun x : HilbertCube => shiftCoord x.1 j := by
  cases j with
  | none =>
    show Continuous fun _ : HilbertCube => (0 : ℂ)
    exact continuous_const
  | some p => exact continuous_coord p

/-- Uniform approximation by the finite truncations of `w`. -/
theorem continuous_inner_shiftVec_const (w : K) :
    Continuous fun x : HilbertCube => ⟪shiftVec x.1, w⟫_ℂ := by
  refine continuous_of_forall_dist_lt fun ε hε => ?_
  have hsum := lp.hasSum_single ENNReal.ofNat_ne_top w
  rw [HasSum, Metric.tendsto_nhds] at hsum
  obtain ⟨s, hs⟩ := (hsum ε hε).exists
  refine ⟨fun x => ∑ i ∈ s, ⟪shiftVec x.1, lp.single 2 i (w i)⟫_ℂ,
    continuous_finsetSum s fun i _ => ?_, fun x => ?_⟩
  · simp only [lp.inner_single_right, shiftVec_apply]
    exact (continuous_shiftCoord i).inner continuous_const
  · show dist ⟪shiftVec x.1, w⟫_ℂ (∑ i ∈ s, ⟪shiftVec x.1, lp.single 2 i (w i)⟫_ℂ) < ε
    rw [dist_eq_norm, ← inner_sum, ← inner_sub_right]
    calc ‖⟪shiftVec x.1, w - ∑ i ∈ s, lp.single 2 i (w i)⟫_ℂ‖
        ≤ ‖shiftVec x.1‖ * ‖w - ∑ i ∈ s, lp.single 2 i (w i)‖ := norm_inner_le_norm _ _
      _ ≤ 1 * ‖w - ∑ i ∈ s, lp.single 2 i (w i)‖ := by gcongr; exact norm_shiftVec_le x
      _ < ε := by rw [one_mul, ← dist_eq_norm, dist_comm]; exact hs

theorem continuous_inner_shiftVec {ξ : HilbertCube → K} (hξ : Continuous ξ) :
    Continuous fun x : HilbertCube => ⟪shiftVec x.1, ξ x⟫_ℂ := by
  refine continuous_iff_continuousAt.2 fun x => Metric.tendsto_nhds.2 fun ε hε => ?_
  have h1 := Metric.tendsto_nhds.1 ((continuous_inner_shiftVec_const (ξ x)).tendsto x) (ε / 2)
    (half_pos hε)
  have h2 := Metric.tendsto_nhds.1 (hξ.tendsto x) (ε / 2) (half_pos hε)
  filter_upwards [h1, h2] with y hy1 hy2
  calc dist ⟪shiftVec y.1, ξ y⟫_ℂ ⟪shiftVec x.1, ξ x⟫_ℂ
      ≤ dist ⟪shiftVec y.1, ξ y⟫_ℂ ⟪shiftVec y.1, ξ x⟫_ℂ +
          dist ⟪shiftVec y.1, ξ x⟫_ℂ ⟪shiftVec x.1, ξ x⟫_ℂ := dist_triangle _ _ _
    _ < ε / 2 + ε / 2 := by
      refine add_lt_add_of_le_of_lt ?_ hy1
      rw [dist_eq_norm, ← inner_sub_right]
      calc ‖⟪shiftVec y.1, ξ y - ξ x⟫_ℂ‖ ≤ ‖shiftVec y.1‖ * ‖ξ y - ξ x‖ := norm_inner_le_norm _ _
        _ ≤ 1 * ‖ξ y - ξ x‖ := by gcongr; exact norm_shiftVec_le y
        _ ≤ ε / 2 := by rw [one_mul, ← dist_eq_norm]; exact hy2.le
    _ = ε := add_halves ε

/-! ### The sections `z_n = e_n - \bar{x_n} η` of `E_DD` -/

/-- `e_n - \bar{x_n} η(x)`, the component of `e_n` orthogonal to `η(x)`. -/
def baseVec (n : ℕ) (x : HilbertCube) : K :=
  (lp.single 2 (some n) (1 : ℂ) : K) - conj ((x.1 : ℕ → ℂ) n) • etaVec x

theorem norm_baseVec_le (n : ℕ) (x : HilbertCube) : ‖baseVec n x‖ ≤ 2 := by
  have hx : ‖(x.1 : ℕ → ℂ) n‖ ≤ 1 := (lp.norm_apply_le_norm ennreal_two_ne_zero x.1 n).trans x.2
  calc ‖baseVec n x‖
      ≤ ‖(lp.single 2 (some n) (1 : ℂ) : K)‖ + ‖conj ((x.1 : ℕ → ℂ) n) • etaVec x‖ :=
        norm_sub_le _ _
    _ = 1 + ‖(x.1 : ℕ → ℂ) n‖ := by
      rw [lp.norm_single (pos_iff_ne_zero.2 ennreal_two_ne_zero), norm_one, norm_smul,
        Complex.norm_conj, norm_etaVec, mul_one]
    _ ≤ 2 := by linarith

/-- The section `z_n`. -/
def base (n : ℕ) : Sections K :=
  ⟨baseVec n, memℓp_infty ⟨2, by rintro _ ⟨x, rfl⟩; exact norm_baseVec_le n x⟩⟩

theorem base_apply (n : ℕ) (x : HilbertCube) : base n x = baseVec n x := rfl

/-- `h·z_n` for a bounded function `h`. -/
def zsec (h : HilbertCube → ℂ) {B : ℝ} (hB : ∀ x, ‖h x‖ ≤ B) (n : ℕ) : Sections K :=
  smulSec h hB (base n)

theorem inner_single_etaVec (n : ℕ) (x : HilbertCube) :
    ⟪(lp.single 2 (some n) (1 : ℂ) : K), etaVec x⟫_ℂ = (x.1 : ℕ → ℂ) n := by
  rw [lp.inner_single_left, etaVec_apply, RCLike.inner_apply', map_one, one_mul]
  rfl

theorem inner_etaVec_single (n : ℕ) (x : HilbertCube) :
    ⟪etaVec x, (lp.single 2 (some n) (1 : ℂ) : K)⟫_ℂ = conj ((x.1 : ℕ → ℂ) n) := by
  rw [← inner_conj_symm, inner_single_etaVec]

theorem inner_baseVec_etaVec (n : ℕ) (x : HilbertCube) : ⟪baseVec n x, etaVec x⟫_ℂ = 0 := by
  rw [baseVec, inner_sub_left, inner_smul_left, inner_single_etaVec, inner_etaVec_self,
    starRingEnd_self_apply, mul_one, sub_self]

theorem inner_baseVec_baseVec (n m : ℕ) (x : HilbertCube) :
    ⟪baseVec n x, baseVec m x⟫_ℂ =
      (if n = m then 1 else 0) - (x.1 : ℕ → ℂ) n * conj ((x.1 : ℕ → ℂ) m) := by
  have hnm : ⟪(lp.single 2 (some n) (1 : ℂ) : K), (lp.single 2 (some m) (1 : ℂ) : K)⟫_ℂ =
      if n = m then 1 else 0 := by
    rw [lp.inner_single_left, lp.single_apply]
    by_cases h : n = m
    · subst h
      rw [Pi.single_eq_same, if_pos rfl, RCLike.inner_apply', map_one, one_mul]
    · rw [Pi.single_eq_of_ne (fun h' => h (Option.some_injective ℕ h')), if_neg h,
        inner_zero_right]
  rw [baseVec, baseVec, inner_sub_left, inner_sub_right, inner_sub_right, inner_smul_left,
    inner_smul_left, inner_smul_right, inner_smul_right, hnm, inner_single_etaVec,
    inner_etaVec_single, inner_etaVec_self, starRingEnd_self_apply]
  ring

theorem inner_zsec_zsec (c d : HilbertCube → ℂ) {B C : ℝ} (hc : ∀ x, ‖c x‖ ≤ B)
    (hd : ∀ x, ‖d x‖ ≤ C) (n m : ℕ) (x : HilbertCube) :
    ⟪zsec c hc n x, zsec d hd m x⟫_ℂ = conj (c x) *
      (d x * ((if n = m then 1 else 0) - (x.1 : ℕ → ℂ) n * conj ((x.1 : ℕ → ℂ) m))) := by
  rw [zsec, zsec, smulSec_apply, smulSec_apply, inner_smul_left, inner_smul_right, base_apply,
    base_apply, inner_baseVec_baseVec]

/-- The constant section `e_n`. -/
def singleSec (n : ℕ) : Sections K :=
  ⟨fun _ => (lp.single 2 (some n) (1 : ℂ) : K), memℓp_infty ⟨1, by
    rintro _ ⟨x, rfl⟩
    exact (lp.norm_single (E := fun _ : Option ℕ => ℂ) (pos_iff_ne_zero.2 ennreal_two_ne_zero)
      (some n) (1 : ℂ)).trans_le norm_one.le⟩⟩

theorem smulSec_singleSec_mem {h : HilbertCube → ℂ} (hh : Continuous h) {B : ℝ}
    (hB : ∀ x, ‖h x‖ ≤ B) (n : ℕ) : smulSec h hB (singleSec n) ∈ continuousSections := by
  refine ⟨?_, fun x => ?_⟩
  · show Continuous fun x => h x • (lp.single 2 (some n) (1 : ℂ) : K)
    exact hh.smul continuous_const
  · show (h x • (lp.single 2 (some n) (1 : ℂ) : K)) none = 0
    rw [lp.coeFn_smul, Pi.smul_apply, lp.single_apply,
      Pi.single_eq_of_ne (Option.some_ne_none n).symm, smul_zero]

theorem zsec_mem_ddModule {h : HilbertCube → ℂ} (hh : Continuous h) {B : ℝ}
    (hB : ∀ x, ‖h x‖ ≤ B) (n : ℕ) : zsec h hB n ∈ ddModule := by
  refine ⟨smulSec h hB (singleSec n),
    Submodule.le_topologicalClosure (Submodule.span ℂ (continuousSections ∪ etaMultiples))
      (Submodule.subset_span (Or.inl (smulSec_singleSec_mem hh hB n))), fun x i => ?_⟩
  rw [tsum_etaCoord_eq_inner]
  show (h x • baseVec n x : K) i = (h x • (lp.single 2 (some n) (1 : ℂ) : K) : K) i -
    ⟪etaVec x, h x • (lp.single 2 (some n) (1 : ℂ) : K)⟫_ℂ * etaCoord x i
  rw [inner_smul_right, inner_etaVec_single]
  simp only [baseVec, lp.coeFn_smul, lp.coeFn_sub, Pi.smul_apply, Pi.sub_apply, smul_eq_mul,
    etaVec_apply]
  ring

/-! ### Every element of `F̈` has continuous coordinates and continuous `η`-coefficient -/

/-- Sections whose coordinates `ξ(x)_n` and whose coefficient `⟨η(x), ξ(x)⟩` are continuous. -/
def weakSub : Submodule ℂ (Sections K) where
  carrier := {ξ | (∀ n : ℕ, Continuous fun x => (ξ x : Option ℕ → ℂ) (some n)) ∧
    Continuous fun x => ⟪etaVec x, ξ x⟫_ℂ}
  add_mem' := by
    rintro ξ ζ ⟨hξ1, hξ2⟩ ⟨hζ1, hζ2⟩
    refine ⟨fun n => ?_, ?_⟩
    · simp only [lp.coeFn_add, Pi.add_apply]
      exact (hξ1 n).add (hζ1 n)
    · simp only [lp.coeFn_add, Pi.add_apply, inner_add_right]
      exact hξ2.add hζ2
  zero_mem' := by
    refine ⟨fun n => ?_, ?_⟩
    · simp only [lp.coeFn_zero, Pi.zero_apply]
      exact continuous_const
    · simp only [lp.coeFn_zero, Pi.zero_apply, inner_zero_right]
      exact continuous_const
  smul_mem' := by
    rintro c ξ ⟨hξ1, hξ2⟩
    refine ⟨fun n => ?_, ?_⟩
    · simp only [lp.coeFn_smul, Pi.smul_apply, smul_eq_mul]
      exact continuous_const.mul (hξ1 n)
    · simp only [lp.coeFn_smul, Pi.smul_apply, inner_smul_right]
      exact continuous_const.mul hξ2

theorem mem_weakSub {ξ : Sections K} : ξ ∈ weakSub ↔
    (∀ n : ℕ, Continuous fun x => (ξ x : Option ℕ → ℂ) (some n)) ∧
      Continuous fun x => ⟪etaVec x, ξ x⟫_ℂ := Iff.rfl

theorem isClosed_weakSub : IsClosed (weakSub : Set (Sections K)) := by
  refine isClosed_of_closure_subset fun ξ hξ => (mem_weakSub (ξ := ξ)).2 ⟨fun n => ?_, ?_⟩
  · refine continuous_of_forall_dist_lt fun ε hε => ?_
    obtain ⟨ζ, hζ, hξζ⟩ := Metric.mem_closure_iff.1 hξ ε hε
    refine ⟨fun x => (ζ x : Option ℕ → ℂ) (some n), ((mem_weakSub (ξ := ζ)).1 hζ).1 n,
      fun x => ?_⟩
    calc dist ((ξ x : Option ℕ → ℂ) (some n)) ((ζ x : Option ℕ → ℂ) (some n))
        = ‖((ξ - ζ) x : Option ℕ → ℂ) (some n)‖ := by
          simp only [dist_eq_norm, lp.coeFn_sub, Pi.sub_apply]
      _ ≤ ‖(ξ - ζ) x‖ := lp.norm_apply_le_norm ennreal_two_ne_zero _ _
      _ ≤ ‖ξ - ζ‖ := lp.norm_apply_le_norm ENNReal.top_ne_zero _ _
      _ < ε := by rw [← dist_eq_norm]; exact hξζ
  · refine continuous_of_forall_dist_lt fun ε hε => ?_
    obtain ⟨ζ, hζ, hξζ⟩ := Metric.mem_closure_iff.1 hξ ε hε
    refine ⟨fun x => ⟪etaVec x, ζ x⟫_ℂ, ((mem_weakSub (ξ := ζ)).1 hζ).2, fun x => ?_⟩
    calc dist ⟪etaVec x, ξ x⟫_ℂ ⟪etaVec x, ζ x⟫_ℂ = ‖⟪etaVec x, (ξ - ζ) x⟫_ℂ‖ := by
          rw [dist_eq_norm, ← inner_sub_right, lp.coeFn_sub, Pi.sub_apply]
      _ ≤ ‖etaVec x‖ * ‖(ξ - ζ) x‖ := norm_inner_le_norm _ _
      _ = ‖(ξ - ζ) x‖ := by rw [norm_etaVec, one_mul]
      _ ≤ ‖ξ - ζ‖ := lp.norm_apply_le_norm ENNReal.top_ne_zero _ _
      _ < ε := by rw [← dist_eq_norm]; exact hξζ

theorem moduleF_le_weakSub : moduleF ≤ weakSub := by
  refine Submodule.topologicalClosure_minimal _ (Submodule.span_le.2 ?_) isClosed_weakSub
  rintro ξ (⟨hcont, hnone⟩ | ⟨f, hf⟩)
  · refine (mem_weakSub (ξ := ξ)).2 ⟨fun n => ?_, ?_⟩
    · refine ((continuous_const : Continuous fun _ : HilbertCube =>
        (lp.single 2 (some n) (1 : ℂ) : K)).inner hcont).congr fun x => ?_
      show ⟪(lp.single 2 (some n) (1 : ℂ) : K), ξ x⟫_ℂ = (ξ x : Option ℕ → ℂ) (some n)
      rw [lp.inner_single_left, RCLike.inner_apply', map_one, one_mul]
    · refine (continuous_inner_shiftVec hcont).congr fun x => ?_
      show ⟪shiftVec x.1, ξ x⟫_ℂ = ⟪etaVec x, ξ x⟫_ℂ
      rw [etaVec, inner_add_left, lp.inner_single_left, hnone x, inner_zero_right, zero_add]
  · have hξη : ∀ x, ξ x = f x • etaVec x := fun x => lp.ext <| funext fun i => by
      rw [hf x i, lp.coeFn_smul, Pi.smul_apply, etaVec_apply, smul_eq_mul]
    refine (mem_weakSub (ξ := ξ)).2 ⟨fun n => ?_, ?_⟩
    · refine (f.continuous.mul (continuous_coord n)).congr fun x => ?_
      show f x * (x.1 : ℕ → ℂ) n = (ξ x : Option ℕ → ℂ) (some n)
      rw [hf x (some n)]
      rfl
    · refine f.continuous.congr fun x => ?_
      show f x = ⟪etaVec x, ξ x⟫_ℂ
      rw [hξη x, inner_smul_right, inner_etaVec_self, mul_one]

theorem continuous_inner_baseVec {ζ : Sections K} (hζ : ζ ∈ ddModule) (n : ℕ) :
    Continuous fun x => ⟪baseVec n x, ζ x⟫_ℂ := by
  obtain ⟨ξ, hξ, hζξ⟩ := hζ
  obtain ⟨hξ1, hξ2⟩ := (mem_weakSub (ξ := ξ)).1 (moduleF_le_weakSub hξ)
  have hζx : ∀ x, ζ x = ξ x - ⟪etaVec x, ξ x⟫_ℂ • etaVec x := fun x =>
    lp.ext <| funext fun i => by
      rw [hζξ x i, tsum_etaCoord_eq_inner, lp.coeFn_sub, Pi.sub_apply, lp.coeFn_smul,
        Pi.smul_apply, etaVec_apply, smul_eq_mul]
  refine ((hξ1 n).sub ((continuous_coord n).mul hξ2)).congr fun x => ?_
  show (ξ x : Option ℕ → ℂ) (some n) - (x.1 : ℕ → ℂ) n * ⟪etaVec x, ξ x⟫_ℂ =
    ⟪baseVec n x, ζ x⟫_ℂ
  rw [hζx x, inner_sub_right, inner_smul_right, inner_baseVec_etaVec, mul_zero, sub_zero,
    baseVec, inner_sub_left, inner_smul_left, starRingEnd_self_apply, lp.inner_single_left,
    RCLike.inner_apply', map_one, one_mul]

/-- `h·z_n` is admissible for `E_DD`: it lies in `E_DD` and pairs continuously with `E_DD`. -/
theorem isAdmissible_zsec {h : HilbertCube → ℂ} (hh : Continuous h) {B : ℝ}
    (hB : ∀ x, ‖h x‖ ≤ B) (n : ℕ) :
    IsAdmissible (X := HilbertCube) (ι := Option ℕ) ddModule (zsec h hB n) :=
  ⟨zsec_mem_ddModule hh hB n, fun ζ hζ => ((Complex.continuous_conj.comp hh).mul
    (continuous_inner_baseVec hζ n)).congr fun x => by
      show conj (h x) * ⟪baseVec n x, ζ x⟫_ℂ = ⟪h x • baseVec n x, ζ x⟫_ℂ
      rw [inner_smul_left]⟩

/-! ### Two blocks of three coordinates and the coefficients of the two isometries -/

/-- The coordinates `0, 1, 2` and `3, 4, 5`. -/
def idx (k : Fin 3 ⊕ Fin 3) : ℕ := (finSumFinEquiv k : Fin (3 + 3)).val

theorem idx_injective : Function.Injective idx :=
  Fin.val_injective.comp finSumFinEquiv.injective

theorem ite_idx (i j : Fin 3 ⊕ Fin 3) :
    (if idx i = idx j then (1 : ℂ) else 0) = if i = j then 1 else 0 := by
  by_cases h : i = j
  · rw [if_pos (congrArg idx h), if_pos h]
  · rw [if_neg fun h' => h (idx_injective h'), if_neg h]

/-- `x_{idx k}`. -/
def coords (x : HilbertCube) (k : Fin 3 ⊕ Fin 3) : ℂ := (x.1 : ℕ → ℂ) (idx k)

theorem continuous_coords (k : Fin 3 ⊕ Fin 3) : Continuous fun x => coords x k :=
  continuous_coord (idx k)

theorem sum_norm_sq_le_one (x : HilbertCube) {g : Fin 3 → ℕ} (hg : Function.Injective g) :
    ∑ p : Fin 3, ‖(x.1 : ℕ → ℂ) (g p)‖ ^ 2 ≤ 1 := by
  have h := lp.sum_rpow_le_norm_rpow (by norm_num : 0 < (2 : ℝ≥0∞).toReal) x.1
    (Finset.univ.map ⟨g, hg⟩)
  rw [Finset.sum_map] at h
  simp only [Function.Embedding.coeFn_mk, ENNReal.toReal_ofNat, Real.rpow_two] at h
  exact h.trans (pow_le_one₀ (norm_nonneg _) x.2)

/-- `βI = ∑_{p<3} |x_p|²`. -/
def betaI (x : HilbertCube) : ℝ := ∑ p : Fin 3, ‖coords x (Sum.inl p)‖ ^ 2

/-- `βJ = ∑_{p<3} |x_{p+3}|²`. -/
def betaJ (x : HilbertCube) : ℝ := ∑ p : Fin 3, ‖coords x (Sum.inr p)‖ ^ 2

/-- `τI = ∑_{p<3} x_p²`. -/
def tauI (x : HilbertCube) : ℂ := ∑ p : Fin 3, coords x (Sum.inl p) ^ 2

/-- `τJ = ∑_{p<3} x_{p+3}²`. -/
def tauJ (x : HilbertCube) : ℂ := ∑ p : Fin 3, coords x (Sum.inr p) ^ 2

theorem betaI_le_one (x : HilbertCube) : betaI x ≤ 1 :=
  sum_norm_sq_le_one x (idx_injective.comp Sum.inl_injective)

theorem betaJ_le_one (x : HilbertCube) : betaJ x ≤ 1 :=
  sum_norm_sq_le_one x (idx_injective.comp Sum.inr_injective)

theorem betaI_nonneg (x : HilbertCube) : 0 ≤ betaI x :=
  Finset.sum_nonneg fun _ _ => sq_nonneg _

theorem norm_tauI_le (x : HilbertCube) : ‖tauI x‖ ≤ 1 :=
  calc ‖tauI x‖ ≤ ∑ p : Fin 3, ‖coords x (Sum.inl p) ^ 2‖ := norm_sum_le _ _
    _ = betaI x := Finset.sum_congr rfl fun _ _ => Complex.norm_pow _ 2
    _ ≤ 1 := betaI_le_one x

theorem norm_tauJ_le (x : HilbertCube) : ‖tauJ x‖ ≤ 1 :=
  calc ‖tauJ x‖ ≤ ∑ p : Fin 3, ‖coords x (Sum.inr p) ^ 2‖ := norm_sum_le _ _
    _ = betaJ x := Finset.sum_congr rfl fun _ _ => Complex.norm_pow _ 2
    _ ≤ 1 := betaJ_le_one x

theorem continuous_betaI : Continuous betaI := by
  show Continuous fun x : HilbertCube => ∑ p : Fin 3, ‖coords x (Sum.inl p)‖ ^ 2
  exact continuous_finsetSum _ fun p _ => (continuous_coords (Sum.inl p)).norm.pow 2

theorem continuous_betaJ : Continuous betaJ := by
  show Continuous fun x : HilbertCube => ∑ p : Fin 3, ‖coords x (Sum.inr p)‖ ^ 2
  exact continuous_finsetSum _ fun p _ => (continuous_coords (Sum.inr p)).norm.pow 2

theorem continuous_tauI : Continuous tauI := by
  show Continuous fun x : HilbertCube => ∑ p : Fin 3, coords x (Sum.inl p) ^ 2
  exact continuous_finsetSum _ fun p _ => (continuous_coords (Sum.inl p)).pow 2

theorem continuous_tauJ : Continuous tauJ := by
  show Continuous fun x : HilbertCube => ∑ p : Fin 3, coords x (Sum.inr p) ^ 2
  exact continuous_finsetSum _ fun p _ => (continuous_coords (Sum.inr p)).pow 2

theorem sum_mul_conj_inl (x : HilbertCube) :
    ∑ p : Fin 3, coords x (Sum.inl p) * conj (coords x (Sum.inl p)) = (betaI x : ℂ) := by
  rw [betaI, Complex.ofReal_sum]
  exact Finset.sum_congr rfl fun _ _ => GroupApproximation.Toeplitz.mul_conj_eq_norm_sq _

theorem sum_mul_conj_inr (x : HilbertCube) :
    ∑ p : Fin 3, coords x (Sum.inr p) * conj (coords x (Sum.inr p)) = (betaJ x : ℂ) := by
  rw [betaJ, Complex.ofReal_sum]
  exact Finset.sum_congr rfl fun _ _ => GroupApproximation.Toeplitz.mul_conj_eq_norm_sq _

/-- The coefficients of the first isometry: `r` on the first block, `0` on the second. -/
def coefOne : Fin 3 ⊕ Fin 3 → HilbertCube → ℂ :=
  Sum.elim (fun _ x => (isoR (betaI x) (tauI x) : ℂ)) (fun _ _ => 0)

/-- The coefficients of the second isometry: `-g` on the first block, `s` on the second. -/
def coefTwo : Fin 3 ⊕ Fin 3 → HilbertCube → ℂ :=
  Sum.elim (fun _ x => -isoG (betaI x) (betaJ x) (tauI x) (tauJ x))
    (fun _ x => (isoS (betaI x) (betaJ x) (tauI x) (tauJ x) : ℂ))

theorem norm_coefOne_le (k : Fin 3 ⊕ Fin 3) (x : HilbertCube) : ‖coefOne k x‖ ≤ 2 := by
  rcases k with _ | _
  · show ‖((isoR (betaI x) (tauI x) : ℝ) : ℂ)‖ ≤ 2
    rw [Complex.norm_of_nonneg (GroupApproximation.Toeplitz.isoR_nonneg _ _)]
    linarith [GroupApproximation.Toeplitz.isoR_le_one (betaI_le_one x) (tauI x)]
  · show ‖(0 : ℂ)‖ ≤ 2
    rw [norm_zero]
    norm_num

theorem norm_coefTwo_le (k : Fin 3 ⊕ Fin 3) (x : HilbertCube) : ‖coefTwo k x‖ ≤ 2 := by
  rcases k with _ | _
  · show ‖-isoG (betaI x) (betaJ x) (tauI x) (tauJ x)‖ ≤ 2
    rw [norm_neg]
    exact GroupApproximation.Toeplitz.norm_isoG_le_two (betaI_nonneg x) (betaI_le_one x)
      (betaJ_le_one x) (norm_tauI_le x) (norm_tauJ_le x)
  · show ‖((isoS (betaI x) (betaJ x) (tauI x) (tauJ x) : ℝ) : ℂ)‖ ≤ 2
    rw [Complex.norm_of_nonneg (GroupApproximation.Toeplitz.isoS_nonneg _ _ _ _)]
    exact GroupApproximation.Toeplitz.isoS_le_two (betaI_nonneg x) (betaI_le_one x)
      (betaJ_le_one x) (norm_tauI_le x) (tauJ x)

theorem continuous_coefOne (k : Fin 3 ⊕ Fin 3) : Continuous (coefOne k) := by
  rcases k with _ | _
  · show Continuous fun x => ((isoR (betaI x) (tauI x) : ℝ) : ℂ)
    exact Complex.continuous_ofReal.comp
      (GroupApproximation.Toeplitz.continuous_isoR betaI_le_one continuous_betaI continuous_tauI)
  · show Continuous fun _ : HilbertCube => (0 : ℂ)
    exact continuous_const

theorem continuous_coefTwo (k : Fin 3 ⊕ Fin 3) : Continuous (coefTwo k) := by
  rcases k with _ | _
  · show Continuous fun x => -isoG (betaI x) (betaJ x) (tauI x) (tauJ x)
    exact (GroupApproximation.Toeplitz.continuous_isoG betaI_le_one betaJ_le_one continuous_betaI
      continuous_betaJ continuous_tauI continuous_tauJ).neg
  · show Continuous fun x => ((isoS (betaI x) (betaJ x) (tauI x) (tauJ x) : ℝ) : ℂ)
    exact Complex.continuous_ofReal.comp (GroupApproximation.Toeplitz.continuous_isoS
      betaI_le_one betaJ_le_one continuous_betaI continuous_betaJ continuous_tauI continuous_tauJ)

theorem oneBound : ∀ _ : HilbertCube, ‖(1 : ℂ)‖ ≤ 1 := fun _ => norm_one.le

theorem sum_inner_zsec (c d : Fin 3 ⊕ Fin 3 → HilbertCube → ℂ) {B C : ℝ}
    (hc : ∀ k x, ‖c k x‖ ≤ B) (hd : ∀ k x, ‖d k x‖ ≤ C) (x : HilbertCube) :
    ∑ i, ∑ j, ⟪zsec (fun _ => 1) oneBound (idx i) x, zsec (fun _ => 1) oneBound (idx j) x⟫_ℂ *
        ⟪zsec (c i) (hc i) (idx i) x, zsec (d j) (hd j) (idx j) x⟫_ℂ =
      ∑ i, ∑ j, gram (coords x) i j * (conj (c i x) * (d j x * gram (coords x) i j)) := by
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  rw [inner_zsec_zsec, inner_zsec_zsec, ite_idx]
  simp only [gram, coords, map_one]
  ring

theorem sum_one_one (x : HilbertCube) :
    ∑ i, ∑ j, ⟪zsec (fun _ => 1) oneBound (idx i) x, zsec (fun _ => 1) oneBound (idx j) x⟫_ℂ *
        ⟪zsec (coefOne i) (norm_coefOne_le i) (idx i) x,
          zsec (coefOne j) (norm_coefOne_le j) (idx j) x⟫_ℂ = 1 := by
  refine (sum_inner_zsec coefOne coefOne norm_coefOne_le norm_coefOne_le x).trans
    ((GroupApproximation.Toeplitz.sum_gram_mul_gram_blocks (coords x)
      (fun i => conj (coefOne i x)) (fun j => coefOne j x)
      (cI := (isoR (betaI x) (tauI x) : ℂ)) (cJ := 0) (dI := (isoR (betaI x) (tauI x) : ℂ))
      (dJ := 0) (fun _ => Complex.conj_ofReal _) (fun _ => map_zero (starRingEnd ℂ)) (fun _ => rfl)
      (fun _ => rfl)).trans ?_)
  rw [sum_mul_conj_inl, sum_mul_conj_inr]
  exact GroupApproximation.Toeplitz.blockCoeff_one_one (betaI_le_one x) (tauI x) (tauJ x) (betaJ x)

theorem sum_one_two (x : HilbertCube) :
    ∑ i, ∑ j, ⟪zsec (fun _ => 1) oneBound (idx i) x, zsec (fun _ => 1) oneBound (idx j) x⟫_ℂ *
        ⟪zsec (coefOne i) (norm_coefOne_le i) (idx i) x,
          zsec (coefTwo j) (norm_coefTwo_le j) (idx j) x⟫_ℂ = 0 := by
  refine (sum_inner_zsec coefOne coefTwo norm_coefOne_le norm_coefTwo_le x).trans
    ((GroupApproximation.Toeplitz.sum_gram_mul_gram_blocks (coords x)
      (fun i => conj (coefOne i x)) (fun j => coefTwo j x)
      (cI := (isoR (betaI x) (tauI x) : ℂ)) (cJ := 0)
      (dI := -isoG (betaI x) (betaJ x) (tauI x) (tauJ x))
      (dJ := (isoS (betaI x) (betaJ x) (tauI x) (tauJ x) : ℂ)) (fun _ => Complex.conj_ofReal _)
      (fun _ => map_zero (starRingEnd ℂ)) (fun _ => rfl) (fun _ => rfl)).trans ?_)
  rw [sum_mul_conj_inl, sum_mul_conj_inr]
  exact GroupApproximation.Toeplitz.blockCoeff_one_two (betaI_le_one x) (betaJ x) (tauI x)
    (tauJ x) (betaJ x)

theorem sum_two_two (x : HilbertCube) :
    ∑ i, ∑ j, ⟪zsec (fun _ => 1) oneBound (idx i) x, zsec (fun _ => 1) oneBound (idx j) x⟫_ℂ *
        ⟪zsec (coefTwo i) (norm_coefTwo_le i) (idx i) x,
          zsec (coefTwo j) (norm_coefTwo_le j) (idx j) x⟫_ℂ = 1 := by
  refine (sum_inner_zsec coefTwo coefTwo norm_coefTwo_le norm_coefTwo_le x).trans
    ((GroupApproximation.Toeplitz.sum_gram_mul_gram_blocks (coords x)
      (fun i => conj (coefTwo i x)) (fun j => coefTwo j x)
      (cI := -conj (isoG (betaI x) (betaJ x) (tauI x) (tauJ x)))
      (cJ := (isoS (betaI x) (betaJ x) (tauI x) (tauJ x) : ℂ))
      (dI := -isoG (betaI x) (betaJ x) (tauI x) (tauJ x))
      (dJ := (isoS (betaI x) (betaJ x) (tauI x) (tauJ x) : ℂ)) (fun _ => map_neg (starRingEnd ℂ) _)
      (fun _ => Complex.conj_ofReal _) (fun _ => rfl) (fun _ => rfl)).trans ?_)
  rw [sum_mul_conj_inl, sum_mul_conj_inr]
  exact GroupApproximation.Toeplitz.blockCoeff_two_two (betaI_le_one x) (betaJ_le_one x) (tauI x)
    (tauJ x)

/-! ### The theorem -/

theorem mem_toeplitzAlgebra_of_forall (E : Set (Sections K)) {T : Module.End ℂ (fockModule E)}
    (hT : ∀ 𝒯 : Set (Module.End ℂ (fockModule E)),
      IsToeplitzClosed (X := HilbertCube) (ι := Option ℕ) E 𝒯 → T ∈ 𝒯) :
    T ∈ toeplitzAlgebra E := by
  refine Set.mem_sInter.2 fun 𝒯 h𝒯 => hT 𝒯 ?_
  obtain ⟨hone, hcre, hadd, hsmul, hmul, hadj, -⟩ := h𝒯
  exact ⟨hone, fun ζ hζ S hS => hcre ζ hζ S fun ω x w =>
    (hS ω x w).trans (tensorCoord_eq _ _ _).symm, hadd, hsmul, hmul, hadj⟩

/-- **Blanchard's Question 5.4** (arXiv:1507.02535v1, p. 9): the Toeplitz algebra `𝒯(E_DD)` of
the Dixmier–Douady module is properly infinite. -/
theorem blanchard_question_5_4 : IsProperlyInfiniteSet (toeplitzAlgebra ddModule) := by
  obtain ⟨s₁, s₂, t₁, t₂, hmem, h1, h2, h3, h4, h5⟩ :=
    GroupApproximation.Toeplitz.exists_properlyInfinite_of_coeff
      (isFockInvariant_fockModule ddModule)
      (fun k => zsec (fun _ => 1) oneBound (idx k))
      (fun k => zsec (coefOne k) (norm_coefOne_le k) (idx k))
      (fun k => zsec (coefTwo k) (norm_coefTwo_le k) (idx k))
      (fun k => isAdmissible_zsec continuous_const oneBound (idx k))
      (fun k => isAdmissible_zsec (continuous_coefOne k) (norm_coefOne_le k) (idx k))
      (fun k => isAdmissible_zsec (continuous_coefTwo k) (norm_coefTwo_le k) (idx k))
      sum_one_one sum_one_two sum_two_two
  exact ⟨s₁, mem_toeplitzAlgebra_of_forall _ fun 𝒯 h𝒯 => (hmem 𝒯 h𝒯).1,
    s₂, mem_toeplitzAlgebra_of_forall _ fun 𝒯 h𝒯 => (hmem 𝒯 h𝒯).2, t₁, t₂, h1, h2, h3, h4, h5⟩

end

end BlanchardToeplitz
