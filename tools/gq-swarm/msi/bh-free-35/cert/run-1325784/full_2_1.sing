LIB "freegb.lib";
ring r = 0,(x0_0,x0_1,x1_0,x1_1,x2_0,x2_1,x3_0,x3_1,x4_0,x4_1,x5_0,x5_1),dp;
def R = freeAlgebra(r, 4);
setring R;
option(redSB); option(redTail);
ideal I;
I = I, x0_0 + x0_1 - 1, x0_0*x0_0 - x0_0, x0_0*x0_1, x0_1*x0_1 - x0_1, x0_1*x0_0, x1_0 + x1_1 - 1, x1_0*x1_0 - x1_0, x1_0*x1_1, x1_1*x1_1 - x1_1, x1_1*x1_0, x2_0 + x2_1 - 1, x2_0*x2_0 - x2_0, x2_0*x2_1, x2_1*x2_1 - x2_1, x2_1*x2_0, x3_0 + x3_1 - 1, x3_0*x3_0 - x3_0, x3_0*x3_1, x3_1*x3_1 - x3_1, x3_1*x3_0, x4_0 + x4_1 - 1, x4_0*x4_0 - x4_0, x4_0*x4_1, x4_1*x4_1 - x4_1, x4_1*x4_0, x5_0 + x5_1 - 1, x5_0*x5_0 - x5_0, x5_0*x5_1, x5_1*x5_1 - x5_1, x5_1*x5_0, x0_0*x1_0 - x1_0*x0_0, x0_0*x1_1 - x1_1*x0_0, x0_1*x1_0 - x1_0*x0_1, x0_1*x1_1 - x1_1*x0_1, x0_0*x2_0 - x2_0*x0_0, x0_0*x2_1 - x2_1*x0_0, x0_1*x2_0 - x2_0*x0_1, x0_1*x2_1 - x2_1*x0_1, x0_0*x3_0 - x3_0*x0_0, x0_0*x3_1 - x3_1*x0_0, x0_1*x3_0 - x3_0*x0_1, x0_1*x3_1 - x3_1*x0_1, x0_0*x4_0 - x4_0*x0_0, x0_0*x4_1 - x4_1*x0_0, x0_1*x4_0 - x4_0*x0_1, x0_1*x4_1 - x4_1*x0_1, x1_0*x2_0 - x2_0*x1_0, x1_0*x2_1 - x2_1*x1_0, x1_1*x2_0 - x2_0*x1_1, x1_1*x2_1 - x2_1*x1_1, x1_0*x3_0 - x3_0*x1_0, x1_0*x3_1 - x3_1*x1_0, x1_1*x3_0 - x3_0*x1_1, x1_1*x3_1 - x3_1*x1_1, x1_0*x5_0 - x5_0*x1_0, x1_0*x5_1 - x5_1*x1_0, x1_1*x5_0 - x5_0*x1_1, x1_1*x5_1 - x5_1*x1_1, x2_0*x3_0 - x3_0*x2_0, x2_0*x3_1 - x3_1*x2_0, x2_1*x3_0 - x3_0*x2_1, x2_1*x3_1 - x3_1*x2_1, x2_0*x4_0 - x4_0*x2_0, x2_0*x4_1 - x4_1*x2_0, x2_1*x4_0 - x4_0*x2_1, x2_1*x4_1 - x4_1*x2_1, x2_0*x5_0 - x5_0*x2_0, x2_0*x5_1 - x5_1*x2_0, x2_1*x5_0 - x5_0*x2_1, x2_1*x5_1 - x5_1*x2_1, x3_0*x4_0 - x4_0*x3_0, x3_0*x4_1 - x4_1*x3_0, x3_1*x4_0 - x4_0*x3_1, x3_1*x4_1 - x4_1*x3_1, x3_0*x5_0 - x5_0*x3_0, x3_0*x5_1 - x5_1*x3_0, x3_1*x5_0 - x5_0*x3_1, x3_1*x5_1 - x5_1*x3_1, x4_0*x5_0 - x5_0*x4_0, x4_0*x5_1 - x5_1*x4_0, x4_1*x5_0 - x5_0*x4_1, x4_1*x5_1 - x5_1*x4_1;
ideal G = twostd(I);
print("GB " + string(size(G)));
if (reduce(x0_0*x5_0 - x5_0*x0_0, G) == 0) { print("T 0 OK"); } else { print("T 0 NO"); }
if (reduce(x0_0*x5_1 - x5_1*x0_0, G) == 0) { print("T 1 OK"); } else { print("T 1 NO"); }
if (reduce(x0_1*x5_0 - x5_0*x0_1, G) == 0) { print("T 2 OK"); } else { print("T 2 NO"); }
if (reduce(x0_1*x5_1 - x5_1*x0_1, G) == 0) { print("T 3 OK"); } else { print("T 3 NO"); }
quit;
