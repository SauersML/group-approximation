+    (Y : FiniteModel) (hY : 0 < Fintype.card Y)
+    (T₀ S₀ T₁ S₁ : Matrix Y Y ℂ) (ε : ℝ)
+    (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1)
+    (hT₀ : ‖T₀‖ ≤ 1) (hS₀ : ‖S₀‖ ≤ 1)
+    (hT₁ : ‖T₁‖ ≤ 1) (hS₁ : ‖S₁‖ ≤ 1)
+    (h00 : hsNorm Y (T₀ * S₀ - 1) ≤ ε)
+    (h11 : hsNorm Y (T₁ * S₁ - 1) ≤ ε)
+    (h01 : hsNorm Y (T₀ * S₁) ≤ ε) :
+    (1 / 4 : ℝ) ≤ ε := by
