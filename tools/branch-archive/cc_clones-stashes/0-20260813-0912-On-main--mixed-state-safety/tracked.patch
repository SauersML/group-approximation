+    (hT₀ : ‖T₀‖ ≤ 1) (hS₀ : ‖S₀‖ ≤ 1)
+    (hT₁ : ‖T₁‖ ≤ 1) (hS₁ : ‖S₁‖ ≤ 1) :
+    2 - Real.sqrt 3 ≤
+      max (hsNorm Y (T₀ * S₀ - 1))
+        (max (hsNorm Y (T₁ * S₁ - 1)) (hsNorm Y (T₀ * S₁))) := by
