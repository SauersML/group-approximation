-    (N : MarkedGroupSpace (generatorCount + 2))
-    (q : FreeGroup Generator) :
-    FreeGroup.lift (quotientGenerator N) q =
-      (QuotientGroup.mk (reindexWord q) : N.Quotient) := by
-  change FreeGroup.lift (quotientGenerator N) q =
