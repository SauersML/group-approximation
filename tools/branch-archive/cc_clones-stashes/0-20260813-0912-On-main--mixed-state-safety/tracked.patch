-/-- The chosen cylinder is nonempty. -/
-theorem chosenCylinder_nonempty : chosenCylinder.Nonempty :=
-  ⟨chosenPoint, chosenPoint_mem_chosenCylinder⟩
-
-/-- The chosen cylinder is simultaneously open and closed. -/
