+    (Y : FiniteModel) (hY : 0 < Fintype.card Y)
+    (U R₀ L₀ R₁ L₁ : Matrix Y Y ℂ)
+    (hU : U ∈ Matrix.unitaryGroup Y ℂ)
+    (hR₀ : ‖R₀‖ ≤ 1) (hL₀ : ‖L₀‖ ≤ 1)
+    (hR₁ : ‖R₁‖ ≤ 1) (hL₁ : ‖L₁‖ ≤ 1) :
+    2 - Real.sqrt 3 ≤
+      max (hsNorm Y (R₀ᴴ * U * L₀ - U))
