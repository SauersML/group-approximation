-private theorem e13_zpow_conj_v2 (n : ℤ) :
-    e13 ^ n * v2 * (e13 ^ n)⁻¹ = v2 := by
-  have hcomm := commute_of_conj_eq_self e13_conj_v2
-  rw [(hcomm.zpow_left n).eq]
-  group
