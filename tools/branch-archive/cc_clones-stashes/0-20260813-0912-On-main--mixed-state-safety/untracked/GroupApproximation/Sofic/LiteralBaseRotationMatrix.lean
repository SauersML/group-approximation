import GroupApproximation.Sofic.LiteralBaseAffineQuotient
import GroupApproximation.Sofic.LiteralBaseRotationRetract

/-!
# The exact matrix realization of the literal rotation retract

The abstract three-generator, eight-relator rotation group has a canonical
surjection onto the subgroup generated by the three displayed integral
matrices.  This file constructs that map and proves its compatibility with
the affine quotient of the full six-generator base.

No completeness assertion is made here: injectivity of `rotationToMatrix`
is precisely the remaining CRW-presentation theorem.  Keeping that boundary
as a named map prevents the valid matrix calculation and surjectivity from
being confused with presentation completeness.
-/

namespace GroupApproximation
namespace LiteralBaseRotationMatrix

open ExplicitLinearModel LiteralBaseAffineQuotient
open LiteralBaseRotationRetract

noncomputable section

/-- The subgroup of `GL₄(ℚ)` generated by the three block-diagonal rotation
matrices. -/
def rotationMatrixGroup : Subgroup Matˣ :=
  Subgroup.closure ({xU, yU, zU} : Set Matˣ)

def xR : rotationMatrixGroup :=
  ⟨xU, Subgroup.subset_closure (by simp)⟩

def yR : rotationMatrixGroup :=
  ⟨yU, Subgroup.subset_closure (by simp)⟩

def zR : rotationMatrixGroup :=
  ⟨zU, Subgroup.subset_closure (by simp)⟩

/-- Evaluation of the three abstract rotation letters in their exact matrix
subgroup. -/
def rotationGeneratorToMatrix : RotationGenerator → rotationMatrixGroup
  | 0 => xR
  | 1 => yR
  | 2 => zR

theorem rotationGeneratorToMatrix_kills :
    ∀ r ∈ rotationRelators,
      FreeGroup.lift rotationGeneratorToMatrix r = 1 := by
  intro r hr
  rw [mem_rotationRelators_iff] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · apply Subtype.ext
    apply Units.ext
    simpa [rotationGeneratorToMatrix, xR, xU, pow_succ] using xM_orderThree'
  · apply Subtype.ext
    apply Units.ext
    simpa [rotationGeneratorToMatrix, yR, yU, pow_succ] using yM_orderThree'
  · apply Subtype.ext
    apply Units.ext
    simpa [rotationGeneratorToMatrix, zR, zU, pow_succ] using zM_orderTwo
  · apply Subtype.ext
    apply Units.ext
    simpa [rotationGeneratorToMatrix, xR, zR, xU, zU, pow_succ]
      using rel_xz_cube
  · apply Subtype.ext
    apply Units.ext
    simpa [rotationGeneratorToMatrix, yR, zR, yU, zU, pow_succ]
      using rel_yz_cube
  · apply Subtype.ext
    apply Units.ext
    simpa [rotationGeneratorToMatrix, xR, yR, zR, xU, yU, zU, pow_succ]
      using rel_xzxy_sq
  · apply Subtype.ext
    apply Units.ext
    simpa [rotationGeneratorToMatrix, xR, yR, zR, xU, yU, zU, pow_succ]
      using rel_yzyx_sq
  · apply Subtype.ext
    apply Units.ext
    simp only [map_pow, map_mul, FreeGroup.lift_apply_of,
      rotationGeneratorToMatrix]
    rw [show (6 : ℕ) = 3 + 3 by norm_num, pow_add]
    change (xM * yM) ^ 3 * (xM * yM) ^ 3 = 1
    simpa only [pow_succ, pow_zero, one_mul, mul_assoc] using rel_xy_six

/-- The canonical matrix realization of the abstract rotation
presentation. -/
def rotationToMatrix : Rotation →* rotationMatrixGroup :=
  PresentedGroup.toGroup rotationGeneratorToMatrix_kills

@[simp] theorem rotationToMatrix_X : rotationToMatrix X = xR := by
  simp [rotationToMatrix, rotationGeneratorToMatrix]

@[simp] theorem rotationToMatrix_Y : rotationToMatrix Y = yR := by
  simp [rotationToMatrix, rotationGeneratorToMatrix]

@[simp] theorem rotationToMatrix_Z : rotationToMatrix Z = zR := by
  simp [rotationToMatrix, rotationGeneratorToMatrix]

/-- The three matrix generators generate the declared target, so the
canonical realization is onto. -/
theorem rotationToMatrix_surjective : Function.Surjective rotationToMatrix := by
  rw [← MonoidHom.range_eq_top]
  apply top_unique
  intro g _
  have hgenerators :
      rotationMatrixGroup.subtype ⁻¹' ({xU, yU, zU} : Set Matˣ) ≤
        rotationToMatrix.range := by
    intro u hu
    rcases hu with h | h | h
    · rw [show u = xR from Subtype.ext h]
      exact ⟨X, rotationToMatrix_X⟩
    · rw [show u = yR from Subtype.ext h]
      exact ⟨Y, rotationToMatrix_Y⟩
    · rw [Set.mem_singleton_iff] at h
      rw [show u = zR from Subtype.ext h]
      exact ⟨Z, rotationToMatrix_Z⟩
  have hclosure :
      Subgroup.closure
          (rotationMatrixGroup.subtype ⁻¹' ({xU, yU, zU} : Set Matˣ)) ≤
        rotationToMatrix.range :=
    (Subgroup.closure_le _).mpr hgenerators
  have htop :
      Subgroup.closure
          (rotationMatrixGroup.subtype ⁻¹' ({xU, yU, zU} : Set Matˣ)) = ⊤ :=
    Subgroup.closure_preimage_eq_top ({xU, yU, zU} : Set Matˣ)
  exact hclosure (htop.symm ▸ Subgroup.mem_top g)

theorem rotationMatrixGroup_le_gammaBar : rotationMatrixGroup ≤ gammaBar := by
  rw [rotationMatrixGroup, Subgroup.closure_le]
  intro u hu
  rcases hu with rfl | rfl | rfl
  · exact xG.property
  · exact yG.property
  · exact zG.property

/-- Inclusion of the rotation matrix subgroup into the full affine matrix
subgroup. -/
def rotationMatrixToAffine : rotationMatrixGroup →* gammaBar where
  toFun u := ⟨u.1, rotationMatrixGroup_le_gammaBar u.property⟩
  map_one' := rfl
  map_mul' _ _ := rfl

theorem rotationMatrixToAffine_injective :
    Function.Injective rotationMatrixToAffine := by
  intro a b hab
  exact Subtype.ext (congrArg (fun u : gammaBar => u.1) hab)

@[simp] theorem rotationMatrixToAffine_xR : rotationMatrixToAffine xR = xG := rfl
@[simp] theorem rotationMatrixToAffine_yR : rotationMatrixToAffine yR = yG := rfl
@[simp] theorem rotationMatrixToAffine_zR : rotationMatrixToAffine zR = zG := rfl

/-- The standalone rotation realization is exactly the restriction of the
six-generator affine quotient along the internal rotation retract. -/
theorem rotation_matrix_affine_square :
    rotationMatrixToAffine.comp rotationToMatrix =
      affineQuotient.comp rotationToBase := by
  apply MonoidHom.ext
  intro r
  obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective
    (rotationRelators : Set (FreeGroup RotationGenerator)) r
  induction w using FreeGroup.induction_on with
  | C1 => simp
  | of i =>
      fin_cases i
      · change rotationMatrixToAffine (rotationToMatrix X) =
          affineQuotient (rotationToBase X)
        simp [affineQuotient, LiteralNonMFLinearWitness.matrixBaseGenerator,
          LiteralNonMFPresentation.v1Index,
          LiteralNonMFPresentation.v2Index,
          LiteralNonMFPresentation.v3Index,
          LiteralNonMFPresentation.xIndex]
      · change rotationMatrixToAffine (rotationToMatrix Y) =
          affineQuotient (rotationToBase Y)
        simp [affineQuotient, LiteralNonMFLinearWitness.matrixBaseGenerator,
          LiteralNonMFPresentation.v1Index,
          LiteralNonMFPresentation.v2Index,
          LiteralNonMFPresentation.v3Index,
          LiteralNonMFPresentation.xIndex,
          LiteralNonMFPresentation.yIndex]
      · change rotationMatrixToAffine (rotationToMatrix Z) =
          affineQuotient (rotationToBase Z)
        simp [affineQuotient, LiteralNonMFLinearWitness.matrixBaseGenerator,
          LiteralNonMFPresentation.v1Index,
          LiteralNonMFPresentation.v2Index,
          LiteralNonMFPresentation.v3Index,
          LiteralNonMFPresentation.xIndex,
          LiteralNonMFPresentation.yIndex,
          LiteralNonMFPresentation.zIndex]
  | inv_of i hi => simpa only [map_inv] using congrArg Inv.inv hi
  | mul a b ha hb => simpa only [map_mul] using congrArg₂ (· * ·) ha hb

/-- Because both comparison maps are embeddings, completeness of the CRW
rotation presentation is equivalent to injectivity of its restriction inside
the full affine quotient. -/
theorem rotationToMatrix_injective_iff_affine_restriction_injective :
    Function.Injective rotationToMatrix ↔
      Function.Injective (affineQuotient.comp rotationToBase) := by
  constructor
  · intro h a b hab
    apply h
    apply rotationMatrixToAffine_injective
    calc
      rotationMatrixToAffine (rotationToMatrix a) =
          affineQuotient (rotationToBase a) :=
        DFunLike.congr_fun rotation_matrix_affine_square a
      _ = affineQuotient (rotationToBase b) := hab
      _ = rotationMatrixToAffine (rotationToMatrix b) :=
        (DFunLike.congr_fun rotation_matrix_affine_square b).symm
  · intro h a b hab
    apply h
    calc
      affineQuotient (rotationToBase a) =
          rotationMatrixToAffine (rotationToMatrix a) :=
        (DFunLike.congr_fun rotation_matrix_affine_square a).symm
      _ = rotationMatrixToAffine (rotationToMatrix b) := congrArg _ hab
      _ = affineQuotient (rotationToBase b) :=
        DFunLike.congr_fun rotation_matrix_affine_square b

end

end LiteralBaseRotationMatrix
end GroupApproximation
