-        mark * (wordInMarkedGroup (FreeGroup.of i))⁻¹ =
-            (wordInMarkedGroup (FreeGroup.of i))⁻¹ *
-              (wordInMarkedGroup (FreeGroup.of i) * mark) *
-              (wordInMarkedGroup (FreeGroup.of i))⁻¹ := by group
