-              (mark * wordInMarkedGroup (FreeGroup.of i)) *
-              (wordInMarkedGroup (FreeGroup.of i))⁻¹ := by rw [hswap]
-        _ = (wordInMarkedGroup (FreeGroup.of i))⁻¹ * mark := by group
-  | mul a b ha hb =>
-      rw [map_mul]
