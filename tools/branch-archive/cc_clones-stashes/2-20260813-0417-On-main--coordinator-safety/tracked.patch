-  | C1 => simp
-  | of i => exact hgen i
-  | inv_of i hi =>
-      have hswap : wordInMarkedGroup (FreeGroup.of i) * mark =
-          mark * wordInMarkedGroup (FreeGroup.of i) := hi.symm
