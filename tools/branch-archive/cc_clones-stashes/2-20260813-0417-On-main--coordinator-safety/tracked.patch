+    rw [hfactor, hsNormSq_mul_right Y hUstar]
+  have hdef11 :
+      hsNorm Y (R₁ᴴ * (U * L₁ * Uᴴ) - 1) =
+        hsNorm Y (R₁ᴴ * U * L₁ - U) := by
+    have hfactor :
+        R₁ᴴ * (U * L₁ * Uᴴ) - 1 = (R₁ᴴ * U * L₁ - U) * Uᴴ := by
