# KL collapse test over Thompson's V (Bleak--Quick presentation, as quoted on main).
# For w in V * <t> of degree m, V dies in V_w = (V*<t>)/<<w>> iff [V_w : <t>] = 1:
#   if V dies, V_w = C_m is generated by t;
#   if [V_w:<t>] = 1 then V_w is cyclic, so the perfect image of V is trivial.
# If V injects, [V_w:<t>] is infinite (V is infinite and not virtually cyclic),
# so the enumeration can only terminate with index 1, and termination IS the
# certificate.  Reads KLCX_IN (lines "<id> <word>") and appends to KLCX_OUT.

F := FreeGroup("a", "b", "c", "t");;
a := F.1;; b := F.2;; c := F.3;; t := F.4;;
L := rec(a := a, b := b, B := b^-1, c := c, t := t, T := t^-1);;
W := function(s) local x, ch;
  x := One(F);
  for ch in s do x := x * L.(String([ch])); od;
  return x;
end;;
BQ := [ W("aa"), W("bbb"), W("abababab"), W("cc"), W("acacac"),
  W(Concatenation("caBaba", "caBaba", "cb", "cabaBa", "cabaBa")),
  W(Concatenation("a", "cbcb", "a", "BcBc", "bcabcBcaBacB", "cbcb", "aB")),
  W(Concatenation("aBcbc", "aBaB", "cbcBa", "BcBc", "babcBcaB")),
  W(Concatenation("ca", "BcBc", "bacabacbc", "BcaBca", "b", "cBcB", "acbacb", "cBcaB")) ];;

Collapse := function(s, maxc) local rels, tab;
  rels := Concatenation(BQ, [W(s)]);
  tab := CosetTableFromGensAndRels([a, b, c, t], rels, [t] : max := maxc, silent := true);
  if tab = fail then return "overflow"; fi;
  return Length(tab[1]);
end;;

RunFile := function(inpath, outpath, maxc) local lines, ln, parts, r, t0;
  lines := SplitString(StringFile(inpath), "\n");
  for ln in lines do
    if ln = "" then continue; fi;
    parts := SplitString(ln, " ");
    t0 := Runtime();
    r := Collapse(parts[2], maxc);
    AppendTo(outpath, parts[1], " ", parts[2], " ", r, " ", Runtime() - t0, "\n");
  od;
end;;
