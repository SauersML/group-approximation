out := OutputTextFile("/Users/user/nonsofic_existence/experiments/hrf-wave5-detectors-2026-09-20/c5/projective_summands.json",false);; PrintTo(out,"[\n");; first:=true;;
for z in [1..4] do part:=parts[z]; modu:=GModuleByMats(List(part[2],m->m*One(GF(3))),GF(3));; dec:=MTX.Indecomposition(modu);; Print("PART ",z," DIMENSIONS ",List(dec,d->MTX.Dimension(d[2])),"\n");
for d in dec do B:=d[1]*(part[1]*One(GF(3))); if not first then PrintTo(out,",\n"); fi; first:=false; PrintTo(out,"{\"basis\":",List(B,r->List(r,IntFFE)),",\"generators\":",List(MTX.Generators(d[2]),m->List(m,r->List(r,IntFFE))),"}"); od; od;
