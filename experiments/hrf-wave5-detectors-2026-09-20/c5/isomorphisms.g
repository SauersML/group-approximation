mods := List(matrices, mm->GModuleByMats(List(mm,m->m*One(GF(3))),GF(3)));;
reps := [];; certificates := [];;
for n in [1..Length(mods)] do
 found := false;
 for r in reps do
  if MTX.Dimension(mods[n])=MTX.Dimension(mods[r]) then
   T := MTX.IsomorphismModules(mods[n],mods[r]);
   if T<>fail then Add(certificates,[r,T]); found:=true; break; fi;
  fi;
 od;
 if not found then Add(reps,n); Add(certificates,[n,IdentityMat(MTX.Dimension(mods[n]),GF(3))]); fi;
od;
Print("REPRESENTATIVES ",reps,"\n");
out := OutputTextFile("/Users/user/nonsofic_existence/experiments/hrf-wave5-detectors-2026-09-20/c5/isomorphisms.json",false);; PrintTo(out,"[\n");;
for n in [1..Length(certificates)] do c:=certificates[n]; PrintTo(out,"{\"representative\":",c[1]-1,",\"map\":",List(c[2],r->List(r,IntFFE)),"}"); if n<Length(certificates) then PrintTo(out,",\n"); fi; od; PrintTo(out,"\n]\n");; CloseStream(out);; QUIT;
