# pairs.out -- evidence for (S), (A), (K) of kms-hc1-ca-edge-defect-is-a-witt-carry-syzygy
# generated by fo_dual.cpp (this directory) and syz_eval.py; ca slice (p,1,p); alpha = (alphaA, alphaB); kappa = 1

## 1. SEEDS=1 on the ca slice: the program's actual jump equals sum psi(U_s X_s) over its seed cofactors (SEEDSUM OK)
### SEEDS=1 ./fo_dual 5 5 1 5 0 0
p=5 slice<=(5,1,5) alpha=(0,0) |basis N|=41
ZERO-JUMP S(cacacacaca|cacacab,k=6) with nonzero formal seed part
JUMP S(cacacacaca|cacacab,k=6) deg 11->15 mu (5,1,5): rho =  0  zcoef 0 NOT-pure-z [target S-pair multidegree]
  SEEDSUM 0 (jump zcoef 0) OK
### SEEDS=1 ./fo_dual 5 5 1 5 1 0
p=5 slice<=(5,1,5) alpha=(1,0) |basis N|=41
ZERO-JUMP S(cacacacaca|cacacab,k=6) with nonzero formal seed part
JUMP S(cacacacaca|cacacab,k=6) deg 11->15 mu (5,1,5): rho =  0  zcoef 0 NOT-pure-z [target S-pair multidegree]
  SEEDSUM 0 (jump zcoef 0) OK
### SEEDS=1 ./fo_dual 5 5 1 5 0 1
p=5 slice<=(5,1,5) alpha=(0,1) |basis N|=41
JUMP S(cacacacaca|cacacab,k=6) deg 11->15 mu (5,1,5): rho =  4*z.  zcoef 4 pure-z [target S-pair multidegree]
  SEEDSUM 4 (jump zcoef 4) OK
### SEEDS=1 ./fo_dual 7 7 1 7 0 0
p=7 slice<=(7,1,7) alpha=(0,0) |basis N|=57
ZERO-JUMP S(cacacacacacaca|cacacab,k=6) with nonzero formal seed part
JUMP S(cacacacacacaca|cacacab,k=6) deg 15->21 mu (7,1,7): rho =  0  zcoef 0 NOT-pure-z [target S-pair multidegree]
  SEEDSUM 0 (jump zcoef 0) OK
### SEEDS=1 ./fo_dual 7 7 1 7 1 0
p=7 slice<=(7,1,7) alpha=(1,0) |basis N|=57
ZERO-JUMP S(cacacacacacaca|cacacab,k=6) with nonzero formal seed part
JUMP S(cacacacacacaca|cacacab,k=6) deg 15->21 mu (7,1,7): rho =  0  zcoef 0 NOT-pure-z [target S-pair multidegree]
  SEEDSUM 0 (jump zcoef 0) OK
### SEEDS=1 ./fo_dual 7 7 1 7 0 1
p=7 slice<=(7,1,7) alpha=(0,1) |basis N|=57
JUMP S(cacacacacacaca|cacacab,k=6) deg 15->21 mu (7,1,7): rho =  6*z.  zcoef 6 pure-z [target S-pair multidegree]
  SEEDSUM 6 (jump zcoef 6) OK

## 2. syz_eval.py on the full pairing tables (SEEDS=1 PAIRTAB=1 ./fo_dual p p 1 p alphaA alphaB, alpha = (0,0),(1,0),(0,1))
### python3 syz_eval.py 5
p=5  l1=4 l2=1  (U1 a^2 = 1 U2 c^2)
  syzygy g=e_1              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=2e_2+3e_3        zeta coords (v00, v10-v00, v01-v00) = (0, 0, 1)
### python3 syz_eval.py 7
p=7  l1=6 l2=1  (U1 a^2 = 1 U2 c^2)
  syzygy g=e_1              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_2              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_3              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=2e_4+3e_5        zeta coords (v00, v10-v00, v01-v00) = (0, 0, 6)
### python3 syz_eval.py 11
p=11  l1=10 l2=1  (U1 a^2 = 1 U2 c^2)
  syzygy g=e_1              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_2              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_3              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_4              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_5              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_6              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=e_7              zeta coords (v00, v10-v00, v01-v00) = (0, 0, 0)
  syzygy g=2e_8+3e_9        zeta coords (v00, v10-v00, v01-v00) = (0, 0, 6)

