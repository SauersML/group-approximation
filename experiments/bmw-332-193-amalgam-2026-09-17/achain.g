# Exact section chain G_{k+1} = phi_0(St_{G_k}(0)) inside the abstract amalgam A (finite presentation),
# using the wreath recursion of the automaton, which descends to A (checked: all sections of the
# defining relators of A are trivial in A; see amnf.py / relsec check below).
# Convention: a letter list [l1,...,lm] acts left-first (l1 first); this is the right action of K^op,
# the same set of tree automorphisms (letters are involutions), so orbits are those of K.
# Input (set before Read): OUT, SEC (0-based lists, generator i = index i+1), R (relators as letter lists),
#   KMAX.  Output: index of G_k in A, level-1 orbit of G_k, and containments G_i^g <= G_k.
F:=FreeGroup(4);; fg:=GeneratorsOfGroup(F);;
wd:=l->Product(List(l,i->fg[i]),One(F));;
A:=F/List(R,wd);; ag:=GeneratorsOfGroup(A);;
red:=function(l) local r,i; r:=[];
  for i in l do if Length(r)>0 and r[Length(r)]=i then Remove(r); else Add(r,i); fi; od; return r; end;;
sect:=function(l,x) local r,i; r:=[];   # x is 0-based letter; returns [x^w, w|_x]
  for i in l do Add(r,SEC[i][x+1]+1); x:=OUT[i][x+1]; od; return [x,red(r)]; end;;
lam:=List([1..4],i->PermList(OUT[i]+1));;
# coset action of A on A/S for S generated by letter lists gens; returns list of 4 perms (right action)
IDX:=0;;
cact:=function(gens) local S,ct;
  S:=Subgroup(A,List(gens,l->MappedWord(wd(l),fg,ag)));
  ct:=CosetTableInWholeGroup(S);
  IDX:=Length(ct[1]);
  return List([1..4],i->PermList(ct[2*i-1]));
end;;
# Schreier generators (letter lists) of the stabilizer of point (1, letter 0) in the diagonal action
stabgens:=function(mu) local orb,tr,todo,p,q,i,gens,s;
  orb:=[[1,1]]; tr:=[[]]; todo:=[1]; gens:=[];
  while Length(todo)>0 do
    p:=Remove(todo,1);
    for i in [1..4] do
      q:=[orb[p][1]^mu[i],orb[p][2]^lam[i]];
      if not q in orb then Add(orb,q); Add(tr,Concatenation(tr[p],[i])); Add(todo,Length(orb));
      else
        s:=red(Concatenation(tr[p],[i],Reversed(tr[Position(orb,q)])));
        if Length(s)>0 then Add(gens,s); fi;
      fi;
    od;
  od;
  return gens;
end;;
# (the triviality in A of all sections of the relators is checked exactly by amnf.py relsec)
G:=[[[1],[2],[3],[4]]];; MU:=[cact(G[1])];;
for k in [1..KMAX] do
  sg:=stabgens(MU[k]);
  ng:=Set(List(sg,l->sect(l,0)[2]));; ng:=Filtered(ng,l->Length(l)>0);;
  Add(G,ng); Add(MU,cact(ng));
  orb:=Orbit(Group(List(ng,l->Product(List(l,i->lam[i]),())) ),1);
  Print("k=",k," #gens ",Length(ng)," maxlen ",Maximum(List(ng,Length)),
        " index ",IDX," level-1 orbit of letter 0 (1-based): ",orb,"\n");
  for j in [1..k] do
    # G_j <= G_{k+1} ?  and some conjugate G_j^g <= G_{k+1} ?
    inc:=ForAll(G[j],l->1^Product(List(l,i->MU[k+1][i]),())=1);
    Print("   G_",j-1," <= G_",k,": ",inc,"\n");
  od;
od;
