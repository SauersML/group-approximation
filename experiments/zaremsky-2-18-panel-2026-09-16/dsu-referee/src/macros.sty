%% Environments

% Theorem-style environments

%\makeatletter% not needed since this is a .sty file
\newtheorem*{rep@theorem}{\rep@title}

\newcommand{\newreptheorem}[2]{
  \newenvironment{rep#1}[1]{
  \def\rep@title{#2 \ref{##1}}
  \begin{rep@theorem}
  }{
  \end{rep@theorem}
  }
}
%\makeatother

\newcommand{\maketheorem}[2]{
\newtheorem{#1}[theorem]{#2}
\newreptheorem{#1}{#2}
\newtheorem*{#1*}{#2}
}

\newcommand{\maketheorems}[2]{
\maketheorem{#1}{#2}
\maketheorem{#1s}{#2s}
}

\let\theorem\undefined
\let\c@theorem\undefined
\let\lemma\undefined
\let\proposition\undefined
\let\corollary\undefined
\let\problem\undefined
\let\fact\undefined



\newtheorem{theorem}{Theorem}[section]
\newreptheorem{theorem}{Theorem}
\newtheorem*{theorem*}{Theorem}

\newcommand{\theoremlevel}[1]{
\theoremstyle{theorem}
\makeatletter
\let\theorem\undefined
\let\c@theorem\undefined
\newtheorem{theorem}{Theorem}[#1]
\makeatother
}

\maketheorems{lemma}{Lemma}
\maketheorems{sublemma}{Sublemma}
\maketheorems{claim}{Claim}
\maketheorems{subclaim}{Subclaim}
\maketheorems{proposition}{Proposition}
\maketheorems{corollary}{Corollary}
\maketheorems{conjecture}{Conjecture}
\maketheorems{metatheorem}{Meta-Theorem}


\newenvironment{thmenv}[1]{
\def\rep@title{#1}
\begin{rep@theorem}
}{
\end{rep@theorem}
}

% Definition-style environments
\theoremstyle{definition}

%\makeatletter% not needed since this is a .sty file
\newtheorem*{rep@definition}{\rep@title}

\newcommand{\newrepdefinition}[2]{
  \newenvironment{rep#1}[1]{
  \def\rep@title{#2 \ref{##1}}\begin{rep@definition}
  }{
  \end{rep@definition}
  }
}
%\makeatother

\newcommand{\makedefinition}[2]{
\newtheorem{#1}[theorem]{#2}
\newrepdefinition{#1}{#2}
\newtheorem*{#1*}{#2}
}

\newcommand{\makedefinitions}[2]{
\makedefinition{#1}{#2}
\makedefinition{#1s}{#2s}
}

\newtheorem{convention}{Convention}[]
\newtheorem*{convention*}{Convention}




\makedefinitions{remark}{Remark}
\makedefinitions{notation}{Notation}
\makedefinitions{observation}{Observation}
\makedefinitions{nonexample}{Non-example}
\makedefinitions{assumption}{Assumption}
\makedefinitions{question}{Question}
\makedefinitions{openquestion}{Open Question}
\makedefinitions{answer}{Answer}
\makedefinitions{problem}{Problem}
\makedefinitions{warning}{Warning}
\makedefinitions{fact}{Fact}

\newenvironment{defenv}[1]{
\def\rep@title{#1}
\begin{rep@definition}
}{
\end{rep@definition}
}



% These last three have the common property that they should all be within a "quote" environment (or a similar environment with fewer bugs)
\makedefinition{condition}{Condition}
\makedefinition{event}{Event}
\makedefinition{property}{Property}

% Repequation environment
\newenvironment{repequation}[1]{
\begin{equation*}\tag{\ref{#1}}
}{
\end{equation*}\ignorespacesafterend
}

% Subproof environment
\newenvironment{subproof}{
\begin{proof}
}{
\QEDmod\end{proof}
}


% Footnote environment
\let\buggyfootnote\footnote
\renewcommand{\footnote}[1]{\text{$ $}\buggyfootnote{#1}}% Fixed footnotemark size bug


% Small text for arXiv 
\newenvironment{smalltext}{\IfFileExists{bibliography.bib}{}{\let\tempbb\mathbb\let\mathbb\amsbb}}{\IfFileExists{bibliography.bib}{}{\let\amsbb\mathbb\let\mathbb\tempbb}}
\newenvironment{Abstract}{\begin{smalltext}\begin{abstract}}{\end{abstract}\end{smalltext}}
\newcommand{\Footnote}[1]{\footnote{\begin{smalltext}#1\end{smalltext}}}
\newcommand{\Footnotetext}[1]{\footnotetext{\begin{smalltext}#1\end{smalltext}}}

