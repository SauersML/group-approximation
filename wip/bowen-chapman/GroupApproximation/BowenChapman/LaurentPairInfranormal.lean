import GroupApproximation.BowenChapman.LaurentPair
import GroupApproximation.Sofic.InfranormalCompressionPair
import Mathlib.GroupTheory.Commutator.Basic

/-!
# The peripheral subgroup is infranormal and not normal

For the pair `Peripheral = EL₃(𝔽₂[ℕ³]) ≤ Ambient = EL₃(𝔽₂[ℤ³]) ⋊ EL₃(ℤ)` of
`BowenChapman.LaurentPair`:

* `peripheral_isInfranormal`: the compressors of `Peripheral` generate `Ambient`;
* `peripheral_not_normal`: `Peripheral` is not normal.

**Infranormality.** Let `H` be the subgroup generated by the compressors.

1. `Peripheral ≤ H`, since a subgroup compresses itself.
2. An integer elementary matrix `x_{ij}(n)` with `n ≥ 0` has nonnegative
   entries, so substitution by it maps polynomials to polynomials, and it
   compresses `Peripheral`.  Its inverse `x_{ij}(-n)` lies in `H`.  Hence the
   whole actor `EL₃(ℤ)` lies in `H`.
3. Conjugating by the actor, `H` contains `x_{ij}(x^(M w))` for every `w ∈ ℕ³`
   and every `M ∈ EL₃(ℤ)`.  The exponents `v` with `x_{ij}(x^v) ∈ H` for all
   `i ≠ j` form an additive submonoid of `ℤ³`, by the commutator identity
   through the third index.  It contains `ℕ³` and `-eᵢ = (e_j - 2eᵢ) + (eᵢ - e_j)`,
   so it is all of `ℤ³`.
4. Every Laurent polynomial is a sum of monomials with coefficients in `𝔽₂`,
   so `EL₃(𝔽₂[ℤ³]) ≤ H`, and `(A, M) = inl A · inr M` gives `H = ⊤`.

**Non-normality.** Conjugating `x_{01}(x₂)` by `x_{01}(-1) ∈ EL₃(ℤ)` gives
`x_{01}(x₁⁻¹x₂)`, whose `(0,1)` entry is not a polynomial.
-/

namespace GroupApproximation.BowenChapman

open scoped Matrix commutatorElement

/-- The elementary matrix `x_{ij}(a)` over `Laurent`, as an element of `EL₃(Laurent)`. -/
noncomputable def elemL (i j : Fin 3) (h : i ≠ j) (a : Laurent) :
    ↥(elementaryGroup (Fin 3) Laurent) :=
  ⟨elementaryUnit i j h a, elementaryUnit_mem i j h a⟩

/-- The elementary matrix `x_{ij}(k)` over `ℤ`, as an element of the actor. -/
def elemZ (i j : Fin 3) (h : i ≠ j) (k : ℤ) : Actor :=
  ⟨elementaryUnit i j h k, elementaryUnit_mem i j h k⟩

/-- The subgroup of `Ambient` generated by the compressors of `Peripheral`. -/
noncomputable abbrev compressorClosure : Subgroup Ambient :=
  Subgroup.closure (compressionSubmonoid Peripheral : Set Ambient)

theorem third_index : ∀ i j : Fin 3, ∃ k : Fin 3, k ≠ i ∧ k ≠ j := by
  decide

theorem zmod_two_eq_zero_or_one : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by
  decide

/-! ### Elementary matrices -/

theorem elemL_zero (i j : Fin 3) (h : i ≠ j) : elemL i j h 0 = 1 := by
  apply Subtype.ext
  change elementaryUnit i j h (0 : Laurent) = 1
  rw [elementaryUnit_zero]

theorem elemL_add (i j : Fin 3) (h : i ≠ j) (a b : Laurent) :
    elemL i j h (a + b) = elemL i j h a * elemL i j h b := by
  apply Subtype.ext
  change elementaryUnit i j h (a + b) = elementaryUnit i j h a * elementaryUnit i j h b
  rw [elementaryUnit_mul]

theorem commutator_elemL (i k j : Fin 3) (hik : i ≠ k) (hkj : k ≠ j) (hij : i ≠ j)
    (a b : Laurent) :
    ⁅elemL i k hik a, elemL k j hkj b⁆ = elemL i j hij (a * b) := by
  apply Subtype.ext
  change ⁅elementaryUnit i k hik a, elementaryUnit k j hkj b⁆ = elementaryUnit i j hij (a * b)
  exact elementaryUnit_commutator i k j hik hkj hij a b

theorem actorAction_elemL (M : Actor) (i j : Fin 3) (h : i ≠ j) (a : Laurent) :
    actorAction M (elemL i j h a) = elemL i j h (substitution M a) :=
  actorAction_elementaryUnit M i j h a

theorem elemL_coe_apply_same (i j : Fin 3) (h : i ≠ j) (a : Laurent) :
    ((elemL i j h a : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j =
      a := by
  change (1 + Matrix.single i j a) i j = a
  rw [Matrix.add_apply, Matrix.one_apply_ne h, Matrix.single_apply_same, zero_add]

theorem elemZ_mulVec_single (i j : Fin 3) (h : i ≠ j) (a : ℤ) :
    ((elemZ i j h a : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ
        Pi.single j 1 = Pi.single j 1 + Pi.single i a := by
  change (1 + Matrix.single i j a) *ᵥ Pi.single j 1 = _
  rw [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.mulVec_single_one]
  congr 1
  funext k
  change Matrix.single i j a k j = (Pi.single i a : Fin 3 → ℤ) k
  by_cases hk : k = i
  · subst hk
    rw [Matrix.single_apply_same, Pi.single_eq_same]
  · rw [Matrix.single_apply_of_ne i j a k j (fun hc => hk hc.1.symm), Pi.single_eq_of_ne hk]

/-! ### Exponents -/

theorem exponentCast_single (i : Fin 3) :
    exponentCast (Pi.single i 1) = (Pi.single i 1 : Fin 3 → ℤ) := by
  funext k
  rw [exponentCast_apply]
  by_cases hk : k = i
  · subst hk
    rw [Pi.single_eq_same, Pi.single_eq_same, Nat.cast_one]
  · rw [Pi.single_eq_of_ne hk, Pi.single_eq_of_ne hk, Nat.cast_zero]

theorem mulVec_exponentCast (N : Matrix (Fin 3) (Fin 3) ℕ) (w : Fin 3 → ℕ) :
    N.map (Nat.cast : ℕ → ℤ) *ᵥ exponentCast w = exponentCast (N *ᵥ w) := by
  funext k
  simp [Matrix.mulVec, dotProduct]

/-- Matrix multiplication on `ℕ³` by a nonnegative integer matrix. -/
def natExponentMap (N : Matrix (Fin 3) (Fin 3) ℕ) : (Fin 3 → ℕ) →+ (Fin 3 → ℕ) where
  toFun w := N *ᵥ w
  map_zero' := Matrix.mulVec_zero N
  map_add' v w := Matrix.mulVec_add N v w

/-- Monomial substitution along a nonnegative integer matrix, on polynomials. -/
noncomputable def polySubstitution (N : Matrix (Fin 3) (Fin 3) ℕ) : Poly →+* Poly :=
  AddMonoidAlgebra.mapDomainRingHom (ZMod 2) (natExponentMap N)

theorem substitution_polyToLaurent (M : Actor) (N : Matrix (Fin 3) (Fin 3) ℕ)
    (hMN : ((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) =
      N.map (Nat.cast : ℕ → ℤ))
    (x : Poly) :
    substitution M (polyToLaurent x) = polyToLaurent (polySubstitution N x) := by
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add x y hx hy => simp only [map_add, hx, hy]
  | single w c =>
    rw [polyToLaurent_single, substitution_single, hMN, mulVec_exponentCast]
    simp [polySubstitution, natExponentMap]

theorem elemZ_natCast_matrix (i j : Fin 3) (h : i ≠ j) (n : ℕ) :
    ((elemZ i j h (n : ℤ) : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) =
      (1 + Matrix.single i j n : Matrix (Fin 3) (Fin 3) ℕ).map (Nat.cast : ℕ → ℤ) := by
  change 1 + Matrix.single i j (n : ℤ) = _
  ext a b
  simp [Matrix.one_apply, Matrix.single]

/-! ### Compressors -/

theorem mem_compressorClosure_of_mem_peripheral {x : Ambient} (hx : x ∈ Peripheral) :
    x ∈ compressorClosure :=
  Subgroup.subset_closure (mem_compressionSubmonoid_of_mem Peripheral x hx)

/-- An actor element whose substitution restricts to polynomials compresses
`Peripheral`. -/
theorem inr_mem_compressionSubmonoid (M : Actor) (σ : Poly →+* Poly)
    (hσ : ∀ x : Poly, substitution M (polyToLaurent x) = polyToLaurent (σ x)) :
    (SemidirectProduct.inr M : Ambient) ∈ compressionSubmonoid Peripheral := by
  rw [mem_compressionSubmonoid]
  intro γ hγ
  rw [mem_peripheral_iff] at hγ ⊢
  obtain ⟨A, rfl⟩ := hγ
  refine ⟨elementaryGroupMap (ι := Fin 3) σ A, ?_⟩
  show (SemidirectProduct.inl (elementaryGroupMap (ι := Fin 3) polyToLaurent
        (elementaryGroupMap (ι := Fin 3) σ A)) : Ambient) =
      SemidirectProduct.inr M *
        SemidirectProduct.inl (elementaryGroupMap (ι := Fin 3) polyToLaurent A) *
        (SemidirectProduct.inr M)⁻¹
  rw [← map_inv (SemidirectProduct.inr : Actor →* Ambient) M, ← SemidirectProduct.inl_aut,
    SemidirectProduct.inl_inj]
  apply Subtype.ext
  apply Units.ext
  refine Matrix.ext fun i j => ?_
  change polyToLaurent
      (σ (((A : (Matrix (Fin 3) (Fin 3) Poly)ˣ) : Matrix (Fin 3) (Fin 3) Poly) i j)) =
    substitution M
      (polyToLaurent (((A : (Matrix (Fin 3) (Fin 3) Poly)ˣ) : Matrix (Fin 3) (Fin 3) Poly) i j))
  exact (hσ _).symm

theorem inr_elemZ_nat_mem (i j : Fin 3) (h : i ≠ j) (n : ℕ) :
    (SemidirectProduct.inr (elemZ i j h (n : ℤ)) : Ambient) ∈ compressionSubmonoid Peripheral :=
  inr_mem_compressionSubmonoid (elemZ i j h (n : ℤ))
    (polySubstitution (1 + Matrix.single i j n))
    (substitution_polyToLaurent _ _ (elemZ_natCast_matrix i j h n))

theorem inr_elemZ_mem (i j : Fin 3) (h : i ≠ j) (k : ℤ) :
    (SemidirectProduct.inr (elemZ i j h k) : Ambient) ∈ compressorClosure := by
  obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg k
  · exact Subgroup.subset_closure (inr_elemZ_nat_mem i j h n)
  · have hinv : elemZ i j h (-(n : ℤ)) = (elemZ i j h (n : ℤ))⁻¹ := by
      apply eq_inv_of_mul_eq_one_left
      apply Subtype.ext
      change elementaryUnit i j h (-(n : ℤ)) * elementaryUnit i j h (n : ℤ) = 1
      rw [elementaryUnit_mul, neg_add_cancel, elementaryUnit_zero]
    rw [hinv, map_inv]
    exact Subgroup.inv_mem _ (Subgroup.subset_closure (inr_elemZ_nat_mem i j h n))

theorem inr_mem_compressorClosure (M : Actor) :
    (SemidirectProduct.inr M : Ambient) ∈ compressorClosure := by
  have htop : Subgroup.closure (((↑) : Actor → (Matrix (Fin 3) (Fin 3) ℤ)ˣ) ⁻¹'
      {z | ∃ (i j : Fin 3) (h : i ≠ j) (a : ℤ), elementaryUnit i j h a = z}) = ⊤ :=
    Subgroup.closure_closure_coe_preimage
  have hle : Subgroup.closure (((↑) : Actor → (Matrix (Fin 3) (Fin 3) ℤ)ˣ) ⁻¹'
      {z | ∃ (i j : Fin 3) (h : i ≠ j) (a : ℤ), elementaryUnit i j h a = z}) ≤
      compressorClosure.comap (SemidirectProduct.inr : Actor →* Ambient) := by
    rw [Subgroup.closure_le]
    intro x hx
    obtain ⟨i, j, h, a, hxa⟩ := hx
    have hx' : x = elemZ i j h a := Subtype.ext hxa.symm
    rw [hx']
    exact inr_elemZ_mem i j h a
  exact hle (by rw [htop]; exact Subgroup.mem_top M)

theorem inl_actorAction_mem (M : Actor) {B : ↥(elementaryGroup (Fin 3) Laurent)}
    (hB : (SemidirectProduct.inl B : Ambient) ∈ compressorClosure) :
    (SemidirectProduct.inl (actorAction M B) : Ambient) ∈ compressorClosure := by
  rw [SemidirectProduct.inl_aut]
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (inr_mem_compressorClosure M) hB)
    (inr_mem_compressorClosure M⁻¹)

theorem inl_elemL_natExponent_mem_peripheral (i j : Fin 3) (h : i ≠ j) (w : Fin 3 → ℕ) :
    (SemidirectProduct.inl (elemL i j h (AddMonoidAlgebra.single (exponentCast w) 1)) : Ambient) ∈
      Peripheral := by
  rw [mem_peripheral_iff]
  refine ⟨⟨elementaryUnit i j h (AddMonoidAlgebra.single w 1), elementaryUnit_mem i j h _⟩, ?_⟩
  show (SemidirectProduct.inl (elementaryGroupMap (ι := Fin 3) polyToLaurent
      ⟨elementaryUnit i j h (AddMonoidAlgebra.single w 1), elementaryUnit_mem i j h _⟩) :
        Ambient) = _
  rw [SemidirectProduct.inl_inj]
  apply Subtype.ext
  change elementaryMatrixUnitMap polyToLaurent
      (elementaryUnit i j h (AddMonoidAlgebra.single w 1)) =
    elementaryUnit i j h (AddMonoidAlgebra.single (exponentCast w) 1)
  rw [elementaryMatrixUnitMap_elementaryUnit, polyToLaurent_single]

/-! ### Good exponents -/

/-- The exponents `v` for which every elementary matrix `x_{ij}(x^v)` lies in the
closure of the compressors. -/
def goodExponents : AddSubmonoid (Fin 3 → ℤ) where
  carrier := {v | ∀ (i j : Fin 3) (h : i ≠ j),
    (SemidirectProduct.inl (elemL i j h (AddMonoidAlgebra.single v 1)) : Ambient) ∈
      compressorClosure}
  zero_mem' := by
    intro i j h
    have h0 := mem_compressorClosure_of_mem_peripheral
      (inl_elemL_natExponent_mem_peripheral i j h 0)
    rwa [map_zero] at h0
  add_mem' := by
    intro u u' hu hu' i j h
    obtain ⟨k, hki, hkj⟩ := third_index i j
    have hprod : AddMonoidAlgebra.single (u + u') (1 : ZMod 2) =
        AddMonoidAlgebra.single u 1 * AddMonoidAlgebra.single u' 1 := by
      rw [AddMonoidAlgebra.single_mul_single, mul_one]
    rw [hprod, ← commutator_elemL i k j hki.symm hkj h, map_commutatorElement,
      commutatorElement_def]
    exact Subgroup.mul_mem _
      (Subgroup.mul_mem _ (Subgroup.mul_mem _ (hu i k hki.symm) (hu' k j hkj))
        (Subgroup.inv_mem _ (hu i k hki.symm)))
      (Subgroup.inv_mem _ (hu' k j hkj))

theorem natExponent_mem (w : Fin 3 → ℕ) : exponentCast w ∈ goodExponents := by
  intro i j h
  exact mem_compressorClosure_of_mem_peripheral (inl_elemL_natExponent_mem_peripheral i j h w)

theorem actor_mulVec_mem (M : Actor) {v : Fin 3 → ℤ} (hv : v ∈ goodExponents) :
    ((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ v ∈ goodExponents := by
  intro i j h
  have hc := inl_actorAction_mem M (hv i j h)
  rwa [actorAction_elemL, substitution_single] at hc

theorem neg_single_mem (i : Fin 3) : -(Pi.single i 1 : Fin 3 → ℤ) ∈ goodExponents := by
  obtain ⟨j, hji, -⟩ := third_index i i
  have h : i ≠ j := hji.symm
  have h₁ : (Pi.single j 1 + Pi.single i (-2) : Fin 3 → ℤ) ∈ goodExponents := by
    have hc := actor_mulVec_mem (elemZ i j h (-2)) (natExponent_mem (Pi.single j 1))
    rwa [exponentCast_single, elemZ_mulVec_single] at hc
  have h₂ : (Pi.single i 1 + Pi.single j (-1) : Fin 3 → ℤ) ∈ goodExponents := by
    have hc := actor_mulVec_mem (elemZ j i h.symm (-1)) (natExponent_mem (Pi.single i 1))
    rwa [exponentCast_single, elemZ_mulVec_single] at hc
  have hsum := add_mem h₁ h₂
  convert hsum using 1
  funext k
  simp only [Pi.add_apply, Pi.neg_apply, Pi.single_apply]
  split_ifs <;> simp_all

theorem all_exponents_good (v : Fin 3 → ℤ) : v ∈ goodExponents := by
  have hneg : ∀ w : Fin 3 → ℕ, -exponentCast w ∈ goodExponents := by
    intro w
    have hdecomp : -exponentCast w =
        w 0 • -(Pi.single 0 1 : Fin 3 → ℤ) + w 1 • -(Pi.single 1 1 : Fin 3 → ℤ) +
          w 2 • -(Pi.single 2 1 : Fin 3 → ℤ) := by
      funext k
      fin_cases k <;> simp
    rw [hdecomp]
    exact add_mem (add_mem (nsmul_mem (neg_single_mem 0) _) (nsmul_mem (neg_single_mem 1) _))
      (nsmul_mem (neg_single_mem 2) _)
  have hv : v = exponentCast (fun k => (v k).toNat) + -exponentCast (fun k => (-v k).toNat) := by
    funext k
    simp only [Pi.add_apply, Pi.neg_apply, exponentCast_apply]
    omega
  rw [hv]
  exact add_mem (natExponent_mem _) (hneg _)

/-! ### Infranormality -/

theorem inl_elemL_mem (i j : Fin 3) (h : i ≠ j) (a : Laurent) :
    (SemidirectProduct.inl (elemL i j h a) : Ambient) ∈ compressorClosure := by
  induction a using AddMonoidAlgebra.induction_linear with
  | zero =>
    rw [elemL_zero, map_one]
    exact Subgroup.one_mem _
  | add a b ha hb =>
    rw [elemL_add, map_mul]
    exact Subgroup.mul_mem _ ha hb
  | single v c =>
    rcases zmod_two_eq_zero_or_one c with rfl | rfl
    · rw [AddMonoidAlgebra.single_zero, elemL_zero, map_one]
      exact Subgroup.one_mem _
    · exact all_exponents_good v i j h

theorem inl_mem_compressorClosure (B : ↥(elementaryGroup (Fin 3) Laurent)) :
    (SemidirectProduct.inl B : Ambient) ∈ compressorClosure := by
  have htop : Subgroup.closure
      (((↑) : ↥(elementaryGroup (Fin 3) Laurent) → (Matrix (Fin 3) (Fin 3) Laurent)ˣ) ⁻¹'
        {z | ∃ (i j : Fin 3) (h : i ≠ j) (a : Laurent), elementaryUnit i j h a = z}) = ⊤ :=
    Subgroup.closure_closure_coe_preimage
  have hle : Subgroup.closure
      (((↑) : ↥(elementaryGroup (Fin 3) Laurent) → (Matrix (Fin 3) (Fin 3) Laurent)ˣ) ⁻¹'
        {z | ∃ (i j : Fin 3) (h : i ≠ j) (a : Laurent), elementaryUnit i j h a = z}) ≤
      compressorClosure.comap
        (SemidirectProduct.inl : ↥(elementaryGroup (Fin 3) Laurent) →* Ambient) := by
    rw [Subgroup.closure_le]
    intro x hx
    obtain ⟨i, j, h, a, hxa⟩ := hx
    have hx' : x = elemL i j h a := Subtype.ext hxa.symm
    rw [hx']
    exact inl_elemL_mem i j h a
  exact hle (by rw [htop]; exact Subgroup.mem_top B)

/-- **The compressors of `Peripheral` generate `Ambient`.** -/
theorem peripheral_isInfranormal : IsInfranormal Peripheral := by
  rw [IsInfranormal, eq_top_iff]
  intro x _
  rw [← SemidirectProduct.inl_left_mul_inr_right x]
  exact Subgroup.mul_mem _ (inl_mem_compressorClosure x.left) (inr_mem_compressorClosure x.right)

/-! ### Non-normality -/

/-- A monomial with a negative exponent is not a polynomial. -/
theorem polyToLaurent_ne_single (p : Poly) {v : Fin 3 → ℤ} {i : Fin 3} (hi : v i < 0) :
    polyToLaurent p ≠ AddMonoidAlgebra.single v 1 := by
  intro hp
  have hcoeff : Finsupp.mapDomain exponentCast p.coeff v = Finsupp.single v (1 : ZMod 2) v :=
    congrArg (fun x : Laurent => x.coeff v) hp
  rw [Finsupp.mapDomain_notin_range, Finsupp.single_eq_same] at hcoeff
  · exact absurd hcoeff (by decide)
  · rintro ⟨w, rfl⟩
    rw [exponentCast_apply] at hi
    omega

/-- **`Peripheral` is not normal.** -/
theorem peripheral_not_normal : ¬ Peripheral.Normal := by
  intro hN
  have h01 : (0 : Fin 3) ≠ 1 := by decide
  have hγ := inl_elemL_natExponent_mem_peripheral 0 1 h01 (Pi.single 1 1)
  have hconj := hN.conj_mem _ hγ (SemidirectProduct.inr (elemZ 0 1 h01 (-1)))
  rw [← map_inv (SemidirectProduct.inr : Actor →* Ambient), ← SemidirectProduct.inl_aut,
    actorAction_elemL, substitution_single, exponentCast_single, elemZ_mulVec_single,
    mem_peripheral_iff] at hconj
  obtain ⟨A, hA⟩ := hconj
  have hentry : polyToLaurent
      (((A : (Matrix (Fin 3) (Fin 3) Poly)ˣ) : Matrix (Fin 3) (Fin 3) Poly) 0 1) =
      AddMonoidAlgebra.single (Pi.single 1 1 + Pi.single 0 (-1) : Fin 3 → ℤ) 1 := by
    have h' := congrArg (fun x : Ambient =>
      ((x.left : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) 0 1) hA
    exact h'.trans (elemL_coe_apply_same 0 1 h01 _)
  exact polyToLaurent_ne_single _ (i := 0) (by simp) hentry

end GroupApproximation.BowenChapman
