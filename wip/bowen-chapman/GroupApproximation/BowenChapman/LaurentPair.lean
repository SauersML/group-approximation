import GroupApproximation.Leavitt.ElementaryGroup
import Mathlib.Algebra.MonoidAlgebra.MapDomain
import Mathlib.Algebra.Ring.Aut
import Mathlib.GroupTheory.SemidirectProduct

/-!
# An explicit infranormal pair of elementary groups

This file fixes the pair of groups on which the negative answer to
Bowen--Chapman's Problem 1.1 is built.  Put

* `Laurent = 𝔽₂[x₁^{±1}, x₂^{±1}, x₃^{±1}]`, the additive monoid algebra of `ℤ³`;
* `Poly = 𝔽₂[x₁, x₂, x₃]`, the additive monoid algebra of `ℕ³`;
* `Actor = EL₃(ℤ)`, acting on `Laurent` by monomial substitution
  `x^v ↦ x^(M v)`, and hence entrywise on `EL₃(Laurent)`.

The ambient group is `Ambient = EL₃(Laurent) ⋊ EL₃(ℤ)`, and the peripheral
subgroup `Peripheral` is the image of `EL₃(Poly)` in the normal factor.  This
is the three-variable, rank-three, characteristic-two member of the family in
Kun--Thom's Theorem E, with the actor `SL₃(ℤ)` replaced by the elementary group
`EL₃(ℤ)` (the same group, generated by definition).

Only definitions and the formulas consumers need are here: monomial
substitution on single monomials, the entrywise action on elementary matrices,
and injectivity of the peripheral embedding.
-/

namespace GroupApproximation.BowenChapman

open scoped Matrix

/-- Laurent polynomials in three variables over `𝔽₂`: the additive monoid
algebra of `ℤ³`. -/
abbrev Laurent : Type := AddMonoidAlgebra (ZMod 2) (Fin 3 → ℤ)

/-- Polynomials in three variables over `𝔽₂`: the additive monoid algebra of
`ℕ³`. -/
abbrev Poly : Type := AddMonoidAlgebra (ZMod 2) (Fin 3 → ℕ)

/-- The exponent inclusion `ℕ³ → ℤ³`. -/
def exponentCast : (Fin 3 → ℕ) →+ (Fin 3 → ℤ) where
  toFun w i := (w i : ℤ)
  map_zero' := by
    funext i
    simp
  map_add' w w' := by
    funext i
    simp

@[simp] theorem exponentCast_apply (w : Fin 3 → ℕ) (i : Fin 3) :
    exponentCast w i = (w i : ℤ) := rfl

theorem exponentCast_injective : Function.Injective exponentCast := by
  intro w w' h
  funext i
  have hi : (w i : ℤ) = (w' i : ℤ) := congrFun h i
  exact_mod_cast hi

/-- The inclusion of polynomials into Laurent polynomials. -/
noncomputable def polyToLaurent : Poly →+* Laurent :=
  AddMonoidAlgebra.mapDomainRingHom (ZMod 2) exponentCast

@[simp] theorem polyToLaurent_single (w : Fin 3 → ℕ) (c : ZMod 2) :
    polyToLaurent (AddMonoidAlgebra.single w c) =
      AddMonoidAlgebra.single (exponentCast w) c := by
  simp [polyToLaurent]

theorem polyToLaurent_injective : Function.Injective polyToLaurent := by
  intro x y h
  exact AddMonoidAlgebra.mapDomain_injective exponentCast_injective h

/-- Two ring automorphisms of `Laurent` which agree on monomials are equal. -/
theorem laurent_ringEquiv_ext {e f : Laurent ≃+* Laurent}
    (h : ∀ (v : Fin 3 → ℤ) (c : ZMod 2),
      e (AddMonoidAlgebra.single v c) = f (AddMonoidAlgebra.single v c)) :
    e = f := by
  apply RingEquiv.ext
  intro x
  induction x using AddMonoidAlgebra.induction_linear with
  | zero => rw [map_zero, map_zero]
  | add x y hx hy => rw [map_add, map_add, hx, hy]
  | single v c => exact h v c

/-- The acting group `EL₃(ℤ)`. -/
abbrev Actor : Type := ↥(elementaryGroup (Fin 3) ℤ)

/-- An element of the actor acts on exponents by matrix multiplication. -/
def exponentAction (M : Actor) : (Fin 3 → ℤ) ≃+ (Fin 3 → ℤ) where
  toFun v := ((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ v
  invFun v := (((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ)⁻¹ : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) :
    Matrix (Fin 3) (Fin 3) ℤ) *ᵥ v
  left_inv v := by
    show (((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ)⁻¹ : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) :
        Matrix (Fin 3) (Fin 3) ℤ) *ᵥ
      (((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ v) = v
    rw [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one,
      Matrix.one_mulVec]
  right_inv v := by
    show ((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ
      ((((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ)⁻¹ : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) :
        Matrix (Fin 3) (Fin 3) ℤ) *ᵥ v) = v
    rw [Matrix.mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one,
      Matrix.one_mulVec]
  map_add' v w := Matrix.mulVec_add _ v w

@[simp] theorem exponentAction_apply (M : Actor) (v : Fin 3 → ℤ) :
    exponentAction M v =
      ((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ v := rfl

theorem exponentAction_one (v : Fin 3 → ℤ) : exponentAction 1 v = v := by
  simp

theorem exponentAction_mul (M N : Actor) (v : Fin 3 → ℤ) :
    exponentAction (M * N) v = exponentAction M (exponentAction N v) := by
  simp

/-- Monomial substitution `x^v ↦ x^(M v)`, as a group homomorphism into the
ring automorphisms of `Laurent`. -/
noncomputable def substitution : Actor →* RingAut Laurent where
  toFun M := AddMonoidAlgebra.mapDomainRingEquiv (ZMod 2) (exponentAction M)
  map_one' := by
    apply laurent_ringEquiv_ext
    intro v c
    change AddMonoidAlgebra.mapDomainRingEquiv (ZMod 2) (exponentAction 1)
        (AddMonoidAlgebra.single v c) = AddMonoidAlgebra.single v c
    rw [AddMonoidAlgebra.mapDomainRingEquiv_single, exponentAction_one]
  map_mul' M N := by
    apply laurent_ringEquiv_ext
    intro v c
    change AddMonoidAlgebra.mapDomainRingEquiv (ZMod 2) (exponentAction (M * N))
        (AddMonoidAlgebra.single v c) =
      AddMonoidAlgebra.mapDomainRingEquiv (ZMod 2) (exponentAction M)
        (AddMonoidAlgebra.mapDomainRingEquiv (ZMod 2) (exponentAction N)
          (AddMonoidAlgebra.single v c))
    rw [AddMonoidAlgebra.mapDomainRingEquiv_single, AddMonoidAlgebra.mapDomainRingEquiv_single,
      AddMonoidAlgebra.mapDomainRingEquiv_single, exponentAction_mul]

/-- Substitution on a single monomial. -/
@[simp] theorem substitution_single (M : Actor) (v : Fin 3 → ℤ) (c : ZMod 2) :
    substitution M (AddMonoidAlgebra.single v c) =
      AddMonoidAlgebra.single
        (((M : (Matrix (Fin 3) (Fin 3) ℤ)ˣ) : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ v) c :=
  AddMonoidAlgebra.mapDomainRingEquiv_single (exponentAction M) c v

/-- The actor acts on `EL₃(Laurent)` entrywise, through `substitution`. -/
noncomputable def actorAction : Actor →* MulAut ↥(elementaryGroup (Fin 3) Laurent) where
  toFun M := elementaryCoefficientEquiv (ι := Fin 3) (substitution M)
  map_one' := by
    apply MulEquiv.ext
    intro A
    apply Subtype.ext
    apply Units.ext
    ext i j
    change substitution 1
        (((A : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j) =
      ((A : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j
    rw [map_one]
    rfl
  map_mul' M N := by
    apply MulEquiv.ext
    intro A
    apply Subtype.ext
    apply Units.ext
    ext i j
    change substitution (M * N)
        (((A : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j) =
      substitution M (substitution N
        (((A : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j))
    rw [map_mul]
    rfl

/-- The entries of `actorAction M B` are the substituted entries of `B`. -/
@[simp] theorem actorAction_coe_apply (M : Actor) (B : ↥(elementaryGroup (Fin 3) Laurent))
    (i j : Fin 3) :
    (((actorAction M B : ↥(elementaryGroup (Fin 3) Laurent)) :
        (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j =
      substitution M
        (((B : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j) :=
  rfl

/-- The actor carries elementary matrices to elementary matrices. -/
theorem actorAction_elementaryUnit (M : Actor) (i j : Fin 3) (h : i ≠ j) (a : Laurent) :
    actorAction M ⟨elementaryUnit i j h a, elementaryUnit_mem i j h a⟩ =
      ⟨elementaryUnit i j h (substitution M a), elementaryUnit_mem i j h (substitution M a)⟩ := by
  apply Subtype.ext
  exact elementaryMatrixUnitMap_elementaryUnit (substitution M : Laurent →+* Laurent) i j h a

/-- The ambient group `EL₃(𝔽₂[ℤ³]) ⋊ EL₃(ℤ)`. -/
abbrev Ambient : Type :=
  SemidirectProduct ↥(elementaryGroup (Fin 3) Laurent) Actor actorAction

/-- The embedding of `EL₃(𝔽₂[ℕ³])` into the normal factor of `Ambient`. -/
noncomputable def peripheralHom : ↥(elementaryGroup (Fin 3) Poly) →* Ambient :=
  SemidirectProduct.inl.comp (elementaryGroupMap (ι := Fin 3) polyToLaurent)

/-- The peripheral subgroup: the image of `EL₃(𝔽₂[ℕ³])` in `Ambient`. -/
noncomputable def Peripheral : Subgroup Ambient :=
  peripheralHom.range

theorem peripheral_eq_range : Peripheral = peripheralHom.range := rfl

theorem mem_peripheral_iff {x : Ambient} :
    x ∈ Peripheral ↔ ∃ A : ↥(elementaryGroup (Fin 3) Poly), peripheralHom A = x :=
  MonoidHom.mem_range

@[simp] theorem peripheralHom_right (A : ↥(elementaryGroup (Fin 3) Poly)) :
    (peripheralHom A).right = 1 := rfl

/-- The normal-factor entries of a peripheral element are polynomials. -/
@[simp] theorem peripheralHom_left_coe_apply (A : ↥(elementaryGroup (Fin 3) Poly))
    (i j : Fin 3) :
    ((((peripheralHom A).left : ↥(elementaryGroup (Fin 3) Laurent)) :
        (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j =
      polyToLaurent (((A : (Matrix (Fin 3) (Fin 3) Poly)ˣ) : Matrix (Fin 3) (Fin 3) Poly) i j) :=
  rfl

theorem peripheralHom_injective : Function.Injective peripheralHom := by
  intro A B h
  have h' : elementaryGroupMap (ι := Fin 3) polyToLaurent A =
      elementaryGroupMap (ι := Fin 3) polyToLaurent B :=
    SemidirectProduct.inl_injective h
  apply Subtype.ext
  apply Units.ext
  ext i j
  have hij : polyToLaurent
        (((A : (Matrix (Fin 3) (Fin 3) Poly)ˣ) : Matrix (Fin 3) (Fin 3) Poly) i j) =
      polyToLaurent
        (((B : (Matrix (Fin 3) (Fin 3) Poly)ˣ) : Matrix (Fin 3) (Fin 3) Poly) i j) :=
    congrArg (fun z : ↥(elementaryGroup (Fin 3) Laurent) =>
      ((z : (Matrix (Fin 3) (Fin 3) Laurent)ˣ) : Matrix (Fin 3) (Fin 3) Laurent) i j) h'
  exact polyToLaurent_injective hij

end GroupApproximation.BowenChapman
