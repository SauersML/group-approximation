+      - name: Palomar axiom closure (Bowen-Chapman)
+        id: axioms-bowen-chapman
+        continue-on-error: true
+        if: always()
+        run: lake env lean scripts/PalomarBowenChapmanAxioms.lean
+
       - name: Reject a run whose axiom closures were not all clean
         if: always()
         run: |
           nonmf='${{ steps.axioms-nonmf.outcome }}'
           lix='${{ steps.axioms-lix.outcome }}'
           strong='${{ steps.axioms-lix-strong.outcome }}'
+          bc='${{ steps.axioms-bowen-chapman.outcome }}'
           echo "non-MF closure: $nonmf"
           echo "LIX closure: $lix"
           echo "LIX strengthened closure: $strong"
+          echo "Bowen-Chapman closure: $bc"
           # `skipped` counts as a failure: the closure was not computed, and a
           # check that did not run must not read like one that passed.
           if [ "$nonmf" != success ] || [ "$lix" != success ] \
-             || [ "$strong" != success ]; then
+             || [ "$strong" != success ] || [ "$bc" != success ]; then
             echo "::error::an axiom-closure driver did not report success"
