/-!
# Reflection of a clopen crossed product onto its chain-recurrent core

`non_mf_groups_exist.tex`, `thm:core-ring-reflection` (tex 1516–1524) and its proof
(tex 1526–1539).  `R_X = LC(X, k) ⋊_T ℤ` is `ClopenCrossedProduct T k`, `Y` is the chain-recurrent
set `Dynamics.chainRecurrentSet T`, and restriction `R_X → R_Y` is
`ClopenCrossedProduct.restrict T k (Dynamics.image_chainRecurrentSet T)`.

The module instantiates the abstract reflection of `Algebra/DirectlyFiniteReflection.lean` at
restriction.  Upstream results that are not yet on `main` enter as named hypothesis Props:

| Prop | content | owner |
|---|---|---|
| `LEFStablyFiniteInterface` | LEF rings are stably finite (tex 1358) | hull-bridge |
| `RestrictSurjectiveInterface` | restriction to a closed invariant set is onto (tex 1470) | chain-matricial |
| `CoreKernelDefectInterface` | killing the defects kills `I` (tex 1476) | chain-matricial, chain-itinerary |
| `CoreLEFInterface` | `R_Y` is LEF (`lem:chain-core-models`) | chain-itinerary |
| `RestrictInjectiveIffInterface` | restriction is injective iff `Y = X` (tex 1538) | chain-matricial |

* Model tests: each interface holds on an empty space (`*_isEmpty_model`).  The injectivity
  criterion needs `1 ≠ 0` in `k` (`not_restrictInjectiveIff_of_subsingleton_coefficients`).  The
  kernel statement fails for an arbitrary closed invariant `Y`: at `X = PUnit`, `Y = ∅` every defect
  vanishes but `I = R_X` (`not_forall_killsKernel_of_killsDefects_closedInvariant`).
* Printed Props, one per sentence, each proved from the interfaces by a `_of_interfaces` theorem:
  `PrintedCoreFactorsUniquely`, `PrintedCoreUniversalStablyFiniteLEF`,
  `PrintedCoreMatrixAmplification`, `PrintedCoreDirectlyFiniteIff`, `PrintedCoreKillsDefectsAndI`,
  `PrintedCoreLEFStablyFinite`, `PrintedCoreCornerKillsI`, `PrintedCoreKillsMatrixI`,
  `PrintedCoreMatrixQuotientLEF`, `PrintedCoreIZeroIff`.

`X` is a compact, totally disconnected metric space and `k` a finite field.  The printed
"nonempty" is not used.
-/

namespace GroupApproximation

namespace CoreRingReflection

open ClopenCrossedProduct (restrict restrictHomeo defectD coeff coeff_injective map_defectD_eq_zero)
open Pestov91 (IsLEFRing isLEFRing_of_finite)

/-! ### Hypothesis Props for upstream results not yet on `main` -/

/-- **Restriction is onto** (tex 1470–1471, `lem:transient-matrices`: "Restriction fits into an
exact sequence $0\to I\to R_X\to R_Y\to0$").  For a closed invariant set `Y` of a compact,
Hausdorff, totally disconnected space, `R_X → R_Y` is surjective.  Owner: chain-matricial
(`ClopenCrossedProduct.restrict_surjective`, `Dynamics/TransientIdealExact.lean`). -/
def RestrictSurjectiveInterface : Prop :=
  ∀ (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] [TotallyDisconnectedSpace X]
    (T : X ≃ₜ X) (k : Type) [Ring k] (Y : Set X) (hY : T '' Y = Y), IsClosed Y →
    Function.Surjective (restrict T k hY)

/-- **The transient ideal is generated by the defects** (tex 1476–1478, `lem:transient-matrices`:
"The ideal $I$ is locally matricial and is generated by the indicators $1_{P\setminus T(P)}$ of
the defects"), in the form consumed here.  A unital homomorphism out of `R_X`, into any ring, that
kills the defect `d = 1_{P∖T(P)}` of every compressed clopen `P` kills the kernel of restriction to
the chain-recurrent set.  Owners: chain-matricial (`ker_restrict_le_of_forall_defectD`), with the
defect cover from chain-itinerary. -/
def CoreKernelDefectInterface.{w} : Prop :=
  ∀ (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] (T : X ≃ₜ X)
    (k : Type) [Field k] [Finite k] (A : Type w) [Ring A] (ψ : ClopenCrossedProduct T k →+* A),
    (∀ (P : Set X) (hP : IsClopen P), T '' P ⊆ P → ψ (defectD T k hP) = 0) →
    ∀ x, restrict T k (Dynamics.image_chainRecurrentSet T) x = 0 → ψ x = 0

/-- **`R_Y` is LEF** (`lem:chain-core-models`; tex 1529: "Since $R_Y$ itself is LEF").  The clopen
crossed product of the chain-recurrent set over a finite field is LEF.  Owner: chain-itinerary
(`ChainCore.isLEFRing_crossedProduct_chainRecurrentSet`, `Dynamics/ChainCoreGeneral.lean`). -/
def CoreLEFInterface : Prop :=
  ∀ (X : Type) [MetricSpace X] [CompactSpace X] [TotallyDisconnectedSpace X] (T : X ≃ₜ X)
    (k : Type) [Field k] [Finite k],
    IsLEFRing (ClopenCrossedProduct (restrictHomeo T (Dynamics.image_chainRecurrentSet T)) k)

/-- **`I = 0` exactly when `X = Y`** (tex 1538: "Finally, $I=0$ exactly when $X=Y$").  Restriction
to a closed invariant set is injective iff the set is everything.  Owner: chain-matricial
(`ClopenCrossedProduct.restrict_injective_iff`, `Dynamics/TransientIdealExact.lean`). -/
def RestrictInjectiveIffInterface : Prop :=
  ∀ (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] [TotallyDisconnectedSpace X]
    (T : X ≃ₜ X) (k : Type) [Ring k] [Nontrivial k] (Y : Set X) (hY : T '' Y = Y), IsClosed Y →
    (Function.Injective (restrict T k hY) ↔ Y = Set.univ)

/-! ### Model tests -/

/-- A clopen crossed product whose coefficient functions all agree is the zero ring. -/
theorem subsingleton_clopenCrossedProduct {X : Type*} [TopologicalSpace X] (T : X ≃ₜ X)
    (k : Type*) [Ring k] (h : ∀ (_ : X) (a b : k), a = b) :
    Subsingleton (ClopenCrossedProduct T k) := by
  refine subsingleton_of_zero_eq_one ?_
  have h01 : (0 : LocallyConstant X k) = 1 := LocallyConstant.ext fun x => h x _ _
  rw [← map_zero (coeff T k), h01, map_one]

/-- `RestrictSurjectiveInterface` holds on an empty space. -/
theorem restrictSurjective_isEmpty_model {X : Type} [TopologicalSpace X] [IsEmpty X]
    (T : X ≃ₜ X) (k : Type) [Ring k] (Y : Set X) (hY : T '' Y = Y) :
    Function.Surjective (restrict T k hY) := by
  haveI := subsingleton_clopenCrossedProduct (restrictHomeo T hY) k fun y _ _ =>
    (IsEmpty.false y.1).elim
  exact fun _ => ⟨0, Subsingleton.elim _ _⟩

/-- `CoreKernelDefectInterface` holds on an empty space. -/
theorem coreKernelDefect_isEmpty_model.{w} {X : Type} [MetricSpace X] [CompactSpace X]
    [IsEmpty X] (T : X ≃ₜ X) (k : Type) [Field k] (A : Type w) [Ring A]
    (ψ : ClopenCrossedProduct T k →+* A) :
    (∀ (P : Set X) (hP : IsClopen P), T '' P ⊆ P → ψ (defectD T k hP) = 0) →
      ∀ x, restrict T k (Dynamics.image_chainRecurrentSet T) x = 0 → ψ x = 0 := by
  haveI := subsingleton_clopenCrossedProduct T k fun x _ _ => (IsEmpty.false x).elim
  intro _ x _
  rw [Subsingleton.elim x 0, map_zero]

/-- `CoreLEFInterface` holds on an empty space. -/
theorem coreLEF_isEmpty_model {X : Type} [MetricSpace X] [CompactSpace X] [IsEmpty X]
    (T : X ≃ₜ X) (k : Type) [Field k] :
    IsLEFRing (ClopenCrossedProduct (restrictHomeo T (Dynamics.image_chainRecurrentSet T)) k) := by
  haveI := subsingleton_clopenCrossedProduct
    (restrictHomeo T (Dynamics.image_chainRecurrentSet T)) k fun y _ _ => (IsEmpty.false y.1).elim
  exact isLEFRing_of_finite _

/-- `RestrictInjectiveIffInterface` holds on an empty space. -/
theorem restrictInjectiveIff_isEmpty_model {X : Type} [TopologicalSpace X] [IsEmpty X]
    (T : X ≃ₜ X) (k : Type) [Ring k] (Y : Set X) (hY : T '' Y = Y) :
    Function.Injective (restrict T k hY) ↔ Y = Set.univ := by
  haveI := subsingleton_clopenCrossedProduct T k fun x _ _ => (IsEmpty.false x).elim
  exact ⟨fun _ => Set.eq_univ_of_forall fun x => (IsEmpty.false x).elim,
    fun _ a b _ => Subsingleton.elim a b⟩

/-- **Adversarial witness: `1 ≠ 0` in `k` is essential** in `RestrictInjectiveIffInterface`.  Over
the zero ring `k = PUnit`, restriction from `X = PUnit` to `Y = ∅` is injective although `Y ≠ X`. -/
theorem not_restrictInjectiveIff_of_subsingleton_coefficients :
    ¬ ∀ (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] [TotallyDisconnectedSpace X]
      (T : X ≃ₜ X) (k : Type) [Ring k] (Y : Set X) (hY : T '' Y = Y), IsClosed Y →
      (Function.Injective (restrict T k hY) ↔ Y = Set.univ) := by
  intro h
  haveI : TotallyDisconnectedSpace PUnit.{1} := ⟨fun _ _ _ => Set.subsingleton_of_subsingleton⟩
  haveI := subsingleton_clopenCrossedProduct (Homeomorph.refl PUnit.{1}) PUnit.{1}
    fun _ a b => Subsingleton.elim a b
  exact Set.empty_ne_univ ((h PUnit.{1} (Homeomorph.refl _) PUnit.{1} ∅ (Set.image_empty _)
    isClosed_empty).1 fun a b _ => Subsingleton.elim a b)

/-- Over `X = PUnit` with `Y = ∅`, every defect vanishes, yet restriction kills `1 ≠ 0`. -/
theorem not_killsKernel_of_killsDefects_emptySet (k : Type) [Field k] :
    ¬ ∀ (A : Type) [Ring A] (ψ : ClopenCrossedProduct (Homeomorph.refl PUnit.{1}) k →+* A),
      (∀ (P : Set PUnit.{1}) (hP : IsClopen P), Homeomorph.refl PUnit.{1} '' P ⊆ P →
        ψ (defectD (Homeomorph.refl PUnit.{1}) k hP) = 0) →
      ∀ x, restrict (Homeomorph.refl PUnit.{1}) k (Set.image_empty _) x = 0 → ψ x = 0 := by
  intro h
  have hd : ∀ (P : Set PUnit.{1}) (hP : IsClopen P),
      defectD (Homeomorph.refl PUnit.{1}) k hP = 0 := by
    intro P hP
    rw [defectD, ← map_zero (coeff (Homeomorph.refl PUnit.{1}) k)]
    congr 1
    exact LocallyConstant.ext fun y => (LocallyConstant.charFn_eq_zero k y _).2
      fun hy => hy.2 ⟨y, hy.1, Subsingleton.elim _ _⟩
  haveI : Subsingleton (ClopenCrossedProduct
      (restrictHomeo (Homeomorph.refl PUnit.{1}) (Set.image_empty _)) k) :=
    subsingleton_clopenCrossedProduct _ k fun y _ _ => absurd y.2 (Set.notMem_empty _)
  have h1 := h _ (RingHom.id _) (fun P hP _ => hd P hP) 1 (Subsingleton.elim _ _)
  have h2 := DFunLike.congr_fun (coeff_injective (Homeomorph.refl PUnit.{1}) k
    ((map_one (coeff (Homeomorph.refl PUnit.{1}) k)).trans
      (h1.trans (map_zero (coeff (Homeomorph.refl PUnit.{1}) k)).symm))) PUnit.unit
  change (1 : k) = 0 at h2
  exact one_ne_zero h2

/-- **Adversarial witness: `Y` must be the chain-recurrent set** in `CoreKernelDefectInterface`.
For an arbitrary closed invariant `Y` the kernel statement fails, at `X = PUnit`, `Y = ∅`,
`k = 𝔽₂`. -/
theorem not_forall_killsKernel_of_killsDefects_closedInvariant :
    ¬ ∀ (X : Type) [TopologicalSpace X] [CompactSpace X] [T2Space X] [TotallyDisconnectedSpace X]
      (T : X ≃ₜ X) (k : Type) [Field k] [Finite k] (Y : Set X) (hY : T '' Y = Y), IsClosed Y →
      ∀ (A : Type) [Ring A] (ψ : ClopenCrossedProduct T k →+* A),
        (∀ (P : Set X) (hP : IsClopen P), T '' P ⊆ P → ψ (defectD T k hP) = 0) →
        ∀ x, restrict T k hY x = 0 → ψ x = 0 := by
  intro h
  haveI : TotallyDisconnectedSpace PUnit.{1} := ⟨fun _ _ _ => Set.subsingleton_of_subsingleton⟩
  exact not_killsKernel_of_killsDefects_emptySet (ZMod 2)
    (h PUnit.{1} (Homeomorph.refl _) (ZMod 2) ∅ (Set.image_empty _) isClosed_empty)

