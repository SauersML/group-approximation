   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Non-MF groups from one-sided compression</rdf:li>
     <rdf:li xml:lang="en-US">Non-MF groups from one-sided compression</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>MF groups</rdf:li>
     <rdf:li>norm matrix coronas</rdf:li>
     <rdf:li>MF radicals</rdf:li>
     <rdf:li>property (T)</rdf:li>
     <rdf:li>asymptotic representations</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
